---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Monte-Carlo Rechner - Simulationen und Wahrscheinlichkeiten";
const description = "Führen Sie Monte-Carlo-Simulationen für Wahrscheinlichkeitsschätzungen durch. Pi-Annäherung, Zufallsexperimente und Risikoabschätzungen simulieren.";

const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Wahrscheinlichkeit." },
  { name: "Monty-Hall Rechner", url: "/de/monty-hall-rechner", description: "Monty-Hall-Problem." },
  { name: "Statistik-Rechner", url: "/de/statistikrechner", description: "Statistik berechnen." },
  { name: "Normalverteilung-Rechner", url: "/de/normalverteilungsrechner", description: "Normalverteilung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="monte-carlo-calculator" calculatorName="Monte-Carlo Rechner" keywords="Monte Carlo Simulation, Pi schätzen, Wahrscheinlichkeit simulieren, Zufallsexperiment, numerische Methoden" breadcrumbs={[{ name: "Monte-Carlo Rechner", url: "/de/monte-carlo-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Monte-Carlo Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Führen Sie Monte-Carlo-Simulationen durch. Schätzen Sie Pi, berechnen Sie Integrale und verstehen Sie die Grundlagen stochastischer Simulationen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Simulation</label>
          <select id="mc-type" class="mc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="pi">Pi-Annäherung (Einheitskreis)</option>
            <option value="integral">Integration: ∫ sin(x) dx von 0 bis π</option>
            <option value="dice">Würfel-Summen-Wahrscheinlichkeit</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Simulationen</label>
            <select id="mc-n" class="mc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
              <option value="1000">1.000</option>
              <option value="10000" selected>10.000</option>
              <option value="100000">100.000</option>
              <option value="500000">500.000</option>
            </select>
          </div>
          <div id="mc-dice-wrap" class="hidden">
            <label class="block text-xs font-medium text-text mb-1">Zielwert (Würfelsumme)</label>
            <input type="number" id="mc-dice-target" class="mc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="2" max="12" value="7">
          </div>
        </div>

        <button id="mc-run" class="w-full py-3 bg-primary text-white font-bold rounded-xl hover:bg-primary/90 transition-colors cursor-pointer">Simulation starten</button>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="mc-result-label">Geschätztes Ergebnis</div>
          <div class="text-5xl font-extrabold font-mono" id="mc-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="mc-result-sub">Klicken Sie auf Simulation starten</div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Treffer</div>
            <div class="text-xl font-bold" id="mc-hits">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Simulationen</div>
            <div class="text-xl font-bold" id="mc-total">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fehler</div>
            <div class="text-xl font-bold" id="mc-error">—</div>
          </div>
        </div>

        <canvas id="mc-canvas" width="500" height="200" class="w-full rounded-xl border border-border bg-gray-50"></canvas>
      </div>
      <ShareButton lang="de" calculatorId="monte-carlo" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die Monte-Carlo-Methode</h2>
      <p>Die Monte-Carlo-Methode ist eine Klasse von Algorithmen, die auf wiederholter Zufallsstichprobennahme beruhen. Benannt nach dem Kasino in Monte Carlo, wurden sie in den 1940er Jahren von Stanislaw Ulam und John von Neumann entwickelt. Sie werden eingesetzt, wenn analytische Lösungen zu komplex sind.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Wie schätzt die Monte-Carlo-Methode Pi?</p>
          <p>Punkte werden zufällig in einem Einheitsquadrat [0,1]×[0,1] platziert. Punkte, deren Abstand vom Ursprung kleiner als 1 ist, liegen im Einheitskreis. Das Verhältnis dieser Punkte zur Gesamtzahl × 4 nähert sich Pi an.</p>
        </div>
        <div>
          <p class="font-semibold">Wie genau ist die Monte-Carlo-Methode?</p>
          <p>Der Fehler nimmt mit √N ab, wobei N die Anzahl der Simulationen ist. Bei 10.000 Simulationen ist der typische Fehler etwa 1/√10.000 = 1%. Bei 1.000.000 Simulationen: 0,1%. Sie konvergiert langsam, ist aber universell anwendbar.</p>
        </div>
        <div>
          <p class="font-semibold">Wo wird Monte Carlo in der Praxis eingesetzt?</p>
          <p>Finanzrisikoanalyse (Value at Risk), Optionspreisberechnung, Klimamodelle, Teilchenphysik (CERN), Raumfahrtmissionsplanung, KI-Spielalgorithmen (AlphaGo) und Ingenieurssimulationen verwenden Monte-Carlo-Methoden.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist Quasi-Monte-Carlo?</p>
          <p>Im Gegensatz zu echtem Monte Carlo verwendet Quasi-Monte-Carlo deterministische, gleichmäßig verteilte Folgen (Low-Discrepancy-Sequenzen wie Halton oder Sobol). Diese konvergieren schneller (Fehler ∝ 1/N statt 1/√N).</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function runMonteCarlo() {
      const type = (document.getElementById('mc-type') as HTMLSelectElement).value;
      const n = parseInt((document.getElementById('mc-n') as HTMLSelectElement).value) || 10000;
      const diceTarget = parseInt((document.getElementById('mc-dice-target') as HTMLInputElement).value) || 7;

      let hits = 0;
      let estimate = 0;
      let exact = 0;
      let label = '';
      const points: [number, number, boolean][] = [];

      if (type === 'pi') {
        label = 'Geschätztes Pi (π)';
        exact = Math.PI;
        for (let i = 0; i < n; i++) {
          const x = Math.random();
          const y = Math.random();
          const inside = x * x + y * y <= 1;
          if (inside) hits++;
          if (i < 2000) points.push([x, y, inside]);
        }
        estimate = 4 * hits / n;

      } else if (type === 'integral') {
        label = '∫₀^π sin(x) dx ≈';
        exact = 2;
        for (let i = 0; i < n; i++) {
          const x = Math.random() * Math.PI;
          const y = Math.random();
          const inside = y <= Math.sin(x);
          if (inside) hits++;
          if (i < 2000) points.push([x / Math.PI, y, inside]);
        }
        estimate = Math.PI * hits / n;

      } else {
        label = `P(Würfelsumme = ${diceTarget})`;
        const exactProbs: Record<number, number> = {2:1,3:2,4:3,5:4,6:5,7:6,8:5,9:4,10:3,11:2,12:1};
        exact = (exactProbs[diceTarget] || 0) / 36;
        for (let i = 0; i < n; i++) {
          const d1 = Math.ceil(Math.random() * 6);
          const d2 = Math.ceil(Math.random() * 6);
          const inside = (d1 + d2) === diceTarget;
          if (inside) hits++;
          if (i < 2000) points.push([d1 / 6, d2 / 6, inside]);
        }
        estimate = hits / n;
      }

      const fmt = (v: number, dec = 5) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });
      const error = Math.abs(estimate - exact);

      document.getElementById('mc-result-label')!.textContent = label;
      document.getElementById('mc-result')!.textContent = fmt(estimate);
      document.getElementById('mc-result-sub')!.textContent = `Exakter Wert: ${fmt(exact)}`;
      document.getElementById('mc-hits')!.textContent = hits.toLocaleString('de-DE');
      document.getElementById('mc-total')!.textContent = n.toLocaleString('de-DE');
      document.getElementById('mc-error')!.textContent = fmt(error);

      const canvas = document.getElementById('mc-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const cw = canvas.width, ch = canvas.height;
      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(0, 0, cw, ch);
      points.slice(0, 1500).forEach(([x, y, inside]) => {
        ctx.fillStyle = inside ? 'rgba(37,99,235,0.5)' : 'rgba(239,68,68,0.4)';
        ctx.beginPath();
        ctx.arc(x * cw, (1 - y) * ch, 2, 0, Math.PI * 2);
        ctx.fill();
      });

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('mc-run')!.addEventListener('click', runMonteCarlo);
      document.getElementById('mc-type')!.addEventListener('change', () => {
        const isDice = (document.getElementById('mc-type') as HTMLSelectElement).value === 'dice';
        document.getElementById('mc-dice-wrap')!.classList.toggle('hidden', !isDice);
      });
    }, 50);
  </script>
</CalculatorLayout>
