---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hubble Konstante Rechner - Kosmische Expansion & Universumsalter 2026";
const description = "Berechne Entfernungen aus der Rotverschiebung mit dem Hubble-Gesetz, schaetze das Universumsalter und erkunde kosmische Expansionsparameter.";

const relatedCalcs = [
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Erweiterte Berechnungen." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Halbwertszeit-Rechner", url: "/de/halbwertszeit-rechner", description: "Halbwertszeit." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hubble-Konstante-Rechner" keywords="Hubble Konstante, Hubble Gesetz, kosmische Expansion, Universumsalter, Rotverschiebung, Galaxienentfernung" breadcrumbs={[{ name: "Hubble-Konstante-Rechner", url: "/de/hubble-konstante-rechner" }]} lang="de" enSlug="hubble-constant-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hubble-Konstante-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">v = H&#8320; &times; d &mdash; Hubbles Gesetz verknuepft Fluchtgeschwindigkeit mit Entfernung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Hubble-Konstante H&#8320; (km/s/Mpc)</label><input type="number" id="hkk-h0" class="hkk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70" step="0.1" min="1"></div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Berechnen fuer</label>
          <select id="hkk-solve" class="hkk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="dist" selected>Entfernung aus Geschwindigkeit</option>
            <option value="vel">Geschwindigkeit aus Entfernung</option>
            <option value="h0">H&#8320; aus Geschwindigkeit und Entfernung</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fluchtgeschwindigkeit (km/s)</label><input type="number" id="hkk-vel" class="hkk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7000" step="100" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Entfernung (Mpc)</label><input type="number" id="hkk-dist" class="hkk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" step="1" min="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="hkk-label">Ergebnis</div>
          <div class="text-5xl font-extrabold font-mono" id="hkk-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hubble-Zeit (Weltalter)</div><div class="text-xl font-bold font-mono" id="hkk-age">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rotverschiebung (z)</div><div class="text-xl font-bold font-mono" id="hkk-z">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Entfernung (Mly)</div><div class="text-xl font-bold font-mono" id="hkk-mly">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hubble-Radius</div><div class="text-xl font-bold font-mono" id="hkk-hr">--</div></div>
        </div>
      </div>

      <ShareButton calculatorId="hubble-constant" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Hubble-Gesetz</h2>
      <p>Das Hubble-Gesetz besagt, dass sich Galaxien umso schneller von uns entfernen, je weiter sie von uns entfernt sind: v = H&#8320; &times; d. Die Hubble-Konstante H&#8320; betraegt nach aktuellen Messungen etwa 67-73 km/s/Mpc.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist die Hubble-Konstante?</strong> Die Hubble-Konstante H&#8320; beschreibt die Expansionsrate des Universums. Sie gibt an, um wie viele km/s sich eine Galaxie fuer jede Megaparsec (Mpc) Entfernung schneller von uns entfernt.</p>
      <p><strong>Wie alt ist das Universum laut Hubble?</strong> Die Hubble-Zeit (1/H&#8320;) ergibt eine obere Grenze des Universumsalters von etwa 13,8 Milliarden Jahren, uebereinstimmend mit anderen kosmologischen Messungen.</p>
      <p><strong>Was ist Rotverschiebung (z)?</strong> Die Rotverschiebung z misst, wie stark sich das Licht einer Galaxie durch die kosmische Expansion in den roten Spektralbereich verschoben hat. Kleine z-Werte entsprechen nahen Galaxien.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHKK() {
      const solve = (document.getElementById('hkk-solve') as HTMLSelectElement).value;
      let H0 = parseFloat((document.getElementById('hkk-h0') as HTMLInputElement).value) || 70;
      let vel = parseFloat((document.getElementById('hkk-vel') as HTMLInputElement).value) || 0;
      let dist = parseFloat((document.getElementById('hkk-dist') as HTMLInputElement).value) || 0;
      const c = 299792.458;

      if (solve === 'dist') {
        dist = vel / H0;
        document.getElementById('hkk-label')!.textContent = 'Entfernung';
        document.getElementById('hkk-result')!.textContent = dist.toFixed(2) + ' Mpc';
      } else if (solve === 'vel') {
        vel = H0 * dist;
        document.getElementById('hkk-label')!.textContent = 'Fluchtgeschwindigkeit';
        document.getElementById('hkk-result')!.textContent = vel.toFixed(0) + ' km/s';
      } else {
        H0 = dist > 0 ? vel / dist : 0;
        document.getElementById('hkk-label')!.textContent = 'Hubble-Konstante';
        document.getElementById('hkk-result')!.textContent = H0.toFixed(1) + ' km/s/Mpc';
      }

      const hubbleTimeSec = (3.086e22) / (H0 * 1000);
      const hubbleTimeGyr = hubbleTimeSec / (3.156e16);
      const z = vel / c;
      const mly = dist * 3.2616;
      const hubbleRadius = c / H0;

      document.getElementById('hkk-age')!.textContent = hubbleTimeGyr.toFixed(2) + ' Gyr';
      document.getElementById('hkk-z')!.textContent = z.toFixed(6);
      document.getElementById('hkk-mly')!.textContent = mly.toFixed(1) + ' Mly';
      document.getElementById('hkk-hr')!.textContent = hubbleRadius.toFixed(0) + ' Mpc';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hkk-in').forEach(el => {
        el.addEventListener('input', calcHKK);
        el.addEventListener('change', calcHKK);
      });
      calcHKK();
    }, 50);
  </script>
</CalculatorLayout>
