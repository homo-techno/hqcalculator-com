---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Riemenl\u00e4ngenrechner - Riementrieb-Auslegung";
const description = "Berechnen Sie die Riemenl\u00e4nge f\u00fcr offene und gekreuzte Riementriebe. Finden Sie \u00dcbersetzungsverh\u00e4ltnis, Umschlingungswinkel und Riemenl\u00e4nge.";
const relatedCalcs = [
  { name: "Zahnrad-Rechner", url: "/gear-calculator", description: "\u00dcbersetzung." },
  { name: "Schrittmotor-Rechner", url: "/stepper-motor-calculator", description: "Motorschritte." },
  { name: "Tr\u00e4gheitsmoment-Rechner", url: "/moment-of-inertia-calculator", description: "Rotationstr\u00e4gheit." },
  { name: "Spannung & Dehnung", url: "/stress-strain-calculator", description: "Materialspannung." },
  { name: "Rohrstr\u00f6mung-Rechner", url: "/pipe-flow-calculator", description: "Durchflussrate." },
  { name: "Einheitenumrechner", url: "/unit-converter", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Riemenl\u00e4ngenrechner" lang="de" keywords="riemenl\u00e4nge, riemenscheibe rechner, \u00fcbersetzungsverh\u00e4ltnis, umschlingungswinkel, gekreuzter riemen, offener riemen" breadcrumbs={[{ name: "Riemenl\u00e4ngenrechner", url: "/de/riemenlaenge-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Riemenl&auml;ngenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie die Durchmesser zweier Riemenscheiben und den Achsabstand ein, um Riemenl&auml;nge, &Uuml;bersetzungsverh&auml;ltnis und Umschlingungswinkel zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Scheibe 1 Durchmesser D1 (mm)</label><input type="number" id="bl-d1" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Scheibe 2 Durchmesser D2 (mm)</label><input type="number" id="bl-d2" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Achsabstand C (mm)</label><input type="number" id="bl-c" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Antriebsdrehzahl (Scheibe 1, U/min)</label><input type="number" id="bl-rpm" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Offene Riemenl&auml;nge</div>
          <div class="text-5xl font-extrabold font-mono" id="bl-result">0</div>
          <div class="text-sm text-blue-200 mt-1">mm</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gekreuzte Riemenl&auml;nge</div><div class="text-xl font-bold" id="bl-crossed">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Uuml;bersetzungsverh&auml;ltnis</div><div class="text-xl font-bold" id="bl-ratio">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umschlingungswinkel (kl. Scheibe)</div><div class="text-xl font-bold" id="bl-wrap">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abtriebsdrehzahl (Scheibe 2)</div><div class="text-xl font-bold" id="bl-rpm2">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schritt f&uuml;r Schritt</h3>
          <div class="font-mono text-sm space-y-1" id="bl-steps"></div>
        </div>
      </div>
      <ShareButton calculatorId="belt-length" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Riemenl&auml;ngen-Formeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Offen: L = 2C + &pi;(D1+D2)/2 + (D1&minus;D2)&sup2;/(4C)</p>
        <p>Gekreuzt: L = 2C + &pi;(D1+D2)/2 + (D1+D2)&sup2;/(4C)</p>
        <p>&Uuml;bersetzung = D1/D2</p>
        <p>Umschlingungswinkel = 180&deg; &minus; 2&times;sin&sup1;((D2&minus;D1)/(2C))</p>
      </div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBl() {
      const D1 = parseFloat((document.getElementById('bl-d1') as HTMLInputElement).value) || 0;
      const D2 = parseFloat((document.getElementById('bl-d2') as HTMLInputElement).value) || 0;
      const C = parseFloat((document.getElementById('bl-c') as HTMLInputElement).value) || 0;
      const rpm1 = parseFloat((document.getElementById('bl-rpm') as HTMLInputElement).value) || 0;
      const steps: string[] = [];
      let Lopen = 0, Lcrossed = 0;
      if (C > 0) {
        Lopen = 2 * C + Math.PI * (D1 + D2) / 2 + Math.pow(D1 - D2, 2) / (4 * C);
        Lcrossed = 2 * C + Math.PI * (D1 + D2) / 2 + Math.pow(D1 + D2, 2) / (4 * C);
        steps.push(`Offener Riemen = 2C + \u03c0(D1+D2)/2 + (D1\u2212D2)\u00b2/(4C)`);
        steps.push(`= 2\u00d7${C} + \u03c0\u00d7${(D1+D2).toFixed(1).replace('.', ',')}/2 + ${Math.pow(D1-D2,2).toFixed(1).replace('.', ',')}/(4\u00d7${C})`);
        steps.push(`= ${Lopen.toFixed(2).replace('.', ',')} mm`);
        steps.push(`Gekreuzter Riemen = 2C + \u03c0(D1+D2)/2 + (D1+D2)\u00b2/(4C)`);
        steps.push(`= ${Lcrossed.toFixed(2).replace('.', ',')} mm`);
      }
      let speedRatio = 0;
      if (D2 > 0) {
        speedRatio = D1 / D2;
        steps.push(`\u00dcbersetzung = D1/D2 = ${D1}/${D2} = ${speedRatio.toFixed(4).replace('.', ',')}`);
      }
      let wrapDeg = 180;
      if (C > 0 && Math.abs(D2 - D1) < 2 * C) {
        const sinA = Math.abs(D2 - D1) / (2 * C);
        wrapDeg = 180 - 2 * (Math.asin(sinA) * 180 / Math.PI);
        steps.push(`Umschlingungswinkel = 180\u00b0 \u2212 2\u00d7sin\u207b\u00b9(|D2\u2212D1|/(2C)) = ${wrapDeg.toFixed(2).replace('.', ',')}\u00b0`);
      }
      let rpm2 = 0;
      if (D2 > 0) {
        rpm2 = rpm1 * D1 / D2;
        steps.push(`Abtriebsdrehzahl = ${rpm1} \u00d7 ${D1}/${D2} = ${rpm2.toFixed(2).replace('.', ',')} U/min`);
      }
      document.getElementById('bl-result')!.textContent = Lopen.toFixed(2).replace('.', ',');
      document.getElementById('bl-crossed')!.textContent = Lcrossed.toFixed(2).replace('.', ',') + ' mm';
      document.getElementById('bl-ratio')!.textContent = speedRatio.toFixed(4).replace('.', ',') + ' : 1';
      document.getElementById('bl-wrap')!.textContent = wrapDeg.toFixed(2).replace('.', ',') + '\u00b0';
      document.getElementById('bl-rpm2')!.textContent = rpm2.toFixed(2).replace('.', ',') + ' U/min';
      document.getElementById('bl-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bl-d1') as HTMLInputElement).value = '150';
      (document.getElementById('bl-d2') as HTMLInputElement).value = '300';
      (document.getElementById('bl-c') as HTMLInputElement).value = '500';
      (document.getElementById('bl-rpm') as HTMLInputElement).value = '1800';
      document.querySelectorAll('.bl-in').forEach(el => { el.addEventListener('input', calcBl); el.addEventListener('change', calcBl); });
      calcBl();
    }, 50);
  </script>
</CalculatorLayout>
