---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "IELTS-Punkte-Rechner - Gesamtband & CEFR-Niveau";
const description = "Berechnen Sie Ihren IELTS-Gesamtband-Score aus den Einzelabschnittswerten, ermitteln Sie Ihr CEFR-Niveau und überprüfen Sie Universitätsanforderungen.";
const relatedCalcs = [
  { name: "Sprachlernrechner", url: "/language-learning-calculator", description: "Lernstunden." },
  { name: "SAT-Punkte-Rechner", url: "/sat-score-calculator", description: "SAT-Bewertung." },
  { name: "ACT-Punkte-Rechner", url: "/act-score-calculator", description: "ACT-Bewertung." },
  { name: "Lernplanung-Rechner", url: "/spaced-repetition-calculator", description: "Lernplanung." },
  { name: "Stipendium-Rechner", url: "/scholarship-calculator", description: "Stipendien." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozentberechnungen." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie wird der IELTS-Gesamtband berechnet?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der IELTS-Gesamtband ist der Durchschnitt der vier Abschnittswerte (Hören, Lesen, Schreiben, Sprechen), gerundet auf die nächste 0,5. Bei Werten von 7,0; 6,5; 6,0; 6,5 ergibt sich ein Durchschnitt von 6,5." }
    },
    {
      "@type": "Question",
      "name": "Welchen IELTS-Score brauche ich für eine deutsche Universität?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die meisten deutschen Universitäten akzeptieren englischsprachige Studiengänge mit einem IELTS-Score von 6,0–6,5. Spitzenprogramme können 7,0 oder höher verlangen." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="IELTS-Punkte-Rechner" lang="de" keywords="ielts rechner, ielts band score, ielts gesamtpunktzahl, cefr niveau, ielts universitätsanforderung" breadcrumbs={[{ name: "IELTS-Punkte-Rechner", url: "/de/ielts-punkte-rechner" }]} enSlug="ielts-score-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">IELTS-Punkte-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren IELTS-Gesamtband und überprüfen Sie, ob Sie die Universitätsanforderungen erfüllen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hörverstehen (Band)</label><input type="number" id="il-listen" class="il-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7.0" min="0" max="9" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Leseverstehen (Band)</label><input type="number" id="il-read" class="il-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6.5" min="0" max="9" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schreiben (Band)</label><input type="number" id="il-write" class="il-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6.0" min="0" max="9" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sprechen (Band)</label><input type="number" id="il-speak" class="il-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6.5" min="0" max="9" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtband-Score</div>
          <div class="text-5xl font-extrabold font-mono" id="il-overall">0</div>
          <div class="text-sm text-blue-200 mt-1">von 9,0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CEFR-Niveau</div><div class="text-xl font-bold" id="il-cefr">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sprachniveau</div><div class="text-xl font-bold" id="il-skill">-</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Universitätsanforderungen prüfen</h3>
          <div class="space-y-2" id="il-reqs"></div>
        </div>
      </div>
      <ShareButton calculatorId="ielts-punkte" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">IELTS-Bewertungssystem erklärt</h2>
      <p>IELTS-Scores reichen von 0–9 in Halbband-Schritten. Der Gesamtband ist der Durchschnitt der vier Abschnitte, gerundet auf die nächste 0,5. Die meisten Universitäten verlangen 6,0–7,5 insgesamt mit Mindestpunktzahlen pro Abschnitt.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie wird der IELTS-Gesamtband berechnet?</h4>
      <p>Der IELTS-Gesamtband ist der Durchschnitt der vier Abschnittswerte, gerundet auf die nächste 0,5.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Welchen IELTS-Score brauche ich für eine deutsche Universität?</h4>
      <p>Die meisten deutschen Universitäten für englischsprachige Studiengänge verlangen 6,0–6,5. Spitzenprogramme können 7,0 oder höher verlangen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcIL() {
      const listen = parseFloat((document.getElementById('il-listen') as HTMLInputElement).value) || 0;
      const read = parseFloat((document.getElementById('il-read') as HTMLInputElement).value) || 0;
      const write = parseFloat((document.getElementById('il-write') as HTMLInputElement).value) || 0;
      const speak = parseFloat((document.getElementById('il-speak') as HTMLInputElement).value) || 0;
      const avg = (listen + read + write + speak) / 4;
      const overall = Math.round(avg * 2) / 2;
      let cefr: string;
      let skill: string;
      if (overall >= 8.5) { cefr = 'C2'; skill = 'Experte'; }
      else if (overall >= 7.0) { cefr = 'C1'; skill = 'Sehr gut'; }
      else if (overall >= 5.5) { cefr = 'B2'; skill = 'Gut'; }
      else if (overall >= 4.0) { cefr = 'B1'; skill = 'Fortgeschritten'; }
      else if (overall >= 3.0) { cefr = 'A2'; skill = 'Grundkenntnisse'; }
      else { cefr = 'A1'; skill = 'Anfänger'; }
      document.getElementById('il-overall')!.textContent = overall.toFixed(1);
      document.getElementById('il-cefr')!.textContent = cefr;
      document.getElementById('il-skill')!.textContent = skill;
      const minSection = Math.min(listen, read, write, speak);
      const reqs = [
        { name: 'Top-Universitäten (Oxford, MIT)', overall: 7.5, section: 7.0 },
        { name: 'Die meisten US/UK-Universitäten', overall: 6.5, section: 6.0 },
        { name: 'Grundstufenprogramme', overall: 5.5, section: 5.0 },
        { name: 'Einwanderung (Kanada/Australien)', overall: 6.0, section: 6.0 },
      ];
      const reqsHTML = reqs.map(r => {
        const meetsOverall = overall >= r.overall;
        const meetsSection = minSection >= r.section;
        const pass = meetsOverall && meetsSection;
        const status = pass ? 'text-green-600' : 'text-red-500';
        const label = pass ? 'Anforderung erfüllt' : 'Unter Anforderung';
        return '<div class="flex justify-between items-center py-1 border-b border-border last:border-0"><span class="text-sm">' + r.name + ' (' + r.overall + '+)</span><span class="text-sm font-bold ' + status + '">' + label + '</span></div>';
      }).join('');
      document.getElementById('il-reqs')!.innerHTML = reqsHTML;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.il-in').forEach(el => { el.addEventListener('input', calcIL); el.addEventListener('change', calcIL); }); calcIL(); }, 50);
  </script>
</CalculatorLayout>
