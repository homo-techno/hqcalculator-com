---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "LED-Einsparrechner";
const description = "Berechnen Sie Ihre jährlichen Stromeinsparungen durch Umstieg auf LED-Beleuchtung.";

const relatedCalcs = [
  { name: "LED-Widerstand Rechner", url: "/de/led-widerstand-rechner", description: "Vorwiderstand berechnen." },
  { name: "Gartenbeleuchtung Rechner", url: "/de/gartenbeleuchtung-rechner", description: "Gartenbeleuchtung planen." },
  { name: "Wäschereikosten Rechner", url: "/de/waescherei-kosten-rechner", description: "Betriebskosten senken." },
  { name: "Akkulaufzeit-Rechner", url: "/de/akkulaufzeit-rechner", description: "Akkulaufzeit berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="LED-Einsparrechner" lang="de" enSlug="led-savings-calculator" keywords="led einsparrechner, led stromeinsparung, glühbirne auf led umstieg, beleuchtungskosten senken" breadcrumbs={[{ name: "LED-Einsparrechner", url: "/de/led-ersparnis-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">LED-Einsparrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie viel Strom und Geld Sie durch den Umstieg von herkömmlichen Leuchtmitteln auf LED-Lampen sparen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Leuchtmittel</label><input type="number" id="ler-count" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Betriebsstunden/Tag</label><input type="number" id="ler-hours" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.5" max="24" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bisheriger Typ</label><select id="ler-old-type" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="60">Glühbirne 60 W</option>
            <option value="100">Glühbirne 100 W</option>
            <option value="20">Energiesparlampe 20 W</option>
            <option value="50">Halogen 50 W</option>
            <option value="35">Halogen 35 W</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Alte Wattage (W)</label><input type="number" id="ler-old-w" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Neue LED-Wattage (W)</label><input type="number" id="ler-new-w" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (€/kWh)</label><input type="number" id="ler-price" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.32" min="0.01" step="0.01"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Preis LED-Lampe (€/Stück)</label><input type="number" id="ler-led-cost" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.00" min="0.50" step="0.50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">LED-Lebensdauer (Stunden)</label><input type="number" id="ler-life" class="ler-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25000" min="1000" step="1000"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jährliche Stromeinsparung</div>
          <div class="text-4xl font-extrabold font-mono" id="ler-annual-save">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einsparung kWh/Jahr</div><div class="text-xl font-bold" id="ler-kwh-save">0 kWh</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CO₂-Einsparung/Jahr</div><div class="text-xl font-bold" id="ler-co2">0 kg</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Investitionskosten</div><div class="text-xl font-bold" id="ler-invest">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Amortisationszeit</div><div class="text-xl font-bold" id="ler-payback">0 Monate</div></div>
        </div>
      </div>
      <ShareButton calculatorId="led-savings-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">LED-Umstieg – eine der lohnendsten Energiesparmaßnahmen</h2>
      <p>Der Umstieg auf LED-Beleuchtung ist eine der effektivsten Maßnahmen zur Reduzierung des Haushaltsstromverbrauchs. Moderne LEDs verbrauchen bis zu 85 % weniger Energie als Glühbirnen und bis zu 50 % weniger als Energiesparlampen. Gleichzeitig haben LEDs eine Lebensdauer von 15.000–50.000 Stunden, während Glühbirnen nur 1.000–2.000 Stunden halten. Für einen typischen Haushalt mit 20 Leuchtmitteln amortisiert sich die Investition meist innerhalb von 1–2 Jahren.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche LED ersetzt eine 60-Watt-Glühbirne?</strong> Eine LED mit 8–9 Watt erzeugt denselben Lichtstrom (ca. 800 Lumen) wie eine 60-Watt-Glühbirne. Das entspricht einer Einsparung von über 85 %.</p>
      <p><strong>Sind LED-Lampen sofort hell?</strong> Moderne LEDs erreichen sofort volle Helligkeit. Ältere Modelle hatten teils eine kurze Anlaufzeit, dies ist bei aktuellen Produkten nicht mehr der Fall.</p>
      <p><strong>Können LEDs gedimmt werden?</strong> Ja, aber es werden spezielle "dimmbare LED"-Lampen und kompatible LED-Dimmer benötigt. Herkömmliche Phasendimmer sind oft nicht kompatibel.</p>
      <p><strong>Wie hoch ist die CO₂-Einsparung?</strong> Der deutsche Strommix emittiert ca. 400–500 g CO₂ pro kWh. Durch Senkung des Verbrauchs reduzieren Sie Ihren ökologischen Fußabdruck messbar.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const lerFmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
    function calcLER() {
      const oldTypeSel = (document.getElementById('ler-old-type') as HTMLSelectElement).value;
      const oldWInput = document.getElementById('ler-old-w') as HTMLInputElement;
      if (oldTypeSel) oldWInput.value = oldTypeSel;
      const count = parseFloat((document.getElementById('ler-count') as HTMLInputElement).value) || 0;
      const hours = parseFloat((document.getElementById('ler-hours') as HTMLInputElement).value) || 0;
      const oldW = parseFloat(oldWInput.value) || 0;
      const newW = parseFloat((document.getElementById('ler-new-w') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('ler-price') as HTMLInputElement).value) || 0;
      const ledCost = parseFloat((document.getElementById('ler-led-cost') as HTMLInputElement).value) || 0;
      const lifeHours = parseFloat((document.getElementById('ler-life') as HTMLInputElement).value) || 25000;
      const hoursPerYear = hours * 365;
      const oldKwhYear = count * oldW / 1000 * hoursPerYear;
      const newKwhYear = count * newW / 1000 * hoursPerYear;
      const saveKwh = oldKwhYear - newKwhYear;
      const saveMoney = saveKwh * price;
      const co2 = saveKwh * 0.45;
      const invest = count * ledCost;
      const paybackMonths = saveMoney > 0 ? (invest / saveMoney) * 12 : 0;
      document.getElementById('ler-annual-save')!.textContent = lerFmt(saveMoney);
      document.getElementById('ler-kwh-save')!.textContent = saveKwh.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' kWh';
      document.getElementById('ler-co2')!.textContent = co2.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' kg';
      document.getElementById('ler-invest')!.textContent = lerFmt(invest);
      document.getElementById('ler-payback')!.textContent = Math.ceil(paybackMonths).toLocaleString('de-DE') + ' Monate';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.ler-in').forEach(el => { el.addEventListener('input', calcLER); el.addEventListener('change', calcLER); }); calcLER(); }, 50);
  </script>
</CalculatorLayout>
