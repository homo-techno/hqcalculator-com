---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Rechtsanwaltsgebühren Rechner – Anwalts- & Gerichtskosten";
const description = "Ermitteln Sie Anwaltsgebühren und Gerichtskosten nach deutschem Recht. Streitwert, Instanz und Gebührenart auswählen.";
const relatedCalcs = [
  { name: "Anwaltskostenrechner", url: "/de/anwaltskosten-rechner", description: "RVG Gebühren." },
  { name: "Prozesskostenrechner", url: "/de/prozesskosten-rechner", description: "Gerichtskosten." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="legal-fee-calculator" calculatorName="Rechtsanwaltsgebühren Rechner" keywords="Rechtsanwaltsgebühren, Anwaltskosten, Gerichtskosten, RVG, GKG" breadcrumbs={[{ name: "Rechtsanwaltsgebühren", url: "/de/rechtsanwaltsgebuehren-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Rechtsanwaltsgebühren Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Anwalts- und Gerichtsgebühren nach deutschem Recht schnell und einfach berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Streitwert (€)</label>
          <input type="number" id="rag-streitwert" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Verfahrensart</label>
          <select id="rag-art" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="ausser">Außergerichtliche Beratung</option>
            <option value="erstinstanz" selected>Erstinstanzliches Verfahren</option>
            <option value="berufung">Berufung</option>
            <option value="revision">Revision</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten (inkl. MwSt.)</div>
          <div class="text-5xl font-extrabold font-mono" id="rag-result">0,00 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="rag-details"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Kostenzusammenfassung</h3>
          <div id="rag-summary" class="text-sm text-text-secondary"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="rechtsanwaltsgebuehren" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Rechtsanwaltsgebühren in Deutschland</h2>
      <p>In Deutschland werden Anwaltsgebühren durch das Rechtsanwaltsvergütungsgesetz (RVG) geregelt. Zusätzlich fallen Gerichtskosten nach dem Gerichtskostengesetz (GKG) an. Die Höhe beider Kostenarten richtet sich nach dem Streitwert der jeweiligen Angelegenheit. Für ein Ersturteil vor dem Amtsgericht fallen beispielsweise eine Verfahrens- und eine Terminsgebühr an.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was sind Gerichtsgebühren nach GKG?</summary>
          <p class="mt-2 text-sm text-text-secondary">Das Gerichtskostengesetz (GKG) regelt die Gebühren für staatliche Gerichte. Sie werden in Gerichtsgebühreneinheiten (GE) berechnet, deren Höhe ebenfalls vom Streitwert abhängt.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen Verfahrens- und Terminsgebühr?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die Verfahrensgebühr entsteht für die allgemeine Bearbeitung des Mandats. Die Terminsgebühr fällt zusätzlich an, wenn ein mündlicher Verhandlungstermin stattfindet.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was kostet ein Anwalt für ein Erstgespräch?</summary>
          <p class="mt-2 text-sm text-text-secondary">Das Erstgespräch ist seit 2021 nicht mehr gesetzlich gedeckelt. Viele Anwälte berechnen 190–250 € für eine Erstberatungsstunde, andere bieten kostenlose Erstgespräche an.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Übernimmt die Rechtsschutzversicherung diese Kosten?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ja, eine Rechtsschutzversicherung übernimmt in der Regel die Anwalts- und Gerichtskosten bis zur vereinbarten Versicherungssumme, sofern der Rechtsschutzfall versichert ist.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcRAG() {
      const streitwert = parseFloat((document.getElementById('rag-streitwert') as HTMLInputElement).value) || 0;
      const art = (document.getElementById('rag-art') as HTMLSelectElement).value;

      // Grundgebühr nach §13 RVG (vereinfacht)
      function grundgebuehr(sw: number): number {
        if (sw <= 500) return 49;
        if (sw <= 1000) return 88;
        if (sw <= 2000) return 166;
        if (sw <= 3000) return 222;
        if (sw <= 5000) return 334;
        if (sw <= 10000) return 614;
        if (sw <= 20000) return 978;
        if (sw <= 30000) return 1219;
        if (sw <= 50000) return 1763;
        if (sw <= 100000) return 2641;
        return 2641 + Math.floor((sw - 100000) / 50000) * 519;
      }

      const gg = grundgebuehr(streitwert);
      let anwaltNetto = 0;
      let gerichtNetto = 0;
      let beschreibung = '';

      if (art === 'ausser') {
        anwaltNetto = gg * 1.3 + Math.min(gg * 0.2, 20);
        beschreibung = 'Geschäftsgebühr 1,3 + Auslagenpauschale';
      } else if (art === 'erstinstanz') {
        anwaltNetto = gg * 1.3 + gg * 1.2 + Math.min(gg * 0.2, 20);
        gerichtNetto = gg * 3.0;
        beschreibung = 'Verfahrensgebühr 1,3 + Terminsgebühr 1,2 + Gerichtskosten 3,0 GE';
      } else if (art === 'berufung') {
        anwaltNetto = gg * 1.6 + gg * 1.3 + Math.min(gg * 0.2, 20);
        gerichtNetto = gg * 4.0;
        beschreibung = 'Verfahrensgebühr 1,6 + Terminsgebühr 1,3 + Gerichtskosten 4,0 GE';
      } else {
        anwaltNetto = gg * 2.0 + gg * 1.5 + Math.min(gg * 0.2, 20);
        gerichtNetto = gg * 5.0;
        beschreibung = 'Verfahrensgebühr 2,0 + Terminsgebühr 1,5 + Gerichtskosten 5,0 GE';
      }

      const anwaltBrutto = anwaltNetto * 1.19;
      const gesamtBrutto = anwaltBrutto + gerichtNetto;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

      document.getElementById('rag-result')!.textContent = fmt(gesamtBrutto);
      document.getElementById('rag-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anwaltskosten netto</div><div class="text-lg font-bold font-mono">${fmt(anwaltNetto)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anwaltskosten brutto</div><div class="text-lg font-bold font-mono">${fmt(anwaltBrutto)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gerichtskosten</div><div class="text-lg font-bold font-mono">${fmt(gerichtNetto)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundgebühr (1,0)</div><div class="text-lg font-bold font-mono">${fmt(gg)}</div></div>
      `;
      document.getElementById('rag-summary')!.textContent = beschreibung;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('rag-streitwert')!.addEventListener('input', calcRAG);
      document.getElementById('rag-art')!.addEventListener('change', calcRAG);
      calcRAG();
    }, 50);
  </script>
</CalculatorLayout>
