---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zaunlinie-Rechner - Material, Pfosten & Kosten";
const description = "Berechnen Sie Zaunmaterialien aus der Gesamtlänge. Pfostenanzahl, Abstände, Drahtstränge, Toröffnungen und Installationskosten.";
const relatedCalcs = [
  { name: "Zaunpfosten-Rechner", url: "/de/zaunpfosten-rechner", description: "Pfostenabstand und Anzahl." },
  { name: "Zaun-Rechner", url: "/de/zaun-rechner", description: "Zaun-Materialschätzung." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
  { name: "Dünger-Rechner", url: "/de/duenger-rechner", description: "Düngerbedarf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Zaunlinie-Rechner" lang="de" enSlug="fence-line-calculator" keywords="zaunlinie rechner, zaun material, pfostenanzahl, drahtzaun, zaun kosten, toröffnungen, weidezaun" breadcrumbs={[{ name: "Zaunlinie", url: "/de/zaunlinie-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zaunlinie-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie alle Materialien und Kosten für die Zauninstallation.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesamtlänge (Meter)</label><input type="number" id="zlde-len" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="800" min="3" max="30000" step="10"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zauntyp</label>
            <select id="zlde-type" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="5|0.80|2.50">Stacheldraht 5-strängig</option>
              <option value="4|0.80|2.50" selected>Stacheldraht 4-strängig</option>
              <option value="3|0.80|2.50">Stacheldraht 3-strängig</option>
              <option value="1|0|5.00">Knotengitter / Wildzaun</option>
              <option value="3|1.30|4.00">Hochspannung 3-strängig</option>
              <option value="5|1.30|4.00">Hochspannung 5-strängig</option>
              <option value="3|2.00|6.00">Elektrozaun 3-strängig</option>
              <option value="1|0|8.00">Holzzaun (3-Riegel)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Pfostenabstand (Meter)</label><input type="number" id="zlde-spacing" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="1" max="10" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Pfostenkosten (&euro;/St&uuml;ck)</label><input type="number" id="zlde-postcost" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="0.50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eck-/Streben-Pfosten</label><input type="number" id="zlde-corners" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" max="50" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Eckpfosten-Kosten (&euro;)</label><input type="number" id="zlde-cornercost" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tor&ouml;ffnungen</label><input type="number" id="zlde-gates" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Torkosten (&euro;/St&uuml;ck)</label><input type="number" id="zlde-gatecost" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="0" step="5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Arbeitskosten (&euro;/Meter)</label><input type="number" id="zlde-labor" class="zlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="0.50"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten Zaun</div>
          <div class="text-5xl font-extrabold font-mono" id="zlde-total">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Linienpfosten</div><div class="text-xl font-bold font-mono" id="zlde-posts">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Draht/Material (m)</div><div class="text-xl font-bold font-mono" id="zlde-wire">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Meter</div><div class="text-xl font-bold font-mono" id="zlde-perft">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten</div><div class="text-xl font-bold font-mono" id="zlde-matcost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Arbeitskosten</div><div class="text-xl font-bold font-mono" id="zlde-labcost">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fence-line-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zaunlinie planen</h2>
      <p>Die Zaunkosten setzen sich aus Pfosten, Draht/Material, Toren und Arbeitskosten zusammen. Stacheldraht ist für Weidezäune am verbreitetsten, Elektrozäune bieten flexiblere Lösungen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welcher Pfostenabstand ist optimal?</strong> Für Stacheldraht 2-3 Meter, für Elektrozäune bis zu 5 Meter möglich.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcZLDE() {
      const totalLen = parseFloat((document.getElementById('zlde-len') as HTMLInputElement).value) || 800;
      const fenceData = (document.getElementById('zlde-type') as HTMLSelectElement).value.split('|');
      const strands = parseInt(fenceData[0]);
      const matPerM = parseFloat(fenceData[2]);
      const postSpacing = parseFloat((document.getElementById('zlde-spacing') as HTMLInputElement).value) || 2.5;
      const postCost = parseFloat((document.getElementById('zlde-postcost') as HTMLInputElement).value) || 0;
      const corners = parseInt((document.getElementById('zlde-corners') as HTMLInputElement).value) || 0;
      const cornerCost = parseFloat((document.getElementById('zlde-cornercost') as HTMLInputElement).value) || 0;
      const gates = parseInt((document.getElementById('zlde-gates') as HTMLInputElement).value) || 0;
      const gateCost = parseFloat((document.getElementById('zlde-gatecost') as HTMLInputElement).value) || 0;
      const laborRate = parseFloat((document.getElementById('zlde-labor') as HTMLInputElement).value) || 0;
      const gateWidth = gates * 4;
      const fenceLen = Math.max(0, totalLen - gateWidth);
      const linePosts = Math.ceil(fenceLen / postSpacing) + 1;
      const wireLength = fenceLen * strands;
      const postTotal = linePosts * postCost;
      const cornerTotal = corners * cornerCost;
      const gateTotal = gates * gateCost;
      const materialsCost = postTotal + cornerTotal + gateTotal + (fenceLen * matPerM);
      const laborCost = totalLen * laborRate;
      const totalCost = materialsCost + laborCost;
      const costPerM = totalLen > 0 ? totalCost / totalLen : 0;
      const fmtEur = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('zlde-total')!.textContent = fmtEur(totalCost);
      document.getElementById('zlde-posts')!.textContent = linePosts.toLocaleString('de-DE');
      document.getElementById('zlde-wire')!.textContent = Math.round(wireLength).toLocaleString('de-DE');
      document.getElementById('zlde-perft')!.textContent = costPerM.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('zlde-matcost')!.textContent = fmtEur(materialsCost);
      document.getElementById('zlde-labcost')!.textContent = fmtEur(laborCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zlde-in').forEach(el => { el.addEventListener('input', calcZLDE); el.addEventListener('change', calcZLDE); });
      calcZLDE();
    }, 50);
  </script>
</CalculatorLayout>
