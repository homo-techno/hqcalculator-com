---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Musik-Intervall Rechner - Halbtöne, Frequenzen & Intervallnamen";
const description = "Berechnen und identifizieren Sie musikalische Intervalle, Halbtöne und Frequenzverhältnisse für alle Noten.";
const relatedCalcs = [
  { name: "Musik-Tonart Rechner", url: "/de/musik-tonart-rechner", description: "Tonarten ermitteln." },
  { name: "Akkord Rechner", url: "/de/akkord-rechner", description: "Akkorde berechnen." },
  { name: "Newton-Verfahren Rechner", url: "/de/newton-verfahren-rechner", description: "Mathematik." },
  { name: "Namen Generator", url: "/de/namen-generator", description: "Namen generieren." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Musik-Intervall Rechner" enSlug="music-interval-calculator" keywords="Musikintervall, Halbtöne, Frequenzverhältnis, Musiktheorie, Prime Oktave Quinte" breadcrumbs={[{ name: "Musik-Intervall Rechner", url: "/de/musik-intervall-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Musik-Intervall Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Wählen Sie zwei Noten und berechnen Sie das Intervall, die Anzahl der Halbtöne und das Frequenzverhältnis.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Grundton</label>
            <select id="mi-root" class="mi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0">C</option><option value="1">C# / Db</option><option value="2">D</option>
              <option value="3">D# / Eb</option><option value="4">E</option><option value="5">F</option>
              <option value="6">F# / Gb</option><option value="7">G</option><option value="8">G# / Ab</option>
              <option value="9">A</option><option value="10">A# / Bb</option><option value="11">H</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Oberton</label>
            <select id="mi-top" class="mi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0">C</option><option value="1">C# / Db</option><option value="2">D</option>
              <option value="3">D# / Eb</option><option value="4">E</option><option value="5">F</option>
              <option value="6">F# / Gb</option><option value="7" selected>G</option><option value="8">G# / Ab</option>
              <option value="9">A</option><option value="10">A# / Bb</option><option value="11">H</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Grundfrequenz (Hz)</label><input type="number" id="mi-freq" class="mi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="261.63" min="20" step="0.01"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Intervall</div>
          <div class="text-4xl font-extrabold font-mono" id="mi-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="mi-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Halbtöne</div><div class="text-xl font-bold" id="mi-semitones">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Frequenzverhältnis</div><div class="text-xl font-bold" id="mi-ratio">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Obertonfrequenz</div><div class="text-xl font-bold" id="mi-topfreq">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Konsonanz</div><div class="text-xl font-bold" id="mi-consonance">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="musik-intervall" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Musikalische Intervalle verstehen</h2>
      <p>Ein Intervall ist der Abstand zwischen zwei Tönen. Im gleichstufigen Tonsystem (12-TET) wird die Oktave in 12 gleiche Halbtöne unterteilt. Das Frequenzverhältnis eines Halbtons beträgt 2^(1/12) ≈ 1,0595. Eine reine Quinte (7 Halbtöne) hat ein Verhältnis von ca. 1,498.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was sind konsonante Intervalle?</strong></p><p>Konsonante Intervalle klingen harmonisch zusammen: Prime (0), Oktave (12), Quinte (7), Quarte (5), Terzen (3/4) und Sexten (8/9) Halbtöne.</p></div>
        <div><p><strong>Was ist der Unterschied zwischen Dur- und Mollterz?</strong></p><p>Die große Terz (Dur) hat 4 Halbtöne, die kleine Terz (Moll) nur 3. Dieser Unterschied bestimmt, ob ein Akkord dur oder moll klingt.</p></div>
        <div><p><strong>Wie berechnet man die Frequenz eines Tons?</strong></p><p>f₂ = f₁ × 2^(n/12), wobei n die Anzahl der Halbtöne ist. A4 = 440 Hz, A5 = 880 Hz (12 Halbtöne = Oktave = Faktor 2).</p></div>
        <div><p><strong>Was ist ein Tritonus?</strong></p><p>Der Tritonus (6 Halbtöne) gilt als das dissonanteste Intervall. Er teilt die Oktave genau in der Mitte und klingt spannungsgeladen.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const INTERVAL_NAMES: string[] = [
      'Prime (unisono)', 'kleine Sekunde', 'große Sekunde', 'kleine Terz',
      'große Terz', 'reine Quarte', 'Tritonus', 'reine Quinte',
      'kleine Sexte', 'große Sexte', 'kleine Septime', 'große Septime', 'Oktave'
    ];
    const CONSONANCE: string[] = [
      'vollkommen konsonant', 'stark dissonant', 'mäßig dissonant', 'konsonant',
      'konsonant', 'konsonant', 'dissonant', 'vollkommen konsonant',
      'konsonant', 'konsonant', 'dissonant', 'mäßig dissonant', 'vollkommen konsonant'
    ];
    function calcMI() {
      const root = parseInt((document.getElementById('mi-root') as HTMLSelectElement).value) || 0;
      const top = parseInt((document.getElementById('mi-top') as HTMLSelectElement).value) || 0;
      const baseFreq = parseFloat((document.getElementById('mi-freq') as HTMLInputElement).value) || 261.63;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      let semitones = (top - root + 12) % 12;
      const ratio = Math.pow(2, semitones / 12);
      const topFreq = baseFreq * ratio;
      const name = INTERVAL_NAMES[semitones] || 'Unbekannt';
      const consonance = CONSONANCE[semitones] || '—';
      document.getElementById('mi-result')!.textContent = name;
      document.getElementById('mi-sub')!.textContent = semitones + ' Halbton' + (semitones !== 1 ? 'e' : '');
      document.getElementById('mi-semitones')!.textContent = semitones.toString();
      document.getElementById('mi-ratio')!.textContent = fmt(ratio, 4) + ':1';
      document.getElementById('mi-topfreq')!.textContent = fmt(topFreq) + ' Hz';
      document.getElementById('mi-consonance')!.textContent = consonance;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mi-in').forEach(el => { el.addEventListener('input', calcMI); el.addEventListener('change', calcMI); });
      calcMI();
    }, 50);
  </script>
</CalculatorLayout>
