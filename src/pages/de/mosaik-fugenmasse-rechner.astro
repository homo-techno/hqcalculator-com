---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mosaik-Fugenmasse Rechner - Fugenmasse für Mosaik berechnen";
const description = "Berechnen Sie die benötigte Fugenmasse für Mosaik- und Fliesenarbeiten. Mit Fugenbreite, Fliesengröße und verschiedenen Fugenmaterialien.";

const relatedCalcs = [
  { name: "Mosaik-Fliesen Rechner", url: "/de/mosaik-fliesen-rechner", description: "Fliesenmengen berechnen." },
  { name: "Mörtelrechner", url: "/de/moertel-rechner", description: "Mörtel berechnen." },
  { name: "Fliesen-Rechner", url: "/de/fliesenrechner", description: "Fliesen berechnen." },
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Fläche berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mosaic-grout-calculator" calculatorName="Mosaik-Fugenmasse Rechner" keywords="Fugenmasse Rechner, Mosaik Fugenmasse, Fugenmaterial berechnen, Fliesengrout, Fugenbreite" breadcrumbs={[{ name: "Mosaik-Fugenmasse Rechner", url: "/de/mosaik-fugenmasse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mosaik-Fugenmasse Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie präzise die benötigte Menge an Fugenmasse für Ihre Mosaik- und Fliesenprojekte – damit Sie nicht zu viel kaufen und nichts fehlt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gesamtfläche (m²)</label>
          <input type="number" id="fg-area" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="5">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fliesenbreite (mm)</label>
            <input type="number" id="fg-fw" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="5" value="25">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fliesenhöhe (mm)</label>
            <input type="number" id="fg-fh" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="5" value="25">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fliesendicke (mm)</label>
            <input type="number" id="fg-ft" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="1" value="4">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fugenbreite (mm)</label>
            <input type="number" id="fg-gw" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0.5" value="2">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Fugenmassen-Typ</label>
          <select id="fg-type" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="1.5">Standardfugenmasse (1,5 kg/L)</option>
            <option value="1.7">Epoxidfugenmasse (1,7 kg/L)</option>
            <option value="1.3">Flexible Fugenmasse (1,3 kg/L)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Zuschlag für Verluste (%)</label>
          <input type="number" id="fg-waste" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="5" min="0" max="30" value="10">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Fugenmasse</div>
          <div class="text-5xl font-extrabold font-mono" id="fg-result">— kg</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fugenmasse (netto)</div>
            <div class="text-xl font-bold" id="fg-net">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mit Verlust (brutto)</div>
            <div class="text-xl font-bold" id="fg-gross">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fugenvolumen (L)</div>
            <div class="text-xl font-bold" id="fg-vol">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fugenanteil (%)</div>
            <div class="text-xl font-bold" id="fg-pct">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnung</h3>
          <div class="font-mono text-sm space-y-1" id="fg-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mosaic-grout" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Fugenmasse für Mosaikarbeiten</h2>
      <p>Die Fugenmasse (Grout) füllt die Zwischenräume zwischen Mosaiktesseras oder Fliesen. Sie schützt den Unterkleber vor Feuchtigkeit, verleiht dem Mosaik Stabilität und ist ein wichtiges optisches Gestaltungselement. Die benötigte Menge hängt von Fliesengröße, Fugenbreite und Schichtdicke ab.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Fugenvolumen = Fläche × Fliesendicke × Fugenanteil</p>
        <p>Fugenanteil = 1 - (Fliesenbreite × Fliesenhöhe) / ((Breite+Fuge) × (Höhe+Fuge))</p>
        <p>Masse = Volumen × Dichte</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen Epoxid- und Zementfugenmasse?</p>
          <p>Zementfugenmasse ist günstig, einfach zu verarbeiten und gut für trockene Bereiche. Epoxidfugenmasse ist wasserabweisend, chemikalienresistent und besonders gut für Küche und Bad geeignet. Sie ist teurer und schwieriger zu verarbeiten.</p>
        </div>
        <div>
          <p class="font-semibold">Wie breit sollten Fugen bei Mosaikarbeiten sein?</p>
          <p>Bei kleinen Mosaiktesseras (5-20 mm): 1-3 mm Fugen. Bei mittelgroßen Fliesen (20-100 mm): 2-5 mm. Bei großen Fliesen: 3-8 mm. Breitere Fugen bieten mehr Toleranz bei Unebenheiten, schmalere wirken eleganter.</p>
        </div>
        <div>
          <p class="font-semibold">Wann sollte die Fugenmasse aufgetragen werden?</p>
          <p>Erst wenn der Kleberunterlagemortel/Kleber vollständig ausgehärtet ist – in der Regel nach 24-48 Stunden. Bei Epoxidfugenmasse ist die Verarbeitungszeit (pot life) nach Anmischen begrenzt: meist 30-60 Minuten.</p>
        </div>
        <div>
          <p class="font-semibold">Wie reinigt man überschüssige Fugenmasse?</p>
          <p>Zementfugenmasse: Innerhalb von 15-30 Minuten mit feuchtem Schwamm abwischen. Nach dem Aushärten nur noch mit speziellem Fugenreiniger oder verdünnter Salzsäure entfernen. Epoxidfuge: sofort mit Spezialreiniger, nach Aushärtung kaum entfernbar.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcFg() {
      const area = parseFloat((document.getElementById('fg-area') as HTMLInputElement).value) || 0;
      const fw = parseFloat((document.getElementById('fg-fw') as HTMLInputElement).value) || 25;
      const fh = parseFloat((document.getElementById('fg-fh') as HTMLInputElement).value) || 25;
      const ft = parseFloat((document.getElementById('fg-ft') as HTMLInputElement).value) || 4;
      const gw = parseFloat((document.getElementById('fg-gw') as HTMLInputElement).value) || 2;
      const density = parseFloat((document.getElementById('fg-type') as HTMLSelectElement).value) || 1.5;
      const waste = parseFloat((document.getElementById('fg-waste') as HTMLInputElement).value) || 10;

      const fmt = (v: number, dec = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });

      // Joint fraction
      const pitchW = fw + gw;
      const pitchH = fh + gw;
      const tileArea = fw * fh;
      const pitchArea = pitchW * pitchH;
      const jointFraction = 1 - tileArea / pitchArea;

      // Volume of grout in liters
      const areaMm2 = area * 1e6;
      const groutVolMm3 = areaMm2 * (ft) * jointFraction;
      const groutVolL = groutVolMm3 / 1e6;

      const netMass = groutVolL * density;
      const grossMass = netMass * (1 + waste / 100);

      const steps: string[] = [];
      steps.push(`Fugenanteil = 1 - (${fw}×${fh}) / ((${fw}+${gw})×(${fh}+${gw})) = ${fmt(jointFraction * 100, 1)}%`);
      steps.push(`Fugenvolumen = ${fmt(area)} m² × ${ft} mm × ${fmt(jointFraction * 100, 1)}%`);
      steps.push(`= ${fmt(groutVolL)} L`);
      steps.push(`Netto-Masse = ${fmt(groutVolL)} L × ${density} kg/L = ${fmt(netMass)} kg`);
      steps.push(`Brutto (+${waste}% Verlust) = ${fmt(grossMass)} kg`);

      document.getElementById('fg-result')!.textContent = fmt(grossMass) + ' kg';
      document.getElementById('fg-net')!.textContent = fmt(netMass) + ' kg';
      document.getElementById('fg-gross')!.textContent = fmt(grossMass) + ' kg';
      document.getElementById('fg-vol')!.textContent = fmt(groutVolL) + ' L';
      document.getElementById('fg-pct')!.textContent = fmt(jointFraction * 100, 1) + '%';
      document.getElementById('fg-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.fg-in').forEach(el => {
        el.addEventListener('input', calcFg);
        el.addEventListener('change', calcFg);
      });
      calcFg();
    }, 50);
  </script>
</CalculatorLayout>
