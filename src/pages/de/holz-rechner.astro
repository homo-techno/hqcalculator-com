---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Holzrechner – Holzmengen, Kosten und Verschnitt berechnen";
const description = "Berechnen Sie Holzmengen, Kosten und Verschnitt für Bauprojekte. Laufmeter, Kubikmeter und Quadratmeter auf einen Blick.";

const relatedCalcs = [
  { name: "Grundstücks-Bebauungsrechner", url: "/de/grundstuecks-bebauung-rechner", description: "GRZ berechnen." },
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Flächen berechnen." },
  { name: "Instandhaltungsrücklage", url: "/de/instandhaltungsruecklage-rechner", description: "Rücklage." },
  { name: "Makramee Rechner", url: "/de/makramee-rechner", description: "Garnmengen." },
];
---
<CalculatorLayout lang="de" enSlug="lumber-calculator" title={title} description={description} calculatorName="Holzrechner" keywords="Holzrechner, Holzmenge berechnen, Bauholz Kosten, Verschnitt, Kubikmeter Holz" breadcrumbs={[{ name: "Holzrechner", url: "/de/holz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Holzrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Holzmengen, Kubikmeter, Kosten und Verschnitt für Ihr Bauprojekt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Länge (m)</label>
            <input type="number" id="hz-len" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="3" step="0.01" min="0.01">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (cm)</label>
            <input type="number" id="hz-width" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="12" step="0.1" min="0.1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Höhe (cm)</label>
            <input type="number" id="hz-height" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="4" step="0.1" min="0.1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Stücke</label>
            <input type="number" id="hz-count" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="10" step="1" min="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label>
            <input type="number" id="hz-waste" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="10" step="1" min="0" max="50">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Preis pro Laufmeter (€)</label>
          <input type="number" id="hz-price" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="2.50" step="0.01" min="0">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten (inkl. Verschnitt)</div>
          <div class="text-5xl font-extrabold font-mono" id="hz-result">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Laufmeter gesamt</div>
            <div class="text-xl font-bold font-mono" id="hz-lm">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kubikmeter</div>
            <div class="text-xl font-bold font-mono" id="hz-m3">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mit Verschnitt (lm)</div>
            <div class="text-xl font-bold font-mono" id="hz-lm-waste">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Verschnitt (lm)</div>
            <div class="text-xl font-bold font-mono" id="hz-waste-lm">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="lumber" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Holzmengen richtig berechnen</h2>
      <p>Bei Bauprojekten ist die genaue Kalkulation von Holzmengen entscheidend, um Kosten zu minimieren und ausreichend Material zu haben. Der Verschnitt – also das Abfallholz beim Zuschneiden – beträgt je nach Projekt typischerweise 5–15 %. Bei komplexen Schnitten oder Diagonalverlegung kann der Verschnitt bis zu 20–25 % betragen.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist ein Laufmeter Holz?</h3>
      <p>Ein Laufmeter (lm) ist ein Meter Holz in seiner Länge, unabhängig vom Querschnitt. Um die tatsächliche Menge zu ermitteln, multipliziert man Laufmeter × Breite × Höhe für das Volumen in Kubikmeter.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie viel Verschnitt soll ich einplanen?</h3>
      <p>Als Faustregel gilt: 10 % Verschnitt für gerade Verlegung, 15 % für Diagonalverlegung (45°), 20 % für Fischgrät-Muster. Bei Dachstühlen und komplexen Schnitten lieber 15–20 % aufschlagen.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen Festmeter und Raummeter?</h3>
      <p>Ein Festmeter (fm) ist 1 m³ kompaktes Holz ohne Hohlräume. Ein Raummeter (rm) umfasst 1 m³ Holz mit Hohlräumen (z. B. Brennholzstapel) und entspricht ca. 0,65–0,7 Festmeter.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Welche Holzarten eignen sich für den Außenbereich?</h3>
      <p>Heimische Hölzer: Lärche (besonders dauerhaft), Eiche, Robinie. Tropenhölzer: Bangkirai, Teak, Ipé. Für Terrassendielen empfiehlt sich eine Holzschutzbehandlung oder UV-stabiles Öl.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcHz() {
      const len = parseFloat((document.getElementById('hz-len') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('hz-width') as HTMLInputElement).value) / 100 || 0;
      const height = parseFloat((document.getElementById('hz-height') as HTMLInputElement).value) / 100 || 0;
      const count = parseInt((document.getElementById('hz-count') as HTMLInputElement).value) || 1;
      const waste = parseFloat((document.getElementById('hz-waste') as HTMLInputElement).value) / 100 || 0;
      const price = parseFloat((document.getElementById('hz-price') as HTMLInputElement).value) || 0;
      const lm = len * count;
      const lmWaste = lm * (1 + waste);
      const wasteLm = lmWaste - lm;
      const m3 = lmWaste * width * height;
      const cost = lmWaste * price;
      document.getElementById('hz-result')!.textContent = cost.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
      document.getElementById('hz-lm')!.textContent = lm.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' lm';
      document.getElementById('hz-m3')!.textContent = m3.toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) + ' m³';
      document.getElementById('hz-lm-waste')!.textContent = lmWaste.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' lm';
      document.getElementById('hz-waste-lm')!.textContent = wasteLm.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' lm';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['hz-len', 'hz-width', 'hz-height', 'hz-count', 'hz-waste', 'hz-price'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcHz);
      });
      calcHz();
    }, 50);
  </script>
</CalculatorLayout>
