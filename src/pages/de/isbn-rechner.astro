---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "ISBN Rechner – ISBN-10 & ISBN-13 validieren & konvertieren";
const description = "Validieren und konvertieren Sie ISBN-10 und ISBN-13 Buchcodes.";
const relatedCalcs = [
  { name: "IP-Subnetz Rechner", url: "/de/ip-subnetz-rechner", description: "Subnetzmasken berechnen." },
  { name: "JSON Formatierer", url: "/de/json-formatierer", description: "JSON formatieren & validieren." },
  { name: "Interpolationsrechner", url: "/de/interpolations-rechner", description: "Lineare Interpolation." },
  { name: "IQ-Wert Rechner", url: "/de/iq-wert-rechner", description: "IQ-Wert & Perzentil." },
];
---
<CalculatorLayout lang="de" enSlug="isbn-calculator" title={title} description={description} calculatorName="ISBN Rechner" keywords="ISBN Rechner, ISBN-10, ISBN-13, ISBN validieren, ISBN konvertieren, Buchcode prüfen" breadcrumbs={[{ name: "ISBN Rechner", url: "/de/isbn-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">ISBN Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Validieren Sie ISBN-10 und ISBN-13 Buchcodes, prüfen Sie die Prüfziffer und konvertieren Sie zwischen beiden Formaten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">ISBN eingeben (10 oder 13 Stellen)</label>
          <input type="text" id="isbn-input" class="isbn-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold font-mono" value="978-3-16-148410-0" placeholder="z.B. 978-3-16-148410-0">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Validierungsergebnis</div>
          <div class="text-3xl font-extrabold font-mono" id="isbn-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="isbn-type">—</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Berechnete Prüfziffer</div><div class="text-2xl font-bold font-mono" id="isbn-check">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eingegebene Prüfziffer</div><div class="text-2xl font-bold font-mono" id="isbn-given">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Konvertierung</h3>
          <div class="space-y-2" id="isbn-convert"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Aufschlüsselung</h3>
          <div class="text-xs font-mono space-y-1" id="isbn-breakdown"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="isbn" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">ISBN – Internationale Standardbuchnummer</h2>
      <p class="text-text-secondary">Die ISBN (International Standard Book Number) ist ein weltweit einheitliches Identifikationssystem für Bücher. Die ISBN-13 wurde 2007 als Standard eingeführt und beginnt immer mit dem EAN-Präfix 978 oder 979. Ältere ISBN-10-Nummern können in ISBN-13 konvertiert werden, indem 978 vorangestellt und eine neue Prüfziffer berechnet wird.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>ISBN-10 Prüfziffer: Σ(i × dᵢ) mod 11 (i=1..10)</p>
        <p>ISBN-13 Prüfziffer: 10 − (Σ(wᵢ × dᵢ) mod 10) mod 10</p>
        <p>Gewichte ISBN-13: 1,3,1,3,1,3,1,3,1,3,1,3</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zwischen ISBN-10 und ISBN-13?</h4>
          <p class="text-text-secondary mt-1">ISBN-10 hat 10 Ziffern und wurde bis 2007 verwendet. ISBN-13 hat 13 Ziffern und beginnt mit dem EAN-Präfix 978 oder 979. Seit dem 1. Januar 2007 ist ISBN-13 der internationale Standard. Alle ISBN-10 können in ISBN-13 (mit Präfix 978) konvertiert werden.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was bedeuten die Teile einer ISBN?</h4>
          <p class="text-text-secondary mt-1">Eine ISBN-13 besteht aus: EAN-Präfix (978/979), Sprachgruppe/Ländercode, Verlagsnummer, Titelnummer und Prüfziffer. Zum Beispiel: 978-3-16-148410-0: 978=EAN, 3=deutschsprachiger Raum, 16=Verlag, 148410=Titel, 0=Prüfziffer.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie beantrage ich eine ISBN für mein Buch?</h4>
          <p class="text-text-secondary mt-1">In Deutschland vergibt die MVB GmbH (Marketing- und Verlagsservice des Buchhandels) ISBNs. Verlage können Blöcke von ISBNs erwerben. Einzelne Autoren (Selfpublisher) können ebenfalls ISBNs über Dienstleister wie Books on Demand erhalten. Die einmalige ISBN kostet ca. 70–90 €.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Kann ich eine ISBN manuell überprüfen?</h4>
          <p class="text-text-secondary mt-1">Ja: Für ISBN-13 multiplizieren Sie die Ziffern abwechselnd mit 1 und 3, addieren alle Produkte und berechnen den Rest bei Division durch 10. Ist der Rest 0, ist die ISBN gültig. Anderenfalls ist die Prüfziffer (10 minus Rest) falsch.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function cleanISBN(s: string): string {
      return s.replace(/[\s\-]/g, '');
    }
    function calcISBN10Check(digits: string): string {
      let sum = 0;
      for (let i = 0; i < 9; i++) sum += (i + 1) * parseInt(digits[i]);
      const r = sum % 11;
      return r === 10 ? 'X' : String(r);
    }
    function calcISBN13Check(digits: string): string {
      let sum = 0;
      const weights = [1,3,1,3,1,3,1,3,1,3,1,3];
      for (let i = 0; i < 12; i++) sum += weights[i] * parseInt(digits[i]);
      return String((10 - (sum % 10)) % 10);
    }
    function isbn10to13(isbn10: string): string {
      const base = '978' + isbn10.slice(0, 9);
      return base + calcISBN13Check(base);
    }
    function isbn13to10(isbn13: string): string | null {
      if (!isbn13.startsWith('978')) return null;
      const base = isbn13.slice(3, 12);
      return base + calcISBN10Check(base);
    }
    function calcISBN() {
      const raw = (document.getElementById('isbn-input') as HTMLInputElement).value;
      const clean = cleanISBN(raw);
      let valid = false;
      let type = '';
      let checkCalc = '—';
      let checkGiven = '—';
      let resultText = 'Ungültig';
      let convertHTML = '';
      let breakdownHTML = '';
      if (clean.length === 10 && /^[0-9]{9}[0-9X]$/.test(clean)) {
        type = 'ISBN-10';
        checkCalc = calcISBN10Check(clean);
        checkGiven = clean[9].toUpperCase();
        valid = checkCalc === checkGiven;
        if (valid) {
          resultText = 'Gültige ISBN-10';
          const isbn13 = isbn10to13(clean);
          convertHTML = '<div class="text-sm"><span class="font-medium">ISBN-13 Äquivalent:</span> <span class="font-mono">' + isbn13 + '</span></div>';
        } else {
          resultText = 'Ungültige ISBN-10';
        }
        breakdownHTML = '<div>Format: ISBN-10</div><div>Nutzstellen (1–9): ' + clean.slice(0,9) + '</div><div>Prüfziffer (10): ' + checkGiven + '</div><div>Berechnete Prüfziffer: ' + checkCalc + '</div>';
      } else if (clean.length === 13 && /^[0-9]{13}$/.test(clean)) {
        type = 'ISBN-13 / EAN-13';
        checkCalc = calcISBN13Check(clean);
        checkGiven = clean[12];
        valid = checkCalc === checkGiven;
        if (valid) {
          resultText = 'Gültige ISBN-13';
          const isbn10 = isbn13to10(clean);
          convertHTML = '<div class="text-sm"><span class="font-medium">ISBN-10 Äquivalent:</span> <span class="font-mono">' + (isbn10 ? isbn10 : 'Nur für 978-Präfix möglich') + '</span></div>';
        } else {
          resultText = 'Ungültige ISBN-13';
        }
        const prefix = clean.slice(0,3);
        breakdownHTML = '<div>EAN-Präfix: ' + prefix + (prefix === '978' ? ' (Original)' : prefix === '979' ? ' (Erweiterung)' : ' (Unbekannt)') + '</div><div>Sprachgruppe: ' + clean[3] + '</div><div>Prüfziffer: ' + checkGiven + ' (berechnet: ' + checkCalc + ')</div>';
      } else {
        type = 'Unbekanntes Format (' + clean.length + ' Zeichen)';
        resultText = 'Fehler: Bitte 10 oder 13 Ziffern eingeben';
      }
      const resultEl = document.getElementById('isbn-result')!;
      resultEl.textContent = resultText;
      resultEl.className = 'text-3xl font-extrabold font-mono ' + (valid ? 'text-green-300' : 'text-red-300');
      document.getElementById('isbn-type')!.textContent = type;
      document.getElementById('isbn-check')!.textContent = checkCalc;
      document.getElementById('isbn-given')!.textContent = checkGiven;
      document.getElementById('isbn-convert')!.innerHTML = convertHTML;
      document.getElementById('isbn-breakdown')!.innerHTML = breakdownHTML;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('isbn-input')!.addEventListener('input', calcISBN);
      calcISBN();
    }, 50);
  </script>
</CalculatorLayout>
