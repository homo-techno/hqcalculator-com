---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Huehnerfutter-Rechner - Tagesbedarf, Kosten & Eierproduktion";
const description = "Berechnen Sie den taeglichen, woechentlichen und monatlichen Futterbedarf fuer Huehner basierend auf Herdengroesse und Alter. Inkl. Futterkosten und Eierproduktion.";
const relatedCalcs = [
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrung." },
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI fuer Kinder." },
  { name: "Spendenabzug-Rechner", url: "/de/spendenabzug-rechner", description: "Steuerersparnis." },
  { name: "Kindesunterhalt-Rechner", url: "/de/kindesunterhalt-rechner", description: "Unterhalt." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Huehnerfutter-Rechner" enSlug="chicken-feed-calculator" keywords="Huehnerfutter-Rechner, Gefluegelfutter, Legehennen Futter, Futterkosten, Eier pro Tag, Herdenfutter" breadcrumbs={[{ name: "Huehnerfutter-Rechner", url: "/de/huehnerfutter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Huehnerfutter-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Futterbedarf, Kosten und erwartete Eierproduktion fuer Ihre Herde.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Huehner</label><input type="number" id="hf-count" class="hf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Alter / Stadium</label>
            <select id="hf-age" class="hf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="chick">Kueken (0-8 Wochen)</option>
              <option value="pullet">Junghennen (8-20 Wochen)</option>
              <option value="layer" selected>Legehennen (20+ Wochen)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Futterpreis (&euro; / 25 kg Sack)</label><input type="number" id="hf-bagcost" class="hf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Legerate (%)</label><input type="number" id="hf-layrate" class="hf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="0" max="100" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Taeglicher Futterbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="hf-result">0 g</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Woechentlich</div><div class="text-xl font-bold font-mono" id="hf-weekly">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatlich</div><div class="text-xl font-bold font-mono" id="hf-monthly">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Saecke / Monat</div><div class="text-xl font-bold font-mono" id="hf-bags">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatskosten</div><div class="text-xl font-bold font-mono" id="hf-cost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eier / Tag</div><div class="text-xl font-bold font-mono" id="hf-eggs">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten / Ei</div><div class="text-xl font-bold font-mono" id="hf-peregg">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="huehnerfutter" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Huehnerfuetterung im Ueberblick</h2>
      <p>Eine ausgewogene Fuetterung ist entscheidend fuer gesunde Huehner und eine gute Legeleistung. Legehennen benoetigen etwa 120-130 g Alleinfutter pro Tag mit ca. 16% Proteingehalt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Wie viel Futter braucht ein Huhn pro Tag?</strong> Legehennen ca. 120-130 g, Kueken ca. 25 g, Junghennen ca. 70 g.</li>
        <li><strong>Was kostet die Haltung pro Huhn im Monat?</strong> In Deutschland ca. 3-5 Euro pro Monat nur fuer Futter.</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcHF() {
      const count = parseFloat((document.getElementById('hf-count') as HTMLInputElement).value) || 0;
      const age = (document.getElementById('hf-age') as HTMLSelectElement).value;
      const bagCost = parseFloat((document.getElementById('hf-bagcost') as HTMLInputElement).value) || 0;
      const layRate = parseFloat((document.getElementById('hf-layrate') as HTMLInputElement).value) || 0;
      // Feed per bird per day in grams
      const feedPerDay: Record<string, number> = { chick: 25, pullet: 70, layer: 125 };
      const dailyPerBird = feedPerDay[age] || 125;
      const dailyTotal = count * dailyPerBird;
      const weeklyTotal = dailyTotal * 7;
      const monthlyTotal = dailyTotal * 30;
      const bagsPerMonth = Math.ceil(monthlyTotal / 25000);
      const monthlyCost = bagsPerMonth * bagCost;
      const eggsPerDay = age === 'layer' ? Math.round(count * (layRate / 100) * 10) / 10 : 0;
      const monthlyEggs = eggsPerDay * 30;
      const costPerEgg = monthlyEggs > 0 ? monthlyCost / monthlyEggs : 0;
      document.getElementById('hf-result')!.textContent = dailyTotal.toFixed(0) + ' g';
      document.getElementById('hf-weekly')!.textContent = (weeklyTotal / 1000).toFixed(1) + ' kg';
      document.getElementById('hf-monthly')!.textContent = (monthlyTotal / 1000).toFixed(1) + ' kg';
      document.getElementById('hf-bags')!.textContent = bagsPerMonth.toString();
      document.getElementById('hf-cost')!.textContent = monthlyCost.toFixed(2) + ' \u20AC';
      document.getElementById('hf-eggs')!.textContent = eggsPerDay.toFixed(1);
      document.getElementById('hf-peregg')!.textContent = costPerEgg.toFixed(2) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hf-in').forEach(el => { el.addEventListener('input', calcHF); el.addEventListener('change', calcHF); });
      calcHF();
    }, 50);
  </script>
</CalculatorLayout>
