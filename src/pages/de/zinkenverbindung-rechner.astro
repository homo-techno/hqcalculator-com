---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zinkenverbindung-Rechner - Fingerverbindung Layout & Planung";
const description = "Berechnen Sie das Layout für Zinkenverbindungen inkl. Zinkenbreite, Anzahl und Vorrichtungseinstellung. Perfekte Zinkenverbindungen für Kisten und Schubladen.";
const relatedCalcs = [
  { name: "Bäckerprozent-Rechner", url: "/de/baeckerprozent-rechner", description: "Bäckerprozente." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Boolesche-Algebra-Rechner", url: "/de/boolesche-algebra-rechner", description: "Logik-Operationen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Batteriespeicher-Rechner", url: "/de/batteriespeicher-rechner", description: "Speicher-Rechner." },
  { name: "Bootskredit-Rechner", url: "/de/bootskredit-rechner", description: "Kreditberechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Zinkenverbindung-Rechner" enSlug="box-joint-calculator" keywords="Zinkenverbindung Rechner, Fingerverbindung, Zinkenbreite, Verbindung Layout, Kistenbau, Schubladenverbindung" breadcrumbs={[{ name: "Zinkenverbindung-Rechner", url: "/de/zinkenverbindung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zinkenverbindung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Zinkenverbindung (Fingerverbindung) mit präzisen Maßen und Vorrichtungseinstellung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="grid grid-cols-2 gap-4 mb-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Brettbreite (mm)</label>
          <input type="number" id="zv-width" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="20" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Brettstärke (mm)</label>
          <input type="number" id="zv-thick" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="5" step="1">
        </div>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Zinkenbreite</label>
        <select id="zv-fw" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="0">Auto (= Brettstärke)</option>
          <option value="3">3 mm</option>
          <option value="5">5 mm</option>
          <option value="6">6 mm</option>
          <option value="8">8 mm</option>
          <option value="10">10 mm</option>
          <option value="12">12 mm</option>
          <option value="15">15 mm</option>
          <option value="20">20 mm</option>
        </select>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Schnittmethode</label>
        <select id="zv-method" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="dado" selected>Nutfräser an Tischkreissäge</option>
          <option value="router">Oberfräse mit Vorrichtung</option>
          <option value="scroll">Dekupiersäge / Bandsäge</option>
        </select>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Anzahl Zinken (pro Brett)</div>
        <div class="text-4xl font-extrabold" id="zv-count">--</div>
        <div class="text-sm text-blue-200 mt-1" id="zv-count-sub">--</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zinkenbreite</div><div class="text-xl font-bold" id="zv-fwd">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zinkentiefe</div><div class="text-xl font-bold" id="zv-fd">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nuten (Teil A)</div><div class="text-xl font-bold" id="zv-slots-a">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nuten (Teil B)</div><div class="text-xl font-bold" id="zv-slots-b">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leimfläche</div><div class="text-xl font-bold" id="zv-glue">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vorrichtungs-Abstand</div><div class="text-xl font-bold" id="zv-offset">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h4 class="font-semibold text-sm text-text mb-1">Einrichtungshinweise</h4>
        <p class="text-sm text-text-secondary" id="zv-notes">--</p>
      </div>
      <ShareButton lang="de" calculatorId="zinkenverbindung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zinkenverbindung-Leitfaden</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Zinkenbreite = typischerweise gleich der Brettstärke</strong></p>
        <p><strong>Zinkentiefe = Stärke des Gegenstücks</strong></p>
        <p><strong>Ungerade Anzahl Zinken bevorzugt für Symmetrie</strong></p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Tipps für perfekte Zinkenverbindungen</h3>
      <ul>
        <li>Machen Sie einen Probeschnitt an einem Reststück</li>
        <li>Zinken sollten leicht klemmend passen (leichtes Klopfen nötig)</li>
        <li>Zinken leicht anschleifen, wenn zu stramm</li>
        <li>Leim auf beide Seiten jedes Zinkens auftragen</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcZV() {
      const boardWidth = parseFloat((document.getElementById('zv-width') as HTMLInputElement).value) || 100;
      const boardThick = parseFloat((document.getElementById('zv-thick') as HTMLInputElement).value) || 12;
      let fingerWidth = parseFloat((document.getElementById('zv-fw') as HTMLSelectElement).value) || 0;
      const method = (document.getElementById('zv-method') as HTMLSelectElement).value;
      if (fingerWidth === 0) fingerWidth = boardThick;
      const fingerDepth = boardThick;
      const totalUnits = Math.floor(boardWidth / fingerWidth);
      const fingers = totalUnits % 2 === 0 ? totalUnits - 1 : totalUnits;
      const fingersA = Math.ceil(fingers / 2);
      const slotsA = Math.floor(fingers / 2);
      const fingersB = Math.floor(fingers / 2);
      const slotsB = Math.ceil(fingers / 2);
      const usedWidth = fingers * fingerWidth;
      const remainder = boardWidth - usedWidth;
      const glueAreaSqMm = fingers * 2 * fingerDepth * fingerWidth;
      const glueAreaSqCm = glueAreaSqMm / 100;
      const jigOffset = fingerWidth;
      document.getElementById('zv-count')!.textContent = fingers.toString();
      document.getElementById('zv-count-sub')!.textContent = fingersA + ' Zinken an Teil A, ' + fingersB + ' Zinken an Teil B';
      document.getElementById('zv-fwd')!.textContent = fingerWidth + ' mm';
      document.getElementById('zv-fd')!.textContent = fingerDepth + ' mm';
      document.getElementById('zv-slots-a')!.textContent = slotsA + ' Nuten';
      document.getElementById('zv-slots-b')!.textContent = slotsB + ' Nuten';
      document.getElementById('zv-glue')!.textContent = glueAreaSqCm.toFixed(1) + ' cm\u00B2';
      document.getElementById('zv-offset')!.textContent = jigOffset + ' mm vom Blatt';
      let notes = 'Nutfr\u00e4ser oder Fr\u00e4ser auf exakt ' + fingerWidth + ' mm Breite einstellen. ';
      if (method === 'dado') {
        notes += 'Vorrichtungsstift genau ' + jigOffset + ' mm vom Blatt positionieren. Zuerst an Restholz testen.';
      } else if (method === 'router') {
        notes += 'Nutfr\u00e4ser passend zur Zinkenbreite verwenden. Indexier-Vorrichtung mit Stift bei ' + jigOffset + ' mm Abstand bauen.';
      } else {
        notes += 'Alle Schnitte sorgf\u00e4ltig anreißen. Diese Methode erfordert Geduld, erlaubt aber beliebige Zinkenbreiten.';
      }
      if (remainder > 0.1) {
        notes += ' Hinweis: ' + remainder.toFixed(1) + ' mm Rest werden auf Ober- und Unterkante aufgeteilt.';
      }
      document.getElementById('zv-notes')!.textContent = notes;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zv-in').forEach(el => { el.addEventListener('input', calcZV); el.addEventListener('change', calcZV); });
      calcZV();
    }, 50);
  </script>
</CalculatorLayout>
