---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Anwaltskostenrechner – RVG Gebühren berechnen";
const description = "Berechnen Sie Rechtsanwaltskosten nach dem RVG (Rechtsanwaltsvergütungsgesetz). Streitwert eingeben und Gebühren sofort ermitteln.";
const relatedCalcs = [
  { name: "Rechtsanwaltsgebühren Rechner", url: "/de/rechtsanwaltsgebuehren-rechner", description: "Anwaltsgebühren." },
  { name: "Prozesskostenrechner", url: "/de/prozesskosten-rechner", description: "Gerichtskosten." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="legal-billing-calculator" calculatorName="Anwaltskostenrechner" keywords="Anwaltskostenrechner, RVG, Rechtsanwaltskosten, Streitwert, Gerichtsgebühren" breadcrumbs={[{ name: "Anwaltskostenrechner", url: "/de/anwaltskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Anwaltskostenrechner (RVG)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie Anwaltskosten nach dem Rechtsanwaltsvergütungsgesetz anhand des Streitwerts.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Streitwert (€)</label>
          <input type="number" id="awk-streitwert" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000" min="0" step="100">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Instanz</label>
          <select id="awk-instanz" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.3">Außergerichtlich (1,3-fache Gebühr)</option>
            <option value="1.3" selected>Amtsgericht (1,3-fache Gebühr)</option>
            <option value="1.6">Landgericht (1,6-fache Gebühr)</option>
            <option value="2.0">Oberlandesgericht (2,0-fache Gebühr)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Mehrwertsteuer</label>
          <select id="awk-mwst" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.19" selected>19 % MwSt. inkl.</option>
            <option value="1.0">Netto (ohne MwSt.)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Anwaltskosten gesamt</div>
          <div class="text-5xl font-extrabold font-mono" id="awk-result">0,00 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="awk-details"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Hinweis</h3>
          <p class="text-sm text-text-secondary">Diese Berechnung dient als Orientierung. Die tatsächlichen Kosten können je nach Fallkomplexität abweichen. Ohne Rechtsberatung.</p>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="anwaltskosten" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Anwaltskosten nach dem RVG berechnen</h2>
      <p>Das Rechtsanwaltsvergütungsgesetz (RVG) regelt in Deutschland die Vergütung von Rechtsanwälten. Die Gebühren richten sich primär nach dem Streitwert der Angelegenheit und der jeweiligen Verfahrensstufe. Aus dem Streitwert wird zunächst eine Grundgebühr (1,0-fache Gebühr) ermittelt, die dann mit einem instanzabhängigen Multiplikator versehen wird.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist das RVG?</summary>
          <p class="mt-2 text-sm text-text-secondary">Das Rechtsanwaltsvergütungsgesetz (RVG) ist das deutsche Gesetz, das die gesetzlichen Gebühren für Rechtsanwälte regelt. Es legt fest, wie viel ein Anwalt mindestens für bestimmte Tätigkeiten verlangen darf.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie wird der Streitwert festgelegt?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der Streitwert entspricht in der Regel dem wirtschaftlichen Interesse an der Sache. Bei einer Geldforderung ist es der geforderte Betrag. Das Gericht oder die Parteien können den Streitwert auch festsetzen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Können Anwälte höhere Honorare verlangen?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ja, durch eine schriftliche Honorarvereinbarung können höhere Vergütungen vereinbart werden. In der Praxis ist dies bei Unternehmensrecht und spezialisierten Kanzleien üblich.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wer trägt bei einem Prozessgewinn die Kosten?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die unterlegene Partei trägt in der Regel die Kosten des Rechtsstreits, einschließlich der gegnerischen Anwaltskosten bis zur Höhe der gesetzlichen Gebühren nach RVG.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Gibt es Prozesskostenhilfe?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ja, bei geringem Einkommen und aussichtsreicher Klage kann das Gericht Prozesskostenhilfe (PKH) gewähren. Der Staat übernimmt dann die Gerichts- und Anwaltskosten ganz oder teilweise.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAnwalt() {
      const streitwert = parseFloat((document.getElementById('awk-streitwert') as HTMLInputElement).value) || 0;
      const faktor = parseFloat((document.getElementById('awk-instanz') as HTMLSelectElement).value) || 1.3;
      const mwst = parseFloat((document.getElementById('awk-mwst') as HTMLSelectElement).value) || 1.19;

      // RVG Gebührentabelle (vereinfacht nach §13 RVG)
      let grundgebuehr = 0;
      if (streitwert <= 500) grundgebuehr = 49;
      else if (streitwert <= 1000) grundgebuehr = 88;
      else if (streitwert <= 1500) grundgebuehr = 127;
      else if (streitwert <= 2000) grundgebuehr = 166;
      else if (streitwert <= 3000) grundgebuehr = 222;
      else if (streitwert <= 4000) grundgebuehr = 278;
      else if (streitwert <= 5000) grundgebuehr = 334;
      else if (streitwert <= 6000) grundgebuehr = 390;
      else if (streitwert <= 7000) grundgebuehr = 446;
      else if (streitwert <= 8000) grundgebuehr = 502;
      else if (streitwert <= 9000) grundgebuehr = 558;
      else if (streitwert <= 10000) grundgebuehr = 614;
      else if (streitwert <= 13000) grundgebuehr = 614 + (streitwert - 10000) / 3000 * 121;
      else if (streitwert <= 16000) grundgebuehr = 735 + (streitwert - 13000) / 3000 * 121;
      else if (streitwert <= 19000) grundgebuehr = 856 + (streitwert - 16000) / 3000 * 121;
      else if (streitwert <= 22000) grundgebuehr = 977 + (streitwert - 19000) / 3000 * 121;
      else if (streitwert <= 25000) grundgebuehr = 1098 + (streitwert - 22000) / 3000 * 121;
      else if (streitwert <= 30000) grundgebuehr = 1219 + (streitwert - 25000) / 5000 * 136;
      else if (streitwert <= 35000) grundgebuehr = 1355 + (streitwert - 30000) / 5000 * 136;
      else if (streitwert <= 40000) grundgebuehr = 1491 + (streitwert - 35000) / 5000 * 136;
      else if (streitwert <= 45000) grundgebuehr = 1627 + (streitwert - 40000) / 5000 * 136;
      else if (streitwert <= 50000) grundgebuehr = 1763 + (streitwert - 45000) / 5000 * 136;
      else grundgebuehr = 1899 + Math.floor((streitwert - 50000) / 50000) * 331 + ((streitwert - 50000) % 50000) / 50000 * 331;

      const gebuehrNetto = grundgebuehr * faktor;
      const auslagen = Math.min(gebuehrNetto * 0.2, 20); // Pauschale §670 BGB max 20€
      const gesamtNetto = gebuehrNetto + auslagen;
      const gesamtBrutto = gesamtNetto * mwst;

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('awk-result')!.textContent = fmt(gesamtBrutto);
      document.getElementById('awk-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundgebühr (1,0)</div><div class="text-lg font-bold font-mono">${fmt(grundgebuehr)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verfahrensgebühr</div><div class="text-lg font-bold font-mono">${fmt(gebuehrNetto)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Auslagenpauschale</div><div class="text-lg font-bold font-mono">${fmt(auslagen)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nettobetrag</div><div class="text-lg font-bold font-mono">${fmt(gesamtNetto)}</div></div>
      `;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('awk-streitwert')!.addEventListener('input', calcAnwalt);
      document.getElementById('awk-instanz')!.addEventListener('change', calcAnwalt);
      document.getElementById('awk-mwst')!.addEventListener('change', calcAnwalt);
      calcAnwalt();
    }, 50);
  </script>
</CalculatorLayout>
