---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Determinanten-Rechner - 2x2 und 3x3 Matrix";
const description = "Berechnen Sie die Determinante einer 2x2- oder 3x3-Matrix. Zeigt Kofaktoren und ob die Matrix invertierbar ist.";

const relatedCalcs = [
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Mathematische Berechnungen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Mittelwert berechnen." },
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Bruchrechnung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Determinanten-Rechner" lang="de" enSlug="determinant-calculator" keywords="determinanten rechner, matrix determinante, 2x2 determinante, 3x3 determinante, kofaktoren, invertierbare matrix" breadcrumbs={[{ name: "Determinanten-Rechner", url: "/de/determinanten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Determinanten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Determinante einer 2&times;2 oder 3&times;3 Matrix mit Kofaktoren und Invertierbarkeitspr&uuml;fung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Matrixgr&ouml;&szlig;e</label>
          <select id="det-mode" class="det-in w-full px-4 py-2 border border-border rounded-xl text-lg">
            <option value="2">2 &times; 2</option>
            <option value="3" selected>3 &times; 3</option>
          </select>
        </div>

        <div id="det-matrix-2" class="hidden">
          <h3 class="font-semibold text-text mb-2">2&times;2 Matrix</h3>
          <div class="grid grid-cols-2 gap-2">
            <input type="number" id="det-a11" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="1" />
            <input type="number" id="det-a12" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="2" />
            <input type="number" id="det-a21" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="3" />
            <input type="number" id="det-a22" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="4" />
          </div>
        </div>

        <div id="det-matrix-3">
          <h3 class="font-semibold text-text mb-2">3&times;3 Matrix</h3>
          <div class="grid grid-cols-3 gap-2">
            <input type="number" id="det-b11" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="6" />
            <input type="number" id="det-b12" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="1" />
            <input type="number" id="det-b13" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="1" />
            <input type="number" id="det-b21" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="4" />
            <input type="number" id="det-b22" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="-2" />
            <input type="number" id="det-b23" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="5" />
            <input type="number" id="det-b31" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="2" />
            <input type="number" id="det-b32" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="8" />
            <input type="number" id="det-b33" class="det-in w-full px-3 py-2 border border-border rounded-xl text-lg text-center font-mono" value="7" />
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Determinante</div>
          <div class="text-5xl font-extrabold font-mono" id="det-result">0</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Invertierbar?</div>
            <div class="text-xl font-bold" id="det-invertible">&mdash;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Matrixgr&ouml;&szlig;e</div>
            <div class="text-xl font-bold" id="det-size">3&times;3</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Kofaktoren (erste Zeile)</h3>
          <div class="text-sm text-text-secondary font-mono" id="det-cofactors"></div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schritt f&uuml;r Schritt</h3>
          <div class="text-sm text-text-secondary font-mono whitespace-pre-wrap" id="det-steps"></div>
        </div>
      </div>

      <ShareButton calculatorId="determinant-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Matrix-Determinanten verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>2&times;2:</strong> det = a&middot;d &minus; b&middot;c</p>
        <p><strong>3&times;3:</strong> Kofaktor-Entwicklung entlang der ersten Zeile</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet Determinante = 0?</strong> Die Matrix ist singul&auml;r (nicht invertierbar). Das Gleichungssystem hat keine eindeutige L&ouml;sung.</p>
      <p><strong>Wof&uuml;r braucht man Determinanten?</strong> Zur L&ouml;sung linearer Gleichungssysteme, Berechnung von Fl&auml;chen/Volumina und zur Pr&uuml;fung der Invertierbarkeit.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDET() {
      const mode = (document.getElementById('det-mode') as HTMLSelectElement).value;
      const is2 = mode === '2';

      document.getElementById('det-matrix-2')!.classList.toggle('hidden', !is2);
      document.getElementById('det-matrix-3')!.classList.toggle('hidden', is2);
      document.getElementById('det-size')!.innerHTML = is2 ? '2&times;2' : '3&times;3';

      let det = 0;
      let cofactorStr = '';
      let steps = '';

      if (is2) {
        const a = parseFloat((document.getElementById('det-a11') as HTMLInputElement).value) || 0;
        const b = parseFloat((document.getElementById('det-a12') as HTMLInputElement).value) || 0;
        const c = parseFloat((document.getElementById('det-a21') as HTMLInputElement).value) || 0;
        const d = parseFloat((document.getElementById('det-a22') as HTMLInputElement).value) || 0;

        det = a * d - b * c;
        cofactorStr = 'C11 = ' + d + ', C12 = ' + (-c);
        steps = 'det = (' + a + ')(' + d + ') - (' + b + ')(' + c + ')\n    = ' + (a * d) + ' - ' + (b * c) + '\n    = ' + det;
      } else {
        const v = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0;
        const a = v('det-b11'), b = v('det-b12'), c = v('det-b13');
        const d = v('det-b21'), e = v('det-b22'), f = v('det-b23');
        const g = v('det-b31'), h = v('det-b32'), i = v('det-b33');

        const c11 = e * i - f * h;
        const c12 = -(d * i - f * g);
        const c13 = d * h - e * g;

        det = a * c11 + b * c12 + c * c13;
        cofactorStr = 'C11 = ' + c11 + ', C12 = ' + c12 + ', C13 = ' + c13;
        steps = 'Entwicklung entlang Zeile 1:\n';
        steps += 'det = ' + a + '(' + e + '\u00b7' + i + ' - ' + f + '\u00b7' + h + ') - ' + b + '(' + d + '\u00b7' + i + ' - ' + f + '\u00b7' + g + ') + ' + c + '(' + d + '\u00b7' + h + ' - ' + e + '\u00b7' + g + ')\n';
        steps += '    = ' + a + '(' + c11 + ') + ' + b + '(' + c12 + ') + ' + c + '(' + c13 + ')\n';
        steps += '    = ' + (a * c11) + ' + ' + (b * c12) + ' + ' + (c * c13) + '\n';
        steps += '    = ' + det;
      }

      document.getElementById('det-result')!.textContent = String(det);
      document.getElementById('det-invertible')!.textContent = det !== 0 ? 'Ja' : 'Nein (Singul\u00e4r)';
      document.getElementById('det-cofactors')!.textContent = cofactorStr;
      document.getElementById('det-steps')!.textContent = steps;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.det-in').forEach(el => {
        el.addEventListener('input', calcDET);
        el.addEventListener('change', calcDET);
      });
      calcDET();
    }, 50);
  </script>
</CalculatorLayout>
