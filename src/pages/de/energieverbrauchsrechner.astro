---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Energieverbrauchsrechner (TDEE) - Tagesenergieverbrauch berechnen 2026";
const description = "Berechne deinen Gesamtenergieverbrauch (TDEE). Finde heraus, wie viele Kalorien du taeglich verbrennst, basierend auf deinem Aktivitaetslevel.";

const relatedCalcs = [
  { name: "Grundumsatzrechner", url: "/de/grundumsatzrechner", description: "Grundumsatz berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Taeglicher Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Koerperfettrechner", url: "/de/koerperfettrechner", description: "Koerperfettanteil schaetzen." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Kaloriendefizit planen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Energieverbrauchsrechner" keywords="TDEE Rechner, Energieverbrauchsrechner, Tagesenergieverbrauch, Kalorienverbrauch, Erhaltungskalorien, TDEE berechnen" breadcrumbs={[{ name: "Energieverbrauchsrechner", url: "/de/energieverbrauchsrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Energieverbrauchsrechner (TDEE)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne deinen Gesamtenergieverbrauch — die Gesamtmenge an Kalorien, die du taeglich einschliesslich Aktivitaet verbrennst.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Geschlecht</label>
            <div class="flex gap-2">
              <button class="tdee-gender-btn flex-1 py-3 rounded-xl font-semibold bg-primary text-white border border-primary cursor-pointer" data-gender="male">Maennlich</button>
              <button class="tdee-gender-btn flex-1 py-3 rounded-xl font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-gender="female">Weiblich</button>
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Alter</label>
            <input type="number" id="tdee-age" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="28" min="15" max="120">
          </div>

          <div class="mb-5">
            <div class="flex gap-2">
              <button class="tdee-unit-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-primary text-white cursor-pointer" data-unit="metric">Metrisch</button>
              <button class="tdee-unit-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-unit="imperial">Imperial</button>
            </div>
          </div>

          <div class="mb-5" id="tdee-h-metric">
            <label class="block text-sm font-medium text-text mb-1">Groesse (cm)</label>
            <input type="number" id="tdee-h-cm" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="178" min="100" max="250">
          </div>
          <div class="mb-5 hidden" id="tdee-h-imperial">
            <label class="block text-sm font-medium text-text mb-1">Groesse</label>
            <div class="flex gap-3">
              <div class="flex-1"><input type="number" id="tdee-h-ft" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="5" min="3" max="8"><span class="text-xs text-text-muted">Fuss</span></div>
              <div class="flex-1"><input type="number" id="tdee-h-in" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="0" max="11"><span class="text-xs text-text-muted">Zoll</span></div>
            </div>
          </div>

          <div class="mb-5" id="tdee-w-metric">
            <label class="block text-sm font-medium text-text mb-1">Gewicht (kg)</label>
            <input type="number" id="tdee-w-kg" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="80" min="30" max="300">
          </div>
          <div class="mb-5 hidden" id="tdee-w-imperial">
            <label class="block text-sm font-medium text-text mb-1">Gewicht (lbs)</label>
            <input type="number" id="tdee-w-lbs" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="176" min="66" max="660">
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Aktivitaetslevel</label>
            <div class="space-y-2" id="tdee-activity-radios">
              <label class="flex items-start gap-3 p-3 border border-border rounded-xl cursor-pointer hover:border-primary/30 transition-colors tdee-activity-option" data-mult="1.2">
                <input type="radio" name="tdee-activity" value="1.2" class="mt-1">
                <div><div class="font-semibold text-sm">Sitzend</div><div class="text-xs text-text-muted">Wenig oder keine Bewegung, Bueroarbeit</div></div>
              </label>
              <label class="flex items-start gap-3 p-3 border border-border rounded-xl cursor-pointer hover:border-primary/30 transition-colors tdee-activity-option" data-mult="1.375">
                <input type="radio" name="tdee-activity" value="1.375" class="mt-1">
                <div><div class="font-semibold text-sm">Leicht aktiv</div><div class="text-xs text-text-muted">Leichte Bewegung 1-3 Tage/Woche</div></div>
              </label>
              <label class="flex items-start gap-3 p-3 border border-border rounded-xl cursor-pointer hover:border-primary/30 transition-colors tdee-activity-option" data-mult="1.55">
                <input type="radio" name="tdee-activity" value="1.55" checked class="mt-1">
                <div><div class="font-semibold text-sm">Maessig aktiv</div><div class="text-xs text-text-muted">Moderate Bewegung 3-5 Tage/Woche</div></div>
              </label>
              <label class="flex items-start gap-3 p-3 border border-border rounded-xl cursor-pointer hover:border-primary/30 transition-colors tdee-activity-option" data-mult="1.725">
                <input type="radio" name="tdee-activity" value="1.725" class="mt-1">
                <div><div class="font-semibold text-sm">Sehr aktiv</div><div class="text-xs text-text-muted">Intensives Training 6-7 Tage/Woche</div></div>
              </label>
              <label class="flex items-start gap-3 p-3 border border-border rounded-xl cursor-pointer hover:border-primary/30 transition-colors tdee-activity-option" data-mult="1.9">
                <input type="radio" name="tdee-activity" value="1.9" class="mt-1">
                <div><div class="font-semibold text-sm">Extrem aktiv</div><div class="text-xs text-text-muted">Sehr hartes Training, koerperliche Arbeit, 2x/Tag Training</div></div>
              </label>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Dein TDEE</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="tdee-result">0</div>
            <div class="text-sm text-blue-200 mt-1">kcal/Tag</div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundumsatz</div><div class="text-xl font-bold" id="tdee-bmr">0</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktivitaetsverbrauch</div><div class="text-xl font-bold" id="tdee-activity-burn">0</div></div>
          </div>

          <div class="space-y-3">
            <h3 class="font-semibold text-text text-sm">Kalorienziele</h3>
            <div class="p-4 bg-red-50 rounded-xl border border-red-100">
              <div class="flex justify-between items-center">
                <div><div class="font-semibold text-sm text-danger">Schnelles Abnehmen</div><div class="text-xs text-text-muted">&minus;1000 kcal/Tag (~1 kg/Woche)</div></div>
                <div class="text-xl font-bold text-danger" id="tdee-extreme-loss">0</div>
              </div>
            </div>
            <div class="p-4 bg-orange-50 rounded-xl border border-orange-100">
              <div class="flex justify-between items-center">
                <div><div class="font-semibold text-sm text-orange-600">Abnehmen</div><div class="text-xs text-text-muted">&minus;500 kcal/Tag (~0,5 kg/Woche)</div></div>
                <div class="text-xl font-bold text-orange-600" id="tdee-loss">0</div>
              </div>
            </div>
            <div class="p-4 bg-green-50 rounded-xl border border-green-100">
              <div class="flex justify-between items-center">
                <div><div class="font-semibold text-sm text-secondary">Gewicht halten</div><div class="text-xs text-text-muted">TDEE Erhaltungsbedarf</div></div>
                <div class="text-xl font-bold text-secondary" id="tdee-maintain">0</div>
              </div>
            </div>
            <div class="p-4 bg-blue-50 rounded-xl border border-blue-100">
              <div class="flex justify-between items-center">
                <div><div class="font-semibold text-sm text-primary">Zunehmen</div><div class="text-xs text-text-muted">+500 kcal/Tag (~0,5 kg/Woche)</div></div>
                <div class="text-xl font-bold text-primary" id="tdee-gain">0</div>
              </div>
            </div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-text text-sm mb-3">Empfohlene Makronaehrstoffe (Erhaltung)</h3>
            <div class="grid grid-cols-3 gap-3 text-center">
              <div><div class="text-xs text-text-muted">Protein (30%)</div><div class="text-lg font-bold text-primary" id="tdee-protein">0g</div></div>
              <div><div class="text-xs text-text-muted">Kohlenhydrate (40%)</div><div class="text-lg font-bold text-secondary" id="tdee-carbs">0g</div></div>
              <div><div class="text-xs text-text-muted">Fett (30%)</div><div class="text-lg font-bold text-accent" id="tdee-fat">0g</div></div>
            </div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="tdee" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist der TDEE?</h2>
      <p>Der Gesamtenergieverbrauch (Total Daily Energy Expenditure, TDEE) ist die Gesamtanzahl an Kalorien, die dein Koerper an einem Tag verbrennt. Er umfasst deinen Grundumsatz (BMR), die Energie fuer koerperliche Aktivitaet, den thermischen Effekt der Nahrung und die Nicht-Sport-Thermogenese (NEAT).</p>

      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">
        TDEE = BMR &times; Aktivitaetsfaktor
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">TDEE-Komponenten</h3>
      <ul>
        <li><strong>BMR (60-70 %):</strong> Kalorienverbrauch in Ruhe fuer grundlegende Koerperfunktionen</li>
        <li><strong>Koerperliche Aktivitaet (15-30 %):</strong> Sport, Bewegung und bewusste koerperliche Aktivitaet</li>
        <li><strong>Thermischer Effekt der Nahrung (10 %):</strong> Energie fuer Verdauung und Verarbeitung</li>
        <li><strong>NEAT (5-15 %):</strong> Zappeln, Gehen, Stehen und andere Nicht-Sport-Bewegungen</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">TDEE fuer Gewichtsziele nutzen</h3>
      <ul>
        <li><strong>Abnehmen:</strong> 500-1000 kcal unter dem TDEE essen fuer 0,5-1 kg Verlust pro Woche</li>
        <li><strong>Gewicht halten:</strong> Auf TDEE-Niveau essen</li>
        <li><strong>Zunehmen:</strong> 300-500 kcal ueber dem TDEE essen fuer Muskelaufbau</li>
      </ul>
      <p>Esse niemals dauerhaft unter deinem Grundumsatz, da dies den Stoffwechsel verlangsamen und zu Muskelverlust fuehren kann.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let tdeeGender = 'male';
    let tdeeUnit = 'metric';

    function getWeight(): number {
      if (tdeeUnit === 'metric') return parseFloat((document.getElementById('tdee-w-kg') as HTMLInputElement).value) || 0;
      return (parseFloat((document.getElementById('tdee-w-lbs') as HTMLInputElement).value) || 0) * 0.453592;
    }

    function getHeight(): number {
      if (tdeeUnit === 'metric') return parseFloat((document.getElementById('tdee-h-cm') as HTMLInputElement).value) || 0;
      const ft = parseFloat((document.getElementById('tdee-h-ft') as HTMLInputElement).value) || 0;
      const inch = parseFloat((document.getElementById('tdee-h-in') as HTMLInputElement).value) || 0;
      return (ft * 12 + inch) * 2.54;
    }

    function calcTDEE() {
      const weight = getWeight();
      const height = getHeight();
      const age = parseFloat((document.getElementById('tdee-age') as HTMLInputElement).value) || 0;
      const activityRadio = document.querySelector('input[name="tdee-activity"]:checked') as HTMLInputElement;
      const multiplier = parseFloat(activityRadio?.value || '1.55');

      let bmr: number;
      if (tdeeGender === 'male') { bmr = 10 * weight + 6.25 * height - 5 * age + 5; }
      else { bmr = 10 * weight + 6.25 * height - 5 * age - 161; }

      const tdee = Math.round(bmr * multiplier);
      const activityBurn = Math.round(tdee - bmr);

      document.getElementById('tdee-result')!.textContent = tdee.toLocaleString('de-DE');
      document.getElementById('tdee-bmr')!.textContent = Math.round(bmr).toLocaleString('de-DE') + ' kcal';
      document.getElementById('tdee-activity-burn')!.textContent = activityBurn.toLocaleString('de-DE') + ' kcal';

      document.getElementById('tdee-extreme-loss')!.textContent = Math.max(1200, tdee - 1000).toLocaleString('de-DE') + ' kcal';
      document.getElementById('tdee-loss')!.textContent = Math.max(1200, tdee - 500).toLocaleString('de-DE') + ' kcal';
      document.getElementById('tdee-maintain')!.textContent = tdee.toLocaleString('de-DE') + ' kcal';
      document.getElementById('tdee-gain')!.textContent = (tdee + 500).toLocaleString('de-DE') + ' kcal';

      document.getElementById('tdee-protein')!.textContent = Math.round(tdee * 0.30 / 4) + 'g';
      document.getElementById('tdee-carbs')!.textContent = Math.round(tdee * 0.40 / 4) + 'g';
      document.getElementById('tdee-fat')!.textContent = Math.round(tdee * 0.30 / 9) + 'g';

      document.querySelectorAll('.tdee-activity-option').forEach(opt => {
        const radio = opt.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio.checked) { opt.classList.add('border-primary', 'bg-primary/5'); opt.classList.remove('border-border'); }
        else { opt.classList.remove('border-primary', 'bg-primary/5'); opt.classList.add('border-border'); }
      });

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.tdee-gender-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tdee-gender-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white', 'border-primary'); b.classList.add('bg-surface-alt', 'text-text-secondary', 'border-border'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary', 'border-border'); btn.classList.add('bg-primary', 'text-white', 'border-primary');
          tdeeGender = (btn as HTMLElement).dataset.gender || 'male';
          calcTDEE();
        });
      });

      document.querySelectorAll('.tdee-unit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tdee-unit-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          tdeeUnit = (btn as HTMLElement).dataset.unit || 'metric';
          const isMetric = tdeeUnit === 'metric';
          document.getElementById('tdee-h-metric')!.classList.toggle('hidden', !isMetric);
          document.getElementById('tdee-h-imperial')!.classList.toggle('hidden', isMetric);
          document.getElementById('tdee-w-metric')!.classList.toggle('hidden', !isMetric);
          document.getElementById('tdee-w-imperial')!.classList.toggle('hidden', isMetric);
          calcTDEE();
        });
      });

      document.querySelectorAll('input[name="tdee-activity"]').forEach(radio => { radio.addEventListener('change', calcTDEE); });
      ['tdee-age', 'tdee-h-cm', 'tdee-h-ft', 'tdee-h-in', 'tdee-w-kg', 'tdee-w-lbs'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcTDEE);
      });

      calcTDEE();
    }, 50);
  </script>
</CalculatorLayout>
