---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bruttomietmultiplikator-Rechner";
const description = "Berechnen Sie den Bruttomietmultiplikator aus Immobilienpreis und Bruttomiete, sch&auml;tzen Sie den Immobilienwert und vergleichen Sie mit Marktdurchschnitten.";
const relatedCalcs = [
  { name: "Mietrendite-Rechner", url: "/de/mietrendite-rechner", description: "Mietrendite-Analyse." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlagewachstum." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Bruttomietmultiplikator-Rechner" lang="de" enSlug="gross-rent-multiplier-calculator" keywords="bruttomietmultiplikator, GRM, immobilienbewertung, mieteinnahmen, immobilieninvestition" breadcrumbs={[{ name: "Bruttomietmultiplikator", url: "/de/bruttomietmultiplikator-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bruttomietmultiplikator-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie Anlageimmobilien schnell mit dem Bruttomietmultiplikator und vergleichen Sie mit Markt-Benchmarks.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Berechnen f&uuml;r</label>
          <select id="gmde-mode" class="gmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="grm" selected>GRM (Bruttomietmultiplikator)</option>
            <option value="price">Immobilienpreis</option>
            <option value="rent">Jahresmiete</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Immobilienpreis (&euro;)</label><input type="number" id="gmde-price" class="gmde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="300000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Monatliche Bruttomiete (&euro;)</label><input type="number" id="gmde-rent" class="gmde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1500" min="0" step="50"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Ziel-GRM (f&uuml;r Preis/Miete-Berechnung)</label><input type="number" id="gmde-target" class="gmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="1" max="50" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="gmde-label">Bruttomietmultiplikator</div>
          <div class="text-5xl font-extrabold font-mono" id="gmde-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahresbruttomiete</div><div class="text-xl font-bold font-mono" id="gmde-annual">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Rendite</div><div class="text-xl font-bold font-mono" id="gmde-caprate">0 %</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Preis/Miete-Verh.</div><div class="text-xl font-bold font-mono" id="gmde-priceratio">0</div></div>
        </div>
        <div class="p-4 rounded-xl text-center" id="gmde-status-box"><div class="font-bold text-sm" id="gmde-status">-</div></div>
      </div>
      <ShareButton calculatorId="gross-rent-multiplier-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist der Bruttomietmultiplikator?</h2>
      <p>Der Bruttomietmultiplikator (GRM) ist das Verh&auml;ltnis von Immobilienpreis zur j&auml;hrlichen Bruttomiete. Ein niedriger GRM deutet auf starke Mieteinnahmen im Verh&auml;ltnis zum Preis hin.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein guter GRM?</strong> In Deutschland liegt ein typischer GRM zwischen 12 und 20, abh&auml;ngig von Lage und Markt.</p>
      <p><strong>Wie unterscheidet sich GRM von der Rendite?</strong> Der GRM betrachtet nur die Bruttomiete, w&auml;hrend die Rendite auch Betriebskosten ber&uuml;cksichtigt.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGMDE() {
      const mode = (document.getElementById('gmde-mode') as HTMLSelectElement).value;
      let price = parseFloat((document.getElementById('gmde-price') as HTMLInputElement).value) || 0;
      let monthlyRent = parseFloat((document.getElementById('gmde-rent') as HTMLInputElement).value) || 0;
      const target = parseFloat((document.getElementById('gmde-target') as HTMLInputElement).value) || 15;

      let annualRent = monthlyRent * 12;
      let grm = 0;
      let resultText = '';
      let label = 'Bruttomietmultiplikator';

      if (mode === 'grm') {
        grm = annualRent > 0 ? price / annualRent : 0;
        resultText = grm.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        label = 'Bruttomietmultiplikator';
      } else if (mode === 'price') {
        price = annualRent * target;
        grm = target;
        resultText = price.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC';
        label = 'Gesch\u00E4tzter Immobilienpreis';
      } else {
        annualRent = target > 0 ? price / target : 0;
        monthlyRent = annualRent / 12;
        grm = target;
        resultText = monthlyRent.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC/Monat';
        label = 'Erforderliche Monatsmiete';
      }

      const impliedCap = price > 0 ? (annualRent * 0.6 / price) * 100 : 0;
      const priceRatio = monthlyRent > 0 ? price / monthlyRent : 0;

      document.getElementById('gmde-result')!.textContent = resultText;
      document.getElementById('gmde-label')!.textContent = label;
      document.getElementById('gmde-annual')!.textContent = annualRent.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC';
      document.getElementById('gmde-caprate')!.textContent = impliedCap.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
      document.getElementById('gmde-priceratio')!.textContent = priceRatio.toLocaleString('de-DE', { maximumFractionDigits: 0 });

      let status: string, color: string;
      const effectiveGRM = grm;
      if (effectiveGRM > 0 && effectiveGRM <= 10) { status = 'Niedriger GRM \u2014 starke Einnahmen relativ zum Preis'; color = 'bg-green-50 text-green-800'; }
      else if (effectiveGRM <= 16) { status = 'Durchschnittlicher GRM \u2014 typische Anlageimmobilie'; color = 'bg-blue-50 text-blue-800'; }
      else if (effectiveGRM <= 22) { status = '\u00DCberdurchschnittlicher GRM \u2014 Premium-Markt'; color = 'bg-yellow-50 text-yellow-800'; }
      else { status = 'Hoher GRM \u2014 wertsteigerungsabh\u00E4ngiger Markt'; color = 'bg-red-50 text-red-800'; }

      document.getElementById('gmde-status')!.textContent = status;
      document.getElementById('gmde-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gmde-in').forEach(el => { el.addEventListener('input', calcGMDE); el.addEventListener('change', calcGMDE); });
      calcGMDE();
    }, 50);
  </script>
</CalculatorLayout>
