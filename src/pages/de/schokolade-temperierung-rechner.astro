---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schokolade-Temperierung-Rechner - Temperaturkurven fuer Zartbitter, Vollmilch & Weiss";
const description = "Exakte Temperiertemperaturen fuer Zartbitter-, Vollmilch- und Weisse Schokolade. Impfschokoladenmenge und Arbeitszeit berechnen.";
const relatedCalcs = [
  { name: "Huehnerfutter-Rechner", url: "/de/huehnerfutter-rechner", description: "Futterberechnung." },
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrung." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
  { name: "Keramikform-Rechner", url: "/de/keramikform-rechner", description: "Gipsformen." },
  { name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner", description: "Statistik." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Schokolade-Temperierung-Rechner" enSlug="chocolate-tempering-calculator" keywords="Schokolade temperieren, Temperiertemperatur, Zartbitter Temperatur, Vollmilch temperieren, Kakaobutterkristalle, Arbeitstemperatur" breadcrumbs={[{ name: "Schokolade temperieren", url: "/de/schokolade-temperierung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schokolade-Temperierung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Praezise Temperiertemperaturen und Impfmengen fuer Zartbitter-, Vollmilch- und Weisse Schokolade.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Schokoladenart</label>
          <select id="st-type" class="st-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="dark">Zartbitterschokolade (55-70% Kakao)</option>
            <option value="milk">Vollmilchschokolade (30-45% Kakao)</option>
            <option value="white">Weisse Schokolade</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gesamtgewicht Schokolade (g)</label>
          <input type="number" id="st-weight" class="st-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="50" step="10">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Temperiermethode</label>
          <select id="st-method" class="st-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="seed">Impfmethode</option>
            <option value="table">Tabliermethode</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Verarbeitungstemperatur</div>
          <div class="text-5xl font-extrabold font-mono" id="st-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schritt 1: Schmelzen auf</div><div class="text-xl font-bold font-mono" id="st-melt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schritt 2: Abkuehlen auf</div><div class="text-xl font-bold font-mono" id="st-cool">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schritt 3: Erwaermen auf</div><div class="text-xl font-bold font-mono" id="st-reheat">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Impfmenge</div><div class="text-xl font-bold font-mono" id="st-seed">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erst-Schmelzmenge</div><div class="text-xl font-bold font-mono" id="st-portion">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Arbeitszeit</div><div class="text-xl font-bold font-mono" id="st-time">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Anleitung</div>
          <div class="text-sm text-text-secondary" id="st-instructions">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="schokolade-temperierung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Schokolade richtig temperieren</h2>
      <p>Beim Temperieren von Schokolade werden die Kakaobutterkristalle in eine stabile Form (Beta-V-Kristalle) gebracht. Richtig temperierte Schokolade hat einen schoenen Glanz, einen knackigen Bruch und schmilzt angenehm auf der Zunge.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Warum muss Schokolade temperiert werden?</strong> Ohne Temperierung wird die Schokolade matt, hat weissen Belag (Fettreif) und keinen knackigen Bruch.</li>
        <li><strong>Welche Methode ist einfacher?</strong> Die Impfmethode ist fuer Anfaenger einfacher, die Tabliermethode erfordert eine Marmorplatte.</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcST() {
      const type = (document.getElementById('st-type') as HTMLSelectElement).value;
      const weight = parseFloat((document.getElementById('st-weight') as HTMLInputElement).value) || 500;
      const method = (document.getElementById('st-method') as HTMLSelectElement).value;
      // Temperatures in °C
      const temps: Record<string, {melt: number[], cool: number[], work: number[]}> = {
        dark: { melt: [50, 55], cool: [27, 28], work: [31, 32] },
        milk: { melt: [45, 50], cool: [26, 27], work: [29, 30] },
        white: { melt: [40, 45], cool: [25, 26], work: [27, 28] }
      };
      const t = temps[type];
      const meltStr = t.melt[0] + '-' + t.melt[1] + '\u00B0C';
      const coolStr = t.cool[0] + '-' + t.cool[1] + '\u00B0C';
      const workStr = t.work[0] + '-' + t.work[1] + '\u00B0C';
      const seedPct = 0.27;
      const seedAmt = weight * seedPct;
      const meltPortion = weight - seedAmt;
      document.getElementById('st-result')!.textContent = workStr;
      document.getElementById('st-melt')!.textContent = meltStr;
      document.getElementById('st-cool')!.textContent = coolStr;
      document.getElementById('st-reheat')!.textContent = workStr;
      if (method === 'seed') {
        document.getElementById('st-seed')!.textContent = seedAmt.toFixed(0) + ' g (' + Math.round(seedPct * 100) + '%)';
        document.getElementById('st-portion')!.textContent = meltPortion.toFixed(0) + ' g';
      } else {
        document.getElementById('st-seed')!.textContent = 'Entfaellt (Tablieren)';
        document.getElementById('st-portion')!.textContent = weight.toFixed(0) + ' g (alles)';
      }
      const workMins = Math.max(15, Math.min(45, weight / 20));
      document.getElementById('st-time')!.textContent = '~' + Math.round(workMins) + ' Min.';
      let instructions = '';
      if (method === 'seed') {
        instructions = meltPortion.toFixed(0) + ' g auf ' + meltStr + ' schmelzen. Vom Herd nehmen, ' + seedAmt.toFixed(0) + ' g fein gehackte Impfschokolade zugeben. Staendig ruehren, bis auf ' + coolStr + ' abgekuehlt. Vorsichtig auf ' + workStr + ' erwaermen und waehrend der Arbeit halten.';
      } else {
        instructions = 'Alle ' + weight + ' g auf ' + meltStr + ' schmelzen. 2/3 auf Marmorplatte giessen. Mit Paletten arbeiten, bis eingedickt und auf ' + coolStr + ' abgekuehlt. Zurueck in die Schuessel geben, verruehren und auf ' + workStr + ' bringen.';
      }
      document.getElementById('st-instructions')!.textContent = instructions;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.st-in').forEach(el => { el.addEventListener('input', calcST); el.addEventListener('change', calcST); });
      calcST();
    }, 50);
  </script>
</CalculatorLayout>
