---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Anleiherechner - Anleihekurs & Rendite berechnen";
const description = "Berechnen Sie Anleihekurs, Rendite bis Fälligkeit, laufende Rendite und Kuponzahlungen. Verstehen Sie Anleihebewertungen und Renditen.";

const relatedCalcs = [
  { name: "Anlagerechner", url: "/de/anlage-rechner", description: "Anlagen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszins-rechner", description: "Zinseszins." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Anleiherechner" lang="de" keywords="anleihe rechner, anleiherendite, rendite bis fälligkeit, anleihekurs, kuponrate, anleihebewertung" breadcrumbs={[{ name: "Anleiherechner", url: "/de/anleihe-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Anleiherechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Anleihekurs, Rendite bis F&auml;lligkeit und Kuponzahlungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Nennwert (Nominalwert)</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">$</span>
              <input type="number" id="bd-face" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1000" min="0" step="100">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Kuponrate (%/Jahr)</label>
              <input type="number" id="bd-coupon" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="5" min="0" max="20" step="0.125">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Jahre bis Fälligkeit</label>
              <input type="number" id="bd-years" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="1" max="30" step="1">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Marktzins / Rendite (%)</label>
            <input type="number" id="bd-market" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="4" min="0" max="20" step="0.1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kuponfrequenz</label>
            <select id="bd-freq" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="2" selected>Halbjährlich</option>
              <option value="1">Jährlich</option>
              <option value="4">Vierteljährlich</option>
            </select>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Anleihekurs</div>
            <div class="text-5xl font-extrabold" id="bd-price">$0</div>
            <div class="text-sm text-blue-200 mt-1" id="bd-premium">Zum Nennwert</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Laufende Rendite</div>
              <div class="text-xl font-bold text-secondary" id="bd-current-yield">0%</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Jährlicher Kupon</div>
              <div class="text-xl font-bold" id="bd-annual-coupon">$0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Kupons gesamt</div>
              <div class="text-xl font-bold" id="bd-total-coupons">$0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gesamtrendite</div>
              <div class="text-xl font-bold" id="bd-total-return">$0</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Cashflow-Zeitplan</h3>
            <div class="space-y-1 text-sm" id="bd-table"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="bond" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie Anleihepreise funktionieren</h2>
      <p>Der Preis einer Anleihe ist der Barwert aller zuk&uuml;nftigen Zahlungsstr&ouml;me (Kuponzahlungen + Nennwert bei F&auml;lligkeit), abgezinst mit dem Marktzins. Wenn die Marktzinsen steigen, fallen die Anleihekurse und umgekehrt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmt = (n: number) => '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, '.');

    function calcBond() {
      const face = parseFloat((document.getElementById('bd-face') as HTMLInputElement).value) || 0;
      const couponRate = (parseFloat((document.getElementById('bd-coupon') as HTMLInputElement).value) || 0) / 100;
      const years = parseInt((document.getElementById('bd-years') as HTMLInputElement).value) || 1;
      const marketRate = (parseFloat((document.getElementById('bd-market') as HTMLInputElement).value) || 0) / 100;
      const freq = parseInt((document.getElementById('bd-freq') as HTMLSelectElement).value) || 2;

      const couponPayment = (face * couponRate) / freq;
      const r = marketRate / freq;
      const n = years * freq;

      let pvCoupons = 0;
      if (r > 0) pvCoupons = couponPayment * (1 - Math.pow(1 + r, -n)) / r;
      else pvCoupons = couponPayment * n;
      const pvFace = face / Math.pow(1 + r, n);
      const price = pvCoupons + pvFace;

      const annualCoupon = face * couponRate;
      const currentYield = price > 0 ? (annualCoupon / price) * 100 : 0;
      const totalCoupons = annualCoupon * years;
      const totalReturn = totalCoupons + face - price;

      document.getElementById('bd-price')!.textContent = fmt(price);
      document.getElementById('bd-current-yield')!.textContent = currentYield.toFixed(2).replace('.', ',') + '%';
      document.getElementById('bd-annual-coupon')!.textContent = fmt(annualCoupon);
      document.getElementById('bd-total-coupons')!.textContent = fmt(totalCoupons);
      document.getElementById('bd-total-return')!.textContent = fmt(totalReturn);

      const premium = price > face * 1.001 ? '\u00dcber Nennwert (Aufgeld)' : price < face * 0.999 ? 'Unter Nennwert (Abschlag)' : 'Zum Nennwert';
      document.getElementById('bd-premium')!.textContent = premium;

      const rows: string[] = [];
      rows.push('<div class="grid grid-cols-3 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Jahr</span><span>Kupons</span><span>Cashflow</span></div>');
      for (let y = 1; y <= years; y++) {
        const coupons = annualCoupon;
        const cf = y === years ? coupons + face : coupons;
        rows.push(`<div class="grid grid-cols-3 gap-1 text-xs ${y === years ? 'font-bold' : ''}"><span>${y}</span><span>${fmt(coupons)}</span><span>${fmt(cf)}</span></div>`);
      }
      document.getElementById('bd-table')!.innerHTML = rows.join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['bd-face', 'bd-coupon', 'bd-years', 'bd-market'].forEach(id => document.getElementById(id)!.addEventListener('input', calcBond));
      document.getElementById('bd-freq')!.addEventListener('change', calcBond);
      calcBond();
    }, 50);
  </script>
</CalculatorLayout>
