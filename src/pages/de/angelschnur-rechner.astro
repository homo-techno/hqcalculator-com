---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Angelschnur-Rechner - Tragkraft, Knoten & Durchmesser";
const description = "Berechnen Sie die empfohlene Angelschnurst&auml;rke basierend auf Zielfisch, Knotenfestigkeit und Angelbedingungen.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Geschwindigkeit", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
  { name: "Gewichtsumrechner", url: "/de/gewichtsumrechner", description: "Gewichte umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Angelschnur-Rechner" lang="de" enSlug="fishing-line-calculator" keywords="Angelschnur Rechner, Tragkraft, Knotenfestigkeit, Vorfach, Schnurdurchmesser, Angelschnur Test" breadcrumbs={[{ name: "Angelschnur-Rechner", url: "/de/angelschnur-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Angelschnur-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die richtige Schnurst&auml;rke basierend auf Zielfisch, Knotentyp und Angelbedingungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zielfisch-Gewicht (kg)</label><input type="number" id="asr-fish" class="asr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.2" max="500" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sicherheitsfaktor</label>
            <select id="asr-margin" class="asr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1.5">1,5x (Leicht)</option>
              <option value="2" selected>2x (Standard)</option>
              <option value="3">3x (Schwere Deckung)</option>
              <option value="4">4x (Extrem)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Knotentyp</label>
          <select id="asr-knot" class="asr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0.95">Palomarknoten (95%)</option>
            <option value="0.90">Clinchknoten (90%)</option>
            <option value="0.85" selected>Uniknoten (85%)</option>
            <option value="0.80">Blutknoten (80%)</option>
            <option value="0.75">Chirurgenknoten (75%)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Schnurtyp</label>
          <select id="asr-type" class="asr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="mono">Monofilament</option>
            <option value="fluoro" selected>Fluorocarbon</option>
            <option value="braid">Geflochten</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Angelbedingungen</label>
          <select id="asr-cond" class="asr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="open">Freies Wasser</option>
            <option value="light" selected>Leichte Hindernisse</option>
            <option value="heavy">Schwere Deckung / Steine</option>
            <option value="offshore">Hochsee / Gro&szlig;fisch</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Tragkraft</div>
          <div class="text-5xl font-extrabold font-mono" id="asr-rec">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nach Knoten</div><div class="text-xl font-bold font-mono" id="asr-afterknot">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vorfach</div><div class="text-xl font-bold font-mono" id="asr-leader">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchmesser</div><div class="text-xl font-bold font-mono" id="asr-diam">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schnurempfehlung nach Fischart</h3>
          <div class="text-xs space-y-1" id="asr-species"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fishing-line" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Welche Tragkraft f&uuml;r welchen Fisch?</strong> Als Faustregel: 2x das erwartete Fischgewicht als Schnurtragkraft w&auml;hlen.</p>
      <p><strong>Warum verliert ein Knoten an Festigkeit?</strong> Jeder Knoten verringert die Tragkraft der Schnur um 5-30%, je nach Knotentyp.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcASR() {
      const fishKg = parseFloat((document.getElementById('asr-fish') as HTMLInputElement).value) || 0;
      const margin = parseFloat((document.getElementById('asr-margin') as HTMLSelectElement).value) || 2;
      const knotStrength = parseFloat((document.getElementById('asr-knot') as HTMLSelectElement).value) || 0.85;
      const lineType = (document.getElementById('asr-type') as HTMLSelectElement).value;
      const cond = (document.getElementById('asr-cond') as HTMLSelectElement).value;
      if (fishKg <= 0) return;
      let condMult = 1.0;
      if (cond === 'heavy') condMult = 1.3;
      else if (cond === 'offshore') condMult = 1.5;
      else if (cond === 'light') condMult = 1.1;
      const rawNeeded = fishKg * margin * condMult;
      const lineTestNeeded = rawNeeded / knotStrength;
      const standardTests = [1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 20, 25, 30, 40, 50, 60, 80, 100];
      let recTest = standardTests[standardTests.length - 1];
      for (const t of standardTests) {
        if (t >= lineTestNeeded) { recTest = t; break; }
      }
      const afterKnot = recTest * knotStrength;
      const leaderTest = Math.round(recTest * 0.8);
      let diameter = 0;
      if (lineType === 'mono') diameter = 0.1 * Math.sqrt(recTest);
      else if (lineType === 'fluoro') diameter = 0.107 * Math.sqrt(recTest);
      else diameter = 0.04 * Math.sqrt(recTest);
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('asr-rec')!.textContent = recTest + ' kg';
      document.getElementById('asr-afterknot')!.textContent = fmt(afterKnot) + ' kg';
      document.getElementById('asr-leader')!.textContent = leaderTest + ' kg';
      document.getElementById('asr-diam')!.textContent = diameter.toFixed(2).replace('.', ',') + ' mm';
      const species = [
        { name: 'Forelle / Barsch', line: '2-4 kg' },
        { name: 'Hecht', line: '6-12 kg' },
        { name: 'Zander', line: '4-8 kg' },
        { name: 'Karpfen', line: '6-15 kg' },
        { name: 'Wels', line: '15-50 kg' },
        { name: 'Lachs / Meerforelle', line: '5-12 kg' },
        { name: 'Thunfisch', line: '20-60 kg' },
        { name: 'Marlin / Schwertfisch', line: '40-80 kg' },
      ];
      document.getElementById('asr-species')!.innerHTML = species.map(s =>
        '<div class="flex justify-between"><span>' + s.name + '</span><span class="font-mono font-bold">' + s.line + '</span></div>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('asr-fish') as HTMLInputElement).value = '5';
      document.querySelectorAll('.asr-in').forEach(el => { el.addEventListener('input', calcASR); el.addEventListener('change', calcASR); });
      calcASR();
    }, 50);
  </script>
</CalculatorLayout>
