---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "DSGVO-Bu\u00DFgeld-Rechner - Strafe nach Versto\u00DF & Umsatz sch\u00E4tzen";
const description = "Berechnen Sie potenzielle DSGVO-Bu\u00DFgelder basierend auf Versto\u00DFart, Unternehmensumsatz, Schweregrad und mildernden Umst\u00E4nden.";
const relatedCalcs = [
  { name: "Compliance-Kosten-Rechner", url: "/de/compliance-kosten-rechner", description: "Compliance-Budget." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Budget-Rechner", url: "/de/budgetrechner", description: "Budget." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="DSGVO-Bu\u00DFgeld-Rechner" lang="de" enSlug="gdpr-fine-calculator" keywords="dsgvo bu\u00DFgeld rechner, dsgvo strafe, datenschutz, datenschutzversto\u00DF, datenpanne bu\u00DFgeld, eu verordnung, dsgvo compliance" breadcrumbs={[{ name: "DSGVO-Bu\u00DFgeld", url: "/de/dsgvo-bussgeld-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">DSGVO-Bu&szlig;geld-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie potenzielle DSGVO-Bu&szlig;gelder basierend auf Versto&szlig;art, Umsatz und Umst&auml;nden.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Versto&szlig;stufe</label>
          <select id="dsg-tier" class="dsg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="lower" selected>Untere Stufe (Art. 83(4)) - bis 2% / 10 Mio. &euro;</option>
            <option value="upper">Obere Stufe (Art. 83(5/6)) - bis 4% / 20 Mio. &euro;</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Versto&szlig;art</label>
          <select id="dsg-type" class="dsg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="consent">Fehlende g&uuml;ltige Einwilligung</option>
            <option value="breach-notification" selected>Versto&szlig; gegen Meldepflicht</option>
            <option value="data-rights">Verletzung von Betroffenenrechten</option>
            <option value="transfer">Unrechtm&auml;&szlig;ige Daten&uuml;bermittlung</option>
            <option value="dpia">Fehlende Datenschutz-Folgenabsch&auml;tzung</option>
            <option value="dpo">Kein Datenschutzbeauftragter</option>
            <option value="records">Unzureichende Dokumentation</option>
            <option value="security">Unzureichende Sicherheitsma&szlig;nahmen</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Weltweiter Jahresumsatz (&euro;)</label>
          <input type="number" id="dsg-revenue" class="dsg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000000" min="0" step="1000000">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl betroffener Personen</label>
          <input type="number" id="dsg-subjects" class="dsg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="1" step="100">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Schweregrad</label>
          <select id="dsg-severity" class="dsg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="minor">Gering / vernachl&auml;ssigbarer Schaden</option>
            <option value="moderate" selected>Mittlerer Schaden</option>
            <option value="severe">Schwer / erheblicher Schaden</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Vors&auml;tzlich oder fahrl&auml;ssig?</label>
          <select id="dsg-intent" class="dsg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="negligent" selected>Fahrl&auml;ssig</option>
            <option value="intentional">Vors&auml;tzlich</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Mildernde Umst&auml;nde</label>
          <select id="dsg-mitigate" class="dsg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Keine</option>
            <option value="some" selected>Einige (Kooperation, Abhilfe)</option>
            <option value="strong">Stark (Selbstmeldung, DSB eingebunden)</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tztes DSGVO-Bu&szlig;geld</div>
          <div class="text-5xl font-extrabold font-mono" id="dsg-total"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Maximal m&ouml;glich</div>
            <div class="text-xl font-bold text-secondary" id="dsg-max"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">% vom Umsatz</div>
            <div class="text-xl font-bold" id="dsg-pct"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Schwerefaktor</div>
            <div class="text-xl font-bold text-orange-600" id="dsg-sev-factor"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Risikostufe</div>
            <div class="text-xl font-bold" id="dsg-risk"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gdpr-fine" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">DSGVO-Bu&szlig;gelder verstehen</h2>
      <p>DSGVO-Bu&szlig;gelder fallen in zwei Stufen. Verst&ouml;&szlig;e der unteren Stufe (Art. 83(4)) umfassen Dokumentationspflichten, Sicherheitsma&szlig;nahmen oder DSFA-Pflichten mit Bu&szlig;geldern bis 10 Mio. &euro; oder 2% des Umsatzes. Verst&ouml;&szlig;e der oberen Stufe (Art. 83(5/6)) betreffen Einwilligung, Betroffenenrechte und unrechtm&auml;&szlig;ige &Uuml;bermittlung mit Bu&szlig;geldern bis 20 Mio. &euro; oder 4% des Umsatzes.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie werden Bu&szlig;gelder bestimmt?</strong> Aufsichtsbeh&ouml;rden ber&uuml;cksichtigen Art und Schwere des Versto&szlig;es, Anzahl der Betroffenen, Kooperationsbereitschaft und ob der Versto&szlig; vors&auml;tzlich oder fahrl&auml;ssig war.</p>
      <p><strong>Kann man Bu&szlig;gelder reduzieren?</strong> Ja, durch schnelle Selbstmeldung, Kooperation mit der Aufsichtsbeh&ouml;rde und sofortige Abhilfema&szlig;nahmen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcDSG() {
      const tier = (document.getElementById('dsg-tier') as HTMLSelectElement).value;
      const revenue = parseFloat((document.getElementById('dsg-revenue') as HTMLInputElement).value) || 0;
      const subjects = parseInt((document.getElementById('dsg-subjects') as HTMLInputElement).value) || 1;
      const severity = (document.getElementById('dsg-severity') as HTMLSelectElement).value;
      const intent = (document.getElementById('dsg-intent') as HTMLSelectElement).value;
      const mitigate = (document.getElementById('dsg-mitigate') as HTMLSelectElement).value;
      const revenuePct = tier === 'upper' ? 0.04 : 0.02;
      const flatMax = tier === 'upper' ? 20000000 : 10000000;
      const maxFine = Math.max(revenue * revenuePct, flatMax);
      const sevMultipliers: Record<string, number> = { minor: 0.1, moderate: 0.35, severe: 0.7 };
      const sevFactor = sevMultipliers[severity] || 0.35;
      const intentFactor = intent === 'intentional' ? 1.5 : 1.0;
      let scaleFactor = 1.0;
      if (subjects > 100000) scaleFactor = 1.3;
      else if (subjects > 10000) scaleFactor = 1.1;
      else if (subjects < 100) scaleFactor = 0.7;
      const mitigateDiscount: Record<string, number> = { none: 1.0, some: 0.7, strong: 0.4 };
      const mitFactor = mitigateDiscount[mitigate] || 1.0;
      let estimatedFine = maxFine * sevFactor * intentFactor * scaleFactor * mitFactor;
      estimatedFine = Math.min(estimatedFine, maxFine);
      estimatedFine = Math.max(estimatedFine, 5000);
      const pctOfRevenue = revenue > 0 ? ((estimatedFine / revenue) * 100).toFixed(2) + '%' : 'N/A';
      let riskLevel = 'Niedrig';
      if (estimatedFine > 5000000) riskLevel = 'Kritisch';
      else if (estimatedFine > 1000000) riskLevel = 'Hoch';
      else if (estimatedFine > 100000) riskLevel = 'Mittel';
      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('dsg-total')!.textContent = fmtEur(estimatedFine);
      document.getElementById('dsg-max')!.textContent = fmtEur(maxFine);
      document.getElementById('dsg-pct')!.textContent = pctOfRevenue;
      document.getElementById('dsg-sev-factor')!.textContent = (sevFactor * intentFactor * scaleFactor * mitFactor * 100).toFixed(0) + '%';
      const riskEl = document.getElementById('dsg-risk')!;
      riskEl.textContent = riskLevel;
      riskEl.className = 'text-xl font-bold ' + (riskLevel === 'Kritisch' ? 'text-red-600' : riskLevel === 'Hoch' ? 'text-orange-600' : riskLevel === 'Mittel' ? 'text-yellow-600' : 'text-green-600');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dsg-in').forEach(el => { el.addEventListener('input', calcDSG); el.addEventListener('change', calcDSG); });
      calcDSG();
    }, 50);
  </script>
</CalculatorLayout>
