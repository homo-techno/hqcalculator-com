---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Magnetische Deklination Rechner – Kompasskorrektur berechnen";
const description = "Berechnen Sie die magnetische Deklination für Navigation und Kompasskorrektur. Missweisungskorrektur für präzise Peilungen.";

const relatedCalcs = [
  { name: "Kartenentfernung Rechner", url: "/de/kartenentfernung-rechner", description: "Entfernungen." },
  { name: "Maßstabsrechner", url: "/de/massstab-rechner", description: "Kartenmaßstäbe." },
  { name: "Magnetfeld Rechner", url: "/de/magnetfeld-rechner", description: "Magnetfeldstärken." },
];
---
<CalculatorLayout lang="de" enSlug="magnetic-declination-calculator" title={title} description={description} calculatorName="Magnetische Deklination Rechner" keywords="Magnetische Deklination, Missweisungskorrektur, Kompass Navigation, Peilung berechnen" breadcrumbs={[{ name: "Magnetische Deklination", url: "/de/magnetische-deklination-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Magnetische Deklination Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Korrektur zwischen magnetischem und geografischem Norden für eine präzise Navigation.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breitengrad (°N)</label>
            <input type="number" id="md-lat" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="52.5" step="0.1" min="-90" max="90">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Längengrad (°O)</label>
            <input type="number" id="md-lon" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="13.4" step="0.1" min="-180" max="180">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Schnellauswahl Stadt</label>
          <select id="md-city" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="">– Stadt wählen –</option>
            <option value="52.5_13.4">Berlin (3,6° O)</option>
            <option value="48.1_11.6">München (2,7° O)</option>
            <option value="53.6_10.0">Hamburg (2,1° O)</option>
            <option value="47.4_8.5">Zürich (2,4° O)</option>
            <option value="48.2_16.4">Wien (4,1° O)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Magnetische Deklination für Ihren Standort (°)</label>
          <input type="number" id="md-decl" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="3.6" step="0.1" min="-180" max="180">
          <p class="text-xs text-text-muted mt-1">Positiv = Östliche Missweisung (Kompass zeigt zu weit östlich)</p>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gemessene Kompasspeilung (°)</label>
          <input type="number" id="md-bearing" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="45" step="0.1" min="0" max="360">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wahre (geografische) Peilung</div>
          <div class="text-5xl font-extrabold font-mono" id="md-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="md-dir">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Deklination</div>
            <div class="text-xl font-bold font-mono" id="md-decl-disp">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kompass-Peilung</div>
            <div class="text-xl font-bold font-mono" id="md-compass-disp">–</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-sm text-text-secondary" id="md-explain"></div>
      </div>
      <ShareButton lang="de" calculatorId="magnetic-declination" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist magnetische Deklination?</h2>
      <p>Die magnetische Deklination (auch Missweisung) ist der Winkelunterschied zwischen dem magnetischen Norden (wohin ein Kompass zeigt) und dem geografischen Norden (dem wahren Norden). Dieser Unterschied variiert je nach Standort auf der Erde und verändert sich auch über die Zeit. In Mitteleuropa beträgt die Missweisung derzeit etwa 2–4° östlich.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Warum zeigt ein Kompass nicht auf den geografischen Nordpol?</h3>
      <p>Ein Kompass richtet sich nach dem magnetischen Nordpol aus, der nicht mit dem geografischen Nordpol identisch ist. Der magnetische Nordpol liegt derzeit in der Nähe der kanadischen Arktis und wandert langsam.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie korrigiere ich meine Peilung?</h3>
      <p>Östliche Missweisung: Wahre Peilung = Kompasspeilung + Deklination. Westliche Missweisung: Wahre Peilung = Kompasspeilung − Deklination. Merksatz: "Ost ist am meisten, West ist am wenigsten."</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie oft ändert sich die magnetische Deklination?</h3>
      <p>Die magnetische Deklination ändert sich jährlich um etwa 0,1–0,2°. Topografische Karten geben daher ein Druckjahr und eine jährliche Änderungsrate an.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Spielt die Deklination bei GPS eine Rolle?</h3>
      <p>Nein. GPS-Geräte arbeiten mit geografischen Koordinaten und dem wahren Norden. Nur analoge Kompasse müssen korrigiert werden.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const directions = ['N', 'NNO', 'NO', 'ONO', 'O', 'OSO', 'SO', 'SSO', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'];
    function getDir(deg: number): string { return directions[Math.round(((deg % 360) + 360) % 360 / 22.5) % 16]; }
    function calcMD() {
      const decl = parseFloat((document.getElementById('md-decl') as HTMLInputElement).value) || 0;
      const bearing = parseFloat((document.getElementById('md-bearing') as HTMLInputElement).value) || 0;
      const trueBearing = ((bearing + decl) % 360 + 360) % 360;
      document.getElementById('md-result')!.textContent = trueBearing.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '°';
      document.getElementById('md-dir')!.textContent = getDir(trueBearing) + ' (wahrer Norden)';
      document.getElementById('md-decl-disp')!.textContent = (decl > 0 ? '+' : '') + decl.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + '° ' + (decl >= 0 ? 'Östlich' : 'Westlich');
      document.getElementById('md-compass-disp')!.textContent = bearing.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + '° ' + getDir(bearing);
      document.getElementById('md-explain')!.textContent = 'Korrektur: ' + bearing + '° (magnetisch) + ' + decl + '° Deklination = ' + trueBearing.toFixed(1) + '° (wahre Peilung)';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('md-city')!.addEventListener('change', () => {
        const val = (document.getElementById('md-city') as HTMLSelectElement).value;
        if (val) {
          const [lat, lon] = val.split('_');
          (document.getElementById('md-lat') as HTMLInputElement).value = lat;
          (document.getElementById('md-lon') as HTMLInputElement).value = lon;
        }
        calcMD();
      });
      ['md-decl', 'md-bearing', 'md-lat', 'md-lon'].forEach(id => document.getElementById(id)!.addEventListener('input', calcMD));
      calcMD();
    }, 50);
  </script>
</CalculatorLayout>
