---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kerzen-Brenndauer-Rechner";
const description = "Berechnen Sie, wie lange eine Kerze basierend auf Gewicht, Wachsart und Dochtgr\u00f6\u00dfe brennen wird.";
const relatedCalcs = [
  { name: "Kerzenherstellung", url: "/de/kerzenherstellung-rechner", description: "Kerzen herstellen." },
  { name: "Karamell-Rechner", url: "/de/karamell-rechner", description: "Karamell." },
  { name: "Einmach-Rechner", url: "/de/einmach-rechner", description: "Einmachen." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorien." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kerzen-Brenndauer-Rechner" lang="de" enSlug="candle-burn-time-calculator" keywords="kerzen brenndauer, kerze rechner, wachs brennrate, sojakerze, paraffinkerze" breadcrumbs={[{ name: "Kerzen-Brenndauer", url: "/de/kerzen-brenndauer-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kerzen-Brenndauer-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie, wie lange Ihre Kerze brennen wird.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kerzengewicht (g)</label><input type="number" id="kb-wt" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="225" min="0" step="10"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Wachsart</label>
            <select id="kb-wax" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0.25" selected>Sojawachs (~0,25 Std./g)</option>
              <option value="0.18">Paraffin (~0,18 Std./g)</option>
              <option value="0.21">Bienenwachs (~0,21 Std./g)</option>
              <option value="0.28">Kokoswachs (~0,28 Std./g)</option>
              <option value="0.23">Palmwachs (~0,23 Std./g)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kerzenpreis (&euro;)</label><input type="number" id="kb-price" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nutzung (Std./Tag)</label><input type="number" id="kb-use" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="24" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Brenndauer</div>
          <div class="text-5xl font-extrabold font-mono" id="kb-result">0 Std.</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nutzungstage</div><div class="text-xl font-bold font-mono" id="kb-days">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Stunde</div><div class="text-xl font-bold font-mono" id="kb-cph">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Tag</div><div class="text-xl font-bold font-mono" id="kb-cpd">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="candle-burn-time" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Wie lange brennt eine Kerze?</h3>
      <p>Die Brenndauer h&auml;ngt von Wachsart, Gewicht und Dochtgr&ouml;&szlig;e ab. Sojawachs brennt am l&auml;ngsten, Paraffin am schnellsten.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKB() {
      const wt = parseFloat((document.getElementById('kb-wt') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('kb-wax') as HTMLSelectElement).value) || 0.25;
      const price = parseFloat((document.getElementById('kb-price') as HTMLInputElement).value) || 0;
      const use = parseFloat((document.getElementById('kb-use') as HTMLInputElement).value) || 1;
      const totalHrs = wt * rate;
      const days = use > 0 ? totalHrs / use : 0;
      const costHr = totalHrs > 0 ? price / totalHrs : 0;
      const costDay = use > 0 ? costHr * use : 0;
      document.getElementById('kb-result')!.textContent = totalHrs.toFixed(0) + ' Std.';
      document.getElementById('kb-days')!.textContent = Math.floor(days).toString();
      document.getElementById('kb-cph')!.textContent = costHr.toFixed(2).replace('.', ',') + ' \u20ac';
      document.getElementById('kb-cpd')!.textContent = costDay.toFixed(2).replace('.', ',') + ' \u20ac';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kb-in').forEach(el => { el.addEventListener('input', calcKB); el.addEventListener('change', calcKB); });
      calcKB();
    }, 50);
  </script>
</CalculatorLayout>
