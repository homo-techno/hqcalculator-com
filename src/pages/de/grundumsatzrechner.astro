---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Grundumsatzrechner - Basalstoffwechselrate berechnen 2026";
const description = "Berechne deinen Grundumsatz (BMR) mit Mifflin-St Jeor, Harris-Benedict und Katch-McArdle. Finde heraus, wie viele Kalorien dein Koerper in Ruhe verbrennt.";

const relatedCalcs = [
  { name: "Energieverbrauchsrechner", url: "/de/energieverbrauchsrechner", description: "Tagesenergieverbrauch berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Taeglichen Kalorienbedarf berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index berechnen." },
  { name: "Koerperfettrechner", url: "/de/koerperfettrechner", description: "Koerperfettanteil schaetzen." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Gewichtsverlust planen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Grundumsatzrechner" keywords="Grundumsatzrechner, BMR Rechner, Basalstoffwechselrate, Ruheumsatz, Kalorienverbrauch Ruhe, Mifflin-St Jeor" breadcrumbs={[{ name: "Grundumsatzrechner", url: "/de/grundumsatzrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Grundumsatzrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne deinen Grundumsatz (BMR) — die Kalorien, die dein Koerper in vollstaendiger Ruhe benoetigt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-6">
            <label class="block text-sm font-medium text-text mb-2">Geschlecht</label>
            <div class="flex gap-2">
              <button class="bmr-gender-btn flex-1 py-3 rounded-xl font-semibold bg-primary text-white border border-primary cursor-pointer" data-gender="male">Maennlich</button>
              <button class="bmr-gender-btn flex-1 py-3 rounded-xl font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-gender="female">Weiblich</button>
            </div>
          </div>

          <div class="mb-6">
            <label class="block text-sm font-medium text-text mb-1">Alter</label>
            <input type="number" id="bmr-age" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="30" min="15" max="120">
          </div>

          <div class="mb-6">
            <label class="block text-sm font-medium text-text mb-2">Einheiten</label>
            <div class="flex gap-2">
              <button class="bmr-unit-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-primary text-white cursor-pointer" data-unit="metric">Metrisch (kg/cm)</button>
              <button class="bmr-unit-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-unit="imperial">Imperial (lbs/in)</button>
            </div>
          </div>

          <div class="mb-6" id="bmr-height-metric">
            <label class="block text-sm font-medium text-text mb-1">Groesse (cm)</label>
            <input type="number" id="bmr-height-cm" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="175" min="100" max="250">
          </div>
          <div class="mb-6 hidden" id="bmr-height-imperial">
            <label class="block text-sm font-medium text-text mb-1">Groesse</label>
            <div class="flex gap-3">
              <div class="flex-1"><input type="number" id="bmr-height-ft" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="5" min="3" max="8"><span class="text-xs text-text-muted">Fuss</span></div>
              <div class="flex-1"><input type="number" id="bmr-height-in" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="9" min="0" max="11"><span class="text-xs text-text-muted">Zoll</span></div>
            </div>
          </div>

          <div class="mb-6" id="bmr-weight-metric">
            <label class="block text-sm font-medium text-text mb-1">Gewicht (kg)</label>
            <input type="number" id="bmr-weight-kg" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="75" min="30" max="300">
          </div>
          <div class="mb-6 hidden" id="bmr-weight-imperial">
            <label class="block text-sm font-medium text-text mb-1">Gewicht (lbs)</label>
            <input type="number" id="bmr-weight-lbs" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="165" min="66" max="660">
          </div>

          <div class="mb-6">
            <label class="block text-sm font-medium text-text mb-1">Koerperfett % <span class="text-text-muted">(optional, fuer Katch-McArdle)</span></label>
            <input type="number" id="bmr-bodyfat" class="w-full px-4 py-3 border border-border rounded-xl text-lg" placeholder="z.B. 20" min="3" max="60">
          </div>
        </div>

        <div class="space-y-4">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Dein Grundumsatz</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="bmr-result">0</div>
            <div class="text-sm text-blue-200 mt-1">kcal/Tag</div>
          </div>

          <div class="space-y-3">
            <div class="p-4 bg-surface-alt rounded-xl">
              <div class="flex justify-between items-center">
                <div><div class="font-semibold text-text text-sm">Mifflin-St Jeor</div><div class="text-xs text-text-muted">Genaueste Formel fuer die meisten Menschen</div></div>
                <div class="text-xl font-bold text-primary" id="bmr-mifflin">0</div>
              </div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl">
              <div class="flex justify-between items-center">
                <div><div class="font-semibold text-text text-sm">Revidierte Harris-Benedict</div><div class="text-xs text-text-muted">Klassische Formel, revidiert 1984</div></div>
                <div class="text-xl font-bold" id="bmr-harris">0</div>
              </div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl">
              <div class="flex justify-between items-center">
                <div><div class="font-semibold text-text text-sm">Katch-McArdle</div><div class="text-xs text-text-muted">Nutzt fettfreie Koerpermasse (benoetigt Koerperfett %)</div></div>
                <div class="text-xl font-bold" id="bmr-katch">&mdash;</div>
              </div>
            </div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-text text-sm mb-3">Tagesverbrauch nach Aktivitaetslevel</h3>
            <div class="space-y-2 text-sm" id="bmr-activity-table"></div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="bmr" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist der Grundumsatz (BMR)?</h2>
      <p>Der Grundumsatz (Basal Metabolic Rate, BMR) ist die Anzahl an Kalorien, die dein Koerper fuer grundlegende lebenserhaltende Funktionen in vollstaendiger Ruhe benoetigt — Atmung, Kreislauf, Zellproduktion und Naehrstoffverarbeitung. Der BMR macht etwa 60-75 % deines taeglichen Gesamtkalorienverbrauchs aus.</p>

      <h3 class="text-xl font-semibold text-text mt-8">BMR-Formeln</h3>
      <p><strong>Mifflin-St Jeor Gleichung (1990)</strong> — gilt als die genaueste:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>Maenner: BMR = (10 &times; Gewicht in kg) + (6,25 &times; Groesse in cm) &minus; (5 &times; Alter) + 5</p>
        <p>Frauen: BMR = (10 &times; Gewicht in kg) + (6,25 &times; Groesse in cm) &minus; (5 &times; Alter) &minus; 161</p>
      </div>

      <p><strong>Revidierte Harris-Benedict Gleichung (1984):</strong></p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>Maenner: BMR = 88,362 + (13,397 &times; Gewicht) + (4,799 &times; Groesse) &minus; (5,677 &times; Alter)</p>
        <p>Frauen: BMR = 447,593 + (9,247 &times; Gewicht) + (3,098 &times; Groesse) &minus; (4,330 &times; Alter)</p>
      </div>

      <p><strong>Katch-McArdle Gleichung</strong> (benoetigt Koerperfettanteil):</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>BMR = 370 + (21,6 &times; fettfreie Koerpermasse in kg)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Faktoren, die den Grundumsatz beeinflussen</h3>
      <ul>
        <li><strong>Alter:</strong> Der BMR sinkt ab dem 20. Lebensjahr um ca. 1-2 % pro Jahrzehnt</li>
        <li><strong>Geschlecht:</strong> Maenner haben typischerweise einen hoeheren BMR wegen mehr Muskelmasse</li>
        <li><strong>Muskelmasse:</strong> Mehr Muskeln = hoeherer BMR (Muskeln verbrennen mehr Kalorien als Fett)</li>
        <li><strong>Koerpergroesse:</strong> Groessere Koerper benoetigen mehr Energie fuer Grundfunktionen</li>
        <li><strong>Genetik:</strong> Manche Menschen haben von Natur aus einen schnelleren oder langsameren Stoffwechsel</li>
        <li><strong>Hormone:</strong> Schilddruesenhormone beeinflussen den Stoffwechsel erheblich</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">BMR vs. RMR vs. TDEE</h3>
      <ul>
        <li><strong>BMR:</strong> Kalorienverbrauch in absoluter Ruhe (unter klinischen Bedingungen gemessen)</li>
        <li><strong>RMR:</strong> Ruheumsatz — aehnlich wie BMR, aber unter weniger strengen Bedingungen. Meist 10-20 % hoeher.</li>
        <li><strong>TDEE:</strong> Gesamtenergieverbrauch — BMR &times; Aktivitaetsfaktor. Das ist dein tatsaechlicher taeglicher Kalorienverbrauch.</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let bmrGender = 'male';
    let bmrUnit = 'metric';

    const activities = [
      { label: 'Sitzend (Bueroarbeit)', mult: 1.2 },
      { label: 'Leichte Bewegung (1-2 Tage/Woche)', mult: 1.375 },
      { label: 'Moderate Bewegung (3-5 Tage/Woche)', mult: 1.55 },
      { label: 'Intensive Bewegung (6-7 Tage/Woche)', mult: 1.725 },
      { label: 'Leistungssportler (2x taeglich)', mult: 1.9 },
    ];

    function getWeight(): number {
      if (bmrUnit === 'metric') return parseFloat((document.getElementById('bmr-weight-kg') as HTMLInputElement).value) || 0;
      return (parseFloat((document.getElementById('bmr-weight-lbs') as HTMLInputElement).value) || 0) * 0.453592;
    }

    function getHeight(): number {
      if (bmrUnit === 'metric') return parseFloat((document.getElementById('bmr-height-cm') as HTMLInputElement).value) || 0;
      const ft = parseFloat((document.getElementById('bmr-height-ft') as HTMLInputElement).value) || 0;
      const inch = parseFloat((document.getElementById('bmr-height-in') as HTMLInputElement).value) || 0;
      return (ft * 12 + inch) * 2.54;
    }

    function calcBMR() {
      const weight = getWeight();
      const height = getHeight();
      const age = parseFloat((document.getElementById('bmr-age') as HTMLInputElement).value) || 0;
      const bodyFat = parseFloat((document.getElementById('bmr-bodyfat') as HTMLInputElement).value);

      let mifflin: number;
      if (bmrGender === 'male') { mifflin = 10 * weight + 6.25 * height - 5 * age + 5; }
      else { mifflin = 10 * weight + 6.25 * height - 5 * age - 161; }

      let harris: number;
      if (bmrGender === 'male') { harris = 88.362 + 13.397 * weight + 4.799 * height - 5.677 * age; }
      else { harris = 447.593 + 9.247 * weight + 3.098 * height - 4.330 * age; }

      let katch: number | null = null;
      if (!isNaN(bodyFat) && bodyFat > 0) {
        const leanMass = weight * (1 - bodyFat / 100);
        katch = 370 + 21.6 * leanMass;
      }

      const primaryBMR = Math.round(mifflin);
      document.getElementById('bmr-result')!.textContent = primaryBMR.toLocaleString('de-DE');
      document.getElementById('bmr-mifflin')!.textContent = Math.round(mifflin).toLocaleString('de-DE') + ' kcal';
      document.getElementById('bmr-harris')!.textContent = Math.round(harris).toLocaleString('de-DE') + ' kcal';
      document.getElementById('bmr-katch')!.textContent = katch !== null ? Math.round(katch).toLocaleString('de-DE') + ' kcal' : '\u2014';

      const tableEl = document.getElementById('bmr-activity-table')!;
      tableEl.innerHTML = activities.map(a => {
        const cal = Math.round(primaryBMR * a.mult);
        return `<div class="flex justify-between items-center py-1"><span class="text-text-secondary">${a.label}</span><span class="font-bold">${cal.toLocaleString('de-DE')} kcal</span></div>`;
      }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bmr-gender-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bmr-gender-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white', 'border-primary'); b.classList.add('bg-surface-alt', 'text-text-secondary', 'border-border'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary', 'border-border'); btn.classList.add('bg-primary', 'text-white', 'border-primary');
          bmrGender = (btn as HTMLElement).dataset.gender || 'male';
          calcBMR();
        });
      });

      document.querySelectorAll('.bmr-unit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bmr-unit-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          bmrUnit = (btn as HTMLElement).dataset.unit || 'metric';
          const isMetric = bmrUnit === 'metric';
          document.getElementById('bmr-height-metric')!.classList.toggle('hidden', !isMetric);
          document.getElementById('bmr-height-imperial')!.classList.toggle('hidden', isMetric);
          document.getElementById('bmr-weight-metric')!.classList.toggle('hidden', !isMetric);
          document.getElementById('bmr-weight-imperial')!.classList.toggle('hidden', isMetric);
          calcBMR();
        });
      });

      ['bmr-age', 'bmr-height-cm', 'bmr-height-ft', 'bmr-height-in', 'bmr-weight-kg', 'bmr-weight-lbs', 'bmr-bodyfat'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcBMR);
      });

      calcBMR();
    }, 50);
  </script>
</CalculatorLayout>
