---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Pferdefutter Rechner - Taeglicher Heu & Kraftfutter Bedarf 2026";
const description = "Berechne den taeglichen Heu-, Kraftfutter- und Ergaenzungsfutterbedarf fuer dein Pferd basierend auf Gewicht und Belastung. Pferdeernaehrung optimieren.";

const relatedCalcs = [
  { name: "Pferdegewicht-Rechner", url: "/de/pferdegewicht-rechner", description: "Pferdegewicht schaetzen." },
  { name: "Huehnerfutter-Rechner", url: "/de/huehnerfutter-rechner", description: "Gefluegelfutter." },
  { name: "Hundefutter-Rechner", url: "/de/hundefutter-rechner", description: "Hundefutter berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Pferdefutter-Rechner" keywords="Pferdefutter Rechner, Heumenge Pferd, Kraftfutter Pferd, Pferdegewicht Futterration, Equine Ernaehrung, Futterbedarf Pferd" breadcrumbs={[{ name: "Pferdefutter-Rechner", url: "/de/pferdefutter-rechner" }]} lang="de" enSlug="horse-feed-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Pferdefutter-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne die taegliche Heu-, Kraftfutter- und Ergaenzungsmittelmenge basierend auf Gewicht und Belastung deines Pferdes.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Pferdegewicht (kg)</label>
            <input type="number" id="pfr-weight" class="pfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="100" max="1200" step="25">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Belastungsklasse</label>
            <select id="pfr-work" class="pfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="maintenance">Ruhe (keine Arbeit)</option>
              <option value="light" selected>Leicht (Freizeitreiten)</option>
              <option value="moderate">Mittel (regelmaessiges Training)</option>
              <option value="heavy">Schwer (Turniersport)</option>
              <option value="intense">Intensiv (Rennen)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Lebensphase</label>
            <select id="pfr-stage" class="pfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="growing">Wachstum (unter 2 Jahre)</option>
              <option value="adult" selected>Erwachsen</option>
              <option value="pregnant">Trächtig</option>
              <option value="lactating">Stillend</option>
              <option value="senior">Senior (20+ Jahre)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Heupreis (€/Ballen ~25 kg)</label>
            <input type="number" id="pfr-haycost" class="pfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0" step="0.5">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Tagesration</div>
          <div class="text-5xl font-extrabold font-mono" id="pfr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Heu / Tag</div><div class="text-xl font-bold font-mono" id="pfr-hay">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraftfutter / Tag</div><div class="text-xl font-bold font-mono" id="pfr-grain">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raufutter-Quote</div><div class="text-xl font-bold font-mono" id="pfr-ratio">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Salz (g/Tag)</div><div class="text-xl font-bold font-mono" id="pfr-salt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">DE (MJ/Tag)</div><div class="text-xl font-bold font-mono" id="pfr-energy">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Heukosten</div><div class="text-xl font-bold font-mono" id="pfr-cost">--</div></div>
        </div>
      </div>

      <ShareButton calculatorId="horse-feed" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Pferdeernaehrung richtig planen</h2>
      <p>Pferde benoetigen taegliches Raufutter (Heu, Gras) von mindestens 1,5 % ihres Koerpergewichts. Bei Arbeitsbelastung steigt der Kraftfutterbedarf, waehrend das Raufutter immer die Basis der Ration bilden sollte.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie viel Heu braucht ein Pferd?</strong> Als Faustregel gilt 1,5-2,5 % des Koerpergewichts pro Tag als Gesamtfutteraufnahme, davon mindestens 50-85 % Raufutter je nach Belastung.</p>
      <p><strong>Wann sollte ich Kraftfutter geben?</strong> Kraftfutter ist noetig, wenn der Energiebedarf durch Raufutter allein nicht gedeckt werden kann – bei intensiver Arbeit, Wachstum, Traechtigkeit oder Laktation.</p>
      <p><strong>Wie viel Wasser braucht ein Pferd?</strong> Ein erwachsenes Pferd trinkt 25-50 Liter Wasser pro Tag, bei heissem Wetter oder Arbeit entsprechend mehr.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcPFR() {
      const weight = parseFloat((document.getElementById('pfr-weight') as HTMLInputElement).value) || 0;
      const work = (document.getElementById('pfr-work') as HTMLSelectElement).value;
      const stage = (document.getElementById('pfr-stage') as HTMLSelectElement).value;
      const hayCost = parseFloat((document.getElementById('pfr-haycost') as HTMLInputElement).value) || 0;

      const intakePct: Record<string, number> = { maintenance: 0.02, light: 0.022, moderate: 0.025, heavy: 0.028, intense: 0.03 };
      const foragePct: Record<string, number> = { maintenance: 1.0, light: 0.85, moderate: 0.70, heavy: 0.60, intense: 0.50 };
      const stageAdj: Record<string, number> = { growing: 1.15, adult: 1.0, pregnant: 1.1, lactating: 1.25, senior: 0.95 };

      let totalIntake = weight * (intakePct[work] || 0.022);
      totalIntake *= stageAdj[stage] || 1.0;

      const forageRatio = foragePct[work] || 0.85;
      const hayKg = totalIntake * forageRatio;
      const grainKg = totalIntake * (1 - forageRatio);

      const deBase = 0.0333 * weight * 4.18;
      const workDE: Record<string, number> = { maintenance: 1.0, light: 1.2, moderate: 1.4, heavy: 1.6, intense: 1.9 };
      const dailyDE = deBase * (workDE[work] || 1.2);

      const saltG = work === 'maintenance' ? 30 : work === 'light' ? 45 : 60;
      const ballesMonth = (hayKg * 30) / 25;
      const monthlyCost = ballesMonth * hayCost;
      const ratioDisplay = Math.round(forageRatio * 100) + ':' + Math.round((1 - forageRatio) * 100);

      document.getElementById('pfr-result')!.textContent = totalIntake.toFixed(1) + ' kg';
      document.getElementById('pfr-hay')!.textContent = hayKg.toFixed(1) + ' kg';
      document.getElementById('pfr-grain')!.textContent = grainKg.toFixed(1) + ' kg';
      document.getElementById('pfr-ratio')!.textContent = ratioDisplay;
      document.getElementById('pfr-salt')!.textContent = saltG.toString();
      document.getElementById('pfr-energy')!.textContent = dailyDE.toFixed(1) + ' MJ';
      document.getElementById('pfr-cost')!.textContent = monthlyCost.toFixed(0) + ' €';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.pfr-in').forEach(el => {
        el.addEventListener('input', calcPFR);
        el.addEventListener('change', calcPFR);
      });
      calcPFR();
    }, 50);
  </script>
</CalculatorLayout>
