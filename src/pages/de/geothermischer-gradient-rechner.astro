---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Geothermischer Gradient-Rechner - Temperatur in der Tiefe";
const description = "Temperatur in der Tiefe aus Oberfl\u00E4chentemperatur und geothermischem Gradienten berechnen. W\u00E4rmefluss und W\u00E4rmeleitf\u00E4higkeit f\u00FCr geologische Studien sch\u00E4tzen.";
const relatedCalcs = [
  { name: "Temperaturrechner", url: "/de/temperaturrechner", description: "Temperaturen umrechnen." },
  { name: "W\u00E4rme\u00FCbertragungs-Rechner", url: "/de/waermeuebertragung-rechner", description: "W\u00E4rme\u00FCbertragung." },
  { name: "Druckumrechner", url: "/de/druckumrechner", description: "Druckeinheiten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Geothermischer Gradient-Rechner" lang="de" enSlug="geothermal-gradient-calculator" keywords="geothermischer gradient, temperatur in der tiefe, w\u00E4rmefluss, w\u00E4rmeleitf\u00E4higkeit, geothermische energie" breadcrumbs={[{ name: "Geothermischer Gradient", url: "/de/geothermischer-gradient-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Geothermischer Gradient-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Unterirdische Temperatur in beliebiger Tiefe mit dem geothermischen Gradienten sch&auml;tzen und W&auml;rmefluss aus der W&auml;rmeleitf&auml;higkeit berechnen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Oberfl&auml;chentemperatur (&deg;C)</label>
            <input type="number" id="ggg-surface" class="ggg-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Geotherm. Gradient (&deg;C/km)</label>
            <input type="number" id="ggg-gradient" class="ggg-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="30" min="0" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Zieltiefe (m)</label>
            <input type="number" id="ggg-depth" class="ggg-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="3000" min="0" step="100">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">W&auml;rmeleitf&auml;higkeit (W/m&middot;K)</label>
            <input type="number" id="ggg-conduct" class="ggg-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="2.5" min="0" step="0.1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Geologisches Setting</label>
          <select id="ggg-setting" class="ggg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="30">Kontinentaler Durchschnitt (30&deg;C/km)</option>
            <option value="40">Aktive Riftzone (40&deg;C/km)</option>
            <option value="60">Vulkangebiet (60&deg;C/km)</option>
            <option value="80">Geothermischer Hotspot (80&deg;C/km)</option>
            <option value="15">Stabiler Kraton (15&deg;C/km)</option>
            <option value="20">Ozeanische Kruste (20&deg;C/km)</option>
            <option value="0">Benutzerdefiniert</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Temperatur in der Tiefe</div>
          <div class="text-4xl font-extrabold" id="ggg-temp">0&deg;C</div>
          <div class="text-sm text-blue-200 mt-1" id="ggg-tempf">0&deg;F</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">W&auml;rmefluss</div>
            <div class="text-xl font-bold" id="ggg-heatflow">0 mW/m&sup2;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Tiefe (km)</div>
            <div class="text-xl font-bold" id="ggg-depthkm">0 km</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Temperaturanstieg</div>
            <div class="text-xl font-bold" id="ggg-increase">0&deg;C</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Siedetiefe</div>
            <div class="text-xl font-bold" id="ggg-boiling">0 m</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Geothermische Eignung</div>
          <div class="text-xl font-bold" id="ggg-suit">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="geothermal-gradient" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Geothermischer Gradient: Formel</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>T(Tiefe)</strong> = T(Oberfl&auml;che) + Gradient &times; Tiefe</p>
        <p><strong>W&auml;rmefluss</strong> = W&auml;rmeleitf&auml;higkeit &times; Gradient (in &deg;C/m)</p>
        <p><strong>Siedetiefe</strong> = (100 - T(Oberfl&auml;che)) / Gradient &times; 1000</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der geothermische Gradient?</strong> Der Temperaturgradient beschreibt, wie stark die Temperatur mit der Tiefe zunimmt. In Deutschland betr&auml;gt er durchschnittlich 30&deg;C pro km.</p>
      <p><strong>Ab welcher Tiefe l&auml;sst sich Strom erzeugen?</strong> F&uuml;r die Stromerzeugung sind typischerweise Temperaturen &uuml;ber 150&deg;C erforderlich, was in Deutschland Tiefen von &uuml;ber 4.000 m entspricht.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcGGG() {
      const surface = parseFloat((document.getElementById('ggg-surface') as HTMLInputElement).value) || 0;
      let gradient = parseFloat((document.getElementById('ggg-gradient') as HTMLInputElement).value) || 0;
      const depth = parseFloat((document.getElementById('ggg-depth') as HTMLInputElement).value) || 0;
      const conduct = parseFloat((document.getElementById('ggg-conduct') as HTMLInputElement).value) || 0;
      const setting = (document.getElementById('ggg-setting') as HTMLSelectElement).value;
      if (setting !== '0') {
        gradient = parseFloat(setting);
        (document.getElementById('ggg-gradient') as HTMLInputElement).value = setting;
      }
      const depthKm = depth / 1000;
      const tempIncrease = gradient * depthKm;
      const tempAtDepth = surface + tempIncrease;
      const tempF = tempAtDepth * 9 / 5 + 32;
      const heatFlow = conduct * (gradient / 1000) * 1000;
      const boilingDepth = gradient > 0 ? ((100 - surface) / gradient) * 1000 : 0;
      let suitability = '';
      if (tempAtDepth >= 150) suitability = 'Ausgezeichnet \u2013 Stromerzeugung';
      else if (tempAtDepth >= 100) suitability = 'Gut \u2013 Bin\u00E4rkraftwerk';
      else if (tempAtDepth >= 50) suitability = 'M\u00E4\u00DFig \u2013 Direktnutzung (Heizung)';
      else if (tempAtDepth >= 25) suitability = 'Gering \u2013 Erdw\u00E4rmepumpe';
      else suitability = 'Minimales geothermisches Potenzial';
      const fmt = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('ggg-temp')!.textContent = fmt(tempAtDepth) + '\u00B0C';
      document.getElementById('ggg-tempf')!.textContent = fmt(tempF) + '\u00B0F';
      document.getElementById('ggg-heatflow')!.textContent = fmt(heatFlow) + ' mW/m\u00B2';
      document.getElementById('ggg-depthkm')!.textContent = (depthKm).toFixed(2) + ' km';
      document.getElementById('ggg-increase')!.textContent = '+' + fmt(tempIncrease) + '\u00B0C';
      document.getElementById('ggg-boiling')!.textContent = fmt(boilingDepth) + ' m';
      document.getElementById('ggg-suit')!.textContent = suitability;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ggg-in').forEach(el => { el.addEventListener('input', calcGGG); el.addEventListener('change', calcGGG); });
      calcGGG();
    }, 50);
  </script>
</CalculatorLayout>
