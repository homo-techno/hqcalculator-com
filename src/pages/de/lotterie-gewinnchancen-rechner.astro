---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lotterie Gewinnchancen Rechner – Lotto 6aus49 & mehr";
const description = "Berechnen Sie die Gewinnwahrscheinlichkeiten für Lotto 6aus49 und andere Lotterien. Alle Gewinnklassen auf einen Blick.";

const relatedCalcs = [
  { name: "Beute-Drop Rechner", url: "/de/beute-drop-rechner", description: "Drop-Wahrscheinlichkeiten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Statistik-Rechner", url: "/de/statistik-rechner", description: "Statistik." },
];
---
<CalculatorLayout lang="de" enSlug="lottery-odds-calculator" title={title} description={description} calculatorName="Lotterie Gewinnchancen Rechner" keywords="Lotto Wahrscheinlichkeit, 6aus49 Gewinnchancen, Lotterie Odds, Jackpot Chance" breadcrumbs={[{ name: "Lotterie Gewinnchancen", url: "/de/lotterie-gewinnchancen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lotterie Gewinnchancen Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Gewinnwahrscheinlichkeiten für verschiedene Lotterien und Gewinnklassen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Lotterie auswählen</label>
          <select id="lot-typ" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="6_49_6" selected>Lotto 6aus49 – Jackpot (6 Richtige)</option>
            <option value="6_49_5">Lotto 6aus49 – 5 Richtige + Superzahl</option>
            <option value="6_49_5n">Lotto 6aus49 – 5 Richtige</option>
            <option value="6_49_4">Lotto 6aus49 – 4 Richtige</option>
            <option value="6_49_3">Lotto 6aus49 – 3 Richtige</option>
            <option value="eurojackpot">EuroJackpot (5+2)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div id="lot-custom" class="hidden grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kugeln gesamt (n)</label>
            <input type="number" id="lot-n" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="49" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gezogene Kugeln (k)</label>
            <input type="number" id="lot-k" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="6" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Richtige benötigt (r)</label>
            <input type="number" id="lot-r" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="6" min="1" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gewinnchance (1 zu …)</div>
          <div class="text-3xl font-extrabold font-mono" id="lot-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="lot-pct"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Tipps für 50% Chance</div>
            <div class="text-xl font-bold font-mono" id="lot-t50">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Tipps/Woche bis 90%</div>
            <div class="text-xl font-bold font-mono" id="lot-t90">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="lottery-odds" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie werden Lotto-Gewinnchancen berechnet?</h2>
      <p>Die Gewinnchancen beim Lotto werden mit dem Binomialkoeffizienten berechnet. Beim deutschen Lotto 6aus49 werden 6 Zahlen aus 49 gezogen. Die Anzahl möglicher Kombinationen beträgt C(49,6) = 13.983.816. Die Chance, alle 6 Richtigen zu tippen, liegt daher bei 1 zu 13.983.816 – also etwa 0,000007 %.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Wie hoch ist die Jackpot-Chance beim deutschen Lotto?</h3>
      <p>Die Jackpot-Chance (6 Richtige ohne Superzahl) beträgt 1 zu 13.983.816. Mit Superzahl ist es 1 zu 139.838.160.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Verbessert mehr spielen die Chancen?</h3>
      <p>Ja – jeder Tipp ist ein unabhängiger Versuch. Mit zwei Tipps verdoppeln Sie Ihre Chancen. Allerdings bleiben die absoluten Chancen auch bei 100 Tipps verschwindend gering.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Gibt es eine Strategie, die Gewinnchancen zu erhöhen?</h3>
      <p>Nein. Lotto ist ein reines Zufallsspiel. Keine Strategie, kein System und keine Zahlenkombination erhöht die mathematische Wahrscheinlichkeit.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der EuroJackpot und wie unterscheiden sich die Chancen?</h3>
      <p>Beim EuroJackpot werden 5 aus 50 Zahlen und 2 aus 12 Eurozahlen gezogen. Die Jackpot-Chance beträgt 1 zu 139.838.160 – identisch mit Lotto 6aus49 + Superzahl.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function binom(n: number, k: number): number {
      if (k > n) return 0;
      if (k === 0 || k === n) return 1;
      let result = 1;
      for (let i = 0; i < k; i++) {
        result = result * (n - i) / (i + 1);
      }
      return Math.round(result);
    }
    const presets: Record<string, number> = {
      '6_49_6': binom(49, 6),
      '6_49_5': binom(49, 6) * 10,
      '6_49_5n': Math.round(binom(49, 6) / (binom(6, 5) * binom(43, 1))),
      '6_49_4': Math.round(binom(49, 6) / (binom(6, 4) * binom(43, 2))),
      '6_49_3': Math.round(binom(49, 6) / (binom(6, 3) * binom(43, 3))),
      'eurojackpot': binom(50, 5) * binom(12, 2),
    };
    function calcLot() {
      const typ = (document.getElementById('lot-typ') as HTMLSelectElement).value;
      const isCustom = typ === 'custom';
      document.getElementById('lot-custom')!.classList.toggle('hidden', !isCustom);
      let odds: number;
      if (isCustom) {
        const n = parseInt((document.getElementById('lot-n') as HTMLInputElement).value) || 49;
        const k = parseInt((document.getElementById('lot-k') as HTMLInputElement).value) || 6;
        const r = parseInt((document.getElementById('lot-r') as HTMLInputElement).value) || 6;
        odds = Math.round(binom(n, k) / (binom(k, r) * binom(n - k, k - r)));
      } else {
        odds = presets[typ] || presets['6_49_6'];
      }
      const pct = (1 / odds * 100);
      const t50 = Math.ceil(Math.log(0.5) / Math.log(1 - 1 / odds));
      const t90 = Math.ceil(Math.log(0.1) / Math.log(1 - 1 / odds));
      document.getElementById('lot-result')!.textContent = '1 zu ' + odds.toLocaleString('de-DE');
      document.getElementById('lot-pct')!.textContent = pct.toLocaleString('de-DE', { maximumSignificantDigits: 3 }) + ' %';
      document.getElementById('lot-t50')!.textContent = t50.toLocaleString('de-DE');
      document.getElementById('lot-t90')!.textContent = t90.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('lot-typ')!.addEventListener('change', calcLot);
      ['lot-n', 'lot-k', 'lot-r'].forEach(id => document.getElementById(id)!.addEventListener('input', calcLot));
      calcLot();
    }, 50);
  </script>
</CalculatorLayout>
