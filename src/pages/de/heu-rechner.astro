---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Heu-Rechner - T&auml;glicher, Monatlicher &amp; J&auml;hrlicher Heubedarf";
const description = "Berechnen Sie den Heubedarf f&uuml;r Pferde und Rinder basierend auf Tieranzahl, Gewicht und Heu-Prozentsatz des K&ouml;rpergewichts pro Tag.";

const relatedCalcs = [
  { name: "H&uuml;hnerfutter-Rechner", url: "/de/huehnerfutter-rechner", description: "H&uuml;hnerfutter und Eierkosten." },
  { name: "Hundefutter-Rechner", url: "/de/hundefutter-rechner", description: "Hundefutterbedarf." },
  { name: "D&uuml;nger-Rechner", url: "/de/duenger-rechner", description: "D&uuml;ngerbedarf." },
  { name: "Kompost-Rechner", url: "/de/kompost-rechner", description: "Kompostzusammensetzung." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Heu-Rechner"
  keywords="heu rechner, pferd heubedarf, rinder heu, ballen pro monat, heukosten, viehfutter"
  breadcrumbs={[{ name: "Heu-Rechner", url: "/de/heu-rechner" }]}
  lang="de"
  enSlug="hay-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Heu-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den t&auml;glichen, monatlichen und j&auml;hrlichen Heubedarf und die Kosten f&uuml;r Ihr Vieh.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tierart</label>
            <select id="heude-animal" class="heude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="horse" selected>Pferd</option>
              <option value="cattle">Rind</option>
              <option value="goat">Ziege</option>
              <option value="sheep">Schaf</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Tiere</label>
            <input type="number" id="heude-count" class="heude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" step="1">
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Durchschn. Gewicht (kg)</label>
            <input type="number" id="heude-weight" class="heude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="20" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Heu % K&ouml;rpergewicht/Tag</label>
            <input type="number" id="heude-pct" class="heude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0.5" max="4" step="0.1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ballengewicht (kg)</label>
            <input type="number" id="heude-bale" class="heude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="5" step="1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kosten pro Ballen (&euro;)</label>
          <input type="number" id="heude-cost" class="heude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="0.5">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Heu pro Tag (alle Tiere)</div>
          <div class="text-5xl font-extrabold font-mono" id="heude-result">0 kg</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ballen / Monat</div><div class="text-xl font-bold font-mono" id="heude-monthly">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ballen / Jahr</div><div class="text-xl font-bold font-mono" id="heude-annual">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">kg / Monat</div><div class="text-xl font-bold font-mono" id="heude-kgmonth">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Kosten</div><div class="text-xl font-bold font-mono" id="heude-mcost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Kosten</div><div class="text-xl font-bold font-mono" id="heude-acost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Tier / Tag</div><div class="text-xl font-bold font-mono" id="heude-peranimal">0 kg</div></div>
        </div>
      </div>

      <ShareButton calculatorId="heu-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Heubedarf berechnen</h2>
      <p>Als Faustregel ben&ouml;tigen Pferde t&auml;glich 1,5 bis 2,5 % ihres K&ouml;rpergewichts an Heu oder Raufutter. Bei einem 500-kg-Pferd entspricht das 7,5-12,5 kg Heu pro Tag.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel Heu ben&ouml;tigt ein Pferd?</strong> Ein durchschnittliches Pferd (500 kg) ben&ouml;tigt 2 % seines K&ouml;rpergewichts pro Tag, also etwa 10 kg Heu t&auml;glich. Bei Arbeits- und Sportpferden kann der Bedarf h&ouml;her sein.</p>
      <p><strong>Wie viele Heuballen brauche ich pro Jahr?</strong> Bei einem Pferd (500 kg, 2 % K&ouml;rpergewicht, 25-kg-Ballen) ben&ouml;tigen Sie etwa 146 Ballen pro Jahr pro Tier.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHEUDE() {
      const count = parseFloat((document.getElementById('heude-count') as HTMLInputElement).value) || 0;
      const weight = parseFloat((document.getElementById('heude-weight') as HTMLInputElement).value) || 0;
      const pct = parseFloat((document.getElementById('heude-pct') as HTMLInputElement).value) || 0;
      const baleWeight = parseFloat((document.getElementById('heude-bale') as HTMLInputElement).value) || 25;
      const costPerBale = parseFloat((document.getElementById('heude-cost') as HTMLInputElement).value) || 0;

      const perAnimalDay = weight * (pct / 100);
      const totalDayKg = perAnimalDay * count;
      const monthKg = totalDayKg * 30;
      const yearKg = totalDayKg * 365;
      const balesMonth = Math.ceil(monthKg / baleWeight);
      const balesYear = Math.ceil(yearKg / baleWeight);
      const monthlyCost = balesMonth * costPerBale;
      const annualCost = balesYear * costPerBale;

      const fmtEur = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' \u20AC';

      document.getElementById('heude-result')!.textContent = totalDayKg.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' kg';
      document.getElementById('heude-monthly')!.textContent = balesMonth.toString();
      document.getElementById('heude-annual')!.textContent = balesYear.toString();
      document.getElementById('heude-kgmonth')!.textContent = monthKg.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.getElementById('heude-mcost')!.textContent = fmtEur(monthlyCost);
      document.getElementById('heude-acost')!.textContent = fmtEur(annualCost);
      document.getElementById('heude-peranimal')!.textContent = perAnimalDay.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' kg';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.heude-in').forEach(el => { el.addEventListener('input', calcHEUDE); el.addEventListener('change', calcHEUDE); });
      calcHEUDE();
    }, 50);
  </script>
</CalculatorLayout>
