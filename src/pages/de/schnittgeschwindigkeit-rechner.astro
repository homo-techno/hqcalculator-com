---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schnittgeschwindigkeit-Rechner - Drehzahl & Vorschub";
const description = "Berechnen Sie Schnittgeschwindigkeit, Spindeldrehzahl und Vorschub fuer verschiedene Materialien und Werkzeugdurchmesser. Optimieren Sie Zerspanungsparameter.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "Flaechenrechner", url: "/de/flaechenrechner", description: "Flaechen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitte." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen." },
  { name: "Zylinder-Rechner", url: "/de/zylinder-rechner", description: "Zylinderberechnungen." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Erweiterte Mathematik." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Schnittgeschwindigkeit-Rechner" keywords="Schnittgeschwindigkeit, Drehzahl, Vorschub, Drehen, Fraesen, Zerspanung, Spindeldrehzahl" breadcrumbs={[{ name: "Schnittgeschwindigkeit-Rechner", url: "/de/schnittgeschwindigkeit-rechner" }]} lang="de" enSlug="cutting-speed-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schnittgeschwindigkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Spindeldrehzahl, Schnittgeschwindigkeit und Vorschub fuer Dreh- und Fraesoperationen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Berechnen</label>
        <select id="sgr-mode" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="rpm">Drehzahl aus Vc und Durchmesser</option>
          <option value="sfm">Vc aus Drehzahl und Durchmesser</option>
        </select>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Werkstoff</label>
        <select id="sgr-material" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="30">Baustahl / S235 (25-40 m/min)</option>
          <option value="25">Verguetungsstahl (20-30 m/min)</option>
          <option value="18">Legierter Stahl / 42CrMo4 (12-25 m/min)</option>
          <option value="12">Werkzeugstahl / gehaertet (8-18 m/min)</option>
          <option value="18">Edelstahl 1.4301 (12-25 m/min)</option>
          <option value="90">Aluminium 6061 (60-120 m/min)</option>
          <option value="60">Messing / Bronze (45-90 m/min)</option>
          <option value="30">Kupfer (25-40 m/min)</option>
          <option value="150">Kunststoff / Nylon (100-250 m/min)</option>
          <option value="15">Gusseisen (12-25 m/min)</option>
          <option value="15">Titan (10-20 m/min)</option>
        </select>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Schneidstoff</label>
        <select id="sgr-tool" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="1.0">HSS (Schnellarbeitsstahl)</option>
          <option value="2.5" selected>Hartmetall</option>
          <option value="4.0">Keramik</option>
          <option value="5.0">CBN / Diamant</option>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Schnittgeschwindigkeit (m/min)</label>
          <input type="number" id="sgr-vc" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="1" step="5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Spindeldrehzahl (U/min)</label>
          <input type="number" id="sgr-rpm" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="955" min="1" step="10">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Durchmesser (mm)</label>
          <input type="number" id="sgr-dia" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0.1" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Vorschub pro Zahn (mm)</label>
          <input type="number" id="sgr-fz" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.1" min="0.01" step="0.01">
        </div>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Anzahl Schneiden</label>
        <input type="number" id="sgr-flutes" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="12" step="1">
        <p class="text-xs text-text-muted mt-1">Fuer Fraesen (1 fuer Drehen)</p>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="sgr-resultlabel">Spindeldrehzahl</div>
        <div class="text-4xl font-extrabold" id="sgr-result">--</div>
        <div class="text-sm text-blue-200 mt-1" id="sgr-resultunit">U/min</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Schnittgeschwindigkeit</div>
          <div class="text-xl font-bold" id="sgr-vcout">--</div>
          <div class="text-xs text-text-muted">m/min</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Vorschubgeschwindigkeit</div>
          <div class="text-xl font-bold" id="sgr-feed">--</div>
          <div class="text-xs text-text-muted">mm/min</div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Zeitspanvolumen (ca.)</div>
          <div class="text-xl font-bold" id="sgr-mrr">--</div>
          <div class="text-xs text-text-muted">cm3/min</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Empfohlene Vc</div>
          <div class="text-xl font-bold" id="sgr-recvc">--</div>
          <div class="text-xs text-text-muted">fuer dieses Material + Werkzeug</div>
        </div>
      </div>

      <ShareButton calculatorId="cutting-speed" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Formeln zur Schnittgeschwindigkeit</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>n</strong> = (Vc x 1000) / (pi x d)</p>
        <p><strong>Vc</strong> = (pi x d x n) / 1000</p>
        <p><strong>Vf (mm/min)</strong> = n x fz x z</p>
      </div>
      <p>Wobei d = Durchmesser in mm, Vc = Schnittgeschwindigkeit in m/min, fz = Vorschub pro Zahn, z = Anzahl Schneiden.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSGR() {
      const mode = (document.getElementById('sgr-mode') as HTMLSelectElement).value;
      const baseVc = parseFloat((document.getElementById('sgr-material') as HTMLSelectElement).value) || 30;
      const toolFactor = parseFloat((document.getElementById('sgr-tool') as HTMLSelectElement).value) || 1.0;
      let vc = parseFloat((document.getElementById('sgr-vc') as HTMLInputElement).value) || 0;
      let rpm = parseFloat((document.getElementById('sgr-rpm') as HTMLInputElement).value) || 0;
      const dia = parseFloat((document.getElementById('sgr-dia') as HTMLInputElement).value) || 25;
      const fz = parseFloat((document.getElementById('sgr-fz') as HTMLInputElement).value) || 0.1;
      const flutes = parseFloat((document.getElementById('sgr-flutes') as HTMLInputElement).value) || 4;

      const recVc = Math.round(baseVc * toolFactor);

      if (mode === 'rpm') {
        rpm = (vc * 1000) / (Math.PI * dia);
        document.getElementById('sgr-resultlabel')!.textContent = 'Spindeldrehzahl';
        document.getElementById('sgr-result')!.textContent = Math.round(rpm).toLocaleString('de-DE');
        document.getElementById('sgr-resultunit')!.textContent = 'U/min';
      } else {
        vc = (Math.PI * dia * rpm) / 1000;
        document.getElementById('sgr-resultlabel')!.textContent = 'Schnittgeschwindigkeit';
        document.getElementById('sgr-result')!.textContent = Math.round(vc).toLocaleString('de-DE');
        document.getElementById('sgr-resultunit')!.textContent = 'm/min';
      }

      const feedMM = rpm * fz * flutes;
      const mrr = feedMM * 2.5 * (dia / 2) / 1000;

      document.getElementById('sgr-vcout')!.textContent = vc.toFixed(1).replace('.', ',');
      document.getElementById('sgr-feed')!.textContent = feedMM.toFixed(1).replace('.', ',');
      document.getElementById('sgr-mrr')!.textContent = mrr.toFixed(2).replace('.', ',');
      document.getElementById('sgr-recvc')!.textContent = String(recVc);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const updateVc = () => {
        const baseVc = parseFloat((document.getElementById('sgr-material') as HTMLSelectElement).value) || 30;
        const toolFactor = parseFloat((document.getElementById('sgr-tool') as HTMLSelectElement).value) || 1.0;
        (document.getElementById('sgr-vc') as HTMLInputElement).value = String(Math.round(baseVc * toolFactor));
        calcSGR();
      };
      document.getElementById('sgr-material')!.addEventListener('change', updateVc);
      document.getElementById('sgr-tool')!.addEventListener('change', updateVc);

      document.querySelectorAll('.sgr-in').forEach(el => {
        el.addEventListener('input', calcSGR);
        el.addEventListener('change', calcSGR);
      });
      calcSGR();
    }, 50);
  </script>
</CalculatorLayout>
