---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Containerbeladung-Rechner - Kartons pro Container berechnen";
const description = "Berechnen Sie, wie viele Kartons in einen 20-Fuß-, 40-Fuß- oder 40-Fuß-HC-Seecontainer passen. Prüfen Sie Volumenauslastung und Gewichtsgrenzen.";
const relatedCalcs = [
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Fläche berechnen." },
  { name: "Gewinnspanne", url: "/de/gewinnspanne-rechner", description: "Gewinnmargen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Containerbeladung-Rechner" enSlug="container-loading-calculator" keywords="Containerbeladung, Seecontainer, 20 Fuß Container, 40 Fuß Container, Volumenauslastung, Containergewicht" breadcrumbs={[{ name: "Containerbeladung-Rechner", url: "/de/containerbeladung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Containerbeladung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie, wie viele Kartons in Standard-Seecontainer passen, mit Volumen- und Gewichtsprüfung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Containertyp</label><select id="cl2-type" class="cl2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="20">20 Fuß Standard</option><option value="40" selected>40 Fuß Standard</option><option value="40hc">40 Fuß High Cube</option></select></div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Karton L (cm)</label><input type="number" id="cl2-bl" class="cl2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Karton B (cm)</label><input type="number" id="cl2-bw" class="cl2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Karton H (cm)</label><input type="number" id="cl2-bh" class="cl2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Kartongewicht (kg)</label><input type="number" id="cl2-bwt" class="cl2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kartons pro Container</div>
          <div class="text-5xl font-extrabold font-mono" id="cl2-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumenauslastung</div><div class="text-xl font-bold font-mono" id="cl2-volutil">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-xl font-bold font-mono" id="cl2-totalwt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewichtsgrenze</div><div class="text-xl font-bold font-mono" id="cl2-wtlimit">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewichtsstatus</div><div class="text-xl font-bold font-mono" id="cl2-wtstatus">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="container-loading" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Containerbeladung optimieren</h2>
      <p>Die optimale Beladung eines Seecontainers berücksichtigt sowohl die maximale Stückzahl als auch die Gewichtsgrenze. Der Rechner prüft alle möglichen Ausrichtungen der Kartons und wählt die beste Variante.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Wie groß ist ein 40-Fuß-Container innen?</strong> Ein Standard-40-Fuß-Container hat Innenmaße von ca. 1.203 x 234 x 238 cm.</p>
      <p><strong>Was ist ein High-Cube-Container?</strong> Ein HC-Container ist etwa 30 cm höher als ein Standardcontainer (269 cm statt 238 cm Innenhöhe).</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCL2() {
      const type = (document.getElementById('cl2-type') as HTMLSelectElement).value;
      const bl = parseFloat((document.getElementById('cl2-bl') as HTMLInputElement).value) || 0;
      const bw = parseFloat((document.getElementById('cl2-bw') as HTMLInputElement).value) || 0;
      const bh = parseFloat((document.getElementById('cl2-bh') as HTMLInputElement).value) || 0;
      const bwt = parseFloat((document.getElementById('cl2-bwt') as HTMLInputElement).value) || 0;

      const containers: Record<string, {l: number, w: number, h: number, maxKg: number}> = {
        '20':   { l: 589, w: 234, h: 238, maxKg: 21770 },
        '40':   { l: 1203, w: 234, h: 238, maxKg: 26680 },
        '40hc': { l: 1203, w: 234, h: 269, maxKg: 26460 }
      };
      const c = containers[type] || containers['40'];

      if (bl <= 0 || bw <= 0 || bh <= 0) return;

      const orientations = [
        Math.floor(c.l/bl) * Math.floor(c.w/bw) * Math.floor(c.h/bh),
        Math.floor(c.l/bl) * Math.floor(c.w/bh) * Math.floor(c.h/bw),
        Math.floor(c.l/bw) * Math.floor(c.w/bl) * Math.floor(c.h/bh),
        Math.floor(c.l/bw) * Math.floor(c.w/bh) * Math.floor(c.h/bl),
        Math.floor(c.l/bh) * Math.floor(c.w/bl) * Math.floor(c.h/bw),
        Math.floor(c.l/bh) * Math.floor(c.w/bw) * Math.floor(c.h/bl)
      ];
      let maxBoxes = Math.max(...orientations);

      if (bwt > 0) {
        const maxByWeight = Math.floor(c.maxKg / bwt);
        maxBoxes = Math.min(maxBoxes, maxByWeight);
      }

      const containerVol = c.l * c.w * c.h;
      const usedVol = maxBoxes * bl * bw * bh;
      const volUtil = containerVol > 0 ? (usedVol / containerVol) * 100 : 0;
      const totalWeight = maxBoxes * bwt;
      const overWeight = totalWeight > c.maxKg;

      document.getElementById('cl2-result')!.textContent = maxBoxes.toLocaleString('de-DE');
      document.getElementById('cl2-volutil')!.textContent = volUtil.toFixed(1) + '%';
      document.getElementById('cl2-totalwt')!.textContent = totalWeight.toLocaleString('de-DE', {maximumFractionDigits: 0}) + ' kg';
      document.getElementById('cl2-wtlimit')!.textContent = c.maxKg.toLocaleString('de-DE') + ' kg';
      document.getElementById('cl2-wtstatus')!.textContent = overWeight ? '\u00DCBERSCHRITTEN' : 'Im Rahmen';
      (document.getElementById('cl2-wtstatus') as HTMLElement).style.color = overWeight ? '#dc2626' : '#16a34a';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cl2-bl') as HTMLInputElement).value = '40';
      (document.getElementById('cl2-bw') as HTMLInputElement).value = '30';
      (document.getElementById('cl2-bh') as HTMLInputElement).value = '25';
      (document.getElementById('cl2-bwt') as HTMLInputElement).value = '12';
      document.querySelectorAll('.cl2-in').forEach(el => { el.addEventListener('input', calcCL2); el.addEventListener('change', calcCL2); });
      calcCL2();
    }, 50);
  </script>
</CalculatorLayout>
