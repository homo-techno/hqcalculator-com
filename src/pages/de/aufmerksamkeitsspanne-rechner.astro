---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aufmerksamkeitsspannen-Rechner - Fokusdauer nach Alter & Aufgabe";
const description = "Schätzen Sie Ihre Aufmerksamkeitsspanne nach Alter und Aufgabentyp. Erhalten Sie Pausenempfehlungen und Tipps zur Fokusoptimierung.";
const relatedCalcs = [
  { name: "Pomodoro-Rechner", url: "/pomodoro-calculator", description: "Pomodoro-Timer." },
  { name: "Produktivitätsrechner", url: "/productivity-calculator", description: "Produktivitätskennzahlen." },
  { name: "Lesezeit", url: "/reading-time-calculator", description: "Lesedauer." },
  { name: "Lernzeit", url: "/study-time-calculator", description: "Lernplanung." },
  { name: "Bildschirmzeit", url: "/screen-time-calculator", description: "Bildschirmnutzung." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Genaues Alter berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Aufmerksamkeitsspannen-Rechner" keywords="Aufmerksamkeitsspanne, Fokusdauer, Konzentrationsdauer, Pausenhäufigkeit, Alter Aufmerksamkeit, Produktivität" lang="de" breadcrumbs={[{ name: "Aufmerksamkeitsspanne", url: "/de/aufmerksamkeitsspanne-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aufmerksamkeitsspannen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Ihre Fähigkeit zur anhaltenden Aufmerksamkeit basierend auf Alter, Aufgabenkomplexität und Umgebungsfaktoren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ihr Alter</label>
          <input type="number" id="as-age" class="as-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="3" max="100" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Aufgabentyp</label>
          <select id="as-task" class="as-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="passive">Passiv (Video schauen, zuhören)</option>
            <option value="reading">Lesen / Lernen</option>
            <option value="creative">Kreativ (schreiben, gestalten)</option>
            <option value="analytical">Analytisch (Mathe, Programmieren, Problemlösung)</option>
            <option value="repetitive">Repetitiv (Dateneingabe, Montage)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Interessengrad (1-10)</label>
          <input type="range" id="as-interest" class="as-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Sehr langweilig (1)</span><span>Faszinierend (10)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Koffein heute konsumiert?</label>
          <select id="as-caff" class="as-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="0">Keines</option>
            <option value="1">Mäßig (1-2 Tassen)</option>
            <option value="2">Viel (3+ Tassen)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Schlafstunden letzte Nacht</label>
          <input type="number" id="as-sleep" class="as-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="16" step="0.5">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Geschätzte Aufmerksamkeitsspanne</div>
          <div class="text-2xl font-extrabold mt-1" id="as-span">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Empfohlene Pausenhäufigkeit</div>
            <div class="text-xl font-bold text-text mt-1" id="as-break">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Altersbasierter Grundwert</div>
            <div class="text-xl font-bold text-text mt-1" id="as-baseline">--</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Optimale Arbeitssitzungen/Tag</div>
            <div class="text-xl font-bold text-text mt-1" id="as-sessions">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Gesamte fokussierte Stunden</div>
            <div class="text-xl font-bold text-text mt-1" id="as-total">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Tipps zur Fokusoptimierung</div>
          <div class="text-sm text-text" id="as-tips">--</div>
        </div>
      </div>

      <ShareButton calculatorId="attention-span" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAS() {
      const age = parseInt((document.getElementById('as-age') as HTMLInputElement).value) || 25;
      const task = (document.getElementById('as-task') as HTMLSelectElement).value;
      const interest = parseInt((document.getElementById('as-interest') as HTMLInputElement).value) || 5;
      const caff = parseInt((document.getElementById('as-caff') as HTMLSelectElement).value) || 0;
      const sleepHrs = parseFloat((document.getElementById('as-sleep') as HTMLInputElement).value) || 7;

      let baseline = 20;
      if (age < 5) baseline = 5 + age;
      else if (age < 8) baseline = 10 + (age - 5) * 2;
      else if (age < 12) baseline = 16 + (age - 8) * 2;
      else if (age < 18) baseline = 24 + (age - 12) * 1.5;
      else if (age < 30) baseline = 33;
      else if (age < 50) baseline = 30;
      else if (age < 65) baseline = 27;
      else baseline = 22;

      const taskMult: Record<string, number> = {
        passive: 1.3,
        reading: 0.9,
        creative: 1.1,
        analytical: 0.8,
        repetitive: 0.7,
      };
      const tMult = taskMult[task] || 1;

      const intMult = 0.6 + (interest - 1) * 0.1;
      const caffBoost = caff === 1 ? 1.1 : caff === 2 ? 1.05 : 1.0;

      let sleepFactor = 1.0;
      if (sleepHrs < 5) sleepFactor = 0.6;
      else if (sleepHrs < 6) sleepFactor = 0.75;
      else if (sleepHrs < 7) sleepFactor = 0.9;
      else if (sleepHrs <= 9) sleepFactor = 1.0;
      else sleepFactor = 0.95;

      const span = Math.round(baseline * tMult * intMult * caffBoost * sleepFactor);
      const breakFreq = Math.max(10, span);
      const sessionsPerDay = Math.min(12, Math.round(480 / (span + 10)));
      const totalFocused = (sessionsPerDay * span / 60).toFixed(1).replace('.', ',');

      document.getElementById('as-span')!.textContent = span + ' Minuten';
      document.getElementById('as-break')!.textContent = 'Alle ' + breakFreq + ' Min.';
      document.getElementById('as-baseline')!.textContent = Math.round(baseline) + ' Min. (Alter ' + age + ')';
      document.getElementById('as-sessions')!.textContent = sessionsPerDay + ' Sitzungen';
      document.getElementById('as-total')!.textContent = totalFocused + ' Std.';

      let tips: string[] = [];
      if (sleepHrs < 7) tips.push('Mehr Schlaf kann den Fokus um bis zu 40 % steigern.');
      if (interest < 5) tips.push('Geringes Interesse verringert die Aufmerksamkeit erheblich. Versuchen Sie, die Aufgabe spielerisch zu gestalten.');
      if (task === 'analytical') tips.push('Bei analytischer Arbeit: Probleme in kleinere Teile aufteilen. Mit leichteren Aufgaben abwechseln.');
      if (task === 'repetitive') tips.push('Repetitive Aufgaben erschöpfen den Fokus am schnellsten. Nutzen Sie die Pomodoro-Technik (25 Min. arbeiten, 5 Min. Pause).');
      if (caff === 0 && age >= 18) tips.push('Mäßiger Koffeinkonsum (1-2 Tassen) kann die Aufmerksamkeit um 10 % verbessern.');
      if (caff === 2) tips.push('\u00DCbermäßiges Koffein kann Unruhe verursachen und den Nettofokus verringern. Reduzierung erwägen.');
      if (tips.length === 0) tips.push('Ihre Fokusbedingungen sind gut. Achten Sie auf regelmäßigen Schlaf, mäßigen Koffeinkonsum und regelmäßige Pausen.');

      document.getElementById('as-tips')!.textContent = tips.join(' ');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('as-age') as HTMLInputElement).value = '25';
      (document.getElementById('as-interest') as HTMLInputElement).value = '5';
      (document.getElementById('as-sleep') as HTMLInputElement).value = '7';
      document.querySelectorAll('.as-in').forEach(el => {
        el.addEventListener('input', calcAS);
        el.addEventListener('change', calcAS);
      });
      calcAS();
    }, 50);
  </script>
</CalculatorLayout>
