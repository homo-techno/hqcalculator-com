---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Musik-Tonart Rechner - Vorzeichen, Tonleitern & Verwandte Tonarten";
const description = "Ermitteln Sie Tonarten, Vorzeichen und verwandte Tonleitern in der Musiktheorie für Dur und Moll.";
const relatedCalcs = [
  { name: "Musik-Intervall Rechner", url: "/de/musik-intervall-rechner", description: "Intervalle berechnen." },
  { name: "Akkord Rechner", url: "/de/akkord-rechner", description: "Akkorde berechnen." },
  { name: "Namen Generator", url: "/de/namen-generator", description: "Namen generieren." },
  { name: "Newton-Verfahren Rechner", url: "/de/newton-verfahren-rechner", description: "Mathematische Berechnungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Musik-Tonart Rechner" enSlug="music-key-calculator" keywords="Tonart, Vorzeichen, Durtonleiter, Molltonleiter, Musiktheorie, Quintenzirkel" breadcrumbs={[{ name: "Musik-Tonart Rechner", url: "/de/musik-tonart-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Musik-Tonart Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie alle Töne einer Tonleiter, die Vorzeichen und die Paralleltonart für jede Dur- oder Molltonart.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Grundton</label>
            <select id="tk-root" class="tk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0">C</option><option value="2">D</option><option value="4">E</option>
              <option value="5">F</option><option value="7">G</option><option value="9">A</option>
              <option value="11">H</option><option value="1">C# / Des</option><option value="3">D# / Es</option>
              <option value="6">F# / Ges</option><option value="8">G# / As</option><option value="10">A# / B</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tongeschlecht</label>
            <select id="tk-mode" class="tk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="dur">Dur (Major)</option>
              <option value="moll">Moll (Minor)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Tonleiter</div>
          <div class="text-3xl font-extrabold font-mono" id="tk-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="tk-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vorzeichen</div><div class="text-xl font-bold" id="tk-accidentals">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Paralleltonart</div><div class="text-xl font-bold" id="tk-relative">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Töne der Tonleiter</h3>
          <div class="flex flex-wrap gap-2" id="tk-notes"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Stufenakkorde (Triaden)</h3>
          <div class="space-y-1 text-sm font-mono" id="tk-chords"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="musik-tonart" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Der Quintenzirkel und Tonarten</h2>
      <p>Der Quintenzirkel zeigt die Beziehungen zwischen den 12 Tonarten. Jede Tonart hat eine bestimmte Anzahl an Vorzeichen (Kreuze oder Be). C-Dur hat keine Vorzeichen, G-Dur ein Kreuz, F-Dur ein Be. Dur- und Molltonarten mit demselben Vorzeichen werden als Paralleltonarten bezeichnet.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was ist der Unterschied zwischen Dur und Moll?</strong></p><p>Durtonleitern klingen hell und fröhlich, Molltonleitern eher dunkel und melancholisch. Der Unterschied liegt in der Lage der Halbtonschritte.</p></div>
        <div><p><strong>Was sind Vorzeichen?</strong></p><p>Vorzeichen (Kreuze # oder Be ♭) erhöhen oder erniedrigen eine Note um einen Halbton. Die Anzahl der Vorzeichen bestimmt die Tonart.</p></div>
        <div><p><strong>Was ist eine Paralleltonart?</strong></p><p>Dur und Moll mit denselben Vorzeichen sind Paralleltonarten. C-Dur und a-Moll haben z.B. beide keine Vorzeichen.</p></div>
        <div><p><strong>Wie viele Tonarten gibt es?</strong></p><p>Es gibt 12 Durtonarten und 12 Molltonarten, insgesamt also 24 Tonarten. Dazu kommen weitere Modi wie Dorisch, Phrygisch usw.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const NOTE_NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','H'];
    const NOTE_NAMES_FLAT = ['C','Des','D','Es','E','F','Ges','G','As','A','B','H'];
    const DUR_STEPS = [0,2,4,5,7,9,11];
    const MOLL_STEPS = [0,2,3,5,7,8,10];
    const SHARP_KEYS = [0,7,2,9,4,11,6,1];
    const FLAT_KEYS = [0,5,10,3,8,1,6,11];
    const TRIAD_QUAL_DUR = ['Dur','Moll','Moll','Dur','Dur','Moll','verm.'];
    const TRIAD_QUAL_MOLL = ['Moll','verm.','Dur','Moll','Moll','Dur','Dur'];
    const ROMAN_DUR = ['I','ii','iii','IV','V','vi','vii°'];
    const ROMAN_MOLL = ['i','ii°','III','iv','v','VI','VII'];
    function calcTK() {
      const root = parseInt((document.getElementById('tk-root') as HTMLSelectElement).value) || 0;
      const mode = (document.getElementById('tk-mode') as HTMLSelectElement).value;
      const steps = mode === 'dur' ? DUR_STEPS : MOLL_STEPS;
      const sharpIdx = SHARP_KEYS.indexOf(root);
      const flatIdx = FLAT_KEYS.indexOf(root);
      let accidentals = '—';
      let useFlat = false;
      if (sharpIdx > 0) { accidentals = sharpIdx + ' Kreuz' + (sharpIdx > 1 ? 'e' : ''); }
      else if (flatIdx > 0) { accidentals = flatIdx + ' Be'; useFlat = true; }
      else { accidentals = 'keine'; }
      const names = useFlat ? NOTE_NAMES_FLAT : NOTE_NAMES;
      const scaleNotes = steps.map(s => names[(root + s) % 12]);
      const relativeRoot = mode === 'dur' ? (root + 9) % 12 : (root + 3) % 12;
      const relativeName = NOTE_NAMES[relativeRoot] + (mode === 'dur' ? '-Moll' : '-Dur');
      const triadQual = mode === 'dur' ? TRIAD_QUAL_DUR : TRIAD_QUAL_MOLL;
      const roman = mode === 'dur' ? ROMAN_DUR : ROMAN_MOLL;
      const triadSteps = mode === 'dur'
        ? [[0,4,7],[2,5,9],[4,7,11],[5,9,0],[7,11,2],[9,0,4],[11,2,5]]
        : [[0,3,7],[2,5,8],[3,7,10],[5,8,0],[7,10,2],[8,0,3],[10,2,5]];
      const chords = triadSteps.map((ts, i) => {
        const cn = ts.map(t => names[(root + t) % 12]);
        return roman[i] + ' – ' + scaleNotes[i] + ' ' + triadQual[i] + ': ' + cn.join(' – ');
      });
      document.getElementById('tk-result')!.textContent = scaleNotes.join(' – ');
      document.getElementById('tk-sub')!.textContent = names[root] + '-' + (mode === 'dur' ? 'Dur' : 'Moll');
      document.getElementById('tk-accidentals')!.textContent = accidentals;
      document.getElementById('tk-relative')!.textContent = relativeName;
      document.getElementById('tk-notes')!.innerHTML = scaleNotes.map((n, i) =>
        '<span class="px-3 py-1 bg-primary text-white rounded-lg font-bold text-sm">' + (i+1) + '. ' + n + '</span>'
      ).join('');
      document.getElementById('tk-chords')!.innerHTML = chords.map(c =>
        '<div>' + c + '</div>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.tk-in').forEach(el => { el.addEventListener('input', calcTK); el.addEventListener('change', calcTK); });
      calcTK();
    }, 50);
  </script>
</CalculatorLayout>
