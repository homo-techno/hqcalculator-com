---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zahlensystem Umrechner – Dezimal, Binär, Oktal, Hexadezimal";
const description = "Konvertieren Sie Zahlen zwischen Dezimal, Binär, Oktal und Hexadezimal.";
const relatedCalcs = [
  { name: "Zahlenfolge Rechner", url: "/de/zahlenfolge-rechner", description: "Arithmetische Folgen." },
  { name: "Absolutwert Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert berechnen." },
  { name: "ADC-Auflösung Rechner", url: "/de/adc-aufloesung-rechner", description: "ADC-Auflösung." },
  { name: "Operationsverstärker Rechner", url: "/de/operationsverstaerker-rechner", description: "Op-Amp-Schaltungen." },
];
---
<CalculatorLayout lang="de" enSlug="number-base-converter" title={title} description={description} calculatorName="Zahlensystem Umrechner" keywords="Zahlensystem, Binär, Dezimal, Hexadezimal, Oktal, Umrechner, Konverter" breadcrumbs={[{ name: "Zahlensystem Umrechner", url: "/de/zahlensystem-umrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zahlensystem Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Konvertieren Sie Zahlen zwischen Dezimal (Basis 10), Binär (Basis 2), Oktal (Basis 8) und Hexadezimal (Basis 16).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Eingabewert</label>
          <input type="text" id="zs-input" class="zs-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold font-mono" placeholder="z.B. 255">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Eingabe-Zahlensystem</label>
          <select id="zs-from" class="zs-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="10">Dezimal (Basis 10)</option>
            <option value="2">Binär (Basis 2)</option>
            <option value="8">Oktal (Basis 8)</option>
            <option value="16">Hexadezimal (Basis 16)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Dezimal (10)</div>
            <div class="text-2xl font-extrabold font-mono" id="zs-dec">—</div>
          </div>
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Binär (2)</div>
            <div class="text-2xl font-extrabold font-mono break-all" id="zs-bin">—</div>
          </div>
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Oktal (8)</div>
            <div class="text-2xl font-extrabold font-mono" id="zs-oct">—</div>
          </div>
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Hexadezimal (16)</div>
            <div class="text-2xl font-extrabold font-mono" id="zs-hex">—</div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bits benötigt</div>
            <div class="text-xl font-bold" id="zs-bits">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bytes (8-Bit)</div>
            <div class="text-xl font-bold" id="zs-bytes">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Vorzeichen (2er-K.)</div>
            <div class="text-xl font-bold" id="zs-twos">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Umrechnungsweg</h3>
          <div class="font-mono text-sm space-y-1" id="zs-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="number-base" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zahlensysteme verstehen</h2>
      <p>Computer arbeiten intern mit dem binären Zahlensystem (Basis 2), da elektronische Schaltungen nur zwei Zustände kennen: 0 und 1. Hexadezimal (Basis 16) wird häufig als kompakte Darstellung von Binärzahlen verwendet – eine Hexadezimalstelle entspricht genau 4 Bit (einem Nibble). Das Oktalsystem (Basis 8) wurde früher in der Informatik eingesetzt und entspricht 3 Bit pro Stelle.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Dezimal → Binär: wiederholte Division durch 2</p>
        <p>Binär → Dezimal: Stellenwerte 2^n summieren</p>
        <p>Hexadezimal: 0–9, A=10, B=11, C=12, D=13, E=14, F=15</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Warum nutzen Computer das Binärsystem?</strong> Transistoren haben zwei stabile Zustände (leitend/nicht leitend), die natürlich Einsen und Nullen entsprechen. Das macht die Binärdarstellung für digitale Schaltungen ideal.</p>
      <p><strong>Was ist der Unterschied zwischen Bit und Byte?</strong> Ein Bit ist die kleinste Informationseinheit (0 oder 1). Ein Byte besteht aus 8 Bit und kann 256 verschiedene Werte (0–255) darstellen.</p>
      <p><strong>Wofür wird Hexadezimal verwendet?</strong> Hexadezimal wird für Farb-Codes (#FF5500), Speicheradressen, IP-Adressen (IPv6) und Maschinencodes verwendet, da es Binärzahlen kompakt darstellt.</p>
      <p><strong>Was ist das Zweierkomplement?</strong> Das Zweierkomplement ist die häufigste Methode zur Darstellung negativer ganzer Zahlen in Computern. Man invertiert alle Bits und addiert 1.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcZS() {
      const raw = (document.getElementById('zs-input') as HTMLInputElement).value.trim();
      const base = parseInt((document.getElementById('zs-from') as HTMLSelectElement).value);
      const steps: string[] = [];
      if (!raw) {
        ['zs-dec','zs-bin','zs-oct','zs-hex','zs-bits','zs-bytes','zs-twos'].forEach(id => { document.getElementById(id)!.textContent = '—'; });
        document.getElementById('zs-steps')!.innerHTML = '';
        return;
      }
      const num = parseInt(raw, base);
      if (isNaN(num) || num < 0) {
        document.getElementById('zs-dec')!.textContent = 'Ungültig';
        return;
      }
      const dec = num.toString(10);
      const bin = num.toString(2);
      const oct = num.toString(8);
      const hex = num.toString(16).toUpperCase();
      const bits = bin.length;
      const bytes = Math.ceil(bits / 8);
      const twos = num <= 0x7FFFFFFF ? ('0x' + num.toString(16).toUpperCase().padStart(8,'0')) : '—';
      steps.push('Eingabe: ' + raw + ' (Basis ' + base + ')');
      steps.push('Dezimalwert: ' + dec);
      steps.push('Binär: ' + bin + ' (' + bits + ' Bits)');
      steps.push('Oktal: ' + oct);
      steps.push('Hexadezimal: ' + hex);
      document.getElementById('zs-dec')!.textContent = dec;
      document.getElementById('zs-bin')!.textContent = bin;
      document.getElementById('zs-oct')!.textContent = oct;
      document.getElementById('zs-hex')!.textContent = hex;
      document.getElementById('zs-bits')!.textContent = bits.toString();
      document.getElementById('zs-bytes')!.textContent = bytes.toString();
      document.getElementById('zs-twos')!.textContent = twos;
      document.getElementById('zs-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('zs-input') as HTMLInputElement).value = '255';
      document.querySelectorAll('.zs-in').forEach(el => { el.addEventListener('input', calcZS); el.addEventListener('change', calcZS); });
      calcZS();
    }, 50);
  </script>
</CalculatorLayout>
