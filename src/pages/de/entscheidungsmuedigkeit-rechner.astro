---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Entscheidungsmuedigkeit-Rechner - Willenskraft & Entscheidungslast";
const description = "Schaetzen Sie Ihre taegliche Entscheidungsanzahl, Ermuedungsakkumulation, Willenskrafterschoepfung und finden Sie Ihr optimales Entscheidungszeitfenster.";

const relatedCalcs = [
  { name: "Produktivit\u00e4tsrechner", url: "/de/produktivitaets-rechner", description: "Produktivit\u00e4t." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "T\u00e4glicher Bedarf." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffeinaufnahme." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="decision-fatigue-calculator" calculatorName="Entscheidungsmuedigkeit-Rechner" keywords="entscheidungsmuedigkeit, willenskraft, ego depletion, entscheidungsfindung, entscheidungsueberlastung, optimales timing" breadcrumbs={[{ name: "Entscheidungsm\u00fcdigkeit-Rechner", url: "/de/entscheidungsmuedigkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Entscheidungsm&uuml;digkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihre t&auml;gliche Entscheidungslast und finden Sie die besten Zeiten f&uuml;r wichtige Entscheidungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Rolle / Berufstyp</label>
          <select id="em3-role" class="em3-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="exec">F&uuml;hrungskraft / Manager (hohe Entscheidungslast)</option>
            <option value="professional">Fachkraft / Wissensarbeiter</option>
            <option value="creative">Kreativ / Designer</option>
            <option value="service">Dienstleistung / Kundenkontakt</option>
            <option value="manual">Handwerk / Routinearbeit</option>
            <option value="student">Student/in</option>
            <option value="homemaker">Hausfrau/-mann / Betreuung</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Schlafstunden letzte Nacht</label>
          <input type="number" id="em3-sleep" class="em3-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="14" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Mahlzeiten bisher heute</label>
          <input type="number" id="em3-meals" class="em3-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="6" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Wichtige Entscheidungen heute bereits getroffen</label>
          <input type="number" id="em3-made" class="em3-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="100" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Aktuelles Stressniveau (1-10)</label>
          <input type="range" id="em3-stress" class="em3-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Entspannt (1)</span><span>Sehr gestresst (10)</span></div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Aktuelle Entscheidungskapazit&auml;t</div>
          <div class="text-2xl font-extrabold mt-1" id="em3-capacity">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Gesch. Entscheidungen/Tag</div>
            <div class="text-xl font-bold text-text mt-1" id="em3-count">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Erm&uuml;dungsgrad</div>
            <div class="text-xl font-bold text-text mt-1" id="em3-fatigue">--</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Willenskraft-Reserve</div>
            <div class="text-xl font-bold text-text mt-1" id="em3-willpower">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Optimales Zeitfenster</div>
            <div class="text-xl font-bold text-text mt-1" id="em3-window">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Strategien gegen Entscheidungsm&uuml;digkeit</div>
          <div class="text-sm text-text" id="em3-strat">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="decision-fatigue" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist Entscheidungsm&uuml;digkeit?</h2>
      <p>Entscheidungsm&uuml;digkeit beschreibt das Ph&auml;nomen, dass die Qualit&auml;t unserer Entscheidungen im Laufe des Tages abnimmt, je mehr Entscheidungen wir treffen. Studien zeigen, dass wir t&auml;glich bis zu 35.000 Entscheidungen treffen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie kann ich Entscheidungsm&uuml;digkeit vermeiden?</strong> Routinen einf&uuml;hren, wichtige Entscheidungen morgens treffen, Mahlzeiten und Kleidung vorplanen.</p>
      <p><strong>Hilft Zucker wirklich?</strong> Ja, Glukose spielt eine Rolle bei der Willenskraft. Eine ausgewogene Mahlzeit kann die Entscheidungsf&auml;higkeit verbessern.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcEM3() {
      const role = (document.getElementById('em3-role') as HTMLSelectElement).value;
      const sleepHrs = parseFloat((document.getElementById('em3-sleep') as HTMLInputElement).value) || 7;
      const meals = parseInt((document.getElementById('em3-meals') as HTMLInputElement).value) || 2;
      const made = parseInt((document.getElementById('em3-made') as HTMLInputElement).value) || 5;
      const stress = parseInt((document.getElementById('em3-stress') as HTMLInputElement).value) || 5;

      const decisionCounts: Record<string, number> = {
        exec: 120, professional: 80, creative: 70, service: 90, manual: 40, student: 60, homemaker: 100,
      };
      const dailyDecisions = decisionCounts[role] || 70;

      let maxCapacity = 100;
      if (sleepHrs < 6) maxCapacity -= 25;
      else if (sleepHrs < 7) maxCapacity -= 10;
      maxCapacity += Math.min(3, meals) * 8;
      maxCapacity -= stress * 2;

      const drainPerDecision = 100 / (dailyDecisions * 0.6);
      const currentDrain = made * drainPerDecision;
      const currentCapacity = Math.max(0, Math.min(100, maxCapacity - currentDrain));
      const fatiguePct = Math.min(100, currentDrain / maxCapacity * 100);

      let capacityLabel = '';
      if (currentCapacity > 70) capacityLabel = 'Hoch - Guter Zeitpunkt f\u00fcr wichtige Entscheidungen';
      else if (currentCapacity > 40) capacityLabel = 'Mittel - Routine-Entscheidungen OK';
      else if (currentCapacity > 15) capacityLabel = 'Niedrig - Wichtige Entscheidungen vermeiden';
      else capacityLabel = 'Ersch\u00f6pft - Pause, Essen, Ruhe';

      let window = 'Vormittag (9-11 Uhr)';
      if (sleepHrs >= 7 && meals >= 1) window = '9-11 Uhr und 13-15 Uhr (nach dem Mittagessen)';
      else if (sleepHrs < 6) window = 'Nach einem Nickerchen oder einer Ruhepause';

      document.getElementById('em3-capacity')!.textContent = currentCapacity.toFixed(0) + '% - ' + capacityLabel;
      document.getElementById('em3-count')!.textContent = dailyDecisions + ' Entscheidungen/Tag';
      document.getElementById('em3-fatigue')!.textContent = fatiguePct.toFixed(0) + '% erm\u00fcdet';
      document.getElementById('em3-willpower')!.textContent = currentCapacity.toFixed(0) + ' / ' + maxCapacity.toFixed(0);
      document.getElementById('em3-window')!.textContent = window;

      let strats: string[] = [];
      strats.push('Routine-Entscheidungen automatisieren (Meal-Prep, Standard-Outfits, Vorlagen).');
      if (made > dailyDecisions * 0.4) strats.push('Sie haben \u00fcber 40% Ihres Entscheidungsbudgets verbraucht. Verschieben Sie wichtige Entscheidungen auf morgen fr\u00fch.');
      if (meals < 2) strats.push('Essen Sie etwas. Glukose stellt die Entscheidungsf\u00e4higkeit wieder her.');
      if (sleepHrs < 7) strats.push('Schlafmangel beeintr\u00e4chtigt das Urteilsverm\u00f6gen stark. Priorisieren Sie heute Nacht 7+ Stunden.');
      if (stress > 6) strats.push('Hoher Stress beschleunigt Entscheidungsm\u00fcdigkeit. 10 Min. Spaziergang oder Atem\u00fcbungen vor wichtigen Entscheidungen.');
      strats.push('\u00c4hnliche Entscheidungen b\u00fcndeln. 2-Minuten-Regel: Dauert eine Entscheidung unter 2 Min., sofort treffen.');

      document.getElementById('em3-strat')!.textContent = strats.join(' ');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('em3-sleep') as HTMLInputElement).value = '7';
      (document.getElementById('em3-meals') as HTMLInputElement).value = '2';
      (document.getElementById('em3-made') as HTMLInputElement).value = '5';
      (document.getElementById('em3-stress') as HTMLInputElement).value = '5';
      document.querySelectorAll('.em3-in').forEach(el => {
        el.addEventListener('input', calcEM3);
        el.addEventListener('change', calcEM3);
      });
      calcEM3();
    }, 50);
  </script>
</CalculatorLayout>
