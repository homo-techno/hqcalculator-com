---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Stickstoffkreislaufrechner - Einfahrphasen-Tracker";
const description = "Verfolgen Sie den Fortschritt des Stickstoffkreislaufs in Ihrem Aquarium, indem Sie Ammoniak-, Nitrit- und Nitratwerte eingeben, um die Einfahrphase und den geschätzten Abschluss zu bestimmen.";
const relatedCalcs = [
  { name: "Aquarium-Wasserwechsel", url: "/de/aquarium-wasserwechsel-rechner", description: "Wasserwechselvolumen und -häufigkeit." },
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Gewicht." },
  { name: "Fischbesatz", url: "/de/fischbesatz-rechner", description: "Fischbesatzkapazitätsrechner." },
  { name: "Aquarium-CO2", url: "/de/aquarium-co2-rechner", description: "CO2-Einspritzrate für Pflanzenbecken." },
  { name: "Aquarium-Medikamente", url: "/de/aquarium-medikamente-rechner", description: "Fischmedikamenten-Dosierungsrechner." },
  { name: "Aquarium-Heizung", url: "/de/aquarium-heizung-rechner", description: "Heizleistung für Ihr Becken." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquarium-Stickstoffkreislaufrechner" keywords="Aquarium-Stickstoffkreislauf, Aquarium-Einfahren, Ammoniak Nitrit Nitrat, Aquarium-Einfahrphasen-Tracker, fischloses Einfahren" breadcrumbs={[{ name: "Aquarium-Stickstoffkreislauf", url: "/de/aquarium-stickstoffkreislauf-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Stickstoffkreislaufrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Ihre Wassertestwerte ein, um festzustellen, wo Sie sich im Stickstoffkreislauf befinden und wann es sicher ist, Fische einzusetzen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ammoniak (ppm)</label>
            <input type="number" id="anc-nh3" class="anc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.5" min="0" max="10" step="0.25">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Nitrit (ppm)</label>
            <input type="number" id="anc-no2" class="anc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.25" min="0" max="10" step="0.25">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Nitrat (ppm)</label>
            <input type="number" id="anc-no3" class="anc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="200" step="5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tage seit Start</label>
            <input type="number" id="anc-days" class="anc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="14" min="0" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">pH-Wert</label>
            <input type="number" id="anc-ph" class="anc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7.2" min="5" max="9" step="0.1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Einfahrphase</div>
          <div class="text-4xl font-extrabold font-mono" id="anc-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sicher für Fische?</div>
            <div class="text-xl font-bold font-mono" id="anc-safe">Nein</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesch. Resttage</div>
            <div class="text-xl font-bold font-mono" id="anc-remain">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Toxizitätslevel</div>
            <div class="text-xl font-bold font-mono" id="anc-toxic">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Erforderliche Maßnahme</div>
            <div class="text-xl font-bold font-mono" id="anc-action">--</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquarium-nitrogen-cycle" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcANC() {
      const nh3 = parseFloat((document.getElementById('anc-nh3') as HTMLInputElement).value) || 0;
      const no2 = parseFloat((document.getElementById('anc-no2') as HTMLInputElement).value) || 0;
      const no3 = parseFloat((document.getElementById('anc-no3') as HTMLInputElement).value) || 0;
      const days = parseFloat((document.getElementById('anc-days') as HTMLInputElement).value) || 0;
      const ph = parseFloat((document.getElementById('anc-ph') as HTMLInputElement).value) || 7;
      let stage = '';
      let safe = 'Nein';
      let remain = '--';
      let toxic = 'Niedrig';
      let action = 'Abwarten';
      if (nh3 === 0 && no2 === 0 && no3 === 0 && days < 3) {
        stage = 'Nicht gestartet';
        remain = '28-42 Tage';
        action = 'Ammoniakquelle hinzufügen';
      } else if (nh3 > 0 && no2 === 0 && no3 <= 5) {
        stage = 'Phase 1: Ammoniak';
        remain = Math.max(7, 35 - days) + ' Tage';
        toxic = nh3 > 2 ? 'Hoch' : nh3 > 0.5 ? 'Mittel' : 'Niedrig';
        action = nh3 > 4 ? 'Wasserwechsel' : 'Abwarten';
      } else if (nh3 > 0 && no2 > 0) {
        stage = 'Phase 2: Nitrit steigt';
        remain = Math.max(5, 28 - days) + ' Tage';
        toxic = 'Mittel';
        action = no2 > 5 ? 'Teilwasserwechsel' : 'Abwarten';
      } else if (nh3 <= 0.25 && no2 > 0 && no3 > 0) {
        stage = 'Phase 3: Nitrit-Spitze';
        remain = Math.max(3, 21 - days) + ' Tage';
        toxic = no2 > 2 ? 'Mittel' : 'Niedrig';
        action = 'Fast geschafft';
      } else if (nh3 === 0 && no2 === 0 && no3 > 0) {
        stage = 'Eingefahren!';
        safe = 'Ja';
        remain = '0 Tage';
        toxic = 'Keine';
        action = no3 > 40 ? 'Wasserwechsel' : 'Fische langsam einsetzen';
      } else {
        stage = 'In Bearbeitung';
        remain = Math.max(3, 30 - days) + ' Tage';
        toxic = (nh3 + no2) > 2 ? 'Mittel' : 'Niedrig';
        action = 'Weiter testen';
      }
      document.getElementById('anc-result')!.textContent = stage;
      document.getElementById('anc-safe')!.textContent = safe;
      document.getElementById('anc-remain')!.textContent = remain;
      document.getElementById('anc-toxic')!.textContent = toxic;
      document.getElementById('anc-action')!.textContent = action;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.anc-in').forEach(el => { el.addEventListener('input', calcANC); el.addEventListener('change', calcANC); });
      calcANC();
    }, 50);
  </script>
</CalculatorLayout>
