---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kundenwert-Rechner (CLV) - Customer Lifetime Value berechnen";
const description = "Berechnen Sie den Customer Lifetime Value (CLV), das CLV:CAC-Verhaeltnis und den langfristigen Wert Ihrer Kundenbeziehungen.";
const relatedCalcs = [
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Gewinnmargenrechner", url: "/de/gewinnmargenrechner", description: "Gewinnmargen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kundenwert-Rechner" keywords="CLV, Customer Lifetime Value, Kundenwert, LTV, CLV CAC Verhaeltnis, Kundenakquisitionskosten" breadcrumbs={[{ name: "Kundenwert-Rechner", url: "/de/kundenwert-rechner" }]} lang="de" enSlug="customer-lifetime-value-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kundenwert-Rechner (CLV)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie den Gesamtwert, den ein Kunde ueber die gesamte Geschaeftsbeziehung bringt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Durchschnittlicher Bestellwert (EUR)</label><input type="number" id="kwr-purchase" class="kwr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="50" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Kaufhaeufigkeit (pro Jahr)</label><input type="number" id="kwr-frequency" class="kwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Durchschnittliche Kundenlebensdauer (Jahre)</label><input type="number" id="kwr-lifespan" class="kwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="0.5"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Gewinnmarge (%)</label><input type="number" id="kwr-margin" class="kwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="100" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Kundenakquisitionskosten (EUR)</label><input type="number" id="kwr-cac" class="kwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="0" step="10"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Diskontierungssatz (%)</label><input type="number" id="kwr-discount" class="kwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="50" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Customer Lifetime Value</div>
          <div class="text-5xl font-extrabold font-mono" id="kwr-result">0 EUR</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CLV:CAC-Verhaeltnis</div><div class="text-xl font-bold font-mono" id="kwr-ratio">0x</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahresumsatz/Kunde</div><div class="text-xl font-bold font-mono" id="kwr-annual">0 EUR</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahresgewinn/Kunde</div><div class="text-xl font-bold font-mono" id="kwr-annprofit">0 EUR</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lebensdauer-Umsatz</div><div class="text-xl font-bold font-mono" id="kwr-ltrev">0 EUR</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Netto-CLV (nach CAC)</div><div class="text-xl font-bold font-mono" id="kwr-net">0 EUR</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CAC-Amortisation (Monate)</div><div class="text-xl font-bold font-mono" id="kwr-payback">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="customer-lifetime-value" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Customer Lifetime Value verstehen</h2>
      <p>Der CLV ist eine der wichtigsten Kennzahlen im Marketing. Ein gesundes CLV:CAC-Verhaeltnis liegt bei mindestens 3:1. Das bedeutet, dass jeder investierte Euro in Kundenakquise mindestens 3 Euro Gewinn ueber die Kundenlebensdauer bringen sollte.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Was ist ein gutes CLV:CAC-Verhaeltnis?</strong> Ein Verhaeltnis von 3:1 oder hoeher gilt als gesund. Unter 1:1 verlieren Sie Geld pro Kunde.</li>
        <li><strong>Wie kann ich den CLV erhoehen?</strong> Durch hoehere Bestellwerte, haeufigere Kaeufe, laengere Kundenbindung oder bessere Margen.</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKWR() {
      const avgPurchase = parseFloat((document.getElementById('kwr-purchase') as HTMLInputElement).value) || 0;
      const frequency = parseFloat((document.getElementById('kwr-frequency') as HTMLInputElement).value) || 0;
      const lifespan = parseFloat((document.getElementById('kwr-lifespan') as HTMLInputElement).value) || 0;
      const margin = parseFloat((document.getElementById('kwr-margin') as HTMLInputElement).value) || 0;
      const cac = parseFloat((document.getElementById('kwr-cac') as HTMLInputElement).value) || 0;
      const discountRate = parseFloat((document.getElementById('kwr-discount') as HTMLInputElement).value) || 0;

      const annualRevenue = avgPurchase * frequency;
      const annualProfit = annualRevenue * (margin / 100);

      let clv = 0;
      for (let y = 1; y <= lifespan; y++) {
        clv += annualProfit / Math.pow(1 + discountRate / 100, y);
      }

      const lifetimeRevenue = annualRevenue * lifespan;
      const clvCacRatio = cac > 0 ? clv / cac : 0;
      const netCLV = clv - cac;
      const monthlyProfit = annualProfit / 12;
      const paybackMonths = monthlyProfit > 0 ? cac / monthlyProfit : 0;

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('kwr-result')!.textContent = fmt(clv);
      document.getElementById('kwr-ratio')!.textContent = clvCacRatio.toFixed(2).replace('.', ',') + 'x';
      document.getElementById('kwr-annual')!.textContent = fmt(annualRevenue);
      document.getElementById('kwr-annprofit')!.textContent = fmt(annualProfit);
      document.getElementById('kwr-ltrev')!.textContent = fmt(lifetimeRevenue);
      document.getElementById('kwr-net')!.textContent = fmt(netCLV);
      document.getElementById('kwr-payback')!.textContent = paybackMonths.toFixed(1).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kwr-in').forEach(el => { el.addEventListener('input', calcKWR); el.addEventListener('change', calcKWR); });
      calcKWR();
    }, 50);
  </script>
</CalculatorLayout>
