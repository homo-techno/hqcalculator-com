---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Abschreibungsrechner - Linear & Degressiv";
const description = "Berechnen Sie die Abschreibung von Anlageg\u00fctern mit linearer, degressiver und digitaler Summe-der-Jahresziffern-Methode inkl. Abschreibungsplan.";

const relatedCalcs = [
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen." },
  { name: "Anlagerechner", url: "/de/anlage-rechner", description: "Anlagewachstum." },
  { name: "Zinseszinsrechner", url: "/de/zinseszins-rechner", description: "Zinseszins." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Abschreibungsrechner" lang="de" enSlug="depreciation-calculator" keywords="abschreibungsrechner, lineare abschreibung, degressive abschreibung, afa rechner, abschreibungsplan" breadcrumbs={[{ name: "Abschreibungsrechner", url: "/de/abschreibungsrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Abschreibungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Abschreibung von Anlageg&uuml;tern mit verschiedenen Methoden und Abschreibungsplan.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anschaffungskosten (&euro;)</label><input type="number" id="afp-cost" class="afp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Restwert (&euro;)</label><input type="number" id="afp-salv" class="afp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000" min="0" step="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Nutzungsdauer (Jahre)</label><input type="number" id="afp-life" class="afp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="50" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Methode</label><select id="afp-method" class="afp-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="sl">Linear (AfA)</option><option value="db">Degressiv (200%)</option><option value="syd">Summe der Jahresziffern</option></select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">J&auml;hrliche Abschreibung (Jahr 1)</div>
          <div class="text-4xl font-extrabold font-mono" id="afp-annual">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt-AfA</div><div class="text-xl font-bold" id="afp-total">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abschreibungsbasis</div><div class="text-xl font-bold" id="afp-base">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">AfA-Satz (Jahr 1)</div><div class="text-xl font-bold" id="afp-rate">0%</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl overflow-x-auto">
          <h3 class="font-semibold text-sm text-text mb-3">Abschreibungsplan</h3>
          <table class="w-full text-sm"><thead><tr class="text-xs text-text-muted uppercase"><th class="text-left pb-2">Jahr</th><th class="text-right pb-2">AfA</th><th class="text-right pb-2">Kumuliert</th><th class="text-right pb-2">Buchwert</th></tr></thead><tbody id="afp-table"></tbody></table>
        </div>
      </div>
      <ShareButton calculatorId="depreciation-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Abschreibungsmethoden in Deutschland</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Linear:</strong> AfA = (Anschaffungskosten &minus; Restwert) / Nutzungsdauer</p>
        <p><strong>Degressiv:</strong> AfA = Buchwert &times; (2 / Nutzungsdauer)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Methode ist steuerlich vorteilhafter?</strong> Die degressive Methode erm&ouml;glicht h&ouml;here Abschreibungen in den ersten Jahren und reduziert so die Steuerlast fr&uuml;her.</p>
      <p><strong>Wo finde ich die Nutzungsdauer?</strong> Die AfA-Tabellen des Bundesfinanzministeriums geben die betriebsgew&ouml;hnliche Nutzungsdauer f&uuml;r verschiedene Wirtschaftsg&uuml;ter vor.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const afpFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcAFP() {
      const cost = parseFloat((document.getElementById('afp-cost') as HTMLInputElement).value) || 0;
      const salv = parseFloat((document.getElementById('afp-salv') as HTMLInputElement).value) || 0;
      const life = parseInt((document.getElementById('afp-life') as HTMLInputElement).value) || 1;
      const method = (document.getElementById('afp-method') as HTMLSelectElement).value;
      const base = cost - salv;
      const rows: { dep: number; accum: number; book: number }[] = [];
      let accum = 0;
      if (method === 'sl') {
        const annual = base / life;
        for (let y = 0; y < life; y++) { accum += annual; rows.push({ dep: annual, accum, book: cost - accum }); }
      } else if (method === 'db') {
        const rate = 2 / life;
        let book = cost;
        for (let y = 0; y < life; y++) {
          let dep = book * rate;
          if (book - dep < salv) dep = book - salv;
          if (dep < 0) dep = 0;
          accum += dep; book -= dep;
          rows.push({ dep, accum, book });
        }
      } else {
        const sydSum = (life * (life + 1)) / 2;
        for (let y = 0; y < life; y++) {
          const dep = base * (life - y) / sydSum;
          accum += dep;
          rows.push({ dep, accum, book: cost - accum });
        }
      }
      const first = rows[0]?.dep || 0;
      document.getElementById('afp-annual')!.textContent = afpFmt(first);
      document.getElementById('afp-total')!.textContent = afpFmt(base);
      document.getElementById('afp-base')!.textContent = afpFmt(base);
      document.getElementById('afp-rate')!.textContent = (cost > 0 ? (first / cost * 100) : 0).toFixed(1).replace('.', ',') + '%';
      document.getElementById('afp-table')!.innerHTML = rows.map((r, i) =>
        '<tr class="border-t border-border/30"><td class="py-1">' + (i + 1) + '</td><td class="text-right">' + afpFmt(r.dep) + '</td><td class="text-right">' + afpFmt(r.accum) + '</td><td class="text-right">' + afpFmt(r.book) + '</td></tr>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.afp-in').forEach(el => { el.addEventListener('input', calcAFP); el.addEventListener('change', calcAFP); }); calcAFP(); }, 50);
  </script>
</CalculatorLayout>
