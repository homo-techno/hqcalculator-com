---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Mulchrechner - Mulchmenge in m³ für Beet und Garten berechnen";
const description = "Berechnen Sie die benötigte Mulchmenge in Kubikmetern und Säcken für Ihre Beete und Gartenflächen.";
const relatedCalcs = [
  { name: "Pilzzucht Rechner", url: "/de/pilzzucht-rechner", description: "Substratmenge berechnen." },
  { name: "Ahornsirup Rechner", url: "/de/ahornsirup-rechner", description: "Ahornsirup berechnen." },
  { name: "Umzugsbudget Rechner", url: "/de/umzugsbudget-rechner", description: "Budget planen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Mulchrechner" enSlug="mulch-calculator" keywords="Mulch berechnen, Mulchmenge, Rindenmulch, Holzhäcksel, Gartenplanung, m³ Mulch" breadcrumbs={[{ name: "Mulchrechner", url: "/de/mulch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mulchrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die benötigte Mulchmenge für Ihre Gartenflächen. Geben Sie Fläche, gewünschte Schichtdicke und Preis ein.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Beetlänge (m)</label><input type="number" id="mu-length" class="mu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Beetbreite (m)</label><input type="number" id="mu-width" class="mu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schichtdicke (cm)</label><input type="number" id="mu-depth" class="mu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro m³ (€)</label><input type="number" id="mu-price" class="mu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="0" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Sackgröße (Liter)</label><input type="number" id="mu-bagsize" class="mu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70" min="1" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Sack (€)</label><input type="number" id="mu-bagprice" class="mu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6.99" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Mulchmenge</div>
          <div class="text-5xl font-extrabold font-mono" id="mu-result">0,00 m³</div>
          <div class="text-sm text-blue-200 mt-1" id="mu-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fläche</div><div class="text-xl font-bold" id="mu-area">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahl Säcke</div><div class="text-xl font-bold" id="mu-bags">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten (loses Material)</div><div class="text-xl font-bold" id="mu-bulkcost">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten (Säcke)</div><div class="text-xl font-bold" id="mu-bagcost">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mulch" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mulch – Vorteile und richtige Menge</h2>
      <p>Mulch schützt den Boden vor Austrocknung, unterdrückt Unkraut und verbessert langfristig die Bodenstruktur. Die empfohlene Schichtdicke liegt bei 5–10 cm für Rindenmulch und 3–5 cm für feineren Holzhäcksel. Eine zu dicke Schicht kann die Belüftung des Bodens behindern.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Volumen (m³) = Länge × Breite × Schichtdicke(cm) / 100</p>
        <p>Anzahl Säcke = Volumen × 1000 / Sackgröße(Liter)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Wie dick sollte die Mulchschicht sein?</strong></p><p>Für Rindenmulch werden 5–10 cm empfohlen. Zu dünn wirkt wenig, zu dick kann die Belüftung hemmen.</p></div>
        <div><p><strong>Wie viel Mulch brauche ich pro m²?</strong></p><p>Bei 8 cm Schichtdicke benötigen Sie 0,08 m³ pro m², also 80 Liter oder etwa 1,1 Säcke à 70 Liter.</p></div>
        <div><p><strong>Welche Mulcharten gibt es?</strong></p><p>Rindenmulch, Holzhäcksel, Grasschnitt, Kompost und Steingranulat. Rindenmulch ist am weitesten verbreitet und hält Unkraut gut zurück.</p></div>
        <div><p><strong>Was kostet Rindenmulch?</strong></p><p>Loses Material kostet ca. 25–60 €/m³. Sackware ist meist teurer, aber praktischer für kleinere Mengen.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMU() {
      const length = parseFloat((document.getElementById('mu-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('mu-width') as HTMLInputElement).value) || 0;
      const depth = parseFloat((document.getElementById('mu-depth') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('mu-price') as HTMLInputElement).value) || 0;
      const bagSize = parseFloat((document.getElementById('mu-bagsize') as HTMLInputElement).value) || 70;
      const bagPrice = parseFloat((document.getElementById('mu-bagprice') as HTMLInputElement).value) || 0;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      const area = length * width;
      const volume = area * depth / 100;
      const bags = Math.ceil(volume * 1000 / bagSize);
      const bulkCost = volume * price;
      const bagCost = bags * bagPrice;
      document.getElementById('mu-result')!.textContent = fmt(volume) + ' m³';
      document.getElementById('mu-sub')!.textContent = fmt(volume * 1000, 0) + ' Liter | Fläche: ' + fmt(area) + ' m²';
      document.getElementById('mu-area')!.textContent = fmt(area) + ' m²';
      document.getElementById('mu-bags')!.textContent = bags.toLocaleString('de-DE') + ' Säcke';
      document.getElementById('mu-bulkcost')!.textContent = fmt(bulkCost) + ' €';
      document.getElementById('mu-bagcost')!.textContent = fmt(bagCost) + ' €';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mu-in').forEach(el => { el.addEventListener('input', calcMU); el.addEventListener('change', calcMU); });
      calcMU();
    }, 50);
  </script>
</CalculatorLayout>
