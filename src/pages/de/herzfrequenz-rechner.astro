---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Herzfrequenz-Rechner - Trainingspulszonen";
const description = "Berechnen Sie Ihre maximale Herzfrequenz und Trainingspulszonen f&uuml;r optimale Trainingsintensit&auml;t. Finden Sie Ihre Fettverbrennungs-, Kardio- und Maximalpulszonen.";

const relatedCalcs = [
  { name: "Blutdruckrechner", url: "/de/blutdruckrechner", description: "Blutdruckklassifikation." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "T&auml;glicher Kalorienbedarf." },
  { name: "Kalorienverbrauch-Rechner", url: "/de/kalorienverbrauch-rechner", description: "Kalorien beim Sport." },
  { name: "Tempoberechner", url: "/de/tempoberechner", description: "Lauftempo." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Herzfrequenz-Rechner"
  keywords="herzfrequenz rechner, trainingspuls, maximalpuls, pulszonen, fettverbrennungszone, kardiozone, karvonen"
  breadcrumbs={[{ name: "Herzfrequenz-Rechner", url: "/de/herzfrequenz-rechner" }]}
  lang="de"
  enSlug="heart-rate-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Herzfrequenz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihre Trainingspulszonen f&uuml;r optimale Trainingsintensit&auml;t.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="space-y-4 mb-6">
            <div>
              <label class="block text-sm font-medium text-text mb-1">Alter</label>
              <input type="number" id="hfde-age" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="30" min="10" max="100" step="1">
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-1">Ruhepuls (optional)</label>
              <input type="number" id="hfde-resting" class="w-full px-4 py-3 border border-border rounded-xl text-lg text-center" value="70" min="30" max="120" step="1" placeholder="Schläge/min in Ruhe">
              <p class="text-xs text-text-muted mt-1">Morgens vor dem Aufstehen messen. Wird f&uuml;r die Karvonen-Formel verwendet.</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-2">Formel</label>
              <div class="flex gap-2 flex-wrap">
                <button class="hfde-formula-btn px-3 py-2 rounded-xl text-sm font-semibold border border-primary bg-blue-50 text-primary" data-formula="standard">Standard (220&minus;Alter)</button>
                <button class="hfde-formula-btn px-3 py-2 rounded-xl text-sm font-semibold border border-border" data-formula="tanaka">Tanaka</button>
                <button class="hfde-formula-btn px-3 py-2 rounded-xl text-sm font-semibold border border-border" data-formula="karvonen">Karvonen</button>
              </div>
            </div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-2">Ruhepuls-Referenz</h3>
            <div class="grid grid-cols-2 gap-1 text-xs">
              <div class="flex justify-between p-1"><span>Sportler</span><span class="font-bold">40-59 S/min</span></div>
              <div class="flex justify-between p-1"><span>Sehr gut</span><span class="font-bold">60-64 S/min</span></div>
              <div class="flex justify-between p-1"><span>Gut</span><span class="font-bold">65-72 S/min</span></div>
              <div class="flex justify-between p-1"><span>Durchschnitt</span><span class="font-bold">73-80 S/min</span></div>
              <div class="flex justify-between p-1"><span>Unterdurchschn.</span><span class="font-bold">81-90 S/min</span></div>
              <div class="flex justify-between p-1"><span>Schlecht</span><span class="font-bold">91+ S/min</span></div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Maximale Herzfrequenz</div>
            <div class="text-5xl font-extrabold" id="hfde-max">190</div>
            <div class="text-sm text-blue-200 mt-1">S/min</div>
          </div>

          <div class="space-y-2" id="hfde-zones"></div>

          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Herzfrequenz-Reserve</div>
            <div class="text-xl font-bold" id="hfde-reserve">120 S/min</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="herzfrequenz-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Pulszonen verstehen</h2>
      <p>Training in verschiedenen Pulszonen erzeugt unterschiedliche physiologische Anpassungen. Niedrige Zonen st&auml;rken Ausdauer und verbrennen Fett, hohe Zonen verbessern Fitness und Geschwindigkeit.</p>

      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Standard:</strong> Max HF = 220 &minus; Alter</p>
        <p><strong>Tanaka:</strong> Max HF = 208 &minus; (0,7 &times; Alter)</p>
        <p><strong>Karvonen:</strong> Ziel = ((Max HF &minus; Ruhepuls) &times; %) + Ruhepuls</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Zone verbrennt am meisten Fett?</strong> Zone 2 (60-70% MHF) nutzt den h&ouml;chsten Fettanteil als Energiequelle. H&ouml;here Zonen verbrennen jedoch mehr Kalorien insgesamt.</p>
      <p><strong>Ist Zone 5 sicher?</strong> Zone 5 sollte nur f&uuml;r kurze Intervalle von gesunden, gut trainierten Personen genutzt werden. Vor intensivem Training immer &auml;rztlichen Rat einholen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let hfdeFormula = 'standard';

    const hfdeZones = [
      { name: 'Zone 1 \u2014 Aufw\u00E4rmen', min: 50, max: 60, color: '#94a3b8', desc: 'Sehr leicht, Erholung' },
      { name: 'Zone 2 \u2014 Fettverbrennung', min: 60, max: 70, color: '#22c55e', desc: 'Leicht, Fettverbrennung' },
      { name: 'Zone 3 \u2014 Ausdauer', min: 70, max: 80, color: '#3b82f6', desc: 'Moderat, aerob' },
      { name: 'Zone 4 \u2014 Intensiv', min: 80, max: 90, color: '#f97316', desc: 'Kr\u00E4ftig, anaerob' },
      { name: 'Zone 5 \u2014 Maximum', min: 90, max: 100, color: '#ef4444', desc: 'Maximale Belastung' },
    ];

    function calcHFDE() {
      const age = parseInt((document.getElementById('hfde-age') as HTMLInputElement).value) || 30;
      const resting = parseInt((document.getElementById('hfde-resting') as HTMLInputElement).value) || 70;

      let maxHR: number;
      if (hfdeFormula === 'tanaka') {
        maxHR = Math.round(208 - 0.7 * age);
      } else {
        maxHR = 220 - age;
      }

      const reserve = maxHR - resting;
      const useKarvonen = hfdeFormula === 'karvonen';

      document.getElementById('hfde-max')!.textContent = String(maxHR);
      document.getElementById('hfde-reserve')!.textContent = reserve + ' S/min';

      document.getElementById('hfde-zones')!.innerHTML = hfdeZones.map(z => {
        let low: number, high: number;
        if (useKarvonen) {
          low = Math.round(reserve * z.min / 100 + resting);
          high = Math.round(reserve * z.max / 100 + resting);
        } else {
          low = Math.round(maxHR * z.min / 100);
          high = Math.round(maxHR * z.max / 100);
        }
        return '<div class="p-3 rounded-xl border-l-4" style="border-color: ' + z.color + '; background: ' + z.color + '11;">' +
          '<div class="flex justify-between items-center">' +
          '<div><div class="font-semibold text-sm">' + z.name + '</div>' +
          '<div class="text-xs text-text-muted">' + z.desc + ' (' + z.min + '-' + z.max + '%)</div></div>' +
          '<div class="text-right"><div class="text-xl font-bold">' + low + '\u2013' + high + '</div>' +
          '<div class="text-xs text-text-muted">S/min</div></div></div>' +
          '<div class="mt-2 h-2 bg-white/50 rounded-full overflow-hidden">' +
          '<div class="h-full rounded-full" style="width: ' + z.max + '%; background: ' + z.color + ';"></div></div></div>';
      }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['hfde-age', 'hfde-resting'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcHFDE);
      });

      document.querySelectorAll('.hfde-formula-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.hfde-formula-btn').forEach(b => {
            b.classList.remove('border-primary', 'bg-blue-50', 'text-primary');
            b.classList.add('border-border');
          });
          btn.classList.remove('border-border');
          btn.classList.add('border-primary', 'bg-blue-50', 'text-primary');
          hfdeFormula = (btn as HTMLElement).dataset.formula || 'standard';
          calcHFDE();
        });
      });

      calcHFDE();
    }, 50);
  </script>
</CalculatorLayout>
