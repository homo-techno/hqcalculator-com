---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Prozentrechner - Kostenloser Online Prozent-Rechner 2026";
const description = "Berechne Prozente sofort. Finde den Prozentsatz einer Zahl, prozentuale Zunahme/Abnahme und mehr. Kostenlos, schnell, keine Anmeldung nötig.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie berechne ich den Prozentsatz einer Zahl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Um X% einer Zahl zu finden, multipliziere die Zahl mit X und teile durch 100. Zum Beispiel: 25% von 200 = 200 × 25 / 100 = 50."
      }
    },
    {
      "@type": "Question",
      "name": "Wie berechne ich eine prozentuale Zunahme?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prozentuale Zunahme = ((Neuer Wert - Alter Wert) / Alter Wert) × 100. Beispiel: Steigt ein Preis von 50 € auf 65 €, beträgt die Zunahme ((65-50)/50) × 100 = 30%."
      }
    },
    {
      "@type": "Question",
      "name": "Was ist die Formel für die prozentuale Differenz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prozentuale Differenz = (|Wert1 - Wert2| / ((Wert1 + Wert2) / 2)) × 100. Dies berechnet die relative Differenz zwischen zwei Werten."
      }
    }
  ]
};

const relatedCalcs = [
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Brüche umrechnen, addieren, subtrahieren, multiplizieren und dividieren." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Berechne deinen Body-Mass-Index." },
  { name: "Trinkgeldrechner", url: "/de/trinkgeldrechner", description: "Rechnungen aufteilen und Trinkgeld berechnen." },
  { name: "Notenrechner", url: "/de/notenrechner", description: "Berechne deinen Notendurchschnitt sofort." },
  { name: "Mehrwertsteuerrechner", url: "/de/mehrwertsteuerrechner", description: "Mehrwertsteuer auf Einkäufe berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten berechnen." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Prozentrechner"
  keywords="Prozentrechner, Prozent berechnen, Prozentsatz berechnen, Prozent einer Zahl, prozentuale Zunahme, prozentuale Abnahme"
  breadcrumbs={[{ name: "Prozentrechner", url: "/de/prozentrechner" }]}
  lang="de"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Prozentrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne Prozente sofort. Finde Prozentsätze von Zahlen, prozentuale Veränderungen und mehr -- keine Anmeldung nötig.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm overflow-hidden">
      <div class="flex border-b border-border overflow-x-auto">
        <button class="mode-tab active px-5 py-3 text-sm font-medium text-primary border-b-2 border-primary whitespace-nowrap" data-mode="basic">
          Was ist X% von Y?
        </button>
        <button class="mode-tab px-5 py-3 text-sm font-medium text-text-secondary hover:text-primary whitespace-nowrap border-b-2 border-transparent" data-mode="reverse">
          X ist wieviel % von Y?
        </button>
        <button class="mode-tab px-5 py-3 text-sm font-medium text-text-secondary hover:text-primary whitespace-nowrap border-b-2 border-transparent" data-mode="change">
          % Zunahme / Abnahme
        </button>
        <button class="mode-tab px-5 py-3 text-sm font-medium text-text-secondary hover:text-primary whitespace-nowrap border-b-2 border-transparent" data-mode="difference">
          % Differenz
        </button>
      </div>

      <div class="p-6 sm:p-8">
        <!-- MODUS: Basis (Was ist X% von Y?) -->
        <div id="panel-basic" class="calc-panel">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <div class="space-y-4">
                <div>
                  <label for="basic-percent" class="block text-sm font-medium text-text mb-1">Prozentsatz</label>
                  <div class="flex items-center gap-2">
                    <input type="text" id="basic-percent" value="25" inputmode="decimal"
                      class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                    <span class="text-xl text-text-muted font-bold">%</span>
                  </div>
                </div>
                <div class="text-center text-2xl text-text-muted font-light">von</div>
                <div>
                  <label for="basic-number" class="block text-sm font-medium text-text mb-1">Zahl</label>
                  <input type="text" id="basic-number" value="200" inputmode="decimal"
                    class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>
              </div>
            </div>
            <div class="flex items-center">
              <div class="w-full text-center p-6 bg-primary rounded-2xl text-white">
                <div class="text-sm font-medium text-blue-200 uppercase tracking-wide mb-2">Ergebnis</div>
                <div id="basic-result" class="text-5xl sm:text-6xl font-extrabold">50</div>
                <div id="basic-formula" class="text-sm text-blue-200 mt-3">25% von 200 = 50</div>
              </div>
            </div>
          </div>
        </div>

        <!-- MODUS: Umkehrung (X ist wieviel % von Y?) -->
        <div id="panel-reverse" class="calc-panel hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <div class="space-y-4">
                <div>
                  <label for="rev-x" class="block text-sm font-medium text-text mb-1">Wert</label>
                  <input type="text" id="rev-x" value="50" inputmode="decimal"
                    class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>
                <div class="text-center text-2xl text-text-muted font-light">ist wieviel % von</div>
                <div>
                  <label for="rev-y" class="block text-sm font-medium text-text mb-1">Gesamt</label>
                  <input type="text" id="rev-y" value="200" inputmode="decimal"
                    class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>
              </div>
            </div>
            <div class="flex items-center">
              <div class="w-full text-center p-6 bg-secondary rounded-2xl text-white">
                <div class="text-sm font-medium text-emerald-200 uppercase tracking-wide mb-2">Ergebnis</div>
                <div id="rev-result" class="text-5xl sm:text-6xl font-extrabold">25%</div>
                <div id="rev-formula" class="text-sm text-emerald-200 mt-3">50 ist 25% von 200</div>
              </div>
            </div>
          </div>
        </div>

        <!-- MODUS: Prozentuale Veränderung -->
        <div id="panel-change" class="calc-panel hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <div class="space-y-4">
                <div>
                  <label for="change-from" class="block text-sm font-medium text-text mb-1">Von (Ursprungswert)</label>
                  <input type="text" id="change-from" value="100" inputmode="decimal"
                    class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>
                <div class="text-center text-2xl text-text-muted font-light">nach</div>
                <div>
                  <label for="change-to" class="block text-sm font-medium text-text mb-1">Nach (Neuer Wert)</label>
                  <input type="text" id="change-to" value="150" inputmode="decimal"
                    class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>
              </div>
            </div>
            <div class="flex items-center">
              <div class="w-full text-center p-6 rounded-2xl text-white" id="change-result-card" style="background: #10b981">
                <div class="text-sm font-medium opacity-80 uppercase tracking-wide mb-2" id="change-direction">Zunahme</div>
                <div id="change-result" class="text-5xl sm:text-6xl font-extrabold">50%</div>
                <div id="change-formula" class="text-sm opacity-80 mt-3">Von 100 nach 150 = +50%</div>
                <div id="change-diff" class="text-sm opacity-80 mt-1">Differenz: 50</div>
              </div>
            </div>
          </div>
        </div>

        <!-- MODUS: Prozentuale Differenz -->
        <div id="panel-difference" class="calc-panel hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <div class="space-y-4">
                <div>
                  <label for="diff-a" class="block text-sm font-medium text-text mb-1">Wert 1</label>
                  <input type="text" id="diff-a" value="100" inputmode="decimal"
                    class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>
                <div class="text-center text-2xl text-text-muted font-light">vs</div>
                <div>
                  <label for="diff-b" class="block text-sm font-medium text-text mb-1">Wert 2</label>
                  <input type="text" id="diff-b" value="150" inputmode="decimal"
                    class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                </div>
              </div>
            </div>
            <div class="flex items-center">
              <div class="w-full text-center p-6 bg-accent rounded-2xl text-white">
                <div class="text-sm font-medium text-amber-200 uppercase tracking-wide mb-2">% Differenz</div>
                <div id="diff-result" class="text-5xl sm:text-6xl font-extrabold">40%</div>
                <div id="diff-formula" class="text-sm text-amber-200 mt-3">|100 - 150| / ((100 + 150) / 2) = 40%</div>
              </div>
            </div>
          </div>
        </div>

        <ShareButton calculatorId="percentage" lang="de" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <!-- Prozent-Referenztabelle -->
    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">Schnelle Prozent-Referenztabelle</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="ref-table">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left py-2 pr-4 font-semibold text-text">Prozent</th>
              <th class="text-left py-2 pr-4 font-semibold text-text">Bruch</th>
              <th class="text-left py-2 pr-4 font-semibold text-text">Dezimal</th>
              <th class="text-right py-2 font-semibold text-text">Wert von <span id="ref-base">200</span></th>
            </tr>
          </thead>
          <tbody class="text-text-secondary" id="ref-tbody">
          </tbody>
        </table>
      </div>
    </div>

    <!-- SEO-Inhalt -->
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie berechnet man Prozente?</h2>
      <p>Ein Prozent ist eine Möglichkeit, eine Zahl als Bruchteil von 100 auszudrücken. Das Wort "Prozent" kommt vom lateinischen "per centum" und bedeutet "von hundert". Prozente werden überall verwendet -- von Rabatten und Steuerberechnungen bis hin zu Prüfungsergebnissen und Finanzberichten.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Die grundlegende Prozentformel</h3>
      <p>Um <strong>X% einer Zahl Y</strong> zu finden, verwende diese Formel:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono text-lg">
        Ergebnis = (X / 100) &times; Y
      </div>
      <p><strong>Beispiel:</strong> Was ist 15% von 300?</p>
      <p>Ergebnis = (15 / 100) &times; 300 = 0,15 &times; 300 = <strong>45</strong></p>

      <h3 class="text-xl font-semibold text-text mt-8">Wie findet man den Prozentsatz einer Zahl?</h3>
      <p>Um herauszufinden, wieviel Prozent X von Y ist:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono text-lg">
        Prozentsatz = (X / Y) &times; 100
      </div>
      <p><strong>Beispiel:</strong> 45 ist wieviel Prozent von 300?</p>
      <p>Prozentsatz = (45 / 300) &times; 100 = <strong>15%</strong></p>

      <h3 class="text-xl font-semibold text-text mt-8">Prozentuale Zunahme oder Abnahme berechnen</h3>
      <p>Die Formel für die prozentuale Veränderung misst, wie stark ein Wert im Verhältnis zum Ausgangswert gestiegen oder gefallen ist:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono text-lg">
        % Veränderung = ((Neu - Alt) / Alt) &times; 100
      </div>
      <p><strong>Beispiel:</strong> Ein Preis steigt von 80 € auf 100 €.</p>
      <p>% Veränderung = ((100 - 80) / 80) &times; 100 = (20 / 80) &times; 100 = <strong>25% Zunahme</strong></p>

      <h3 class="text-xl font-semibold text-text mt-8">Prozentuale Differenz zwischen zwei Werten</h3>
      <p>Im Gegensatz zur prozentualen Veränderung behandelt die prozentuale Differenz beide Werte gleich -- es spielt keine Rolle, welcher zuerst kam:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono text-lg">
        % Differenz = (|W1 - W2| / ((W1 + W2) / 2)) &times; 100
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufige Prozent-Umrechnungen</h3>
      <ul>
        <li><strong>10%</strong> = 1/10 = 0,1</li>
        <li><strong>20%</strong> = 1/5 = 0,2</li>
        <li><strong>25%</strong> = 1/4 = 0,25</li>
        <li><strong>33,33%</strong> = 1/3 = 0,333...</li>
        <li><strong>50%</strong> = 1/2 = 0,5</li>
        <li><strong>75%</strong> = 3/4 = 0,75</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Anwendungen von Prozenten im Alltag</h3>
      <ul>
        <li><strong>Einkaufen:</strong> Rabatte berechnen -- "30% Rabatt auf 59,99 €" = 41,99 €</li>
        <li><strong>Finanzen:</strong> Zinsen, Anlagerenditen, Inflation</li>
        <li><strong>Steuern:</strong> Einkommensteuer, Mehrwertsteuer, Grundsteuer</li>
        <li><strong>Bildung:</strong> Prüfungsergebnisse, Notenberechnungen</li>
        <li><strong>Gesundheit:</strong> BMI, Körperfettanteil, Nährwertangaben</li>
        <li><strong>Wirtschaft:</strong> Gewinnmargen, Wachstumsraten, Marktanteile</li>
      </ul>

      <h2 class="text-2xl font-bold text-text mt-12">Häufig gestellte Fragen</h2>

      <h3 class="text-lg font-semibold text-text mt-6">Wie berechne ich den Prozentsatz einer Zahl?</h3>
      <p>Um X% einer Zahl zu finden, multipliziere die Zahl mit X und teile durch 100. Zum Beispiel: 25% von 200 = 200 &times; 25 / 100 = 50. Alternativ kannst du den Prozentsatz zuerst in eine Dezimalzahl umwandeln: 25% = 0,25, dann 0,25 &times; 200 = 50.</p>

      <h3 class="text-lg font-semibold text-text mt-6">Wie berechne ich die prozentuale Zunahme?</h3>
      <p>Prozentuale Zunahme = ((Neuer Wert - Alter Wert) / Alter Wert) &times; 100. Beispiel: Steigt ein Preis von 50 € auf 65 €, beträgt die Zunahme ((65-50)/50) &times; 100 = 30%.</p>

      <h3 class="text-lg font-semibold text-text mt-6">Wie rechne ich einen Bruch in Prozent um?</h3>
      <p>Teile den Zähler durch den Nenner und multipliziere mit 100. Zum Beispiel: 3/4 = 0,75 = 75%.</p>

      <h3 class="text-lg font-semibold text-text mt-6">Wie berechne ich einen Rabatt?</h3>
      <p>Multipliziere den Originalpreis mit (1 - Rabatt/100). Beispiel: 20% Rabatt auf 80 €: 80 &times; (1 - 20/100) = 80 &times; 0,8 = 64 €. Du sparst 16 €.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const parse = (v: string) => parseFloat(v.replace(/[^0-9.\-]/g, '')) || 0;
    const fmt = (n: number) => {
      if (Number.isInteger(n) && Math.abs(n) < 1e15) return n.toLocaleString('de-DE');
      return parseFloat(n.toFixed(6)).toLocaleString('de-DE', { maximumFractionDigits: 6 });
    };

    const tabs = document.querySelectorAll('.mode-tab');
    const panels = document.querySelectorAll('.calc-panel');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active', 'text-primary', 'border-primary');
          t.classList.add('text-text-secondary', 'border-transparent');
        });
        tab.classList.add('active', 'text-primary', 'border-primary');
        tab.classList.remove('text-text-secondary', 'border-transparent');
        panels.forEach(p => p.classList.add('hidden'));
        const mode = (tab as HTMLElement).dataset.mode;
        document.getElementById(`panel-${mode}`)?.classList.remove('hidden');
        const url = new URL(window.location.href);
        url.searchParams.set('mode', mode || 'basic');
        history.replaceState(null, '', url.toString());
      });
    });

    const urlMode = new URL(window.location.href).searchParams.get('mode');
    if (urlMode) {
      const targetTab = document.querySelector(`.mode-tab[data-mode="${urlMode}"]`) as HTMLElement;
      targetTab?.click();
    }

    const basicPercent = document.getElementById('basic-percent') as HTMLInputElement;
    const basicNumber = document.getElementById('basic-number') as HTMLInputElement;
    const basicResult = document.getElementById('basic-result')!;
    const basicFormula = document.getElementById('basic-formula')!;

    function calcBasic() {
      const p = parse(basicPercent.value);
      const n = parse(basicNumber.value);
      const result = (p / 100) * n;
      basicResult.textContent = fmt(result);
      basicFormula.textContent = `${fmt(p)}% von ${fmt(n)} = ${fmt(result)}`;
      updateRefTable(n);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    basicPercent.addEventListener('input', calcBasic);
    basicNumber.addEventListener('input', calcBasic);

    const revX = document.getElementById('rev-x') as HTMLInputElement;
    const revY = document.getElementById('rev-y') as HTMLInputElement;
    const revResult = document.getElementById('rev-result')!;
    const revFormula = document.getElementById('rev-formula')!;

    function calcReverse() {
      const x = parse(revX.value);
      const y = parse(revY.value);
      const result = y !== 0 ? (x / y) * 100 : 0;
      revResult.textContent = `${parseFloat(result.toFixed(4))}%`;
      revFormula.textContent = `${fmt(x)} ist ${parseFloat(result.toFixed(4))}% von ${fmt(y)}`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    revX.addEventListener('input', calcReverse);
    revY.addEventListener('input', calcReverse);

    const changeFrom = document.getElementById('change-from') as HTMLInputElement;
    const changeTo = document.getElementById('change-to') as HTMLInputElement;
    const changeResult = document.getElementById('change-result')!;
    const changeFormula = document.getElementById('change-formula')!;
    const changeDiff = document.getElementById('change-diff')!;
    const changeDirection = document.getElementById('change-direction')!;
    const changeCard = document.getElementById('change-result-card')!;

    function calcChange() {
      const from = parse(changeFrom.value);
      const to = parse(changeTo.value);
      const diff = to - from;
      const pct = from !== 0 ? (diff / from) * 100 : 0;
      const isIncrease = pct >= 0;
      changeResult.textContent = `${parseFloat(Math.abs(pct).toFixed(4))}%`;
      changeDirection.textContent = isIncrease ? 'Zunahme' : 'Abnahme';
      changeCard.style.background = isIncrease ? '#10b981' : '#ef4444';
      changeFormula.textContent = `Von ${fmt(from)} nach ${fmt(to)} = ${pct >= 0 ? '+' : ''}${parseFloat(pct.toFixed(4))}%`;
      changeDiff.textContent = `Differenz: ${fmt(Math.abs(diff))}`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    changeFrom.addEventListener('input', calcChange);
    changeTo.addEventListener('input', calcChange);

    const diffA = document.getElementById('diff-a') as HTMLInputElement;
    const diffB = document.getElementById('diff-b') as HTMLInputElement;
    const diffResult = document.getElementById('diff-result')!;
    const diffFormula = document.getElementById('diff-formula')!;

    function calcDifference() {
      const a = parse(diffA.value);
      const b = parse(diffB.value);
      const avg = (a + b) / 2;
      const result = avg !== 0 ? (Math.abs(a - b) / avg) * 100 : 0;
      diffResult.textContent = `${parseFloat(result.toFixed(4))}%`;
      diffFormula.textContent = `|${fmt(a)} - ${fmt(b)}| / ((${fmt(a)} + ${fmt(b)}) / 2) = ${parseFloat(result.toFixed(4))}%`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    diffA.addEventListener('input', calcDifference);
    diffB.addEventListener('input', calcDifference);

    const refPercents = [1, 5, 10, 15, 20, 25, 30, 33.33, 40, 50, 60, 66.67, 75, 80, 90, 100];
    const fractions: Record<number, string> = { 1: '1/100', 5: '1/20', 10: '1/10', 15: '3/20', 20: '1/5', 25: '1/4', 30: '3/10', 33.33: '1/3', 40: '2/5', 50: '1/2', 60: '3/5', 66.67: '2/3', 75: '3/4', 80: '4/5', 90: '9/10', 100: '1/1' };

    function updateRefTable(base: number) {
      const tbody = document.getElementById('ref-tbody')!;
      const baseSpan = document.getElementById('ref-base')!;
      baseSpan.textContent = fmt(base);
      tbody.innerHTML = refPercents.map(p => `
        <tr class="border-b border-border/50">
          <td class="py-2 pr-4">${p}%</td>
          <td class="py-2 pr-4">${fractions[p] || ''}</td>
          <td class="py-2 pr-4">${(p / 100).toFixed(4)}</td>
          <td class="py-2 text-right font-medium">${fmt((p / 100) * base)}</td>
        </tr>
      `).join('');
    }

    calcBasic();
    calcReverse();
    calcChange();
    calcDifference();

    const params = new URL(window.location.href).searchParams;
    if (params.get('p')) basicPercent.value = params.get('p')!;
    if (params.get('n')) basicNumber.value = params.get('n')!;
    if (params.get('p') || params.get('n')) calcBasic();
  </script>
</CalculatorLayout>
