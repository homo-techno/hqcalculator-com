---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Chi-Quadrat-Rechner - Chi-Quadrat-Teststatistik";
const description = "Berechnen Sie die Chi-Quadrat-Teststatistik aus beobachteten und erwarteten Haeufigkeiten. Zeigt Freiheitsgrade und kritische Werte.";
const relatedCalcs = [
  { name: "Chemisches Gleichgewicht", url: "/de/chemisches-gleichgewicht-rechner", description: "Gleichgewichtskonstanten." },
  { name: "Reaktionskinetik", url: "/de/reaktionskinetik-rechner", description: "Reaktionsgeschwindigkeit." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI fuer Kinder." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Chi-Quadrat-Rechner" enSlug="chi-square-calculator" keywords="Chi-Quadrat-Rechner, Chi-Quadrat-Test, Anpassungstest, beobachtet erwartet, Freiheitsgrade, kritischer Wert" breadcrumbs={[{ name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Chi-Quadrat-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie beobachtete und erwartete Haeufigkeiten ein, um die Chi-Quadrat-Statistik zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Beobachtete Werte <span class="text-text-muted">(kommagetrennt)</span></label>
          <textarea id="cq-obs" class="cq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" rows="2" placeholder="16, 18, 22, 14, 10">16, 18, 22, 14, 10</textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Erwartete Werte <span class="text-text-muted">(kommagetrennt)</span></label>
          <textarea id="cq-exp" class="cq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" rows="2" placeholder="16, 16, 16, 16, 16">16, 16, 16, 16, 16</textarea>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Chi-Quadrat-Statistik (&chi;&sup2;)</div>
          <div class="text-5xl font-extrabold font-mono" id="cq-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Freiheitsgrade</div><div class="text-xl font-bold" id="cq-df">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Signifikant (p &lt; 0,05)</div><div class="text-xl font-bold" id="cq-sig">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krit. Wert (p=0,05)</div><div class="text-xl font-bold" id="cq-crit05">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krit. Wert (p=0,01)</div><div class="text-xl font-bold" id="cq-crit01">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Komponentenaufschluesselung</h3>
          <div class="text-sm text-text-secondary font-mono whitespace-pre-wrap" id="cq-breakdown"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="chi-quadrat" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Chi-Quadrat-Anpassungstest</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>&chi;&sup2; = &Sigma; (O<sub>i</sub> - E<sub>i</sub>)&sup2; / E<sub>i</sub></p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Interpretation</h3>
      <ul>
        <li>Wenn &chi;&sup2; &gt; kritischer Wert, wird die Nullhypothese verworfen</li>
        <li>Hoeheres &chi;&sup2; bedeutet groessere Abweichung vom Erwarteten</li>
        <li>Freiheitsgrade = Anzahl der Kategorien - 1</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function parseNums(input: string): number[] {
      return input.split(/[\s,]+/).map(s => parseFloat(s.trim())).filter(n => !isNaN(n));
    }
    function calcCQ() {
      const obs = parseNums((document.getElementById('cq-obs') as HTMLTextAreaElement).value);
      const exp = parseNums((document.getElementById('cq-exp') as HTMLTextAreaElement).value);
      const n = Math.min(obs.length, exp.length);
      const fmt = (v: number) => Number.isInteger(v) ? String(v) : v.toFixed(4);
      if (n < 1) {
        document.getElementById('cq-result')!.textContent = '\u2014';
        document.getElementById('cq-df')!.textContent = '\u2014';
        document.getElementById('cq-sig')!.textContent = '\u2014';
        document.getElementById('cq-crit05')!.textContent = '\u2014';
        document.getElementById('cq-crit01')!.textContent = '\u2014';
        document.getElementById('cq-breakdown')!.textContent = '';
        document.dispatchEvent(new CustomEvent('calc-update'));
        return;
      }
      let chiSq = 0;
      let breakdown = 'Kategorie | Beobachtet | Erwartet | (O-E)\u00B2/E\n' + '-'.repeat(50) + '\n';
      for (let i = 0; i < n; i++) {
        const component = exp[i] !== 0 ? ((obs[i] - exp[i]) ** 2) / exp[i] : 0;
        chiSq += component;
        breakdown += '   ' + (i + 1) + '      |    ' + obs[i] + '     |    ' + exp[i] + '     |  ' + fmt(component) + '\n';
      }
      breakdown += '-'.repeat(50) + '\n';
      breakdown += 'Gesamt \u03C7\u00B2 = ' + fmt(chiSq);
      const df = n - 1;
      const critTable05: Record<number, number> = {1:3.841,2:5.991,3:7.815,4:9.488,5:11.070,6:12.592,7:14.067,8:15.507,9:16.919,10:18.307,11:19.675,12:21.026,13:22.362,14:23.685,15:24.996,16:26.296,17:27.587,18:28.869,19:30.144,20:31.410,25:37.652,30:43.773};
      const critTable01: Record<number, number> = {1:6.635,2:9.210,3:11.345,4:13.277,5:15.086,6:16.812,7:18.475,8:20.090,9:21.666,10:23.209,11:24.725,12:26.217,13:27.688,14:29.141,15:30.578,16:31.999,17:33.409,18:34.805,19:36.191,20:37.566,25:44.314,30:50.892};
      const crit05 = critTable05[df];
      const crit01 = critTable01[df];
      document.getElementById('cq-result')!.textContent = fmt(chiSq);
      document.getElementById('cq-df')!.textContent = String(df);
      document.getElementById('cq-crit05')!.textContent = crit05 !== undefined ? fmt(crit05) : '\u2014';
      document.getElementById('cq-crit01')!.textContent = crit01 !== undefined ? fmt(crit01) : '\u2014';
      if (crit05 !== undefined) {
        document.getElementById('cq-sig')!.textContent = chiSq > crit05 ? 'Ja (H\u2080 verwerfen)' : 'Nein (nicht verwerfen)';
      } else {
        document.getElementById('cq-sig')!.textContent = '\u2014';
      }
      document.getElementById('cq-breakdown')!.textContent = breakdown;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.cq-in').forEach(el => { el.addEventListener('input', calcCQ); el.addEventListener('change', calcCQ); });
      calcCQ();
    }, 50);
  </script>
</CalculatorLayout>
