---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kuchenform-Umrechner - Backformen umrechnen";
const description = "Rechnen Sie Kuchenrezepte zwischen verschiedenen Backformgr\u00f6\u00dfen und -formen um. Berechnen Sie Teigvolumen-Verh\u00e4ltnisse f\u00fcr runde, eckige und rechteckige Formen.";
const relatedCalcs = [
  { name: "Kuchen-Portionen", url: "/de/kuchen-portionen-rechner", description: "Kuchengr\u00f6\u00dfe berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Karamell-Rechner", url: "/de/karamell-rechner", description: "Karamell-Rezepte." },
  { name: "Einmach-Rechner", url: "/de/einmach-rechner", description: "Einmachen berechnen." },
  { name: "Kerzenherstellung", url: "/de/kerzenherstellung-rechner", description: "Kerzen herstellen." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorienverbrauch." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kuchenform-Umrechner" lang="de" enSlug="cake-pan-converter-calculator" keywords="kuchenform umrechner, backform gr\u00f6\u00dfe, rezept umrechnen, teigvolumen, backform vergleich" breadcrumbs={[{ name: "Kuchenform-Umrechner", url: "/de/kuchenform-umrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kuchenform-Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie Kuchenrezepte zwischen verschiedenen Formgr&ouml;&szlig;en und -formen um.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-bold text-text text-sm uppercase tracking-wide">Originalform</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Form</label>
            <select id="kfu-shape1" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="round">Rund</option>
              <option value="square">Quadratisch</option>
              <option value="rect">Rechteckig</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">H&ouml;he (cm)</label>
            <input type="number" id="kfu-h1" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" step="0.5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite / Durchmesser (cm)</label>
            <input type="number" id="kfu-w1" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="24" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">L&auml;nge (cm) - nur rechteckig</label>
            <input type="number" id="kfu-l1" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="33" min="1" step="1">
          </div>
        </div>
        <h3 class="font-bold text-text text-sm uppercase tracking-wide pt-2">Neue Form</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Form</label>
            <select id="kfu-shape2" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="round" selected>Rund</option>
              <option value="square">Quadratisch</option>
              <option value="rect">Rechteckig</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">H&ouml;he (cm)</label>
            <input type="number" id="kfu-h2" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" step="0.5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite / Durchmesser (cm)</label>
            <input type="number" id="kfu-w2" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">L&auml;nge (cm) - nur rechteckig</label>
            <input type="number" id="kfu-l2" class="kfu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="33" min="1" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Rezept-Multiplikator</div>
          <div class="text-5xl font-extrabold font-mono" id="kfu-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Originalvolumen</div>
            <div class="text-xl font-bold font-mono" id="kfu-vol1">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Neues Volumen</div>
            <div class="text-xl font-bold font-mono" id="kfu-vol2">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Backzeit-Anpassung</div>
          <div class="text-xl font-bold font-mono" id="kfu-time">--</div>
        </div>
      </div>
      <ShareButton calculatorId="cake-pan-converter" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Wie rechne ich Backformen um?</h3>
      <p>Der Umrechner vergleicht das Volumen beider Formen und berechnet den Faktor, mit dem Sie alle Zutaten multiplizieren m&uuml;ssen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKFU() {
      const shape1 = (document.getElementById('kfu-shape1') as HTMLSelectElement).value;
      const shape2 = (document.getElementById('kfu-shape2') as HTMLSelectElement).value;
      const w1 = parseFloat((document.getElementById('kfu-w1') as HTMLInputElement).value) || 0;
      const l1 = parseFloat((document.getElementById('kfu-l1') as HTMLInputElement).value) || 0;
      const h1 = parseFloat((document.getElementById('kfu-h1') as HTMLInputElement).value) || 0;
      const w2 = parseFloat((document.getElementById('kfu-w2') as HTMLInputElement).value) || 0;
      const l2 = parseFloat((document.getElementById('kfu-l2') as HTMLInputElement).value) || 0;
      const h2 = parseFloat((document.getElementById('kfu-h2') as HTMLInputElement).value) || 0;

      function volume(shape: string, w: number, l: number, h: number): number {
        if (shape === 'round') return Math.PI * Math.pow(w / 2, 2) * h;
        if (shape === 'square') return w * w * h;
        return w * l * h;
      }

      const vol1 = volume(shape1, w1, l1, h1);
      const vol2 = volume(shape2, w2, l2, h2);

      if (vol1 <= 0 || vol2 <= 0) {
        document.getElementById('kfu-result')!.textContent = 'Ma\u00dfe eingeben';
        return;
      }

      const multiplier = vol2 / vol1;

      document.getElementById('kfu-result')!.textContent = multiplier.toFixed(2).replace('.', ',') + 'x';
      document.getElementById('kfu-vol1')!.textContent = vol1.toFixed(1).replace('.', ',') + ' cm\u00b3';
      document.getElementById('kfu-vol2')!.textContent = vol2.toFixed(1).replace('.', ',') + ' cm\u00b3';

      let timeAdj = '';
      if (multiplier < 0.7) timeAdj = 'Zeit um 10-15 Min. reduzieren, fr\u00fch pr\u00fcfen';
      else if (multiplier < 0.9) timeAdj = 'Zeit um 5-10 Min. reduzieren';
      else if (multiplier <= 1.1) timeAdj = 'Gleiche Backzeit beibehalten';
      else if (multiplier <= 1.4) timeAdj = '5-10 Min. l\u00e4nger, bei Br\u00e4unung abdecken';
      else timeAdj = '10-20 Min. l\u00e4nger, Temperatur um 10\u00b0C senken';
      document.getElementById('kfu-time')!.textContent = timeAdj;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kfu-in').forEach(el => { el.addEventListener('input', calcKFU); el.addEventListener('change', calcKFU); });
      calcKFU();
    }, 50);
  </script>
</CalculatorLayout>
