---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Luftentfeuchter-Rechner - Dimensionierung nach Raumgroesse";
const description = "Berechnen Sie die benoetigte Luftentfeuchter-Kapazitaet in Liter/Tag basierend auf Raumgroesse, Luftfeuchtigkeit, Feuchtigkeitsquellen und Klimabedingungen.";

const relatedCalcs = [
  { name: "Heizlastrechner", url: "/de/heizlast-rechner", description: "Heizlast." },
  { name: "L\u00fcftungsrechner", url: "/de/lueftungs-rechner", description: "Luftwechselrate." },
  { name: "K\u00fchllastrechner", url: "/de/kuehllast-rechner", description: "K\u00fchllast." },
  { name: "Energierechner", url: "/de/energie-rechner", description: "Energieverbrauch." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="dehumidifier-calculator" calculatorName="Luftentfeuchter-Rechner" keywords="luftentfeuchter rechner, luftentfeuchter dimensionierung, liter pro tag, luftfeuchtigkeit, entfeuchtung, keller entfeuchten" breadcrumbs={[{ name: "Luftentfeuchter-Rechner", url: "/de/luftentfeuchter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Luftentfeuchter-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die richtige Luftentfeuchter-Gr&ouml;&szlig;e f&uuml;r Ihren Raum basierend auf Raumverh&auml;ltnissen und Feuchtigkeitsniveau.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <h3 class="text-lg font-bold text-text">Raumgr&ouml;&szlig;e</h3>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">L&auml;nge (m)</label>
            <input type="number" id="le2-length" class="le2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" min="2" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Breite (m)</label>
            <input type="number" id="le2-width" class="le2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="2" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">H&ouml;he (m)</label>
            <input type="number" id="le2-height" class="le2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="2" step="0.1">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Aktuelle Luftfeuchtigkeit (%RH)</label>
            <input type="number" id="le2-current" class="le2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70" min="30" max="100" step="5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Ziel-Luftfeuchtigkeit (%RH)</label>
            <input type="number" id="le2-target" class="le2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="30" max="60" step="5">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Raumtemperatur (&deg;C)</label>
            <input type="number" id="le2-temp" class="le2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="22" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Feuchtigkeitszustand</label>
            <select id="le2-condition" class="le2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="moderate">M&auml;&szlig;ig feucht</option>
              <option value="damp" selected>Feucht (modriger Geruch)</option>
              <option value="wet">Nass (sichtbare Feuchtigkeit)</option>
              <option value="extreme">Extrem nass (&Uuml;berschwemmung)</option>
            </select>
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Kapazit&auml;t</div>
          <div class="text-4xl font-extrabold" id="le2-liters">--</div>
          <div class="text-sm text-blue-200 mt-1">Liter pro Tag</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Raumfl&auml;che</div>
            <div class="text-xl font-bold" id="le2-area">--</div>
            <div class="text-xs text-text-muted">m&sup2;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Raumvolumen</div>
            <div class="text-xl font-bold" id="le2-volume">--</div>
            <div class="text-xs text-text-muted">m&sup3;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Feuchtigkeitsdifferenz</div>
            <div class="text-xl font-bold" id="le2-moisture">--</div>
            <div class="text-xs text-text-muted">% RH</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Pints pro Tag</div>
            <div class="text-xl font-bold" id="le2-pints">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-1">Empfohlene Ger&auml;tegr&ouml;&szlig;e</div>
          <div class="text-lg font-bold" id="le2-rec">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="dehumidifier" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl mx-auto prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Luftentfeuchter-Dimensionierung</h2>
      <p>Die Kapazit&auml;t eines Luftentfeuchters wird in Liter Wasser pro Tag angegeben. Die richtige Gr&ouml;&szlig;e h&auml;ngt von der Raumfl&auml;che, dem Feuchtigkeitsgrad und der gew&uuml;nschten Luftfeuchtigkeit ab.</p>
      <ul>
        <li><strong>M&auml;&szlig;ig:</strong> Raum f&uuml;hlt sich nur bei feuchtem Wetter feucht an</li>
        <li><strong>Feucht:</strong> Immer feucht, modriger Geruch</li>
        <li><strong>Nass:</strong> W&auml;nde schwitzen, Kondenswasser sichtbar</li>
        <li><strong>Extrem nass:</strong> Stehendes Wasser oder &Uuml;berschwemmung</li>
        <li>Ziel 40-60% RH f&uuml;r Komfort; unter 60% gegen Schimmel</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel Strom verbraucht ein Luftentfeuchter?</strong> Typisch 200-500 Watt, bei Dauerbetrieb ca. 3-10 kWh pro Tag. Bei einem Strompreis von 0,30 &euro;/kWh sind das 0,90-3,00 &euro; pro Tag.</p>
      <p><strong>Wann brauche ich einen Bautrockner statt eines Entfeuchters?</strong> Bei Wassersch&auml;den oder Neubaufeuchte. Bautrockner haben deutlich h&ouml;here Kapazit&auml;ten (bis 80+ Liter/Tag).</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcLE2() {
      const length = parseFloat((document.getElementById('le2-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('le2-width') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('le2-height') as HTMLInputElement).value) || 0;
      const currentRH = parseFloat((document.getElementById('le2-current') as HTMLInputElement).value) || 70;
      const targetRH = parseFloat((document.getElementById('le2-target') as HTMLInputElement).value) || 50;
      const temp = parseFloat((document.getElementById('le2-temp') as HTMLInputElement).value) || 22;
      const condition = (document.getElementById('le2-condition') as HTMLSelectElement).value;

      const area = length * width;
      const volume = area * height;

      const condFactors: Record<string, number> = {
        moderate: 0.2, damp: 0.3, wet: 0.4, extreme: 0.5,
      };
      const baseLiters = condFactors[condition] || 0.3;

      let liters = baseLiters * area;

      const humidityDiff = currentRH - targetRH;
      const humidityFactor = humidityDiff > 20 ? 1.0 + (humidityDiff - 20) * 0.02 : 1.0;
      liters *= humidityFactor;

      if (temp < 18) liters *= 1.2;
      else if (temp > 28) liters *= 0.9;

      liters *= height / 2.5;

      const pints = liters / 0.473176;

      let rec = '';
      if (liters <= 10) rec = '10-Liter-Ger\u00e4t (kleiner Raum)';
      else if (liters <= 16) rec = '16-Liter-Ger\u00e4t (Standard-Raum)';
      else if (liters <= 25) rec = '25-Liter-Ger\u00e4t (gro\u00dfer Raum)';
      else if (liters <= 35) rec = '35-Liter-Ger\u00e4t (Keller/Ganzes Geschoss)';
      else rec = Math.ceil(liters / 35) + ' x 35-Liter-Ger\u00e4te oder Bautrockner';

      document.getElementById('le2-liters')!.textContent = liters.toFixed(1).replace('.', ',');
      document.getElementById('le2-area')!.textContent = area.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('le2-volume')!.textContent = volume.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('le2-moisture')!.textContent = humidityDiff.toFixed(0);
      document.getElementById('le2-pints')!.textContent = pints.toFixed(1).replace('.', ',');
      document.getElementById('le2-rec')!.textContent = rec;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.le2-in').forEach(el => {
        el.addEventListener('input', calcLE2);
        el.addEventListener('change', calcLE2);
      });
      calcLE2();
    }, 50);
  </script>
</CalculatorLayout>
