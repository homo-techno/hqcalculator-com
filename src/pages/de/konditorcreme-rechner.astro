---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Konditor-Creme Rechner - Zutatenmengen für Torten";
const description = "Berechnen Sie Zutatenmengen für Konditoreicreme und Füllungen für verschiedene Tortengrößen. Perfekt für Patissiers und Hobbybäcker.";

const relatedCalcs = [
  { name: "Backmengen-Rechner", url: "/de/backmengen-rechner", description: "Backmengen skalieren." },
  { name: "Rezept-Rechner", url: "/de/rezept-rechner", description: "Rezepte umrechnen." },
  { name: "Kalorien-Rechner", url: "/de/kalorien-rechner", description: "Kalorien berechnen." },
  { name: "Gewichtsrechner", url: "/de/gewichtsrechner", description: "Gewicht umrechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Konditor-Creme Rechner" lang="de" enSlug="pastry-cream-calculator" keywords="konditorcreme rechner, patisserie creme berechnen, tortenfüllung menge, crème pâtissière, konditoreibedarf" breadcrumbs={[{ name: "Konditor-Creme Rechner", url: "/de/konditorcreme-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Konditor-Creme Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie genaue Zutatenmengen für Konditoreicremes und Tortenfüllungen verschiedener Größen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Cremetyp</label>
          <select id="kc-type" class="kc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="patissiere">Crème pâtissière (Konditorcreme)</option>
            <option value="chantilly">Crème chantilly (Schlagsahne)</option>
            <option value="buttercream">Buttercreme (klassisch)</option>
            <option value="ganache">Ganache (Schokolade)</option>
            <option value="mascarpone">Mascarpone-Creme</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tortendurchmesser (cm)</label><input type="number" id="kc-diam" class="kc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="26" min="10" max="60" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Fülllschichten</label><input type="number" id="kc-layers" class="kc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="10" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schichtdicke (mm)</label><input type="number" id="kc-thickness" class="kc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="3" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Außeneindeckung</label><select id="kc-cover" class="kc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="none">Keine</option><option value="thin">Dünn (2 mm)</option><option value="thick">Dick (5 mm)</option></select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Cremenmenge</div>
          <div class="text-4xl font-extrabold font-mono" id="kc-result">0 g</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl overflow-x-auto">
          <h3 class="font-semibold text-sm text-text mb-3">Zutaten</h3>
          <div id="kc-ingredients" class="space-y-1 text-sm"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen gesamt</div><div class="text-xl font-bold" id="kc-volume">0 ml</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien (ca.)</div><div class="text-xl font-bold" id="kc-kcal">0 kcal</div></div>
        </div>
      </div>
      <ShareButton calculatorId="konditorcreme-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Konditoreicreme: Grundlagen und Mengen</h2>
      <p class="text-text-secondary mt-2">Die richtige Cremenmenge ist entscheidend für das Gelingen einer Torte. Zu wenig Creme lässt die Torte trocken wirken, zu viel macht sie schwer und unausgewogen. Als Faustregel gilt: Für eine Füllung bei einer 26-cm-Torte mit 2 Schichten benötigt man ca. 400–600 g Creme. Die genaue Menge hängt von der Dichte der Creme und der gewünschten Schichtdicke ab.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Volumen Füllung:</strong> π × (d/2)² × Schichtdicke × Anzahl Schichten</p>
        <p><strong>Crememasse (g):</strong> Volumen (cm³) × Dichte der Creme (g/cm³)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Crème pâtissière und Buttercreme?</strong> Crème pâtissière ist eine gekochte Creme auf Milchbasis mit Eiern und Stärke – leichter und frischer im Geschmack. Buttercreme enthält viel Butter und ist stabiler, eignet sich daher besser für aufwändige Dekorationen.</p>
      <p><strong>Wie lange ist selbst hergestellte Torte haltbar?</strong> Torten mit Konditoreicreme sollten im Kühlschrank aufbewahrt und innerhalb von 2–3 Tagen verzehrt werden. Ganache-Torten halten sich 3–5 Tage im Kühlschrank.</p>
      <p><strong>Kann ich die Creme einfrieren?</strong> Ganache und Buttercreme lassen sich gut einfrieren. Crème pâtissière verliert beim Auftauen ihre Konsistenz und wird wässrig – besser frisch zubereiten.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKC() {
      const type = (document.getElementById('kc-type') as HTMLSelectElement).value;
      const diam = parseFloat((document.getElementById('kc-diam') as HTMLInputElement).value) || 26;
      const layers = parseInt((document.getElementById('kc-layers') as HTMLInputElement).value) || 2;
      const thickMM = parseFloat((document.getElementById('kc-thickness') as HTMLInputElement).value) || 8;
      const cover = (document.getElementById('kc-cover') as HTMLSelectElement).value;

      const radius = diam / 2;
      const layerVolCm3 = Math.PI * radius * radius * (thickMM / 10);
      const circumference = Math.PI * diam;
      const torteHeight = layers * 3 + thickMM * layers / 10 + 2;

      const coverThickMM = cover === 'none' ? 0 : cover === 'thin' ? 2 : 5;
      const sideVolCm3 = circumference * torteHeight * (coverThickMM / 10);
      const topVolCm3 = cover === 'none' ? 0 : Math.PI * radius * radius * (coverThickMM / 10);
      const totalVolCm3 = layerVolCm3 * layers + sideVolCm3 + topVolCm3;

      const densities: Record<string, number> = { patissiere: 1.05, chantilly: 0.45, buttercream: 0.90, ganache: 1.25, mascarpone: 0.85 };
      const kcalPer100g: Record<string, number> = { patissiere: 165, chantilly: 300, buttercream: 450, ganache: 520, mascarpone: 400 };
      const density = densities[type] || 1.0;
      const totalMassG = totalVolCm3 * density;
      const totalKcal = (totalMassG / 100) * (kcalPer100g[type] || 300);

      const recipes: Record<string, { label: string; parts: { name: string; ratio: number; unit: string }[] }> = {
        patissiere: { label: 'Crème pâtissière', parts: [{ name: 'Vollmilch', ratio: 0.60, unit: 'ml' }, { name: 'Eigelb', ratio: 0.08, unit: 'g' }, { name: 'Zucker', ratio: 0.12, unit: 'g' }, { name: 'Speisestärke', ratio: 0.05, unit: 'g' }, { name: 'Butter', ratio: 0.05, unit: 'g' }, { name: 'Vanillemark', ratio: 0.01, unit: 'g' }] },
        chantilly: { label: 'Crème chantilly', parts: [{ name: 'Sahne (30% Fett)', ratio: 0.88, unit: 'ml' }, { name: 'Puderzucker', ratio: 0.05, unit: 'g' }, { name: 'Vanilleextrakt', ratio: 0.01, unit: 'ml' }] },
        buttercream: { label: 'Buttercreme', parts: [{ name: 'Butter (Zimmertemp.)', ratio: 0.55, unit: 'g' }, { name: 'Puderzucker', ratio: 0.35, unit: 'g' }, { name: 'Vanilleextrakt', ratio: 0.01, unit: 'ml' }, { name: 'Sahne', ratio: 0.03, unit: 'ml' }] },
        ganache: { label: 'Ganache', parts: [{ name: 'Zartbitterschokolade', ratio: 0.50, unit: 'g' }, { name: 'Sahne (35% Fett)', ratio: 0.45, unit: 'ml' }, { name: 'Butter', ratio: 0.05, unit: 'g' }] },
        mascarpone: { label: 'Mascarpone-Creme', parts: [{ name: 'Mascarpone', ratio: 0.50, unit: 'g' }, { name: 'Sahne', ratio: 0.30, unit: 'ml' }, { name: 'Puderzucker', ratio: 0.10, unit: 'g' }, { name: 'Vanilleextrakt', ratio: 0.01, unit: 'ml' }] },
      };

      const rec = recipes[type];
      const ingHTML = rec ? rec.parts.map(p => {
        const amt = totalMassG * p.ratio;
        return '<div class="flex justify-between"><span>' + p.name + '</span><span class="font-mono font-bold">' + Math.round(amt).toLocaleString('de-DE') + ' ' + p.unit + '</span></div>';
      }).join('') : '';

      document.getElementById('kc-result')!.textContent = Math.round(totalMassG).toLocaleString('de-DE') + ' g';
      document.getElementById('kc-volume')!.textContent = Math.round(totalVolCm3 * 10).toLocaleString('de-DE') + ' ml';
      document.getElementById('kc-kcal')!.textContent = Math.round(totalKcal).toLocaleString('de-DE') + ' kcal';
      document.getElementById('kc-ingredients')!.innerHTML = ingHTML;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kc-in').forEach(el => { el.addEventListener('input', calcKC); el.addEventListener('change', calcKC); });
      calcKC();
    }, 50);
  </script>
</CalculatorLayout>
