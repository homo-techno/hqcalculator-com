---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "BTU-Rechner - Heiz- & K&uuml;hlleistung berechnen";
const description = "Berechnen Sie die ben&ouml;tigte BTU-Kapazit&auml;t zum Heizen oder K&uuml;hlen Ihres Raumes basierend auf Ma&szlig;en und Bedingungen.";
const relatedCalcs = [
  { name: "Fl&auml;chenrechner", url: "/de/flaechenrechner", description: "Fl&auml;chen berechnen." },
  { name: "Stromkosten-Rechner", url: "/de/stromkostenrechner", description: "Stromkosten." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="BTU-Rechner" lang="de" enSlug="btu-calculator" keywords="btu rechner, heizleistung, k&uuml;hlleistung, klimaanlage gr&ouml;&szlig;e, heizung dimensionierung" breadcrumbs={[{ name: "BTU-Rechner", url: "/de/btu-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">BTU-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die richtige Heiz-/K&uuml;hlleistung f&uuml;r Ihren Raum.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="bt-cool" class="px-4 py-2 rounded-lg text-sm font-semibold border-2 border-primary bg-blue-50 text-primary">K&uuml;hlen (Klima)</button>
          <button id="bt-heat" class="px-4 py-2 rounded-lg text-sm font-semibold border-2 border-border text-text-muted">Heizen</button>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Rauml&auml;nge (m)</label><input type="number" id="bt-l" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="bt-w" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Deckenh&ouml;he (m)</label><input type="number" id="bt-h" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="2" max="6" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">D&auml;mmung</label>
            <select id="bt-insul" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="poor">Schlecht</option><option value="average" selected>Durchschnittlich</option><option value="good">Gut</option><option value="excellent">Ausgezeichnet</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonneneinstrahlung</label>
            <select id="bt-sun" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="shaded">Meist beschattet</option><option value="average" selected>Durchschnittlich</option><option value="sunny">Sehr sonnig</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Personen</label><input type="number" id="bt-occ" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Klimazone</label>
            <select id="bt-climate" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="mild">Mild</option><option value="moderate" selected>Gem&auml;&szlig;igt</option><option value="hot">Hei&szlig; / Sehr kalt</option><option value="extreme">Extrem</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene BTU</div>
          <div class="text-5xl font-extrabold" id="bt-btu">0</div>
          <div class="text-sm text-blue-200 mt-1" id="bt-kw">0 kW</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumfl&auml;che</div><div class="text-xl font-bold" id="bt-area">0 m&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Watt-&Auml;quivalent</div><div class="text-xl font-bold" id="bt-watts">0 W</div></div>
        </div>
      </div>
      <ShareButton calculatorId="btu" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">BTU-Dimensionierung</h2>
      <p>Faustregel: Ca. 60 BTU pro m&sup2; zum K&uuml;hlen (gut ged&auml;mmter Raum) bis 100 BTU pro m&sup2; bei schlechter D&auml;mmung. Faktoren wie D&auml;mmung, Sonneneinstrahlung, Klima und Personenanzahl beeinflussen das Ergebnis. 1 kW &asymp; 3.412 BTU/h.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let isCooling = true;
    function setMode(cool: boolean) {
      isCooling = cool;
      document.getElementById('bt-cool')!.className = `px-4 py-2 rounded-lg text-sm font-semibold border-2 ${cool ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted'}`;
      document.getElementById('bt-heat')!.className = `px-4 py-2 rounded-lg text-sm font-semibold border-2 ${!cool ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted'}`;
      calcBTU();
    }
    function calcBTU() {
      const l = parseFloat((document.getElementById('bt-l') as HTMLInputElement).value) || 0;
      const w = parseFloat((document.getElementById('bt-w') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('bt-h') as HTMLInputElement).value) || 2.5;
      const insul = (document.getElementById('bt-insul') as HTMLSelectElement).value;
      const sun = (document.getElementById('bt-sun') as HTMLSelectElement).value;
      const occ = parseInt((document.getElementById('bt-occ') as HTMLInputElement).value) || 2;
      const climate = (document.getElementById('bt-climate') as HTMLSelectElement).value;
      const areaM2 = l * w;
      const areaSqFt = areaM2 * 10.7639;
      let baseBTU = areaSqFt * (isCooling ? 20 : 30);
      const heightFactor = h > 2.5 ? 1 + (h - 2.5) * 0.15 : 1;
      baseBTU *= heightFactor;
      const insulMul: Record<string, number> = { poor: 1.3, average: 1.0, good: 0.85, excellent: 0.7 };
      baseBTU *= insulMul[insul];
      const sunMul: Record<string, number> = { shaded: 0.9, average: 1.0, sunny: 1.15 };
      baseBTU *= sunMul[sun];
      if (occ > 2) baseBTU += (occ - 2) * 600;
      const climateMul: Record<string, number> = { mild: 0.85, moderate: 1.0, hot: 1.15, extreme: 1.3 };
      baseBTU *= climateMul[climate];
      const btu = Math.ceil(baseBTU / 1000) * 1000;
      const kw = btu * 0.000293071;
      document.getElementById('bt-btu')!.textContent = btu.toLocaleString('de-DE');
      document.getElementById('bt-kw')!.textContent = kw.toFixed(1).replace('.', ',') + ' kW';
      document.getElementById('bt-area')!.textContent = areaM2.toFixed(1).replace('.', ',') + ' m\u00B2';
      document.getElementById('bt-watts')!.textContent = Math.round(btu * 0.293071).toLocaleString('de-DE') + ' W';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bt-l') as HTMLInputElement).value = '6';
      (document.getElementById('bt-w') as HTMLInputElement).value = '4.5';
      (document.getElementById('bt-h') as HTMLInputElement).value = '2.5';
      (document.getElementById('bt-occ') as HTMLInputElement).value = '2';
      document.getElementById('bt-cool')!.addEventListener('click', () => setMode(true));
      document.getElementById('bt-heat')!.addEventListener('click', () => setMode(false));
      document.querySelectorAll('.bt-in').forEach(el => { el.addEventListener('input', calcBTU); el.addEventListener('change', calcBTU); });
      calcBTU();
    }, 50);
  </script>
</CalculatorLayout>
