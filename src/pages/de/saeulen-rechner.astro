---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "S\u00e4ulenrechner - Bemessung, Knicklast & Querschnittsfl\u00e4che";
const description = "Berechnen Sie S\u00e4ulenbemessung f\u00fcr Stahl, Holz oder Beton. Geben Sie Last, H\u00f6he und Material ein, um die erforderliche Querschnittsfl\u00e4che, Schlankheitsgrad und Euler-Knicklast zu erhalten.";

const relatedCalcs = [
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Betonbewehrungsrechner", url: "/de/betonbewehrung-rechner", description: "Bewehrung." },
  { name: "Betonschalungsrechner", url: "/de/betonschalung-rechner", description: "Schalungsmaterial." },
  { name: "Betonmischungsrechner", url: "/de/betonmischung-rechner", description: "Mischungsentwurf." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="S\u00e4ulenrechner" lang="de" enSlug="column-calculator" keywords="s\u00e4ulenrechner, s\u00e4ulenbemessung, euler knicklast, schlankheitsgrad, stahlst\u00fctze, holzst\u00fctze, betonst\u00fctze" breadcrumbs={[{ name: "S\u00e4ulenrechner", url: "/de/saeulen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">S&auml;ulenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie S&auml;ulenbemessung, Knicklast und Schlankheitsgrad f&uuml;r tragende S&auml;ulen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Axiallast (kN)</label>
            <input type="number" id="sr-load" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="100" min="0" step="10">
          </div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">S&auml;ulenh&ouml;he / Knickl&auml;nge (m)</label>
            <input type="number" id="sr-height" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="3" min="0.5" step="0.1">
          </div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Material</label>
            <select id="sr-material" class="w-full px-3 py-3 border border-border rounded-xl text-lg">
              <option value="steel" selected>Baustahl S235 (fy=235 MPa)</option>
              <option value="wood">Holz (Nadelholz C24, fc=21 MPa)</option>
              <option value="concrete">Beton (C30/37, fck=30 MPa)</option>
            </select>
          </div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Randbedingung (K-Faktor)</label>
            <select id="sr-kfactor" class="w-full px-3 py-3 border border-border rounded-xl text-lg">
              <option value="0.65">Eingespannt-Eingespannt (K=0,65)</option>
              <option value="0.80">Eingespannt-Gelenkig (K=0,80)</option>
              <option value="1.0" selected>Gelenkig-Gelenkig (K=1,0)</option>
              <option value="1.2">Eingespannt-Frei (Kragarm, K=1,2)</option>
              <option value="2.0">Frei-Frei (K=2,0)</option>
            </select>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Sicherheitsfaktor</label>
              <input type="number" id="sr-sf" class="w-full px-3 py-2 border border-border rounded-lg" value="2.0" min="1" max="5" step="0.1">
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Erforderliche Querschnittsfl&auml;che</div>
            <div class="text-5xl font-extrabold font-mono" id="sr-area">0</div>
            <div class="text-sm text-blue-200 mt-1">cm&sup2; (min)</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Euler-Knicklast</div>
              <div class="text-xl font-bold" id="sr-euler">0 kN</div>
              <div class="text-xs text-text-muted">kritische Last</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Schlankheitsgrad</div>
              <div class="text-xl font-bold" id="sr-slender">0</div>
              <div class="text-xs text-text-muted">KL/r</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Min. Abmessung</div>
              <div class="text-xl font-bold" id="sr-dim">0 cm</div>
              <div class="text-xs text-text-muted">Quadrats&auml;ule Seite</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Effektive L&auml;nge</div>
              <div class="text-xl font-bold" id="sr-eff">0 m</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Vorgeschlagene Gr&ouml;&szlig;e</div>
            <div class="text-xl font-bold" id="sr-suggest">--</div>
            <div class="text-xs text-text-muted">Statiker konsultieren</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="column" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">So bemessen Sie eine S&auml;ule</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Erforderliche Fl&auml;che:</strong> Last x Sicherheitsfaktor / Zul&auml;ssige Spannung</p>
        <p><strong>Euler-Knicklast:</strong> Pi&sup2; x E x I / (K x L)&sup2;</p>
        <p><strong>Schlankheitsgrad:</strong> K x L / r (Tr&auml;gheitsradius)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Materialeigenschaften</h3>
      <ul>
        <li><strong>Stahl S235:</strong> E = 210.000 MPa, fy = 235 MPa</li>
        <li><strong>Holz (C24):</strong> E = 11.000 MPa, fc = 21 MPa</li>
        <li><strong>Beton (C30/37):</strong> E = 33.000 MPa, fck = 30 MPa</li>
      </ul>
      <p class="text-sm text-red-600"><strong>Haftungsausschluss:</strong> Nur zur Absch&auml;tzung. Konsultieren Sie einen zugelassenen Tragwerksplaner.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const srMaterials: Record<string, { E: number; allowable: number }> = {
      steel: { E: 210000, allowable: 156.7 },     // MPa, 0.6*fy (simplified)
      wood: { E: 11000, allowable: 14 },            // MPa
      concrete: { E: 33000, allowable: 17 },         // MPa, 0.85*fck/1.5
    };

    function calcColumn() {
      const loadKN = parseFloat((document.getElementById('sr-load') as HTMLInputElement).value) || 0;
      const heightM = parseFloat((document.getElementById('sr-height') as HTMLInputElement).value) || 1;
      const material = (document.getElementById('sr-material') as HTMLSelectElement).value;
      const K = parseFloat((document.getElementById('sr-kfactor') as HTMLSelectElement).value) || 1.0;
      const sf = parseFloat((document.getElementById('sr-sf') as HTMLInputElement).value) || 2.0;

      const mat = srMaterials[material] || srMaterials.steel;
      const loadN = loadKN * 1000;
      const heightMM = heightM * 1000;
      const effectiveLengthMM = K * heightMM;

      // Required area based on allowable stress (N/mm2 = MPa)
      const designLoad = loadN * sf;
      const reqAreaMM2 = designLoad / mat.allowable;
      const reqAreaCM2 = reqAreaMM2 / 100;

      // Assume square column: side = sqrt(area), I = side^4/12, r = side/sqrt(12)
      const sideMM = Math.sqrt(reqAreaMM2);
      const I = Math.pow(sideMM, 4) / 12;
      const r = sideMM / Math.sqrt(12);

      // Slenderness ratio
      const slenderness = r > 0 ? effectiveLengthMM / r : 0;

      // Euler buckling load (N)
      const eulerLoadN = I > 0 ? (Math.PI * Math.PI * mat.E * I) / (effectiveLengthMM * effectiveLengthMM) : 0;
      const eulerLoadKN = eulerLoadN / 1000;

      // Suggested size
      let suggest = '--';
      if (material === 'steel') {
        if (reqAreaCM2 <= 20) suggest = 'HEB 100 (26 cm\u00B2)';
        else if (reqAreaCM2 <= 40) suggest = 'HEB 140 (43 cm\u00B2)';
        else if (reqAreaCM2 <= 65) suggest = 'HEB 180 (65 cm\u00B2)';
        else if (reqAreaCM2 <= 100) suggest = 'HEB 220 (91 cm\u00B2)';
        else suggest = 'HEB 260+ (Statiker konsultieren)';
      } else if (material === 'wood') {
        if (reqAreaCM2 <= 100) suggest = '10x10 cm';
        else if (reqAreaCM2 <= 225) suggest = '15x15 cm';
        else if (reqAreaCM2 <= 400) suggest = '20x20 cm';
        else suggest = '25x25 cm+';
      } else {
        const sideCM = Math.ceil(sideMM / 10) / 10 * 10;
        const roundSide = Math.ceil(sideCM / 5) * 5;
        suggest = roundSide + ' x ' + roundSide + ' cm Betons\u00e4ule';
      }

      document.getElementById('sr-area')!.textContent = reqAreaCM2.toFixed(1);
      document.getElementById('sr-euler')!.textContent = eulerLoadKN.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' kN';
      document.getElementById('sr-slender')!.textContent = slenderness.toFixed(1);
      document.getElementById('sr-dim')!.textContent = (sideMM / 10).toFixed(1) + ' cm';
      document.getElementById('sr-eff')!.textContent = (effectiveLengthMM / 1000).toFixed(2) + ' m';
      document.getElementById('sr-suggest')!.textContent = suggest;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('#sr-load, #sr-height, #sr-sf').forEach(el => {
        el.addEventListener('input', calcColumn);
        el.addEventListener('change', calcColumn);
      });
      document.querySelectorAll('#sr-material, #sr-kfactor').forEach(el => {
        el.addEventListener('input', calcColumn);
        el.addEventListener('change', calcColumn);
      });
      calcColumn();
    }, 50);
  </script>
</CalculatorLayout>
