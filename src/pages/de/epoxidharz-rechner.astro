---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Epoxidharz-Rechner - Harz & H\u00e4rter Mischung";
const description = "Berechnen Sie das Mischverh\u00e4ltnis von Harz und H\u00e4rter nach Volumen oder Gewicht, Abdeckungsfl\u00e4che und Topfzeit bei verschiedenen Temperaturen.";
const relatedCalcs = [
  { name: "Umschlag-Rechner", url: "/de/umschlag-rechner", description: "Umschlaggr\u00f6\u00dfen." },
  { name: "Erosion-Rechner", url: "/de/erosion-rechner", description: "Bodenerosion." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
  { name: "Stickgarn-Rechner", url: "/de/stickgarn-rechner", description: "Stickgarnbedarf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Epoxidharz-Rechner" lang="de" enSlug="epoxy-calculator" keywords="epoxidharz rechner, harz h\u00e4rter verh\u00e4ltnis, epoxid abdeckung, topfzeit, epoxid mischung" breadcrumbs={[{ name: "Epoxidharz-Rechner", url: "/de/epoxidharz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Epoxidharz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Harz/H&auml;rter-Mengen, Abdeckungsfl&auml;che und Topfzeit f&uuml;r Epoxidharz-Projekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fl&auml;chenl&auml;nge (cm)</label><input type="number" id="epde-len" class="epde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fl&auml;chenbreite (cm)</label><input type="number" id="epde-wid" class="epde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschte Dicke (mm)</label><input type="number" id="epde-thk" class="epde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0.5" step="0.5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mischverh&auml;ltnis (Harz:H&auml;rter)</label>
            <select id="epde-ratio" class="epde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1" selected>1:1</option>
              <option value="2">2:1</option>
              <option value="3">3:1</option>
              <option value="4">4:1</option>
              <option value="5">5:1</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Schichten</label><input type="number" id="epde-coats" class="epde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="10" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Temperatur (&deg;C)</label><input type="number" id="epde-temp" class="epde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="22" min="5" max="50" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Verschnitt-Faktor (%)</label><input type="number" id="epde-waste" class="epde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="50" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtmenge Epoxidharz</div>
          <div class="text-4xl font-extrabold font-mono" id="epde-result">0 ml</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Harz ben&ouml;tigt</div><div class="text-xl font-bold font-mono" id="epde-resin">0 ml</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">H&auml;rter ben&ouml;tigt</div><div class="text-xl font-bold font-mono" id="epde-hard">0 ml</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fl&auml;che</div><div class="text-xl font-bold font-mono" id="epde-area">0 m&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Topfzeit</div><div class="text-xl font-bold font-mono" id="epde-pot">0 Min.</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aush&auml;rtezeit</div><div class="text-xl font-bold font-mono" id="epde-cure">0 Std.</div></div>
        </div>
      </div>
      <ShareButton calculatorId="epoxy-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Epoxidharz richtig mischen</h2>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was passiert bei falschem Mischverh&auml;ltnis?</strong> Zu viel oder zu wenig H&auml;rter f&uuml;hrt zu unvollst&auml;ndiger Aush&auml;rtung, klebriger Oberfl&auml;che oder Verbr&uuml;hung.</p>
      <p><strong>Wie beeinflusst Temperatur die Topfzeit?</strong> H&ouml;here Temperaturen verk&uuml;rzen die Topfzeit erheblich. Pro 10&deg;C Erh&ouml;hung halbiert sich die Topfzeit etwa.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcEPDE() {
      const len = parseFloat((document.getElementById('epde-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('epde-wid') as HTMLInputElement).value) || 0;
      const thk = parseFloat((document.getElementById('epde-thk') as HTMLInputElement).value) || 3;
      const ratio = parseFloat((document.getElementById('epde-ratio') as HTMLSelectElement).value) || 1;
      const coats = parseInt((document.getElementById('epde-coats') as HTMLInputElement).value) || 1;
      const temp = parseFloat((document.getElementById('epde-temp') as HTMLInputElement).value) || 22;
      const waste = parseFloat((document.getElementById('epde-waste') as HTMLInputElement).value) || 10;

      const areaCm2 = len * wid;
      const areaM2 = areaCm2 / 10000;
      const volumeCm3 = areaCm2 * (thk / 10) * coats;
      const totalMl = volumeCm3 * (1 + waste / 100);

      const resinPart = ratio / (ratio + 1);
      const hardenerPart = 1 / (ratio + 1);
      const resinMl = totalMl * resinPart;
      const hardenerMl = totalMl * hardenerPart;

      const tempDiffC = temp - 22;
      const potLifeMin = 45 * Math.pow(0.5, tempDiffC / 10);
      const cureHrs = 24 * Math.pow(0.5, tempDiffC / 10);

      document.getElementById('epde-result')!.textContent = Math.round(totalMl) + ' ml';
      document.getElementById('epde-resin')!.textContent = Math.round(resinMl) + ' ml';
      document.getElementById('epde-hard')!.textContent = Math.round(hardenerMl) + ' ml';
      document.getElementById('epde-area')!.textContent = areaM2.toFixed(2) + ' m\u00B2';
      document.getElementById('epde-pot')!.textContent = Math.round(potLifeMin) + ' Min.';
      document.getElementById('epde-cure')!.textContent = cureHrs.toFixed(0) + ' Std.';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.epde-in').forEach(el => { el.addEventListener('input', calcEPDE); el.addEventListener('change', calcEPDE); });
      calcEPDE();
    }, 50);
  </script>
</CalculatorLayout>
