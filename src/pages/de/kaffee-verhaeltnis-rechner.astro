---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kaffee-Verhältnis-Rechner - Perfekte Brühstärke";
const description = "Berechnen Sie das perfekte Kaffee-Wasser-Verhältnis. Geben Sie die gewünschte Tassenzahl und Stärke ein und erhalten Sie Gramm Kaffee, Milliliter Wasser und Löffelmengen.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Bruchrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kaffee-Verhältnis-Rechner" enSlug="coffee-ratio-calculator" keywords="Kaffee Verhältnis, Kaffee Wasser Verhältnis, Kaffeezubereitung, Gramm Kaffee, Brühstärke, Kaffee Dosierung" breadcrumbs={[{ name: "Kaffee-Verhältnis-Rechner", url: "/de/kaffee-verhaeltnis-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kaffee-Verhältnis-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das perfekte Kaffee-Wasser-Verhältnis für Ihre bevorzugte Brühstärke.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewünschte Tassen</label>
            <input type="number" id="kv-cups" class="kv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tassengröße (ml)</label>
            <select id="kv-size" class="kv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="125">Espressotasse (125 ml)</option>
              <option value="200" selected>Standard (200 ml)</option>
              <option value="300">Groß (300 ml)</option>
              <option value="400">Becher (400 ml)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Brühstärke (Kaffee:Wasser)</label>
          <select id="kv-strength" class="kv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="18">Leicht (1:18)</option>
            <option value="17">Mittel-Leicht (1:17)</option>
            <option value="16" selected>Mittel / Gold-Standard (1:16)</option>
            <option value="15">Stark (1:15)</option>
            <option value="14">Extra Stark (1:14)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Zubereitungsart</label>
          <select id="kv-method" class="kv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="pourover">Handfilter / Filterkaffee</option>
            <option value="french">French Press</option>
            <option value="aeropress">AeroPress</option>
            <option value="espresso">Espresso</option>
            <option value="coldbrew">Cold Brew</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigter Kaffee</div>
          <div class="text-5xl font-extrabold font-mono" id="kv-result">0 g</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser</div><div class="text-xl font-bold font-mono" id="kv-water">0 ml</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Messlöffel</div><div class="text-xl font-bold font-mono" id="kv-tbsp">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser (dl)</div><div class="text-xl font-bold font-mono" id="kv-dl">0 dl</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Brühzeit</div><div class="text-xl font-bold font-mono" id="kv-time">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mahlgrad</div><div class="text-xl font-bold font-mono" id="kv-grind">-</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kaffee-verhaeltnis" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das perfekte Kaffee-Verhältnis</h2>
      <p>Das Standardverhältnis der Specialty Coffee Association ist 1:16 (1g Kaffee auf 16ml Wasser). Je nach Geschmack kann man stärker (1:14) oder milder (1:18) dosieren.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Kaffee pro Tasse?</strong> Für eine Standardtasse (200ml) bei mittlerer Stärke benötigen Sie ca. 12,5g Kaffee.</p>
      <p><strong>Was bedeutet die "Goldene Ratio"?</strong> 1:16 gilt als ideales Verhältnis für ausgewogenen Geschmack ohne Bitterkeit.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKV() {
      const cups = parseFloat((document.getElementById('kv-cups') as HTMLInputElement).value) || 1;
      const cupSize = parseFloat((document.getElementById('kv-size') as HTMLSelectElement).value) || 200;
      const ratio = parseFloat((document.getElementById('kv-strength') as HTMLSelectElement).value) || 16;
      const method = (document.getElementById('kv-method') as HTMLSelectElement).value;
      const totalWaterMl = cups * cupSize;
      let coffeeGrams = totalWaterMl / ratio;
      let brewTime = '';
      let grindSize = '';
      if (method === 'espresso') {
        coffeeGrams = cups * 18;
        brewTime = '25-30 Sek.';
        grindSize = 'Extrafein';
      } else if (method === 'french') {
        brewTime = '4 Min.';
        grindSize = 'Grob';
      } else if (method === 'pourover') {
        brewTime = '3-4 Min.';
        grindSize = 'Mittel-Fein';
      } else if (method === 'aeropress') {
        brewTime = '1-2 Min.';
        grindSize = 'Fein-Mittel';
      } else if (method === 'coldbrew') {
        coffeeGrams = totalWaterMl / 8;
        brewTime = '12-24 Std.';
        grindSize = 'Extra Grob';
      }
      const tbsp = coffeeGrams / 7; // 1 gehäufter Kaffeelöffel ≈ 7g
      const dl = totalWaterMl / 100;
      document.getElementById('kv-result')!.textContent = coffeeGrams.toFixed(1) + ' g';
      document.getElementById('kv-water')!.textContent = Math.round(totalWaterMl) + ' ml';
      document.getElementById('kv-tbsp')!.textContent = tbsp.toFixed(1) + ' Löffel';
      document.getElementById('kv-dl')!.textContent = dl.toFixed(1) + ' dl';
      document.getElementById('kv-time')!.textContent = brewTime;
      document.getElementById('kv-grind')!.textContent = grindSize;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kv-in').forEach(el => { el.addEventListener('input', calcKV); el.addEventListener('change', calcKV); });
      calcKV();
    }, 50);
  </script>
</CalculatorLayout>
