---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Devisenkurs-Rechner - Manuelle Wechselkursumrechnung";
const description = "Rechnen Sie Waehrungen mit manuellem Wechselkurs um. Sehen Sie umgerechnete Betraege, Umkehrkurse und Gebuehren.";
const relatedCalcs = [
  { name: "Waehrungsrechner", url: "/de/waehrungsrechner", description: "Waehrungsumrechnung." },
  { name: "Krypto-Gewinn-Rechner", url: "/de/krypto-gewinn-rechner", description: "Krypto-Gewinne." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Gewinnmargenrechner", url: "/de/gewinnmargenrechner", description: "Gewinnmargen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Devisenkurs-Rechner" keywords="Devisenkurs Rechner, Wechselkurs, Forex Rechner, Waehrungsumrechnung, Umkehrkurs" breadcrumbs={[{ name: "Devisenkurs-Rechner", url: "/de/devisenkurs-rechner" }]} lang="de" enSlug="currency-exchange-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Devisenkurs-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie Waehrungen mit einem manuellen Wechselkurs um.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Betrag</label><input type="number" id="dvr-amount" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1000" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Ausgangswaehrung</label><input type="text" id="dvr-from" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="EUR"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Zielwaehrung</label><input type="text" id="dvr-to" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="USD"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Wechselkurs (1 Ausgang = ? Ziel)</label><input type="number" id="dvr-rate" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.09" min="0" step="0.0001"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Gebuehr / Spread (%)</label><input type="number" id="dvr-fee" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="10" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Umgerechneter Betrag</div>
          <div class="text-5xl font-extrabold font-mono" id="dvr-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umkehrkurs</div><div class="text-xl font-bold font-mono" id="dvr-inverse">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gebuehrenbetrag</div><div class="text-xl font-bold font-mono" id="dvr-feeamt">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effektiver Kurs</div><div class="text-xl font-bold font-mono" id="dvr-effective">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Betrag vor Gebuehr</div><div class="text-xl font-bold font-mono" id="dvr-before">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="currency-exchange" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Devisenkurse verstehen</h2>
      <p>Bei jeder Waehrungsumrechnung faellt typischerweise ein Spread oder eine Gebuehr an. Der effektive Kurs nach Abzug der Gebuehr zeigt Ihnen, wie viel Sie tatsaechlich erhalten. Vergleichen Sie immer mehrere Anbieter fuer die besten Konditionen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcDVR() {
      const amount = parseFloat((document.getElementById('dvr-amount') as HTMLInputElement).value) || 0;
      const fromCur = (document.getElementById('dvr-from') as HTMLInputElement).value || 'VON';
      const toCur = (document.getElementById('dvr-to') as HTMLInputElement).value || 'NACH';
      const rate = parseFloat((document.getElementById('dvr-rate') as HTMLInputElement).value) || 0;
      const feePct = parseFloat((document.getElementById('dvr-fee') as HTMLInputElement).value) || 0;

      const convertedBefore = amount * rate;
      const feeAmount = convertedBefore * (feePct / 100);
      const converted = convertedBefore - feeAmount;
      const effectiveRate = amount > 0 ? converted / amount : 0;
      const inverseRate = rate > 0 ? 1 / rate : 0;

      document.getElementById('dvr-result')!.textContent = converted.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + toCur;
      document.getElementById('dvr-inverse')!.textContent = '1 ' + toCur + ' = ' + inverseRate.toFixed(4).replace('.', ',') + ' ' + fromCur;
      document.getElementById('dvr-feeamt')!.textContent = feeAmount.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + toCur;
      document.getElementById('dvr-effective')!.textContent = effectiveRate.toFixed(4).replace('.', ',');
      document.getElementById('dvr-before')!.textContent = convertedBefore.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + toCur;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dvr-in').forEach(el => { el.addEventListener('input', calcDVR); el.addEventListener('change', calcDVR); });
      calcDVR();
    }, 50);
  </script>
</CalculatorLayout>
