---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Hurrikan-Kategorie-Rechner - Saffir-Simpson-Skala";
const description = "Bestimmen Sie die Saffir-Simpson-Hurrikan-Kategorie anhand der Windgeschwindigkeit mit Sturmflutschätzungen, Schadenspotenzial und Sicherheitshinweisen.";
const relatedCalcs = [
  { name: "Tornado-Skala-Rechner", url: "/tornado-scale-calculator", description: "EF-Tornado-Skala." },
  { name: "Windgeschwindigkeit-Umrechner", url: "/wind-speed-converter", description: "Windgeschwindigkeitseinheiten." },
  { name: "Windchill-Rechner", url: "/wind-chill-calculator", description: "Windkühlfaktor." },
  { name: "Luftdruckrechner", url: "/barometric-pressure-calculator", description: "Druckmessungen." },
  { name: "Blitzentfernung-Rechner", url: "/lightning-distance-calculator", description: "Blitzentfernung." },
  { name: "Regenintensitäts-Rechner", url: "/rainfall-intensity-calculator", description: "Niederschlagsraten." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist die Saffir-Simpson-Skala?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Saffir-Simpson-Skala klassifiziert Hurrikane in 5 Kategorien basierend auf der anhaltenden Windgeschwindigkeit. Kategorie 1 beginnt bei 119 km/h, Kategorie 5 übersteigt 252 km/h." }
    },
    {
      "@type": "Question",
      "name": "Ab welcher Windgeschwindigkeit wird ein Sturm zum Hurrikan?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ein tropischer Sturm wird zum Hurrikan (Kategorie 1), wenn die anhaltenden Windgeschwindigkeiten 119 km/h (74 mph bzw. 64 Knoten) überschreiten." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Hurrikan-Kategorie-Rechner" lang="de" keywords="hurrikan kategorie rechner, saffir-simpson skala, hurrikan windgeschwindigkeit, sturmflut, hurrikanschäden" breadcrumbs={[{ name: "Hurrikan-Kategorie-Rechner", url: "/de/hurrikan-kategorie-rechner" }]} enSlug="hurricane-category-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hurrikan-Kategorie-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die Saffir-Simpson-Hurrikan-Kategorie anhand der anhaltenden Windgeschwindigkeit mit Schadens- und Sturmflutschätzungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anhaltende Windgeschwindigkeit</label><input type="number" id="hk-wind" class="hk-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="120" min="0" step="5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="hk-unit" class="hk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="kmh" selected>km/h</option>
              <option value="mph">mph</option>
              <option value="kn">Knoten</option>
              <option value="ms">m/s</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Hurrikan-Kategorie</div>
          <div class="text-5xl font-extrabold font-mono" id="hk-result">--</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="hk-dmg-box">
          <div class="font-bold text-sm" id="hk-dmg">--</div>
          <div class="text-xs mt-1" id="hk-desc">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wind (mph)</div><div class="text-xl font-bold font-mono" id="hk-mph">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wind (Knoten)</div><div class="text-xl font-bold font-mono" id="hk-kn">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wind (km/h)</div><div class="text-xl font-bold font-mono" id="hk-kmh">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sturmflut</div><div class="text-xl font-bold font-mono" id="hk-surge">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kerndruck</div><div class="text-xl font-bold font-mono" id="hk-pres">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="hurrikan-kategorie" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die Saffir-Simpson-Hurrikanskala verstehen</h2>
      <p>Die Saffir-Simpson-Skala klassifiziert Hurrikane in 5 Kategorien basierend auf der anhaltenden Windgeschwindigkeit. Sie gibt Auskunft über das Schadenspotenzial und hilft bei Evakuierungsentscheidungen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Was ist die Saffir-Simpson-Skala?</h4>
      <p>Die Saffir-Simpson-Skala klassifiziert Hurrikane in 5 Kategorien basierend auf der anhaltenden Windgeschwindigkeit. Kategorie 1 beginnt bei 119 km/h, Kategorie 5 übersteigt 252 km/h.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Ab welcher Windgeschwindigkeit wird ein Sturm zum Hurrikan?</h4>
      <p>Ein tropischer Sturm wird zum Hurrikan (Kategorie 1), wenn die anhaltenden Windgeschwindigkeiten 119 km/h überschreiten.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcHK() {
      const wind = parseFloat((document.getElementById('hk-wind') as HTMLInputElement).value) || 120;
      const unit = (document.getElementById('hk-unit') as HTMLSelectElement).value;
      let mph: number;
      if (unit === 'kn') mph = wind * 1.15078;
      else if (unit === 'kmh') mph = wind * 0.621371;
      else if (unit === 'ms') mph = wind * 2.23694;
      else mph = wind;
      const kn = mph / 1.15078;
      const kmh = mph * 1.60934;
      document.getElementById('hk-mph')!.textContent = mph.toFixed(0);
      document.getElementById('hk-kn')!.textContent = kn.toFixed(0);
      document.getElementById('hk-kmh')!.textContent = kmh.toFixed(0);
      const cats = [
        { cat: 'Tropische Depression', min: 0, max: 38, dmg: 'Minimal', desc: 'Unorganisiertes System mit Windgeschwindigkeiten unter 63 km/h', surge: 'N/A', pres: '> 1009 mb', color: 'bg-blue-50 text-blue-800' },
        { cat: 'Tropischer Sturm', min: 39, max: 73, dmg: 'Gering bis mittel', desc: 'Benannter Sturm, starke Winde und starker Regen möglich', surge: '0-1 m', pres: '1000-1009 mb', color: 'bg-green-50 text-green-800' },
        { cat: 'Kategorie 1', min: 74, max: 95, dmg: 'Minimaler Hurrikan', desc: 'Dachschäden, Stromausfälle, einige Überschwemmungen', surge: '1-2 m', pres: '980-994 mb', color: 'bg-yellow-50 text-yellow-800' },
        { cat: 'Kategorie 2', min: 96, max: 110, dmg: 'Moderater Hurrikan', desc: 'Schwere Dach- und Fassadenschäden, umgestürzte Bäume', surge: '2-2.5 m', pres: '965-979 mb', color: 'bg-orange-50 text-orange-800' },
        { cat: 'Kategorie 3', min: 111, max: 129, dmg: 'Großer Hurrikan', desc: 'Verheerende Schäden, tagelanger Strom-/Wasserausfall', surge: '3-4 m', pres: '945-964 mb', color: 'bg-orange-100 text-orange-900' },
        { cat: 'Kategorie 4', min: 130, max: 156, dmg: 'Großer Hurrikan', desc: 'Katastrophale Schäden, Gebiete wochenlang unbewohnbar', surge: '4-6 m', pres: '920-944 mb', color: 'bg-red-50 text-red-800' },
        { cat: 'Kategorie 5', min: 157, max: 9999, dmg: 'Katastrophaler Hurrikan', desc: 'Totales Dachversagen, massive Zerstörung, vollständige Verwüstung', surge: '6+ m', pres: '< 920 mb', color: 'bg-red-100 text-red-900' },
      ];
      let c = cats[0];
      for (const ct of cats) { if (mph >= ct.min && mph <= ct.max) { c = ct; break; } }
      document.getElementById('hk-result')!.textContent = c.cat;
      document.getElementById('hk-dmg')!.textContent = c.dmg;
      document.getElementById('hk-desc')!.textContent = c.desc;
      document.getElementById('hk-dmg-box')!.className = 'p-4 rounded-xl text-center ' + c.color;
      document.getElementById('hk-surge')!.textContent = c.surge;
      document.getElementById('hk-pres')!.textContent = c.pres;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.hk-in').forEach(el => { el.addEventListener('input', calcHK); el.addEventListener('change', calcHK); }); calcHK(); }, 50);
  </script>
</CalculatorLayout>
