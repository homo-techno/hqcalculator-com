---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fliesengewicht-Rechner - Bodenlast pro Quadratmeter";
const description = "Berechnen Sie das Gewicht von Keramik- und Porzellanfliesen pro Quadratmeter fuer Bodenbelastungsberechnungen. Inkl. Fliesenkleber und Fugenmoertel.";
const relatedCalcs = [
  { name: "Keramikform-Rechner", url: "/de/keramikform-rechner", description: "Gipsformen." },
  { name: "Keramikfaser-Rechner", url: "/de/keramikfaser-rechner", description: "Ofenisolierung." },
  { name: "Keramikanalyse-Rechner", url: "/de/keramikanalyse-rechner", description: "Scherbenanalyse." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
  { name: "Kaelteanlage-Rechner", url: "/de/kaelteanlage-rechner", description: "Kaelteanlagen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Fliesengewicht-Rechner" enSlug="ceramic-tile-weight-calculator" keywords="Fliesengewicht, Keramikfliese Gewicht, Porzellanfliese Gewicht, Bodenlast, Fliesengewicht Rechner" breadcrumbs={[{ name: "Fliesengewicht-Rechner", url: "/de/fliesengewicht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fliesengewicht-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das installierte Gesamtgewicht von Fliesen pro Quadratmeter inkl. Fliesenkleber und Fugenmoertel fuer die Tragwerksplanung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Fliesentyp</label>
        <select id="fg-type" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="ceramic" selected>Keramik</option>
          <option value="porcelain">Porzellan / Feinsteinzeug</option>
          <option value="natural_stone">Naturstein (Marmor/Granit)</option>
          <option value="glass_tile">Glasfliese</option>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-5">
        <div><label class="block text-sm font-medium text-text mb-2">Fliesenlaenge (cm)</label><input type="number" id="fg-length" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-2">Fliesenbreite (cm)</label><input type="number" id="fg-width" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1"></div>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Fliesendicke (mm)</label>
        <input type="number" id="fg-thick" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="3" max="25" step="0.5">
      </div>
      <div class="grid grid-cols-2 gap-4 mb-5">
        <div><label class="block text-sm font-medium text-text mb-2">Gesamtflaeche (m²)</label><input type="number" id="fg-area" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0.1" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-2">Kleberdicke (mm)</label><input type="number" id="fg-thinset" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="2" max="12" step="1"></div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Installiertes Gesamtgewicht</div>
        <div class="text-4xl font-extrabold" id="fg-total">--</div>
        <div class="text-sm text-blue-200 mt-1">fuer die gesamte Flaeche</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewicht pro m²</div><div class="text-xl font-bold" id="fg-psm">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fliesen benoetigt</div><div class="text-xl font-bold" id="fg-count">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nur Fliesengewicht</div><div class="text-xl font-bold" id="fg-tile-only">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kleber + Fuge</div><div class="text-xl font-bold" id="fg-mortar">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl text-center mb-4">
        <div class="text-xs text-text-muted uppercase">Gewicht pro Einzelfliese</div>
        <div class="text-xl font-bold" id="fg-single">--</div>
      </div>
      <ShareButton lang="de" calculatorId="fliesengewicht" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Fliesengewicht fuer Bodenbelastung</h2>
      <p>Die Kenntnis des Gesamtgewichts einer Flieseninstallation ist entscheidend fuer die Tragwerksplanung, insbesondere bei aufgestaenderten Boeden, Arbeitsplatten und Wandanwendungen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Typische Fliesengewichte</h3>
      <ul>
        <li><strong>Keramikfliese:</strong> ~18 kg/m² bei 8 mm Standarddicke</li>
        <li><strong>Feinsteinzeug:</strong> ~22 kg/m² bei 8 mm Standarddicke</li>
        <li><strong>Naturstein:</strong> ~27-35 kg/m² je nach Steinart</li>
        <li><strong>Glasfliese:</strong> ~15-18 kg/m² bei Standard-Mosaikdicke</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFG() {
      const type = (document.getElementById('fg-type') as HTMLSelectElement).value;
      const tileL = parseFloat((document.getElementById('fg-length') as HTMLInputElement).value) || 30;
      const tileW = parseFloat((document.getElementById('fg-width') as HTMLInputElement).value) || 30;
      const thickMM = parseFloat((document.getElementById('fg-thick') as HTMLInputElement).value) || 8;
      const area = parseFloat((document.getElementById('fg-area') as HTMLInputElement).value) || 10;
      const thinsetMM = parseFloat((document.getElementById('fg-thinset') as HTMLInputElement).value) || 5;
      // Density in g/cm³
      const densities: Record<string, number> = { ceramic: 2.0, porcelain: 2.4, natural_stone: 2.7, glass_tile: 2.5 };
      const density = densities[type] || 2.0;
      const thickCm = thickMM / 10;
      // Single tile weight (g)
      const tileVolCm3 = tileL * tileW * thickCm;
      const singleTileWeight = tileVolCm3 * density; // grams
      // Tiles per m²
      const tileAreaCm2 = tileL * tileW;
      const tilesPerM2 = 10000 / tileAreaCm2;
      const tileWeightPerM2 = (singleTileWeight * tilesPerM2) / 1000; // kg/m²
      // Thinset weight per m² (~1.8 g/cm³ density)
      const thinsetWeightPerM2 = (thinsetMM / 10) * 10000 * 1.8 / 1000; // kg/m²
      // Grout weight approx 4.5 kg/m²
      const groutWeightPerM2 = 4.5;
      const totalPerM2 = tileWeightPerM2 + thinsetWeightPerM2 + groutWeightPerM2;
      const totalWeight = totalPerM2 * area;
      const tileCount = Math.ceil(area * tilesPerM2 * 1.1);
      document.getElementById('fg-total')!.textContent = Math.round(totalWeight).toLocaleString('de-DE') + ' kg';
      document.getElementById('fg-psm')!.textContent = totalPerM2.toFixed(1) + ' kg/m\u00B2';
      document.getElementById('fg-count')!.textContent = tileCount + ' Fliesen';
      document.getElementById('fg-tile-only')!.textContent = (tileWeightPerM2 * area).toFixed(0) + ' kg';
      document.getElementById('fg-mortar')!.textContent = ((thinsetWeightPerM2 + groutWeightPerM2) * area).toFixed(0) + ' kg';
      document.getElementById('fg-single')!.textContent = (singleTileWeight / 1000).toFixed(2) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fg-in').forEach(el => { el.addEventListener('input', calcFG); el.addEventListener('change', calcFG); });
      calcFG();
    }, 50);
  </script>
</CalculatorLayout>
