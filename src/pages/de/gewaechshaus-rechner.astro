---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gew&auml;chshaus-Rechner - Heizleistung & Kostensch&auml;tzung";
const description = "Berechnen Sie den Heizbedarf Ihres Gew&auml;chshauses inkl. kW-Bedarf, Heizger&auml;tegr&ouml;&szlig;e und gesch&auml;tzte Heizkosten basierend auf Ma&szlig;en und D&auml;mmung.";
const relatedCalcs = [
  { name: "Wachstumsgradtage-Rechner", url: "/de/wachstumsgradtage-rechner", description: "W&auml;rmeeinheiten." },
  { name: "D&uuml;nger-Rechner", url: "/de/duenger-rechner", description: "D&uuml;ngebedarf." },
  { name: "Bew&auml;sserungsrechner", url: "/de/bewaesserungsrechner", description: "Bew&auml;sserungsplanung." },
  { name: "Kompost-Rechner", url: "/de/kompost-rechner", description: "Kompostverh&auml;ltnis." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gew&auml;chshaus-Rechner" lang="de" enSlug="greenhouse-calculator" keywords="gew&auml;chshaus rechner, gew&auml;chshaus heizung, heizleistung berechnen, heizkosten gew&auml;chshaus, u-wert" breadcrumbs={[{ name: "Gew&auml;chshaus-Rechner", url: "/de/gewaechshaus-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gew&auml;chshaus-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Heizbedarf, die Heizger&auml;tegr&ouml;&szlig;e und die gesch&auml;tzten Kosten f&uuml;r Ihr Gew&auml;chshaus.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">L&auml;nge (m)</label><input type="number" id="ghde-length" class="ghde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (m)</label><input type="number" id="ghde-width" class="ghde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">H&ouml;he (m)</label><input type="number" id="ghde-height" class="ghde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">U-Wert (W/m&sup2;K)</label>
            <select id="ghde-uval" class="ghde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="6.8">Einfachglas (6,8)</option>
              <option value="3.5" selected>Doppelglas (3,5)</option>
              <option value="3.0">Polycarbonat (3,0)</option>
              <option value="2.5">Doppel-Polycarbonat (2,5)</option>
              <option value="6.4">Polyethylen-Folie (6,4)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Au&szlig;entemp. (&deg;C)</label><input type="number" id="ghde-outdoor" class="ghde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="-5" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wunschtemp. (&deg;C)</label><input type="number" id="ghde-desired" class="ghde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Energiekosten (&euro;/kWh)</label>
          <input type="number" id="ghde-ecost" class="ghde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.35" min="0" step="0.01">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Heizleistung</div>
          <div class="text-5xl font-extrabold font-mono" id="ghde-result">0 W</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Heizger&auml;t</div><div class="text-xl font-bold font-mono" id="ghde-heater">0 kW</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Oberfl&auml;che</div><div class="text-xl font-bold font-mono" id="ghde-surface">0 m&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Temp.-Diff.</div><div class="text-xl font-bold font-mono" id="ghde-diff">0&deg;C</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Kosten / Nacht (12h)</div><div class="text-xl font-bold font-mono" id="ghde-nightcost">0,00 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Monatskosten</div><div class="text-xl font-bold font-mono" id="ghde-monthcost">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="greenhouse-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gew&auml;chshaus-Heizung berechnen</h2>
      <p>Die ben&ouml;tigte Heizleistung ergibt sich aus der Oberfl&auml;che, der Temperaturdifferenz und dem U-Wert der Verglasung. Ein Sicherheitsfaktor von 10 % wird hinzugerechnet.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welcher U-Wert ist der beste?</strong> Doppel-Polycarbonat (U-Wert 2,5) bietet die beste D&auml;mmung, Einfachglas (6,8) die schlechteste.</p>
      <p><strong>Wie senke ich die Heizkosten?</strong> Bessere D&auml;mmung, Doppelverglasung und Luftpolsterfolie an den W&auml;nden reduzieren den W&auml;rmeverlust erheblich.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGHDE() {
      const length = parseFloat((document.getElementById('ghde-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('ghde-width') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('ghde-height') as HTMLInputElement).value) || 0;
      const uVal = parseFloat((document.getElementById('ghde-uval') as HTMLSelectElement).value) || 3.5;
      const outdoor = parseFloat((document.getElementById('ghde-outdoor') as HTMLInputElement).value) || 0;
      const desired = parseFloat((document.getElementById('ghde-desired') as HTMLInputElement).value) || 0;
      const eCost = parseFloat((document.getElementById('ghde-ecost') as HTMLInputElement).value) || 0;

      const wallArea = 2 * (length * height) + 2 * (width * height);
      const roofArea = length * width;
      const totalSurface = wallArea + roofArea;
      const tempDiff = desired - outdoor;
      const wattsNeeded = totalSurface * uVal * tempDiff * 1.1;
      const kw = wattsNeeded / 1000;

      const heaterSizes = [1, 1.5, 2, 3, 4, 5, 6, 8, 10, 15, 20];
      let heater = heaterSizes[heaterSizes.length - 1];
      for (const s of heaterSizes) {
        if (s >= kw) { heater = s; break; }
      }

      const nightCost = (kw * 12) * eCost;
      const monthCost = nightCost * 30;

      document.getElementById('ghde-result')!.textContent = Math.round(wattsNeeded).toLocaleString('de-DE') + ' W';
      document.getElementById('ghde-heater')!.textContent = heater.toLocaleString('de-DE') + ' kW';
      document.getElementById('ghde-surface')!.textContent = Math.round(totalSurface).toLocaleString('de-DE') + ' m\u00B2';
      document.getElementById('ghde-diff')!.textContent = tempDiff.toLocaleString('de-DE') + '\u00B0C';
      document.getElementById('ghde-nightcost')!.textContent = nightCost.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('ghde-monthcost')!.textContent = Math.round(monthCost).toLocaleString('de-DE') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ghde-in').forEach(el => { el.addEventListener('input', calcGHDE); el.addEventListener('change', calcGHDE); });
      calcGHDE();
    }, 50);
  </script>
</CalculatorLayout>
