---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SliderInput from '../../components/SliderInput.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hypothekenrechner - Kostenloser Monatsratenrechner 2026";
const description = "Berechne deine monatliche Hypothekenrate sofort mit unserem kostenlosen Rechner. Inklusive Tilgungsplan, Steuern, Versicherung und Zinsaufschlüsselung.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie wird eine monatliche Hypothekenrate berechnet?",
      "acceptedAnswer": { "@type": "Answer", "text": "Monatliche Rate = P[r(1+r)^n]/[(1+r)^n-1], wobei P der Darlehensbetrag, r der monatliche Zinssatz und n die Anzahl der Zahlungen ist. Bei einem Darlehen von 400.000 € zu 3,5 % über 25 Jahre beträgt die Rate ca. 2.001 €." }
    },
    {
      "@type": "Question",
      "name": "Wie viel Immobilie kann ich mir leisten?",
      "acceptedAnswer": { "@type": "Answer", "text": "Eine Faustregel: Die monatliche Rate sollte maximal 35 % des Nettoeinkommens betragen. Bei 4.000 € netto wären das ca. 1.400 €/Monat für die Hypothek." }
    }
  ]
};

const relatedCalcs = [
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten und Tilgung berechnen." },
  { name: "Autofinanzierungsrechner", url: "/de/autofinanzierungsrechner", description: "Autokredit berechnen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins-Wachstum berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Kapitalwachstum berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Hypothekenrechner"
  keywords="Hypothekenrechner, Baufinanzierung, Hypothekenrate, Tilgungsplan, Immobilienkredit, Monatsrate"
  breadcrumbs={[{ name: "Hypothekenrechner", url: "/de/hypothekenrechner" }]}
  lang="de"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hypothekenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne deine monatliche Hypothekenrate inklusive Nebenkosten. Sieh den vollständigen Tilgungsplan.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm overflow-hidden">
      <div class="p-6 sm:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
          <div class="lg:col-span-3">
            <SliderInput id="home-price" label="Kaufpreis" min={50000} max={2000000} step={5000} value={400000} suffix=" €" tooltip="Gesamtkaufpreis der Immobilie" />
            <SliderInput id="down-payment" label="Eigenkapital" min={0} max={100} step={1} value={20} suffix="%" tooltip="Anteil des Kaufpreises als Eigenkapital" />
            <div class="p-3 bg-surface-alt rounded-lg text-sm text-text-secondary mb-5" id="dp-amount">Eigenkapital: 80.000 € | Darlehen: 320.000 €</div>
            <SliderInput id="interest-rate" label="Zinssatz" min={1} max={15} step={0.125} value={3.5} suffix="%" tooltip="Jährlicher Sollzinssatz" />
            <div class="mb-5">
              <label class="block text-sm font-medium text-text mb-2">Laufzeit</label>
              <div class="flex gap-2">
                {[10, 15, 20, 25, 30].map(t => (
                  <button class={`hyp-term-btn flex-1 py-2 text-sm font-medium rounded-lg border transition-all cursor-pointer ${t === 25 ? 'bg-primary text-white border-primary' : 'bg-white text-text-secondary border-border hover:border-primary/30'}`} data-term={t}>
                    {t} J.
                  </button>
                ))}
              </div>
            </div>

            <details class="mt-2">
              <summary class="text-sm font-medium text-primary cursor-pointer hover:underline">Weitere Optionen (Nebenkosten)</summary>
              <div class="mt-4 space-y-0">
                <SliderInput id="property-tax" label="Grundsteuer (jährlich)" min={0} max={10000} step={50} value={1200} suffix=" €" tooltip="Jährliche Grundsteuer" />
                <SliderInput id="home-insurance" label="Gebäudeversicherung (jährlich)" min={0} max={5000} step={50} value={800} suffix=" €" tooltip="Jährliche Gebäudeversicherung" />
                <SliderInput id="hoa" label="Hausgeld (monatlich)" min={0} max={1000} step={25} value={0} suffix=" €" tooltip="Monatliches Hausgeld/Nebenkosten" />
              </div>
            </details>
          </div>

          <div class="lg:col-span-2 space-y-4">
            <div class="p-6 bg-primary rounded-2xl text-white text-center">
              <div class="text-sm font-medium text-blue-200 uppercase tracking-wide mb-1">Monatliche Rate</div>
              <div class="text-4xl sm:text-5xl font-extrabold" id="monthly-payment">0 €</div>
            </div>

            <div class="space-y-3 p-4 bg-surface-alt rounded-xl">
              <div class="flex justify-between text-sm">
                <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>Tilgung & Zinsen</span>
                <span class="font-semibold" id="pi-amount">0 €</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>Grundsteuer</span>
                <span class="font-semibold" id="tax-amount">0 €</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>Versicherung</span>
                <span class="font-semibold" id="ins-amount">0 €</span>
              </div>
              <div class="flex justify-between text-sm" id="hoa-row">
                <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-purple-500 inline-block"></span>Hausgeld</span>
                <span class="font-semibold" id="hoa-amount">0 €</span>
              </div>
              <div class="border-t border-border pt-2 flex justify-between text-sm font-bold">
                <span>Gesamt monatlich</span>
                <span id="total-monthly">0 €</span>
              </div>
            </div>

            <div class="chart-container p-4 bg-surface-alt rounded-xl">
              <canvas id="donut-chart" width="250" height="250"></canvas>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="p-3 bg-surface-alt rounded-xl text-center">
                <div class="text-xs text-text-muted uppercase">Gesamtzinsen</div>
                <div class="text-lg font-bold text-danger" id="total-interest">0 €</div>
              </div>
              <div class="p-3 bg-surface-alt rounded-xl text-center">
                <div class="text-xs text-text-muted uppercase">Gesamtkosten</div>
                <div class="text-lg font-bold" id="total-cost">0 €</div>
              </div>
              <div class="p-3 bg-surface-alt rounded-xl text-center">
                <div class="text-xs text-text-muted uppercase">Tilgungsende</div>
                <div class="text-lg font-bold" id="payoff-date">—</div>
              </div>
              <div class="p-3 bg-surface-alt rounded-xl text-center">
                <div class="text-xs text-text-muted uppercase">Darlehensbetrag</div>
                <div class="text-lg font-bold" id="loan-amount">0 €</div>
              </div>
            </div>
          </div>
        </div>

        <ShareButton calculatorId="mortgage" lang="de" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold text-text">Tilgungsplan</h2>
        <div class="flex gap-2">
          <button id="view-yearly" class="px-3 py-1.5 text-xs font-medium bg-primary text-white rounded-lg cursor-pointer">Jährlich</button>
          <button id="view-monthly" class="px-3 py-1.5 text-xs font-medium bg-surface-alt text-text-secondary rounded-lg cursor-pointer">Monatlich</button>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="amort-table">
          <thead>
            <tr class="border-b border-border text-left">
              <th class="py-2 pr-3 font-semibold">Jahr</th>
              <th class="py-2 pr-3 font-semibold text-right">Zahlung</th>
              <th class="py-2 pr-3 font-semibold text-right">Tilgung</th>
              <th class="py-2 pr-3 font-semibold text-right">Zinsen</th>
              <th class="py-2 font-semibold text-right">Restschuld</th>
            </tr>
          </thead>
          <tbody id="amort-tbody"></tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie funktioniert ein Hypothekenrechner?</h2>
      <p>Ein Hypothekenrechner hilft dir, deine monatliche Rate auf Basis des Kaufpreises, Eigenkapitals, Zinssatzes und der Laufzeit zu berechnen. Unser Rechner berücksichtigt auch Grundsteuer, Gebäudeversicherung und Hausgeld für ein vollständiges Bild deiner monatlichen Kosten.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Die Tilgungsformel</h3>
      <p>Die monatliche Rate (Tilgung und Zinsen) wird mit der Standard-Annuitätenformel berechnet:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">
        M = P &times; [r(1+r)<sup>n</sup>] / [(1+r)<sup>n</sup> - 1]
      </div>
      <p>Wobei:</p>
      <ul>
        <li><strong>M</strong> = Monatliche Rate (nur Tilgung & Zinsen)</li>
        <li><strong>P</strong> = Darlehensbetrag (Kaufpreis minus Eigenkapital)</li>
        <li><strong>r</strong> = Monatlicher Zinssatz (Jahreszins &divide; 12)</li>
        <li><strong>n</strong> = Gesamtanzahl der Raten (Jahre &times; 12)</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Tipps für eine günstigere Baufinanzierung</h3>
      <ul>
        <li><strong>Eigenkapital aufbauen:</strong> Mindestens 20 % sind empfehlenswert</li>
        <li><strong>Bonität verbessern:</strong> Bessere Schufa = bessere Konditionen</li>
        <li><strong>Angebote vergleichen:</strong> Zinsen können sich zwischen Banken um 0,5 % oder mehr unterscheiden</li>
        <li><strong>Kürzere Laufzeit wählen:</strong> 15-20 Jahre haben oft niedrigere Zinsen als 30 Jahre</li>
        <li><strong>Sondertilgungen vereinbaren:</strong> Reduziert die Gesamtzinskosten erheblich</li>
      </ul>

      <h2 class="text-2xl font-bold text-text mt-12">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Wie wird die monatliche Hypothekenrate berechnet?</h3>
      <p>Die monatliche Rate wird mit der Annuitätenformel berechnet: M = P[r(1+r)^n]/[(1+r)^n-1]. Bei einem Darlehen von 320.000 € zu 3,5 % über 25 Jahre beträgt die Rate ca. 1.601 €/Monat, plus Nebenkosten.</p>

      <h3 class="text-lg font-semibold text-text mt-6">Sollte ich eine kürzere Laufzeit wählen?</h3>
      <p>Eine kürzere Laufzeit bedeutet höhere monatliche Raten, aber deutlich geringere Gesamtzinsen. Bei 15 Jahren statt 30 Jahren kann man oft über 100.000 € an Zinsen sparen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    import Chart from 'chart.js/auto';

    const $ = (id: string) => document.getElementById(id)!;
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' €';
    let loanTerm = 25;
    let donutChart: Chart | null = null;
    let viewMode: 'yearly' | 'monthly' = 'yearly';

    document.querySelectorAll('.hyp-term-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.hyp-term-btn').forEach(b => {
          b.classList.remove('bg-primary', 'text-white', 'border-primary');
          b.classList.add('bg-white', 'text-text-secondary', 'border-border');
        });
        btn.classList.add('bg-primary', 'text-white', 'border-primary');
        btn.classList.remove('bg-white', 'text-text-secondary', 'border-border');
        loanTerm = parseInt((btn as HTMLElement).dataset.term || '25');
        calculate();
      });
    });

    $('view-yearly').addEventListener('click', () => { viewMode = 'yearly'; updateViewBtns(); calculate(); });
    $('view-monthly').addEventListener('click', () => { viewMode = 'monthly'; updateViewBtns(); calculate(); });
    function updateViewBtns() {
      $('view-yearly').className = `px-3 py-1.5 text-xs font-medium rounded-lg cursor-pointer ${viewMode === 'yearly' ? 'bg-primary text-white' : 'bg-surface-alt text-text-secondary'}`;
      $('view-monthly').className = `px-3 py-1.5 text-xs font-medium rounded-lg cursor-pointer ${viewMode === 'monthly' ? 'bg-primary text-white' : 'bg-surface-alt text-text-secondary'}`;
    }

    function getVal(id: string): number {
      const slider = document.getElementById(`${id}-slider`) as HTMLInputElement;
      return parseFloat(slider?.value || '0');
    }

    function calculate() {
      const homePrice = getVal('home-price');
      const downPct = getVal('down-payment');
      const rate = getVal('interest-rate');
      const taxAnnual = getVal('property-tax');
      const insAnnual = getVal('home-insurance');
      const hoaMonthly = getVal('hoa');

      const downPayment = homePrice * downPct / 100;
      const principal = homePrice - downPayment;
      const monthlyRate = rate / 100 / 12;
      const numPayments = loanTerm * 12;

      let pi = 0;
      if (monthlyRate > 0) {
        pi = principal * (monthlyRate * Math.pow(1 + monthlyRate, numPayments)) / (Math.pow(1 + monthlyRate, numPayments) - 1);
      } else {
        pi = principal / numPayments;
      }

      const taxMonthly = taxAnnual / 12;
      const insMonthly = insAnnual / 12;
      const totalMonthly = pi + taxMonthly + insMonthly + hoaMonthly;
      const totalInterest = (pi * numPayments) - principal;
      const totalCost = pi * numPayments;

      const now = new Date();
      const payoff = new Date(now.getFullYear(), now.getMonth() + numPayments);
      const payoffStr = payoff.toLocaleDateString('de-DE', { month: 'short', year: 'numeric' });

      $('dp-amount').textContent = `Eigenkapital: ${fmt(downPayment)} | Darlehen: ${fmt(principal)}`;
      $('monthly-payment').textContent = fmt(totalMonthly);
      $('pi-amount').textContent = fmt(pi);
      $('tax-amount').textContent = fmt(taxMonthly);
      $('ins-amount').textContent = fmt(insMonthly);
      $('hoa-amount').textContent = fmt(hoaMonthly);
      $('total-monthly').textContent = fmt(totalMonthly);
      $('total-interest').textContent = fmt(totalInterest);
      $('total-cost').textContent = fmt(totalCost);
      $('payoff-date').textContent = payoffStr;
      $('loan-amount').textContent = fmt(principal);

      ($('hoa-row') as HTMLElement).style.display = hoaMonthly > 0 ? 'flex' : 'none';

      updateDonut(pi, taxMonthly, insMonthly, hoaMonthly);
      buildAmortization(principal, monthlyRate, pi, numPayments);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function updateDonut(pi: number, tax: number, ins: number, hoa: number) {
      const ctx = ($('donut-chart') as HTMLCanvasElement).getContext('2d')!;
      const data = [pi, tax, ins];
      const labels = ['Tilgung & Zinsen', 'Grundsteuer', 'Versicherung'];
      const colors = ['#3b82f6', '#10b981', '#f59e0b'];
      if (hoa > 0) { data.push(hoa); labels.push('Hausgeld'); colors.push('#8b5cf6'); }

      if (donutChart) donutChart.destroy();
      donutChart = new Chart(ctx, {
        type: 'doughnut',
        data: { labels, datasets: [{ data, backgroundColor: colors, borderWidth: 0 }] },
        options: {
          responsive: true,
          cutout: '65%',
          plugins: {
            legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, pointStyleWidth: 10, font: { size: 11 } } },
            tooltip: { callbacks: { label: (c) => `${c.label}: ${Math.round(c.parsed).toLocaleString('de-DE')} €` } }
          }
        }
      });
    }

    function buildAmortization(principal: number, monthlyRate: number, pi: number, numPayments: number) {
      let balance = principal;
      const rows: { period: string; payment: number; princ: number; interest: number; balance: number }[] = [];

      if (viewMode === 'monthly') {
        for (let m = 1; m <= numPayments; m++) {
          const interest = balance * monthlyRate;
          const princ = pi - interest;
          balance -= princ;
          if (balance < 0) balance = 0;
          rows.push({ period: `Monat ${m}`, payment: pi, princ, interest, balance });
        }
      } else {
        for (let y = 1; y <= numPayments / 12; y++) {
          let yearPayment = 0, yearPrinc = 0, yearInterest = 0;
          for (let m = 0; m < 12; m++) {
            const interest = balance * monthlyRate;
            const princ = pi - interest;
            balance -= princ;
            if (balance < 0) balance = 0;
            yearPayment += pi;
            yearPrinc += princ;
            yearInterest += interest;
          }
          rows.push({ period: `Jahr ${y}`, payment: yearPayment, princ: yearPrinc, interest: yearInterest, balance });
        }
      }

      const tbody = $('amort-tbody');
      const header = $('amort-table').querySelector('th')!;
      header.textContent = viewMode === 'monthly' ? 'Monat' : 'Jahr';

      const displayRows = viewMode === 'monthly' ? rows.slice(0, 60) : rows;
      tbody.innerHTML = displayRows.map(r => `
        <tr class="border-b border-border/30 hover:bg-surface-alt/50">
          <td class="py-2 pr-3 text-text-secondary">${r.period}</td>
          <td class="py-2 pr-3 text-right">${fmt(r.payment)}</td>
          <td class="py-2 pr-3 text-right text-primary">${fmt(r.princ)}</td>
          <td class="py-2 pr-3 text-right text-danger">${fmt(r.interest)}</td>
          <td class="py-2 text-right font-medium">${fmt(r.balance)}</td>
        </tr>
      `).join('');

      if (viewMode === 'monthly' && rows.length > 60) {
        tbody.innerHTML += `<tr><td colspan="5" class="py-3 text-center text-sm text-primary cursor-pointer hover:underline" id="show-all-months">Alle ${rows.length} Monate anzeigen</td></tr>`;
        $('show-all-months')?.addEventListener('click', () => {
          tbody.innerHTML = rows.map(r => `
            <tr class="border-b border-border/30 hover:bg-surface-alt/50">
              <td class="py-2 pr-3 text-text-secondary">${r.period}</td>
              <td class="py-2 pr-3 text-right">${fmt(r.payment)}</td>
              <td class="py-2 pr-3 text-right text-primary">${fmt(r.princ)}</td>
              <td class="py-2 pr-3 text-right text-danger">${fmt(r.interest)}</td>
              <td class="py-2 text-right font-medium">${fmt(r.balance)}</td>
            </tr>
          `).join('');
        });
      }
    }

    document.addEventListener('calc-update', () => {});
    setTimeout(() => {
      ['home-price-slider', 'down-payment-slider', 'interest-rate-slider', 'property-tax-slider', 'home-insurance-slider', 'hoa-slider'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calculate);
      });
      ['home-price-input', 'down-payment-input', 'interest-rate-input', 'property-tax-input', 'home-insurance-input', 'hoa-input'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', () => setTimeout(calculate, 120));
      });
      calculate();
    }, 50);
  </script>
</CalculatorLayout>
