---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lebensversicherung Rechner – Todesfallschutz & Beiträge";
const description = "Berechnen Sie den benötigten Todesfallschutz und monatliche Beiträge für Ihre Risikolebensversicherung.";
const relatedCalcs = [
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionen planen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibung." },
  { name: "Auslastungsgrad Rechner", url: "/de/auslastungsgrad-rechner", description: "Kapazität." },
  { name: "Anwaltskostenrechner", url: "/de/anwaltskosten-rechner", description: "Rechtskosten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="life-insurance-calculator" calculatorName="Lebensversicherung Rechner" keywords="Lebensversicherung Rechner, Risikolebensversicherung, Todesfallschutz, Versicherungssumme, Beitragsrechner" breadcrumbs={[{ name: "Lebensversicherung Rechner", url: "/de/lebensversicherung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lebensversicherung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die optimale Versicherungssumme und schätzen Sie monatliche Beiträge für Ihre Risikolebensversicherung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Jahresbruttoeinkommen (€)</label>
            <input type="number" id="lv-einkommen" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60000" step="1000" min="0">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Absicherungsdauer (Jahre)</label>
            <input type="number" id="lv-jahre" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="1" min="1" max="40">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Offene Schulden (€)</label>
            <input type="number" id="lv-schulden" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200000" step="5000" min="0">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Vorhandenes Vermögen (€)</label>
            <input type="number" id="lv-vermoegen" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30000" step="1000" min="0">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Alter (Jahre)</label>
            <input type="number" id="lv-alter" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" step="1" min="18" max="65">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Raucherstatus</label>
            <select id="lv-raucher" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1" selected>Nichtraucher</option>
              <option value="2">Raucher</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Versicherungssumme</div>
          <div class="text-4xl font-extrabold font-mono" id="lv-summe">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="lv-details"></div>
      </div>
      <ShareButton lang="de" calculatorId="lebensversicherung" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Risikolebensversicherung in Deutschland</h2>
      <p>Die Risikolebensversicherung ist der günstigste Weg, Angehörige finanziell abzusichern. Als Faustregel gilt: Die Versicherungssumme sollte 3–5 Jahresgehälter plus offene Schulden betragen. Beiträge hängen von Alter, Gesundheitszustand, Raucherstatus und Versicherungsdauer ab. Nichtraucher zahlen typischerweise 30–50 % weniger als Raucher.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie hoch sollte die Versicherungssumme sein?</summary>
          <p class="mt-2 text-sm text-text-secondary">Experten empfehlen mindestens 3–5 Jahresbruttoeinkommen plus alle offenen Verbindlichkeiten (Hypotheken, Kredite). Bei Familien mit Kindern sollte es eher Richtung 5–7 Jahresgehälter gehen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was kostet eine Risikolebensversicherung monatlich?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ein gesunder Nichtraucher, 35 Jahre, mit 500.000 € Versicherungssumme auf 20 Jahre zahlt typischerweise 20–40 € pro Monat. Raucher zahlen das Doppelte bis Dreifache.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen Risikolebens- und Kapitallebensversicherung?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die Risikolebensversicherung zahlt nur im Todesfall und hat keinen Sparanteil. Sie ist deutlich günstiger. Die Kapitallebensversicherung kombiniert Versicherungsschutz mit Sparplan, hat aber höhere Kosten und geringere Renditen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Ist eine Risikolebensversicherung steuerlich absetzbar?</summary>
          <p class="mt-2 text-sm text-text-secondary">Beiträge können als Vorsorgeaufwendungen steuerlich geltend gemacht werden, jedoch nur im Rahmen der jährlichen Höchstbeträge (1.900 € für Arbeitnehmer). Die Auszahlung im Todesfall ist erbschaftsteuerpflichtig, wenn sie das Freibetragsvolumen übersteigt.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLV() {
      const einkommen = parseFloat((document.getElementById('lv-einkommen') as HTMLInputElement).value) || 0;
      const jahre = parseFloat((document.getElementById('lv-jahre') as HTMLInputElement).value) || 0;
      const schulden = parseFloat((document.getElementById('lv-schulden') as HTMLInputElement).value) || 0;
      const vermoegen = parseFloat((document.getElementById('lv-vermoegen') as HTMLInputElement).value) || 0;
      const alter = parseFloat((document.getElementById('lv-alter') as HTMLInputElement).value) || 35;
      const raucher = parseFloat((document.getElementById('lv-raucher') as HTMLSelectElement).value) || 1;

      // Empfohlene Versicherungssumme
      const einkommensAbsicherung = einkommen * Math.min(jahre, 10) * 0.7; // 70% des Einkommens für bis zu 10 Jahre
      const empfohleneSumme = Math.max(einkommensAbsicherung + schulden - vermoegen, 0);

      // Grober Beitragsschätzer
      const basisBeitrag = empfohleneSumme / 1000 * (0.08 + alter * 0.003);
      const beitragMonatlich = basisBeitrag * raucher * (1 + jahre * 0.005);

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
      const fmtD = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('lv-summe')!.textContent = fmt(empfohleneSumme);
      document.getElementById('lv-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einkommensabsicherung</div><div class="text-lg font-bold font-mono">${fmt(einkommensAbsicherung)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schuldenabdeckung</div><div class="text-lg font-bold font-mono">${fmt(schulden)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abzgl. Vermögen</div><div class="text-lg font-bold font-mono">- ${fmt(vermoegen)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Beitrag (ca.)</div><div class="text-lg font-bold font-mono">${fmtD(beitragMonatlich)}</div></div>`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['lv-einkommen','lv-jahre','lv-schulden','lv-vermoegen','lv-alter'].forEach(id => document.getElementById(id)!.addEventListener('input', calcLV));
      document.getElementById('lv-raucher')!.addEventListener('change', calcLV);
      calcLV();
    }, 50);
  </script>
</CalculatorLayout>
