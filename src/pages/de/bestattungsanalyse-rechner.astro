---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bestattungsanalyse-Rechner - Demografische Alters- & Geschlechtsverteilung";
const description = "Analysieren Sie Bestattungspopulationen: Berechnen Sie Sterbealtersverteilung, Geschlechterverh&auml;ltnis, Lebenserwartung und demografische Profile aus Friedhofsdaten.";
const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Statistik-Rechner", url: "/de/statistik-rechner", description: "Statistische Berechnungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Bestattungsanalyse-Rechner" lang="de" enSlug="burial-analysis-calculator" keywords="bestattungsanalyse, pal&auml;odemografie, sterbealter, geschlechterverh&auml;ltnis, bio-arch&auml;ologie" breadcrumbs={[{ name: "Bestattungsanalyse", url: "/de/bestattungsanalyse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bestattungsanalyse-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie Friedhofspopulationen mit demografischen Berechnungen inkl. Sterbealtersverteilung, Geschlechterverh&auml;ltnis und Lebenserwartungssch&auml;tzungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-sm font-medium text-text mb-1">Gesamtbestattungen</label><input type="number" id="bua-total" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">M&auml;nnlich</label><input type="number" id="bua-male" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Weiblich</label><input type="number" id="bua-female" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Unbestimmt</label><input type="number" id="bua-indet" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">Subadulte (0-15 J.)</label><input type="number" id="bua-subadult" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Erwachsene (15+ J.)</label><input type="number" id="bua-adult" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Durchschn. Sterbealter Erwachsene (Jahre)</label><input type="number" id="bua-avgage" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="15" max="80" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Nutzungsdauer Friedhof (Jahre)</label><input type="number" id="bua-duration" class="bua-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch. Lebenserwartung bei Geburt</div>
          <div class="text-4xl font-extrabold" id="bua-e0">0</div>
          <div class="text-sm text-blue-200 mt-1">Jahre (Acs&aacute;di-Nemesk&eacute;ri-Methode)</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Geschlechterverh. (M:W)</div><div class="text-xl font-bold" id="bua-sexratio">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kindersterblichkeit</div><div class="text-xl font-bold" id="bua-submort">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rohe Sterberate</div><div class="text-xl font-bold" id="bua-cdr">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. lebende Bev.</div><div class="text-xl font-bold" id="bua-livepop">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bestattungen/Jahr</div><div class="text-xl font-bold" id="bua-peryr">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Juvenilit&auml;tsindex</div><div class="text-xl font-bold" id="bua-juv">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="burial-analysis" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Pal&auml;odemografische Formeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Geschlechterverh.</strong> = M&auml;nnlich / Weiblich (erwartet ~1,0)</p>
        <p><strong>Juvenilit&auml;tsindex</strong> = Subadulte / (Subadulte + Erwachsene)</p>
        <p><strong>Rohe Sterberate</strong> = 1000 / Lebenserwartung bei Geburt</p>
        <p><strong>Lebende Bev.</strong> = Bestattungen &times; Lebenserwartung / Dauer</p>
      </div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBUA() {
      const total = parseFloat((document.getElementById('bua-total') as HTMLInputElement).value) || 0;
      const male = parseFloat((document.getElementById('bua-male') as HTMLInputElement).value) || 0;
      const female = parseFloat((document.getElementById('bua-female') as HTMLInputElement).value) || 0;
      const subadult = parseFloat((document.getElementById('bua-subadult') as HTMLInputElement).value) || 0;
      const adult = parseFloat((document.getElementById('bua-adult') as HTMLInputElement).value) || 0;
      const avgAge = parseFloat((document.getElementById('bua-avgage') as HTMLInputElement).value) || 0;
      const duration = parseFloat((document.getElementById('bua-duration') as HTMLInputElement).value) || 1;
      const sexRatio = female > 0 ? male / female : 0;
      const subMort = total > 0 ? (subadult / total) * 100 : 0;
      const juvIndex = (subadult + adult) > 0 ? subadult / (subadult + adult) : 0;
      const avgSubadultAge = 5;
      const weightedAvgAge = total > 0 ? (subadult * avgSubadultAge + adult * avgAge) / total : 0;
      const e0 = weightedAvgAge;
      const cdr = e0 > 0 ? 1000 / e0 : 0;
      const burialsPerYear = duration > 0 ? total / duration : 0;
      const livingPop = e0 > 0 && duration > 0 ? (total * e0) / duration : 0;
      const fmt = (v: number, d: number) => v.toFixed(d).replace('.', ',');
      document.getElementById('bua-e0')!.textContent = fmt(e0, 1);
      document.getElementById('bua-sexratio')!.textContent = fmt(sexRatio, 2) + ':1';
      document.getElementById('bua-submort')!.textContent = fmt(subMort, 1) + '%';
      document.getElementById('bua-cdr')!.textContent = fmt(cdr, 1) + ' /1000';
      document.getElementById('bua-livepop')!.textContent = Math.round(livingPop).toLocaleString('de-DE');
      document.getElementById('bua-peryr')!.textContent = fmt(burialsPerYear, 2);
      document.getElementById('bua-juv')!.textContent = fmt(juvIndex, 3);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bua-total') as HTMLInputElement).value = '85';
      (document.getElementById('bua-male') as HTMLInputElement).value = '32';
      (document.getElementById('bua-female') as HTMLInputElement).value = '35';
      (document.getElementById('bua-indet') as HTMLInputElement).value = '18';
      (document.getElementById('bua-subadult') as HTMLInputElement).value = '28';
      (document.getElementById('bua-adult') as HTMLInputElement).value = '57';
      (document.getElementById('bua-avgage') as HTMLInputElement).value = '38';
      (document.getElementById('bua-duration') as HTMLInputElement).value = '200';
      document.querySelectorAll('.bua-in').forEach(el => { el.addEventListener('input', calcBUA); el.addEventListener('change', calcBUA); });
      calcBUA();
    }, 50);
  </script>
</CalculatorLayout>
