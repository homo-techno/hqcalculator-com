---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Eigenkapitalrendite-Rechner – Cash-on-Cash Return";
const description = "Berechnen Sie die Eigenkapitalrendite (Cash-on-Cash Return) Ihrer Immobilieninvestition aus Nettomieteinnahmen und eingesetztem Kapital.";
const relatedCalcs = [
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
  { name: "Festgeld-Rechner", url: "/de/festgeld-rechner", description: "Festgeld." },
  { name: "Cashback-Rechner", url: "/de/cashback-rechner", description: "Cashback." },
  { name: "CO₂-Steuer-Rechner", url: "/de/co2-steuer-rechner", description: "CO₂-Steuer." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Eigenkapitalrendite-Rechner" enSlug="cash-on-cash-return-calculator" keywords="Eigenkapitalrendite, Cash-on-Cash, Immobilienrendite, Mietrendite, Kapitalanlage" breadcrumbs={[{ name: "Eigenkapitalrendite-Rechner", url: "/de/eigenkapitalrendite-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Eigenkapitalrendite-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Messen Sie die Leistung Ihrer Immobilieninvestition durch den Vergleich von jährlichem Cashflow und eingesetztem Eigenkapital.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-sm text-text">Eingesetztes Kapital</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eigenkapital / Anzahlung (€)</label><input type="number" id="ekr-down" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kaufnebenkosten (€)</label><input type="number" id="ekr-closing" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="500"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Sanierungskosten (€)</label><input type="number" id="ekr-rehab" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="500"></div>
        <h3 class="font-semibold text-sm text-text">Jährliche Einnahmen &amp; Ausgaben</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Jährliche Bruttomiete (€)</label><input type="number" id="ekr-rent" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Jährl. Betriebskosten (€)</label><input type="number" id="ekr-expenses" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="500"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Jährlicher Schuldendienst (€)</label><input type="number" id="ekr-debt" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Eigenkapitalrendite</div>
          <div class="text-5xl font-extrabold font-mono" id="ekr-coc">0%</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eingesetztes Kapital</div><div class="text-xl font-bold font-mono" id="ekr-totalcash">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährlicher Cashflow</div><div class="text-xl font-bold font-mono" id="ekr-cashflow">0 €</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">NOI</div><div class="text-xl font-bold font-mono" id="ekr-noi">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Cashflow</div><div class="text-xl font-bold font-mono" id="ekr-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">vs. DAX (8%)</div><div class="text-xl font-bold font-mono" id="ekr-vs500">--</div></div>
        </div>
        <div class="p-4 rounded-xl text-center" id="ekr-status-box"><div class="font-bold text-sm" id="ekr-status">-</div></div>
      </div>
      <ShareButton lang="de" calculatorId="cash-on-cash-return" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Eigenkapitalrendite bei Immobilien</h2>
      <p>Die Eigenkapitalrendite misst den jährlichen Cashflow im Verhältnis zum eingesetzten Eigenkapital. In Deutschland gelten 4-6% als durchschnittlich und 8%+ als sehr gut.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcEKR() {
      const down = parseFloat((document.getElementById('ekr-down') as HTMLInputElement).value) || 0;
      const closing = parseFloat((document.getElementById('ekr-closing') as HTMLInputElement).value) || 0;
      const rehab = parseFloat((document.getElementById('ekr-rehab') as HTMLInputElement).value) || 0;
      const rent = parseFloat((document.getElementById('ekr-rent') as HTMLInputElement).value) || 0;
      const expenses = parseFloat((document.getElementById('ekr-expenses') as HTMLInputElement).value) || 0;
      const debt = parseFloat((document.getElementById('ekr-debt') as HTMLInputElement).value) || 0;
      const totalCash = down + closing + rehab;
      const noi = rent - expenses;
      const annualCashFlow = noi - debt;
      const monthlyCF = annualCashFlow / 12;
      const coc = totalCash > 0 ? (annualCashFlow / totalCash) * 100 : 0;
      const daxEquiv = totalCash * 0.08;
      let vsLabel = 'Gleich';
      if (annualCashFlow > daxEquiv * 1.1) vsLabel = 'Besser';
      else if (annualCashFlow < daxEquiv * 0.9) vsLabel = 'Schlechter';
      const fmt = (v: number) => (v >= 0 ? '' : '-') + Math.abs(v).toLocaleString('de-DE', {maximumFractionDigits:0}) + ' €';
      document.getElementById('ekr-coc')!.textContent = coc.toFixed(2) + '%';
      document.getElementById('ekr-totalcash')!.textContent = fmt(totalCash);
      document.getElementById('ekr-cashflow')!.textContent = fmt(annualCashFlow);
      document.getElementById('ekr-noi')!.textContent = fmt(noi);
      document.getElementById('ekr-monthly')!.textContent = fmt(monthlyCF);
      document.getElementById('ekr-vs500')!.textContent = vsLabel;
      let status: string, color: string;
      if (coc >= 12) { status = 'Ausgezeichnete Eigenkapitalrendite'; color = 'bg-green-50 text-green-800'; }
      else if (coc >= 8) { status = 'Starke Rendite — überdurchschnittlich'; color = 'bg-blue-50 text-blue-800'; }
      else if (coc >= 4) { status = 'Moderate Rendite — typisch für stabile Märkte'; color = 'bg-yellow-50 text-yellow-800'; }
      else { status = 'Niedrige Rendite — andere Optionen prüfen'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('ekr-status')!.textContent = status;
      document.getElementById('ekr-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ekr-down') as HTMLInputElement).value = '60000';
      (document.getElementById('ekr-closing') as HTMLInputElement).value = '15000';
      (document.getElementById('ekr-rehab') as HTMLInputElement).value = '5000';
      (document.getElementById('ekr-rent') as HTMLInputElement).value = '12000';
      (document.getElementById('ekr-expenses') as HTMLInputElement).value = '3000';
      (document.getElementById('ekr-debt') as HTMLInputElement).value = '5400';
      document.querySelectorAll('.ekr-in').forEach(el => { el.addEventListener('input', calcEKR); el.addEventListener('change', calcEKR); });
      calcEKR();
    }, 50);
  </script>
</CalculatorLayout>
