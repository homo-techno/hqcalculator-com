---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fu\u00dfleistenrechner";
const description = "Berechnen Sie den Bedarf an Fu\u00dfleisten f\u00fcr jeden Raum. Ber\u00fccksichtigen Sie T\u00fcren, \u00d6ffnungen und Materialverschnitt.";
const relatedCalcs = [
  { name: "Stuckleisten-Rechner", url: "/crown-molding-calculator", description: "Stuckleisten." },
  { name: "Quadratmeter-Rechner", url: "/square-footage-calculator", description: "Fl\u00e4che." },
  { name: "Arbeitsplatten-Rechner", url: "/countertop-calculator", description: "Arbeitsplatten." },
  { name: "Bodenbelag-Rechner", url: "/flooring-calculator", description: "Bodenbelag." },
  { name: "T\u00fcr-Rechner", url: "/door-calculator", description: "T\u00fcren." },
  { name: "Beleuchtungs-Rechner", url: "/lighting-calculator", description: "Beleuchtung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fu\u00dfleistenrechner" lang="de" keywords="fussleisten rechner, sockelleisten berechnen, fussleisten l\u00e4nge, sockelleisten kosten, raumleisten" breadcrumbs={[{ name: "Fu\u00dfleistenrechner", url: "/de/fussleisten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fu&szlig;leistenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Fu&szlig;leistenbedarf f&uuml;r Ihren Raum.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Rauml&auml;nge (m)</label><input type="number" id="bb-len" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="4.3" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="bb-wid" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="3.7" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">T&uuml;ren (je 0,9 m)</label><input type="number" id="bb-doors" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstige &Ouml;ffnungen (m)</label><input type="number" id="bb-open" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Leistenl&auml;nge (m)</label>
            <select id="bb-piece" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="2.4" selected>2,4 m</option>
              <option value="2.5">2,5 m</option>
              <option value="3">3 m</option>
              <option value="4">4 m</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Leiste (&euro;)</label><input type="number" id="bb-price" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Fu&szlig;leisten</div>
          <div class="text-5xl font-extrabold font-mono" id="bb-result">0 m</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umfang</div><div class="text-lg font-bold font-mono" id="bb-perim">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">St&uuml;ck</div><div class="text-lg font-bold font-mono" id="bb-pieces">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten</div><div class="text-lg font-bold font-mono" id="bb-cost">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abz&uuml;ge</div><div class="text-xl font-bold font-mono" id="bb-deduct">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ecken</div><div class="text-xl font-bold font-mono" id="bb-corners">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="baseboard" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBB() {
      const len = parseFloat((document.getElementById('bb-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('bb-wid') as HTMLInputElement).value) || 0;
      const doors = parseInt((document.getElementById('bb-doors') as HTMLInputElement).value) || 0;
      const openings = parseFloat((document.getElementById('bb-open') as HTMLInputElement).value) || 0;
      const pieceLen = parseFloat((document.getElementById('bb-piece') as HTMLSelectElement).value);
      const price = parseFloat((document.getElementById('bb-price') as HTMLInputElement).value) || 0;
      const perimeter = 2 * (len + wid);
      const deductions = doors * 0.9 + openings;
      const netLength = Math.max(0, perimeter - deductions);
      const withWaste = netLength * 1.1;
      const pieces = Math.ceil(withWaste / pieceLen);
      document.getElementById('bb-result')!.textContent = netLength.toFixed(1).replace('.', ',') + ' m';
      document.getElementById('bb-perim')!.textContent = perimeter.toFixed(1).replace('.', ',') + ' m';
      document.getElementById('bb-pieces')!.textContent = pieces.toString();
      document.getElementById('bb-cost')!.textContent = (pieces * price).toFixed(0) + ' \u20ac';
      document.getElementById('bb-deduct')!.textContent = deductions.toFixed(1).replace('.', ',') + ' m';
      document.getElementById('bb-corners')!.textContent = '4 Innenecken';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bb-in').forEach(el => { el.addEventListener('input', calcBB); el.addEventListener('change', calcBB); });
      calcBB();
    }, 50);
  </script>
</CalculatorLayout>
