---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Wandertempo Rechner - Wanderzeit & Strecke 2026";
const description = "Berechne deine Wanderzeit mit Naismiths Regel inklusive Hoehengewinn, Distanz und Tempo. Kostenloser Wanderrechner fuer Touren.";

const relatedCalcs = [
  { name: "Temporechner", url: "/de/temporechner", description: "Lauftempo berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Wasserbedarfsrechner", url: "/de/wasserbedarfsrechner", description: "Taeglicher Wasserbedarf." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Wandertempo-Rechner" keywords="Wanderrechner, Wanderzeit, Naismith Regel, Wandertempo, Hoehengewinn, Wanderstrecke, Wandern Deutschland" breadcrumbs={[{ name: "Wandertempo-Rechner", url: "/de/wandertempo-rechner" }]} lang="de" enSlug="hiking-pace-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Wandertempo-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetze deine Wanderzeit mit Hoehengewinn und Tempo-Faktoren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Distanz (km)</label><input type="number" id="wtr-dist" class="wtr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="12" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hoehengewinn (m)</label><input type="number" id="wtr-elev" class="wtr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="600" min="0" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fitnesslevel</label>
            <select id="wtr-fit" class="wtr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="2.4">Anfaenger (2,4 km/h)</option>
              <option value="3.2" selected>Durchschnitt (3,2 km/h)</option>
              <option value="4.0">Fit (4,0 km/h)</option>
              <option value="4.8">Schnell (4,8 km/h)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gelaende</label>
            <select id="wtr-terr" class="wtr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1">Befestigter Weg</option>
              <option value="1.15" selected>Gemischtes Gelaende</option>
              <option value="1.3">Felsig / rau</option>
              <option value="1.5">Weglos</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Pausenzeit (Minuten)</label><input type="number" id="wtr-break" class="wtr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzte Zeit</div>
          <div class="text-5xl font-extrabold font-mono" id="wtr-result">0h 0m</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gehzeit</div><div class="text-xl font-bold font-mono" id="wtr-hike">0h 0m</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Akt. Tempo</div><div class="text-xl font-bold font-mono" id="wtr-pace">0 min/km</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien (ca.)</div><div class="text-xl font-bold font-mono" id="wtr-cal">0 kcal</div></div>
        </div>
      </div>

      <ShareButton calculatorId="hiking-pace" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie wird die Wanderzeit berechnet?</h2>
      <p>Die Wanderzeit wird nach Naismiths Regel berechnet: Fuer je 5 km Strecke wird 1 Stunde angesetzt, plus 1 Stunde je 600 Hoehenmeter. Das Ergebnis wird je nach Gelaende und Fitnesslevel angepasst.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist Naismiths Regel?</strong> Die von William Naismith entwickelte Faustregel fuer Wanderer: 5 km flache Strecke entspricht 1 Stunde, plus 10 Minuten je 100 Hoehenmetern.</p>
      <p><strong>Wie viele km pro Tag beim Wandern?</strong> Durchschnittliche Wanderer schaffen 15-25 km pro Tag auf gut markierten Wegen. Mit schwerem Gepaeck oder steilem Gelaende sind 10-15 km realistisch.</p>
      <p><strong>Wie berechne ich meinen Wasserverbrauch?</strong> Plane etwa 0,5 Liter Wasser pro Stunde Wandern, bei Hitze und Anstrengung mehr.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function fmtWtrTime(min: number): string {
      const h = Math.floor(min / 60);
      const m = Math.round(min % 60);
      return h + 'h ' + m + 'm';
    }

    function calcWTR() {
      const dist = parseFloat((document.getElementById('wtr-dist') as HTMLInputElement).value) || 0;
      const elev = parseFloat((document.getElementById('wtr-elev') as HTMLInputElement).value) || 0;
      const pace = parseFloat((document.getElementById('wtr-fit') as HTMLSelectElement).value) || 3.2;
      const terrain = parseFloat((document.getElementById('wtr-terr') as HTMLSelectElement).value) || 1;
      const breaks = parseFloat((document.getElementById('wtr-break') as HTMLInputElement).value) || 0;

      const flatTime = dist / pace * 60;
      const elevTime = elev / 600 * 60;
      const hikeTime = (flatTime + elevTime) * terrain;
      const totalTime = hikeTime + breaks;
      const avgPace = dist > 0 ? hikeTime / dist : 0;
      const calories = hikeTime * 6;

      document.getElementById('wtr-result')!.textContent = fmtWtrTime(totalTime);
      document.getElementById('wtr-hike')!.textContent = fmtWtrTime(hikeTime);
      document.getElementById('wtr-pace')!.textContent = avgPace.toFixed(0) + ' min/km';
      document.getElementById('wtr-cal')!.textContent = Math.round(calories) + ' kcal';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.wtr-in').forEach(el => {
        el.addEventListener('input', calcWTR);
        el.addEventListener('change', calcWTR);
      });
      calcWTR();
    }, 50);
  </script>
</CalculatorLayout>
