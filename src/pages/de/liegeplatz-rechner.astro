---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Liegeplatz Rechner - Kosten und Anforderungen für Bootsliegeplätze";
const description = "Berechnen Sie Kosten und Anforderungen für Bootsliegeplätze in Marinas. Liegeplatzgebühren, Serviceleistungen und Saisonkosten auf einen Blick.";
const relatedCalcs = [
  { name: "Ankerketten Rechner", url: "/de/ankerketten-rechner", description: "Ankerkettenlänge berechnen." },
  { name: "Schiffsbatterie Rechner", url: "/de/schiffsbatterie-rechner", description: "Batteriekapazität für Boote." },
  { name: "Schiffsdiesel Rechner", url: "/de/schiffsdiesel-rechner", description: "Kraftstoffverbrauch Schiff." },
  { name: "Schiffsfarbe Rechner", url: "/de/schiffsfarbe-rechner", description: "Farbverbrauch Schiff." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="marina-slip-calculator" calculatorName="Liegeplatz Rechner" keywords="Liegeplatz Rechner, Marinakosten, Bootsliegeplatz, Liegeplatzgebühren, Marina Kosten berechnen" breadcrumbs={[{ name: "Liegeplatz Rechner", url: "/de/liegeplatz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Liegeplatz Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Kosten und Anforderungen für einen Bootsliegeplatz in einer Marina – inklusive Saisongebühren und Zusatzleistungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bootslänge (m)</label><input type="number" id="lp-len" class="lp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="2" max="50" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bootsbreite (m)</label><input type="number" id="lp-beam" class="lp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.8" min="1" max="15" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Marinaklasse</label>
            <select id="lp-class" class="lp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="basic">Einfach (€8/m/Tag)</option>
              <option value="standard" selected>Standard (€14/m/Tag)</option>
              <option value="premium">Premium (€22/m/Tag)</option>
              <option value="luxury">Luxus (€35/m/Tag)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aufenthaltsdauer</label>
            <select id="lp-duration" class="lp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1">1 Tag</option>
              <option value="7">1 Woche</option>
              <option value="30">1 Monat</option>
              <option value="180" selected>Saison (6 Monate)</option>
              <option value="365">Jahresvertrag</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="flex items-center gap-2"><input type="checkbox" id="lp-strom" class="lp-in w-4 h-4"><label for="lp-strom" class="text-sm text-text">Landstrom (€3/Tag)</label></div>
          <div class="flex items-center gap-2"><input type="checkbox" id="lp-wasser" class="lp-in w-4 h-4" checked><label for="lp-wasser" class="text-sm text-text">Wasser (inklusive)</label></div>
          <div class="flex items-center gap-2"><input type="checkbox" id="lp-wifi" class="lp-in w-4 h-4"><label for="lp-wifi" class="text-sm text-text">WLAN (€2/Tag)</label></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="lp-total">--</div>
          <div class="text-sm text-blue-200 mt-1" id="lp-per">-- pro Tag</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Liegeplatzgröße</div><div class="text-xl font-bold" id="lp-size">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundgebühr/Tag</div><div class="text-xl font-bold" id="lp-base">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Extras/Tag</div><div class="text-xl font-bold" id="lp-extras">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="liegeplatz" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Liegeplatzkosten in deutschen Marinas</h2>
      <p>Die Kosten für einen Bootsliegeplatz variieren stark je nach Lage, Marinaklasse und Bootsgröße. In Deutschland werden Liegeplätze typischerweise nach Bootslänge abgerechnet – der Preis pro Laufmeter und Tag liegt je nach Marina zwischen 8 und 35 Euro. Zusätzlich können Landstrom, WLAN und Frischwasser extra kosten. Ein Saisonliegeplatz bietet oft erhebliche Rabatte gegenüber der Tagespauschale.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie wird der Liegeplatz berechnet?</strong> Der Liegeplatz wird in der Regel nach der Länge des Bootes abgerechnet. Manche Marinas berechnen auch die Breite oder nutzen eine Kombination aus Länge und Breite als Grundlage.</p>
      <p><strong>Was kostet ein Jahres-Liegeplatz in Deutschland?</strong> Ein Jahres-Liegeplatz für ein 8-Meter-Boot kostet in einer Standardmarina zwischen 1.500 und 4.000 Euro, in Premium-Marinas auch deutlich mehr.</p>
      <p><strong>Was ist im Liegeplatz normalerweise inbegriffen?</strong> Frischwasser ist oft inklusive. Landstrom, WLAN, Sanitäranlagen und Slipanlage sind häufig separat buchbar oder pauschal im Saisonpreis enthalten.</p>
      <p><strong>Gibt es Rabatte für längere Aufenthalte?</strong> Ja, die meisten Marinas bieten Wochen-, Monats- oder Saisonrabatte an. Ein Saison- oder Jahresvertrag ist fast immer günstiger als die Tagesrate.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const lpRates: Record<string, number> = { basic: 8, standard: 14, premium: 22, luxury: 35 };
    function calcLP() {
      const len = parseFloat((document.getElementById('lp-len') as HTMLInputElement).value) || 0;
      const beam = parseFloat((document.getElementById('lp-beam') as HTMLInputElement).value) || 0;
      const cls = (document.getElementById('lp-class') as HTMLSelectElement).value;
      const days = parseInt((document.getElementById('lp-duration') as HTMLSelectElement).value) || 1;
      const strom = (document.getElementById('lp-strom') as HTMLInputElement).checked ? 3 : 0;
      const wifi = (document.getElementById('lp-wifi') as HTMLInputElement).checked ? 2 : 0;
      const rate = lpRates[cls] || 14;
      const basePerDay = len * rate;
      const extrasPerDay = strom + wifi;
      const totalPerDay = basePerDay + extrasPerDay;
      const total = totalPerDay * days;
      const slipSize = (len * beam).toFixed(1).replace('.', ',') + ' m²';
      const fmt = (v: number) => v.toLocaleString('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
      document.getElementById('lp-total')!.textContent = total > 0 ? fmt(total) : '--';
      document.getElementById('lp-per')!.textContent = total > 0 ? fmt(totalPerDay) + ' pro Tag' : '--';
      document.getElementById('lp-size')!.textContent = slipSize;
      document.getElementById('lp-base')!.textContent = basePerDay > 0 ? fmt(basePerDay) : '--';
      document.getElementById('lp-extras')!.textContent = fmt(extrasPerDay);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.lp-in').forEach(el => { el.addEventListener('input', calcLP); el.addEventListener('change', calcLP); });
      calcLP();
    }, 50);
  </script>
</CalculatorLayout>
