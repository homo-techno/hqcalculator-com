---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kies-Rechner - Tonnen, Kubikmeter & Kostenrechner";
const description = "Berechnen Sie die benötigte Menge an Kies, Sand, Mulch oder Mutterboden. Volumen in Kubikmetern und Gewicht in Tonnen mit Kostenschätzung.";
const relatedCalcs = [
  { name: "Glasfusing-Rechner", url: "/de/glasfusing-rechner", description: "Glasfusing-Brennpläne." },
  { name: "Grünes-Bauen-Rechner", url: "/de/gruenes-bauen-rechner", description: "LEED-Punkte schätzen." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Noten berechnen." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Genauigkeit." },
  { name: "Glasdicke-Rechner", url: "/de/glasdicke-rechner", description: "Glasdicke berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kies-Rechner" enSlug="gravel-calculator" keywords="Kies Rechner, Kies Menge, Kubikmeter, Kies Kosten, Gartenrechner, Mulch Rechner, Sand Rechner" breadcrumbs={[{ name: "Kies-Rechner", url: "/de/kies-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kies-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die benötigte Menge an Kies, Sand, Mulch oder Erde für Ihr Projekt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Material</label>
            <div class="grid grid-cols-2 gap-2">
              <button class="kir-mat-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-primary bg-blue-50 text-primary" data-mat="kies">Kies</button>
              <button class="kir-mat-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-mat="sand">Sand</button>
              <button class="kir-mat-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-mat="mulch">Mulch</button>
              <button class="kir-mat-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-mat="mutterboden">Mutterboden</button>
              <button class="kir-mat-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-mat="schotter">Schotter</button>
              <button class="kir-mat-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-mat="flusskies">Flusskies</button>
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Flächenform</label>
            <div class="flex gap-2">
              <button class="kir-shape-btn px-4 py-2 rounded-xl text-sm font-semibold border border-primary bg-blue-50 text-primary" data-shape="rect">Rechteck</button>
              <button class="kir-shape-btn px-4 py-2 rounded-xl text-sm font-semibold border border-border" data-shape="circle">Kreis</button>
              <button class="kir-shape-btn px-4 py-2 rounded-xl text-sm font-semibold border border-border" data-shape="triangle">Dreieck</button>
            </div>
          </div>

          <div id="kir-rect" class="mb-5">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-text mb-1">Länge (m)</label>
                <input type="number" id="kir-length" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="6" min="0" step="0.1">
              </div>
              <div>
                <label class="block text-xs font-medium text-text mb-1">Breite (m)</label>
                <input type="number" id="kir-width" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="0" step="0.1">
              </div>
            </div>
          </div>

          <div id="kir-circle" class="mb-5 hidden">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Durchmesser (m)</label>
              <input type="number" id="kir-diameter" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="4" min="0" step="0.1">
            </div>
          </div>

          <div id="kir-triangle" class="mb-5 hidden">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-text mb-1">Basis (m)</label>
                <input type="number" id="kir-base" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="5" min="0" step="0.1">
              </div>
              <div>
                <label class="block text-xs font-medium text-text mb-1">Höhe (m)</label>
                <input type="number" id="kir-height" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="0" step="0.1">
              </div>
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Tiefe (cm)</label>
            <input type="number" id="kir-depth" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="8" min="0" step="1">
            <div class="flex gap-2 mt-2">
              <button class="kir-depth-btn px-2 py-1 text-xs rounded-lg border border-border hover:bg-surface-alt" data-d="5">5 cm</button>
              <button class="kir-depth-btn px-2 py-1 text-xs rounded-lg border border-border hover:bg-surface-alt" data-d="8">8 cm</button>
              <button class="kir-depth-btn px-2 py-1 text-xs rounded-lg border border-border hover:bg-surface-alt" data-d="10">10 cm</button>
              <button class="kir-depth-btn px-2 py-1 text-xs rounded-lg border border-border hover:bg-surface-alt" data-d="15">15 cm</button>
              <button class="kir-depth-btn px-2 py-1 text-xs rounded-lg border border-border hover:bg-surface-alt" data-d="30">30 cm</button>
            </div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <label class="block text-xs font-medium text-text mb-1">Preis pro Tonne (€)</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">€</span>
              <input type="number" id="kir-cost" class="w-full pl-7 pr-3 py-2 border border-border rounded-lg" value="35" min="0" step="5">
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="kir-mat-label">Kies benötigt</div>
            <div class="text-4xl font-extrabold" id="kir-m3">0</div>
            <div class="text-sm text-blue-200 mt-1">Kubikmeter</div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Liter</div>
              <div class="text-xl font-bold" id="kir-liter">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gewicht (Tonnen)</div>
              <div class="text-xl font-bold" id="kir-tons">0</div>
            </div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Geschätzte Kosten</div>
            <div class="text-3xl font-bold text-secondary" id="kir-total-cost">€0</div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fläche</div>
            <div class="text-xl font-bold" id="kir-area">0 m²</div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-2">Materialdichte-Referenz</h3>
            <div class="grid grid-cols-2 gap-1 text-xs">
              <div class="flex justify-between p-1"><span>Kies</span><span class="font-bold">1.600 kg/m³</span></div>
              <div class="flex justify-between p-1"><span>Sand</span><span class="font-bold">1.600 kg/m³</span></div>
              <div class="flex justify-between p-1"><span>Mulch</span><span class="font-bold">475 kg/m³</span></div>
              <div class="flex justify-between p-1"><span>Mutterboden</span><span class="font-bold">1.300 kg/m³</span></div>
              <div class="flex justify-between p-1"><span>Schotter</span><span class="font-bold">1.600 kg/m³</span></div>
              <div class="flex justify-between p-1"><span>Flusskies</span><span class="font-bold">1.540 kg/m³</span></div>
            </div>
          </div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="gravel" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Kiesbedarf berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Volumen (m³)</strong> = Fläche (m²) x Tiefe (m)</p>
        <p><strong>Gewicht (t)</strong> = Volumen (m³) x Dichte (kg/m³) / 1000</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Empfohlene Tiefen</h3>
      <ul>
        <li><strong>Einfahrt:</strong> 8-10 cm Kies</li>
        <li><strong>Gehweg:</strong> 5-8 cm</li>
        <li><strong>Mulchbeete:</strong> 5-8 cm</li>
        <li><strong>Drainage:</strong> 15-30 cm</li>
        <li><strong>Fundament-Unterbau:</strong> 10-15 cm Schotter</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel wiegt ein Kubikmeter Kies?</strong> Etwa 1.600 kg (1,6 Tonnen). Das genaue Gewicht hängt von der Kiessorte und dem Feuchtigkeitsgehalt ab.</p>
      <p><strong>Wie viel Fläche deckt ein Kubikmeter Kies?</strong> Bei 8 cm Tiefe deckt 1 m³ eine Fläche von 12,5 m² ab.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let kirShape = 'rect';
    let kirMat = 'kies';

    const kirDensity: Record<string, number> = {
      kies: 1600, sand: 1600, mulch: 475, mutterboden: 1300, schotter: 1600, flusskies: 1540
    };
    const kirMatNames: Record<string, string> = {
      kies: 'Kies', sand: 'Sand', mulch: 'Mulch', mutterboden: 'Mutterboden', schotter: 'Schotter', flusskies: 'Flusskies'
    };

    function calcKies() {
      const depthCm = parseFloat((document.getElementById('kir-depth') as HTMLInputElement).value) || 0;
      const depthM = depthCm / 100;
      const costPerTon = parseFloat((document.getElementById('kir-cost') as HTMLInputElement).value) || 0;

      let areaM2 = 0;
      if (kirShape === 'rect') {
        const l = parseFloat((document.getElementById('kir-length') as HTMLInputElement).value) || 0;
        const w = parseFloat((document.getElementById('kir-width') as HTMLInputElement).value) || 0;
        areaM2 = l * w;
      } else if (kirShape === 'circle') {
        const d = parseFloat((document.getElementById('kir-diameter') as HTMLInputElement).value) || 0;
        areaM2 = Math.PI * (d / 2) ** 2;
      } else if (kirShape === 'triangle') {
        const b = parseFloat((document.getElementById('kir-base') as HTMLInputElement).value) || 0;
        const h = parseFloat((document.getElementById('kir-height') as HTMLInputElement).value) || 0;
        areaM2 = 0.5 * b * h;
      }

      const volM3 = areaM2 * depthM;
      const volL = volM3 * 1000;
      const tons = volM3 * kirDensity[kirMat] / 1000;
      const cost = tons * costPerTon;

      document.getElementById('kir-mat-label')!.textContent = kirMatNames[kirMat] + ' benötigt';
      document.getElementById('kir-m3')!.textContent = volM3.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('kir-liter')!.textContent = volL.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.getElementById('kir-tons')!.textContent = tons.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('kir-total-cost')!.textContent = '€' + Math.round(cost).toLocaleString('de-DE');
      document.getElementById('kir-area')!.textContent = areaM2.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m²';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.kir-mat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.kir-mat-btn').forEach(b => { b.classList.remove('border-primary', 'bg-blue-50', 'text-primary'); b.classList.add('border-border'); });
          btn.classList.remove('border-border'); btn.classList.add('border-primary', 'bg-blue-50', 'text-primary');
          kirMat = (btn as HTMLElement).dataset.mat || 'kies';
          calcKies();
        });
      });

      document.querySelectorAll('.kir-shape-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.kir-shape-btn').forEach(b => { b.classList.remove('border-primary', 'bg-blue-50', 'text-primary'); b.classList.add('border-border'); });
          btn.classList.remove('border-border'); btn.classList.add('border-primary', 'bg-blue-50', 'text-primary');
          kirShape = (btn as HTMLElement).dataset.shape || 'rect';
          document.getElementById('kir-rect')!.classList.toggle('hidden', kirShape !== 'rect');
          document.getElementById('kir-circle')!.classList.toggle('hidden', kirShape !== 'circle');
          document.getElementById('kir-triangle')!.classList.toggle('hidden', kirShape !== 'triangle');
          calcKies();
        });
      });

      document.querySelectorAll('.kir-depth-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          (document.getElementById('kir-depth') as HTMLInputElement).value = (btn as HTMLElement).dataset.d || '8';
          calcKies();
        });
      });

      ['kir-length', 'kir-width', 'kir-diameter', 'kir-base', 'kir-height', 'kir-depth', 'kir-cost'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcKies);
      });

      calcKies();
    }, 50);
  </script>
</CalculatorLayout>
