---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Linsendicke Rechner – Brillenglas Mittendicke berechnen";
const description = "Berechnen Sie die Mittendicke von Brillengläsern aus Brechkraft (Dioptrien), Linsendurchmesser und Brechungsindex.";
const relatedCalcs = [
  { name: "Linsengleichung Rechner", url: "/de/linsen-gleichung-rechner", description: "Brennweite berechnen." },
  { name: "Lichtintensität Rechner", url: "/de/lichtintensitaet-rechner", description: "Beleuchtungsstärke." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="lens-thickness-calculator" calculatorName="Linsendicke Rechner" keywords="Linsendicke Rechner, Brillenglas Dicke, Dioptrien Dicke, Mittendicke, Brechungsindex" breadcrumbs={[{ name: "Linsendicke Rechner", url: "/de/linsendicke-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Linsendicke Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Mittendicke Ihrer Brillengläser aus Brechkraft, Durchmesser und Brechungsindex.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Brechkraft (Dioptrien)</label>
          <input type="number" id="ldk-dpt" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="-3.5" step="0.25">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Linsendurchmesser (mm)</label>
          <input type="number" id="ldk-dia" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="65" step="1" min="10">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Brechungsindex</label>
          <select id="ldk-n" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.5" selected>Standard 1,50</option>
            <option value="1.53">Mitteldünn 1,53</option>
            <option value="1.56">Mitteldünn 1,56</option>
            <option value="1.6">Dünn 1,60</option>
            <option value="1.67">Sehr dünn 1,67</option>
            <option value="1.74">Ultra dünn 1,74</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Mindestmittendicke (mm)</label>
          <input type="number" id="ldk-min" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" step="0.1" min="0.5">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mittendicke</div>
          <div class="text-5xl font-extrabold font-mono" id="ldk-result">0 mm</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="ldk-details"></div>
      </div>
      <ShareButton lang="de" calculatorId="linsendicke" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Brillenglas-Dicke verstehen</h2>
      <p>Die Dicke eines Brillenglases hängt von der Brechkraft (in Dioptrien), dem Glasdurchmesser und dem Brechungsindex des Materials ab. Minus-Gläser (für Kurzsichtigkeit) sind am Rand dicker, Plus-Gläser in der Mitte. Ein höherer Brechungsindex ermöglicht dünnere Gläser bei gleicher Korrekturleistung. Moderne Hochindex-Gläser (n=1,74) können bei starker Fehlsichtigkeit deutlich schlanker sein als Standard-Gläser (n=1,50).</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was bedeutet der Brechungsindex?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der Brechungsindex (n) beschreibt, wie stark ein Material Licht bricht. Je höher der Index, desto stärker die Brechung – und desto dünner kann das Glas bei gleicher Dioptrienzahl sein.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Ab wann lohnen sich Hochindex-Gläser?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ab einer Fehlsichtigkeit von ±3 Dioptrien empfehlen Optiker oft Hochindex-Gläser (1,60 oder höher). Bei starker Fehlsichtigkeit (ab ±6 dpt) sind dünne Gläser (1,67–1,74) sinnvoll.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Warum ist der Glasdurchmesser wichtig?</summary>
          <p class="mt-2 text-sm text-text-secondary">Größere Gläser sind bei Minusgläsern am Rand deutlich dicker. Kleinere Fassungen führen daher zu dünneren und leichteren Brillengläsern. Die Wahl der Fassung hat erheblichen Einfluss auf die Glasdicke.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist die Mindestmittendicke?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die Mindestmittendicke ist die kleinste erlaubte Glasdicke in der Mitte des Glases. Sie liegt typischerweise bei 1,0–2,0 mm und wird durch die mechanische Stabilität und Fassungsart begrenzt.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLdk() {
      const D = parseFloat((document.getElementById('ldk-dpt') as HTMLInputElement).value) || 0;
      const dia = parseFloat((document.getElementById('ldk-dia') as HTMLInputElement).value) || 65;
      const n = parseFloat((document.getElementById('ldk-n') as HTMLSelectElement).value) || 1.5;
      const minDick = parseFloat((document.getElementById('ldk-min') as HTMLInputElement).value) || 1.5;

      const r = dia / 2; // Halbdurchmesser in mm
      const f = (n - 1) * 1000 / D; // Brennweite in mm (aus Linsengleichung)
      const R = Math.abs(f) * (n - 1); // Krümmungsradius in mm

      // Pfeiltiefe (Sagitta): s = R - sqrt(R^2 - r^2)
      const sagitta = R > r ? R - Math.sqrt(R * R - r * r) : 0;

      let mittendicke: number;
      if (D < 0) {
        // Minusglas: Mittendicke = Mindestranddicke - Sagitta (vereinfacht)
        const randdicke = minDick + sagitta;
        mittendicke = minDick;
        const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('ldk-result')!.textContent = fmt(mittendicke) + ' mm';
        document.getElementById('ldk-details')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Randdicke</div><div class="text-lg font-bold font-mono">${fmt(randdicke)} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sagitta</div><div class="text-lg font-bold font-mono">${fmt(sagitta)} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krümmungsradius</div><div class="text-lg font-bold font-mono">${fmt(R)} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Glastyp</div><div class="text-lg font-bold">Minusglas</div></div>`;
      } else if (D > 0) {
        // Plusglas: Mittendicke = Mindestranddicke + Sagitta
        mittendicke = minDick + sagitta;
        const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('ldk-result')!.textContent = fmt(mittendicke) + ' mm';
        document.getElementById('ldk-details')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Randdicke</div><div class="text-lg font-bold font-mono">${fmt(minDick)} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sagitta</div><div class="text-lg font-bold font-mono">${fmt(sagitta)} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krümmungsradius</div><div class="text-lg font-bold font-mono">${fmt(R)} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Glastyp</div><div class="text-lg font-bold">Plusglas</div></div>`;
      } else {
        document.getElementById('ldk-result')!.textContent = '— mm';
        document.getElementById('ldk-details')!.innerHTML = '';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['ldk-dpt','ldk-dia','ldk-min'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcLdk);
      });
      document.getElementById('ldk-n')!.addEventListener('change', calcLdk);
      calcLdk();
    }, 50);
  </script>
</CalculatorLayout>
