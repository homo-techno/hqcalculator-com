---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Feldfläche-Rechner - Hektar, Ar & Einzäunung";
const description = "Berechnen Sie unregelmäßige Feldflächen aus Abmessungen. Umrechnung zwischen Hektar und Ar, Umfang und Zaunbedarf.";
const relatedCalcs = [
  { name: "Zaunpfosten-Rechner", url: "/de/zaunpfosten-rechner", description: "Pfostenabstand." },
  { name: "Zaun-Rechner", url: "/de/zaun-rechner", description: "Zaun-Material." },
  { name: "Dünger-Rechner", url: "/de/duenger-rechner", description: "Düngerbedarf." },
  { name: "Zaunlinie-Rechner", url: "/de/zaunlinie-rechner", description: "Zaunlinie." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Feldfläche-Rechner" lang="de" enSlug="field-area-calculator" keywords="feldfläche rechner, hektar berechnen, unregelmäßige feldfläche, zaun umfang, ackerfläche" breadcrumbs={[{ name: "Feldfläche", url: "/de/feldflaeche-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Feldfläche-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Feldfläche, konvertieren Sie Einheiten und schätzen Sie den Zaunbedarf.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Feldform</label>
          <select id="ffde-shape" class="ffde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="rect" selected>Rechteck</option>
            <option value="triangle">Dreieck</option>
            <option value="trapezoid">Trapez</option>
            <option value="circle">Kreis</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1" id="ffde-l1-label">Länge (Meter)</label><input type="number" id="ffde-l1" class="ffde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="300" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1" id="ffde-l2-label">Breite (Meter)</label><input type="number" id="ffde-l2" class="ffde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="150" min="1" step="1"></div>
        </div>
        <div id="ffde-l3-wrap">
          <label class="block text-xs font-medium text-text mb-1" id="ffde-l3-label">Zweite parallele Seite (Meter)</label>
          <input type="number" id="ffde-l3" class="ffde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="240" min="0" step="1">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zaunkosten (&euro;/Meter)</label><input type="number" id="ffde-fcost" class="ffde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tor&ouml;ffnungen</label><input type="number" id="ffde-gates" class="ffde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" max="20" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Feldfl&auml;che</div>
          <div class="text-5xl font-extrabold font-mono" id="ffde-area">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ar</div><div class="text-xl font-bold font-mono" id="ffde-ar">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">m&sup2;</div><div class="text-xl font-bold font-mono" id="ffde-sqm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Acres</div><div class="text-xl font-bold font-mono" id="ffde-acres">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umfang (m)</div><div class="text-xl font-bold font-mono" id="ffde-perim">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zaunkosten</div><div class="text-xl font-bold font-mono" id="ffde-fence">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="field-area-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Feldfläche berechnen</h2>
      <p>1 Hektar = 10.000 m&sup2; = 100 Ar. Die Umfangsberechnung hilft bei der Planung von Einzäunungen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie groß ist ein Hektar?</strong> 10.000 m&sup2; - etwa die Größe eines Fußballfelds (100 x 100 m).</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcFFDE() {
      const shape = (document.getElementById('ffde-shape') as HTMLSelectElement).value;
      const l1 = parseFloat((document.getElementById('ffde-l1') as HTMLInputElement).value) || 0;
      const l2 = parseFloat((document.getElementById('ffde-l2') as HTMLInputElement).value) || 0;
      const l3 = parseFloat((document.getElementById('ffde-l3') as HTMLInputElement).value) || 0;
      const fcost = parseFloat((document.getElementById('ffde-fcost') as HTMLInputElement).value) || 0;
      const gates = parseInt((document.getElementById('ffde-gates') as HTMLInputElement).value) || 0;
      const l3Wrap = document.getElementById('ffde-l3-wrap') as HTMLElement;
      const l1Label = document.getElementById('ffde-l1-label')!;
      const l2Label = document.getElementById('ffde-l2-label')!;
      const l3Label = document.getElementById('ffde-l3-label')!;
      let areaSqM = 0;
      let perimeter = 0;
      if (shape === 'rect') {
        l1Label.textContent = 'L\u00E4nge (Meter)'; l2Label.textContent = 'Breite (Meter)'; l3Wrap.style.display = 'none';
        areaSqM = l1 * l2; perimeter = 2 * (l1 + l2);
      } else if (shape === 'triangle') {
        l1Label.textContent = 'Basis (Meter)'; l2Label.textContent = 'H\u00F6he (Meter)'; l3Wrap.style.display = 'none';
        areaSqM = 0.5 * l1 * l2;
        const side = Math.sqrt((l1 / 2) * (l1 / 2) + l2 * l2);
        perimeter = l1 + 2 * side;
      } else if (shape === 'trapezoid') {
        l1Label.textContent = 'Seite A (Meter)'; l2Label.textContent = 'H\u00F6he (Meter)'; l3Label.textContent = 'Seite B (Meter)'; l3Wrap.style.display = 'block';
        areaSqM = 0.5 * (l1 + l3) * l2;
        const offset = Math.abs(l1 - l3) / 2;
        const leg = Math.sqrt(offset * offset + l2 * l2);
        perimeter = l1 + l3 + 2 * leg;
      } else {
        l1Label.textContent = 'Radius (Meter)'; l2Label.textContent = '(nicht verwendet)'; l3Wrap.style.display = 'none';
        areaSqM = Math.PI * l1 * l1; perimeter = 2 * Math.PI * l1;
      }
      const hectares = areaSqM / 10000;
      const ar = areaSqM / 100;
      const acres = hectares * 2.47105;
      const gateWidth = gates * 4;
      const fenceLength = Math.max(0, perimeter - gateWidth);
      const fenceCost = fenceLength * fcost;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('ffde-area')!.textContent = fmt(hectares) + ' ha';
      document.getElementById('ffde-ar')!.textContent = fmt(ar);
      document.getElementById('ffde-sqm')!.textContent = Math.round(areaSqM).toLocaleString('de-DE');
      document.getElementById('ffde-acres')!.textContent = fmt(acres);
      document.getElementById('ffde-perim')!.textContent = Math.round(perimeter).toLocaleString('de-DE');
      document.getElementById('ffde-fence')!.textContent = Math.round(fenceCost).toLocaleString('de-DE') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ffde-in').forEach(el => { el.addEventListener('input', calcFFDE); el.addEventListener('change', calcFFDE); });
      calcFFDE();
    }, 50);
  </script>
</CalculatorLayout>
