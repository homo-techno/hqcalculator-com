---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gewerbemiete-Rechner - Mietkosten f\u00fcr Gewerbefl\u00e4chen";
const description = "Berechnen Sie gewerbliche Mietkosten inklusive Nebenkosten, Betriebskosten und Grundsteuer. Vergleichen Sie Brutto- und Nettomiete.";
const relatedCalcs = [
  { name: "Anlagerechner", url: "/de/anlage-rechner", description: "Anlagen." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Budgetierung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gewerbemiete-Rechner" lang="de" enSlug="commercial-rent-calculator" keywords="gewerbemiete rechner, gewerbefl\u00e4che miete, nebenkosten, nettomiete, bruttomiete, mietkosten gewerbe" breadcrumbs={[{ name: "Gewerbemiete", url: "/de/gewerbemiete-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gewerbemiete-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die gesamten Mietkosten f&uuml;r Gewerbefl&auml;chen inklusive Grundmiete und Nebenkosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Fl&auml;che (m&sup2;)</label><input type="number" id="gm-sqm" class="gm-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="200" min="0" step="10"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Grundmiete (&euro; pro m&sup2; / Monat)</label><input type="number" id="gm-rate" class="gm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.5"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Mietart</label>
          <select id="gm-type" class="gm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="brutto" selected>Bruttomiete (inkl. NK)</option>
            <option value="netto">Nettomiete (zzgl. NK)</option>
            <option value="teilinkl">Teilinklusivmiete</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Betriebskosten (&euro; pro m&sup2; / Monat)</label><input type="number" id="gm-nk" class="gm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="0.5"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Grundsteuer (&euro; pro m&sup2; / Monat)</label><input type="number" id="gm-tax" class="gm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" min="0" step="0.5"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Versicherung (&euro; pro m&sup2; / Monat)</label><input type="number" id="gm-ins" class="gm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.5" min="0" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Gesamtmiete</div>
          <div class="text-5xl font-extrabold font-mono" id="gm-result">0 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Gesamtmiete</div><div class="text-xl font-bold font-mono" id="gm-annual">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Grundmiete</div><div class="text-xl font-bold font-mono" id="gm-base">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Nebenkosten</div><div class="text-xl font-bold font-mono" id="gm-addons">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt &euro;/m&sup2;/Monat</div><div class="text-xl font-bold font-mono" id="gm-total-psm">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="commercial-rent" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gewerbemiete verstehen</h2>
      <p>Bei der Gewerbemiete unterscheidet man zwischen Bruttomiete (alle Kosten inklusive), Nettomiete (zzgl. s&auml;mtlicher Nebenkosten) und Teilinklusivmiete. In Deutschland sind Nebenkosten bei Gewerbefl&auml;chen oft separat umgelegt und k&ouml;nnen erheblich variieren.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was sind typische Nebenkosten?</strong> Betriebskosten f&uuml;r Gewerbefl&auml;chen liegen meist zwischen 3-6 &euro;/m&sup2; pro Monat und umfassen Heizung, Wasser, M&uuml;llabfuhr, Reinigung und Versicherung.</p>
      <p><strong>Wie berechne ich die Gesamtmietbelastung?</strong> Addieren Sie Grundmiete, Betriebskosten, Grundsteuer und Versicherung pro m&sup2; und multiplizieren Sie mit der Fl&auml;che.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGM() {
      const sqm = parseFloat((document.getElementById('gm-sqm') as HTMLInputElement).value) || 0;
      const baseRate = parseFloat((document.getElementById('gm-rate') as HTMLInputElement).value) || 0;
      const leaseType = (document.getElementById('gm-type') as HTMLSelectElement).value;
      const nk = parseFloat((document.getElementById('gm-nk') as HTMLInputElement).value) || 0;
      const tax = parseFloat((document.getElementById('gm-tax') as HTMLInputElement).value) || 0;
      const ins = parseFloat((document.getElementById('gm-ins') as HTMLInputElement).value) || 0;

      const monthlyBase = sqm * baseRate;
      let monthlyAddons = 0;

      if (leaseType === 'netto') {
        monthlyAddons = sqm * (nk + tax + ins);
      } else if (leaseType === 'teilinkl') {
        monthlyAddons = sqm * nk;
      }

      const monthlyTotal = monthlyBase + monthlyAddons;
      const annualTotal = monthlyTotal * 12;
      const totalPerSqM = sqm > 0 ? monthlyTotal / sqm : 0;

      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC';
      document.getElementById('gm-result')!.textContent = fmt(monthlyTotal);
      document.getElementById('gm-annual')!.textContent = fmt(annualTotal);
      document.getElementById('gm-base')!.textContent = fmt(monthlyBase);
      document.getElementById('gm-addons')!.textContent = fmt(monthlyAddons);
      document.getElementById('gm-total-psm')!.textContent = totalPerSqM.toFixed(2).replace('.', ',') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gm-in').forEach(el => { el.addEventListener('input', calcGM); el.addEventListener('change', calcGM); });
      calcGM();
    }, 50);
  </script>
</CalculatorLayout>
