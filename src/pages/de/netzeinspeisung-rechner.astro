---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Netzeinspeisung Rechner - Einspeisevergütung & Solar-Ersparnisse";
const description = "Berechnen Sie Einspeisevergütung und Ersparnisse durch Solar-Netzeinspeisung für Ihre Photovoltaikanlage.";
const relatedCalcs = [
  { name: "Akkulaufzeit Rechner", url: "/de/akkulaufzeit-rechner", description: "Akkulaufzeit berechnen." },
  { name: "Netzwerk Verfügbarkeit", url: "/de/netzwerk-verfuegbarkeit-rechner", description: "Uptime berechnen." },
  { name: "Kapitalwert Rechner", url: "/de/kapitalwert-rechner", description: "Investitionen bewerten." },
  { name: "Nettovermögen Rechner", url: "/de/nettovermoegen-rechner", description: "Vermögen berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Netzeinspeisung Rechner" enSlug="net-metering-calculator" keywords="Netzeinspeisung, Einspeisevergütung, Photovoltaik, Solar, EEG-Vergütung, Solaranlage Ertrag" breadcrumbs={[{ name: "Netzeinspeisung Rechner", url: "/de/netzeinspeisung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Netzeinspeisung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihre jährliche Einspeisevergütung, Eigenverbrauchsersparnis und Gesamtertrag Ihrer Photovoltaikanlage.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anlagenleistung (kWp)</label><input type="number" id="ne-kwp" class="ne-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0.5" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Jahresertrag (kWh/kWp)</label><input type="number" id="ne-yield" class="ne-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="950" min="500" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eigenverbrauchsanteil (%)</label><input type="number" id="ne-selfuse" class="ne-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einspeisevergütung (Ct/kWh)</label><input type="number" id="ne-feedin" class="ne-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8.11" min="0" step="0.01"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (Ct/kWh)</label><input type="number" id="ne-price" class="ne-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Systemkosten (€)</label><input type="number" id="ne-cost" class="ne-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15000" min="0" step="500"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jährlicher Gesamtertrag</div>
          <div class="text-5xl font-extrabold font-mono" id="ne-result">0,00 €</div>
          <div class="text-sm text-blue-200 mt-1" id="ne-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einspeisevergütung p.a.</div><div class="text-xl font-bold" id="ne-feedinamt">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenverbrauchsersparnis p.a.</div><div class="text-xl font-bold" id="ne-savingamt">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Amortisationszeit</div><div class="text-xl font-bold" id="ne-payback">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahresproduktion</div><div class="text-xl font-bold" id="ne-kwh">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="netzeinspeisung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Photovoltaik und Netzeinspeisung in Deutschland</h2>
      <p>In Deutschland wird überschüssiger Solarstrom ins öffentliche Netz eingespeist und vergütet. Die Einspeisevergütung nach EEG wird für 20 Jahre garantiert und richtet sich nach dem Inbetriebnahmedatum. Anlagen bis 10 kWp erhalten 2024 ca. 8,11 Ct/kWh. Eigenverbrauch spart den vollen Strompreis.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Wie hoch ist die Einspeisevergütung 2024?</strong></p><p>Für neue Anlagen bis 10 kWp beträgt die Vergütung ca. 8,11 Ct/kWh für die Volleinspeisung und 12,87 Ct/kWh bei Anmeldung als Eigenverbrauchsanlage (Stand 2024).</p></div>
        <div><p><strong>Lohnt sich eine Photovoltaikanlage?</strong></p><p>Bei aktuellen Strompreisen von 25–35 Ct/kWh amortisiert sich eine Anlage typischerweise in 8–12 Jahren. Die Anlage produziert dann 10–15 Jahre kostenlosen Strom.</p></div>
        <div><p><strong>Was ist Eigenverbrauch?</strong></p><p>Eigenverbrauch ist der direkte Verbrauch des selbst erzeugten Solarstroms im Haushalt. Jede selbst verbrauchte kWh spart den vollen Strompreis.</p></div>
        <div><p><strong>Brauche ich einen Speicher?</strong></p><p>Ein Batteriespeicher erhöht den Eigenverbrauchsanteil von ca. 30% auf 60–70%, rechnet sich aber nur bei hohen Strompreisen und günstigen Speicherkosten.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcNE() {
      const kwp = parseFloat((document.getElementById('ne-kwp') as HTMLInputElement).value) || 0;
      const yieldPerKwp = parseFloat((document.getElementById('ne-yield') as HTMLInputElement).value) || 950;
      const selfUsePct = parseFloat((document.getElementById('ne-selfuse') as HTMLInputElement).value) || 30;
      const feedinCt = parseFloat((document.getElementById('ne-feedin') as HTMLInputElement).value) || 8.11;
      const priceCt = parseFloat((document.getElementById('ne-price') as HTMLInputElement).value) || 30;
      const systemCost = parseFloat((document.getElementById('ne-cost') as HTMLInputElement).value) || 0;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      const totalKwh = kwp * yieldPerKwp;
      const selfKwh = totalKwh * selfUsePct / 100;
      const feedinKwh = totalKwh - selfKwh;
      const feedinAmt = feedinKwh * feedinCt / 100;
      const savingAmt = selfKwh * priceCt / 100;
      const totalAmt = feedinAmt + savingAmt;
      const payback = totalAmt > 0 ? systemCost / totalAmt : 0;
      document.getElementById('ne-result')!.textContent = fmt(totalAmt) + ' €';
      document.getElementById('ne-sub')!.textContent = fmt(totalKwh, 0) + ' kWh/Jahr | ' + fmt(feedinKwh, 0) + ' kWh eingespeist';
      document.getElementById('ne-feedinamt')!.textContent = fmt(feedinAmt) + ' €';
      document.getElementById('ne-savingamt')!.textContent = fmt(savingAmt) + ' €';
      document.getElementById('ne-payback')!.textContent = payback > 0 ? fmt(payback, 1) + ' Jahre' : '—';
      document.getElementById('ne-kwh')!.textContent = fmt(totalKwh, 0) + ' kWh';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ne-in').forEach(el => { el.addEventListener('input', calcNE); el.addEventListener('change', calcNE); });
      calcNE();
    }, 50);
  </script>
</CalculatorLayout>
