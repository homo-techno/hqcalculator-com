---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "GPS Genauigkeit Rechner - PDOP, HDOP & Fehlerabschätzung";
const description = "Schätzen Sie die GPS-Positionsgenauigkeit aus PDOP-, HDOP- und VDOP-Werten sowie UERE. Berechnen Sie den 95%-Konfidenzkreisradius für Vermessungsplanung.";
const relatedCalcs = [
  { name: "Großkreis-Rechner", url: "/de/grosskreis-rechner", description: "Großkreis-Distanz." },
  { name: "Golf-Handicap-Rechner", url: "/de/golf-handicap-rechner", description: "Golf Handicap." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Noten berechnen." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies berechnen." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Glasfusing-Rechner", url: "/de/glasfusing-rechner", description: "Glasfusing-Brennpläne." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="GPS-Genauigkeit-Rechner" enSlug="gps-accuracy-calculator" keywords="GPS Genauigkeit, PDOP, HDOP, VDOP, Positionsfehler, UERE, GPS Vermessung, Konfidenzkreis" breadcrumbs={[{ name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">GPS-Genauigkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die horizontale und vertikale Positionsgenauigkeit aus DOP-Werten (Dilution of Precision) und dem User Equivalent Range Error (UERE).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">HDOP</label>
            <input type="number" id="gpsa-hdop" class="gpsa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.2" step="0.1" min="0.1">
          </div>
          <div>
            <label class="block text-sm font-semibold text-text mb-1">VDOP</label>
            <input type="number" id="gpsa-vdop" class="gpsa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.8" step="0.1" min="0.1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">UERE - User Equivalent Range Error (m)</label>
          <input type="number" id="gpsa-uere" class="gpsa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6.0" step="0.1" min="0.1">
          <p class="text-xs text-text-muted mt-1">Typisch: ~6 m zivil, ~1 m SBAS, 0,01-0,02 m RTK</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Anzahl Satelliten</label>
          <input type="number" id="gpsa-sats" class="gpsa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="4" max="30">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Horizontale Genauigkeit (1-Sigma)</div>
          <div class="text-5xl font-extrabold font-mono" id="gpsa-hacc">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Vertikale Genauigkeit (1-Sigma)</div>
            <div class="text-xl font-bold" id="gpsa-vacc">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">3D-Genauigkeit (PDOP)</div>
            <div class="text-xl font-bold" id="gpsa-3d">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">95% Horiz. Konfidenz</div>
            <div class="text-xl font-bold" id="gpsa-h95">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">95% Vert. Konfidenz</div>
            <div class="text-xl font-bold" id="gpsa-v95">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">PDOP</div>
          <div class="text-xl font-bold" id="gpsa-pdop">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">DOP-Qualitätsbewertung</div>
          <div class="text-xl font-bold" id="gpsa-rating">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gps-accuracy" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">GPS-Genauigkeitsschätzung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Horizontaler Fehler = HDOP x UERE</p>
        <p>Vertikaler Fehler = VDOP x UERE</p>
        <p>PDOP = sqrt(HDOP^2 + VDOP^2)</p>
        <p>95%-Konfidenz = 1,96 x Sigma</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist HDOP?</strong> HDOP (Horizontal Dilution of Precision) beschreibt, wie die Satellitengeometrie die horizontale Positionsgenauigkeit beeinflusst. Niedrigere Werte bedeuten bessere Genauigkeit.</p>
      <p><strong>Was ist ein guter PDOP-Wert?</strong> Ein PDOP unter 2 gilt als ausgezeichnet, unter 5 als gut. Über 10 ist die Genauigkeit für präzise Anwendungen unzureichend.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcGPSA() {
      const hdop = parseFloat((document.getElementById('gpsa-hdop') as HTMLInputElement).value) || 1;
      const vdop = parseFloat((document.getElementById('gpsa-vdop') as HTMLInputElement).value) || 1;
      const uere = parseFloat((document.getElementById('gpsa-uere') as HTMLInputElement).value) || 6;
      const sats = parseInt((document.getElementById('gpsa-sats') as HTMLInputElement).value) || 8;
      const pdop = Math.sqrt(hdop * hdop + vdop * vdop);
      const hErr = hdop * uere;
      const vErr = vdop * uere;
      const err3d = pdop * uere;
      const h95 = hErr * 1.96;
      const v95 = vErr * 1.96;
      let rating = '';
      if (pdop <= 1) rating = 'Ideal';
      else if (pdop <= 2) rating = 'Ausgezeichnet';
      else if (pdop <= 5) rating = 'Gut';
      else if (pdop <= 10) rating = 'Mittel';
      else if (pdop <= 20) rating = 'Schwach';
      else rating = 'Schlecht';
      document.getElementById('gpsa-hacc')!.textContent = hErr.toFixed(2) + ' m';
      document.getElementById('gpsa-vacc')!.textContent = vErr.toFixed(2) + ' m';
      document.getElementById('gpsa-3d')!.textContent = err3d.toFixed(2) + ' m';
      document.getElementById('gpsa-h95')!.textContent = h95.toFixed(2) + ' m';
      document.getElementById('gpsa-v95')!.textContent = v95.toFixed(2) + ' m';
      document.getElementById('gpsa-pdop')!.textContent = pdop.toFixed(2);
      document.getElementById('gpsa-rating')!.textContent = rating + ' (' + sats + ' Sats)';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gpsa-in').forEach(el => { el.addEventListener('input', calcGPSA); el.addEventListener('change', calcGPSA); });
      calcGPSA();
    }, 50);
  </script>
</CalculatorLayout>
