---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Feuerstelle-Rechner - Steine, Abdeckung & Kies-Schätzer";
const description = "Berechnen Sie Feuerstellen-Materialien nach Durchmesser, Höhe und Wandtyp. Stein-/Blockanzahl, Abdecksteine, Kiesbasis und Feuerring-Größe.";
const relatedCalcs = [
  { name: "Zaun-Rechner", url: "/de/zaun-rechner", description: "Zaun-Material." },
  { name: "Zaunpfosten-Rechner", url: "/de/zaunpfosten-rechner", description: "Pfostenabstand." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
  { name: "Feuer-Rechner", url: "/de/feuer-rechner", description: "FIRE-Rechner." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Feuerstelle-Rechner" lang="de" enSlug="fire-pit-calculator" keywords="feuerstelle rechner, feuerstelle steine, feuerstelle blöcke, feuerring, feuerstelle kies, abdecksteine, feuerstelle materialien" breadcrumbs={[{ name: "Feuerstelle-Rechner", url: "/de/feuerstelle-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Feuerstelle-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Materialien f&uuml;r den Bau einer runden Feuerstelle inkl. St&uuml;tzmauerst&uuml;cke, Abdecksteine und Kies.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div><label class="block text-xs font-medium text-text mb-1">Innendurchmesser (m)</label><input type="number" id="fsde-diameter" class="fsde-in w-full px-3 py-3 border border-border rounded-xl text-lg" value="1.2" min="0.6" max="2.4" step="0.1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Wandh&ouml;he (cm)</label><input type="number" id="fsde-height" class="fsde-in w-full px-3 py-3 border border-border rounded-xl text-lg" value="30" min="15" max="90" step="1"></div>
          </div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Wandst&auml;rke (cm)</label>
            <select id="fsde-thickness" class="fsde-in w-full px-3 py-3 border border-border rounded-xl text-lg">
              <option value="10">10 cm (Einzelblock)</option>
              <option value="15" selected>15 cm (Standard)</option>
              <option value="20">20 cm (dicke Wand)</option>
              <option value="30">30 cm (Doppelwand)</option>
            </select>
          </div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Wandmaterial</label>
            <select id="fsde-material" class="fsde-in w-full px-3 py-3 border border-border rounded-xl text-lg">
              <option value="block" selected>St&uuml;tzmauerstein (30x10x15 cm)</option>
              <option value="stone">Naturstein (ca. 20x15 cm)</option>
              <option value="brick">Schamottestein (23x11x6 cm)</option>
            </select>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <label class="block text-xs font-medium text-text mb-1">Kiesbasis-Tiefe (cm)</label>
            <input type="number" id="fsde-gravel" class="fsde-in w-full px-3 py-2 border border-border rounded-lg" value="15" min="5" max="30" step="1">
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Steine / Bl&ouml;cke</div>
            <div class="text-5xl font-extrabold font-mono" id="fsde-blocks">0</div>
            <div class="text-sm text-blue-200 mt-1" id="fsde-unitlabel">St&uuml;tzmauersteine</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abdecksteine</div><div class="text-xl font-bold" id="fsde-caps">0</div><div class="text-xs text-text-muted">f&uuml;r obere Reihe</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reihen / Schichten</div><div class="text-xl font-bold" id="fsde-rows">0</div></div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kies ben&ouml;tigt</div><div class="text-xl font-bold" id="fsde-gravelamt">0 Liter</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Feuerring-Gr&ouml;&szlig;e</div><div class="text-xl font-bold" id="fsde-ring">--</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Au&szlig;endurchmesser</div>
            <div class="text-xl font-bold" id="fsde-outsidedia">0 m</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="fire-pit-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Feuerstelle-Materialien berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Umfang:</strong> Pi &times; Innendurchmesser</p>
        <p><strong>Steine pro Reihe:</strong> Umfang / Steinbreite</p>
        <p><strong>Reihen:</strong> Wandhöhe / Steinhöhe</p>
        <p><strong>Gesamt:</strong> Steine pro Reihe &times; Reihen</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Tipps zum Bau einer Feuerstelle</h3>
      <ul>
        <li><strong>Standort:</strong> Mindestens 3-6 Meter von Geb&auml;uden entfernt</li>
        <li><strong>Basis:</strong> 15 cm Kies f&uuml;r Drainage, 30 cm &uuml;ber die W&auml;nde hinaus</li>
        <li><strong>Feuerring-Einsatz:</strong> Sch&uuml;tzt die Steine vor direkter Hitze</li>
        <li><strong>Abdecksteine:</strong> Mit Kleber auf der oberen Reihe fixieren</li>
      </ul>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Brauche ich eine Genehmigung?</strong> In vielen Gemeinden ist f&uuml;r offene Feuerstellen eine Genehmigung erforderlich. Informieren Sie sich bei Ihrer Gemeinde.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const fsdeSizes: Record<string, { w: number; h: number }> = {
      block: { w: 30, h: 10 },
      stone: { w: 20, h: 15 },
      brick: { w: 23, h: 6 },
    };
    const fsdeLabels: Record<string, string> = {
      block: 'St\u00FCtzmauersteine',
      stone: 'Natursteine (Durchschnitt)',
      brick: 'Schamottesteine',
    };
    function calcFSDE() {
      const insideDiaM = parseFloat((document.getElementById('fsde-diameter') as HTMLInputElement).value) || 1.2;
      const wallHeightCm = parseFloat((document.getElementById('fsde-height') as HTMLInputElement).value) || 30;
      const thicknessCm = parseFloat((document.getElementById('fsde-thickness') as HTMLSelectElement).value) || 15;
      const material = (document.getElementById('fsde-material') as HTMLSelectElement).value;
      const gravelDepthCm = parseFloat((document.getElementById('fsde-gravel') as HTMLInputElement).value) || 15;
      const insideDiaCm = insideDiaM * 100;
      const outsideDiaCm = insideDiaCm + 2 * thicknessCm;
      const outsideDiaM = outsideDiaCm / 100;
      const midCircumCm = Math.PI * (insideDiaCm + thicknessCm);
      const matSize = fsdeSizes[material] || fsdeSizes.block;
      const blocksPerRow = Math.ceil(midCircumCm / matSize.w);
      const rows = Math.ceil(wallHeightCm / matSize.h);
      const totalBlocks = blocksPerRow * rows;
      const capStones = blocksPerRow;
      const gravelDiaCm = outsideDiaCm + 60;
      const gravelAreaSqCm = Math.PI * Math.pow(gravelDiaCm / 2, 2);
      const gravelCuCm = gravelAreaSqCm * gravelDepthCm;
      const gravelLiters = gravelCuCm / 1000;
      let ringSize = '--';
      if (insideDiaCm <= 75) ringSize = '60 cm Einsatz';
      else if (insideDiaCm <= 95) ringSize = '75 cm Einsatz';
      else if (insideDiaCm <= 110) ringSize = '90 cm Einsatz';
      else if (insideDiaCm <= 130) ringSize = '105 cm Einsatz';
      else ringSize = '120 cm Einsatz';
      document.getElementById('fsde-blocks')!.textContent = String(totalBlocks);
      document.getElementById('fsde-unitlabel')!.textContent = fsdeLabels[material] || 'Steine';
      document.getElementById('fsde-caps')!.textContent = String(capStones);
      document.getElementById('fsde-rows')!.textContent = String(rows);
      document.getElementById('fsde-gravelamt')!.textContent = Math.round(gravelLiters).toLocaleString('de-DE') + ' Liter';
      document.getElementById('fsde-ring')!.textContent = ringSize;
      document.getElementById('fsde-outsidedia')!.textContent = outsideDiaM.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('#fsde-diameter, #fsde-height, #fsde-gravel').forEach(el => { el.addEventListener('input', calcFSDE); el.addEventListener('change', calcFSDE); });
      document.querySelectorAll('#fsde-thickness, #fsde-material').forEach(el => { el.addEventListener('input', calcFSDE); el.addEventListener('change', calcFSDE); });
      calcFSDE();
    }, 50);
  </script>
</CalculatorLayout>
