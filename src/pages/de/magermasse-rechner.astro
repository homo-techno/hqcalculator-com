---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Magermasse Rechner";
const description = "Berechnen Sie Ihre Magermasse (LBM) nach Boer, James und Hume.";

const relatedCalcs = [
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Gewichtsziele planen." },
  { name: "A1C-Rechner", url: "/de/a1c-rechner", description: "HbA1c Wert berechnen." },
  { name: "Sprachlernrechner", url: "/de/sprachlern-rechner", description: "Lernzeit berechnen." },
  { name: "Lernkurvenrechner", url: "/de/lernkurven-rechner", description: "Lernfortschritt analysieren." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Magermasse Rechner" lang="de" enSlug="lean-body-mass-calculator" keywords="magermasse rechner, lean body mass berechnen, körperzusammensetzung, fettfreie masse" breadcrumbs={[{ name: "Magermasse Rechner", url: "/de/magermasse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Magermasse Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihre fettfreie Körpermasse (Lean Body Mass, LBM) nach den Formeln von Boer, James und Hume.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Geschlecht</label><select id="mmr-sex" class="mmr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="m" selected>Männlich</option>
            <option value="f">Weiblich</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Körpergröße (cm)</label><input type="number" id="mmr-height" class="mmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="175" min="100" max="250" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Körpergewicht (kg)</label><input type="number" id="mmr-weight" class="mmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="30" max="300" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Magermasse (Boer-Formel)</div>
          <div class="text-4xl font-extrabold font-mono" id="mmr-boer">0 kg</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">James (kg)</div><div class="text-xl font-bold" id="mmr-james">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hume (kg)</div><div class="text-xl font-bold" id="mmr-hume">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Körperfett (%)</div><div class="text-xl font-bold" id="mmr-fat">0 %</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase mb-1">Einordnung</div>
          <div class="text-lg font-semibold" id="mmr-category">–</div>
        </div>
      </div>
      <ShareButton calculatorId="lean-body-mass-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Magermasse – Was ist LBM?</h2>
      <p>Die Magermasse (Lean Body Mass, LBM) ist das Körpergewicht abzüglich des Körperfetts. Sie umfasst Muskeln, Knochen, Organe, Wasser und Bindegewebe. Ein hoher LBM-Anteil ist ein Zeichen guter körperlicher Fitness und fördert einen höheren Grundumsatz. Zur Berechnung der LBM gibt es mehrere Formeln, die auf Größe und Gewicht basieren. Die Boer-Formel gilt als besonders präzise für Erwachsene.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Boer (Mann):</strong> LBM = 0,407 × Gewicht + 0,267 × Größe − 19,2</p>
        <p><strong>Boer (Frau):</strong> LBM = 0,252 × Gewicht + 0,473 × Größe − 48,3</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Magermasse und Muskelmasse?</strong> Muskelmasse ist ein Teil der Magermasse. Die Magermasse umfasst alle körperfettfreien Gewebe: Muskeln, Knochen, Wasser, Organe.</p>
      <p><strong>Wie genau sind die LBM-Formeln?</strong> Die Formeln sind Schätzungen auf Basis von Größe und Gewicht. Für genaue Werte ist eine DEXA-Messung oder Bioimpedanzanalyse empfehlenswert.</p>
      <p><strong>Wie viel Körperfett ist normal?</strong> Männer: 10–20 % (athletisch 6–13 %), Frauen: 20–30 % (athletisch 14–20 %).</p>
      <p><strong>Warum ist die Magermasse wichtig?</strong> Eine höhere Magermasse bedeutet mehr Muskeln, die den Grundumsatz erhöhen. Das erleichtert Gewichtsmanagement und verbessert allgemeine Gesundheitsindikatoren.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcMMR() {
      const sex = (document.getElementById('mmr-sex') as HTMLSelectElement).value;
      const height = parseFloat((document.getElementById('mmr-height') as HTMLInputElement).value) || 0;
      const weight = parseFloat((document.getElementById('mmr-weight') as HTMLInputElement).value) || 0;
      let boer: number, james: number, hume: number;
      if (sex === 'm') {
        boer = 0.407 * weight + 0.267 * height - 19.2;
        james = 1.1 * weight - 128 * Math.pow(weight / height, 2);
        hume = 0.3281 * weight + 0.3393 * height - 29.5336;
      } else {
        boer = 0.252 * weight + 0.473 * height - 48.3;
        james = 1.07 * weight - 148 * Math.pow(weight / height, 2);
        hume = 0.2969 * weight + 0.4135 * height - 43.0745;
      }
      const fat = weight > 0 ? ((weight - boer) / weight * 100) : 0;
      let category = '–';
      if (sex === 'm') {
        if (fat < 6) category = 'Essentieller Fettanteil';
        else if (fat < 14) category = 'Athletisch';
        else if (fat < 18) category = 'Fit';
        else if (fat < 25) category = 'Normal';
        else category = 'Übergewicht';
      } else {
        if (fat < 14) category = 'Essentieller Fettanteil';
        else if (fat < 21) category = 'Athletisch';
        else if (fat < 25) category = 'Fit';
        else if (fat < 32) category = 'Normal';
        else category = 'Übergewicht';
      }
      const fmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('mmr-boer')!.textContent = fmt(boer) + ' kg';
      document.getElementById('mmr-james')!.textContent = fmt(james);
      document.getElementById('mmr-hume')!.textContent = fmt(hume);
      document.getElementById('mmr-fat')!.textContent = fmt(fat) + ' %';
      document.getElementById('mmr-category')!.textContent = category;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.mmr-in').forEach(el => { el.addEventListener('input', calcMMR); el.addEventListener('change', calcMMR); }); calcMMR(); }, 50);
  </script>
</CalculatorLayout>
