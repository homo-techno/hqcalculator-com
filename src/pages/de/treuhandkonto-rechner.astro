---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Treuhandkonto-Rechner - Monatliche Nebenkosten sch\u00e4tzen";
const description = "Berechnen Sie Ihre monatliche Treuhandzahlung inkl. Grundsteuer, Wohngeb\u00e4udeversicherung und Nebenkosten.";
const relatedCalcs = [
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallreserve." },
  { name: "Mitarbeiterfluktuation", url: "/de/mitarbeiterfluktuation-rechner", description: "Fluktuationskosten." },
  { name: "Energieaudit-Rechner", url: "/de/energieaudit-rechner", description: "Energieeffizienz." },
  { name: "Stromverbrauch-Rechner", url: "/de/stromverbrauch-rechner", description: "Stromkosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Treuhandkonto-Rechner" lang="de" enSlug="escrow-calculator" keywords="treuhandkonto rechner, hausgeld, nebenkosten, grundsteuer, wohngeb\u00e4udeversicherung, monatliche belastung" breadcrumbs={[{ name: "Treuhandkonto", url: "/de/treuhandkonto-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Treuhandkonto-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihre monatliche Nebenkosten-R&uuml;cklage f&uuml;r Steuern, Versicherung und mehr.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Grundsteuer (&euro;)</label><input type="number" id="tkde-tax" class="tkde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1200" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Versicherung (&euro;)</label><input type="number" id="tkde-ins" class="tkde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="800" min="0" step="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Monatl. Instandhaltungsr&uuml;cklage (&euro;)</label><input type="number" id="tkde-maint" class="tkde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Monatl. Hausgeld/WEG (&euro;)</label><input type="number" id="tkde-hoa" class="tkde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="10"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Monatliche Kreditrate (Tilgung + Zinsen, &euro;)</label><input type="number" id="tkde-pi" class="tkde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1200" min="0" step="10"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Gesamtbelastung</div>
          <div class="text-5xl font-extrabold font-mono" id="tkde-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Nebenkosten</div><div class="text-2xl font-bold" id="tkde-escrow">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Nebenkosten</div><div class="text-2xl font-bold" id="tkde-annual">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Steuer/Monat</div><div class="text-xl font-bold" id="tkde-taxmo">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Versicherung/Monat</div><div class="text-xl font-bold" id="tkde-insmo">0 &euro;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Kostenaufteilung</h3>
          <div class="space-y-2" id="tkde-bars"></div>
        </div>
      </div>
      <ShareButton calculatorId="escrow-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wohnnebenkosten verstehen</h2>
      <p>Als Immobilienbesitzer fallen neben der Kreditrate weitere monatliche Kosten an: Grundsteuer, Geb&auml;udeversicherung, Instandhaltungsr&uuml;cklage und ggf. WEG-Hausgeld. Eine realistische Planung aller Kosten sch&uuml;tzt vor &Uuml;berraschungen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie hoch sollte die Instandhaltungsr&uuml;cklage sein?</strong> Als Faustregel gelten 1-2 &euro; pro m&sup2; Wohnfl&auml;che pro Monat, je nach Alter und Zustand der Immobilie.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcTKDE() {
      const tax = parseFloat((document.getElementById('tkde-tax') as HTMLInputElement).value) || 0;
      const ins = parseFloat((document.getElementById('tkde-ins') as HTMLInputElement).value) || 0;
      const maint = parseFloat((document.getElementById('tkde-maint') as HTMLInputElement).value) || 0;
      const hoa = parseFloat((document.getElementById('tkde-hoa') as HTMLInputElement).value) || 0;
      const pi = parseFloat((document.getElementById('tkde-pi') as HTMLInputElement).value) || 0;
      const taxMo = tax / 12;
      const insMo = ins / 12;
      const escrow = taxMo + insMo + maint + hoa;
      const total = pi + escrow;
      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('tkde-total')!.textContent = fmtEur(total);
      document.getElementById('tkde-escrow')!.textContent = fmtEur(escrow);
      document.getElementById('tkde-annual')!.textContent = fmtEur(escrow * 12);
      document.getElementById('tkde-taxmo')!.textContent = fmtEur(taxMo);
      document.getElementById('tkde-insmo')!.textContent = fmtEur(insMo);
      const items = [
        ['Kreditrate', pi, '#3B82F6'],
        ['Grundsteuer', taxMo, '#10B981'],
        ['Versicherung', insMo, '#F59E0B'],
        ['Instandhaltung', maint, '#EF4444'],
        ['Hausgeld/WEG', hoa, '#8B5CF6'],
      ].filter(([, v]) => (v as number) > 0);
      document.getElementById('tkde-bars')!.innerHTML = items.map(([label, val, color]) => {
        const pct = total > 0 ? ((val as number) / total * 100) : 0;
        return '<div class="flex items-center gap-2"><div class="w-28 text-xs text-text-muted">' + label + '</div><div class="flex-1 h-5 bg-gray-100 rounded-full overflow-hidden"><div class="h-full rounded-full" style="width:' + pct + '%;background:' + color + '"></div></div><div class="w-24 text-right text-xs font-bold">' + Math.round(val as number).toLocaleString('de-DE') + ' \u20AC (' + pct.toFixed(0) + '%)</div></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.tkde-in').forEach(el => el.addEventListener('input', calcTKDE)); calcTKDE(); }, 50);
  </script>
</CalculatorLayout>
