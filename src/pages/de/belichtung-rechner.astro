---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Belichtung-Rechner - Belichtungsdreieck, EV & ND-Filter";
const description = "Berechnen Sie \u00e4quivalente Belichtungen mit dem Belichtungsdreieck (ISO, Blende, Verschlusszeit). EV-Werte, Reziprozit\u00e4t und ND-Filter-Stufen.";

const relatedCalcs = [
  { name: "Sch\u00e4rfentiefe-Rechner", url: "/de/schaerfentiefe-rechner", description: "Sch\u00e4rfentiefe." },
  { name: "Kamera-Sensor-Rechner", url: "/de/kamera-sensor-rechner", description: "Sensorgr\u00f6\u00dfen." },
  { name: "Brennweite-Rechner", url: "/de/brennweite-rechner", description: "Brennweiten." },
  { name: "Zeitraffer-Rechner", url: "/de/zeitraffer-rechner", description: "Zeitraffer-Intervalle." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Belichtung-Rechner" lang="de" enSlug="exposure-calculator" keywords="belichtungsrechner, belichtungsdreieck, ev wert, nd filter stufen, iso, blende, verschlusszeit" breadcrumbs={[{ name: "Belichtung-Rechner", url: "/de/belichtung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Belichtung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie &auml;quivalente Belichtungen, EV-Werte und ND-Filter-Anpassungen mit dem Belichtungsdreieck.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Aktuelle Belichtungseinstellungen</h3>
        <div>
          <label class="block text-sm font-medium text-text mb-1">ISO</label>
          <select id="blr-iso" class="blr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="50">50</option>
            <option value="100" selected>100</option>
            <option value="200">200</option>
            <option value="400">400</option>
            <option value="800">800</option>
            <option value="1600">1600</option>
            <option value="3200">3200</option>
            <option value="6400">6400</option>
            <option value="12800">12800</option>
            <option value="25600">25600</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Blende (f/)</label>
          <select id="blr-aperture" class="blr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">1,0</option>
            <option value="1.4">1,4</option>
            <option value="2">2,0</option>
            <option value="2.8" selected>2,8</option>
            <option value="4">4,0</option>
            <option value="5.6">5,6</option>
            <option value="8">8,0</option>
            <option value="11">11</option>
            <option value="16">16</option>
            <option value="22">22</option>
            <option value="32">32</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Verschlusszeit</label>
          <select id="blr-shutter" class="blr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.00025">1/4000</option>
            <option value="0.0005">1/2000</option>
            <option value="0.001">1/1000</option>
            <option value="0.002">1/500</option>
            <option value="0.004">1/250</option>
            <option value="0.008" selected>1/125</option>
            <option value="0.01667">1/60</option>
            <option value="0.03333">1/30</option>
            <option value="0.06667">1/15</option>
            <option value="0.125">1/8</option>
            <option value="0.25">1/4</option>
            <option value="0.5">1/2</option>
            <option value="1">1s</option>
            <option value="2">2s</option>
            <option value="4">4s</option>
            <option value="8">8s</option>
            <option value="15">15s</option>
            <option value="30">30s</option>
            <option value="60">60s</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">ND-Filter (Blendenstufen)</label>
          <select id="blr-nd" class="blr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0" selected>Keiner</option>
            <option value="1">ND2 (1 Stufe)</option>
            <option value="2">ND4 (2 Stufen)</option>
            <option value="3">ND8 (3 Stufen)</option>
            <option value="4">ND16 (4 Stufen)</option>
            <option value="6">ND64 (6 Stufen)</option>
            <option value="10">ND1000 (10 Stufen)</option>
          </select>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Belichtungswert (EV)</div>
          <div class="text-4xl font-extrabold" id="blr-ev"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Lichtwert (LV)</div><div class="text-xl font-bold text-text" id="blr-lv"></div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Mit ND: Neue Verschl.zeit</div><div class="text-xl font-bold text-text" id="blr-nd-shutter"></div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Beleuchtungsst&auml;rke (Lux)</div><div class="text-xl font-bold text-text" id="blr-lux"></div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Szenenbeschreibung</div><div class="text-xl font-bold text-text" id="blr-scene"></div></div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h4 class="font-semibold text-sm text-text mb-2">&Auml;quivalente Belichtungen (gleicher EV)</h4>
          <div class="text-sm text-text-secondary space-y-1" id="blr-equiv"></div>
        </div>
      </div>
      <ShareButton calculatorId="exposure-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Belichtung verstehen</h2>
      <p>Das Belichtungsdreieck besteht aus ISO, Blende und Verschlusszeit. Jede Blendenstufe verdoppelt oder halbiert die Lichtmenge auf dem Sensor.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der EV-Wert?</strong> EV ist eine Zahl, die eine Kombination aus Blende und Verschlusszeit bei ISO 100 darstellt. EV 0 entspricht f/1,0 bei 1 Sekunde.</p>
      <p><strong>Wof&uuml;r brauche ich einen ND-Filter?</strong> ND-Filter reduzieren die Lichtmenge, erm&ouml;glichen l&auml;ngere Verschlusszeiten bei hellem Licht (z.B. f&uuml;r Langzeitbelichtungen).</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBLR() {
      const iso = parseFloat((document.getElementById('blr-iso') as HTMLSelectElement).value);
      const aperture = parseFloat((document.getElementById('blr-aperture') as HTMLSelectElement).value);
      const shutter = parseFloat((document.getElementById('blr-shutter') as HTMLSelectElement).value);
      const ndStops = parseInt((document.getElementById('blr-nd') as HTMLSelectElement).value);

      const ev100 = Math.log2(aperture * aperture / shutter);
      const lv = ev100;

      document.getElementById('blr-ev')!.textContent = 'EV ' + ev100.toFixed(1).replace('.', ',');
      document.getElementById('blr-lv')!.textContent = 'LV ' + lv.toFixed(1).replace('.', ',');

      const lux = 2.5 * Math.pow(2, ev100);
      document.getElementById('blr-lux')!.textContent = lux >= 1000 ? (lux / 1000).toFixed(1).replace('.', ',') + 'k' : lux.toFixed(0);

      let scene = '';
      if (ev100 >= 15) scene = 'Helle Sonne auf Schnee';
      else if (ev100 >= 14) scene = 'Helles Tageslicht';
      else if (ev100 >= 12) scene = 'Tageslicht, bew\u00F6lkt';
      else if (ev100 >= 10) scene = 'Schatten / wolkig';
      else if (ev100 >= 8) scene = 'Goldene Stunde';
      else if (ev100 >= 5) scene = 'Innenraum, hell';
      else if (ev100 >= 3) scene = 'Innenraum, dunkel';
      else if (ev100 >= 0) scene = 'D\u00E4mmerung';
      else scene = 'Nacht / Sterne';
      document.getElementById('blr-scene')!.textContent = scene;

      const ndShutter = shutter * Math.pow(2, ndStops);
      function fmtShutter(s: number): string {
        if (s < 1) {
          const denom = Math.round(1 / s);
          return '1/' + denom + 's';
        }
        if (s < 60) return s.toFixed(1).replace('.', ',') + 's';
        const m = Math.floor(s / 60);
        const sec = Math.round(s % 60);
        return m + 'min ' + sec + 's';
      }
      document.getElementById('blr-nd-shutter')!.textContent = ndStops === 0 ? 'N/A' : fmtShutter(ndShutter);

      const equivEl = document.getElementById('blr-equiv')!;
      const equivPairs = [
        { a: 1.4, label: 'f/1,4' },
        { a: 2.8, label: 'f/2,8' },
        { a: 5.6, label: 'f/5,6' },
        { a: 8, label: 'f/8' },
        { a: 11, label: 'f/11' },
        { a: 16, label: 'f/16' },
      ];
      let html = '';
      equivPairs.forEach(p => {
        const eqShutter = (p.a * p.a) / Math.pow(2, ev100);
        html += '<div>' + p.label + ' @ ' + fmtShutter(eqShutter) + ' (ISO ' + iso + ')</div>';
      });
      equivEl.innerHTML = html;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.blr-in').forEach(el => {
        el.addEventListener('input', calcBLR);
        el.addEventListener('change', calcBLR);
      });
      calcBLR();
    }, 50);
  </script>
</CalculatorLayout>
