---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Unternehmensgründung-Rechner - GmbH, UG & AG Kosten";
const description = "Berechnen Sie die Kosten für die Gründung einer GmbH, UG (haftungsbeschränkt) oder AG in Deutschland, einschließlich Notargebühren, Handelsregister und jährliche Anforderungen.";
const relatedCalcs = [
  { name: "Compliance-Kosten-Rechner", url: "/compliance-cost-calculator", description: "Jährliche Compliance-Kosten." },
  { name: "Markenrechts-Rechner", url: "/trademark-cost-calculator", description: "Marke schützen." },
  { name: "Rechtskosten-Rechner", url: "/legal-fee-calculator", description: "Anwaltskosten." },
  { name: "Einkommensteuer-Rechner", url: "/de/einkommensteuer-rechner", description: "Steuerschätzung." },
  { name: "Investitionsrechner", url: "/de/anlagerechner", description: "Kapitalwachstum." },
  { name: "Inflationsrechner", url: "/de/inflationsrechner", description: "Inflationsberechnungen." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet eine GmbH-Gründung in Deutschland?",
      "acceptedAnswer": { "@type": "Answer", "text": "Eine GmbH-Gründung kostet typischerweise 500–2.000 € für Notar und Handelsregistereintragung. Dazu kommt das Stammkapital von mindestens 25.000 € (mindestens 12.500 € bei Gründung). Eine UG kann bereits ab 1 € Stammkapital gegründet werden." }
    },
    {
      "@type": "Question",
      "name": "Was ist der Unterschied zwischen GmbH und UG?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die GmbH erfordert mindestens 25.000 € Stammkapital, bietet aber vollständigen Haftungsschutz. Die UG (haftungsbeschränkt) kann mit minimalem Kapital gegründet werden, muss aber 25 % des Jahresgewinns bis zum Erreichen des GmbH-Stammkapitals zurücklegen." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Unternehmensgründung-Rechner" lang="de" keywords="unternehmensgründung rechner, gmbh kosten, ug gründung, ag gründung, handelsregister, notargebühren, gesellschaftsgründung" breadcrumbs={[{ name: "Unternehmensgründung-Rechner", url: "/de/unternehmensgruendung-rechner" }]} enSlug="incorporation-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Unternehmensgründung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geschätzte Gründungskosten nach Unternehmensform in Deutschland berechnen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Unternehmensform</label>
          <select id="ug-type" class="ug-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="gmbh" selected>GmbH (Gesellschaft mit beschränkter Haftung)</option>
            <option value="ug">UG (Unternehmergesellschaft haftungsbeschränkt)</option>
            <option value="ag">AG (Aktiengesellschaft)</option>
            <option value="kg">KG / GmbH & Co. KG</option>
            <option value="einzelunternehmen">Einzelunternehmen / Freiberufler</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Stammkapital (€)</label>
          <input type="number" id="ug-capital" class="ug-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25000" min="1" step="1000">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Rechtliche Begleitung</label>
          <select id="ug-legal" class="ug-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="musterdisposition">Musterprotokoll (vereinfacht)</option>
            <option value="standard" selected>Standardgründung mit Notar</option>
            <option value="anwalt">Anwalt + Notar (individuell)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Expressbearbeitung?</label>
          <select id="ug-expedite" class="ug-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="no" selected>Nein – Standardbearbeitung</option>
            <option value="yes">Ja – Express (+200–500 €)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Erste-Jahres-Kosten einbeziehen?</label>
          <select id="ug-annual" class="ug-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="no">Nur Gründungskosten</option>
            <option value="yes" selected>Erstes Jahr Betriebskosten einbeziehen</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="ug-total"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Notargebühren</div>
            <div class="text-xl font-bold text-secondary" id="ug-notar"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Handelsregister</div>
            <div class="text-xl font-bold" id="ug-hr"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Anwaltsgebühren</div>
            <div class="text-xl font-bold text-orange-600" id="ug-legal-cost"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Jährl. Kosten (1. Jahr)</div>
            <div class="text-xl font-bold" id="ug-annual-cost"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="unternehmensgruendung" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gründungskosten in Deutschland</h2>
      <p>Die Kosten für eine Unternehmensgründung in Deutschland hängen von der Rechtsform ab. Eine GmbH kostet typischerweise 1.000–3.000 € für Notar und Handelsregistereintragung. Eine UG kann günstiger gegründet werden. Die AG erfordert mindestens 50.000 € Grundkapital und höhere Gründungskosten.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Was kostet eine GmbH-Gründung in Deutschland?</h4>
      <p>Typisch 500–2.000 € für Notar und Handelsregister. Dazu kommt das Stammkapital von mindestens 25.000 €.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Was ist der Unterschied zwischen GmbH und UG?</h4>
      <p>Die GmbH erfordert mindestens 25.000 € Stammkapital. Die UG kann mit minimalem Kapital gegründet werden, muss aber 25 % des Jahresgewinns zurücklegen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

    function calcUG() {
      const entityType = (document.getElementById('ug-type') as HTMLSelectElement).value;
      const capital = parseFloat((document.getElementById('ug-capital') as HTMLInputElement).value) || 25000;
      const legal = (document.getElementById('ug-legal') as HTMLSelectElement).value;
      const expedite = (document.getElementById('ug-expedite') as HTMLSelectElement).value;
      const inclAnnual = (document.getElementById('ug-annual') as HTMLSelectElement).value;

      const notarFees: Record<string, number> = {
        gmbh: legal === 'musterdisposition' ? 200 : 800,
        ug: legal === 'musterdisposition' ? 200 : 500,
        ag: 1500, kg: 600, einzelunternehmen: 0
      };
      const notarFee = notarFees[entityType] || 800;

      const hrFees: Record<string, number> = {
        gmbh: 150, ug: 150, ag: 300, kg: 150, einzelunternehmen: 20
      };
      const hrFee = hrFees[entityType] || 150;

      const legalFees: Record<string, Record<string, number>> = {
        gmbh: { musterdisposition: 0, standard: 500, anwalt: 2000 },
        ug: { musterdisposition: 0, standard: 300, anwalt: 1200 },
        ag: { musterdisposition: 0, standard: 1500, anwalt: 5000 },
        kg: { musterdisposition: 0, standard: 800, anwalt: 2500 },
        einzelunternehmen: { musterdisposition: 0, standard: 0, anwalt: 500 }
      };
      const legalFee = (legalFees[entityType] && legalFees[entityType][legal]) || 0;

      const expediteFee = expedite === 'yes' ? 350 : 0;

      let annualCost = 0;
      if (inclAnnual === 'yes') {
        const annualFees: Record<string, number> = {
          gmbh: 1200, ug: 600, ag: 3000, kg: 1000, einzelunternehmen: 200
        };
        annualCost = annualFees[entityType] || 1000;
      }

      const total = notarFee + hrFee + legalFee + expediteFee + annualCost;

      document.getElementById('ug-total')!.textContent = fmtEur(total);
      document.getElementById('ug-notar')!.textContent = fmtEur(notarFee);
      document.getElementById('ug-hr')!.textContent = fmtEur(hrFee + expediteFee);
      document.getElementById('ug-legal-cost')!.textContent = fmtEur(legalFee);
      document.getElementById('ug-annual-cost')!.textContent = fmtEur(annualCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ug-in').forEach(el => {
        el.addEventListener('input', calcUG);
        el.addEventListener('change', calcUG);
      });
      calcUG();
    }, 50);
  </script>
</CalculatorLayout>
