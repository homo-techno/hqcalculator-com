---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Makramee Rechner – Garnlängen und Materialmengen berechnen";
const description = "Berechnen Sie Garnlängen und Materialmengen für Makramee-Projekte. Wandbehang, Pflanzenhänger und Tischläufer einfach kalkulieren.";

const relatedCalcs = [
  { name: "Holzrechner", url: "/de/holz-rechner", description: "Materialmengen." },
  { name: "Magazin-Layout Rechner", url: "/de/magazin-layout-rechner", description: "Layoutmaße." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Anteile." },
];
---
<CalculatorLayout lang="de" enSlug="macrame-calculator" title={title} description={description} calculatorName="Makramee Rechner" keywords="Makramee Rechner, Garnlänge berechnen, Makramee Material, Schnurmenge Makramee" breadcrumbs={[{ name: "Makramee Rechner", url: "/de/makramee-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Makramee Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die benötigte Garnlänge und Materialmengen für Ihr Makramee-Projekt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Projekttyp</label>
          <select id="mkr-type" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="wall" selected>Wandbehang</option>
            <option value="plant">Pflanzenhänger</option>
            <option value="runner">Tischläufer</option>
            <option value="basket">Korb</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (cm)</label>
            <input type="number" id="mkr-width" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="40" step="1" min="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Länge/Höhe (cm)</label>
            <input type="number" id="mkr-length" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="60" step="1" min="5">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Knotendichte</label>
          <select id="mkr-density" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="loose">Locker (dekorativ)</option>
            <option value="medium" selected>Mittel (Standard)</option>
            <option value="tight">Dicht (Funktional)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Garnstärke (mm)</label>
          <select id="mkr-yarn" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="3">3 mm (fein)</option>
            <option value="5" selected>5 mm (Standard)</option>
            <option value="8">8 mm (grob)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtgarn benötigt</div>
          <div class="text-5xl font-extrabold font-mono" id="mkr-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="mkr-sub">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Anzahl Schnüre</div>
            <div class="text-xl font-bold font-mono" id="mkr-cords">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Länge je Schnur</div>
            <div class="text-xl font-bold font-mono" id="mkr-per-cord">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewicht (ca.)</div>
            <div class="text-xl font-bold font-mono" id="mkr-weight">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Knäuel à 100 m</div>
            <div class="text-xl font-bold font-mono" id="mkr-balls">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="macrame" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Makramee – Die Kunst des dekorativen Knotens</h2>
      <p>Makramee ist eine Handarbeitstechnik, bei der durch das Knüpfen von Knoten aus Schnüren oder Fäden Muster und Strukturen entstehen. Ursprünglich aus dem arabischen Raum stammend, erlebte Makramee in den 1970er Jahren eine große Blütezeit und ist heute wieder modern. Für Einsteiger eignen sich Baumwollschnüre in 3–5 mm Stärke, die sich leicht verknoten lassen.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Wie lang sollten die Schnüre sein?</h3>
      <p>Als Faustregel gilt: 4× die fertige Länge des Projekts. Für einen 60 cm langen Wandbehang benötigen Sie also Schnüre von ca. 240 cm. Bei dichteren Knoten sollten Sie 5–6× die Länge einplanen.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Welches Material eignet sich für Makramee?</h3>
      <p>Baumwollschnüre (natürlich oder gedreht), Juteschnur, Hanf und Polyester-Makrameegarn. Für Anfänger empfiehlt sich eine 3-strängige gedrehte Baumwollschnur in 5 mm, die sich gut verknotet und entwirrt.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie verhindere ich das Verfilzen der Schnüre?</h3>
      <p>Wickeln Sie lange Schnüre in kleine Bündel (Bobbins) und arbeiten Sie stets von oben nach unten. Lösen Sie Knoten sofort, wenn Sie merken, dass etwas falsch läuft, bevor sie zu fest werden.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const typeFactors: Record<string, number> = { wall: 1.0, plant: 1.3, runner: 0.9, basket: 1.5 };
    const densityFactors: Record<string, number> = { loose: 3.5, medium: 4.5, tight: 6.0 };
    const yarnWeightPerM: Record<string, number> = { '3': 8, '5': 18, '8': 42 };
    function calcMkr() {
      const type = (document.getElementById('mkr-type') as HTMLSelectElement).value;
      const width = parseFloat((document.getElementById('mkr-width') as HTMLInputElement).value) || 40;
      const length = parseFloat((document.getElementById('mkr-length') as HTMLInputElement).value) || 60;
      const density = (document.getElementById('mkr-density') as HTMLSelectElement).value;
      const yarn = (document.getElementById('mkr-yarn') as HTMLSelectElement).value;
      const yarnMm = parseFloat(yarn);
      const cordsPerCm = 2 / yarnMm;
      const numCords = Math.ceil(width * cordsPerCm) * 2;
      const cordLength = length / 100 * densityFactors[density] * typeFactors[type];
      const total = numCords * cordLength;
      const weightPerM = yarnWeightPerM[yarn] || 18;
      const weight = total * weightPerM / 1000;
      const balls = Math.ceil(total / 100);
      document.getElementById('mkr-result')!.textContent = total.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m';
      document.getElementById('mkr-sub')!.textContent = weight.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' g Baumwollschnur';
      document.getElementById('mkr-cords')!.textContent = numCords.toLocaleString('de-DE') + ' Stk.';
      document.getElementById('mkr-per-cord')!.textContent = cordLength.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' m';
      document.getElementById('mkr-weight')!.textContent = weight.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' g';
      document.getElementById('mkr-balls')!.textContent = balls.toLocaleString('de-DE') + ' Stk.';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['mkr-type', 'mkr-density', 'mkr-yarn'].forEach(id => document.getElementById(id)!.addEventListener('change', calcMkr));
      ['mkr-width', 'mkr-length'].forEach(id => document.getElementById(id)!.addEventListener('input', calcMkr));
      calcMkr();
    }, 50);
  </script>
</CalculatorLayout>
