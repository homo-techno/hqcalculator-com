---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Nettovermögen Rechner - Vermögen minus Verbindlichkeiten berechnen";
const description = "Berechnen Sie Ihr Nettovermögen aus Vermögenswerten abzüglich aller Verbindlichkeiten und Schulden.";
const relatedCalcs = [
  { name: "Kapitalwert Rechner", url: "/de/kapitalwert-rechner", description: "Investitionen bewerten." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibungen berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "Abschlusskosten Rechner", url: "/de/abschlusskosten-rechner", description: "Immobilien-Nebenkosten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Nettovermögen Rechner" enSlug="net-worth-calculator" keywords="Nettovermögen, Vermögensbilanz, Aktiva Passiva, Schulden Vermögen, persönliche Bilanz, Eigenkapital" breadcrumbs={[{ name: "Nettovermögen Rechner", url: "/de/nettovermoegen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Nettovermögen Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihr persönliches Nettovermögen: Erfassen Sie alle Vermögenswerte und Verbindlichkeiten für eine klare Finanzbilanz.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Vermögenswerte (Aktiva)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Immobilien (€)</label><input type="number" id="nv-property" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="350000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bankguthaben (€)</label><input type="number" id="nv-cash" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25000" min="0" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktien & Fonds (€)</label><input type="number" id="nv-stocks" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fahrzeuge (€)</label><input type="number" id="nv-vehicles" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20000" min="0" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Altersvorsorge (€)</label><input type="number" id="nv-pension" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstiges Vermögen (€)</label><input type="number" id="nv-other-asset" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000" min="0" step="500"></div>
        </div>
        <h3 class="font-semibold text-text pt-2">Verbindlichkeiten (Passiva)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hypothek / Immobilienkredite (€)</label><input type="number" id="nv-mortgage" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Konsumentenkredite (€)</label><input type="number" id="nv-loan" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8000" min="0" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kreditkartenschulden (€)</label><input type="number" id="nv-cc" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2000" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstige Schulden (€)</label><input type="number" id="nv-other-liab" class="nv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nettovermögen</div>
          <div class="text-5xl font-extrabold font-mono" id="nv-result">0,00 €</div>
          <div class="text-sm text-blue-200 mt-1" id="nv-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtvermögen</div><div class="text-xl font-bold" id="nv-assets">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtschulden</div><div class="text-xl font-bold" id="nv-liabilities">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenkapitalquote</div><div class="text-xl font-bold" id="nv-ratio">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschuldungsgrad</div><div class="text-xl font-bold" id="nv-debtratio">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="nettovermoegen" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Nettovermögen als Maßstab der Finanzgesundheit</h2>
      <p>Das Nettovermögen ist der wichtigste Indikator für den finanziellen Status einer Person. Es ergibt sich aus der Differenz aller Vermögenswerte und Verbindlichkeiten. Laut Bundesbank beträgt das mittlere Nettovermögen eines deutschen Haushalts ca. 135.000 Euro.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was ist ein gutes Nettovermögen?</strong></p><p>Das hängt von Alter, Einkommen und Lebenszielen ab. Als Faustregel gilt: Nettovermögen sollte mindestens das 1-fache des Jahreseinkommens betragen, im Alter deutlich mehr.</p></div>
        <div><p><strong>Sollte ich Altersvorsorge einrechnen?</strong></p><p>Ja, private Rentenversicherungen und Betriebsrenten sind Vermögenswerte. Gesetzliche Rentenansprüche sind schwer zu bewerten und werden oft separat betrachtet.</p></div>
        <div><p><strong>Wie oft sollte ich mein Nettovermögen berechnen?</strong></p><p>Mindestens einmal jährlich. So können Sie Fortschritte verfolgen, Sparziele überprüfen und die Vermögensentwicklung planen.</p></div>
        <div><p><strong>Was ist die Eigenkapitalquote?</strong></p><p>Die Eigenkapitalquote zeigt, welcher Anteil Ihres Gesamtvermögens schuldenfrei ist. Eine Quote über 50% gilt als gesund.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcNV() {
      const property = parseFloat((document.getElementById('nv-property') as HTMLInputElement).value) || 0;
      const cash = parseFloat((document.getElementById('nv-cash') as HTMLInputElement).value) || 0;
      const stocks = parseFloat((document.getElementById('nv-stocks') as HTMLInputElement).value) || 0;
      const vehicles = parseFloat((document.getElementById('nv-vehicles') as HTMLInputElement).value) || 0;
      const pension = parseFloat((document.getElementById('nv-pension') as HTMLInputElement).value) || 0;
      const otherAsset = parseFloat((document.getElementById('nv-other-asset') as HTMLInputElement).value) || 0;
      const mortgage = parseFloat((document.getElementById('nv-mortgage') as HTMLInputElement).value) || 0;
      const loan = parseFloat((document.getElementById('nv-loan') as HTMLInputElement).value) || 0;
      const cc = parseFloat((document.getElementById('nv-cc') as HTMLInputElement).value) || 0;
      const otherLiab = parseFloat((document.getElementById('nv-other-liab') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
      const totalAssets = property + cash + stocks + vehicles + pension + otherAsset;
      const totalLiab = mortgage + loan + cc + otherLiab;
      const netWorth = totalAssets - totalLiab;
      const equityRatio = totalAssets > 0 ? (netWorth / totalAssets * 100) : 0;
      const debtRatio = totalAssets > 0 ? (totalLiab / totalAssets * 100) : 0;
      document.getElementById('nv-result')!.textContent = fmt(netWorth);
      document.getElementById('nv-sub')!.textContent = 'Aktiva: ' + fmt(totalAssets) + ' − Passiva: ' + fmt(totalLiab);
      document.getElementById('nv-assets')!.textContent = fmt(totalAssets);
      document.getElementById('nv-liabilities')!.textContent = fmt(totalLiab);
      document.getElementById('nv-ratio')!.textContent = equityRatio.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
      document.getElementById('nv-debtratio')!.textContent = debtRatio.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.nv-in').forEach(el => { el.addEventListener('input', calcNV); el.addEventListener('change', calcNV); });
      calcNV();
    }, 50);
  </script>
</CalculatorLayout>
