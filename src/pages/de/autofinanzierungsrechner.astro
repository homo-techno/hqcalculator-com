---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SliderInput from '../../components/SliderInput.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Autofinanzierungsrechner - Kfz-Kredit & Rate berechnen 2026";
const description = "Berechne deine monatliche Kfz-Rate, Gesamtzinsen und den vollstaendigen Tilgungsplan. Beruecksichtigt Anzahlung und Restwert.";

const relatedCalcs = [
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Allgemeiner Kreditrechner." },
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Baufinanzierung berechnen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins berechnen." },
  { name: "Gehaltsrechner", url: "/de/gehaltsrechner", description: "Gehalt umrechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziele planen." },
  { name: "Mehrwertsteuerrechner", url: "/de/mehrwertsteuerrechner", description: "MwSt. berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Autofinanzierungsrechner" keywords="Autofinanzierungsrechner, Kfz-Kredit, Autokredit, monatliche Rate Auto, Autofinanzierung berechnen" breadcrumbs={[{ name: "Autofinanzierungsrechner", url: "/de/autofinanzierungsrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Autofinanzierungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne deine monatliche Kfz-Rate und die Gesamtkosten der Finanzierung. Beruecksichtigt Anzahlung und Inzahlungnahme.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <SliderInput id="auto-price" label="Fahrzeugpreis" min={5000} max={150000} step={500} value={30000} suffix=" &euro;" tooltip="Kauf- oder Verhandlungspreis" />
          <SliderInput id="auto-down" label="Anzahlung" min={0} max={50000} step={500} value={5000} suffix=" &euro;" tooltip="Eigenkapital" />
          <SliderInput id="auto-trade" label="Inzahlungnahme" min={0} max={50000} step={500} value={0} suffix=" &euro;" tooltip="Wert des alten Fahrzeugs" />
          <SliderInput id="auto-rate" label="Zinssatz (eff. p.a.)" min={0} max={15} step={0.1} value={4.9} suffix="%" tooltip="Effektiver Jahreszins" />

          <div class="mt-4 mb-4">
            <label class="block text-sm font-medium text-text mb-2">Laufzeit</label>
            <div class="flex gap-2">
              <button class="auto-term-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt border border-border cursor-pointer" data-months="24">24 Mo.</button>
              <button class="auto-term-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt border border-border cursor-pointer" data-months="36">36 Mo.</button>
              <button class="auto-term-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-primary text-white border border-primary cursor-pointer" data-months="48">48 Mo.</button>
              <button class="auto-term-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt border border-border cursor-pointer" data-months="60">60 Mo.</button>
              <button class="auto-term-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt border border-border cursor-pointer" data-months="72">72 Mo.</button>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Rate</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="auto-monthly">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kreditbetrag</div><div class="text-xl font-bold" id="auto-loan-amt">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zinsen gesamt</div><div class="text-xl font-bold text-danger" id="auto-interest">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="auto-total">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahlung + Inzahlungn.</div><div class="text-xl font-bold" id="auto-down-total">0 &euro;</div></div>
          </div>
          <div class="chart-container p-4 bg-surface-alt rounded-xl"><canvas id="auto-donut" width="220" height="220"></canvas></div>
        </div>
      </div>

      <ShareButton calculatorId="auto-loan" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">Tilgungsplan</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-3 font-semibold">Jahr</th><th class="py-2 pr-3 font-semibold text-right">Zahlung</th><th class="py-2 pr-3 font-semibold text-right">Tilgung</th><th class="py-2 pr-3 font-semibold text-right">Zinsen</th><th class="py-2 font-semibold text-right">Restschuld</th></tr></thead>
          <tbody id="auto-amort-tbody"></tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie Autofinanzierung funktioniert</h2>
      <p>Bei einer Autofinanzierung wird das Fahrzeug als Sicherheit fuer den Kredit genutzt. Die monatliche Rate setzt sich aus Tilgung und Zinsen zusammen. Zu Beginn der Laufzeit ist der Zinsanteil hoeher.</p>

      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">
        Kreditbetrag = Fahrzeugpreis &minus; Anzahlung &minus; Inzahlungnahme
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Tipps fuer guenstige Konditionen</h3>
      <ul>
        <li><strong>Eigenkapital:</strong> Je mehr Anzahlung, desto geringer der Kreditbetrag und die Zinslast</li>
        <li><strong>Kuerzere Laufzeit:</strong> 24-48 Monate haben meist bessere Zinssaetze als 60-72 Monate</li>
        <li><strong>Angebote vergleichen:</strong> Haendlerfinanzierung, Hausbank und Online-Anbieter vergleichen</li>
        <li><strong>Bonitaet pruefen:</strong> Ein guter SCHUFA-Score fuehrt zu besseren Konditionen</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Die wahren Kosten laengerer Laufzeiten</h3>
      <p>Laengere Laufzeiten senken zwar die monatliche Rate, erhoehen aber die Gesamtzinsen erheblich. Ein Fahrzeug fuer 30.000 Euro bei 4,9 % kostet bei 36 Monaten ca. 2.316 Euro Zinsen, bei 72 Monaten jedoch ca. 4.664 Euro — fast das Doppelte.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    import Chart from 'chart.js/auto';
    let autoChart: Chart | null = null;
    let autoTermMonths = 48;

    function getVal(id: string): number {
      const s = document.getElementById(`${id}-slider`) as HTMLInputElement;
      return parseFloat(s?.value || '0');
    }
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcAuto() {
      const price = getVal('auto-price');
      const down = getVal('auto-down');
      const trade = getVal('auto-trade');
      const annualRate = getVal('auto-rate');
      const n = autoTermMonths;

      const loanAmount = Math.max(0, price - down - trade);
      const r = annualRate / 100 / 12;

      let M: number;
      if (r > 0) { M = loanAmount * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1); }
      else { M = n > 0 ? loanAmount / n : 0; }

      const totalPayment = M * n;
      const totalInterest = totalPayment - loanAmount;

      document.getElementById('auto-monthly')!.textContent = fmt(M);
      document.getElementById('auto-loan-amt')!.textContent = fmt(loanAmount);
      document.getElementById('auto-interest')!.textContent = fmt(totalInterest);
      document.getElementById('auto-total')!.textContent = fmt(totalPayment + down + trade);
      document.getElementById('auto-down-total')!.textContent = fmt(down + trade);

      const ctx = (document.getElementById('auto-donut') as HTMLCanvasElement).getContext('2d')!;
      if (autoChart) autoChart.destroy();
      autoChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Tilgung', 'Zinsen', 'Anzahlung'],
          datasets: [{ data: [loanAmount, totalInterest, down + trade], backgroundColor: ['#3b82f6', '#ef4444', '#10b981'], borderWidth: 0 }]
        },
        options: {
          responsive: true, cutout: '65%',
          plugins: {
            legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, font: { size: 11 } } },
            tooltip: { callbacks: { label: (c) => `${c.label}: ${fmt(c.parsed)}` } }
          }
        }
      });

      let balance = loanAmount;
      const years = Math.ceil(n / 12);
      let html = '';
      for (let y = 1; y <= years; y++) {
        let yPay = 0, yPrinc = 0, yInt = 0;
        const monthsThisYear = Math.min(12, n - (y - 1) * 12);
        for (let m = 0; m < monthsThisYear; m++) {
          const interest = balance * r;
          const princ = M - interest;
          balance = Math.max(0, balance - princ);
          yPay += M; yPrinc += princ; yInt += interest;
        }
        html += `<tr class="border-b border-border/30 hover:bg-surface-alt/50"><td class="py-2 pr-3 text-text-secondary">Jahr ${y}</td><td class="py-2 pr-3 text-right">${fmt(yPay)}</td><td class="py-2 pr-3 text-right text-primary">${fmt(yPrinc)}</td><td class="py-2 pr-3 text-right text-danger">${fmt(yInt)}</td><td class="py-2 text-right font-medium">${fmt(balance)}</td></tr>`;
      }
      document.getElementById('auto-amort-tbody')!.innerHTML = html;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['auto-price-slider', 'auto-down-slider', 'auto-trade-slider', 'auto-rate-slider'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcAuto);
      });
      ['auto-price-input', 'auto-down-input', 'auto-trade-input', 'auto-rate-input'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', () => setTimeout(calcAuto, 120));
      });

      document.querySelectorAll('.auto-term-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.auto-term-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white', 'border-primary'); b.classList.add('bg-surface-alt', 'border-border'); });
          btn.classList.remove('bg-surface-alt', 'border-border'); btn.classList.add('bg-primary', 'text-white', 'border-primary');
          autoTermMonths = parseInt((btn as HTMLElement).dataset.months || '48');
          calcAuto();
        });
      });

      calcAuto();
    }, 50);
  </script>
</CalculatorLayout>
