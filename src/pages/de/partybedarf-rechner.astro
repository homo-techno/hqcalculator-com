---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Partybedarf Rechner - Getränke, Essen & Deko";
const description = "Berechnen Sie Getränke-, Essen- und Dekomengen für Ihre Feier. Perfekte Planung für Geburtstag, Hochzeit und Firmenevents.";

const relatedCalcs = [
  { name: "Trinkgeld-Rechner", url: "/de/trinkgeld-rechner", description: "Trinkgeld berechnen." },
  { name: "Kostenrechner", url: "/de/kostenrechner", description: "Eventkosten." },
  { name: "Backuniform-Rechner", url: "/de/backuniform-rechner", description: "Backmengen." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Partybedarf Rechner" lang="de" enSlug="party-supplies-calculator" keywords="partybedarf rechner, party planer, getränke berechnen party, essen menge feier, geburtstag planung" breadcrumbs={[{ name: "Partybedarf Rechner", url: "/de/partybedarf-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Partybedarf Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Feier perfekt: Berechnen Sie Getränke, Speisen und Dekorationsmengen für alle Gäste.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Gäste</label><input type="number" id="pb-guests" class="pb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" max="1000" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Veranstaltungsdauer (Std)</label><input type="number" id="pb-hours" class="pb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="24" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anlass</label>
            <select id="pb-type" class="pb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="birthday">Geburtstag</option>
              <option value="wedding">Hochzeit</option>
              <option value="bbq">Grillfest / BBQ</option>
              <option value="corporate">Firmenfeier</option>
              <option value="cocktail">Cocktailparty</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tageszeit</label>
            <select id="pb-daytime" class="pb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="afternoon">Nachmittag</option>
              <option value="evening">Abend</option>
              <option value="lunch">Mittag</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kinder (unter 12 J.)</label><input type="number" id="pb-kids" class="pb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Person (€)</label><input type="number" id="pb-budget" class="pb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätztes Gesamtbudget</div>
          <div class="text-4xl font-extrabold font-mono" id="pb-result">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Alkohol. Getränke</div><div class="text-xl font-bold" id="pb-alcohol">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Alkoholfrei</div><div class="text-xl font-bold" id="pb-soft">0 L</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Speisemenge</div><div class="text-xl font-bold" id="pb-food">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Teller/Besteck</div><div class="text-xl font-bold" id="pb-plates">0 Stk</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Servietten</div><div class="text-xl font-bold" id="pb-napkins">0 Stk</div></div>
        </div>
      </div>
      <ShareButton calculatorId="partybedarf-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Party erfolgreich planen</h2>
      <p class="text-text-secondary mt-2">Eine gut geplante Feier lebt von der richtigen Menge an Getränken und Speisen. Als Faustregel gilt: Erwachsene trinken pro Stunde etwa 0,5–0,75 Liter Getränke, davon bei Abendveranstaltungen ca. 30–40 % alkoholisch. Bei einem 3-stündigen Abendessen rechnet man mit 250–350 g Speisen pro Person. Für Grillpartys sollte man mit 300–400 g Fleisch pro Person einplanen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Bier brauche ich für 30 Personen?</strong> Bei einer 4-stündigen Abendveranstaltung mit 30 Erwachsenen sollten Sie ca. 40–50 Liter Bier einplanen. Das entspricht etwa 2 Fässern à 30 Liter oder 120 Flaschen (0,33 L).</p>
      <p><strong>Wie viel Essen für einen Kindergeburtstag?</strong> Kinder essen und trinken etwa 60 % der Erwachsenenmenge. Für 20 Kinder bei 3 Stunden Feier: ca. 4–5 kg Snacks und 15 Liter alkoholfreie Getränke.</p>
      <p><strong>Was muss ich bei einem Buffet beachten?</strong> Bei einem Buffet plant man 20–25 % mehr Speisen ein als bei einem Menü, da Gäste tendenziell mehr nehmen. Kalte Speisen können früher vorbereitet werden.</p>
      <p><strong>Wie berechne ich den Eiswürfelbedarf?</strong> Pro Gast und Stunde benötigen Sie ca. 0,1–0,15 kg Eis. Bei 30 Gästen und 5 Stunden also etwa 15–22 kg Eis.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const pbEuro = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

    function calcPB() {
      const guests = parseInt((document.getElementById('pb-guests') as HTMLInputElement).value) || 30;
      const hours = parseFloat((document.getElementById('pb-hours') as HTMLInputElement).value) || 5;
      const type = (document.getElementById('pb-type') as HTMLSelectElement).value;
      const daytime = (document.getElementById('pb-daytime') as HTMLSelectElement).value;
      const kids = parseInt((document.getElementById('pb-kids') as HTMLInputElement).value) || 0;
      const budgetPerPerson = parseFloat((document.getElementById('pb-budget') as HTMLInputElement).value) || 25;

      const adults = Math.max(guests - kids, 0);
      const drinkPerAdultPerHour = daytime === 'afternoon' ? 0.4 : 0.55;
      const alcoholRatio = (type === 'cocktail' ? 0.5 : type === 'wedding' ? 0.4 : type === 'corporate' ? 0.25 : 0.35);
      const totalDrinkAdults = adults * drinkPerAdultPerHour * hours;
      const totalDrinkKids = kids * 0.25 * hours;
      const alcoholL = totalDrinkAdults * alcoholRatio;
      const softL = totalDrinkAdults * (1 - alcoholRatio) + totalDrinkKids;

      const foodPerAdult = type === 'bbq' ? 0.4 : type === 'wedding' ? 0.35 : 0.25;
      const totalFood = adults * foodPerAdult + kids * 0.15;

      const platesPerPerson = type === 'cocktail' ? 3 : 2;
      const plates = guests * platesPerPerson;
      const napkins = guests * 4;
      const totalBudget = guests * budgetPerPerson;

      document.getElementById('pb-result')!.textContent = pbEuro(totalBudget);
      document.getElementById('pb-alcohol')!.textContent = alcoholL.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('pb-soft')!.textContent = softL.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('pb-food')!.textContent = totalFood.toFixed(1).replace('.', ',') + ' kg';
      document.getElementById('pb-plates')!.textContent = plates.toLocaleString('de-DE') + ' Stk';
      document.getElementById('pb-napkins')!.textContent = napkins.toLocaleString('de-DE') + ' Stk';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pb-in').forEach(el => { el.addEventListener('input', calcPB); el.addEventListener('change', calcPB); });
      calcPB();
    }, 50);
  </script>
</CalculatorLayout>
