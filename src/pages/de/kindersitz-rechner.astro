---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kindersitz-Rechner - Den richtigen Kindersitz finden";
const description = "Bestimmen Sie, welchen Kindersitz Ihr Kind basierend auf Alter, Gr\u00f6\u00dfe und Gewicht ben\u00f6tigt. Gem\u00e4\u00df deutschen und EU-Sicherheitsrichtlinien.";
const relatedCalcs = [
  { name: "Kfz-Versicherung", url: "/de/kfz-versicherung-rechner", description: "Versicherung." },
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
  { name: "Auto-Leasing", url: "/de/auto-leasing-rechner", description: "Leasing." },
  { name: "Autorate", url: "/de/autorate-rechner", description: "Autofinanzierung." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorien." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kindersitz-Rechner" lang="de" enSlug="car-seat-calculator" keywords="kindersitz rechner, kindersitz alter, kindersitz gewicht, kindersitz wechsel, sitzerh\u00f6hung, kindersitz sicherheit" breadcrumbs={[{ name: "Kindersitz-Rechner", url: "/de/kindersitz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kindersitz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie den richtigen Kindersitz basierend auf Alter, Gr&ouml;&szlig;e und Gewicht Ihres Kindes gem&auml;&szlig; Sicherheitsrichtlinien.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Alter des Kindes</label>
          <div class="flex gap-3">
            <div class="flex-1">
              <label class="block text-xs text-text-muted mb-1">Jahre</label>
              <input type="number" id="ks2-years" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" max="12" step="1">
            </div>
            <div class="flex-1">
              <label class="block text-xs text-text-muted mb-1">Monate</label>
              <input type="number" id="ks2-months" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="11" step="1">
            </div>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gewicht (kg)</label>
          <input type="number" id="ks2-weight" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="13" min="2" max="55" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gr&ouml;&szlig;e (cm)</label>
          <input type="number" id="ks2-height" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="87" min="45" max="165" step="1">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Kindersitz</div>
        <div class="text-3xl font-extrabold" id="ks2-type">--</div>
        <div class="text-sm text-blue-200 mt-1" id="ks2-direction">Blickrichtung</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Sicherheitshinweis</div>
          <div class="text-lg font-bold" id="ks2-safety">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">N&auml;chster Wechsel</div>
          <div class="text-lg font-bold" id="ks2-next">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Preisbereich</div>
          <div class="text-lg font-bold" id="ks2-price">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Nur Gurt bereit</div>
          <div class="text-lg font-bold" id="ks2-seatbelt">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Alle Kindersitz-Stufen (i-Size/R129)</h3>
        <div class="text-xs" id="ks2-stages"></div>
      </div>

      <ShareButton calculatorId="car-seat" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kindersitz-Sicherheitsrichtlinien</h2>
      <p>In Deutschland m&uuml;ssen Kinder bis 150 cm K&ouml;rpergr&ouml;&szlig;e einen geeigneten Kindersitz verwenden. Die i-Size-Regelung (UN R129) orientiert sich prim&auml;r an der K&ouml;rpergr&ouml;&szlig;e statt am Gewicht.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Kindersitz-Gruppen</h3>
      <ul>
        <li><strong>Babyschale (R&uuml;ckw&auml;rts):</strong> Geburt bis ca. 83 cm / 13 kg</li>
        <li><strong>Reboarder:</strong> R&uuml;ckw&auml;rtsgerichtet bis mind. 15 Monate, ideal bis 105 cm</li>
        <li><strong>Vorw&auml;rts mit Gurt:</strong> Ab ca. 100 cm, 15-36 kg</li>
        <li><strong>Sitzerh&ouml;hung:</strong> Ab ca. 125 cm, 22-36 kg</li>
        <li><strong>Nur Fahrzeuggurt:</strong> Ab 150 cm K&ouml;rpergr&ouml;&szlig;e</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKS2() {
      const years = parseFloat((document.getElementById('ks2-years') as HTMLInputElement).value) || 0;
      const months = parseFloat((document.getElementById('ks2-months') as HTMLInputElement).value) || 0;
      const weight = parseFloat((document.getElementById('ks2-weight') as HTMLInputElement).value) || 13;
      const height = parseFloat((document.getElementById('ks2-height') as HTMLInputElement).value) || 87;
      const ageMonths = years * 12 + months;

      let seatType = '';
      let direction = '';
      let safety = '';
      let next = '';
      let price = '';
      let seatbelt = 'Nein';
      let currentStage = 0;

      const seatbeltReady = height >= 150;

      if (height < 83 && weight < 13 && ageMonths < 18) {
        seatType = 'Babyschale';
        direction = 'R\u00fcckw\u00e4rtsgerichtet \u2014 sicherste Position';
        safety = 'R\u00fcckw\u00e4rts lassen!';
        next = 'Bei ca. 83 cm / 13 kg';
        price = '80 - 350 \u20ac';
        currentStage = 0;
      } else if (height < 105 && ageMonths < 48) {
        seatType = 'Reboarder / Kleinkind-Sitz';
        direction = 'R\u00fcckw\u00e4rts bis mind. 15 Monate, ideal l\u00e4nger';
        safety = 'So lange wie m\u00f6glich r\u00fcckw\u00e4rts!';
        next = 'Ab ca. 100-105 cm';
        price = '150 - 500 \u20ac';
        currentStage = 1;
      } else if (!seatbeltReady) {
        if (height < 125 || weight < 22) {
          seatType = 'Kindersitz (Gruppe 2/3)';
          direction = 'Vorw\u00e4rtsgerichtet mit Fahrzeuggurt';
          safety = 'R\u00fcckenst\u00fctze bevorzugt';
          next = 'Ab 125 cm / 22 kg: Sitzerh\u00f6hung';
          price = '80 - 300 \u20ac';
          currentStage = 2;
        } else {
          seatType = 'Sitzerh\u00f6hung';
          direction = 'Vorw\u00e4rtsgerichtet mit Fahrzeuggurt';
          safety = 'Mit R\u00fcckenst\u00fctze sicherer';
          next = 'Ab 150 cm: nur Gurt';
          price = '30 - 200 \u20ac';
          currentStage = 3;
        }
      } else {
        seatType = 'Nur Fahrzeuggurt';
        direction = 'Kein Kindersitz mehr n\u00f6tig';
        safety = 'Gurt sitzt korrekt';
        next = 'Keine \u2014 geschafft!';
        price = 'Entf.';
        seatbelt = 'Ja';
        currentStage = 4;
      }

      if (seatbeltReady) seatbelt = 'Ja';

      document.getElementById('ks2-type')!.textContent = seatType;
      document.getElementById('ks2-direction')!.textContent = direction;
      document.getElementById('ks2-safety')!.textContent = safety;
      document.getElementById('ks2-next')!.textContent = next;
      document.getElementById('ks2-price')!.textContent = price;
      document.getElementById('ks2-seatbelt')!.textContent = seatbelt;

      const stages = [
        { name: 'Babyschale', age: 'Geburt - 18 Mon.', weight: 'Bis 13 kg', height: 'Bis 83 cm' },
        { name: 'Reboarder', age: 'Ab 15 Mon.', weight: 'Bis 18 kg', height: 'Bis 105 cm' },
        { name: 'Kindersitz Gr. 2/3', age: '3,5 - 7+ J.', weight: '15-36 kg', height: '100-150 cm' },
        { name: 'Sitzerh\u00f6hung', age: '6 - 12 J.', weight: '22-36 kg', height: '125-150 cm' },
        { name: 'Nur Fahrzeuggurt', age: 'Ab 12 J.', weight: '\u00dcber 36 kg', height: 'Ab 150 cm' },
      ];

      document.getElementById('ks2-stages')!.innerHTML =
        '<div class="grid grid-cols-4 gap-2 font-semibold text-text-muted mb-1"><span>Stufe</span><span>Alter</span><span>Gewicht</span><span>Gr\u00f6\u00dfe</span></div>' +
        stages.map((s, i) => {
          return '<div class="grid grid-cols-4 gap-2 py-1 ' + (i === currentStage ? 'bg-blue-50 rounded font-bold' : '') + '"><span>' + s.name + '</span><span>' + s.age + '</span><span>' + s.weight + '</span><span>' + s.height + '</span></div>';
        }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ks2-in').forEach(el => {
        el.addEventListener('input', calcKS2);
        el.addEventListener('change', calcKS2);
      });
      calcKS2();
    }, 50);
  </script>
</CalculatorLayout>
