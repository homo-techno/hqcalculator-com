---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kamerasensor-Rechner - Cropfaktor, Pixelpitch & Sensorfl\u00e4che";
const description = "Vergleichen Sie Kamerasensorgr\u00f6\u00dfen: Cropfaktor, Pixelpitch, Pixeldichte und Sensorfl\u00e4che f\u00fcr Vollformat, APS-C, MFT und mehr.";
const relatedCalcs = [
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
  { name: "Kondensator-Rechner", url: "/de/kondensator-rechner", description: "Kondensator." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorienverbrauch." },
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
  { name: "Campingausr\u00fcstung", url: "/de/campingausruestung-rechner", description: "Camping." },
  { name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner", description: "Defizit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kamerasensor-Rechner" lang="de" enSlug="camera-sensor-calculator" keywords="kamerasensor rechner, cropfaktor, pixelpitch, sensorgr\u00f6\u00dfe vergleich, pixeldichte, vollformat APS-C MFT" breadcrumbs={[{ name: "Kamerasensor", url: "/de/kamerasensor-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kamerasensor-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Sensorgr&ouml;&szlig;en, Cropfaktoren, Pixelpitch und Dichte verschiedener Kameraformate.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Sensorformat</label>
          <select id="ks-format" class="ks-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="53.4x40.0">Mittelformat (53,4 x 40mm)</option>
            <option value="36.0x24.0" selected>Vollformat (36 x 24mm)</option>
            <option value="23.5x15.6">APS-C Nikon/Sony (23,5 x 15,6mm)</option>
            <option value="22.3x14.9">APS-C Canon (22,3 x 14,9mm)</option>
            <option value="17.3x13.0">Micro Four Thirds (17,3 x 13mm)</option>
            <option value="13.2x8.8">1-Zoll (13,2 x 8,8mm)</option>
            <option value="7.6x5.7">1/1,7-Zoll (7,6 x 5,7mm)</option>
            <option value="6.17x4.55">1/2,3-Zoll (6,17 x 4,55mm)</option>
            <option value="0x0">Eigene Werte</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3" id="ks-custom-wrap" style="display:none">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Sensorbreite (mm)</label>
            <input type="number" id="ks-cw" class="ks-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="36" min="1" step="0.1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Sensorh&ouml;he (mm)</label>
            <input type="number" id="ks-ch" class="ks-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="24" min="1" step="0.1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Megapixel</label>
          <input type="number" id="ks-mp" class="ks-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="24" min="1" max="200" step="0.1">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Cropfaktor (vs. Vollformat)</div>
          <div class="text-4xl font-extrabold" id="ks-crop"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Sensorfl&auml;che</div>
            <div class="text-xl font-bold text-text" id="ks-area"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Pixelpitch</div>
            <div class="text-xl font-bold text-text" id="ks-pitch"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Pixeldichte</div>
            <div class="text-xl font-bold text-text" id="ks-density"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Sensordiagonale</div>
            <div class="text-xl font-bold text-text" id="ks-diag"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Bildaufl&ouml;sung (px)</div>
            <div class="text-xl font-bold text-text" id="ks-dims"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Fl&auml;che vs. Vollformat</div>
            <div class="text-xl font-bold text-text" id="ks-area-pct"></div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h4 class="font-semibold text-sm text-text mb-2">Sensorgr&ouml;&szlig;en-Vergleich</h4>
          <div class="text-sm text-text-secondary space-y-1" id="ks-compare"></div>
        </div>
      </div>
      <ShareButton calculatorId="camera-sensor" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kamerasensoren verstehen</h2>
      <p>Gr&ouml;&szlig;ere Sensoren fangen mehr Licht ein, produzieren weniger Rauschen und erzeugen eine geringere Sch&auml;rfentiefe. Der Cropfaktor gibt an, wie viel kleiner ein Sensor im Vergleich zum Vollformat (35mm) ist.</p>
      <p><strong>Pixelpitch</strong> ist der Abstand zwischen Pixelzentren. Gr&ouml;&szlig;erer Pixelpitch bedeutet in der Regel bessere Low-Light-Leistung auf Kosten geringerer Aufl&ouml;sung.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKS() {
      const formatVal = (document.getElementById('ks-format') as HTMLSelectElement).value;
      let sW: number, sH: number;

      if (formatVal === '0x0') {
        document.getElementById('ks-custom-wrap')!.style.display = '';
        sW = parseFloat((document.getElementById('ks-cw') as HTMLInputElement).value) || 36;
        sH = parseFloat((document.getElementById('ks-ch') as HTMLInputElement).value) || 24;
      } else {
        document.getElementById('ks-custom-wrap')!.style.display = 'none';
        const parts = formatVal.split('x');
        sW = parseFloat(parts[0]);
        sH = parseFloat(parts[1]);
      }

      const mp = parseFloat((document.getElementById('ks-mp') as HTMLInputElement).value) || 24;
      const totalPixels = mp * 1000000;

      const ffDiag = Math.sqrt(36 * 36 + 24 * 24);
      const sDiag = Math.sqrt(sW * sW + sH * sH);
      const cropFactor = ffDiag / sDiag;
      const sArea = sW * sH;
      const ffArea = 36 * 24;

      const aspect = sW / sH;
      const imgH = Math.sqrt(totalPixels / aspect);
      const imgW = imgH * aspect;
      const pixelPitch = (sW / imgW) * 1000;

      document.getElementById('ks-crop')!.textContent = cropFactor.toFixed(2).replace('.', ',') + 'x';
      document.getElementById('ks-area')!.textContent = sArea.toFixed(1).replace('.', ',') + ' mm\u00b2';
      document.getElementById('ks-pitch')!.textContent = pixelPitch.toFixed(2).replace('.', ',') + ' \u00b5m';
      document.getElementById('ks-density')!.textContent = (mp / sArea * 100).toFixed(1).replace('.', ',') + ' MP/cm\u00b2';
      document.getElementById('ks-diag')!.textContent = sDiag.toFixed(1).replace('.', ',') + ' mm';
      document.getElementById('ks-dims')!.textContent = Math.round(imgW) + ' x ' + Math.round(imgH);
      document.getElementById('ks-area-pct')!.textContent = ((sArea / ffArea) * 100).toFixed(1).replace('.', ',') + '%';

      const formats = [
        { name: 'Mittelformat', w: 53.4, h: 40 },
        { name: 'Vollformat', w: 36, h: 24 },
        { name: 'APS-C', w: 23.5, h: 15.6 },
        { name: 'Micro 4/3', w: 17.3, h: 13 },
        { name: '1-Zoll', w: 13.2, h: 8.8 },
      ];

      let html = '';
      formats.forEach(f => {
        const fArea = f.w * f.h;
        const ratio = (sArea / fArea * 100).toFixed(0);
        html += '<div class="flex justify-between"><span>' + f.name + ' (' + f.w + 'x' + f.h + 'mm)</span><span class="font-bold">' + ratio + '% davon</span></div>';
      });
      document.getElementById('ks-compare')!.innerHTML = html;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ks-in').forEach(el => {
        el.addEventListener('input', calcKS);
        el.addEventListener('change', calcKS);
      });
      calcKS();
    }, 50);
  </script>
</CalculatorLayout>
