---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "CO₂-Fußabdruck-Rechner – Jährliche Emissionen berechnen";
const description = "Berechnen Sie Ihren jährlichen CO₂-Fußabdruck aus Verkehr, Hausenergie und Lebensstil. Erfahren Sie, wie Sie Ihre Emissionen senken können.";
const relatedCalcs = [
  { name: "CO₂-Kompensation-Rechner", url: "/de/co2-kompensation-rechner", description: "CO₂ kompensieren." },
  { name: "CO₂-Steuer-Rechner", url: "/de/co2-steuer-rechner", description: "CO₂-Steuer berechnen." },
  { name: "Kohlenstoffbindung-Rechner", url: "/de/kohlenstoffbindung-rechner", description: "CO₂-Aufnahme durch Bäume." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="CO₂-Fußabdruck-Rechner" enSlug="carbon-footprint-calculator" keywords="CO₂ Fußabdruck, Kohlendioxid Emissionen, Klimarechner, Treibhausgas, Umwelt" breadcrumbs={[{ name: "CO₂-Fußabdruck-Rechner", url: "/de/co2-fussabdruck-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">CO₂-Fußabdruck-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Ihre jährlichen CO₂-Emissionen aus dem Alltag.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Verkehr</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gefahrene km/Jahr</label><input type="number" id="cfd-km" class="cfd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (l/100km)</label><input type="number" id="cfd-lper100" class="cfd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Flüge pro Jahr (Hin & Rück)</label><input type="number" id="cfd-flights" class="cfd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="50" step="1"></div>
        <h3 class="font-semibold text-text">Hausenergie</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Strom (kWh/Monat)</label><input type="number" id="cfd-elec" class="cfd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Erdgas (kWh/Monat)</label><input type="number" id="cfd-gas" class="cfd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
        </div>
        <h3 class="font-semibold text-text">Ernährung</h3>
        <div>
          <select id="cfd-diet" class="cfd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="heavy">Viel Fleisch (3,3 t/Jahr)</option>
            <option value="medium">Durchschnittlich (2,5 t/Jahr)</option>
            <option value="light">Wenig Fleisch (1,7 t/Jahr)</option>
            <option value="veg">Vegetarisch (1,4 t/Jahr)</option>
            <option value="vegan">Vegan (1,0 t/Jahr)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jährlicher CO₂-Fußabdruck</div>
          <div class="text-4xl font-extrabold" id="cfd-total">0</div>
          <div class="text-sm text-blue-200 mt-1">Tonnen CO₂/Jahr</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">DE-Durchschnitt</div><div class="text-xl font-bold">8,9 Tonnen</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Weltdurchschnitt</div><div class="text-xl font-bold">4,8 Tonnen</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Aufschlüsselung</h3>
          <div class="space-y-2" id="cfd-breakdown"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Bäume zum Ausgleich nötig</div>
          <div class="text-2xl font-bold" id="cfd-trees">0 Bäume</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="carbon-footprint" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Den CO₂-Fußabdruck verstehen</h2>
      <p>Der durchschnittliche Deutsche verursacht rund 8,9 Tonnen CO₂ pro Jahr. Der globale Durchschnitt liegt bei 4,8 Tonnen. Um die Erderwärmung auf 1,5 °C zu begrenzen, müssen wir bis 2050 unter 2 Tonnen pro Person kommen.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Wie wird der CO₂-Fußabdruck berechnet?</strong> Die Berechnung basiert auf typischen Emissionsfaktoren für Autofahren, Fliegen, Strom, Heizung und Ernährung.</p>
      <p><strong>Wie kann ich meinen Fußabdruck senken?</strong> Weniger fliegen, öffentliche Verkehrsmittel nutzen, auf Ökostrom umsteigen und pflanzliche Ernährung bevorzugen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const dietTons: Record<string, number> = { heavy: 3.3, medium: 2.5, light: 1.7, veg: 1.4, vegan: 1.0 };
    function calcCFD() {
      const km = parseFloat((document.getElementById('cfd-km') as HTMLInputElement).value) || 0;
      const lper100 = parseFloat((document.getElementById('cfd-lper100') as HTMLInputElement).value) || 7;
      const flights = parseFloat((document.getElementById('cfd-flights') as HTMLInputElement).value) || 0;
      const elec = parseFloat((document.getElementById('cfd-elec') as HTMLInputElement).value) || 0;
      const gas = parseFloat((document.getElementById('cfd-gas') as HTMLInputElement).value) || 0;
      const diet = (document.getElementById('cfd-diet') as HTMLSelectElement).value;
      const carCO2 = (km * lper100 / 100) * 2.31 / 1000;
      const flightCO2 = flights * 1.6;
      const elecCO2 = elec * 12 * 0.000385;
      const gasCO2 = gas * 12 * 0.000201;
      const dietCO2 = dietTons[diet] || 2.5;
      const total = carCO2 + flightCO2 + elecCO2 + gasCO2 + dietCO2;
      document.getElementById('cfd-total')!.textContent = total.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('cfd-trees')!.textContent = Math.ceil(total / 0.022) + ' Bäume';
      const items = [
        { label: 'Autofahren', val: carCO2 },
        { label: 'Flüge', val: flightCO2 },
        { label: 'Strom', val: elecCO2 },
        { label: 'Erdgas', val: gasCO2 },
        { label: 'Ernährung', val: dietCO2 },
      ];
      const maxVal = Math.max(...items.map(i => i.val), 0.1);
      document.getElementById('cfd-breakdown')!.innerHTML = items.map(i =>
        '<div class="flex justify-between items-center"><span class="text-sm">' + i.label + '</span><div class="flex items-center gap-2"><div class="w-24 bg-gray-200 rounded-full h-2"><div class="bg-primary rounded-full h-2" style="width:' + (total > 0 ? (i.val/total*100).toFixed(0) : 0) + '%"></div></div><span class="text-sm font-bold">' + i.val.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + 't</span></div></div>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cfd-km') as HTMLInputElement).value = '15000';
      (document.getElementById('cfd-lper100') as HTMLInputElement).value = '7';
      (document.getElementById('cfd-flights') as HTMLInputElement).value = '2';
      (document.getElementById('cfd-elec') as HTMLInputElement).value = '300';
      (document.getElementById('cfd-gas') as HTMLInputElement).value = '800';
      (document.getElementById('cfd-diet') as HTMLSelectElement).value = 'medium';
      document.querySelectorAll('.cfd-in').forEach(el => { el.addEventListener('input', calcCFD); el.addEventListener('change', calcCFD); });
      calcCFD();
    }, 50);
  </script>
</CalculatorLayout>
