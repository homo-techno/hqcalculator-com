---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Backen-Höhenanpassungsrechner - Anpassungen für große Höhen";
const description = "Passen Sie Backrezepte für große Höhen an. Erhalten Sie Korrekturen für Temperatur, Triebmittel, Zucker, Flüssigkeit und Backzeit basierend auf Ihrer Höhenlage.";
const relatedCalcs = [
  { name: "Bäckerprozent-Rechner", url: "/de/baeckerprozent-rechner", description: "Bäckerprozente berechnen." },
  { name: "Kuchenform-Umrechner", url: "/de/kuchenform-umrechner", description: "Zwischen Formgrößen umrechnen." },
  { name: "Keksmengen-Rechner", url: "/de/keksmengen-rechner", description: "Keksrezepte skalieren." },
  { name: "Brotmehl-Rechner", url: "/de/brotmehl-rechner", description: "Mehlprotein und Ersatz." },
  { name: "Backumrechnungsrechner", url: "/de/backumrechnung-rechner", description: "Backeinheiten umrechnen." },
  { name: "Teighydratation-Rechner", url: "/de/teighydratation-rechner", description: "Teighydratation berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Backen-Höhenanpassungsrechner" keywords="Höhenbacken, Höhenanpassung, Backen in der Höhe, Bergbacken, Höhenrezept, Höhenkorrektur" breadcrumbs={[{ name: "Backen Höhenanpassung", url: "/de/backen-hoehe-rechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Backen-Höhenanpassungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Passen Sie Ihre Backrezepte für große Höhen an. Erhalten Sie spezifische Korrekturen für Temperatur, Triebmittel, Zucker und Flüssigkeitsmenge.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Ihre Höhenlage (Meter)</label>
          <input type="number" id="ba2-alt" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="0" max="5000" step="50">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Backart</label>
          <select id="ba2-type" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="cake">Kuchen</option>
            <option value="cookies">Kekse</option>
            <option value="bread">Hefebrot</option>
            <option value="quickbread">Schnellbrot / Muffins</option>
            <option value="pie">Kuchen (Pie)</option>
          </select>
        </div>
        <h3 class="font-bold text-text text-sm uppercase tracking-wide">Ihre Meereshöhen-Rezeptwerte</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ofentemp. (&deg;C)</label>
            <input type="number" id="ba2-temp" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="175" min="100" max="260" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Backpulver (TL)</label>
            <input type="number" id="ba2-bp" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" max="10" step="0.25">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zucker (Gramm)</label>
            <input type="number" id="ba2-sugar" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="0" max="1000" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Flüssigkeit (ml)</label>
            <input type="number" id="ba2-liquid" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="250" min="0" max="2000" step="10">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Angepasste Ofentemperatur</div>
          <div class="text-5xl font-extrabold font-mono" id="ba2-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Backpulver</div>
            <div class="text-xl font-bold font-mono" id="ba2-bp-adj">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zucker</div>
            <div class="text-xl font-bold font-mono" id="ba2-sugar-adj">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Flüssigkeit</div>
            <div class="text-xl font-bold font-mono" id="ba2-liquid-adj">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Siedepunkt</div>
            <div class="text-xl font-bold font-mono" id="ba2-boil">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Zusätzliche Tipps</div>
          <div class="text-sm text-text-secondary" id="ba2-tips">--</div>
        </div>
      </div>
      <ShareButton calculatorId="baking-altitude" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBA2() {
      const altM = parseFloat((document.getElementById('ba2-alt') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('ba2-type') as HTMLSelectElement).value;
      const temp = parseFloat((document.getElementById('ba2-temp') as HTMLInputElement).value) || 175;
      const bp = parseFloat((document.getElementById('ba2-bp') as HTMLInputElement).value) || 0;
      const sugar = parseFloat((document.getElementById('ba2-sugar') as HTMLInputElement).value) || 0;
      const liquid = parseFloat((document.getElementById('ba2-liquid') as HTMLInputElement).value) || 0;

      let tempAdd = 0, bpReduce = 0, sugarReduce = 0, liquidAdd = 0;

      if (altM >= 900 && altM < 1500) {
        tempAdd = 8;
        bpReduce = 0.125;
        sugarReduce = 0.0625;
        liquidAdd = 0.083;
      } else if (altM >= 1500 && altM < 2100) {
        tempAdd = 14;
        bpReduce = 0.25;
        sugarReduce = 0.125;
        liquidAdd = 0.125;
      } else if (altM >= 2100 && altM < 3000) {
        tempAdd = 14;
        bpReduce = 0.375;
        sugarReduce = 0.1875;
        liquidAdd = 0.1875;
      } else if (altM >= 3000) {
        tempAdd = 14;
        bpReduce = 0.5;
        sugarReduce = 0.25;
        liquidAdd = 0.25;
      }

      const adjTemp = temp + tempAdd;
      const adjBp = Math.max(0, bp * (1 - bpReduce));
      const adjSugar = Math.round(sugar * (1 - sugarReduce));
      const adjLiquid = Math.round(liquid * (1 + liquidAdd));

      const boilC = 100 - (altM / 300);
      const boilF = boilC * 9 / 5 + 32;

      document.getElementById('ba2-result')!.textContent = adjTemp + '\u00B0C (+' + tempAdd + '\u00B0)';
      document.getElementById('ba2-bp-adj')!.textContent = adjBp.toFixed(2).replace('.', ',') + ' TL';
      document.getElementById('ba2-sugar-adj')!.textContent = adjSugar + ' g';
      document.getElementById('ba2-liquid-adj')!.textContent = adjLiquid + ' ml';
      document.getElementById('ba2-boil')!.textContent = boilC.toFixed(0) + '\u00B0C / ' + boilF.toFixed(0) + '\u00B0F';

      let tips = '';
      if (altM < 900) {
        tips = 'Unter 900 m: In der Regel keine Höhenanpassungen nötig.';
      } else if (type === 'cake') {
        tips = 'Für Kuchen: Ofentemperatur erhöhen, Zucker und Triebmittel reduzieren, Flüssigkeit erhöhen. Ein zusätzliches Ei für Struktur verwenden. Formen großzügiger einfetten.';
      } else if (type === 'cookies') {
        tips = 'Für Kekse: Mehl leicht erhöhen (1-2 EL pro Tasse), Zucker leicht reduzieren, Flüssigkeit erhöhen. Backzeit verkürzen.';
      } else if (type === 'bread') {
        tips = 'Für Hefebrot: Gehzeit verkürzen (Teig geht in der Höhe schneller). Hefe um ca. 25% reduzieren. Eventuell etwas mehr Mehl nötig.';
      } else if (type === 'quickbread') {
        tips = 'Für Schnellbrot: Backpulver reduzieren, Flüssigkeit erhöhen und Ofentemperatur erhöhen. 2-4 EL Mehl pro Tasse für Struktur hinzufügen.';
      } else {
        tips = 'Für Kuchen (Pie): Ofentemperatur erhöhen. Füllung benötigt eventuell mehr Verdickungsmittel, da Flüssigkeiten bei niedrigerer Temperatur kochen.';
      }
      document.getElementById('ba2-tips')!.textContent = tips;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ba2-in').forEach(el => { el.addEventListener('input', calcBA2); el.addEventListener('change', calcBA2); });
      calcBA2();
    }, 50);
  </script>
</CalculatorLayout>
