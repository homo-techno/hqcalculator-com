---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kaloriendefizit-Rechner - Gewichtsverlust planen";
const description = "Berechnen Sie Ihr t\u00e4gliches Kalorienziel f\u00fcr die Gewichtsabnahme. Setzen Sie TDEE, Defizit und Zielgewicht f\u00fcr Ihren Zeitplan.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Verbrauch." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlaf." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlage." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kaloriendefizit-Rechner" lang="de" enSlug="caloric-deficit-calculator" keywords="kaloriendefizit, gewichtsverlust, kalorienziel, TDEE, fettabbau, di\u00e4t rechner" breadcrumbs={[{ name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kaloriendefizit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Gewichtsabnahme mit einem nachhaltigen Kaloriendefizit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">TDEE (kcal/Tag)</label><input type="number" id="kd-tdee" class="kd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2200" min="800" max="6000" step="50"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">T&auml;gliches Defizit (kcal)</label>
            <select id="kd-def" class="kd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="250">250 kcal (langsam/leicht)</option>
              <option value="500" selected>500 kcal (Standard)</option>
              <option value="750">750 kcal (aggressiv)</option>
              <option value="1000">1000 kcal (max. sicher)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Gewicht (kg)</label><input type="number" id="kd-cur" class="kd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" min="40" max="250" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zielgewicht (kg)</label><input type="number" id="kd-goal" class="kd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="77" min="40" max="200" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">T&auml;gliches Kalorienziel</div>
          <div class="text-5xl font-extrabold font-mono" id="kd-target">0</div>
          <div class="text-sm text-blue-200 mt-1">Kalorien/Tag</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">W&ouml;chentl. Verlust</div><div class="text-xl font-bold" id="kd-wkloss">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wochen bis Ziel</div><div class="text-xl font-bold" id="kd-weeks">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zieldatum</div><div class="text-xl font-bold" id="kd-date">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">W&ouml;chentl. Defizit</div><div class="text-xl font-bold" id="kd-wkdef">0 kcal</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kg abzunehmen</div><div class="text-xl font-bold" id="kd-fat">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Sichere Defizit-Richtlinien</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>250 kcal Defizit</span><span class="font-bold">~0,25 kg/Woche</span></div>
            <div class="flex justify-between"><span>500 kcal Defizit</span><span class="font-bold">~0,5 kg/Woche</span></div>
            <div class="flex justify-between"><span>750 kcal Defizit</span><span class="font-bold">~0,75 kg/Woche</span></div>
            <div class="flex justify-between"><span>1000 kcal Defizit</span><span class="font-bold">~1 kg/Woche</span></div>
            <div class="flex justify-between"><span>Min. Frauen</span><span class="font-bold">1200 kcal/Tag</span></div>
            <div class="flex justify-between"><span>Min. M&auml;nner</span><span class="font-bold">1500 kcal/Tag</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="caloric-deficit" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kaloriendefizit f&uuml;r Gewichtsverlust</h2>
      <p>Ein Kilogramm K&ouml;rperfett enth&auml;lt etwa 7.700 Kalorien. Ein t&auml;gliches Defizit von 500 Kalorien sollte ca. 0,5 kg Gewichtsverlust pro Woche erzeugen. Ihr TDEE (Gesamtenergieumsatz) umfasst Ihren Grundumsatz plus Kalorien durch Aktivit&auml;t. Gehen Sie nie unter 1.200 kcal/Tag (Frauen) oder 1.500 kcal/Tag (M&auml;nner) ohne &auml;rztliche Aufsicht.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcDefizit() {
      const tdee = parseInt((document.getElementById('kd-tdee') as HTMLInputElement).value) || 2200;
      const deficit = parseInt((document.getElementById('kd-def') as HTMLSelectElement).value) || 500;
      const curWt = parseFloat((document.getElementById('kd-cur') as HTMLInputElement).value) || 90;
      const goalWt = parseFloat((document.getElementById('kd-goal') as HTMLInputElement).value) || 77;
      const target = Math.max(1200, tdee - deficit);
      const actualDeficit = tdee - target;
      const weeklyLossKg = (actualDeficit * 7) / 7700;
      const kgToLose = Math.max(0, curWt - goalWt);
      const weeks = weeklyLossKg > 0 ? Math.ceil(kgToLose / weeklyLossKg) : 0;
      const targetDate = new Date();
      targetDate.setDate(targetDate.getDate() + weeks * 7);
      const months = ['Jan','Feb','M\u00e4r','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
      document.getElementById('kd-target')!.textContent = target.toLocaleString('de-DE');
      document.getElementById('kd-wkloss')!.textContent = weeklyLossKg.toFixed(2).replace('.', ',') + ' kg';
      document.getElementById('kd-weeks')!.textContent = weeks.toString();
      document.getElementById('kd-date')!.textContent = months[targetDate.getMonth()] + ' ' + targetDate.getFullYear();
      document.getElementById('kd-wkdef')!.textContent = (actualDeficit * 7).toLocaleString('de-DE') + ' kcal';
      document.getElementById('kd-fat')!.textContent = kgToLose.toFixed(1).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kd-in').forEach(el => { el.addEventListener('input', calcDefizit); el.addEventListener('change', calcDefizit); });
      calcDefizit();
    }, 50);
  </script>
</CalculatorLayout>
