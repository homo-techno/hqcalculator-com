---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Sch\u00e4rfentiefe-Rechner - DoF, Hyperfokaldistanz & Zerstreuungskreis";
const description = "Berechnen Sie die Sch\u00e4rfentiefe aus Brennweite, Blende und Motivabstand. Finden Sie Nah-/Ferngrenze, Hyperfokaldistanz und Zerstreuungskreis.";

const relatedCalcs = [
  { name: "Belichtungsrechner", url: "/de/belichtungsrechner", description: "Belichtungsdreieck." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Seitenverh\u00e4ltnis-Rechner", url: "/de/seitenverhaeltnis-rechner", description: "Seitenverh\u00e4ltnisse." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Mathematische Berechnungen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Sch\u00e4rfentiefe-Rechner" lang="de" enSlug="depth-of-field-calculator" keywords="schaerfentiefe rechner, dof rechner, hyperfokaldistanz, zerstreuungskreis, blende, bokeh, geringe schaerfentiefe" breadcrumbs={[{ name: "Sch\u00e4rfentiefe-Rechner", url: "/de/schaerfentiefe-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Sch&auml;rfentiefe-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Sch&auml;rfentiefe, Nah-/Ferngrenzen und Hyperfokaldistanz aus Ihren Kameraeinstellungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Sensorformat</label>
          <select id="stf-sensor" class="stf-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.029">Vollformat (35mm)</option>
            <option value="0.019">APS-C (Canon)</option>
            <option value="0.018">APS-C (Nikon/Sony)</option>
            <option value="0.015">Micro Four Thirds</option>
            <option value="0.011">1-Zoll-Sensor</option>
            <option value="0.006">1/2,3-Zoll (Kompakt)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Brennweite (mm)</label>
          <input type="number" id="stf-focal" class="stf-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="50" min="1" max="2000" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Blende (f/)</label>
          <input type="number" id="stf-aperture" class="stf-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="2.8" min="0.7" max="128" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Motivabstand</label>
          <div class="flex gap-2">
            <input type="number" id="stf-distance" class="stf-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="0.01" step="0.1">
            <select id="stf-unit" class="stf-in px-4 py-3 border border-border rounded-xl text-lg">
              <option value="m">Meter</option>
              <option value="ft">Fu&szlig;</option>
            </select>
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Sch&auml;rfentiefe</div>
          <div class="text-4xl font-extrabold" id="stf-total"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Nahgrenze</div>
            <div class="text-xl font-bold text-text" id="stf-near"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Ferngrenze</div>
            <div class="text-xl font-bold text-text" id="stf-far"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Hyperfokaldistanz</div>
            <div class="text-xl font-bold text-text" id="stf-hyper"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Zerstreuungskreis</div>
            <div class="text-xl font-bold text-text" id="stf-coc"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Sch&auml;rfe davor</div>
            <div class="text-xl font-bold text-text" id="stf-front"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Sch&auml;rfe dahinter</div>
            <div class="text-xl font-bold text-text" id="stf-behind"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="depth-of-field-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Sch&auml;rfentiefe verstehen</h2>
      <p>Die Sch&auml;rfentiefe (DoF) ist der Entfernungsbereich, in dem Objekte akzeptabel scharf erscheinen. Sie h&auml;ngt von Brennweite, Blende, Motivabstand und Sensorgr&ouml;&szlig;e ab.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie erhalte ich geringe Sch&auml;rfentiefe?</strong> Verwenden Sie eine offene Blende (kleine f-Zahl), l&auml;ngere Brennweite oder gehen Sie n&auml;her an Ihr Motiv heran.</p>
      <p><strong>Was ist die Hyperfokaldistanz?</strong> Der k&uuml;rzeste Fokusabstand, bei dem alles von der halben Distanz bis Unendlich akzeptabel scharf ist.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSTF() {
      const cocMM = parseFloat((document.getElementById('stf-sensor') as HTMLSelectElement).value);
      const f = parseFloat((document.getElementById('stf-focal') as HTMLInputElement).value) || 50;
      const N = parseFloat((document.getElementById('stf-aperture') as HTMLInputElement).value) || 2.8;
      const unit = (document.getElementById('stf-unit') as HTMLSelectElement).value;
      let dist = parseFloat((document.getElementById('stf-distance') as HTMLInputElement).value) || 3;

      const distM = unit === 'ft' ? dist * 0.3048 : dist;
      const distMM = distM * 1000;
      const c = cocMM;

      const H = (f * f) / (N * c) + f;
      const nearMM = (distMM * (H - f)) / (H + distMM - 2 * f);
      const farMM = distMM >= H ? Infinity : (distMM * (H - f)) / (H - distMM);
      const dofMM = farMM === Infinity ? Infinity : farMM - nearMM;

      function formatDist(mm: number): string {
        if (!isFinite(mm)) return 'Unendlich';
        if (unit === 'ft') {
          const ft = mm / 304.8;
          return ft >= 100 ? ft.toFixed(0) + ' ft' : ft.toFixed(2) + ' ft';
        }
        if (mm >= 1000) return (mm / 1000).toFixed(2).replace('.', ',') + ' m';
        return mm.toFixed(1).replace('.', ',') + ' mm';
      }

      document.getElementById('stf-total')!.textContent = formatDist(dofMM);
      document.getElementById('stf-near')!.textContent = formatDist(nearMM);
      document.getElementById('stf-far')!.textContent = formatDist(farMM);
      document.getElementById('stf-hyper')!.textContent = formatDist(H);
      document.getElementById('stf-coc')!.textContent = c.toFixed(3).replace('.', ',') + ' mm';

      const frontMM = distMM - nearMM;
      const behindMM = farMM === Infinity ? Infinity : farMM - distMM;
      document.getElementById('stf-front')!.textContent = formatDist(frontMM);
      document.getElementById('stf-behind')!.textContent = formatDist(behindMM);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.stf-in').forEach(el => {
        el.addEventListener('input', calcSTF);
        el.addEventListener('change', calcSTF);
      });
      calcSTF();
    }, 50);
  </script>
</CalculatorLayout>
