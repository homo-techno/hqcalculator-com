---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Edelstein-Karat-Rechner - Gewicht aus Abmessungen & Wert";
const description = "Sch\u00E4tzen Sie das Karatgewicht eines Edelsteins aus seinen Abmessungen nach Form, den ungef\u00E4hren Wert nach Typ und Qualit\u00E4t sowie den Preis pro Karat.";
const relatedCalcs = [
  { name: "Gewichtsumrechner", url: "/de/gewichtsumrechner", description: "Gewichtseinheiten." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumenformen." },
  { name: "Dichterechner", url: "/de/dichterechner", description: "Materialdichte." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Edelstein-Karat-Rechner" lang="de" enSlug="gem-carat-calculator" keywords="edelstein karat, edelstein gewicht, karat aus abmessungen, edelstein wert, preis pro karat, gemmologie rechner" breadcrumbs={[{ name: "Edelstein-Karat", url: "/de/edelstein-karat-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Edelstein-Karat-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie das Karatgewicht eines Edelsteins aus Abmessungen und Form, mit ungef&auml;hrem Wert nach Edelsteintyp und Qualit&auml;tsstufe.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Edelsteintyp</label>
            <select id="ekr-type" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="diamond">Diamant</option>
              <option value="ruby">Rubin</option>
              <option value="sapphire">Saphir</option>
              <option value="emerald" selected>Smaragd</option>
              <option value="aquamarine">Aquamarin</option>
              <option value="topaz">Topas</option>
              <option value="amethyst">Amethyst</option>
              <option value="garnet">Granat</option>
              <option value="opal">Opal</option>
              <option value="tourmaline">Turmalin</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Schliffform</label>
            <select id="ekr-shape" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="round">Brillant (rund)</option>
              <option value="oval" selected>Oval</option>
              <option value="emerald">Smaragdschliff</option>
              <option value="pear">Tropfen</option>
              <option value="marquise">Marquise</option>
              <option value="cushion">Kissen</option>
              <option value="princess">Prinzess (quadratisch)</option>
              <option value="cabochon">Cabochon</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">L&auml;nge (mm)</label><input type="number" id="ekr-len" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="8" min="0" step="0.1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Breite (mm)</label><input type="number" id="ekr-wid" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="6" min="0" step="0.1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Tiefe (mm)</label><input type="number" id="ekr-dep" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="4" min="0" step="0.1"></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Qualit&auml;tsstufe</label>
          <select id="ekr-quality" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="commercial">Kommerziell (niedriger)</option>
            <option value="good" selected>Gut (durchschnittlich)</option>
            <option value="fine">Fein (hohe Qualit&auml;t)</option>
            <option value="exceptional">Au&szlig;ergew&ouml;hnlich (Museumsqualit&auml;t)</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tztes Karatgewicht</div>
          <div class="text-4xl font-extrabold" id="ekr-carat">0</div>
          <div class="text-sm text-blue-200 mt-1">Karat</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewicht (Gramm)</div>
            <div class="text-xl font-bold" id="ekr-grams">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewicht (mg)</div>
            <div class="text-xl font-bold" id="ekr-mg">0</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesch. Preis/Karat</div>
            <div class="text-xl font-bold text-secondary" id="ekr-ppc">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesch. Gesamtwert</div>
            <div class="text-xl font-bold text-secondary" id="ekr-value">0 &euro;</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Volumen (mm&sup3;)</div>
          <div class="text-xl font-bold" id="ekr-vol">0</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Edelstein-Dichte-Referenz</div>
          <div class="grid grid-cols-2 gap-1 text-xs">
            <div class="flex justify-between p-1"><span>Diamant</span><span class="font-bold">3,52 g/cm&sup3;</span></div>
            <div class="flex justify-between p-1"><span>Rubin/Saphir</span><span class="font-bold">4,00 g/cm&sup3;</span></div>
            <div class="flex justify-between p-1"><span>Smaragd</span><span class="font-bold">2,72 g/cm&sup3;</span></div>
            <div class="flex justify-between p-1"><span>Topas</span><span class="font-bold">3,53 g/cm&sup3;</span></div>
            <div class="flex justify-between p-1"><span>Amethyst</span><span class="font-bold">2,65 g/cm&sup3;</span></div>
            <div class="flex justify-between p-1"><span>Opal</span><span class="font-bold">2,10 g/cm&sup3;</span></div>
          </div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="gem-carat" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Karat-Gewichtssch&auml;tzung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Gewicht (ct)</strong> = L &times; B &times; T &times; Formfaktor &times; Dichte / 200</p>
        <p><strong>1 Karat</strong> = 200 Milligramm = 0,2 Gramm</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie genau ist die Sch&auml;tzung?</strong> Die Formel liefert eine N&auml;herung. Das tats&auml;chliche Gewicht h&auml;ngt von der genauen Schliffqualit&auml;t ab.</p>
      <p><strong>Was beeinflusst den Preis?</strong> Farbe, Reinheit, Schliffqualit&auml;t und Karatgewicht bestimmen den Edelsteinwert.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcEKR() {
      const gemDensity: Record<string, number> = {
        diamond: 3.52, ruby: 4.00, sapphire: 4.00, emerald: 2.72,
        aquamarine: 2.72, topaz: 3.53, amethyst: 2.65, garnet: 3.80,
        opal: 2.10, tourmaline: 3.10
      };
      const shapeFactors: Record<string, number> = {
        round: 0.0061, oval: 0.0062, emerald: 0.0080, pear: 0.0059,
        marquise: 0.0059, cushion: 0.0065, princess: 0.0083, cabochon: 0.0070
      };
      const pricePerCarat: Record<string, Record<string, number>> = {
        diamond:     { commercial: 2700, good: 7200, fine: 18000, exceptional: 54000 },
        ruby:        { commercial: 450, good: 2700, fine: 13500, exceptional: 45000 },
        sapphire:    { commercial: 360, good: 1800, fine: 9000, exceptional: 36000 },
        emerald:     { commercial: 270, good: 1800, fine: 9000, exceptional: 31500 },
        aquamarine:  { commercial: 45, good: 180, fine: 540, exceptional: 1800 },
        topaz:       { commercial: 9, good: 45, fine: 270, exceptional: 900 },
        amethyst:    { commercial: 5, good: 18, fine: 72, exceptional: 225 },
        garnet:      { commercial: 9, good: 45, fine: 270, exceptional: 1350 },
        opal:        { commercial: 27, good: 180, fine: 1800, exceptional: 9000 },
        tourmaline:  { commercial: 27, good: 180, fine: 900, exceptional: 4500 },
      };
      const gemType = (document.getElementById('ekr-type') as HTMLSelectElement).value;
      const shape = (document.getElementById('ekr-shape') as HTMLSelectElement).value;
      const len = parseFloat((document.getElementById('ekr-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('ekr-wid') as HTMLInputElement).value) || 0;
      const dep = parseFloat((document.getElementById('ekr-dep') as HTMLInputElement).value) || 0;
      const quality = (document.getElementById('ekr-quality') as HTMLSelectElement).value;
      const sg = gemDensity[gemType] || 2.65;
      const sf = shapeFactors[shape] || 0.0062;
      const carat = len * wid * dep * sf * sg;
      const grams = carat * 0.2;
      const mg = grams * 1000;
      const volumeMm3 = (grams / sg) * 1000;
      const ppc = (pricePerCarat[gemType] || pricePerCarat.amethyst)[quality] || 45;
      const totalValue = carat * ppc;
      const fmt = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 2 });
      document.getElementById('ekr-carat')!.textContent = carat.toFixed(3);
      document.getElementById('ekr-grams')!.textContent = grams.toFixed(4) + ' g';
      document.getElementById('ekr-mg')!.textContent = fmt(mg) + ' mg';
      document.getElementById('ekr-ppc')!.textContent = fmt(ppc) + ' \u20AC';
      document.getElementById('ekr-value')!.textContent = fmt(totalValue) + ' \u20AC';
      document.getElementById('ekr-vol')!.textContent = fmt(volumeMm3) + ' mm\u00B3';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ekr-in').forEach(el => { el.addEventListener('input', calcEKR); el.addEventListener('change', calcEKR); });
      calcEKR();
    }, 50);
  </script>
</CalculatorLayout>
