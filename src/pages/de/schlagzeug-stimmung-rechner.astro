---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schlagzeug-Stimmung-Rechner - Fellspannung & Frequenz";
const description = "Berechnen Sie die optimale Stimmung für Ihre Trommeln. Ermitteln Sie Frequenzen, Fellspannung und Stimmverhältnisse für Snare, Toms und Bassdrum.";

const relatedCalcs = [
  { name: "Frequenzrechner", url: "/de/frequenzrechner", description: "Frequenz berechnen." },
  { name: "BPM-Rechner", url: "/de/bpm-rechner", description: "Tempo berechnen." },
  { name: "Dezibel-Rechner", url: "/de/dezibel-rechner", description: "Lautstärke berechnen." },
  { name: "Wellenlaenge-Rechner", url: "/de/wellenlaenge-rechner", description: "Wellenlänge berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Schlagzeug-Stimmung-Rechner" lang="de" enSlug="drum-tuning-calculator" keywords="schlagzeug stimmung, trommel frequenz, fellspannung, drum tuning, snare stimmung, tom stimmung" breadcrumbs={[{ name: "Schlagzeug-Stimmung-Rechner", url: "/de/schlagzeug-stimmung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schlagzeug-Stimmung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die optimale Stimmfrequenz f&uuml;r Ihre Trommeln basierend auf Durchmesser, Trommeltyp und gew&uuml;nschter Tonh&ouml;he.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Trommeldurchmesser (Zoll)</label><input type="number" id="drt-diam" class="drt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="4" max="26"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Trommeltyp</label><select id="drt-type" class="drt-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="snare">Snare</option><option value="rack">Rack Tom</option><option value="floor">Floor Tom</option><option value="kick">Bassdrum</option></select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stimmung</label><select id="drt-tuning" class="drt-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="low">Tief</option><option value="medium">Mittel</option><option value="high">Hoch</option></select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Schlagfell / Resonanzfell</label><select id="drt-head" class="drt-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="batter">Schlagfell</option><option value="reso">Resonanzfell</option></select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Frequenz</div>
          <div class="text-5xl font-extrabold font-mono" id="drt-result">0 Hz</div>
          <div class="text-sm text-blue-200 mt-1" id="drt-note"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">N&auml;chste Note</div><div class="text-xl font-bold" id="drt-nearest">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reso-Verh&auml;ltnis</div><div class="text-xl font-bold" id="drt-ratio">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="drt-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="drum-tuning-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Schlagzeug richtig stimmen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Grundfrequenz = Basisfaktor / Durchmesser &times; Stimmungsfaktor</p>
        <p>Reso-Frequenz = Schlagfell-Frequenz &times; Verh&auml;ltnis</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie stimme ich Schlagfell und Resonanzfell aufeinander ab?</strong> Das Resonanzfell wird typischerweise etwas h&ouml;her (1,3&ndash;1,5&times;) oder gleich hoch wie das Schlagfell gestimmt.</p>
      <p><strong>Welche Frequenz ist f&uuml;r eine Snare typisch?</strong> Eine 14-Zoll-Snare wird oft zwischen 200 und 330 Hz gestimmt, je nach gew&uuml;nschtem Sound.</p>
      <p><strong>Wie beeinflusst der Durchmesser die Frequenz?</strong> Gr&ouml;&szlig;ere Trommeln erzeugen tiefere T&ouml;ne bei gleicher Fellspannung.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDrt() {
      const diam = parseFloat((document.getElementById('drt-diam') as HTMLInputElement).value) || 14;
      const type = (document.getElementById('drt-type') as HTMLSelectElement).value;
      const tuning = (document.getElementById('drt-tuning') as HTMLSelectElement).value;
      const head = (document.getElementById('drt-head') as HTMLSelectElement).value;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      const steps: string[] = [];
      const baseFreqs: Record<string, number> = { snare: 3400, rack: 2800, floor: 2200, kick: 1600 };
      const tuningMult: Record<string, number> = { low: 0.8, medium: 1.0, high: 1.25 };
      const resoRatios: Record<string, number> = { snare: 1.3, rack: 1.4, floor: 1.3, kick: 0.9 };
      const baseF = baseFreqs[type] || 3400;
      const tMult = tuningMult[tuning] || 1.0;
      const batterFreq = (baseF / diam) * tMult;
      steps.push('Basis = ' + baseF + ' / ' + diam + '" = ' + fmt(baseF / diam) + ' Hz');
      steps.push('Stimmung (' + tuning + ') = ' + fmt(baseF / diam) + ' x ' + tMult + ' = ' + fmt(batterFreq) + ' Hz');
      const resoR = resoRatios[type] || 1.3;
      const resoFreq = batterFreq * resoR;
      steps.push('Reso-Frequenz = ' + fmt(batterFreq) + ' x ' + resoR + ' = ' + fmt(resoFreq) + ' Hz');
      const finalFreq = head === 'batter' ? batterFreq : resoFreq;
      const noteNames = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
      const semitones = 12 * Math.log2(finalFreq / 440) + 69;
      const nearestMidi = Math.round(semitones);
      const nearestNote = noteNames[nearestMidi % 12] + Math.floor(nearestMidi / 12 - 1);
      const nearestFreq = 440 * Math.pow(2, (nearestMidi - 69) / 12);
      steps.push('Naechste Note: ' + nearestNote + ' (' + fmt(nearestFreq) + ' Hz)');
      document.getElementById('drt-result')!.textContent = fmt(finalFreq) + ' Hz';
      document.getElementById('drt-note')!.textContent = head === 'batter' ? 'Schlagfell' : 'Resonanzfell';
      document.getElementById('drt-nearest')!.textContent = nearestNote + ' (' + fmt(nearestFreq) + ' Hz)';
      document.getElementById('drt-ratio')!.textContent = resoR + ':1';
      document.getElementById('drt-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('drt-diam') as HTMLInputElement).value = '14';
      document.querySelectorAll('.drt-in').forEach(el => { el.addEventListener('input', calcDrt); el.addEventListener('change', calcDrt); });
      calcDrt();
    }, 50);
  </script>
</CalculatorLayout>
