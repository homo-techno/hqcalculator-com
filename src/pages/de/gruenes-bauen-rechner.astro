---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Grünes-Bauen-Rechner - DGNB/LEED-ähnliche Zertifizierungspunkte";
const description = "Schätzen Sie Ihre Grünes-Bauen-Zertifizierungspunkte in Kategorien wie Energie, Wasser, Materialien und Raumluftqualität.";
const relatedCalcs = [
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies berechnen." },
  { name: "Glasfusing-Rechner", url: "/de/glasfusing-rechner", description: "Glasfusing-Brennpläne." },
  { name: "Großkreis-Rechner", url: "/de/grosskreis-rechner", description: "Großkreis-Distanz." },
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Genauigkeit." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Noten berechnen." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Grünes-Bauen-Rechner" enSlug="green-building-calculator" keywords="grünes Bauen Rechner, LEED Punkte, DGNB Zertifizierung, nachhaltiges Bauen, Grünes-Bauen-Bewertung" breadcrumbs={[{ name: "Grünes-Bauen-Rechner", url: "/de/gruenes-bauen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Grünes-Bauen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Zertifizierungspunkte für nachhaltiges Bauen in verschiedenen Nachhaltigkeitskategorien.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Energieeffizienz (max. 33 Pkt.)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Energiereduzierung ggü. Norm (%)</label><input type="number" id="grb-energy" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Erneuerbare Energie vor Ort (%)</label><input type="number" id="grb-renew" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" max="100" step="5"></div>
        </div>
        <h3 class="font-semibold text-text">Wassereffizienz (max. 11 Pkt.)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Innen-Wasserreduzierung (%)</label><input type="number" id="grb-water" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="0" max="60" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Außen-Wasserreduzierung (%)</label><input type="number" id="grb-outdoor" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" max="100" step="10"></div>
        </div>
        <h3 class="font-semibold text-text">Materialien & Ressourcen (max. 13 Pkt.)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Recyclinganteil (%)</label><input type="number" id="grb-recycled" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Regionale Materialien (%)</label><input type="number" id="grb-regional" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="100" step="5"></div>
        </div>
        <h3 class="font-semibold text-text">Raumluftqualität (max. 15 Pkt.)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Lüftung</label>
            <select id="grb-vent" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">Erweitert (+30% über Norm)</option>
              <option value="2" selected>Norm DIN EN 15251</option>
              <option value="1">Unter Norm</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Emissionsarme Materialien</label>
            <select id="grb-voc" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="4">Alle Kategorien emissionsarm</option>
              <option value="2" selected>Teilweise emissionsarm</option>
              <option value="0">Standardmaterialien</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Tageslichtnutzung (%)</label>
          <input type="number" id="grb-daylight" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" max="100" step="10">
        </div>
        <h3 class="font-semibold text-text">Standort & Lage (max. 26 Pkt.)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">ÖPNV-Anbindung</label>
            <select id="grb-transit" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="6">Nahe Bahnhof (400 m)</option>
              <option value="3" selected>Nahe Bushaltestelle (400 m)</option>
              <option value="0">Kein ÖPNV in der Nähe</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Regenwassermanagement</label>
            <select id="grb-storm" class="grb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">Vollständige Retention/Behandlung</option>
              <option value="1" selected>Teilweises Management</option>
              <option value="0">Kein Management</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Punkte</div>
          <div class="text-4xl font-extrabold" id="grb-total">0 / 110</div>
          <div class="text-sm text-blue-200 mt-1" id="grb-level">Berechnung...</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Energie-Punkte</div><div class="text-xl font-bold" id="grb-epoints">0 / 33</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser-Punkte</div><div class="text-xl font-bold" id="grb-wpoints">0 / 11</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Material-Punkte</div><div class="text-xl font-bold" id="grb-mpoints">0 / 13</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumluft-Punkte</div><div class="text-xl font-bold" id="grb-ipoints">0 / 15</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="green-building" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Grünes Bauen Zertifizierungsstufen</h2>
      <p>LEED (Leadership in Energy and Environmental Design) hat vier Zertifizierungsstufen: Zertifiziert (40-49 Punkte), Silber (50-59), Gold (60-79) und Platin (80+) von 110 möglichen Punkten. In Deutschland bietet die DGNB (Deutsche Gesellschaft für Nachhaltiges Bauen) ein ähnliches System. Die größte Kategorie ist Energie und Atmosphäre (33 Punkte), was Energieeffizienz zum wirkungsvollsten Bereich macht.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen LEED und DGNB?</strong> LEED ist ein US-amerikanisches System, DGNB wurde speziell für den deutschen und europäischen Markt entwickelt und bewertet auch soziale und ökonomische Nachhaltigkeit stärker.</p>
      <p><strong>Lohnt sich eine Zertifizierung?</strong> Zertifizierte Gebäude erzielen oft 10-20% höhere Mietpreise und haben niedrigere Betriebskosten durch geringeren Energieverbrauch.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGRB() {
      const energy = parseFloat((document.getElementById('grb-energy') as HTMLInputElement).value) || 0;
      const renew = parseFloat((document.getElementById('grb-renew') as HTMLInputElement).value) || 0;
      const water = parseFloat((document.getElementById('grb-water') as HTMLInputElement).value) || 0;
      const outdoor = parseFloat((document.getElementById('grb-outdoor') as HTMLInputElement).value) || 0;
      const recycled = parseFloat((document.getElementById('grb-recycled') as HTMLInputElement).value) || 0;
      const regional = parseFloat((document.getElementById('grb-regional') as HTMLInputElement).value) || 0;
      const vent = parseInt((document.getElementById('grb-vent') as HTMLSelectElement).value) || 0;
      const voc = parseInt((document.getElementById('grb-voc') as HTMLSelectElement).value) || 0;
      const daylight = parseFloat((document.getElementById('grb-daylight') as HTMLInputElement).value) || 0;
      const transit = parseInt((document.getElementById('grb-transit') as HTMLSelectElement).value) || 0;
      const storm = parseInt((document.getElementById('grb-storm') as HTMLSelectElement).value) || 0;
      const ePoints = Math.min(33, Math.round(energy / 100 * 18 + renew / 100 * 7) + (energy >= 50 ? 5 : 0) + (renew >= 100 ? 3 : 0));
      const wPoints = Math.min(11, Math.round(water / 60 * 6 + outdoor / 100 * 4) + (water >= 40 ? 1 : 0));
      const mPoints = Math.min(13, Math.round(recycled / 100 * 6 + regional / 100 * 4) + (recycled >= 50 ? 2 : 0) + (regional >= 50 ? 1 : 0));
      const iPoints = Math.min(15, vent + voc + Math.round(daylight / 100 * 4) + (daylight >= 75 ? 2 : 0));
      const sPoints = Math.min(26, transit + storm + 5);
      const total = ePoints + wPoints + mPoints + iPoints + sPoints;
      let level = 'Nicht zertifiziert';
      if (total >= 80) level = 'Platin';
      else if (total >= 60) level = 'Gold';
      else if (total >= 50) level = 'Silber';
      else if (total >= 40) level = 'Zertifiziert';
      document.getElementById('grb-total')!.textContent = total + ' / 110';
      document.getElementById('grb-level')!.textContent = level;
      document.getElementById('grb-epoints')!.textContent = ePoints + ' / 33';
      document.getElementById('grb-wpoints')!.textContent = wPoints + ' / 11';
      document.getElementById('grb-mpoints')!.textContent = mPoints + ' / 13';
      document.getElementById('grb-ipoints')!.textContent = iPoints + ' / 15';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.grb-in').forEach(el => { el.addEventListener('input', calcGRB); el.addEventListener('change', calcGRB); }); calcGRB(); }, 50);
  </script>
</CalculatorLayout>
