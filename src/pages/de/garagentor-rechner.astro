---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Garagentor-Rechner - Kosten, D\u00E4mmwert & Federtyp";
const description = "Sch\u00E4tzen Sie Garagentor-Kosten nach Gr\u00F6\u00DFe, Material und D\u00E4mmung. Erhalten Sie D\u00E4mmwert, Federtyp-Empfehlungen und Antriebsdimensionierung.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/de/betonrechner", description: "Betonvolumen." },
  { name: "Fundament-Rechner", url: "/de/fundament-rechner", description: "Fundament." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Garagentor-Rechner" lang="de" enSlug="garage-door-calculator" keywords="garagentor rechner, garagentor kosten, garagentor d\u00E4mmung, torsionsfeder, garagentorantrieb, isoliertes garagentor" breadcrumbs={[{ name: "Garagentor-Rechner", url: "/de/garagentor-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Garagentor-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Garagentor-Kosten, D&auml;mmwert, Federtyp und Antriebsanforderungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Torbreite (m)</label>
              <select id="gdt-width" class="gdt-in w-full px-3 py-3 border border-border rounded-xl text-lg">
                <option value="2.4">2,4 m (Einzel)</option>
                <option value="2.7" selected>2,7 m (Einzel breit)</option>
                <option value="3.0">3,0 m (Breit)</option>
                <option value="5.0">5,0 m (Doppel)</option>
                <option value="5.5">5,5 m (Doppel breit)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Torh&ouml;he (m)</label>
              <select id="gdt-height" class="gdt-in w-full px-3 py-3 border border-border rounded-xl text-lg">
                <option value="2.1" selected>2,1 m (Standard)</option>
                <option value="2.4">2,4 m (Hoch)</option>
                <option value="2.7">2,7 m</option>
                <option value="3.0">3,0 m (Gewerbe)</option>
              </select>
            </div>
          </div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Material</label>
            <select id="gdt-material" class="gdt-in w-full px-3 py-3 border border-border rounded-xl text-lg">
              <option value="steel" selected>Stahl (am h&auml;ufigsten)</option>
              <option value="wood">Echtholz (Landhausstil)</option>
              <option value="aluminum">Aluminium (modern/Glas)</option>
              <option value="fiberglass">Glasfaser</option>
              <option value="vinyl">Vinyl</option>
            </select>
          </div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">D&auml;mmung</label>
            <select id="gdt-insulation" class="gdt-in w-full px-3 py-3 border border-border rounded-xl text-lg">
              <option value="none">Keine (einschalig)</option>
              <option value="polystyrene" selected>Polystyrol (R-6 bis R-9)</option>
              <option value="polyurethane">Polyurethanschaum (R-12 bis R-18)</option>
            </select>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <label class="block text-xs font-medium text-text mb-1">Anzahl Tore</label>
            <input type="number" id="gdt-qty" class="gdt-in w-full px-3 py-2 border border-border rounded-lg" value="1" min="1" max="6" step="1">
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Kosten pro Tor</div>
            <div class="text-5xl font-extrabold font-mono" id="gdt-cost">0 &euro;</div>
            <div class="text-sm text-blue-200 mt-1">installiert mit Antrieb</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">D&auml;mmwert</div>
              <div class="text-xl font-bold" id="gdt-rvalue">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Torfl&auml;che</div>
              <div class="text-xl font-bold" id="gdt-area">0 m&sup2;</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Federtyp</div>
              <div class="text-xl font-bold" id="gdt-spring">--</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Antrieb</div>
              <div class="text-xl font-bold" id="gdt-opener">--</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gesch. Gewicht</div>
              <div class="text-xl font-bold" id="gdt-weight">0 kg</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gesamt (alle Tore)</div>
              <div class="text-2xl font-bold text-secondary" id="gdt-totalcost">0 &euro;</div>
            </div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="garage-door" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Garagentor-Kostenfaktoren</h2>
      <ul>
        <li><strong>Material:</strong> Stahl ist am g&uuml;nstigsten; Holz ist Premium</li>
        <li><strong>Gr&ouml;&szlig;e:</strong> Doppeltore kosten 50-80% mehr als Einzeltore</li>
        <li><strong>D&auml;mmung:</strong> F&uuml;gt 200-800 &euro; zu den Torkosten hinzu</li>
        <li><strong>Montage:</strong> Typischerweise 300-600 &euro; pro Tor</li>
      </ul>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Torsionsfeder oder Zugfeder?</strong> Torsionsfedern sind sicherer und langlebiger, werden &uuml;ber dem Tor montiert und eignen sich f&uuml;r schwere Tore.</p>
      <p><strong>Welche D&auml;mmung?</strong> Polyurethanschaum bietet den besten D&auml;mmwert und versteift gleichzeitig das Tor.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const gdtBaseCost: Record<string, number> = { steel: 270, wood: 590, aluminum: 480, fiberglass: 380, vinyl: 320 };
    const gdtWeightPerSqM: Record<string, number> = { steel: 48, wood: 75, aluminum: 32, fiberglass: 38, vinyl: 38 };

    function calcGDT() {
      const width = parseFloat((document.getElementById('gdt-width') as HTMLSelectElement).value) || 2.7;
      const height = parseFloat((document.getElementById('gdt-height') as HTMLSelectElement).value) || 2.1;
      const material = (document.getElementById('gdt-material') as HTMLSelectElement).value;
      const insulation = (document.getElementById('gdt-insulation') as HTMLSelectElement).value;
      const qty = parseInt((document.getElementById('gdt-qty') as HTMLInputElement).value) || 1;
      const area = width * height;
      const baseCostSm = gdtBaseCost[material] || 270;
      let doorCost = area * baseCostSm;
      let rValue = 0;
      if (insulation === 'none') { rValue = 0; }
      else if (insulation === 'polystyrene') { rValue = 7.5; doorCost += area * 30; }
      else { rValue = 15; doorCost += area * 85; }
      const openerCost = area > 10 ? 450 : 350;
      const installCost = area > 10 ? 550 : 400;
      const totalPerDoor = doorCost + openerCost + installCost;
      const totalAll = totalPerDoor * qty;
      const weightPerSm = gdtWeightPerSqM[material] || 48;
      let doorWeight = area * weightPerSm;
      if (insulation !== 'none') doorWeight += area * 5;
      const springType = doorWeight > 70 ? 'Torsion' : 'Zugfeder';
      let openerType = '0,5 PS';
      if (doorWeight > 100) openerType = '0,75 PS';
      if (doorWeight > 160) openerType = '1 PS';
      if (doorWeight > 230) openerType = '1,5 PS';
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      document.getElementById('gdt-cost')!.textContent = fmt(Math.round(totalPerDoor)) + ' \u20AC';
      document.getElementById('gdt-rvalue')!.textContent = rValue > 0 ? 'R-' + rValue : 'Keine';
      document.getElementById('gdt-area')!.textContent = area.toFixed(1) + ' m\u00B2';
      document.getElementById('gdt-spring')!.textContent = springType;
      document.getElementById('gdt-opener')!.textContent = openerType;
      document.getElementById('gdt-weight')!.textContent = Math.round(doorWeight) + ' kg';
      document.getElementById('gdt-totalcost')!.textContent = fmt(Math.round(totalAll)) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.gdt-in, #gdt-qty').forEach(el => {
        el.addEventListener('input', calcGDT);
        el.addEventListener('change', calcGDT);
      });
      calcGDT();
    }, 50);
  </script>
</CalculatorLayout>
