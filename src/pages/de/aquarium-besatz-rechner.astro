---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Besatz-Rechner - Fischanzahl & Biobelastung";
const description = "Berechnen Sie, wie viele Fische Ihr Aquarium vertr&auml;gt, basierend auf Beckengr&ouml;&szlig;e und Filtertyp. Sehen Sie max. Fisch-cm, Anzahl nach Gr&ouml;&szlig;e und Besatzdichte.";
const relatedCalcs = [
  { name: "Fischvertr&auml;glichkeit", url: "/de/fischvertraeglichkeit-rechner", description: "Artvertr&auml;glichkeit." },
  { name: "Fischf&uuml;tterung", url: "/de/fischfuetterung-rechner", description: "Futtermenge." },
  { name: "Zuchtbecken", url: "/de/zuchtbecken-rechner", description: "Zuchtbecken." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Aquarium-Besatz-Rechner" lang="de" enSlug="fish-tank-stocking-calculator" keywords="Aquarium Besatz, Fischanzahl, Liter pro Fisch, Biobelastung, Besatzdichte, Aquarium Filterung" breadcrumbs={[{ name: "Aquarium-Besatz", url: "/de/aquarium-besatz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Besatz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie viele Fische Ihr Aquarium sicher aufnehmen kann.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beckengr&ouml;&szlig;e (Liter)</label>
            <input type="number" id="abr-liters" class="abr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="110" min="10" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Filtertyp</label>
            <select id="abr-filter" class="abr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0.8">Einfach / Schwamm (80%)</option>
              <option value="1.0" selected>Innen-/Au&szlig;enfilter (100%)</option>
              <option value="1.2">Topffilter (120%)</option>
              <option value="1.5">&Uuml;berdimensioniert / Sumpf (150%)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fischart</label>
            <select id="abr-type" class="abr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="tropical" selected>Tropische S&uuml;&szlig;wasser</option>
              <option value="goldfish">Goldfische</option>
              <option value="cichlid">Buntbarsche</option>
              <option value="marine">Meerwasser</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bepflanzung</label>
            <select id="abr-plants" class="abr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0">Keine Pflanzen</option>
              <option value="0.1" selected>Leicht bepflanzt</option>
              <option value="0.2">M&auml;&szlig;ig bepflanzt</option>
              <option value="0.3">Stark bepflanzt</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Max. Fisch-cm</div>
          <div class="text-5xl font-extrabold font-mono" id="abr-result">0 cm</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Klein (3-5 cm)</div><div class="text-xl font-bold font-mono" id="abr-small">0 Fische</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mittel (8-10 cm)</div><div class="text-xl font-bold font-mono" id="abr-medium">0 Fische</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gro&szlig; (13-15 cm)</div><div class="text-xl font-bold font-mono" id="abr-large">0 Fische</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Besatzstufe</div><div class="text-xl font-bold font-mono" id="abr-level">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasserwechsel</div><div class="text-xl font-bold font-mono" id="abr-changes">-</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fish-tank-stocking" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie viele Fische pro Liter?</strong> Als Faustregel gilt: 1 cm Fisch pro 1-2 Liter Wasser, je nach Fischart.</p>
      <p><strong>Warum ist &Uuml;berbesatz gef&auml;hrlich?</strong> Zu viele Fische f&uuml;hren zu schlechter Wasserqualit&auml;t, Stress und Krankheiten.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcABR() {
      const liters = parseFloat((document.getElementById('abr-liters') as HTMLInputElement).value) || 0;
      const filterMult = parseFloat((document.getElementById('abr-filter') as HTMLSelectElement).value) || 1;
      const fishType = (document.getElementById('abr-type') as HTMLSelectElement).value;
      const plantBonus = parseFloat((document.getElementById('abr-plants') as HTMLSelectElement).value) || 0;
      const cmPerLiter: Record<string, number> = {
        tropical: 1.0, goldfish: 0.5, cichlid: 0.75, marine: 0.5
      };
      const baseRate = cmPerLiter[fishType] || 1;
      const effectiveLiters = liters * filterMult * (1 + plantBonus);
      const maxCm = effectiveLiters * baseRate;
      const smallFish = Math.floor(maxCm / 4);
      const medFish = Math.floor(maxCm / 9);
      const largeFish = Math.floor(maxCm / 14);
      let level = 'Konservativ';
      if (filterMult >= 1.2 && plantBonus >= 0.2) level = 'Gro\u00dfz\u00fcgig';
      else if (filterMult >= 1.0) level = 'Standard';
      let changes = 'W\u00f6chentlich 25%';
      if (fishType === 'goldfish') changes = 'W\u00f6chentlich 30%';
      else if (fishType === 'marine') changes = '2-w\u00f6chentlich 20%';
      else if (filterMult >= 1.5) changes = '2-w\u00f6chentlich 25%';
      document.getElementById('abr-result')!.textContent = Math.round(maxCm) + ' cm';
      document.getElementById('abr-small')!.textContent = smallFish + ' Fische';
      document.getElementById('abr-medium')!.textContent = medFish + ' Fische';
      document.getElementById('abr-large')!.textContent = largeFish + ' Fische';
      document.getElementById('abr-level')!.textContent = level;
      document.getElementById('abr-changes')!.textContent = changes;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.abr-in').forEach(el => { el.addEventListener('input', calcABR); el.addEventListener('change', calcABR); });
      calcABR();
    }, 50);
  </script>
</CalculatorLayout>
