---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Boots-Kraftstoffrechner - Verbrauch & Kosten auf See";
const description = "Berechnen Sie den Kraftstoffverbrauch Ihres Bootes anhand von Motorleistung, Geschwindigkeit und Effizienz. Schätzen Sie Gallonen pro Stunde, Reichweite und Kraftstoffkosten pro Fahrt.";
const relatedCalcs = [
  { name: "Bootsanhänger-Rechner", url: "/de/bootsanhaenger-rechner", description: "Anhänger-Kapazität." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeit-rechner", description: "Geschwindigkeit und Entfernung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Boots-Kraftstoffrechner" lang="de" keywords="boots kraftstoff rechner, marine kraftstoffverbrauch, gallonen pro stunde, bootskosten, marine effizienz, boots reichweite" breadcrumbs={[{ name: "Boots-Kraftstoff", url: "/de/boots-kraftstoff-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Boots-Kraftstoffrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Kraftstoffverbrauch, Reichweite und Fahrtkosten basierend auf Motorspezifikationen und Fahrbedingungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Motorleistung (PS)</label><input type="number" id="bf2-hp" class="bf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Motoren</label><input type="number" id="bf2-eng" class="bf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="4" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Reisegeschwindigkeit (Knoten)</label><input type="number" id="bf2-speed" class="bf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gas (%)</label><input type="number" id="bf2-throttle" class="bf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="10" max="100" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tankinhalt (Gallonen)</label><input type="number" id="bf2-tank" class="bf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kraftstoffpreis ($/Gal)</label><input type="number" id="bf2-price" class="bf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.01" step="0.10"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Fahrstrecke (Seemeilen)</label><input type="number" id="bf2-dist" class="bf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gallonen pro Stunde</div>
          <div class="text-5xl font-extrabold font-mono" id="bf2-gph">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reichweite (sm)</div><div class="text-xl font-bold" id="bf2-range">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fahrt-Kraftstoff (Gal)</div><div class="text-xl font-bold" id="bf2-trip">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fahrtkosten</div><div class="text-xl font-bold" id="bf2-cost">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">sm pro Gallone</div><div class="text-xl font-bold" id="bf2-nmpg">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tankdauer (Std)</div><div class="text-xl font-bold" id="bf2-dur">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro sm</div><div class="text-xl font-bold" id="bf2-cpnm">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="boat-fuel" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBF2() {
      const hp = parseFloat((document.getElementById('bf2-hp') as HTMLInputElement).value) || 0;
      const eng = parseInt((document.getElementById('bf2-eng') as HTMLInputElement).value) || 1;
      const speed = parseFloat((document.getElementById('bf2-speed') as HTMLInputElement).value) || 0;
      const throttle = (parseFloat((document.getElementById('bf2-throttle') as HTMLInputElement).value) || 75) / 100;
      const tank = parseFloat((document.getElementById('bf2-tank') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('bf2-price') as HTMLInputElement).value) || 0;
      const dist = parseFloat((document.getElementById('bf2-dist') as HTMLInputElement).value) || 0;

      const gphPerEngine = hp * 0.1 * throttle * throttle;
      const gph = gphPerEngine * eng;
      const nmpg = speed > 0 && gph > 0 ? speed / gph : 0;
      const range = gph > 0 ? (tank / gph) * speed * 0.9 : 0;
      const tripFuel = speed > 0 ? (dist / speed) * gph : 0;
      const tripCost = tripFuel * price;
      const tankDur = gph > 0 ? tank / gph : 0;
      const cpnm = nmpg > 0 ? price / nmpg : 0;

      document.getElementById('bf2-gph')!.textContent = gph > 0 ? gph.toFixed(1).replace('.', ',') : '--';
      document.getElementById('bf2-range')!.textContent = range > 0 ? Math.round(range).toLocaleString('de-DE') : '--';
      document.getElementById('bf2-trip')!.textContent = tripFuel > 0 ? tripFuel.toFixed(1).replace('.', ',') : '--';
      document.getElementById('bf2-cost')!.textContent = tripCost > 0 ? '$' + tripCost.toFixed(2) : '--';
      document.getElementById('bf2-nmpg')!.textContent = nmpg > 0 ? nmpg.toFixed(2).replace('.', ',') : '--';
      document.getElementById('bf2-dur')!.textContent = tankDur > 0 ? tankDur.toFixed(1).replace('.', ',') : '--';
      document.getElementById('bf2-cpnm')!.textContent = cpnm > 0 ? '$' + cpnm.toFixed(2) : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bf2-hp') as HTMLInputElement).value = '250';
      (document.getElementById('bf2-eng') as HTMLInputElement).value = '1';
      (document.getElementById('bf2-speed') as HTMLInputElement).value = '25';
      (document.getElementById('bf2-throttle') as HTMLInputElement).value = '75';
      (document.getElementById('bf2-tank') as HTMLInputElement).value = '150';
      (document.getElementById('bf2-price') as HTMLInputElement).value = '5.50';
      (document.getElementById('bf2-dist') as HTMLInputElement).value = '50';
      document.querySelectorAll('.bf2-in').forEach(el => { el.addEventListener('input', calcBF2); el.addEventListener('change', calcBF2); });
      calcBF2();
    }, 50);
  </script>
</CalculatorLayout>
