---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Brillen-Kosten-Rechner - Gestell, Gläser & Beschichtungen";
const description = "Berechnen Sie die Gesamtkosten einer Brille inkl. Gestell, Gläser, Beschichtungen (Entspiegelung, Blaulichtfilter, Gleitsicht) und Versicherungsleistungen.";
const relatedCalcs = [
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "Notendurchschnitt-Rechner", url: "/de/notendurchschnitt-rechner", description: "GPA berechnen." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Grünes-Bauen-Rechner", url: "/de/gruenes-bauen-rechner", description: "Nachhaltiges Bauen." },
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Genauigkeit." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Brillen-Kosten-Rechner" enSlug="glasses-cost-calculator" keywords="Brillenkosten, Brillenpreis, Gleitsichtgläser Kosten, Blaulichtfilter, Entspiegelung, Brillenversicherung" breadcrumbs={[{ name: "Brillen-Kosten-Rechner", url: "/de/brillen-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Brillen-Kosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Gesamtkosten einer Brille mit Gestell, Gläsern, Beschichtungen und Versicherungszuschuss.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gestell-Kategorie</label>
            <select id="bkr-frame" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="budget">Preiswert (30-80 €)</option>
              <option value="mid" selected>Mittelklasse (100-200 €)</option>
              <option value="designer">Designer (250-500 €)</option>
              <option value="luxury">Luxus (500+ €)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Glastyp</label>
            <select id="bkr-lens" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="sv" selected>Einstärkenglas</option>
              <option value="bifocal">Bifokalglas</option>
              <option value="progressive">Gleitsichtglas</option>
              <option value="occupational">Arbeitsplatzglas / Büro</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Glasmaterial / Index</label>
            <select id="bkr-mat" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="cr39">CR-39 (1,50)</option>
              <option value="poly" selected>Polycarbonat (1,59)</option>
              <option value="hi160">Hochbrechend 1,60</option>
              <option value="hi167">Hochbrechend 1,67</option>
              <option value="hi174">Ultra-hochbrechend 1,74</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beschichtungen</label>
            <select id="bkr-coat" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="none">Keine Beschichtung</option>
              <option value="ar" selected>Nur Entspiegelung</option>
              <option value="arblue">Entspiegelung + Blaulichtfilter</option>
              <option value="photo">Selbsttönend (Transitions)</option>
              <option value="all">Entspieg. + Blaulicht + Selbsttönend</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gläser-Zuschuss Versicherung (€)</label><input type="number" id="bkr-ins" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="0" max="1000" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gestell-Zuschuss (€)</label><input type="number" id="bkr-fa" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="130" min="0" max="500" step="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten Brille</div>
          <div class="text-5xl font-extrabold font-mono" id="bkr-total">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gestellkosten</div><div class="text-xl font-bold font-mono" id="bkr-fc">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gläser + Beschichtungen</div><div class="text-xl font-bold font-mono" id="bkr-lc">0 €</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Versicherung</div><div class="text-xl font-bold font-mono" id="bkr-io">-0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="bkr-oop">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährlich (2J-Ersatz)</div><div class="text-xl font-bold font-mono" id="bkr-annual">0 €</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="brillen-kosten" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Brillenkosten in Deutschland</h2>
      <p>Die Kosten einer Brille setzen sich aus Gestell, Gläsern und optionalen Beschichtungen zusammen. Gleitsichtgläser sind deutlich teurer als Einstärkengläser. Seit 2017 übernehmen gesetzliche Krankenkassen nur bei starker Sehschwäche (ab 6 Dioptrien) einen Zuschuss.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was kosten Gleitsichtgläser?</strong> Gleitsichtgläser kosten je nach Qualität zwischen 200 € und 1.000 € pro Paar. Hochwertige Gleitsichtgläser bieten breitere Sehzonen.</p>
      <p><strong>Lohnt sich eine Entspiegelung?</strong> Ja, eine Entspiegelung reduziert Blendung und Reflexe und ist besonders beim Autofahren und bei Bildschirmarbeit empfehlenswert.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBKR() {
      const frame = (document.getElementById('bkr-frame') as HTMLSelectElement).value;
      const lens = (document.getElementById('bkr-lens') as HTMLSelectElement).value;
      const mat = (document.getElementById('bkr-mat') as HTMLSelectElement).value;
      const coat = (document.getElementById('bkr-coat') as HTMLSelectElement).value;
      const insAllow = parseFloat((document.getElementById('bkr-ins') as HTMLInputElement).value) || 0;
      const frameAllow = parseFloat((document.getElementById('bkr-fa') as HTMLInputElement).value) || 0;

      const frameCosts: Record<string, number> = { budget: 55, mid: 150, designer: 375, luxury: 650 };
      const lensCosts: Record<string, number> = { sv: 80, bifocal: 150, progressive: 300, occupational: 250 };
      const matCosts: Record<string, number> = { cr39: 0, poly: 50, hi160: 100, hi167: 150, hi174: 250 };
      const coatCosts: Record<string, number> = { none: 0, ar: 80, arblue: 120, photo: 130, all: 200 };

      const fc = frameCosts[frame];
      const lc = lensCosts[lens] + matCosts[mat] + coatCosts[coat];
      const subtotal = fc + lc;

      const frameOffset = Math.min(fc, frameAllow);
      const lensOffset = Math.min(lc, insAllow);
      const totalOffset = frameOffset + lensOffset;
      const oop = Math.max(0, subtotal - totalOffset);
      const annual = Math.round(oop / 2);

      const fmt = (v: number) => v.toLocaleString('de-DE');

      document.getElementById('bkr-total')!.textContent = fmt(subtotal) + ' \u20ac';
      document.getElementById('bkr-fc')!.textContent = fmt(fc) + ' \u20ac';
      document.getElementById('bkr-lc')!.textContent = fmt(lc) + ' \u20ac';
      document.getElementById('bkr-io')!.textContent = '-' + fmt(Math.round(totalOffset)) + ' \u20ac';
      document.getElementById('bkr-oop')!.textContent = fmt(Math.round(oop)) + ' \u20ac';
      document.getElementById('bkr-annual')!.textContent = fmt(annual) + ' \u20ac/J.';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bkr-in').forEach(el => { el.addEventListener('input', calcBKR); el.addEventListener('change', calcBKR); });
      calcBKR();
    }, 50);
  </script>
</CalculatorLayout>
