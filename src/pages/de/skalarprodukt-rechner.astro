---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Skalarprodukt-Rechner - Vektor-Skalarprodukt (2D & 3D) 2026";
const description = "Berechne das Skalarprodukt zweier Vektoren in 2D oder 3D. Finde den Winkel zwischen Vektoren und die skalare Projektion.";

const relatedCalcs = [
  { name: "Kreuzprodukt-Rechner", url: "/de/kreuzprodukt-rechner", description: "3D-Vektor-Kreuzprodukt." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Mittelwert, Median, Modus." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Erweiterte Mathematik." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Skalarprodukt-Rechner" keywords="Skalarprodukt Rechner, Vektor Skalarprodukt, Punktprodukt, Winkel zwischen Vektoren, Vektorprojektion" breadcrumbs={[{ name: "Skalarprodukt-Rechner", url: "/de/skalarprodukt-rechner" }]} lang="de" enSlug="dot-product-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Skalarprodukt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne das Skalarprodukt zweier Vektoren mit Winkel- und Projektionsergebnissen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Dimension</label>
          <select id="spde-mode" class="spde-in w-full px-4 py-2 border border-border rounded-xl text-lg">
            <option value="2">2D-Vektoren</option>
            <option value="3" selected>3D-Vektoren</option>
          </select>
        </div>
        <h3 class="font-semibold text-text">Vektor A</h3>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">A<sub>x</sub></label><input type="number" id="spde-ax" class="spde-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="1" /></div>
          <div><label class="block text-sm font-medium text-text mb-1">A<sub>y</sub></label><input type="number" id="spde-ay" class="spde-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="2" /></div>
          <div id="spde-az-wrap"><label class="block text-sm font-medium text-text mb-1">A<sub>z</sub></label><input type="number" id="spde-az" class="spde-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="3" /></div>
        </div>
        <h3 class="font-semibold text-text">Vektor B</h3>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">B<sub>x</sub></label><input type="number" id="spde-bx" class="spde-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="4" /></div>
          <div><label class="block text-sm font-medium text-text mb-1">B<sub>y</sub></label><input type="number" id="spde-by" class="spde-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="5" /></div>
          <div id="spde-bz-wrap"><label class="block text-sm font-medium text-text mb-1">B<sub>z</sub></label><input type="number" id="spde-bz" class="spde-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="6" /></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Skalarprodukt A &middot; B</div>
          <div class="text-5xl font-extrabold font-mono" id="spde-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Winkel zwischen Vektoren</div><div class="text-xl font-bold" id="spde-angle">0&deg;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Projektion von A auf B</div><div class="text-xl font-bold" id="spde-proj">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">|A|</div><div class="text-xl font-bold" id="spde-maga">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">|B|</div><div class="text-xl font-bold" id="spde-magb">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Interpretation</h3>
          <div class="text-sm text-text-secondary" id="spde-interpret"></div>
        </div>
      </div>
      <ShareButton calculatorId="dot-product" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist das Skalarprodukt?</h2>
      <p>Das Skalarprodukt (Punktprodukt) zweier Vektoren ergibt eine einzelne Zahl. Fuer Vektoren A und B gilt:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p><strong>A &middot; B</strong> = A<sub>x</sub>B<sub>x</sub> + A<sub>y</sub>B<sub>y</sub> + A<sub>z</sub>B<sub>z</sub></p>
        <p><strong>A &middot; B</strong> = |A| |B| cos(&theta;)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was sagt das Vorzeichen aus?</strong> Positiv: Vektoren zeigen in aehnliche Richtung (Winkel &lt; 90&deg;). Null: Vektoren stehen senkrecht aufeinander. Negativ: Vektoren zeigen in entgegengesetzte Richtungen.</p>
      <p><strong>Wo wird das Skalarprodukt angewendet?</strong> In der Physik fuer Arbeit (Kraft mal Weg), in der Computergrafik fuer Beleuchtungsberechnungen und in der Datenanalyse fuer Aehnlichkeitsmasse.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSPDE() {
      const mode = (document.getElementById('spde-mode') as HTMLSelectElement).value;
      const is3D = mode === '3';
      document.getElementById('spde-az-wrap')!.style.display = is3D ? '' : 'none';
      document.getElementById('spde-bz-wrap')!.style.display = is3D ? '' : 'none';

      const ax = parseFloat((document.getElementById('spde-ax') as HTMLInputElement).value) || 0;
      const ay = parseFloat((document.getElementById('spde-ay') as HTMLInputElement).value) || 0;
      const az = is3D ? (parseFloat((document.getElementById('spde-az') as HTMLInputElement).value) || 0) : 0;
      const bx = parseFloat((document.getElementById('spde-bx') as HTMLInputElement).value) || 0;
      const by = parseFloat((document.getElementById('spde-by') as HTMLInputElement).value) || 0;
      const bz = is3D ? (parseFloat((document.getElementById('spde-bz') as HTMLInputElement).value) || 0) : 0;

      const dot = ax * bx + ay * by + az * bz;
      const magA = Math.sqrt(ax * ax + ay * ay + az * az);
      const magB = Math.sqrt(bx * bx + by * by + bz * bz);
      let angle = 0;
      if (magA > 0 && magB > 0) {
        angle = Math.acos(Math.min(1, Math.max(-1, dot / (magA * magB)))) * (180 / Math.PI);
      }
      const projection = magB > 0 ? dot / magB : 0;
      const fmt = (n: number) => Number.isInteger(n) ? String(n) : n.toFixed(4).replace('.', ',');

      document.getElementById('spde-result')!.textContent = fmt(dot);
      document.getElementById('spde-angle')!.innerHTML = fmt(angle) + '&deg;';
      document.getElementById('spde-proj')!.textContent = fmt(projection);
      document.getElementById('spde-maga')!.textContent = fmt(magA);
      document.getElementById('spde-magb')!.textContent = fmt(magB);

      let interpret = '';
      if (magA === 0 || magB === 0) {
        interpret = 'Einer oder beide Vektoren sind Nullvektoren.';
      } else if (Math.abs(dot) < 1e-10) {
        interpret = 'Die Vektoren stehen senkrecht aufeinander (orthogonal).';
      } else if (dot > 0) {
        interpret = 'Die Vektoren zeigen in eine aehnliche Richtung (spitzer Winkel von ' + fmt(angle) + '\u00B0).';
      } else {
        interpret = 'Die Vektoren zeigen in entgegengesetzte Richtungen (stumpfer Winkel von ' + fmt(angle) + '\u00B0).';
      }
      document.getElementById('spde-interpret')!.innerHTML = interpret;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.spde-in').forEach(el => { el.addEventListener('input', calcSPDE); el.addEventListener('change', calcSPDE); });
      calcSPDE();
    }, 50);
  </script>
</CalculatorLayout>
