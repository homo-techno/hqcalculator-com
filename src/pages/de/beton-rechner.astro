---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Betonrechner - Kubikmeter, S\u00e4cke & Kostensch\u00e4tzung";
const description = "Berechnen Sie den Betonbedarf in Kubikmetern und S\u00e4cken. Unterst\u00fctzt Platten, Fundamente, S\u00e4ulen und Treppen. Kostensch\u00e4tzung und Bestellmengen.";
const relatedCalcs = [
  { name: "Betonplattenrechner", url: "/de/betonplatte-rechner", description: "Plattenvolumen." },
  { name: "Betonmischungsrechner", url: "/de/betonmischung-rechner", description: "Mischungsentwurf." },
  { name: "Betonbewehrungsrechner", url: "/de/betonbewehrung-rechner", description: "Bewehrung." },
  { name: "Betontreppenrechner", url: "/de/betontreppe-rechner", description: "Treppenvolumen." },
  { name: "Betonschalungsrechner", url: "/de/betonschalung-rechner", description: "Schalungsmaterial." },
  { name: "Betonversiegelungsrechner", url: "/de/betonversiegelung-rechner", description: "Versiegelung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Betonrechner" lang="de" enSlug="concrete-calculator" keywords="betonrechner, kubikmeter, beton s\u00e4cke, betonkosten, plattenrechner, fundamentrechner, wie viel beton" breadcrumbs={[{ name: "Betonrechner", url: "/de/beton-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Betonrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie viel Beton Sie f&uuml;r Platten, Fundamente, S&auml;ulen und mehr ben&ouml;tigen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Projekttyp</label>
            <div class="grid grid-cols-2 gap-2">
              <button class="br-shape-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-primary bg-blue-50 text-primary" data-shape="slab">Platte / Rechteck</button>
              <button class="br-shape-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-shape="footing">Wand / Fundament</button>
              <button class="br-shape-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-shape="column">S&auml;ule / Rohr</button>
              <button class="br-shape-btn px-3 py-2.5 rounded-xl text-sm font-semibold border border-border" data-shape="stairs">Treppe</button>
            </div>
          </div>
          <div id="br-slab">
            <div class="grid grid-cols-3 gap-3 mb-5">
              <div><label class="block text-xs font-medium text-text mb-1">L&auml;nge (m)</label><input type="number" id="br-length" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="6" min="0" step="0.1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Breite (m)</label><input type="number" id="br-width" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="3" min="0" step="0.1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Dicke (cm)</label><input type="number" id="br-depth" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="10" min="0" step="1"></div>
            </div>
          </div>
          <div id="br-column" class="hidden">
            <div class="grid grid-cols-3 gap-3 mb-5">
              <div><label class="block text-xs font-medium text-text mb-1">Durchmesser (cm)</label><input type="number" id="br-diameter" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="30" min="0" step="1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">H&ouml;he (m)</label><input type="number" id="br-col-height" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="1.2" min="0" step="0.1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Anzahl</label><input type="number" id="br-col-qty" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="4" min="1" step="1"></div>
            </div>
          </div>
          <div id="br-stairs" class="hidden">
            <div class="grid grid-cols-2 gap-3 mb-3">
              <div><label class="block text-xs font-medium text-text mb-1">Breite (m)</label><input type="number" id="br-stair-width" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="1.2" min="0" step="0.1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Anzahl Stufen</label><input type="number" id="br-steps" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="5" min="1" step="1"></div>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-5">
              <div><label class="block text-xs font-medium text-text mb-1">Auftritt (cm)</label><input type="number" id="br-tread" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="27" min="0" step="1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Steigung (cm)</label><input type="number" id="br-rise" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="18" min="0" step="1"></div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <div class="grid grid-cols-2 gap-3">
              <div><label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label><input type="number" id="br-waste" class="w-full px-3 py-2 border border-border rounded-lg" value="10" min="0" max="50" step="1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Preis pro m&sup3;</label>
                <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span><input type="number" id="br-cost" class="w-full pl-7 pr-3 py-2 border border-border rounded-lg" value="120" min="0" step="5"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Betonbedarf</div>
            <div class="text-4xl font-extrabold" id="br-m3">0</div>
            <div class="text-sm text-blue-200 mt-1">Kubikmeter (inkl. Verschnitt)</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Liter</div><div class="text-xl font-bold" id="br-liters">0</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kubikmeter (netto)</div><div class="text-xl font-bold" id="br-m3net">0</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">S&auml;cke ben&ouml;tigt</h3>
            <div class="grid grid-cols-3 gap-3 text-center">
              <div><div class="text-xs text-text-muted">25 kg S&auml;cke</div><div class="text-2xl font-bold" id="br-bags25">0</div><div class="text-xs text-text-muted">~12 L/Sack</div></div>
              <div><div class="text-xs text-text-muted">30 kg S&auml;cke</div><div class="text-2xl font-bold" id="br-bags30">0</div><div class="text-xs text-text-muted">~14 L/Sack</div></div>
              <div><div class="text-xs text-text-muted">40 kg S&auml;cke</div><div class="text-2xl font-bold" id="br-bags40">0</div><div class="text-xs text-text-muted">~19 L/Sack</div></div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesch&auml;tzte Kosten</div>
            <div class="text-3xl font-bold text-secondary" id="br-total-cost">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewicht (ca.)</div>
            <div class="text-xl font-bold" id="br-weight">0 kg</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="concrete" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Beton berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Platte:</strong> Volumen = L&auml;nge (m) &times; Breite (m) &times; Dicke (cm) &divide; 100 = m&sup3;</p>
        <p><strong>S&auml;ule:</strong> Volumen = &pi; &times; (Durchmesser/2)&sup2; &times; H&ouml;he = m&sup3;</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Tipps zur Betonbestellung</h3>
      <ul>
        <li><strong>Immer 10% Aufschlag</strong> f&uuml;r Verschnitt, Versch&uuml;ttung und unebene Fl&auml;chen</li>
        <li>Transportbetonfahrzeuge fassen typischerweise 6-8 m&sup3;</li>
        <li>F&uuml;r kleine Projekte (&lt; 1 m&sup3;) k&ouml;nnen S&auml;cke wirtschaftlicher sein</li>
        <li>Standardbeton wiegt etwa 2.400 kg pro Kubikmeter</li>
        <li>Abbindezeit betr&auml;gt 24-48 Stunden; vollst&auml;ndige Aush&auml;rtung dauert 28 Tage</li>
      </ul>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viele S&auml;cke f&uuml;r 1 m&sup3;?</strong> Ca. 84 S&auml;cke &agrave; 25 kg Trockenbeton oder 53 S&auml;cke &agrave; 40 kg.</p>
      <p><strong>Welche Dicke f&uuml;r eine Einfahrt?</strong> Standard ist 10-12 cm. F&uuml;r schwere Belastung 15-18 cm.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let brShape = 'slab';
    function calcBeton() {
      let cuM = 0;
      const waste = (parseFloat((document.getElementById('br-waste') as HTMLInputElement).value) || 0) / 100;
      const costPerM3 = parseFloat((document.getElementById('br-cost') as HTMLInputElement).value) || 0;
      if (brShape === 'slab' || brShape === 'footing') {
        const l = parseFloat((document.getElementById('br-length') as HTMLInputElement).value) || 0;
        const w = parseFloat((document.getElementById('br-width') as HTMLInputElement).value) || 0;
        const d = (parseFloat((document.getElementById('br-depth') as HTMLInputElement).value) || 0) / 100;
        cuM = l * w * d;
      } else if (brShape === 'column') {
        const d = (parseFloat((document.getElementById('br-diameter') as HTMLInputElement).value) || 0) / 100;
        const h = parseFloat((document.getElementById('br-col-height') as HTMLInputElement).value) || 0;
        const qty = parseInt((document.getElementById('br-col-qty') as HTMLInputElement).value) || 1;
        cuM = Math.PI * Math.pow(d / 2, 2) * h * qty;
      } else if (brShape === 'stairs') {
        const w = parseFloat((document.getElementById('br-stair-width') as HTMLInputElement).value) || 0;
        const steps = parseInt((document.getElementById('br-steps') as HTMLInputElement).value) || 0;
        const tread = (parseFloat((document.getElementById('br-tread') as HTMLInputElement).value) || 0) / 100;
        const rise = (parseFloat((document.getElementById('br-rise') as HTMLInputElement).value) || 0) / 100;
        for (let i = 1; i <= steps; i++) { cuM += w * tread * rise; }
        cuM += w * tread * rise * steps / 2;
      }
      const cuMNet = cuM;
      const cuMWithWaste = cuM * (1 + waste);
      const liters = cuMWithWaste * 1000;
      document.getElementById('br-m3')!.textContent = cuMWithWaste.toFixed(2);
      document.getElementById('br-m3net')!.textContent = cuMNet.toFixed(2);
      document.getElementById('br-liters')!.textContent = Math.round(liters).toLocaleString('de-DE');
      document.getElementById('br-bags25')!.textContent = String(Math.ceil(liters / 12));
      document.getElementById('br-bags30')!.textContent = String(Math.ceil(liters / 14));
      document.getElementById('br-bags40')!.textContent = String(Math.ceil(liters / 19));
      document.getElementById('br-total-cost')!.textContent = Math.round(cuMWithWaste * costPerM3).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('br-weight')!.textContent = Math.round(cuMWithWaste * 2400).toLocaleString('de-DE') + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.br-shape-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.br-shape-btn').forEach(b => { b.classList.remove('border-primary', 'bg-blue-50', 'text-primary'); b.classList.add('border-border'); });
          btn.classList.remove('border-border'); btn.classList.add('border-primary', 'bg-blue-50', 'text-primary');
          brShape = (btn as HTMLElement).dataset.shape || 'slab';
          document.getElementById('br-slab')!.classList.toggle('hidden', brShape !== 'slab' && brShape !== 'footing');
          document.getElementById('br-column')!.classList.toggle('hidden', brShape !== 'column');
          document.getElementById('br-stairs')!.classList.toggle('hidden', brShape !== 'stairs');
          calcBeton();
        });
      });
      ['br-length','br-width','br-depth','br-diameter','br-col-height','br-col-qty','br-stair-width','br-steps','br-tread','br-rise','br-waste','br-cost'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcBeton);
      });
      calcBeton();
    }, 50);
  </script>
</CalculatorLayout>
