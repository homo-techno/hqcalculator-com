---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kreatinin-Clearance-Rechner - Cockcroft-Gault-Gleichung";
const description = "Berechnen Sie die Kreatinin-Clearance (CrCl) mit der Cockcroft-Gault-Gleichung anhand von Alter, Gewicht, Serumkreatinin und Geschlecht.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Koerperfettrechner", url: "/de/koerperfettrechner", description: "Koerperfettanteil." },
  { name: "A1C-Rechner", url: "/de/a1c-rechner", description: "HbA1c-Umrechnung." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Grundumsatzrechner", url: "/de/grundumsatzrechner", description: "Grundumsatz." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kreatinin-Clearance-Rechner" keywords="Kreatinin Clearance, Cockcroft Gault, CrCl, Nierenfunktion, GFR, renal" breadcrumbs={[{ name: "Kreatinin-Clearance-Rechner", url: "/de/kreatinin-clearance-rechner" }]} lang="de" enSlug="creatinine-clearance-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kreatinin-Clearance-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie die Nierenfunktion mit der Cockcroft-Gault-Gleichung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
          <select id="kcr-sex" class="kcr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="male" selected>Maennlich</option>
            <option value="female">Weiblich</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Alter (Jahre)</label><input type="number" id="kcr-age" class="kcr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="18" max="120" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="kcr-wt" class="kcr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70" min="30" max="300" step="0.1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Serumkreatinin (mg/dL)</label>
          <input type="number" id="kcr-scr" class="kcr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.0" min="0.1" max="20" step="0.1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kreatinin-Clearance</div>
          <div class="text-5xl font-extrabold font-mono" id="kcr-crcl">0</div>
          <div class="text-sm text-blue-200 mt-1">mL/min</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nierenstadium</div><div class="text-xl font-bold" id="kcr-stage">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Funktion</div><div class="text-xl font-bold" id="kcr-func">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Angepasst (BSA)</div><div class="text-xl font-bold" id="kcr-adj">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">CKD-Stadien</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Stadium 1 (Normal)</span><span class="font-bold">90+ mL/min</span></div>
            <div class="flex justify-between"><span>Stadium 2 (Leicht)</span><span class="font-bold">60-89 mL/min</span></div>
            <div class="flex justify-between"><span>Stadium 3 (Mittel)</span><span class="font-bold">30-59 mL/min</span></div>
            <div class="flex justify-between"><span>Stadium 4 (Schwer)</span><span class="font-bold">15-29 mL/min</span></div>
            <div class="flex justify-between"><span>Stadium 5 (Versagen)</span><span class="font-bold">&lt;15 mL/min</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="creatinine-clearance" lang="de" /><FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Cockcroft-Gault-Gleichung</h2>
      <p>Die Cockcroft-Gault-Gleichung schaetzt die Kreatinin-Clearance: CrCl = [(140 - Alter) x Gewicht] / (72 x SCr). Fuer Frauen wird mit 0,85 multipliziert. Diese Formel wird haeufig zur Dosisanpassung von Medikamenten bei Niereninsuffizienz verwendet.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Was ist die Kreatinin-Clearance?</strong> Ein Mass fuer die Nierenfunktion, das angibt, wie gut die Nieren Kreatinin aus dem Blut filtern.</li>
        <li><strong>Wann ist die CrCl bedenklich?</strong> Werte unter 60 mL/min deuten auf eine eingeschraenkte Nierenfunktion hin.</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKCR() {
      const sex = (document.getElementById('kcr-sex') as HTMLSelectElement).value;
      const age = parseFloat((document.getElementById('kcr-age') as HTMLInputElement).value) || 0;
      const wt = parseFloat((document.getElementById('kcr-wt') as HTMLInputElement).value) || 0;
      const scr = parseFloat((document.getElementById('kcr-scr') as HTMLInputElement).value) || 0.1;
      let crcl = ((140 - age) * wt) / (72 * scr);
      if (sex === 'female') crcl *= 0.85;
      const bsa = Math.sqrt((170 * wt) / 3600);
      const adjusted = crcl * (1.73 / bsa);
      let stage = '';
      let func = '';
      if (crcl >= 90) { stage = 'Stadium 1'; func = 'Normal'; }
      else if (crcl >= 60) { stage = 'Stadium 2'; func = 'Leicht'; }
      else if (crcl >= 30) { stage = 'Stadium 3'; func = 'Mittel'; }
      else if (crcl >= 15) { stage = 'Stadium 4'; func = 'Schwer'; }
      else { stage = 'Stadium 5'; func = 'Versagen'; }
      document.getElementById('kcr-crcl')!.textContent = crcl.toFixed(1).replace('.', ',');
      document.getElementById('kcr-stage')!.textContent = stage;
      document.getElementById('kcr-func')!.textContent = func;
      document.getElementById('kcr-adj')!.textContent = adjusted.toFixed(1).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kcr-in').forEach(el => { el.addEventListener('input', calcKCR); el.addEventListener('change', calcKCR); });
      calcKCR();
    }, 50);
  </script>
</CalculatorLayout>
