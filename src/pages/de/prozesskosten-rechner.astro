---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Prozesskostenrechner – Gerichts- & Anwaltskosten Zivilprozess";
const description = "Schätzen Sie Gerichts- und Anwaltskosten für Zivilprozesse in Deutschland nach GKG und RVG. Mit Kostenrisiko-Analyse.";
const relatedCalcs = [
  { name: "Anwaltskostenrechner", url: "/de/anwaltskosten-rechner", description: "RVG Gebühren." },
  { name: "Rechtsanwaltsgebühren Rechner", url: "/de/rechtsanwaltsgebuehren-rechner", description: "Anwaltsgebühren." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="litigation-cost-calculator" calculatorName="Prozesskostenrechner" keywords="Prozesskostenrechner, Gerichtskosten, Anwaltskosten Klage, Zivilprozess Kosten, GKG RVG" breadcrumbs={[{ name: "Prozesskostenrechner", url: "/de/prozesskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Prozesskostenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Gerichts- und Anwaltskosten für Zivilprozesse in Deutschland – inklusive Kostenrisiko bei Klageabweisung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Streitwert (€)</label>
          <input type="number" id="prk-sw" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15000" step="500" min="0">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Instanz</label>
          <select id="prk-inst" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="ag" selected>Amtsgericht (bis 5.000 € Streitwert)</option>
            <option value="lg">Landgericht (ab 5.001 €)</option>
            <option value="olg">Oberlandesgericht (Berufung)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ergebnis der Klage</label>
          <select id="prk-ergebnis" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="voll" selected>Vollständiger Erfolg (100%)</option>
            <option value="teil50">Teilerfolg (50%)</option>
            <option value="verlust">Klageabweisung (0%)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Zu tragende Kosten (Kläger)</div>
          <div class="text-4xl font-extrabold font-mono" id="prk-result">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="prk-details"></div>
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800" id="prk-hinweis"></div>
      </div>
      <ShareButton lang="de" calculatorId="prozesskosten" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Prozesskosten in deutschen Zivilverfahren</h2>
      <p>In Deutschland gilt das Unterliegerprinzip: Die unterlegene Partei trägt die gesamten Verfahrenskosten. Bei Teilerfolg werden die Kosten anteilig aufgeteilt. Die Gerichtsgebühren richten sich nach dem Gerichtskostengesetz (GKG), die Anwaltsgebühren nach dem RVG. Eine Rechtsschutzversicherung kann das finanzielle Risiko erheblich mindern.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wer zahlt die Anwaltskosten bei gewonnenem Prozess?</summary>
          <p class="mt-2 text-sm text-text-secondary">Bei vollständigem Erfolg werden die Anwaltskosten vom Gericht der unterlegenen Partei auferlegt – jedoch nur bis zur Höhe der gesetzlichen RVG-Gebühren. Höhere Honorarvereinbarungen trägt der eigene Mandant.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist ein Mahnbescheid und ist er günstiger?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ein Mahnbescheid (gerichtliches Mahnverfahren) kostet deutlich weniger als ein streitiges Klageverfahren. Die Gerichtsgebühren betragen nur 0,5 GE statt 3,0 GE. Wird Widerspruch eingelegt, wechselt es ins Klageverfahren.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist Prozesskostenhilfe (PKH)?</summary>
          <p class="mt-2 text-sm text-text-secondary">Prozesskostenhilfe wird gewährt, wenn die Partei die Kosten nicht tragen kann und die Klage hinreichende Erfolgsaussichten hat. Der Staat schießt die Kosten vor, die bei späterem Einkommenszuwachs zurückzuzahlen sind.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was passiert bei einem Vergleich?</summary>
          <p class="mt-2 text-sm text-text-secondary">Bei einem gerichtlichen Vergleich werden die Kosten oft geteilt oder durch den Vergleich pauschal geregelt. Gerichtsgebühren ermäßigen sich bei einem Vergleich auf 1,0 GE statt 3,0 GE.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function grundgebuehr(sw: number): number {
      if (sw <= 500) return 49;
      if (sw <= 1000) return 88;
      if (sw <= 2000) return 166;
      if (sw <= 3000) return 222;
      if (sw <= 5000) return 334;
      if (sw <= 10000) return 614;
      if (sw <= 20000) return 978;
      if (sw <= 30000) return 1219;
      if (sw <= 50000) return 1763;
      if (sw <= 100000) return 2641;
      return 2641 + Math.floor((sw - 100000) / 50000) * 519;
    }
    function calcPrk() {
      const sw = parseFloat((document.getElementById('prk-sw') as HTMLInputElement).value) || 0;
      const inst = (document.getElementById('prk-inst') as HTMLSelectElement).value;
      const ergebnis = (document.getElementById('prk-ergebnis') as HTMLSelectElement).value;

      const gg = grundgebuehr(sw);
      let anwFaktorEigen = 1.3, anwFaktorGegner = 1.3, gerichtGE = 3.0;
      if (inst === 'lg') { anwFaktorEigen = 1.3; anwFaktorGegner = 1.3; gerichtGE = 3.0; }
      else if (inst === 'olg') { anwFaktorEigen = 1.6; anwFaktorGegner = 1.6; gerichtGE = 4.0; }

      const anwKostenEigen = (gg * anwFaktorEigen + gg * 1.2 + Math.min(gg * 0.2, 20)) * 1.19;
      const anwKostenGegner = (gg * anwFaktorGegner + gg * 1.2 + Math.min(gg * 0.2, 20)) * 1.19;
      const gerichtKosten = gg * gerichtGE;
      const gesamtKosten = anwKostenEigen + anwKostenGegner + gerichtKosten;

      let klaeagerTraegt = 0, beschreibung = '';
      if (ergebnis === 'voll') {
        klaeagerTraegt = 0;
        beschreibung = 'Bei vollständigem Erfolg trägt die Gegenseite alle Kosten. Ihr Kostenrisiko: 0 €.';
      } else if (ergebnis === 'teil50') {
        klaeagerTraegt = gesamtKosten * 0.5;
        beschreibung = 'Bei 50%-Teilerfolg trägt jede Seite die Hälfte der Kosten. Ihr eigener Anwalt bleibt stets Ihr Risiko.';
      } else {
        klaeagerTraegt = anwKostenEigen + anwKostenGegner + gerichtKosten;
        beschreibung = 'Bei vollständiger Klageabweisung tragen Sie alle Kosten: eigener Anwalt, Gegneranwalt und Gerichtsgebühren.';
      }

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('prk-result')!.textContent = fmt(klaeagerTraegt);
      document.getElementById('prk-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigener Anwalt (brutto)</div><div class="text-lg font-bold font-mono">${fmt(anwKostenEigen)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gegneranwalt (brutto)</div><div class="text-lg font-bold font-mono">${fmt(anwKostenGegner)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gerichtsgebühren</div><div class="text-lg font-bold font-mono">${fmt(gerichtKosten)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten Verfahren</div><div class="text-lg font-bold font-mono">${fmt(gesamtKosten)}</div></div>`;
      document.getElementById('prk-hinweis')!.textContent = beschreibung;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('prk-sw')!.addEventListener('input', calcPrk);
      document.getElementById('prk-inst')!.addEventListener('change', calcPrk);
      document.getElementById('prk-ergebnis')!.addEventListener('change', calcPrk);
      calcPrk();
    }, 50);
  </script>
</CalculatorLayout>
