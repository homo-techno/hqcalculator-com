---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Zahnbr\u00fccke-Rechner - Kosten & Vergleich";
const description = "Sch\u00e4tzen Sie die Kosten einer Zahnbr\u00fccke nach Material, Pfeilerzustand und Versicherung. Vergleichen Sie mit Implantat- und Prothesenalternativen.";

const relatedCalcs = [
  { name: "Zahnimplantat-Kostenrechner", url: "/de/zahnimplantat-kosten-rechner", description: "Implantatkosten." },
  { name: "Zahnkrone-Rechner", url: "/de/zahnkrone-rechner", description: "Kronenkosten." },
  { name: "Zahnversicherung-Rechner", url: "/de/zahnversicherung-rechner", description: "Versicherungsanalyse." },
  { name: "Zahn-R\u00f6ntgen-Rechner", url: "/de/zahn-roentgen-rechner", description: "R\u00f6ntgenstrahlung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Zahnbr\u00fccke-Rechner" lang="de" enSlug="dental-bridge-calculator" keywords="zahnbruecke kosten, zahnbruecke rechner, bruecke vs implantat, zahnbruecke material, zahnersatz kosten" breadcrumbs={[{ name: "Zahnbr\u00fccke-Rechner", url: "/de/zahnbruecke-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zahnbr&uuml;cke-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Kosten einer Zahnbr&uuml;cke und vergleichen Sie mit Implantat- und Prothesenalternativen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fehlende Z&auml;hne (Br&uuml;ckenglieder)</label><input type="number" id="zdb-pontic" class="zdb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="6" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Br&uuml;ckenmaterial</label>
            <select id="zdb-mat" class="zdb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="pfm" selected>Metallkeramik (VMK)</option>
              <option value="zirconia">Zirkonoxid</option>
              <option value="allceramic">Vollkeramik</option>
              <option value="metal">Vollmetall</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Pfeilerzustand</label>
            <select id="zdb-abut" class="zdb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="healthy" selected>Gesunde Pfeilerz&auml;hne</option>
              <option value="buildup">Stiftaufbau n&ouml;tig</option>
              <option value="rct">Wurzelbehandlung n&ouml;tig</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Position</label>
            <select id="zdb-loc" class="zdb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="anterior">Frontzahnbereich</option>
              <option value="posterior" selected>Seitenzahnbereich</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versicherung/Zuschuss (%)</label><input type="number" id="zdb-ins" class="zdb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Zuschuss (&euro;)</label><input type="number" id="zdb-max" class="zdb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2000" min="0" max="10000" step="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Br&uuml;cke Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="zdb-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Br&uuml;ckeneinheiten</div><div class="text-xl font-bold font-mono" id="zdb-units">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vorbehandlung</div><div class="text-xl font-bold font-mono" id="zdb-prep">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="zdb-oop">0 &euro;</div></div>
        </div>
        <div class="p-3 bg-blue-50 rounded-xl text-center text-xs font-semibold text-blue-900 uppercase tracking-wide mb-1">Alternativenvergleich</div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Br&uuml;cke</div><div class="text-xl font-bold font-mono" id="zdb-bridge">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Implantat(e)</div><div class="text-xl font-bold font-mono" id="zdb-implant">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Teilprothese</div><div class="text-xl font-bold font-mono" id="zdb-denture">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dental-bridge-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Zahnbr&uuml;cken in Deutschland</h2>
      <p>Eine Zahnbr&uuml;cke ersetzt fehlende Z&auml;hne, indem sie auf den Nachbarz&auml;hnen (Pfeilern) befestigt wird. Die Kosten h&auml;ngen von Material, Anzahl der Glieder und notwendiger Vorbehandlung ab. Die gesetzliche Krankenkasse zahlt einen Festzuschuss.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie hoch ist der Festzuschuss der Krankenkasse?</strong> Der Festzuschuss deckt ca. 60% der Regelversorgung ab. Mit Bonusheft kann er auf 75% steigen.</p>
      <p><strong>Br&uuml;cke oder Implantat?</strong> Eine Br&uuml;cke ist g&uuml;nstiger und schneller fertig. Ein Implantat schont die Nachbarz&auml;hne und h&auml;lt l&auml;nger.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const zdbFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcZDB() {
      const pontics = parseFloat((document.getElementById('zdb-pontic') as HTMLInputElement).value) || 1;
      const mat = (document.getElementById('zdb-mat') as HTMLSelectElement).value;
      const abut = (document.getElementById('zdb-abut') as HTMLSelectElement).value;
      const loc = (document.getElementById('zdb-loc') as HTMLSelectElement).value;
      const insPct = parseFloat((document.getElementById('zdb-ins') as HTMLInputElement).value) || 0;
      const insMax = parseFloat((document.getElementById('zdb-max') as HTMLInputElement).value) || 0;

      const abutments = 2;
      const totalUnits = pontics + abutments;
      const unitCosts: Record<string, number> = { pfm: 900, zirconia: 1200, allceramic: 1050, metal: 800 };
      const locMult: Record<string, number> = { anterior: 1.05, posterior: 1.0 };

      const unitCost = unitCosts[mat] * (locMult[loc] || 1.0);
      const bridgeCost = Math.round(unitCost * totalUnits);

      let prepCost = 0;
      if (abut === 'buildup') prepCost = 250 * abutments;
      else if (abut === 'rct') prepCost = 800 * abutments + 250 * abutments;

      const subtotal = bridgeCost + prepCost;
      const insOffset = Math.min(subtotal * (insPct / 100), insMax);
      const oop = subtotal - insOffset;

      const implantCost = Math.round(pontics * 3000);
      const dentureCost = Math.round(1000 + pontics * 80);

      document.getElementById('zdb-total')!.textContent = zdbFmt(subtotal);
      document.getElementById('zdb-units')!.textContent = totalUnits + ' Einheiten';
      document.getElementById('zdb-prep')!.textContent = zdbFmt(prepCost);
      document.getElementById('zdb-oop')!.textContent = zdbFmt(oop);
      document.getElementById('zdb-bridge')!.textContent = zdbFmt(subtotal);
      document.getElementById('zdb-implant')!.textContent = zdbFmt(implantCost);
      document.getElementById('zdb-denture')!.textContent = zdbFmt(dentureCost);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zdb-in').forEach(el => { el.addEventListener('input', calcZDB); el.addEventListener('change', calcZDB); });
      calcZDB();
    }, 50);
  </script>
</CalculatorLayout>
