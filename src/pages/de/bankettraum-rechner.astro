---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bankettraumrechner - Raumgröße für Veranstaltungen & Gäste";
const description = "Berechnen Sie die benötigte Raumfläche für verschiedene Bestuhlung und Gästezahlen. Vergleichen Sie Theater-, Klassenzimmer-, Bankett-, U-Form- und Stehempfang-Layouts.";
const relatedCalcs = [
  { name: "Sitzplan-Rechner", url: "/de/sitzplan-rechner", description: "Tischlayout-Planer." },
  { name: "Zeltgröße-Rechner", url: "/de/zeltgroesse-rechner", description: "Benötigte Zeltmaße." },
  { name: "Eventbudget-Rechner", url: "/de/eventbudget-rechner", description: "Gesamte Eventkosten." },
  { name: "Soundsystem-Rechner", url: "/de/soundsystem-rechner", description: "Benötigte Lautsprecherleistung." },
  { name: "Eventbeleuchtung-Rechner", url: "/de/eventbeleuchtung-rechner", description: "Beleuchtungsplan." },
  { name: "Konferenzraum-Rechner", url: "/de/konferenzraum-rechner", description: "Konferenzraumplanung." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Bankettraumrechner"
  keywords="Bankettraum Rechner, Veranstaltungsraum Größe, Tagungsraum Kapazität, Venue Quadratmeter, Bestuhlung Layout"
  breadcrumbs={[{ name: "Bankettraum", url: "/de/bankettraum-rechner" }]}
  lang="de"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bankettraumrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die richtige Raumgröße basierend auf Bestuhlung und Gästezahl.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl Gäste</label>
          <input type="number" id="br2-guests" class="br2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="10" step="10">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Primäre Bestuhlung</label>
          <select id="br2-style" class="br2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="banquet">Bankett-Rundtische (Sitzessen)</option>
            <option value="theater">Theater (Stuhlreihen)</option>
            <option value="classroom">Klassenzimmer (Tische + Stühle nach vorn)</option>
            <option value="ushape">U-Form / Blockbestuhlung</option>
            <option value="cocktail">Stehempfang / Cocktail</option>
            <option value="boardroom">Konferenztisch (ein Tisch)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Bühne / Podium einplanen?</label>
          <select id="br2-stage" class="br2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Nein</option>
            <option value="14">Kleines Podium (14 m&sup2;)</option>
            <option value="28">Mittlere Bühne (28 m&sup2;)</option>
            <option value="46">Große Bühne (46 m&sup2;)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tanzfläche einplanen?</label>
          <select id="br2-dance" class="br2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Nein</option>
            <option value="18">Klein (18 m&sup2;)</option>
            <option value="32">Mittel (32 m&sup2;)</option>
            <option value="46">Groß (46 m&sup2;)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Puffer für Gänge & Service (%)</label>
          <input type="number" id="br2-buffer" class="br2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="5" max="40" step="5">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mindest-Raumgröße</div>
        <div class="text-5xl font-extrabold" id="br2-sqft">--</div>
        <div class="text-sm mt-1" id="br2-dims">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">m&sup2; pro Gast</div>
          <div class="text-xl font-bold" id="br2-ppguest">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Bestuhlungsfläche</div>
          <div class="text-xl font-bold" id="br2-seatarea">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Zusatzflächen</div>
          <div class="text-xl font-bold" id="br2-extra">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Mind. Deckenhöhe</div>
          <div class="text-xl font-bold" id="br2-ceiling">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="br2-compare"></div>

      <ShareButton calculatorId="banquet-room" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Raumgrößen-Richtwerte nach Layout</h2>
      <p>Platzbedarf pro Gast variiert stark nach Layout: Theater (0,6-0,7 m&sup2;), Klassenzimmer (1,4-1,7 m&sup2;), Bankett-Rundtische (1,1-1,3 m&sup2;), Stehempfang (0,6-0,7 m&sup2;), U-Form (2,3-2,8 m&sup2;).</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBR2() {
      const guests = parseInt((document.getElementById('br2-guests') as HTMLInputElement).value) || 10;
      const style = (document.getElementById('br2-style') as HTMLSelectElement).value;
      const stageArea = parseInt((document.getElementById('br2-stage') as HTMLSelectElement).value) || 0;
      const danceArea = parseInt((document.getElementById('br2-dance') as HTMLSelectElement).value) || 0;
      const bufferPct = parseFloat((document.getElementById('br2-buffer') as HTMLInputElement).value) || 20;

      const sqmMap: Record<string, number> = {
        banquet: 1.2, theater: 0.65, classroom: 1.6, ushape: 2.6, cocktail: 0.65, boardroom: 2.3,
      };
      const sqmPerGuest = sqmMap[style] || 1.2;
      const seatingArea = guests * sqmPerGuest;
      const extraArea = stageArea + danceArea;
      const subtotal = seatingArea + extraArea;
      const totalSqm = Math.ceil(subtotal * (1 + bufferPct / 100));
      const side = Math.ceil(Math.sqrt(totalSqm));
      const recW = Math.ceil(side * 0.75);
      const recL = Math.ceil(side * 1.33);
      const ceiling = guests > 200 ? '4,2+ m' : (guests > 100 ? '3,6+ m' : '3,0+ m');

      document.getElementById('br2-sqft')!.textContent = totalSqm.toLocaleString('de-DE') + ' m\u00B2';
      document.getElementById('br2-dims')!.textContent = side + 'x' + side + ' m (quadratisch) oder ' + recW + 'x' + recL + ' m (rechteckig)';
      document.getElementById('br2-ppguest')!.textContent = sqmPerGuest.toFixed(1).replace('.', ',') + ' m\u00B2';
      document.getElementById('br2-seatarea')!.textContent = Math.round(seatingArea).toLocaleString('de-DE') + ' m\u00B2';
      document.getElementById('br2-extra')!.textContent = extraArea.toLocaleString('de-DE') + ' m\u00B2';
      document.getElementById('br2-ceiling')!.textContent = ceiling;

      const layouts = [
        { name: 'Bankett-Rundtische', sqm: 1.2 },
        { name: 'Theater', sqm: 0.65 },
        { name: 'Klassenzimmer', sqm: 1.6 },
        { name: 'Stehempfang', sqm: 0.65 },
        { name: 'U-Form', sqm: 2.6 },
      ];
      let compare = '<h3 class="font-semibold text-sm text-text mb-2">Raumgr\u00F6\u00DFe nach Bestuhlungsstil</h3>';
      layouts.forEach(l => {
        const total = Math.ceil((guests * l.sqm + extraArea) * (1 + bufferPct / 100));
        const active = l.sqm === sqmPerGuest ? ' font-bold text-primary' : ' text-text-secondary';
        compare += '<div class="flex justify-between text-sm py-1 border-b border-border last:border-0' + active + '"><span>' + l.name + ' (' + l.sqm.toFixed(1).replace('.', ',') + ' m\u00B2/Gast)</span><span>' + total.toLocaleString('de-DE') + ' m\u00B2</span></div>';
      });
      document.getElementById('br2-compare')!.innerHTML = compare;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.br2-in').forEach(el => { el.addEventListener('input', calcBR2); el.addEventListener('change', calcBR2); });
      calcBR2();
    }, 50);
  </script>
</CalculatorLayout>
