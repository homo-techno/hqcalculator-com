---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lichtlaufzeit Rechner – Astronomische Distanzen & Lichtzeit";
const description = "Berechnen Sie die Zeit, die Licht benötigt, um astronomische Distanzen zu überbrücken – von der Erde zum Mond, zur Sonne und darüber hinaus.";
const relatedCalcs = [
  { name: "Blitzentfernung Rechner", url: "/de/blitzentfernung-rechner", description: "Schallgeschwindigkeit." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
  { name: "Lichtintensität Rechner", url: "/de/lichtintensitaet-rechner", description: "Lux & Lumen." },
  { name: "Linsengleichung Rechner", url: "/de/linsen-gleichung-rechner", description: "Optik." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="light-travel-time-calculator" calculatorName="Lichtlaufzeit Rechner" keywords="Lichtlaufzeit, Lichtgeschwindigkeit, astronomische Distanz, Lichtjahr, Lichtminuten" breadcrumbs={[{ name: "Lichtlaufzeit Rechner", url: "/de/lichtlaufzeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lichtlaufzeit Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie lange Licht braucht, um astronomische Distanzen zu überbrücken.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Bekannte Entfernung wählen</label>
          <select id="llt-preset" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="384400">Erde – Mond (384.400 km)</option>
            <option value="149597870.7" selected>Erde – Sonne (1 AE)</option>
            <option value="778570000">Erde – Jupiter</option>
            <option value="1427000000">Erde – Saturn</option>
            <option value="4500000000">Erde – Neptun</option>
            <option value="40000000000">Erde – Proxima Centauri (ca.)</option>
            <option value="custom">Eigene Eingabe</option>
          </select>
        </div>
        <div id="llt-custom-wrap" class="hidden">
          <label class="block text-sm font-medium text-text mb-1">Distanz (km)</label>
          <input type="number" id="llt-dist" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000000" step="1000" min="0">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Lichtlaufzeit</div>
          <div class="text-4xl font-extrabold font-mono" id="llt-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="llt-details"></div>
      </div>
      <ShareButton lang="de" calculatorId="lichtlaufzeit" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Die Lichtgeschwindigkeit im Universum</h2>
      <p>Licht bewegt sich mit ca. 299.792.458 m/s (≈ 300.000 km/s) durch das Vakuum. Dieses physikalische Limit bedeutet, dass alle astronomischen Beobachtungen zeitverzögert sind: Wir sehen die Sonne, wie sie vor 8 Minuten war. Licht von der Andromeda-Galaxie braucht 2,5 Millionen Jahre. Das Konzept der Lichtlaufzeit ist fundamental für unser Verständnis des Universums.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie lange braucht Licht von der Sonne zur Erde?</summary>
          <p class="mt-2 text-sm text-text-secondary">Licht braucht von der Sonne zur Erde ca. 8 Minuten und 20 Sekunden (499 Sekunden). Die Entfernung beträgt 149,6 Millionen Kilometer (1 Astronomische Einheit).</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist ein Lichtjahr?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ein Lichtjahr ist die Strecke, die Licht in einem Jahr zurücklegt: ca. 9,461 × 10¹² km (etwa 9,5 Billionen Kilometer). Es ist eine Längeneinheit, keine Zeiteinheit.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie lange braucht Licht zum Mond?</summary>
          <p class="mt-2 text-sm text-text-secondary">Licht braucht ca. 1,28 Sekunden von der Erde zum Mond. Das erklärt die Kommunikationsverzögerung bei Mondmissionen: Befehle kommen erst 1,28 Sekunden später an.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist eine Lichtsekunde in km?</summary>
          <p class="mt-2 text-sm text-text-secondary">Eine Lichtsekunde entspricht ca. 299.792 km. In einer Minute legt Licht ca. 18 Millionen km zurück, in einer Stunde ca. 1,08 Milliarden km.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const C_KM = 299792.458; // km/s
    function calcLLT() {
      const preset = (document.getElementById('llt-preset') as HTMLSelectElement).value;
      const customWrap = document.getElementById('llt-custom-wrap')!;
      customWrap.classList.toggle('hidden', preset !== 'custom');
      let distKm: number;
      if (preset === 'custom') {
        distKm = parseFloat((document.getElementById('llt-dist') as HTMLInputElement).value) || 0;
      } else {
        distKm = parseFloat(preset);
      }
      const seconds = distKm / C_KM;
      const minutes = seconds / 60;
      const hours = minutes / 60;
      const days = hours / 24;
      const years = days / 365.25;

      let displayText = '';
      if (seconds < 60) {
        displayText = seconds.toLocaleString('de-DE', { maximumFractionDigits: 3 }) + ' Sekunden';
      } else if (minutes < 60) {
        displayText = minutes.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Minuten';
      } else if (hours < 24) {
        displayText = hours.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Stunden';
      } else if (days < 365) {
        displayText = days.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Tage';
      } else {
        displayText = years.toLocaleString('de-DE', { maximumFractionDigits: 4 }) + ' Jahre';
      }

      document.getElementById('llt-result')!.textContent = displayText;
      const fmtN = (v: number, u: string) => v.toLocaleString('de-DE', { maximumFractionDigits: 4 }) + ' ' + u;
      const aeVal = distKm / 149597870.7;
      document.getElementById('llt-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sekunden</div><div class="text-lg font-bold font-mono">${fmtN(seconds, 's')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minuten</div><div class="text-lg font-bold font-mono">${fmtN(minutes, 'min')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stunden</div><div class="text-lg font-bold font-mono">${fmtN(hours, 'h')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Astron. Einheiten</div><div class="text-lg font-bold font-mono">${fmtN(aeVal, 'AE')}</div></div>`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('llt-preset')!.addEventListener('change', calcLLT);
      document.getElementById('llt-dist')!.addEventListener('input', calcLLT);
      calcLLT();
    }, 50);
  </script>
</CalculatorLayout>
