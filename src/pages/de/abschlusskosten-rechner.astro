---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Abschlusskosten-Rechner - Nebenkosten beim Immobilienkauf";
const description = "Berechnen Sie die Nebenkosten beim Immobilienkauf in Deutschland: Grunderwerbsteuer, Notar, Grundbuch und Makler.";
const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothekenberechnung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Mehrwertsteuer-Rechner", url: "/de/mehrwertsteuer-rechner", description: "MwSt berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Abschlusskosten-Rechner" enSlug="closing-cost-calculator" keywords="Kaufnebenkosten, Grunderwerbsteuer, Notarkosten, Grundbuchkosten, Maklergebühren, Immobilienkauf" breadcrumbs={[{ name: "Abschlusskosten-Rechner", url: "/de/abschlusskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Abschlusskosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die gesamten Kaufnebenkosten beim Immobilienerwerb in Deutschland.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kaufpreis (EUR)</label><input type="number" id="ak-price" class="ak2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="350000" min="0" step="5000"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bundesland</label>
            <select id="ak-state" class="ak2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="3.5">Bayern (3,5%)</option>
              <option value="3.5">Sachsen (3,5%)</option>
              <option value="5.0">Baden-Württemberg (5,0%)</option>
              <option value="5.0" selected>Hessen (5,0%)</option>
              <option value="6.0">Berlin (6,0%)</option>
              <option value="6.5">NRW (6,5%)</option>
              <option value="6.5">Brandenburg (6,5%)</option>
              <option value="6.5">Schleswig-Holstein (6,5%)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Makler (% vom Kaufpreis)</label>
            <input type="number" id="ak-broker" class="ak2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.57" min="0" max="7.14" step="0.01">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Darlehensbetrag (EUR)</label>
            <input type="number" id="ak-loan" class="ak2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="280000" min="0" step="5000">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Kaufnebenkosten</div>
          <div class="text-4xl font-extrabold font-mono" id="ak-total">0 EUR</div>
          <div class="text-sm text-blue-200 mt-1" id="ak-pct">0% des Kaufpreises</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Kostenaufstellung</h3>
          <div class="space-y-2 text-sm" id="ak-items"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Benötigtes Eigenkapital</div><div class="text-xl font-bold" id="ak-cash">0 EUR</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold" id="ak-down">0 EUR</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="abschlusskosten" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kaufnebenkosten in Deutschland</h2>
      <p>Beim Immobilienkauf in Deutschland fallen neben dem Kaufpreis erhebliche Nebenkosten an. Diese betragen typischerweise 7-13% des Kaufpreises und umfassen Grunderwerbsteuer, Notar- und Grundbuchkosten sowie ggf. Maklergebühren.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie hoch ist die Grunderwerbsteuer?</strong> Sie variiert je nach Bundesland zwischen 3,5% (Bayern, Sachsen) und 6,5% (z.B. NRW, Brandenburg).</p>
      <p><strong>Wer zahlt den Makler?</strong> Seit 2020 werden Maklerkosten bei Wohnimmobilien in der Regel hälftig zwischen Käufer und Verkäufer geteilt.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAK2() {
      const price = parseFloat((document.getElementById('ak-price') as HTMLInputElement).value) || 0;
      const taxRate = parseFloat((document.getElementById('ak-state') as HTMLSelectElement).value) || 5.0;
      const brokerPct = parseFloat((document.getElementById('ak-broker') as HTMLInputElement).value) || 3.57;
      const loan = parseFloat((document.getElementById('ak-loan') as HTMLInputElement).value) || 0;
      const down = price - loan;

      const items: [string, number][] = [
        ['Grunderwerbsteuer (' + taxRate + '%)', price * taxRate / 100],
        ['Notarkosten (ca. 1,5%)', price * 0.015],
        ['Grundbuchkosten (ca. 0,5%)', price * 0.005],
        ['Maklergebühren (' + brokerPct + '%)', price * brokerPct / 100],
      ];

      const total = items.reduce((s, [, v]) => s + v, 0);
      const fmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });

      document.getElementById('ak-total')!.textContent = fmt(Math.round(total)) + ' EUR';
      document.getElementById('ak-pct')!.textContent = (price > 0 ? (total / price * 100) : 0).toFixed(1) + '% des Kaufpreises';
      document.getElementById('ak-cash')!.textContent = fmt(Math.round(down + total)) + ' EUR';
      document.getElementById('ak-down')!.textContent = fmt(Math.round(down)) + ' EUR';
      document.getElementById('ak-items')!.innerHTML = items.map(([name, val]) =>
        '<div class="flex justify-between"><span class="text-text-muted">' + name + '</span><span class="font-bold">' + fmt(Math.round(val)) + ' EUR</span></div>'
      ).join('') + '<div class="flex justify-between border-t border-border pt-2 mt-2 font-bold"><span>Gesamt</span><span>' + fmt(Math.round(total)) + ' EUR</span></div>';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.ak2-in').forEach(el => el.addEventListener('input', calcAK2)); calcAK2(); }, 50);
  </script>
</CalculatorLayout>
