---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const relatedCalcs = [
  { slug: 'netzwerk-latenz-rechner', title: 'Netzwerk-Latenz' },
  { slug: 'netzwerk-verfuegbarkeit-rechner', title: 'Netzwerk-Verfügbarkeit' },
  { slug: 'internetgeschwindigkeit-rechner', title: 'Internetgeschwindigkeit' },
];
---
<CalculatorLayout
  title="Netzwerk-Durchsatz Rechner"
  description="Berechnen Sie theoretischen und effektiven Netzwerkdurchsatz sowie Übertragungszeiten für Datenmengen."
  lang="de"
  enSlug="network-throughput-calculator"
>
  <div class="ndr-wrap">
    <h2>Netzwerk-Durchsatz Rechner</h2>

    <div class="ndr-form">
      <label>Bandbreite (Mbit/s)
        <input type="number" id="ndr-bw" value="100" min="0.001" step="1" />
      </label>
      <label>Effizienz / Protokoll-Overhead (%)
        <input type="number" id="ndr-eff" value="80" min="1" max="100" step="1" />
      </label>
      <label>Datenmenge (MB)
        <input type="number" id="ndr-data" value="1000" min="0" step="1" />
      </label>
      <button id="ndr-btn">Berechnen</button>
    </div>

    <div class="ndr-result" id="ndr-result" style="display:none">
      <h3>Ergebnis</h3>
      <div class="ndr-grid">
        <div class="ndr-item"><span>Theoretischer Durchsatz</span><strong id="ndr-theo"></strong></div>
        <div class="ndr-item"><span>Effektiver Durchsatz</span><strong id="ndr-eff-r"></strong></div>
        <div class="ndr-item highlight"><span>Übertragungszeit</span><strong id="ndr-time"></strong></div>
        <div class="ndr-item"><span>Durchsatz in MB/s</span><strong id="ndr-mbs"></strong></div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('ndr-btn').addEventListener('click', function() {
      var bw = parseFloat(document.getElementById('ndr-bw').value) || 100;
      var eff = parseFloat(document.getElementById('ndr-eff').value) || 80;
      var dataMB = parseFloat(document.getElementById('ndr-data').value) || 1000;
      var effectiveMbps = bw * (eff / 100);
      var effectiveMBs = effectiveMbps / 8;
      var timeSec = dataMB / effectiveMBs;
      var timeStr = timeSec < 60 ? timeSec.toFixed(2) + ' s' : (timeSec < 3600 ? (timeSec/60).toFixed(2) + ' min' : (timeSec/3600).toFixed(2) + ' h');
      document.getElementById('ndr-theo').textContent = bw.toLocaleString('de-DE') + ' Mbit/s';
      document.getElementById('ndr-eff-r').textContent = effectiveMbps.toFixed(1) + ' Mbit/s';
      document.getElementById('ndr-time').textContent = timeStr;
      document.getElementById('ndr-mbs').textContent = effectiveMBs.toFixed(2) + ' MB/s';
      document.getElementById('ndr-result').style.display = 'block';
      document.dispatchEvent(new CustomEvent('calc-update'));
    });
  </script>

  <style>
    .ndr-wrap { max-width: 600px; margin: 0 auto; }
    .ndr-form { display: flex; flex-direction: column; gap: 12px; margin: 20px 0; }
    .ndr-form label { display: flex; flex-direction: column; gap: 4px; font-weight: 500; }
    .ndr-form input { padding: 8px; border: 1px solid #ddd; border-radius: 6px; font-size: 1rem; }
    .ndr-form button { background: #2563eb; color: #fff; border: none; padding: 12px; border-radius: 8px; font-size: 1rem; cursor: pointer; }
    .ndr-result { background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; padding: 20px; margin-top: 20px; }
    .ndr-grid { display: grid; gap: 10px; margin-top: 12px; }
    .ndr-item { display: flex; justify-content: space-between; padding: 8px 12px; background: #fff; border-radius: 6px; }
    .ndr-item.highlight { background: #dbeafe; font-weight: bold; }
  </style>

  <section>
    <h2>Netzwerkdurchsatz erklärt</h2>
    <p>Der theoretische Durchsatz entspricht der Nennbandbreite, der effektive Durchsatz ist geringer durch Protokoll-Overhead (TCP/IP-Header, Handshake, Fehlerkorrektur). Bei 100 Mbit/s Ethernet liegt der effektive Durchsatz typischerweise bei 80–90 Mbit/s, bei WLAN oft nur bei 50–60%.</p>
  </section>

  <section>
    <h2>Häufige Fragen</h2>
    <details><summary>Warum ist der effektive Durchsatz geringer als die Nennbandbreite?</summary><p>Protokoll-Overhead (TCP/IP-Header), Paketverluste, Wiederholungsübertragungen und Flusskontrolle reduzieren den nutzbaren Durchsatz.</p></details>
    <details><summary>Was ist der Unterschied zwischen Mbit/s und MB/s?</summary><p>1 MB/s = 8 Mbit/s. Internetanbieter werben in Mbit/s, Dateigrößen werden in MB/GB angegeben.</p></details>
    <details><summary>Wie lange dauert der Upload einer 10-GB-Datei bei 100 Mbit/s?</summary><p>Bei 80% Effizienz = 80 Mbit/s = 10 MB/s → 1024 MB / 10 MB/s ≈ 102 Sekunden.</p></details>
  </section>

  <ShareButton calculatorId="netzwerk-durchsatz-rechner" lang="de" />
  <FeedbackWidget lang="de" />
  <RelatedCalculators calculators={relatedCalcs} lang="de" />
</CalculatorLayout>
