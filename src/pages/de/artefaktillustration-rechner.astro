---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Artefaktillustrations-Rechner - Maßstabsfaktor & Zeichnungsmaße";
const description = "Berechnen Sie Maßstabsfaktoren, Zeichnungsmaße und Verkleinerungsverhältnisse für archäologische Artefaktillustrationen.";
const relatedCalcs = [
  { name: "Keramikanalyse", url: "/ceramic-analysis-calculator", description: "Keramikanalyse." },
  { name: "Lithische Analyse", url: "/lithic-analysis-calculator", description: "Steinwerkzeuganalyse." },
  { name: "Knochenmessung", url: "/bone-measurement-calculator", description: "Skelettmessungen." },
  { name: "Artefaktdichte", url: "/de/artefaktdichte-rechner", description: "Funde pro Fläche." },
  { name: "Seitenverhältnis", url: "/de/seitenverhaeltnis-rechner", description: "Verhältnisberechnungen." },
  { name: "Bildschirmgröße", url: "/screen-size-calculator", description: "Größenberechnungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Artefaktillustrations-Rechner" keywords="Artefaktillustration, Maßstabsfaktor, Zeichnungsmaßstab, archäologische Illustration, Verkleinerung, 1:1 Maßstab" lang="de" breadcrumbs={[{ name: "Artefaktillustration", url: "/de/artefaktillustration-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Artefaktillustrations-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Maßstabsfaktoren und Zeichnungsmaße für archäologische Artefaktillustrationen. Rechnen Sie zwischen tatsächlichen und Illustrationsmaßen um.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tatsächliche Objektlänge (mm)</label>
          <input type="number" id="ail-actual" class="ail-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="85" min="0.1" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tatsächliche Objektbreite (mm)</label>
          <input type="number" id="ail-width" class="ail-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="0.1" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tatsächliche Objektdicke (mm)</label>
          <input type="number" id="ail-thick" class="ail-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0.1" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Zeichnungsmaßstab</label>
          <select id="ail-scale" class="ail-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="2">2:1 (doppelte Größe)</option>
            <option value="1" selected>1:1 (Originalgröße)</option>
            <option value="0.75">3:4 (dreiviertel)</option>
            <option value="0.5">1:2 (halbe Größe)</option>
            <option value="0.333">1:3 (ein Drittel)</option>
            <option value="0.25">1:4 (ein Viertel)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Publikationsverkleinerung (%)</label>
          <input type="number" id="ail-reduce" class="ail-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="10" max="100" step="5">
          <p class="text-xs text-text-muted mt-1">Typisch: 50 % für die meisten Publikationen, 33 % für große Objekte</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gewünschte Linienstärke in Publikation (mm)</label>
          <input type="number" id="ail-publine" class="ail-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.3" min="0.1" max="2" step="0.05">
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Zeichnungslänge</div>
          <div class="text-4xl font-extrabold" id="ail-drawlen">0</div>
          <div class="text-sm text-blue-200 mt-1" id="ail-scalestr">im Maßstab</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zeichnungsbreite</div>
            <div class="text-xl font-bold" id="ail-drawwid">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zeichnungsdicke</div>
            <div class="text-xl font-bold" id="ail-drawthk">0</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Publikationslänge</div>
            <div class="text-xl font-bold" id="ail-publen">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Publikationsmaßstab</div>
            <div class="text-xl font-bold" id="ail-pubscale">0</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zeichnungslinienstärke</div>
            <div class="text-xl font-bold" id="ail-drawline">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Maßstabsleiste (Zeichnung)</div>
            <div class="text-xl font-bold" id="ail-scalebar">0</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="artifact-illustration" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Formeln für Artefaktillustrationen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Zeichnungsgröße</strong> = Tatsächliche Größe * Maßstabsfaktor</p>
        <p><strong>Publikationsgröße</strong> = Zeichnungsgröße * (Verkleinerung % / 100)</p>
        <p><strong>Zeichnungslinienstärke</strong> = Pub.-Linienstärke / (Verkleinerung / 100)</p>
      </div>
      <p>Archäologische Illustrationen müssen eine Maßstabsleiste enthalten und den Zeichnungsmaßstab angeben. Standardpraxis ist 1:1 für die meisten Artefakte, 2:1 für Kleinfunde und 1:2 oder kleiner für große Objekte.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAIL() {
      const actual = parseFloat((document.getElementById('ail-actual') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('ail-width') as HTMLInputElement).value) || 0;
      const thick = parseFloat((document.getElementById('ail-thick') as HTMLInputElement).value) || 0;
      const scale = parseFloat((document.getElementById('ail-scale') as HTMLSelectElement).value) || 1;
      const reducePct = parseFloat((document.getElementById('ail-reduce') as HTMLInputElement).value) || 100;
      const pubLine = parseFloat((document.getElementById('ail-publine') as HTMLInputElement).value) || 0.3;

      const drawLen = actual * scale;
      const drawWid = width * scale;
      const drawThk = thick * scale;
      const reduceFactor = reducePct / 100;
      const pubLen = drawLen * reduceFactor;
      const pubScale = scale * reduceFactor;
      const drawLine = pubLine / reduceFactor;
      const scaleBarReal = 50;
      const scaleBarDraw = scaleBarReal * scale;

      let scaleStr = '';
      if (scale >= 1) scaleStr = scale + ':1';
      else scaleStr = '1:' + (1 / scale).toFixed(0);

      let pubScaleStr = '';
      if (pubScale >= 1) pubScaleStr = pubScale.toFixed(2) + ':1';
      else pubScaleStr = '1:' + (1 / pubScale).toFixed(1);

      const fmt = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('ail-drawlen')!.textContent = fmt(drawLen) + ' mm';
      document.getElementById('ail-scalestr')!.textContent = 'im Maßstab ' + scaleStr;
      document.getElementById('ail-drawwid')!.textContent = fmt(drawWid) + ' mm';
      document.getElementById('ail-drawthk')!.textContent = fmt(drawThk) + ' mm';
      document.getElementById('ail-publen')!.textContent = fmt(pubLen) + ' mm';
      document.getElementById('ail-pubscale')!.textContent = pubScaleStr;
      document.getElementById('ail-drawline')!.textContent = drawLine.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' mm';
      document.getElementById('ail-scalebar')!.textContent = fmt(scaleBarDraw) + ' mm = 5 cm';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ail-in').forEach(el => { el.addEventListener('input', calcAIL); el.addEventListener('change', calcAIL); });
      calcAIL();
    }, 50);
  </script>
</CalculatorLayout>
