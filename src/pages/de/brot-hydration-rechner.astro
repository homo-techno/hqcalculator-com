---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Brot-Hydration-Rechner - Teigeigenschaften nach Hydration";
const description = "Visualisieren und verstehen Sie Brotteig-Eigenschaften bei verschiedenen Hydrationsstufen. Handhabungstipps, ideale Brotarten und erwartete Krumenstruktur.";
const relatedCalcs = [
  { name: "Bäckerprozent-Rechner", url: "/de/baeckerprozent-rechner", description: "Bäckerprozente berechnen." },
  { name: "Brotmehl-Rechner", url: "/de/brotmehl-rechner", description: "Mehlprotein und Substitution." },
  { name: "Alkohol-Kalorien-Rechner", url: "/de/alkohol-kalorien-rechner", description: "Getränke-Kalorien." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Brot-Hydration-Rechner" enSlug="bread-hydration-visual-calculator" keywords="Brot Hydration, Teig Hydration visuell, Krumenstruktur, Brot Textur, Hydrationsstufen, Teig Handhabung" breadcrumbs={[{ name: "Brot-Hydration-Rechner", url: "/de/brot-hydration-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Brot-Hydration-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erkunden Sie, wie verschiedene Hydrationsstufen das Teigverhalten, die Brotarten, Krumenstruktur und Handhabungstechniken beeinflussen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hydrationsstufe (%)</label>
          <input type="range" id="bh-slider" class="bh-in w-full" min="45" max="100" value="65" step="1">
          <div class="flex justify-between text-xs text-text-muted mt-1">
            <span>45%</span><span>60%</span><span>75%</span><span>90%</span><span>100%</span>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Oder exakte Hydration eingeben</label>
          <input type="number" id="bh-exact" class="bh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="65" min="45" max="100" step="1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Mehlsorte</label>
          <select id="bh-flour" class="bh-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="bread">Brotmehl Type 550 (11-12%)</option>
            <option value="ap">Allzweckmehl Type 405 (10-11%)</option>
            <option value="ww">Vollkornmehl (14%)</option>
            <option value="rye">Roggenmehl (8-9%)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Hydration</div>
          <div class="text-5xl font-extrabold font-mono" id="bh-result">--</div>
        </div>
        <div class="p-6 bg-surface-alt rounded-2xl">
          <div class="text-xs text-text-muted uppercase mb-3">Teig-Visuelle Anzeige</div>
          <div class="relative h-8 bg-gray-200 rounded-full overflow-hidden">
            <div class="absolute left-0 top-0 h-full rounded-full transition-all duration-300" id="bh-bar" style="width: 50%; background: linear-gradient(90deg, #d4a373, #8b6f47);"></div>
          </div>
          <div class="flex justify-between text-xs text-text-muted mt-1">
            <span>Fest</span><span>Weich</span><span>Feucht</span><span>Teigig</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Teigbeschaffenheit</div><div class="text-lg font-bold" id="bh-feel">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ideale Brotarten</div><div class="text-lg font-bold" id="bh-breads">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krumenstruktur</div><div class="text-lg font-bold" id="bh-crumb">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krusteneigenschaft</div><div class="text-lg font-bold" id="bh-crust">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Handhabungsschwierigkeit</div><div class="text-lg font-bold" id="bh-difficulty">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ofentrieb</div><div class="text-lg font-bold" id="bh-spring">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Handhabungstipps</div>
          <div class="text-sm text-text-secondary" id="bh-tips">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Mehlsorte-Hinweis</div>
          <div class="text-sm text-text-secondary" id="bh-flour-note">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="brot-hydration" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Brot-Hydration verstehen</h2>
      <p>Die Hydration ist das Verhältnis von Wasser zu Mehl in Prozent. Bei 65% Hydration kommen auf 1000g Mehl 650g Wasser. Niedrigere Hydration (50-60%) ergibt festere Teige für Brötchen und Bagels. Höhere Hydration (75-85%) ergibt offenere Krumen wie bei Ciabatta. Deutsche Brote haben typischerweise 60-70% Hydration.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBH() {
      const slider = document.getElementById('bh-slider') as HTMLInputElement;
      const exact = document.getElementById('bh-exact') as HTMLInputElement;
      const flourType = (document.getElementById('bh-flour') as HTMLSelectElement).value;
      let hydration = parseFloat(exact.value) || 65;
      if (document.activeElement === slider) {
        hydration = parseFloat(slider.value) || 65;
        exact.value = String(hydration);
      } else {
        slider.value = String(Math.min(100, Math.max(45, hydration)));
      }
      hydration = Math.min(100, Math.max(45, hydration));
      const barWidth = ((hydration - 45) / 55) * 100;
      const bar = document.getElementById('bh-bar') as HTMLElement;
      bar.style.width = barWidth + '%';
      if (hydration < 60) bar.style.background = 'linear-gradient(90deg, #c4956a, #b8845c)';
      else if (hydration < 70) bar.style.background = 'linear-gradient(90deg, #c4956a, #9a7b5a)';
      else if (hydration < 80) bar.style.background = 'linear-gradient(90deg, #9a7b5a, #6b8cae)';
      else bar.style.background = 'linear-gradient(90deg, #6b8cae, #4a7ab5)';
      document.getElementById('bh-result')!.textContent = hydration + '%';
      let feel = '', breads = '', crumb = '', crust = '', difficulty = '', spring = '', tips = '';
      if (hydration < 55) {
        feel = 'Sehr fest, dicht, trocken';
        breads = 'Nudeln, Bagels, Brezeln';
        crumb = 'Sehr eng, dicht, kleine L\u00f6cher';
        crust = 'Z\u00e4h, dick';
        difficulty = 'Leicht - h\u00e4lt Form gut';
        spring = 'Minimal';
        tips = 'Gr\u00fcndlich kneten f\u00fcr Glutenentwicklung. Teig ist fest und widersteht Dehnung. Teigschaber verwenden. L\u00e4ngere Ruhezeiten f\u00fcr Hydration einplanen.';
      } else if (hydration < 62) {
        feel = 'Fest, glatt, geschmeidig';
        breads = 'Bagels, Toastbrot, Br\u00f6tchen';
        crumb = 'Eng, gleichm\u00e4\u00dfig, kleine L\u00f6cher';
        crust = 'Mittlere Kruste';
        difficulty = 'Leicht - gut handhabbar';
        spring = 'M\u00e4\u00dfig';
        tips = 'Gut f\u00fcr Anf\u00e4nger. Teig l\u00e4sst sich leicht formen. Standardkneten funktioniert gut. Fest formen f\u00fcr gute Struktur.';
      } else if (hydration < 68) {
        feel = 'Weich, geschmeidig, leicht klebrig';
        breads = 'Toastbrot, Dinnerrolls, Franz\u00f6sisches Brot';
        crumb = 'Mittlere, gleichm\u00e4\u00dfige Krume mit kleinen-mittleren L\u00f6chern';
        crust = 'Leicht, knusprige Kruste';
        difficulty = 'Leicht bis mittel';
        spring = 'Gut';
        tips = 'Klassische Brot-Hydration. Leicht bemehlen bei Handhabung. Fenstertest funktioniert gut in diesem Bereich. Gute Balance aus Geschmack und Textur.';
      } else if (hydration < 75) {
        feel = 'Weich, klebrig, dehnbar';
        breads = 'Baguettes, Landbrot, Sauerteig';
        crumb = 'Offene Krume, unregelm\u00e4\u00dfige mittlere L\u00f6cher';
        crust = 'Knusprig, rissige Kruste';
        difficulty = 'Mittel - etwas klebrig';
        spring = 'Sehr gut';
        tips = 'Nasse H\u00e4nde oder Teigschaber verwenden. Dehnen-und-Falten funktioniert besser als Kneten. Mehl beim Formen minimieren. Gute Glutenentwicklung erm\u00f6glichen.';
      } else if (hydration < 82) {
        feel = 'Sehr weich, klebrig, dehnbar';
        breads = 'Ciabatta, Focaccia, Pain de Campagne';
        crumb = 'Offen, gro\u00dfe unregelm\u00e4\u00dfige L\u00f6cher';
        crust = 'D\u00fcnn, sehr knusprig';
        difficulty = 'Herausfordernd - sehr klebrig';
        spring = 'Ausgezeichnet';
        tips = 'Nasse H\u00e4nde sind essenziell. Dehnen-und-Falten-Methode (3-4 S\u00e4tze w\u00e4hrend Stockgare). Vorsichtig formen. In ge\u00f6lte Formen gie\u00dfen f\u00fcr Focaccia. Starkes Mehl empfohlen.';
      } else if (hydration < 90) {
        feel = 'Extrem weich, teigig, gie\u00dfbar';
        breads = 'Hoch-Hydrations-Focaccia, Kastenbrote';
        crumb = 'Sehr offen, gro\u00dfe L\u00f6cher, cremig';
        crust = 'D\u00fcnn, zart, knusprig';
        difficulty = 'Sehr herausfordernd';
        spring = 'Explosiv (in Formen)';
        tips = 'Fast unm\u00f6glich per Hand zu formen. Gut ge\u00f6lte Formen verwenden. Coil-Folds funktionieren am besten. Proteinreiches Mehl (13%+) erforderlich. Lange Kalte F\u00fchrung hilft. Backpapier verwenden.';
      } else {
        feel = 'Teig-Konsistenz, leicht gie\u00dfbar';
        breads = 'Spezial-Kastenbrote, experimentell';
        crumb = 'Extrem offen, sehr cremig';
        crust = 'D\u00fcnn, weich';
        difficulty = 'Expertenniveau';
        spring = 'Formabh\u00e4ngig';
        tips = 'Im Grunde ein dicker Teig. Muss in Form gebacken werden. Sehr proteinreiches Mehl essenziell. Verl\u00e4ngerte Autolyse (1-2 Stunden) hilft. Mehrere Coil-Folds n\u00f6tig. Kalte F\u00fchrung dringend empfohlen.';
      }
      let flourNote = '';
      if (flourType === 'bread') {
        flourNote = 'Brotmehl Type 550 (11-12% Protein) kann h\u00f6here Hydration handhaben. 5-10% mehr Wasser als bei Type-405-Rezepten m\u00f6glich.';
      } else if (flourType === 'ap') {
        flourNote = 'Type 405 (10-11% Protein) funktioniert gut bis ~70% Hydration. Dar\u00fcber wird der Teig schwieriger zu handhaben. Hydration um 3-5% reduzieren.';
      } else if (flourType === 'ww') {
        flourNote = 'Vollkornmehl absorbiert mehr Wasser. Typischerweise 5-10% mehr Hydration m\u00f6glich. Kleie schneidet Glutenstr\u00e4nge, daher 30-60 Min. Autolyse. Dichtere Krume erwarten.';
      } else if (flourType === 'rye') {
        flourNote = 'Roggenmehl hat minimales Gluten. \u00dcber 50% Roggenanteil verh\u00e4lt sich der Teig v\u00f6llig anders. Hydration f\u00fchlt sich feuchter an, da Roggen langsam Wasser aufnimmt. Kastenform f\u00fcr Roggenbrote verwenden.';
      }
      document.getElementById('bh-feel')!.textContent = feel;
      document.getElementById('bh-breads')!.textContent = breads;
      document.getElementById('bh-crumb')!.textContent = crumb;
      document.getElementById('bh-crust')!.textContent = crust;
      document.getElementById('bh-difficulty')!.textContent = difficulty;
      document.getElementById('bh-spring')!.textContent = spring;
      document.getElementById('bh-tips')!.textContent = tips;
      document.getElementById('bh-flour-note')!.textContent = flourNote;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bh-in').forEach(el => { el.addEventListener('input', calcBH); el.addEventListener('change', calcBH); });
      calcBH();
    }, 50);
  </script>
</CalculatorLayout>
