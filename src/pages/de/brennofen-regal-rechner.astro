---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Brennofen Regalrechner – Regalanordnung & Kapazität planen";
const description = "Planen Sie Regalanordnung und Kapazität in Ihrem Töpferbrennofen.";
const relatedCalcs = [
  { name: "Brennofen Energierechner", url: "/de/brennofen-energie-rechner", description: "Stromkosten Brennofen." },
  { name: "Brennofen Temperaturrechner", url: "/de/brennofen-temperatur-rechner", description: "Temperaturen & Kegelwerte." },
  { name: "3D-Drucker Kostenrechner", url: "/de/3d-drucker-kosten-rechner", description: "3D-Druck Kosten." },
  { name: "Einladungsrechner", url: "/de/einladungs-rechner", description: "Druckkosten Einladungen." },
];
---
<CalculatorLayout lang="de" enSlug="kiln-shelf-calculator" title={title} description={description} calculatorName="Brennofen Regalrechner" keywords="Brennofen Regal, Töpferei Kapazität, Ofenregal Anordnung, Kiln Shelf, Töpferbrennofen planen" breadcrumbs={[{ name: "Brennofen Regalrechner", url: "/de/brennofen-regal-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Brennofen Regalrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie die optimale Regalanordnung in Ihrem Töpferbrennofen und ermitteln Sie die maximale Ladekapazität.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Brennofen-Innenmaße</h3>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="br-width" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="40" min="10" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tiefe (cm)</label><input type="number" id="br-depth" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="40" min="10" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Höhe (cm)</label><input type="number" id="br-height" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="50" min="10" step="1"></div>
        </div>
        <h3 class="font-semibold text-text">Regalmaße</h3>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Regal-Breite (cm)</label><input type="number" id="br-sw" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="30" min="5" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Regal-Tiefe (cm)</label><input type="number" id="br-sd" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="30" min="5" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Regal-Dicke (cm)</label><input type="number" id="br-st" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="1.5" min="0.5" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Min. Abstand zwischen Etagen (cm)</label><input type="number" id="br-gap" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="10" min="2" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Unterstützer-Höhe (cm)</label><input type="number" id="br-post" class="br-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="8" min="1" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Maximale Etagen</div>
          <div class="text-5xl font-extrabold font-mono" id="br-result">—</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nutzbare Fläche/Etage</div><div class="text-xl font-bold" id="br-area">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtfläche</div><div class="text-xl font-bold" id="br-total-area">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ofen-Volumen</div><div class="text-xl font-bold" id="br-vol">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Etagen-Verteilung</h3>
          <div class="text-xs space-y-1" id="br-layout"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kiln-shelf" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Brennofen-Beladung optimieren</h2>
      <p class="text-text-secondary">Eine gut geplante Regalanordnung maximiert die Nutzkapazität Ihres Brennofens und sorgt für gleichmäßige Wärmeverteilung. Wichtige Faustregeln: Zwischen der Oberkante des höchsten Stücks und dem nächsten Regal mindestens 1–2 cm Abstand lassen, Regale nicht bis an die Ofenwand schieben (2–3 cm Abstand für Luftzirkulation) und schwerere Stücke immer auf die unterste Etage stellen.</p>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welches Material sind Brennofenregale?</h4>
          <p class="text-text-secondary mt-1">Brennofenregale bestehen meist aus hochfeuerfestem Cordierit (Magnesium-Aluminium-Silikat) oder Siliziumkarbid (SiC). Cordierit ist leichter und günstiger, SiC-Platten sind stabiler und langlebiger, aber teurer. Für Temperaturen unter 1300 °C eignet sich Cordierit gut.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was sind Kiln Wash und warum ist es wichtig?</h4>
          <p class="text-text-secondary mt-1">Kiln Wash (Regaltrennmittel) ist eine Schutzschicht aus Aluminiumoxid oder Kaolin, die auf Ofenregale aufgetragen wird, um das Ankleben von heruntertropfender Glasur zu verhindern. Ohne Kiln Wash können Glasurtropfen Regale dauerhaft beschädigen.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel Abstand brauche ich zwischen den Stücken?</h4>
          <p class="text-text-secondary mt-1">Bei glasierten Stücken mindestens 1–2 cm Abstand zwischen den Objekten lassen, damit die Glasur beim Schmelzen nicht zusammenklebt. Unglasierte Stücke (Biskuitware) können eng gestapelt werden. Beim Glasurbrand darf keine Glasur das Ofenregal oder andere Stücke berühren.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welche Ofen-Größe brauche ich als Hobbyist?</h4>
          <p class="text-text-secondary mt-1">Für Hobbytöpfer reicht ein Frontofen mit ca. 20–50 Liter Innenvolumen (z.B. 30×30×30 cm). Für semi-professionelle Nutzung empfehlen sich 50–120-Liter-Öfen. Professionelle Werkstätten nutzen Öfen ab 200 Liter aufwärts, oft mit Drehstromanschluss.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBR() {
      const ow = parseFloat((document.getElementById('br-width') as HTMLInputElement).value) || 40;
      const od = parseFloat((document.getElementById('br-depth') as HTMLInputElement).value) || 40;
      const oh = parseFloat((document.getElementById('br-height') as HTMLInputElement).value) || 50;
      const sw = parseFloat((document.getElementById('br-sw') as HTMLInputElement).value) || 30;
      const sd = parseFloat((document.getElementById('br-sd') as HTMLInputElement).value) || 30;
      const st = parseFloat((document.getElementById('br-st') as HTMLInputElement).value) || 1.5;
      const gap = parseFloat((document.getElementById('br-gap') as HTMLInputElement).value) || 10;
      const post = parseFloat((document.getElementById('br-post') as HTMLInputElement).value) || 8;
      const shelfStep = st + post + gap;
      const maxShelves = Math.floor((oh - gap) / shelfStep);
      const totalShelves = Math.max(0, maxShelves);
      const shelfArea = sw * sd;
      const totalArea = shelfArea * totalShelves;
      const ovenVol = (ow * od * oh) / 1000;
      document.getElementById('br-result')!.textContent = totalShelves.toString();
      document.getElementById('br-area')!.textContent = shelfArea.toLocaleString('de-DE') + ' cm²';
      document.getElementById('br-total-area')!.textContent = totalArea.toLocaleString('de-DE') + ' cm²';
      document.getElementById('br-vol')!.textContent = ovenVol.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' L';
      const lines = [];
      for (let i = 0; i < totalShelves; i++) {
        const bottom = Math.round(i * shelfStep + gap);
        const top = Math.round(bottom + st);
        lines.push('Etage ' + (i + 1) + ': ' + bottom + '–' + top + ' cm (Nutzraum bis ' + Math.round(top + gap) + ' cm)');
      }
      document.getElementById('br-layout')!.innerHTML = lines.map(l => '<div>' + l + '</div>').join('') || '<div>Keine Etagen möglich</div>';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.br-in').forEach(el => { el.addEventListener('input', calcBR); el.addEventListener('change', calcBR); });
      calcBR();
    }, 50);
  </script>
</CalculatorLayout>
