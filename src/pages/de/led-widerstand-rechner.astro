---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "LED-Widerstand Rechner";
const description = "Berechnen Sie den richtigen Vorwiderstand für LEDs aus Spannung und Strom.";

const relatedCalcs = [
  { name: "LED-Einsparrechner", url: "/de/led-ersparnis-rechner", description: "LED-Einsparungen berechnen." },
  { name: "Gartenbeleuchtung Rechner", url: "/de/gartenbeleuchtung-rechner", description: "Gartenbeleuchtung planen." },
  { name: "Akkulaufzeit-Rechner", url: "/de/akkulaufzeit-rechner", description: "Akkulaufzeit berechnen." },
  { name: "ADC-Auflösung-Rechner", url: "/de/adc-aufloesung-rechner", description: "ADC-Auflösung berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="LED-Widerstand Rechner" lang="de" enSlug="led-resistor-calculator" keywords="led widerstand rechner, vorwiderstand berechnen, led schaltung, led strom berechnen" breadcrumbs={[{ name: "LED-Widerstand Rechner", url: "/de/led-widerstand-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">LED-Widerstand Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den benötigten Vorwiderstand für LEDs, um sie sicher an einer Spannungsquelle zu betreiben.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versorgungsspannung (V)</label><input type="number" id="lwr-vs" class="lwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" min="1.5" max="48" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">LED-Farbe / Typ</label><select id="lwr-color" class="lwr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.8">Rot (1,8 V)</option>
            <option value="2.0">Orange (2,0 V)</option>
            <option value="2.1">Gelb (2,1 V)</option>
            <option value="2.2" selected>Grün (2,2 V)</option>
            <option value="3.2">Blau / Weiß (3,2 V)</option>
            <option value="3.4">Ultraviolett (3,4 V)</option>
            <option value="0">Benutzerdefiniert</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">LED-Vorwärtsspannung (V)</label><input type="number" id="lwr-vf" class="lwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.2" min="0.5" max="5" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">LED-Strom (mA)</label><input type="number" id="lwr-if" class="lwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" max="1000" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Anzahl LEDs in Reihe</label><input type="number" id="lwr-num" class="lwr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="20" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Vorwiderstand</div>
          <div class="text-4xl font-extrabold font-mono" id="lwr-r">0 Ω</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nächster E12-Wert</div><div class="text-xl font-bold" id="lwr-e12">0 Ω</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verlustleistung</div><div class="text-xl font-bold" id="lwr-power">0 mW</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Min. Widerstandsleistung</div><div class="text-xl font-bold" id="lwr-prating">0 W</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Farbcode-Hinweis</div>
          <div class="text-sm font-mono" id="lwr-colorcode">–</div>
        </div>
      </div>
      <ShareButton calculatorId="led-resistor-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">LED-Vorwiderstand – Warum ist er wichtig?</h2>
      <p>LEDs haben keine interne Strombegrenzung. Ohne Vorwiderstand fließt ein unkontrollierter Strom, der die LED sofort zerstört. Der Vorwiderstand begrenzt den Strom auf den zulässigen Betriebsstrom (meist 20 mA für Standard-LEDs). Die Berechnung folgt dem Ohmschen Gesetz: R = (Vs − n×Vf) / If, wobei Vs die Versorgungsspannung, Vf die Vorwärtsspannung, n die Anzahl der LEDs in Reihe und If der Betriebsstrom ist.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p><strong>Formel:</strong> R = (Vs − n × Vf) / If</p>
        <p><strong>Verlustleistung:</strong> P = (Vs − n × Vf) × If</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was passiert ohne Vorwiderstand?</strong> Ohne Vorwiderstand ist der Strom nur durch den minimalen Innenwiderstand der LED begrenzt. Dies führt zu sofortiger thermischer Zerstörung der LED.</p>
      <p><strong>Was sind E12-Widerstände?</strong> E12 ist eine genormte Widerstandsreihe mit 12 Werten pro Dekade (1,0; 1,2; 1,5; 1,8; 2,2; 2,7; 3,3; 3,9; 4,7; 5,6; 6,8; 8,2). Der nächsthöhere E12-Wert schützt die LED besser.</p>
      <p><strong>Wie viel Leistung muss der Widerstand vertragen?</strong> Die berechnete Verlustleistung mit Sicherheitsfaktor 2 ergibt die Mindest-Nennleistung. Gängige Werte: 0,25 W, 0,5 W, 1 W.</p>
      <p><strong>Kann ich mehrere LEDs parallel betreiben?</strong> Ja, aber jede LED benötigt dann einen eigenen Vorwiderstand, da Fertigungsstreuungen zu ungleichmäßiger Stromverteilung führen können.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const e12 = [1.0,1.2,1.5,1.8,2.2,2.7,3.3,3.9,4.7,5.6,6.8,8.2];
    function nextE12(r: number): number {
      if (r <= 0) return 0;
      const exp = Math.floor(Math.log10(r));
      const base = Math.pow(10, exp);
      const norm = r / base;
      const found = e12.find(v => v >= norm - 0.001);
      if (found) return found * base;
      return 10 * base;
    }
    const colorCodes = ['Schwarz','Braun','Rot','Orange','Gelb','Grün','Blau','Violett','Grau','Weiß'];
    function resistorCode(r: number): string {
      if (r <= 0) return '–';
      const rounded = nextE12(r);
      const exp = Math.floor(Math.log10(rounded));
      const sig = Math.round(rounded / Math.pow(10, exp - 1));
      const d1 = Math.floor(sig / 10);
      const d2 = sig % 10;
      const mult = exp - 1;
      if (mult < 0 || d1 > 9 || d2 > 9) return '–';
      return colorCodes[d1] + ' / ' + colorCodes[d2] + ' / ' + (mult >= 0 ? colorCodes[mult] : '–') + ' / Gold (±5 %)';
    }
    function calcLWR() {
      const colorSel = (document.getElementById('lwr-color') as HTMLSelectElement).value;
      const vfInput = document.getElementById('lwr-vf') as HTMLInputElement;
      if (colorSel !== '0') vfInput.value = colorSel;
      const vs = parseFloat((document.getElementById('lwr-vs') as HTMLInputElement).value) || 0;
      const vf = parseFloat(vfInput.value) || 0;
      const ifMa = parseFloat((document.getElementById('lwr-if') as HTMLInputElement).value) || 20;
      const num = parseInt((document.getElementById('lwr-num') as HTMLInputElement).value) || 1;
      const ifA = ifMa / 1000;
      const vDrop = vs - num * vf;
      const r = vDrop > 0 ? vDrop / ifA : 0;
      const powerMw = vDrop > 0 ? vDrop * ifA * 1000 : 0;
      const pRating = powerMw / 1000 < 0.125 ? 0.25 : powerMw / 1000 < 0.25 ? 0.5 : powerMw / 1000 < 0.5 ? 1.0 : 2.0;
      const e12Val = nextE12(r);
      document.getElementById('lwr-r')!.textContent = r.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 1 }) + ' \u03A9';
      document.getElementById('lwr-e12')!.textContent = e12Val.toLocaleString('de-DE') + ' \u03A9';
      document.getElementById('lwr-power')!.textContent = powerMw.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 1 }) + ' mW';
      document.getElementById('lwr-prating')!.textContent = pRating.toLocaleString('de-DE') + ' W';
      document.getElementById('lwr-colorcode')!.textContent = resistorCode(e12Val);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.lwr-in').forEach(el => { el.addEventListener('input', calcLWR); el.addEventListener('change', calcLWR); }); calcLWR(); }, 50);
  </script>
</CalculatorLayout>
