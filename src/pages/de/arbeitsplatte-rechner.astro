---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Arbeitsplatten-Rechner - Flaeche, Material & Kosten berechnen";
const description = "Berechnen Sie die Arbeitsplattenflaeche, Materialkosten und Kantenlaenge fuer Kuechen- oder Badezimmerprojekte.";
const relatedCalcs = [
  { name: "Quadratmeterrechner", url: "/de/quadratmeterrechner", description: "Flaeche berechnen." },
  { name: "Fliesenrechner", url: "/de/fliesen-rechner", description: "Fliesen berechnen." },
  { name: "Betonrechner", url: "/de/betonrechner", description: "Betonmenge." },
  { name: "Stuckleisten-Rechner", url: "/de/stuckleisten-rechner", description: "Stuckleisten." },
  { name: "Vorhang-Rechner", url: "/de/vorhang-rechner", description: "Vorhaenge." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Arbeitsplatten-Rechner" keywords="Arbeitsplatte Rechner, Kuechenarbeitsplatte, Arbeitsplatte Kosten, Granit, Quarz, Arbeitsplatte Flaeche" breadcrumbs={[{ name: "Arbeitsplatten-Rechner", url: "/de/arbeitsplatte-rechner" }]} lang="de" enSlug="countertop-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Arbeitsplatten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Material fuer Ihr Arbeitsplattenprojekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Abschnitte (bis zu 4)</h3>
          <div class="space-y-2" id="apl-sections">
            <div class="grid grid-cols-3 gap-2 items-center">
              <div><label class="block text-xs text-text-muted">Laenge (cm)</label><input type="number" class="apl-len w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="240" step="1"></div>
              <div><label class="block text-xs text-text-muted">Tiefe (cm)</label><input type="number" class="apl-dep w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="60" step="1"></div>
              <div class="text-xs font-mono text-text-muted pt-4 apl-sf"></div>
            </div>
            <div class="grid grid-cols-3 gap-2 items-center">
              <div><input type="number" class="apl-len w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="120" step="1"></div>
              <div><input type="number" class="apl-dep w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="60" step="1"></div>
              <div class="text-xs font-mono text-text-muted apl-sf"></div>
            </div>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Material</label>
          <select id="apl-mat" class="apl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="80">Laminat (80 EUR/m2)</option>
            <option value="200" selected>Granit (200 EUR/m2)</option>
            <option value="300">Quarz (300 EUR/m2)</option>
            <option value="400">Marmor (400 EUR/m2)</option>
            <option value="350">Keramik (350 EUR/m2)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtflaeche</div>
          <div class="text-5xl font-extrabold font-mono" id="apl-result">0 m2</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten</div><div class="text-lg font-bold font-mono" id="apl-matcost">0 EUR</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einbau (~100 EUR/m2)</div><div class="text-lg font-bold font-mono" id="apl-install">0 EUR</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt gesch.</div><div class="text-lg font-bold font-mono" id="apl-total">0 EUR</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kantenlaenge</div><div class="text-xl font-bold font-mono" id="apl-edge">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Platten (gesch.)</div><div class="text-xl font-bold font-mono" id="apl-slab">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="countertop" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Arbeitsplatten planen</h2>
      <p>Die richtige Berechnung der Arbeitsplattenflaeche ist entscheidend fuer ein gelungenes Kuechenprojekt. Messen Sie alle Abschnitte einzeln und addieren Sie die Flaechen. Vergessen Sie nicht, 10 % Verschnitt einzuplanen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Welches Material ist am besten?</strong> Granit und Quarz sind robust und pflegeleicht. Laminat ist die guenstigste Option.</li>
        <li><strong>Wie viel kostet eine neue Arbeitsplatte?</strong> Je nach Material zwischen 80 und 400 EUR pro Quadratmeter, plus Einbaukosten.</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcAPL() {
      const lengths = document.querySelectorAll('.apl-len');
      const depths = document.querySelectorAll('.apl-dep');
      const sfLabels = document.querySelectorAll('.apl-sf');
      const matCost = parseFloat((document.getElementById('apl-mat') as HTMLSelectElement).value);
      let totalM2 = 0;
      let totalEdge = 0;
      lengths.forEach((el, i) => {
        const l = parseFloat((el as HTMLInputElement).value) || 0;
        const d = parseFloat((depths[i] as HTMLInputElement).value) || 0;
        const m2 = (l * d) / 10000;
        totalM2 += m2;
        totalEdge += l;
        if (sfLabels[i]) sfLabels[i].textContent = m2.toFixed(2) + ' m\u00B2';
      });
      const materialTotal = totalM2 * matCost;
      const installTotal = totalM2 * 100;
      const slabCount = Math.ceil(totalM2 / 3);
      document.getElementById('apl-result')!.textContent = totalM2.toFixed(2) + ' m\u00B2';
      document.getElementById('apl-matcost')!.textContent = Math.round(materialTotal).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('apl-install')!.textContent = Math.round(installTotal).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('apl-total')!.textContent = Math.round(materialTotal + installTotal).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('apl-edge')!.textContent = (totalEdge / 100).toFixed(1).replace('.', ',') + ' m';
      document.getElementById('apl-slab')!.textContent = slabCount + (slabCount === 1 ? ' Platte' : ' Platten');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.apl-len, .apl-dep, .apl-in').forEach(el => { el.addEventListener('input', calcAPL); el.addEventListener('change', calcAPL); });
      calcAPL();
    }, 50);
  </script>
</CalculatorLayout>
