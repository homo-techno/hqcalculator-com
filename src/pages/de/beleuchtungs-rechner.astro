---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Beleuchtungsrechner – Leuchten & Lumen für Räume berechnen";
const description = "Berechnen Sie die benötigte Anzahl von Leuchten und den Gesamtlichtstrom für optimale Raumbeleuchtung nach DIN EN 12464.";
const relatedCalcs = [
  { name: "Lichtintensität Rechner", url: "/de/lichtintensitaet-rechner", description: "Lux & Lumen." },
  { name: "Lichtlaufzeit Rechner", url: "/de/lichtlaufzeit-rechner", description: "Lichtgeschwindigkeit." },
  { name: "Nivellierrechner", url: "/de/nivellier-rechner", description: "Bodennivellierung." },
  { name: "Tragwand Rechner", url: "/de/tragwand-rechner", description: "Raumplanung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="lighting-calculator" calculatorName="Beleuchtungsrechner" keywords="Beleuchtungsrechner, Leuchten berechnen, Lumen Raum, Lux DIN, Raumbeleuchtung planen" breadcrumbs={[{ name: "Beleuchtungsrechner", url: "/de/beleuchtungs-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Beleuchtungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Raumbeleuchtung: Ermitteln Sie Leuchtenanzahl und Gesamtlichtstrom nach DIN EN 12464.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Raumlänge (m)</label>
            <input type="number" id="bel-l" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" step="0.1" min="0.1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Raumbreite (m)</label>
            <input type="number" id="bel-b" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" step="0.1" min="0.1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Raumnutzung (Sollbeleuchtungsstärke)</label>
          <select id="bel-nutzung" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="100">Flur / Gang (100 lx)</option>
            <option value="200">Wohnzimmer (200 lx)</option>
            <option value="300" selected>Küche / Bad (300 lx)</option>
            <option value="500">Büro / Arbeitsraum (500 lx)</option>
            <option value="750">Feinarbeitsplatz (750 lx)</option>
            <option value="1000">Zeichenbüro (1000 lx)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Lichtstrom je Leuchte (lm)</label>
            <input type="number" id="bel-lm" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="800" step="50" min="100">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Raumwirkungsgrad (%)</label>
            <input type="number" id="bel-wirkung" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" step="5" min="10" max="100">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Leuchten</div>
          <div class="text-5xl font-extrabold font-mono" id="bel-result">0 Stk.</div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="bel-details"></div>
      </div>
      <ShareButton lang="de" calculatorId="beleuchtung" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Raumbeleuchtung nach DIN EN 12464 planen</h2>
      <p>Die Norm DIN EN 12464 definiert Mindestbeleuchtungsstärken für verschiedene Arbeitsbereiche. Die benötigte Leuchtenzahl ergibt sich aus der Formel: N = (E × A) / (η × Φ), wobei E die Sollbeleuchtungsstärke in Lux, A die Raumfläche, η der Raumwirkungsgrad und Φ der Lichtstrom je Leuchte ist. Ein Sicherheitsfaktor (Wartungswert) von 10–20 % wird empfohlen.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Raumwirkungsgrad?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der Raumwirkungsgrad (η) gibt an, wie viel des abgestrahlten Lichts tatsächlich als nutzbare Beleuchtung auf der Arbeitsfläche ankommt. Er berücksichtigt Reflexion von Wänden, Decke und Boden. Typische Werte: 0,5–0,7 (50–70 %).</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Welche Beleuchtungsstärke braucht ein Büro?</summary>
          <p class="mt-2 text-sm text-text-secondary">Für Büroarbeitsplätze schreibt DIN EN 12464-1 eine mittlere Beleuchtungsstärke von 500 lx auf der Arbeitsfläche vor. Bildschirmarbeitsplätze können mit 300–500 lx auskommen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viele Lumen hat eine normale LED-Lampe?</summary>
          <p class="mt-2 text-sm text-text-secondary">Standard-LED-Lampen (E27, 9W) haben ca. 800 lm, was einer 60-Watt-Glühbirne entspricht. LED-Panels für Deckenleuchten liefern oft 1.500–4.000 lm pro Leuchte.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Soll ich Direktlicht oder indirekte Beleuchtung wählen?</summary>
          <p class="mt-2 text-sm text-text-secondary">Direktstrahler (nach unten) sind effizienter für Arbeitsplatzbeleuchung. Indirekte Beleuchtung (über Decke) erzeugt angenehmeres, blendfreies Licht für Wohnbereiche, braucht aber mehr Lumen gesamt.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBel() {
      const l = parseFloat((document.getElementById('bel-l') as HTMLInputElement).value) || 0;
      const b = parseFloat((document.getElementById('bel-b') as HTMLInputElement).value) || 0;
      const E = parseFloat((document.getElementById('bel-nutzung') as HTMLSelectElement).value) || 300;
      const lmPro = parseFloat((document.getElementById('bel-lm') as HTMLInputElement).value) || 800;
      const eta = parseFloat((document.getElementById('bel-wirkung') as HTMLInputElement).value) / 100 || 0.6;

      const flaeche = l * b;
      const gesamtLm = (E * flaeche) / eta;
      const anzahl = Math.ceil(gesamtLm / lmPro);
      const tatsLux = (anzahl * lmPro * eta) / flaeche;
      const leistungGes = anzahl * 9; // Schätzung: 9W LED = 800lm

      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('bel-result')!.textContent = anzahl + ' Stk.';
      document.getElementById('bel-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumfläche</div><div class="text-lg font-bold font-mono">${fmt(flaeche)} m²</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt-Lichtstrom</div><div class="text-lg font-bold font-mono">${fmt(gesamtLm)} lm</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erreichte Lux</div><div class="text-lg font-bold font-mono">${fmt(tatsLux)} lx</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtleistung (ca.)</div><div class="text-lg font-bold font-mono">${fmt(leistungGes)} W</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leistung pro m²</div><div class="text-lg font-bold font-mono">${fmt(leistungGes / flaeche)} W/m²</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sollwert</div><div class="text-lg font-bold font-mono">${E} lx</div></div>`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['bel-l','bel-b','bel-lm','bel-wirkung'].forEach(id => document.getElementById(id)!.addEventListener('input', calcBel));
      document.getElementById('bel-nutzung')!.addEventListener('change', calcBel);
      calcBel();
    }, 50);
  </script>
</CalculatorLayout>
