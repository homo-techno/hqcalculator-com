---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Eigenkapital Rechner - Immobilien-Eigenkapital berechnen 2026";
const description = "Berechne dein Immobilien-Eigenkapital, die Beleihungsquote (LTV) und wie das Eigenkapital mit der Zeit waechst. Kostenloser Eigenkapitalrechner.";

const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothekenrate berechnen." },
  { name: "Hauskauf-Leistbarkeit-Rechner", url: "/de/hauskauf-leistbarkeit-rechner", description: "Leistbarkeit pruefen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Kapitalwachstum." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Eigenkapital-Rechner" keywords="Eigenkapital Rechner, Beleihungsquote, LTV Ratio, Immobilien Eigenkapital, Hypothek Eigenkapital, Eigenkapital berechnen" breadcrumbs={[{ name: "Eigenkapital-Rechner", url: "/de/eigenkapital-rechner" }]} lang="de" enSlug="home-equity-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Eigenkapital-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sieh, wie viel Eigenkapital du in deiner Immobilie hast und wie deine Beleihungsquote ist.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Immobilienwert (€)</label><input type="number" id="ekp-value" class="ekp-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="400000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Restschuld Hypothek (€)</label><input type="number" id="ekp-balance" class="ekp-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="250000" min="0" step="1000"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Andere Lasten (€)</label><input type="number" id="ekp-liens" class="ekp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Jaehrl. Wertsteigerung (%)</label><input type="number" id="ekp-appr" class="ekp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="-10" max="20" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Eigenkapital</div>
          <div class="text-5xl font-extrabold font-mono" id="ekp-result">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beleihungsquote</div><div class="text-xl font-bold font-mono" id="ekp-ltv">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenkapital %</div><div class="text-xl font-bold font-mono" id="ekp-pct">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nachrang-Kredit moegl.</div><div class="text-xl font-bold font-mono" id="ekp-heloc">0 €</div></div>
        </div>
        <div class="p-4 rounded-xl text-center" id="ekp-status-box"><div class="font-bold text-sm" id="ekp-status">-</div></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Eigenkapitalprognose (5 Jahre)</h3>
          <div class="text-xs space-y-1" id="ekp-table"></div>
        </div>
      </div>

      <ShareButton calculatorId="home-equity" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist Immobilien-Eigenkapital?</h2>
      <p>Das Eigenkapital in einer Immobilie ist der Unterschied zwischen dem aktuellen Marktwert und den noch ausstehenden Schulden (Hypothek, Grundschuld). Es steigt durch Tilgung der Hypothek und Wertsteigerung der Immobilie.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist die Beleihungsquote (LTV)?</strong> Die Loan-to-Value-Quote zeigt, welcher Anteil des Immobilienwerts noch finanziert ist. Unter 80 % gelten als gut – darueber koennen Aufschlaege anfallen.</p>
      <p><strong>Wie kann ich Eigenkapital aufbauen?</strong> Durch Tilgung der Hypothek, Sondertilgungen und natuerliche Immobilienwertsteigerung. Modernisierungen koennen den Wert zusaetzlich erhoehen.</p>
      <p><strong>Was ist ein Nachrangkredit?</strong> Mit ausreichend Eigenkapital (mind. 15-20 % nach Kredit) koennen Eigentuemer einen Nachrangkredit aufnehmen, oft zu guenstigeren Konditionen als andere Darlehensformen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEKP() {
      const value = parseFloat((document.getElementById('ekp-value') as HTMLInputElement).value) || 0;
      const balance = parseFloat((document.getElementById('ekp-balance') as HTMLInputElement).value) || 0;
      const liens = parseFloat((document.getElementById('ekp-liens') as HTMLInputElement).value) || 0;
      const appr = parseFloat((document.getElementById('ekp-appr') as HTMLInputElement).value) / 100 || 0;

      const totalDebt = balance + liens;
      const equity = value - totalDebt;
      const ltv = value > 0 ? (totalDebt / value) * 100 : 0;
      const equityPct = value > 0 ? (equity / value) * 100 : 0;
      const helocAvail = Math.max(0, value * 0.85 - totalDebt);

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' €';
      document.getElementById('ekp-result')!.textContent = fmt(equity);
      document.getElementById('ekp-ltv')!.textContent = ltv.toFixed(1) + '%';
      document.getElementById('ekp-pct')!.textContent = equityPct.toFixed(1) + '%';
      document.getElementById('ekp-heloc')!.textContent = fmt(helocAvail);

      let status: string, color: string;
      if (ltv > 95) { status = 'Sehr hohe Beleihungsquote – wenig Eigenkapital'; color = 'bg-red-50 text-red-800'; }
      else if (ltv > 80) { status = 'Aufschlaege moeglich (LTV > 80 %)'; color = 'bg-yellow-50 text-yellow-800'; }
      else if (ltv > 60) { status = 'Gute Eigenkapitalposition'; color = 'bg-blue-50 text-blue-800'; }
      else { status = 'Starkes Eigenkapital – ausgezeichnete Position'; color = 'bg-green-50 text-green-800'; }
      document.getElementById('ekp-status')!.textContent = status;
      document.getElementById('ekp-status-box')!.className = 'p-4 rounded-xl text-center ' + color;

      const rows: string[] = [];
      for (let y = 1; y <= 5; y++) {
        const futureValue = value * Math.pow(1 + appr, y);
        const futureEquity = futureValue - totalDebt;
        rows.push('<div class="flex justify-between"><span>Jahr ' + y + ': Wert ' + fmt(futureValue) + '</span><span>Eigenkapital: ' + fmt(futureEquity) + '</span></div>');
      }
      document.getElementById('ekp-table')!.innerHTML = rows.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ekp-in').forEach(el => {
        el.addEventListener('input', calcEKP);
        el.addEventListener('change', calcEKP);
      });
      calcEKP();
    }, 50);
  </script>
</CalculatorLayout>
