---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Beute-Drop Rechner – Wahrscheinlichkeiten für Loot-Drops";
const description = "Berechnen Sie Wahrscheinlichkeiten für Beute-Drops in Spielen. Wie viele Versuche brauchen Sie für einen bestimmten Drop?";

const relatedCalcs = [
  { name: "Lotterie Gewinnchancen", url: "/de/lotterie-gewinnchancen-rechner", description: "Lotto-Wahrscheinlichkeiten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Statistik-Rechner", url: "/de/statistik-rechner", description: "Statistische Auswertungen." },
];
---
<CalculatorLayout lang="de" enSlug="loot-drop-calculator" title={title} description={description} calculatorName="Beute-Drop Rechner" keywords="Beute Drop Rechner, Loot Drop Wahrscheinlichkeit, Drop Rate Rechner, Gaming Chancen" breadcrumbs={[{ name: "Beute-Drop Rechner", url: "/de/beute-drop-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Beute-Drop Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Wahrscheinlichkeit, nach einer bestimmten Anzahl von Versuchen einen Beute-Drop zu erhalten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Drop-Rate (%)</label>
          <input type="number" id="bd-rate" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="1" step="0.01" min="0.001" max="100">
          <p class="text-xs text-text-muted mt-1">Beispiel: 1 % bedeutet 1 von 100 Versuchen im Durchschnitt</p>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Anzahl der Versuche</label>
          <input type="number" id="bd-tries" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="100" step="1" min="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wahrscheinlichkeit mindestens 1 Drop</div>
          <div class="text-5xl font-extrabold font-mono" id="bd-result">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ø Versuche bis Drop</div>
            <div class="text-xl font-bold font-mono" id="bd-avg">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Erw. Drops bei diesen Versuchen</div>
            <div class="text-xl font-bold font-mono" id="bd-expected">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Versuche für 50% Chance</div>
            <div class="text-xl font-bold font-mono" id="bd-v50">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Versuche für 90% Chance</div>
            <div class="text-xl font-bold font-mono" id="bd-v90">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="loot-drop" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie funktionieren Beute-Drop-Wahrscheinlichkeiten?</h2>
      <p>In vielen Online-Spielen wie World of Warcraft, Path of Exile oder Diablo haben Items eine festgelegte Drop-Rate. Diese gibt an, mit welcher Wahrscheinlichkeit ein Item pro Versuch fällt. Die Wahrscheinlichkeit, nach n Versuchen mindestens einmal erfolgreich zu sein, berechnet sich mit der geometrischen Verteilung: P = 1 − (1 − p)^n.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist eine Drop-Rate?</h3>
      <p>Die Drop-Rate ist die Wahrscheinlichkeit, dass ein bestimmtes Item bei einem Kill, einer Truhe oder einem anderen Spielereignis erscheint. Eine Drop-Rate von 0,1 % bedeutet, dass das Item im Durchschnitt einmal pro 1.000 Versuche fällt.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Warum bekomme ich trotz hoher Versuchszahl keinen Drop?</h3>
      <p>Auch mit vielen Versuchen gibt es keine Garantie. Die Wahrscheinlichkeit steigt mit jedem Versuch, aber nie auf 100 %. Dies nennt man den "Gambler's Fallacy" – vorherige Versuche beeinflussen zukünftige nicht.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was bedeutet "Pity-System"?</h3>
      <p>Manche Spiele implementieren ein Pity-System, das garantiert, dass nach einer bestimmten Anzahl von Versuchen ohne Drop der seltene Gegenstand automatisch erscheint.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie viele Versuche brauche ich für eine 99% Chance?</h3>
      <p>Das hängt von der Drop-Rate ab. Für eine Drop-Rate p brauchen Sie n = log(0,01) / log(1 − p) Versuche für eine 99%-Chance.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBD() {
      const rateRaw = parseFloat((document.getElementById('bd-rate') as HTMLInputElement).value) || 1;
      const tries = parseInt((document.getElementById('bd-tries') as HTMLInputElement).value) || 1;
      const p = Math.min(rateRaw / 100, 1);
      const prob = 1 - Math.pow(1 - p, tries);
      const avg = 1 / p;
      const expected = tries * p;
      const v50 = Math.ceil(Math.log(0.5) / Math.log(1 - p));
      const v90 = Math.ceil(Math.log(0.1) / Math.log(1 - p));
      document.getElementById('bd-result')!.textContent = (prob * 100).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
      document.getElementById('bd-avg')!.textContent = avg.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.getElementById('bd-expected')!.textContent = expected.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('bd-v50')!.textContent = v50.toLocaleString('de-DE');
      document.getElementById('bd-v90')!.textContent = v90.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('bd-rate')!.addEventListener('input', calcBD);
      document.getElementById('bd-tries')!.addEventListener('input', calcBD);
      calcBD();
    }, 50);
  </script>
</CalculatorLayout>
