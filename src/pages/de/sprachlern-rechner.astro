---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Sprachlernrechner";
const description = "Berechnen Sie Lernzeit und Fortschritt beim Erlernen neuer Sprachen.";

const relatedCalcs = [
  { name: "Lernkurvenrechner", url: "/de/lernkurven-rechner", description: "Lernkurven analysieren." },
  { name: "Lieferzeitrechner", url: "/de/lieferzeit-rechner", description: "Lieferzeiten berechnen." },
  { name: "Magermasse Rechner", url: "/de/magermasse-rechner", description: "Körperzusammensetzung." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Gewichtsziele planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Sprachlernrechner" lang="de" enSlug="language-learning-calculator" keywords="sprachlernrechner, sprachkurs dauer, lernzeit sprache, fremdsprache lernen" breadcrumbs={[{ name: "Sprachlernrechner", url: "/de/sprachlern-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Sprachlernrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie lange Sie für das Erreichen eines bestimmten Sprachniveaus benötigen und planen Sie Ihre Lernzeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zielsprache</label><select id="slr-lang" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="600">Englisch / Französisch / Spanisch</option>
            <option value="750">Russisch / Polnisch / Tschechisch</option>
            <option value="900">Arabisch / Japanisch</option>
            <option value="1100">Chinesisch (Mandarin)</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zielniveau (GER)</label><select id="slr-level" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.15">A1 – Anfänger</option>
            <option value="0.25">A2 – Grundkenntnisse</option>
            <option value="0.45" selected>B1 – Mittelstufe</option>
            <option value="0.65">B2 – Oberstufe</option>
            <option value="0.80">C1 – Fortgeschritten</option>
            <option value="1.0">C2 – Muttersprachlich</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Niveau (GER)</label><select id="slr-current" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0" selected>Keine Kenntnisse</option>
            <option value="0.15">A1</option>
            <option value="0.25">A2</option>
            <option value="0.45">B1</option>
            <option value="0.65">B2</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Lernstunden pro Tag</label><input type="number" id="slr-daily" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0.25" max="12" step="0.25"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Lernmethode</label><select id="slr-method" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="1.2">Selbststudium (App, Bücher)</option>
          <option value="1.0" selected>Sprachkurs (Gruppe)</option>
          <option value="0.8">Intensivkurs / Einzelunterricht</option>
          <option value="0.6">Immersion (Sprachland)</option>
        </select></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Lernzeit</div>
          <div class="text-4xl font-extrabold font-mono" id="slr-hours">0 Stunden</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wochen</div><div class="text-xl font-bold" id="slr-weeks">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monate</div><div class="text-xl font-bold" id="slr-months">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zieldatum</div><div class="text-xl font-bold" id="slr-date">–</div></div>
        </div>
      </div>
      <ShareButton calculatorId="language-learning-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Sprachen lernen – Zeitplanung nach dem GER</h2>
      <p>Der Gemeinsame Europäische Referenzrahmen (GER) teilt Sprachkenntnisse in sechs Niveaus von A1 bis C2 ein. Das US-amerikanische Foreign Service Institute (FSI) hat ermittelt, wie viele Unterrichtsstunden Englischsprachige für verschiedene Sprachen benötigen. Leicht verwandte Sprachen wie Spanisch oder Französisch erfordern ca. 600–750 Stunden bis B2, während komplexere Sprachen wie Japanisch oder Chinesisch 1.000 und mehr Stunden benötigen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange dauert es, fließend Englisch zu sprechen?</strong> Von null auf B2 benötigen die meisten Lernenden 600–800 Stunden. Bei 1 Stunde täglich sind das ca. 2 Jahre.</p>
      <p><strong>Was ist effektiver: App oder Sprachkurs?</strong> Beide haben Vor- und Nachteile. Apps sind flexibel und günstig, bieten aber wenig Sprechpraxis. Sprachkurse mit Muttersprachler-Interaktion beschleunigen das Lernen deutlich.</p>
      <p><strong>Was bedeuten die GER-Niveaus in der Praxis?</strong> A2: einfache Alltagsgespräche. B1: Reisesituationen meistern. B2: Studium und Beruf. C1: komplexe Themen flüssig diskutieren. C2: nahezu muttersprachliches Niveau.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSLR() {
      const totalHours = parseFloat((document.getElementById('slr-lang') as HTMLSelectElement).value) || 600;
      const targetPct = parseFloat((document.getElementById('slr-level') as HTMLSelectElement).value) || 0.45;
      const currentPct = parseFloat((document.getElementById('slr-current') as HTMLSelectElement).value) || 0;
      const daily = parseFloat((document.getElementById('slr-daily') as HTMLInputElement).value) || 1;
      const methodFactor = parseFloat((document.getElementById('slr-method') as HTMLSelectElement).value) || 1;
      const neededHours = Math.max(0, (targetPct - currentPct) * totalHours * methodFactor);
      const weeks = neededHours / (daily * 7);
      const months = weeks / 4.33;
      const targetDate = new Date();
      targetDate.setDate(targetDate.getDate() + Math.round(weeks * 7));
      const dateStr = targetDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'short', day: 'numeric' });
      document.getElementById('slr-hours')!.textContent = Math.round(neededHours).toLocaleString('de-DE') + ' Stunden';
      document.getElementById('slr-weeks')!.textContent = Math.ceil(weeks).toLocaleString('de-DE');
      document.getElementById('slr-months')!.textContent = Math.ceil(months).toLocaleString('de-DE');
      document.getElementById('slr-date')!.textContent = dateStr;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.slr-in').forEach(el => { el.addEventListener('input', calcSLR); el.addEventListener('change', calcSLR); }); calcSLR(); }, 50);
  </script>
</CalculatorLayout>
