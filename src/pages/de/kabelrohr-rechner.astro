---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kabelrohr-Rechner - Leitungsquerschnitt & Belegung nach VDE";
const description = "Berechnen Sie die Kabelrohr-Belegung anhand von Kabelanzahl und Querschnitt. Finden Sie die richtige Rohrgröße nach VDE-Richtlinien mit maximal 40% Füllung.";
const relatedCalcs = [
  { name: "Kabelquerschnitt-Rechner", url: "/de/kabelquerschnitt-rechner", description: "Kabelgrößen." },
  { name: "Ohmsches Gesetz", url: "/de/ohmsches-gesetz-rechner", description: "Spannung, Strom, Widerstand." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kabelrohr-Rechner" enSlug="conduit-fill-calculator" keywords="Kabelrohr Rechner, Kabelrohr Belegung, Leitungsverlegung, VDE Kabelrohr, Rohr Füllung, Installationsrohr" breadcrumbs={[{ name: "Kabelrohr-Rechner", url: "/de/kabelrohr-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kabelrohr-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Kabelrohr-Belegung und finden Sie die Mindestgröße des Installationsrohrs nach VDE-Vorschriften.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kabelquerschnitt (AWG)</label>
            <select id="cf2-awg" class="cf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="14" selected>14 AWG</option>
              <option value="12">12 AWG</option>
              <option value="10">10 AWG</option>
              <option value="8">8 AWG</option>
              <option value="6">6 AWG</option>
              <option value="4">4 AWG</option>
              <option value="2">2 AWG</option>
              <option value="1">1 AWG</option>
              <option value="0">1/0 AWG</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl der Kabel</label>
            <input type="number" id="cf2-count" class="cf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Isolationstyp</label>
            <select id="cf2-ins" class="cf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="THHN" selected>THHN/THWN</option>
              <option value="TW">TW</option>
              <option value="XHHW">XHHW</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Rohrtyp</label>
            <select id="cf2-conduit" class="cf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="EMT" selected>EMT</option>
              <option value="PVC40">PVC Schedule 40</option>
              <option value="PVC80">PVC Schedule 80</option>
              <option value="RMC">Stahlpanzerrohr (RMC)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mindest-Rohrgröße</div>
          <div class="text-5xl font-extrabold font-mono" id="cf2-result">-</div>
          <div class="text-sm text-blue-200 mt-1" id="cf2-fillpct">-</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="cf2-status-box">
          <div class="font-bold text-sm" id="cf2-status">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kabelfl. je Kabel</div>
            <div class="text-xl font-bold font-mono" id="cf2-wirearea">0 in²</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamte Kabelfläche</div>
            <div class="text-xl font-bold font-mono" id="cf2-totalarea">0 in²</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Max. Füllung</div>
            <div class="text-xl font-bold font-mono" id="cf2-maxfill">40%</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rohr-Optionen</h3>
          <div class="text-xs space-y-1" id="cf2-options"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="conduit-fill" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kabelrohr-Belegung berechnen</h2>
      <p>Die korrekte Dimensionierung von Kabelrohren ist entscheidend für eine sichere Elektroinstallation. Die maximale Belegung beträgt in der Regel 40% des Rohrquerschnitts bei drei oder mehr Kabeln. Dies gewährleistet ausreichend Platz zum Einziehen der Kabel und verhindert Überhitzung.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Warum nur 40% Füllung?</strong> Die Begrenzung auf 40% stellt sicher, dass Kabel ohne übermäßige Reibung eingezogen werden können und die Wärmeableitung gewährleistet ist.</p>
      <p><strong>Was passiert bei Überbelegung?</strong> Zu viele Kabel im Rohr führen zu erhöhter Wärmeentwicklung, erschwertem Einziehen und erhöhter Brandgefahr.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const CF2_WIRE_AREA: Record<string, Record<string, number>> = {
      'THHN': { '14': 0.0097, '12': 0.0133, '10': 0.0211, '8': 0.0366, '6': 0.0507, '4': 0.0824, '2': 0.1158, '1': 0.1562, '0': 0.1855 },
      'TW':   { '14': 0.0139, '12': 0.0181, '10': 0.0243, '8': 0.0437, '6': 0.0726, '4': 0.1087, '2': 0.1473, '1': 0.1901, '0': 0.2223 },
      'XHHW': { '14': 0.0097, '12': 0.0133, '10': 0.0211, '8': 0.0366, '6': 0.0507, '4': 0.0824, '2': 0.1158, '1': 0.1562, '0': 0.1855 },
    };
    const CF2_CONDUIT: Record<string, Record<string, number>> = {
      'EMT':   { '1/2': 0.304, '3/4': 0.533, '1': 0.864, '1-1/4': 1.496, '1-1/2': 2.036, '2': 3.356, '2-1/2': 5.858, '3': 8.846, '4': 15.68 },
      'PVC40': { '1/2': 0.285, '3/4': 0.508, '1': 0.832, '1-1/4': 1.453, '1-1/2': 1.986, '2': 3.291, '2-1/2': 5.453, '3': 8.091, '4': 14.57 },
      'PVC80': { '1/2': 0.217, '3/4': 0.409, '1': 0.688, '1-1/4': 1.237, '1-1/2': 1.711, '2': 2.874, '2-1/2': 4.695, '3': 7.268, '4': 13.20 },
      'RMC':   { '1/2': 0.314, '3/4': 0.533, '1': 0.864, '1-1/4': 1.496, '1-1/2': 2.036, '2': 3.356, '2-1/2': 5.858, '3': 8.846, '4': 15.68 },
    };
    const CF2_SIZES = ['1/2', '3/4', '1', '1-1/4', '1-1/2', '2', '2-1/2', '3', '4'];

    function calcCF2() {
      const awg = (document.getElementById('cf2-awg') as HTMLSelectElement).value;
      const count = parseInt((document.getElementById('cf2-count') as HTMLInputElement).value) || 1;
      const ins = (document.getElementById('cf2-ins') as HTMLSelectElement).value;
      const conduitType = (document.getElementById('cf2-conduit') as HTMLSelectElement).value;

      const wireArea = CF2_WIRE_AREA[ins]?.[awg] || 0.01;
      const totalArea = wireArea * count;
      const maxFillPct = count === 1 ? 0.53 : count === 2 ? 0.31 : 0.40;

      document.getElementById('cf2-wirearea')!.textContent = wireArea.toFixed(4) + ' in\u00B2';
      document.getElementById('cf2-totalarea')!.textContent = totalArea.toFixed(4) + ' in\u00B2';
      document.getElementById('cf2-maxfill')!.textContent = (maxFillPct * 100).toFixed(0) + '%';

      const conduitAreas = CF2_CONDUIT[conduitType];
      let minSize = '';
      let minFill = 0;
      let optionsHtml = '';

      for (const size of CF2_SIZES) {
        const cArea = conduitAreas[size];
        const allowable = cArea * maxFillPct;
        const fillPct = (totalArea / cArea) * 100;
        const fits = totalArea <= allowable;
        if (fits && !minSize) {
          minSize = size;
          minFill = fillPct;
        }
        const label = fits ? '<span class="text-green-600 font-bold">OK</span>' : '<span class="text-red-500">\u00DCber</span>';
        optionsHtml += '<div class="flex justify-between"><span>' + size + '" ' + conduitType + '</span><span>' + fillPct.toFixed(1) + '% F\u00FCllung &mdash; ' + label + '</span></div>';
      }

      document.getElementById('cf2-result')!.textContent = minSize ? minSize + '"' : 'N/A';
      document.getElementById('cf2-fillpct')!.textContent = minSize ? minFill.toFixed(1) + '% F\u00FCllung mit ' + count + ' x ' + awg + ' AWG ' + ins : 'Kein Standardrohr passt';
      document.getElementById('cf2-options')!.innerHTML = optionsHtml;

      let status: string, color: string;
      if (!minSize) {
        status = 'Kein Standardrohr passt \u2014 Kabelanzahl reduzieren oder Parallelverlegung nutzen';
        color = 'bg-red-50 text-red-800';
      } else if (minFill > 35) {
        status = 'Enge Belegung \u2014 n\u00E4chste Gr\u00F6\u00DFe f\u00FCr leichteres Einziehen empfohlen';
        color = 'bg-yellow-50 text-yellow-800';
      } else {
        status = minSize + '" ' + conduitType + ' erf\u00FCllt die Belegungsvorschriften';
        color = 'bg-green-50 text-green-800';
      }
      document.getElementById('cf2-status')!.textContent = status;
      document.getElementById('cf2-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.cf2-in').forEach(el => {
        el.addEventListener('input', calcCF2);
        el.addEventListener('change', calcCF2);
      });
      calcCF2();
    }, 50);
  </script>
</CalculatorLayout>
