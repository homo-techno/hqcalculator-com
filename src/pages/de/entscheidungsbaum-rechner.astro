---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Entscheidungsbaum-Rechner - Erwartungswert & Optimaler Pfad";
const description = "Erstellen Sie Entscheidungsbaeume mit Zufallsknoten und Ergebnissen. Berechnen Sie den Erwartungswert fuer jeden Pfad und finden Sie die optimale Entscheidung.";

const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Wahrscheinlichkeit." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Statistik-Rechner", url: "/de/statistik-rechner", description: "Statistik." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="decision-tree-calculator" calculatorName="Entscheidungsbaum-Rechner" keywords="entscheidungsbaum, erwartungswert, entscheidungsanalyse, zufallsknoten, optimale entscheidung, sensitivitaetsanalyse" breadcrumbs={[{ name: "Entscheidungsbaum-Rechner", url: "/de/entscheidungsbaum-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Entscheidungsbaum-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Entscheidungen mit unsicheren Ergebnissen. F&uuml;gen Sie Optionen mit Wahrscheinlichkeiten und Werten hinzu.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <h3 class="font-semibold text-text">Entscheidungsoptionen</h3>
          <button id="eb2-addopt" class="px-3 py-1 bg-primary text-white text-sm rounded-lg hover:bg-blue-700">+ Option hinzuf&uuml;gen</button>
        </div>

        <div id="eb2-options" class="space-y-6"></div>

        <div>
          <label class="block text-sm font-semibold text-text mb-1">Anfangskosten (gelten f&uuml;r alle Optionen)</label>
          <input type="number" class="eb2-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" id="eb2-cost" value="0" step="any">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Beste Entscheidung</div>
          <div class="text-3xl font-extrabold" id="eb2-best">--</div>
          <div class="text-sm text-blue-200 mt-1" id="eb2-bestev">--</div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Alle Optionen im Vergleich</h3>
          <div class="text-xs font-mono space-y-1" id="eb2-compare"></div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Sensitivit&auml;t: Wie weit m&uuml;sste sich die beste Option verschlechtern?</h3>
          <div class="text-sm text-text-secondary" id="eb2-sensitivity">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="decision-tree" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Entscheidungsbaumanalyse</h2>
      <p>Ein Entscheidungsbaum strukturiert komplexe Entscheidungen mit unsicheren Ergebnissen. Jede Option hat Zufallsknoten (Ergebnisse mit Wahrscheinlichkeiten und Werten). Der Erwartungswert jeder Option ist die Summe aus Wahrscheinlichkeit mal Wert &uuml;ber alle Ergebnisse.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Erwartungswert?</strong> Der gewichtete Durchschnitt aller m&ouml;glichen Ergebnisse, wobei die Gewichte die Wahrscheinlichkeiten sind.</p>
      <p><strong>M&uuml;ssen die Wahrscheinlichkeiten 100% ergeben?</strong> Ja, f&uuml;r eine korrekte Analyse sollten sich die Wahrscheinlichkeiten jeder Option zu 1,0 (100%) summieren.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    interface EBOutcome { prob: number; value: number; label: string; }
    interface EBOption { name: string; outcomes: EBOutcome[]; }

    let eb2Options: EBOption[] = [
      { name: 'Option A', outcomes: [
        { prob: 0.6, value: 500, label: 'Erfolg' },
        { prob: 0.4, value: -200, label: 'Misserfolg' }
      ]},
      { name: 'Option B', outcomes: [
        { prob: 0.3, value: 1000, label: 'Gro\u00dfer Gewinn' },
        { prob: 0.5, value: 100, label: 'Kleiner Gewinn' },
        { prob: 0.2, value: -500, label: 'Verlust' }
      ]}
    ];

    function renderEB2() {
      const container = document.getElementById('eb2-options')!;
      let html = '';
      for (let oi = 0; oi < eb2Options.length; oi++) {
        const opt = eb2Options[oi];
        html += '<div class="border border-border rounded-xl p-4 space-y-2">';
        html += '<div class="flex justify-between items-center"><input type="text" class="eb2-name font-semibold text-text bg-transparent border-b border-dashed border-border" data-oi="' + oi + '" value="' + opt.name + '">';
        html += '<div class="flex gap-1"><button class="eb2-addout px-2 py-1 bg-surface-alt text-xs rounded" data-oi="' + oi + '">+ Ergebnis</button>';
        if (eb2Options.length > 1) html += '<button class="eb2-delopt px-2 py-1 text-red-500 text-xs rounded" data-oi="' + oi + '">Entf.</button>';
        html += '</div></div>';
        for (let ci = 0; ci < opt.outcomes.length; ci++) {
          const o = opt.outcomes[ci];
          html += '<div class="grid grid-cols-[1fr_0.7fr_0.7fr_auto] gap-1 items-center">';
          html += '<input type="text" class="eb2-in px-2 py-1 border border-border rounded text-xs" data-oi="' + oi + '" data-ci="' + ci + '" data-f="label" value="' + o.label + '">';
          html += '<input type="number" class="eb2-in px-2 py-1 border border-border rounded text-xs text-center" data-oi="' + oi + '" data-ci="' + ci + '" data-f="prob" value="' + o.prob + '" min="0" max="1" step="0.01">';
          html += '<input type="number" class="eb2-in px-2 py-1 border border-border rounded text-xs text-center" data-oi="' + oi + '" data-ci="' + ci + '" data-f="value" value="' + o.value + '" step="any">';
          html += '<button class="eb2-delout text-red-400 text-xs px-1" data-oi="' + oi + '" data-ci="' + ci + '">x</button></div>';
        }
        html += '</div>';
      }
      container.innerHTML = html;

      container.querySelectorAll('.eb2-name').forEach(el => {
        el.addEventListener('input', (e) => {
          const t = e.target as HTMLInputElement;
          eb2Options[parseInt(t.dataset.oi || '0')].name = t.value;
          calcEB2();
        });
      });
      container.querySelectorAll('.eb2-in').forEach(el => {
        el.addEventListener('input', (e) => {
          const t = e.target as HTMLInputElement;
          const oi = parseInt(t.dataset.oi || '0');
          const ci = parseInt(t.dataset.ci || '0');
          const f = t.dataset.f as string;
          if (f === 'label') eb2Options[oi].outcomes[ci].label = t.value;
          else if (f === 'prob') eb2Options[oi].outcomes[ci].prob = parseFloat(t.value) || 0;
          else if (f === 'value') eb2Options[oi].outcomes[ci].value = parseFloat(t.value) || 0;
          calcEB2();
        });
      });
      container.querySelectorAll('.eb2-addout').forEach(el => {
        el.addEventListener('click', (e) => {
          const oi = parseInt((e.target as HTMLElement).dataset.oi || '0');
          eb2Options[oi].outcomes.push({ prob: 0, value: 0, label: 'Neu' });
          renderEB2(); calcEB2();
        });
      });
      container.querySelectorAll('.eb2-delout').forEach(el => {
        el.addEventListener('click', (e) => {
          const oi = parseInt((e.target as HTMLElement).dataset.oi || '0');
          const ci = parseInt((e.target as HTMLElement).dataset.ci || '0');
          if (eb2Options[oi].outcomes.length > 1) { eb2Options[oi].outcomes.splice(ci, 1); renderEB2(); calcEB2(); }
        });
      });
      container.querySelectorAll('.eb2-delopt').forEach(el => {
        el.addEventListener('click', (e) => {
          const oi = parseInt((e.target as HTMLElement).dataset.oi || '0');
          eb2Options.splice(oi, 1); renderEB2(); calcEB2();
        });
      });
    }

    function calcEB2() {
      const cost = parseFloat((document.getElementById('eb2-cost') as HTMLInputElement).value) || 0;
      const evs = eb2Options.map(opt => opt.outcomes.reduce((sum, o) => sum + o.prob * o.value, 0) - cost);
      const bestIdx = evs.indexOf(Math.max(...evs));

      const fmtEuro = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

      document.getElementById('eb2-best')!.textContent = eb2Options[bestIdx].name;
      document.getElementById('eb2-bestev')!.textContent = 'EW: ' + fmtEuro(evs[bestIdx]);

      let compareHtml = '';
      for (let i = 0; i < eb2Options.length; i++) {
        const marker = i === bestIdx ? ' font-bold text-primary' : '';
        const probSum = eb2Options[i].outcomes.reduce((s, o) => s + o.prob, 0);
        compareHtml += '<div class="flex justify-between py-0.5 border-b border-border' + marker + '"><span>' + eb2Options[i].name + '</span><span>EW: ' + fmtEuro(evs[i]) + ' (P-Summe: ' + probSum.toFixed(2).replace('.', ',') + ')' + (i === bestIdx ? ' BESTE' : '') + '</span></div>';
      }
      document.getElementById('eb2-compare')!.innerHTML = compareHtml;

      if (eb2Options.length >= 2) {
        const sorted = evs.map((ev, i) => ({ ev, i })).sort((a, b) => b.ev - a.ev);
        if (sorted.length >= 2) {
          const gap = sorted[0].ev - sorted[1].ev;
          document.getElementById('eb2-sensitivity')!.textContent =
            'Die beste Option (' + eb2Options[sorted[0].i].name + ') f\u00fchrt mit ' + fmtEuro(gap) +
            ' vor ' + eb2Options[sorted[1].i].name + '. ' +
            'Die Entscheidung w\u00fcrde sich \u00e4ndern, wenn der EW der besten Option um mehr als ' + fmtEuro(gap) + ' sinkt.';
        }
      }

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('eb2-addopt')!.addEventListener('click', () => {
        eb2Options.push({ name: 'Option ' + String.fromCharCode(65 + eb2Options.length), outcomes: [{ prob: 0.5, value: 0, label: 'Ergebnis' }] });
        renderEB2(); calcEB2();
      });
      document.getElementById('eb2-cost')!.addEventListener('input', calcEB2);
      renderEB2();
      calcEB2();
    }, 50);
  </script>
</CalculatorLayout>
