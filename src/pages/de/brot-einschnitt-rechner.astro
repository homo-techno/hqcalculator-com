---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Brot-G&auml;rzeit-Rechner - Gehzeit nach Temperatur sch&auml;tzen";
const description = "Sch&auml;tzen Sie die Geh- und Stockgarezeit Ihres Brotteigs basierend auf Teigtemperatur, Hefemenge und Anreicherungsgrad. Planen Sie Ihren Backplan.";
const relatedCalcs = [
  { name: "Sauerteig-Rechner", url: "/de/sauerteig-rechner", description: "Sauerteigverh&auml;ltnisse berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeitberechnungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Brot-G&auml;rzeit-Rechner" lang="de" enSlug="bread-scoring-calculator" keywords="brot g&auml;rzeit, stockgare, teigtemperatur, hefeg&auml;rung, gehzeit rechner" breadcrumbs={[{ name: "Brot-G&auml;rzeit-Rechner", url: "/de/brot-einschnitt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Brot-G&auml;rzeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Stockgare- und Stückgarezeiten basierend auf Teigtemperatur, Hefeanteil und Anreicherungsgrad.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Teigtemperatur (&deg;C)</label>
          <input type="number" id="bsc-temp" class="bsc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="50" step="1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hefe % (B&auml;ckerprozent)</label>
          <input type="number" id="bsc-yeast" class="bsc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" max="10" step="0.1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Teigart</label>
          <select id="bsc-type" class="bsc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="lean">Mager (Mehl, Wasser, Salz, Hefe)</option>
            <option value="slightly">Leicht angereichert (wenig Butter/Zucker)</option>
            <option value="enriched">Angereichert (Brioche, Zopf)</option>
            <option value="heavy">Stark angereichert (Panettone, Stollen)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Triebmittel</label>
          <select id="bsc-leaven" class="bsc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="commercial">Industriehefe</option>
            <option value="sourdough">Sauerteig</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Stockgare</div>
          <div class="text-5xl font-extrabold font-mono" id="bsc-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Stückgare</div>
            <div class="text-xl font-bold font-mono" id="bsc-proof">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kühlschrank (2-3&deg;C)</div>
            <div class="text-xl font-bold font-mono" id="bsc-fridge">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Temp (&deg;F)</div>
            <div class="text-xl font-bold font-mono" id="bsc-fahrenheit">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Tipp</div>
            <div class="text-sm font-bold" id="bsc-tip">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="bread-scoring" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Brot-G&auml;rzeit-Formeln</h2>
      <p>Die G&auml;rzeit h&auml;ngt von Temperatur, Hefemenge und Teiganreicherung ab. H&ouml;here Temperaturen beschleunigen die G&auml;rung, w&auml;hrend angereicherte Teige l&auml;nger brauchen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die ideale Teigtemperatur?</strong> F&uuml;r die meisten Brotteige liegt die ideale Temperatur zwischen 24-26&deg;C. Dies erm&ouml;glicht eine gleichm&auml;&szlig;ige G&auml;rung mit guter Geschmacksentwicklung.</p>
      <p><strong>Wie kann ich die Gehzeit verk&uuml;rzen?</strong> Erh&ouml;hen Sie die Teigtemperatur oder die Hefemenge. Beachten Sie jedoch, dass eine l&auml;ngere G&auml;rung oft besseren Geschmack ergibt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBSC() {
      const tempC = parseFloat((document.getElementById('bsc-temp') as HTMLInputElement).value) || 24;
      const yeastPct = parseFloat((document.getElementById('bsc-yeast') as HTMLInputElement).value) || 1.0;
      const doughType = (document.getElementById('bsc-type') as HTMLSelectElement).value;
      const leaven = (document.getElementById('bsc-leaven') as HTMLSelectElement).value;
      const tempF = tempC * 9 / 5 + 32;

      const baseMins = 120;
      const tempFactor = Math.pow(2, (75 - tempF) / 15);
      const yeastFactor = 1.0 / yeastPct;
      const enrichFactors: Record<string, number> = { lean: 1.0, slightly: 1.3, enriched: 1.8, heavy: 2.5 };
      const enrichFactor = enrichFactors[doughType] || 1.0;
      const leavenFactor = leaven === 'sourdough' ? 2.0 : 1.0;

      const bulkMins = baseMins * tempFactor * yeastFactor * enrichFactor * leavenFactor;
      const proofMins = bulkMins * 0.55;
      const fridgeMins = bulkMins * 5;

      function formatTime(mins: number): string {
        if (mins < 60) return Math.round(mins) + ' Min';
        const h = Math.floor(mins / 60);
        const m = Math.round(mins % 60);
        if (m === 0) return h + ' Std';
        return h + ' Std ' + m + ' Min';
      }

      document.getElementById('bsc-result')!.textContent = formatTime(bulkMins);
      document.getElementById('bsc-proof')!.textContent = formatTime(proofMins);

      const fridgeHrs = fridgeMins / 60;
      if (fridgeHrs > 48) document.getElementById('bsc-fridge')!.textContent = '8-16 Std (\u00fcber Nacht)';
      else document.getElementById('bsc-fridge')!.textContent = formatTime(Math.min(fridgeMins, 960));

      document.getElementById('bsc-fahrenheit')!.textContent = tempF.toFixed(1) + '\u00B0F';

      let tip = '';
      if (tempF < 65) tip = 'Langsame Gare entwickelt mehr Geschmack. Ideal f\u00fcr \u00dcber-Nacht-G\u00e4rung.';
      else if (tempF < 78) tip = 'Idealer Bereich f\u00fcr die meisten Brotteige.';
      else if (tempF < 85) tip = 'Schnelle Gare. Vorsicht vor \u00dcberg\u00e4rung.';
      else tip = 'Sehr schnell. Risiko von \u00dcberg\u00e4rung und Fehlaromen.';
      document.getElementById('bsc-tip')!.textContent = tip;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bsc-temp') as HTMLInputElement).value = '24';
      (document.getElementById('bsc-yeast') as HTMLInputElement).value = '1.0';
      document.querySelectorAll('.bsc-in').forEach(el => { el.addEventListener('input', calcBSC); el.addEventListener('change', calcBSC); });
      calcBSC();
    }, 50);
  </script>
</CalculatorLayout>
