---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "R\u00e4umungskosten-Rechner - Kosten einer Mieterr\u00e4umung";
const description = "Berechnen Sie die Gesamtkosten einer Mieterr\u00e4umung inkl. Anwaltskosten, Gerichtskosten, Mietausfall und Renovierung, mit Vergleich zu Alternativen.";

const relatedCalcs = [
  { name: "Mietobjekt-Rechner", url: "/de/mietobjekt-rechner", description: "Mietobjekt-ROI." },
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow-Analyse." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Miete-vs-Kauf-Rechner", url: "/de/miete-vs-kauf-rechner", description: "Mieten vs. Kaufen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="R\u00e4umungskosten-Rechner" lang="de" enSlug="eviction-cost-calculator" keywords="raeumungskosten, mieterraeumung kosten, anwaltskosten raeumung, mietausfall, raeumungsklage" breadcrumbs={[{ name: "R\u00e4umungskosten-Rechner", url: "/de/raeumungskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">R&auml;umungskosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Gesamtkosten einer R&auml;umung und vergleichen Sie mit Alternativen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Monatliche Miete (&euro;)</label><input type="number" id="rkr-rent" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="900" min="0" step="50"></div>
        <h3 class="font-semibold text-sm text-text">Rechts- &amp; Gerichtskosten</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anwaltskosten (&euro;)</label><input type="number" id="rkr-attorney" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gerichtskosten (&euro;)</label><input type="number" id="rkr-court" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" step="50"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Gerichtsvollzieher (&euro;)</label><input type="number" id="rkr-process" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" step="50"></div>
        <h3 class="font-semibold text-sm text-text">Einkommensverlust &amp; Renovierung</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Monate Mietausfall</label><input type="number" id="rkr-lostmonths" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0" max="24" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Renovierung / Instandsetzung (&euro;)</label><input type="number" id="rkr-repair" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="0" step="250"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Leerstand danach (Monate)</label><input type="number" id="rkr-vacancy" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" max="6" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Aufhebungsvereinbarung (&euro;)</label><input type="number" id="rkr-cashkeys" class="rkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="0" step="250"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte R&auml;umungskosten</div>
          <div class="text-5xl font-extrabold font-mono" id="rkr-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rechtskosten</div><div class="text-xl font-bold font-mono" id="rkr-legal">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mietausfall</div><div class="text-xl font-bold font-mono" id="rkr-lostrent">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Renovierungskosten</div><div class="text-xl font-bold font-mono" id="rkr-turnover">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Dauer</div><div class="text-xl font-bold font-mono" id="rkr-timeline">-- Wochen</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufhebungsvereinbarung ges.</div><div class="text-xl font-bold font-mono" id="rkr-cfktotal">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ersparnis vs. R&auml;umung</div><div class="text-xl font-bold font-mono" id="rkr-cfksavings">0 &euro;</div></div>
        </div>
        <div class="p-4 rounded-xl text-center" id="rkr-status-box"><div class="font-bold text-sm" id="rkr-status">-</div></div>
      </div>
      <ShareButton calculatorId="eviction-cost-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">R&auml;umungskosten in Deutschland</h2>
      <p>Eine R&auml;umungsklage in Deutschland dauert oft 6-12 Monate. Die Kosten umfassen Anwalt, Gericht, Gerichtsvollzieher, Mietausfall und Renovierung. Eine Aufhebungsvereinbarung ist oft die kosteng&uuml;nstigere Alternative.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie lange dauert eine R&auml;umung?</strong> In Deutschland kann eine R&auml;umungsklage 6-12 Monate oder l&auml;nger dauern, je nach Gericht und Umst&auml;nden.</p>
      <p><strong>Was ist eine Aufhebungsvereinbarung?</strong> Eine einvernehmliche L&ouml;sung, bei der dem Mieter eine Abfindung f&uuml;r den freiwilligen Auszug gezahlt wird.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcRKR() {
      const rent = parseFloat((document.getElementById('rkr-rent') as HTMLInputElement).value) || 0;
      const attorney = parseFloat((document.getElementById('rkr-attorney') as HTMLInputElement).value) || 0;
      const court = parseFloat((document.getElementById('rkr-court') as HTMLInputElement).value) || 0;
      const process = parseFloat((document.getElementById('rkr-process') as HTMLInputElement).value) || 0;
      const lostMonths = parseFloat((document.getElementById('rkr-lostmonths') as HTMLInputElement).value) || 0;
      const repair = parseFloat((document.getElementById('rkr-repair') as HTMLInputElement).value) || 0;
      const vacancy = parseFloat((document.getElementById('rkr-vacancy') as HTMLInputElement).value) || 0;
      const cashKeys = parseFloat((document.getElementById('rkr-cashkeys') as HTMLInputElement).value) || 0;

      const legalCosts = attorney + court + process;
      const lostRent = rent * lostMonths;
      const vacancyLoss = rent * vacancy;
      const turnoverCosts = repair + vacancyLoss;
      const totalEviction = legalCosts + lostRent + turnoverCosts;

      const cfkLostRent = rent * 1;
      const cfkTotal = cashKeys + cfkLostRent + repair * 0.5;
      const cfkSavings = totalEviction - cfkTotal;

      const timelineWeeks = Math.round((lostMonths * 4.3) + 4);

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';

      document.getElementById('rkr-total')!.textContent = fmt(totalEviction);
      document.getElementById('rkr-legal')!.textContent = fmt(legalCosts);
      document.getElementById('rkr-lostrent')!.textContent = fmt(lostRent);
      document.getElementById('rkr-turnover')!.textContent = fmt(turnoverCosts);
      document.getElementById('rkr-timeline')!.textContent = timelineWeeks + ' Wochen';
      document.getElementById('rkr-cfktotal')!.textContent = fmt(cfkTotal);
      document.getElementById('rkr-cfksavings')!.textContent = fmt(cfkSavings);

      let status: string, color: string;
      if (cfkSavings > totalEviction * 0.3) { status = 'Aufhebungsvereinbarung empfohlen \u2014 deutliche Ersparnis'; color = 'bg-green-50 text-green-800'; }
      else if (cfkSavings > 0) { status = 'Aufhebungsvereinbarung spart Geld und Zeit'; color = 'bg-blue-50 text-blue-800'; }
      else { status = 'R\u00E4umungsklage kann kosteneffektiver sein'; color = 'bg-yellow-50 text-yellow-800'; }

      document.getElementById('rkr-status')!.textContent = status;
      document.getElementById('rkr-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.rkr-in').forEach(el => { el.addEventListener('input', calcRKR); el.addEventListener('change', calcRKR); });
      calcRKR();
    }, 50);
  </script>
</CalculatorLayout>
