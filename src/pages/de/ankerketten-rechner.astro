---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ankerkettenrechner - Kettenlänge & Scope-Verhältnis";
const description = "Berechnen Sie Ankerketten- und Vorleinenlänge aus Wassertiefe, Scope-Verhältnis und Bedingungen. Bestimmen Sie die richtige Ankerausrüstung für Wind und Strömung.";
const relatedCalcs = [
  { name: "Bootkredit", url: "/boat-loan-calculator", description: "Bootsfinanzierung." },
  { name: "Seemeile", url: "/nautical-mile-calculator", description: "Nautische Entfernung." },
  { name: "Gezeitenrechner", url: "/tide-calculator", description: "Gezeitenvorhersage." },
  { name: "Peilungsrechner", url: "/bearing-calculator", description: "Navigationspeilungen." },
  { name: "Großkreis", url: "/great-circle-calculator", description: "Großkreis-Navigation." },
  { name: "Auftrieb", url: "/buoyancy-calculator", description: "Auftriebskraft." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Ankerkettenrechner" keywords="Ankerkettenrechner, Vorleinenlänge, Scope-Verhältnis, Ankern, Ankerkette, Boot ankern" breadcrumbs={[{ name: "Ankerkette", url: "/de/ankerketten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ankerkettenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die richtige Ankerketten- und Vorleinenlänge basierend auf Tiefe, Bedingungen und Scope-Verhältnis für sicheres Ankern.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wassertiefe (m)</label><input type="number" id="an2-depth" class="an2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.5" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tidenhub (m)</label><input type="number" id="an2-tide" class="an2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bughöhe (m)</label><input type="number" id="an2-bow" class="an2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.3" step="0.1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Scope-Verhältnis</label>
            <select id="an2-scope" class="an2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="5">5:1 (Ruhig, nur Kette)</option>
              <option value="7" selected>7:1 (Normale Bedingungen)</option>
              <option value="8">8:1 (Mäßiger Wind)</option>
              <option value="10">10:1 (Sturm/starke Strömung)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Vorleinentyp</label>
            <select id="an2-rode" class="an2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="chain">Nur Kette</option>
              <option value="combo">Kette + Leine</option>
              <option value="rope">Nur Leine</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Bootslänge (m)</label><input type="number" id="an2-boat" class="an2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="3" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Vorleinenlänge</div>
          <div class="text-5xl font-extrabold font-mono" id="an2-total">--</div>
          <div class="text-sm text-blue-200 mt-1">Meter</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Tiefe</div><div class="text-xl font-bold" id="an2-maxd">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kettenlänge</div><div class="text-xl font-bold" id="an2-chain">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leinenlänge</div><div class="text-xl font-bold" id="an2-rope">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schwojkreis</div><div class="text-xl font-bold" id="an2-swing">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Haltebewertung</div><div class="text-xl font-bold" id="an2-rating">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="anchor-chain" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAN2() {
      const depth = parseFloat((document.getElementById('an2-depth') as HTMLInputElement).value) || 0;
      const tide = parseFloat((document.getElementById('an2-tide') as HTMLInputElement).value) || 0;
      const bow = parseFloat((document.getElementById('an2-bow') as HTMLInputElement).value) || 0;
      const scope = parseFloat((document.getElementById('an2-scope') as HTMLSelectElement).value) || 7;
      const rodeType = (document.getElementById('an2-rode') as HTMLSelectElement).value;
      const boat = parseFloat((document.getElementById('an2-boat') as HTMLInputElement).value) || 0;

      const maxDepth = depth + tide;
      const totalHeight = maxDepth + bow;
      const totalRode = totalHeight * scope;

      let chainLen = 0;
      let ropeLen = 0;
      if (rodeType === 'chain') {
        chainLen = totalRode;
        ropeLen = 0;
      } else if (rodeType === 'combo') {
        chainLen = Math.max(maxDepth, boat, 6);
        ropeLen = totalRode - chainLen;
        if (ropeLen < 0) ropeLen = 0;
      } else {
        chainLen = 0;
        ropeLen = totalRode;
      }

      const swingRadius = totalRode + boat;

      let rating = 'Schlecht';
      if (scope >= 10) rating = 'Ausgezeichnet';
      else if (scope >= 8) rating = 'Sehr gut';
      else if (scope >= 7) rating = 'Gut';
      else if (scope >= 5) rating = rodeType === 'chain' ? 'Gut' : 'Mäßig';

      const fmtM = (v: number) => v.toFixed(1).replace('.', ',') + ' m';

      document.getElementById('an2-total')!.textContent = totalRode > 0 ? Math.ceil(totalRode).toString() : '--';
      document.getElementById('an2-maxd')!.textContent = maxDepth > 0 ? fmtM(maxDepth) : '--';
      document.getElementById('an2-chain')!.textContent = chainLen > 0 ? Math.ceil(chainLen) + ' m' : '--';
      document.getElementById('an2-rope')!.textContent = ropeLen > 0 ? Math.ceil(ropeLen) + ' m' : 'N/A';
      document.getElementById('an2-swing')!.textContent = swingRadius > 0 ? Math.ceil(swingRadius) + ' m' : '--';
      document.getElementById('an2-rating')!.textContent = rating;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('an2-depth') as HTMLInputElement).value = '5';
      (document.getElementById('an2-tide') as HTMLInputElement).value = '1.2';
      (document.getElementById('an2-bow') as HTMLInputElement).value = '1.5';
      (document.getElementById('an2-boat') as HTMLInputElement).value = '10';
      document.querySelectorAll('.an2-in').forEach(el => { el.addEventListener('input', calcAN2); el.addEventListener('change', calcAN2); });
      calcAN2();
    }, 50);
  </script>
</CalculatorLayout>
