---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Stickgarn-Rechner - Garnl\u00e4nge & Abdeckung";
const description = "Berechnen Sie die ben\u00f6tigte Stickgarnl\u00e4nge anhand von Stichanzahl, Fadenzahl und Designfl\u00e4che f\u00fcr Hand- und Maschinenstickerei.";
const relatedCalcs = [
  { name: "Umschlag-Rechner", url: "/de/umschlag-rechner", description: "Umschlaggr\u00f6\u00dfen." },
  { name: "Epoxidharz-Rechner", url: "/de/epoxidharz-rechner", description: "Mischverh\u00e4ltnisse." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
  { name: "Erosion-Rechner", url: "/de/erosion-rechner", description: "Bodenerosion." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Stickgarn-Rechner" lang="de" enSlug="embroidery-thread-calculator" keywords="stickgarn rechner, stichanzahl, garnl\u00e4nge, stickgarn bedarf, kreuzstich rechner" breadcrumbs={[{ name: "Stickgarn-Rechner", url: "/de/stickgarn-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stickgarn-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Garnl&auml;nge, Str&auml;nge und Abdeckung f&uuml;r Hand- oder Maschinenstickerei-Projekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Stichart</label>
          <select id="sgr-stitch" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="cross" selected>Kreuzstich</option>
            <option value="back">R&uuml;ckstich</option>
            <option value="satin">Plattstich</option>
            <option value="french">Franz&ouml;sischer Knoten</option>
            <option value="chain">Kettenstich</option>
            <option value="stem">Stielstich</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Designbreite (cm)</label><input type="number" id="sgr-w" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Designh&ouml;he (cm)</label><input type="number" id="sgr-h" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="1" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Stoffz&auml;hlung (ct)</label>
            <select id="sgr-ct" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="11">11 count Aida</option>
              <option value="14" selected>14 count Aida</option>
              <option value="16">16 count Aida</option>
              <option value="18">18 count Aida</option>
              <option value="28">28 count Evenweave</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Verwendete F&auml;den</label><input type="number" id="sgr-strands" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="6" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Abdeckung (%)</label><input type="number" id="sgr-cov" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="1" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Farben</label><input type="number" id="sgr-colors" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="100" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtgarn ben&ouml;tigt</div>
          <div class="text-4xl font-extrabold font-mono" id="sgr-result">0 m</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtstiche</div><div class="text-xl font-bold font-mono" id="sgr-stitches">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Str&auml;nge (8m)</div><div class="text-xl font-bold font-mono" id="sgr-skeins">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Farbe</div><div class="text-xl font-bold font-mono" id="sgr-percolor">0 m</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Garn (Meter)</div><div class="text-xl font-bold font-mono" id="sgr-meters">0 m</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Designfl&auml;che</div><div class="text-xl font-bold font-mono" id="sgr-area">0 cm&sup2;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="embroidery-thread-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Stickgarn berechnen</h2>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel Garn brauche ich pro Kreuzstich?</strong> Auf 14ct Aida mit 2 F&auml;den ben&ouml;tigen Sie ca. 2,5 cm Garn pro Stich plus Verschnitt.</p>
      <p><strong>Was ist der Unterschied zwischen Aida und Evenweave?</strong> Evenweave wird &uuml;ber 2 F&auml;den gestickt, daher halbiert sich die effektive Z&auml;hlung.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcSGR() {
      const stitch = (document.getElementById('sgr-stitch') as HTMLSelectElement).value;
      const dw = parseFloat((document.getElementById('sgr-w') as HTMLInputElement).value) || 15;
      const dh = parseFloat((document.getElementById('sgr-h') as HTMLInputElement).value) || 15;
      const ct = parseInt((document.getElementById('sgr-ct') as HTMLSelectElement).value) || 14;
      const strands = parseInt((document.getElementById('sgr-strands') as HTMLInputElement).value) || 2;
      const coverage = parseFloat((document.getElementById('sgr-cov') as HTMLInputElement).value) || 60;
      const colors = parseInt((document.getElementById('sgr-colors') as HTMLInputElement).value) || 1;

      const dwIn = dw / 2.54;
      const dhIn = dh / 2.54;
      const effectiveCt = ct >= 28 ? ct / 2 : ct;
      const stitchesWide = Math.round(dwIn * effectiveCt);
      const stitchesHigh = Math.round(dhIn * effectiveCt);
      const totalPossible = stitchesWide * stitchesHigh;
      const totalStitches = Math.round(totalPossible * (coverage / 100));

      const inchPerStitch: Record<string, number> = {
        cross: 1.0 / effectiveCt * 14,
        back: 0.7 / effectiveCt * 14,
        satin: 1.3 / effectiveCt * 14,
        french: 0.8 / effectiveCt * 14,
        chain: 1.1 / effectiveCt * 14,
        stem: 0.9 / effectiveCt * 14
      };

      const ips = inchPerStitch[stitch] || 1.0;
      const threadPerStitch = ips + 0.1;
      const totalInches = totalStitches * threadPerStitch * strands;
      const totalWithWaste = totalInches * 1.15;
      const totalYards = totalWithWaste / 36;
      const totalMeters = totalYards * 0.9144;
      const skeins = Math.ceil(totalMeters / 8);
      const perColorM = totalMeters / colors;
      const designArea = dw * dh;

      document.getElementById('sgr-result')!.textContent = totalMeters.toFixed(0) + ' m';
      document.getElementById('sgr-stitches')!.textContent = totalStitches.toLocaleString('de-DE');
      document.getElementById('sgr-skeins')!.textContent = skeins.toString();
      document.getElementById('sgr-percolor')!.textContent = perColorM.toFixed(1) + ' m';
      document.getElementById('sgr-meters')!.textContent = totalMeters.toFixed(0) + ' m';
      document.getElementById('sgr-area')!.textContent = designArea.toFixed(1) + ' cm\u00B2';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sgr-in').forEach(el => { el.addEventListener('input', calcSGR); el.addEventListener('change', calcSGR); });
      calcSGR();
    }, 50);
  </script>
</CalculatorLayout>
