---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Internetgeschwindigkeit Rechner – Download & Upload Zeiten";
const description = "Berechnen Sie Download-/Upload-Zeiten und Bandbreitenbedarf.";
const relatedCalcs = [
  { name: "Datenspeicher-Rechner", url: "/de/datenspeicher-rechner", description: "Speichergrößen umrechnen." },
  { name: "IP-Subnetz Rechner", url: "/de/ip-subnetz-rechner", description: "IP-Bereiche berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Kerosin Rechner", url: "/de/kerosin-rechner", description: "Treibstoffverbrauch." },
];
---
<CalculatorLayout lang="de" enSlug="internet-speed-calculator" title={title} description={description} calculatorName="Internetgeschwindigkeit Rechner" keywords="Internetgeschwindigkeit, Download-Zeit berechnen, Bandbreite, Übertragungsrate, Upload-Zeit" breadcrumbs={[{ name: "Internetgeschwindigkeit Rechner", url: "/de/internetgeschwindigkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Internetgeschwindigkeit Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie lange der Download oder Upload einer Datei bei Ihrer Internetverbindung dauert.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Dateigröße</label>
            <input type="number" id="ig-size" class="ig-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1000" min="0" step="100">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="ig-unit" class="ig-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1">MB (Megabyte)</option>
              <option value="1024" selected>GB (Gigabyte)</option>
              <option value="1048576">TB (Terabyte)</option>
              <option value="0.001">KB (Kilobyte)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Download-Geschwindigkeit (Mbit/s)</label><input type="number" id="ig-down" class="ig-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0.1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Upload-Geschwindigkeit (Mbit/s)</label><input type="number" id="ig-up" class="ig-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="0.1" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Download-Zeit</div>
            <div class="text-4xl font-extrabold font-mono" id="ig-down-result">—</div>
          </div>
          <div class="p-6 bg-green-600 rounded-2xl text-white text-center">
            <div class="text-sm text-green-200 uppercase tracking-wide mb-1">Upload-Zeit</div>
            <div class="text-4xl font-extrabold font-mono" id="ig-up-result">—</div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dateigröße (MB)</div><div class="text-xl font-bold" id="ig-mb">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dateigröße (GB)</div><div class="text-xl font-bold" id="ig-gb">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dateigröße (Bits)</div><div class="text-xl font-bold" id="ig-bits">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Download-Zeiten bei verschiedenen Verbindungen</h3>
          <div class="text-xs space-y-1" id="ig-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="internet-speed" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Internetgeschwindigkeit verstehen</h2>
      <p class="text-text-secondary">Internetgeschwindigkeiten werden in Megabit pro Sekunde (Mbit/s) angegeben, Dateigrößen hingegen in Megabyte (MB). Da 1 Byte aus 8 Bit besteht, müssen Sie die Mbit/s-Angabe durch 8 teilen, um den Durchsatz in MB/s zu erhalten. Eine 100-Mbit/s-Verbindung lädt also ca. 12,5 MB pro Sekunde herunter.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Übertragungsrate (MB/s) = Geschwindigkeit (Mbit/s) / 8</p>
        <p>Dauer (s) = Dateigröße (MB) / Übertragungsrate (MB/s)</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Warum ist die tatsächliche Geschwindigkeit langsamer als angegeben?</h4>
          <p class="text-text-secondary mt-1">Anbieter garantieren meist nur einen Bruchteil der Maximalgeschwindigkeit. Faktoren wie WLAN-Interferenzen, Netzwerklast, Serverkapazität und veraltete Hardware können die reale Geschwindigkeit deutlich reduzieren. Testen Sie Ihre Verbindung mit Speedtest.net oder Breitbandtest der Bundesnetzagentur.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zwischen Mbit/s und MB/s?</h4>
          <p class="text-text-secondary mt-1">Mbit/s (Megabit pro Sekunde) ist die Einheit für Übertragungsgeschwindigkeit bei Internetanschlüssen. MB/s (Megabyte pro Sekunde) wird für Dateigrößen und Kopiergeschwindigkeiten verwendet. 1 MB/s entspricht 8 Mbit/s, da 1 Byte = 8 Bit.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welche Internetgeschwindigkeit brauche ich zum Streamen?</h4>
          <p class="text-text-secondary mt-1">SD-Streaming benötigt ca. 3 Mbit/s, HD-Streaming 5–10 Mbit/s und 4K-Streaming 25–50 Mbit/s. Bei mehreren gleichzeitigen Nutzern im Haushalt empfiehlt sich ein Glasfaseranschluss mit mindestens 100 Mbit/s.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie schnell ist Glasfaser im Vergleich zu DSL?</h4>
          <p class="text-text-secondary mt-1">DSL-Anschlüsse erreichen typisch 16–250 Mbit/s Download. Glasfaser (FTTH) bietet symmetrische Geschwindigkeiten von 200 Mbit/s bis 10 Gbit/s. Die Latenz bei Glasfaser ist zudem deutlich geringer, was besonders beim Gaming wichtig ist.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function fmtDauer(secs: number): string {
      if (secs < 60) return secs.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' Sek.';
      if (secs < 3600) {
        const m = Math.floor(secs / 60);
        const s = Math.round(secs % 60);
        return m + ' Min. ' + s + ' Sek.';
      }
      const h = Math.floor(secs / 3600);
      const m = Math.floor((secs % 3600) / 60);
      return h + ' Std. ' + m + ' Min.';
    }
    function calcIG() {
      const size = parseFloat((document.getElementById('ig-size') as HTMLInputElement).value) || 0;
      const unit = parseFloat((document.getElementById('ig-unit') as HTMLSelectElement).value) || 1;
      const downSpeed = parseFloat((document.getElementById('ig-down') as HTMLInputElement).value) || 0;
      const upSpeed = parseFloat((document.getElementById('ig-up') as HTMLInputElement).value) || 0;
      const sizeMB = size * unit;
      const sizeGB = sizeMB / 1024;
      const sizeBits = sizeMB * 8 * 1e6;
      const downSec = downSpeed > 0 ? (sizeMB * 8) / downSpeed : 0;
      const upSec = upSpeed > 0 ? (sizeMB * 8) / upSpeed : 0;
      document.getElementById('ig-down-result')!.textContent = downSec > 0 ? fmtDauer(downSec) : '—';
      document.getElementById('ig-up-result')!.textContent = upSec > 0 ? fmtDauer(upSec) : '—';
      document.getElementById('ig-mb')!.textContent = sizeMB.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' MB';
      document.getElementById('ig-gb')!.textContent = sizeGB.toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) + ' GB';
      document.getElementById('ig-bits')!.textContent = (sizeBits / 1e9).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Gbit';
      const speeds = [1, 10, 50, 100, 250, 500, 1000];
      document.getElementById('ig-table')!.innerHTML = speeds.map(sp => {
        const t = (sizeMB * 8) / sp;
        return '<div class="flex justify-between"><span>' + sp + ' Mbit/s</span><span>' + fmtDauer(t) + '</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ig-in').forEach(el => { el.addEventListener('input', calcIG); el.addEventListener('change', calcIG); });
      calcIG();
    }, 50);
  </script>
</CalculatorLayout>
