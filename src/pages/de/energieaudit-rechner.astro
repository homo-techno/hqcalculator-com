---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Energieaudit-Rechner - Energieeffizienz-Bewertung & Einsparpotential";
const description = "Bewerten Sie die Energieeffizienz Ihres Hauses und ermitteln Sie Einsparpotential bei D\u00e4mmung, Heizung, Beleuchtung und Ger\u00e4ten.";
const relatedCalcs = [
  { name: "Stromverbrauch-Rechner", url: "/de/stromverbrauch-rechner", description: "Ger\u00e4te-Stromkosten." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallreserve." },
  { name: "Epoxidharz-Rechner", url: "/de/epoxidharz-rechner", description: "Epoxidharz-Mischung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Energieaudit-Rechner" lang="de" enSlug="energy-audit-calculator" keywords="energieaudit rechner, energieeffizienz bewertung, einsparpotential, energieberatung, haus energiecheck" breadcrumbs={[{ name: "Energieaudit-Rechner", url: "/de/energieaudit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Energieaudit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie die Energieleistung Ihres Hauses und finden Sie Einsparungsm&ouml;glichkeiten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Aktueller Energieverbrauch</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Monatl. Stromrechnung (&euro;)</label><input type="number" id="eade-elec" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Monatl. Gasrechnung (&euro;)</label><input type="number" id="eade-gas" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" min="0" step="10"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Wohnfl&auml;che (m&sup2;)</label><input type="number" id="eade-sqm" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="30" max="500" step="5"></div>
        <h3 class="font-semibold text-text">Geb&auml;udeh&uuml;lle</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">D&auml;mmqualit&auml;t</label>
            <select id="eade-insul" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">Ausgezeichnet (gut abgedichtet)</option>
              <option value="2" selected>Durchschnittlich</option>
              <option value="1">Schlecht / Keine</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fenstertyp</label>
            <select id="eade-windows" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">Dreifachverglasung / Low-E</option>
              <option value="2" selected>Doppelverglasung</option>
              <option value="1">Einfachverglasung</option>
            </select>
          </div>
        </div>
        <h3 class="font-semibold text-text">Anlagen</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Heizsystem</label>
            <select id="eade-hvac" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">W&auml;rmepumpe (hocheffizient)</option>
              <option value="2" selected>Gasheizung / Standard</option>
              <option value="1">Alter Heizkessel / Nachtspeicher</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Warmwasserbereitung</label>
            <select id="eade-wh" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">W&auml;rmepumpen-Boiler</option>
              <option value="2" selected>Standard-Speicher (Gas/Strom)</option>
              <option value="1">Alt / Ineffizient</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beleuchtung</label>
            <select id="eade-light" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">100% LED</option>
              <option value="2" selected>Gemischt LED/Energiespar</option>
              <option value="1">&Uuml;berwiegend Gl&uuml;hbirnen</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ger&auml;tealter</label>
            <select id="eade-appl" class="eade-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">Energieeffizienzklasse A (unter 5 J.)</option>
              <option value="2" selected>Durchschnitt (5-15 J.)</option>
              <option value="1">Alt (15+ J.)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Energieeffizienz-Score</div>
          <div class="text-4xl font-extrabold" id="eade-score">0</div>
          <div class="text-sm text-blue-200 mt-1" id="eade-grade">Berechne...</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Energiekosten</div><div class="text-xl font-bold" id="eade-annual">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro m&sup2;</div><div class="text-xl font-bold" id="eade-persqm">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einsparpotential</div><div class="text-xl font-bold" id="eade-savings">0 &euro;/Jahr</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CO&sup2;-Reduktion</div><div class="text-xl font-bold" id="eade-co2">0 kg/Jahr</div></div>
        </div>
      </div>
      <ShareButton calculatorId="energy-audit-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Energieaudit verstehen</h2>
      <p>Ein Energieaudit bewertet, wie effizient Ihr Haus Energie nutzt. Kernbereiche sind Geb&auml;udeh&uuml;lle (D&auml;mmung, Fenster, Luftdichtheit), Heizsystem, Warmwasser, Beleuchtung und Ger&auml;te. In Deutschland liegt der Durchschnitt bei etwa 18 &euro;/m&sup2; j&auml;hrlich.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was kostet ein professionelles Energieaudit?</strong> Ein Energieberater-Check kostet in Deutschland ca. 300-500 &euro;, wird aber durch BAFA-F&ouml;rderung bezuschusst.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcEADE() {
      const elec = parseFloat((document.getElementById('eade-elec') as HTMLInputElement).value) || 0;
      const gas = parseFloat((document.getElementById('eade-gas') as HTMLInputElement).value) || 0;
      const sqm = parseFloat((document.getElementById('eade-sqm') as HTMLInputElement).value) || 120;
      const insul = parseInt((document.getElementById('eade-insul') as HTMLSelectElement).value) || 2;
      const windows = parseInt((document.getElementById('eade-windows') as HTMLSelectElement).value) || 2;
      const hvac = parseInt((document.getElementById('eade-hvac') as HTMLSelectElement).value) || 2;
      const wh = parseInt((document.getElementById('eade-wh') as HTMLSelectElement).value) || 2;
      const light = parseInt((document.getElementById('eade-light') as HTMLSelectElement).value) || 2;
      const appl = parseInt((document.getElementById('eade-appl') as HTMLSelectElement).value) || 2;
      const annualCost = (elec + gas) * 12;
      const perSqm = sqm > 0 ? annualCost / sqm : 0;
      const rawScore = (insul + windows + hvac + wh + light + appl);
      const maxScore = 18;
      const score = Math.round((rawScore / maxScore) * 100);
      let grade = 'Schlecht';
      if (score >= 90) grade = 'Ausgezeichnet';
      else if (score >= 75) grade = 'Gut';
      else if (score >= 55) grade = 'Durchschnittlich';
      else if (score >= 40) grade = 'Unterdurchschnittlich';
      const savingsPercent = Math.max(0, (maxScore - rawScore) / maxScore * 0.4);
      const potentialSavings = annualCost * savingsPercent;
      const co2Reduction = potentialSavings * 2.0;
      document.getElementById('eade-score')!.textContent = score + '/100';
      document.getElementById('eade-grade')!.textContent = grade;
      document.getElementById('eade-annual')!.textContent = Math.round(annualCost).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('eade-persqm')!.textContent = perSqm.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('eade-savings')!.textContent = Math.round(potentialSavings).toLocaleString('de-DE') + ' \u20AC/Jahr';
      document.getElementById('eade-co2')!.textContent = Math.round(co2Reduction).toLocaleString('de-DE') + ' kg/Jahr';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.eade-in').forEach(el => { el.addEventListener('input', calcEADE); el.addEventListener('change', calcEADE); }); calcEADE(); }, 50);
  </script>
</CalculatorLayout>
