---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Faunendatierung-Rechner - Relative Datierung aus Tiervergesellschaftungen";
const description = "Analysieren Sie Faunenvergesellschaftungen zur relativen Datierung mittels Artenratios, Aussterbe-Markern und biostratigraphischen Leitfossilien.";
const relatedCalcs = [
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
  { name: "Dünger-Rechner", url: "/de/duenger-rechner", description: "Düngerbedarf." },
  { name: "Feuer-Rechner", url: "/de/feuer-rechner", description: "FIRE-Rechner." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Faunendatierung-Rechner" lang="de" enSlug="faunal-dating-calculator" keywords="faunendatierung, biostratigraphie, leitfossil, faunenvergesellschaftung, relative datierung, aussterbe-marker" breadcrumbs={[{ name: "Faunendatierung", url: "/de/faunendatierung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Faunendatierung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie relative Datierungen aus der Zusammensetzung von Faunenvergesellschaftungen mittels Artenanteilen, Diversitätsindizes und Domestikationsraten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-sm font-medium text-text mb-1">Gesamt-NISP (Anzahl identifizierter Exemplare)</label><input type="number" id="fdde-nisp" class="fdde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="250" min="1" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Domestizierte Tierexemplare</label><input type="number" id="fdde-dom" class="fdde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="180" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Wildtierexemplare</label><input type="number" id="fdde-wild" class="fdde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl verschiedener Arten</label><input type="number" id="fdde-species" class="fdde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="1" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Ausgestorbene Arten vorhanden</label><input type="number" id="fdde-extinct" class="fdde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">H&auml;ufigste Art (Anzahl)</label><input type="number" id="fdde-abundant" class="fdde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="95" min="1" step="1"></div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Domestikationsrate</div>
          <div class="text-4xl font-extrabold" id="fdde-domratio">0</div>
          <div class="text-sm text-blue-200 mt-1" id="fdde-period">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wild:Domestiziert</div><div class="text-xl font-bold" id="fdde-wdratio">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Simpson-Diversit&auml;tsindex</div><div class="text-xl font-bold" id="fdde-simpson">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Artenreichtum</div><div class="text-xl font-bold" id="fdde-richness">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dominanzindex</div><div class="text-xl font-bold" id="fdde-dominance">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Subsistenzinterpretation</div>
          <div class="text-sm font-bold" id="fdde-interp">--</div>
        </div>
      </div>
      <ShareButton calculatorId="faunal-dating-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Formeln der Faunenanalyse</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Domestikationsrate</strong> = Domestizierte NISP / Gesamt-NISP</p>
        <p><strong>Simpson-Index</strong> = 1 - Summe(ni/N)&sup2; f&uuml;r jede Art</p>
        <p><strong>Dominanz</strong> = H&auml;ufigste Art / Gesamt-NISP</p>
      </div>
      <p>Die Zusammensetzung von Faunenvergesellschaftungen ver&auml;ndert sich &uuml;ber die Zeit mit zunehmender Domestikation. Hohe Domestikationsraten deuten auf sp&auml;tere Perioden mit etablierter Landwirtschaft hin.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist NISP?</strong> Number of Identified Specimens - die Anzahl identifizierter Knochenexemplare in einer archäologischen Fundstelle.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcFDDE() {
      const nisp = parseFloat((document.getElementById('fdde-nisp') as HTMLInputElement).value) || 0;
      const dom = parseFloat((document.getElementById('fdde-dom') as HTMLInputElement).value) || 0;
      const wild = parseFloat((document.getElementById('fdde-wild') as HTMLInputElement).value) || 0;
      const species = parseFloat((document.getElementById('fdde-species') as HTMLInputElement).value) || 1;
      const extinct = parseFloat((document.getElementById('fdde-extinct') as HTMLInputElement).value) || 0;
      const abundant = parseFloat((document.getElementById('fdde-abundant') as HTMLInputElement).value) || 0;
      const domRatio = nisp > 0 ? dom / nisp : 0;
      const wdRatio = dom > 0 ? wild / dom : (wild > 0 ? Infinity : 0);
      const dominance = nisp > 0 ? abundant / nisp : 0;
      let simpsonSum = 0;
      if (nisp > 0 && species > 0) {
        const p1 = abundant / nisp;
        simpsonSum += p1 * p1;
        const remaining = nisp - abundant;
        const otherSpecies = species - 1;
        if (otherSpecies > 0) {
          const avgOther = remaining / otherSpecies;
          for (let i = 0; i < otherSpecies; i++) {
            const pi = avgOther / nisp;
            simpsonSum += pi * pi;
          }
        }
      }
      const simpsonIndex = 1 - simpsonSum;
      let period = '';
      let interp = '';
      if (extinct > 0) { period = 'Pleistoz\u00E4n oder fr\u00FCher (ausgestorbene Arten vorhanden)'; interp = 'J\u00E4ger-Sammler-Subsistenz mit pleistoz\u00E4ner Megafauna'; }
      else if (domRatio === 0) { period = 'Pr\u00E4-Neolithikum / Mesolithikum'; interp = 'Reine Jagd-Sammel-Fischerei-Wirtschaft, keine Domestikate'; }
      else if (domRatio < 0.2) { period = 'Fr\u00FChes Neolithikum / \u00DCbergang'; interp = '\u00DCberwiegend Wildressourcen mit beginnender Domestikation'; }
      else if (domRatio < 0.5) { period = 'Neolithikum'; interp = 'Mischwirtschaft: bedeutende Jagd mit wachsender Viehzucht'; }
      else if (domRatio < 0.8) { period = 'Sp\u00E4tneolithikum / Bronzezeit'; interp = 'Pastorale Wirtschaft dominant, erg\u00E4nzt durch Jagd'; }
      else { period = 'Eisenzeit / Historisch'; interp = 'Voll agrarisch/pastorale Wirtschaft mit minimaler Jagd'; }
      document.getElementById('fdde-domratio')!.textContent = (domRatio * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      document.getElementById('fdde-period')!.textContent = period;
      document.getElementById('fdde-wdratio')!.textContent = wdRatio === Infinity ? 'Alles wild' : wdRatio.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ':1';
      document.getElementById('fdde-simpson')!.textContent = simpsonIndex.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      document.getElementById('fdde-richness')!.textContent = species + ' Arten';
      document.getElementById('fdde-dominance')!.textContent = (dominance * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      document.getElementById('fdde-interp')!.textContent = interp;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fdde-in').forEach(el => { el.addEventListener('input', calcFDDE); el.addEventListener('change', calcFDDE); });
      calcFDDE();
    }, 50);
  </script>
</CalculatorLayout>
