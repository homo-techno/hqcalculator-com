---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Namen Generator - Zufällige Namen für Charaktere, Babys & Fantasiewelten";
const description = "Generieren Sie zufällige Namen für Charaktere, Babys und Fantasiewelten in verschiedenen Stilen.";
const relatedCalcs = [
  { name: "Akkord Rechner", url: "/de/akkord-rechner", description: "Akkorde berechnen." },
  { name: "Musik-Tonart Rechner", url: "/de/musik-tonart-rechner", description: "Tonarten ermitteln." },
  { name: "Neuroplastizität Rechner", url: "/de/neuroplastizitaet-rechner", description: "Lernpotenzial schätzen." },
  { name: "Bewegungsprofil Rechner", url: "/de/bewegungsprofil-rechner", description: "Kinematik berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Namen Generator" enSlug="name-generator" keywords="Namen Generator, zufällige Namen, Charakternamen, Babyname, Fantasienamen, Rollenspielnamen" breadcrumbs={[{ name: "Namen Generator", url: "/de/namen-generator" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Namen Generator</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Generieren Sie zufällige Namen für Charaktere, Babys, Fantasiewelten oder Rollenspiele. Wählen Sie Stil, Geschlecht und Anzahl.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Namensstil</label>
            <select id="ng-style" class="ng-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="german">Deutsch</option>
              <option value="fantasy">Fantasie</option>
              <option value="nordic">Nordisch</option>
              <option value="ancient">Antik</option>
              <option value="modern">Modern international</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
            <select id="ng-gender" class="ng-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="male">Männlich</option>
              <option value="female">Weiblich</option>
              <option value="neutral">Neutral / Unisex</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Namen</label><input type="number" id="ng-count" class="ng-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="20" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mit Nachname?</label>
            <select id="ng-lastname" class="ng-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="yes">Ja</option>
              <option value="no">Nein</option>
            </select>
          </div>
        </div>
        <button id="ng-btn" class="w-full py-3 bg-primary text-white font-bold rounded-xl hover:opacity-90 transition-opacity">Namen generieren</button>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-2">Generierte Namen</div>
          <div class="space-y-1" id="ng-result"><div class="text-blue-200 text-sm">Klicken Sie auf "Namen generieren"</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase mb-1">Zuletzt generiert</div>
          <div class="text-xl font-bold" id="ng-featured">—</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="namen-generator" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Namengenerierung für Kreativprojekte</h2>
      <p>Ein Namen Generator ist nützlich für Schriftsteller, Spielleiter, Game Designer und werdende Eltern. Die Zusammensetzung aus Silben und kulturellen Mustern erzeugt authentisch klingende Namen für verschiedene Settings und Epochen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Wofür kann ich den Namen Generator nutzen?</strong></p><p>Für Romane, Kurzgeschichten, Pen-&-Paper-Rollenspiele, Computerspielcharaktere, Babynamen zur Inspiration oder für anonyme Testzwecke.</p></div>
        <div><p><strong>Sind die Namen urheberrechtlich geschützt?</strong></p><p>Nein, generierte Namen sind frei verwendbar. Namen sind grundsätzlich nicht schutzfähig, solange sie keine eingetragenen Marken sind.</p></div>
        <div><p><strong>Wie funktioniert die Namensgenerierung?</strong></p><p>Der Generator kombiniert stilspezifische Silben, Vorsilben und Nachsilben nach sprachlichen Mustern der jeweiligen Kultur oder Epoche.</p></div>
        <div><p><strong>Kann ich einen generierten Namen für mein Baby wählen?</strong></p><p>Ja, aber beachten Sie, dass das Standesamt ungewöhnliche oder nicht erkennbar als Vorname geeignete Bezeichnungen ablehnen kann.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const NAMES: Record<string, Record<string, string[]>> = {
      german: {
        male: ['Hans','Klaus','Werner','Friedrich','Gerhard','Helmut','Manfred','Dieter','Wolfgang','Rainer','Heinz','Karl','Ernst','Walter','Günter'],
        female: ['Ursula','Brigitte','Helga','Ingrid','Elfriede','Gudrun','Edeltraud','Waltraud','Hannelore','Hildegard','Irmgard','Renate','Gerda','Erika'],
        neutral: ['Kai','Kim','Robin','Alex','Luca','Nico','Mika','Jona','Rene','Chris','Jan','Lee','Pat']
      },
      fantasy: {
        male: ['Aldric','Borath','Caelum','Dravak','Erindor','Fyrak','Gorath','Halvrek','Ixidor','Jareth','Keldor','Lyrian','Mordak','Nyxar','Orendel'],
        female: ['Aelindra','Brysa','Celwyn','Dara','Eirendis','Faelith','Galindra','Hysara','Isildra','Jyra','Kaelis','Lyra','Miriel','Nyara','Oranis'],
        neutral: ['Aeln','Brix','Caer','Dryn','Elix','Faer','Gael','Hyx','Ilyr','Jaen']
      },
      nordic: {
        male: ['Bjorn','Erik','Gunnar','Harald','Ivar','Leif','Magnus','Njord','Olaf','Ragnar','Sigurd','Thor','Ulf','Vidar','Yngvar'],
        female: ['Astrid','Birna','Dagny','Freya','Gudrun','Helga','Ingrid','Kari','Liv','Sigrid','Solveig','Thyra','Ulfhild','Vigdis','Ylva'],
        neutral: ['Ari','Bjarne','Dag','Eir','Finn','Gerd','Hel','Idunn','Jon']
      },
      ancient: {
        male: ['Aurelius','Brutus','Cassius','Demetrius','Flavius','Gordian','Hadrian','Janus','Lucius','Maximus','Nero','Octavian','Petronius','Quintus','Rex'],
        female: ['Aelia','Claudia','Diana','Flavia','Gratia','Helena','Julia','Lavinia','Marcella','Octavia','Portia','Quintina','Silvia','Valeria'],
        neutral: ['Amor','Fama','Lux','Pax','Rex','Sol','Vox']
      },
      modern: {
        male: ['Liam','Noah','Oliver','Elijah','James','Leo','Lucas','Mason','Ethan','Aiden','Logan','Sebastian','Mateo','Jackson','Daniel'],
        female: ['Emma','Sophia','Isabella','Mia','Amelia','Harper','Evelyn','Luna','Camila','Aria','Layla','Ella','Scarlett','Victoria','Grace'],
        neutral: ['Jordan','Riley','Avery','Hayden','Quinn','Peyton','Skyler','Morgan','Rowan','Sage','Finley','River','Dakota']
      }
    };
    const LASTNAMES: Record<string, string[]> = {
      german: ['Müller','Schmid','Schneider','Fischer','Weber','Meyer','Wagner','Becker','Schulz','Hoffmann','Schäfer','Koch','Bauer','Richter','Klein'],
      fantasy: ['von Drachenstein','Eisenherz','Mondschatten','Flammenfaust','Dunkelwald','Silberpfeil','Sturmsang','Nebelkind','Feuerbrand','Sternenläufer'],
      nordic: ['Eriksson','Björnsson','Larsen','Olsen','Andersen','Magnusson','Sigurdsson','Thorvaldsen','Gudmundsson','Halvorsen'],
      ancient: ['Maximus','Secundus','Tertius','Aurelius','Claudianus','Flavianus','Julianus','Valentinus','Honorius','Theodosius'],
      modern: ['Smith','Johnson','Williams','Brown','Jones','Garcia','Miller','Davis','Wilson','Anderson','Taylor','Thomas','Martinez','Hernandez','Moore']
    };
    function generateNames() {
      const style = (document.getElementById('ng-style') as HTMLSelectElement).value;
      const gender = (document.getElementById('ng-gender') as HTMLSelectElement).value;
      const count = parseInt((document.getElementById('ng-count') as HTMLInputElement).value) || 5;
      const withLast = (document.getElementById('ng-lastname') as HTMLSelectElement).value === 'yes';
      const firstPool = NAMES[style]?.[gender] || NAMES['german']['male'];
      const lastPool = LASTNAMES[style] || LASTNAMES['german'];
      const results: string[] = [];
      for (let i = 0; i < Math.min(count, 20); i++) {
        const first = firstPool[Math.floor(Math.random() * firstPool.length)];
        const full = withLast ? first + ' ' + lastPool[Math.floor(Math.random() * lastPool.length)] : first;
        results.push(full);
      }
      document.getElementById('ng-result')!.innerHTML = results.map(n =>
        '<div class="text-xl font-bold py-1 border-b border-blue-400 border-opacity-30">' + n + '</div>'
      ).join('');
      document.getElementById('ng-featured')!.textContent = results[0] || '—';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('ng-btn')!.addEventListener('click', generateNames);
      document.querySelectorAll('.ng-in').forEach(el => el.addEventListener('change', generateNames));
      generateNames();
    }, 50);
  </script>
</CalculatorLayout>
