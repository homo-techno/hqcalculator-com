---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Beleuchtungsrechner - PAR & Lumen für Aquarien";
const description = "Berechnen Sie die optimale Lichtintensität in PAR und Lumen für Pflanzenaquarien und reine Fischbecken basierend auf Beckenabmessungen und Pflanzenbedarf.";
const relatedCalcs = [
  { name: "Aquarium-CO2", url: "/de/aquarium-co2-rechner", description: "CO2-Einspritzrate für Pflanzenaquarien." },
  { name: "Aquarium-Substrat", url: "/de/aquarium-substrat-rechner", description: "Substrattiefe und -gewicht." },
  { name: "Aquarium-Heizung", url: "/de/aquarium-heizung-rechner", description: "Heizleistung für Ihr Becken." },
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Wassergewicht." },
  { name: "Riffbecken", url: "/de/riffbecken-rechner", description: "Riffbecken-Parameterdosierung." },
  { name: "Aquarium-Kosten", url: "/de/aquarium-kosten-rechner", description: "Gesamte Aquarium-Einrichtungskosten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquarium-Beleuchtungsrechner" keywords="Aquarium-Beleuchtungsrechner, PAR-Rechner, Pflanzenbecken-Licht, Aquarium-Lumen, Aquarium-Beleuchtung" breadcrumbs={[{ name: "Aquarium-Beleuchtung", url: "/de/aquarium-beleuchtung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Beleuchtungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die ideale Lichtintensität für Ihr Pflanzen- oder reines Fischaquarium basierend auf Beckentiefe und Pflanzenanforderungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Länge (cm)</label>
            <input type="number" id="al2-len" class="al2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (cm)</label>
            <input type="number" id="al2-wid" class="al2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tiefe (cm)</label>
            <input type="number" id="al2-dep" class="al2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="1" step="1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Beckentyp</label>
          <select id="al2-type" class="al2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="low">Schwachlicht-Pflanzen (Anubias, Javafarn)</option>
            <option value="medium" selected>Mittellicht-Pflanzen (Cryptocoryne, Schwertpflanzen)</option>
            <option value="high">Starklicht-Pflanzen (Bodendecker, Rotpflanzen)</option>
            <option value="fish">Nur Fische (keine lebenden Pflanzen)</option>
            <option value="reef">Riff / Korallenbecken</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener PAR am Substrat</div>
          <div class="text-5xl font-extrabold font-mono" id="al2-result">0 PAR</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamte Lumen benötigt</div>
            <div class="text-xl font-bold font-mono" id="al2-lumens">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">LED-Watt (ca.)</div>
            <div class="text-xl font-bold font-mono" id="al2-watts">0 W</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Lumen pro Liter</div>
            <div class="text-xl font-bold font-mono" id="al2-lpg">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Beleuchtungsdauer</div>
            <div class="text-xl font-bold font-mono" id="al2-photo">0 Std.</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquarium-lighting" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAL2() {
      const lenCm = parseFloat((document.getElementById('al2-len') as HTMLInputElement).value) || 0;
      const widCm = parseFloat((document.getElementById('al2-wid') as HTMLInputElement).value) || 0;
      const depCm = parseFloat((document.getElementById('al2-dep') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('al2-type') as HTMLSelectElement).value;
      const len = lenCm / 2.54;
      const wid = widCm / 2.54;
      const dep = depCm / 2.54;
      const gallons = (len * wid * dep) / 231;
      const liters = gallons * 3.785;
      const surfArea = (len * wid) / 144;
      const parTargets: Record<string, number> = { fish: 20, low: 40, medium: 75, high: 120, reef: 200 };
      const photoHours: Record<string, number> = { fish: 6, low: 8, medium: 8, high: 10, reef: 10 };
      const targetPAR = parTargets[type] || 50;
      const depthFactor = 1 + (dep - 12) * 0.04;
      const totalLumens = Math.round(targetPAR * surfArea * depthFactor * 40);
      const ledWatts = Math.ceil(totalLumens / 100);
      const lpg = liters > 0 ? (totalLumens / liters).toFixed(0) : '0';
      const photo = photoHours[type] || 8;
      document.getElementById('al2-result')!.textContent = targetPAR + ' PAR';
      document.getElementById('al2-lumens')!.textContent = totalLumens.toLocaleString('de-DE');
      document.getElementById('al2-watts')!.textContent = ledWatts + ' W';
      document.getElementById('al2-lpg')!.textContent = lpg;
      document.getElementById('al2-photo')!.textContent = photo + ' Std.';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.al2-in').forEach(el => { el.addEventListener('input', calcAL2); el.addEventListener('change', calcAL2); });
      calcAL2();
    }, 50);
  </script>
</CalculatorLayout>
