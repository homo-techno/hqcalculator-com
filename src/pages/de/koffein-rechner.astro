---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Koffein-Rechner - T\u00e4gliche Aufnahme & Halbwertszeit";
const description = "Berechnen Sie Ihre t\u00e4gliche Koffeinaufnahme und verfolgen Sie, wie lange Koffein in Ihrem System verbleibt.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorien." },
  { name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner", description: "Defizit." },
  { name: "Koffein-Halbwertszeit", url: "/de/koffein-halbwertszeit-rechner", description: "Halbwertszeit." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "BMI." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlaf." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorienverbrauch." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Koffein-Rechner" lang="de" enSlug="caffeine-calculator" keywords="koffein rechner, koffeinaufnahme, kaffee rechner, koffein halbwertszeit, t\u00e4gliches koffeinlimit" breadcrumbs={[{ name: "Koffein-Rechner", url: "/de/koffein-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Koffein-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Verfolgen Sie Ihre Koffeinaufnahme und sehen Sie, wann die Wirkung nachl&auml;sst.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Getr&auml;nk</label>
            <select id="kf-bev" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="95" selected>Kaffee (240ml) — 95mg</option>
              <option value="63">Espresso (1 Shot) — 63mg</option>
              <option value="47">Schwarztee (240ml) — 47mg</option>
              <option value="28">Gr&uuml;ntee (240ml) — 28mg</option>
              <option value="34">Cola (330ml) — 34mg</option>
              <option value="80">Energy Drink (250ml) — 80mg</option>
              <option value="160">Energy Drink (500ml) — 160mg</option>
              <option value="200">Koffeintablette — 200mg</option>
              <option value="5">Entkoffeiniert (240ml) — 5mg</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Portionen</label><input type="number" id="kf-qty" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Stunden seit letztem Koffein</label><input type="number" id="kf-hrs" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="48" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Koffein im System</div>
          <div class="text-5xl font-extrabold font-mono" id="kf-result">0 mg</div>
          <div class="text-sm text-blue-200 mt-1" id="kf-pct">des 400mg-Tageslimits</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="kf-status-box">
          <div class="font-bold text-sm" id="kf-status">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt aufgenommen</div><div class="text-xl font-bold font-mono" id="kf-total">0 mg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verstoffwechselt</div><div class="text-xl font-bold font-mono" id="kf-met">0 mg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abgebaut bis</div><div class="text-xl font-bold font-mono" id="kf-clear">-</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Zeitverlauf (Koffein-Halbwertszeit &asymp; 5 Std.)</h3>
          <div class="text-xs space-y-1" id="kf-timeline"></div>
        </div>
      </div>
      <ShareButton calculatorId="caffeine" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Wie viel Koffein ist sicher?</h3>
      <p>Die EFSA empfiehlt f&uuml;r gesunde Erwachsene maximal 400 mg Koffein pro Tag. Schwangere sollten nicht mehr als 200 mg zu sich nehmen.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Wie lange wirkt Koffein?</h3>
      <p>Die Halbwertszeit von Koffein betr&auml;gt etwa 5 Stunden. Nach 10 Stunden sind noch ca. 25% im K&ouml;rper.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKF() {
      const mgPer = parseInt((document.getElementById('kf-bev') as HTMLSelectElement).value) || 0;
      const qty = parseFloat((document.getElementById('kf-qty') as HTMLInputElement).value) || 0;
      const hrs = parseFloat((document.getElementById('kf-hrs') as HTMLInputElement).value) || 0;
      const halfLife = 5;
      const total = mgPer * qty;
      const remaining = total * Math.pow(0.5, hrs / halfLife);
      const metabolized = total - remaining;
      const pct = (total / 400) * 100;
      document.getElementById('kf-result')!.textContent = Math.round(remaining) + ' mg';
      document.getElementById('kf-total')!.textContent = total + ' mg';
      document.getElementById('kf-met')!.textContent = Math.round(metabolized) + ' mg';
      document.getElementById('kf-pct')!.textContent = pct.toFixed(0) + '% des 400mg-Tageslimits';
      const clearHrs = total > 0 ? halfLife * Math.log2(total / 10) : 0;
      const clearLeft = Math.max(0, clearHrs - hrs);
      document.getElementById('kf-clear')!.textContent = clearLeft > 0 ? '~' + clearLeft.toFixed(1).replace('.', ',') + ' Std.' : 'Jetzt';
      let status: string, color: string;
      if (remaining < 50) { status = 'Niedrig \u2014 minimale Wirkung'; color = 'bg-green-50 text-green-800'; }
      else if (remaining < 200) { status = 'Moderat \u2014 wach und konzentriert'; color = 'bg-yellow-50 text-yellow-800'; }
      else if (remaining < 400) { status = 'Hoch \u2014 kann Unruhe verursachen'; color = 'bg-orange-50 text-orange-800'; }
      else { status = 'Sehr hoch \u2014 kann Angst/Schlafst\u00f6rungen verursachen'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('kf-status')!.textContent = status;
      document.getElementById('kf-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      const timeline = document.getElementById('kf-timeline')!;
      let html = '';
      for (let h = 0; h <= 24; h += 2) {
        const r = total * Math.pow(0.5, (hrs + h) / halfLife);
        if (r < 1) break;
        html += '<div>+' + h + 'h: ~' + Math.round(r) + ' mg verbleibend</div>';
      }
      timeline.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('kf-qty') as HTMLInputElement).value = '2';
      (document.getElementById('kf-hrs') as HTMLInputElement).value = '0';
      document.querySelectorAll('.kf-in').forEach(el => { el.addEventListener('input', calcKF); el.addEventListener('change', calcKF); });
      calcKF();
    }, 50);
  </script>
</CalculatorLayout>
