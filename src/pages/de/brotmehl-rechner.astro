---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Brotmehl-Rechner - Proteingehalt & Substitution";
const description = "Berechnen Sie den Proteingehalt von Mehl und finden Sie Substitutionsverhältnisse beim Wechsel zwischen verschiedenen Mehlsorten.";
const relatedCalcs = [
  { name: "Bäckerprozent-Rechner", url: "/de/baeckerprozent-rechner", description: "Bäckerprozente berechnen." },
  { name: "Brot-Hydration-Rechner", url: "/de/brot-hydration-rechner", description: "Teig-Hydration visualisieren." },
  { name: "Alkohol-Kalorien-Rechner", url: "/de/alkohol-kalorien-rechner", description: "Getränke-Kalorien." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Brotmehl-Rechner" enSlug="bread-flour-calculator" keywords="Brotmehl Protein, Mehl Substitution, Kuchenmehl Ersatz, Weizenkleber, Mehl Proteingehalt, Mehltypen" breadcrumbs={[{ name: "Brotmehl-Rechner", url: "/de/brotmehl-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Brotmehl-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie den Proteingehalt von Mehl und berechnen Sie exakte Substitutionsverhältnisse mit Weizenkleber oder Stärke.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Rezept verlangt</label>
            <select id="bm-from" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="550">Type 550 (11,5%)</option>
              <option value="405">Type 405 (10%)</option>
              <option value="812">Type 812 (12%)</option>
              <option value="1050">Type 1050 (13%)</option>
              <option value="1600">Vollkornmehl (14%)</option>
              <option value="00">Tipo 00 (11,5%)</option>
              <option value="manitoba">Manitoba (14,5%)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Sie haben</label>
            <select id="bm-to" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="550">Type 550 (11,5%)</option>
              <option value="405" selected>Type 405 (10%)</option>
              <option value="812">Type 812 (12%)</option>
              <option value="1050">Type 1050 (13%)</option>
              <option value="1600">Vollkornmehl (14%)</option>
              <option value="00">Tipo 00 (11,5%)</option>
              <option value="manitoba">Manitoba (14,5%)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Benötigte Menge (g)</label>
          <input type="number" id="bm-amount" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Substitution</div>
          <div class="text-3xl font-extrabold font-mono" id="bm-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mehlmenge</div><div class="text-xl font-bold font-mono" id="bm-flour">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kleber / Stärke Anp.</div><div class="text-xl font-bold font-mono" id="bm-adj">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Protein benötigt</div><div class="text-xl font-bold font-mono" id="bm-prot-need">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Protein vorhanden</div><div class="text-xl font-bold font-mono" id="bm-prot-have">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Tipp</div>
          <div class="text-sm text-text-secondary" id="bm-tip">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="brotmehl" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Deutsche Mehltypen verstehen</h2>
      <p>In Deutschland werden Mehle nach ihrem Mineralstoffgehalt (Type-Zahl) klassifiziert. Type 405 ist das feinste Weißmehl mit niedrigstem Proteingehalt, ideal für Kuchen. Type 550 ist das Standard-Brotmehl. Type 1050 hat mehr Protein und eignet sich für herzhafte Brote. Vollkornmehl enthält das ganze Korn und hat den höchsten Proteingehalt.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBM() {
      const fromType = (document.getElementById('bm-from') as HTMLSelectElement).value;
      const toType = (document.getElementById('bm-to') as HTMLSelectElement).value;
      const amount = parseFloat((document.getElementById('bm-amount') as HTMLInputElement).value) || 500;
      const proteins: Record<string, number> = {
        '405': 10, '550': 11.5, '812': 12, '1050': 13, '1600': 14, '00': 11.5, 'manitoba': 14.5
      };
      const fromProt = proteins[fromType];
      const toProt = proteins[toType];
      const proteinNeeded = amount * (fromProt / 100);
      const proteinAvailable = amount * (toProt / 100);
      const proteinDiff = proteinNeeded - proteinAvailable;
      let adjAmount = 0;
      let adjType = '';
      let flourAmount = amount;
      if (proteinDiff > 0) {
        adjAmount = proteinDiff / 0.75;
        flourAmount = amount - adjAmount;
        adjType = 'Weizenkleber';
      } else if (proteinDiff < 0) {
        adjAmount = Math.abs(proteinDiff) / (toProt / 100);
        flourAmount = amount - adjAmount;
        adjType = 'Speisest\u00e4rke';
      }
      let resultText = '';
      if (fromType === toType) {
        resultText = amount + 'g ' + (document.getElementById('bm-to') as HTMLSelectElement).selectedOptions[0].text.split(' (')[0];
      } else if (adjAmount < 1) {
        resultText = amount + 'g - nah genug, 1:1 verwenden';
      } else {
        resultText = flourAmount.toFixed(0) + 'g Mehl + ' + adjAmount.toFixed(0) + 'g ' + adjType;
      }
      document.getElementById('bm-result')!.textContent = resultText;
      document.getElementById('bm-flour')!.textContent = flourAmount.toFixed(0) + ' g';
      document.getElementById('bm-adj')!.textContent = adjAmount < 1 ? 'Nicht n\u00f6tig' : adjAmount.toFixed(0) + ' g ' + adjType;
      document.getElementById('bm-prot-need')!.textContent = fromProt + '% (' + proteinNeeded.toFixed(1) + 'g)';
      document.getElementById('bm-prot-have')!.textContent = toProt + '% (' + proteinAvailable.toFixed(1) + 'g)';
      let tip = '';
      if (fromType === toType) tip = 'Keine Substitution n\u00f6tig - gleiche Mehlsorte.';
      else if (proteinDiff > 5) tip = 'Gro\u00dfer Proteinunterschied. Ergebnis kann vom Original abweichen. Erwägen Sie, das richtige Mehl zu kaufen.';
      else if (proteinDiff > 0) tip = 'Weizenkleber zugeben, um Protein zu erh\u00f6hen. Gr\u00fcndlich mit Mehl mischen, bevor Fl\u00fcssigkeit zugegeben wird.';
      else if (proteinDiff < -5) tip = 'Gro\u00dfer Proteinunterschied. Ersetzen Sie etwas Mehl durch Speisest\u00e4rke, um den Proteingehalt zu senken.';
      else if (proteinDiff < 0) tip = 'Ihr Mehl hat mehr Protein. Ersetzen Sie etwas durch Speisest\u00e4rke f\u00fcr eine bessere Übereinstimmung.';
      else tip = 'Sehr \u00e4hnlich. 1:1 Substitution verwenden.';
      document.getElementById('bm-tip')!.textContent = tip;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bm-in').forEach(el => { el.addEventListener('input', calcBM); el.addEventListener('change', calcBM); });
      calcBM();
    }, 50);
  </script>
</CalculatorLayout>
