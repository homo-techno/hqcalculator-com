---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Generator-Gr\u00F6\u00DFe-Rechner - Leistung & Anlaufstrom";
const description = "Berechnen Sie die richtige Generatorgr\u00F6\u00DFe basierend auf Ihren Ger\u00E4ten. Vergleichen Sie Anlauf- und Dauerleistung und ermitteln Sie die n\u00F6tige Spitzenkapazit\u00E4t.";
const relatedCalcs = [
  { name: "Stromkosten-Rechner", url: "/de/stromkostenrechner", description: "Stromkosten." },
  { name: "Solar-Rechner", url: "/de/solarrechner", description: "Solardimensionierung." },
  { name: "Akkulaufzeit-Rechner", url: "/de/akkulaufzeit-rechner", description: "Akkulaufzeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Generator-Gr\u00F6\u00DFe-Rechner" lang="de" enSlug="generator-size-calculator" keywords="generator rechner, generator leistung, anlaufleistung, dauerleistung, spitzenkapazit\u00E4t, notstrom generator" breadcrumbs={[{ name: "Generator-Gr\u00F6\u00DFe", url: "/de/generator-groesse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Generator-Gr&ouml;&szlig;e-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die richtige Generator-Leistung durch Auflisten Ihrer Ger&auml;te mit Anlauf- und Dauerleistung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Ger&auml;te ausw&auml;hlen</h3>
          <div class="space-y-2" id="gnr-list">
            <div class="grid grid-cols-12 gap-1 text-xs text-text-muted font-semibold px-1">
              <div class="col-span-5">Ger&auml;t</div>
              <div class="col-span-3 text-center">Dauer W</div>
              <div class="col-span-3 text-center">Anlauf W</div>
              <div class="col-span-1 text-center">An</div>
            </div>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Generator</div>
          <div class="text-5xl font-extrabold font-mono" id="gnr-result">0 W</div>
          <div class="text-sm text-blue-200 mt-1" id="gnr-note">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamt Dauer</div>
            <div class="text-xl font-bold font-mono" id="gnr-running">0 W</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gr&ouml;&szlig;ter Anlauf</div>
            <div class="text-xl font-bold font-mono" id="gnr-surge">0 W</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Spitzenbedarf</div>
            <div class="text-xl font-bold font-mono" id="gnr-peak">0 W</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Generator-Typ Empfehlung</div>
          <div class="text-lg font-bold" id="gnr-type">-</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="generator-size" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Generator richtig dimensionieren</h2>
      <p>Ger&auml;te mit Elektromotoren (K&uuml;hlschrank, Pumpen, Klimaanlage) ben&ouml;tigen beim Anlauf das 2-3-fache ihrer Dauerleistung. Der Generator muss diese Spitze abdecken k&ouml;nnen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Dauer- und Anlaufleistung?</strong> Die Dauerleistung ist der kontinuierliche Verbrauch, die Anlaufleistung der kurzzeitige Spitzenbedarf beim Einschalten.</p>
      <p><strong>Wie viel Reserve einplanen?</strong> Planen Sie mindestens 20% Sicherheitsreserve &uuml;ber dem berechneten Spitzenbedarf ein.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const GNR_APPLIANCES = [
      { name: 'K\u00FChlschrank', running: 200, starting: 1200 },
      { name: 'Gefriertruhe', running: 150, starting: 900 },
      { name: 'Tauchpumpe', running: 800, starting: 2000 },
      { name: 'Klimaanlage (zentral)', running: 3500, starting: 7000 },
      { name: 'Klimager\u00E4t (mobil)', running: 1200, starting: 3600 },
      { name: 'Heizungsgebl\u00E4se', running: 800, starting: 2400 },
      { name: 'Brunnenpumpe', running: 750, starting: 2000 },
      { name: 'Mikrowelle (1000W)', running: 1000, starting: 1000 },
      { name: 'E-Herd (1 Platte)', running: 2500, starting: 2500 },
      { name: 'Beleuchtung (10 LEDs)', running: 100, starting: 100 },
      { name: 'TV / Unterhaltung', running: 300, starting: 300 },
      { name: 'Garagentorantrieb', running: 550, starting: 1100 },
      { name: 'Elektro-Warmwasser', running: 4500, starting: 4500 },
      { name: 'Waschmaschine', running: 500, starting: 1200 },
      { name: 'Trockner (Elektro)', running: 5000, starting: 6000 },
    ];

    function buildGNRList() {
      const container = document.getElementById('gnr-list')!;
      const header = container.querySelector('.grid');
      let html = header ? header.outerHTML : '';
      GNR_APPLIANCES.forEach((app, i) => {
        html += '<div class="grid grid-cols-12 gap-1 items-center">';
        html += '<div class="col-span-5 text-xs font-medium truncate">' + app.name + '</div>';
        html += '<div class="col-span-3"><input type="number" class="gnr-in w-full px-1 py-1 border border-border rounded-lg text-sm font-bold text-center" id="gnr-r' + i + '" value="' + app.running + '" min="0"></div>';
        html += '<div class="col-span-3"><input type="number" class="gnr-in w-full px-1 py-1 border border-border rounded-lg text-sm font-bold text-center" id="gnr-s' + i + '" value="' + app.starting + '" min="0"></div>';
        html += '<div class="col-span-1 text-center"><input type="checkbox" class="gnr-in" id="gnr-c' + i + '"' + (i < 4 ? ' checked' : '') + '></div>';
        html += '</div>';
      });
      container.innerHTML = html;
    }

    function calcGNR() {
      let totalRunning = 0;
      let largestSurge = 0;
      GNR_APPLIANCES.forEach((_, i) => {
        const checked = (document.getElementById('gnr-c' + i) as HTMLInputElement)?.checked;
        if (!checked) return;
        const running = parseFloat((document.getElementById('gnr-r' + i) as HTMLInputElement).value) || 0;
        const starting = parseFloat((document.getElementById('gnr-s' + i) as HTMLInputElement).value) || 0;
        totalRunning += running;
        const surge = starting - running;
        if (surge > largestSurge) largestSurge = surge;
      });
      const peakDemand = totalRunning + largestSurge;
      const recommended = Math.ceil(peakDemand * 1.2 / 500) * 500;
      document.getElementById('gnr-running')!.textContent = totalRunning.toLocaleString('de-DE') + ' W';
      document.getElementById('gnr-surge')!.textContent = largestSurge.toLocaleString('de-DE') + ' W';
      document.getElementById('gnr-peak')!.textContent = peakDemand.toLocaleString('de-DE') + ' W';
      document.getElementById('gnr-result')!.textContent = recommended.toLocaleString('de-DE') + ' W';
      document.getElementById('gnr-note')!.textContent = (recommended / 1000).toFixed(1) + ' kW Minimum mit 20% Sicherheitsreserve';
      let genType: string;
      if (recommended <= 3500) genType = 'Tragbarer Inverter-Generator (leise, sparsam)';
      else if (recommended <= 7500) genType = 'Tragbarer konventioneller Generator';
      else if (recommended <= 12000) genType = 'Gro\u00DFer tragbarer oder kleiner station\u00E4rer Generator';
      else genType = 'Station\u00E4rer Notstrom-Generator (automatische Umschaltung)';
      document.getElementById('gnr-type')!.textContent = genType;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      buildGNRList();
      document.querySelectorAll('.gnr-in').forEach(el => {
        el.addEventListener('input', calcGNR);
        el.addEventListener('change', calcGNR);
      });
      calcGNR();
    }, 50);
  </script>
</CalculatorLayout>
