---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gacha-Rechner - Ziehkosten & Wahrscheinlichkeit";
const description = "Berechnen Sie Ziehkosten f\u00FCr Zielwahrscheinlichkeit, Mitleid-System-Mechanik, erwartete Ausgaben und Rate-Up-Chancen f\u00FCr Gacha-Spiele.";
const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Allgemeine Wahrscheinlichkeit." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budgetplanung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Statistik-Rechner", url: "/de/statistik-rechner", description: "Statistische Analyse." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gacha-Rechner" lang="de" enSlug="gacha-calculator" keywords="gacha rechner, ziehkosten, mitleid system, gacha wahrscheinlichkeit, banner chancen, rate up, gacha ausgaben" breadcrumbs={[{ name: "Gacha-Rechner", url: "/de/gacha-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gacha-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihre Ausgaben und Chancen f&uuml;r Gacha-Ziehungen mit Mitleid-Systemen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Basis-Rate-Up-Chance (%)</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-rate" min="0.01" max="100" step="0.01" value="0.6">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Hartes Mitleid (garantiert bei Ziehung #)</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-pity" min="0" max="1000" value="90">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Weiches Mitleid beginnt bei (Ziehung #)</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-soft" min="0" max="1000" value="74">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Weiches Mitleid Ratenanstieg (%/Ziehung)</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-softrate" min="0" max="100" step="0.1" value="6">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">50/50 Gewinnrate (%)</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-5050" min="1" max="100" value="50">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Kosten pro Ziehung (W&auml;hrung)</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-cost" min="0.01" step="0.01" value="160">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Echtgeld pro W&auml;hrungseinheit (&euro;)</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-money" min="0.001" step="0.001" value="0.0125">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Gew&uuml;nschte Kopien</label>
          <input type="number" class="gar-in w-full px-4 py-2 border border-border rounded-lg" id="gar-copies" min="1" max="10" value="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Durchschn. Ziehungen ben&ouml;tigt</div>
          <div class="text-5xl font-extrabold font-mono" id="gar-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Durchschn. W&auml;hrungskosten</div>
            <div class="text-xl font-bold font-mono" id="gar-avgcost">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Durchschn. Echtgeld (&euro;)</div>
            <div class="text-xl font-bold font-mono" id="gar-avgmoney">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Worst Case Ziehungen</div>
            <div class="text-xl font-bold font-mono" id="gar-worst">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Worst Case Kosten (&euro;)</div>
            <div class="text-xl font-bold font-mono" id="gar-worstcost">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Wahrscheinlichkeit nach Ziehungsanzahl</h3>
          <div class="text-xs font-mono space-y-1" id="gar-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gacha-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gacha-Mechaniken verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Basiswahrscheinlichkeit pro Ziehung = Rate-Up-Chance</p>
        <p>Weiches Mitleid erh&ouml;ht die Rate ab einer bestimmten Ziehung</p>
        <p>Hartes Mitleid garantiert den Charakter</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein Mitleid-System?</strong> Ein Mitleid-System (Pity) garantiert nach einer bestimmten Anzahl erfolgloser Ziehungen einen seltenen Gegenstand oder Charakter.</p>
      <p><strong>Was bedeutet 50/50?</strong> Wenn Sie einen 5-Sterne-Charakter erhalten, besteht eine 50%-Chance, dass es der beworbene Charakter ist. Bei Verlust ist der n&auml;chste 5-Sterne garantiert der beworbene.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGAR() {
      const baseRate = parseFloat((document.getElementById('gar-rate') as HTMLInputElement).value) || 0.6;
      const hardPity = parseInt((document.getElementById('gar-pity') as HTMLInputElement).value) || 90;
      const softStart = parseInt((document.getElementById('gar-soft') as HTMLInputElement).value) || 74;
      const softIncrease = parseFloat((document.getElementById('gar-softrate') as HTMLInputElement).value) || 6;
      const winRate = parseFloat((document.getElementById('gar-5050') as HTMLInputElement).value) || 50;
      const costPerPull = parseFloat((document.getElementById('gar-cost') as HTMLInputElement).value) || 160;
      const moneyPerUnit = parseFloat((document.getElementById('gar-money') as HTMLInputElement).value) || 0.0125;
      const copies = parseInt((document.getElementById('gar-copies') as HTMLInputElement).value) || 1;
      const pullProbs: number[] = [];
      let cumProb = 0;
      let avgPulls = 0;
      for (let i = 1; i <= hardPity; i++) {
        let rate = baseRate / 100;
        if (i >= softStart && softStart > 0) {
          rate = Math.min(1, rate + (i - softStart + 1) * (softIncrease / 100));
        }
        if (i === hardPity) rate = 1;
        const probHere = (1 - cumProb) * rate;
        pullProbs.push(probHere);
        avgPulls += i * probHere;
        cumProb += probHere;
      }
      const win5050 = winRate / 100;
      const avgForRateUp = avgPulls / win5050 + (1 - win5050) * avgPulls;
      const avgTotal = avgForRateUp * copies;
      const worstPulls = hardPity * 2 * copies;
      const worstCost = worstPulls * costPerPull * moneyPerUnit;
      const avgCurrency = avgTotal * costPerPull;
      const avgMoney = avgCurrency * moneyPerUnit;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('gar-result')!.textContent = Math.ceil(avgTotal).toLocaleString('de-DE');
      document.getElementById('gar-avgcost')!.textContent = Math.ceil(avgCurrency).toLocaleString('de-DE');
      document.getElementById('gar-avgmoney')!.textContent = fmt(avgMoney) + ' \u20AC';
      document.getElementById('gar-worst')!.textContent = worstPulls.toLocaleString('de-DE');
      document.getElementById('gar-worstcost')!.textContent = fmt(worstCost) + ' \u20AC';
      const milestones = [10, 20, 30, 40, 50, 60, 70, 80, hardPity, hardPity * 2];
      let html = '';
      for (const n of milestones) {
        let cum = 0;
        for (let i = 0; i < Math.min(n, pullProbs.length); i++) {
          cum += pullProbs[i];
        }
        if (n > hardPity) { cum = 1; }
        const simpleChance = 1 - Math.pow(1 - baseRate / 100 * win5050, Math.min(n, hardPity * 2));
        const displayChance = Math.min(n >= hardPity * 2 ? 100 : simpleChance * 100 + (cum * win5050 * 100 - simpleChance * 100) * 0.5, 100);
        const money = n * costPerPull * moneyPerUnit;
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + n + ' Ziehungen (' + fmt(money) + ' \u20AC)</span><span>' + Math.min(displayChance, 100).toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + '%</span></div>';
      }
      document.getElementById('gar-table')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gar-in').forEach(el => { el.addEventListener('input', calcGAR); el.addEventListener('change', calcGAR); });
      calcGAR();
    }, 50);
  </script>
</CalculatorLayout>
