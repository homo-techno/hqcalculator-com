---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gärtemperatur-Rechner - Gewünschte Teigtemperatur (GTT)";
const description = "Berechnen Sie die gewünschte Teigtemperatur anhand der Zutatentemperaturen und des Reibungsfaktors. Finden Sie die ideale Wassertemperatur.";
const relatedCalcs = [
  { name: "Dünger-Rechner", url: "/de/duenger-rechner", description: "Düngerbedarf." },
  { name: "Fastenrechner", url: "/de/fastenrechner", description: "Intervallfasten." },
  { name: "Feuer-Rechner", url: "/de/feuer-rechner", description: "FIRE-Rechner." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gärtemperatur-Rechner" lang="de" enSlug="fermentation-temperature-calculator" keywords="gewünschte teigtemperatur, GTT, reibungsfaktor, wassertemperatur, brotteig temperatur, gärung kontrolle" breadcrumbs={[{ name: "Gärtemperatur", url: "/de/gaertemperatur-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gärtemperatur-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Wassertemperatur, um Ihre gew&uuml;nschte Teigtemperatur (GTT) zu erreichen, unter Ber&uuml;cksichtigung von Mehl-, Raum- und Maschinenreibungstemperatur.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschte Teigtemperatur (&deg;C)</label><input type="number" id="gtde-ddt" class="gtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="24" min="10" max="40" step="1"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Raumtemperatur (&deg;C)</label><input type="number" id="gtde-room" class="gtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="22" min="5" max="45" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Mehltemperatur (&deg;C)</label><input type="number" id="gtde-flour" class="gtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="21" min="5" max="45" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Vorteig-/Sauerteigtemp. (&deg;C)</label><input type="number" id="gtde-pre" class="gtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="21" min="5" max="45" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mit Vorteig?</label>
            <select id="gtde-usepre" class="gtde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="no">Nein (direkter Teig)</option>
              <option value="yes">Ja (mit Vorteig)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Reibungsfaktor (&deg;C)</label>
          <input type="number" id="gtde-friction" class="gtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="13" min="0" max="35" step="1">
          <p class="text-xs text-text-muted mt-1">Typisch: Handkneten 0-3, Spiralkneter 11-17, Planetenkneter 14-19</p>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Wassertemperatur</div>
          <div class="text-5xl font-extrabold font-mono" id="gtde-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wassertemp. (&deg;F)</div><div class="text-xl font-bold font-mono" id="gtde-fahr">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">GTT (&deg;F)</div><div class="text-xl font-bold font-mono" id="gtde-ddt-f">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Multiplikationsfaktor</div><div class="text-xl font-bold font-mono" id="gtde-factor">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser-Hinweis</div><div class="text-sm font-bold" id="gtde-advisory">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fermentation-temp-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gärtemperatur-Steuerung</h2>
      <p>Die Teigtemperatur ist entscheidend für die Gärung. Die Formel berücksichtigt Raum-, Mehl- und optionale Vorteigtemperatur sowie den Reibungsfaktor der Knetmaschine.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Reibungsfaktor?</strong> Die Wärme, die durch das Kneten entsteht. Er variiert je nach Knetmaschine und Knetdauer.</p>
      <p><strong>Wie bestimme ich meinen Reibungsfaktor?</strong> Messen Sie die Teigtemperatur nach dem Kneten und rechnen Sie zurück.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGTDE() {
      const ddt = parseFloat((document.getElementById('gtde-ddt') as HTMLInputElement).value) || 24;
      const room = parseFloat((document.getElementById('gtde-room') as HTMLInputElement).value) || 22;
      const flour = parseFloat((document.getElementById('gtde-flour') as HTMLInputElement).value) || 21;
      const pre = parseFloat((document.getElementById('gtde-pre') as HTMLInputElement).value) || 21;
      const usePre = (document.getElementById('gtde-usepre') as HTMLSelectElement).value;
      const friction = parseFloat((document.getElementById('gtde-friction') as HTMLInputElement).value) || 13;
      let factor = 3;
      let waterTemp = 0;
      if (usePre === 'yes') {
        factor = 4;
        waterTemp = (ddt * factor) - room - flour - pre - friction;
      } else {
        waterTemp = (ddt * factor) - room - flour - friction;
      }
      const waterF = waterTemp * 9 / 5 + 32;
      const ddtF = ddt * 9 / 5 + 32;
      let advisory = '';
      if (waterTemp < 2) advisory = 'Sehr kalt! Eiswasser verwenden.';
      else if (waterTemp < 10) advisory = 'Kaltes Wasser. Vorher kühlen.';
      else if (waterTemp < 24) advisory = 'Kühles bis lauwarmes Wasser.';
      else if (waterTemp < 32) advisory = 'Warmes Wasser. Standardbereich.';
      else if (waterTemp < 45) advisory = 'Heißes Wasser. Vorsicht - Hefe stirbt über 45°C.';
      else advisory = 'Zu heiß! Schädigt die Hefe. Reibungsfaktor oder Umgebung anpassen.';
      document.getElementById('gtde-result')!.textContent = waterTemp.toFixed(0) + '\u00B0C';
      document.getElementById('gtde-fahr')!.textContent = waterF.toFixed(1) + '\u00B0F';
      document.getElementById('gtde-ddt-f')!.textContent = ddtF.toFixed(1) + '\u00B0F';
      document.getElementById('gtde-factor')!.textContent = factor + 'x (GTT \u00D7 ' + factor + ' = ' + (ddt * factor) + ')';
      document.getElementById('gtde-advisory')!.textContent = advisory;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gtde-in').forEach(el => { el.addEventListener('input', calcGTDE); el.addEventListener('change', calcGTDE); });
      calcGTDE();
    }, 50);
  </script>
</CalculatorLayout>
