---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Haarfarbe-Mischen-Rechner - Entwicklerverh&auml;ltnis & Einwirkzeit";
const description = "Berechnen Sie Haarfarben-Mischverh&auml;ltnisse, Entwicklermenge, Farbmenge und Einwirkzeit f&uuml;r perfekte Haarfarb-Ergebnisse.";
const relatedCalcs = [
  { name: "Haarentwickler-Rechner", url: "/de/haarentwickler-rechner", description: "Entwicklervolumen-Auswahl." },
  { name: "Haaraufhellung-Rechner", url: "/de/haaraufhellung-rechner", description: "Blondierung." },
  { name: "Haarwachstum-Rechner", url: "/de/haarwachstum-rechner", description: "Wachstumsrate." },
  { name: "Haarporositaet-Rechner", url: "/de/haarporositaet-rechner", description: "Porosit&auml;tsbewertung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Haarfarbe-Mischen-Rechner" lang="de" enSlug="hair-color-mixing-calculator" keywords="haarfarbe mischen, entwicklerverh&auml;ltnis, haarfarbemittel, einwirkzeit, farbformel, salonfarbe" breadcrumbs={[{ name: "Haarfarbe-Mischen", url: "/de/haarfarbe-mischen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Haarfarbe-Mischen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das perfekte Haarfarbe-Mischverh&auml;ltnis, Entwicklermenge und Einwirkzeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Farbservice-Typ</label>
          <select id="hfmde-service" class="hfmde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="permanent">Permanente Farbe</option>
            <option value="demi">Demi-Permanent</option>
            <option value="semi">Semi-Permanent</option>
            <option value="highLift">Hochtonfarbe</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Entwicklervolumen</label>
          <select id="hfmde-developer" class="hfmde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="10">10 Vol. (1 Stufe Aufhellung)</option>
            <option value="20" selected>20 Vol. (2 Stufen Aufhellung)</option>
            <option value="30">30 Vol. (3 Stufen Aufhellung)</option>
            <option value="40">40 Vol. (4 Stufen Aufhellung)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Mischverh&auml;ltnis</label>
          <select id="hfmde-ratio" class="hfmde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">1:1 (Standard)</option>
            <option value="1.5">1:1,5 (Extra Abdeckung)</option>
            <option value="2">1:2 (Hochton / Aufheller)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Farbtuben ben&ouml;tigt</label><input type="number" id="hfmde-tubes" class="hfmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0.5" max="5" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tubengr&ouml;&szlig;e (g)</label><input type="number" id="hfmde-tubesize" class="hfmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="30" max="120" step="10"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Haarl&auml;nge</label>
          <select id="hfmde-length" class="hfmde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="short">Kurz (&uuml;ber Schulter)</option>
            <option value="medium" selected>Mittel (Schulterl&auml;nge)</option>
            <option value="long">Lang (unter Schulter)</option>
            <option value="vlong">Sehr lang (Mitte R&uuml;cken+)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Mischmenge</div>
          <div class="text-5xl font-extrabold font-mono" id="hfmde-total">0 g</div>
          <div class="text-sm text-blue-200 mt-1">Farbe + Entwickler zusammen</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Farbmenge</div><div class="text-xl font-bold" id="hfmde-color">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Entwicklermenge</div><div class="text-xl font-bold" id="hfmde-dev">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einwirkzeit</div><div class="text-xl font-bold" id="hfmde-time">0 Min.</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufhellungsstufen</div><div class="text-xl font-bold" id="hfmde-lift">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Misch-Tipps</h3>
          <div class="text-sm space-y-1" id="hfmde-tips"></div>
        </div>
      </div>
      <ShareButton calculatorId="hair-color-mixing-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haarfarbe richtig mischen</h2>
      <p>Das korrekte Mischverh&auml;ltnis ist entscheidend f&uuml;r gleichm&auml;&szlig;ige, professionelle Ergebnisse. Standard-Permanentfarbe verwendet ein 1:1-Verh&auml;ltnis mit 20-Vol.-Entwickler f&uuml;r bis zu 2 Stufen Aufhellung.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welches Mischverh&auml;ltnis bei Hochtonfarbe?</strong> 1:2 (Farbe:Entwickler) mit 30 oder 40 Vol.</p>
      <p><strong>Wie messe ich genau?</strong> Verwenden Sie eine K&uuml;chenwaage f&uuml;r die beste Genauigkeit. Mischen Sie in einer nicht-metallischen Schale.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcHFMDE() {
      const service = (document.getElementById('hfmde-service') as HTMLSelectElement).value;
      const developer = parseInt((document.getElementById('hfmde-developer') as HTMLSelectElement).value);
      const ratio = parseFloat((document.getElementById('hfmde-ratio') as HTMLSelectElement).value);
      const tubes = parseFloat((document.getElementById('hfmde-tubes') as HTMLInputElement).value) || 1;
      const tubeSize = parseFloat((document.getElementById('hfmde-tubesize') as HTMLInputElement).value) || 60;
      const length = (document.getElementById('hfmde-length') as HTMLSelectElement).value;

      const colorAmount = tubes * tubeSize;
      const devAmount = colorAmount * ratio;
      const totalMix = colorAmount + devAmount;

      let liftLevels = 0;
      if (developer === 10) liftLevels = 1;
      else if (developer === 20) liftLevels = 2;
      else if (developer === 30) liftLevels = 3;
      else if (developer === 40) liftLevels = 4;

      let processTime = 35;
      if (service === 'permanent') processTime = 35;
      else if (service === 'demi') processTime = 20;
      else if (service === 'semi') processTime = 20;
      else if (service === 'highLift') processTime = 50;
      if (developer >= 30) processTime += 5;
      if (developer >= 40) processTime += 5;

      let lengthMultiplier = 1;
      if (length === 'short') lengthMultiplier = 0.5;
      else if (length === 'long') lengthMultiplier = 1.5;
      else if (length === 'vlong') lengthMultiplier = 2;

      const tips: string[] = [];
      if (service === 'permanent') tips.push('Zuerst auf den Ansatz auftragen, dann in den letzten 10 Minuten durch die L\u00E4ngen ziehen.');
      if (service === 'demi') tips.push('Ohne Ammoniak \u2013 ideal zum Mischen von Graut\u00F6nen oder zum T\u00F6nen.');
      if (service === 'semi') tips.push('F\u00FCr die meisten Semi-Permanentfarben wird kein Entwickler ben\u00F6tigt.');
      if (service === 'highLift') tips.push('Funktioniert am besten auf nat\u00FCrlichem, ungef\u00E4rbtem Haar ab Stufe 7+.');
      if (developer >= 30) tips.push('Genau beobachten \u2013 h\u00F6heres Entwicklervolumen kann Sch\u00E4den verursachen.');
      tips.push('Empfohlene Tuben f\u00FCr diese L\u00E4nge: ' + Math.ceil(lengthMultiplier) + '\u2013' + Math.ceil(lengthMultiplier * 1.5));
      tips.push('In einer nicht-metallischen Schale mit einem F\u00E4rbepinsel mischen.');

      document.getElementById('hfmde-total')!.textContent = Math.round(totalMix) + ' g';
      document.getElementById('hfmde-color')!.textContent = Math.round(colorAmount) + ' g';
      document.getElementById('hfmde-dev')!.textContent = Math.round(devAmount) + ' g';
      document.getElementById('hfmde-time')!.textContent = processTime + ' Min.';
      document.getElementById('hfmde-lift')!.textContent = liftLevels.toString();
      document.getElementById('hfmde-tips')!.innerHTML = tips.map(t => '<p>' + t + '</p>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hfmde-in').forEach(el => { el.addEventListener('input', calcHFMDE); el.addEventListener('change', calcHFMDE); });
      calcHFMDE();
    }, 50);
  </script>
</CalculatorLayout>
