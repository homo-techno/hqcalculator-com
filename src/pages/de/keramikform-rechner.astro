---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Keramikform-Rechner - Gips-Wasser-Verhaeltnis nach Gewicht";
const description = "Berechnen Sie Gipsform-Mischverhaeltnisse (Wasser zu Gips nach Gewicht) fuer keramische Schlickergiessformen. Verschiedene Gipstypen und Formgroessen.";
const relatedCalcs = [
  { name: "Keramikfaser-Rechner", url: "/de/keramikfaser-rechner", description: "Ofenisolierung." },
  { name: "Keramikanalyse-Rechner", url: "/de/keramikanalyse-rechner", description: "Scherbenanalyse." },
  { name: "Fliesengewicht-Rechner", url: "/de/fliesengewicht-rechner", description: "Fliesengewicht." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
  { name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner", description: "Statistik." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Keramikform-Rechner" enSlug="ceramic-mold-calculator" keywords="Gipsform, Gipsverhaeltnis, Wasser-Gips-Verhaeltnis, Keramikform, Schlickerguss, Formenbau" breadcrumbs={[{ name: "Keramikform-Rechner", url: "/de/keramikform-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Keramikform-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie praezise Gips-Wasser-Verhaeltnisse fuer Keramikformen. Erzielen Sie die richtige Konsistenz fuer haltbare, saugfaehige Formen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Gipstyp</label>
        <select id="km-type" class="km-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="pottery" selected>Toepfergips Nr. 1</option>
          <option value="hydrocal">Hydrocal (Weiss)</option>
          <option value="hydrostone">Hydrostone</option>
          <option value="moulding">Modellgips</option>
          <option value="custom">Individuelles Verhaeltnis</option>
        </select>
      </div>
      <div id="km-custom-ratio" class="mb-5 hidden">
        <label class="block text-sm font-medium text-text mb-2">Gipskonsistenz (kg Gips pro 100 Teile Wasser)</label>
        <input type="number" id="km-ratio" class="km-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="73" min="40" max="120" step="1">
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Formvolumen-Methode</label>
        <select id="km-method" class="km-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="volume" selected>Volumen direkt eingeben</option>
          <option value="box">Rechteckiger Formkasten</option>
          <option value="cylinder">Zylindrische Form</option>
        </select>
      </div>
      <div id="km-vol-input" class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Formvolumen (cm³)</label>
        <input type="number" id="km-vol" class="km-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3200" min="1" step="100">
      </div>
      <div id="km-box-input" class="mb-5 hidden">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Laenge (cm)</label><input type="number" id="km-bl" class="km-in w-full px-3 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="km-bw" class="km-in w-full px-3 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hoehe (cm)</label><input type="number" id="km-bh" class="km-in w-full px-3 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" step="1"></div>
        </div>
      </div>
      <div id="km-cyl-input" class="mb-5 hidden">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Durchmesser (cm)</label><input type="number" id="km-cd" class="km-in w-full px-3 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hoehe (cm)</label><input type="number" id="km-ch" class="km-in w-full px-3 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="1" step="1"></div>
        </div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gips benoetigt</div>
        <div class="text-4xl font-extrabold" id="km-plaster">--</div>
        <div class="text-sm text-blue-200 mt-1" id="km-plaster-note">--</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser benoetigt</div><div class="text-xl font-bold" id="km-water">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-xl font-bold" id="km-total">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Formvolumen</div><div class="text-xl font-bold" id="km-volume">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abbindezeit</div><div class="text-xl font-bold" id="km-settime">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <h3 class="font-semibold text-sm text-text mb-2">Mischanleitung</h3>
        <p class="text-xs text-text-muted" id="km-instructions">--</p>
      </div>
      <ShareButton lang="de" calculatorId="keramikform" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gipsformenmischung</h2>
      <p>Das korrekte Gips-Wasser-Verhaeltnis ist entscheidend fuer die Formqualitaet. Zu viel Gips ergibt eine dichte, harte Form mit schlechter Saugfaehigkeit. Zu wenig Gips ergibt eine schwache, weiche Form. Toepfergips Nr. 1 im Standard-Verhaeltnis 73:100 bietet die beste Balance fuer den Schlickerguss.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Mischschritte</h3>
      <ul>
        <li>Immer Gips zum Wasser geben (nie Wasser zum Gips)</li>
        <li>Gips ueber 2-3 Minuten auf die Wasseroberflaeche sieben</li>
        <li>Gips 1-2 Minuten einweichen lassen</li>
        <li>2-3 Minuten vorsichtig mit Hand oder Mixer ruehren</li>
        <li>Giessen, wenn die Mischung cremige Konsistenz erreicht</li>
        <li>Formkasten vibrieren oder klopfen, um Luftblasen zu entfernen</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKM() {
      const plasterType = (document.getElementById('km-type') as HTMLSelectElement).value;
      const method = (document.getElementById('km-method') as HTMLSelectElement).value;
      document.getElementById('km-custom-ratio')!.classList.toggle('hidden', plasterType !== 'custom');
      document.getElementById('km-vol-input')!.classList.toggle('hidden', method !== 'volume');
      document.getElementById('km-box-input')!.classList.toggle('hidden', method !== 'box');
      document.getElementById('km-cyl-input')!.classList.toggle('hidden', method !== 'cylinder');
      const ratios: Record<string, {ratio: number, setMin: number}> = {
        pottery: { ratio: 73, setMin: 25 },
        hydrocal: { ratio: 45, setMin: 20 },
        hydrostone: { ratio: 32, setMin: 17 },
        moulding: { ratio: 67, setMin: 27 },
        custom: { ratio: parseFloat((document.getElementById('km-ratio') as HTMLInputElement).value) || 73, setMin: 25 }
      };
      const pd = ratios[plasterType] || ratios['pottery'];
      let vol = 0;
      if (method === 'volume') {
        vol = parseFloat((document.getElementById('km-vol') as HTMLInputElement).value) || 3200;
      } else if (method === 'box') {
        const l = parseFloat((document.getElementById('km-bl') as HTMLInputElement).value) || 25;
        const w = parseFloat((document.getElementById('km-bw') as HTMLInputElement).value) || 15;
        const h = parseFloat((document.getElementById('km-bh') as HTMLInputElement).value) || 10;
        vol = l * w * h;
      } else {
        const d = parseFloat((document.getElementById('km-cd') as HTMLInputElement).value) || 20;
        const h = parseFloat((document.getElementById('km-ch') as HTMLInputElement).value) || 15;
        vol = Math.PI * (d / 2) * (d / 2) * h;
      }
      // Per 100g water: water vol = 100cm³, plaster vol = R/2.34 cm³
      const waterVolPerUnit = 100; // cm³ per 100g water
      const plasterVolPerUnit = pd.ratio / 2.34; // cm³ per R g plaster
      const mixVolPerUnit = waterVolPerUnit + plasterVolPerUnit;
      const scaleFactor = vol / mixVolPerUnit;
      const waterG = 100 * scaleFactor;
      const plasterG = pd.ratio * scaleFactor;
      const totalG = waterG + plasterG;
      document.getElementById('km-plaster')!.textContent = (plasterG / 1000).toFixed(2) + ' kg';
      document.getElementById('km-plaster-note')!.textContent = plasterType !== 'custom' ?
        plasterType.charAt(0).toUpperCase() + plasterType.slice(1) + ' im Verhaeltnis ' + pd.ratio + ':100' :
        'Individuelles Verhaeltnis ' + pd.ratio + ':100';
      document.getElementById('km-water')!.textContent = (waterG / 1000).toFixed(2) + ' kg (' + (waterG / 1000).toFixed(2) + ' L)';
      document.getElementById('km-total')!.textContent = (totalG / 1000).toFixed(2) + ' kg';
      document.getElementById('km-volume')!.textContent = vol.toFixed(0) + ' cm\u00B3';
      document.getElementById('km-settime')!.textContent = '~' + pd.setMin + ' Min.';
      document.getElementById('km-instructions')!.textContent =
        (waterG / 1000).toFixed(2) + ' L Wasser in einen sauberen Behaelter messen. ' +
        'Langsam ' + (plasterG / 1000).toFixed(2) + ' kg Gips ueber 2-3 Minuten auf die Wasseroberflaeche sieben. ' +
        '1-2 Minuten einweichen lassen, dann 2-3 Minuten glatt ruehren. ' +
        'In die vorbereitete Form giessen. Abbindezeit: ca. ' + pd.setMin + ' Minuten.';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.km-in').forEach(el => { el.addEventListener('input', calcKM); el.addEventListener('change', calcKM); });
      calcKM();
    }, 50);
  </script>
</CalculatorLayout>
