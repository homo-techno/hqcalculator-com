---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Tragfähigkeit-Rechner – Bevölkerungskapazität berechnen";
const description = "Berechnen Sie die Tragfähigkeit von Land für antike Bevölkerungen basierend auf Subsistenzstrategie, Ackerfläche, Ernteertrag und Kalorienbedarf.";
const relatedCalcs = [
  { name: "Rindergewicht-Rechner", url: "/de/rindergewicht-rechner", description: "Rindergewicht." },
  { name: "Katzenfutter-Rechner", url: "/de/katzenfutter-rechner", description: "Katzenfutter." },
  { name: "Catering-Mengen-Rechner", url: "/de/catering-mengen-rechner", description: "Catering." },
  { name: "Kubikmeter-Rechner", url: "/de/kubikmeter-rechner", description: "Volumen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Tragfähigkeit-Rechner" enSlug="carrying-capacity-calculator" keywords="Tragfähigkeit, Bevölkerungskapazität, antike Bevölkerung, Subsistenz, Ernteertrag, Archäologie" breadcrumbs={[{ name: "Tragfähigkeit-Rechner", url: "/de/tragfaehigkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Tragfähigkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie, wie viele Menschen eine bestimmte Landfläche unter verschiedenen Subsistenzstrategien ernähren konnte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Subsistenzstrategie</label>
          <select id="tfr-strategy" class="tfr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="hg">Jäger und Sammler</option>
            <option value="hort">Gartenbau (Brandrodung)</option>
            <option value="agri" selected>Regenfeldbau</option>
            <option value="irrig">Bewässerungslandwirtschaft</option>
            <option value="pastoral">Pastorale Nomaden</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Gesamtfläche (km²)</label><input type="number" id="tfr-area" class="tfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Anteil Ackerland (%)</label><input type="number" id="tfr-arable" class="tfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="100" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Ernteertrag (kg/Hektar/Jahr)</label><input type="number" id="tfr-yield" class="tfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="10" step="10">
          <p class="text-xs text-text-muted mt-1">Typisch antik: Weizen 500-1000, Reis 1000-2000, Mais 600-1200</p>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Kalorischer Wert (kcal/kg)</label><input type="number" id="tfr-calkg" class="tfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="100" step="100">
          <p class="text-xs text-text-muted mt-1">Weizen ~3400, Reis ~3600, Mais ~3650, Kartoffel ~770</p>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Täglicher Kalorienbedarf (kcal/Person)</label><input type="number" id="tfr-daily" class="tfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1500" max="4000" step="100"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Brachefaktor (% der Fläche brach)</label><input type="number" id="tfr-fallow" class="tfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="90" step="1"></div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Maximale Tragfähigkeit</div>
          <div class="text-4xl font-extrabold" id="tfr-pop">0</div>
          <div class="text-sm text-blue-200 mt-1">Personen</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effektive Ackerfläche</div><div class="text-xl font-bold" id="tfr-effland">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bevölkerungsdichte</div><div class="text-xl font-bold" id="tfr-density">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahresproduktion</div><div class="text-xl font-bold" id="tfr-production">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien pro Jahr</div><div class="text-xl font-bold" id="tfr-totalcal">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ha pro Person</div><div class="text-xl font-bold" id="tfr-happ">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nachhaltige Bev. (80%)</div><div class="text-xl font-bold" id="tfr-sustain">0</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="carrying-capacity" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Tragfähigkeit-Formeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Effektives Land</strong> = Gesamtfläche * (Ackerland% / 100) * (1 - Brache% / 100)</p>
        <p><strong>Jahresproduktion</strong> = Effektive ha * Ertrag (kg/ha)</p>
        <p><strong>Gesamtkalorien</strong> = Produktion * kcal/kg</p>
        <p><strong>Max. Bevölkerung</strong> = Gesamtkalorien / (Tagesbedarf * 365)</p>
      </div>
      <p>Jäger und Sammler konnten typischerweise 0,01-1 Person/km² ernähren, während intensive Landwirtschaft 50-200+ Personen/km² ermöglichte.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcTFR() {
      const strategy = (document.getElementById('tfr-strategy') as HTMLSelectElement).value;
      const areaSqKm = parseFloat((document.getElementById('tfr-area') as HTMLInputElement).value) || 0;
      const arablePct = parseFloat((document.getElementById('tfr-arable') as HTMLInputElement).value) || 0;
      const yieldKgHa = parseFloat((document.getElementById('tfr-yield') as HTMLInputElement).value) || 0;
      const calPerKg = parseFloat((document.getElementById('tfr-calkg') as HTMLInputElement).value) || 0;
      const dailyCal = parseFloat((document.getElementById('tfr-daily') as HTMLInputElement).value) || 2200;
      const fallowPct = parseFloat((document.getElementById('tfr-fallow') as HTMLInputElement).value) || 0;
      const areaHa = areaSqKm * 100;
      const arableHa = areaHa * (arablePct / 100);
      const effectiveHa = arableHa * (1 - fallowPct / 100);
      let maxPop = 0;
      if (strategy === 'hg') { maxPop = areaSqKm * 0.1; }
      else if (strategy === 'pastoral') { maxPop = areaSqKm * 2; }
      else {
        const totalProduction = effectiveHa * yieldKgHa;
        const totalCalories = totalProduction * calPerKg;
        const annualNeed = dailyCal * 365;
        maxPop = annualNeed > 0 ? totalCalories / annualNeed : 0;
      }
      const totalProduction = effectiveHa * yieldKgHa;
      const totalCalories = totalProduction * calPerKg;
      const density = areaSqKm > 0 ? maxPop / areaSqKm : 0;
      const haPerPerson = maxPop > 0 ? effectiveHa / maxPop : 0;
      const sustainPop = maxPop * 0.8;
      let prodStr = '';
      if (totalProduction >= 1e6) prodStr = (totalProduction / 1e6).toFixed(1) + ' Mio. kg';
      else if (totalProduction >= 1000) prodStr = (totalProduction / 1000).toFixed(1) + 'k kg';
      else prodStr = totalProduction.toFixed(0) + ' kg';
      let calStr = '';
      if (totalCalories >= 1e9) calStr = (totalCalories / 1e9).toFixed(1) + ' Mrd. kcal';
      else if (totalCalories >= 1e6) calStr = (totalCalories / 1e6).toFixed(1) + ' Mio. kcal';
      else calStr = Math.round(totalCalories).toLocaleString('de-DE') + ' kcal';
      document.getElementById('tfr-pop')!.textContent = Math.round(maxPop).toLocaleString('de-DE');
      document.getElementById('tfr-effland')!.textContent = effectiveHa.toFixed(0) + ' ha';
      document.getElementById('tfr-density')!.textContent = density.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' /km²';
      document.getElementById('tfr-production')!.textContent = prodStr;
      document.getElementById('tfr-totalcal')!.textContent = calStr;
      document.getElementById('tfr-happ')!.textContent = haPerPerson.toFixed(2);
      document.getElementById('tfr-sustain')!.textContent = Math.round(sustainPop).toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('tfr-area') as HTMLInputElement).value = '100';
      (document.getElementById('tfr-arable') as HTMLInputElement).value = '40';
      (document.getElementById('tfr-yield') as HTMLInputElement).value = '800';
      (document.getElementById('tfr-calkg') as HTMLInputElement).value = '3400';
      (document.getElementById('tfr-daily') as HTMLInputElement).value = '2200';
      (document.getElementById('tfr-fallow') as HTMLInputElement).value = '33';
      document.querySelectorAll('.tfr-in').forEach(el => { el.addEventListener('input', calcTFR); el.addEventListener('change', calcTFR); });
      calcTFR();
    }, 50);
  </script>
</CalculatorLayout>
