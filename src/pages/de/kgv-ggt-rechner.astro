---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "kgV / ggT Rechner";
const description = "Berechnen Sie das kleinste gemeinsame Vielfache (kgV) und den größten gemeinsamen Teiler (ggT).";

const relatedCalcs = [
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert berechnen." },
  { name: "Lernkurvenrechner", url: "/de/lernkurven-rechner", description: "Lernkurven analysieren." },
  { name: "LED-Widerstand Rechner", url: "/de/led-widerstand-rechner", description: "Vorwiderstand berechnen." },
  { name: "Sprachlernrechner", url: "/de/sprachlern-rechner", description: "Lernzeit berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="kgV / ggT Rechner" lang="de" enSlug="lcm-gcf-calculator" keywords="kgv rechner, ggt rechner, kleinstes gemeinsames vielfaches, größter gemeinsamer teiler" breadcrumbs={[{ name: "kgV / ggT Rechner", url: "/de/kgv-ggt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">kgV / ggT Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das kleinste gemeinsame Vielfache (kgV) und den größten gemeinsamen Teiler (ggT) für bis zu vier Zahlen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zahl 1</label><input type="number" id="kgv-a" class="kgv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zahl 2</label><input type="number" id="kgv-b" class="kgv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zahl 3 (optional)</label><input type="number" id="kgv-c" class="kgv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" placeholder="z. B. 24" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zahl 4 (optional)</label><input type="number" id="kgv-d" class="kgv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" placeholder="z. B. 30" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">kgV</div>
            <div class="text-4xl font-extrabold font-mono" id="kgv-lcm">0</div>
          </div>
          <div class="p-6 bg-green-600 rounded-2xl text-white text-center">
            <div class="text-sm text-green-200 uppercase tracking-wide mb-1">ggT</div>
            <div class="text-4xl font-extrabold font-mono" id="kgv-gcd">0</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Primfaktorzerlegung</div>
          <div class="text-sm font-mono" id="kgv-factors">–</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Teiler von ggT</div>
          <div class="text-sm font-mono" id="kgv-divisors">–</div>
        </div>
      </div>
      <ShareButton calculatorId="lcm-gcf-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">kgV und ggT – Grundbegriffe der Zahlentheorie</h2>
      <p>Der größte gemeinsame Teiler (ggT) zweier oder mehrerer natürlicher Zahlen ist die größte Zahl, durch die alle Zahlen ohne Rest teilbar sind. Das kleinste gemeinsame Vielfache (kgV) ist die kleinste positive Zahl, die ein Vielfaches aller Eingabezahlen ist. Beide Größen sind grundlegend für das Kürzen von Brüchen, die Berechnung von Rhythmen und zahlreiche andere mathematische Anwendungen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>ggT(a,b):</strong> Euklidischer Algorithmus – ggT(a,b) = ggT(b, a mod b)</p>
        <p><strong>kgV(a,b):</strong> kgV(a,b) = |a × b| / ggT(a,b)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wofür braucht man den ggT?</strong> Der ggT wird zum Kürzen von Brüchen benötigt: Zähler und Nenner werden durch ihren ggT dividiert, um den Bruch auf seine kleinste Form zu bringen.</p>
      <p><strong>Wofür braucht man das kgV?</strong> Das kgV wird zum Addieren von Brüchen mit unterschiedlichen Nennern benötigt. Man findet den Hauptnenner, indem man das kgV der Nenner berechnet.</p>
      <p><strong>Was ist der Unterschied zwischen Teiler und Vielfachem?</strong> Teiler sind Zahlen, durch die eine Zahl ohne Rest teilbar ist (Teiler von 12: 1, 2, 3, 4, 6, 12). Vielfache sind Produkte einer Zahl (Vielfache von 4: 4, 8, 12, 16, ...).</p>
      <p><strong>Gilt kgV × ggT = a × b immer?</strong> Ja, für zwei Zahlen a und b gilt stets: kgV(a,b) × ggT(a,b) = a × b. Diese Beziehung vereinfacht die Berechnung erheblich.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function gcd(a: number, b: number): number { return b === 0 ? a : gcd(b, a % b); }
    function lcm(a: number, b: number): number { return a / gcd(a, b) * b; }
    function primeFactors(n: number): number[] {
      const factors: number[] = [];
      let d = 2;
      while (d * d <= n) { while (n % d === 0) { factors.push(d); n = Math.floor(n / d); } d++; }
      if (n > 1) factors.push(n);
      return factors;
    }
    function calcKGV() {
      const vals: number[] = [];
      ['kgv-a','kgv-b','kgv-c','kgv-d'].forEach(id => {
        const v = parseInt((document.getElementById(id) as HTMLInputElement).value);
        if (v && v > 0) vals.push(v);
      });
      if (vals.length < 2) return;
      let g = vals[0], l = vals[0];
      for (let i = 1; i < vals.length; i++) { g = gcd(g, vals[i]); l = lcm(l, vals[i]); }
      document.getElementById('kgv-lcm')!.textContent = l.toLocaleString('de-DE');
      document.getElementById('kgv-gcd')!.textContent = g.toLocaleString('de-DE');
      const factorStrs = vals.map(v => v + ' = ' + (primeFactors(v).join(' × ') || '1'));
      document.getElementById('kgv-factors')!.textContent = factorStrs.join('\n');
      const divisors: number[] = [];
      for (let i = 1; i <= g; i++) { if (g % i === 0) divisors.push(i); }
      document.getElementById('kgv-divisors')!.textContent = divisors.join(', ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.kgv-in').forEach(el => { el.addEventListener('input', calcKGV); el.addEventListener('change', calcKGV); }); calcKGV(); }, 50);
  </script>
</CalculatorLayout>
