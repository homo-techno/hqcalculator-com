---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Baby-Meilensteinrechner - Entwicklungsmeilensteine nach Alter";
const description = "Verfolgen Sie die erwarteten Entwicklungsmeilensteine Ihres Babys nach Alter in Monaten. Motorik, Sprache, soziale und kognitive Meilensteine von der Geburt bis 36 Monate.";

const relatedCalcs = [
  { name: "Kindergrößenrechner", url: "/de/kindergroesse-rechner", description: "Größenvorhersage." },
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI-Perzentilen." },
  { name: "Babynahrungsrechner", url: "/de/babynahrung-rechner", description: "Nahrungsbedarf." },
  { name: "Töpfchentraining-Rechner", url: "/de/toepfchentraining-rechner", description: "Bereitschaft fürs Töpfchen." },
  { name: "Windelkosten-Rechner", url: "/de/windelkosten-rechner", description: "Windelausgaben." },
  { name: "Kinderernährungsrechner", url: "/de/kinderernaehrung-rechner", description: "Ernährungsbedarf." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Baby-Meilensteinrechner"
  keywords="Baby Meilenstein Rechner, Entwicklungsmeilensteine, Babyentwicklung nach Monat, Säugling Meilensteine, Kindesentwicklung, wann krabbelt Baby"
  breadcrumbs={[{ name: "Baby-Meilensteinrechner", url: "/de/baby-meilenstein-rechner" }]}
  lang="de"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Baby-Meilensteinrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sehen Sie, welche Entwicklungsmeilensteine in diesem Alter zu erwarten sind und was als Nächstes kommt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Alter des Babys (Monate)</label>
          <input type="number" id="bml-age" class="bml-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0" max="36" step="1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Oder Geburtsdatum eingeben</label>
          <input type="date" id="bml-birth" class="bml-in w-full px-4 py-3 border border-border rounded-xl text-lg">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Entwicklungsstufe</div>
        <div class="text-3xl font-extrabold" id="bml-stage">--</div>
        <div class="text-sm text-blue-200 mt-1" id="bml-agetext">Altersdetails</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Motorik</div>
          <div class="text-lg font-bold" id="bml-motor">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Sprache</div>
          <div class="text-lg font-bold" id="bml-language">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Sozial/Emotional</div>
          <div class="text-lg font-bold" id="bml-social">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Kognitiv</div>
          <div class="text-lg font-bold" id="bml-cognitive">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <h3 class="font-semibold text-sm text-text mb-3">Aktuelle Meilensteine</h3>
        <div class="text-sm" id="bml-current"></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Was als Nächstes kommt</h3>
        <div class="text-sm" id="bml-upcoming"></div>
      </div>

      <ShareButton calculatorId="baby-milestone" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Entwicklungsmeilensteine verstehen</h2>
      <p>Meilensteine sind Verhaltensweisen oder körperliche Fähigkeiten, die bei Säuglingen und Kindern im Laufe ihres Wachstums beobachtet werden. Jedes Kind entwickelt sich in seinem eigenen Tempo, und es gibt eine große Bandbreite des Normalen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Wichtige Meilenstein-Kategorien</h3>
      <ul>
        <li><strong>Grobmotorik:</strong> Große Bewegungen wie Drehen, Sitzen, Krabbeln, Laufen</li>
        <li><strong>Feinmotorik:</strong> Kleine Bewegungen wie Greifen, Kneifen, Zeichnen</li>
        <li><strong>Sprache:</strong> Brabbeln, erste Worte, Sätze, Verständnis</li>
        <li><strong>Sozial/Emotional:</strong> Lächeln, Bindung, Spiel, Empathie</li>
        <li><strong>Kognitiv:</strong> Problemlösung, Gedächtnis, Neugier, Fantasie</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Wann Sie Ihren Arzt konsultieren sollten</h3>
      <p>Sprechen Sie mit Ihrem Kinderarzt, wenn Ihr Kind Meilensteine nicht im erwarteten Zeitrahmen erreicht, bereits erlernte Fähigkeiten verliert oder wenn Sie Bedenken bezüglich seiner Entwicklung haben.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBML() {
      let age = parseFloat((document.getElementById('bml-age') as HTMLInputElement).value) || 0;
      const birthInput = (document.getElementById('bml-birth') as HTMLInputElement).value;

      if (birthInput) {
        const birth = new Date(birthInput);
        const now = new Date();
        const diffMs = now.getTime() - birth.getTime();
        const calcAge = diffMs / (1000 * 60 * 60 * 24 * 30.44);
        if (calcAge >= 0 && calcAge <= 36) {
          age = Math.floor(calcAge);
          (document.getElementById('bml-age') as HTMLInputElement).value = String(age);
        }
      }

      interface MilestoneSet {
        stage: string;
        motor: string;
        language: string;
        social: string;
        cognitive: string;
        details: string[];
        upcoming: string[];
      }

      const milestones: Record<number, MilestoneSet> = {
        0: {
          stage: 'Neugeborenes',
          motor: 'Nur Reflexe', language: 'Schreien', social: 'Bevorzugt Gesichter', cognitive: 'Erschrickt bei Geräuschen',
          details: ['Hebt kurz den Kopf in Bauchlage', 'Greift reflexartig nach dem Finger', 'Verfolgt Objekte kurz', 'Reagiert auf laute Geräusche'],
          upcoming: ['Soziales Lächeln (ca. 2 Monate)', 'Bessere Kopfkontrolle', 'Gurrlaute', 'Gleichmäßiges Verfolgen von Objekten']
        },
        2: {
          stage: 'Frühes Säuglingsalter',
          motor: 'Hebt den Kopf', language: 'Gurren', social: 'Soziales Lächeln', cognitive: 'Folgt Objekten',
          details: ['Hält Kopf in Bauchlage hoch', 'Macht gurrende und gluckende Geräusche', 'Lächelt Menschen an', 'Beginnt Dingen mit den Augen zu folgen'],
          upcoming: ['Umdrehen (4-6 Monate)', 'Lachen', 'Nach Spielzeug greifen', 'Bekannte Personen erkennen']
        },
        4: {
          stage: 'Aktiver Säugling',
          motor: 'Dreht sich um', language: 'Brabbeln beginnt', social: 'Lacht', cognitive: 'Greift nach Spielzeug',
          details: ['Dreht sich vom Bauch auf den Rücken', 'Führt Hände zum Mund', 'Brabbelt mit Ausdruck', 'Spielt gerne mit Menschen', 'Greift mit einer Hand nach Spielzeug'],
          upcoming: ['Sitzen ohne Unterstützung', 'Fremdeln', 'Reagiert auf eigenen Namen', 'Gegenstände von Hand zu Hand wechseln']
        },
        6: {
          stage: 'Sitzphase',
          motor: 'Sitzt mit Hilfe', language: 'Reagiert auf Namen', social: 'Fremdeln beginnt', cognitive: 'Erkundet mit dem Mund',
          details: ['Sitzt mit Unterstützung, sitzt evtl. kurz allein', 'Reagiert auf eigenen Namen', 'Reiht Vokale aneinander (ah, eh, oh)', 'Schaut sich gern im Spiegel an', 'Nimmt Dinge zum Erkunden in den Mund'],
          upcoming: ['Krabbeln (7-10 Monate)', 'Erste Worte', 'Zum Stehen hochziehen', 'Pinzettengriff', 'Klatschen']
        },
        9: {
          stage: 'Mobile Phase',
          motor: 'Krabbeln', language: 'Mama/Papa-Laute', social: 'Trennungsangst', cognitive: 'Objektpermanenz',
          details: ['Krabbelt oder rutscht', 'Zieht sich zum Stehen hoch', 'Verwendet Pinzettengriff', 'Sagt evtl. Mama/Papa (unspezifisch)', 'Versteht "Nein"', 'Zeigt auf Gegenstände'],
          upcoming: ['Laufen (10-15 Monate)', 'Erste echte Worte', 'Winken zum Abschied', 'Bauklötze stapeln']
        },
        12: {
          stage: 'Kleinkind-Anfänge',
          motor: 'Entlanghangeln/Erste Schritte', language: '1-3 Worte', social: 'Winkt Tschüss', cognitive: 'Benutzt Gegenstände richtig',
          details: ['Macht erste Schritte oder geht an Möbeln entlang', 'Sagt 1-3 Worte', 'Winkt Tschüss', 'Folgt einfachen Anweisungen', 'Benutzt Becher', 'Erkundet Gegenstände auf verschiedene Weisen'],
          upcoming: ['Gut laufen (15 Monate)', 'Wortschatzexplosion', 'Rennen', 'Mehr Bauklötze stapeln', 'Selbst essen']
        },
        18: {
          stage: 'Aktives Kleinkind',
          motor: 'Läuft gut', language: '10-20 Worte', social: 'Parallelspiel', cognitive: 'Zeigt auf Körperteile',
          details: ['Läuft selbstständig', 'Sagt 10-20 Worte', 'Zeigt auf Dinge', 'Spielt einfach Rollenspiele', 'Kritzelt', 'Kann einfache Anweisungen befolgen'],
          upcoming: ['Rennen (20-24 Monate)', '2-Wort-Sätze', 'Klettern', 'Formen sortieren', 'Töpfchen-Interesse']
        },
        24: {
          stage: 'Sprechendes Kleinkind',
          motor: 'Rennt und klettert', language: '50+ Worte, 2-Wort-Sätze', social: 'Spielt neben anderen', cognitive: 'Sortiert Formen und Farben',
          details: ['Rennt und tritt einen Ball', 'Spricht 50+ Worte', 'Verwendet 2-Wort-Sätze', 'Folgt 2-Schritt-Anweisungen', 'Beginnt Rollenspiele', 'Sortiert Formen und Farben'],
          upcoming: ['Dreirad fahren', 'Ganze Sätze', 'Zählen', 'MIT anderen spielen', 'Sich selbst anziehen']
        },
        30: {
          stage: 'Vorschulreif',
          motor: 'Springt, wirft', language: 'Kurze Sätze', social: 'Abwechseln', cognitive: 'Zählt bis 3',
          details: ['Springt mit beiden Füßen', 'Spricht in 3-4-Wort-Sätzen', 'Folgt 2-3-Schritt-Anweisungen', 'Beginnt mit anderen Kindern zu spielen', 'Benennt einige Farben', 'Zählt bis 3'],
          upcoming: ['Gut Dreirad fahren', 'Geschichten erzählen', 'Formen zeichnen', 'Kooperatives Spiel', 'Namen schreiben']
        },
        36: {
          stage: 'Vorschulkind',
          motor: 'Fährt Dreirad', language: 'Ganze Sätze', social: 'Kooperatives Spiel', cognitive: 'Versteht Geschichten',
          details: ['Fährt Dreirad', 'Spricht deutlich in Sätzen', 'Zeichnet Kreise', 'Spielt kooperativ', 'Versteht "mein" und "dein"', 'Zählt bis 10'],
          upcoming: ['Buchstaben schreiben', 'Komplexe Rollenspiele', 'Detaillierte Geschichten erzählen', 'Zeitkonzepte verstehen']
        }
      };

      const ages = Object.keys(milestones).map(Number).sort((a, b) => a - b);
      let matchAge = 0;
      for (const a of ages) {
        if (age >= a) matchAge = a;
      }

      const m = milestones[matchAge];
      const nextAge = ages.find(a => a > matchAge);
      const nextM = nextAge !== undefined ? milestones[nextAge] : null;

      document.getElementById('bml-stage')!.textContent = m.stage;
      document.getElementById('bml-agetext')!.textContent = age + ' Monate alt';
      document.getElementById('bml-motor')!.textContent = m.motor;
      document.getElementById('bml-language')!.textContent = m.language;
      document.getElementById('bml-social')!.textContent = m.social;
      document.getElementById('bml-cognitive')!.textContent = m.cognitive;

      document.getElementById('bml-current')!.innerHTML = m.details.map(d =>
        '<div class="flex items-start gap-2 py-1"><span class="text-primary font-bold mt-0.5">&#10003;</span><span>' + d + '</span></div>'
      ).join('');

      const upcomingItems = nextM ? nextM.details.slice(0, 4) : m.upcoming;
      document.getElementById('bml-upcoming')!.innerHTML = upcomingItems.map(d =>
        '<div class="flex items-start gap-2 py-1"><span class="text-text-muted font-bold mt-0.5">&#9675;</span><span>' + d + '</span></div>'
      ).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bml-in').forEach(el => {
        el.addEventListener('input', calcBML);
        el.addEventListener('change', calcBML);
      });
      calcBML();
    }, 50);
  </script>
</CalculatorLayout>
