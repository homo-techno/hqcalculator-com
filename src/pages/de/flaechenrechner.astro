---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Flächenrechner - Fläche von 2D-Formen berechnen";
const description = "Berechnen Sie Fläche und Umfang von Rechtecken, Kreisen, Dreiecken, Trapezen, Ellipsen und Parallelogrammen.";
const relatedCalcs = [
  { name: "Quadratmeter", url: "/square-footage-calculator", description: "Quadratmeter." },
  { name: "Volumenrechner", url: "/volume-calculator", description: "3D-Volumen." },
  { name: "Kreisrechner", url: "/circle-calculator", description: "Kreise." },
  { name: "Dreiecksrechner", url: "/triangle-calculator", description: "Dreiecke." },
  { name: "Farbrechner", url: "/paint-calculator", description: "Farbmenge." },
  { name: "Längenumrechner", url: "/length-converter", description: "Längeneinheiten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Flächenrechner" keywords="Flächenrechner, Fläche berechnen, Rechteck Fläche, Kreis Fläche, Dreieck Fläche, 2D-Formen" lang="de" breadcrumbs={[{ name: "Flächenrechner", url: "/de/flaechenrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Flächenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Fläche und Umfang gängiger 2D-Formen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Form</label>
          <select id="ar-shape" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="rectangle">Rechteck</option>
            <option value="circle">Kreis</option>
            <option value="triangle">Dreieck</option>
            <option value="trapezoid">Trapez</option>
            <option value="ellipse">Ellipse</option>
            <option value="parallelogram">Parallelogramm</option>
          </select>
        </div>
        <div id="ar-inputs" class="space-y-3"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Fläche</div>
          <div class="text-4xl sm:text-5xl font-extrabold" id="ar-area">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umfang</div><div class="text-xl font-bold text-secondary" id="ar-perim">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Formel</div><div class="text-sm font-mono font-bold" id="ar-formula">-</div></div>
        </div>
      </div>
      <ShareButton calculatorId="area" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Flächenformeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Rechteck: A = l \u00D7 b</p>
        <p>Kreis: A = \u03C0 \u00D7 r\u00B2</p>
        <p>Dreieck: A = \u00BD \u00D7 g \u00D7 h</p>
        <p>Trapez: A = \u00BD \u00D7 (a + b) \u00D7 h</p>
        <p>Ellipse: A = \u03C0 \u00D7 a \u00D7 b</p>
      </div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const shapes: Record<string, { inputs: string[]; labels: string[]; calc: (v: number[]) => [number, number, string] }> = {
      rectangle: { inputs: ['length','width'], labels: ['L\u00E4nge','Breite'], calc: ([l,w]) => [l*w, 2*(l+w), 'A = l \u00D7 b'] },
      circle: { inputs: ['radius'], labels: ['Radius'], calc: ([r]) => [Math.PI*r*r, 2*Math.PI*r, 'A = \u03C0r\u00B2'] },
      triangle: { inputs: ['base','height'], labels: ['Grundseite','H\u00F6he'], calc: ([b,h]) => [0.5*b*h, NaN, 'A = \u00BDbh'] },
      trapezoid: { inputs: ['top','bottom','height'], labels: ['Oben (a)','Unten (b)','H\u00F6he'], calc: ([a,b,h]) => [0.5*(a+b)*h, NaN, 'A = \u00BD(a+b)h'] },
      ellipse: { inputs: ['semi_a','semi_b'], labels: ['Halbachse a','Halbachse b'], calc: ([a,b]) => [Math.PI*a*b, NaN, 'A = \u03C0ab'] },
      parallelogram: { inputs: ['base','height'], labels: ['Grundseite','H\u00F6he'], calc: ([b,h]) => [b*h, NaN, 'A = g \u00D7 h'] },
    };
    function renderInputs() {
      const shape = (document.getElementById('ar-shape') as HTMLSelectElement).value;
      const s = shapes[shape];
      document.getElementById('ar-inputs')!.innerHTML = s.inputs.map((id, i) =>
        '<div><label class="block text-xs font-medium text-text mb-1">' + s.labels[i] + '</label><input type="number" id="ar-' + id + '" class="ar-val w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="0" step="0.5"></div>'
      ).join('');
      document.querySelectorAll('.ar-val').forEach(el => el.addEventListener('input', calcArea));
      calcArea();
    }
    function calcArea() {
      const shape = (document.getElementById('ar-shape') as HTMLSelectElement).value;
      const s = shapes[shape];
      const vals = s.inputs.map(id => parseFloat((document.getElementById('ar-' + id) as HTMLInputElement).value) || 0);
      const [area, perim, formula] = s.calc(vals);
      document.getElementById('ar-area')!.textContent = area.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('ar-perim')!.textContent = isNaN(perim) ? 'N/V' : perim.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('ar-formula')!.textContent = formula;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.getElementById('ar-shape')!.addEventListener('change', renderInputs); renderInputs(); }, 50);
  </script>
</CalculatorLayout>
