---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Freiberufler-Stundensatz-Rechner - Stunden- & Tagess\u00E4tze";
const description = "Berechnen Sie den richtigen Freiberufler-Stundensatz basierend auf Wunschgehalt, abrechnungsf\u00E4higen Stunden, Gemeinkosten und Gewinnmarge.";
const relatedCalcs = [
  { name: "Gehaltsrechner", url: "/de/gehaltsrechner", description: "Gehaltsumrechnung." },
  { name: "Einkommensteuer-Rechner", url: "/de/einkommensteuer-rechner", description: "Steuersch\u00E4tzung." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budgetplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Freiberufler-Stundensatz-Rechner" lang="de" enSlug="freelance-rate-calculator" keywords="freiberufler stundensatz, tagessatz berechnen, projektsatz, freiberufler preisgestaltung, beratungshonorar" breadcrumbs={[{ name: "Freiberufler-Stundensatz", url: "/de/freiberufler-stundensatz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Freiberufler-Stundensatz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie den richtigen Stunden-, Tages- und Projektsatz f&uuml;r Ihre freiberufliche T&auml;tigkeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Gew&uuml;nschtes Jahresgehalt (&Auml;quivalent)</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="fbs-salary" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="65000" min="0" step="5000">
            </div>
            <p class="text-xs text-text-muted mt-1">Was Sie als Angestellter verdienen m&ouml;chten</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Abrechnungsf&auml;hige Stunden pro Jahr</label>
            <input type="number" id="fbs-hours" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="1200" min="100" max="2500" step="50">
            <p class="text-xs text-text-muted mt-1">Typisch: 1000-1500 (inkl. Verwaltung, Akquise, Urlaub)</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gemeinkosten / Sozialabgaben (%)</label>
            <div class="relative">
              <input type="number" id="fbs-overhead" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="30" min="0" max="100" step="5">
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted">%</span>
            </div>
            <p class="text-xs text-text-muted mt-1">Krankenversicherung, Altersvorsorge, Software, Ausstattung</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewinnmarge (%)</label>
            <div class="relative">
              <input type="number" id="fbs-profit" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="15" min="0" max="50" step="5">
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted">%</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Typische Projektstunden</label>
            <input type="number" id="fbs-project-hours" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="40" min="1" max="1000" step="5">
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Stundensatz</div>
            <div class="text-5xl font-extrabold font-mono" id="fbs-hourly">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Tagessatz (8h)</div>
              <div class="text-xl font-bold text-secondary" id="fbs-day">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Projektsatz</div>
              <div class="text-xl font-bold" id="fbs-project">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Monatlicher Umsatz</div>
              <div class="text-xl font-bold text-green-600" id="fbs-monthly">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Jahresumsatz gesamt</div>
              <div class="text-xl font-bold" id="fbs-annual">0 &euro;</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gemeinkosten + Sozialabgaben</div>
            <div class="text-xl font-bold text-orange-600" id="fbs-overhead-cost">0 &euro;/Jahr</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="freelance-rate-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">So bestimmen Sie Ihren Freiberufler-Stundensatz</h2>
      <p>Ihr Freiberufler-Stundensatz muss nicht nur Ihr Gehalts&auml;quivalent abdecken, sondern auch Gemeinkosten (Krankenversicherung, Altersvorsorge, Ausstattung, Software), Sozialabgaben, nicht abrechnungsf&auml;hige Stunden (Akquise, Verwaltung) und eine Gewinnmarge f&uuml;r Gesch&auml;ftswachstum.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viele Stunden kann ich abrechnen?</strong> Die meisten Freiberufler k&ouml;nnen nur 60-70% ihrer Arbeitszeit abrechnen. Der Rest geht f&uuml;r Kundenakquise, Verwaltung, Rechnungsstellung und Weiterbildung drauf.</p>
      <p><strong>Welcher Stundensatz ist &uuml;blich?</strong> In Deutschland liegen typische S&auml;tze f&uuml;r IT-Freiberufler bei 70-120 &euro;/h, f&uuml;r Berater bei 80-200 &euro;/h, abh&auml;ngig von Branche und Erfahrung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const fbsFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcFBS() {
      const salary = parseFloat((document.getElementById('fbs-salary') as HTMLInputElement).value) || 0;
      const hours = parseFloat((document.getElementById('fbs-hours') as HTMLInputElement).value) || 1;
      const overheadPct = (parseFloat((document.getElementById('fbs-overhead') as HTMLInputElement).value) || 0) / 100;
      const profitPct = (parseFloat((document.getElementById('fbs-profit') as HTMLInputElement).value) || 0) / 100;
      const projectHours = parseFloat((document.getElementById('fbs-project-hours') as HTMLInputElement).value) || 1;
      const overheadCost = salary * overheadPct;
      const baseCost = salary + overheadCost;
      const withProfit = baseCost * (1 + profitPct);
      const hourlyRate = withProfit / hours;
      const dayRate = hourlyRate * 8;
      const projectRate = hourlyRate * projectHours;
      const monthlyRevenue = withProfit / 12;
      document.getElementById('fbs-hourly')!.textContent = Math.round(hourlyRate).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('fbs-day')!.textContent = fbsFmt(dayRate);
      document.getElementById('fbs-project')!.textContent = fbsFmt(projectRate);
      document.getElementById('fbs-monthly')!.textContent = fbsFmt(monthlyRevenue);
      document.getElementById('fbs-annual')!.textContent = fbsFmt(withProfit);
      document.getElementById('fbs-overhead-cost')!.textContent = fbsFmt(overheadCost) + '/Jahr';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['fbs-salary', 'fbs-hours', 'fbs-overhead', 'fbs-profit', 'fbs-project-hours'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcFBS); el.addEventListener('change', calcFBS); }
      });
      calcFBS();
    }, 50);
  </script>
</CalculatorLayout>
