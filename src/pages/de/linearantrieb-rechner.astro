---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Linearantrieb Rechner – Kraft, Hub & Geschwindigkeit";
const description = "Berechnen Sie Kraft, Hub und Geschwindigkeit für Linearantriebe. Inklusive Wirkungsgrad und Leistungsberechnung.";
const relatedCalcs = [
  { name: "Auslastungsgrad Rechner", url: "/de/auslastungsgrad-rechner", description: "Kapazitätsnutzung." },
  { name: "Tragwand Rechner", url: "/de/tragwand-rechner", description: "Strukturlasten." },
  { name: "Lineare Gleichung Rechner", url: "/de/lineare-gleichung-rechner", description: "Gleichungen." },
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="linear-actuator-calculator" calculatorName="Linearantrieb Rechner" keywords="Linearantrieb berechnen, Linearzylinder Kraft, Hub Geschwindigkeit, Aktuator Auslegung" breadcrumbs={[{ name: "Linearantrieb Rechner", url: "/de/linearantrieb-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Linearantrieb Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kraft, Hub, Geschwindigkeit und Leistung für elektrische und hydraulische Linearantriebe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Antriebstyp</label>
          <select id="lan-typ" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="elektr" selected>Elektrischer Linearantrieb</option>
            <option value="pneum">Pneumatikzylinder</option>
            <option value="hydr">Hydraulikzylinder</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1" id="lan-label1">Motorleistung (W)</label>
            <input type="number" id="lan-p1" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" step="10" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1" id="lan-label2">Geschwindigkeit (mm/s)</label>
            <input type="number" id="lan-v" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" step="1" min="0.1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Hub (mm)</label>
            <input type="number" id="lan-hub" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" step="10" min="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Wirkungsgrad (%)</label>
            <input type="number" id="lan-eta" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" step="5" min="10" max="100">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Maximale Schubkraft</div>
          <div class="text-5xl font-extrabold font-mono" id="lan-result">0 N</div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="lan-details"></div>
      </div>
      <ShareButton lang="de" calculatorId="linearantrieb" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Linearantriebe auslegen und berechnen</h2>
      <p>Linearantriebe wandeln Rotations- oder Fluidenergie in geradlinige Bewegung um. Bei elektrischen Antrieben gilt: Kraft F = (P × η) / v, wobei P die Leistung, η der Wirkungsgrad und v die Geschwindigkeit ist. Pneumatik- und Hydraulikzylinder werden nach Kolbenfläche und Druck dimensioniert. Die Hubzeit ergibt sich aus Hub geteilt durch Geschwindigkeit.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen elektrischen und pneumatischen Linearantrieben?</summary>
          <p class="mt-2 text-sm text-text-secondary">Elektrische Linearantriebe bieten präzise Positionierung und Kraftregelung. Pneumatikzylinder sind günstiger und robust, aber ohne externe Sensoren nicht präzise positionierbar. Hydraulik liefert bei kleinem Bauraum die höchsten Kräfte.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie berechne ich die Kraft eines Pneumatikzylinders?</summary>
          <p class="mt-2 text-sm text-text-secondary">F = p × A × η, wobei p der Betriebsdruck (Pa), A die Kolbenfläche (m²) und η der Wirkungsgrad ist. Bei 6 bar und 50 mm Kolbendurchmesser: F = 600.000 × 0,00196 × 0,9 ≈ 1.058 N.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Welcher Wirkungsgrad ist typisch für Linearantriebe?</summary>
          <p class="mt-2 text-sm text-text-secondary">Elektrische Spindelantriebe erreichen 70–90 %, Riemenantriebe 85–95 %, Pneumatikzylinder 80–90 % und Hydraulikzylinder 90–98 %.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie lange dauert ein vollständiger Hub?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die Hubzeit ergibt sich aus t = s / v, wobei s der Hub in mm und v die Geschwindigkeit in mm/s ist. Bei 300 mm Hub und 10 mm/s dauert ein Vollhub 30 Sekunden.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLan() {
      const p1 = parseFloat((document.getElementById('lan-p1') as HTMLInputElement).value) || 0;
      const v = parseFloat((document.getElementById('lan-v') as HTMLInputElement).value) || 1;
      const hub = parseFloat((document.getElementById('lan-hub') as HTMLInputElement).value) || 0;
      const eta = parseFloat((document.getElementById('lan-eta') as HTMLInputElement).value) / 100 || 0.8;

      const kraft = (p1 * eta) / (v / 1000); // N
      const hubzeit = hub / v; // Sekunden
      const arbeit = kraft * (hub / 1000); // Joule
      const kraftKg = kraft / 9.81; // kg (Gewichtskraft)

      const fmt = (v: number, u: string, d = 1) => v.toLocaleString('de-DE', { maximumFractionDigits: d }) + ' ' + u;
      document.getElementById('lan-result')!.textContent = fmt(kraft, 'N', 0);
      document.getElementById('lan-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraft (kgf)</div><div class="text-lg font-bold font-mono">${fmt(kraftKg, 'kgf')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hubzeit</div><div class="text-lg font-bold font-mono">${fmt(hubzeit, 's')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Arbeit</div><div class="text-lg font-bold font-mono">${fmt(arbeit, 'J')}</div></div>`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['lan-p1','lan-v','lan-hub','lan-eta'].forEach(id => document.getElementById(id)!.addEventListener('input', calcLan));
      document.getElementById('lan-typ')!.addEventListener('change', calcLan);
      calcLan();
    }, 50);
  </script>
</CalculatorLayout>
