---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Filmentwicklung-Rechner - Verdünnung, Entwicklungszeit & Tankvolumen";
const description = "Berechnen Sie Verdünnungsverhältnisse, Entwicklungszeiten nach Temperatur, Push/Pull-Anpassungen und Tankvolumen für die Filmentwicklung.";
const relatedCalcs = [
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
  { name: "Gärtemperatur-Rechner", url: "/de/gaertemperatur-rechner", description: "Temperatursteuerung." },
  { name: "Glasfaser-Dämpfung", url: "/de/glasfaser-daempfung-rechner", description: "Optische Verluste." },
  { name: "Feuer-Rechner", url: "/de/feuer-rechner", description: "FIRE-Rechner." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Filmentwicklung-Rechner" lang="de" enSlug="film-developing-calculator" keywords="filmentwicklung rechner, dunkelkammer timer, chemische verdünnung, entwicklungszeit, push pull film, tankvolumen" breadcrumbs={[{ name: "Filmentwicklung", url: "/de/filmentwicklung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Filmentwicklung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie chemische Verd&uuml;nnungen, Entwicklungszeiten nach Temperatur und Push/Pull-Anpassungen f&uuml;r die Filmverarbeitung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tanktyp</label>
          <select id="fede-tank" class="fede-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="300" selected>Einzelspule (300ml / 35mm)</option>
            <option value="600">Doppelspule (600ml / 35mm x2)</option>
            <option value="500">Einzelspule (500ml / 120)</option>
            <option value="1000">Doppelspule (1000ml / 120 x2)</option>
            <option value="0">Benutzerdefiniert</option>
          </select>
        </div>
        <div id="fede-custom-vol-wrap" style="display:none">
          <label class="block text-sm font-medium text-text mb-1">Benutzerdefiniertes Tankvolumen (ml)</label>
          <input type="number" id="fede-custom-vol" class="fede-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="300" min="100" step="10">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Entwickler-Verd&uuml;nnung</label>
          <select id="fede-dilution" class="fede-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Stamml&ouml;sung (unverd&uuml;nnt)</option>
            <option value="1" selected>1+1</option>
            <option value="3">1+3</option>
            <option value="4">1+4</option>
            <option value="7">1+7</option>
            <option value="9">1+9</option>
            <option value="14">1+14</option>
            <option value="19">1+19</option>
            <option value="24">1+24</option>
            <option value="31">1+31</option>
            <option value="49">1+49</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Basis-Entwicklungszeit (Minuten bei 20&deg;C)</label><input type="number" id="fede-basetime" class="fede-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="9" min="1" max="120" step="0.5"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tats&auml;chliche Temperatur (&deg;C)</label>
          <input type="number" id="fede-temp" class="fede-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="20" min="15" max="30" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Push / Pull (Blendenstufen)</label>
          <select id="fede-push" class="fede-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="-2">Pull -2</option>
            <option value="-1">Pull -1</option>
            <option value="0" selected>Normal</option>
            <option value="1">Push +1</option>
            <option value="2">Push +2</option>
            <option value="3">Push +3</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Angepasste Entwicklungszeit</div>
          <div class="text-4xl font-extrabold" id="fede-time"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Entwickler-Volumen</div><div class="text-xl font-bold text-text" id="fede-dev-vol"></div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Wasser-Volumen</div><div class="text-xl font-bold text-text" id="fede-water-vol"></div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Gesamtl&ouml;sung</div><div class="text-xl font-bold text-text" id="fede-total-vol"></div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Temperaturanpassung</div><div class="text-xl font-bold text-text" id="fede-temp-adj"></div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h4 class="font-semibold text-sm text-text mb-2">Verarbeitungsschritte</h4>
          <div class="text-sm text-text-secondary space-y-1">
            <div>1. Entwickler: <span class="font-bold" id="fede-step-dev"></span></div>
            <div>2. Stoppbad: 1 Minute</div>
            <div>3. Fixierer: 5-8 Minuten</div>
            <div>4. W&auml;ssern: 10-15 Minuten</div>
            <div>5. Netzmittel: 1 Minute</div>
            <div>6. Trocknen: 2-4 Stunden</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="film-developing-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Grundlagen der Filmentwicklung</h2>
      <p>Die Entwicklungszeit variiert mit Temperatur, Verd&uuml;nnung und Push/Pull-Verarbeitung. Die Standard-Referenztemperatur ist 20&deg;C. H&ouml;here Temperaturen beschleunigen die Entwicklung.</p>
      <p><strong>Temperaturkompensation:</strong> F&uuml;r jedes Grad Celsius &uuml;ber 20 reduziert sich die Entwicklungszeit um ca. 10%. Unter 20 erh&ouml;ht sie sich um 10% pro Grad.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet Push +1?</strong> Der Film wurde eine Blendenstufe unterbelichtet und wird länger entwickelt, um dies auszugleichen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcFEDE() {
      const tankVal = parseInt((document.getElementById('fede-tank') as HTMLSelectElement).value);
      let tankVol = tankVal;
      if (tankVal === 0) {
        document.getElementById('fede-custom-vol-wrap')!.style.display = '';
        tankVol = parseInt((document.getElementById('fede-custom-vol') as HTMLInputElement).value) || 300;
      } else {
        document.getElementById('fede-custom-vol-wrap')!.style.display = 'none';
      }
      const dilParts = parseInt((document.getElementById('fede-dilution') as HTMLSelectElement).value);
      const baseTime = parseFloat((document.getElementById('fede-basetime') as HTMLInputElement).value) || 9;
      const tempC = parseFloat((document.getElementById('fede-temp') as HTMLInputElement).value) || 20;
      const pushStops = parseInt((document.getElementById('fede-push') as HTMLSelectElement).value);
      const tempFactor = Math.pow(0.9, tempC - 20);
      let adjustedTime = baseTime * tempFactor;
      if (pushStops > 0) adjustedTime *= (1 + pushStops * 0.4);
      else if (pushStops < 0) adjustedTime *= Math.pow(0.8, Math.abs(pushStops));
      const mins = Math.floor(adjustedTime);
      const secs = Math.round((adjustedTime - mins) * 60);
      document.getElementById('fede-time')!.textContent = mins + ':' + String(secs).padStart(2, '0');
      const totalParts = 1 + dilParts;
      const devVol = dilParts === 0 ? tankVol : Math.round(tankVol / totalParts);
      const waterVol = tankVol - devVol;
      document.getElementById('fede-dev-vol')!.textContent = devVol + ' ml';
      document.getElementById('fede-water-vol')!.textContent = waterVol + ' ml';
      document.getElementById('fede-total-vol')!.textContent = tankVol + ' ml';
      const tempDiffPct = ((1 - tempFactor) * 100);
      const sign = tempDiffPct >= 0 ? '+' : '';
      document.getElementById('fede-temp-adj')!.textContent = sign + tempDiffPct.toFixed(0) + '% (' + tempC.toFixed(1) + '\u00B0C)';
      document.getElementById('fede-step-dev')!.textContent = mins + ':' + String(secs).padStart(2, '0') + ' (Erste 30s kippen, dann 10s jede Minute)';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fede-in').forEach(el => { el.addEventListener('input', calcFEDE); el.addEventListener('change', calcFEDE); });
      calcFEDE();
    }, 50);
  </script>
</CalculatorLayout>
