---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kuchen-Portionen-Rechner - Kuchengr\u00f6\u00dfe & Etagen f\u00fcr G\u00e4steanzahl";
const description = "Berechnen Sie die richtige Kuchengr\u00f6\u00dfe und Etagenzahl f\u00fcr Ihre Feier. W\u00e4hlen Sie zwischen Hochzeits-, Party- und Blechkuchen-Stilen.";
const relatedCalcs = [
  { name: "Kuchenform-Umrechner", url: "/de/kuchenform-umrechner", description: "Backformen umrechnen." },
  { name: "Karamell-Rechner", url: "/de/karamell-rechner", description: "Karamell-Rezepte." },
  { name: "Einmach-Rechner", url: "/de/einmach-rechner", description: "Einmachen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorienverbrauch." },
  { name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner", description: "Defizit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kuchen-Portionen-Rechner" lang="de" enSlug="cake-serving-calculator" keywords="kuchen portionen rechner, kuchengr\u00f6\u00dfe, hochzeitstorte, kuchen etagen, tortenportionen" breadcrumbs={[{ name: "Kuchen-Portionen", url: "/de/kuchen-portionen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kuchen-Portionen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die richtige Kuchengr&ouml;&szlig;e und Etagenzahl f&uuml;r Ihre G&auml;steanzahl.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl G&auml;ste</label>
          <input type="number" id="kp-guests" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Portionsgr&ouml;&szlig;e</label>
          <select id="kp-serving" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="wedding">Hochzeit (kleine St&uuml;cke)</option>
            <option value="party">Party (gro&szlig;z&uuml;gige St&uuml;cke)</option>
            <option value="dessert">Dessertbuffet (kleine Portionen, 75% serviert)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Kuchenform</label>
          <select id="kp-shape" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="round">Rund</option>
            <option value="square">Quadratisch</option>
            <option value="sheet">Blechkuchen</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Kuchenstil</label>
          <select id="kp-style" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="tiered">Mehrstufig (gestapelt)</option>
            <option value="single">Einst&ouml;ckig</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Preis pro Portion (&euro;)</label>
          <input type="number" id="kp-price" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="25" step="0.5">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Kuchen</div>
        <div class="text-4xl font-extrabold" id="kp-recommend">--</div>
        <div class="text-sm mt-1" id="kp-servings">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gesamtportionen</div>
          <div class="text-xl font-bold" id="kp-totalserv">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gesch. Kosten</div>
          <div class="text-xl font-bold" id="kp-cost">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Anzahl Etagen</div>
          <div class="text-xl font-bold" id="kp-tiers">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">H&ouml;he (ca.)</div>
          <div class="text-xl font-bold" id="kp-height">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="kp-details"></div>

      <ShareButton calculatorId="cake-serving" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kuchen-Portionen-Ratgeber</h2>
      <p>Hochzeitsportionen sind typischerweise kleine Scheiben. Eine 3-st&ouml;ckige Torte (15cm, 23cm, 30cm rund) ergibt ca. 100 Hochzeitsportionen. Blechkuchen sind die wirtschaftlichste Option f&uuml;r gro&szlig;e Feiern.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Runde Kuchen - Portionen</h3>
      <ul>
        <li>15 cm rund: 12 Hochzeits- / 8 Party-St&uuml;cke</li>
        <li>20 cm rund: 24 Hochzeits- / 14 Party-St&uuml;cke</li>
        <li>25 cm rund: 38 Hochzeits- / 20 Party-St&uuml;cke</li>
        <li>30 cm rund: 56 Hochzeits- / 30 Party-St&uuml;cke</li>
        <li>35 cm rund: 78 Hochzeits- / 40 Party-St&uuml;cke</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKP() {
      const guests = parseInt((document.getElementById('kp-guests') as HTMLInputElement).value) || 1;
      const serving = (document.getElementById('kp-serving') as HTMLSelectElement).value;
      const shape = (document.getElementById('kp-shape') as HTMLSelectElement).value;
      const style = (document.getElementById('kp-style') as HTMLSelectElement).value;
      const price = parseFloat((document.getElementById('kp-price') as HTMLInputElement).value) || 5;

      let servingsNeeded = guests;
      if (serving === 'dessert') servingsNeeded = Math.ceil(guests * 0.75);

      const roundWedding: Record<number, number> = { 6: 12, 8: 24, 9: 32, 10: 38, 12: 56, 14: 78, 16: 100 };
      const roundParty: Record<number, number> = { 6: 8, 8: 14, 9: 18, 10: 20, 12: 30, 14: 40, 16: 50 };
      const squareWedding: Record<number, number> = { 6: 18, 8: 32, 10: 50, 12: 72, 14: 98, 16: 128 };
      const squareParty: Record<number, number> = { 6: 12, 8: 20, 10: 32, 12: 45, 14: 63, 16: 80 };

      let tierSizes: number[] = [];
      let totalServings = 0;
      let rec = '';

      if (shape === 'sheet') {
        const fullSheet = serving === 'party' ? 48 : 72;
        const sheetsNeeded = Math.ceil(servingsNeeded / fullSheet);
        totalServings = sheetsNeeded * fullSheet;
        rec = sheetsNeeded + ' Blechkuchen (45x66cm)';
        tierSizes = [];
      } else if (style === 'single') {
        const servMap = shape === 'round' ? (serving === 'party' ? roundParty : roundWedding) : (serving === 'party' ? squareParty : squareWedding);
        const sizes = Object.keys(servMap).map(Number).sort((a, b) => a - b);
        let bestSize = sizes[sizes.length - 1];
        for (const s of sizes) {
          if (servMap[s] >= servingsNeeded) { bestSize = s; break; }
        }
        totalServings = servMap[bestSize];
        const cmSize = Math.round(bestSize * 2.54);
        rec = cmSize + 'cm ' + (shape === 'round' ? 'rund' : 'quadratisch') + ' (einst\u00f6ckig)';
        tierSizes = [bestSize];
      } else {
        const servMap = shape === 'round' ? (serving === 'party' ? roundParty : roundWedding) : (serving === 'party' ? squareParty : squareWedding);
        const sizes = Object.keys(servMap).map(Number).sort((a, b) => b - a);
        let remaining = servingsNeeded;
        tierSizes = [];
        let currentMax = sizes[0];

        while (remaining > 0 && tierSizes.length < 6) {
          let bestFit = sizes.find(s => s <= currentMax && servMap[s] <= remaining + 5) || sizes[sizes.length - 1];
          if (tierSizes.length === 0) {
            bestFit = sizes.find(s => servMap[s] >= remaining * 0.3) || sizes[0];
            if (servMap[bestFit] >= remaining) {
              tierSizes.push(bestFit);
              remaining -= servMap[bestFit];
              break;
            }
          }
          tierSizes.push(bestFit);
          remaining -= servMap[bestFit];
          currentMax = bestFit - 2;
          if (currentMax < sizes[sizes.length - 1]) break;
        }

        if (remaining > 0 && tierSizes.length < 6) {
          const smallest = sizes[sizes.length - 1];
          tierSizes.push(smallest);
        }

        tierSizes.sort((a, b) => b - a);
        totalServings = tierSizes.reduce((sum, s) => sum + (servMap[s] || 0), 0);
        const cmSizes = tierSizes.map(s => Math.round(s * 2.54));
        rec = tierSizes.length + '-st\u00f6ckig ' + (shape === 'round' ? 'rund' : 'quadratisch') + ' (' + cmSizes.join('cm, ') + 'cm)';
      }

      const numTiers = tierSizes.length || 1;
      const heightCm = Math.round((numTiers * 5 + (numTiers - 1) * 1) * 2.54);
      const cost = totalServings * price;

      document.getElementById('kp-recommend')!.textContent = rec;
      document.getElementById('kp-servings')!.textContent = 'Reicht f\u00fcr ' + totalServings + (totalServings >= servingsNeeded ? ' (ausreichend)' : ' (ggf. erg\u00e4nzen)');
      document.getElementById('kp-totalserv')!.textContent = totalServings.toString();
      document.getElementById('kp-cost')!.textContent = cost.toLocaleString('de-DE') + ' \u20ac';
      document.getElementById('kp-tiers')!.textContent = shape === 'sheet' ? 'Entf.' : numTiers.toString();
      document.getElementById('kp-height')!.textContent = shape === 'sheet' ? '10 cm' : heightCm + ' cm';

      let details = '<h3 class="font-semibold text-sm text-text mb-2">Kuchen-Details</h3><ul class="text-sm text-text-secondary space-y-1">';
      details += '<li>Ben\u00f6tigte Portionen: ' + servingsNeeded + '</li>';
      details += '<li>Vorhandene Portionen: ' + totalServings + '</li>';
      details += '<li>Portionsstil: ' + (serving === 'wedding' ? 'Hochzeit (klein)' : serving === 'party' ? 'Party (gro\u00dfz\u00fcgig)' : 'Dessertbuffet (kleine Portionen)') + '</li>';
      details += '<li>Gesch\u00e4tzte Kosten bei ' + price.toFixed(2).replace('.', ',') + ' \u20ac/Portion: ' + cost.toLocaleString('de-DE') + ' \u20ac</li>';
      if (totalServings < servingsNeeded) {
        details += '<li class="text-red-600 font-semibold">Erg\u00e4nzend Blechkuchen f\u00fcr ' + (servingsNeeded - totalServings) + ' weitere Portionen empfohlen</li>';
      }
      details += '</ul>';
      document.getElementById('kp-details')!.innerHTML = details;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kp-in').forEach(el => { el.addEventListener('input', calcKP); el.addEventListener('change', calcKP); });
      calcKP();
    }, 50);
  </script>
</CalculatorLayout>
