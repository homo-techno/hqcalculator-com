---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kundenakquise-Kosten-Rechner (CPA)";
const description = "Berechnen Sie CPA, ROAS, Klickkosten und Konversionsrate aus Ihren Werbeausgaben und Ergebnissen.";
const relatedCalcs = [
  { name: "Gewinnspanne-Rechner", url: "/de/gewinnspanne-rechner", description: "Gewinnmargen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kundenakquise-Kosten-Rechner" enSlug="cost-per-acquisition-calculator" keywords="CPA Rechner, Kundenakquisekosten, ROAS, Konversionsrate, Werbeausgaben, Klickkosten" breadcrumbs={[{ name: "Kundenakquise-Kosten-Rechner", url: "/de/kundenakquise-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kundenakquise-Kosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie Ihre Werbeeffizienz mit CPA, ROAS und Konversions-Kennzahlen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Gesamte Werbeausgaben (€)</label><input type="number" id="ca-spend" class="ca-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5000" min="0" step="100"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesamte Klicks</label><input type="number" id="ca-clicks" class="ca-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2500" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesamte Conversions</label><input type="number" id="ca-conversions" class="ca-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesamtumsatz aus Conversions (€)</label><input type="number" id="ca-revenue" class="ca-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15000" min="0" step="100"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kosten pro Akquisition</div>
          <div class="text-5xl font-extrabold font-mono" id="ca-result">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ROAS</div><div class="text-xl font-bold font-mono" id="ca-roas">0x</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Klick</div><div class="text-xl font-bold font-mono" id="ca-cpc">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Konversionsrate</div><div class="text-xl font-bold font-mono" id="ca-cvr">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Netto-Gewinn</div><div class="text-xl font-bold font-mono" id="ca-profit">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umsatz pro Klick</div><div class="text-xl font-bold font-mono" id="ca-rpc">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinnmarge</div><div class="text-xl font-bold font-mono" id="ca-margin">0%</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cost-per-acquisition" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kundenakquisekosten verstehen</h2>
      <p>Die Kosten pro Akquisition (CPA) geben an, wie viel Sie ausgeben müssen, um einen neuen Kunden zu gewinnen. Der ROAS (Return on Ad Spend) zeigt, wie viel Umsatz jeder investierte Euro generiert. Ein ROAS von 3x bedeutet: 3 € Umsatz pro 1 € Werbeausgaben.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was ist ein guter CPA?</strong> Das hängt von Ihrer Branche und Marge ab. Grundregel: CPA sollte deutlich unter dem Customer Lifetime Value (CLV) liegen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCA() {
      const spend = parseFloat((document.getElementById('ca-spend') as HTMLInputElement).value) || 0;
      const clicks = parseFloat((document.getElementById('ca-clicks') as HTMLInputElement).value) || 0;
      const conversions = parseFloat((document.getElementById('ca-conversions') as HTMLInputElement).value) || 0;
      const revenue = parseFloat((document.getElementById('ca-revenue') as HTMLInputElement).value) || 0;

      const cpa = conversions > 0 ? spend / conversions : 0;
      const roas = spend > 0 ? revenue / spend : 0;
      const cpc = clicks > 0 ? spend / clicks : 0;
      const cvr = clicks > 0 ? (conversions / clicks) * 100 : 0;
      const profit = revenue - spend;
      const rpc = clicks > 0 ? revenue / clicks : 0;
      const margin = revenue > 0 ? (profit / revenue) * 100 : 0;

      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('ca-result')!.textContent = fmt(cpa);
      document.getElementById('ca-roas')!.textContent = roas.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + 'x';
      document.getElementById('ca-cpc')!.textContent = fmt(cpc);
      document.getElementById('ca-cvr')!.textContent = cvr.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + '%';
      document.getElementById('ca-profit')!.textContent = fmt(profit);
      document.getElementById('ca-rpc')!.textContent = fmt(rpc);
      document.getElementById('ca-margin')!.textContent = margin.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ca-in').forEach(el => { el.addEventListener('input', calcCA); el.addEventListener('change', calcCA); });
      calcCA();
    }, 50);
  </script>
</CalculatorLayout>
