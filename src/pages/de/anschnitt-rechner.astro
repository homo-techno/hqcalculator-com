---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Anschnittrechner - Beschnitt, Endformat & Sicherheitsbereich";
const description = "Berechnen Sie Beschnitt, Endformat und Sicherheitsbereich für verschiedene Druckformate. Unverzichtbar für Druckvorstufe und Design-Setup.";
const relatedCalcs = [
  { name: "Postergrößen-Rechner", url: "/de/postergroessen-rechner", description: "Postermaße und DPI." },
  { name: "Druckauflösungsrechner", url: "/de/druckaufloesung-rechner", description: "DPI/PPI-Berechnungen." },
  { name: "Visitenkartenrechner", url: "/de/visitenkarten-rechner", description: "Visitenkartendruck." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Anschnittrechner" lang="de" keywords="anschnitt, beschnitt, endformat, sicherheitsbereich, druckvorstufe, druckdaten, druckbereich" breadcrumbs={[{ name: "Anschnittrechner", url: "/de/anschnitt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Anschnittrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Anschnitt-, Endformat- und Sicherheitsbereich-Maße für Druckaufträge.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Voreingestelltes Format</label>
          <select id="bm2-preset" class="bm2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="custom">Benutzerdefiniert</option>
            <option value="letter">US Letter (8,5 x 11 Zoll)</option>
            <option value="a4">A4 (210 x 297 mm)</option>
            <option value="a5">A5 (148 x 210 mm)</option>
            <option value="6x9">Taschenbuch (6 x 9 Zoll)</option>
            <option value="5.5x8.5">Digest (5,5 x 8,5 Zoll)</option>
            <option value="bcard">Visitenkarte (3,5 x 2 Zoll)</option>
            <option value="postcard">Postkarte (6 x 4 Zoll)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Endformat-Breite (Zoll)</label><input type="number" id="bm2-width" class="bm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.125"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Endformat-Höhe (Zoll)</label><input type="number" id="bm2-height" class="bm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.125"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Beschnitt (Zoll)</label><input type="number" id="bm2-bleed" class="bm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.0625"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sicherheitsrand (Zoll)</label><input type="number" id="bm2-safe" class="bm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.0625"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Dokumentgröße (mit Beschnitt)</div>
          <div class="text-4xl font-extrabold font-mono" id="bm2-result">0 x 0 Zoll</div>
          <div class="text-sm text-blue-200 mt-1" id="bm2-resultmm"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Endformat</div><div class="text-lg font-bold" id="bm2-trimsize">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sicherheitsbereich</div><div class="text-lg font-bold" id="bm2-safearea">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beschnittbereich (gesamt)</div><div class="text-lg font-bold" id="bm2-bleedarea">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">DPI für Qualität</div><div class="text-lg font-bold" id="bm2-pixels">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Maß-Zusammenfassung</h3>
          <div class="font-mono text-sm space-y-1" id="bm2-steps"></div>
        </div>
      </div>
      <ShareButton calculatorId="bleed-margin" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Druckbeschnitt verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Beschnitt: Bereich jenseits des Endformats, der abgeschnitten wird. Standard: 3 mm (0,125 Zoll).</p>
        <p>Endformat: Endgültige Schnittgröße des Druckstücks.</p>
        <p>Sicherheitsbereich: Bereich innerhalb des Endformats, in dem alle wichtigen Inhalte bleiben sollten.</p>
        <p>Dokumentgröße = Endformat + (2 x Beschnitt) je Dimension.</p>
      </div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBm2() {
      const preset = (document.getElementById('bm2-preset') as HTMLSelectElement).value;
      const presets: Record<string, [number, number]> = {
        letter: [8.5, 11], a4: [8.268, 11.693], a5: [5.827, 8.268],
        '6x9': [6, 9], '5.5x8.5': [5.5, 8.5], bcard: [3.5, 2], postcard: [6, 4]
      };
      if (preset !== 'custom' && presets[preset]) {
        (document.getElementById('bm2-width') as HTMLInputElement).value = presets[preset][0].toString();
        (document.getElementById('bm2-height') as HTMLInputElement).value = presets[preset][1].toString();
      }
      const trimW = parseFloat((document.getElementById('bm2-width') as HTMLInputElement).value) || 0;
      const trimH = parseFloat((document.getElementById('bm2-height') as HTMLInputElement).value) || 0;
      const bleed = parseFloat((document.getElementById('bm2-bleed') as HTMLInputElement).value) || 0;
      const safe = parseFloat((document.getElementById('bm2-safe') as HTMLInputElement).value) || 0;
      const docW = trimW + 2 * bleed;
      const docH = trimH + 2 * bleed;
      const safeW = trimW - 2 * safe;
      const safeH = trimH - 2 * safe;
      const docWmm = docW * 25.4;
      const docHmm = docH * 25.4;
      const pixW = Math.ceil(docW * 300);
      const pixH = Math.ceil(docH * 300);
      const steps: string[] = [];
      steps.push('Endformat: ' + trimW.toFixed(3) + ' x ' + trimH.toFixed(3) + ' Zoll');
      steps.push('Beschnitt (je Seite): ' + bleed.toFixed(3) + ' Zoll (' + (bleed * 25.4).toFixed(1) + ' mm)');
      steps.push('Dokument: ' + docW.toFixed(3) + ' x ' + docH.toFixed(3) + ' Zoll');
      steps.push('Dokument (mm): ' + docWmm.toFixed(1) + ' x ' + docHmm.toFixed(1) + ' mm');
      steps.push('Sicherheitsbereich: ' + safeW.toFixed(3) + ' x ' + safeH.toFixed(3) + ' Zoll');
      steps.push('Bei 300 DPI: ' + pixW + ' x ' + pixH + ' Pixel');
      document.getElementById('bm2-result')!.textContent = docW.toFixed(3) + ' x ' + docH.toFixed(3) + ' Zoll';
      document.getElementById('bm2-resultmm')!.textContent = docWmm.toFixed(1) + ' x ' + docHmm.toFixed(1) + ' mm';
      document.getElementById('bm2-trimsize')!.textContent = trimW.toFixed(3) + ' x ' + trimH.toFixed(3) + ' Zoll';
      document.getElementById('bm2-safearea')!.textContent = safeW.toFixed(3) + ' x ' + safeH.toFixed(3) + ' Zoll';
      document.getElementById('bm2-bleedarea')!.textContent = bleed.toFixed(3) + ' Zoll je Seite';
      document.getElementById('bm2-pixels')!.textContent = pixW + ' x ' + pixH + ' px';
      document.getElementById('bm2-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bm2-width') as HTMLInputElement).value = '8.5';
      (document.getElementById('bm2-height') as HTMLInputElement).value = '11';
      (document.getElementById('bm2-bleed') as HTMLInputElement).value = '0.125';
      (document.getElementById('bm2-safe') as HTMLInputElement).value = '0.25';
      document.querySelectorAll('.bm2-in').forEach(el => { el.addEventListener('input', calcBm2); el.addEventListener('change', calcBm2); });
      calcBm2();
    }, 50);
  </script>
</CalculatorLayout>
