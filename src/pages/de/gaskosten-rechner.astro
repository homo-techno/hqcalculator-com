---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gaskosten-Rechner - Fahrtkosten & Kraftstoffverbrauch";
const description = "Berechnen Sie die Kraftstoffkosten f\u00FCr eine Fahrt basierend auf Entfernung, Verbrauch und Benzinpreis. Kosten auf Mitfahrer aufteilen.";
const relatedCalcs = [
  { name: "Benzinverbrauch-Rechner", url: "/de/benzinverbrauch-rechner", description: "Verbrauch." },
  { name: "CO\u2082-Fu\u00DFabdruck-Rechner", url: "/de/co2-fussabdruck-rechner", description: "CO\u2082." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gaskosten-Rechner" lang="de" enSlug="gas-cost-calculator" keywords="gaskosten rechner, fahrtkosten, tankkosten, kraftstoff rechner, benzinkosten, reisekosten" breadcrumbs={[{ name: "Gaskosten", url: "/de/gaskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gaskosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Kraftstoffkosten f&uuml;r jede Fahrt und teilen Sie unter Mitfahrern auf.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Entfernung (km)</label><input type="number" id="gkr-dist" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (L/100km)</label><input type="number" id="gkr-consumption" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7.5" min="0.1" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Benzinpreis (&euro;/L)</label><input type="number" id="gkr-price" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.75" min="0" step="0.05"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Mitfahrer (zum Teilen)</label><input type="number" id="gkr-pass" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="20" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Kraftstoffkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="gkr-total">0,00 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Liter ben&ouml;tigt</div><div class="text-xl font-bold font-mono" id="gkr-liters">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Person</div><div class="text-xl font-bold" id="gkr-person">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/km</div><div class="text-xl font-bold" id="gkr-km">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hin- und R&uuml;ckfahrt</div><div class="text-xl font-bold" id="gkr-round">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CO&sup2;-Emissionen</div><div class="text-xl font-bold" id="gkr-co2">0 kg</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gas-cost" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kraftstoffkosten berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Liter = Entfernung(km) &times; Verbrauch(L/100km) / 100</p>
        <p>Kosten = Liter &times; Preis(&euro;/L)</p>
        <p>CO&sup2; = Liter &times; 2,31 kg/L</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein normaler Verbrauch?</strong> Kleinwagen: 5-6 L/100km, Mittelklasse: 7-8 L/100km, SUV: 9-11 L/100km.</p>
      <p><strong>Wie kann ich Sprit sparen?</strong> Gleichm&auml;&szlig;ig fahren, Reifendruck pr&uuml;fen, unn&ouml;tiges Gewicht vermeiden und Tempomat auf der Autobahn nutzen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGKR() {
      const dist = parseFloat((document.getElementById('gkr-dist') as HTMLInputElement).value) || 0;
      const consumption = parseFloat((document.getElementById('gkr-consumption') as HTMLInputElement).value) || 1;
      const price = parseFloat((document.getElementById('gkr-price') as HTMLInputElement).value) || 0;
      const pass = parseInt((document.getElementById('gkr-pass') as HTMLInputElement).value) || 1;
      const liters = dist * consumption / 100;
      const cost = liters * price;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('gkr-total')!.textContent = fmt(cost) + ' \u20AC';
      document.getElementById('gkr-liters')!.textContent = liters.toFixed(1);
      document.getElementById('gkr-person')!.textContent = fmt(cost / pass) + ' \u20AC';
      document.getElementById('gkr-km')!.textContent = dist > 0 ? fmt(cost / dist) + ' \u20AC' : '0 \u20AC';
      document.getElementById('gkr-round')!.textContent = fmt(cost * 2) + ' \u20AC';
      document.getElementById('gkr-co2')!.textContent = (liters * 2.31).toFixed(1) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.gkr-in').forEach(el => el.addEventListener('input', calcGKR)); calcGKR(); }, 50);
  </script>
</CalculatorLayout>
