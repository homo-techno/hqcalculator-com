---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bierbraurechner - Alkoholgehalt, D\u00e4mpfung & Kalorien";
const description = "Berechnen Sie Alkoholgehalt, Kalorien pro 0,33l, scheinbare und tats\u00e4chliche D\u00e4mpfung sowie EBC-Farbsch\u00e4tzung f\u00fcr Hobbybrauer.";
const relatedCalcs = [
  { name: "Kaffee-Verh\u00e4ltnis-Rechner", url: "/coffee-ratio-calculator", description: "Perfektes Kaffee-Wasser-Verh\u00e4ltnis." },
  { name: "Sauerteig-Rechner", url: "/sourdough-calculator", description: "Sauerteig-Verh\u00e4ltnisse." },
  { name: "Lebensmittelkosten-Rechner", url: "/food-cost-calculator", description: "Gastronomie-Kostenanalyse." },
  { name: "Back-Umrechner", url: "/baking-conversion-calculator", description: "Back-Umrechnungen." },
  { name: "Hefe-Rechner", url: "/yeast-calculator", description: "Hefe-Umrechnung." },
  { name: "Meal-Prep-Rechner", url: "/meal-prep-calculator", description: "Wochenplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Bierbraurechner" lang="de" keywords="bier alkoholgehalt rechner, hobbybrauer rechner, stammw\u00fcrze, restextrakt, d\u00e4mpfung, EBC farbe, kalorien bier" breadcrumbs={[{ name: "Bierbraurechner", url: "/de/bierbrauen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bierbraurechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Alkoholgehalt, Kalorien, D&auml;mpfung und Farbe f&uuml;r Ihr Heimbraubier aus Stammw&uuml;rze und Restextrakt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stammw&uuml;rze (OG)</label><input type="number" id="bb2-og" class="bb2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.050" min="1.000" max="1.200" step="0.001"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Restextrakt (FG)</label><input type="number" id="bb2-fg" class="bb2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.010" min="0.990" max="1.100" step="0.001"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Sudgr&ouml;&szlig;e (Liter)</label><input type="number" id="bb2-batch" class="bb2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">EBC Farbe (gesch.)</label><input type="number" id="bb2-srm" class="bb2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="16" min="2" max="80" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Alkoholgehalt (ABV)</div>
          <div class="text-5xl font-extrabold font-mono" id="bb2-result">0%</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien / 0,33l</div><div class="text-xl font-bold font-mono" id="bb2-cal">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Scheinbare D&auml;mpfung</div><div class="text-xl font-bold font-mono" id="bb2-aa">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tats&auml;chliche D&auml;mpfung</div><div class="text-xl font-bold font-mono" id="bb2-ra">0%</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ABW</div><div class="text-xl font-bold font-mono" id="bb2-abw">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Farbe</div><div class="text-xl font-bold font-mono" id="bb2-color">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flaschen (0,33l)</div><div class="text-xl font-bold font-mono" id="bb2-bottles">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="beer-brewing" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBB2() {
      const og = parseFloat((document.getElementById('bb2-og') as HTMLInputElement).value) || 1.0;
      const fg = parseFloat((document.getElementById('bb2-fg') as HTMLInputElement).value) || 1.0;
      const batch = parseFloat((document.getElementById('bb2-batch') as HTMLInputElement).value) || 20;
      const ebc = parseFloat((document.getElementById('bb2-srm') as HTMLInputElement).value) || 2;
      const srm = ebc / 1.97;
      const abv = (og - fg) * 131.25;
      const abw = abv * 0.79336;
      const ogPoints = og - 1;
      const fgPoints = fg - 1;
      const apparentAtten = ogPoints > 0 ? ((ogPoints - fgPoints) / ogPoints) * 100 : 0;
      const ogPlato = (-1 * 616.868) + (1111.14 * og) - (630.272 * og * og) + (135.997 * og * og * og);
      const fgPlato = (-1 * 616.868) + (1111.14 * fg) - (630.272 * fg * fg) + (135.997 * fg * fg * fg);
      const realExtract = 0.1808 * ogPlato + 0.8192 * fgPlato;
      const realAtten = ogPlato > 0 ? ((ogPlato - realExtract) / ogPlato) * 100 : 0;
      const cal = ((6.9 * abw + 4 * (realExtract - 0.1)) * fg * 3.55) * (330 / 355);
      let colorName = 'Strohgelb';
      if (ebc <= 4) colorName = 'Blassgelb';
      else if (ebc <= 8) colorName = 'Strohgelb';
      else if (ebc <= 12) colorName = 'Gold';
      else if (ebc <= 18) colorName = 'Bernstein';
      else if (ebc <= 28) colorName = 'Dunkel-Bernstein';
      else if (ebc <= 34) colorName = 'Kupfer';
      else if (ebc <= 44) colorName = 'Braun';
      else if (ebc <= 60) colorName = 'Dunkelbraun';
      else colorName = 'Schwarz';
      const bottles = Math.floor(batch * 1000 / 330);
      document.getElementById('bb2-result')!.textContent = abv.toFixed(2).replace('.', ',') + '%';
      document.getElementById('bb2-cal')!.textContent = Math.round(cal).toString();
      document.getElementById('bb2-aa')!.textContent = apparentAtten.toFixed(1).replace('.', ',') + '%';
      document.getElementById('bb2-ra')!.textContent = realAtten.toFixed(1).replace('.', ',') + '%';
      document.getElementById('bb2-abw')!.textContent = abw.toFixed(2).replace('.', ',') + '%';
      document.getElementById('bb2-color')!.textContent = colorName;
      document.getElementById('bb2-bottles')!.textContent = bottles.toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bb2-in').forEach(el => { el.addEventListener('input', calcBB2); el.addEventListener('change', calcBB2); });
      calcBB2();
    }, 50);
  </script>
</CalculatorLayout>
