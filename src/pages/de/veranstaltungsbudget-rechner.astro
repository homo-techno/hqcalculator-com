---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Veranstaltungsbudget-Rechner - Kostenaufstellung f\u00fcr Events";
const description = "Planen Sie Ihr Veranstaltungsbudget mit detaillierter Aufschl\u00fcsselung: Location, Catering, Unterhaltung, Dekoration, Personal und mehr.";

const relatedCalcs = [
  { name: "Veranstaltungspersonal-Rechner", url: "/de/veranstaltungspersonal-rechner", description: "Personalbedarf." },
  { name: "Veranstaltungszeitplan-Rechner", url: "/de/veranstaltungszeitplan-rechner", description: "Zeitplanung." },
  { name: "Veranstaltungsversicherung-Rechner", url: "/de/veranstaltungsversicherung-rechner", description: "Versicherungskosten." },
  { name: "Veranstaltungsbeleuchtung-Rechner", url: "/de/veranstaltungsbeleuchtung-rechner", description: "Beleuchtung planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Veranstaltungsbudget-Rechner" lang="de" enSlug="event-budget-calculator" keywords="veranstaltungsbudget rechner, event kosten, eventplanung budget, party budget, veranstaltungsausgaben" breadcrumbs={[{ name: "Veranstaltungsbudget-Rechner", url: "/de/veranstaltungsbudget-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Veranstaltungsbudget-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihr Veranstaltungsbudget mit einer Aufschl&uuml;sselung aller Hauptkategorien.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl G&auml;ste</label><input type="number" id="vbr-guests" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Veranstaltungsart</label>
          <select id="vbr-type" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="corporate">Firmenveranstaltung</option>
            <option value="wedding">Hochzeitsfeier</option>
            <option value="birthday">Geburtstagsfeier</option>
            <option value="gala">Gala / Benefizveranstaltung</option>
            <option value="conference">Konferenz</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Location-Kosten (&euro;)</label><input type="number" id="vbr-venue" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="0" step="100"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Catering pro Person (&euro;)</label><input type="number" id="vbr-catering" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="0" step="5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Unterhaltung / DJ / Band (&euro;)</label><input type="number" id="vbr-entertain" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="0" step="100"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Dekoration &amp; Blumen (&euro;)</label><input type="number" id="vbr-decor" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2000" min="0" step="100"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Personalkosten (&euro;)</label><input type="number" id="vbr-staff" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1200" min="0" step="100"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Fotografie / Video (&euro;)</label><input type="number" id="vbr-photo" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="0" step="100"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Sonstiges / Puffer (%)</label><input type="number" id="vbr-misc" class="vbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="50" step="1"></div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtbudget</div>
        <div class="text-5xl font-extrabold" id="vbr-total">--</div>
        <div class="text-sm mt-1" id="vbr-perguest">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Catering gesamt</div><div class="text-xl font-bold" id="vbr-cattotal">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Puffer</div><div class="text-xl font-bold" id="vbr-contamt">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fixkosten</div><div class="text-xl font-bold" id="vbr-fixed">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gr&ouml;&szlig;te Kategorie</div><div class="text-xl font-bold" id="vbr-largest">--</div></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="vbr-breakdown"></div>

      <ShareButton calculatorId="event-budget-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Veranstaltungsbudget richtig planen</h2>
      <p>Ein gut geplantes Budget stellt sicher, dass Ihre Veranstaltung finanziell im Rahmen bleibt. Typische Aufteilung: 40-50% f&uuml;r Location und Catering, 10-15% f&uuml;r Unterhaltung, 8-10% f&uuml;r Dekoration und 10% als Puffer.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel Puffer einplanen?</strong> Mindestens 10-15% des Gesamtbudgets f&uuml;r unvorhergesehene Kosten.</p>
      <p><strong>Was sind die gr&ouml;&szlig;ten Kostentreiber?</strong> Location und Catering machen zusammen oft mehr als die H&auml;lfte des Budgets aus.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcVBR() {
      const guests = parseInt((document.getElementById('vbr-guests') as HTMLInputElement).value) || 1;
      const venue = parseFloat((document.getElementById('vbr-venue') as HTMLInputElement).value) || 0;
      const cateringPP = parseFloat((document.getElementById('vbr-catering') as HTMLInputElement).value) || 0;
      const entertain = parseFloat((document.getElementById('vbr-entertain') as HTMLInputElement).value) || 0;
      const decor = parseFloat((document.getElementById('vbr-decor') as HTMLInputElement).value) || 0;
      const staff = parseFloat((document.getElementById('vbr-staff') as HTMLInputElement).value) || 0;
      const photo = parseFloat((document.getElementById('vbr-photo') as HTMLInputElement).value) || 0;
      const miscPct = parseFloat((document.getElementById('vbr-misc') as HTMLInputElement).value) || 0;

      const cateringTotal = cateringPP * guests;
      const subtotal = venue + cateringTotal + entertain + decor + staff + photo;
      const contingency = subtotal * (miscPct / 100);
      const total = subtotal + contingency;
      const perGuest = total / guests;
      const fixed = venue + entertain + decor + staff + photo;

      const cats = [
        { name: 'Location', val: venue },
        { name: 'Catering', val: cateringTotal },
        { name: 'Unterhaltung', val: entertain },
        { name: 'Dekoration', val: decor },
        { name: 'Personal', val: staff },
        { name: 'Fotografie', val: photo },
        { name: 'Puffer', val: contingency },
      ];
      const largest = cats.reduce((a, b) => a.val > b.val ? a : b);

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('vbr-total')!.textContent = fmt(total);
      document.getElementById('vbr-perguest')!.textContent = fmt(perGuest) + ' pro Gast';
      document.getElementById('vbr-cattotal')!.textContent = fmt(cateringTotal);
      document.getElementById('vbr-contamt')!.textContent = fmt(contingency);
      document.getElementById('vbr-fixed')!.textContent = fmt(fixed);
      document.getElementById('vbr-largest')!.textContent = largest.name;

      document.getElementById('vbr-breakdown')!.innerHTML = '<h3 class="font-semibold text-sm text-text mb-3">Budgetaufschl\u00FCsselung</h3>' +
        cats.filter(c => c.val > 0).sort((a, b) => b.val - a.val).map(c => {
          const pct = total > 0 ? (c.val / total * 100) : 0;
          return '<div class="text-xs mb-1"><div class="flex justify-between mb-0.5"><span class="text-text-secondary">' + c.name + '</span><span class="font-semibold">' + fmt(c.val) + ' (' + pct.toFixed(1).replace('.', ',') + '%)</span></div><div class="w-full h-2 bg-gray-200 rounded-full"><div class="h-full bg-primary rounded-full" style="width:' + Math.min(100, pct) + '%"></div></div></div>';
        }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vbr-in').forEach(el => { el.addEventListener('input', calcVBR); el.addEventListener('change', calcVBR); });
      calcVBR();
    }, 50);
  </script>
</CalculatorLayout>
