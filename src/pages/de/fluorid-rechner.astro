---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fluorid-Rechner - Optimale Zufuhr & Supplementierung";
const description = "Berechnen Sie die optimale Fluoridaufnahme nach Alter und Gewicht, bewerten Sie den Wasserfluoridgehalt und erhalten Sie Supplementempfehlungen.";
const relatedCalcs = [
  { name: "Zahnversicherung", url: "/de/zahnversicherung-rechner", description: "Zahnversicherungsanalyse." },
  { name: "Dosierungsrechner", url: "/de/dosierungsrechner", description: "Medikamentendosierung." },
  { name: "Wasseraufnahme", url: "/de/wasseraufnahme-rechner", description: "T&auml;glicher Wasserbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fluorid-Rechner" lang="de" enSlug="fluoride-calculator" keywords="Fluorid Aufnahme, Fluorid Supplement, Wasserfluorid, Fluorid Dosis Kinder, Fluorid Empfehlung" breadcrumbs={[{ name: "Fluorid-Rechner", url: "/de/fluorid-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fluorid-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die optimale Fluoridaufnahme und Supplementbedarf basierend auf Alter, Gewicht und Wasserfluoridgehalt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Altersgruppe</label>
            <select id="flr-age" class="flr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0-6m">0-6 Monate</option>
              <option value="6m-3y" selected>6 Monate - 3 Jahre</option>
              <option value="3-6y">3-6 Jahre</option>
              <option value="6-16y">6-16 Jahre</option>
              <option value="adult">Erwachsene (16+)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="flr-wt" class="flr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="3" max="150" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wasserfluoridgehalt (ppm)</label><input type="number" id="flr-water" class="flr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.3" min="0" max="10" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">T&auml;gliche Wasseraufnahme (mL)</label><input type="number" id="flr-intake" class="flr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="750" min="0" max="5000" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fluorid-Zahnpasta?</label>
            <select id="flr-paste" class="flr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="no">Nein</option>
              <option value="child" selected>Kinder (500 ppm)</option>
              <option value="adult">Normal (1000-1500 ppm)</option>
              <option value="rx">Verschreibungspflichtig (5000 ppm)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fluorid-Mundsp&uuml;lung?</label>
            <select id="flr-rinse" class="flr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="no" selected>Nein</option>
              <option value="otc">Freiverkauf (225 ppm NaF)</option>
              <option value="rx">Verschreibungspflichtig (900 ppm)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Supplement-Empfehlung</div>
          <div class="text-4xl font-extrabold font-mono" id="flr-supp">Nicht notwendig</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Optimale Aufnahme</div><div class="text-xl font-bold font-mono" id="flr-optimal">0 mg/Tag</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aus Wasser</div><div class="text-xl font-bold font-mono" id="flr-fromw">0 mg/Tag</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Defizit / &Uuml;berschuss</div><div class="text-xl font-bold font-mono" id="flr-gap">0 mg</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser-Status</div><div class="text-xl font-bold font-mono" id="flr-status">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fluorose-Risiko</div><div class="text-xl font-bold font-mono" id="flr-frisk">-</div></div>
        </div>
        <div class="p-3 bg-amber-50 rounded-xl text-center text-xs text-amber-800 font-semibold">
          Konsultieren Sie Ihren Kinderarzt oder Zahnarzt vor der Gabe von Fluorid-Supplementen. Optimaler Wasserfluoridgehalt: 0,7 ppm.
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fluoride" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Ab wann brauchen Kinder Fluorid?</strong> Fluorid-Supplementierung wird ab 6 Monaten empfohlen, wenn der Trinkwasser-Fluoridgehalt unter 0,3 ppm liegt.</p>
      <p><strong>Was ist Fluorose?</strong> Fluorose sind wei&szlig;e Flecken auf den Z&auml;hnen durch zu viel Fluorid w&auml;hrend der Zahnentwicklung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFLR() {
      const ageGroup = (document.getElementById('flr-age') as HTMLSelectElement).value;
      const waterF = parseFloat((document.getElementById('flr-water') as HTMLInputElement).value) || 0;
      const waterIntake = parseFloat((document.getElementById('flr-intake') as HTMLInputElement).value) || 750;
      const paste = (document.getElementById('flr-paste') as HTMLSelectElement).value;
      const ai: Record<string, number> = { '0-6m': 0.01, '6m-3y': 0.5, '3-6y': 0.7, '6-16y': 1.0, 'adult': 3.0 };
      const ul: Record<string, number> = { '0-6m': 0.7, '6m-3y': 1.3, '3-6y': 2.2, '6-16y': 10.0, 'adult': 10.0 };
      const optimalIntake = ai[ageGroup] || 0.5;
      const upperLimit = ul[ageGroup] || 2.0;
      const fromWater = (waterF * waterIntake) / 1000;
      let suppDose = 0;
      if (ageGroup === '0-6m') { suppDose = 0; }
      else if (ageGroup === '6m-3y') { suppDose = waterF < 0.3 ? 0.25 : 0; }
      else if (ageGroup === '3-6y') { suppDose = waterF < 0.3 ? 0.50 : waterF < 0.6 ? 0.25 : 0; }
      else if (ageGroup === '6-16y') { suppDose = waterF < 0.3 ? 1.00 : waterF < 0.6 ? 0.50 : 0; }
      const gap = optimalIntake - fromWater;
      let waterStatus: string;
      if (waterF >= 0.7) waterStatus = 'Optimal (0,7+ ppm)';
      else if (waterF >= 0.3) waterStatus = 'Suboptimal';
      else waterStatus = 'Mangelhaft';
      let fluorosisRisk: string;
      const totalF = fromWater + suppDose;
      if (ageGroup === 'adult') { fluorosisRisk = 'k.A. (Erwachsene)'; }
      else if (totalF > upperLimit) { fluorosisRisk = 'Hoch'; }
      else if (waterF > 2.0 || (paste === 'adult' && ageGroup === '6m-3y')) { fluorosisRisk = 'M\u00e4\u00dfig'; }
      else { fluorosisRisk = 'Niedrig'; }
      let suppText: string;
      if (suppDose > 0) { suppText = suppDose.toFixed(2).replace('.', ',') + ' mg F/Tag'; }
      else if (ageGroup === '0-6m') { suppText = 'Nicht empfohlen'; }
      else { suppText = 'Nicht notwendig'; }
      const fmt = (v: number) => v.toFixed(2).replace('.', ',');
      document.getElementById('flr-supp')!.textContent = suppText;
      document.getElementById('flr-optimal')!.textContent = fmt(optimalIntake) + ' mg/Tag';
      document.getElementById('flr-fromw')!.textContent = fmt(fromWater) + ' mg/Tag';
      document.getElementById('flr-gap')!.textContent = (gap > 0 ? '-' : '+') + fmt(Math.abs(gap)) + ' mg';
      document.getElementById('flr-status')!.textContent = waterStatus;
      document.getElementById('flr-frisk')!.textContent = fluorosisRisk;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.flr-in').forEach(el => { el.addEventListener('input', calcFLR); el.addEventListener('change', calcFLR); });
      calcFLR();
    }, 50);
  </script>
</CalculatorLayout>
