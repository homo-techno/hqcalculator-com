---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kognitive-Belastung-Rechner - Intrinsisch, Extrinsisch & Lernfördernd";
const description = "Schätzen Sie Ihre gesamte kognitive Belastung über intrinsische, extrinsische und lernfördernde Dimensionen. Erkennen Sie Überlastungsrisiken und Vereinfachungsstrategien.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Standardabweichung", url: "/de/standardabweichung-rechner", description: "Streuung." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kognitive-Belastung-Rechner" enSlug="cognitive-load-calculator" keywords="kognitive Belastung, intrinsische Belastung, extrinsische Belastung, kognitive Überlastung, Arbeitsgedächtnis, Instruktionsdesign" breadcrumbs={[{ name: "Kognitive-Belastung-Rechner", url: "/de/kognitive-belastung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kognitive-Belastung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Ihre kognitive Gesamtbelastung und ob Sie sich der Überlastung nähern (nach Swellers Cognitive Load Theory).</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Intrinsische Belastung (Aufgabenkomplexität)</h3>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl gleichzeitig zu verarbeitender Elemente</label>
          <input type="number" id="kb-elements" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="1" max="20" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ihr Expertenlevel für dieses Thema (1-10)</label>
          <input type="range" id="kb-expertise" class="kb-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Anfänger (1)</span><span>Experte (10)</span></div>
        </div>

        <h3 class="font-semibold text-text mt-4">Extrinsische Belastung (Störungen / schlechtes Design)</h3>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Qualität der Anleitung/Oberfläche (1-10)</label>
          <input type="range" id="kb-design" class="kb-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Sehr schlecht (1)</span><span>Ausgezeichnet (10)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Umgebungsablenkungen (1-10)</label>
          <input type="range" id="kb-distract" class="kb-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ruhig/fokussiert (1)</span><span>Sehr ablenkend (10)</span></div>
        </div>

        <h3 class="font-semibold text-text mt-4">Lernfördernde Belastung</h3>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Aktives Lernengagement (1-10)</label>
          <input type="range" id="kb-engage" class="kb-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Passiv (1)</span><span>Tief engagiert (10)</span></div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Gesamte kognitive Belastung</div>
          <div class="text-2xl font-extrabold mt-1" id="kb-total">--</div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Intrinsisch</div>
            <div class="text-xl font-bold text-text mt-1" id="kb-intr">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Extrinsisch</div>
            <div class="text-xl font-bold text-text mt-1" id="kb-extr">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Lernfördernd</div>
            <div class="text-xl font-bold text-text mt-1" id="kb-germ">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-secondary">Überlastungsschwelle</div>
          <div class="text-xl font-bold text-text mt-1" id="kb-threshold">--</div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Vereinfachungsstrategien</div>
          <div class="text-sm text-text" id="kb-strat">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="kognitive-belastung" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kognitive Belastungstheorie</h2>
      <p>Die Cognitive Load Theory nach John Sweller beschreibt, wie das Arbeitsgedächtnis beim Lernen belastet wird. Eine Überlastung führt zu ineffektivem Lernen. Durch die Reduzierung extrinsischer Belastung und die Optimierung der intrinsischen Belastung kann das Lernen verbessert werden.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcKB() {
      const elements = parseInt((document.getElementById('kb-elements') as HTMLInputElement).value) || 5;
      const expertise = parseInt((document.getElementById('kb-expertise') as HTMLInputElement).value) || 3;
      const design = parseInt((document.getElementById('kb-design') as HTMLInputElement).value) || 5;
      const distract = parseInt((document.getElementById('kb-distract') as HTMLInputElement).value) || 3;
      const engage = parseInt((document.getElementById('kb-engage') as HTMLInputElement).value) || 5;

      const expertiseFactor = 1 - (expertise - 1) * 0.08;
      const intrinsic = Math.min(10, elements * expertiseFactor);
      const extraneous = ((11 - design) + distract) / 2;
      const germane = engage * 0.6;

      const total = intrinsic + extraneous + germane;
      const capacity = 10;
      const overloadPct = (total / capacity) * 100;

      let status = '';
      if (overloadPct <= 70) status = total.toFixed(1) + ' / 10 - Innerhalb der Kapazität';
      else if (overloadPct <= 100) status = total.toFixed(1) + ' / 10 - Nahe der Kapazität';
      else status = total.toFixed(1) + ' / 10 - ÜBERLASTET';

      document.getElementById('kb-total')!.textContent = status;
      document.getElementById('kb-intr')!.textContent = intrinsic.toFixed(1) + ' / 10';
      document.getElementById('kb-extr')!.textContent = extraneous.toFixed(1) + ' / 10';
      document.getElementById('kb-germ')!.textContent = germane.toFixed(1) + ' / 10';
      document.getElementById('kb-threshold')!.textContent = overloadPct.toFixed(0) + '% der Kapazität genutzt';

      let strategies: string[] = [];
      if (intrinsic > 5) {
        strategies.push('Teilen Sie die Aufgabe in kleinere Teilaufgaben mit weniger interagierenden Elementen auf.');
        if (expertise < 5) strategies.push('Bauen Sie zuerst Vorwissen auf (Schemata reduzieren die intrinsische Belastung).');
      }
      if (extraneous > 4) {
        if (design < 5) strategies.push('Verbessern Sie das Instruktionsdesign: verwenden Sie Lösungsbeispiele, vermeiden Sie Split-Attention-Effekt.');
        if (distract > 5) strategies.push('Reduzieren Sie Ablenkungen: suchen Sie einen ruhigen Ort, schalten Sie Benachrichtigungen stumm.');
      }
      if (germane < 3) {
        strategies.push('Erhöhen Sie das aktive Engagement: erklären Sie sich selbst, üben Sie Abruf, erstellen Sie Konzeptkarten.');
      }
      if (overloadPct > 100) {
        strategies.push('KRITISCH: Sie sind kognitiv überlastet. Reduzieren Sie zuerst die extrinsische Belastung, dann vereinfachen Sie die Aufgabe.');
      }
      if (strategies.length === 0) {
        strategies.push('Ihre kognitive Belastung ist gut ausbalanciert. Gute Bedingungen für effektives Lernen.');
      }

      document.getElementById('kb-strat')!.textContent = strategies.join(' ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('kb-elements') as HTMLInputElement).value = '5';
      (document.getElementById('kb-expertise') as HTMLInputElement).value = '3';
      (document.getElementById('kb-design') as HTMLInputElement).value = '5';
      (document.getElementById('kb-distract') as HTMLInputElement).value = '3';
      (document.getElementById('kb-engage') as HTMLInputElement).value = '5';
      document.querySelectorAll('.kb-in').forEach(el => {
        el.addEventListener('input', calcKB);
        el.addEventListener('change', calcKB);
      });
      calcKB();
    }, 50);
  </script>
</CalculatorLayout>
