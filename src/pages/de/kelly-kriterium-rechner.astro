---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kelly-Kriterium Rechner – Optimale Einsatzgröße berechnen";
const description = "Berechnen Sie die optimale Einsatzgröße für Wetten und Investitionen.";
const relatedCalcs = [
  { name: "Zinssatz Rechner", url: "/de/zinssatz-rechner", description: "Zinssätze & Zinseszinsen." },
  { name: "Lagerumschlag Rechner", url: "/de/lagerumschlag-rechner", description: "Lagerumschlaghäufigkeit." },
  { name: "Rechnungsrechner", url: "/de/rechnungs-rechner", description: "Rechnungen mit MwSt." },
  { name: "IQ-Wert Rechner", url: "/de/iq-wert-rechner", description: "IQ-Wert & Perzentil." },
];
---
<CalculatorLayout lang="de" enSlug="kelly-criterion-calculator" title={title} description={description} calculatorName="Kelly-Kriterium Rechner" keywords="Kelly Kriterium, optimale Einsatzgröße, Kelly Formel, Sportwetten, Portfoliomanagement, Bankroll Management" breadcrumbs={[{ name: "Kelly-Kriterium Rechner", url: "/de/kelly-kriterium-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kelly-Kriterium Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den optimalen Einsatz nach dem Kelly-Kriterium für maximales langfristiges Wachstum bei Wetten und Investitionen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewinnwahrscheinlichkeit (%)</label><input type="number" id="kk-prob" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="55" min="1" max="99" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gewinn-Quote (Odds)</label><input type="number" id="kk-odds" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="2.0" min="1.01" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kapital / Bankroll (€)</label><input type="number" id="kk-bank" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fraktioneller Kelly (%)</label><input type="number" id="kk-frac" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="1" max="100" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Optimaler Einsatz (voller Kelly)</div>
          <div class="text-5xl font-extrabold font-mono" id="kk-result">— %</div>
          <div class="text-sm text-blue-200 mt-1" id="kk-result-eur">— €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Halber Kelly (25 %)</div><div class="text-xl font-bold" id="kk-half">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fraktioneller Kelly</div><div class="text-xl font-bold" id="kk-frac-out">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erwarteter Gewinn</div><div class="text-xl font-bold" id="kk-ev">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rechenweg</h3>
          <div class="font-mono text-xs space-y-1" id="kk-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kelly-criterion" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Das Kelly-Kriterium erklärt</h2>
      <p class="text-text-secondary">Das Kelly-Kriterium, entwickelt 1956 von John L. Kelly Jr. bei Bell Labs, ist eine mathematische Formel zur Bestimmung der optimalen Einsatzgröße, um das langfristige Wachstum eines Kapitals zu maximieren. Die Formel lautet: <strong>f* = (b × p − q) / b</strong>, wobei p die Gewinnwahrscheinlichkeit, q = 1−p die Verlustwahrscheinlichkeit und b die Netto-Gewinnquote (Odds − 1) ist.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>f* = (b × p − q) / b</p>
        <p>b = Netto-Odds (Gewinn-Odds − 1)</p>
        <p>p = Gewinnwahrscheinlichkeit</p>
        <p>q = 1 − p (Verlustwahrscheinlichkeit)</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der fraktionelle Kelly?</h4>
          <p class="text-text-secondary mt-1">Da der volle Kelly bei Schätzfehlern der Wahrscheinlichkeit zu großen Verlusten führen kann, empfehlen Praktiker oft den halben (50 %) oder einen Viertel-Kelly (25 %). Dies reduziert das Risiko erheblich bei nur geringfügig niedrigerem Erwartungswert des Wachstums.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wann ist der Kelly-Einsatz negativ?</h4>
          <p class="text-text-secondary mt-1">Ist das Kelly-Ergebnis negativ oder null, hat die Wette keinen positiven Erwartungswert – man sollte nicht setzen. Dies passiert, wenn b × p kleiner oder gleich q ist, d.h. die Quoten die Gewinnwahrscheinlichkeit nicht ausreichend kompensieren.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Kann das Kelly-Kriterium für Aktieninvestitionen genutzt werden?</h4>
          <p class="text-text-secondary mt-1">Ja, das Kelly-Kriterium wird im Portfoliomanagement als Positionsgrößenformel genutzt. Für Aktien wird die Formel angepasst: f* = (μ − r) / σ², wobei μ die erwartete Rendite, r der risikofreie Zinssatz und σ² die Varianz der Renditen ist.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welche Einschränkungen hat das Kelly-Kriterium?</h4>
          <p class="text-text-secondary mt-1">Das Modell setzt voraus, dass Wahrscheinlichkeiten und Quoten exakt bekannt sind – in der Praxis sind sie geschätzt. Schätzfehler führen zu Überinvestition und hohen Verlusten. Zudem ignoriert Kelly persönliche Risikoaversion, da es ausschließlich Kapitalwachstum maximiert.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKK() {
      const prob = parseFloat((document.getElementById('kk-prob') as HTMLInputElement).value) / 100 || 0.55;
      const odds = parseFloat((document.getElementById('kk-odds') as HTMLInputElement).value) || 2.0;
      const bank = parseFloat((document.getElementById('kk-bank') as HTMLInputElement).value) || 1000;
      const fracPct = parseFloat((document.getElementById('kk-frac') as HTMLInputElement).value) || 50;
      const q = 1 - prob;
      const b = odds - 1;
      const kelly = (b * prob - q) / b;
      const kellyPct = kelly * 100;
      const kellyEur = kelly * bank;
      const halfKellyEur = kelly * 0.25 * bank;
      const fracKellyEur = kelly * (fracPct / 100) * bank;
      const ev = prob * b - q;
      const fmt2 = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('kk-result')!.textContent = kellyPct.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
      document.getElementById('kk-result-eur')!.textContent = kelly > 0 ? fmtEur(kellyEur) + ' Einsatz' : 'Kein positiver Erwartungswert – nicht setzen!';
      document.getElementById('kk-half')!.textContent = kelly > 0 ? fmtEur(halfKellyEur) : '—';
      document.getElementById('kk-frac-out')!.textContent = kelly > 0 ? fmtEur(fracKellyEur) + ' (' + fracPct + ' %)' : '—';
      document.getElementById('kk-ev')!.textContent = ev.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) + ' je €1';
      const steps = [
        'p = ' + (prob * 100).toFixed(1) + ' % Gewinnwahrsch.',
        'q = 1 − p = ' + (q * 100).toFixed(1) + ' %',
        'b = Odds − 1 = ' + odds + ' − 1 = ' + fmt2(b),
        'f* = (b × p − q) / b = (' + fmt2(b) + ' × ' + fmt2(prob) + ' − ' + fmt2(q) + ') / ' + fmt2(b),
        'f* = ' + fmt2(kelly) + ' = ' + fmt2(kellyPct) + ' % des Kapitals',
        'Einsatz = ' + fmt2(kellyPct) + ' % × ' + fmtEur(bank) + ' = ' + fmtEur(kellyEur),
      ];
      document.getElementById('kk-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kk-in').forEach(el => { el.addEventListener('input', calcKK); el.addEventListener('change', calcKK); });
      calcKK();
    }, 50);
  </script>
</CalculatorLayout>
