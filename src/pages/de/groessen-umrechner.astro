---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Gr&ouml;&szlig;en-Umrechner - Fu&szlig;/Zoll in Zentimeter";
const description = "Rechnen Sie K&ouml;rpergr&ouml;&szlig;e zwischen Fu&szlig; &amp; Zoll, Zentimeter, Meter und Zoll um.";

const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Idealgewicht-Rechner", url: "/de/idealgewicht-rechner", description: "Idealgewicht." },
  { name: "L&auml;ngen-Umrechner", url: "/de/laengen-umrechner", description: "L&auml;nge umrechnen." },
  { name: "Gewicht-Umrechner", url: "/de/gewicht-umrechner", description: "Gewicht umrechnen." },
  { name: "Schuhgr&ouml;&szlig;en-Umrechner", url: "/de/schuhgroessen-umrechner", description: "Schuhgr&ouml;&szlig;en." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Gr&ouml;&szlig;en-Umrechner"
  keywords="gr&ouml;&szlig;e umrechner, fu&szlig; in cm, cm in fu&szlig;, gr&ouml;&szlig;e rechner, gr&ouml;&szlig;enumrechnung"
  breadcrumbs={[{ name: "Gr&ouml;&szlig;en-Umrechner", url: "/de/groessen-umrechner" }]}
  lang="de"
  enSlug="height-converter"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gr&ouml;&szlig;en-Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie K&ouml;rpergr&ouml;&szlig;e zwischen Fu&szlig;/Zoll und metrischen Einheiten um.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fu&szlig;</label><input type="number" id="gude-ft" class="gude-imp w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1" min="0" max="9" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zoll (Inch)</label><input type="number" id="gude-in" class="gude-imp w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="10" min="0" max="11" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Zentimeter</label><input type="number" id="gude-cm" class="gude-met w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="177.8" min="0" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">K&ouml;rpergr&ouml;&szlig;e</div>
          <div class="text-4xl font-extrabold font-mono" id="gude-result">177,8 cm</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Meter</div><div class="text-xl font-bold font-mono" id="gude-m">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtzoll</div><div class="text-xl font-bold font-mono" id="gude-tin">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Millimeter</div><div class="text-xl font-bold font-mono" id="gude-mm">0</div></div>
        </div>
      </div>

      <ShareButton calculatorId="groessen-umrechner-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gr&ouml;&szlig;en umrechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>1 Fu&szlig; = 12 Zoll = 30,48 cm</p>
        <p>1 Zoll = 2,54 cm</p>
        <p>cm = (Fu&szlig; &times; 12 + Zoll) &times; 2,54</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufige Umrechnungen</h3>
      <p>Die h&auml;ufigsten Gr&ouml;&szlig;enumrechnungen:</p>
      <ul>
        <li>5'0" = 152,4 cm</li>
        <li>5'6" = 167,6 cm</li>
        <li>5'10" = 177,8 cm</li>
        <li>6'0" = 182,9 cm</li>
        <li>6'3" = 190,5 cm</li>
      </ul>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie gro&szlig; ist 5 Fu&szlig; 9 Zoll in cm?</strong> 5'9" entspricht 175,3 cm. Berechnung: (5 &times; 12 + 9) &times; 2,54 = 69 &times; 2,54 = 175,26 cm.</p>
      <p><strong>Was ist die durchschnittliche K&ouml;rpergr&ouml;&szlig;e in Deutschland?</strong> Die durchschnittliche K&ouml;rpergr&ouml;&szlig;e in Deutschland betr&auml;gt etwa 180 cm f&uuml;r M&auml;nner und 167 cm f&uuml;r Frauen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function updateFromImpDE() {
      const ft = parseInt((document.getElementById('gude-ft') as HTMLInputElement).value) || 0;
      const inches = parseFloat((document.getElementById('gude-in') as HTMLInputElement).value) || 0;
      const totalIn = ft * 12 + inches;
      const cm = totalIn * 2.54;
      (document.getElementById('gude-cm') as HTMLInputElement).value = cm.toFixed(1);
      updateDisplayDE(totalIn, cm);
    }

    function updateFromMetDE() {
      const cm = parseFloat((document.getElementById('gude-cm') as HTMLInputElement).value) || 0;
      const totalIn = cm / 2.54;
      const ft = Math.floor(totalIn / 12);
      const inches = totalIn - ft * 12;
      (document.getElementById('gude-ft') as HTMLInputElement).value = String(ft);
      (document.getElementById('gude-in') as HTMLInputElement).value = inches.toFixed(1);
      updateDisplayDE(totalIn, cm);
    }

    function updateDisplayDE(totalIn: number, cm: number) {
      const ft = Math.floor(totalIn / 12);
      const inches = totalIn - ft * 12;
      document.getElementById('gude-result')!.textContent = ft + '\'' + inches.toFixed(1) + '" = ' + cm.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' cm';
      document.getElementById('gude-m')!.textContent = (cm / 100).toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      document.getElementById('gude-tin')!.textContent = totalIn.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('gude-mm')!.textContent = (cm * 10).toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.gude-imp').forEach(el => el.addEventListener('input', updateFromImpDE));
      document.querySelectorAll('.gude-met').forEach(el => el.addEventListener('input', updateFromMetDE));
      updateFromImpDE();
    }, 50);
  </script>
</CalculatorLayout>
