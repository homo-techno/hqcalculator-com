---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Metallgewicht Rechner - Gewicht von Metallteilen berechnen";
const description = "Berechnen Sie das Gewicht von Metallteilen aus Material, Form und Abmessungen. Stahl, Aluminium, Kupfer und mehr – für Stäbe, Bleche, Rohre und Profile.";
const relatedCalcs = [
  { name: "Metall-Ausdehnung Rechner", url: "/de/metall-ausdehnung-rechner", description: "Thermische Ausdehnung." },
  { name: "Metallermüdung Rechner", url: "/de/metallmuedigkeit-rechner", description: "Ermüdungsberechnung." },
  { name: "Metalloberfläche Rechner", url: "/de/metalloberflaeche-rechner", description: "Oberflächenbehandlung." },
  { name: "Mauerwerksanker Rechner", url: "/de/mauerwerksanker-rechner", description: "Ankertragfähigkeiten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="metal-weight-calculator" calculatorName="Metallgewicht Rechner" keywords="Metallgewicht Rechner, Stahlgewicht, Aluminiumgewicht, Rohrgewicht, Blechgewicht berechnen" breadcrumbs={[{ name: "Metallgewicht Rechner", url: "/de/metallgewicht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Metallgewicht Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Gewicht von Metallteilen schnell und präzise – für verschiedene Materialien, Formen und Abmessungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Material</label>
            <select id="mg-mat" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="7.85" selected>Stahl / Eisen (7,85 g/cm³)</option>
              <option value="7.9">Edelstahl (7,90 g/cm³)</option>
              <option value="2.7">Aluminium (2,70 g/cm³)</option>
              <option value="8.9">Kupfer (8,90 g/cm³)</option>
              <option value="8.5">Messing (8,50 g/cm³)</option>
              <option value="7.2">Gusseisen (7,20 g/cm³)</option>
              <option value="8.4">Bronze (8,40 g/cm³)</option>
              <option value="11.3">Blei (11,30 g/cm³)</option>
              <option value="7.15">Zink (7,15 g/cm³)</option>
              <option value="4.5">Titan (4,50 g/cm³)</option>
              <option value="custom">Benutzerdefiniert</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Form</label>
            <select id="mg-shape" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="rod-round" selected>Rundstab</option>
              <option value="rod-square">Vierkantprofil</option>
              <option value="sheet">Blech / Platte</option>
              <option value="pipe">Rundrohr</option>
              <option value="square-pipe">Vierkantrohr</option>
              <option value="hex">Sechskantstab</option>
            </select>
          </div>
        </div>
        <div id="mg-custom-row" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Dichte (g/cm³)</label>
          <input type="number" id="mg-density-custom" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7.85" step="0.01" min="0.1">
        </div>
        <div id="mg-dims" class="grid grid-cols-3 gap-3">
          <div id="mg-d1-wrap"><label class="block text-xs font-medium text-text mb-1" id="mg-d1-lbl">Durchmesser (mm)</label><input type="number" id="mg-d1" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0.1" step="0.1"></div>
          <div id="mg-d2-wrap" class="hidden"><label class="block text-xs font-medium text-text mb-1" id="mg-d2-lbl">Breite (mm)</label><input type="number" id="mg-d2" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0.1" step="0.1"></div>
          <div id="mg-d3-wrap" class="hidden"><label class="block text-xs font-medium text-text mb-1" id="mg-d3-lbl">Wanddicke (mm)</label><input type="number" id="mg-d3" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.1" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Länge / Höhe (mm)</label><input type="number" id="mg-len" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="0.1" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Anzahl Stücke</label><input type="number" id="mg-qty" class="mg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtgewicht</div>
          <div class="text-5xl font-extrabold font-mono" id="mg-weight">--</div>
          <div class="text-sm text-blue-200 mt-1" id="mg-per">-- kg pro Stück</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen</div><div class="text-xl font-bold" id="mg-vol">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dichte</div><div class="text-xl font-bold" id="mg-dens">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Querschnitt</div><div class="text-xl font-bold" id="mg-cross">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="metallgewicht" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Metallgewicht schnell berechnen</h2>
      <p>Das Gewicht eines Metallteils ergibt sich aus Volumen × Dichte. Für gängige Formen gilt: Rundstab: V = π/4 × d² × L; Blech: V = a × b × t; Rohr: V = π/4 × (D² − d²) × L. Stahl hat eine Dichte von ca. 7,85 g/cm³, Aluminium von 2,70 g/cm³ – Aluminiumteile sind damit bei gleicher Form etwa 3× leichter als Stahlteile.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie schwer ist 1 m Stahlrohr?</strong> Das hängt vom Außendurchmesser und der Wanddicke ab. Ein Rohr 50×5 mm wiegt ca. 5,6 kg/m, ein Rohr 100×5 mm etwa 11,8 kg/m.</p>
      <p><strong>Wie berechne ich das Gewicht eines Aluminiumblechs?</strong> Gewicht (kg) = Länge (m) × Breite (m) × Dicke (m) × 2700 (Dichte in kg/m³). Ein Aluminiumblech 1000×500×3 mm wiegt: 1 × 0,5 × 0,003 × 2700 = 4,05 kg.</p>
      <p><strong>Welches Metall ist am leichtesten?</strong> Von den gängigen Konstruktionsmetallen ist Aluminium das leichteste (2,70 g/cm³), gefolgt von Titan (4,50 g/cm³) und Stahl (7,85 g/cm³).</p>
      <p><strong>Was ist der Unterschied zwischen Dichte und spezifischem Gewicht?</strong> Dichte ist die Masse pro Volumen (kg/m³ oder g/cm³). Das spezifische Gewicht ist das Verhältnis zur Dichte von Wasser und ist dimensionslos.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMG() {
      const matVal = (document.getElementById('mg-mat') as HTMLSelectElement).value;
      const shape = (document.getElementById('mg-shape') as HTMLSelectElement).value;
      const isCustom = matVal === 'custom';
      document.getElementById('mg-custom-row')!.classList.toggle('hidden', !isCustom);
      const density = isCustom ? (parseFloat((document.getElementById('mg-density-custom') as HTMLInputElement).value) || 7.85) : (parseFloat(matVal) || 7.85);
      const d1 = parseFloat((document.getElementById('mg-d1') as HTMLInputElement).value) || 0;
      const d2 = parseFloat((document.getElementById('mg-d2') as HTMLInputElement).value) || 0;
      const d3 = parseFloat((document.getElementById('mg-d3') as HTMLInputElement).value) || 0;
      const lenMm = parseFloat((document.getElementById('mg-len') as HTMLInputElement).value) || 0;
      const qty = parseInt((document.getElementById('mg-qty') as HTMLInputElement).value) || 1;
      const d1Lbl = document.getElementById('mg-d1-lbl')!;
      const d2Wrap = document.getElementById('mg-d2-wrap')!;
      const d3Wrap = document.getElementById('mg-d3-wrap')!;
      let crossMm2 = 0;
      if (shape === 'rod-round') {
        d1Lbl.textContent = 'Durchmesser (mm)'; d2Wrap.classList.add('hidden'); d3Wrap.classList.add('hidden');
        crossMm2 = Math.PI / 4 * d1 * d1;
      } else if (shape === 'rod-square') {
        d1Lbl.textContent = 'Seite a (mm)'; d2Wrap.classList.remove('hidden'); document.getElementById('mg-d2-lbl')!.textContent = 'Seite b (mm)'; d3Wrap.classList.add('hidden');
        crossMm2 = d1 * d2;
      } else if (shape === 'sheet') {
        d1Lbl.textContent = 'Breite (mm)'; d2Wrap.classList.remove('hidden'); document.getElementById('mg-d2-lbl')!.textContent = 'Dicke (mm)'; d3Wrap.classList.add('hidden');
        crossMm2 = d1 * d2;
      } else if (shape === 'pipe') {
        d1Lbl.textContent = 'Außendurchm. (mm)'; d2Wrap.classList.add('hidden'); d3Wrap.classList.remove('hidden'); document.getElementById('mg-d3-lbl')!.textContent = 'Wanddicke (mm)';
        const ri = d1 / 2 - d3;
        crossMm2 = Math.PI / 4 * (d1 * d1 - 4 * ri * ri);
      } else if (shape === 'square-pipe') {
        d1Lbl.textContent = 'Außenseite (mm)'; d2Wrap.classList.add('hidden'); d3Wrap.classList.remove('hidden'); document.getElementById('mg-d3-lbl')!.textContent = 'Wanddicke (mm)';
        const inner = d1 - 2 * d3;
        crossMm2 = d1 * d1 - inner * inner;
      } else if (shape === 'hex') {
        d1Lbl.textContent = 'Schlüsselweite (mm)'; d2Wrap.classList.add('hidden'); d3Wrap.classList.add('hidden');
        crossMm2 = (Math.sqrt(3) / 2) * d1 * d1;
      }
      const volMm3 = crossMm2 * lenMm;
      const volCm3 = volMm3 / 1000;
      const massG = volCm3 * density;
      const massKg = massG / 1000;
      const totalKg = massKg * qty;
      const fmtKg = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 3 }) + ' kg';
      document.getElementById('mg-weight')!.textContent = totalKg > 0 ? fmtKg(totalKg) : '--';
      document.getElementById('mg-per')!.textContent = massKg > 0 ? fmtKg(massKg) + ' pro Stück' : '--';
      document.getElementById('mg-vol')!.textContent = volCm3 > 0 ? volCm3.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' cm³' : '--';
      document.getElementById('mg-dens')!.textContent = density.toLocaleString('de-DE') + ' g/cm³';
      document.getElementById('mg-cross')!.textContent = crossMm2 > 0 ? crossMm2.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' mm²' : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mg-in').forEach(el => { el.addEventListener('input', calcMG); el.addEventListener('change', calcMG); });
      calcMG();
    }, 50);
  </script>
</CalculatorLayout>
