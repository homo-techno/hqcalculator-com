---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Cashback-Rechner – Kreditkarten-Prämien berechnen";
const description = "Berechnen Sie Ihre Cashback-Prämien nach Ausgabekategorie. Vergleichen Sie Karten und maximieren Sie Ihre Rückerstattungen.";
const relatedCalcs = [
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
  { name: "Festgeld-Rechner", url: "/de/festgeld-rechner", description: "Festgeld." },
  { name: "Eigenkapitalrendite-Rechner", url: "/de/eigenkapitalrendite-rechner", description: "Rendite." },
  { name: "CO₂-Steuer-Rechner", url: "/de/co2-steuer-rechner", description: "CO₂-Steuer." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Cashback-Rechner" enSlug="cash-back-calculator" keywords="Cashback Rechner, Kreditkarten Prämien, Cashback Vergleich, Rückerstattung, Bonusprogramm" breadcrumbs={[{ name: "Cashback-Rechner", url: "/de/cashback-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Cashback-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihre Cashback-Prämien nach Ausgabekategorie.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lebensmittel (€/Monat)</label><input type="number" id="cbr-groc" class="cbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tanken (€/Monat)</label><input type="number" id="cbr-gas" class="cbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Restaurant (€/Monat)</label><input type="number" id="cbr-dine" class="cbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Online-Shopping (€/Monat)</label><input type="number" id="cbr-online" class="cbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Sonstige Ausgaben (€/Monat)</label><input type="number" id="cbr-other" class="cbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Jahresgebühr (€)</label><input type="number" id="cbr-fee" class="cbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="grid grid-cols-5 gap-2">
          <div><label class="block text-[10px] text-text-muted mb-1">Lebenm. %</label><input type="number" id="cbr-rg" class="cbr-in w-full px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" min="0" max="10" step="0.5"></div>
          <div><label class="block text-[10px] text-text-muted mb-1">Tanken %</label><input type="number" id="cbr-ra" class="cbr-in w-full px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" min="0" max="10" step="0.5"></div>
          <div><label class="block text-[10px] text-text-muted mb-1">Essen %</label><input type="number" id="cbr-rd" class="cbr-in w-full px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" min="0" max="10" step="0.5"></div>
          <div><label class="block text-[10px] text-text-muted mb-1">Online %</label><input type="number" id="cbr-ro" class="cbr-in w-full px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" min="0" max="10" step="0.5"></div>
          <div><label class="block text-[10px] text-text-muted mb-1">Sonst. %</label><input type="number" id="cbr-rx" class="cbr-in w-full px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" min="0" max="10" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jährliches Cashback (netto)</div>
          <div class="text-5xl font-extrabold font-mono" id="cbr-annual">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Prämie</div><div class="text-xl font-bold" id="cbr-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effektive Rate</div><div class="text-xl font-bold" id="cbr-eff">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Ausgaben</div><div class="text-xl font-bold" id="cbr-spend">0 €</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cash-back" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Cashback optimal nutzen</h2>
      <p>Cashback-Kreditkarten bieten zwischen 0,5% und 5% Rückerstattung je nach Kategorie. Achten Sie darauf, dass die Jahresgebühr nicht die Prämien übersteigt.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCBR() {
      const groc = parseFloat((document.getElementById('cbr-groc') as HTMLInputElement).value) || 0;
      const gas = parseFloat((document.getElementById('cbr-gas') as HTMLInputElement).value) || 0;
      const dine = parseFloat((document.getElementById('cbr-dine') as HTMLInputElement).value) || 0;
      const online = parseFloat((document.getElementById('cbr-online') as HTMLInputElement).value) || 0;
      const other = parseFloat((document.getElementById('cbr-other') as HTMLInputElement).value) || 0;
      const fee = parseFloat((document.getElementById('cbr-fee') as HTMLInputElement).value) || 0;
      const rg = (parseFloat((document.getElementById('cbr-rg') as HTMLInputElement).value) || 0) / 100;
      const ra = (parseFloat((document.getElementById('cbr-ra') as HTMLInputElement).value) || 0) / 100;
      const rd = (parseFloat((document.getElementById('cbr-rd') as HTMLInputElement).value) || 0) / 100;
      const ro = (parseFloat((document.getElementById('cbr-ro') as HTMLInputElement).value) || 0) / 100;
      const rx = (parseFloat((document.getElementById('cbr-rx') as HTMLInputElement).value) || 0) / 100;
      const monthlyReward = groc * rg + gas * ra + dine * rd + online * ro + other * rx;
      const annualReward = monthlyReward * 12 - fee;
      const totalSpend = groc + gas + dine + online + other;
      const eff = totalSpend > 0 ? (annualReward / (totalSpend * 12)) * 100 : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.getElementById('cbr-annual')!.textContent = fmt(annualReward) + ' €';
      document.getElementById('cbr-monthly')!.textContent = fmt(monthlyReward) + ' €';
      document.getElementById('cbr-eff')!.textContent = eff.toFixed(2) + '%';
      document.getElementById('cbr-spend')!.textContent = totalSpend.toLocaleString('de-DE') + ' €';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cbr-groc') as HTMLInputElement).value = '400';
      (document.getElementById('cbr-gas') as HTMLInputElement).value = '150';
      (document.getElementById('cbr-dine') as HTMLInputElement).value = '200';
      (document.getElementById('cbr-online') as HTMLInputElement).value = '200';
      (document.getElementById('cbr-other') as HTMLInputElement).value = '400';
      (document.getElementById('cbr-fee') as HTMLInputElement).value = '0';
      (document.getElementById('cbr-rg') as HTMLInputElement).value = '2';
      (document.getElementById('cbr-ra') as HTMLInputElement).value = '2';
      (document.getElementById('cbr-rd') as HTMLInputElement).value = '3';
      (document.getElementById('cbr-ro') as HTMLInputElement).value = '5';
      (document.getElementById('cbr-rx') as HTMLInputElement).value = '1';
      document.querySelectorAll('.cbr-in').forEach(el => el.addEventListener('input', calcCBR));
      calcCBR();
    }, 50);
  </script>
</CalculatorLayout>
