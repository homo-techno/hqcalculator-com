---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gleitverhältnis-Rechner - Gleitdistanz, Geschwindigkeit & Notfallreichweite";
const description = "Berechnen Sie die Gleitdistanz aus Höhe und Gleitverhältnis. Finden Sie die beste Gleitgeschwindigkeit, Gegenwindeffekte und Notfallreichweite.";
const relatedCalcs = [
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Positionsgenauigkeit." },
  { name: "Grosskreis-Rechner", url: "/de/grosskreis-rechner", description: "Grosskreis-Distanz." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Golf-Handicap-Rechner", url: "/de/golf-handicap-rechner", description: "Golf-Handicap." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Gleitverhältnis-Rechner" enSlug="glide-ratio-calculator" keywords="Gleitverhältnis, Gleitdistanz, beste Gleitgeschwindigkeit, Motorausfall, Notfallreichweite, L/D-Verhältnis, Sinkrate" breadcrumbs={[{ name: "Gleitverhältnis-Rechner", url: "/de/gleitverhaeltnis-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gleitverhältnis-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie Gleitdistanz, beste Gleitgeschwindigkeit und Notfallreichweite bei Motorausfall.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label for="glr-alt" class="block text-sm font-medium text-text mb-1">Höhe AGL (ft)</label>
          <input type="number" id="glr-alt" class="glr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="500" />
        </div>
        <div>
          <label for="glr-ratio" class="block text-sm font-medium text-text mb-1">Gleitverhältnis (z.B. 9 für 9:1)</label>
          <input type="number" id="glr-ratio" class="glr-in w-full border border-border rounded-lg px-3 py-2" min="1" max="60" step="0.5" />
        </div>
        <div>
          <label for="glr-bg" class="block text-sm font-medium text-text mb-1">Beste Gleitgeschwindigkeit (kts IAS)</label>
          <input type="number" id="glr-bg" class="glr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="1" />
        </div>
        <div>
          <label for="glr-hw" class="block text-sm font-medium text-text mb-1">Gegenwind (kts, negativ = Rückenwind)</label>
          <input type="number" id="glr-hw" class="glr-in w-full border border-border rounded-lg px-3 py-2" step="5" />
        </div>
        <div>
          <label for="glr-wt" class="block text-sm font-medium text-text mb-1">Aktuelles Gewicht (lbs)</label>
          <input type="number" id="glr-wt" class="glr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="50" />
        </div>
        <div>
          <label for="glr-mgw" class="block text-sm font-medium text-text mb-1">Max. Abfluggewicht (lbs)</label>
          <input type="number" id="glr-mgw" class="glr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="50" />
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Maximale Gleitdistanz</div>
          <div class="text-5xl font-extrabold font-mono" id="glr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Windstille Gleitdistanz</div><div class="text-xl font-bold font-mono" id="glr-nowind">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gleitzeit</div><div class="text-xl font-bold font-mono" id="glr-time">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sinkrate</div><div class="text-xl font-bold font-mono" id="glr-sink">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Angepasste Gleitgeschw.</div><div class="text-xl font-bold font-mono" id="glr-adjbg">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gleitwinkel</div><div class="text-xl font-bold font-mono" id="glr-angle">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundgeschwindigkeit</div><div class="text-xl font-bold font-mono" id="glr-gs">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gleitverhaeltnis" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gleitverhältnis und Notfallreichweite</h2>
      <p>Das Gleitverhältnis (L/D) gibt an, wie weit ein Flugzeug pro verlorener Höheneinheit gleiten kann. Ein Verhältnis von 9:1 bedeutet, dass aus 1.000 Fuß Höhe 9.000 Fuß (ca. 1,5 NM) zurückgelegt werden können. Die beste Gleitgeschwindigkeit wird durch das Gewicht beeinflusst.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie beeinflusst Wind die Gleitdistanz?</strong> Gegenwind verringert die Gleitdistanz über Grund, Rückenwind vergrößert sie. Das Gleitverhältnis durch die Luft bleibt unverändert.</p>
      <p><strong>Wie passt man die Gleitgeschwindigkeit ans Gewicht an?</strong> Die angepasste Gleitgeschwindigkeit = Basis-Gleitgeschwindigkeit x Wurzel(aktuelles Gewicht / max. Gewicht).</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGLR() {
      const alt = parseFloat((document.getElementById('glr-alt') as HTMLInputElement).value) || 5000;
      const ratio = parseFloat((document.getElementById('glr-ratio') as HTMLInputElement).value) || 9;
      const bg = parseFloat((document.getElementById('glr-bg') as HTMLInputElement).value) || 68;
      const hw = parseFloat((document.getElementById('glr-hw') as HTMLInputElement).value) || 0;
      const wt = parseFloat((document.getElementById('glr-wt') as HTMLInputElement).value) || 2200;
      const mgw = parseFloat((document.getElementById('glr-mgw') as HTMLInputElement).value) || 2550;

      const glideFt = alt * ratio;
      const glideNM = glideFt / 6076.12;
      const bgAdj = bg * Math.sqrt(wt / mgw);
      const bgFtMin = bgAdj * 6076.12 / 60;
      const sinkRate = bgFtMin / ratio;
      const glideTimeMin = sinkRate > 0 ? alt / sinkRate : 0;
      const gs = bgAdj - hw;
      const windGlideNM = (glideTimeMin / 60) * gs;
      const glideAngle = Math.atan(1 / ratio) * 180 / Math.PI;

      const mins = Math.floor(glideTimeMin);
      const secs = Math.round((glideTimeMin - mins) * 60);

      document.getElementById('glr-result')!.textContent = windGlideNM.toFixed(1) + ' NM';
      document.getElementById('glr-nowind')!.textContent = glideNM.toFixed(1) + ' NM';
      document.getElementById('glr-time')!.textContent = mins + 'm ' + secs + 's';
      document.getElementById('glr-sink')!.textContent = Math.round(sinkRate) + ' FPM';
      document.getElementById('glr-adjbg')!.textContent = bgAdj.toFixed(0) + ' kts';
      document.getElementById('glr-angle')!.textContent = glideAngle.toFixed(1) + '\u00b0';
      document.getElementById('glr-gs')!.textContent = gs.toFixed(0) + ' kts';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('glr-alt') as HTMLInputElement).value = '5000';
      (document.getElementById('glr-ratio') as HTMLInputElement).value = '9';
      (document.getElementById('glr-bg') as HTMLInputElement).value = '68';
      (document.getElementById('glr-hw') as HTMLInputElement).value = '10';
      (document.getElementById('glr-wt') as HTMLInputElement).value = '2200';
      (document.getElementById('glr-mgw') as HTMLInputElement).value = '2550';
      document.querySelectorAll('.glr-in').forEach(el => { el.addEventListener('input', calcGLR); el.addEventListener('change', calcGLR); });
      calcGLR();
    }, 50);
  </script>
</CalculatorLayout>
