---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Färbe-Verhältnis-Rechner - Farbstoff & Mischungsverhältnis";
const description = "Berechnen Sie das optimale Mischungsverhältnis von Farbstoff zu Material. Ideal für Textilfarben, Haarfarben und industrielle Färbeprozesse.";

const relatedCalcs = [
  { name: "Verdünnungsrechner", url: "/de/verduennungsrechner", description: "Verdünnungen berechnen." },
  { name: "Mischungsrechner", url: "/de/mischungsrechner", description: "Mischverhältnisse." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozent berechnen." },
  { name: "Konzentrationsrechner", url: "/de/konzentrationsrechner", description: "Konzentrationen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Färbe-Verhältnis-Rechner" lang="de" enSlug="dye-ratio-calculator" keywords="färbe verhältnis, farbstoff mischung, textilfarbe rechner, dye ratio, farbe mischen" breadcrumbs={[{ name: "Färbe-Verhältnis-Rechner", url: "/de/faerbe-verhaeltnis-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">F&auml;rbe-Verh&auml;ltnis-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Mischungsverh&auml;ltnis von Farbstoff zu Material f&uuml;r Textilien, Haare oder industrielle Anwendungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Materialgewicht (g)</label><input type="number" id="dye-weight" class="dye-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="10" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Farbstoffanteil (%)</label><input type="number" id="dye-pct" class="dye-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" max="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Flottenverh&auml;ltnis (1:x)</label><input type="number" id="dye-liquor" class="dye-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Farbstoffpreis (&euro;/kg)</label><input type="number" id="dye-price" class="dye-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigter Farbstoff</div>
          <div class="text-5xl font-extrabold font-mono" id="dye-result">0 g</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wassermenge</div><div class="text-xl font-bold" id="dye-water">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtflotte</div><div class="text-xl font-bold" id="dye-total">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verh&auml;ltnis</div><div class="text-xl font-bold" id="dye-ratio">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Farbstoffkosten</div><div class="text-xl font-bold" id="dye-cost">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="dye-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="dye-ratio-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">F&auml;rbe-Verh&auml;ltnis berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Farbstoff (g) = Materialgewicht (g) &times; Farbstoffanteil (%) / 100</p>
        <p>Wassermenge (ml) = Materialgewicht (g) &times; Flottenverh&auml;ltnis</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist das Flottenverh&auml;ltnis?</strong> Das Verh&auml;ltnis von Materialgewicht zu Wasservolumen (z.B. 1:20 bedeutet 20 ml Wasser pro Gramm Material).</p>
      <p><strong>Wie viel Farbstoff brauche ich f&uuml;r kr&auml;ftige Farben?</strong> Typisch sind 2&ndash;4% des Materialgewichts, f&uuml;r sehr intensive Farben bis zu 6&ndash;8%.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDye() {
      const weight = parseFloat((document.getElementById('dye-weight') as HTMLInputElement).value) || 0;
      const pct = parseFloat((document.getElementById('dye-pct') as HTMLInputElement).value) || 0;
      const liquor = parseFloat((document.getElementById('dye-liquor') as HTMLInputElement).value) || 1;
      const price = parseFloat((document.getElementById('dye-price') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const dyeAmount = weight * pct / 100;
      steps.push('Farbstoff = ' + fmt(weight) + ' g x ' + fmt(pct) + '% / 100 = ' + fmt(dyeAmount) + ' g');
      const waterMl = weight * liquor;
      steps.push('Wasser = ' + fmt(weight) + ' g x ' + liquor + ' = ' + fmt(waterMl) + ' ml');
      const totalFlotte = waterMl + dyeAmount;
      steps.push('Gesamtflotte = ' + fmt(waterMl) + ' + ' + fmt(dyeAmount) + ' = ' + fmt(totalFlotte) + ' ml');
      const ratio = dyeAmount > 0 ? waterMl / dyeAmount : 0;
      steps.push('Verhaeltnis Wasser:Farbstoff = ' + fmt(ratio) + ':1');
      const cost = (dyeAmount / 1000) * price;
      steps.push('Kosten = ' + fmt(dyeAmount) + ' g / 1000 x ' + fmt(price) + ' EUR/kg = ' + fmt(cost) + ' EUR');
      document.getElementById('dye-result')!.textContent = fmt(dyeAmount) + ' g';
      document.getElementById('dye-water')!.textContent = fmt(waterMl) + ' ml';
      document.getElementById('dye-total')!.textContent = fmt(totalFlotte) + ' ml';
      document.getElementById('dye-ratio')!.textContent = fmt(ratio) + ':1';
      document.getElementById('dye-cost')!.textContent = fmt(cost) + ' \u20AC';
      document.getElementById('dye-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('dye-weight') as HTMLInputElement).value = '500';
      (document.getElementById('dye-pct') as HTMLInputElement).value = '3';
      (document.getElementById('dye-liquor') as HTMLInputElement).value = '20';
      (document.getElementById('dye-price') as HTMLInputElement).value = '45';
      document.querySelectorAll('.dye-in').forEach(el => { el.addEventListener('input', calcDye); el.addEventListener('change', calcDye); });
      calcDye();
    }, 50);
  </script>
</CalculatorLayout>
