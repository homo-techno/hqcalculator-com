---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kosmetik-Haltbarkeit-Rechner - PAO-Tracker & Verfallsdatum";
const description = "Verfolgen Sie die Haltbarkeit von Kosmetikprodukten und die Verwendungsdauer nach dem Öffnen (PAO). Erfahren Sie, wann Make-up, Hautpflege und Beauty-Produkte ersetzt werden müssen.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kosmetik-Haltbarkeit-Rechner" enSlug="cosmetic-expiration-calculator" keywords="Kosmetik Haltbarkeit, Make-up Verfallsdatum, PAO, Verwendungsdauer, Produktablauf, Kosmetik Mindesthaltbarkeit" breadcrumbs={[{ name: "Kosmetik-Haltbarkeit-Rechner", url: "/de/kosmetik-haltbarkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kosmetik-Haltbarkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Verfolgen Sie, wann Ihre Beauty-Produkte basierend auf der PAO (Verwendungsdauer nach dem Öffnen) ablaufen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Produktkategorie</label>
          <select id="cex-product" class="cex-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="mascara">Mascara (3-6 Monate)</option>
            <option value="eyeliner_liquid">Flüssiger Eyeliner (3-6 Monate)</option>
            <option value="eyeliner_pencil">Kajal-/Eyelinerstift (12-24 Monate)</option>
            <option value="foundation_liquid" selected>Flüssige Foundation (6-12 Monate)</option>
            <option value="foundation_powder">Puder-Foundation (12-24 Monate)</option>
            <option value="concealer">Concealer (6-12 Monate)</option>
            <option value="lipstick">Lippenstift (12-18 Monate)</option>
            <option value="lip_gloss">Lipgloss (6-12 Monate)</option>
            <option value="blush_powder">Puder-Rouge (12-24 Monate)</option>
            <option value="blush_cream">Creme-Rouge (6-12 Monate)</option>
            <option value="eyeshadow_powder">Puder-Lidschatten (12-24 Monate)</option>
            <option value="eyeshadow_cream">Creme-Lidschatten (6-12 Monate)</option>
            <option value="moisturizer">Feuchtigkeitscreme (6-12 Monate)</option>
            <option value="serum">Serum (6-12 Monate)</option>
            <option value="sunscreen">Sonnenschutz (6-12 Monate)</option>
            <option value="cleanser">Reiniger (12 Monate)</option>
            <option value="nail_polish">Nagellack (12-24 Monate)</option>
            <option value="perfume">Parfüm (24-36 Monate)</option>
            <option value="setting_spray">Fixierspray (6-12 Monate)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Geöffnet am</label>
          <input type="date" id="cex-opened" class="cex-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Lagerbedingungen</label>
          <select id="cex-storage" class="cex-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.0" selected>Kühl, trocken, lichtgeschützt (ideal)</option>
            <option value="0.85">Badezimmer (feucht, warm)</option>
            <option value="0.75">Heiße Umgebung / direktes Sonnenlicht</option>
            <option value="1.1">Kühlschrank (verlängert Haltbarkeit)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Produktstatus</div>
          <div class="text-4xl font-extrabold font-mono" id="cex-status">--</div>
          <div class="text-sm text-blue-200 mt-1" id="cex-remaining">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">PAO (Verwendungsdauer)</div><div class="text-xl font-bold" id="cex-pao">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verfallsdatum</div><div class="text-xl font-bold" id="cex-expiry">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tage seit Öffnung</div><div class="text-xl font-bold" id="cex-days">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nutzungsprozent</div><div class="text-xl font-bold" id="cex-usage">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Anzeichen für Ablauf</h3>
          <div class="text-sm space-y-1" id="cex-signs"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cosmetic-expiration" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haltbarkeit von Kosmetik</h2>
      <p>Alle Kosmetikprodukte haben eine begrenzte Haltbarkeit nach dem Öffnen, gekennzeichnet durch das PAO-Symbol (Period After Opening) - ein kleines Tiegelsymbol mit einer Zahl wie "6M" oder "12M". Augenprodukte wie Mascara laufen am schnellsten ab (3-6 Monate) wegen des Infektionsrisikos. Puderprodukte halten am längsten (bis zu 24 Monate). Lagern Sie Produkte kühl und trocken.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was bedeutet das Tiegelsymbol?</strong> Das offene Tiegelsymbol mit einer Zahl (z.B. 12M) zeigt die Haltbarkeit in Monaten nach dem ersten Öffnen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCEX() {
      const product = (document.getElementById('cex-product') as HTMLSelectElement).value;
      const openedStr = (document.getElementById('cex-opened') as HTMLInputElement).value;
      const storageFactor = parseFloat((document.getElementById('cex-storage') as HTMLSelectElement).value);

      const paoMonths: Record<string, number> = {
        mascara: 4, eyeliner_liquid: 4, eyeliner_pencil: 18, foundation_liquid: 9,
        foundation_powder: 18, concealer: 9, lipstick: 15, lip_gloss: 9,
        blush_powder: 18, blush_cream: 9, eyeshadow_powder: 18, eyeshadow_cream: 9,
        moisturizer: 9, serum: 9, sunscreen: 9, cleanser: 12,
        nail_polish: 18, perfume: 30, setting_spray: 9
      };

      const basePAO = paoMonths[product] || 12;
      const adjustedPAO = Math.round(basePAO * storageFactor);

      const signs: Record<string, string[]> = {
        mascara: ['Trocknet aus oder klumpt', 'Riecht ungew\u00F6hnlich', 'Verursacht Augenreizung', 'Konsistenz ver\u00E4ndert'],
        eyeliner_liquid: ['Trocknet aus', 'Zieht Linien / h\u00E4lt nicht', 'Riecht unangenehm', 'Augenreizung'],
        eyeliner_pencil: ['Wird sehr hart', 'Farbver\u00E4nderung', 'Schwer aufzutragen'],
        foundation_liquid: ['Trennt sich oder wirkt \u00F6lig', 'Farb- oder Geruchsver\u00E4nderung', 'F\u00FChlt sich anders auf der Haut an', 'Unreinheiten'],
        foundation_powder: ['Farbver\u00E4nderung', 'Filmbildung', 'Wird kreidig oder hart'],
        concealer: ['Trennt sich', 'Wird dicker', 'Farbver\u00E4nderung', 'Unreinheiten'],
        lipstick: ['Geruch ver\u00E4ndert sich (wachsig/ranzig)', 'Trocknet aus', 'Texturver\u00E4nderung'],
        lip_gloss: ['Wird klebrig/dickfl\u00FCssig', 'Riecht unangenehm', 'Farbver\u00E4nderung'],
        blush_powder: ['Farbe verblasst', 'Harte Schicht bildet sich', 'Texturver\u00E4nderung'],
        blush_cream: ['Trocknet aus', 'Trennt sich', 'Riecht unangenehm'],
        eyeshadow_powder: ['Farbe verblasst', 'Harte Schicht', 'Br\u00F6ckelt'],
        eyeshadow_cream: ['Trocknet aus', 'Wird fleckig', 'Riecht unangenehm'],
        moisturizer: ['Trennt sich', 'Geruchsver\u00E4nderung', 'Andere Textur', 'Hautreizung'],
        serum: ['Farbver\u00E4nderung', 'Oxidiert (wird dunkel)', 'Riecht anders', 'Weniger wirksam'],
        sunscreen: ['Trennt sich', 'Konsistenz ver\u00E4ndert', 'Riecht anders', 'LSF-Wirksamkeit sinkt'],
        cleanser: ['Geruchsver\u00E4nderung', 'Trennt sich', 'Andere Textur'],
        nail_polish: ['Wird dick', 'Trennt sich', 'Wird f\u00E4dig', 'Schwer gleichm\u00E4\u00DFig aufzutragen'],
        perfume: ['Duft ver\u00E4ndert sich', 'Farbe wird dunkler', 'Wird schw\u00E4cher'],
        setting_spray: ['D\u00FCse verstopft', 'Geruchsver\u00E4nderung', 'Trennt sich']
      };

      let status = '\u00D6ffnungsdatum eingeben';
      let remaining = '';
      let daysSinceOpened = 0;
      let usagePct = 0;
      let expiryStr = '--';

      if (openedStr) {
        const opened = new Date(openedStr);
        const now = new Date();
        const expiry = new Date(opened);
        expiry.setMonth(expiry.getMonth() + adjustedPAO);

        daysSinceOpened = Math.floor((now.getTime() - opened.getTime()) / (1000 * 60 * 60 * 24));
        const totalDays = Math.floor((expiry.getTime() - opened.getTime()) / (1000 * 60 * 60 * 24));
        const daysLeft = Math.floor((expiry.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
        usagePct = Math.min(100, Math.max(0, (daysSinceOpened / totalDays) * 100));

        expiryStr = expiry.toLocaleDateString('de-DE', {day:'numeric', month:'short', year:'numeric'});

        if (daysLeft > 90) {
          status = 'In Ordnung';
          remaining = daysLeft + ' Tage verbleibend';
        } else if (daysLeft > 30) {
          status = 'Bald aufbrauchen';
          remaining = daysLeft + ' Tage verbleibend \u2014 bald ersetzen';
        } else if (daysLeft > 0) {
          status = 'Läuft bald ab';
          remaining = 'Nur noch ' + daysLeft + ' Tage!';
        } else {
          status = 'ABGELAUFEN';
          remaining = 'Vor ' + Math.abs(daysLeft) + ' Tagen abgelaufen \u2014 entsorgen';
        }
      }

      const productSigns = signs[product] || ['Auf Ver\u00E4nderungen bei Geruch, Farbe oder Textur achten.'];

      document.getElementById('cex-status')!.textContent = status;
      document.getElementById('cex-remaining')!.textContent = remaining;
      document.getElementById('cex-pao')!.textContent = adjustedPAO + ' Monate';
      document.getElementById('cex-expiry')!.textContent = expiryStr;
      document.getElementById('cex-days')!.textContent = openedStr ? daysSinceOpened.toString() : '--';
      document.getElementById('cex-usage')!.textContent = openedStr ? usagePct.toFixed(0) + '%' : '--';
      document.getElementById('cex-signs')!.innerHTML = productSigns.map(s => '<p>- ' + s + '</p>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      const today = new Date();
      today.setMonth(today.getMonth() - 3);
      (document.getElementById('cex-opened') as HTMLInputElement).value = today.toISOString().split('T')[0];
      document.querySelectorAll('.cex-in').forEach(el => { el.addEventListener('input', calcCEX); el.addEventListener('change', calcCEX); });
      calcCEX();
    }, 50);
  </script>
</CalculatorLayout>
