---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kraftstoffzuschlag-Rechner - Frachtzuschlag berechnen";
const description = "Berechnen Sie den Kraftstoffzuschlag aus Basis-Frachttarif und aktuellem Dieselpreis. Sch\u00E4tzen Sie Kosten pro Kilometer und Gesamtzuschlag f\u00FCr Frachtsendungen.";
const relatedCalcs = [
  { name: "Spritkosten-Rechner", url: "/de/spritkosten-rechner", description: "Spritkosten sch\u00E4tzen." },
  { name: "Kraftstoffeffizienz-Umrechner", url: "/de/kraftstoffeffizienz-umrechner", description: "Verbrauch umrechnen." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kraftstoffzuschlag-Rechner" lang="de" enSlug="fuel-surcharge-calculator" keywords="kraftstoffzuschlag, fracht kraftstoffkosten, kosten pro kilometer, versandzuschlag, dieselzuschlag" breadcrumbs={[{ name: "Kraftstoffzuschlag", url: "/de/kraftstoffzuschlag-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kraftstoffzuschlag-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Kraftstoffzuschlagsbetr&auml;ge basierend auf Basisfrachttarif, Dieselpreis und Streckenentfernung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Basis-Frachttarif (&euro;)</label><input type="number" id="kzr-base" class="kzr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Aktueller Dieselpreis (&euro;/Liter)</label><input type="number" id="kzr-fuel" class="kzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Basis-Dieselpreis (&euro;/Liter)</label><input type="number" id="kzr-baseline" class="kzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Streckenentfernung (km)</label><input type="number" id="kzr-distance" class="kzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (L/100km)</label><input type="number" id="kzr-consumption" class="kzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Kraftstoffzuschlag</div>
          <div class="text-5xl font-extrabold font-mono" id="kzr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zuschlag %</div><div class="text-xl font-bold font-mono" id="kzr-pct">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro km</div><div class="text-xl font-bold font-mono" id="kzr-perkm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Kraftstoffkosten</div><div class="text-xl font-bold font-mono" id="kzr-totalfuel">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamttarif</div><div class="text-xl font-bold font-mono" id="kzr-allin">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fuel-surcharge-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kraftstoffzuschlag verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Zuschlag = Basisfrachttarif &times; (Preisdifferenz / Basispreis)</p>
        <p>Kraftstoffkosten = (Entfernung / 100) &times; Verbrauch &times; Dieselpreis</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie wird der Kraftstoffzuschlag berechnet?</strong> Der Zuschlag basiert auf der Differenz zwischen dem aktuellen und dem Basis-Dieselpreis, multipliziert mit dem Basisfrachttarif.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKZR() {
      const base = parseFloat((document.getElementById('kzr-base') as HTMLInputElement).value) || 0;
      const fuelPrice = parseFloat((document.getElementById('kzr-fuel') as HTMLInputElement).value) || 0;
      const baseline = parseFloat((document.getElementById('kzr-baseline') as HTMLInputElement).value) || 0;
      const distance = parseFloat((document.getElementById('kzr-distance') as HTMLInputElement).value) || 0;
      const consumption = parseFloat((document.getElementById('kzr-consumption') as HTMLInputElement).value) || 1;
      const fuelDiff = Math.max(0, fuelPrice - baseline);
      const surchargeRate = baseline > 0 ? (fuelDiff / baseline) : 0;
      const surchargeAmt = base * surchargeRate;
      const surchargePct = surchargeRate * 100;
      const litersUsed = (distance / 100) * consumption;
      const totalFuelCost = litersUsed * fuelPrice;
      const costPerKm = distance > 0 ? totalFuelCost / distance : 0;
      const allInRate = base + surchargeAmt;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('kzr-result')!.textContent = fmt(surchargeAmt);
      document.getElementById('kzr-pct')!.textContent = surchargePct.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + '%';
      document.getElementById('kzr-perkm')!.textContent = fmt(costPerKm);
      document.getElementById('kzr-totalfuel')!.textContent = fmt(totalFuelCost);
      document.getElementById('kzr-allin')!.textContent = fmt(allInRate);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('kzr-base') as HTMLInputElement).value = '1500';
      (document.getElementById('kzr-fuel') as HTMLInputElement).value = '1.85';
      (document.getElementById('kzr-baseline') as HTMLInputElement).value = '1.50';
      (document.getElementById('kzr-distance') as HTMLInputElement).value = '800';
      (document.getElementById('kzr-consumption') as HTMLInputElement).value = '32';
      document.querySelectorAll('.kzr-in').forEach(el => { el.addEventListener('input', calcKZR); el.addEventListener('change', calcKZR); });
      calcKZR();
    }, 50);
  </script>
</CalculatorLayout>
