---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kindesunterhalt-Rechner - Monatliche Zahlungen schaetzen";
const description = "Schaetzen Sie den Kindesunterhalt nach Duesseldorfer Tabelle basierend auf Einkommen, Anzahl der Kinder und Alter.";
const relatedCalcs = [
  { name: "Spendenabzug-Rechner", url: "/de/spendenabzug-rechner", description: "Steuerersparnis." },
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI-Perzentile." },
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrung." },
  { name: "Kindergroesse-Rechner", url: "/de/kindergroesse-rechner", description: "Groessenvorhersage." },
  { name: "Kinderreise-Rechner", url: "/de/kinderreise-rechner", description: "Reisekosten." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kindesunterhalt-Rechner" enSlug="child-support-calculator" keywords="Kindesunterhalt-Rechner, Duesseldorfer Tabelle, Unterhaltsberechnung, monatlicher Unterhalt, Unterhaltspflicht" breadcrumbs={[{ name: "Kindesunterhalt-Rechner", url: "/de/kindesunterhalt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kindesunterhalt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie den monatlichen Kindesunterhalt nach der Duesseldorfer Tabelle. Tatsaechliche Betraege variieren nach Einzelfall.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Nettoeinkommen des Unterhaltspflichtigen (&euro;/Monat)</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="ku-income" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="3000" min="0" step="100">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl unterhaltsberechtigter Kinder</label>
            <select id="ku-children" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1" selected>1 Kind</option>
              <option value="2">2 Kinder</option>
              <option value="3">3 Kinder</option>
              <option value="4">4 Kinder</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Altersgruppe des juengsten Kindes</label>
            <select id="ku-agegroup" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="0-5">0-5 Jahre</option>
              <option value="6-11" selected>6-11 Jahre</option>
              <option value="12-17">12-17 Jahre</option>
              <option value="18+">Ab 18 Jahre</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kindergeld (wird haelftig angerechnet)</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="ku-kindergeld" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-lg" value="250" min="0" step="10">
            </div>
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzter monatlicher Unterhalt</div>
            <div class="text-5xl font-extrabold font-mono" id="ku-payment">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahresunterhalt</div><div class="text-xl font-bold text-secondary" id="ku-annual">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einkommensstufe</div><div class="text-xl font-bold" id="ku-stufe">--</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tabellenbetrag</div><div class="text-xl font-bold" id="ku-tabelle">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anteil am Einkommen</div><div class="text-xl font-bold" id="ku-pct">0%</div></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kindesunterhalt" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Kindesunterhalt in Deutschland</h2>
      <p>Die <strong>Duesseldorfer Tabelle</strong> ist die wichtigste Richtlinie zur Berechnung des Kindesunterhalts in Deutschland. Sie wird regelmaessig aktualisiert und richtet sich nach dem Nettoeinkommen des Unterhaltspflichtigen und dem Alter des Kindes.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Hinweis</h3>
      <p>Dieser Rechner bietet nur Schaetzwerte. Der tatsaechliche Unterhalt wird durch Familiengerichte festgelegt und beruecksichtigt Sonderbedarf, Mehrbedarf und den Selbstbehalt des Unterhaltspflichtigen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcKU() {
      const income = parseFloat((document.getElementById('ku-income') as HTMLInputElement).value) || 0;
      const children = parseInt((document.getElementById('ku-children') as HTMLSelectElement).value) || 1;
      const ageGroup = (document.getElementById('ku-agegroup') as HTMLSelectElement).value;
      const kindergeld = parseFloat((document.getElementById('ku-kindergeld') as HTMLInputElement).value) || 250;
      // Simplified Duesseldorfer Tabelle 2024 (monthly amounts by income group and age)
      // Income groups: up to 2100, 2101-2500, 2501-2900, 2901-3300, 3301-3700, 3701-4100, etc.
      const incomeGroups = [2100, 2500, 2900, 3300, 3700, 4100, 4500, 4900, 5500, 6200];
      const baseAmounts: Record<string, number[]> = {
        '0-5':   [480, 504, 528, 552, 576, 618, 660, 702, 744, 786],
        '6-11':  [551, 579, 607, 634, 662, 710, 758, 806, 854, 903],
        '12-17': [645, 677, 710, 742, 775, 831, 887, 944, 1000, 1056],
        '18+':   [689, 724, 758, 793, 827, 887, 947, 1008, 1068, 1128],
      };
      let stufe = 0;
      for (let i = 0; i < incomeGroups.length; i++) {
        if (income <= incomeGroups[i]) { stufe = i; break; }
        if (i === incomeGroups.length - 1) stufe = i;
      }
      const base = baseAmounts[ageGroup][stufe];
      // Half of Kindergeld is deducted
      const zahlbetrag = Math.max(0, base - (kindergeld / 2));
      const totalMonthly = zahlbetrag * children;
      const annualSupport = totalMonthly * 12;
      const pctOfIncome = income > 0 ? (totalMonthly / income) * 100 : 0;
      document.getElementById('ku-payment')!.textContent = fmt(totalMonthly);
      document.getElementById('ku-annual')!.textContent = fmt(annualSupport);
      document.getElementById('ku-stufe')!.textContent = 'Stufe ' + (stufe + 1);
      document.getElementById('ku-tabelle')!.textContent = fmt(base) + ' / Kind';
      document.getElementById('ku-pct')!.textContent = pctOfIncome.toFixed(1) + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['ku-income', 'ku-kindergeld'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcKU); el.addEventListener('change', calcKU); }
      });
      ['ku-children', 'ku-agegroup'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('change', calcKU);
      });
      calcKU();
    }, 50);
  </script>
</CalculatorLayout>
