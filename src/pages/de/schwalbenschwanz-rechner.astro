---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schwalbenschwanz-Rechner - Zinken- & Schwalbenschwanz-Layout 2026";
const description = "Berechne das Layout einer Schwalbenschwanzverbindung: Zinkenanzahl, Abstaende, Winkel und Breiten. Plane perfekte hand- oder maschinengeschnittene Schwalbenschwaenze.";

const relatedCalcs = [
  { name: "Duebel-Rechner", url: "/de/duebel-rechner", description: "Duebelverbindung planen." },
  { name: "Holzrechner", url: "/de/holzrechner", description: "Holzberechnung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Schwalbenschwanz-Rechner" keywords="Schwalbenschwanz Rechner, Zinkenverbindung Layout, Zinkenabstand, Schwalbenschwanzwinkel, Holzverbindung" breadcrumbs={[{ name: "Schwalbenschwanz-Rechner", url: "/de/schwalbenschwanz-rechner" }]} lang="de" enSlug="dovetail-joint-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schwalbenschwanz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Plane dein Schwalbenschwanz-Layout mit praezisen Zinken- und Schwalbenschwanzmassen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5"><label class="block text-sm font-medium text-text mb-2">Brettbreite (mm)</label><input type="number" id="ssde-width" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="25" step="1"></div>
      <div class="grid grid-cols-2 gap-4 mb-5">
        <div><label class="block text-sm font-medium text-text mb-2">Brettstaerke (mm)</label><input type="number" id="ssde-thick" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="19" min="6" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-2">Anzahl Schwaenze</label><input type="number" id="ssde-tails" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="20" step="1"></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-5">
        <div><label class="block text-sm font-medium text-text mb-2">Schwalbenschwanzwinkel</label>
          <select id="ssde-angle" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="8">1:8 (Hartholz)</option>
            <option value="7">1:7 (Universal)</option>
            <option value="6" selected>1:6 (Weichholz)</option>
            <option value="5">1:5 (sehr weich)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-2">Halbzinkenbreite (mm)</label><input type="number" id="ssde-halfpin" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="3" step="1"></div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Schwanzbreite (schmale Seite)</div>
        <div class="text-4xl font-extrabold" id="ssde-tw">--</div>
        <div class="text-sm text-blue-200 mt-1">mm</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zinkenbreite (schmal)</div><div class="text-xl font-bold" id="ssde-pw">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schwanzbreite (breit)</div><div class="text-xl font-bold" id="ssde-tww">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbindungstiefe</div><div class="text-xl font-bold" id="ssde-depth">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schwalbenschwanzwinkel</div><div class="text-xl font-bold" id="ssde-deg">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h4 class="font-semibold text-sm text-text mb-2">Layout-Zusammenfassung</h4>
        <div class="text-sm text-text-secondary space-y-1" id="ssde-summary"><p>--</p></div>
      </div>
      <ShareButton calculatorId="dovetail-joint" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Schwalbenschwanzverbindung planen</h2>
      <h3 class="text-xl font-semibold text-text mt-8">Den richtigen Winkel waehlen</h3>
      <ul>
        <li><strong>1:8 (~7,1 Grad):</strong> Am besten fuer Harthoelzer wie Eiche, Ahorn, Nussbaum</li>
        <li><strong>1:7 (~8,1 Grad):</strong> Guter Universalwinkel</li>
        <li><strong>1:6 (~9,5 Grad):</strong> Am besten fuer Weichhoelzer wie Kiefer, Zeder</li>
        <li><strong>1:5 (~11,3 Grad):</strong> Sehr weiche Hoelzer, maximale mechanische Verriegelung</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie breit sollten die Halbzinken sein?</strong> Mindestens 1/4 der Brettstaerke an den Kanten.</p>
      <p><strong>Wie wird die Tiefe markiert?</strong> Die Grundlinie wird exakt auf die Staerke des Gegenstuecks plus ca. 1 mm markiert.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSSDE() {
      const boardWidth = parseFloat((document.getElementById('ssde-width') as HTMLInputElement).value) || 150;
      const thickness = parseFloat((document.getElementById('ssde-thick') as HTMLInputElement).value) || 19;
      const numTails = parseInt((document.getElementById('ssde-tails') as HTMLInputElement).value) || 3;
      const angleRatio = parseInt((document.getElementById('ssde-angle') as HTMLInputElement).value) || 6;
      const halfPinWidth = parseFloat((document.getElementById('ssde-halfpin') as HTMLInputElement).value) || 10;

      const angleDeg = Math.atan(1 / angleRatio) * (180 / Math.PI);
      const jointDepth = thickness;
      const taperPerSide = thickness / angleRatio;
      const availableWidth = boardWidth - 2 * halfPinWidth;
      const pinNarrowRatio = 0.5;
      const segmentCount = numTails + (numTails - 1) * pinNarrowRatio;
      const tailNarrow = availableWidth / segmentCount;
      const pinNarrow = tailNarrow * pinNarrowRatio;
      const tailWide = tailNarrow + 2 * taperPerSide;

      const fmt = (n: number) => n.toFixed(1).replace('.', ',');

      document.getElementById('ssde-tw')!.textContent = fmt(tailNarrow) + ' mm';
      document.getElementById('ssde-pw')!.textContent = fmt(pinNarrow) + ' mm';
      document.getElementById('ssde-tww')!.textContent = fmt(tailWide) + ' mm';
      document.getElementById('ssde-depth')!.textContent = fmt(jointDepth) + ' mm';
      document.getElementById('ssde-deg')!.textContent = angleDeg.toFixed(1).replace('.', ',') + '\u00B0';

      const summary = 'Layout: ' + fmt(halfPinWidth) + ' mm Halbzinke, dann ' + numTails + ' Schwaenze bei ' + fmt(tailNarrow) + ' mm (schmal) mit ' + (numTails - 1) + ' Zinken bei ' + fmt(pinNarrow) + ' mm (schmal), endend mit ' + fmt(halfPinWidth) + ' mm Halbzinke. Gesamt: ' + boardWidth + ' mm.';
      document.getElementById('ssde-summary')!.innerHTML = '<p>' + summary + '</p>';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ssde-in').forEach(el => { el.addEventListener('input', calcSSDE); el.addEventListener('change', calcSSDE); });
      calcSSDE();
    }, 50);
  </script>
</CalculatorLayout>
