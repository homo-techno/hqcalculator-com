---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Haarporosit&auml;t-Rechner - Beurteilung &amp; Produktempfehlungen";
const description = "Bestimmen Sie Ihre Haarporosit&auml;t durch einen gezielten Test und erhalten Sie pers&ouml;nliche Produktempfehlungen f&uuml;r niedrige, mittlere oder hohe Porosit&auml;t.";
const relatedCalcs = [
  { name: "Haarwachstum-Rechner", url: "/de/haarwachstum-rechner", description: "L&auml;ngenprognose." },
  { name: "Haarfarbe-Mischen-Rechner", url: "/de/haarfarbe-mischen-rechner", description: "Haarfarbe mischen." },
  { name: "Haarentwickler-Rechner", url: "/de/haarentwickler-rechner", description: "Entwickler ausw&auml;hlen." },
  { name: "Haaraufhellung-Rechner", url: "/de/haaraufhellung-rechner", description: "Bleichen &amp; Einwirkzeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Haarporosit&auml;t-Rechner" lang="de" enSlug="hair-porosity-calculator" keywords="haarporosit&auml;t rechner, niedrige porosit&auml;t, hohe porosit&auml;t, haartest, haarpflege, produktempfehlung, kutikula" breadcrumbs={[{ name: "Haarporosit&auml;t-Rechner", url: "/de/haarporositaet-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Haarporosit&auml;t-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie Ihre Haarporosit&auml;t und erhalten Sie pers&ouml;nliche Produktempfehlungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Wasseraufnahme-Test</label>
          <select id="hpo-water" class="hpo-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Haar schwimmt lange an der Oberfl&auml;che</option>
            <option value="2" selected>Haar sinkt nach einigen Minuten langsam</option>
            <option value="3">Haar sinkt sofort</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Trockenzeit</label>
          <select id="hpo-dry" class="hpo-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Braucht sehr lange zum Lufttrocknen</option>
            <option value="2" selected>Trocknet in normaler Zeit</option>
            <option value="3">Trocknet sehr schnell</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Produktaufnahme</label>
          <select id="hpo-absorb" class="hpo-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Produkte liegen auf dem Haar, wirken fettig</option>
            <option value="2" selected>Produkte werden normal aufgenommen</option>
            <option value="3">Haar nimmt Produkte schnell auf, braucht h&auml;ufiges Nachauftragen</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Haargef&uuml;hl nach dem Waschen</label>
          <select id="hpo-texture" class="hpo-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Glatt, gl&auml;nzend, manchmal steif</option>
            <option value="2" selected>Weich und leicht k&auml;mmbar</option>
            <option value="3">Rau, kr&auml;uselig oder verfilzt</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Chemische / W&auml;rme-Geschichte</label>
          <select id="hpo-history" class="hpo-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Keine Farbe, kaum W&auml;rmebehandlung</option>
            <option value="2" selected>Etwas Farbe oder regelm&auml;&szlig;ige W&auml;rmebehandlung</option>
            <option value="3">Gebleicht, dauerwelle oder h&auml;ufige W&auml;rmeschaden</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kn&auml;useligkeitsgrad</label>
          <select id="hpo-frizz" class="hpo-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Selten kr&auml;uselig</option>
            <option value="2" selected>Manchmal kr&auml;uselig bei Feuchtigkeit</option>
            <option value="3">St&auml;ndig kr&auml;uselig</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ihre Haarporosit&auml;t</div>
          <div class="text-4xl font-extrabold font-mono" id="hpo-result">--</div>
          <div class="text-sm text-blue-200 mt-1" id="hpo-score">Punktzahl: --</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kutikulazustand</div><div class="text-xl font-bold" id="hpo-cuticle">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Feuchtigkeitsspeicherung</div><div class="text-xl font-bold" id="hpo-moisture">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Produktempfehlungen</h3>
          <div class="text-sm space-y-1" id="hpo-recs"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Pflegetipps</h3>
          <div class="text-sm space-y-1" id="hpo-tips"></div>
        </div>
      </div>
      <ShareButton calculatorId="hair-porosity-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haarporosit&auml;t verstehen</h2>
      <p>Haarporosit&auml;t beschreibt, wie gut Ihr Haar Feuchtigkeit aufnimmt und speichert. Niedrige Porosit&auml;t bedeutet fest geschlossene Kutikula, die Feuchtigkeit widersteht. Mittlere Porosit&auml;t nimmt Feuchtigkeit gut auf und beh&auml;lt sie. Hohe Porosit&auml;t hat ge&ouml;ffnete oder gesch&auml;digte Kutikula, die Feuchtigkeit schnell aufnimmt, aber auch schnell verliert. Das Wissen um die eigene Porosit&auml;t hilft bei der Wahl der richtigen Produkte und Pflegeroutinen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie teste ich meine Haarporosit&auml;t?</strong> Der einfachste Test: Ein sauberes Haar in ein Glas Wasser legen. Schwimmt es lange, deutet das auf niedrige Porosit&auml;t hin; sinkt es sofort, ist die Porosit&auml;t hoch.</p>
      <p><strong>Kann sich die Porosit&auml;t ver&auml;ndern?</strong> Ja, chemische Behandlungen, W&auml;rme und UV-Strahlung erh&ouml;hen die Porosit&auml;t. Regul&auml;re Pflegebehandlungen k&ouml;nnen helfen, sie zu senken.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHPO() {
      const water = parseInt((document.getElementById('hpo-water') as HTMLSelectElement).value);
      const dry = parseInt((document.getElementById('hpo-dry') as HTMLSelectElement).value);
      const absorb = parseInt((document.getElementById('hpo-absorb') as HTMLSelectElement).value);
      const texture = parseInt((document.getElementById('hpo-texture') as HTMLSelectElement).value);
      const history = parseInt((document.getElementById('hpo-history') as HTMLSelectElement).value);
      const frizz = parseInt((document.getElementById('hpo-frizz') as HTMLSelectElement).value);

      const total = water + dry + absorb + texture + history + frizz;
      const avg = total / 6;

      let porosity = 'Mittlere Porosit\u00E4t';
      let cuticle = 'Leicht ge\u00F6ffnet';
      let moisture = 'Gut';
      let recs: string[] = [];
      let tips: string[] = [];

      if (avg <= 1.5) {
        porosity = 'Niedrige Porosit\u00E4t';
        cuticle = 'Fest geschlossen';
        moisture = 'Feuchtigkeitsresistent';
        recs = [
          'Leichte, wasserbasierte Produkte verwenden',
          'Schwere Butter und \u00D6le vermeiden (lagern sich auf dem Haar)',
          'Humektanzien wie Glycerin und Honig bevorzugen',
          'Monatlich kl\u00E4rendes Shampoo gegen Ablagerungen',
          'Fl\u00FCssige Leave-in-Conditioner statt Cremes',
        ];
        tips = [
          'Produkte auf feuchtem, warmem Haar auftragen (W\u00E4rme \u00F6ffnet Kutikula)',
          'Dampf oder warmes Tuch beim Deep Conditioning nutzen',
          'Proteinreiche Produkte vermeiden (k\u00F6nnen Steifheit verursachen)',
          'LOC-Methode: Liquid, \u00D6l, Creme',
        ];
      } else if (avg <= 2.3) {
        porosity = 'Mittlere Porosit\u00E4t';
        cuticle = 'Leicht ge\u00F6ffnet';
        moisture = 'Gute Speicherung';
        recs = [
          'Die meisten Produkte funktionieren gut f\u00FCr Ihren Haartyp',
          'Gelegentliche Deep-Conditioning-Behandlungen',
          'Ausgewogenes Verh\u00E4ltnis von Protein- und Feuchtigkeitspflege',
          'Mittelgewichtige Leave-in-Conditioner',
          'Argan\u00F6l oder Jojobaöl zum Versiegeln',
        ];
        tips = [
          'Regelm\u00E4\u00DFige Pflege mit Konditionierbehandlungen',
          'Keine \u00DCberverarbeitung durch W\u00E4rme oder Chemikalien',
          'Proteinbehandlungen alle 4\u20136 Wochen',
          'Ihr Haar befindet sich in einem gesunden Porosit\u00E4tsbereich',
        ];
      } else {
        porosity = 'Hohe Porosit\u00E4t';
        cuticle = 'Ge\u00F6ffnet / gesch\u00E4digt';
        moisture = 'Verliert Feuchtigkeit schnell';
        recs = [
          'Schwere Butter und \u00D6le (Shea, Rizinus\u00F6l) verwenden',
          'Proteinbehandlungen alle 1\u20132 Wochen zur L\u00FCckenschlie\u00DFung',
          'Anti-Humektanzien bei feuchtem Wetter',
          'Leave-in-Conditioner und Haarmasken regelm\u00E4\u00DFig verwenden',
          'Mit schwererem \u00D6l wie Rizinus- oder Oliven\u00F6l versiegeln',
        ];
        tips = [
          'LCO-Methode: Liquid, Creme, \u00D6l (zuletzt versiegeln)',
          'Kaltes Wasser nach dem Sp\u00FClen zum Schlie\u00DFen der Kutikula',
          'Zu viel W\u00E4rmestyling vermeiden',
          'Apfelessig-Sp\u00FClung gl\u00E4ttet die Kutikula',
          'Auf Satinkissen oder mit Satinhaube schlafen',
        ];
      }

      document.getElementById('hpo-result')!.textContent = porosity;
      document.getElementById('hpo-score')!.textContent = 'Punktzahl: ' + avg.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' / 3,0';
      document.getElementById('hpo-cuticle')!.textContent = cuticle;
      document.getElementById('hpo-moisture')!.textContent = moisture;
      document.getElementById('hpo-recs')!.innerHTML = recs.map(r => '<p>- ' + r + '</p>').join('');
      document.getElementById('hpo-tips')!.innerHTML = tips.map(t => '<p>- ' + t + '</p>').join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hpo-in').forEach(el => { el.addEventListener('input', calcHPO); el.addEventListener('change', calcHPO); });
      calcHPO();
    }, 50);
  </script>
</CalculatorLayout>
