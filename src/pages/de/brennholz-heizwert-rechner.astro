---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Brennholz-Heizwert-Rechner - Heizwert nach Holzart vergleichen";
const description = "Vergleichen Sie den Heizwert (kWh) pro Raummeter nach Holzart. Berechnen Sie Kosten pro kWh und finden Sie das effizienteste Brennholz.";
const relatedCalcs = [
  { name: "Brennholz-Rechner", url: "/de/brennholz-rechner", description: "Brennholzbedarf berechnen." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten umrechnen." },
  { name: "Temperaturumrechner", url: "/de/temperaturumrechner", description: "Temperaturen umrechnen." },
  { name: "CO2-Rechner", url: "/de/co2-rechner", description: "CO2-Emissionen berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Brennholz-Heizwert-Rechner" lang="de" enSlug="firewood-btu-calculator" keywords="Brennholz Heizwert, kWh pro Raummeter, Holzart vergleich, Brennholzkosten, Heizwert Holz" breadcrumbs={[{ name: "Brennholz-Heizwert-Rechner", url: "/de/brennholz-heizwert-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Brennholz-Heizwert-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie den Heizwert nach Holzart und finden Sie das beste Preis-Leistungs-Verhältnis.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Holzart</label>
          <select id="fbh-species" class="fbh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="2100">Buche (2.100 kWh/rm)</option>
            <option value="2100" selected>Eiche (2.100 kWh/rm)</option>
            <option value="1900">Esche (1.900 kWh/rm)</option>
            <option value="1800">Birke (1.800 kWh/rm)</option>
            <option value="1700">Ahorn (1.700 kWh/rm)</option>
            <option value="1500">Kiefer (1.500 kWh/rm)</option>
            <option value="1600">Fichte (1.600 kWh/rm)</option>
            <option value="1400">Pappel (1.400 kWh/rm)</option>
            <option value="1350">Erle (1.350 kWh/rm)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Raummeter (rm)</label>
            <input type="number" id="fbh-rm" class="fbh-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="3" min="0.25" max="50" step="0.25">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Preis pro rm (&euro;)</label>
            <input type="number" id="fbh-price" class="fbh-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="95" min="0" step="5">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Vergleich mit Alternative</label>
          <select id="fbh-alt" class="fbh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="10|0.08">Erdgas (0,08 &euro;/kWh)</option>
            <option value="12.9|0.10">Fl&uuml;ssiggas (0,10 &euro;/kWh)</option>
            <option value="10|0.12">Heiz&ouml;l (0,12 &euro;/kWh)</option>
            <option value="1|0.35">Strom (0,35 &euro;/kWh)</option>
            <option value="4.8|0.06">Holzpellets (0,06 &euro;/kWh)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Heizwert</div>
          <div class="text-5xl font-extrabold font-mono" id="fbh-total">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">kWh pro rm</div>
            <div class="text-xl font-bold font-mono" id="fbh-kwh">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kosten/kWh</div>
            <div class="text-xl font-bold font-mono" id="fbh-costkwh">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtkosten</div>
            <div class="text-xl font-bold font-mono" id="fbh-cost">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Alt. &euro;/kWh</div>
            <div class="text-xl font-bold font-mono" id="fbh-altcost">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ersparnis</div>
            <div class="text-xl font-bold font-mono" id="fbh-savings">--</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="firewood-btu" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Was ist ein Raummeter (rm)?</strong> Ein Raummeter entspricht einem Kubikmeter geschichteter Holzscheite inklusive Zwischenr&auml;umen.</p>
      <p><strong>Welches Holz hat den h&ouml;chsten Heizwert?</strong> Buche und Eiche haben mit ca. 2.100 kWh/rm den h&ouml;chsten Heizwert unter den g&auml;ngigen Brennh&ouml;lzern.</p>
      <p><strong>Wie berechnet man die Kosten pro kWh?</strong> Teilen Sie den Preis pro Raummeter durch den Heizwert in kWh pro Raummeter.</p>
      <h2 class="text-2xl font-bold text-text mt-8">Heizwert-Berechnung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Gesamter Heizwert = kWh/rm &times; Raummeter</p>
        <p>Kosten pro kWh = Preis/rm &divide; kWh/rm</p>
        <p>Ersparnis = (Alt. &euro;/kWh - Holz &euro;/kWh) &times; Gesamt-kWh</p>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFBH() {
      const kwhPerRm = parseFloat((document.getElementById('fbh-species') as HTMLSelectElement).value);
      const rm = parseFloat((document.getElementById('fbh-rm') as HTMLInputElement).value) || 3;
      const price = parseFloat((document.getElementById('fbh-price') as HTMLInputElement).value) || 0;
      const altVal = (document.getElementById('fbh-alt') as HTMLSelectElement).value.split('|');
      const altPriceKwh = parseFloat(altVal[1]);
      const totalKwh = kwhPerRm * rm;
      const totalCost = price * rm;
      const costPerKwh = kwhPerRm > 0 ? price / kwhPerRm : 0;
      const altTotalCost = totalKwh * altPriceKwh;
      const savings = altTotalCost - totalCost;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('fbh-total')!.textContent = totalKwh.toLocaleString('de-DE') + ' kWh';
      document.getElementById('fbh-kwh')!.textContent = kwhPerRm.toLocaleString('de-DE');
      document.getElementById('fbh-costkwh')!.textContent = fmt(costPerKwh) + ' \u20AC';
      document.getElementById('fbh-cost')!.textContent = fmt(totalCost) + ' \u20AC';
      document.getElementById('fbh-altcost')!.textContent = fmt(altPriceKwh) + ' \u20AC';
      document.getElementById('fbh-savings')!.textContent = (savings >= 0 ? '+' : '') + fmt(savings) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fbh-in').forEach(el => { el.addEventListener('input', calcFBH); el.addEventListener('change', calcFBH); });
      calcFBH();
    }, 50);
  </script>
</CalculatorLayout>
