---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ziegenfutter-Rechner - Täglicher Futterbedarf nach Gewicht & Produktionsstadium";
const description = "Berechnen Sie den täglichen Futterbedarf für Ziegen basierend auf Gewicht und Produktionsstadium (Erhaltung, Trächtigkeit, Laktation). Inklusive Mineralstoffempfehlungen.";
const relatedCalcs = [
  { name: "Glutenfreies Mehl-Rechner", url: "/de/glutenfreies-mehl-rechner", description: "GF-Mehlmischungen." },
  { name: "Glykaemischer-Index-Rechner", url: "/de/glykaemischer-index-rechner", description: "Glykämischer Index." },
  { name: "Goldwaschen-Rechner", url: "/de/goldwaschen-rechner", description: "Goldwaschen." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "Grünes-Bauen-Rechner", url: "/de/gruenes-bauen-rechner", description: "Nachhaltiges Bauen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Ziegenfutter-Rechner" enSlug="goat-feed-calculator" keywords="Ziegenfutter, Ziegenernährung, Milchziegen Futter, Ziegenheu, Ziegenmineralien, Ziegendiät" breadcrumbs={[{ name: "Ziegenfutter-Rechner", url: "/de/ziegenfutter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ziegenfutter-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den täglichen Futterbedarf, Heu-Mengen, Kraftfutterrationen und Mineralstoffzusätze für Ihre Ziegen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Ziegen</label><input type="number" id="zfr-count" class="zfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="200" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Durchschnittsgewicht (kg)</label><input type="number" id="zfr-weight" class="zfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="55" min="10" max="150" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Produktionsstadium</label>
            <select id="zfr-stage" class="zfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="maintenance" selected>Erhaltung</option>
              <option value="growing">Wachsendes Kitz</option>
              <option value="early_preg">Frühe Trächtigkeit</option>
              <option value="late_preg">Späte Trächtigkeit</option>
              <option value="lactating">Laktierend</option>
              <option value="buck">Bock (Deckzeit)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Heukosten (€/Ballen ~20 kg)</label><input type="number" id="zfr-haycost" class="zfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Tägliches Futter pro Ziege</div>
          <div class="text-5xl font-extrabold font-mono" id="zfr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Heu / Ziege / Tag</div><div class="text-xl font-bold font-mono" id="zfr-hay">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraftfutter / Ziege / Tag</div><div class="text-xl font-bold font-mono" id="zfr-grain">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt Herde / Tag</div><div class="text-xl font-bold font-mono" id="zfr-total">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minerale (g/Tag)</div><div class="text-xl font-bold font-mono" id="zfr-mineral">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ballen / Monat</div><div class="text-xl font-bold font-mono" id="zfr-bales">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatskosten</div><div class="text-xl font-bold font-mono" id="zfr-cost">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="ziegenfutter" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Ziegenfütterung</h2>
      <p>Ziegen fressen täglich 3-5% ihres Körpergewichts an Trockenmasse. Heu ist das Grundfutter, Kraftfutter wird je nach Produktionsstadium ergänzt. Laktierende Ziegen haben den höchsten Futterbedarf.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Heu braucht eine Ziege?</strong> Eine 55 kg schwere Ziege im Erhaltungsbedarf benötigt etwa 1,5-2 kg Heu pro Tag.</p>
      <p><strong>Brauchen alle Ziegen Kraftfutter?</strong> Nein, Ziegen im Erhaltungsbedarf kommen oft nur mit Heu und Mineralfutter aus. Laktierende Ziegen und Kitze benötigen zusätzlich Kraftfutter.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcZFR() {
      const count = parseInt((document.getElementById('zfr-count') as HTMLInputElement).value) || 1;
      const weightKg = parseFloat((document.getElementById('zfr-weight') as HTMLInputElement).value) || 55;
      const stage = (document.getElementById('zfr-stage') as HTMLSelectElement).value;
      const hayCost = parseFloat((document.getElementById('zfr-haycost') as HTMLInputElement).value) || 0;

      const hayPct: Record<string, number> = {
        maintenance: 0.035, growing: 0.04, early_preg: 0.035,
        late_preg: 0.04, lactating: 0.045, buck: 0.04
      };
      const grainPct: Record<string, number> = {
        maintenance: 0, growing: 0.01, early_preg: 0.005,
        late_preg: 0.01, lactating: 0.015, buck: 0.01
      };

      const hayPerGoat = weightKg * (hayPct[stage] || 0.035);
      const grainPerGoat = weightKg * (grainPct[stage] || 0);
      const totalPerGoat = hayPerGoat + grainPerGoat;
      const totalHerd = totalPerGoat * count;

      const mineralG = stage === 'lactating' ? 20 : 15;
      const totalMineral = mineralG * count;

      const hayBalesMonth = Math.ceil((hayPerGoat * count * 30) / 20);
      const monthlyCost = hayBalesMonth * hayCost;

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

      document.getElementById('zfr-result')!.textContent = fmt(totalPerGoat) + ' kg';
      document.getElementById('zfr-hay')!.textContent = fmt(hayPerGoat) + ' kg';
      document.getElementById('zfr-grain')!.textContent = fmt(grainPerGoat) + ' kg';
      document.getElementById('zfr-total')!.textContent = fmt(totalHerd) + ' kg';
      document.getElementById('zfr-mineral')!.textContent = totalMineral.toString();
      document.getElementById('zfr-bales')!.textContent = hayBalesMonth.toString();
      document.getElementById('zfr-cost')!.textContent = monthlyCost.toLocaleString('de-DE') + ' \u20ac';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zfr-in').forEach(el => { el.addEventListener('input', calcZFR); el.addEventListener('change', calcZFR); });
      calcZFR();
    }, 50);
  </script>
</CalculatorLayout>
