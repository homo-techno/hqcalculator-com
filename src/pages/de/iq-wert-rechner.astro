---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "IQ-Wert Rechner – IQ-Werte & Perzentile verstehen";
const description = "Verstehen Sie IQ-Werte und Perzentile im Bevölkerungsvergleich.";
const relatedCalcs = [
  { name: "BMI Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index berechnen." },
  { name: "Keto Rechner", url: "/de/keto-rechner", description: "Makronährstoffe für Keto." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglichen Kalorienbedarf." },
  { name: "Kelly-Kriterium Rechner", url: "/de/kelly-kriterium-rechner", description: "Optimale Einsatzgröße." },
];
---
<CalculatorLayout lang="de" enSlug="iq-score-calculator" title={title} description={description} calculatorName="IQ-Wert Rechner" keywords="IQ Rechner, Intelligenzquotient, IQ Perzentil, IQ Test, IQ Skala, Normalverteilung" breadcrumbs={[{ name: "IQ-Wert Rechner", url: "/de/iq-wert-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">IQ-Wert Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Bevölkerungsperzentil zu einem IQ-Wert und verstehen Sie, was der Intelligenzquotient aussagt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">IQ-Wert eingeben</label><input type="number" id="iq-score" class="iq-in w-full px-4 py-3 border border-border rounded-xl text-4xl font-bold text-center" value="100" min="40" max="200" step="1"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Mittelwert (Ø)</label><input type="number" id="iq-mean" class="iq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Standardabweichung</label><input type="number" id="iq-sd" class="iq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Perzentil (besser als ... der Bevölkerung)</div>
          <div class="text-5xl font-extrabold font-mono" id="iq-percentile">—</div>
          <div class="text-sm text-blue-200 mt-1" id="iq-category">—</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Z-Wert</div><div class="text-xl font-bold" id="iq-z">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anteil Population</div><div class="text-xl font-bold" id="iq-pop">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Klassifikation</div><div class="text-xl font-bold" id="iq-class">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">IQ-Skala Referenz</h3>
          <div class="text-xs space-y-1" id="iq-scale"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="iq-score" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Was bedeutet der IQ-Wert?</h2>
      <p class="text-text-secondary">Der Intelligenzquotient (IQ) ist ein standardisiertes Maß für kognitive Fähigkeiten, das auf einer Normalverteilung mit Mittelwert 100 und Standardabweichung 15 basiert. Etwa 68 % der Bevölkerung haben einen IQ zwischen 85 und 115, 95 % zwischen 70 und 130. Der IQ misst logisches Denken, räumliches Vorstellungsvermögen und verbale Fähigkeiten – nicht Kreativität oder emotionale Intelligenz.</p>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist ein durchschnittlicher IQ-Wert?</h4>
          <p class="text-text-secondary mt-1">Der IQ-Durchschnitt liegt per Definition bei 100. Werte zwischen 90 und 110 gelten als durchschnittlich (normaler Bereich). Etwa 50 % der Bevölkerung liegen in diesem Bereich. Werte über 130 werden als hochbegabt eingestuft (etwa 2 % der Bevölkerung).</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Flynn-Effekt?</h4>
          <p class="text-text-secondary mt-1">Der Flynn-Effekt beschreibt den historisch beobachteten Anstieg der IQ-Werte um etwa 3 Punkte pro Jahrzehnt. Als Ursachen gelten bessere Ernährung, Bildung und veränderte Denkgewohnheiten. IQ-Tests werden daher regelmäßig neu normiert.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Kann man seinen IQ verbessern?</h4>
          <p class="text-text-secondary mt-1">Der IQ ist genetisch mitbedingt, aber auch von Umweltfaktoren abhängig. Guter Schlaf, körperliche Bewegung, geistige Herausforderungen und gesunde Ernährung können die kognitive Leistungsfähigkeit verbessern. Spezifisches Gehirntraining verbessert primär die trainierten Aufgaben, kaum den allgemeinen IQ.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welche IQ-Tests sind in Deutschland anerkannt?</h4>
          <p class="text-text-secondary mt-1">Anerkannte Tests umfassen den WAIS-IV (Wechsler Intelligenztest für Erwachsene), den CFT 20-R sowie den BIS-HB. Online-IQ-Tests sind nicht standardisiert und wissenschaftlich nicht valide. Offizielle Tests werden von Psychologen durchgeführt und ausgewertet.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function normalCDF(z: number): number {
      const a1=0.254829592,a2=-0.284496736,a3=1.421413741,a4=-1.453152027,a5=1.061405429,p=0.3275911;
      const sign = z < 0 ? -1 : 1;
      z = Math.abs(z) / Math.sqrt(2);
      const t = 1 / (1 + p * z);
      const y = 1 - (((((a5*t+a4)*t+a3)*t+a2)*t+a1)*t)*Math.exp(-z*z);
      return 0.5 * (1 + sign * y);
    }
    function calcIQ() {
      const score = parseFloat((document.getElementById('iq-score') as HTMLInputElement).value) || 100;
      const mean = parseFloat((document.getElementById('iq-mean') as HTMLInputElement).value) || 100;
      const sd = parseFloat((document.getElementById('iq-sd') as HTMLInputElement).value) || 15;
      const z = (score - mean) / sd;
      const pct = normalCDF(z) * 100;
      let category = '';
      let cls = '';
      if (score >= 145) { category = 'Ausnahmetalent'; cls = 'Außergewöhnlich hoch'; }
      else if (score >= 130) { category = 'Hochbegabt'; cls = 'Sehr hoch'; }
      else if (score >= 120) { category = 'Überdurchschnittlich'; cls = 'Hoch'; }
      else if (score >= 110) { category = 'Leicht überdurchschnittlich'; cls = 'Überdurchschnittlich'; }
      else if (score >= 90) { category = 'Durchschnittlich'; cls = 'Normal'; }
      else if (score >= 80) { category = 'Leicht unterdurchschnittlich'; cls = 'Unterdurchschnittlich'; }
      else if (score >= 70) { category = 'Unterdurchschnittlich'; cls = 'Niedrig'; }
      else { category = 'Weit unterdurchschnittlich'; cls = 'Sehr niedrig'; }
      const pctInRange = (normalCDF((score + 15 - mean)/sd) - normalCDF((score - 15 - mean)/sd)) * 100;
      document.getElementById('iq-percentile')!.textContent = pct.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
      document.getElementById('iq-category')!.textContent = category;
      document.getElementById('iq-z')!.textContent = z.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('iq-pop')!.textContent = 'Top ' + (100 - pct).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
      document.getElementById('iq-class')!.textContent = cls;
      const ranges = [
        { range: '≥ 145', label: 'Ausnahmetalent', pct: 0.1 },
        { range: '130–144', label: 'Hochbegabt', pct: 2.1 },
        { range: '120–129', label: 'Überdurchschnittlich', pct: 6.7 },
        { range: '110–119', label: 'Leicht über Ø', pct: 16.1 },
        { range: '90–109', label: 'Durchschnittlich', pct: 50.0 },
        { range: '80–89', label: 'Unterdurchschnittlich', pct: 16.1 },
        { range: '70–79', label: 'Weit unter Ø', pct: 6.7 },
        { range: '< 70', label: 'Sehr niedrig', pct: 2.2 },
      ];
      document.getElementById('iq-scale')!.innerHTML = ranges.map(r => {
        const inRange = (r.range.includes('≥') && score >= 145) ||
          (r.range.includes('<') && score < 70) ||
          (r.range.includes('–') && score >= parseInt(r.range.split('–')[0]) && score <= parseInt(r.range.split('–')[1]));
        return '<div class="flex justify-between' + (inRange ? ' text-blue-700 font-bold' : '') + '"><span>' + r.range + ': ' + r.label + '</span><span>ca. ' + r.pct + ' % der Bevölkerung' + (inRange ? ' ← Sie' : '') + '</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.iq-in').forEach(el => { el.addEventListener('input', calcIQ); el.addEventListener('change', calcIQ); });
      calcIQ();
    }, 50);
  </script>
</CalculatorLayout>
