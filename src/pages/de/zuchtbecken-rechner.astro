---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zuchtbecken-Rechner - Aufzucht & Laichbecken planen";
const description = "Berechnen Sie die Anforderungen f&uuml;r Zuchtbecken inkl. Jungfischplatz, Trennwandplatzierung, Wasserparameter und Aufzuchtkapazit&auml;t.";
const relatedCalcs = [
  { name: "Zucht-Rechner", url: "/de/zucht-rechner", description: "Tragzeit berechnen." },
  { name: "Auftrieb-Rechner", url: "/de/auftrieb-rechner", description: "Auftriebskraft." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Zuchtbecken-Rechner" lang="de" enSlug="breeding-tank-calculator" keywords="zuchtbecken rechner, fischzucht, jungfischbecken, laichbecken, aquarium zucht" breadcrumbs={[{ name: "Zuchtbecken-Rechner", url: "/de/zuchtbecken-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zuchtbecken-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihr Zuchtbecken inkl. Laichraum, Jungfischkapazit&auml;t, Trennwandplatzierung und Wasserparameter.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Beckenl&auml;nge (cm)</label><input type="number" id="btk-len" class="btk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="15" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="btk-wid" class="btk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="15" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">H&ouml;he (cm)</label><input type="number" id="btk-hgt" class="btk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="15" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fischart</label>
            <select id="btk-fish" class="btk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="livebearer" selected>Lebendgeb&auml;rende (Guppy, Molly)</option>
              <option value="egglayer">Eierleger (Salmler, Barben)</option>
              <option value="cichlid">Buntbarsche (Maulbr&uuml;ter)</option>
              <option value="betta">Kampffisch / Schaumnestbauer</option>
              <option value="catfish">Welse / Panzerwelse</option>
              <option value="shrimp">Garnelen</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Trennw&auml;nde</label><input type="number" id="btk-div" class="btk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="5" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Erwachsenengr&ouml;&szlig;e (cm)</label><input type="number" id="btk-size" class="btk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="30" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Max. Jungfischkapazit&auml;t</div>
          <div class="text-5xl font-extrabold font-mono" id="btk-result">0 Jungfische</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beckenvolumen</div><div class="text-xl font-bold font-mono" id="btk-vol">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sektionsgr&ouml;&szlig;e</div><div class="text-xl font-bold font-mono" id="btk-section">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Idealtemp.</div><div class="text-xl font-bold font-mono" id="btk-temp">26&deg;C</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasserwechsel</div><div class="text-xl font-bold font-mono" id="btk-wc">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="breeding-tank" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie gro&szlig; sollte ein Zuchtbecken sein?</strong> Mindestens 40 Liter f&uuml;r kleine Fische. Gr&ouml;&szlig;ere Arten ben&ouml;tigen entsprechend mehr Platz.</p>
      <p><strong>Warum sind regelm&auml;&szlig;ige Wasserwechsel bei Jungfischen wichtig?</strong> Jungfische produzieren viel Abfall und reagieren empfindlich auf schlechte Wasserqualit&auml;t.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBTK() {
      const len = parseFloat((document.getElementById('btk-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('btk-wid') as HTMLInputElement).value) || 0;
      const hgt = parseFloat((document.getElementById('btk-hgt') as HTMLInputElement).value) || 0;
      const fish = (document.getElementById('btk-fish') as HTMLSelectElement).value;
      const divs = parseFloat((document.getElementById('btk-div') as HTMLInputElement).value) || 0;
      const size = parseFloat((document.getElementById('btk-size') as HTMLInputElement).value) || 1;
      const liters = (len * wid * hgt) / 1000;
      const sections = divs + 1;
      const sectionLiters = liters / sections;
      const fryPerLiter: Record<string, number> = {
        livebearer: 1, egglayer: 1.3, cichlid: 0.5, betta: 0.8, catfish: 0.8, shrimp: 2.5
      };
      const maxFry = Math.floor(sectionLiters * (fryPerLiter[fish] || 0.8));
      const temps: Record<string, string> = {
        livebearer: '26-27', egglayer: '24-27', cichlid: '26-28', betta: '27-28', catfish: '23-26', shrimp: '22-24'
      };
      const wcFreq: Record<string, string> = {
        livebearer: '25% 3x/Woche', egglayer: '20% 2x/Woche', cichlid: '30% 2x/Woche',
        betta: '25% 2x/Woche', catfish: '20% 2x/Woche', shrimp: '10% w\u00f6chentlich'
      };
      document.getElementById('btk-result')!.textContent = maxFry + ' Jungfische';
      document.getElementById('btk-vol')!.textContent = liters.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('btk-section')!.textContent = sectionLiters.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('btk-temp')!.textContent = (temps[fish] || '26') + '\u00B0C';
      document.getElementById('btk-wc')!.textContent = wcFreq[fish] || '25% 2x/Woche';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('btk-len') as HTMLInputElement).value = '60';
      (document.getElementById('btk-wid') as HTMLInputElement).value = '30';
      (document.getElementById('btk-hgt') as HTMLInputElement).value = '30';
      (document.getElementById('btk-div') as HTMLInputElement).value = '1';
      (document.getElementById('btk-size') as HTMLInputElement).value = '5';
      document.querySelectorAll('.btk-in').forEach(el => { el.addEventListener('input', calcBTK); el.addEventListener('change', calcBTK); });
      calcBTK();
    }, 50);
  </script>
</CalculatorLayout>
