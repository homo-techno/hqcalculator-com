---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Stoffschrumpfung-Rechner - Einlauf & Zuschnittgröße";
const description = "Berechnen Sie den Vorwasch-Zuschnitt unter Berücksichtigung des Schrumpfungsprozentsatzes, der Anpassung und des Stofftyps.";
const relatedCalcs = [
  { name: "Stoff-Rechner", url: "/de/stoff-rechner", description: "Stoffbedarf berechnen." },
  { name: "Stoffbreite-Rechner", url: "/de/stoffbreite-rechner", description: "Schnittmuster-Layout." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Stoffschrumpfung-Rechner" lang="de" enSlug="fabric-shrinkage-calculator" keywords="stoffschrumpfung rechner, einlauf berechnen, vorwaschen, schrumpfung prozent, zuschnitt anpassung" breadcrumbs={[{ name: "Stoffschrumpfung", url: "/de/stoffschrumpfung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stoffschrumpfung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Vorwasch-Zuschnittmaße unter Berücksichtigung der Stoffschrumpfung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Stofftyp</label>
          <select id="ssde-fabric" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="cotton" selected>Baumwolle (3-5%)</option>
            <option value="linen">Leinen (3-10%)</option>
            <option value="wool">Wolle (5-10%)</option>
            <option value="silk">Seide (2-5%)</option>
            <option value="rayon">Viskose (3-8%)</option>
            <option value="denim">Denim (3-10%)</option>
            <option value="knit">Baumwollstrick (5-8%)</option>
            <option value="polyester">Polyester (0-1%)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Berechnungsmodus</label>
          <select id="ssde-mode" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="prewash" selected>Vorwaschgr&ouml;&szlig;e finden (Endma&szlig; bekannt)</option>
            <option value="postwash">Nachwaschgr&ouml;&szlig;e finden (Vorwaschma&szlig; bekannt)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="ssde-w" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="110" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Länge (cm)</label><input type="number" id="ssde-l" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="1" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schrumpfung Breite %</label><input type="number" id="ssde-sw" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="30" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Schrumpfung Länge %</label><input type="number" id="ssde-sl" class="ssde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="30" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="ssde-label">Zuschnittma&szlig; (vor Wäsche)</div>
          <div class="text-4xl font-extrabold font-mono" id="ssde-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Breiten&auml;nderung</div><div class="text-xl font-bold font-mono" id="ssde-wchange">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">L&auml;ngen&auml;nderung</div><div class="text-xl font-bold font-mono" id="ssde-lchange">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fl&auml;chen&auml;nderung</div><div class="text-xl font-bold font-mono" id="ssde-achange">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Originalfl&auml;che</div><div class="text-xl font-bold font-mono" id="ssde-oarea">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Endfl&auml;che</div><div class="text-xl font-bold font-mono" id="ssde-farea">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fabric-shrinkage-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Stoffschrumpfung verstehen</h2>
      <p>Naturfasern wie Baumwolle, Leinen und Wolle schrumpfen beim ersten Waschen. Der Einlauf variiert je nach Fasertyp, Webart und Behandlung.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Sollte ich den Stoff vorwaschen?</strong> Ja, besonders bei Naturfasern. So vermeiden Sie, dass das fertige Kleidungsstück beim Waschen schrumpft.</p>
      <p><strong>Schrumpft Polyester?</strong> Kaum - typischerweise nur 0-1%. Mischgewebe mit Naturfasern können jedoch mehr einlaufen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcSSDE() {
      const fabric = (document.getElementById('ssde-fabric') as HTMLSelectElement).value;
      const mode = (document.getElementById('ssde-mode') as HTMLSelectElement).value;
      const w = parseFloat((document.getElementById('ssde-w') as HTMLInputElement).value) || 110;
      const l = parseFloat((document.getElementById('ssde-l') as HTMLInputElement).value) || 150;
      let sw = parseFloat((document.getElementById('ssde-sw') as HTMLInputElement).value) || 0;
      let sl = parseFloat((document.getElementById('ssde-sl') as HTMLInputElement).value) || 0;
      const shrinkMap: Record<string, number[]> = {
        cotton: [3, 5], linen: [3, 7], wool: [5, 8], silk: [2, 3],
        rayon: [3, 6], denim: [3, 8], knit: [5, 7], polyester: [0.5, 0.5]
      };
      if (fabric !== 'custom') {
        const s = shrinkMap[fabric] || [3, 5];
        sw = s[0]; sl = s[1];
        (document.getElementById('ssde-sw') as HTMLInputElement).value = sw.toString();
        (document.getElementById('ssde-sl') as HTMLInputElement).value = sl.toString();
      }
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      let preW: number, preL: number, postW: number, postL: number;
      if (mode === 'prewash') {
        postW = w; postL = l;
        preW = w / (1 - sw / 100);
        preL = l / (1 - sl / 100);
        document.getElementById('ssde-label')!.textContent = 'Zuschnittma\u00DF (vor W\u00E4sche)';
        document.getElementById('ssde-result')!.textContent = fmt(preW) + ' x ' + fmt(preL) + ' cm';
      } else {
        preW = w; preL = l;
        postW = w * (1 - sw / 100);
        postL = l * (1 - sl / 100);
        document.getElementById('ssde-label')!.textContent = 'Endma\u00DF (nach W\u00E4sche)';
        document.getElementById('ssde-result')!.textContent = fmt(postW) + ' x ' + fmt(postL) + ' cm';
      }
      const wChange = Math.abs((preW || w / (1 - sw / 100)) - (postW || w * (1 - sw / 100)));
      const lChange = Math.abs((preL || l / (1 - sl / 100)) - (postL || l * (1 - sl / 100)));
      const origArea = (mode === 'prewash') ? (preW * preL) : (preW * preL);
      const finalArea = (mode === 'prewash') ? (w * l) : (postW * postL);
      const areaPctLoss = ((origArea - finalArea) / origArea * 100);
      document.getElementById('ssde-wchange')!.textContent = fmt(wChange) + ' cm';
      document.getElementById('ssde-lchange')!.textContent = fmt(lChange) + ' cm';
      document.getElementById('ssde-achange')!.textContent = fmt(areaPctLoss) + '%';
      document.getElementById('ssde-oarea')!.textContent = Math.round(origArea).toLocaleString('de-DE') + ' cm\u00B2';
      document.getElementById('ssde-farea')!.textContent = Math.round(finalArea).toLocaleString('de-DE') + ' cm\u00B2';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ssde-in').forEach(el => { el.addEventListener('input', calcSSDE); el.addEventListener('change', calcSSDE); });
      calcSSDE();
    }, 50);
  </script>
</CalculatorLayout>
