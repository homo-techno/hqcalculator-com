---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Emotionale Intelligenz Rechner - EQ-Selbsteinsch\u00e4tzung";
const description = "Bewerten Sie Ihre emotionale Intelligenz in f\u00fcnf Bereichen: Selbstwahrnehmung, Selbstregulierung, Motivation, Empathie und soziale Kompetenz.";
const relatedCalcs = [
  { name: "Elo-Bewertung", url: "/de/elo-bewertung-rechner", description: "Rating-System." },
  { name: "Ergonomischer Schreibtisch", url: "/de/ergonomischer-schreibtisch-rechner", description: "Schreibtischh\u00f6he." },
  { name: "Mitarbeiterfluktuation", url: "/de/mitarbeiterfluktuation-rechner", description: "Fluktuation." },
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallreserve." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Emotionale Intelligenz Rechner" lang="de" enSlug="emotional-intelligence-calculator" keywords="emotionale intelligenz, EQ, selbstwahrnehmung, empathie, soziale kompetenz, selbstregulierung, motivation" breadcrumbs={[{ name: "Emotionale Intelligenz", url: "/de/emotionale-intelligenz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Emotionale Intelligenz Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie sich bei jeder Aussage (1 = Stimme gar nicht zu, 5 = Stimme voll zu), um Ihr EQ-Profil zu ermitteln.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Selbstwahrnehmung</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich kann meine Emotionen genau identifizieren, w&auml;hrend ich sie erlebe.</label>
          <input type="range" id="eiq-sa1" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich verstehe, wie meine Gef&uuml;hle mein Verhalten und meine Entscheidungen beeinflussen.</label>
          <input type="range" id="eiq-sa2" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>

        <h3 class="font-semibold text-text mt-2">Selbstregulierung</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich kann unter Druck ruhig und gelassen bleiben.</label>
          <input type="range" id="eiq-sr1" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich denke erst nach, bevor ich emotional handle.</label>
          <input type="range" id="eiq-sr2" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>

        <h3 class="font-semibold text-text mt-2">Motivation</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich verfolge meine Ziele trotz R&uuml;ckschl&auml;gen und Hindernissen.</label>
          <input type="range" id="eiq-mo1" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich werde von inneren Standards angetrieben statt von &auml;u&szlig;eren Belohnungen.</label>
          <input type="range" id="eiq-mo2" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>

        <h3 class="font-semibold text-text mt-2">Empathie</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich kann sp&uuml;ren, wie andere sich f&uuml;hlen, auch wenn sie es nicht sagen.</label>
          <input type="range" id="eiq-em1" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich ber&uuml;cksichtige die Gef&uuml;hle anderer bei meinen Entscheidungen.</label>
          <input type="range" id="eiq-em2" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>

        <h3 class="font-semibold text-text mt-2">Soziale Kompetenz</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich gehe konstruktiv mit Konflikten und Meinungsverschiedenheiten um.</label>
          <input type="range" id="eiq-ss1" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich baue leicht Beziehungen auf und pflege starke Verbindungen.</label>
          <input type="range" id="eiq-ss2" class="eiq-in w-full" min="1" max="5" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Ablehnung (1)</span><span>Zustimmung (5)</span></div>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Gesamt EQ-Wert</div>
          <div class="text-2xl font-extrabold mt-1" id="eiq-total">--</div>
        </div>

        <div class="grid grid-cols-5 gap-2">
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Wahrnehm.</div>
            <div class="text-lg font-bold text-text mt-1" id="eiq-d1">--</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Regulier.</div>
            <div class="text-lg font-bold text-text mt-1" id="eiq-d2">--</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Motivat.</div>
            <div class="text-lg font-bold text-text mt-1" id="eiq-d3">--</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Empathie</div>
            <div class="text-lg font-bold text-text mt-1" id="eiq-d4">--</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Sozial</div>
            <div class="text-lg font-bold text-text mt-1" id="eiq-d5">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-secondary">Gesch&auml;tztes Perzentil</div>
          <div class="text-xl font-bold text-text mt-1" id="eiq-pct">--</div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Profilzusammenfassung</div>
          <div class="text-sm text-text" id="eiq-summary">--</div>
        </div>
      </div>

      <ShareButton calculatorId="emotional-intelligence-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist Emotionale Intelligenz?</h2>
      <p>Emotionale Intelligenz (EQ) beschreibt die F&auml;higkeit, eigene und fremde Emotionen wahrzunehmen, zu verstehen und konstruktiv damit umzugehen. Nach Daniel Goleman umfasst EQ f&uuml;nf Kernbereiche.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Kann man EQ verbessern?</strong> Ja, im Gegensatz zum IQ l&auml;sst sich emotionale Intelligenz durch Training und bewusste Praxis deutlich steigern.</p>
      <p><strong>Warum ist EQ wichtig?</strong> Hohe emotionale Intelligenz korreliert mit besserer F&uuml;hrung, st&auml;rkeren Beziehungen und h&ouml;herer Lebenszufriedenheit.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEIQ() {
      const sa = (parseInt((document.getElementById('eiq-sa1') as HTMLInputElement).value) || 3) + (parseInt((document.getElementById('eiq-sa2') as HTMLInputElement).value) || 3);
      const sr = (parseInt((document.getElementById('eiq-sr1') as HTMLInputElement).value) || 3) + (parseInt((document.getElementById('eiq-sr2') as HTMLInputElement).value) || 3);
      const mo = (parseInt((document.getElementById('eiq-mo1') as HTMLInputElement).value) || 3) + (parseInt((document.getElementById('eiq-mo2') as HTMLInputElement).value) || 3);
      const em = (parseInt((document.getElementById('eiq-em1') as HTMLInputElement).value) || 3) + (parseInt((document.getElementById('eiq-em2') as HTMLInputElement).value) || 3);
      const ss = (parseInt((document.getElementById('eiq-ss1') as HTMLInputElement).value) || 3) + (parseInt((document.getElementById('eiq-ss2') as HTMLInputElement).value) || 3);

      const total = sa + sr + mo + em + ss;
      const maxScore = 50;
      const pct = Math.min(99, Math.max(1, Math.round((total / maxScore) * 100)));

      document.getElementById('eiq-total')!.textContent = total + ' / ' + maxScore;
      document.getElementById('eiq-d1')!.textContent = sa + '/10';
      document.getElementById('eiq-d2')!.textContent = sr + '/10';
      document.getElementById('eiq-d3')!.textContent = mo + '/10';
      document.getElementById('eiq-d4')!.textContent = em + '/10';
      document.getElementById('eiq-d5')!.textContent = ss + '/10';
      document.getElementById('eiq-pct')!.textContent = pct + '. Perzentil (ca.)';

      const domains = [
        { name: 'Selbstwahrnehmung', score: sa },
        { name: 'Selbstregulierung', score: sr },
        { name: 'Motivation', score: mo },
        { name: 'Empathie', score: em },
        { name: 'Soziale Kompetenz', score: ss },
      ];
      domains.sort((a, b) => b.score - a.score);
      const strongest = domains[0].name;
      const weakest = domains[4].name;

      let summary = 'Ihre St\u00E4rke ist ' + strongest + ' und Ihr gr\u00F6\u00DFtes Entwicklungspotenzial liegt bei ' + weakest + '. ';
      if (total >= 40) summary += 'Ihr EQ ist sehr hoch. Sie zeichnen sich wahrscheinlich in F\u00FChrung, Beziehungen und Emotionsmanagement aus.';
      else if (total >= 30) summary += 'Ihr EQ ist \u00FCberdurchschnittlich. Sie haben gute emotionale F\u00E4higkeiten mit einigen Bereichen zur Weiterentwicklung.';
      else if (total >= 20) summary += 'Ihr EQ liegt im Durchschnittsbereich. Gezieltes Training in Ihren schw\u00E4cheren Bereichen kann deutliche Verbesserung bringen.';
      else summary += 'Ihr EQ-Wert deutet auf Entwicklungspotenzial hin. Die gute Nachricht: Emotionale Intelligenz l\u00E4sst sich durch \u00DCbung und Bewusstsein deutlich verbessern.';

      document.getElementById('eiq-summary')!.textContent = summary;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const ids = ['eiq-sa1','eiq-sa2','eiq-sr1','eiq-sr2','eiq-mo1','eiq-mo2','eiq-em1','eiq-em2','eiq-ss1','eiq-ss2'];
      ids.forEach(id => { (document.getElementById(id) as HTMLInputElement).value = '3'; });
      document.querySelectorAll('.eiq-in').forEach(el => {
        el.addEventListener('input', calcEIQ);
        el.addEventListener('change', calcEIQ);
      });
      calcEIQ();
    }, 50);
  </script>
</CalculatorLayout>
