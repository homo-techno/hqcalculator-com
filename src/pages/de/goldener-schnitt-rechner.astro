---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Goldener Schnitt Rechner - Phi, Drittel-Regel & Fibonacci-Spirale";
const description = "Berechnen Sie den Goldenen Schnitt und Drittel-Regel-Gitterpositionen aus Bildabmessungen. Fibonacci-Spirale und Phi-Anwendungen für visuelle Komposition.";
const relatedCalcs = [
  { name: "Glasfusing-Rechner", url: "/de/glasfusing-rechner", description: "Glasfusing-Brennpläne." },
  { name: "Glasdicke-Rechner", url: "/de/glasdicke-rechner", description: "Glasdicke." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Genauigkeit." },
  { name: "Grosskreis-Rechner", url: "/de/grosskreis-rechner", description: "Grosskreis-Distanz." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Goldener Schnitt Rechner" enSlug="golden-ratio-calculator" keywords="Goldener Schnitt Rechner, Phi, Fibonacci-Spirale, Drittel-Regel, Kompositionsgitter, Goldene Teilung, 1,618" breadcrumbs={[{ name: "Goldener Schnitt Rechner", url: "/de/goldener-schnitt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Goldener Schnitt Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Goldene-Schnitt-Gitterlinien, Fibonacci-Proportionen und Drittel-Regel-Positionen für die Bildkomposition.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Berechnungsmodus</label>
          <select id="gsr-mode" class="gsr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="image" selected>Bild-Kompositionsgitter</option>
            <option value="value">Goldener Schnitt aus Wert</option>
          </select>
        </div>

        <div id="gsr-image-inputs">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-sm font-medium text-text mb-1">Bildbreite (px)</label><input type="number" id="gsr-width" class="gsr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="1920" min="1" step="1"></div>
            <div><label class="block text-sm font-medium text-text mb-1">Bildhöhe (px)</label><input type="number" id="gsr-height" class="gsr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="1080" min="1" step="1"></div>
          </div>
        </div>

        <div id="gsr-value-inputs" style="display:none">
          <div><label class="block text-sm font-medium text-text mb-1">Wert eingeben</label><input type="number" id="gsr-value" class="gsr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="100" min="0.001" step="any"></div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Goldener Schnitt (\u03C6)</div>
          <div class="text-4xl font-extrabold" id="gsr-phi">1,6180339887</div>
        </div>

        <div id="gsr-image-results">
          <div class="p-4 bg-surface-alt rounded-xl mb-3">
            <h4 class="font-semibold text-sm text-text mb-2">Goldener-Schnitt-Gitterlinien</h4>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div><div class="text-text-secondary">Vertikal links</div><div class="font-bold text-text" id="gsr-vl"></div></div>
              <div><div class="text-text-secondary">Vertikal rechts</div><div class="font-bold text-text" id="gsr-vr"></div></div>
              <div><div class="text-text-secondary">Horizontal oben</div><div class="font-bold text-text" id="gsr-ht"></div></div>
              <div><div class="text-text-secondary">Horizontal unten</div><div class="font-bold text-text" id="gsr-hb"></div></div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl mb-3">
            <h4 class="font-semibold text-sm text-text mb-2">Drittel-Regel-Gitterlinien</h4>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div><div class="text-text-secondary">Vertikale Linien</div><div class="font-bold text-text" id="gsr-tv"></div></div>
              <div><div class="text-text-secondary">Horizontale Linien</div><div class="font-bold text-text" id="gsr-th"></div></div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl mb-3">
            <h4 class="font-semibold text-sm text-text mb-2">Kraftpunkte (Goldene Schnittpunkte)</h4>
            <div class="text-sm text-text-secondary space-y-1" id="gsr-points"></div>
          </div>
        </div>

        <div id="gsr-value-results" style="display:none">
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Wert x \u03C6</div><div class="text-xl font-bold text-text" id="gsr-mult"></div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Wert / \u03C6</div><div class="text-xl font-bold text-text" id="gsr-div"></div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Größeres Segment</div><div class="text-xl font-bold text-text" id="gsr-larger"></div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary uppercase tracking-wide">Kleineres Segment</div><div class="text-xl font-bold text-text" id="gsr-smaller"></div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl mt-3">
            <h4 class="font-semibold text-sm text-text mb-2">Fibonacci-Folge nahe Wert</h4>
            <div class="text-sm text-text-secondary" id="gsr-fib"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="goldener-schnitt" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Der Goldene Schnitt in der visuellen Kunst</h2>
      <p>Der Goldene Schnitt (Phi, \u03C6 = 1,618...) kommt in der gesamten Natur vor und wird seit Jahrhunderten in Kunst und Architektur verwendet. Er liefert ästhetisch ansprechende Proportionen für die Komposition.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zur Drittel-Regel?</strong> Die Drittel-Regel platziert Linien bei 33%, der Goldene Schnitt bei etwa 38,2%. Beide erzeugen visuell ausgewogene Kompositionen.</p>
      <p><strong>Was ist die Fibonacci-Folge?</strong> Jede Zahl ist die Summe der beiden vorherigen: 1, 1, 2, 3, 5, 8, 13, 21... Das Verhältnis aufeinanderfolgender Zahlen nähert sich Phi an.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const PHI_DE = (1 + Math.sqrt(5)) / 2;

    function calcGSR() {
      const mode = (document.getElementById('gsr-mode') as HTMLSelectElement).value;
      document.getElementById('gsr-phi')!.textContent = PHI_DE.toFixed(10).replace('.', ',');

      if (mode === 'image') {
        document.getElementById('gsr-image-inputs')!.style.display = '';
        document.getElementById('gsr-value-inputs')!.style.display = 'none';
        document.getElementById('gsr-image-results')!.style.display = '';
        document.getElementById('gsr-value-results')!.style.display = 'none';

        const w = parseInt((document.getElementById('gsr-width') as HTMLInputElement).value) || 1920;
        const h = parseInt((document.getElementById('gsr-height') as HTMLInputElement).value) || 1080;

        const gvl = Math.round(w / PHI_DE);
        const gvr = Math.round(w - w / PHI_DE);
        const ght = Math.round(h / PHI_DE);
        const ghb = Math.round(h - h / PHI_DE);

        document.getElementById('gsr-vl')!.textContent = gvr + 'px (' + (gvr / w * 100).toFixed(1) + '%)';
        document.getElementById('gsr-vr')!.textContent = gvl + 'px (' + (gvl / w * 100).toFixed(1) + '%)';
        document.getElementById('gsr-ht')!.textContent = ghb + 'px (' + (ghb / h * 100).toFixed(1) + '%)';
        document.getElementById('gsr-hb')!.textContent = ght + 'px (' + (ght / h * 100).toFixed(1) + '%)';

        const t1 = Math.round(w / 3);
        const t2 = Math.round(2 * w / 3);
        const t3 = Math.round(h / 3);
        const t4 = Math.round(2 * h / 3);
        document.getElementById('gsr-tv')!.textContent = t1 + 'px, ' + t2 + 'px';
        document.getElementById('gsr-th')!.textContent = t3 + 'px, ' + t4 + 'px';

        const points = [[gvr, ghb], [gvl, ghb], [gvr, ght], [gvl, ght]];
        let html = '';
        points.forEach((p, i) => {
          html += '<div>Punkt ' + (i + 1) + ': (' + p[0] + ', ' + p[1] + ') px</div>';
        });
        document.getElementById('gsr-points')!.innerHTML = html;
      } else {
        document.getElementById('gsr-image-inputs')!.style.display = 'none';
        document.getElementById('gsr-value-inputs')!.style.display = '';
        document.getElementById('gsr-image-results')!.style.display = 'none';
        document.getElementById('gsr-value-results')!.style.display = '';

        const val = parseFloat((document.getElementById('gsr-value') as HTMLInputElement).value) || 100;

        document.getElementById('gsr-mult')!.textContent = (val * PHI_DE).toFixed(4).replace('.', ',');
        document.getElementById('gsr-div')!.textContent = (val / PHI_DE).toFixed(4).replace('.', ',');
        document.getElementById('gsr-larger')!.textContent = (val / PHI_DE).toFixed(4).replace('.', ',');
        document.getElementById('gsr-smaller')!.textContent = (val - val / PHI_DE).toFixed(4).replace('.', ',');

        let fib = [1, 1];
        while (fib[fib.length - 1] < val * 5) {
          fib.push(fib[fib.length - 1] + fib[fib.length - 2]);
        }
        const nearby = fib.filter(f => f >= val * 0.1 && f <= val * 10);
        document.getElementById('gsr-fib')!.textContent = nearby.join(', ');
      }

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.gsr-in').forEach(el => {
        el.addEventListener('input', calcGSR);
        el.addEventListener('change', calcGSR);
      });
      calcGSR();
    }, 50);
  </script>
</CalculatorLayout>
