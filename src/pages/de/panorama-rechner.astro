---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Panorama Rechner - Bildanzahl, Überlappung & Bildwinkel";
const description = "Berechnen Sie Bildanzahl, Überlappung und Bildwinkel für Panoramafotografie. Ermitteln Sie die optimale Aufnahmeanzahl für lückenlose Panoramas.";

const relatedCalcs = [
  { name: "Tiefenschärfe-Rechner", url: "/de/tiefenschaerfe-rechner", description: "Tiefenschärfe." },
  { name: "Belichtungsrechner", url: "/de/belichtungsrechner", description: "Belichtung." },
  { name: "Bildgrößen-Rechner", url: "/de/bildgroessen-rechner", description: "Bildgrößen." },
  { name: "Druckkosten-Rechner", url: "/de/druckkosten-rechner", description: "Druckkosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Panorama Rechner" lang="de" enSlug="panorama-calculator" keywords="panorama rechner, panoramafotografie, bildanzahl panorama, überlappung kamera, bildwinkel berechnen" breadcrumbs={[{ name: "Panorama Rechner", url: "/de/panorama-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Panorama Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die optimale Bildanzahl, Überlappung und Bildwinkel für perfekte Panoramaaufnahmen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Brennweite (mm)</label><input type="number" id="pan-focal" class="pan-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="24" min="8" max="800" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sensor</label><select id="pan-sensor" class="pan-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="35">Vollformat (36×24 mm)</option><option value="crop">APS-C (23,5×15,6 mm)</option><option value="m43">MFT (17,3×13 mm)</option><option value="medium">Mittelformat (44×33 mm)</option></select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Panoramabreite (°)</label><input type="number" id="pan-hfov" class="pan-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="360" min="30" max="360" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Überlappung (%)</label><input type="number" id="pan-overlap" class="pan-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="10" max="70" step="5"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Ausrichtung</label>
          <select id="pan-orient" class="pan-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="land">Querformat</option>
            <option value="port">Hochformat</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Bilder</div>
          <div class="text-4xl font-extrabold font-mono" id="pan-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hör. Bildwinkel</div><div class="text-xl font-bold font-mono" id="pan-hangle">0°</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vert. Bildwinkel</div><div class="text-xl font-bold font-mono" id="pan-vangle">0°</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schrittwinkel</div><div class="text-xl font-bold font-mono" id="pan-step">0°</div></div>
        </div>
      </div>
      <ShareButton calculatorId="panorama-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Panoramafotografie planen</h2>
      <p class="text-text-secondary mt-2">Für ein hochwertiges Panoramabild ist die richtige Planung entscheidend. Eine Überlappung von 25–35 % ermöglicht der Stitching-Software, Bilder präzise zusammenzusetzen. Kürzere Brennweiten erfassen mehr Winkel pro Bild und reduzieren die Bildanzahl, haben aber mehr Randverzerrung. Längere Brennweiten liefern mehr Details, erfordern aber mehr Bilder.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Hör. Bildwinkel:</strong> 2 × arctan(Sensorbreite / (2 × Brennweite))</p>
        <p><strong>Bilder:</strong> ceil(Panoramabreite / (Bildwinkel × (1 - Überlappung/100)))</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Überlappung empfiehlt sich für Panoramas?</strong> Eine Überlappung von 25–35 % ist für die meisten Stitching-Programme ideal. Bei sehr schwierigen Lichtverhältnissen oder Weitwinkelaufnahmen empfehlen sich 40–50 %.</p>
      <p><strong>Welche Brennweite ist optimal für Panoramas?</strong> Mittlere Brennweiten (35–50 mm Vollformat) bieten einen guten Kompromiss aus Verzerrung und Bildanzahl. Unter 20 mm entstehen starke Randverzerrungen.</p>
      <p><strong>Muss ich ein Stativ verwenden?</strong> Für hochauflösende Panoramas ist ein Stativ mit Panoramakopf unverzichtbar. Das Nodalpunktadapter verhindert Parallaxefehler beim Stitching.</p>
      <p><strong>Was ist der Unterschied zwischen 180° und 360° Panorama?</strong> Ein 180° Panorama (Halbkugel) erfasst die gesamte Szenerie vor der Kamera. Ein 360° Panorama umschließt die komplette Umgebung und eignet sich für virtuelle Touren.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcPAN() {
      const focal = parseFloat((document.getElementById('pan-focal') as HTMLInputElement).value) || 24;
      const sensor = (document.getElementById('pan-sensor') as HTMLSelectElement).value;
      const panoramaW = parseFloat((document.getElementById('pan-hfov') as HTMLInputElement).value) || 360;
      const overlap = parseFloat((document.getElementById('pan-overlap') as HTMLInputElement).value) || 30;
      const orient = (document.getElementById('pan-orient') as HTMLSelectElement).value;

      const sensorW: Record<string, number> = { '35': 36, crop: 23.5, m43: 17.3, medium: 44 };
      const sensorH: Record<string, number> = { '35': 24, crop: 15.6, m43: 13, medium: 33 };

      const sw = sensorW[sensor] || 36;
      const sh = sensorH[sensor] || 24;
      const effW = orient === 'land' ? sw : sh;
      const effH = orient === 'land' ? sh : sw;

      const hAngle = 2 * Math.atan(effW / (2 * focal)) * (180 / Math.PI);
      const vAngle = 2 * Math.atan(effH / (2 * focal)) * (180 / Math.PI);
      const stepAngle = hAngle * (1 - overlap / 100);
      const numImages = Math.ceil(panoramaW / stepAngle);

      document.getElementById('pan-result')!.textContent = numImages.toLocaleString('de-DE');
      document.getElementById('pan-hangle')!.textContent = hAngle.toFixed(1).replace('.', ',') + '\u00B0';
      document.getElementById('pan-vangle')!.textContent = vAngle.toFixed(1).replace('.', ',') + '\u00B0';
      document.getElementById('pan-step')!.textContent = stepAngle.toFixed(1).replace('.', ',') + '\u00B0';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pan-in').forEach(el => { el.addEventListener('input', calcPAN); el.addEventListener('change', calcPAN); });
      calcPAN();
    }, 50);
  </script>
</CalculatorLayout>
