---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "H&ouml;rverlust-Rechner - Audiogramm auswerten";
const description = "Klassifizieren Sie den H&ouml;rverlust (geringf&uuml;gig, mittel, schwer, hochgradig) aus dB-HL-Schwellenwerten, erkennen Sie das Frequenzmuster und visualisieren Sie das Sprachbanane.";

const relatedCalcs = [
  { name: "H&ouml;rger&auml;t-Rechner", url: "/de/hoergeraet-rechner", description: "H&ouml;rger&auml;te-Kosten." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Blutdruckrechner", url: "/de/blutdruckrechner", description: "Blutdruckklassifikation." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="H&ouml;rverlust-Rechner"
  keywords="h&ouml;rverlust rechner, dB HL, h&ouml;rpegel, leichter h&ouml;rverlust, schwerer h&ouml;rverlust, audiogramm, sprachbanane"
  breadcrumbs={[{ name: "H&ouml;rverlust-Rechner", url: "/de/hoerverlust-rechner" }]}
  lang="de"
  enSlug="hearing-loss-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">H&ouml;rverlust-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Ihre Audiogramm-Schwellenwerte ein, um den H&ouml;rverlust zu klassifizieren und zu verstehen, welche Kl&auml;nge Sie m&ouml;glicherweise nicht h&ouml;ren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-3 bg-blue-50 rounded-xl text-center text-xs font-semibold text-blue-900 uppercase tracking-wide">H&ouml;rschwellen eingeben (dB HL) &ndash; Niedrigere Werte = Besser</div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">250 Hz</label><input type="number" id="hvde-250" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="-10" max="120" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">500 Hz</label><input type="number" id="hvde-500" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="-10" max="120" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">1000 Hz</label><input type="number" id="hvde-1k" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="-10" max="120" step="5"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">2000 Hz</label><input type="number" id="hvde-2k" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="-10" max="120" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">4000 Hz</label><input type="number" id="hvde-4k" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="-10" max="120" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">8000 Hz</label><input type="number" id="hvde-8k" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="-10" max="120" step="5"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Ohr</label>
          <select id="hvde-ear" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="right" selected>Rechtes Ohr</option>
            <option value="left">Linkes Ohr</option>
            <option value="better">Besseres Ohr</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">H&ouml;rverlust-Klassifikation</div>
          <div class="text-4xl font-extrabold font-mono" id="hvde-class">Normal</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">PTA (Reinton-Ø)</div><div class="text-xl font-bold font-mono" id="hvde-pta">0 dB</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hochfrequenz-Ø</div><div class="text-xl font-bold font-mono" id="hvde-hfa">0 dB</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Muster</div><div class="text-xl font-bold font-mono" id="hvde-pattern">-</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sprachverstehen</div><div class="text-xl font-bold font-mono" id="hvde-speech">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfehlung</div><div class="text-xl font-bold font-mono" id="hvde-rec">-</div></div>
        </div>
        <div class="p-3 bg-amber-50 rounded-xl text-center text-xs text-amber-800 font-semibold">
          Dieses Tool dient nur zu Informationszwecken. Bitte einen Audiologen f&uuml;r eine professionelle H&ouml;runtersuchung aufsuchen.
        </div>
      </div>

      <ShareButton calculatorId="hoerverlust-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&ouml;rverlust verstehen</h2>
      <p>Der Reintonmittelwert (PTA) ist der Durchschnitt der H&ouml;rschwellen bei 500, 1000 und 2000 Hz und ist die Standardmethode zur Klassifizierung des H&ouml;rverlustes nach WHO/DIN-Normen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet die dB-HL-Angabe?</strong> dB HL (Dezibel H&ouml;rpegel) ist die Menge an Verst&auml;rkung, die jemand ben&ouml;tigt, um einen Ton zu h&ouml;ren. Normalh&ouml;rende h&ouml;ren Frequenzen bei 0-15 dB HL. H&ouml;here Werte bedeuten gr&ouml;&szlig;eren H&ouml;rverlust.</p>
      <p><strong>Ab wann brauche ich ein H&ouml;rger&auml;t?</strong> H&ouml;rger&auml;te werden &uuml;blicherweise ab einem PTA von 25-40 dB HL (leichter bis mittlerer H&ouml;rverlust) empfohlen, wenn die Kommunikation beeintr&auml;chtigt ist.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHVDE() {
      const f250 = parseFloat((document.getElementById('hvde-250') as HTMLInputElement).value) || 0;
      const f500 = parseFloat((document.getElementById('hvde-500') as HTMLInputElement).value) || 0;
      const f1k = parseFloat((document.getElementById('hvde-1k') as HTMLInputElement).value) || 0;
      const f2k = parseFloat((document.getElementById('hvde-2k') as HTMLInputElement).value) || 0;
      const f4k = parseFloat((document.getElementById('hvde-4k') as HTMLInputElement).value) || 0;
      const f8k = parseFloat((document.getElementById('hvde-8k') as HTMLInputElement).value) || 0;

      const pta = (f500 + f1k + f2k) / 3;
      const hfa = (f2k + f4k + f8k) / 3;

      let classification: string;
      if (pta <= 15) classification = 'Normal';
      else if (pta <= 25) classification = 'Geringf\u00FCgig';
      else if (pta <= 40) classification = 'Leicht';
      else if (pta <= 55) classification = 'Mittel';
      else if (pta <= 70) classification = 'Mittel-Schwer';
      else if (pta <= 90) classification = 'Schwer';
      else classification = 'Hochgradig';

      const lowAvg = (f250 + f500) / 2;
      const highAvg = (f4k + f8k) / 2;
      const midAvg = (f1k + f2k) / 2;
      let pattern: string;
      if (highAvg - lowAvg > 20) pattern = 'Hochton-Abfall';
      else if (lowAvg - highAvg > 20) pattern = 'Tiefton (Anstieg)';
      else if (Math.abs(highAvg - lowAvg) <= 20 && midAvg < lowAvg - 15) pattern = 'Muldenf\u00F6rmig';
      else if (highAvg > 60 && f4k > f2k + 15) pattern = 'L\u00E4rmkerbe (4kHz)';
      else pattern = 'Flach';

      let speech: string;
      if (pta <= 15) speech = 'Keine Schwierigkeiten';
      else if (pta <= 25) speech = 'Leises Sprechen schwer';
      else if (pta <= 40) speech = 'Fl\u00FCstern fehlt';
      else if (pta <= 55) speech = 'Normalsprache fehlt';
      else if (pta <= 70) speech = 'Lautes Sprechen schwer';
      else if (pta <= 90) speech = 'Sprache kaum h\u00F6rbar';
      else speech = 'Sprache nicht h\u00F6rbar';

      let rec: string;
      if (pta <= 15) rec = 'J\u00E4hrliche Kontrolle';
      else if (pta <= 25) rec = 'Beobachten, ggf. H\u00F6rger\u00E4t';
      else if (pta <= 55) rec = 'H\u00F6rger\u00E4t empfohlen';
      else if (pta <= 90) rec = 'Leistungsstarkes H\u00F6rger\u00E4t';
      else rec = 'Cochlea-Implantat pr\u00FCfen';

      document.getElementById('hvde-class')!.textContent = classification;
      document.getElementById('hvde-pta')!.textContent = pta.toFixed(0) + ' dB HL';
      document.getElementById('hvde-hfa')!.textContent = hfa.toFixed(0) + ' dB HL';
      document.getElementById('hvde-pattern')!.textContent = pattern;
      document.getElementById('hvde-speech')!.textContent = speech;
      document.getElementById('hvde-rec')!.textContent = rec;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hvde-in').forEach(el => { el.addEventListener('input', calcHVDE); el.addEventListener('change', calcHVDE); });
      calcHVDE();
    }, 50);
  </script>
</CalculatorLayout>
