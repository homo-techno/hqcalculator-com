---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bestellmenge Rechner – Optimale Bestellmenge (EOQ) berechnen";
const description = "Berechnen Sie die optimale Bestellmenge (EOQ) und Bestellkosten.";
const relatedCalcs = [
  { name: "Notargebühren Rechner", url: "/de/notargebuehren-rechner", description: "Notarkosten berechnen." },
  { name: "Optionsgewinn Rechner", url: "/de/optionsgewinn-rechner", description: "Optionsgewinne." },
  { name: "Verpackungsrechner", url: "/de/verpackungs-rechner", description: "Verpackungsmengen." },
  { name: "Erzgehalt Rechner", url: "/de/erzgehalt-rechner", description: "Bergbaukennzahlen." },
];
---
<CalculatorLayout lang="de" enSlug="order-quantity-calculator" title={title} description={description} calculatorName="Bestellmenge Rechner" keywords="Bestellmenge, EOQ, optimale Bestellmenge, Lagerhaltungskosten, Bestellkosten, Andler, Logistik" breadcrumbs={[{ name: "Bestellmenge Rechner", url: "/de/bestellmenge-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bestellmenge Rechner (EOQ)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die optimale Bestellmenge nach dem Economic Order Quantity (EOQ) Modell (Andler-Formel) zur Minimierung der Gesamtkosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jahresbedarf (Stück/Jahr)</label>
            <input type="number" id="bm-demand" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bestellkosten (€/Bestellung)</label>
            <input type="number" id="bm-order" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="5" min="0">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einstandspreis (€/Stück)</label>
            <input type="number" id="bm-price" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Lagerkostensatz (% p.a.)</label>
            <input type="number" id="bm-rate" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" max="100">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Optimale Bestellmenge (EOQ)</div>
          <div class="text-5xl font-extrabold font-mono" id="bm-result">— Stück</div>
          <div class="text-sm text-blue-200 mt-1" id="bm-subtitle"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bestellhäufigkeit</div>
            <div class="text-xl font-bold" id="bm-freq">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bestellintervall</div>
            <div class="text-xl font-bold" id="bm-interval">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtkosten/Jahr</div>
            <div class="text-xl font-bold" id="bm-total">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ø Lagerbestand</div>
            <div class="text-xl font-bold" id="bm-avg">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Andler-Formel Berechnungsweg</h3>
          <div class="font-mono text-sm space-y-1" id="bm-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="order-quantity" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das EOQ-Modell in der Beschaffungslogistik</h2>
      <p>Das Economic Order Quantity (EOQ) Modell, in Deutschland auch als Andler-Formel bekannt, bestimmt die optimale Bestellmenge, bei der die Summe aus Bestellkosten und Lagerhaltungskosten minimal ist. Das Modell geht von einem konstanten, gleichmäßigen Bedarf, sofortiger Lieferung und fehlenden Mengenrabatten aus.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>EOQ = √(2 × D × S / (h × C))</p>
        <p>D = Jahresbedarf | S = Bestellkosten | h = Lagerkostensatz | C = Einstandspreis</p>
        <p>Bestellhäufigkeit = D / EOQ</p>
        <p>Gesamtkosten = D×C + EOQ/2×h×C + D/EOQ×S</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was sind Bestellkosten?</strong> Bestellkosten (auch Loskosten) umfassen alle Kosten, die bei jeder Bestellung anfallen: Verwaltungsaufwand, Versandkosten, Wareneingangskosten und ggf. Rüstkosten in der Produktion.</p>
      <p><strong>Was sind Lagerhaltungskosten?</strong> Lagerhaltungskosten entstehen durch Kapitalbindung (Zinsen), Lagerraum, Versicherung, Schwund und Veralterung. Typische Lagerkostensätze liegen zwischen 10–30% des Warenwerts pro Jahr.</p>
      <p><strong>Wann ist das EOQ-Modell nicht geeignet?</strong> Das EOQ-Modell funktioniert schlecht bei stark schwankender Nachfrage (besser: Bestellpunktverfahren), bei Mengenrabatten (besser: erweiterte EOQ-Modelle) und bei verderblichen Waren.</p>
      <p><strong>Was ist der Zusammenhang mit dem ABC/XYZ-Analyse?</strong> A-Artikel (hoher Wert) werden oft mit kleinen EOQ-Bestellmengen häufig bestellt. C-Artikel (niedriger Wert) werden mit großen Bestellmengen selten bestellt, um Bestellkosten zu sparen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBM() {
      const D = parseFloat((document.getElementById('bm-demand') as HTMLInputElement).value) || 0;
      const S = parseFloat((document.getElementById('bm-order') as HTMLInputElement).value) || 0;
      const C = parseFloat((document.getElementById('bm-price') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('bm-rate') as HTMLInputElement).value) || 0;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      const fmt0 = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      const hC = (h / 100) * C;
      const eoq = hC > 0 ? Math.sqrt(2 * D * S / hC) : 0;
      const freq = eoq > 0 ? D / eoq : 0;
      const interval = freq > 0 ? 365 / freq : 0;
      const avgStock = eoq / 2;
      const orderCostYear = freq * S;
      const holdingCostYear = avgStock * hC;
      const purchaseCost = D * C;
      const totalCost = purchaseCost + orderCostYear + holdingCostYear;
      const steps: string[] = [];
      steps.push('h×C = ' + fmt(h, 1) + '% × ' + fmt(C) + ' € = ' + fmt(hC) + ' €/Stück/Jahr');
      steps.push('EOQ = √(2 × ' + fmt0(D) + ' × ' + fmt(S) + ' / ' + fmt(hC) + ')');
      steps.push('= √(' + fmt(2*D*S) + ' / ' + fmt(hC) + ') = ' + fmt(eoq, 0) + ' Stück');
      steps.push('Bestellhäufigkeit = ' + fmt0(D) + ' / ' + fmt(eoq, 0) + ' = ' + fmt(freq, 1) + 'x/Jahr');
      steps.push('Ø Lagerbestand = EOQ/2 = ' + fmt(avgStock, 0) + ' Stück');
      steps.push('Gesamtkosten = Einkauf + Bestellung + Lagerung = ' + fmt(totalCost) + ' €');
      document.getElementById('bm-result')!.textContent = fmt0(Math.round(eoq)) + ' Stück';
      document.getElementById('bm-subtitle')!.textContent = freq.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + 'x pro Jahr bestellen';
      document.getElementById('bm-freq')!.textContent = freq.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + 'x/Jahr';
      document.getElementById('bm-interval')!.textContent = fmt(interval, 0) + ' Tage';
      document.getElementById('bm-total')!.textContent = fmt(totalCost) + ' €';
      document.getElementById('bm-avg')!.textContent = fmt(avgStock, 0) + ' Stück';
      document.getElementById('bm-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bm-demand') as HTMLInputElement).value = '10000';
      (document.getElementById('bm-order') as HTMLInputElement).value = '50';
      (document.getElementById('bm-price') as HTMLInputElement).value = '20';
      (document.getElementById('bm-rate') as HTMLInputElement).value = '20';
      document.querySelectorAll('.bm-in').forEach(el => { el.addEventListener('input', calcBM); el.addEventListener('change', calcBM); });
      calcBM();
    }, 50);
  </script>
</CalculatorLayout>
