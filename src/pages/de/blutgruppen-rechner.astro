---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blutgruppenrechner - Blutgruppe des Kindes vorhersagen";
const description = "Sagen Sie mögliche Blutgruppen von Kindern basierend auf den Blutgruppen der Eltern mittels Genetik vorher.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Tägliche Kalorien." },
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Wahrscheinlichkeit." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Blutgruppenrechner" lang="de" keywords="blutgruppen rechner, blutgruppe vererbung, ABO blutgruppe, rhesusfaktor, genetik rechner" breadcrumbs={[{ name: "Blutgruppe", url: "/de/blutgruppen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blutgruppenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sagen Sie mögliche Blutgruppen von Kindern anhand der elterlichen Blutgruppen vorher.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Elternteil 1 Blutgruppe</label>
            <select id="bt-p1" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="A">A</option><option value="B">B</option><option value="AB">AB</option><option value="O" selected>0</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Elternteil 2 Blutgruppe</label>
            <select id="bt-p2" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="A" selected>A</option><option value="B">B</option><option value="AB">AB</option><option value="O">0</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Elternteil 1 Rhesusfaktor</label>
            <select id="bt-rh1" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="+" selected>Rh+ (Positiv)</option><option value="-">Rh- (Negativ)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Elternteil 2 Rhesusfaktor</label>
            <select id="bt-rh2" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="+" selected>Rh+ (Positiv)</option><option value="-">Rh- (Negativ)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mögliche Blutgruppen des Kindes</div>
          <div class="text-3xl font-extrabold" id="bt-result">-</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Wahrscheinlichkeitsverteilung</h3>
          <div class="space-y-2" id="bt-probs"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Kompatibilität</h3>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div><div class="text-xs text-text-muted">Elternteil 1 kann spenden an</div><div class="font-bold" id="bt-don1">-</div></div>
            <div><div class="text-xs text-text-muted">Elternteil 1 kann empfangen von</div><div class="font-bold" id="bt-rec1">-</div></div>
            <div><div class="text-xs text-text-muted">Elternteil 2 kann spenden an</div><div class="font-bold" id="bt-don2">-</div></div>
            <div><div class="text-xs text-text-muted">Elternteil 2 kann empfangen von</div><div class="font-bold" id="bt-rec2">-</div></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="blood-type" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Blutgruppen-Genetik</h2>
      <p>Die Blutgruppe wird durch das ABO-Gen bestimmt. A und B sind kodominant, 0 ist rezessiv. Rh+ ist dominant gegenüber Rh-.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const genotypes: Record<string, string[][]> = {
      'A': [['A','A'],['A','O']], 'B': [['B','B'],['B','O']], 'AB': [['A','B']], 'O': [['O','O']]
    };
    const donateMap: Record<string, string> = {
      'O-':'Alle Typen','O+':'O+,A+,B+,AB+','A-':'A-,A+,AB-,AB+','A+':'A+,AB+','B-':'B-,B+,AB-,AB+','B+':'B+,AB+','AB-':'AB-,AB+','AB+':'Nur AB+'
    };
    const receiveMap: Record<string, string> = {
      'O-':'Nur O-','O+':'O-,O+','A-':'O-,A-','A+':'O-,O+,A-,A+','B-':'O-,B-','B+':'O-,O+,B-,B+','AB-':'O-,A-,B-,AB-','AB+':'Alle Typen'
    };
    function phenotype(a1: string, a2: string): string {
      const s = new Set([a1, a2]);
      if (s.has('A') && s.has('B')) return 'AB';
      if (s.has('A')) return 'A';
      if (s.has('B')) return 'B';
      return 'O';
    }
    function calcBT() {
      const p1 = (document.getElementById('bt-p1') as HTMLSelectElement).value;
      const p2 = (document.getElementById('bt-p2') as HTMLSelectElement).value;
      const rh1 = (document.getElementById('bt-rh1') as HTMLSelectElement).value;
      const rh2 = (document.getElementById('bt-rh2') as HTMLSelectElement).value;
      const g1 = genotypes[p1], g2 = genotypes[p2];
      const counts: Record<string, number> = {};
      let total = 0;
      for (const ga of g1) { for (const gb of g2) { for (const a of ga) { for (const b of gb) {
        const ph = phenotype(a, b); counts[ph] = (counts[ph] || 0) + 1; total++;
      }}}}
      const rhGenotypes1 = rh1 === '+' ? [['+','+'],['+','-']] : [['-','-']];
      const rhGenotypes2 = rh2 === '+' ? [['+','+'],['+','-']] : [['-','-']];
      const rhCounts: Record<string, number> = { '+': 0, '-': 0 };
      let rhTotal = 0;
      for (const r1 of rhGenotypes1) { for (const r2 of rhGenotypes2) { for (const a of r1) { for (const b of r2) {
        const rh = (a === '+' || b === '+') ? '+' : '-'; rhCounts[rh]++; rhTotal++;
      }}}}
      const results: string[] = [];
      const probLines: string[] = [];
      for (const type of ['A', 'B', 'AB', 'O']) {
        if (counts[type]) {
          const aboPct = counts[type] / total * 100;
          for (const rh of ['+', '-']) {
            if (rhCounts[rh]) {
              const pct = aboPct * (rhCounts[rh] / rhTotal) / 100 * 100;
              if (pct > 0) {
                results.push(type + rh);
                probLines.push(`<div class="flex justify-between"><span class="font-mono font-bold">${type}${rh}</span><div class="flex items-center gap-2"><div class="w-24 bg-gray-200 rounded-full h-2"><div class="bg-primary rounded-full h-2" style="width:${pct}%"></div></div><span class="text-sm font-semibold">${pct.toFixed(1)}%</span></div></div>`);
              }
            }
          }
        }
      }
      document.getElementById('bt-result')!.textContent = results.join(', ');
      document.getElementById('bt-probs')!.innerHTML = probLines.join('');
      const full1 = p1 + rh1, full2 = p2 + rh2;
      document.getElementById('bt-don1')!.textContent = donateMap[full1] || '-';
      document.getElementById('bt-rec1')!.textContent = receiveMap[full1] || '-';
      document.getElementById('bt-don2')!.textContent = donateMap[full2] || '-';
      document.getElementById('bt-rec2')!.textContent = receiveMap[full2] || '-';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { ['bt-p1','bt-p2','bt-rh1','bt-rh2'].forEach(id => document.getElementById(id)!.addEventListener('change', calcBT)); calcBT(); }, 50);
  </script>
</CalculatorLayout>
