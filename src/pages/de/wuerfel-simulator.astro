---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "W\u00fcrfel-Simulator - Virtueller W\u00fcrfelwurf";
const description = "W\u00fcrfeln Sie virtuelle W\u00fcrfel: W4, W6, W8, W10, W12, W20 und W100. Perfekt f\u00fcr D&D, Brettspiele und Tabletop-RPGs.";

const relatedCalcs = [
  { name: "Zufallszahlengenerator", url: "/de/zufallszahlengenerator", description: "Zufallszahlen." },
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Wahrscheinlichkeit." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Mittelwert." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="W\u00fcrfel-Simulator" lang="de" enSlug="dice-roller" keywords="wuerfel simulator, virtueller wuerfel, w20 wuerfel, dnd wuerfel, tabletop rpg wuerfel, zufallswuerfel" breadcrumbs={[{ name: "W\u00fcrfel-Simulator", url: "/de/wuerfel-simulator" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">W&uuml;rfel-Simulator</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">W&uuml;rfeln Sie virtuelle W&uuml;rfel f&uuml;r Tabletop-Spiele, D&amp;D und mehr.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl W&uuml;rfel</label><input type="number" id="wfs-count" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="2" min="1" max="100" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Modifikator (+/-)</label><input type="number" id="wfs-mod" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="0" step="1"></div>
        </div>
        <div class="grid grid-cols-7 gap-2">
          <button class="wfs-die py-3 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-sides="6">W6</button>
          <button class="wfs-die py-3 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-sides="4">W4</button>
          <button class="wfs-die py-3 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-sides="8">W8</button>
          <button class="wfs-die py-3 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-sides="10">W10</button>
          <button class="wfs-die py-3 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-sides="12">W12</button>
          <button class="wfs-die py-3 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-sides="20">W20</button>
          <button class="wfs-die py-3 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-sides="100">W100</button>
        </div>
        <button id="wfs-roll" class="w-full py-4 bg-primary text-white rounded-xl font-bold text-xl hover:bg-primary/90 transition">W&uuml;rfeln!</button>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="wfs-label">2W6</div>
          <div class="text-6xl font-extrabold font-mono" id="wfs-total">-</div>
        </div>
        <div class="flex flex-wrap gap-2 justify-center" id="wfs-dice"></div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Summe</div><div class="text-xl font-bold font-mono" id="wfs-sum">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Min. m&ouml;glich</div><div class="text-xl font-bold font-mono" id="wfs-min">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. m&ouml;glich</div><div class="text-xl font-bold font-mono" id="wfs-max">-</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl max-h-40 overflow-y-auto">
          <h3 class="font-semibold text-sm text-text mb-2">Verlauf</h3>
          <div class="space-y-1 text-sm font-mono" id="wfs-history"></div>
        </div>
      </div>
      <ShareButton calculatorId="dice-roller-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">W&uuml;rfel f&uuml;r Tabletop-Spiele</h2>
      <p>In Rollenspielen wie D&amp;D werden verschiedene W&uuml;rfeltypen verwendet: W4, W6, W8, W10, W12, W20 und W100. Der W20 ist der wichtigste W&uuml;rfel f&uuml;r Angriffs- und F&auml;higkeitsw&uuml;rfe.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet 2W6+3?</strong> Zwei sechsseitige W&uuml;rfel werfen und 3 zum Ergebnis addieren.</p>
      <p><strong>Wie funktioniert der W100?</strong> Meist werden zwei W10 geworfen: einer f&uuml;r die Zehnerstelle, einer f&uuml;r die Einerstelle (00-99, wobei 00 = 100).</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let wfsSides = 6;
    function rollWFS() {
      const count = parseInt((document.getElementById('wfs-count') as HTMLInputElement).value) || 1;
      const mod = parseInt((document.getElementById('wfs-mod') as HTMLInputElement).value) || 0;
      const results: number[] = [];
      for (let i = 0; i < count; i++) results.push(Math.floor(Math.random() * wfsSides) + 1);
      const sum = results.reduce((a, b) => a + b, 0);
      const total = sum + mod;
      const modStr = mod > 0 ? '+' + mod : mod < 0 ? String(mod) : '';
      document.getElementById('wfs-label')!.textContent = count + 'W' + wfsSides + modStr;
      document.getElementById('wfs-total')!.textContent = String(total);
      document.getElementById('wfs-sum')!.textContent = String(sum);
      document.getElementById('wfs-min')!.textContent = String(count + mod);
      document.getElementById('wfs-max')!.textContent = String(count * wfsSides + mod);
      document.getElementById('wfs-dice')!.innerHTML = results.map(r =>
        '<div class="w-12 h-12 flex items-center justify-center rounded-lg bg-white border-2 border-border font-bold text-lg ' + (r === wfsSides ? 'text-green-600 border-green-400' : r === 1 ? 'text-red-600 border-red-400' : '') + '">' + r + '</div>'
      ).join('');
      const hist = document.getElementById('wfs-history')!;
      hist.innerHTML = '<div>' + count + 'W' + wfsSides + modStr + ': [' + results.join(', ') + ']' + (modStr ? ' ' + modStr : '') + ' = ' + total + '</div>' + hist.innerHTML;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('wfs-roll')!.addEventListener('click', rollWFS);
      document.querySelectorAll('.wfs-die').forEach(btn => btn.addEventListener('click', () => {
        wfsSides = parseInt((btn as HTMLElement).dataset.sides!) || 6;
        document.querySelectorAll('.wfs-die').forEach(b => {
          const active = (b as HTMLElement).dataset.sides === String(wfsSides);
          (b as HTMLElement).className = 'wfs-die py-3 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
      }));
      rollWFS();
    }, 50);
  </script>
</CalculatorLayout>
