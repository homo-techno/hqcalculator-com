---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kabelkanal-Rechner - Energiekette f&uuml;r Robotik dimensionieren";
const description = "Berechnen Sie Kabelkanal- (Energieketten-) Dimensionierung f&uuml;r Robotik- und CNC-Anwendungen. Bestimmen Sie Innenma&szlig;e, Biegeradius, Verfahrweg und F&uuml;llkapazit&auml;t.";
const relatedCalcs = [
  { name: "Kabeld&auml;mpfung-Rechner", url: "/de/kabeldaempfung-rechner", description: "Kabelverlust berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen berechnen." },
  { name: "Fl&auml;chenrechner", url: "/de/flaechenrechner", description: "Fl&auml;chen berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kabelkanal-Rechner" lang="de" enSlug="cable-carrier-calculator" keywords="kabelkanal rechner, energiekette, schleppkette, kabelmanagement, biegeradius, robotik" breadcrumbs={[{ name: "Kabelkanal-Rechner", url: "/de/kabelkanal-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kabelkanal-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Dimensionieren Sie Kabelkan&auml;le (Energieketten) f&uuml;r Robotik- und Bewegungssysteme. Berechnen Sie Innenma&szlig;e, minimalen Biegeradius und Gesamtkettenl&auml;nge aus Ihrem Kabelb&uuml;ndel.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-6">
        <h3 class="text-lg font-bold text-text">Kabelb&uuml;ndel</h3>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="block text-sm font-semibold text-text mb-2">Leistungskabel (Anz.)</label><input type="number" id="ccr-power-qty" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-sm font-semibold text-text mb-2">Leistungskabel AD (mm)</label><input type="number" id="ccr-power-od" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
          <div><label class="block text-sm font-semibold text-text mb-2">Signalkabel (Anz.)</label><input type="number" id="ccr-signal-qty" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-sm font-semibold text-text mb-2">Signalkabel AD (mm)</label><input type="number" id="ccr-signal-od" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
          <div><label class="block text-sm font-semibold text-text mb-2">Pneumatikschl&auml;uche (Anz.)</label><input type="number" id="ccr-hose-qty" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-sm font-semibold text-text mb-2">Schlauch AD (mm)</label><input type="number" id="ccr-hose-od" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
        </div>
        <h3 class="text-lg font-bold text-text">Verfahrparameter</h3>
        <div><label class="block text-sm font-semibold text-text mb-2">Verfahrweg (mm)</label><input type="number" id="ccr-travel" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="50" step="50"></div>
        <div><label class="block text-sm font-semibold text-text mb-2">Max. Geschwindigkeit (m/s)</label><input type="number" id="ccr-speed" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">F&uuml;llfaktor (%)</label>
          <input type="number" id="ccr-fill" class="ccr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="30" max="80" step="5">
          <p class="text-xs text-text-secondary mt-1">Empfohlen: 50-60% f&uuml;r Kabel, max. 80%</p>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm font-medium opacity-80 mb-1">Empfohlene Innenh&ouml;he</div>
          <div id="ccr-result-height" class="text-3xl sm:text-4xl font-extrabold">--</div>
          <div class="text-sm opacity-80 mt-1">mm (min. Innenma&szlig;)</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary mb-1">Min. Innenbreite</div><div id="ccr-inner-width" class="text-lg font-bold text-text">--</div><div class="text-xs text-text-secondary">mm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary mb-1">Min. Biegeradius</div><div id="ccr-bend-radius" class="text-lg font-bold text-text">--</div><div class="text-xs text-text-secondary">mm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary mb-1">Gesamte Kettenl&auml;nge</div><div id="ccr-chain-length" class="text-lg font-bold text-text">--</div><div class="text-xs text-text-secondary">mm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary mb-1">Kabelquerschnitt</div><div id="ccr-cable-area" class="text-lg font-bold text-text">--</div><div class="text-xs text-text-secondary">mm&sup2; gesamt</div></div>
        </div>
        <ShareButton calculatorId="cable-carrier" lang="de" />
        <FeedbackWidget lang="de" />
      </div>
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Energieketten dimensionieren</h2>
      <p>Die richtige Dimensionierung einer Energiekette (Schleppkette) ist entscheidend f&uuml;r die Lebensdauer der darin gef&uuml;hrten Kabel. Der F&uuml;llfaktor sollte 60% nicht &uuml;berschreiten, damit die Kabel gen&uuml;gend Bewegungsfreiheit haben. Der minimale Biegeradius betr&auml;gt typischerweise das 10-fache des gr&ouml;&szlig;ten Kabelau&szlig;endurchmessers.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcCCR() {
      const powerQty = parseInt((document.getElementById('ccr-power-qty') as HTMLInputElement).value) || 0;
      const powerOD = parseFloat((document.getElementById('ccr-power-od') as HTMLInputElement).value) || 12;
      const signalQty = parseInt((document.getElementById('ccr-signal-qty') as HTMLInputElement).value) || 0;
      const signalOD = parseFloat((document.getElementById('ccr-signal-od') as HTMLInputElement).value) || 6;
      const hoseQty = parseInt((document.getElementById('ccr-hose-qty') as HTMLInputElement).value) || 0;
      const hoseOD = parseFloat((document.getElementById('ccr-hose-od') as HTMLInputElement).value) || 8;
      const travel = parseFloat((document.getElementById('ccr-travel') as HTMLInputElement).value) || 500;
      const speed = parseFloat((document.getElementById('ccr-speed') as HTMLInputElement).value) || 3;
      const fillPct = parseFloat((document.getElementById('ccr-fill') as HTMLInputElement).value) / 100 || 0.6;
      const powerArea = powerQty * Math.PI * Math.pow(powerOD / 2, 2);
      const signalArea = signalQty * Math.PI * Math.pow(signalOD / 2, 2);
      const hoseArea = hoseQty * Math.PI * Math.pow(hoseOD / 2, 2);
      const totalCableArea = powerArea + signalArea + hoseArea;
      const largestOD = Math.max(powerQty > 0 ? powerOD : 0, signalQty > 0 ? signalOD : 0, hoseQty > 0 ? hoseOD : 0);
      const innerHeight = Math.ceil(largestOD * 1.1 + 2);
      const requiredInnerArea = totalCableArea / fillPct;
      const innerWidth = Math.ceil(requiredInnerArea / innerHeight);
      const minBendRadius = Math.max(largestOD * 10, 50);
      const chainLength = travel + Math.PI * minBendRadius + 200;
      document.getElementById('ccr-result-height')!.textContent = innerHeight.toString();
      document.getElementById('ccr-inner-width')!.textContent = innerWidth.toString();
      document.getElementById('ccr-bend-radius')!.textContent = minBendRadius.toFixed(0);
      document.getElementById('ccr-chain-length')!.textContent = chainLength.toFixed(0);
      document.getElementById('ccr-cable-area')!.textContent = totalCableArea.toFixed(1).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ccr-power-qty') as HTMLInputElement).value = '3';
      (document.getElementById('ccr-power-od') as HTMLInputElement).value = '12';
      (document.getElementById('ccr-signal-qty') as HTMLInputElement).value = '4';
      (document.getElementById('ccr-signal-od') as HTMLInputElement).value = '6';
      (document.getElementById('ccr-hose-qty') as HTMLInputElement).value = '2';
      (document.getElementById('ccr-hose-od') as HTMLInputElement).value = '8';
      (document.getElementById('ccr-travel') as HTMLInputElement).value = '500';
      (document.getElementById('ccr-speed') as HTMLInputElement).value = '3';
      (document.getElementById('ccr-fill') as HTMLInputElement).value = '60';
      document.querySelectorAll('.ccr-in').forEach(el => { el.addEventListener('input', calcCCR); el.addEventListener('change', calcCCR); });
      calcCCR();
    }, 50);
  </script>
</CalculatorLayout>
