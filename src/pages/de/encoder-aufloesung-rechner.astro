---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Encoder-Aufl\u00f6sung-Rechner - PPR zu Winkel- & Linearaufl\u00f6sung";
const description = "Wandeln Sie Encoder-PPR (Impulse pro Umdrehung) in Winkel- und Linearaufl\u00f6sung um. Berechnen Sie die Positionsgenauigkeit f\u00fcr Dreh- und Linear-Encoder.";
const relatedCalcs = [
  { name: "Gleichstufige Stimmung", url: "/de/gleichstufige-stimmung-rechner", description: "Frequenzberechnung." },
  { name: "Gleichungsl\u00f6ser", url: "/de/gleichungsloeser", description: "Gleichungen l\u00f6sen." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
  { name: "Fluchtgeschwindigkeit", url: "/de/fluchtgeschwindigkeit-rechner", description: "Fluchtgeschwindigkeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Encoder-Aufl\u00f6sung-Rechner" lang="de" enSlug="encoder-resolution-calculator" keywords="encoder aufl\u00f6sung, PPR, impulse pro umdrehung, winkelaufl\u00f6sung, linearaufl\u00f6sung, quadratur-encoder" breadcrumbs={[{ name: "Encoder-Aufl\u00f6sung", url: "/de/encoder-aufloesung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Encoder-Aufl&ouml;sung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">PPR in Winkel- und Linearaufl&ouml;sung umrechnen. Unterst&uuml;tzt Quadratur-Dekodierung und Gewindespindelsteigung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Encoder PPR (Impulse pro Umdrehung)</label>
          <input type="number" id="encde-ppr" class="encde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1024" min="1" step="1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Quadratur-Dekodierung</label>
          <select id="encde-quad" class="encde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">1x (Einzelflanke)</option>
            <option value="2">2x (Doppelflanke)</option>
            <option value="4" selected>4x (Quadratur)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Getriebe&uuml;bersetzung</label>
          <input type="number" id="encde-gear" class="encde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" step="1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Gewindespindel-Steigung (mm/Umdrehung)</label>
          <input type="number" id="encde-pitch" class="encde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.1" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Max. Wellendrehzahl (U/min)</label>
          <input type="number" id="encde-rpm" class="encde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="1" step="100">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm font-medium opacity-80 mb-1">Winkelaufl&ouml;sung</div>
          <div id="encde-result-angle" class="text-3xl sm:text-4xl font-extrabold">--</div>
          <div class="text-sm opacity-80 mt-1">Grad pro Z&auml;hlschritt</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Gesamtz&auml;hlschritte/Umdr.</div>
            <div id="encde-counts" class="text-lg font-bold text-text">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Bogensekunden/Schritt</div>
            <div id="encde-arcsec" class="text-lg font-bold text-text">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Linearaufl&ouml;sung</div>
            <div id="encde-linear" class="text-lg font-bold text-text">--</div>
            <div class="text-xs text-text-secondary">Mikrometer/Schritt</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Max. Frequenz</div>
            <div id="encde-freq" class="text-lg font-bold text-text">--</div>
            <div class="text-xs text-text-secondary">kHz</div>
          </div>
        </div>

        <ShareButton calculatorId="encoder-resolution-de" lang="de" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Encoder-Aufl&ouml;sung verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Gesamtschritte = PPR &times; Quadratur &times; Getriebe&uuml;bersetzung</p>
        <p>Winkelaufl&ouml;sung = 360&deg; / Gesamtschritte</p>
        <p>Linearaufl&ouml;sung = Steigung / Gesamtschritte</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist Quadratur-Dekodierung?</strong> Bei 4x-Dekodierung werden alle vier Flanken der A- und B-Signale gez&auml;hlt, was die Aufl&ouml;sung vervierfacht.</p>
      <p><strong>Wie w&auml;hle ich den richtigen Encoder?</strong> Die erforderliche Aufl&ouml;sung h&auml;ngt von der Anwendung ab. F&uuml;r CNC-Maschinen sind typischerweise 1-10 Mikrometer Linearaufl&ouml;sung erforderlich.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcENCDE() {
      const ppr = parseFloat((document.getElementById('encde-ppr') as HTMLInputElement).value) || 1024;
      const quad = parseFloat((document.getElementById('encde-quad') as HTMLSelectElement).value) || 4;
      const gear = parseFloat((document.getElementById('encde-gear') as HTMLInputElement).value) || 1;
      const pitch = parseFloat((document.getElementById('encde-pitch') as HTMLInputElement).value) || 5;
      const rpm = parseFloat((document.getElementById('encde-rpm') as HTMLInputElement).value) || 3000;

      const totalCounts = ppr * quad * gear;
      const angleDeg = 360 / totalCounts;
      const arcSec = angleDeg * 3600;
      const linearMicrons = (pitch * 1000) / totalCounts;
      const maxFreqHz = (totalCounts * rpm) / 60;
      const maxFreqKHz = maxFreqHz / 1000;

      document.getElementById('encde-result-angle')!.textContent = angleDeg.toFixed(6);
      document.getElementById('encde-counts')!.textContent = totalCounts.toLocaleString('de-DE');
      document.getElementById('encde-arcsec')!.textContent = arcSec.toFixed(2);
      document.getElementById('encde-linear')!.textContent = linearMicrons.toFixed(3);
      document.getElementById('encde-freq')!.textContent = maxFreqKHz.toFixed(1);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.encde-in').forEach(el => { el.addEventListener('input', calcENCDE); el.addEventListener('change', calcENCDE); });
      calcENCDE();
    }, 50);
  </script>
</CalculatorLayout>
