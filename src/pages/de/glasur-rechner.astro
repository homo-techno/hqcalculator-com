---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Glasur-Rechner - Glasurmenge f\u00FCr Torten & Cupcakes";
const description = "Berechnen Sie die genaue Glasurmenge f\u00FCr Schichttorten, Blechkuchen und Cupcakes. Erhalten Sie Zutatenmengen f\u00FCr Buttercreme und Frischk\u00E4se-Glasur.";
const relatedCalcs = [
  { name: "Backumrechner", url: "/de/backumrechner", description: "Backma\u00DFe umrechnen." },
  { name: "Rezeptskalierer", url: "/de/rezeptskalierer", description: "Rezepte skalieren." },
  { name: "Kuchenform-Umrechner", url: "/de/kuchenform-umrechner", description: "Zwischen Formgr\u00F6\u00DFen umrechnen." },
  { name: "Zuckersirup-Rechner", url: "/de/zuckersirup-rechner", description: "Zuckersirup-Konzentrationen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Glasur-Rechner" lang="de" enSlug="frosting-calculator" keywords="glasur rechner, glasurmenge, buttercreme menge, tortenglasur, cupcake glasur, frischk\u00E4se glasur" breadcrumbs={[{ name: "Glasur-Rechner", url: "/de/glasur-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Glasur-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie viel Glasur Sie f&uuml;r Ihre Torte oder Cupcakes ben&ouml;tigen, mit Zutatenmengen f&uuml;r beliebte Glasurarten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kuchentyp</label>
          <select id="gls-type" class="gls-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="layer2">2-Schicht-Rundtorte</option>
            <option value="layer3">3-Schicht-Rundtorte</option>
            <option value="sheet">Blechkuchen (23x33 cm)</option>
            <option value="cupcakes">Cupcakes</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Durchmesser (cm) / Anzahl</label>
            <input type="number" id="gls-size" class="gls-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="22" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Glasurdicke</label>
            <select id="gls-style" class="gls-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="thin">D&uuml;nn</option>
              <option value="medium" selected>Mittel</option>
              <option value="thick">Dick / Dekorativ</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Glasurart</label>
          <select id="gls-recipe" class="gls-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="buttercream">Amerikanische Buttercreme</option>
            <option value="cream">Frischk&auml;se-Glasur</option>
            <option value="swiss">Schweizer Baiser-Buttercreme</option>
            <option value="ganache">Schokoladen-Ganache</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Glasurmenge ben&ouml;tigt</div>
          <div class="text-5xl font-extrabold font-mono" id="gls-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Butter / Fett</div>
            <div class="text-xl font-bold font-mono" id="gls-butter">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Puderzucker</div>
            <div class="text-xl font-bold font-mono" id="gls-sugar">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fl&uuml;ssigkeit (Milch/Sahne)</div>
            <div class="text-xl font-bold font-mono" id="gls-liquid">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Portionen</div>
            <div class="text-xl font-bold font-mono" id="gls-serves">--</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="frosting-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Glasur f&uuml;r Torten berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Oberfl&auml;che = Decke + Seiten + Zwischenschichten</p>
        <p>Glasurmenge = Oberfl&auml;che &times; Dickenfaktor</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel Buttercreme f&uuml;r eine 26-cm-Torte?</strong> F&uuml;r eine 2-Schicht-Torte mit 26 cm Durchmesser und mittlerer Glasurdicke ben&ouml;tigen Sie ca. 700-900 g Buttercreme.</p>
      <p><strong>Kann ich Glasur einfrieren?</strong> Ja, Buttercreme l&auml;sst sich bis zu 3 Monate einfrieren. Vor der Verwendung im K&uuml;hlschrank auftauen und nochmals aufschlagen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGLS() {
      const type = (document.getElementById('gls-type') as HTMLSelectElement).value;
      const size = parseFloat((document.getElementById('gls-size') as HTMLInputElement).value) || 22;
      const style = (document.getElementById('gls-style') as HTMLSelectElement).value;
      const recipe = (document.getElementById('gls-recipe') as HTMLSelectElement).value;
      let grams = 0;
      if (type === 'cupcakes') {
        const perCupcake = style === 'thin' ? 28 : style === 'medium' ? 40 : 60;
        grams = size * perCupcake;
      } else if (type === 'sheet') {
        grams = style === 'thin' ? 700 : style === 'medium' ? 950 : 1300;
      } else {
        const layers = type === 'layer3' ? 3 : 2;
        const diameterCm = size;
        const topArea = Math.PI * Math.pow(diameterCm / 2, 2);
        const sideArea = Math.PI * diameterCm * (layers * 4);
        const betweenLayers = topArea * (layers - 1);
        const totalSqCm = topArea + sideArea + betweenLayers;
        const factor = style === 'thin' ? 0.08 : style === 'medium' ? 0.12 : 0.17;
        grams = totalSqCm * factor;
      }
      let butterG = 0, sugarG = 0, liquidMl = 0;
      if (recipe === 'buttercream') {
        butterG = grams * 0.3; sugarG = grams * 0.6; liquidMl = grams * 0.05;
      } else if (recipe === 'cream') {
        butterG = grams * 0.25; sugarG = grams * 0.45; liquidMl = grams * 0.03;
      } else if (recipe === 'swiss') {
        butterG = grams * 0.45; sugarG = grams * 0.22; liquidMl = 0;
      } else {
        butterG = 0; sugarG = grams * 0.6; liquidMl = grams * 0.12;
      }
      const serves = type === 'cupcakes' ? Math.round(size) : type === 'sheet' ? 24 : (type === 'layer3' ? 16 : 12);
      document.getElementById('gls-result')!.textContent = Math.round(grams).toLocaleString('de-DE') + ' g';
      document.getElementById('gls-butter')!.textContent = (recipe === 'ganache' ? 'Entf\u00E4llt (Sahne verwenden)' : Math.round(butterG).toLocaleString('de-DE') + ' g');
      document.getElementById('gls-sugar')!.textContent = Math.round(sugarG).toLocaleString('de-DE') + ' g';
      document.getElementById('gls-liquid')!.textContent = Math.round(liquidMl).toLocaleString('de-DE') + ' ml';
      document.getElementById('gls-serves')!.textContent = serves + ' Portionen';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gls-in').forEach(el => { el.addEventListener('input', calcGLS); el.addEventListener('change', calcGLS); });
      calcGLS();
    }, 50);
  </script>
</CalculatorLayout>
