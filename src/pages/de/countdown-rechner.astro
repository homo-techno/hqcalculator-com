---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Countdown-Rechner - Tage bis zu einem beliebigen Datum";
const description = "Zaehlen Sie die Tage, Stunden, Minuten und Sekunden bis zu einem beliebigen Datum herunter. Planen Sie Events und verfolgen Sie Fristen.";
const relatedCalcs = [
  { name: "Datumsrechner", url: "/de/datumsrechner", description: "Datumsberechnungen." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "Stundenrechner", url: "/de/stundenrechner", description: "Stunden berechnen." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeitberechnungen." },
  { name: "Arbeitstagerechner", url: "/de/arbeitstage-rechner", description: "Arbeitstage." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Countdown-Rechner" keywords="Countdown Rechner, Tage bis, Countdown Timer, Datum Countdown, Zeit bis Ereignis" breadcrumbs={[{ name: "Countdown-Rechner", url: "/de/countdown-rechner" }]} lang="de" enSlug="countdown-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Countdown-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sehen Sie genau, wie viel Zeit bis zu einem beliebigen Datum verbleibt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zieldatum</label><input type="date" id="cdr-date" class="cdr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2026-12-31"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ereignisname</label><input type="text" id="cdr-name" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="Silvester 2027" placeholder="Optional"></div>
        </div>
        <div class="flex gap-2 flex-wrap">
          <button class="cdr-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-date="2026-12-25" data-name="Weihnachten">Weihnachten</button>
          <button class="cdr-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-date="2027-01-01" data-name="Neujahr 2027">Neujahr</button>
          <button class="cdr-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-date="2026-10-03" data-name="Tag der Deutschen Einheit">3. Oktober</button>
          <button class="cdr-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-date="2026-10-31" data-name="Halloween">Halloween</button>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="cdr-label">Zeit bis</div>
          <div class="text-5xl font-extrabold font-mono" id="cdr-days">0</div>
          <div class="text-sm text-blue-200 mt-1">Tage</div>
        </div>
        <div class="grid grid-cols-4 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tage</div><div class="text-2xl font-bold font-mono" id="cdr-d">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stunden</div><div class="text-2xl font-bold font-mono" id="cdr-h">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minuten</div><div class="text-2xl font-bold font-mono" id="cdr-m">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sekunden</div><div class="text-2xl font-bold font-mono" id="cdr-s">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wochen</div><div class="text-xl font-bold" id="cdr-weeks">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stunden gesamt</div><div class="text-xl font-bold" id="cdr-totH">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minuten gesamt</div><div class="text-xl font-bold" id="cdr-totM">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="countdown" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie funktioniert der Countdown-Rechner?</h2>
      <p>Der Countdown-Rechner zeigt Ihnen die genaue verbleibende Zeit bis zu einem beliebigen Datum an. Ob Geburtstag, Hochzeit, Urlaub oder ein wichtiger Termin - Sie sehen Tage, Stunden, Minuten und Sekunden in Echtzeit.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Wie viele Tage bis Weihnachten?</strong> Waehlen Sie den 25. Dezember als Zieldatum und sehen Sie die genaue Anzahl der verbleibenden Tage.</li>
        <li><strong>Kann ich den Countdown fuer vergangene Daten nutzen?</strong> Ja, der Rechner zeigt auch die verstrichene Zeit seit einem vergangenen Datum an.</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcCDR() {
      const dateStr = (document.getElementById('cdr-date') as HTMLInputElement).value;
      const name = (document.getElementById('cdr-name') as HTMLInputElement).value || 'Zieldatum';
      if (!dateStr) return;
      const target = new Date(dateStr + 'T00:00:00');
      const now = new Date();
      const diff = target.getTime() - now.getTime();
      const past = diff < 0;
      const absDiff = Math.abs(diff);
      const totalDays = Math.floor(absDiff / 86400000);
      const hours = Math.floor((absDiff % 86400000) / 3600000);
      const mins = Math.floor((absDiff % 3600000) / 60000);
      const secs = Math.floor((absDiff % 60000) / 1000);
      document.getElementById('cdr-label')!.textContent = past ? 'Zeit seit ' + name : 'Zeit bis ' + name;
      document.getElementById('cdr-days')!.textContent = (past ? '-' : '') + totalDays.toLocaleString('de-DE');
      document.getElementById('cdr-d')!.textContent = String(totalDays);
      document.getElementById('cdr-h')!.textContent = String(hours);
      document.getElementById('cdr-m')!.textContent = String(mins);
      document.getElementById('cdr-s')!.textContent = String(secs);
      document.getElementById('cdr-weeks')!.textContent = (totalDays / 7).toFixed(1).replace('.', ',');
      document.getElementById('cdr-totH')!.textContent = Math.floor(absDiff / 3600000).toLocaleString('de-DE');
      document.getElementById('cdr-totM')!.textContent = Math.floor(absDiff / 60000).toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.cdr-in').forEach(el => el.addEventListener('input', calcCDR));
      document.querySelectorAll('.cdr-preset').forEach(btn => btn.addEventListener('click', () => {
        (document.getElementById('cdr-date') as HTMLInputElement).value = (btn as HTMLElement).dataset.date!;
        (document.getElementById('cdr-name') as HTMLInputElement).value = (btn as HTMLElement).dataset.name!;
        calcCDR();
      }));
      calcCDR();
      setInterval(calcCDR, 1000);
    }, 50);
  </script>
</CalculatorLayout>
