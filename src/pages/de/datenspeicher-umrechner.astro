---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Datenspeicher-Umrechner - Bytes, KB, MB, GB, TB";
const description = "Rechnen Sie zwischen Datenspeichereinheiten um: Bits, Bytes, KB, MB, GB, TB, PB und deren binaere Entsprechungen.";

const relatedCalcs = [
  { name: "Datentransfer-Rechner", url: "/de/datentransfer-rechner", description: "Uebertragungszeit." },
  { name: "Prozentrechner", url: "/de/prozent-rechner", description: "Prozentrechnung." },
  { name: "Einheitenumrechner", url: "/de/laengenumrechner", description: "Laengeneinheiten." },
  { name: "Pixel-Rechner", url: "/de/pixel-rechner", description: "Pixel." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="data-storage-converter" calculatorName="Datenspeicher-Umrechner" keywords="datenspeicher umrechner, bytes in gb, mb in gb, tb in gb, datenmenge umrechnen, bits in bytes" breadcrumbs={[{ name: "Datenspeicher-Umrechner", url: "/de/datenspeicher-umrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Datenspeicher-Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen allen g&auml;ngigen Datenspeichereinheiten um.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Wert</label>
            <input type="number" id="dsu-val" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1" min="0" step="0.1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="dsu-unit" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="0">Bits</option>
              <option value="3">Bytes</option>
              <option value="13">KB (1000)</option>
              <option value="23">MB (1000&sup2;)</option>
              <option value="33" selected>GB (1000&sup3;)</option>
              <option value="43">TB (1000&sup4;)</option>
              <option value="53">PB (1000&sup5;)</option>
              <option value="10">KiB (1024)</option>
              <option value="20">MiB (1024&sup2;)</option>
              <option value="30">GiB (1024&sup3;)</option>
              <option value="40">TiB (1024&sup4;)</option>
            </select>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Dezimale (SI) Einheiten</h3>
          <div class="space-y-2 text-sm" id="dsu-decimal"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Bin&auml;re (IEC) Einheiten</h3>
          <div class="space-y-2 text-sm" id="dsu-binary"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Basiseinheiten</h3>
          <div class="space-y-2 text-sm" id="dsu-base"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="data-storage" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Datenspeichereinheiten erkl&auml;rt</h2>
      <p>SI-Einheiten verwenden Zehnerpotenzen (KB, MB, GB). Bin&auml;re Einheiten verwenden Zweierpotenzen (KiB, MiB, GiB). Betriebssysteme und Speicherhersteller mischen diese Standards h&auml;ufig.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum zeigt meine Festplatte weniger Speicher an?</strong> Hersteller verwenden SI-Einheiten (1 GB = 1.000.000.000 Bytes), w&auml;hrend Betriebssysteme oft bin&auml;re Einheiten nutzen (1 GiB = 1.073.741.824 Bytes).</p>
      <p><strong>Was ist der Unterschied zwischen Bits und Bytes?</strong> 1 Byte = 8 Bits. Internetgeschwindigkeiten werden in Bits (Mbit/s), Dateigroessen in Bytes (MB) angegeben.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcDSU() {
      const val = parseFloat((document.getElementById('dsu-val') as HTMLInputElement).value) || 0;
      const unitCode = (document.getElementById('dsu-unit') as HTMLSelectElement).value;
      let bits: number;
      if (unitCode === '0') bits = val;
      else if (unitCode === '3') bits = val * 8;
      else if (unitCode === '13') bits = val * 1000 * 8;
      else if (unitCode === '23') bits = val * 1e6 * 8;
      else if (unitCode === '33') bits = val * 1e9 * 8;
      else if (unitCode === '43') bits = val * 1e12 * 8;
      else if (unitCode === '53') bits = val * 1e15 * 8;
      else if (unitCode === '10') bits = val * 1024 * 8;
      else if (unitCode === '20') bits = val * 1048576 * 8;
      else if (unitCode === '30') bits = val * 1073741824 * 8;
      else if (unitCode === '40') bits = val * 1099511627776 * 8;
      else bits = val;
      const bytes = bits / 8;
      function fmt(n: number): string { return n < 0.01 && n > 0 ? n.toExponential(4) : n >= 1e12 ? n.toExponential(4) : n.toLocaleString('de-DE', { maximumFractionDigits: 6 }); }
      const decRow = (label: string, val: number) => '<div class="flex justify-between"><span>' + label + '</span><span class="font-mono font-bold">' + fmt(val) + '</span></div>';
      document.getElementById('dsu-decimal')!.innerHTML = [
        decRow('Kilobytes (KB)', bytes / 1e3),
        decRow('Megabytes (MB)', bytes / 1e6),
        decRow('Gigabytes (GB)', bytes / 1e9),
        decRow('Terabytes (TB)', bytes / 1e12),
        decRow('Petabytes (PB)', bytes / 1e15),
      ].join('');
      document.getElementById('dsu-binary')!.innerHTML = [
        decRow('Kibibytes (KiB)', bytes / 1024),
        decRow('Mebibytes (MiB)', bytes / 1048576),
        decRow('Gibibytes (GiB)', bytes / 1073741824),
        decRow('Tebibytes (TiB)', bytes / 1099511627776),
      ].join('');
      document.getElementById('dsu-base')!.innerHTML = [
        decRow('Bits', bits),
        decRow('Bytes', bytes),
      ].join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.getElementById('dsu-val')!.addEventListener('input', calcDSU); document.getElementById('dsu-unit')!.addEventListener('change', calcDSU); calcDSU(); }, 50);
  </script>
</CalculatorLayout>
