---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Elektrisches Feld-Rechner - Feldstärke, Kraft & Potential";
const description = "Berechnen Sie die elektrische Feldstärke, die Coulomb-Kraft und das elektrische Potential einer Punktladung in verschiedenen Entfernungen.";

const relatedCalcs = [
  { name: "Coulomb-Rechner", url: "/de/coulomb-rechner", description: "Coulomb-Kraft." },
  { name: "Kapazitätsrechner", url: "/de/kapazitaetsrechner", description: "Kapazität berechnen." },
  { name: "Ohmsches Gesetz", url: "/de/ohmsches-gesetz-rechner", description: "U=I*R." },
  { name: "Magnetfeld-Rechner", url: "/de/magnetfeld-rechner", description: "Magnetfelder." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Elektrisches Feld-Rechner" lang="de" enSlug="electric-field-calculator" keywords="elektrisches feld rechner, feldstärke, coulomb kraft, potential, punktladung" breadcrumbs={[{ name: "Elektrisches Feld-Rechner", url: "/de/elektrisches-feld-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Elektrisches Feld-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die elektrische Feldst&auml;rke, Kraft und das Potential einer Punktladung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ladung Q (&mu;C)</label><input type="number" id="elf-q" class="elf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Abstand r (cm)</label><input type="number" id="elf-r" class="elf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0.1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Testladung q (nC) &mdash; f&uuml;r Kraftberechnung</label><input type="number" id="elf-q2" class="elf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Feldst&auml;rke E</div>
          <div class="text-4xl font-extrabold font-mono" id="elf-result">0 N/C</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Potential V</div><div class="text-xl font-bold" id="elf-pot">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraft F</div><div class="text-xl font-bold" id="elf-force">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pot. Energie</div><div class="text-xl font-bold" id="elf-energy">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flussdichte D</div><div class="text-xl font-bold" id="elf-flux">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="elf-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="electric-field-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Elektrisches Feld einer Punktladung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>E = k &times; Q / r&sup2; (k = 8,987 &times; 10&sup9; N&middot;m&sup2;/C&sup2;)</p>
        <p>V = k &times; Q / r</p>
        <p>F = k &times; Q &times; q / r&sup2;</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die elektrische Feldst&auml;rke?</strong> Sie beschreibt die Kraft pro Ladungseinheit an einem Punkt im Raum, gemessen in N/C oder V/m.</p>
      <p><strong>Wie &auml;ndert sich das Feld mit dem Abstand?</strong> Die Feldst&auml;rke nimmt mit dem Quadrat des Abstands ab (Abstandsgesetz).</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcElf() {
      const q = parseFloat((document.getElementById('elf-q') as HTMLInputElement).value) || 0;
      const r = parseFloat((document.getElementById('elf-r') as HTMLInputElement).value) || 1;
      const q2 = parseFloat((document.getElementById('elf-q2') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const k = 8.9875e9;
      const qC = q * 1e-6;
      const rM = r / 100;
      steps.push('Q = ' + q + ' uC = ' + qC.toExponential(2) + ' C');
      steps.push('r = ' + r + ' cm = ' + rM.toExponential(2) + ' m');
      const E = k * Math.abs(qC) / (rM * rM);
      steps.push('E = k x |Q| / r2 = ' + E.toExponential(3) + ' N/C');
      const V = k * qC / rM;
      steps.push('V = k x Q / r = ' + V.toExponential(3) + ' V');
      const q2C = q2 * 1e-9;
      const F = k * Math.abs(qC) * Math.abs(q2C) / (rM * rM);
      if (q2 > 0) {
        steps.push('F = k x |Q| x |q| / r2 = ' + F.toExponential(3) + ' N');
      }
      const U = k * qC * q2C / rM;
      const D = 8.854e-12 * E;
      document.getElementById('elf-result')!.textContent = E.toExponential(3) + ' N/C';
      document.getElementById('elf-pot')!.textContent = V.toExponential(3) + ' V';
      document.getElementById('elf-force')!.textContent = q2 > 0 ? F.toExponential(3) + ' N' : '\u2014';
      document.getElementById('elf-energy')!.textContent = q2 > 0 ? U.toExponential(3) + ' J' : '\u2014';
      document.getElementById('elf-flux')!.textContent = D.toExponential(3) + ' C/m\u00B2';
      document.getElementById('elf-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('elf-q') as HTMLInputElement).value = '1';
      (document.getElementById('elf-r') as HTMLInputElement).value = '10';
      (document.getElementById('elf-q2') as HTMLInputElement).value = '5';
      document.querySelectorAll('.elf-in').forEach(el => { el.addEventListener('input', calcElf); el.addEventListener('change', calcElf); });
      calcElf();
    }, 50);
  </script>
</CalculatorLayout>
