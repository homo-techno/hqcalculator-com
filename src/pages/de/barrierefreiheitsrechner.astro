---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Barrierefreiheitsrechner - Kosten für barrierefreien Umbau";
const description = "Schätzen Sie die Kosten für den barrierefreien Umbau von Gewerbegebäuden inklusive Rampen, Sanitäranlagen, Türen, Beschilderung und Parkplätzen.";
const relatedCalcs = [
  { name: "Compliance-Kostenrechner", url: "/compliance-cost-calculator", description: "Compliance-Budget." },
  { name: "Renovierungsrechner", url: "/incorporation-calculator", description: "Unternehmensgründung." },
  { name: "Gewerbeimmobilien", url: "/commercial-rent-calculator", description: "Gewerbemiete." },
  { name: "ROI-Rechner", url: "/roi-calculator", description: "Kapitalrendite." },
  { name: "Versicherungsrechner", url: "/workers-comp-calculator", description: "Arbeitsunfallversicherung." },
  { name: "Rechtskosten", url: "/litigation-cost-calculator", description: "Prozesskosten." },
];
---

<CalculatorLayout lang="de" title={title} description={description} calculatorName="Barrierefreiheitsrechner" keywords="Barrierefreiheit Rechner, barrierefreier Umbau, Zugänglichkeit, Gewerbegebäude, Rollstuhlrampe, barrierefreies WC" breadcrumbs={[{ name: "Barrierefreiheit", url: "/de/barrierefreiheitsrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Barrierefreiheitsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Kosten für die barrierefreie Gestaltung Ihres Gewerbegebäudes.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gebäudetyp</label>
          <select id="ada-building" class="ada-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="office" selected>Bürogebäude</option>
            <option value="retail">Einzelhandel</option>
            <option value="restaurant">Restaurant</option>
            <option value="medical">Arztpraxis / Zahnarzt</option>
            <option value="hotel">Hotel / Beherbergung</option>
            <option value="education">Schule / Bildungseinrichtung</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gebäudefläche (m²)</label>
          <input type="number" id="ada-sqft" class="ada-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="50" max="50000" step="50">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Eingangszugänglichkeit</label>
          <select id="ada-entrance" class="ada-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="compliant">Bereits barrierefrei</option>
            <option value="ramp" selected>Rampe / ebenerdiger Zugang nötig</option>
            <option value="automatic-doors">Automatische Türen nötig</option>
            <option value="both">Rampe + automatische Türen</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Sanitäranlagen</label>
          <select id="ada-restroom" class="ada-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Bereits barrierefrei</option>
            <option value="minor" selected>Kleinere Anpassungen (Haltegriffe, etc.)</option>
            <option value="major">Größerer Umbau (Kabine vergrößern)</option>
            <option value="full">Kompletter barrierefreier Neubau</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Parkplatzanpassungen</label>
          <select id="ada-parking" class="ada-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Bereits barrierefrei</option>
            <option value="signage" selected>Nur Beschilderung + Markierung</option>
            <option value="spaces">Behindertenparkplätze + Beschilderung</option>
            <option value="full">Komplette Neugestaltung</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Innenraumanpassungen</label>
          <select id="ada-interior" class="ada-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Bereits barrierefrei</option>
            <option value="minor" selected>Klein (Türverbreiterung, Schwellen)</option>
            <option value="moderate">Mittel (Theken, Gänge, Beschilderung)</option>
            <option value="major">Groß (Aufzug, Flure, Grundriss)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Regionaler Kostenfaktor</label>
          <select id="ada-region" class="ada-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.8">Niedrigkostenregion</option>
            <option value="1.0" selected>Durchschnitt</option>
            <option value="1.3">Hochpreisige Großstadt</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Umbaukosten</div>
          <div class="text-5xl font-extrabold font-mono" id="ada-total"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Eingangsbereich</div>
            <div class="text-xl font-bold text-secondary" id="ada-entrance-cost"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sanitäranlagen</div>
            <div class="text-xl font-bold" id="ada-restroom-cost"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Innen / Parkplatz</div>
            <div class="text-xl font-bold text-orange-600" id="ada-other-cost"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mögliche Förderung</div>
            <div class="text-xl font-bold text-green-600" id="ada-credit"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="ada-compliance" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Kosten für Barrierefreiheit verstehen</h2>
      <p>In Deutschland schreibt die DIN 18040 die barrierefreie Gestaltung von Gebäuden vor. Typische Maßnahmen umfassen Rollstuhlrampen (1.500-8.000 €), barrierefreie Sanitäranlagen (3.000-15.000 €), Türverbreiterungen (500-2.500 € pro Tür) und Parkplatzanpassungen (500-5.000 €). Die Kosten variieren je nach Gebäudealter, Typ und Region erheblich.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Fördermöglichkeiten</h3>
      <p>Es gibt verschiedene Förderprogramme von Bund und Ländern für barrierefreie Umbauten. Die KfW bietet zinsgünstige Kredite und Zuschüsse für altersgerechte und barrierefreie Umbauten an. Diese Förderungen können einen erheblichen Teil der Kosten abdecken.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' €';

    function calcADA() {
      const entrance = (document.getElementById('ada-entrance') as HTMLSelectElement).value;
      const restroom = (document.getElementById('ada-restroom') as HTMLSelectElement).value;
      const parking = (document.getElementById('ada-parking') as HTMLSelectElement).value;
      const interior = (document.getElementById('ada-interior') as HTMLSelectElement).value;
      const regionFactor = parseFloat((document.getElementById('ada-region') as HTMLSelectElement).value) || 1.0;
      const sqft = parseInt((document.getElementById('ada-sqft') as HTMLInputElement).value) || 500;

      const entranceCosts: Record<string, number> = {
        compliant: 0, ramp: 5000, 'automatic-doors': 4000, both: 8500
      };
      const entranceCost = (entranceCosts[entrance] || 0) * regionFactor;

      const restroomCosts: Record<string, number> = {
        none: 0, minor: 2500, major: 8000, full: 15000
      };
      const restroomCost = (restroomCosts[restroom] || 0) * regionFactor;

      const parkingCosts: Record<string, number> = {
        none: 0, signage: 800, spaces: 3000, full: 8000
      };
      const parkingCost = (parkingCosts[parking] || 0) * regionFactor;

      const interiorBase: Record<string, number> = {
        none: 0, minor: 3000, moderate: 10000, major: 50000
      };
      let interiorCost = (interiorBase[interior] || 0) * regionFactor;
      if (sqft > 500) interiorCost *= (1 + (sqft - 500) / 2000);

      const otherCost = parkingCost + interiorCost;
      const total = entranceCost + restroomCost + otherCost;

      const foerderung = Math.min(total * 0.3, 12500);

      document.getElementById('ada-total')!.textContent = fmt(total);
      document.getElementById('ada-entrance-cost')!.textContent = fmt(entranceCost);
      document.getElementById('ada-restroom-cost')!.textContent = fmt(restroomCost);
      document.getElementById('ada-other-cost')!.textContent = fmt(otherCost);
      document.getElementById('ada-credit')!.textContent = '-' + fmt(foerderung);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ada-in').forEach(el => {
        el.addEventListener('input', calcADA);
        el.addEventListener('change', calcADA);
      });
      calcADA();
    }, 50);
  </script>
</CalculatorLayout>
