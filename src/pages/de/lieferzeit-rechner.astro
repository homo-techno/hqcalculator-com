---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lieferzeitrechner";
const description = "Berechnen Sie Lieferzeiten, Durchlaufzeiten und Produktionsplanung.";

const relatedCalcs = [
  { name: "Lernkurvenrechner", url: "/de/lernkurven-rechner", description: "Effizienzgewinne prognostizieren." },
  { name: "Leasingrechner", url: "/de/leasing-rechner", description: "Leasingraten berechnen." },
  { name: "Sprachlernrechner", url: "/de/sprachlern-rechner", description: "Lernzeit planen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibungen berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Lieferzeitrechner" lang="de" enSlug="lead-time-calculator" keywords="lieferzeitrechner, durchlaufzeit berechnen, produktionsplanung, vorlaufzeit berechnen" breadcrumbs={[{ name: "Lieferzeitrechner", url: "/de/lieferzeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lieferzeitrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Lieferzeiten, Durchlaufzeiten und optimieren Sie Ihre Produktionsplanung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Bestelldatum</label><input type="date" id="lzr-order" class="lzr-in w-full px-4 py-3 border border-border rounded-xl text-lg"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Beschaffungszeit (Tage)</label><input type="number" id="lzr-procurement" class="lzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Produktionszeit (Tage)</label><input type="number" id="lzr-production" class="lzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Qualitätsprüfung (Tage)</label><input type="number" id="lzr-qa" class="lzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Versandzeit (Tage)</label><input type="number" id="lzr-shipping" class="lzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Puffertage</label><input type="number" id="lzr-buffer" class="lzr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Werktage (Mo–Fr)</label><select id="lzr-workdays" class="lzr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="true" selected>Ja (Werktage)</option>
            <option value="false">Nein (Kalendertage)</option>
          </select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Voraussichtliches Lieferdatum</div>
          <div class="text-3xl font-extrabold font-mono" id="lzr-delivery">–</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtzeit (Tage)</div><div class="text-xl font-bold" id="lzr-total">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalenderwochen</div><div class="text-xl font-bold" id="lzr-weeks">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kritischer Pfad</div><div class="text-sm font-bold" id="lzr-critical">–</div></div>
        </div>
      </div>
      <ShareButton calculatorId="lead-time-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Lieferzeit und Durchlaufzeit in der Produktion</h2>
      <p>Die Lieferzeit (auch Lead Time) umfasst alle Phasen von der Bestellung bis zur Auslieferung: Beschaffung von Rohmaterial, Produktion, Qualitätsprüfung und Versand. In der Produktionsplanung ist die Kenntnis der Durchlaufzeiten entscheidend für termingerechte Lieferungen. Puffertage berücksichtigen Verzögerungen und unvorhergesehene Ereignisse. Eine realistische Lieferzeitberechnung stärkt das Vertrauen der Kunden und verbessert die Planungssicherheit.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Lieferzeit und Durchlaufzeit?</strong> Die Durchlaufzeit bezieht sich auf die interne Produktionszeit, die Lieferzeit umfasst zusätzlich Beschaffung und Versand – also die Gesamtzeit vom Auftragseingang bis zur Auslieferung.</p>
      <p><strong>Wie berechnet man Lieferzeiten in Werktagen?</strong> Werktage berücksichtigen Samstag und Sonntag nicht. Bei 10 Werktagen entspricht dies ca. 14 Kalendertagen. Der Rechner berücksichtigt Wochenenden automatisch.</p>
      <p><strong>Was ist Safety Stock?</strong> Sicherheitsbestand (Safety Stock) ist der Minimalbestand, der Lieferunterbrechungen überbrückt. Er hängt von Lieferzeitvariabilität und Nachfrageschwankungen ab.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function addWorkdays(date: Date, days: number): Date {
      const result = new Date(date);
      let added = 0;
      while (added < days) {
        result.setDate(result.getDate() + 1);
        const dow = result.getDay();
        if (dow !== 0 && dow !== 6) added++;
      }
      return result;
    }
    function calcLZR() {
      const orderVal = (document.getElementById('lzr-order') as HTMLInputElement).value;
      if (!orderVal) return;
      const orderDate = new Date(orderVal);
      const procurement = parseInt((document.getElementById('lzr-procurement') as HTMLInputElement).value) || 0;
      const production = parseInt((document.getElementById('lzr-production') as HTMLInputElement).value) || 0;
      const qa = parseInt((document.getElementById('lzr-qa') as HTMLInputElement).value) || 0;
      const shipping = parseInt((document.getElementById('lzr-shipping') as HTMLInputElement).value) || 0;
      const buffer = parseInt((document.getElementById('lzr-buffer') as HTMLInputElement).value) || 0;
      const useWorkdays = (document.getElementById('lzr-workdays') as HTMLSelectElement).value === 'true';
      const totalDays = procurement + production + qa + shipping + buffer;
      let deliveryDate: Date;
      if (useWorkdays) {
        deliveryDate = addWorkdays(orderDate, totalDays);
      } else {
        deliveryDate = new Date(orderDate);
        deliveryDate.setDate(deliveryDate.getDate() + totalDays);
      }
      const dateStr = deliveryDate.toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
      const weeks = (totalDays / (useWorkdays ? 5 : 7)).toFixed(1).replace('.', ',');
      const phases = [
        ['Beschaffung', procurement],
        ['Produktion', production],
        ['QA', qa],
        ['Versand', shipping],
        ['Puffer', buffer],
      ];
      const critical = phases.filter(p => p[1] > 0).sort((a, b) => (b[1] as number) - (a[1] as number))[0];
      document.getElementById('lzr-delivery')!.textContent = dateStr;
      document.getElementById('lzr-total')!.textContent = totalDays.toLocaleString('de-DE');
      document.getElementById('lzr-weeks')!.textContent = weeks + ' Wo.';
      document.getElementById('lzr-critical')!.textContent = critical ? critical[0] + ' (' + critical[1] + ' T.)' : '–';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      const today = new Date().toISOString().split('T')[0];
      (document.getElementById('lzr-order') as HTMLInputElement).value = today;
      document.querySelectorAll('.lzr-in').forEach(el => { el.addEventListener('input', calcLZR); el.addEventListener('change', calcLZR); });
      calcLZR();
    }, 50);
  </script>
</CalculatorLayout>
