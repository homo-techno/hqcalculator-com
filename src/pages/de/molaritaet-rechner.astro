---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Molaritäts Rechner - Konzentration und Verdünnung berechnen";
const description = "Berechnen Sie Molarität, Konzentration und Verdünnung chemischer Lösungen. Mit Verdünnungsformel C1V1=C2V2 und Mol-Gramm-Umrechnung.";

const relatedCalcs = [
  { name: "Mol Rechner", url: "/de/mol-rechner", description: "Mol berechnen." },
  { name: "pH-Wert Rechner", url: "/de/ph-wert-rechner", description: "pH berechnen." },
  { name: "Stöchiometrie-Rechner", url: "/de/stoichiometrie-rechner", description: "Stöchiometrie berechnen." },
  { name: "Dichte-Rechner", url: "/de/dichterechner", description: "Dichte berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="molarity-calculator" calculatorName="Molaritäts Rechner" keywords="Molarität Rechner, Konzentration berechnen, Verdünnung, C1V1 C2V2, mol/L, chemische Lösung" breadcrumbs={[{ name: "Molaritäts Rechner", url: "/de/molaritaet-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Molaritäts Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Molarität (mol/L), Masse, Volumen und Verdünnungen für chemische Lösungen im Labor.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="mol-btn-conc" class="mol-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer">Konzentration</button>
          <button id="mol-btn-dil" class="mol-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer">Verdünnung</button>
        </div>

        <div id="mol-conc-mode">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Masse des Stoffes (g)</label>
              <input type="number" id="mol-mass" class="mol-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0" value="58.44">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Molmasse (g/mol)</label>
              <input type="number" id="mol-mw" class="mol-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0.001" value="58.44">
            </div>
          </div>
          <div class="mt-3">
            <label class="block text-xs font-medium text-text mb-1">Lösungsvolumen (mL)</label>
            <input type="number" id="mol-vol" class="mol-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0.001" value="1000">
          </div>
        </div>

        <div id="mol-dil-mode" class="hidden space-y-3">
          <p class="text-xs text-text-muted">Verdünnungsformel: C1 × V1 = C2 × V2</p>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Ausgangskonzentration C1 (mol/L)</label>
              <input type="number" id="mol-c1" class="mol-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0" value="5">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Ausgangsvolumen V1 (mL)</label>
              <input type="number" id="mol-v1" class="mol-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0" value="20">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zielkonzentration C2 (mol/L)</label>
            <input type="number" id="mol-c2" class="mol-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0" value="0.5">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="mol-result-label">Molarität</div>
          <div class="text-5xl font-extrabold font-mono" id="mol-result">— mol/L</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="mol-sub1-label">Molanzahl</div>
            <div class="text-xl font-bold" id="mol-sub1">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="mol-sub2-label">Konzentration</div>
            <div class="text-xl font-bold" id="mol-sub2">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rechenweg</h3>
          <div class="font-mono text-sm space-y-1" id="mol-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="molarity" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Molarität und Konzentration in der Chemie</h2>
      <p>Die Molarität (c) gibt die Konzentration eines gelösten Stoffes in mol pro Liter Lösung an. Sie ist eine der wichtigsten Konzentrationsangaben in der Analytik und präparativen Chemie.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>c (mol/L) = n (mol) / V (L)</p>
        <p>n (mol) = m (g) / M (g/mol)</p>
        <p>Verdünnung: C1 × V1 = C2 × V2</p>
        <p>Benötigtes Volumen: V2 = C1 × V1 / C2</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen Molarität und Molalität?</p>
          <p>Molarität (c, mol/L) bezieht sich auf das Lösungsvolumen. Molalität (m, mol/kg) bezieht sich auf die Masse des Lösungsmittels. Bei verdünnten wässrigen Lösungen sind beide ähnlich, bei konzentrierten Lösungen unterscheiden sie sich.</p>
        </div>
        <div>
          <p class="font-semibold">Wie bereite ich eine 1 M NaCl-Lösung zu?</p>
          <p>NaCl (Molmasse: 58,44 g/mol). Für 1 Liter einer 1 M Lösung: 58,44 g NaCl in einem 1-L-Messkolben in destilliertem Wasser auflösen und auf die Markierung auffüllen. Für 500 mL: 29,22 g verwenden.</p>
        </div>
        <div>
          <p class="font-semibold">Was bedeutet die Verdünnungsformel C1V1 = C2V2?</p>
          <p>Diese Formel besagt, dass die Stoffmenge (c × V) beim Verdünnen konstant bleibt. Man fügt nur Lösungsmittel hinzu, ohne mehr Substanz. Daher: Ausgangsmenge = Zielmenge.</p>
        </div>
        <div>
          <p class="font-semibold">Wie finde ich die Molmasse einer Verbindung?</p>
          <p>Die Molmasse wird aus dem Periodensystem berechnet, indem man die Atommassen aller Atome in der Formeleinheit addiert. Zum Beispiel: H₂O = 2×1,008 + 15,999 = 18,015 g/mol.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let molMode = 'conc';

    function calcMol() {
      const fmt = (v: number, dec = 4) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });
      const steps: string[] = [];

      if (molMode === 'conc') {
        const mass = parseFloat((document.getElementById('mol-mass') as HTMLInputElement).value) || 0;
        const mw = parseFloat((document.getElementById('mol-mw') as HTMLInputElement).value) || 1;
        const volMl = parseFloat((document.getElementById('mol-vol') as HTMLInputElement).value) || 1000;
        const volL = volMl / 1000;

        const moles = mass / mw;
        const molarity = moles / volL;

        steps.push(`n = m / M = ${fmt(mass)} g / ${fmt(mw)} g/mol = ${fmt(moles)} mol`);
        steps.push(`c = n / V = ${fmt(moles)} mol / ${fmt(volL)} L = ${fmt(molarity)} mol/L`);

        document.getElementById('mol-result-label')!.textContent = 'Molarität';
        document.getElementById('mol-result')!.textContent = fmt(molarity) + ' mol/L';
        document.getElementById('mol-sub1-label')!.textContent = 'Molanzahl';
        document.getElementById('mol-sub1')!.textContent = fmt(moles) + ' mol';
        document.getElementById('mol-sub2-label')!.textContent = 'Masse';
        document.getElementById('mol-sub2')!.textContent = fmt(mass) + ' g';
      } else {
        const c1 = parseFloat((document.getElementById('mol-c1') as HTMLInputElement).value) || 0;
        const v1ml = parseFloat((document.getElementById('mol-v1') as HTMLInputElement).value) || 0;
        const c2 = parseFloat((document.getElementById('mol-c2') as HTMLInputElement).value) || 0;

        if (c2 <= 0) { document.getElementById('mol-result')!.textContent = '—'; return; }
        const v2ml = (c1 * v1ml) / c2;

        steps.push(`C1 × V1 = C2 × V2`);
        steps.push(`${fmt(c1)} mol/L × ${fmt(v1ml, 1)} mL = ${fmt(c2)} mol/L × V2`);
        steps.push(`V2 = (${fmt(c1)} × ${fmt(v1ml, 1)}) / ${fmt(c2)} = ${fmt(v2ml, 1)} mL`);
        steps.push(`Zuzufügendes Volumen = ${fmt(v2ml - v1ml, 1)} mL Lösungsmittel`);

        document.getElementById('mol-result-label')!.textContent = 'Zielvolumen V2';
        document.getElementById('mol-result')!.textContent = fmt(v2ml, 1) + ' mL';
        document.getElementById('mol-sub1-label')!.textContent = 'Verdünnungsfaktor';
        document.getElementById('mol-sub1')!.textContent = fmt(c1 / c2, 1) + 'x';
        document.getElementById('mol-sub2-label')!.textContent = 'Lösungsmittel zufügen';
        document.getElementById('mol-sub2')!.textContent = fmt(v2ml - v1ml, 1) + ' mL';
      }

      document.getElementById('mol-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('mol-btn-conc')!.addEventListener('click', () => {
        molMode = 'conc';
        document.getElementById('mol-conc-mode')!.classList.remove('hidden');
        document.getElementById('mol-dil-mode')!.classList.add('hidden');
        document.getElementById('mol-btn-conc')!.className = 'mol-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer';
        document.getElementById('mol-btn-dil')!.className = 'mol-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer';
        calcMol();
      });
      document.getElementById('mol-btn-dil')!.addEventListener('click', () => {
        molMode = 'dil';
        document.getElementById('mol-dil-mode')!.classList.remove('hidden');
        document.getElementById('mol-conc-mode')!.classList.add('hidden');
        document.getElementById('mol-btn-dil')!.className = 'mol-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer';
        document.getElementById('mol-btn-conc')!.className = 'mol-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer';
        calcMol();
      });
      document.querySelectorAll('.mol-in').forEach(el => {
        el.addEventListener('input', calcMol);
        el.addEventListener('change', calcMol);
      });
      calcMol();
    }, 50);
  </script>
</CalculatorLayout>
