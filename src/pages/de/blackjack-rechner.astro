---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blackjack-Rechner - Basisstrategie & erwartete Rendite";
const description = "Erhalten Sie Basisstrategie-Empfehlungen basierend auf Ihrer Hand und der offenen Karte des Dealers. Berechnen Sie erwartete Rendite, Kartenzähl-Vorteil und optimale Spielentscheidungen.";
const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Wahrscheinlichkeiten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Statistik-Rechner", url: "/de/statistik-rechner", description: "Statistische Werkzeuge." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitte berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Blackjack-Rechner" lang="de" keywords="blackjack rechner, basisstrategie, kartenzählen, blackjack quoten, erwartete rendite, optimales spiel" breadcrumbs={[{ name: "Blackjack", url: "/de/blackjack-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blackjack-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erhalten Sie Basisstrategie-Empfehlungen und berechnen Sie die erwartete Rendite für Ihre Blackjack-Hand.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Anzahl der Decks</label>
          <select class="bj-in w-full px-4 py-2 border border-border rounded-xl" id="bj-decks">
            <option value="1">1 Deck</option>
            <option value="2">2 Decks</option>
            <option value="6" selected>6 Decks</option>
            <option value="8">8 Decks</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Ihre Karte 1</label>
            <select class="bj-in w-full px-4 py-2 border border-border rounded-xl" id="bj-c1">
              <option value="2">2</option><option value="3">3</option><option value="4">4</option>
              <option value="5">5</option><option value="6">6</option><option value="7">7</option>
              <option value="8">8</option><option value="9">9</option><option value="10" selected>10/B/D/K</option>
              <option value="11">Ass</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Ihre Karte 2</label>
            <select class="bj-in w-full px-4 py-2 border border-border rounded-xl" id="bj-c2">
              <option value="2">2</option><option value="3">3</option><option value="4">4</option>
              <option value="5">5</option><option value="6" selected>6</option><option value="7">7</option>
              <option value="8">8</option><option value="9">9</option><option value="10">10/B/D/K</option>
              <option value="11">Ass</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Offene Karte des Dealers</label>
          <select class="bj-in w-full px-4 py-2 border border-border rounded-xl" id="bj-dealer">
            <option value="2">2</option><option value="3">3</option><option value="4">4</option>
            <option value="5">5</option><option value="6" selected>6</option><option value="7">7</option>
            <option value="8">8</option><option value="9">9</option><option value="10">10/B/D/K</option>
            <option value="11">Ass</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Laufender Count (für Kartenzählen)</label>
          <input type="number" class="bj-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" id="bj-count" value="0" min="-30" max="30">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Aktion</div>
          <div class="text-4xl font-extrabold" id="bj-action">--</div>
          <div class="text-sm text-blue-200 mt-1" id="bj-hand">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Handwert</div>
            <div class="text-xl font-bold font-mono" id="bj-total">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Dealer-Bust-Wahrsch.</div>
            <div class="text-xl font-bold font-mono" id="bj-bust">--</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">True Count</div>
            <div class="text-xl font-bold font-mono" id="bj-truecount">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Spielervorteil</div>
            <div class="text-xl font-bold font-mono" id="bj-edge">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Strategie-Erklärung</h3>
          <div class="text-sm text-text-secondary" id="bj-explain"></div>
        </div>
      </div>
      <ShareButton calculatorId="blackjack" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Blackjack-Basisstrategie</h2>
      <p>Die Basisstrategie minimiert den Hausvorteil auf etwa 0,5 %. Sie gibt die optimale Aktion (Ziehen, Stehen, Verdoppeln, Teilen) basierend auf Ihrer Hand und der offenen Karte des Dealers an. Kartenzählen kann den Vorteil auf die Spielerseite verlagern, indem hohe und niedrige verbleibende Karten verfolgt werden.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBJ() {
      const c1 = parseInt((document.getElementById('bj-c1') as HTMLSelectElement).value);
      const c2 = parseInt((document.getElementById('bj-c2') as HTMLSelectElement).value);
      const dealer = parseInt((document.getElementById('bj-dealer') as HTMLSelectElement).value);
      const decks = parseInt((document.getElementById('bj-decks') as HTMLSelectElement).value);
      const runCount = parseInt((document.getElementById('bj-count') as HTMLInputElement).value) || 0;

      const isPair = c1 === c2;
      const hasAce = c1 === 11 || c2 === 11;
      let total = c1 + c2;
      const isSoft = hasAce && total <= 21;
      if (total > 21 && hasAce) total -= 10;

      let handType = '';
      if (isPair) handType = 'Paar ' + (c1 === 11 ? 'Asse' : c1 + 'er');
      else if (isSoft) handType = 'Soft ' + total;
      else handType = 'Hard ' + total;

      let action = 'Stehen';
      const d = dealer >= 11 ? 11 : dealer;

      if (isPair) {
        if (c1 === 11 || c1 === 8) action = 'Teilen';
        else if (c1 === 10) action = 'Stehen';
        else if (c1 === 9) action = (d === 7 || d >= 10) ? 'Stehen' : 'Teilen';
        else if (c1 === 7) action = d <= 7 ? 'Teilen' : 'Ziehen';
        else if (c1 === 6) action = d <= 6 ? 'Teilen' : 'Ziehen';
        else if (c1 === 5) action = d <= 9 ? 'Verdoppeln' : 'Ziehen';
        else if (c1 === 4) action = (d === 5 || d === 6) ? 'Teilen' : 'Ziehen';
        else if (c1 === 3 || c1 === 2) action = d <= 7 ? 'Teilen' : 'Ziehen';
      } else if (isSoft) {
        if (total >= 19) action = 'Stehen';
        else if (total === 18) {
          if (d >= 9) action = 'Ziehen';
          else if (d >= 3 && d <= 6) action = 'Verdoppeln';
          else action = 'Stehen';
        }
        else if (total === 17) action = (d >= 3 && d <= 6) ? 'Verdoppeln' : 'Ziehen';
        else if (total === 16 || total === 15) action = (d >= 4 && d <= 6) ? 'Verdoppeln' : 'Ziehen';
        else if (total === 14 || total === 13) action = (d === 5 || d === 6) ? 'Verdoppeln' : 'Ziehen';
        else action = 'Ziehen';
      } else {
        if (total >= 17) action = 'Stehen';
        else if (total >= 13 && total <= 16) action = d <= 6 ? 'Stehen' : 'Ziehen';
        else if (total === 12) action = (d >= 4 && d <= 6) ? 'Stehen' : 'Ziehen';
        else if (total === 11) action = 'Verdoppeln';
        else if (total === 10) action = d <= 9 ? 'Verdoppeln' : 'Ziehen';
        else if (total === 9) action = (d >= 3 && d <= 6) ? 'Verdoppeln' : 'Ziehen';
        else action = 'Ziehen';
      }

      const bustProbs: Record<number, number> = {
        2: 0.3536, 3: 0.3742, 4: 0.3944, 5: 0.4167, 6: 0.4210,
        7: 0.2613, 8: 0.2436, 9: 0.2259, 10: 0.2130, 11: 0.1152
      };
      const bustP = bustProbs[d] || 0.2;

      const remainingDecks = Math.max(1, decks - 1);
      const trueCount = runCount / remainingDecks;
      const baseEdge = -0.005;
      const edge = baseEdge + (trueCount * 0.005);

      document.getElementById('bj-action')!.textContent = action;
      document.getElementById('bj-hand')!.textContent = handType + ' vs Dealer ' + (dealer === 11 ? 'Ass' : dealer);
      document.getElementById('bj-total')!.textContent = total + (isSoft ? ' (soft)' : '');
      document.getElementById('bj-bust')!.textContent = (bustP * 100).toFixed(1) + '%';
      document.getElementById('bj-truecount')!.textContent = trueCount.toFixed(1);
      document.getElementById('bj-edge')!.textContent = (edge * 100).toFixed(2) + '%';

      let explain = '';
      if (action === 'Ziehen') explain = 'Ihr Wert ist schwach; nehmen Sie eine weitere Karte.';
      else if (action === 'Stehen') explain = 'Ihre Hand ist stark genug; lassen Sie den Dealer das Risiko tragen.';
      else if (action === 'Verdoppeln') explain = 'Günstige Situation; verdoppeln Sie Ihren Einsatz und nehmen Sie eine Karte.';
      else if (action === 'Teilen') explain = 'Teilen gibt Ihnen zwei bessere Starthände.';
      if (trueCount >= 2) explain += ' True Count ist positiv -- das Deck begünstigt den Spieler.';
      else if (trueCount <= -2) explain += ' True Count ist negativ -- das Deck begünstigt die Bank.';
      document.getElementById('bj-explain')!.textContent = explain;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bj-in').forEach(el => { el.addEventListener('input', calcBJ); el.addEventListener('change', calcBJ); });
      calcBJ();
    }, 50);
  </script>
</CalculatorLayout>
