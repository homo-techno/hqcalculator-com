---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Stoff-Rechner - Meterbedarf & Kosten";
const description = "Berechnen Sie den Stoffbedarf in Metern für Ihre Nähprojekte basierend auf Projekttyp, Maßen und Stoffbreite.";
const relatedCalcs = [
  { name: "Stoffschrumpfung", url: "/de/stoffschrumpfung-rechner", description: "Einlaufberechnung." },
  { name: "Stoffbreite-Rechner", url: "/de/stoffbreite-rechner", description: "Schnittmuster-Layout." },
  { name: "Zaun-Rechner", url: "/de/zaun-rechner", description: "Zaun-Materialschätzung." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Stoff-Rechner" lang="de" enSlug="fabric-calculator" keywords="stoff rechner, meterware berechnen, nährechner, stoffbedarf, stoffkosten" breadcrumbs={[{ name: "Stoff-Rechner", url: "/de/stoff-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stoff-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Stoffbedarf und die Kosten für Ihre Nähprojekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Projektlänge (cm)</label><input type="number" id="sfde-len" class="sfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="180" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Projektbreite (cm)</label><input type="number" id="sfde-wid" class="sfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Stoffbreite</label>
            <select id="sfde-fw" class="sfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="90">90 cm</option>
              <option value="110" selected>110 cm</option>
              <option value="140">140 cm</option>
              <option value="150">150 cm</option>
              <option value="160">160 cm</option>
              <option value="280">280 cm</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Meter (&euro;)</label><input type="number" id="sfde-price" class="sfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stückzahl</label><input type="number" id="sfde-qty" class="sfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nahtzugabe (cm)</label><input type="number" id="sfde-seam" class="sfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" min="0" max="5" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Stoffbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="sfde-result">0 m</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold font-mono" id="sfde-cost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Yards</div><div class="text-xl font-bold font-mono" id="sfde-yd">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">m&sup2;</div><div class="text-xl font-bold font-mono" id="sfde-sqm">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fabric-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Stoffbedarf berechnen</h2>
      <p>Die benötigte Stoffmenge hängt von Projektmaßen, Stoffbreite und Nahtzugabe ab. Der Rechner berücksichtigt, wie viele Bahnen nebeneinander auf die Stoffbreite passen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Stoff brauche ich für ein Kleid?</strong> Das hängt von Schnitt und Größe ab. Ein einfaches Kleid benötigt typischerweise 2-3 Meter bei 140 cm Stoffbreite.</p>
      <p><strong>Soll ich Verschnitt einplanen?</strong> Ja, rechnen Sie 10-15% Mehrbedarf für Musterausrichtung und Verschnitt ein.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcSFDE() {
      const len = parseFloat((document.getElementById('sfde-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('sfde-wid') as HTMLInputElement).value) || 0;
      const fw = parseFloat((document.getElementById('sfde-fw') as HTMLSelectElement).value) || 110;
      const price = parseFloat((document.getElementById('sfde-price') as HTMLInputElement).value) || 0;
      const qty = parseInt((document.getElementById('sfde-qty') as HTMLInputElement).value) || 1;
      const seam = parseFloat((document.getElementById('sfde-seam') as HTMLInputElement).value) || 0;
      const adjLen = len + seam * 2;
      const adjWid = wid + seam * 2;
      const panels = Math.ceil(adjWid / fw);
      const totalCm = adjLen * panels * qty;
      const meters = totalCm / 100;
      const ceilMeters = Math.ceil(meters * 10) / 10;
      const cost = ceilMeters * price;
      const yards = ceilMeters * 1.09361;
      const sqm = (ceilMeters * fw) / 100;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('sfde-result')!.textContent = fmt(ceilMeters) + ' m';
      document.getElementById('sfde-cost')!.textContent = fmt(cost) + ' \u20AC';
      document.getElementById('sfde-yd')!.textContent = fmt(yards);
      document.getElementById('sfde-sqm')!.textContent = fmt(sqm);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sfde-in').forEach(el => { el.addEventListener('input', calcSFDE); el.addEventListener('change', calcSFDE); });
      calcSFDE();
    }, 50);
  </script>
</CalculatorLayout>
