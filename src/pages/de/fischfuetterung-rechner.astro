---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fischf&uuml;tterung-Rechner - Menge & H&auml;ufigkeit nach Art";
const description = "Berechnen Sie die richtige Futtermenge und H&auml;ufigkeit f&uuml;r Ihre Aquarienfische basierend auf Anzahl, Gr&ouml;&szlig;e und Futterart.";
const relatedCalcs = [
  { name: "Fischvertr&auml;glichkeit", url: "/de/fischvertraeglichkeit-rechner", description: "Artvertr&auml;glichkeit." },
  { name: "Aquarium-Besatz", url: "/de/aquarium-besatz-rechner", description: "Besatzdichte." },
  { name: "Zuchtbecken", url: "/de/zuchtbecken-rechner", description: "Zuchtbecken planen." },
  { name: "Aquarium-Kosten", url: "/de/aquarium-kosten-rechner", description: "Aquarium-Kosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fischf&uuml;tterung-Rechner" lang="de" enSlug="fish-feeding-calculator" keywords="Fischf&uuml;tterung Rechner, Futtermenge Fisch, Aquarium F&uuml;tterung, Fischfutter Menge, F&uuml;tterungsplan" breadcrumbs={[{ name: "Fischf&uuml;tterung", url: "/de/fischfuetterung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fischf&uuml;tterung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die korrekte Futtermenge und H&auml;ufigkeit, um Ihre Fische gesund zu halten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Fische</label><input type="number" id="ffr-count" class="ffr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Durchschn. Gr&ouml;&szlig;e (cm)</label><input type="number" id="ffr-size" class="ffr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="60" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Fischkategorie</label>
          <select id="ffr-cat" class="ffr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="community" selected>Gesellschaft (Salmler, Barben)</option>
            <option value="cichlid">Buntbarsche</option>
            <option value="goldfish">Goldfische / Koi</option>
            <option value="betta">Kampffische</option>
            <option value="catfish">Welse / Bodenfische</option>
            <option value="marine">Meerwasserfische</option>
            <option value="fry">Jungfische</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Futterart</label>
          <select id="ffr-food" class="ffr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="flake" selected>Flockenfutter</option>
            <option value="pellet">Granulat / Pellets</option>
            <option value="frozen">Frostfutter (Artemia, Rote M&uuml;ckenlarven)</option>
            <option value="wafer">Futtertabletten / Bodenfutter</option>
            <option value="live">Lebendfutter</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Futtermenge pro Mahlzeit</div>
          <div class="text-5xl font-extrabold font-mono" id="ffr-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mahlzeiten/Tag</div><div class="text-xl font-bold font-mono" id="ffr-meals">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tagesmenge</div><div class="text-xl font-bold font-mono" id="ffr-daily">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatsverbrauch</div><div class="text-xl font-bold font-mono" id="ffr-monthly">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fastentag</div><div class="text-xl font-bold font-mono" id="ffr-fast">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fish-feeding" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie oft sollte man Fische f&uuml;ttern?</strong> Die meisten Aquarienfische werden 2x t&auml;glich gef&uuml;ttert. Jungfische ben&ouml;tigen 3-4 Mahlzeiten.</p>
      <p><strong>Warum ist &Uuml;berf&uuml;tterung sch&auml;dlich?</strong> &Uuml;bersch&uuml;ssiges Futter verschlechtert die Wasserqualit&auml;t und kann Krankheiten verursachen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFFR() {
      const count = parseFloat((document.getElementById('ffr-count') as HTMLInputElement).value) || 0;
      const size = parseFloat((document.getElementById('ffr-size') as HTMLInputElement).value) || 1;
      const cat = (document.getElementById('ffr-cat') as HTMLSelectElement).value;
      const food = (document.getElementById('ffr-food') as HTMLSelectElement).value;
      const fishWeightG = 0.01 * Math.pow(size, 3);
      const totalBiomass = fishWeightG * count;
      const feedPct: Record<string, number> = {
        community: 0.025, cichlid: 0.03, goldfish: 0.02, betta: 0.025,
        catfish: 0.02, marine: 0.025, fry: 0.05
      };
      const pct = feedPct[cat] || 0.025;
      const dailyG = totalBiomass * pct;
      const mealsPerDay: Record<string, number> = {
        community: 2, cichlid: 2, goldfish: 2, betta: 2, catfish: 1, marine: 2, fry: 4
      };
      const meals = mealsPerDay[cat] || 2;
      const perMealG = dailyG / meals;
      let mealStr = '';
      let dailyStr = '';
      if (food === 'flake') {
        const prisen = Math.max(1, Math.round(perMealG / 0.5));
        mealStr = prisen + ' Prise' + (prisen > 1 ? 'n' : '');
        dailyStr = (prisen * meals) + ' Prisen';
      } else if (food === 'pellet') {
        const pellets = Math.max(count, Math.round(perMealG / 0.05));
        mealStr = pellets + ' Pellets';
        dailyStr = (pellets * meals) + ' Pellets';
      } else if (food === 'frozen') {
        const cubes = Math.max(0.5, Math.round(perMealG / 5 * 2) / 2);
        mealStr = cubes + ' W\u00fcrfel';
        dailyStr = (cubes * meals) + ' W\u00fcrfel';
      } else if (food === 'wafer') {
        const wafers = Math.max(1, Math.round(perMealG / 3));
        mealStr = wafers + ' Tablette' + (wafers > 1 ? 'n' : '');
        dailyStr = (wafers * meals) + ' Tabletten';
      } else {
        mealStr = perMealG.toFixed(1).replace('.', ',') + ' g';
        dailyStr = dailyG.toFixed(1).replace('.', ',') + ' g';
      }
      const monthlyG = (dailyG * 30).toFixed(0);
      const fastRec: Record<string, string> = {
        community: '1x pro Woche', cichlid: '1x pro Woche', goldfish: '1x pro Woche',
        betta: '1x pro Woche', catfish: 'Nicht n\u00f6tig', marine: '1x pro Woche', fry: 'Nie'
      };
      document.getElementById('ffr-result')!.textContent = mealStr;
      document.getElementById('ffr-meals')!.textContent = meals + 'x t\u00e4glich';
      document.getElementById('ffr-daily')!.textContent = dailyStr;
      document.getElementById('ffr-monthly')!.textContent = monthlyG + ' g';
      document.getElementById('ffr-fast')!.textContent = fastRec[cat] || '1x pro Woche';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ffr-in').forEach(el => { el.addEventListener('input', calcFFR); el.addEventListener('change', calcFFR); });
      calcFFR();
    }, 50);
  </script>
</CalculatorLayout>
