---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Batteriespeicher-Rechner - Heimspeicher-Dimensionierung für Solar";
const description = "Berechnen Sie die richtige Heimspeicher-Kapazität (kWh) für Solarbackup basierend auf Ihrem täglichen Verbrauch, Solarproduktion und Backup-Dauer.";
const relatedCalcs = [
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Bootskredit-Rechner", url: "/de/bootskredit-rechner", description: "Kreditberechnung." },
  { name: "Zahnspange-Kosten-Rechner", url: "/de/zahnspange-kosten-rechner", description: "Kosten-Vergleich." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Batteriespeicher-Rechner" enSlug="battery-storage-calculator" keywords="Batteriespeicher Rechner, Heimspeicher Dimensionierung, Solar Batterie kWh, Backup Strom Rechner, Stromspeicher" breadcrumbs={[{ name: "Batteriespeicher-Rechner", url: "/de/batteriespeicher-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Batteriespeicher-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Dimensionieren Sie Ihren Heimspeicher für Solarbackup und Energieunabhängigkeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Tägliches Energieprofil</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tagesverbrauch (kWh)</label><input type="number" id="bsp-daily" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="5" max="200" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Abendverbrauch (%)</label><input type="number" id="bsp-evening" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="20" max="90" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Solarproduktion (kWh/Tag)</label><input type="number" id="bsp-solar" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="32" min="0" max="200" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Eigenverbrauch (%)</label><input type="number" id="bsp-self" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="10" max="90" step="5"></div>
        </div>
        <h3 class="font-semibold text-text">Batterie-Spezifikationen</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Entladetiefe (%)</label><input type="number" id="bsp-dod" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" min="50" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wirkungsgrad (%)</label><input type="number" id="bsp-rte" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" min="70" max="98" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Backup-Dauer (Stunden)</label><input type="number" id="bsp-backup" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="1" max="72" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Batteriekosten (€/kWh)</label><input type="number" id="bsp-cost" class="bsp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="100" max="2000" step="50"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Batteriegröße</div>
          <div class="text-4xl font-extrabold" id="bsp-size">0</div>
          <div class="text-sm text-blue-200 mt-1">kWh (nutzbar)</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nennkapazität</div><div class="text-xl font-bold" id="bsp-nominal">0 kWh</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Geschätzte Kosten</div><div class="text-xl font-bold" id="bsp-estcost">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Überschuss-Solar gespeichert</div><div class="text-xl font-bold" id="bsp-stored">0 kWh/Tag</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Backup-Kapazität</div><div class="text-xl font-bold" id="bsp-backupcap">0 Stunden</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="batteriespeicher" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Heimspeicher richtig dimensionieren</h2>
      <p>Heimspeicher speichern überschüssige Solarenergie für abends und nachts oder bei Netzausfällen. Wichtige Faktoren sind der Abend-/Nachtverbrauch (typisch 50-70% des Gesamtverbrauchs), Entladetiefe (DoD, meist 80-100% für Lithium) und Wirkungsgrad (85-95%). Ein typischer Haushalt in Deutschland benötigt 5-15 kWh nutzbaren Speicher.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie groß sollte mein Speicher sein?</strong> Als Faustregel: Der Speicher sollte mindestens den Abend- und Nachtverbrauch abdecken können.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBSP() {
      const daily = parseFloat((document.getElementById('bsp-daily') as HTMLInputElement).value) || 30;
      const evening = parseFloat((document.getElementById('bsp-evening') as HTMLInputElement).value) || 60;
      const solar = parseFloat((document.getElementById('bsp-solar') as HTMLInputElement).value) || 32;
      const selfPct = parseFloat((document.getElementById('bsp-self') as HTMLInputElement).value) || 40;
      const dod = parseFloat((document.getElementById('bsp-dod') as HTMLInputElement).value) || 90;
      const rte = parseFloat((document.getElementById('bsp-rte') as HTMLInputElement).value) || 90;
      const backup = parseFloat((document.getElementById('bsp-backup') as HTMLInputElement).value) || 12;
      const costPerKwh = parseFloat((document.getElementById('bsp-cost') as HTMLInputElement).value) || 500;
      const eveningUsage = daily * (evening / 100);
      const excessSolar = solar * (1 - selfPct / 100);
      const storageNeeded = Math.min(eveningUsage, excessSolar) / (rte / 100);
      const backupNeeded = (daily / 24) * backup / (rte / 100);
      const usableKwh = Math.max(storageNeeded, backupNeeded);
      const nominalKwh = usableKwh / (dod / 100);
      const estCost = nominalKwh * costPerKwh;
      const backupHours = usableKwh > 0 ? usableKwh * (rte / 100) / (daily / 24) : 0;
      document.getElementById('bsp-size')!.textContent = usableKwh.toFixed(1);
      document.getElementById('bsp-nominal')!.textContent = nominalKwh.toFixed(1) + ' kWh';
      document.getElementById('bsp-estcost')!.textContent = Math.round(estCost).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('bsp-stored')!.textContent = excessSolar.toFixed(1) + ' kWh/Tag';
      document.getElementById('bsp-backupcap')!.textContent = backupHours.toFixed(1) + ' Stunden';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.bsp-in').forEach(el => { el.addEventListener('input', calcBSP); el.addEventListener('change', calcBSP); }); calcBSP(); }, 50);
  </script>
</CalculatorLayout>
