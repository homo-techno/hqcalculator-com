---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Anzahlung-Rechner - Eigenkapital & Sparplan 2026";
const description = "Berechne deine Anzahlung fuer den Immobilienkauf, den monatlichen Sparbetrag und sieh, wie verschiedene Eigenkapitalquoten deine Hypothek beeinflussen.";

const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothekenzinsen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
  { name: "Investitionsrechner", url: "/de/investitionsrechner", description: "Rendite." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Anzahlung-Rechner" keywords="Anzahlung Rechner, Eigenkapital Immobilie, Sparziel Hauskauf, Hypothek Anzahlung, Eigenkapitalquote" breadcrumbs={[{ name: "Anzahlung-Rechner", url: "/de/anzahlung-rechner" }]} lang="de" enSlug="down-payment-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Anzahlung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Plane dein Eigenkapital fuer den Immobilienkauf und sieh die Auswirkung auf deine monatliche Rate.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="space-y-4 mb-6">
            <div>
              <label class="block text-sm font-medium text-text mb-1">Kaufpreis</label>
              <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
                <input type="number" id="azde-price" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="350000" min="0" step="10000">
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-1">Eigenkapitalquote (%)</label>
              <input type="range" id="azde-pct-slider" class="w-full" min="0" max="50" step="1" value="20">
              <div class="flex justify-between text-xs text-text-muted mt-1">
                <span>0%</span>
                <span class="font-bold text-primary" id="azde-pct-display">20%</span>
                <span>50%</span>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div><label class="block text-xs font-medium text-text mb-1">Hypothekenzins (%)</label><input type="number" id="azde-rate" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="3.5" min="0" max="20" step="0.1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Jahre)</label><input type="number" id="azde-term" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="25" min="1" max="40"></div>
            </div>
          </div>
          <h3 class="font-semibold text-text mb-3">Sparplan</h3>
          <div class="p-4 bg-surface-alt rounded-xl space-y-3">
            <div><label class="block text-xs font-medium text-text mb-1">Bereits gespart</label>
              <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span><input type="number" id="azde-saved" class="w-full pl-7 pr-3 py-2 border border-border rounded-lg" value="30000" min="0" step="500"></div>
            </div>
            <div><label class="block text-xs font-medium text-text mb-1">Monatliche Sparsumme</label>
              <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span><input type="number" id="azde-monthly" class="w-full pl-7 pr-3 py-2 border border-border rounded-lg" value="1500" min="0" step="100"></div>
            </div>
          </div>
          <div class="flex gap-2 mt-4 flex-wrap">
            <button class="azde-quick px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt font-semibold" data-pct="10">10%</button>
            <button class="azde-quick px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt font-semibold" data-pct="15">15%</button>
            <button class="azde-quick px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt font-semibold" data-pct="20">20%</button>
            <button class="azde-quick px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt font-semibold" data-pct="25">25%</button>
            <button class="azde-quick px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt font-semibold" data-pct="30">30%</button>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Eigenkapital</div>
            <div class="text-4xl font-extrabold" id="azde-amount">0 &euro;</div>
            <div class="text-sm text-blue-200 mt-1" id="azde-pct-text">20% von 350.000 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Darlehensbetrag</div><div class="text-xl font-bold" id="azde-loan">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Rate</div><div class="text-xl font-bold text-secondary" id="azde-payment">0 &euro;</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Nebenkosten (ca. 10-15%)</div>
            <div class="text-xl font-bold" id="azde-extra">0 &euro;</div>
            <div class="text-xs text-text-muted mt-1">Grunderwerbsteuer, Notar, Makler</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Spardauer bis zum Ziel</div>
            <div class="text-2xl font-bold" id="azde-time">0 Monate</div>
            <div class="text-xs text-text-muted mt-1" id="azde-remaining">0 &euro; verbleibend</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Eigenkapital-Vergleich</h3>
            <div class="space-y-1 text-sm" id="azde-comparison"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="down-payment" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Eigenkapital beim Immobilienkauf</h2>
      <p>In Deutschland empfehlen Experten mindestens 20 % Eigenkapital plus die Kaufnebenkosten (ca. 10-15 % des Kaufpreises). Je mehr Eigenkapital, desto bessere Zinskonditionen bieten Banken.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie viel Eigenkapital brauche ich?</strong> Idealerweise 20-30 % des Kaufpreises plus Nebenkosten. Manche Banken finanzieren auch mit weniger Eigenkapital, verlangen dann aber hoehere Zinsen.</p>
      <p><strong>Was sind die Kaufnebenkosten?</strong> Grunderwerbsteuer (3,5-6,5 % je Bundesland), Notar- und Grundbuchkosten (~2 %), Maklerprovision (3-7 %).</p>
      <p><strong>Lohnt sich mehr Eigenkapital?</strong> Ja, denn mit mehr Eigenkapital sinkt der Zinssatz oft um 0,1-0,5 Prozentpunkte, was ueber die Laufzeit Tausende Euro spart.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const azdeFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcAZDE() {
      const price = parseFloat((document.getElementById('azde-price') as HTMLInputElement).value) || 0;
      const pct = parseFloat((document.getElementById('azde-pct-slider') as HTMLInputElement).value) || 0;
      const rate = (parseFloat((document.getElementById('azde-rate') as HTMLInputElement).value) || 0) / 100;
      const term = parseInt((document.getElementById('azde-term') as HTMLInputElement).value) || 25;
      const saved = parseFloat((document.getElementById('azde-saved') as HTMLInputElement).value) || 0;
      const monthly = parseFloat((document.getElementById('azde-monthly') as HTMLInputElement).value) || 0;

      const downPayment = price * pct / 100;
      const loan = price - downPayment;
      const monthlyRate = rate / 12;
      const totalPayments = term * 12;
      const payment = monthlyRate > 0
        ? loan * monthlyRate * Math.pow(1 + monthlyRate, totalPayments) / (Math.pow(1 + monthlyRate, totalPayments) - 1)
        : loan / totalPayments;

      const extraCosts = price * 0.12;
      const totalNeeded = downPayment + extraCosts;
      const remaining = Math.max(0, totalNeeded - saved);
      const monthsToSave = monthly > 0 ? Math.ceil(remaining / monthly) : remaining > 0 ? Infinity : 0;

      document.getElementById('azde-pct-display')!.textContent = pct + '%';
      document.getElementById('azde-amount')!.textContent = azdeFmt(downPayment);
      document.getElementById('azde-pct-text')!.textContent = pct + '% von ' + azdeFmt(price);
      document.getElementById('azde-loan')!.textContent = azdeFmt(loan);
      document.getElementById('azde-payment')!.textContent = azdeFmt(payment);
      document.getElementById('azde-extra')!.textContent = '~' + azdeFmt(extraCosts);
      document.getElementById('azde-remaining')!.textContent = azdeFmt(remaining) + ' verbleibend (inkl. Nebenkosten)';

      if (monthsToSave === Infinity) {
        document.getElementById('azde-time')!.textContent = 'Sparbetrag festlegen';
      } else if (monthsToSave === 0) {
        document.getElementById('azde-time')!.textContent = 'Bereits gespart!';
      } else {
        const yrs = Math.floor(monthsToSave / 12);
        const mos = monthsToSave % 12;
        document.getElementById('azde-time')!.textContent = yrs > 0 ? yrs + ' J. ' + mos + ' M.' : mos + ' Monate';
      }

      const comparisons = [10, 15, 20, 25, 30];
      document.getElementById('azde-comparison')!.innerHTML =
        '<div class="grid grid-cols-3 gap-2 font-semibold text-xs text-text-muted mb-2"><span>EK-Quote</span><span>Betrag</span><span>Rate/Monat</span></div>' +
        comparisons.map(p => {
          const dp = price * p / 100;
          const ln = price - dp;
          const mp = monthlyRate > 0 ? ln * monthlyRate * Math.pow(1 + monthlyRate, totalPayments) / (Math.pow(1 + monthlyRate, totalPayments) - 1) : ln / totalPayments;
          const isCurrent = p === pct;
          return '<div class="grid grid-cols-3 gap-2 text-xs ' + (isCurrent ? 'font-bold text-primary' : '') + '"><span>' + p + '%</span><span>' + azdeFmt(dp) + '</span><span>' + azdeFmt(mp) + '</span></div>';
        }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['azde-price', 'azde-rate', 'azde-term', 'azde-saved', 'azde-monthly'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcAZDE);
      });
      document.getElementById('azde-pct-slider')!.addEventListener('input', calcAZDE);
      document.querySelectorAll('.azde-quick').forEach(btn => {
        btn.addEventListener('click', () => {
          (document.getElementById('azde-pct-slider') as HTMLInputElement).value = (btn as HTMLElement).dataset.pct || '20';
          calcAZDE();
        });
      });
      calcAZDE();
    }, 50);
  </script>
</CalculatorLayout>
