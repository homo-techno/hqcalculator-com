---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Volumetrisches-Gewicht-Rechner - DHL, DPD, UPS";
const description = "Berechnen Sie das volumetrische Gewicht aus Paketma\u00dfen f\u00fcr DHL, DPD und UPS. Vergleichen Sie das abrechnungsrelevante Gewicht bei verschiedenen Paketdiensten.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen." },
  { name: "Rabatt-Rechner", url: "/de/rabatt-rechner", description: "Rabatte berechnen." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budgetplanung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Volumetrisches-Gewicht-Rechner" lang="de" enSlug="dimensional-weight-calculator" keywords="volumetrisches gewicht, dim gewicht, dhl, dpd, ups, abrechnungsgewicht, versandgewicht" breadcrumbs={[{ name: "Volumetrisches-Gewicht-Rechner", url: "/de/volumetrisches-gewicht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Volumetrisches-Gewicht-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das volumetrische Gewicht f&uuml;r DHL, DPD und UPS und vergleichen Sie das Abrechnungsgewicht.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Tats&auml;chliches Gewicht (kg)</label><input type="number" id="vgr-weight" class="vgr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0.1" step="0.1"></div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">L&auml;nge (cm)</label><input type="number" id="vgr-length" class="vgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="vgr-width" class="vgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">H&ouml;he (cm)</label><input type="number" id="vgr-height" class="vgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Volumetrisches Gewicht (DHL)</div>
          <div class="text-5xl font-extrabold font-mono" id="vgr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">DHL Abrechn.</div><div class="text-xl font-bold font-mono" id="vgr-dhl">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">DPD Abrechn.</div><div class="text-xl font-bold font-mono" id="vgr-dpd">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">UPS Abrechn.</div><div class="text-xl font-bold font-mono" id="vgr-ups">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen (cm&sup3;)</div><div class="text-xl font-bold font-mono" id="vgr-cubic">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bester Anbieter</div><div class="text-xl font-bold font-mono" id="vgr-best">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dimensional-weight-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Volumetrisches Gewicht beim Versand</h2>
      <p>Paketdienste berechnen entweder das tats&auml;chliche oder das volumetrische Gewicht &ndash; je nachdem, welches h&ouml;her ist. Der Divisor betr&auml;gt typischerweise 5.000 (DHL/DPD) bzw. 5.000 (UPS) f&uuml;r cm/kg.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Volumenfaktor?</strong> L &times; B &times; H (cm) / 5.000 = Volumetrisches Gewicht in kg. Bei gr&ouml;&szlig;eren, leichten Paketen &uuml;bersteigt das Volumengewicht das reale Gewicht.</p>
      <p><strong>Wie spare ich Versandkosten?</strong> Verwenden Sie m&ouml;glichst kleine Verpackungen und f&uuml;llen Sie leeren Raum nicht unn&ouml;tig auf.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcVGR() {
      const weight = parseFloat((document.getElementById('vgr-weight') as HTMLInputElement).value) || 0;
      const length = parseFloat((document.getElementById('vgr-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('vgr-width') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('vgr-height') as HTMLInputElement).value) || 0;

      const cubicCM = length * width * height;
      const dimDHL = Math.ceil(cubicCM / 5000 * 10) / 10;
      const dimDPD = Math.ceil(cubicCM / 5000 * 10) / 10;
      const dimUPS = Math.ceil(cubicCM / 5000 * 10) / 10;

      const billDHL = Math.max(weight, dimDHL);
      const billDPD = Math.max(weight, dimDPD);
      const billUPS = Math.max(weight, dimUPS);

      const minBillable = Math.min(billDHL, billDPD, billUPS);
      let bestCarrier = 'DHL';
      if (minBillable === billDPD) bestCarrier = 'DPD';
      else if (minBillable === billUPS) bestCarrier = 'UPS';

      const fmtKg = (n: number) => n.toFixed(1).replace('.', ',') + ' kg';

      document.getElementById('vgr-result')!.textContent = fmtKg(dimDHL);
      document.getElementById('vgr-dhl')!.textContent = fmtKg(billDHL);
      document.getElementById('vgr-dpd')!.textContent = fmtKg(billDPD);
      document.getElementById('vgr-ups')!.textContent = fmtKg(billUPS);
      document.getElementById('vgr-cubic')!.textContent = cubicCM.toLocaleString('de-DE', {maximumFractionDigits: 0}) + ' cm\u00B3';
      document.getElementById('vgr-best')!.textContent = bestCarrier;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('vgr-weight') as HTMLInputElement).value = '3';
      (document.getElementById('vgr-length') as HTMLInputElement).value = '45';
      (document.getElementById('vgr-width') as HTMLInputElement).value = '35';
      (document.getElementById('vgr-height') as HTMLInputElement).value = '30';
      document.querySelectorAll('.vgr-in').forEach(el => { el.addEventListener('input', calcVGR); el.addEventListener('change', calcVGR); });
      calcVGR();
    }, 50);
  </script>
</CalculatorLayout>
