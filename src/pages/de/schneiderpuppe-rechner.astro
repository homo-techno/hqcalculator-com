---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schneiderpuppe-Rechner - Polsterung & Anpassung 2026";
const description = "Berechne die Polsterungsmengen fuer deine Schneiderpuppe anhand der Differenz zwischen Koerpermassen und Puppenmassen an den wichtigsten Messpunkten.";

const relatedCalcs = [
  { name: "Stoff-Rechner", url: "/de/stoff-rechner", description: "Stoffbedarf berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Laengenumrechner", url: "/de/laengenumrechner", description: "Laengenumrechnung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Schneiderpuppe-Rechner" keywords="Schneiderpuppe Rechner, Schneiderpuppe Polsterung, Anpassung, Koerpermasse, Schneiderpuppe Groesse, Polsterungsmenge" breadcrumbs={[{ name: "Schneiderpuppe", url: "/de/schneiderpuppe-rechner" }]} lang="de" enSlug="dress-form-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schneiderpuppe-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne die benoetigte Polsterung, um deine Schneiderpuppe an deine Koerpermasse anzupassen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <p class="text-xs text-text-muted font-medium">Gib deine Koerpermasse und Schneiderpuppen-Masse ein (alle in cm):</p>
        <div class="grid grid-cols-3 gap-3">
          <div class="text-xs font-bold text-text-muted pt-8">Messung</div>
          <div class="text-xs font-bold text-text-muted text-center">Dein Koerper</div>
          <div class="text-xs font-bold text-text-muted text-center">Schneiderpuppe</div>
        </div>
        <div class="grid grid-cols-3 gap-3 items-center">
          <div class="text-sm font-medium text-text">Brust</div>
          <div><input type="number" id="spde2-bbust" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="92" min="60" max="150" step="0.5"></div>
          <div><input type="number" id="spde2-fbust" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="88" min="60" max="150" step="0.5"></div>
        </div>
        <div class="grid grid-cols-3 gap-3 items-center">
          <div class="text-sm font-medium text-text">Taille</div>
          <div><input type="number" id="spde2-bwaist" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="72" min="50" max="130" step="0.5"></div>
          <div><input type="number" id="spde2-fwaist" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="68" min="50" max="130" step="0.5"></div>
        </div>
        <div class="grid grid-cols-3 gap-3 items-center">
          <div class="text-sm font-medium text-text">Huefte</div>
          <div><input type="number" id="spde2-bhip" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="98" min="60" max="150" step="0.5"></div>
          <div><input type="number" id="spde2-fhip" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="92" min="60" max="150" step="0.5"></div>
        </div>
        <div class="grid grid-cols-3 gap-3 items-center">
          <div class="text-sm font-medium text-text">Schulter</div>
          <div><input type="number" id="spde2-bshould" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="39" min="25" max="55" step="0.5"></div>
          <div><input type="number" id="spde2-fshould" class="spde2-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="37" min="25" max="55" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Maximale Polsterung noetig</div>
          <div class="text-4xl font-extrabold font-mono" id="spde2-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Brust-Polsterung</div><div class="text-xl font-bold font-mono" id="spde2-pbust">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Taillen-Polsterung</div><div class="text-xl font-bold font-mono" id="spde2-pwaist">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hueft-Polsterung</div><div class="text-xl font-bold font-mono" id="spde2-phip">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schulter-Polsterung</div><div class="text-xl font-bold font-mono" id="spde2-pshould">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wattierungslagen (ca. 6 mm pro Lage)</div><div class="text-xl font-bold font-mono" id="spde2-layers">--</div></div>
      </div>
      <ShareButton calculatorId="dress-form" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Schneiderpuppe anpassen</h2>
      <p>Eine gut angepasste Schneiderpuppe ist entscheidend fuer praezise Passformarbeit. Die Polsterung mit Wattierung gleicht Unterschiede zwischen Puppe und Koerper aus.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Welches Material eignet sich zum Polstern?</strong> Quilt-Wattierung (Volumenvlies) ist ideal. Jede Lage fuegt ca. 6 mm Dicke bzw. ca. 4 cm Umfang hinzu.</p>
      <p><strong>Wie befestige ich die Polsterung?</strong> Wickle die Wattierung um die Puppe und fixiere sie mit Stoffstreifen oder einem enganliegenden T-Shirt darueber.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSPDE2() {
      const bBust = parseFloat((document.getElementById('spde2-bbust') as HTMLInputElement).value) || 92;
      const fBust = parseFloat((document.getElementById('spde2-fbust') as HTMLInputElement).value) || 88;
      const bWaist = parseFloat((document.getElementById('spde2-bwaist') as HTMLInputElement).value) || 72;
      const fWaist = parseFloat((document.getElementById('spde2-fwaist') as HTMLInputElement).value) || 68;
      const bHip = parseFloat((document.getElementById('spde2-bhip') as HTMLInputElement).value) || 98;
      const fHip = parseFloat((document.getElementById('spde2-fhip') as HTMLInputElement).value) || 92;
      const bShould = parseFloat((document.getElementById('spde2-bshould') as HTMLInputElement).value) || 39;
      const fShould = parseFloat((document.getElementById('spde2-fshould') as HTMLInputElement).value) || 37;

      const bustDiff = bBust - fBust;
      const waistDiff = bWaist - fWaist;
      const hipDiff = bHip - fHip;
      const shouldDiff = bShould - fShould;

      const bustThick = Math.max(0, bustDiff / Math.PI / 2);
      const waistThick = Math.max(0, waistDiff / Math.PI / 2);
      const hipThick = Math.max(0, hipDiff / Math.PI / 2);

      const maxPad = Math.max(bustDiff, waistDiff, hipDiff);

      const bustLayers = Math.ceil(bustThick / 0.6);
      const waistLayers = Math.ceil(waistThick / 0.6);
      const hipLayers = Math.ceil(hipThick / 0.6);

      const formatPad = (diff: number, thick: number) => {
        if (diff <= 0) return 'Nicht noetig';
        return '+' + diff.toFixed(1).replace('.', ',') + ' cm Umfang (' + thick.toFixed(1).replace('.', ',') + ' cm dick)';
      };

      document.getElementById('spde2-result')!.textContent = maxPad > 0 ? maxPad.toFixed(1).replace('.', ',') + ' cm max Umfangszugabe' : 'Puppe passt zum Koerper';
      document.getElementById('spde2-pbust')!.textContent = formatPad(bustDiff, bustThick);
      document.getElementById('spde2-pwaist')!.textContent = formatPad(waistDiff, waistThick);
      document.getElementById('spde2-phip')!.textContent = formatPad(hipDiff, hipThick);
      document.getElementById('spde2-pshould')!.textContent = shouldDiff > 0 ? '+' + shouldDiff.toFixed(1).replace('.', ',') + ' cm je Seite' : 'Nicht noetig';
      document.getElementById('spde2-layers')!.textContent = 'Brust: ' + bustLayers + ' | Taille: ' + waistLayers + ' | Huefte: ' + hipLayers;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.spde2-in').forEach(el => { el.addEventListener('input', calcSPDE2); el.addEventListener('change', calcSPDE2); });
      calcSPDE2();
    }, 50);
  </script>
</CalculatorLayout>
