---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Auftrieb-Rechner - Archimedisches Prinzip";
const description = "Berechnen Sie die Auftriebskraft, das verdr&auml;ngte Volumen und ob ein Objekt schwimmt oder sinkt nach dem archimedischen Prinzip.";
const relatedCalcs = [
  { name: "Dichte-Rechner", url: "/de/dichte-rechner", description: "Dichte berechnen." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen." },
  { name: "Kraft-Rechner", url: "/de/kraft-rechner", description: "Kraft berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Auftrieb-Rechner" lang="de" enSlug="buoyancy-calculator" keywords="auftrieb rechner, archimedisches prinzip, auftriebskraft, schwimmen oder sinken" breadcrumbs={[{ name: "Auftrieb-Rechner", url: "/de/auftrieb-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Auftrieb-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Auftriebskraft und bestimmen Sie, ob ein Objekt schwimmt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Objektvolumen (m&sup3;)</label><input type="number" id="bu-vol" class="bu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.0001"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Objektmasse (kg)</label><input type="number" id="bu-mass" class="bu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.01"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Fl&uuml;ssigkeit</label>
          <select id="bu-fluid" class="bu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="1000" selected>S&uuml;&szlig;wasser (1000 kg/m&sup3;)</option>
            <option value="1025">Meerwasser (1025 kg/m&sup3;)</option>
            <option value="789">Alkohol (789 kg/m&sup3;)</option>
            <option value="13534">Quecksilber (13534 kg/m&sup3;)</option>
            <option value="1.225">Luft (1,225 kg/m&sup3;)</option>
            <option value="900">&Ouml;l (900 kg/m&sup3;)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Auftriebskraft</div>
          <div class="text-5xl font-extrabold font-mono" id="bu-result">0 N</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="bu-status-box">
          <div class="font-bold text-lg" id="bu-status">-</div>
          <div class="text-xs mt-1" id="bu-pct">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewichtskraft</div><div class="text-xl font-bold font-mono" id="bu-weight">0 N</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Objektdichte</div><div class="text-xl font-bold font-mono" id="bu-den">0 kg/m&sup3;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nettokraft</div><div class="text-xl font-bold font-mono" id="bu-net">0 N</div></div>
        </div>
      </div>
      <ShareButton calculatorId="buoyancy" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Archimedische Prinzip</h2>
      <p>Die Auftriebskraft auf einen K&ouml;rper in einer Fl&uuml;ssigkeit ist gleich dem Gewicht der verdr&auml;ngten Fl&uuml;ssigkeit: F<sub>A</sub> = &rho;<sub>Fl</sub> &times; V &times; g. Ein Objekt schwimmt, wenn seine Dichte geringer ist als die der Fl&uuml;ssigkeit.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBU() {
      const vol = parseFloat((document.getElementById('bu-vol') as HTMLInputElement).value) || 0;
      const mass = parseFloat((document.getElementById('bu-mass') as HTMLInputElement).value) || 0;
      const fluidDen = parseFloat((document.getElementById('bu-fluid') as HTMLSelectElement).value) || 1000;
      const g = 9.81;
      const buoyantForce = fluidDen * vol * g;
      const weight = mass * g;
      const netForce = buoyantForce - weight;
      const objDensity = vol > 0 ? mass / vol : 0;
      const fmt = (v: number) => v.toFixed(4).replace('.', ',');
      document.getElementById('bu-result')!.textContent = fmt(buoyantForce) + ' N';
      document.getElementById('bu-weight')!.textContent = fmt(weight) + ' N';
      document.getElementById('bu-den')!.textContent = objDensity.toFixed(1).replace('.', ',') + ' kg/m\u00B3';
      document.getElementById('bu-net')!.textContent = (netForce >= 0 ? '+' : '') + fmt(netForce) + ' N';
      let status: string, color: string, pct: string;
      if (objDensity < fluidDen) {
        const submerged = vol > 0 ? (objDensity / fluidDen) * 100 : 0;
        status = 'SCHWIMMT';
        pct = `${submerged.toFixed(1).replace('.', ',')}% eingetaucht`;
        color = 'bg-green-50 text-green-800';
      } else if (objDensity === fluidDen) {
        status = 'SCHWEBT';
        pct = 'Schwebt in beliebiger Tiefe';
        color = 'bg-yellow-50 text-yellow-800';
      } else {
        status = 'SINKT';
        pct = `Scheinbares Gewicht: ${(-netForce).toFixed(3).replace('.', ',')} N`;
        color = 'bg-red-50 text-red-800';
      }
      document.getElementById('bu-status')!.textContent = status;
      document.getElementById('bu-pct')!.textContent = pct;
      document.getElementById('bu-status-box')!.className = `p-4 rounded-xl text-center ${color}`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bu-vol') as HTMLInputElement).value = '0.001';
      (document.getElementById('bu-mass') as HTMLInputElement).value = '0.5';
      document.querySelectorAll('.bu-in').forEach(el => { el.addEventListener('input', calcBU); el.addEventListener('change', calcBU); });
      calcBU();
    }, 50);
  </script>
</CalculatorLayout>
