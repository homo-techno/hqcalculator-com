---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Alkohol-Kalorien-Rechner - Kalorien in alkoholischen Getränken";
const description = "Berechnen Sie die Kalorien in alkoholischen Getränken basierend auf Art, Volumen und Alkoholgehalt.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglicher Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Makro-Rechner", url: "/de/makro-rechner", description: "Makronährstoffe." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Abnehm-Planung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Alkohol-Kalorien-Rechner" enSlug="alcohol-calorie-calculator" keywords="Alkohol Kalorien, Bier Kalorien, Wein Kalorien, Cocktail Kalorien, Getränke Kalorien Rechner" breadcrumbs={[{ name: "Alkohol-Kalorien-Rechner", url: "/de/alkohol-kalorien-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Alkohol-Kalorien-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie heraus, wie viele Kalorien in Ihren Getränken stecken.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Getränkeart</label>
          <select id="ak-type" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="beer" selected>Bier</option>
            <option value="wine">Wein</option>
            <option value="spirits">Spirituosen</option>
            <option value="cocktail">Cocktail</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Volumen (ml)</label><input type="number" id="ak-vol" class="ak-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Alkohol (%)</label><input type="number" id="ak-abv" class="ak-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="100" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Getränke</label><input type="number" id="ak-count" class="ak-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="20" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkalorien</div>
          <div class="text-5xl font-extrabold" id="ak-cals">0</div>
          <div class="text-sm text-blue-200 mt-1" id="ak-per">0 kcal pro Getränk</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reiner Alkohol</div><div class="text-xl font-bold" id="ak-pure">0g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Standardgetränke</div><div class="text-xl font-bold" id="ak-std">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gehen (Min.)</div><div class="text-xl font-bold" id="ak-walk">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Referenz gängiger Getränke</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Bier (500ml, 5%)</span><span class="font-bold">215 kcal</span></div>
            <div class="flex justify-between"><span>Rotwein (200ml, 13%)</span><span class="font-bold">144 kcal</span></div>
            <div class="flex justify-between"><span>Wodka (40ml, 40%)</span><span class="font-bold">88 kcal</span></div>
            <div class="flex justify-between"><span>Margarita (240ml)</span><span class="font-bold">274 kcal</span></div>
            <div class="flex justify-between"><span>Leichtbier (330ml, 3,5%)</span><span class="font-bold">80 kcal</span></div>
            <div class="flex justify-between"><span>Sekt (150ml, 12%)</span><span class="font-bold">84 kcal</span></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="alkohol-kalorien" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Alkohol und Kalorien</h2>
      <p>Reiner Alkohol enthält 7 Kalorien pro Gramm. Die Formel: Kalorien = Volumen (ml) x Alkoholgehalt x 0,789 x 7. Im Vergleich dazu haben Fett 9 kcal/g, Kohlenhydrate und Eiweiß jeweils 4 kcal/g. Alkohol liefert also fast doppelt so viele Kalorien wie Zucker.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viele Kalorien hat ein Glas Wein?</strong> Ein typisches Glas Rotwein (200ml, 13% Alkohol) enthält etwa 144 Kalorien.</p>
      <p><strong>Ist Bier kalorienreicher als Wein?</strong> Pro Portion hat Wein oft weniger Kalorien, aber ein halber Liter Bier enthält aufgrund des größeren Volumens mehr Gesamtkalorien.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const akPresets: Record<string, [number, number]> = {
      beer: [500, 5], wine: [200, 13], spirits: [40, 40], cocktail: [240, 15], custom: [100, 10]
    };
    function setAkPreset() {
      const type = (document.getElementById('ak-type') as HTMLSelectElement).value;
      const [vol, abv] = akPresets[type];
      (document.getElementById('ak-vol') as HTMLInputElement).value = String(vol);
      (document.getElementById('ak-abv') as HTMLInputElement).value = String(abv);
      calcAk();
    }
    function calcAk() {
      const vol = parseFloat((document.getElementById('ak-vol') as HTMLInputElement).value) || 0;
      const abv = parseFloat((document.getElementById('ak-abv') as HTMLInputElement).value) || 0;
      const count = parseInt((document.getElementById('ak-count') as HTMLInputElement).value) || 1;
      const pureAlcoholML = vol * (abv / 100);
      const pureAlcoholG = pureAlcoholML * 0.789;
      const calsPerDrink = Math.round(pureAlcoholG * 7);
      const totalCals = calsPerDrink * count;
      const standardDrinks = (pureAlcoholG / 12) * count;
      document.getElementById('ak-cals')!.textContent = totalCals.toLocaleString('de-DE');
      document.getElementById('ak-per')!.textContent = calsPerDrink + ' kcal pro Getränk';
      document.getElementById('ak-pure')!.textContent = (pureAlcoholG * count).toFixed(1) + 'g';
      document.getElementById('ak-std')!.textContent = standardDrinks.toFixed(1);
      document.getElementById('ak-walk')!.textContent = Math.round(totalCals / 5) + ' Min.';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('ak-type')!.addEventListener('change', setAkPreset);
      document.querySelectorAll('.ak-in').forEach(el => el.addEventListener('input', calcAk));
      calcAk();
    }, 50);
  </script>
</CalculatorLayout>
