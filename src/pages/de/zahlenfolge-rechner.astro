---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zahlenfolge Rechner – Arithmetische und geometrische Folgen berechnen";
const description = "Berechnen Sie arithmetische und geometrische Folgen und deren Summen.";
const relatedCalcs = [
  { name: "Zahlensystem Umrechner", url: "/de/zahlensystem-umrechner", description: "Basis-Konvertierung." },
  { name: "Absolutwert Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert berechnen." },
  { name: "Umlaufzeit Rechner", url: "/de/umlaufzeit-rechner", description: "Keplersche Gesetze." },
  { name: "Osmotischer Druck Rechner", url: "/de/osmotischer-druck-rechner", description: "Osmotischen Druck." },
];
---
<CalculatorLayout lang="de" enSlug="number-sequence-calculator" title={title} description={description} calculatorName="Zahlenfolge Rechner" keywords="Zahlenfolge, arithmetische Folge, geometrische Folge, Summe, Reihe, Progression" breadcrumbs={[{ name: "Zahlenfolge Rechner", url: "/de/zahlenfolge-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zahlenfolge Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie arithmetische und geometrische Folgen, beliebige Glieder und die Summe der ersten n Glieder.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Folgentyp</label>
          <select id="zf-type" class="zf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="arith">Arithmetische Folge</option>
            <option value="geo">Geometrische Folge</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Erstes Glied (a₁)</label>
            <input type="number" id="zf-a1" class="zf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1" id="zf-d-label">Differenz (d)</label>
            <input type="number" id="zf-d" class="zf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Glieder (n)</label>
            <input type="number" id="zf-n" class="zf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" max="50">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gesuchtes Glied (k)</label>
            <input type="number" id="zf-k" class="zf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Summe S(n)</div>
          <div class="text-5xl font-extrabold font-mono" id="zf-sum">—</div>
          <div class="text-sm text-blue-200 mt-1" id="zf-ak-label"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">k-tes Glied (aₖ)</div>
            <div class="text-xl font-bold" id="zf-ak">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">n-tes Glied (aₙ)</div>
            <div class="text-xl font-bold" id="zf-an">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mittelwert</div>
            <div class="text-xl font-bold" id="zf-avg">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Folge (erste 8)</div>
            <div class="text-sm font-bold font-mono" id="zf-seq">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formelweg</h3>
          <div class="font-mono text-sm space-y-1" id="zf-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="number-sequence" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Arithmetische und geometrische Folgen</h2>
      <p>Bei einer arithmetischen Folge ist die Differenz zwischen aufeinanderfolgenden Gliedern konstant (z.B. 2, 5, 8, 11, …). Bei einer geometrischen Folge ist das Verhältnis aufeinanderfolgender Glieder konstant (z.B. 3, 6, 12, 24, …). Beide Folgentypen sind Grundbausteine der Mathematik mit Anwendungen in Finanzmathematik, Physik und Informatik.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Arithmetisch: aₙ = a₁ + (n-1)·d | S(n) = n/2 · (a₁ + aₙ)</p>
        <p>Geometrisch: aₙ = a₁ · q^(n-1) | S(n) = a₁ · (q^n - 1)/(q - 1)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Folge und Reihe?</strong> Eine Folge ist eine geordnete Liste von Zahlen (a₁, a₂, a₃, …). Eine Reihe ist die Summe der Glieder einer Folge (S = a₁ + a₂ + a₃ + …).</p>
      <p><strong>Wofür werden geometrische Folgen verwendet?</strong> Geometrische Folgen modellieren Zinseszins, Radioaktivität, Bevölkerungswachstum und digitale Signale.</p>
      <p><strong>Kann q = 1 bei geometrischen Folgen sein?</strong> Wenn q = 1, sind alle Glieder gleich (konstante Folge). Die Summenformel gilt dann nicht in der Standardform; stattdessen gilt S(n) = n · a₁.</p>
      <p><strong>Was ist eine konvergente geometrische Reihe?</strong> Wenn |q| kleiner 1, konvergiert die unendliche geometrische Reihe gegen S = a₁ / (1 - q).</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcZF() {
      const type = (document.getElementById('zf-type') as HTMLSelectElement).value;
      const a1 = parseFloat((document.getElementById('zf-a1') as HTMLInputElement).value) || 0;
      const d = parseFloat((document.getElementById('zf-d') as HTMLInputElement).value) || 0;
      const n = Math.max(1, parseInt((document.getElementById('zf-n') as HTMLInputElement).value) || 5);
      const k = Math.max(1, parseInt((document.getElementById('zf-k') as HTMLInputElement).value) || 1);
      const lbl = document.getElementById('zf-d-label')!;
      lbl.textContent = type === 'arith' ? 'Differenz (d)' : 'Quotient (q)';
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 4 });
      const steps: string[] = [];
      let an: number, ak: number, sum: number, avg: number;
      let seqArr: number[] = [];
      if (type === 'arith') {
        an = a1 + (n - 1) * d;
        ak = a1 + (k - 1) * d;
        sum = (n / 2) * (a1 + an);
        avg = sum / n;
        seqArr = Array.from({length: Math.min(n, 8)}, (_, i) => a1 + i * d);
        steps.push('aₙ = a₁ + (n-1)·d = ' + fmt(a1) + ' + ' + (n-1) + '·' + fmt(d) + ' = ' + fmt(an));
        steps.push('aₖ = ' + fmt(a1) + ' + (' + k + '-1)·' + fmt(d) + ' = ' + fmt(ak));
        steps.push('S(' + n + ') = ' + n + '/2 · (' + fmt(a1) + ' + ' + fmt(an) + ') = ' + fmt(sum));
      } else {
        const q = d === 0 ? 1 : d;
        an = a1 * Math.pow(q, n - 1);
        ak = a1 * Math.pow(q, k - 1);
        sum = q === 1 ? a1 * n : a1 * (Math.pow(q, n) - 1) / (q - 1);
        avg = sum / n;
        seqArr = Array.from({length: Math.min(n, 8)}, (_, i) => a1 * Math.pow(q, i));
        steps.push('aₙ = a₁ · q^(n-1) = ' + fmt(a1) + ' · ' + fmt(q) + '^' + (n-1) + ' = ' + fmt(an));
        steps.push('aₖ = ' + fmt(a1) + ' · ' + fmt(q) + '^' + (k-1) + ' = ' + fmt(ak));
        if (q !== 1) steps.push('S(' + n + ') = ' + fmt(a1) + ' · (' + fmt(q) + '^' + n + ' - 1)/(' + fmt(q) + ' - 1) = ' + fmt(sum));
        else steps.push('S(' + n + ') = ' + n + ' · ' + fmt(a1) + ' = ' + fmt(sum));
      }
      document.getElementById('zf-sum')!.textContent = fmt(sum);
      document.getElementById('zf-ak-label')!.textContent = 'S(' + n + ') = ' + fmt(sum);
      document.getElementById('zf-an')!.textContent = fmt(an);
      document.getElementById('zf-ak')!.textContent = fmt(ak) + ' (Glied ' + k + ')';
      document.getElementById('zf-avg')!.textContent = fmt(avg);
      document.getElementById('zf-seq')!.textContent = seqArr.map(v => fmt(v)).join(', ') + (n > 8 ? ', …' : '');
      document.getElementById('zf-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('zf-a1') as HTMLInputElement).value = '2';
      (document.getElementById('zf-d') as HTMLInputElement).value = '3';
      (document.getElementById('zf-n') as HTMLInputElement).value = '10';
      (document.getElementById('zf-k') as HTMLInputElement).value = '5';
      document.querySelectorAll('.zf-in').forEach(el => { el.addEventListener('input', calcZF); el.addEventListener('change', calcZF); });
      calcZF();
    }, 50);
  </script>
</CalculatorLayout>
