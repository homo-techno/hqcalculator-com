---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lautstärke Rechner – Dezibel umrechnen & Schallpegel berechnen";
const description = "Konvertieren Sie Dezibel, berechnen Sie Schallpegel-Summen und Lärm-Expositionszeit. Mit Dezibel-Tabelle für Alltagsgeräusche.";

const relatedCalcs = [
  { name: "Mach-Zahl Rechner", url: "/de/mach-zahl-rechner", description: "Schallgeschwindigkeit." },
  { name: "Magnetfeld Rechner", url: "/de/magnetfeld-rechner", description: "Magnetfeldstärken." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
];
---
<CalculatorLayout lang="de" enSlug="loudness-calculator" title={title} description={description} calculatorName="Lautstärke Rechner" keywords="Dezibel Rechner, Schallpegel, Lautstärke umrechnen, dB berechnen, Lärm Exposition" breadcrumbs={[{ name: "Lautstärke Rechner", url: "/de/lautstaerke-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lautstärke Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Schallpegel, addieren Sie mehrere Schallquellen und ermitteln Sie die sichere Expositionszeit.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="ls-m1" class="ls-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="convert">Umrechnen</button>
          <button id="ls-m2" class="ls-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="add">Addieren</button>
          <button id="ls-m3" class="ls-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="expo">Expositionszeit</button>
        </div>
        <div id="ls-panel-convert">
          <label class="block text-xs font-medium text-text mb-1">Schallpegel (dB)</label>
          <input type="number" id="ls-db" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="80" step="0.1">
        </div>
        <div id="ls-panel-add" class="hidden space-y-2">
          <label class="block text-xs font-medium text-text mb-1">Schallquellen addieren (je eine Zeile in dB)</label>
          <textarea id="ls-sources" class="w-full px-4 py-3 border border-border rounded-xl font-mono text-sm" rows="4">80
80
75</textarea>
        </div>
        <div id="ls-panel-expo" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Lärmpegel (dB)</label>
          <input type="number" id="ls-exdb" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="90" step="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="ls-label">Ergebnis</div>
          <div class="text-4xl font-extrabold font-mono" id="ls-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="ls-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="ls-extras"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-xs text-text mb-2 uppercase tracking-wide">Referenzwerte</h3>
          <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-text-secondary font-mono">
            <span>30 dB – Flüstern</span><span>60 dB – Gespräch</span>
            <span>80 dB – Staubsauger</span><span>90 dB – Presslufthammer</span>
            <span>110 dB – Konzert</span><span>140 dB – Düsenmotor</span>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="loudness" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Dezibel – Die Maßeinheit der Lautstärke</h2>
      <p>Das Dezibel (dB) ist eine logarithmische Einheit für den Schalldruckpegel. Eine Verdopplung des Schalldrucks entspricht einer Erhöhung von 6 dB, eine Verdopplung der wahrgenommenen Lautstärke entspricht etwa 10 dB mehr. Die Hörschwelle des Menschen liegt bei 0 dB, die Schmerzgrenze bei etwa 130 dB.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Ab wann ist Lärm gefährlich?</h3>
      <p>Dauerhafter Lärm über 85 dB kann das Gehör schädigen. Laut EU-Richtlinie müssen Arbeitgeber ab 80 dB Schutzmaßnahmen anbieten und ab 85 dB zwingend Gehörschutz zur Verfügung stellen.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie addiere ich mehrere Schallquellen?</h3>
      <p>Schallpegel addieren sich nicht linear. Zwei gleich laute Quellen à 80 dB ergeben zusammen 83 dB – nicht 160 dB. Die korrekte Formel lautet: L_gesamt = 10 × log10(10^(L1/10) + 10^(L2/10)).</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen dB und dB(A)?</h3>
      <p>dB(A) ist eine frequenzbewertete Messung, die der menschlichen Hörwahrnehmung angepasst ist. Das menschliche Ohr ist bei mittleren Frequenzen (2–5 kHz) am empfindlichsten. dB(A) wird für Umweltlärm und Arbeitsschutzmessungen verwendet.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let lsMode = 'convert';
    function setLsMode(m: string) {
      lsMode = m;
      ['convert', 'add', 'expo'].forEach(mode => {
        document.getElementById('ls-panel-' + mode)!.classList.toggle('hidden', mode !== m);
      });
      document.querySelectorAll('.ls-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'ls-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcLS();
    }
    function calcLS() {
      const extras = document.getElementById('ls-extras')!;
      if (lsMode === 'convert') {
        const db = parseFloat((document.getElementById('ls-db') as HTMLInputElement).value) || 0;
        const pa = 2e-5 * Math.pow(10, db / 20);
        const intensity = 1e-12 * Math.pow(10, db / 10);
        document.getElementById('ls-label')!.textContent = 'Schallpegel';
        document.getElementById('ls-result')!.textContent = db.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' dB';
        document.getElementById('ls-sub')!.textContent = db < 85 ? 'Sicherer Bereich' : db < 120 ? 'Gehörschutz empfohlen' : 'Gefährdungsbereich!';
        extras.innerHTML = `<div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schalldruck</div><div class="text-lg font-bold font-mono">${pa.toLocaleString('de-DE', { maximumSignificantDigits: 3 })} Pa</div></div><div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schallintensität</div><div class="text-lg font-bold font-mono">${intensity.toLocaleString('de-DE', { maximumSignificantDigits: 3 })} W/m²</div></div>`;
      } else if (lsMode === 'add') {
        const lines = (document.getElementById('ls-sources') as HTMLTextAreaElement).value.split('\n').map(Number).filter(n => !isNaN(n) && n > 0);
        if (lines.length === 0) { document.getElementById('ls-result')!.textContent = '–'; extras.innerHTML = ''; return; }
        const sum = lines.reduce((acc, db) => acc + Math.pow(10, db / 10), 0);
        const total = 10 * Math.log10(sum);
        document.getElementById('ls-label')!.textContent = 'Summe Schallpegel';
        document.getElementById('ls-result')!.textContent = total.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' dB';
        document.getElementById('ls-sub')!.textContent = lines.length + ' Quellen kombiniert';
        extras.innerHTML = '';
      } else {
        const db = parseFloat((document.getElementById('ls-exdb') as HTMLInputElement).value) || 90;
        const hoursPerDay = 8 * Math.pow(2, (85 - db) / 3);
        const safe = hoursPerDay >= 8 ? 'Ganztags sicher' : hoursPerDay < 0.25 ? 'Weniger als 15 Min!' : hoursPerDay.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Std/Tag';
        document.getElementById('ls-label')!.textContent = 'Sichere Expositionszeit';
        document.getElementById('ls-result')!.textContent = safe;
        document.getElementById('ls-sub')!.textContent = db >= 140 ? 'Sofortiger Schaden möglich!' : '';
        extras.innerHTML = '';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ls-mode').forEach(b => b.addEventListener('click', () => setLsMode((b as HTMLButtonElement).dataset.mode!)));
      document.getElementById('ls-db')!.addEventListener('input', calcLS);
      document.getElementById('ls-sources')!.addEventListener('input', calcLS);
      document.getElementById('ls-exdb')!.addEventListener('input', calcLS);
      calcLS();
    }, 50);
  </script>
</CalculatorLayout>
