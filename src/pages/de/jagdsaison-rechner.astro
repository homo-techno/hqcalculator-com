---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Jagdsaison-Rechner - Kosten, Erfolgsrate & Fleischausbeute";
const description = "Schätzen Sie Jagdkosten, Erfolgsraten und Fleischausbeute nach Tierart für die Jagdplanung. Berechnen Sie Tripkosten und Kostenpro Kilogramm Fleisch.";
const relatedCalcs = [
  { name: "Lebensmittelkosten-Rechner", url: "/food-cost-calculator", description: "Lebensmittelkostenberechnungen." },
  { name: "Budget-Rechner", url: "/budget-calculator", description: "Budget planen." },
  { name: "Kraftstoffkosten-Rechner", url: "/gas-cost-calculator", description: "Kraftstoffkostenschätzungen." },
  { name: "CO2-Fußabdruck-Rechner", url: "/carbon-footprint-calculator", description: "CO2-Emissionen schätzen." },
  { name: "Temperaturumrechner", url: "/temperature-converter", description: "Temperaturen umrechnen." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozentberechnungen." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie berechne ich die Gesamtkosten einer Jagd?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Gesamtkosten einer Jagd setzen sich aus Lizenz-/Abschussgebühren, Reisekosten und Unterkunftskosten zusammen. Unser Rechner berücksichtigt alle diese Faktoren und berechnet auch den Kostenanteil pro Kilogramm Wildbret." }
    },
    {
      "@type": "Question",
      "name": "Welche Tierart hat die höchste Erfolgsrate?",
      "acceptedAnswer": { "@type": "Answer", "text": "Kaninchen und Fasane haben mit 60–70 % die höchsten Erfolgsraten. Elche und Rentiere hingegen haben mit ca. 10–12 % sehr niedrige Erfolgsraten, liefern aber deutlich mehr Fleisch pro Tier." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Jagdsaison-Rechner" lang="de" keywords="jagdsaison rechner, jagdkosten, abschussquoten, jagdlizenz, wildbret, jagdplanung, fleischausbeute" breadcrumbs={[{ name: "Jagdsaison-Rechner", url: "/de/jagdsaison-rechner" }]} enSlug="hunting-season-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Jagdsaison-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Jagdkosten, Erfolgsraten und Fleischausbeute nach Tierart für die Tripplanung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Wildtierart</label>
          <select id="js-species" class="js-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="25|20|2|68">Weißwedelhirsch (25 kg Fleisch, 20 % Erfolg)</option>
            <option value="32|15|1|90">Maultierhirsch (32 kg Fleisch, 15 % Erfolg)</option>
            <option value="90|12|1|160">Wapiti (90 kg Fleisch, 12 % Erfolg)</option>
            <option value="7|40|5|23">Wildpute (7 kg Fleisch, 40 % Erfolg)</option>
            <option value="1.5|60|15|14">Fasan (1,5 kg Fleisch, 60 % Erfolg)</option>
            <option value="2.5|50|10|16">Ente (2,5 kg Fleisch, 50 % Erfolg)</option>
            <option value="55|10|1|230">Elch (55 kg Fleisch, 10 % Erfolg)</option>
            <option value="1|70|25|12">Kaninchen (1 kg Fleisch, 70 % Erfolg)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Jäger</label>
            <input type="number" id="js-hunters" class="js-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="2" min="1" max="20" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jagdtage</label>
            <input type="number" id="js-days" class="js-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" min="1" max="90" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Lizenz/Abschusskarte (€)</label>
            <input type="number" id="js-license" class="js-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="0" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Reisekosten (€)</label>
            <input type="number" id="js-travel" class="js-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="180" min="0" step="25">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Unterkunft/Tag (€)</label>
            <input type="number" id="js-lodge" class="js-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="0" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fleischwert (€/kg)</label>
            <input type="number" id="js-meatval" class="js-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten Jagdtrip</div>
          <div class="text-5xl font-extrabold font-mono" id="js-total">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Erfolgsrate</div>
            <div class="text-xl font-bold font-mono" id="js-success">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Erw. Fleisch (kg)</div>
            <div class="text-xl font-bold font-mono" id="js-meat">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fleischwert</div>
            <div class="text-xl font-bold font-mono" id="js-value">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kosten pro Jäger</div>
            <div class="text-xl font-bold font-mono" id="js-perh">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kosten pro kg Fleisch</div>
            <div class="text-xl font-bold font-mono" id="js-perlb">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="jagdsaison" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Jagdkosten richtig planen</h2>
      <p>Die Kosten einer Jagd setzen sich aus mehreren Faktoren zusammen: Lizenzgebühren, Reise, Unterkunft und Ausrüstung. Mit unserem Rechner können Sie die Gesamtkosten ermitteln und herausfinden, ob die Eigenversorgung mit Wildfleisch wirtschaftlich sinnvoll ist.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie berechne ich die Gesamtkosten einer Jagd?</h4>
      <p>Die Gesamtkosten setzen sich aus Lizenz-/Abschussgebühren, Reisekosten und Unterkunftskosten zusammen. Unser Rechner berücksichtigt alle diese Faktoren und berechnet auch den Kostenanteil pro Kilogramm Wildbret.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Welche Tierart hat die höchste Erfolgsrate?</h4>
      <p>Kaninchen und Fasane haben mit 60–70 % die höchsten Erfolgsraten. Elche haben mit ca. 10 % niedrige Erfolgsraten, liefern aber deutlich mehr Fleisch pro Tier.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcJS() {
      const speciesData = (document.getElementById('js-species') as HTMLSelectElement).value.split('|');
      const meatPerAnimal = parseFloat(speciesData[0]);
      const successPct = parseFloat(speciesData[1]);
      const bagLimit = parseInt(speciesData[2]);
      const hunters = parseInt((document.getElementById('js-hunters') as HTMLInputElement).value) || 2;
      const days = parseInt((document.getElementById('js-days') as HTMLInputElement).value) || 5;
      const license = parseFloat((document.getElementById('js-license') as HTMLInputElement).value) || 0;
      const travel = parseFloat((document.getElementById('js-travel') as HTMLInputElement).value) || 0;
      const lodge = parseFloat((document.getElementById('js-lodge') as HTMLInputElement).value) || 0;
      const meatVal = parseFloat((document.getElementById('js-meatval') as HTMLInputElement).value) || 0;
      const licenseCost = license * hunters;
      const lodgeCost = lodge * days * hunters;
      const totalCost = licenseCost + travel + lodgeCost;
      const costPerHunter = totalCost / hunters;
      const expectedHarvest = hunters * bagLimit * (successPct / 100);
      const expectedMeat = expectedHarvest * meatPerAnimal;
      const meatValue = expectedMeat * meatVal;
      const costPerKg = expectedMeat > 0 ? totalCost / expectedMeat : 0;
      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';
      document.getElementById('js-total')!.textContent = fmtEur(totalCost);
      document.getElementById('js-success')!.textContent = successPct + ' %';
      document.getElementById('js-meat')!.textContent = Math.round(expectedMeat).toLocaleString('de-DE');
      document.getElementById('js-value')!.textContent = fmtEur(meatValue);
      document.getElementById('js-perh')!.textContent = fmtEur(costPerHunter);
      document.getElementById('js-perlb')!.textContent = costPerKg.toFixed(2) + ' \u20ac/kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.js-in').forEach(el => { el.addEventListener('input', calcJS); el.addEventListener('change', calcJS); });
      calcJS();
    }, 50);
  </script>
</CalculatorLayout>
