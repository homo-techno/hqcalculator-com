---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mineral-Bestimmung Rechner - Mineralien bestimmen";
const description = "Bestimmen Sie Mineralien anhand von Härte, Dichte und optischen Eigenschaften. Interaktiver Mineralbestimmungsschlüssel nach Mohs-Skala.";

const relatedCalcs = [
  { name: "Mohs-Härte Rechner", url: "/de/mohs-haerte-rechner", description: "Härte vergleichen." },
  { name: "Mineralreserven Rechner", url: "/de/mineralreserven-rechner", description: "Reserven berechnen." },
  { name: "Bergbaukosten Rechner", url: "/de/bergbau-kosten-rechner", description: "Bergbaukosten schätzen." },
  { name: "Dichte-Rechner", url: "/de/dichterechner", description: "Dichte berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mineral-identification-calculator" calculatorName="Mineral-Bestimmung Rechner" keywords="Mineral bestimmen, Mineralbestimmung, Mohs Härte, Mineral Dichte, Kristallsystem, Mineralien" breadcrumbs={[{ name: "Mineral-Bestimmung Rechner", url: "/de/mineral-bestimmung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mineral-Bestimmung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Eigenschaften Ihres unbekannten Minerals ein und erhalten Sie passende Bestimmungsvorschläge aus der Mineraldatenbank.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mohshärte (1–10)</label>
            <input type="number" id="mb-hardness" class="mb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="1" max="10" value="7">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Dichte (g/cm³)</label>
            <input type="number" id="mb-density" class="mb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0.5" max="20" value="2.65">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Farbe</label>
          <select id="mb-color" class="mb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="">— beliebig —</option>
            <option value="farblos">Farblos / Weiß</option>
            <option value="grau">Grau / Schwarz</option>
            <option value="rot">Rot / Rosa / Orange</option>
            <option value="gelb">Gelb / Braun</option>
            <option value="gruen">Grün</option>
            <option value="blau">Blau / Violett</option>
            <option value="metallisch">Metallisch (Silber/Gold)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Glanz</label>
          <select id="mb-luster" class="mb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="">— beliebig —</option>
            <option value="glasglanz">Glasglanz (vitreus)</option>
            <option value="metallglanz">Metallglanz</option>
            <option value="perlglanz">Perlglanz</option>
            <option value="seidenglanz">Seidenglanz</option>
            <option value="fettglanz">Fettglanz / Harzglanz</option>
            <option value="matt">Matt / Erdig</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Spaltbarkeit</label>
          <select id="mb-cleavage" class="mb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="">— beliebig —</option>
            <option value="keine">Keine / Muscheliger Bruch</option>
            <option value="eine">Eine Richtung</option>
            <option value="zwei">Zwei Richtungen</option>
            <option value="drei">Drei Richtungen</option>
          </select>
        </div>

        <button id="mb-calc-btn" class="w-full py-3 bg-primary text-white font-bold rounded-xl hover:bg-primary/90 transition-colors cursor-pointer">Mineral bestimmen</button>

        <div id="mb-results" class="space-y-3 hidden">
          <h3 class="font-semibold text-text">Mögliche Mineralien:</h3>
          <div id="mb-matches"></div>
        </div>

        <div id="mb-noresult" class="hidden p-4 bg-yellow-50 border border-yellow-200 rounded-xl text-yellow-800 text-sm">
          Keine exakte Übereinstimmung gefunden. Bitte prüfen Sie Ihre Eingaben oder wählen Sie weniger Filter.
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mineral-identification" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mineralbestimmung nach physikalischen Eigenschaften</h2>
      <p>Die Bestimmung von Mineralien erfolgt systematisch über messbare physikalische Eigenschaften. Die wichtigsten Merkmale sind die Mohshärte, die Dichte (spezifisches Gewicht), der Glanz, die Farbe und die Spaltbarkeit.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist die zuverlässigste Eigenschaft zur Mineralbestimmung?</p>
          <p>Die Mohshärte ist eine der zuverlässigsten Eigenschaften, da sie charakteristisch und leicht messbar ist. Kombiniert mit Dichte und Spaltbarkeit lässt sich fast jedes Mineral eindeutig bestimmen.</p>
        </div>
        <div>
          <p class="font-semibold">Wie messe ich die Dichte eines Minerals?</p>
          <p>Die Dichte wird durch Wiegen des Minerals in Luft und in Wasser (Archimedisches Prinzip) bestimmt: Dichte = Gewicht in Luft / (Gewicht in Luft - Gewicht in Wasser).</p>
        </div>
        <div>
          <p class="font-semibold">Warum variiert die Farbe bei Mineralien?</p>
          <p>Viele Mineralien können durch Verunreinigungen (sog. Chromophore) verschiedene Farben annehmen. Quarz zum Beispiel kann farblos (Bergkristall), lila (Amethyst), gelb (Citrin) oder rosa (Rosenquarz) sein.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen Glanz und Farbe?</p>
          <p>Die Farbe beschreibt den Farbton des Minerals, während der Glanz die Art der Lichtreflexion beschreibt (metallisch, glasartig, seidig usw.). Der Glanz ist oft konstanter als die Farbe.</p>
        </div>
        <div>
          <p class="font-semibold">Was bedeutet Spaltbarkeit bei Mineralien?</p>
          <p>Spaltbarkeit ist die Fähigkeit eines Minerals, entlang bestimmter Kristallebenen zu brechen. Sie ergibt glatte, spiegelnde Flächen und ist ein wichtiges Bestimmungsmerkmal.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const MINERALS = [
      { name: 'Quarz', hardMin: 6.5, hardMax: 7.5, densMin: 2.5, densMax: 2.8, colors: ['farblos', 'grau', 'rot', 'gelb', 'gruen', 'blau'], lusters: ['glasglanz'], cleavages: ['keine'], desc: 'Häufigstes Silikatmineral, H=7, SiO₂' },
      { name: 'Feldspat (Orthoklas)', hardMin: 5.5, hardMax: 6.5, densMin: 2.5, densMax: 2.6, colors: ['farblos', 'rot', 'grau'], lusters: ['glasglanz', 'perlglanz'], cleavages: ['zwei'], desc: 'Häufig in Granit, H=6, KAlSi₃O₈' },
      { name: 'Calcit', hardMin: 2.5, hardMax: 3.5, densMin: 2.6, densMax: 2.8, colors: ['farblos', 'grau', 'gruen', 'gelb'], lusters: ['glasglanz', 'perlglanz'], cleavages: ['drei'], desc: 'Kalkspat, reagiert mit HCl, CaCO₃' },
      { name: 'Pyrit', hardMin: 5.5, hardMax: 6.5, densMin: 4.9, densMax: 5.2, colors: ['metallisch'], lusters: ['metallglanz'], cleavages: ['keine'], desc: 'Katzengold, FeS₂, kubisch' },
      { name: 'Galenit', hardMin: 2.0, hardMax: 2.8, densMin: 7.2, densMax: 7.6, colors: ['metallisch', 'grau'], lusters: ['metallglanz'], cleavages: ['drei'], desc: 'Bleiglanz, PbS, sehr schwer' },
      { name: 'Fluorit', hardMin: 3.5, hardMax: 4.5, densMin: 3.0, densMax: 3.3, colors: ['farblos', 'gelb', 'gruen', 'blau', 'rot'], lusters: ['glasglanz'], cleavages: ['drei'], desc: 'Flussspat, CaF₂, leuchtende Farben' },
      { name: 'Apatit', hardMin: 4.5, hardMax: 5.5, densMin: 3.1, densMax: 3.3, colors: ['farblos', 'gruen', 'blau', 'gelb'], lusters: ['glasglanz'], cleavages: ['keine', 'eine'], desc: 'H=5, Ca₅(PO₄)₃, phosphathaltig' },
      { name: 'Biotit (Glimmer)', hardMin: 2.0, hardMax: 3.0, densMin: 2.7, densMax: 3.2, colors: ['grau', 'gruen'], lusters: ['metallglanz', 'perlglanz'], cleavages: ['eine'], desc: 'Schwarzer Glimmer, schuppig spaltbar' },
      { name: 'Malachit', hardMin: 3.5, hardMax: 4.0, densMin: 3.6, densMax: 4.0, colors: ['gruen'], lusters: ['seidenglanz', 'glasglanz'], cleavages: ['eine'], desc: 'Grünes Kupferkarbonat, Cu₂CO₃(OH)₂' },
      { name: 'Magnetit', hardMin: 5.0, hardMax: 6.5, densMin: 5.0, densMax: 5.2, colors: ['grau', 'metallisch'], lusters: ['metallglanz', 'matt'], cleavages: ['keine'], desc: 'Magnetisches Eisenoxid, Fe₃O₄' },
      { name: 'Gips', hardMin: 1.5, hardMax: 2.5, densMin: 2.2, densMax: 2.4, colors: ['farblos', 'grau'], lusters: ['seidenglanz', 'perlglanz'], cleavages: ['eine', 'zwei'], desc: 'CaSO₄·2H₂O, ritzbar mit Fingernagel' },
      { name: 'Talk', hardMin: 0.5, hardMax: 1.5, densMin: 2.5, densMax: 2.9, colors: ['farblos', 'gruen', 'grau'], lusters: ['seidenglanz', 'fettglanz'], cleavages: ['eine'], desc: 'Weichstes Mineral, H=1, Mg₃Si₄O₁₀(OH)₂' },
    ];

    function calcMb() {
      const hardness = parseFloat((document.getElementById('mb-hardness') as HTMLInputElement).value) || 0;
      const density = parseFloat((document.getElementById('mb-density') as HTMLInputElement).value) || 0;
      const color = (document.getElementById('mb-color') as HTMLSelectElement).value;
      const luster = (document.getElementById('mb-luster') as HTMLSelectElement).value;
      const cleavage = (document.getElementById('mb-cleavage') as HTMLSelectElement).value;

      const tolerance = 0.5;
      const densTol = 0.3;

      const matches = MINERALS.filter(m => {
        if (hardness > 0 && (hardness < m.hardMin - tolerance || hardness > m.hardMax + tolerance)) return false;
        if (density > 0 && (density < m.densMin - densTol || density > m.densMax + densTol)) return false;
        if (color && !m.colors.includes(color)) return false;
        if (luster && !m.lusters.includes(luster)) return false;
        if (cleavage && !m.cleavages.includes(cleavage)) return false;
        return true;
      });

      const matchesEl = document.getElementById('mb-matches')!;
      const resultsEl = document.getElementById('mb-results')!;
      const noResultEl = document.getElementById('mb-noresult')!;

      if (matches.length === 0) {
        resultsEl.classList.add('hidden');
        noResultEl.classList.remove('hidden');
      } else {
        noResultEl.classList.add('hidden');
        resultsEl.classList.remove('hidden');
        matchesEl.innerHTML = matches.map(m => `
          <div class="p-4 bg-surface-alt rounded-xl border border-border">
            <div class="font-bold text-text">${m.name}</div>
            <div class="text-sm text-text-secondary mt-1">${m.desc}</div>
            <div class="text-xs text-text-muted mt-1">Härte: ${m.hardMin}–${m.hardMax} | Dichte: ${m.densMin}–${m.densMax} g/cm³</div>
          </div>
        `).join('');
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('mb-calc-btn')!.addEventListener('click', calcMb);
      document.querySelectorAll('.mb-in').forEach(el => el.addEventListener('change', () => {}));
      calcMb();
    }, 50);
  </script>
</CalculatorLayout>
