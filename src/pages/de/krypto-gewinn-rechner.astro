---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Krypto-Gewinn-Rechner - Kryptowaehrungs-Gewinne berechnen";
const description = "Berechnen Sie Ihren Kryptowaehrungs-Gewinn oder -Verlust. Geben Sie Kauf- und Verkaufspreise ein, um Gesamtrendite, Gebuehrenauswirkung und Steuerfolgen zu sehen.";
const relatedCalcs = [
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investments." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "Waehrungsrechner", url: "/de/waehrungsrechner", description: "Waehrungen." },
  { name: "Gewinnmargenrechner", url: "/de/gewinnmargenrechner", description: "Gewinnmargen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Krypto-Gewinn-Rechner" keywords="Krypto Gewinn Rechner, Kryptowaehrung Gewinne, Bitcoin Gewinn, Krypto Steuer, Krypto ROI" breadcrumbs={[{ name: "Krypto-Gewinn-Rechner", url: "/de/krypto-gewinn-rechner" }]} lang="de" enSlug="crypto-profit-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Krypto-Gewinn-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren Kryptowaehrungs-Handelsgewinn oder -verlust.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Investitionsbetrag</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="kgr-invest" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5000" min="0" step="100">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Kaufpreis pro Coin</label>
              <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
                <input type="number" id="kgr-buy" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="30000" min="0" step="100">
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Verkaufspreis pro Coin</label>
              <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
                <input type="number" id="kgr-sell" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="45000" min="0" step="100">
              </div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Kaufgebuehr (%)</label>
              <input type="number" id="kgr-buy-fee" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="0.5" min="0" max="10" step="0.1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Verkaufsgebuehr (%)</label>
              <input type="number" id="kgr-sell-fee" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="0.5" min="0" max="10" step="0.1">
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 rounded-2xl text-white text-center" id="kgr-box" style="background:#22c55e;">
            <div class="text-sm uppercase tracking-wide mb-1 opacity-80">Nettogewinn / -verlust</div>
            <div class="text-5xl font-extrabold" id="kgr-profit">0 EUR</div>
            <div class="text-sm mt-1 opacity-80" id="kgr-pct">0 % Rendite</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gekaufte Coins</div>
              <div class="text-xl font-bold" id="kgr-coins">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Verkaufserloes</div>
              <div class="text-xl font-bold text-secondary" id="kgr-exit">0 EUR</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gebuehren gesamt</div>
              <div class="text-xl font-bold" id="kgr-fees">0 EUR</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Kursaenderung</div>
              <div class="text-xl font-bold" id="kgr-change">0 %</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Aufschluesselung</h3>
            <div class="space-y-1 text-sm" id="kgr-breakdown"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="crypto-profit" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Krypto-Gewinne berechnen</h2>
      <p>Krypto-Gewinne werden aehnlich wie Aktiengewinne berechnet: Verkaufswert minus Anschaffungskosten minus Gebuehren. In Deutschland sind Kryptowaehrungs-Gewinne nach einer Haltefrist von einem Jahr steuerfrei. Bei kuerzerer Haltedauer gilt der persoenliche Steuersatz.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Wann sind Krypto-Gewinne steuerfrei?</strong> In Deutschland nach einer Haltefrist von mindestens einem Jahr.</li>
        <li><strong>Wie werden Gebuehren beruecksichtigt?</strong> Kauf- und Verkaufsgebuehren reduzieren den Gewinn und werden in der Berechnung abgezogen.</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmtKGR = (n: number) => (n < 0 ? '-' : '') + Math.abs(n).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, '.').replace(/\.(\d{2})$/, ',$1') + ' \u20AC';

    function calcKGR() {
      const invest = parseFloat((document.getElementById('kgr-invest') as HTMLInputElement).value) || 0;
      const buyPrice = parseFloat((document.getElementById('kgr-buy') as HTMLInputElement).value) || 0;
      const sellPrice = parseFloat((document.getElementById('kgr-sell') as HTMLInputElement).value) || 0;
      const buyFee = (parseFloat((document.getElementById('kgr-buy-fee') as HTMLInputElement).value) || 0) / 100;
      const sellFee = (parseFloat((document.getElementById('kgr-sell-fee') as HTMLInputElement).value) || 0) / 100;

      const buyFeeAmt = invest * buyFee;
      const effectiveInvest = invest - buyFeeAmt;
      const coins = buyPrice > 0 ? effectiveInvest / buyPrice : 0;
      const grossExit = coins * sellPrice;
      const sellFeeAmt = grossExit * sellFee;
      const netExit = grossExit - sellFeeAmt;
      const profit = netExit - invest;
      const pct = invest > 0 ? (profit / invest) * 100 : 0;
      const priceChange = buyPrice > 0 ? ((sellPrice - buyPrice) / buyPrice) * 100 : 0;

      document.getElementById('kgr-profit')!.textContent = fmtKGR(profit);
      document.getElementById('kgr-pct')!.textContent = pct.toFixed(2).replace('.', ',') + ' % Rendite';
      document.getElementById('kgr-coins')!.textContent = coins.toFixed(6).replace('.', ',');
      document.getElementById('kgr-exit')!.textContent = fmtKGR(netExit);
      document.getElementById('kgr-fees')!.textContent = fmtKGR(buyFeeAmt + sellFeeAmt);
      document.getElementById('kgr-change')!.textContent = (priceChange >= 0 ? '+' : '') + priceChange.toFixed(2).replace('.', ',') + ' %';
      document.getElementById('kgr-box')!.style.backgroundColor = profit >= 0 ? '#22c55e' : '#ef4444';

      const rows: [string, string][] = [
        ['Investition', fmtKGR(invest)],
        ['Kaufgebuehr', fmtKGR(buyFeeAmt)],
        ['Gekaufte Coins', coins.toFixed(6).replace('.', ',')],
        ['Bruttoverkaufswert', fmtKGR(grossExit)],
        ['Verkaufsgebuehr', fmtKGR(sellFeeAmt)],
        ['Nettoerloes', fmtKGR(netExit)],
        ['Gewinn / Verlust', fmtKGR(profit)],
      ];
      document.getElementById('kgr-breakdown')!.innerHTML = rows.map(([l, v]) =>
        '<div class="flex justify-between ' + (l.startsWith('Gewinn') ? 'pt-1 border-t border-border font-bold' : '') + '"><span class="text-text-secondary">' + l + '</span><span class="font-semibold">' + v + '</span></div>'
      ).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['kgr-invest', 'kgr-buy', 'kgr-sell', 'kgr-buy-fee', 'kgr-sell-fee'].forEach(id =>
        document.getElementById(id)!.addEventListener('input', calcKGR));
      calcKGR();
    }, 50);
  </script>
</CalculatorLayout>
