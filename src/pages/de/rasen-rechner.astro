---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Rasenrechner";
const description = "Berechnen Sie Saatgut-, Dünger- und Bewässerungsbedarf für Ihren Rasen.";

const relatedCalcs = [
  { name: "Koi-Teich Rechner", url: "/de/koi-teich-rechner", description: "Teich planen." },
  { name: "Grundstücksfläche Rechner", url: "/de/grundstuecksflaeche-rechner", description: "Fläche berechnen." },
  { name: "Gartenbeleuchtung Rechner", url: "/de/gartenbeleuchtung-rechner", description: "Beleuchtung planen." },
  { name: "Geländegradierung Rechner", url: "/de/gelaendegradierung-rechner", description: "Erdarbeiten planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Rasenrechner" lang="de" enSlug="lawn-calculator" keywords="rasenrechner, rasensamen berechnen, rasendünger menge, rasen bewässerung" breadcrumbs={[{ name: "Rasenrechner", url: "/de/rasen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Rasenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Saatgutmenge, Düngerbedarf und Bewässerungsvolumen für Ihren Rasen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Rasenfläche (m²)</label><input type="number" id="rnr-area" class="rnr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rasentyp</label><select id="rnr-type" class="rnr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="30">Zierrasen (30 g/m²)</option>
            <option value="35" selected>Gebrauchsrasen (35 g/m²)</option>
            <option value="40">Schattenrasen (40 g/m²)</option>
            <option value="45">Sportrasen (45 g/m²)</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Düngertyp</label><select id="rnr-fert" class="rnr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="30">Rasen-Langzeitdünger (30 g/m²)</option>
            <option value="40" selected>Rasendünger Frühjahr (40 g/m²)</option>
            <option value="25">Herbstdünger (25 g/m²)</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bewässerung (mm/Woche)</label><input type="number" id="rnr-water" class="rnr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="5" max="60" step="5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Saatgutzuschlag für Nachsaat (%)</label><input type="number" id="rnr-extra" class="rnr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="50" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Saatgutbedarf</div>
          <div class="text-4xl font-extrabold font-mono" id="rnr-seed">0 kg</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dünger (kg)</div><div class="text-xl font-bold" id="rnr-fertilizer">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser/Woche (L)</div><div class="text-xl font-bold" id="rnr-water-week">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser/Sommer (m³)</div><div class="text-xl font-bold" id="rnr-water-summer">0 m³</div></div>
        </div>
      </div>
      <ShareButton calculatorId="lawn-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Rasenpflege – Mengen richtig berechnen</h2>
      <p>Ein gesunder Rasen benötigt die richtige Menge an Saatgut, Dünger und Wasser. Bei der Neueinsaat werden je nach Rasentyp 25–50 g Samen pro Quadratmeter benötigt. Ein Puffer von 10–15 % für Fehlstellen und Nachsaat ist empfehlenswert. Für die Düngung gilt: Im Frühjahr stickstoffreicher Dünger für kräftiges Wachstum, im Herbst kaliumreicher Dünger zur Wintervorbereitung. Die Bewässerung sollte tief und selten erfolgen – 20–30 mm pro Woche fördern tiefe Wurzeln.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wann ist der beste Zeitpunkt für die Neueinsaat?</strong> Frühjahr (April–Mai) und Spätsommer/Herbst (August–September) sind ideal. Die Bodentemperatur sollte mindestens 8°C betragen.</p>
      <p><strong>Wie oft sollte ich meinen Rasen düngen?</strong> In der Regel 3–4 Mal pro Jahr: Frühjahr, Frühsommer, Hochsommer und Herbst. Langzeitdünger reduzieren den Aufwand.</p>
      <p><strong>Wann sollte ich meinen Rasen bewässern?</strong> Morgens (6–10 Uhr) ist ideal, da das Wasser vor der Hitze einziehen kann. Abends bewässern begünstigt Pilzerkrankungen.</p>
      <p><strong>Wie tief sollte ich meinen Rasen mähen?</strong> Die optimale Schnitthöhe beträgt 3,5–5 cm. Kürzer als 3 cm macht den Rasen anfällig für Trockenschäden.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcRNR() {
      const area = parseFloat((document.getElementById('rnr-area') as HTMLInputElement).value) || 0;
      const seedRate = parseFloat((document.getElementById('rnr-type') as HTMLSelectElement).value) || 35;
      const fertRate = parseFloat((document.getElementById('rnr-fert') as HTMLSelectElement).value) || 40;
      const waterMm = parseFloat((document.getElementById('rnr-water') as HTMLInputElement).value) || 20;
      const extra = parseFloat((document.getElementById('rnr-extra') as HTMLInputElement).value) || 0;
      const seedKg = (area * seedRate / 1000) * (1 + extra / 100);
      const fertilizer = area * fertRate / 1000;
      const waterWeekL = area * waterMm;
      const waterSummerM3 = waterWeekL * 13 / 1000;
      document.getElementById('rnr-seed')!.textContent = seedKg.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' kg';
      document.getElementById('rnr-fertilizer')!.textContent = fertilizer.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' kg';
      document.getElementById('rnr-water-week')!.textContent = waterWeekL.toLocaleString('de-DE') + ' L';
      document.getElementById('rnr-water-summer')!.textContent = waterSummerM3.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' m\u00B3';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.rnr-in').forEach(el => { el.addEventListener('input', calcRNR); el.addEventListener('change', calcRNR); }); calcRNR(); }, 50);
  </script>
</CalculatorLayout>
