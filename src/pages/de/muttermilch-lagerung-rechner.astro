---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Muttermilch-Lagerung-Rechner - Haltbarkeit nach Methode";
const description = "Berechnen Sie, wie lange Muttermilch je nach Lagerungsmethode und Temperatur frisch bleibt. Folgen Sie den Richtlinien f&uuml;r sichere Muttermilch-Aufbewahrung.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "T&auml;glicher Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeitberechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Muttermilch-Lagerung-Rechner" lang="de" enSlug="breastmilk-storage-calculator" keywords="muttermilch lagerung, muttermilch haltbarkeit, abgepumpte milch aufbewahren, stillen" breadcrumbs={[{ name: "Muttermilch-Lagerung", url: "/de/muttermilch-lagerung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Muttermilch-Lagerung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie, wie lange Ihre abgepumpte Muttermilch je nach Aufbewahrungsmethode frisch bleibt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Wann wurde die Milch abgepumpt?</label>
          <input type="datetime-local" id="bms-expressed" class="bms-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Lagerungsmethode</label>
          <select id="bms-method" class="bms-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="counter" selected>Arbeitsplatte / Raumtemperatur</option>
            <option value="cooler">Isolierte K&uuml;hltasche mit K&uuml;hlakkus</option>
            <option value="fridge">K&uuml;hlschrank (hinten, nicht T&uuml;r)</option>
            <option value="freezer">Gefrierfach (im K&uuml;hlschrank)</option>
            <option value="deepfreeze">Tiefk&uuml;hltruhe (freistehend)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Raumtemperatur (bei Arbeitsplatte)</label>
          <select id="bms-temp" class="bms-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="cool">K&uuml;hl (16-21&deg;C)</option>
            <option value="normal" selected>Normal (21-25&deg;C)</option>
            <option value="warm">Warm (25-29&deg;C)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gelagerte Menge (ml)</label>
          <input type="number" id="bms-amount" class="bms-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="10" max="1000" step="10">
        </div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Verbleibende Zeit</div>
        <div class="text-5xl font-extrabold" id="bms-remaining">--</div>
        <div class="text-sm text-blue-200 mt-1" id="bms-expires">Verbrauchsfrist</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Max. Lagerzeit</div>
          <div class="text-lg font-bold" id="bms-maxtime">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Ideal verbrauchen bis</div>
          <div class="text-lg font-bold" id="bms-ideal">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Status</div>
          <div class="text-lg font-bold" id="bms-status">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Verf&uuml;gbare Mahlzeiten</div>
          <div class="text-lg font-bold" id="bms-feedings">--</div>
        </div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Vollst&auml;ndiger Lagerungsleitfaden</h3>
        <div class="text-xs" id="bms-guide"></div>
      </div>
      <ShareButton calculatorId="breastmilk-storage" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Richtlinien zur Muttermilch-Aufbewahrung</h2>
      <p>Die richtige Lagerung von Muttermilch stellt sicher, dass Ihr Baby sichere, n&auml;hrstoffreiche Milch erh&auml;lt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Wichtige Lagerungstipps</h3>
      <ul>
        <li>Beschriften Sie Beh&auml;lter immer mit Datum und Uhrzeit des Abpumpens</li>
        <li>Lagern Sie Milch im hinteren Teil des K&uuml;hlschranks, nicht in der T&uuml;r</li>
        <li>Verwenden Sie BPA-freie Beh&auml;lter oder Muttermilch-Aufbewahrungsbeutel</li>
        <li>Lassen Sie Platz f&uuml;r die Ausdehnung beim Einfrieren</li>
        <li>Lagern Sie in kleinen Mengen (60-120 ml), um Verschwendung zu minimieren</li>
      </ul>
      <h3 class="text-xl font-semibold text-text mt-8">Auftau-Richtlinien</h3>
      <ul>
        <li>&Uuml;ber Nacht im K&uuml;hlschrank auftauen (sicherste Methode)</li>
        <li>Unter warmem flie&szlig;endem Wasser oder im Wasserbad auftauen</li>
        <li>Muttermilch niemals in der Mikrowelle erw&auml;rmen</li>
        <li>Aufgetaute Milch innerhalb von 24 Stunden verbrauchen</li>
        <li>Aufgetaute Muttermilch niemals wieder einfrieren</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBMS() {
      const expressedInput = (document.getElementById('bms-expressed') as HTMLInputElement).value;
      const method = (document.getElementById('bms-method') as HTMLSelectElement).value;
      const temp = (document.getElementById('bms-temp') as HTMLSelectElement).value;
      const amount = parseFloat((document.getElementById('bms-amount') as HTMLInputElement).value) || 120;

      const limits: Record<string, { max: number; ideal: number; label: string }> = {
        counter: { max: 4, ideal: 2, label: 'Raumtemperatur' },
        cooler: { max: 24, ideal: 12, label: 'K\u00fchltasche' },
        fridge: { max: 96, ideal: 72, label: 'K\u00fchlschrank (4\u00B0C)' },
        freezer: { max: 4320, ideal: 2160, label: 'Gefrierfach (-18\u00B0C)' },
        deepfreeze: { max: 8760, ideal: 4380, label: 'Tiefk\u00fchltruhe (-20\u00B0C)' },
      };

      if (method === 'counter') {
        if (temp === 'cool') { limits.counter.max = 6; limits.counter.ideal = 4; }
        else if (temp === 'warm') { limits.counter.max = 2; limits.counter.ideal = 1; }
      }

      const info = limits[method];
      const expressed = expressedInput ? new Date(expressedInput) : new Date();
      const now = new Date();
      const elapsedHours = (now.getTime() - expressed.getTime()) / (1000 * 60 * 60);
      const remainingHours = Math.max(0, info.max - elapsedHours);

      function formatDuration(hours: number): string {
        if (hours < 1) return Math.round(hours * 60) + ' Min';
        if (hours < 48) return Math.round(hours) + ' Stunden';
        if (hours < 720) return Math.round(hours / 24) + ' Tage';
        return Math.round(hours / 720) + ' Monate';
      }

      let status = 'Frisch';
      if (elapsedHours > info.max) status = 'Abgelaufen - Entsorgen';
      else if (elapsedHours > info.ideal) status = 'Bald verbrauchen';

      const expiresDate = new Date(expressed.getTime() + info.max * 60 * 60 * 1000);
      const feedings = Math.floor(amount / 90);

      document.getElementById('bms-remaining')!.textContent = formatDuration(remainingHours);
      document.getElementById('bms-expires')!.textContent = 'Verf\u00e4llt: ' + expiresDate.toLocaleString('de-DE');
      document.getElementById('bms-maxtime')!.textContent = formatDuration(info.max);
      document.getElementById('bms-ideal')!.textContent = formatDuration(info.ideal);
      document.getElementById('bms-status')!.textContent = status;
      document.getElementById('bms-feedings')!.textContent = feedings + ' (bei 90 ml)';

      const allMethods = ['counter', 'cooler', 'fridge', 'freezer', 'deepfreeze'];
      document.getElementById('bms-guide')!.innerHTML =
        '<div class="grid grid-cols-4 gap-2 font-semibold text-text-muted mb-1"><span>Methode</span><span>Temp</span><span>Ideal</span><span>Max</span></div>' +
        allMethods.map(m => {
          const d = limits[m];
          const isSelected = m === method;
          const temps: Record<string, string> = { counter: '25\u00B0C', cooler: '15\u00B0C', fridge: '4\u00B0C', freezer: '-18\u00B0C', deepfreeze: '-20\u00B0C' };
          return `<div class="grid grid-cols-4 gap-2 py-1 ${isSelected ? 'bg-blue-50 rounded font-bold' : ''}"><span>${d.label}</span><span>${temps[m]}</span><span>${formatDuration(d.ideal)}</span><span>${formatDuration(d.max)}</span></div>`;
        }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const now = new Date();
      const offset = now.getTimezoneOffset();
      const local = new Date(now.getTime() - offset * 60000);
      (document.getElementById('bms-expressed') as HTMLInputElement).value = local.toISOString().slice(0, 16);
      (document.getElementById('bms-amount') as HTMLInputElement).value = '120';
      document.querySelectorAll('.bms-in').forEach(el => {
        el.addEventListener('input', calcBMS);
        el.addEventListener('change', calcBMS);
      });
      calcBMS();
    }, 50);
  </script>
</CalculatorLayout>
