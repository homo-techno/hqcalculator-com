---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Veranstaltungs-Countdown-Rechner - Tage bis zum Event";
const description = "Z\u00e4hlen Sie die Tage bis zu einem Ereignis herunter. Sehen Sie Tage, Stunden, Minuten, Wochen und Monate bis zum Zieldatum.";

const relatedCalcs = [
  { name: "Veranstaltungszeitplan-Rechner", url: "/de/veranstaltungszeitplan-rechner", description: "Zeitplanung." },
  { name: "Veranstaltungsbudget-Rechner", url: "/de/veranstaltungsbudget-rechner", description: "Budgetplanung." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "Veranstaltungspersonal-Rechner", url: "/de/veranstaltungspersonal-rechner", description: "Personalbedarf." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Veranstaltungs-Countdown-Rechner" lang="de" enSlug="event-countdown-calculator" keywords="event countdown, tage bis, countdown timer, datumsrechner, tage verbleibend, wochen bis" breadcrumbs={[{ name: "Veranstaltungs-Countdown-Rechner", url: "/de/veranstaltungs-countdown-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Veranstaltungs-Countdown-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie ein Zieldatum ein und sehen Sie genau, wie viel Zeit verbleibt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label for="vcd-name" class="block text-sm font-medium text-text mb-1">Eventname (optional)</label>
          <input type="text" id="vcd-name" class="vcd-in w-full border border-border rounded-lg px-3 py-2" placeholder="z.B. Geburtstag, Urlaub, Hochzeit" />
        </div>
        <div>
          <label for="vcd-date" class="block text-sm font-medium text-text mb-1">Zieldatum</label>
          <input type="date" id="vcd-date" class="vcd-in w-full border border-border rounded-lg px-3 py-2" />
        </div>
        <div>
          <label for="vcd-time" class="block text-sm font-medium text-text mb-1">Zielzeit (optional)</label>
          <input type="time" id="vcd-time" class="vcd-in w-full border border-border rounded-lg px-3 py-2" value="00:00" />
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="vcd-label">Verbleibende Tage</div>
          <div class="text-5xl font-extrabold font-mono" id="vcd-result">0</div>
          <div class="text-sm text-blue-200 mt-1" id="vcd-sub"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stunden</div><div class="text-xl font-bold" id="vcd-hours">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minuten</div><div class="text-xl font-bold" id="vcd-minutes">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wochen</div><div class="text-xl font-bold" id="vcd-weeks">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monate</div><div class="text-xl font-bold" id="vcd-months">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Werktage</div><div class="text-xl font-bold" id="vcd-weekdays">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">% des Jahres vergangen</div><div class="text-xl font-bold" id="vcd-yearpct">0%</div></div>
        </div>
      </div>

      <ShareButton calculatorId="event-countdown-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Countdown zu Ihrem Event</h2>
      <p>Planen Sie Ihre Veranstaltung mit einem genauen Countdown. Sehen Sie die verbleibende Zeit in verschiedenen Einheiten f&uuml;r eine optimale Planung.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wann sollte ich mit der Planung beginnen?</strong> F&uuml;r gro&szlig;e Events wie Hochzeiten 12-18 Monate vorher, f&uuml;r kleinere Feiern 2-3 Monate.</p>
      <p><strong>Was sind Werktage?</strong> Werktage z&auml;hlen nur Montag bis Freitag, ohne Wochenenden.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcVCD() {
      const dateStr = (document.getElementById('vcd-date') as HTMLInputElement).value;
      const timeStr = (document.getElementById('vcd-time') as HTMLInputElement).value || '00:00';
      const eventName = (document.getElementById('vcd-name') as HTMLInputElement).value.trim();

      if (!dateStr) {
        (document.getElementById('vcd-result') as HTMLElement).textContent = '--';
        return;
      }

      const targetDate = new Date(dateStr + 'T' + timeStr + ':00');
      const now = new Date();
      const diffMs = targetDate.getTime() - now.getTime();
      const isPast = diffMs < 0;
      const absDiffMs = Math.abs(diffMs);

      const totalMinutes = Math.floor(absDiffMs / (1000 * 60));
      const totalHours = Math.floor(absDiffMs / (1000 * 60 * 60));
      const totalDays = Math.floor(absDiffMs / (1000 * 60 * 60 * 24));
      const weeks = Math.floor(totalDays / 7);
      const months = Math.floor(totalDays / 30.44);

      let weekdays = 0;
      const startDate = isPast ? targetDate : now;
      const endDate = isPast ? now : targetDate;
      const cursor = new Date(startDate);
      cursor.setHours(0, 0, 0, 0);
      const endNorm = new Date(endDate);
      endNorm.setHours(0, 0, 0, 0);
      while (cursor < endNorm) {
        const day = cursor.getDay();
        if (day !== 0 && day !== 6) weekdays++;
        cursor.setDate(cursor.getDate() + 1);
      }

      const startOfYear = new Date(now.getFullYear(), 0, 1);
      const endOfYear = new Date(now.getFullYear() + 1, 0, 1);
      const yearElapsed = ((now.getTime() - startOfYear.getTime()) / (endOfYear.getTime() - startOfYear.getTime())) * 100;

      const prefix = isPast ? 'vergangen' : 'verbleibend';
      const label = eventName
        ? (isPast ? 'Seit ' + eventName : 'Bis ' + eventName)
        : (isPast ? 'Tage seit Event' : 'Verbleibende Tage');

      (document.getElementById('vcd-label') as HTMLElement).textContent = label;
      (document.getElementById('vcd-result') as HTMLElement).textContent = totalDays.toLocaleString('de-DE');

      const remainHours = totalHours % 24;
      const remainMins = totalMinutes % 60;
      (document.getElementById('vcd-sub') as HTMLElement).textContent =
        totalDays + ' Tage, ' + remainHours + ' Stunden, ' + remainMins + ' Minuten ' + prefix;

      (document.getElementById('vcd-hours') as HTMLElement).textContent = totalHours.toLocaleString('de-DE');
      (document.getElementById('vcd-minutes') as HTMLElement).textContent = totalMinutes.toLocaleString('de-DE');
      (document.getElementById('vcd-weeks') as HTMLElement).textContent = weeks.toLocaleString('de-DE');
      (document.getElementById('vcd-months') as HTMLElement).textContent = months.toString();
      (document.getElementById('vcd-weekdays') as HTMLElement).textContent = weekdays.toLocaleString('de-DE');
      (document.getElementById('vcd-yearpct') as HTMLElement).textContent = yearElapsed.toFixed(1).replace('.', ',') + '%';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const defaultDate = new Date();
      defaultDate.setDate(defaultDate.getDate() + 90);
      const y = defaultDate.getFullYear();
      const m = String(defaultDate.getMonth() + 1).padStart(2, '0');
      const d = String(defaultDate.getDate()).padStart(2, '0');
      (document.getElementById('vcd-date') as HTMLInputElement).value = y + '-' + m + '-' + d;

      document.querySelectorAll('.vcd-in').forEach(el => {
        el.addEventListener('input', calcVCD);
        el.addEventListener('change', calcVCD);
      });
      calcVCD();
    }, 50);
  </script>
</CalculatorLayout>
