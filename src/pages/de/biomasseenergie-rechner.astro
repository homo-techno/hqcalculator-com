---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Biomasseenergie-Rechner - Brennstoff-Energiegehalt & Heizwert";
const description = "Berechnen Sie den Energiegehalt von Biomassebrennstoffen, Heizwert und Nutzw\u00e4rme aus verschiedenen Biomasse-Rohstoffen wie Holz, Pellets und landwirtschaftlichen Abf\u00e4llen.";
const relatedCalcs = [
  { name: "CO\u2082-Fu\u00dfabdruck", url: "/carbon-footprint-calculator", description: "CO\u2082-Emissionen." },
  { name: "BTU-Rechner", url: "/btu-calculator", description: "Heizenergie." },
  { name: "W\u00e4rmepumpe", url: "/heat-pump-efficiency-calculator", description: "W\u00e4rmepumpen-COP." },
  { name: "Kompostierungs-Rechner", url: "/composting-rate-calculator", description: "Kompostberechnungen." },
  { name: "Stromkosten-Rechner", url: "/electricity-cost-calculator", description: "Energiekosten." },
  { name: "CO\u2082-Kompensation", url: "/carbon-offset-calculator", description: "CO\u2082-Kompensation." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Biomasseenergie-Rechner" lang="de" keywords="biomasseenergie rechner, biomasse heizwert, holzpellets kWh, biomasse brennstoffgehalt, erneuerbare biomasseenergie" breadcrumbs={[{ name: "Biomasseenergie-Rechner", url: "/de/biomasseenergie-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Biomasseenergie-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Energiegehalt und Heizleistung aus Biomassebrennstoffen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Biomassebrennstoff</h3>
        <div><label class="block text-xs font-medium text-text mb-1">Brennstofftyp</label>
          <select id="bme-type" class="bme-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="hardwood">Hartholz (Raummeter) &ndash; 1.900 kWh</option>
            <option value="softwood">Weichholz (Raummeter) &ndash; 1.400 kWh</option>
            <option value="pellets" selected>Holzpellets (Tonne) &ndash; 4.800 kWh</option>
            <option value="chips">Hackschnitzel (Tonne) &ndash; 2.900 kWh</option>
            <option value="corn">Mais (100 kg) &ndash; 400 kWh</option>
            <option value="switchgrass">Miscanthus (Tonne) &ndash; 4.100 kWh</option>
            <option value="biogas">Biogas (1.000 m&sup3;) &ndash; 6.000 kWh</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Menge</label><input type="number" id="bme-qty" class="bme-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0.1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Feuchtegehalt (%)</label><input type="number" id="bme-moist" class="bme-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="60" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kessel-/Ofeneffizienz (%)</label><input type="number" id="bme-eff" class="bme-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="30" max="99" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Einheit (&euro;)</label><input type="number" id="bme-cost" class="bme-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="250" min="0" step="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nutzbare W&auml;rmeenergie</div>
          <div class="text-4xl font-extrabold" id="bme-heat">0</div>
          <div class="text-sm text-blue-200 mt-1">kWh</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bruttoenergie</div><div class="text-xl font-bold" id="bme-gross">0 kWh</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Auml;quivalent MWh</div><div class="text-xl font-bold" id="bme-kwh">0 MWh</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro kWh</div><div class="text-xl font-bold" id="bme-cperm">0 Ct</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Auml;quivalent Liter Heiz&ouml;l</div><div class="text-xl font-bold" id="bme-propane">0 l</div></div>
        </div>
      </div>
      <ShareButton calculatorId="biomass-energy" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Biomasseenergie verstehen</h2>
      <p>Biomasseenergie stammt aus organischen Materialien wie Holz, Feldpflanzen und Abf&auml;llen. Die tats&auml;chlich nutzbare W&auml;rme h&auml;ngt vom Feuchtegehalt (der den Heizwert reduziert) und der Verbrennungseffizienz ab. H&ouml;here Feuchtigkeit verringert die Nettoenergie, da Wasser verdampft werden muss. Holzpellets sind beliebt aufgrund ihres niedrigen Feuchtegehalts (typisch 5&ndash;10%) und einer konstanten Energiedichte von etwa 4.800 kWh pro Tonne.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const bmeData: Record<string, number> = { hardwood: 1900, softwood: 1400, pellets: 4800, chips: 2900, corn: 400, switchgrass: 4100, biogas: 6000 };
    function calcBME() {
      const type = (document.getElementById('bme-type') as HTMLSelectElement).value;
      const qty = parseFloat((document.getElementById('bme-qty') as HTMLInputElement).value) || 1;
      const moist = parseFloat((document.getElementById('bme-moist') as HTMLInputElement).value) || 20;
      const eff = parseFloat((document.getElementById('bme-eff') as HTMLInputElement).value) || 80;
      const cost = parseFloat((document.getElementById('bme-cost') as HTMLInputElement).value) || 0;
      const baseKWh = bmeData[type] || 4800;
      const moistFactor = 1 - (moist / 100) * 1.1;
      const grossEnergy = baseKWh * qty * Math.max(moistFactor, 0.1);
      const usableHeat = grossEnergy * (eff / 100);
      const mwh = usableHeat / 1000;
      const totalCost = cost * qty;
      const costPerKWh = usableHeat > 0 ? (totalCost / usableHeat) * 100 : 0;
      const heizoel = usableHeat / 10;
      document.getElementById('bme-heat')!.textContent = Math.round(usableHeat).toLocaleString('de-DE');
      document.getElementById('bme-gross')!.textContent = Math.round(grossEnergy).toLocaleString('de-DE') + ' kWh';
      document.getElementById('bme-kwh')!.textContent = mwh.toFixed(1).replace('.', ',') + ' MWh';
      document.getElementById('bme-cperm')!.textContent = costPerKWh.toFixed(1).replace('.', ',') + ' Ct';
      document.getElementById('bme-propane')!.textContent = Math.round(heizoel).toLocaleString('de-DE') + ' l';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.bme-in').forEach(el => { el.addEventListener('input', calcBME); el.addEventListener('change', calcBME); }); calcBME(); }, 50);
  </script>
</CalculatorLayout>
