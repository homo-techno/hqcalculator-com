---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Elektrokosten-Rechner - Gerätekosten & Stromverbrauch";
const description = "Berechnen Sie die Stromkosten einzelner Elektrogeräte basierend auf Leistung, Nutzungsdauer und Stromtarif. Tages-, Monats- und Jahreskosten.";

const relatedCalcs = [
  { name: "Stromrechnung-Rechner", url: "/de/stromrechnung-rechner", description: "Stromrechnung prüfen." },
  { name: "Stromkosten-Rechner", url: "/de/stromkosten-rechner", description: "Gesamtstromkosten." },
  { name: "Energieeffizienz-Rechner", url: "/de/energieeffizienz-rechner", description: "Effizienz berechnen." },
  { name: "Elektrofahrzeug-Rechner", url: "/de/elektrofahrzeug-rechner", description: "E-Auto Kosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Elektrokosten-Rechner" lang="de" enSlug="electrical-cost-calculator" keywords="elektrokosten rechner, stromkosten gerät, stromverbrauch berechnen, watt kosten, geräte stromkosten" breadcrumbs={[{ name: "Elektrokosten-Rechner", url: "/de/elektrokosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Elektrokosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Stromkosten eines einzelnen Ger&auml;tes nach Leistung und Nutzungsdauer.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Leistung (Watt)</label><input type="number" id="elk-watt" class="elk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="10" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nutzung (Stunden/Tag)</label><input type="number" id="elk-hours" class="elk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0" max="24"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (&euro;/kWh)</label><input type="number" id="elk-rate" class="elk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.01" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nutzungstage pro Monat</label><input type="number" id="elk-days" class="elk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" max="31"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Kosten</div>
          <div class="text-5xl font-extrabold font-mono" id="elk-result">0,00 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Tag</div><div class="text-xl font-bold" id="elk-day">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Jahr</div><div class="text-xl font-bold" id="elk-year">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">kWh/Tag</div><div class="text-xl font-bold" id="elk-kwhday">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">kWh/Jahr</div><div class="text-xl font-bold" id="elk-kwhyear">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="elk-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="electrical-cost-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Ger&auml;te-Stromkosten berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>kWh/Tag = Watt &times; Stunden / 1000</p>
        <p>Kosten/Tag = kWh/Tag &times; Strompreis</p>
        <p>Monatskosten = Kosten/Tag &times; Nutzungstage</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie finde ich die Leistung meines Ger&auml;ts?</strong> Die Wattzahl steht meist auf dem Typenschild oder in der Bedienungsanleitung.</p>
      <p><strong>Was kostet ein Ger&auml;t im Standby?</strong> Standby-Verbrauch liegt typisch bei 0,5&ndash;5 Watt, das ergibt 1&ndash;13 &euro; pro Jahr.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcElk() {
      const watt = parseFloat((document.getElementById('elk-watt') as HTMLInputElement).value) || 0;
      const hours = parseFloat((document.getElementById('elk-hours') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('elk-rate') as HTMLInputElement).value) || 0;
      const days = parseFloat((document.getElementById('elk-days') as HTMLInputElement).value) || 30;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const kwhDay = watt * hours / 1000;
      steps.push('kWh/Tag = ' + watt + ' W x ' + hours + ' h / 1000 = ' + fmt(kwhDay));
      const costDay = kwhDay * rate;
      steps.push('Kosten/Tag = ' + fmt(kwhDay) + ' kWh x ' + fmt(rate) + ' EUR/kWh = ' + fmt(costDay) + ' EUR');
      const costMonth = costDay * days;
      steps.push('Monatskosten = ' + fmt(costDay) + ' x ' + days + ' Tage = ' + fmt(costMonth) + ' EUR');
      const kwhYear = kwhDay * 365;
      const costYear = costDay * 365;
      steps.push('kWh/Jahr = ' + fmt(kwhDay) + ' x 365 = ' + fmt(kwhYear));
      steps.push('Jahreskosten = ' + fmt(costDay) + ' x 365 = ' + fmt(costYear) + ' EUR');
      document.getElementById('elk-result')!.textContent = fmt(costMonth) + ' \u20AC';
      document.getElementById('elk-day')!.textContent = fmt(costDay) + ' \u20AC';
      document.getElementById('elk-year')!.textContent = fmt(costYear) + ' \u20AC';
      document.getElementById('elk-kwhday')!.textContent = fmt(kwhDay);
      document.getElementById('elk-kwhyear')!.textContent = fmt(kwhYear);
      document.getElementById('elk-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('elk-watt') as HTMLInputElement).value = '2000';
      (document.getElementById('elk-hours') as HTMLInputElement).value = '2';
      (document.getElementById('elk-rate') as HTMLInputElement).value = '0.30';
      (document.getElementById('elk-days') as HTMLInputElement).value = '30';
      document.querySelectorAll('.elk-in').forEach(el => { el.addEventListener('input', calcElk); el.addEventListener('change', calcElk); });
      calcElk();
    }, 50);
  </script>
</CalculatorLayout>
