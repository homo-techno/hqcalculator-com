---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schrank-Rechner - K&uuml;chenschr&auml;nke berechnen";
const description = "Berechnen Sie die ben&ouml;tigte Anzahl K&uuml;chenschr&auml;nke, laufende Meter und Kostensch&auml;tzungen f&uuml;r Ihre K&uuml;chenrenovierung.";
const relatedCalcs = [
  { name: "Fl&auml;chenrechner", url: "/de/flaechenrechner", description: "Fl&auml;chen berechnen." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
  { name: "Ziegel-Rechner", url: "/de/ziegel-rechner", description: "Ziegel berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Schrank-Rechner" lang="de" enSlug="cabinet-calculator" keywords="k&uuml;chenschrank rechner, schrankkosten, laufende meter, k&uuml;chenplanung" breadcrumbs={[{ name: "Schrank-Rechner", url: "/de/schrank-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schrank-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie den Schrankbedarf f&uuml;r Ihr K&uuml;chenprojekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">K&uuml;chenwandl&auml;nge (laufende Meter)</label><input type="number" id="cb-lin" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="0.5"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schrankqualit&auml;t</label>
            <select id="cb-grade" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="300">Standard (300 &euro;/lfm)</option>
              <option value="600" selected>Mittelklasse (600 &euro;/lfm)</option>
              <option value="1200">Ma&szlig;anfertigung (1.200 &euro;/lfm)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Oberschrank-Anteil %</label><input type="number" id="cb-upper" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">&Ouml;ffnungen abziehen (m)</label><input type="number" id="cb-open" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">K&uuml;cheninsel L&auml;nge (m)</label><input type="number" id="cb-island" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Schr&auml;nke</div>
          <div class="text-5xl font-extrabold font-mono" id="cb-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Unterschr.</div><div class="text-xl font-bold font-mono" id="cb-base">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Oberschr.</div><div class="text-xl font-bold font-mono" id="cb-up">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Netto lfm</div><div class="text-xl font-bold font-mono" id="cb-net">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schrankkosten</div><div class="text-xl font-bold font-mono" id="cb-cost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Montage (~200 &euro;/lfm)</div><div class="text-xl font-bold font-mono" id="cb-inst">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="cabinet" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">K&uuml;chenschr&auml;nke planen</h2>
      <p>Standardunterschr&auml;nke sind 60 cm breit, Oberschr&auml;nke 60-80 cm. Die Kosten variieren stark je nach Material und Hersteller. Rechnen Sie mit 300-1.500 &euro; pro laufendem Meter inkl. Montage in der DACH-Region.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcCB() {
      const lin = parseFloat((document.getElementById('cb-lin') as HTMLInputElement).value) || 0;
      const grade = parseFloat((document.getElementById('cb-grade') as HTMLSelectElement).value);
      const upperPct = parseFloat((document.getElementById('cb-upper') as HTMLInputElement).value) / 100;
      const openings = parseFloat((document.getElementById('cb-open') as HTMLInputElement).value) || 0;
      const island = parseFloat((document.getElementById('cb-island') as HTMLInputElement).value) || 0;
      const netBase = Math.max(0, lin - openings) + island;
      const netUpper = Math.max(0, lin - openings) * upperPct;
      const baseCabs = Math.ceil(netBase / 0.6);
      const upperCabs = Math.ceil(netUpper / 0.7);
      const totalCabs = baseCabs + upperCabs;
      const totalLM = netBase + netUpper;
      const cabCost = totalLM * grade;
      const installCost = totalLM * 200;
      const fmtEur = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('cb-result')!.textContent = totalCabs.toString();
      document.getElementById('cb-base')!.textContent = baseCabs.toString();
      document.getElementById('cb-up')!.textContent = upperCabs.toString();
      document.getElementById('cb-net')!.textContent = totalLM.toFixed(1).replace('.', ',') + ' lfm';
      document.getElementById('cb-cost')!.textContent = fmtEur(cabCost);
      document.getElementById('cb-inst')!.textContent = fmtEur(installCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cb-lin') as HTMLInputElement).value = '6';
      (document.getElementById('cb-upper') as HTMLInputElement).value = '60';
      (document.getElementById('cb-open') as HTMLInputElement).value = '1.8';
      (document.getElementById('cb-island') as HTMLInputElement).value = '1.2';
      document.querySelectorAll('.cb-in').forEach(el => { el.addEventListener('input', calcCB); el.addEventListener('change', calcCB); });
      calcCB();
    }, 50);
  </script>
</CalculatorLayout>
