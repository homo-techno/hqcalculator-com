---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "BPM-Rechner - Beats pro Minute & Tap Tempo";
const description = "Berechnen Sie Beats pro Minute per Tap Tempo, finden Sie ms pro Beat, Takte pro Minute und Tempobezeichnungen wie Allegro oder Adagio.";
const relatedCalcs = [
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Bowling-Punkte-Rechner", url: "/de/bowling-punkte-rechner", description: "Bowling-Punkte." },
  { name: "Boxreichweite-Rechner", url: "/de/boxreichweite-rechner", description: "Boxreichweite." },
  { name: "Boolesche-Algebra-Rechner", url: "/de/boolesche-algebra-rechner", description: "Logik." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwerte." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="BPM-Rechner" enSlug="bpm-calculator" keywords="BPM Rechner, Beats pro Minute, Tap Tempo, Tempobezeichnung, ms pro Beat, Takte pro Minute" breadcrumbs={[{ name: "BPM-Rechner", url: "/de/bpm-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">BPM-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Beats pro Minute per Tap Tempo oder manueller Eingabe. Finden Sie ms pro Beat, Takte pro Minute und Tempobezeichnungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">BPM (Beats pro Minute)</label>
          <input type="number" id="bpm-bpm" class="bpm-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="1" max="999" step="0.1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Taktart (Beats pro Takt)</label>
          <select id="bpm-sig" class="bpm-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="2">2/4</option>
            <option value="3">3/4</option>
            <option value="4" selected>4/4</option>
            <option value="6">6/8</option>
          </select>
        </div>
        <div>
          <button id="bpm-tap" class="w-full px-6 py-4 bg-blue-600 hover:bg-blue-700 text-white text-xl font-bold rounded-xl transition-colors">TAP TEMPO</button>
          <p class="text-xs text-text-muted mt-1 text-center" id="bpm-tap-info">Tippen Sie rhythmisch auf den Button, um BPM zu erkennen</p>
        </div>
        <button id="bpm-reset" class="w-full px-4 py-2 border border-border rounded-xl text-sm font-bold hover:bg-gray-50">Tap zurücksetzen</button>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Tempo</div>
          <div class="text-4xl font-extrabold font-mono" id="bpm-result">0 BPM</div>
          <div class="text-sm text-blue-200 mt-1" id="bpm-marking">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ms pro Beat</div><div class="text-xl font-bold font-mono" id="bpm-ms">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Takte pro Minute</div><div class="text-xl font-bold font-mono" id="bpm-bars">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beats pro Sekunde</div><div class="text-xl font-bold font-mono" id="bpm-bps">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Frequenz (Hz)</div><div class="text-xl font-bold font-mono" id="bpm-hz">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ganze Note</div><div class="text-lg font-bold font-mono" id="bpm-whole">0 ms</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Halbe Note</div><div class="text-lg font-bold font-mono" id="bpm-half">0 ms</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Achtel Note</div><div class="text-lg font-bold font-mono" id="bpm-eighth">0 ms</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="bpm" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Tempobezeichnungen in der Musik</h2>
      <p>Tempobezeichnungen stammen aus dem Italienischen und geben die Geschwindigkeit eines Musikstücks an. Largo (40-60 BPM) ist sehr langsam, Andante (73-77 BPM) ist Schrittgeschwindigkeit, Allegro (120-156 BPM) ist schnell und Presto (168-200 BPM) ist sehr schnell.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const bpmTapTimes: number[] = [];
    function getBpmTempoMarking(bpm: number): string {
      if (bpm < 24) return "Larghissimo (sehr sehr langsam)";
      if (bpm < 40) return "Grave (sehr langsam)";
      if (bpm < 45) return "Largo (langsam und breit)";
      if (bpm < 50) return "Lento (langsam)";
      if (bpm < 55) return "Larghetto (etwas langsam)";
      if (bpm < 65) return "Adagio (langsam und ausdrucksvoll)";
      if (bpm < 69) return "Adagietto (langsamer als Andante)";
      if (bpm < 73) return "Andante (Schrittgeschwindigkeit)";
      if (bpm < 78) return "Andantino (etwas schneller als Andante)";
      if (bpm < 86) return "Marcia moderato (m\u00e4\u00dfiger Marsch)";
      if (bpm < 98) return "Moderato (m\u00e4\u00dfig)";
      if (bpm < 109) return "Allegretto (m\u00e4\u00dfig schnell)";
      if (bpm < 120) return "Allegro moderato (fast Allegro)";
      if (bpm < 156) return "Allegro (schnell und lebhaft)";
      if (bpm < 176) return "Vivace (lebhaft und schnell)";
      if (bpm < 200) return "Presto (sehr schnell)";
      return "Prestissimo (extrem schnell)";
    }
    function calcBPM() {
      const bpm = parseFloat((document.getElementById('bpm-bpm') as HTMLInputElement).value) || 0;
      const sig = parseInt((document.getElementById('bpm-sig') as HTMLSelectElement).value);
      if (bpm <= 0) {
        document.getElementById('bpm-result')!.textContent = '0 BPM';
        document.getElementById('bpm-marking')!.textContent = '--';
        return;
      }
      const msPerBeat = 60000 / bpm;
      const barsPerMin = bpm / sig;
      const bps = bpm / 60;
      document.getElementById('bpm-result')!.textContent = bpm.toFixed(1) + ' BPM';
      document.getElementById('bpm-marking')!.textContent = getBpmTempoMarking(bpm);
      document.getElementById('bpm-ms')!.textContent = msPerBeat.toFixed(1) + ' ms';
      document.getElementById('bpm-bars')!.textContent = barsPerMin.toFixed(2);
      document.getElementById('bpm-bps')!.textContent = bps.toFixed(3);
      document.getElementById('bpm-hz')!.textContent = bps.toFixed(4) + ' Hz';
      document.getElementById('bpm-whole')!.textContent = (msPerBeat * 4).toFixed(0) + ' ms';
      document.getElementById('bpm-half')!.textContent = (msPerBeat * 2).toFixed(0) + ' ms';
      document.getElementById('bpm-eighth')!.textContent = (msPerBeat / 2).toFixed(0) + ' ms';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bpm-bpm') as HTMLInputElement).value = '120';
      document.querySelectorAll('.bpm-in').forEach(el => { el.addEventListener('input', calcBPM); el.addEventListener('change', calcBPM); });
      document.getElementById('bpm-tap')!.addEventListener('click', () => {
        const now = performance.now();
        bpmTapTimes.push(now);
        if (bpmTapTimes.length > 8) bpmTapTimes.shift();
        if (bpmTapTimes.length >= 2) {
          let totalInterval = 0;
          for (let i = 1; i < bpmTapTimes.length; i++) {
            totalInterval += bpmTapTimes[i] - bpmTapTimes[i - 1];
          }
          const avgInterval = totalInterval / (bpmTapTimes.length - 1);
          const detectedBPM = 60000 / avgInterval;
          (document.getElementById('bpm-bpm') as HTMLInputElement).value = detectedBPM.toFixed(1);
          document.getElementById('bpm-tap-info')!.textContent = 'Taps: ' + bpmTapTimes.length + ' | Avg Intervall: ' + avgInterval.toFixed(0) + ' ms';
          calcBPM();
        } else {
          document.getElementById('bpm-tap-info')!.textContent = 'Nochmal tippen...';
        }
      });
      document.getElementById('bpm-reset')!.addEventListener('click', () => {
        bpmTapTimes.length = 0;
        document.getElementById('bpm-tap-info')!.textContent = 'Tippen Sie rhythmisch auf den Button, um BPM zu erkennen';
      });
      calcBPM();
    }, 50);
  </script>
</CalculatorLayout>
