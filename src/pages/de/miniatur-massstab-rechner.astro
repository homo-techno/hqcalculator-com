---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Miniatur-Maßstab Rechner - Modelle & Tabletop-Miniaturen";
const description = "Berechnen Sie Modellgrößen für Tabletop-Miniaturen, Modelleisenbahnen und Dioramen. Wechseln Sie zwischen realer Größe und Modellgröße für alle gängigen Maßstäbe.";

const relatedCalcs = [
  { name: "Maßstab-Rechner", url: "/de/massstab-rechner", description: "Maßstäbe berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Verhältnisrechner", url: "/de/verhaeltnisrechner", description: "Verhältnis berechnen." },
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Fläche berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="miniature-scale-calculator" calculatorName="Miniatur-Maßstab Rechner" keywords="Miniatur Maßstab, Tabletop Miniaturen, Modelleisenbahn Maßstab, Diorama, Warhammer Maßstab, H0 Maßstab" breadcrumbs={[{ name: "Miniatur-Maßstab Rechner", url: "/de/miniatur-massstab-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Miniatur-Maßstab Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen realer Größe und Modellgröße für alle gängigen Maßstäbe – von Tabletop-Spielen bis zur Modellbahn.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-2">Gängige Maßstäbe</label>
          <div class="grid grid-cols-3 gap-2">
            <button class="mm-preset-btn py-2 px-3 rounded-lg text-xs font-semibold bg-surface-alt text-text hover:bg-primary hover:text-white transition-colors cursor-pointer" data-scale="28">28mm (Warhammer)</button>
            <button class="mm-preset-btn py-2 px-3 rounded-lg text-xs font-semibold bg-surface-alt text-text hover:bg-primary hover:text-white transition-colors cursor-pointer" data-scale="15">15mm (Historisch)</button>
            <button class="mm-preset-btn py-2 px-3 rounded-lg text-xs font-semibold bg-surface-alt text-text hover:bg-primary hover:text-white transition-colors cursor-pointer" data-scale="6">6mm (Epic)</button>
            <button class="mm-preset-btn py-2 px-3 rounded-lg text-xs font-semibold bg-surface-alt text-text hover:bg-primary hover:text-white transition-colors cursor-pointer" data-scale="1.25">1:80 H0</button>
            <button class="mm-preset-btn py-2 px-3 rounded-lg text-xs font-semibold bg-surface-alt text-text hover:bg-primary hover:text-white transition-colors cursor-pointer" data-scale="1.6">1:64 S</button>
            <button class="mm-preset-btn py-2 px-3 rounded-lg text-xs font-semibold bg-surface-alt text-text hover:bg-primary hover:text-white transition-colors cursor-pointer" data-scale="1.1">1:87 H0 (exakt)</button>
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Maßstab (1 : X)</label>
          <input type="number" id="mm-scale" class="mm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" value="56">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Reale Größe (mm)</label>
            <input type="number" id="mm-real" class="mm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" value="1800">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Modellgröße (mm)</label>
            <input type="number" id="mm-model" class="mm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Modellgröße</div>
          <div class="text-5xl font-extrabold font-mono" id="mm-result">— mm</div>
          <div class="text-sm text-blue-200 mt-1" id="mm-result-sub"></div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Maßstab</div>
            <div class="text-xl font-bold" id="mm-ratio">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Real (m)</div>
            <div class="text-xl font-bold" id="mm-real-m">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Modell (cm)</div>
            <div class="text-xl font-bold" id="mm-model-cm">—</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="miniature-scale" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="mt-10 bg-white border border-border rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-text mb-4">Gängige Miniaturmaßstäbe</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-4 font-semibold">Bezeichnung</th><th class="py-2 pr-4 font-semibold">Maßstab</th><th class="py-2 pr-4 font-semibold">Figur 1,80m</th><th class="py-2 font-semibold">Verwendung</th></tr></thead>
          <tbody class="text-text-secondary">
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">2mm / 1:900</td><td class="py-2 pr-4">1:900</td><td class="py-2 pr-4">2 mm</td><td class="py-2">Seestrategien</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">6mm / Epic</td><td class="py-2 pr-4">1:300</td><td class="py-2 pr-4">6 mm</td><td class="py-2">Massenscblachten</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">15mm</td><td class="py-2 pr-4">1:120</td><td class="py-2 pr-4">15 mm</td><td class="py-2">Historische Wargames</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">28mm</td><td class="py-2 pr-4">1:56</td><td class="py-2 pr-4">32 mm</td><td class="py-2">Warhammer, D&D</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">32mm</td><td class="py-2 pr-4">1:50</td><td class="py-2 pr-4">36 mm</td><td class="py-2">Heroic-Scale-Modelle</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">H0 Modellbahn</td><td class="py-2 pr-4">1:87</td><td class="py-2 pr-4">20,7 mm</td><td class="py-2">Modelleisenbahnstandard</td></tr>
            <tr><td class="py-2 pr-4 font-medium">N Modellbahn</td><td class="py-2 pr-4">1:160</td><td class="py-2 pr-4">11,3 mm</td><td class="py-2">Kleinspur Modellbahn</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was bedeutet 28mm-Maßstab bei Tabletop-Miniaturen?</p>
          <p>28mm bezieht sich auf die Augenhöhe einer menschlichen Figur. Dies entspricht ungefähr einem Maßstab von 1:56 bis 1:64 für eine reale Person von 1,80 m. Der Brustbereich liegt bei ca. 32-35 mm.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen heroic scale und true scale?</p>
          <p>True scale gibt reale Proportionen wieder. Heroic scale verwendet überproportionierte Hände, Köpfe und Waffen für bessere Sichtbarkeit und Bemalung. Warhammer 40.000 ist bekannt für seinen heroic scale.</p>
        </div>
        <div>
          <p class="font-semibold">Wie berechne ich die Modellgröße?</p>
          <p>Modellgröße = Reale Größe / Maßstab. Ein Panzer von 8 m Länge in 1:35 wird: 8000 mm / 35 = 228,6 mm Modell. Umgekehrt: Reale Größe = Modellgröße × Maßstab.</p>
        </div>
        <div>
          <p class="font-semibold">Welcher Maßstab ist am verbreitetsten bei Modelleisenbahnen?</p>
          <p>H0 (1:87) ist weltweit der beliebteste Modellbahnmaßstab. In Deutschland ist H0 mit Abstand am häufigsten. N-Spur (1:160) gewinnt durch platzsparende Anlagen an Beliebtheit.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let mmLastChanged = 'real';

    function calcMm() {
      const scale = parseFloat((document.getElementById('mm-scale') as HTMLInputElement).value) || 56;
      const realVal = parseFloat((document.getElementById('mm-real') as HTMLInputElement).value);
      const modelVal = parseFloat((document.getElementById('mm-model') as HTMLInputElement).value);

      const fmt = (v: number, dec = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });

      let modelMm: number;
      let realMm: number;

      if (mmLastChanged === 'real' && !isNaN(realVal)) {
        realMm = realVal;
        modelMm = realMm / scale;
        (document.getElementById('mm-model') as HTMLInputElement).value = fmt(modelMm, 2).replace(',', '.');
      } else if (mmLastChanged === 'model' && !isNaN(modelVal)) {
        modelMm = modelVal;
        realMm = modelMm * scale;
        (document.getElementById('mm-real') as HTMLInputElement).value = fmt(realMm, 0).replace(',', '');
      } else {
        realMm = realVal || 1800;
        modelMm = realMm / scale;
      }

      document.getElementById('mm-result')!.textContent = fmt(modelMm, 2) + ' mm';
      document.getElementById('mm-result-sub')!.textContent = `Real: ${fmt(realMm, 0)} mm = ${fmt(realMm / 1000, 2)} m`;
      document.getElementById('mm-ratio')!.textContent = `1 : ${fmt(scale, 0)}`;
      document.getElementById('mm-real-m')!.textContent = fmt(realMm / 1000, 2) + ' m';
      document.getElementById('mm-model-cm')!.textContent = fmt(modelMm / 10, 2) + ' cm';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('mm-real')!.addEventListener('input', () => { mmLastChanged = 'real'; calcMm(); });
      document.getElementById('mm-model')!.addEventListener('input', () => { mmLastChanged = 'model'; calcMm(); });
      document.getElementById('mm-scale')!.addEventListener('input', calcMm);

      document.querySelectorAll('.mm-preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const s = (btn as HTMLElement).dataset.scale || '56';
          (document.getElementById('mm-scale') as HTMLInputElement).value = s;
          mmLastChanged = 'real';
          calcMm();
        });
      });
      calcMm();
    }, 50);
  </script>
</CalculatorLayout>
