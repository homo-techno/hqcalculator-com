---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Sinkrate-Rechner - Sinkflugplanung & FPM";
const description = "Berechnen Sie den Sinkflugbeginn, die erforderliche Sinkrate in FPM f\u00fcr einen 3-Grad-Gleitpfad und die Distanz zur Landebahn.";

const relatedCalcs = [
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Entfernung-Peilung-Rechner", url: "/de/entfernung-peilung-rechner", description: "GPS-Entfernung." },
  { name: "Tauchplanung-Rechner", url: "/de/tauchplanung-rechner", description: "Tauchplanung." },
  { name: "Beschleunigungsrechner", url: "/de/beschleunigungsrechner", description: "Beschleunigung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Sinkrate-Rechner" lang="de" enSlug="descent-rate-calculator" keywords="sinkrate rechner, sinkflugbeginn, fpm, gleitpfad, sinkflugplanung, vertikalgeschwindigkeit" breadcrumbs={[{ name: "Sinkrate-Rechner", url: "/de/sinkrate-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Sinkrate-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Sinkflugbeginn, erforderliche FPM und Sinkflugdistanz f&uuml;r eine gleichm&auml;&szlig;ige Anflugplanung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label for="skr-cruise" class="block text-sm font-medium text-text mb-1">Reiseflugh&ouml;he (ft MSL)</label>
          <input type="number" id="skr-cruise" class="skr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="500" />
        </div>
        <div>
          <label for="skr-field" class="block text-sm font-medium text-text mb-1">Platzh&ouml;he (ft MSL)</label>
          <input type="number" id="skr-field" class="skr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="100" />
        </div>
        <div>
          <label for="skr-gs" class="block text-sm font-medium text-text mb-1">Grundgeschwindigkeit (kts)</label>
          <input type="number" id="skr-gs" class="skr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5" />
        </div>
        <div>
          <label for="skr-angle" class="block text-sm font-medium text-text mb-1">Sinkwinkel (Grad)</label>
          <input type="number" id="skr-angle" class="skr-in w-full border border-border rounded-lg px-3 py-2" min="1" max="10" step="0.5" />
        </div>
        <div>
          <label for="skr-pattern" class="block text-sm font-medium text-text mb-1">Platzrundenh&ouml;he AGL (ft)</label>
          <input type="number" id="skr-pattern" class="skr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="100" />
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Erforderliche Sinkrate</div>
          <div class="text-5xl font-extrabold font-mono" id="skr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sinkflugbeginn</div>
            <div class="text-xl font-bold font-mono" id="skr-tod">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sinkflugdistanz</div>
            <div class="text-xl font-bold font-mono" id="skr-dist">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">H&ouml;he zu verlieren</div>
            <div class="text-xl font-bold font-mono" id="skr-alt">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sinkflugzeit</div>
            <div class="text-xl font-bold font-mono" id="skr-time">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Faustregel (3x H&ouml;he in 1000ern)</div>
          <div class="text-lg font-bold font-mono" id="skr-rule">--</div>
        </div>
      </div>
      <ShareButton calculatorId="descent-rate-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Sinkflugplanung</h2>
      <p>Eine gute Sinkflugplanung sorgt f&uuml;r einen gleichm&auml;&szlig;igen, komfortablen und treibstoffsparenden Anflug. Die Faustregel: Sinkflugbeginn bei 3&times; der zu verlierenden H&ouml;he (in Tausenden) in NM.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist eine typische Sinkrate?</strong> F&uuml;r Kleinflugzeuge ca. 500 FPM, f&uuml;r Verkehrsflugzeuge ca. 1.500-2.000 FPM im Reiseflug-Sinkflug.</p>
      <p><strong>Was bedeutet 3-Grad-Gleitpfad?</strong> Der Standard-ILS-Gleitpfad betr&auml;gt 3 Grad. Das ergibt bei 120 kts eine Sinkrate von ca. 640 FPM.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSKR() {
      const cruise = parseFloat((document.getElementById('skr-cruise') as HTMLInputElement).value) || 10000;
      const field = parseFloat((document.getElementById('skr-field') as HTMLInputElement).value) || 500;
      const gs = parseFloat((document.getElementById('skr-gs') as HTMLInputElement).value) || 120;
      const angle = parseFloat((document.getElementById('skr-angle') as HTMLInputElement).value) || 3;
      const pattern = parseFloat((document.getElementById('skr-pattern') as HTMLInputElement).value) || 1000;

      const targetAlt = field + pattern;
      const altToLose = cruise - targetAlt;
      const gsFtMin = gs * 6076.12 / 60;
      const descentRate = gsFtMin * Math.tan(angle * Math.PI / 180);
      const descentTimeMin = altToLose > 0 && descentRate > 0 ? altToLose / descentRate : 0;
      const descentDist = (gs / 60) * descentTimeMin;
      const ruleOfThumb = (altToLose / 1000) * 3;
      const mins = Math.floor(descentTimeMin);
      const secs = Math.round((descentTimeMin - mins) * 60);

      document.getElementById('skr-result')!.textContent = Math.round(descentRate) + ' FPM';
      document.getElementById('skr-tod')!.textContent = descentDist.toFixed(1).replace('.', ',') + ' NM vom Platz';
      document.getElementById('skr-dist')!.textContent = descentDist.toFixed(1).replace('.', ',') + ' NM';
      document.getElementById('skr-alt')!.textContent = altToLose.toLocaleString('de-DE') + ' ft';
      document.getElementById('skr-time')!.textContent = mins + ' Min ' + secs + ' Sek';
      document.getElementById('skr-rule')!.textContent = 'Sinkflug beginnen ~' + ruleOfThumb.toFixed(0) + ' NM vorher';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('skr-cruise') as HTMLInputElement).value = '10000';
      (document.getElementById('skr-field') as HTMLInputElement).value = '500';
      (document.getElementById('skr-gs') as HTMLInputElement).value = '120';
      (document.getElementById('skr-angle') as HTMLInputElement).value = '3';
      (document.getElementById('skr-pattern') as HTMLInputElement).value = '1000';
      document.querySelectorAll('.skr-in').forEach(el => { el.addEventListener('input', calcSKR); el.addEventListener('change', calcSKR); });
      calcSKR();
    }, 50);
  </script>
</CalculatorLayout>
