---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schriftgr&ouml;&szlig;e-Rechner - pt, px, em, rem & Zeilenh&ouml;he umrechnen";
const description = "Rechnen Sie zwischen Schriftgr&ouml;&szlig;en-Einheiten um: Punkt (pt), Pixel (px), em, rem. Berechnen Sie Zeilenh&ouml;he, x-H&ouml;he und Versal-H&ouml;he.";
const relatedCalcs = [
  { name: "Typografie-Skala", url: "/de/typografie-skala-rechner", description: "Modulare Typoskalen." },
  { name: "Druckaufl&ouml;sung", url: "/de/druckaufloesung-rechner", description: "DPI/PPI-Berechnung." },
  { name: "Postergr&ouml;&szlig;e", url: "/de/postergroesse-rechner", description: "Postergr&ouml;&szlig;e und DPI." },
  { name: "Seitenformat", url: "/de/seitenformat-rechner", description: "Seitenplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Schriftgr&ouml;&szlig;e-Rechner" lang="de" enSlug="font-size-calculator" keywords="Schriftgr&ouml;&szlig;e Umrechner, pt zu px, em zu rem, Zeilenh&ouml;he, x-H&ouml;he, Typografie Einheiten" breadcrumbs={[{ name: "Schriftgr&ouml;&szlig;e-Rechner", url: "/de/schriftgroesse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schriftgr&ouml;&szlig;e-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen Schriftgr&ouml;&szlig;en (pt, px, em, rem) um und berechnen Sie Zeilenh&ouml;he und x-H&ouml;he f&uuml;r optimale Typografie.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schriftgr&ouml;&szlig;e</label><input type="number" id="sgr-value" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Eingabeeinheit</label>
            <select id="sgr-unit" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="pt">Punkt (pt)</option>
              <option value="px">Pixel (px)</option>
              <option value="em">Em</option>
              <option value="rem">Rem</option>
              <option value="mm">Millimeter (mm)</option>
              <option value="in">Zoll (in)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Basis-Schriftgr&ouml;&szlig;e (px)</label><input type="number" id="sgr-base" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bildschirm-DPI/PPI</label><input type="number" id="sgr-dpi" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Zeilenh&ouml;he-Multiplikator</label><input type="number" id="sgr-lh" class="sgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.5" step="0.05"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Umgerechnete Gr&ouml;&szlig;en</div>
          <div class="text-3xl font-extrabold font-mono" id="sgr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Punkt (pt)</div><div class="text-xl font-bold" id="sgr-pt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pixel (px)</div><div class="text-xl font-bold" id="sgr-px">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Em</div><div class="text-xl font-bold" id="sgr-em">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rem</div><div class="text-xl font-bold" id="sgr-rem">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Millimeter</div><div class="text-xl font-bold" id="sgr-mm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zoll</div><div class="text-xl font-bold" id="sgr-inch">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeilenh&ouml;he</div><div class="text-xl font-bold" id="sgr-lineheight">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">x-H&ouml;he (ca.)</div><div class="text-xl font-bold" id="sgr-xheight">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="font-size" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Was ist der Unterschied zwischen pt und px?</strong> 1 pt = 1/72 Zoll (druckunabh&auml;ngig), 1 px = 1/96 Zoll (bei 96 DPI, bildschirmabh&auml;ngig).</p>
      <p><strong>Was sind em und rem?</strong> Em bezieht sich auf die Eltern-Schriftgr&ouml;&szlig;e, rem auf die Wurzel-Schriftgr&ouml;&szlig;e (html-Element).</p>
      <h2 class="text-2xl font-bold text-text mt-8">Umrechnungsformeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>1 pt = 1/72 Zoll = 0,3528 mm</p>
        <p>1 px = 1/96 Zoll (bei 96 DPI) = 0,75 pt</p>
        <p>1 em = Basis-Schriftgr&ouml;&szlig;e in px</p>
        <p>1 rem = Wurzel-Schriftgr&ouml;&szlig;e in px</p>
        <p>x-H&ouml;he ist ca. 0,5&times; der Schriftgr&ouml;&szlig;e</p>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSGR() {
      const value = parseFloat((document.getElementById('sgr-value') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('sgr-unit') as HTMLSelectElement).value;
      const base = parseFloat((document.getElementById('sgr-base') as HTMLInputElement).value) || 16;
      const dpi = parseFloat((document.getElementById('sgr-dpi') as HTMLInputElement).value) || 96;
      const lh = parseFloat((document.getElementById('sgr-lh') as HTMLInputElement).value) || 1.5;
      let px = 0;
      if (unit === 'px') px = value;
      else if (unit === 'pt') px = value * (dpi / 72);
      else if (unit === 'em') px = value * base;
      else if (unit === 'rem') px = value * base;
      else if (unit === 'mm') px = value * (dpi / 25.4);
      else if (unit === 'in') px = value * dpi;
      const pt = px * (72 / dpi);
      const em = base > 0 ? px / base : 0;
      const rem = base > 0 ? px / base : 0;
      const mm = px * (25.4 / dpi);
      const inch = px / dpi;
      const lineHeight = px * lh;
      const xHeight = pt * 0.5;
      const fmt = (v: number, d: number) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      document.getElementById('sgr-result')!.textContent = fmt(pt, 2) + ' pt = ' + fmt(px, 2) + ' px';
      document.getElementById('sgr-pt')!.textContent = fmt(pt, 2) + ' pt';
      document.getElementById('sgr-px')!.textContent = fmt(px, 2) + ' px';
      document.getElementById('sgr-em')!.textContent = fmt(em, 4) + ' em';
      document.getElementById('sgr-rem')!.textContent = fmt(rem, 4) + ' rem';
      document.getElementById('sgr-mm')!.textContent = fmt(mm, 2) + ' mm';
      document.getElementById('sgr-inch')!.textContent = fmt(inch, 4) + ' in';
      document.getElementById('sgr-lineheight')!.textContent = fmt(lineHeight, 1) + ' px';
      document.getElementById('sgr-xheight')!.textContent = fmt(xHeight, 1) + ' pt';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('sgr-value') as HTMLInputElement).value = '16';
      (document.getElementById('sgr-base') as HTMLInputElement).value = '16';
      (document.getElementById('sgr-dpi') as HTMLInputElement).value = '96';
      (document.getElementById('sgr-lh') as HTMLInputElement).value = '1.5';
      document.querySelectorAll('.sgr-in').forEach(el => { el.addEventListener('input', calcSGR); el.addEventListener('change', calcSGR); });
      calcSGR();
    }, 50);
  </script>
</CalculatorLayout>
