---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kreis-Rechner - Radius, Durchmesser, Flaeche, Umfang";
const description = "Berechnen Sie alle Kreiseigenschaften aus einem bekannten Wert: Radius, Durchmesser, Umfang oder Flaeche.";
const relatedCalcs = [
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
  { name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner", description: "Statistik." },
  { name: "Fliesengewicht-Rechner", url: "/de/fliesengewicht-rechner", description: "Fliesengewicht." },
  { name: "Keramikform-Rechner", url: "/de/keramikform-rechner", description: "Gipsformen." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
  { name: "Kaelteanlage-Rechner", url: "/de/kaelteanlage-rechner", description: "Kaelteleistung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kreis-Rechner" enSlug="circle-calculator" keywords="Kreis-Rechner, Kreisflaeche, Umfang, Radius, Durchmesser, Pi, Kreisberechnung" breadcrumbs={[{ name: "Kreis-Rechner", url: "/de/kreis-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kreis-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie einen beliebigen Wert ein, um alle Kreiseigenschaften zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bekannter Wert</label>
            <select id="kr2-mode" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="radius" selected>Radius</option>
              <option value="diameter">Durchmesser</option>
              <option value="area">Flaeche</option>
              <option value="circumference">Umfang</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Wert</label>
            <input type="number" id="kr2-val" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" min="0" step="0.1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-5 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs uppercase tracking-wide mb-1 opacity-80">Flaeche</div>
            <div class="text-2xl font-extrabold" id="kr2-area">0</div>
          </div>
          <div class="p-5 bg-secondary rounded-2xl text-white text-center">
            <div class="text-xs uppercase tracking-wide mb-1 opacity-80">Umfang</div>
            <div class="text-2xl font-extrabold" id="kr2-circ">0</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Radius</div><div class="text-xl font-bold" id="kr2-radius">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchmesser</div><div class="text-xl font-bold" id="kr2-diameter">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formeln</h3>
          <div class="font-mono text-sm space-y-1">
            <div>A = πr² = π × <span id="kr2-r-val">0</span>² = <span id="kr2-a-val">0</span></div>
            <div>U = 2πr = 2π × <span id="kr2-r-val2">0</span> = <span id="kr2-c-val">0</span></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kreis" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kreisformeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Flaeche = πr²</p><p>Umfang = 2πr = πd</p><p>r = d/2 = U/(2π) = √(A/π)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Was ist Pi (π)?</strong> Pi ist das Verhaeltnis von Umfang zu Durchmesser eines Kreises, ungefaehr 3,14159.</li>
        <li><strong>Wie haengen Radius und Durchmesser zusammen?</strong> Der Durchmesser ist immer doppelt so gross wie der Radius: d = 2r.</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKR2() {
      const mode = (document.getElementById('kr2-mode') as HTMLSelectElement).value;
      const val = parseFloat((document.getElementById('kr2-val') as HTMLInputElement).value) || 0;
      let r: number;
      if (mode === 'radius') r = val;
      else if (mode === 'diameter') r = val / 2;
      else if (mode === 'area') r = Math.sqrt(val / Math.PI);
      else r = val / (2 * Math.PI);
      const area = Math.PI * r * r;
      const circ = 2 * Math.PI * r;
      document.getElementById('kr2-area')!.textContent = area.toFixed(4);
      document.getElementById('kr2-circ')!.textContent = circ.toFixed(4);
      document.getElementById('kr2-radius')!.textContent = r.toFixed(4);
      document.getElementById('kr2-diameter')!.textContent = (r * 2).toFixed(4);
      document.getElementById('kr2-r-val')!.textContent = r.toFixed(2);
      document.getElementById('kr2-r-val2')!.textContent = r.toFixed(2);
      document.getElementById('kr2-a-val')!.textContent = area.toFixed(4);
      document.getElementById('kr2-c-val')!.textContent = circ.toFixed(4);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.getElementById('kr2-val')!.addEventListener('input', calcKR2); document.getElementById('kr2-mode')!.addEventListener('change', calcKR2); calcKR2(); }, 50);
  </script>
</CalculatorLayout>
