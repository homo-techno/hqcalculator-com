---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Wohnungseigentuemer Gebuehr Rechner - WEG Hausgeld 2026";
const description = "Berechne das Hausgeld fuer Wohnungseigentuemergemeinschaften. Analysiere Budget, Ruecklagendeckung und Sonderumlagen-Risiko.";

const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothekenrate berechnen." },
  { name: "Hauskauf-Leistbarkeit-Rechner", url: "/de/hauskauf-leistbarkeit-rechner", description: "Leistbarkeit pruefen." },
  { name: "Eigenkapital-Rechner", url: "/de/eigenkapital-rechner", description: "Eigenkapital berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Wohnungseigentuemer-Gebuehr-Rechner" keywords="Hausgeld Rechner, WEG Gebuehr, Wohnungseigentuemer, Instandhaltungsruecklage, Sonderumlage, Hausgeld berechnen" breadcrumbs={[{ name: "Wohnungseigentuemer-Gebuehr-Rechner", url: "/de/wohnungseigentuemer-gebuehr-rechner" }]} lang="de" enSlug="hoa-fee-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Wohnungseigentuemer-Gebuehr-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysiere das WEG-Budget, die Ruecklagendeckung und das Sonderumlagen-Risiko.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Einheiten</label><input type="number" id="weg-units" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="20" min="1" max="1000" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Monatliches Hausgeld (€)</label><input type="number" id="weg-fee" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="300" min="0" step="25"></div>
        </div>
        <h3 class="font-semibold text-sm text-text">Jaehrliche Budgetaufteilung</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versicherung (€)</label><input type="number" id="weg-ins" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8000" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gartenpflege (€)</label><input type="number" id="weg-landscape" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6000" min="0" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Betriebskosten (€)</label><input type="number" id="weg-utilities" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12000" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verwaltung (€)</label><input type="number" id="weg-mgmt" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9600" min="0" step="500"></div>
        </div>
        <h3 class="font-semibold text-sm text-text">Instandhaltungsruecklage</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktueller Ruecklagenstand (€)</label><input type="number" id="weg-reserve" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Empfohlene Ruecklage (€)</label><input type="number" id="weg-target" class="weg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80000" min="0" step="5000"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jaehrliches WEG-Budget</div>
          <div class="text-5xl font-extrabold font-mono" id="weg-budget">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatlich pro Einheit</div><div class="text-xl font-bold font-mono" id="weg-perunit">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jaehrlich pro Einheit</div><div class="text-xl font-bold font-mono" id="weg-annualunit">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ruecklage gedeckt %</div><div class="text-xl font-bold font-mono" id="weg-funded">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ruecklagenfehlbetrag</div><div class="text-xl font-bold font-mono" id="weg-shortfall">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ruecklage zu Ausgaben</div><div class="text-xl font-bold font-mono" id="weg-ratio">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sonderumlage-Risiko</div><div class="text-xl font-bold font-mono" id="weg-risk">--</div></div>
        </div>
      </div>

      <ShareButton calculatorId="hoa-fee" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Hausgeld in der WEG</h2>
      <p>Das Hausgeld ist die monatliche Zahlung der Wohnungseigentuemer an die Gemeinschaft. Es deckt laufende Kosten (Verwaltung, Versicherung, Betriebskosten) und speist die Instandhaltungsruecklage.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie hoch sollte das Hausgeld sein?</strong> Ein Richtwert sind 1-2 € pro m² Wohnflaeche im Monat. Bei aelteren Gebaeuden oder mit vielen Gemeinschaftseinrichtungen kann es hoeher liegen.</p>
      <p><strong>Was ist eine Sonderumlage?</strong> Eine Sonderumlage wird beschlossen, wenn unvorhergesehene Ausgaben anfallen und die Ruecklage nicht ausreicht. Sie wird zusaetzlich zum Hausgeld erhoben.</p>
      <p><strong>Wie hoch sollte die Instandhaltungsruecklage sein?</strong> Gemaess dem Wohnungseigentumsgesetz sind Ruecklagen vorgeschrieben. Empfohlen werden mindestens 1 % des Gebaeudewerts pro Jahr.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcWEG() {
      const units = parseFloat((document.getElementById('weg-units') as HTMLInputElement).value) || 1;
      const fee = parseFloat((document.getElementById('weg-fee') as HTMLInputElement).value) || 0;
      const ins = parseFloat((document.getElementById('weg-ins') as HTMLInputElement).value) || 0;
      const landscape = parseFloat((document.getElementById('weg-landscape') as HTMLInputElement).value) || 0;
      const utilities = parseFloat((document.getElementById('weg-utilities') as HTMLInputElement).value) || 0;
      const mgmt = parseFloat((document.getElementById('weg-mgmt') as HTMLInputElement).value) || 0;
      const reserve = parseFloat((document.getElementById('weg-reserve') as HTMLInputElement).value) || 0;
      const target = parseFloat((document.getElementById('weg-target') as HTMLInputElement).value) || 0;

      const annualBudget = fee * 12 * units;
      const totalExpenses = ins + landscape + utilities + mgmt;
      const annualPerUnit = fee * 12;
      const fundedPct = target > 0 ? (reserve / target) * 100 : 0;
      const shortfall = Math.max(0, target - reserve);
      const reserveToExpenses = totalExpenses > 0 ? (reserve / totalExpenses) * 100 : 0;

      let risk = 'Niedrig';
      if (fundedPct < 30) risk = 'Hoch';
      else if (fundedPct < 50) risk = 'Mittel';
      else if (fundedPct < 70) risk = 'Niedrig-Mittel';

      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';

      document.getElementById('weg-budget')!.textContent = fmt(annualBudget);
      document.getElementById('weg-perunit')!.textContent = fee.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
      document.getElementById('weg-annualunit')!.textContent = fmt(annualPerUnit);
      document.getElementById('weg-funded')!.textContent = fundedPct.toFixed(1) + '%';
      document.getElementById('weg-shortfall')!.textContent = fmt(shortfall);
      document.getElementById('weg-ratio')!.textContent = reserveToExpenses.toFixed(0) + '%';
      document.getElementById('weg-risk')!.textContent = risk;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.weg-in').forEach(el => {
        el.addEventListener('input', calcWEG);
        el.addEventListener('change', calcWEG);
      });
      calcWEG();
    }, 50);
  </script>
</CalculatorLayout>
