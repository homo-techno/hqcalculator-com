---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Interpolationsrechner – Lineare & Quadratische Interpolation";
const description = "Berechnen Sie lineare und quadratische Interpolation zwischen zwei Punkten.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentsätze berechnen." },
  { name: "Steigung Rechner", url: "/de/steigung-rechner", description: "Geradensteigung ermitteln." },
  { name: "Kinetische Energie Rechner", url: "/de/kinetische-energie-rechner", description: "Energie aus Masse & Geschwindigkeit." },
  { name: "Intervalltraining Rechner", url: "/de/intervalltraining-rechner", description: "HIIT-Einheiten planen." },
];
---
<CalculatorLayout lang="de" enSlug="interpolation-calculator" title={title} description={description} calculatorName="Interpolationsrechner" keywords="Interpolation, lineare Interpolation, Zwischenwert berechnen, Interpolationsformel, Extrapolation" breadcrumbs={[{ name: "Interpolationsrechner", url: "/de/interpolations-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Interpolationsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Zwischenwerte mithilfe linearer oder polynomieller Interpolation zwischen bekannten Datenpunkten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-text-muted uppercase mb-2">Punkt 1</p>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="block text-xs font-medium text-text mb-1">x₁</label><input type="number" id="ip-x1" class="ip-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="0"></div>
              <div><label class="block text-xs font-medium text-text mb-1">y₁</label><input type="number" id="ip-y1" class="ip-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="20"></div>
            </div>
          </div>
          <div>
            <p class="text-xs font-semibold text-text-muted uppercase mb-2">Punkt 2</p>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="block text-xs font-medium text-text mb-1">x₂</label><input type="number" id="ip-x2" class="ip-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="10"></div>
              <div><label class="block text-xs font-medium text-text mb-1">y₂</label><input type="number" id="ip-y2" class="ip-in w-full px-3 py-2 border border-border rounded-xl text-lg font-bold" value="80"></div>
            </div>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesuchter x-Wert</label><input type="number" id="ip-x" class="ip-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Interpolierter y-Wert</div>
          <div class="text-5xl font-extrabold font-mono" id="ip-result">—</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Steigung (m)</div><div class="text-xl font-bold font-mono" id="ip-slope">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Achsenabschnitt (b)</div><div class="text-xl font-bold font-mono" id="ip-intercept">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Position</div><div class="text-xl font-bold font-mono" id="ip-pos">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rechenweg</h3>
          <div class="font-mono text-sm space-y-1" id="ip-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="interpolation" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Lineare Interpolation erklärt</h2>
      <p class="text-text-secondary">Die lineare Interpolation schätzt Zwischenwerte auf einer Geraden zwischen zwei bekannten Punkten (x₁, y₁) und (x₂, y₂). Die Formel lautet: <strong>y = y₁ + (x − x₁) × (y₂ − y₁) / (x₂ − x₁)</strong>. Liegt der gesuchte x-Wert außerhalb des Intervalls [x₁, x₂], spricht man von Extrapolation – die Genauigkeit nimmt dabei ab.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>m = (y₂ − y₁) / (x₂ − x₁)</p>
        <p>y = y₁ + m × (x − x₁)</p>
        <p>Geradengleichung: y = m·x + b</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wann ist lineare Interpolation sinnvoll?</h4>
          <p class="text-text-secondary mt-1">Lineare Interpolation ist geeignet, wenn die Daten näherungsweise auf einer Geraden liegen oder wenn nur zwei Messpunkte verfügbar sind. Typische Anwendungen sind das Ablesen von Tabellenwerten, Umrechnungen und physikalische Berechnungen wie die Wärmedehnung.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist Extrapolation?</h4>
          <p class="text-text-secondary mt-1">Extrapolation bedeutet, die Gerade über die bekannten Datenpunkte hinaus zu verlängern, um Werte außerhalb des Messbereichs zu schätzen. Dies birgt höhere Unsicherheit, da die Linearität nicht mehr garantiert ist.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zur kubischen Spline-Interpolation?</h4>
          <p class="text-text-secondary mt-1">Kubische Splines passen zwischen mehreren Datenpunkten glatte Kurven an und sind besser für nichtlineare Zusammenhänge geeignet. Sie benötigen jedoch mindestens vier Punkte und sind rechnerisch aufwändiger als die lineare Interpolation.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">In welchen Bereichen wird Interpolation eingesetzt?</h4>
          <p class="text-text-secondary mt-1">Interpolation findet Anwendung in Physik, Ingenieurwissenschaften, Computergrafik (z.B. Farbverläufe), Geografie (DEM-Modelle), Finanzmathematik und der Computerspielentwicklung für flüssige Animationen.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcIP() {
      const x1 = parseFloat((document.getElementById('ip-x1') as HTMLInputElement).value);
      const y1 = parseFloat((document.getElementById('ip-y1') as HTMLInputElement).value);
      const x2 = parseFloat((document.getElementById('ip-x2') as HTMLInputElement).value);
      const y2 = parseFloat((document.getElementById('ip-y2') as HTMLInputElement).value);
      const x = parseFloat((document.getElementById('ip-x') as HTMLInputElement).value);
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      const fmt2 = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (isNaN(x1) || isNaN(y1) || isNaN(x2) || isNaN(y2) || isNaN(x) || x1 === x2) {
        document.getElementById('ip-result')!.textContent = 'Fehler';
        return;
      }
      const m = (y2 - y1) / (x2 - x1);
      const b = y1 - m * x1;
      const y = y1 + m * (x - x1);
      const isInterp = (x >= Math.min(x1, x2) && x <= Math.max(x1, x2));
      document.getElementById('ip-result')!.textContent = fmt(y);
      document.getElementById('ip-slope')!.textContent = fmt2(m);
      document.getElementById('ip-intercept')!.textContent = fmt2(b);
      document.getElementById('ip-pos')!.textContent = isInterp ? 'Interpolation' : 'Extrapolation';
      const steps = [
        'm = (' + y2 + ' − ' + y1 + ') / (' + x2 + ' − ' + x1 + ') = ' + fmt2(m),
        'b = ' + y1 + ' − ' + fmt2(m) + ' × ' + x1 + ' = ' + fmt2(b),
        'y = ' + fmt2(m) + ' × ' + x + ' + ' + fmt2(b) + ' = ' + fmt(y),
      ];
      document.getElementById('ip-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ip-in').forEach(el => { el.addEventListener('input', calcIP); el.addEventListener('change', calcIP); });
      calcIP();
    }, 50);
  </script>
</CalculatorLayout>
