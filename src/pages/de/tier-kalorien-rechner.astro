---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Tier-Kalorien-Rechner - RER, MER & Kalorienbedarf nach Lebensphase";
const description = "Berechnen Sie den Ruheenergiebedarf (RER), Erhaltungsenergiebedarf (MER) und täglichen Kalorienbedarf für Ihr Haustier nach Art, Gewicht und Lebensphase.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglicher Kalorienbedarf." },
  { name: "Makro-Rechner", url: "/de/makro-rechner", description: "Makronährstoffe." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Abnehm-Planung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Tier-Kalorien-Rechner" enSlug="animal-calorie-calculator" keywords="Tier Kalorien Rechner, RER, MER, Ruheenergiebedarf, Erhaltungsenergie, Haustier Kalorien" breadcrumbs={[{ name: "Tier-Kalorien-Rechner", url: "/de/tier-kalorien-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Tier-Kalorien-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie RER, MER und den täglichen Kalorienbedarf Ihres Haustieres basierend auf Art, Gewicht und Lebensphase.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tierart</label>
            <select id="tk-species" class="tk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="dog" selected>Hund</option>
              <option value="cat">Katze</option>
              <option value="rabbit">Kaninchen</option>
              <option value="bird">Vogel (Papagei)</option>
              <option value="horse">Pferd</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Körpergewicht (kg)</label>
            <input type="number" id="tk-weight" class="tk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0.2" max="1200" step="0.5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Lebensphase</label>
            <select id="tk-stage" class="tk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="growth">Wachstum (jung)</option>
              <option value="adult" selected>Erwachsen (kastriert)</option>
              <option value="intact">Erwachsen (intakt)</option>
              <option value="senior">Senior</option>
              <option value="pregnant">Trächtig</option>
              <option value="lactating">Säugend</option>
              <option value="weight_loss">Gewichtsabnahme</option>
              <option value="critical">Intensivpflege / Krankheit</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktivitätslevel</label>
            <select id="tk-activity" class="tk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="sedentary">Wenig aktiv</option>
              <option value="normal" selected>Normal</option>
              <option value="active">Aktiv</option>
              <option value="working">Arbeitshund / Sport</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Energiebedarf (MER)</div>
          <div class="text-5xl font-extrabold font-mono" id="tk-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">RER (kcal/Tag)</div><div class="text-xl font-bold font-mono" id="tk-rer">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MER-Faktor</div><div class="text-xl font-bold font-mono" id="tk-factor">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewicht (kg)</div><div class="text-xl font-bold font-mono" id="tk-kg">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Protein (g/Tag)</div><div class="text-xl font-bold font-mono" id="tk-protein">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fett (g/Tag)</div><div class="text-xl font-bold font-mono" id="tk-fat">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser (ml/Tag)</div><div class="text-xl font-bold font-mono" id="tk-water">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="tier-kalorien" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Energiebedarf von Haustieren verstehen</h2>
      <p>Der Ruheenergiebedarf (RER) wird mit der Formel RER = 70 x (Körpergewicht in kg)^0,75 berechnet. Der Erhaltungsenergiebedarf (MER) berücksichtigt Lebensphase, Aktivität und Tierart. Die genaue Futtermenge sollte immer mit einem Tierarzt abgestimmt werden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Futter braucht mein Hund?</strong> Der Energiebedarf hängt von Gewicht, Alter, Rasse und Aktivität ab. Dieser Rechner gibt eine Schätzung, die als Ausgangspunkt dient.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcTK() {
      const species = (document.getElementById('tk-species') as HTMLSelectElement).value;
      const weightKg = parseFloat((document.getElementById('tk-weight') as HTMLInputElement).value) || 0;
      const stage = (document.getElementById('tk-stage') as HTMLSelectElement).value;
      const activity = (document.getElementById('tk-activity') as HTMLSelectElement).value;

      const rer = 70 * Math.pow(weightKg, 0.75);

      const merFactors: Record<string, number> = {
        growth: 2.5, adult: 1.4, intact: 1.6, senior: 1.2,
        pregnant: 1.8, lactating: 3.0, weight_loss: 1.0, critical: 1.0
      };
      const actAdj: Record<string, number> = {
        sedentary: 0.85, normal: 1.0, active: 1.2, working: 1.6
      };
      const speciesAdj: Record<string, number> = {
        dog: 1.0, cat: 0.85, rabbit: 0.7, bird: 0.9, horse: 1.0
      };

      let factor = (merFactors[stage] || 1.4) * (actAdj[activity] || 1.0) * (speciesAdj[species] || 1.0);
      const mer = rer * factor;

      const proteinPct = species === 'cat' ? 0.35 : 0.25;
      const fatPct = species === 'cat' ? 0.35 : 0.30;
      const proteinG = (mer * proteinPct) / 4;
      const fatG = (mer * fatPct) / 9;
      const waterMl = Math.round(mer);

      document.getElementById('tk-result')!.textContent = Math.round(mer) + ' kcal';
      document.getElementById('tk-rer')!.textContent = Math.round(rer).toString();
      document.getElementById('tk-factor')!.textContent = factor.toFixed(2) + 'x';
      document.getElementById('tk-kg')!.textContent = weightKg.toFixed(1);
      document.getElementById('tk-protein')!.textContent = Math.round(proteinG).toString();
      document.getElementById('tk-fat')!.textContent = Math.round(fatG).toString();
      document.getElementById('tk-water')!.textContent = waterMl.toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.tk-in').forEach(el => { el.addEventListener('input', calcTK); el.addEventListener('change', calcTK); });
      calcTK();
    }, 50);
  </script>
</CalculatorLayout>
