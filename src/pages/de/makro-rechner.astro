---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Makronährstoff Rechner – Täglicher Bedarf an Proteinen, Kohlenhydraten & Fetten";
const description = "Berechnen Sie Ihren täglichen Bedarf an Proteinen, Kohlenhydraten und Fetten basierend auf Körpergröße, Gewicht, Aktivität und Ziel.";

const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Macaron Rechner", url: "/de/macaron-rechner", description: "Backmengen." },
  { name: "Marathon Pace Rechner", url: "/de/marathon-pace-rechner", description: "Laufpace." },
];
---
<CalculatorLayout lang="de" enSlug="macro-calculator" title={title} description={description} calculatorName="Makronährstoff Rechner" keywords="Makro Rechner, Makronährstoffe berechnen, Protein Bedarf, Kohlenhydrate, Kalorien Makros" breadcrumbs={[{ name: "Makronährstoff Rechner", url: "/de/makro-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Makronährstoff Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren persönlichen täglichen Makronährstoff-Bedarf für Ihr Fitness- und Ernährungsziel.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Alter (Jahre)</label>
            <input type="number" id="mk-age" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="30" step="1" min="15" max="100">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
            <select id="mk-gender" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="m" selected>Männlich</option>
              <option value="f">Weiblich</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label>
            <input type="number" id="mk-weight" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="80" step="0.5" min="30" max="300">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Größe (cm)</label>
            <input type="number" id="mk-height" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="178" step="1" min="100" max="250">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Aktivitätslevel</label>
          <select id="mk-activity" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="1.2">Sitzend (kaum Bewegung)</option>
            <option value="1.375">Leicht aktiv (1–3× Sport/Woche)</option>
            <option value="1.55" selected>Mäßig aktiv (3–5× Sport/Woche)</option>
            <option value="1.725">Sehr aktiv (6–7× Sport/Woche)</option>
            <option value="1.9">Extrem aktiv (körperliche Arbeit + Sport)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Ziel</label>
          <select id="mk-goal" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="-500">Abnehmen (–500 kcal)</option>
            <option value="-250">Leicht abnehmen (–250 kcal)</option>
            <option value="0" selected>Gewicht halten</option>
            <option value="250">Leicht zunehmen (+250 kcal)</option>
            <option value="500">Zunehmen / Muskeln aufbauen (+500 kcal)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Kalorienbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="mk-kcal">–</div>
          <div class="text-blue-200 text-sm mt-1" id="mk-bmr">–</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl text-center">
            <div class="text-xs text-blue-600 uppercase font-semibold">Protein</div>
            <div class="text-2xl font-bold font-mono text-blue-700" id="mk-protein">–</div>
            <div class="text-xs text-blue-500" id="mk-pkcal">–</div>
          </div>
          <div class="p-4 bg-green-50 border border-green-200 rounded-xl text-center">
            <div class="text-xs text-green-600 uppercase font-semibold">Kohlenhydrate</div>
            <div class="text-2xl font-bold font-mono text-green-700" id="mk-carbs">–</div>
            <div class="text-xs text-green-500" id="mk-ckcal">–</div>
          </div>
          <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-xl text-center">
            <div class="text-xs text-yellow-600 uppercase font-semibold">Fett</div>
            <div class="text-2xl font-bold font-mono text-yellow-700" id="mk-fat">–</div>
            <div class="text-xs text-yellow-500" id="mk-fkcal">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="macro" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was sind Makronährstoffe?</h2>
      <p>Makronährstoffe sind die drei Hauptnährstoffgruppen, aus denen unsere Ernährung besteht: Proteine (4 kcal/g), Kohlenhydrate (4 kcal/g) und Fette (9 kcal/g). Die optimale Verteilung hängt von den persönlichen Zielen ab. Für Muskelaufbau empfiehlt sich ein höherer Proteinanteil (30–35 %), für Ausdauersport mehr Kohlenhydrate (50–60 %).</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Wie viel Protein brauche ich täglich?</h3>
      <p>Die Empfehlung liegt bei 0,8 g/kg Körpergewicht für Inaktive. Sportler benötigen 1,2–2,0 g/kg. Beim Muskelaufbau empfehlen viele Experten 1,6–2,2 g/kg Körpergewicht.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Muss ich Kohlenhydrate meiden zum Abnehmen?</h3>
      <p>Nein, entscheidend ist das Gesamtkaloriendefizit. Low-Carb kann bei manchen Menschen funktionieren, ist aber kein Muss. Eine ausgewogene Ernährung mit Kaloriendefizit ist langfristig nachhaltiger.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen BMR und TDEE?</h3>
      <p>BMR (Basalmetabolismusrate) ist der Energiebedarf im Ruhezustand. TDEE (Total Daily Energy Expenditure) berücksichtigt zusätzlich körperliche Aktivität. Für Gewichtskontrolle ist der TDEE maßgeblich.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMk() {
      const age = parseInt((document.getElementById('mk-age') as HTMLInputElement).value) || 30;
      const gender = (document.getElementById('mk-gender') as HTMLSelectElement).value;
      const weight = parseFloat((document.getElementById('mk-weight') as HTMLInputElement).value) || 80;
      const height = parseFloat((document.getElementById('mk-height') as HTMLInputElement).value) || 178;
      const activity = parseFloat((document.getElementById('mk-activity') as HTMLSelectElement).value) || 1.55;
      const goal = parseInt((document.getElementById('mk-goal') as HTMLSelectElement).value) || 0;
      const bmr = gender === 'm'
        ? 10 * weight + 6.25 * height - 5 * age + 5
        : 10 * weight + 6.25 * height - 5 * age - 161;
      const tdee = bmr * activity;
      const target = Math.round(tdee + goal);
      const protein = Math.round(weight * 1.8);
      const fat = Math.round(target * 0.25 / 9);
      const proteinKcal = protein * 4;
      const fatKcal = fat * 9;
      const carbKcal = Math.max(0, target - proteinKcal - fatKcal);
      const carbs = Math.round(carbKcal / 4);
      document.getElementById('mk-kcal')!.textContent = target.toLocaleString('de-DE') + ' kcal';
      document.getElementById('mk-bmr')!.textContent = 'Grundumsatz: ' + Math.round(bmr).toLocaleString('de-DE') + ' kcal';
      document.getElementById('mk-protein')!.textContent = protein + ' g';
      document.getElementById('mk-pkcal')!.textContent = proteinKcal.toLocaleString('de-DE') + ' kcal';
      document.getElementById('mk-carbs')!.textContent = carbs + ' g';
      document.getElementById('mk-ckcal')!.textContent = carbKcal.toLocaleString('de-DE') + ' kcal';
      document.getElementById('mk-fat')!.textContent = fat + ' g';
      document.getElementById('mk-fkcal')!.textContent = fatKcal.toLocaleString('de-DE') + ' kcal';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['mk-age', 'mk-weight', 'mk-height'].forEach(id => document.getElementById(id)!.addEventListener('input', calcMk));
      ['mk-gender', 'mk-activity', 'mk-goal'].forEach(id => document.getElementById(id)!.addEventListener('change', calcMk));
      calcMk();
    }, 50);
  </script>
</CalculatorLayout>
