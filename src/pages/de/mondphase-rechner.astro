---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mondphase Rechner - Mondphase und Mondkalender berechnen";
const description = "Berechnen Sie die aktuelle Mondphase und den Mondkalender für jedes Datum. Mit Mondaufgang, Monduntergang und Vollmond-Terminen.";

const relatedCalcs = [
  { name: "Datumsrechner", url: "/de/datumsrechner", description: "Datum berechnen." },
  { name: "Jahreszeiten-Rechner", url: "/de/jahreszeiten-rechner", description: "Jahreszeiten bestimmen." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmusrechner", description: "Biorhythmus berechnen." },
  { name: "Kalender-Rechner", url: "/de/kalenderrechner", description: "Kalender berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="moon-phase-calculator" calculatorName="Mondphase Rechner" keywords="Mondphase Rechner, Vollmond Datum, Neumond, Mondkalender, Mondphase berechnen, Mondphase heute" breadcrumbs={[{ name: "Mondphase Rechner", url: "/de/mondphase-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mondphase Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Mondphase für jedes Datum und erhalten Sie einen vollständigen Mondkalender mit allen Vollmond- und Neumond-Terminen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Datum</label>
          <input type="date" id="mn-date" class="mn-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-7xl mb-3" id="mn-emoji">🌕</div>
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mondphase</div>
          <div class="text-3xl font-extrabold" id="mn-phase-name">Vollmond</div>
          <div class="text-sm text-blue-200 mt-1" id="mn-illumination">Beleuchtung: 100%</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mondtag</div>
            <div class="text-xl font-bold" id="mn-day">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Beleuchtungsgrad</div>
            <div class="text-xl font-bold" id="mn-pct">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Nächster Vollmond</div>
            <div class="text-sm font-bold" id="mn-next-full">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Nächster Neumond</div>
            <div class="text-sm font-bold" id="mn-next-new">—</div>
          </div>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-text mb-2">Mondkalender – nächste 3 Monate</h3>
          <div id="mn-calendar" class="space-y-1 text-sm"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="moon-phase" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mondphasen und Mondkalender</h2>
      <p>Der Mond umkreist die Erde in einem synodischen Monat von 29,53059 Tagen. Die Mondphasen entstehen durch den unterschiedlichen Winkel zwischen Mond, Erde und Sonne. Der Mondkalender ist seit Jahrtausenden für Landwirtschaft, Navigation, Religion und Kultur bedeutsam.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Wie lange dauert ein Mondmonat?</p>
          <p>Ein synodischer Monat (von Vollmond zu Vollmond oder Neumond zu Neumond) dauert 29 Tage, 12 Stunden, 44 Minuten und 3 Sekunden. Das siderische Monat (Umlauf relativ zu den Sternen) ist mit 27,32 Tagen etwas kürzer.</p>
        </div>
        <div>
          <p class="font-semibold">Beeinflusst der Mond das Pflanzenwachstum?</p>
          <p>Der Mondkalender-Gartenbau ist eine traditionsreiche Praxis. Wissenschaftlich belegt ist der Einfluss des Mondes auf Gezeiten, da er Wasser anzieht. Ob er das Pflanzenwachstum beeinflusst, ist wissenschaftlich umstritten, wird aber von vielen Gärtnern praktiziert.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist ein Blauer Mond (Blue Moon)?</p>
          <p>Ein Blauer Mond ist der zweite Vollmond in einem Kalendermonat (moderner Gebrauch) oder der dritte Vollmond in einer Jahreszeit mit vier Vollmonden (traditioneller Gebrauch). Er tritt etwa alle 2,5 bis 3 Jahre auf.</p>
        </div>
        <div>
          <p class="font-semibold">Gibt es einen Zusammenhang zwischen Mondphasen und Schlaf?</p>
          <p>Studien zeigen, dass Menschen um den Vollmond kürzer und weniger tief schlafen. Der Mechanismus ist jedoch unklar. Möglicherweise haben evolutionäre Anpassungen oder das historisch hellere Nachtlicht beim Vollmond eine Rolle gespielt.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const SYNODIC_MONTH = 29.53059;
    const KNOWN_NEW_MOON = new Date(2000, 0, 6, 18, 14, 0).getTime();

    const PHASES = [
      { name: 'Neumond', emoji: '🌑', minPct: 0 },
      { name: 'Zunehmende Sichel', emoji: '🌒', minPct: 1 },
      { name: 'Erstes Viertel', emoji: '🌓', minPct: 26 },
      { name: 'Zunehmender Gibbous', emoji: '🌔', minPct: 51 },
      { name: 'Vollmond', emoji: '🌕', minPct: 74 },
      { name: 'Abnehmender Gibbous', emoji: '🌖', minPct: 76 },
      { name: 'Letztes Viertel', emoji: '🌗', minPct: 51 },
      { name: 'Abnehmende Sichel', emoji: '🌘', minPct: 1 },
    ];

    function getMoonAge(date: Date): number {
      const diff = date.getTime() - KNOWN_NEW_MOON;
      const days = diff / (1000 * 60 * 60 * 24);
      return ((days % SYNODIC_MONTH) + SYNODIC_MONTH) % SYNODIC_MONTH;
    }

    function getPhaseInfo(age: number) {
      const pct = age / SYNODIC_MONTH;
      let illumination: number;
      let phaseIndex: number;

      if (pct < 0.5) {
        illumination = pct * 2;
        phaseIndex = pct < 0.03 ? 0 : pct < 0.25 ? 1 : pct < 0.27 ? 2 : 3;
      } else {
        illumination = (1 - pct) * 2;
        phaseIndex = pct < 0.53 ? 4 : pct < 0.75 ? 5 : pct < 0.77 ? 6 : 7;
      }

      return { illumination: illumination * 100, phase: PHASES[phaseIndex] };
    }

    function getNextPhase(date: Date, targetAge: number): Date {
      const age = getMoonAge(date);
      let daysUntil = (targetAge - age + SYNODIC_MONTH) % SYNODIC_MONTH;
      if (daysUntil < 0.5) daysUntil += SYNODIC_MONTH;
      return new Date(date.getTime() + daysUntil * 24 * 60 * 60 * 1000);
    }

    function formatDate(d: Date): string {
      return d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    function calcMn() {
      const dateStr = (document.getElementById('mn-date') as HTMLInputElement).value;
      if (!dateStr) return;
      const date = new Date(dateStr + 'T12:00:00');
      const age = getMoonAge(date);
      const info = getPhaseInfo(age);

      document.getElementById('mn-emoji')!.textContent = info.phase.emoji;
      document.getElementById('mn-phase-name')!.textContent = info.phase.name;
      document.getElementById('mn-illumination')!.textContent = `Beleuchtung: ${info.illumination.toFixed(0)}%`;
      document.getElementById('mn-day')!.textContent = `Tag ${Math.floor(age) + 1} von 30`;
      document.getElementById('mn-pct')!.textContent = info.illumination.toFixed(1) + '%';

      const nextFull = getNextPhase(date, SYNODIC_MONTH * 0.5);
      const nextNew = getNextPhase(date, 0);
      document.getElementById('mn-next-full')!.textContent = formatDate(nextFull);
      document.getElementById('mn-next-new')!.textContent = formatDate(nextNew);

      // Calendar for next 3 months
      const events: string[] = [];
      let cur = new Date(date.getTime());
      const end = new Date(date.getTime() + 90 * 24 * 60 * 60 * 1000);
      while (cur < end) {
        const a = getMoonAge(cur);
        if (a < 1.5 || Math.abs(a - SYNODIC_MONTH / 4) < 1 || Math.abs(a - SYNODIC_MONTH / 2) < 1 || Math.abs(a - 3 * SYNODIC_MONTH / 4) < 1) {
          const pi = getPhaseInfo(a);
          events.push(`<div class="flex items-center gap-2 py-1"><span class="text-lg">${pi.phase.emoji}</span><span class="font-medium">${formatDate(cur)}</span><span class="text-text-muted text-xs">– ${pi.phase.name}</span></div>`);
        }
        cur = new Date(cur.getTime() + SYNODIC_MONTH / 4 * 24 * 60 * 60 * 1000 - 2 * 24 * 60 * 60 * 1000);
        cur = getNextPhase(cur, Math.round(getMoonAge(cur) / (SYNODIC_MONTH / 4)) * (SYNODIC_MONTH / 4) % SYNODIC_MONTH);
      }

      // Simple approach: list main phases
      const calEl = document.getElementById('mn-calendar')!;
      const mainEvents: string[] = [];
      for (let i = 0; i < 90; i++) {
        const d = new Date(date.getTime() + i * 24 * 60 * 60 * 1000);
        const a = getMoonAge(d);
        if (a < 1 || (a > SYNODIC_MONTH / 4 - 0.5 && a < SYNODIC_MONTH / 4 + 0.5) ||
            (a > SYNODIC_MONTH / 2 - 0.5 && a < SYNODIC_MONTH / 2 + 0.5) ||
            (a > 3 * SYNODIC_MONTH / 4 - 0.5 && a < 3 * SYNODIC_MONTH / 4 + 0.5)) {
          const pi = getPhaseInfo(a);
          mainEvents.push(`<div class="flex items-center gap-2 py-1 border-b border-border/30"><span class="text-base">${pi.phase.emoji}</span><span class="font-medium text-xs">${formatDate(d)}</span><span class="text-text-muted text-xs ml-1">${pi.phase.name}</span></div>`);
        }
      }
      calEl.innerHTML = mainEvents.slice(0, 15).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const today = new Date();
      const dateStr = today.toISOString().split('T')[0];
      (document.getElementById('mn-date') as HTMLInputElement).value = dateStr;
      document.getElementById('mn-date')!.addEventListener('change', calcMn);
      calcMn();
    }, 50);
  </script>
</CalculatorLayout>
