---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hauskauf Leistbarkeit Rechner - Wie viel Haus kann ich mir leisten 2026";
const description = "Berechne, wie viel Immobilie du dir leisten kannst – basierend auf Einkommen, Schulden, Eigenkapital und Zinssatz. Kostenloser Immobilienrechner.";

const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothekenrate berechnen." },
  { name: "Eigenkapital-Rechner", url: "/de/eigenkapital-rechner", description: "Eigenkapital berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hauskauf-Leistbarkeit-Rechner" keywords="Hauskauf Leistbarkeit, wie viel Haus kann ich mir leisten, Immobilienrechner, Kreditwuerdigkeit, DTI Quote, Eigenkapital" breadcrumbs={[{ name: "Hauskauf-Leistbarkeit-Rechner", url: "/de/hauskauf-leistbarkeit-rechner" }]} lang="de" enSlug="home-affordability-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hauskauf-Leistbarkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermittle auf Basis deiner Finanzen, wie viel Immobilie du dir leisten kannst.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Jaehrliches Nettoeinkommen (€)</label><input type="number" id="hlr-income" class="hlr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="60000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Monatliche Schulden (€)</label><input type="number" id="hlr-debts" class="hlr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="400" min="0" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eigenkapital (€)</label><input type="number" id="hlr-down" class="hlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zinssatz (%)</label><input type="number" id="hlr-rate" class="hlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.5" min="0" max="15" step="0.125"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Jahre)</label><input type="number" id="hlr-term" class="hlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="5" max="40" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Verschuldungsquote (%)</label><input type="number" id="hlr-dti" class="hlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="20" max="50" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Grundsteuer + Versicherung (€/Jahr)</label><input type="number" id="hlr-extras" class="hlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3600" min="0" step="500"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Leistbarer Kaufpreis</div>
          <div class="text-5xl font-extrabold font-mono" id="hlr-result">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Darlehen</div><div class="text-xl font-bold font-mono" id="hlr-mortgage">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Rate</div><div class="text-xl font-bold font-mono" id="hlr-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Deine DTI-Quote</div><div class="text-xl font-bold font-mono" id="hlr-your-dti">0%</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenkapital %</div><div class="text-xl font-bold font-mono" id="hlr-down-pct">0%</div></div>
          <div class="p-4 rounded-xl text-center" id="hlr-status-box"><div class="font-bold text-sm" id="hlr-status">-</div></div>
        </div>
      </div>

      <ShareButton calculatorId="home-affordability" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie viel Immobilie kann ich mir leisten?</h2>
      <p>Die Faustregel lautet: Die monatliche Kreditrate sollte maximal 30-35 % des Nettoeinkommens betragen. Bei 5.000 € netto waeren das 1.500-1.750 € fuer die Hypothekenrate – inklusive Grundsteuer und Versicherung.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie viel Eigenkapital benoetige ich?</strong> In Deutschland empfehlen Experten mindestens 20 % des Kaufpreises als Eigenkapital plus die Kaufnebenkosten (Grunderwerbsteuer, Notar, Makler: ca. 10-15 %).</p>
      <p><strong>Was ist die Verschuldungsquote (DTI)?</strong> Die Schulden-Einkommens-Quote misst, wie viel deines Einkommens fuer Schuldverpflichtungen aufgewendet wird. Unter 35 % gilt als solide.</p>
      <p><strong>Was beeinflusst den Zinssatz?</strong> Bonität (SCHUFA), Eigenkapitalhöhe, Laufzeit und aktuelle Marktlage bestimmen deinen Zinssatz. Ein besseres Profil ergibt guenstigere Konditionen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHLR() {
      const income = parseFloat((document.getElementById('hlr-income') as HTMLInputElement).value) || 0;
      const debts = parseFloat((document.getElementById('hlr-debts') as HTMLInputElement).value) || 0;
      const down = parseFloat((document.getElementById('hlr-down') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('hlr-rate') as HTMLInputElement).value) / 100 || 0;
      const years = parseFloat((document.getElementById('hlr-term') as HTMLInputElement).value) || 25;
      const maxDTI = parseFloat((document.getElementById('hlr-dti') as HTMLInputElement).value) / 100 || 0.35;
      const extras = parseFloat((document.getElementById('hlr-extras') as HTMLInputElement).value) || 0;

      const monthlyIncome = income / 12;
      const maxTotalPayment = monthlyIncome * maxDTI;
      const maxHousingPayment = maxTotalPayment - debts;
      const monthlyExtras = extras / 12;
      const maxMortgagePayment = Math.max(0, maxHousingPayment - monthlyExtras);
      const r = rate / 12;
      const n = years * 12;
      let maxLoan = 0;
      if (r > 0 && maxMortgagePayment > 0) {
        maxLoan = maxMortgagePayment * (Math.pow(1 + r, n) - 1) / (r * Math.pow(1 + r, n));
      } else if (maxMortgagePayment > 0) {
        maxLoan = maxMortgagePayment * n;
      }
      const homePrice = maxLoan + down;
      const downPct = homePrice > 0 ? (down / homePrice) * 100 : 0;
      const actualDTI = monthlyIncome > 0 ? ((maxHousingPayment + debts) / monthlyIncome) * 100 : 0;

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' €';
      document.getElementById('hlr-result')!.textContent = fmt(homePrice);
      document.getElementById('hlr-mortgage')!.textContent = fmt(maxLoan);
      document.getElementById('hlr-monthly')!.textContent = fmt(maxHousingPayment);
      document.getElementById('hlr-your-dti')!.textContent = actualDTI.toFixed(0) + '%';
      document.getElementById('hlr-down-pct')!.textContent = downPct.toFixed(1) + '%';

      let status: string, color: string;
      if (downPct >= 20) { status = 'Kein Aufschlag – gutes Eigenkapital!'; color = 'bg-green-50 text-green-800'; }
      else if (downPct >= 10) { status = 'Solide Position mit Eigenkapital'; color = 'bg-blue-50 text-blue-800'; }
      else if (downPct >= 5) { status = 'Niedriges Eigenkapital – hoehere Kosten'; color = 'bg-yellow-50 text-yellow-800'; }
      else { status = 'Mehr Eigenkapital ansparen empfohlen'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('hlr-status')!.textContent = status;
      document.getElementById('hlr-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hlr-in').forEach(el => {
        el.addEventListener('input', calcHLR);
        el.addEventListener('change', calcHLR);
      });
      calcHLR();
    }, 50);
  </script>
</CalculatorLayout>
