---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Laminierungsrechner";
const description = "Berechnen Sie Folienverbrauch und Kosten für Laminierarbeiten.";

const relatedCalcs = [
  { name: "Etikettenrechner", url: "/de/etiketten-rechner", description: "Druckkosten berechnen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Maschinen abschreiben." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen berechnen." },
  { name: "Lederrechner", url: "/de/leder-rechner", description: "Lederbedarf berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Laminierungsrechner" lang="de" enSlug="lamination-calculator" keywords="laminierungsrechner, folienverbrauch berechnen, laminierkosten, laminierer folie" breadcrumbs={[{ name: "Laminierungsrechner", url: "/de/laminierungs-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Laminierungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Folienverbrauch und die Gesamtkosten für Ihre Laminierarbeiten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Dokumentenbreite (mm)</label><input type="number" id="lmr-w" class="lmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="210" min="10" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Dokumentenlänge (mm)</label><input type="number" id="lmr-h" class="lmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="297" min="10" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Überlappung / Rand (mm)</label><input type="number" id="lmr-margin" class="lmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Dokumente</label><input type="number" id="lmr-qty" class="lmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Laminierart</label><select id="lmr-type" class="lmr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Einseitig</option>
            <option value="2" selected>Beidseitig</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Folienkosten (€/m²)</label><input type="number" id="lmr-cost" class="lmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.80" min="0" step="0.10"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Arbeitskosten (€/Stunde)</label><input type="number" id="lmr-labor" class="lmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten (Folie)</div>
          <div class="text-4xl font-extrabold font-mono" id="lmr-total">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Folienfläche</div><div class="text-xl font-bold" id="lmr-area">0 m²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stückkosten</div><div class="text-xl font-bold" id="lmr-unit">0,00 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Folienlagen</div><div class="text-xl font-bold" id="lmr-layers">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="lamination-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Laminieren – Schutz für Ihre Dokumente</h2>
      <p>Laminieren schützt Dokumente, Etiketten und Drucksachen vor Feuchtigkeit, Schmutz und mechanischer Beanspruchung. Der Folienverbrauch hängt vom Dokumentenformat und der Überlappung ab. Bei beidseitiger Laminierung wird die Folienmenge verdoppelt. Typische Laminierfolien sind in Stärken von 75 bis 250 Mikrometer erhältlich – dünnere Folien eignen sich für flexible Dokumente, dickere für stabile Ausweise und Karten.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Foliendicke ist für welchen Zweck geeignet?</strong> 75–80 µm für einfache Dokumente, 125 µm für Standardanwendungen und Ausweise, 175–250 µm für Visitenkarten und langlebige Karten.</p>
      <p><strong>Kann man jeden Drucker mit Laminat kombinieren?</strong> Grundsätzlich ja, jedoch sollten Laserdrucker-Ausdrucke vor dem Laminieren vollständig abgekühlt sein, da Hitze den Toner beeinflussen kann.</p>
      <p><strong>Wie lange dauert das Laminieren pro Dokument?</strong> Ein handelsüblicher Bürolaminator benötigt 30–60 Sekunden pro Dokument (A4). Industrielle Laminatoren schaffen deutlich höhere Geschwindigkeiten.</p>
      <p><strong>Was ist der Unterschied zwischen Heißlamination und Kaltlamination?</strong> Heißlaminierung verwendet Wärme zum Verbinden, Kaltlaminierung nutzt Druck und selbstklebende Folien – geeignet für wärmeempfindliche Vorlagen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const lmrFmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
    function calcLMR() {
      const w = parseFloat((document.getElementById('lmr-w') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('lmr-h') as HTMLInputElement).value) || 0;
      const margin = parseFloat((document.getElementById('lmr-margin') as HTMLInputElement).value) || 0;
      const qty = parseFloat((document.getElementById('lmr-qty') as HTMLInputElement).value) || 0;
      const type = parseInt((document.getElementById('lmr-type') as HTMLSelectElement).value) || 1;
      const cost = parseFloat((document.getElementById('lmr-cost') as HTMLInputElement).value) || 0;
      const wM = (w + 2 * margin) / 1000;
      const hM = (h + 2 * margin) / 1000;
      const areaPerDoc = wM * hM * type;
      const totalArea = areaPerDoc * qty;
      const totalCost = totalArea * cost;
      const unitCost = qty > 0 ? totalCost / qty : 0;
      document.getElementById('lmr-total')!.textContent = lmrFmt(totalCost);
      document.getElementById('lmr-area')!.textContent = totalArea.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m\u00B2';
      document.getElementById('lmr-unit')!.textContent = lmrFmt(unitCost);
      document.getElementById('lmr-layers')!.textContent = (qty * type).toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.lmr-in').forEach(el => { el.addEventListener('input', calcLMR); el.addEventListener('change', calcLMR); }); calcLMR(); }, 50);
  </script>
</CalculatorLayout>
