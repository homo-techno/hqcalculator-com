---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blutsauerstoffrechner (SpO2)";
const description = "Prüfen Sie Ihre Blutsauerstoffsättigung (SpO2) und verstehen Sie die Bedeutung Ihrer Pulsoximeter-Werte.";
const relatedCalcs = [
  { name: "Blutdruckrechner", url: "/de/blutdruck-rechner", description: "Blutdruck." },
  { name: "Blutzucker-Umrechner", url: "/de/blutzucker-umrechner", description: "Blutzucker." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "BMI." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Blutsauerstoffrechner" lang="de" keywords="SpO2, blutsauerstoff, pulsoximeter, sauerstoffsättigung, hypoxämie, sauerstoffwerte" breadcrumbs={[{ name: "Blutsauerstoff", url: "/de/blutsauerstoff-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blutsauerstoffrechner (SpO2)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Interpretieren Sie Ihre Pulsoximeter-Werte und verstehen Sie die SpO2-Stufen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">SpO2-Wert (%)</label><input type="number" id="bo-spo2" class="bo-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="98" min="50" max="100" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Pulsfrequenz (bpm)</label><input type="number" id="bo-pulse" class="bo-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="72" min="30" max="200" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Höhenlage</label>
          <select id="bo-alt" class="bo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0" selected>Meereshöhe</option>
            <option value="5000">1.500 m (5.000 ft)</option>
            <option value="8000">2.400 m (8.000 ft)</option>
            <option value="10000">3.000+ m (10.000+ ft)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">SpO2-Status</div>
          <div class="text-5xl font-extrabold font-mono" id="bo-result">Normal</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="bo-status-box"><div class="font-bold text-sm" id="bo-status">-</div></div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pulsstatus</div><div class="text-xl font-bold font-mono" id="bo-pulse-status">Normal</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Höhenangepasst</div><div class="text-xl font-bold font-mono" id="bo-adjusted">-</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">SpO2-Referenzbereiche</h3>
          <div class="text-xs space-y-1" id="bo-ranges"></div>
        </div>
        <div class="p-3 bg-red-50 rounded-xl text-center text-xs text-red-800 font-bold">
          Bei SpO2 unter 90% suchen Sie sofort ärztliche Hilfe. Dieses Tool dient nur als Referenz.
        </div>
      </div>
      <ShareButton calculatorId="blood-oxygen" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBO() {
      const spo2 = parseFloat((document.getElementById('bo-spo2') as HTMLInputElement).value) || 0;
      const pulse = parseFloat((document.getElementById('bo-pulse') as HTMLInputElement).value) || 0;
      const alt = parseInt((document.getElementById('bo-alt') as HTMLSelectElement).value) || 0;
      let status: string, detail: string, color: string;
      const normalMin = alt >= 8000 ? 88 : alt >= 5000 ? 90 : 95;
      if (spo2 >= 95) { status = 'Normal'; detail = 'Gesunde Sauerstoffwerte'; color = 'bg-green-50 text-green-800'; }
      else if (spo2 >= 91) { status = 'Niedrig'; detail = 'Leichte Hypoxämie — engmaschig beobachten'; color = 'bg-yellow-50 text-yellow-800'; }
      else if (spo2 >= 86) { status = 'Bedenklich'; detail = 'Mäßige Hypoxämie — ärztlichen Rat einholen'; color = 'bg-orange-50 text-orange-800'; }
      else { status = 'Kritisch'; detail = 'Schwere Hypoxämie — Notfallversorgung aufsuchen'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('bo-result')!.textContent = status;
      document.getElementById('bo-status')!.textContent = detail;
      document.getElementById('bo-status-box')!.className = `p-4 rounded-xl text-center ${color}`;
      let pulseStatus: string;
      if (pulse < 60) pulseStatus = 'Bradykardie';
      else if (pulse <= 100) pulseStatus = 'Normal';
      else pulseStatus = 'Tachykardie';
      document.getElementById('bo-pulse-status')!.textContent = pulseStatus;
      const altNote = alt > 0 ? `Normal ab ${alt} ft: \u2265${normalMin}%` : 'Meereshöhe';
      document.getElementById('bo-adjusted')!.textContent = altNote;
      const ranges = [
        { label: 'Normal', range: '95-100%', color: 'text-green-700' },
        { label: 'Leichte Hypoxämie', range: '91-94%', color: 'text-yellow-700' },
        { label: 'Mäßige Hypoxämie', range: '86-90%', color: 'text-orange-700' },
        { label: 'Schwere Hypoxämie', range: '< 86%', color: 'text-red-700' },
      ];
      document.getElementById('bo-ranges')!.innerHTML = ranges.map(r => {
        const isCurrent = (r.label === 'Normal' && spo2 >= 95) || (r.label === 'Leichte Hypox\u00e4mie' && spo2 >= 91 && spo2 < 95) || (r.label === 'M\u00e4\u00dfige Hypox\u00e4mie' && spo2 >= 86 && spo2 < 91) || (r.label === 'Schwere Hypox\u00e4mie' && spo2 < 86);
        return `<div class="flex justify-between ${isCurrent ? 'font-bold ' + r.color : ''}"><span>${r.label}</span><span>${r.range}${isCurrent ? ' \u2190 Sie' : ''}</span></div>`;
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bo-in').forEach(el => { el.addEventListener('input', calcBO); el.addEventListener('change', calcBO); });
      calcBO();
    }, 50);
  </script>
</CalculatorLayout>
