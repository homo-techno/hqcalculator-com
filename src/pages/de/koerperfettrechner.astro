---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Körperfettrechner - Körperfettanteil berechnen 2026";
const description = "Berechne deinen Körperfettanteil mit der US Navy Methode. Kostenloser Körperfett-Schätzer mit visueller Skala und Gesundheitskategorien.";

const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index berechnen." },
  { name: "Grundumsatzrechner", url: "/de/grundumsatzrechner", description: "Grundumsatz berechnen." },
  { name: "Energieverbrauchsrechner", url: "/de/energieverbrauchsrechner", description: "Tagesenergieverbrauch." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglicher Kalorienbedarf." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Abnehm-Zeitplan erstellen." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Genaues Alter berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Körperfettrechner" keywords="Körperfettrechner, Körperfettanteil, US Navy Körperfett, Körperzusammensetzung, Fettanteil berechnen" breadcrumbs={[{ name: "Körperfettrechner", url: "/de/koerperfettrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Körperfettrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätze deinen Körperfettanteil mit der US Navy Methode. Gib deine Maße ein.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Geschlecht</label>
            <div class="flex gap-2">
              <button class="bf-gender-btn flex-1 py-3 rounded-xl font-semibold bg-primary text-white border border-primary cursor-pointer" data-gender="male">Männlich</button>
              <button class="bf-gender-btn flex-1 py-3 rounded-xl font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-gender="female">Weiblich</button>
            </div>
          </div>
          <div class="mb-5">
            <div class="flex gap-2">
              <button class="bf-unit-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-primary text-white cursor-pointer" data-unit="metric">Metrisch (cm/kg)</button>
              <button class="bf-unit-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-unit="imperial">Imperial (in/lbs)</button>
            </div>
          </div>
          <div class="mb-5" id="bf-height-met">
            <label class="block text-sm font-medium text-text mb-1">Größe (cm)</label>
            <input type="number" id="bf-h-cm" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="178" min="100" max="250">
          </div>
          <div class="mb-5 hidden" id="bf-height-imp">
            <label class="block text-sm font-medium text-text mb-1">Größe</label>
            <div class="flex gap-3">
              <div class="flex-1"><input type="number" id="bf-h-ft" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="5" min="3" max="8"><span class="text-xs text-text-muted">ft</span></div>
              <div class="flex-1"><input type="number" id="bf-h-in" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="0" max="11"><span class="text-xs text-text-muted">in</span></div>
            </div>
          </div>
          <div class="mb-5" id="bf-weight-met">
            <label class="block text-sm font-medium text-text mb-1">Gewicht (kg)</label>
            <input type="number" id="bf-w-kg" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="82" min="30" max="300">
          </div>
          <div class="mb-5 hidden" id="bf-weight-imp">
            <label class="block text-sm font-medium text-text mb-1">Gewicht (lbs)</label>
            <input type="number" id="bf-w-lbs" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="180" min="60" max="700">
          </div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Halsumfang <span class="bf-unit-label">(cm)</span></label>
            <input type="number" id="bf-neck" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="38" min="20" max="60" step="0.5">
          </div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Taillenumfang <span class="bf-unit-label">(cm)</span></label>
            <input type="number" id="bf-waist" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="86" min="40" max="200" step="0.5">
            <span class="text-xs text-text-muted">Auf Nabelhöhe gemessen</span>
          </div>
          <div class="mb-5" id="bf-hip-row">
            <label class="block text-sm font-medium text-text mb-1">Hüftumfang <span class="bf-unit-label">(cm)</span></label>
            <input type="number" id="bf-hip" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="96" min="50" max="200" step="0.5">
            <span class="text-xs text-text-muted">Am breitesten Punkt gemessen</span>
          </div>
        </div>
        <div class="space-y-4">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Körperfettanteil</div>
            <div class="text-5xl font-extrabold" id="bf-result">0%</div>
            <div class="text-sm text-blue-200 mt-1" id="bf-category">—</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fettmasse</div><div class="text-xl font-bold text-danger" id="bf-fat-mass">0 kg</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Magermasse</div><div class="text-xl font-bold text-secondary" id="bf-lean-mass">0 kg</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">BMI-Methode</div><div class="text-xl font-bold" id="bf-bmi-method">0%</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">BMI</div><div class="text-xl font-bold" id="bf-bmi">0</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <div class="text-sm font-semibold text-text mb-2">Körperfett-Skala</div>
            <div class="relative h-6 rounded-full overflow-hidden flex">
              <div class="h-full bg-blue-400" style="width:14%"></div>
              <div class="h-full bg-green-400" style="width:12%"></div>
              <div class="h-full bg-yellow-400" style="width:12%"></div>
              <div class="h-full bg-orange-400" style="width:12%"></div>
              <div class="h-full bg-red-400" style="width:50%"></div>
            </div>
            <div class="relative h-4"><div class="absolute top-0 w-0 h-0 border-l-[6px] border-r-[6px] border-b-[8px] border-transparent border-b-text transition-all" id="bf-marker" style="left:20%"></div></div>
            <div class="flex justify-between text-[10px] text-text-muted mt-1">
              <span>Essentiell</span><span>Sportler</span><span>Fitness</span><span>Durchschnitt</span><span>Adipös</span>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="text-sm font-semibold text-text mb-2">Körperfett-Kategorien</h3>
            <div class="text-xs space-y-1" id="bf-categories-table"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="body-fat" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie der Körperfettanteil berechnet wird</h2>
      <p>Dieser Rechner verwendet die <strong>US Navy Methode</strong>, die den Körperfettanteil anhand von Umfangsmessungen schätzt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Gesunde Körperfett-Bereiche</h3>
      <ul>
        <li><strong>Essentielles Fett:</strong> Männer 2-5 %, Frauen 10-13 %</li>
        <li><strong>Sportler:</strong> Männer 6-13 %, Frauen 14-20 %</li>
        <li><strong>Fitness:</strong> Männer 14-17 %, Frauen 21-24 %</li>
        <li><strong>Durchschnitt:</strong> Männer 18-24 %, Frauen 25-31 %</li>
        <li><strong>Adipös:</strong> Männer 25 %+, Frauen 32 %+</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let bfGender = 'male';
    let bfUnit = 'metric';

    const maleCategories = [
      { label: 'Essentielles Fett', min: 2, max: 5, color: 'text-blue-600' },
      { label: 'Sportler', min: 6, max: 13, color: 'text-green-600' },
      { label: 'Fitness', min: 14, max: 17, color: 'text-green-500' },
      { label: 'Durchschnitt', min: 18, max: 24, color: 'text-yellow-600' },
      { label: 'Adipös', min: 25, max: 100, color: 'text-red-600' },
    ];
    const femaleCategories = [
      { label: 'Essentielles Fett', min: 10, max: 13, color: 'text-blue-600' },
      { label: 'Sportlerin', min: 14, max: 20, color: 'text-green-600' },
      { label: 'Fitness', min: 21, max: 24, color: 'text-green-500' },
      { label: 'Durchschnitt', min: 25, max: 31, color: 'text-yellow-600' },
      { label: 'Adipös', min: 32, max: 100, color: 'text-red-600' },
    ];

    function getHeight(): number {
      if (bfUnit === 'imperial') {
        const ft = parseFloat((document.getElementById('bf-h-ft') as HTMLInputElement).value) || 0;
        const inch = parseFloat((document.getElementById('bf-h-in') as HTMLInputElement).value) || 0;
        return ft * 12 + inch;
      }
      return (parseFloat((document.getElementById('bf-h-cm') as HTMLInputElement).value) || 0) / 2.54;
    }

    function getWeight(): number {
      if (bfUnit === 'imperial') return parseFloat((document.getElementById('bf-w-lbs') as HTMLInputElement).value) || 0;
      return (parseFloat((document.getElementById('bf-w-kg') as HTMLInputElement).value) || 0) * 2.2046;
    }

    function getMeasurement(id: string): number {
      let val = parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0;
      if (bfUnit === 'metric') val /= 2.54;
      return val;
    }

    function calcBodyFat() {
      const height = getHeight();
      const weight = getWeight();
      const neck = getMeasurement('bf-neck');
      const waist = getMeasurement('bf-waist');
      const hip = getMeasurement('bf-hip');

      let bf: number;
      if (bfGender === 'male') {
        bf = 86.010 * Math.log10(waist - neck) - 70.041 * Math.log10(height) + 36.76;
      } else {
        bf = 163.205 * Math.log10(waist + hip - neck) - 97.684 * Math.log10(height) - 78.387;
      }
      bf = Math.max(0, Math.min(60, bf));

      const fatMass = weight * bf / 100;
      const leanMass = weight - fatMass;
      const heightM = height * 0.0254;
      const weightKg = weight * 0.453592;
      const bmi = heightM > 0 ? weightKg / (heightM * heightM) : 0;
      const age = 30;
      let bmiBf = bfGender === 'male' ? 1.20 * bmi + 0.23 * age - 16.2 : 1.20 * bmi + 0.23 * age - 5.4;

      const categories = bfGender === 'male' ? maleCategories : femaleCategories;
      let category = 'Unbekannt';
      for (const cat of categories) { if (bf >= cat.min && bf <= cat.max) { category = cat.label; break; } }

      const weightUnit = bfUnit === 'imperial' ? 'lbs' : 'kg';
      const displayFat = bfUnit === 'imperial' ? fatMass : fatMass * 0.453592;
      const displayLean = bfUnit === 'imperial' ? leanMass : leanMass * 0.453592;

      document.getElementById('bf-result')!.textContent = bf.toFixed(1) + '%';
      document.getElementById('bf-category')!.textContent = category;
      document.getElementById('bf-fat-mass')!.textContent = Math.round(displayFat) + ' ' + weightUnit;
      document.getElementById('bf-lean-mass')!.textContent = Math.round(displayLean) + ' ' + weightUnit;
      document.getElementById('bf-bmi-method')!.textContent = Math.max(0, bmiBf).toFixed(1) + '%';
      document.getElementById('bf-bmi')!.textContent = bmi.toFixed(1);

      const markerPct = Math.min(100, Math.max(0, (bf / 50) * 100));
      document.getElementById('bf-marker')!.style.left = markerPct + '%';

      const tableEl = document.getElementById('bf-categories-table')!;
      tableEl.innerHTML = categories.filter(c => c.max <= 60).map(cat => {
        const active = bf >= cat.min && bf <= cat.max;
        return `<div class="flex justify-between py-0.5 ${active ? 'font-bold ' + cat.color : 'text-text-muted'}"><span>${active ? '▸ ' : ''}${cat.label}</span><span>${cat.min}-${cat.max === 100 ? '+' : cat.max}%</span></div>`;
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bf-gender-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bf-gender-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white', 'border-primary'); b.classList.add('bg-surface-alt', 'text-text-secondary', 'border-border'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary', 'border-border'); btn.classList.add('bg-primary', 'text-white', 'border-primary');
          bfGender = (btn as HTMLElement).dataset.gender || 'male';
          document.getElementById('bf-hip-row')!.style.display = bfGender === 'female' ? '' : 'none';
          calcBodyFat();
        });
      });
      document.querySelectorAll('.bf-unit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bf-unit-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          bfUnit = (btn as HTMLElement).dataset.unit || 'metric';
          const isMet = bfUnit === 'metric';
          document.getElementById('bf-height-met')!.classList.toggle('hidden', !isMet);
          document.getElementById('bf-height-imp')!.classList.toggle('hidden', isMet);
          document.getElementById('bf-weight-met')!.classList.toggle('hidden', !isMet);
          document.getElementById('bf-weight-imp')!.classList.toggle('hidden', isMet);
          document.querySelectorAll('.bf-unit-label').forEach(el => { el.textContent = isMet ? '(cm)' : '(inches)'; });
          calcBodyFat();
        });
      });
      document.getElementById('bf-hip-row')!.style.display = 'none';
      ['bf-h-ft', 'bf-h-in', 'bf-h-cm', 'bf-w-lbs', 'bf-w-kg', 'bf-neck', 'bf-waist', 'bf-hip'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcBodyFat);
      });
      calcBodyFat();
    }, 50);
  </script>
</CalculatorLayout>
