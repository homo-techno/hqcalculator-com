---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Abnehmenrechner - Kaloriendefizit & Zeitplan berechnen 2026";
const description = "Berechne, wie lange es dauert, dein Wunschgewicht zu erreichen. Finde dein taegliches Kalorienziel fuer sicheres, nachhaltiges Abnehmen.";

const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Taeglicher Kalorienbedarf." },
  { name: "Energieverbrauchsrechner", url: "/de/energieverbrauchsrechner", description: "Tagesenergieverbrauch." },
  { name: "Grundumsatzrechner", url: "/de/grundumsatzrechner", description: "Grundumsatz berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Koerperfettrechner", url: "/de/koerperfettrechner", description: "Koerperfettanteil." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Abnehmenrechner" keywords="Abnehmenrechner, Kaloriendefizit Rechner, Gewicht verlieren, Abnehm-Zeitplan, Diaet Rechner, Wunschgewicht" breadcrumbs={[{ name: "Abnehmenrechner", url: "/de/abnehmenrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Abnehmenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finde heraus, wie lange es dauert, dein Wunschgewicht zu erreichen — mit einem persoenlichen Kalorienplan.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5"><label class="block text-sm font-medium text-text mb-2">Geschlecht</label><div class="flex gap-2"><button class="wl-gender-btn flex-1 py-2.5 rounded-xl font-semibold bg-primary text-white border border-primary cursor-pointer" data-gender="male">Maennlich</button><button class="wl-gender-btn flex-1 py-2.5 rounded-xl font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-gender="female">Weiblich</button></div></div>
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div><label class="block text-xs font-medium text-text mb-1">Alter</label><input type="number" id="wl-age" class="w-full px-3 py-2.5 border border-border rounded-xl text-lg" value="30" min="15" max="120"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Groesse (cm)</label><input type="number" id="wl-height" class="w-full px-3 py-2.5 border border-border rounded-xl text-lg" value="175" min="120" max="230"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Gewicht (kg)</label><input type="number" id="wl-current" class="w-full px-3 py-2.5 border border-border rounded-xl text-lg" value="90" min="30" max="300"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Wunschgewicht (kg)</label><input type="number" id="wl-goal" class="w-full px-3 py-2.5 border border-border rounded-xl text-lg" value="75" min="30" max="300"></div>
          </div>
          <div class="mb-5"><label class="block text-sm font-medium text-text mb-1">Aktivitaetslevel</label><select id="wl-activity" class="w-full px-3 py-2.5 border border-border rounded-xl"><option value="1.2">Sitzend (Bueroarbeit)</option><option value="1.375">Leichte Bewegung (1-3 Tage/Woche)</option><option value="1.55" selected>Moderate Bewegung (3-5 Tage/Woche)</option><option value="1.725">Intensives Training (6-7 Tage/Woche)</option><option value="1.9">Leistungssportler</option></select></div>
          <div class="mb-5"><label class="block text-sm font-medium text-text mb-2">Abnehmgeschwindigkeit</label>
            <div class="space-y-2">
              <label class="flex items-center gap-3 p-3 border border-border rounded-xl cursor-pointer wl-rate-opt"><input type="radio" name="wl-rate" value="0.25" class="text-primary"><div><span class="font-semibold text-sm">Langsam (0,25 kg/Woche)</span><span class="text-xs text-text-muted ml-2">Am leichtesten durchzuhalten</span></div></label>
              <label class="flex items-center gap-3 p-3 border border-primary rounded-xl cursor-pointer bg-primary/5 wl-rate-opt"><input type="radio" name="wl-rate" value="0.5" checked class="text-primary"><div><span class="font-semibold text-sm">Moderat (0,5 kg/Woche)</span><span class="text-xs text-text-muted ml-2">Empfohlen</span></div></label>
              <label class="flex items-center gap-3 p-3 border border-border rounded-xl cursor-pointer wl-rate-opt"><input type="radio" name="wl-rate" value="1" class="text-primary"><div><span class="font-semibold text-sm">Schnell (1 kg/Woche)</span><span class="text-xs text-text-muted ml-2">Aggressives Defizit</span></div></label>
            </div>
          </div>
        </div>
        <div class="space-y-4">
          <div class="p-6 bg-primary rounded-2xl text-white text-center"><div class="text-sm text-blue-200 uppercase mb-1">Zeit bis zum Ziel</div><div class="text-4xl font-extrabold" id="wl-time">0 Wochen</div></div>
          <div class="p-5 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Taegliches Kalorienziel</div><div class="text-3xl font-bold text-primary" id="wl-calories">0 kcal</div></div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dein TDEE</div><div class="text-xl font-bold" id="wl-tdee">0</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Taegliches Defizit</div><div class="text-xl font-bold text-danger" id="wl-deficit">0</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abzunehmen</div><div class="text-xl font-bold" id="wl-to-lose">0 kg</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zieldatum</div><div class="text-xl font-bold" id="wl-date">&mdash;</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl"><h3 class="font-semibold text-sm text-text mb-2">Gewichtsprognose</h3><div class="space-y-1 text-sm" id="wl-timeline"></div></div>
        </div>
      </div>
      <ShareButton calculatorId="weight-loss" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie Abnehmen funktioniert</h2>
      <p>Gewichtsverlust entsteht, wenn du weniger Kalorien zu dir nimmst als du verbrauchst (Kaloriendefizit). 1 kg Koerperfett entspricht ca. 7.700 Kalorien. Um 0,5 kg pro Woche zu verlieren, brauchst du ein taegliches Defizit von etwa 550 Kalorien.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Taegliches Defizit = (Abzunehmen &times; 7700) / (Wochen &times; 7)</div>
      <h3 class="text-xl font-semibold text-text mt-8">Richtlinien fuer sicheres Abnehmen</h3>
      <ul>
        <li>Maximal 0,5-1 kg pro Woche verlieren</li>
        <li>Nie unter 1200 kcal (Frauen) oder 1500 kcal (Maenner) essen</li>
        <li>Proteinzufuhr priorisieren (1,6-2,2 g/kg) um Muskeln zu erhalten</li>
        <li>Krafttraining einbauen, um die Muskelmasse zu bewahren</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let wlGender = 'male';
    function calcWL() {
      const age = parseFloat((document.getElementById('wl-age') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('wl-height') as HTMLInputElement).value) || 0;
      const current = parseFloat((document.getElementById('wl-current') as HTMLInputElement).value) || 0;
      const goal = parseFloat((document.getElementById('wl-goal') as HTMLInputElement).value) || 0;
      const activity = parseFloat((document.getElementById('wl-activity') as HTMLSelectElement).value);
      const rate = parseFloat((document.querySelector('input[name="wl-rate"]:checked') as HTMLInputElement)?.value || '0.5');
      let bmr = wlGender === 'male' ? 10 * current + 6.25 * height - 5 * age + 5 : 10 * current + 6.25 * height - 5 * age - 161;
      const tdee = Math.round(bmr * activity);
      const toLose = Math.max(0, current - goal);
      const weeks = rate > 0 ? Math.ceil(toLose / rate) : 0;
      const dailyDeficit = Math.round(rate * 7700 / 7);
      const targetCal = Math.max(wlGender === 'male' ? 1500 : 1200, tdee - dailyDeficit);
      const goalDate = new Date(); goalDate.setDate(goalDate.getDate() + weeks * 7);

      document.getElementById('wl-time')!.textContent = weeks > 0 ? (weeks < 8 ? weeks + ' Wochen' : Math.round(weeks / 4.33) + ' Monate') : 'Schon erreicht!';
      document.getElementById('wl-calories')!.textContent = targetCal + ' kcal';
      document.getElementById('wl-tdee')!.textContent = tdee + ' kcal';
      document.getElementById('wl-deficit')!.textContent = '-' + dailyDeficit + ' kcal';
      document.getElementById('wl-to-lose')!.textContent = toLose.toFixed(1).replace('.', ',') + ' kg';
      document.getElementById('wl-date')!.textContent = weeks > 0 ? goalDate.toLocaleDateString('de-DE', { month: 'short', year: 'numeric' }) : '\u2014';

      const timeline = document.getElementById('wl-timeline')!;
      const steps: string[] = [];
      for (let w = 4; w <= weeks && steps.length < 8; w += Math.max(4, Math.floor(weeks / 8))) {
        const lost = Math.min(toLose, rate * w);
        steps.push(`<div class="flex justify-between"><span class="text-text-muted">Woche ${w}</span><span class="font-medium">${(current - lost).toFixed(1).replace('.', ',')} kg</span></div>`);
      }
      if (weeks > 0) steps.push(`<div class="flex justify-between font-semibold text-primary"><span>Ziel (Woche ${weeks})</span><span>${String(goal).replace('.', ',')} kg</span></div>`);
      timeline.innerHTML = steps.join('');

      document.querySelectorAll('.wl-rate-opt').forEach(opt => { const r = opt.querySelector('input') as HTMLInputElement; if (r.checked) { opt.classList.add('border-primary', 'bg-primary/5'); opt.classList.remove('border-border'); } else { opt.classList.remove('border-primary', 'bg-primary/5'); opt.classList.add('border-border'); } });
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.wl-gender-btn').forEach(btn => { btn.addEventListener('click', () => { document.querySelectorAll('.wl-gender-btn').forEach(b => { b.classList.remove('bg-primary','text-white','border-primary'); b.classList.add('bg-surface-alt','text-text-secondary','border-border'); }); btn.classList.remove('bg-surface-alt','text-text-secondary','border-border'); btn.classList.add('bg-primary','text-white','border-primary'); wlGender = (btn as HTMLElement).dataset.gender || 'male'; calcWL(); }); });
      ['wl-age','wl-height','wl-current','wl-goal'].forEach(id => document.getElementById(id)!.addEventListener('input', calcWL));
      document.getElementById('wl-activity')!.addEventListener('change', calcWL);
      document.querySelectorAll('input[name="wl-rate"]').forEach(r => r.addEventListener('change', calcWL));
      calcWL();
    }, 50);
  </script>
</CalculatorLayout>
