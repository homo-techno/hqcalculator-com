---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lebensmittelkosten-Rechner - Restaurant Gewinn & Aufschlag";
const description = "Berechnen Sie den Lebensmittelkostenanteil, Aufschlag, Gewinn pro Portion und täglichen/monatlichen Gewinn für Restaurantgerichte.";
const relatedCalcs = [
  { name: "Protein pro Euro Rechner", url: "/de/protein-pro-dollar-rechner", description: "Proteinwert vergleichen." },
  { name: "Meal-Prep-Rechner", url: "/de/meal-prep-rechner", description: "Wöchentliche Mahlzeitenplanung." },
  { name: "Backumrechner", url: "/de/backumrechner", description: "Backmaße umrechnen." },
  { name: "Bierbrau-Rechner", url: "/de/bierbrau-rechner", description: "Heimbrauen ABV & Statistik." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Lebensmittelkosten-Rechner" lang="de" enSlug="food-cost-calculator" keywords="lebensmittelkosten rechner, restaurant kosten, lebensmittelkostenanteil, menüpreise, restaurantgewinn, aufschlag rechner" breadcrumbs={[{ name: "Lebensmittelkosten-Rechner", url: "/de/lebensmittelkosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lebensmittelkosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Lebensmittelkostenanteil, Aufschlag und Gewinn für die Preisgestaltung von Restaurantgerichten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zutatenkosten (&euro;)</label>
            <input type="number" id="lkr-cost" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.50" min="0" step="0.01">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Verkaufspreis (&euro;)</label>
            <input type="number" id="lkr-price" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="14.99" min="0" step="0.01">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Portionen pro Tag</label>
            <input type="number" id="lkr-portions" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Betriebstage / Monat</label>
            <input type="number" id="lkr-days" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="26" min="1" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Lebensmittelkostenanteil</div>
          <div class="text-5xl font-extrabold font-mono" id="lkr-result">0%</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufschlag</div><div class="text-xl font-bold font-mono" id="lkr-markup">0x</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinn / Portion</div><div class="text-xl font-bold font-mono" id="lkr-profit">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bruttomarge</div><div class="text-xl font-bold font-mono" id="lkr-margin">0%</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tagesgewinn</div><div class="text-xl font-bold font-mono" id="lkr-daily">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatsgewinn</div><div class="text-xl font-bold font-mono" id="lkr-monthly">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="food-cost-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Lebensmittelkosten im Restaurant berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Lebensmittelkostenanteil = (Zutatenkosten / Verkaufspreis) &times; 100</p>
        <p>Aufschlag = Verkaufspreis / Zutatenkosten</p>
        <p>Gewinn pro Portion = Verkaufspreis &minus; Zutatenkosten</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein guter Lebensmittelkostenanteil?</strong> In der Gastronomie gilt ein Anteil von 25-35% als ideal. Unter 25% ist hervorragend, &uuml;ber 40% erfordert eine &Uuml;berpr&uuml;fung der Preisgestaltung.</p>
      <p><strong>Wie kann ich den Lebensmittelkostenanteil senken?</strong> Optimieren Sie Portionsgr&ouml;&szlig;en, verhandeln Sie mit Lieferanten, reduzieren Sie Lebensmittelverschwendung und passen Sie Men&uuml;preise regelm&auml;&szlig;ig an.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLKR() {
      const cost = parseFloat((document.getElementById('lkr-cost') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('lkr-price') as HTMLInputElement).value) || 0;
      const portions = parseFloat((document.getElementById('lkr-portions') as HTMLInputElement).value) || 0;
      const days = parseFloat((document.getElementById('lkr-days') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const foodCostPct = price > 0 ? (cost / price) * 100 : 0;
      const markup = cost > 0 ? price / cost : 0;
      const profitPerPlate = price - cost;
      const grossMargin = price > 0 ? ((price - cost) / price) * 100 : 0;
      const dailyProfit = profitPerPlate * portions;
      const monthlyProfit = dailyProfit * days;
      document.getElementById('lkr-result')!.textContent = foodCostPct.toFixed(1).replace('.', ',') + '%';
      document.getElementById('lkr-markup')!.textContent = markup.toFixed(2).replace('.', ',') + 'x';
      document.getElementById('lkr-profit')!.textContent = fmt(profitPerPlate) + ' \u20AC';
      document.getElementById('lkr-margin')!.textContent = grossMargin.toFixed(1).replace('.', ',') + '%';
      document.getElementById('lkr-daily')!.textContent = fmt(dailyProfit) + ' \u20AC';
      document.getElementById('lkr-monthly')!.textContent = fmt(monthlyProfit) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.lkr-in').forEach(el => { el.addEventListener('input', calcLKR); el.addEventListener('change', calcLKR); });
      calcLKR();
    }, 50);
  </script>
</CalculatorLayout>
