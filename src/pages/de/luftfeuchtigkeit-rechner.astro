---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Luftfeuchtigkeit-Rechner - Relative & Absolute Luftfeuchtigkeit";
const description = "Berechnen Sie relative Luftfeuchtigkeit, absolute Luftfeuchtigkeit, Mischungsverhältnis und Dampfdruck aus Temperatur und Taupunkt.";
const relatedCalcs = [
  { name: "Taupunkt-Rechner", url: "/dew-point-calculator", description: "Taupunkttemperatur." },
  { name: "Hitzeindex-Rechner", url: "/heat-index-calculator", description: "Hitzeindex." },
  { name: "Feuchttemperatur-Rechner", url: "/wet-bulb-calculator", description: "Feuchte Kugeltemperatur." },
  { name: "Windchill-Rechner", url: "/wind-chill-calculator", description: "Windkühlfaktor." },
  { name: "Temperaturumrechner", url: "/temperature-converter", description: "Temperatureinheiten." },
  { name: "Druckumrechner", url: "/pressure-converter", description: "Druckeinheiten." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist relative Luftfeuchtigkeit?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die relative Luftfeuchtigkeit ist das Verhältnis des tatsächlichen Wasserdampfdrucks zum Sättigungsdampfdruck bei gleicher Temperatur, ausgedrückt als Prozentsatz. 100 % bedeutet gesättigte Luft (Nebel oder Regen möglich)." }
    },
    {
      "@type": "Question",
      "name": "Welche Luftfeuchtigkeit ist ideal in Innenräumen?",
      "acceptedAnswer": { "@type": "Answer", "text": "Für Innenräume wird eine relative Luftfeuchtigkeit von 40–60 % empfohlen. Darunter kann es zu trockener Haut und Reizung der Atemwege kommen, darüber fördert es Schimmelbildung." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Luftfeuchtigkeit-Rechner" lang="de" keywords="luftfeuchtigkeit rechner, relative luftfeuchtigkeit, absolute luftfeuchtigkeit, mischungsverhältnis, dampfdruck, taupunkt" breadcrumbs={[{ name: "Luftfeuchtigkeit-Rechner", url: "/de/luftfeuchtigkeit-rechner" }]} enSlug="humidity-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Luftfeuchtigkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie relative Luftfeuchtigkeit, absolute Luftfeuchtigkeit, Mischungsverhältnis und Dampfdruck aus Temperatur und Taupunkt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lufttemperatur (°C)</label><input type="number" id="lf-temp" class="lf-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="25" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Taupunkt (°C)</label><input type="number" id="lf-dew" class="lf-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="15" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Relative Luftfeuchtigkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="lf-result">--</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="lf-comfort-box">
          <div class="font-bold text-sm" id="lf-comfort">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Absolute Luftfeuchtigkeit</div><div class="text-xl font-bold font-mono" id="lf-abs">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dampfdruck</div><div class="text-xl font-bold font-mono" id="lf-vp">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mischungsverhältnis</div><div class="text-xl font-bold font-mono" id="lf-mix">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sättigungsdampfdruck</div><div class="text-xl font-bold font-mono" id="lf-svp">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Luftfeuchtigkeits-Komfortzonen</h3>
          <div class="text-xs space-y-1">
            <div>Unter 30 %: Zu trocken, Hautreizungen</div>
            <div>30–50 %: Idealer Innenraumkomfort</div>
            <div>50–60 %: Angenehm</div>
            <div>60–70 %: Beginnt sich feucht anzufühlen</div>
            <div>Über 70 %: Unkomfortabel, schwül</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="luftfeuchtigkeit" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie wird Luftfeuchtigkeit berechnet?</h2>
      <p>Die relative Luftfeuchtigkeit wird mit der Magnus-Formel berechnet: RH = (e / e_s) × 100 %, wobei e der tatsächliche Dampfdruck und e_s der Sättigungsdampfdruck ist. Die absolute Luftfeuchtigkeit gibt an, wie viel Gramm Wasserdampf pro Kubikmeter Luft vorhanden sind.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Was ist relative Luftfeuchtigkeit?</h4>
      <p>Die relative Luftfeuchtigkeit ist das Verhältnis des tatsächlichen Wasserdampfdrucks zum Sättigungsdampfdruck bei gleicher Temperatur, ausgedrückt als Prozentsatz. 100 % bedeutet gesättigte Luft.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Welche Luftfeuchtigkeit ist ideal in Innenräumen?</h4>
      <p>Für Innenräume wird eine relative Luftfeuchtigkeit von 40–60 % empfohlen. Darunter kann es zu trockener Haut kommen, darüber fördert es Schimmelbildung.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcLF() {
      const tC = parseFloat((document.getElementById('lf-temp') as HTMLInputElement).value) ?? 25;
      const dpC = parseFloat((document.getElementById('lf-dew') as HTMLInputElement).value) ?? 15;
      const a = 17.27, b = 237.7;
      const svp = 6.112 * Math.exp((a * tC) / (b + tC));
      const vp = 6.112 * Math.exp((a * dpC) / (b + dpC));
      const rh = Math.min(100, Math.max(0, (vp / svp) * 100));
      const absH = 216.7 * (vp / (273.15 + tC));
      const mixR = 621.97 * (vp / (1013.25 - vp));
      document.getElementById('lf-result')!.textContent = rh.toFixed(1) + '%';
      document.getElementById('lf-abs')!.textContent = absH.toFixed(2) + ' g/m\u00B3';
      document.getElementById('lf-vp')!.textContent = vp.toFixed(2) + ' hPa';
      document.getElementById('lf-mix')!.textContent = mixR.toFixed(2) + ' g/kg';
      document.getElementById('lf-svp')!.textContent = svp.toFixed(2) + ' hPa';
      let comfort: string, color: string;
      if (rh < 30) { comfort = 'Zu trocken'; color = 'bg-yellow-50 text-yellow-800'; }
      else if (rh < 50) { comfort = 'Idealer Komfort'; color = 'bg-green-50 text-green-800'; }
      else if (rh < 60) { comfort = 'Angenehm'; color = 'bg-green-50 text-green-800'; }
      else if (rh < 70) { comfort = 'Leicht feucht'; color = 'bg-yellow-50 text-yellow-800'; }
      else { comfort = 'Unkomfortabel / Schwül'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('lf-comfort')!.textContent = comfort;
      document.getElementById('lf-comfort-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.lf-in').forEach(el => { el.addEventListener('input', calcLF); el.addEventListener('change', calcLF); }); calcLF(); }, 50);
  </script>
</CalculatorLayout>
