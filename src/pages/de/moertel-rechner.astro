---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mörtelrechner - Mörtelmengen für Mauerwerk berechnen";
const description = "Berechnen Sie Mörtelmengen für Mauerwerk, Verputz und Fliesenarbeiten. Zement, Sand und Wasseranteile für verschiedene Mörtelmischungen.";

const relatedCalcs = [
  { name: "Mosaik-Fugenmasse Rechner", url: "/de/mosaik-fugenmasse-rechner", description: "Fugenmasse berechnen." },
  { name: "Beton-Rechner", url: "/de/betonrechner", description: "Beton berechnen." },
  { name: "Fliesen-Rechner", url: "/de/fliesenrechner", description: "Fliesen berechnen." },
  { name: "Mauerwerk-Rechner", url: "/de/mauerwerkrechner", description: "Mauerwerk berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mortar-calculator" calculatorName="Mörtelrechner" keywords="Mörtelrechner, Mörtel berechnen, Mauermörtel, Putzmörtel, Zement Sand Mischung, Mauerwerk" breadcrumbs={[{ name: "Mörtelrechner", url: "/de/moertel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mörtelrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die benötigte Mörtelmenge und Mischungsverhältnisse für Mauerwerk, Verputz, Fliesenleger und Außenanlagen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Anwendung</label>
          <select id="mr2-type" class="mr2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="masonry">Mauermörtel (MG IIa)</option>
            <option value="plaster">Putzmörtel (innen, 15mm)</option>
            <option value="plaster_out">Außenputz (20mm)</option>
            <option value="tile">Fliesenmörtel / Dünnbett</option>
            <option value="joint">Fugenmörtel (10mm Fuge)</option>
          </select>
        </div>

        <div id="mr2-masonry-inputs">
          <h3 class="text-xs font-semibold text-text mb-2">Wandfläche</h3>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Wandlänge (m)</label>
              <input type="number" id="mr2-len" class="mr2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="5">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Wandhöhe (m)</label>
              <input type="number" id="mr2-height" class="mr2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="2.5">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Steinformat</label>
              <select id="mr2-brick" class="mr2-in w-full px-4 py-3 border border-border rounded-xl font-bold bg-white">
                <option value="0.22">NF (24×11,5×7,1 cm)</option>
                <option value="0.14">MF (25×12×6,5 cm)</option>
                <option value="0.28">DF (24×11,5×5,2 cm – 2 Schichten)</option>
                <option value="0.30">KS 5DF (49,8×17,5×11,3 cm)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Wanddicke (cm)</label>
              <input type="number" id="mr2-thick" class="mr2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="5" value="24">
            </div>
          </div>
        </div>

        <div id="mr2-surface-inputs">
          <label class="block text-xs font-medium text-text mb-1">Fläche (m²)</label>
          <input type="number" id="mr2-area" class="mr2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="20">
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Mischungsverhältnis (Zement : Sand)</label>
          <select id="mr2-mix" class="mr2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="1:3">1:3 (Mörtelgruppe III – fest)</option>
            <option value="1:4" selected>1:4 (Mörtelgruppe IIa – Standard)</option>
            <option value="1:6">1:6 (Mörtelgruppe I – leicht)</option>
            <option value="1:2">1:2 (Mörtelgruppe IV – sehr fest)</option>
          </select>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigter Mörtel</div>
          <div class="text-5xl font-extrabold font-mono" id="mr2-result">— L</div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zement</div>
            <div class="text-xl font-bold" id="mr2-cement">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sand</div>
            <div class="text-xl font-bold" id="mr2-sand">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wasser</div>
            <div class="text-xl font-bold" id="mr2-water">—</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Säcke Zement (25 kg)</div>
            <div class="text-xl font-bold" id="mr2-bags">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Material gesamt (kg)</div>
            <div class="text-xl font-bold" id="mr2-total-kg">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnung</h3>
          <div class="font-mono text-sm space-y-1" id="mr2-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mortar" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mörtel – Zusammensetzung und Anwendung</h2>
      <p>Mörtel ist ein Gemisch aus Bindemittel (Zement, Kalk oder Gips), Zuschlag (Sand) und Wasser. Je nach Anwendung und Festigkeitsklasse (Mörtelgruppe) variiert das Mischungsverhältnis. Normgerechte Mörtel nach DIN EN 998 sichern die Qualität im Bauwesen.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen Mauermörtel und Putzmörtel?</p>
          <p>Mauermörtel (Mörtelgruppe II-III) verbindet Steine und muss Druckkräfte übertragen. Putzmörtel hat eine feinere Körnung, muss besser haften und wird dicker aufgetragen. Außenputz braucht höhere Wetterbeständigkeit als Innenputz.</p>
        </div>
        <div>
          <p class="font-semibold">Wie viel Wasser kommt in den Mörtel?</p>
          <p>Das Wasser-Zement-Verhältnis (w/z-Wert) liegt typischerweise zwischen 0,4 und 0,6 (40-60 mL Wasser pro 100g Zement). Zu viel Wasser macht den Mörtel schwächer, zu wenig erschwert die Verarbeitung. Optimal ist eine streichfähige, aber nicht fließende Konsistenz.</p>
        </div>
        <div>
          <p class="font-semibold">Wie lange dauert das Abbinden von Mörtel?</p>
          <p>Zementmörtel beginnt nach ca. 2-4 Stunden abzubinden und erreicht nach 28 Tagen seine volle Festigkeit. Kalkhaltige Mörtel binden langsamer ab. Bei Frost unter 5°C darf nicht gemauert werden, da der Hydrationsprozess zum Erliegen kommt.</p>
        </div>
        <div>
          <p class="font-semibold">Was bedeuten die Mörtelgruppen?</p>
          <p>DIN EN 998 unterscheidet: MG I (weich, historisch), MG IIa (Standard, 1:4 Zement:Sand), MG IIb (fester), MG III (harter Zementmörtel 1:3), MG IV (Spezialmörtel). Höhere Gruppen sind fester, aber weniger elastisch.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcMr2() {
      const type = (document.getElementById('mr2-type') as HTMLSelectElement).value;
      const mixStr = (document.getElementById('mr2-mix') as HTMLSelectElement).value;
      const [c, s] = mixStr.split(':').map(Number);
      const ratio = s / c;

      const fmt = (v: number, dec = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });

      const isMasonry = type === 'masonry';
      document.getElementById('mr2-masonry-inputs')!.classList.toggle('hidden', !isMasonry);
      document.getElementById('mr2-surface-inputs')!.classList.toggle('hidden', isMasonry);

      let volumeLiters = 0;
      const steps: string[] = [];

      if (isMasonry) {
        const len = parseFloat((document.getElementById('mr2-len') as HTMLInputElement).value) || 0;
        const h = parseFloat((document.getElementById('mr2-height') as HTMLInputElement).value) || 0;
        const thick = parseFloat((document.getElementById('mr2-thick') as HTMLInputElement).value) || 24;
        const mortarPct = parseFloat((document.getElementById('mr2-brick') as HTMLSelectElement).value) || 0.22;

        const wallVolume = len * h * (thick / 100);
        volumeLiters = wallVolume * mortarPct * 1000;
        steps.push(`Wandvolumen = ${fmt(len)} × ${fmt(h)} × ${fmt(thick/100)} = ${fmt(wallVolume)} m³`);
        steps.push(`Mörtelanteil: ${(mortarPct * 100).toFixed(0)}% → ${fmt(volumeLiters)} L`);
      } else {
        const area = parseFloat((document.getElementById('mr2-area') as HTMLInputElement).value) || 0;
        const thicknessCm: Record<string, number> = { plaster: 1.5, plaster_out: 2.0, tile: 0.6, joint: 0.8 };
        const tCm = thicknessCm[type] || 1.5;
        volumeLiters = area * (tCm / 100) * 1000;
        steps.push(`Fläche ${fmt(area)} m² × ${tCm} cm Schichtdicke = ${fmt(volumeLiters)} L`);
      }

      // Cement density 1400 kg/m³, sand 1700 kg/m³
      const totalParts = 1 + ratio;
      const cementVolL = volumeLiters / totalParts;
      const sandVolL = volumeLiters * ratio / totalParts;
      const waterL = cementVolL * 0.5;

      const cementKg = cementVolL * 1.4;
      const sandKg = sandVolL * 1.7;
      const totalKg = cementKg + sandKg + waterL;
      const bags = Math.ceil(cementKg / 25);

      steps.push(`Mischung ${mixStr}: ${fmt(cementVolL, 0)} L Zement + ${fmt(sandVolL, 0)} L Sand`);
      steps.push(`Zement: ${fmt(cementKg, 1)} kg | Sand: ${fmt(sandKg, 1)} kg | Wasser: ${fmt(waterL, 1)} L`);
      steps.push(`Zementsäcke (25 kg): ${bags} Stück`);

      document.getElementById('mr2-result')!.textContent = fmt(volumeLiters, 0) + ' L';
      document.getElementById('mr2-cement')!.textContent = fmt(cementKg, 1) + ' kg';
      document.getElementById('mr2-sand')!.textContent = fmt(sandKg, 1) + ' kg';
      document.getElementById('mr2-water')!.textContent = fmt(waterL, 1) + ' L';
      document.getElementById('mr2-bags')!.textContent = bags + ' Säcke';
      document.getElementById('mr2-total-kg')!.textContent = fmt(totalKg, 0) + ' kg';
      document.getElementById('mr2-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.mr2-in').forEach(el => {
        el.addEventListener('input', calcMr2);
        el.addEventListener('change', calcMr2);
      });
      calcMr2();
    }, 50);
  </script>
</CalculatorLayout>
