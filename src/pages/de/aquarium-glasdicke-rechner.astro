---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Glasdickerechner - Individueller Beckenbau";
const description = "Berechnen Sie die minimale Glas- oder Acryldicke für individuelle Aquarienbauten basierend auf Beckenabmessungen, Wasserdruck und Sicherheitsfaktor.";
const relatedCalcs = [
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Wassergewicht." },
  { name: "Aquarium-Ständer", url: "/de/aquarium-staender-rechner", description: "Ständer-Tragfähigkeitsrechner." },
  { name: "Aquarium-Kosten", url: "/de/aquarium-kosten-rechner", description: "Gesamte Aquarium-Einrichtungskosten." },
  { name: "Aquarium-Substrat", url: "/de/aquarium-substrat-rechner", description: "Substrattiefe und -gewicht." },
  { name: "Aquarium-Technikbecken", url: "/de/aquarium-technikbecken-rechner", description: "Technikbecken-Konfiguration." },
  { name: "Aquarium-Hintergrund", url: "/de/aquarium-hintergrund-rechner", description: "Hintergrundmaterial-Rechner." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquarium-Glasdickerechner" keywords="Aquarium-Glasdicke, individueller Aquariumbau, Aquarium-Glasrechner, Acryl-Beckendicke, Aquarium-Sicherheitsfaktor" breadcrumbs={[{ name: "Aquarium-Glasdicke", url: "/de/aquarium-glasdicke-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Glasdickerechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die minimale sichere Glas- oder Acryldicke für ein individuelles Aquarium basierend auf Abmessungen und Materialtyp.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Länge (cm)</label>
            <input type="number" id="agt-len" class="agt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="15" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (cm)</label>
            <input type="number" id="agt-wid" class="agt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="15" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Höhe (cm)</label>
            <input type="number" id="agt-hgt" class="agt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="15" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Material</label>
            <select id="agt-mat" class="agt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="glass" selected>Gehärtetes Glas</option>
              <option value="float">Floatglas (Standard)</option>
              <option value="acrylic">Acryl (Plexiglas)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Sicherheitsfaktor</label>
            <select id="agt-sf" class="agt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3.8" selected>Standard (3,8x)</option>
              <option value="5">Konservativ (5x)</option>
              <option value="3">Minimum (3x)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Verstrebung</label>
          <select id="agt-brace" class="agt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none" selected>Keine Verstrebung (Randlos)</option>
            <option value="top">Obere Verstrebung / Euro-Steg</option>
            <option value="center">Mittelsteg</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mindestdicke</div>
          <div class="text-5xl font-extrabold font-mono" id="agt-result">0 mm</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Dicke (Zoll)</div>
            <div class="text-xl font-bold font-mono" id="agt-inches">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Beckenvolumen</div>
            <div class="text-xl font-bold font-mono" id="agt-vol">0 L</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wasserdruck (unten)</div>
            <div class="text-xl font-bold font-mono" id="agt-psi">0 bar</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtes Wassergewicht</div>
            <div class="text-xl font-bold font-mono" id="agt-weight">0 kg</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquarium-glass-thickness" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAGT() {
      const lenCm = parseFloat((document.getElementById('agt-len') as HTMLInputElement).value) || 0;
      const widCm = parseFloat((document.getElementById('agt-wid') as HTMLInputElement).value) || 0;
      const hgtCm = parseFloat((document.getElementById('agt-hgt') as HTMLInputElement).value) || 0;
      const mat = (document.getElementById('agt-mat') as HTMLSelectElement).value;
      const sf = parseFloat((document.getElementById('agt-sf') as HTMLSelectElement).value) || 3.8;
      const brace = (document.getElementById('agt-brace') as HTMLSelectElement).value;
      const len = lenCm / 2.54;
      const wid = widCm / 2.54;
      const hgt = hgtCm / 2.54;
      const gallons = (len * wid * hgt) / 231;
      const liters = gallons * 3.785;
      const weightKg = liters;
      const psi = hgt * 0.0361;
      const bar = psi * 0.0689476;
      const stressMap: Record<string, number> = { glass: 19300, float: 6000, acrylic: 10500 };
      const allowable = stressMap[mat] || 6000;
      let span = Math.max(len, wid);
      if (brace === 'top') span *= 0.85;
      if (brace === 'center') span *= 0.65;
      const pressure = psi;
      const thicknessInches = Math.sqrt((sf * pressure * span * span) / allowable);
      const thicknessMM = thicknessInches * 25.4;
      const stdMM = [3, 4, 5, 6, 8, 10, 12, 15, 19, 25];
      let recMM = stdMM[stdMM.length - 1];
      for (const s of stdMM) { if (s >= thicknessMM) { recMM = s; break; } }
      document.getElementById('agt-result')!.textContent = recMM + ' mm';
      document.getElementById('agt-inches')!.textContent = (recMM / 25.4).toFixed(2) + '"';
      document.getElementById('agt-vol')!.textContent = liters.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('agt-psi')!.textContent = bar.toFixed(3).replace('.', ',') + ' bar';
      document.getElementById('agt-weight')!.textContent = weightKg.toFixed(0) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.agt-in').forEach(el => { el.addEventListener('input', calcAGT); el.addEventListener('change', calcAGT); });
      calcAGT();
    }, 50);
  </script>
</CalculatorLayout>
