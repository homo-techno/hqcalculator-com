---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lebendgestein Rechner – Menge für Meerwasseraquarium berechnen";
const description = "Berechnen Sie die benötigte Menge Lebendgestein (Live Rock) für Ihr Meerwasseraquarium basierend auf Beckenvolumen und Besatz.";
const relatedCalcs = [
  { name: "Viehtränke Rechner", url: "/de/viehtraenk-rechner", description: "Wasserbedarf Tiere." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="live-rock-calculator" calculatorName="Lebendgestein Rechner" keywords="Lebendgestein Rechner, Live Rock, Meerwasseraquarium, Aquarium Liverock, Kilogramm Becken" breadcrumbs={[{ name: "Lebendgestein Rechner", url: "/de/lebendgestein-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lebendgestein Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die optimale Menge Lebendgestein für Ihr Meerwasseraquarium – für biologisches Gleichgewicht und gesunden Besatz.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Länge (cm)</label>
            <input type="number" id="lge-l" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" step="5" min="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (cm)</label>
            <input type="number" id="lge-b" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" step="5" min="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Höhe (cm)</label>
            <input type="number" id="lge-h" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="55" step="5" min="10">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Beckensystem</label>
          <select id="lge-sys" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.5">FOWLR – Fisch mit wenig Gestein (0,5 kg/10 L)</option>
            <option value="0.75" selected>Riffaquarium gemischt (0,75 kg/10 L)</option>
            <option value="1.0">Korallenbecken intensiv (1,0 kg/10 L)</option>
            <option value="1.25">SPS-Riff hochdicht (1,25 kg/10 L)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Füllstand (%)</label>
          <input type="number" id="lge-fuell" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="85" step="5" min="50" max="100">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigtes Lebendgestein</div>
          <div class="text-5xl font-extrabold font-mono" id="lge-result">0 kg</div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="lge-details"></div>
      </div>
      <ShareButton lang="de" calculatorId="lebendgestein" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Lebendgestein im Meerwasseraquarium</h2>
      <p>Lebendgestein (Live Rock) ist poröses Kalkgestein aus dem Meer, das mit Bakterien, Algen und Mikroorganismen besiedelt ist. Es bildet die biologische Filterung im Meerwasseraquarium durch Nitrifikation und Denitrifikation. Als Faustregel gilt: 0,5–1,25 kg pro 10 Liter Aquarienvolumen, je nach Besatzdichte und Systemart. Qualitativ hochwertiges Gestein mit großer Oberfläche ist effektiver als schweres, dichtes Gestein.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viel Lebendgestein brauche ich pro Liter?</summary>
          <p class="mt-2 text-sm text-text-secondary">Als Faustregel gilt 0,5–1,25 kg pro 10 Liter Aquarieninhalt. Für ein reines Fischbecken (FOWLR) reichen 0,5 kg/10 L. Für ein intensiv besetztes Korallenbecken werden 1,0–1,25 kg/10 L empfohlen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Muss Lebendgestein eingefahren werden?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ja, frisches Lebendgestein muss 2–4 Wochen in einem separaten Behälter mit Meerwasser "eingefahren" werden, damit abgestorbenes organisches Material abgebaut wird. Dabei kommt es zu erhöhten Ammonium- und Nitratwerten.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen "trockenem" und "lebendem" Gestein?</summary>
          <p class="mt-2 text-sm text-text-secondary">Trockenes Totgestein (Dry Rock) ist günstiger und enthält keine unerwünschten Organismen, muss aber durch Impfung mit Lebendgestein oder Bakterienkulturen besiedelt werden. Lebendgestein enthält sofort aktive Biologie, bringt aber auch Risiken wie Aiptasien oder Pest-Algen mit.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Kann ich Lebendgestein selbst herstellen?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ja, sogenanntes "gebackenes" oder "gecultertes" Gestein kann man aus Totgestein durch Einlegen in Meerwasser mit Algen, Bakterien und Licht über mehrere Monate selbst herstellen. Das spart Kosten und vermeidet eingeschleppte Schädlinge.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLge() {
      const l = parseFloat((document.getElementById('lge-l') as HTMLInputElement).value) || 0;
      const b = parseFloat((document.getElementById('lge-b') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('lge-h') as HTMLInputElement).value) || 0;
      const kgPro10L = parseFloat((document.getElementById('lge-sys') as HTMLSelectElement).value) || 0.75;
      const fuell = parseFloat((document.getElementById('lge-fuell') as HTMLInputElement).value) / 100 || 0.85;

      const bruttoLiter = (l * b * h) / 1000; // Liter
      const nettoLiter = bruttoLiter * fuell; // Liter mit Füllstand
      const empfKg = nettoLiter / 10 * kgPro10L;
      const minKg = nettoLiter / 10 * 0.5;
      const maxKg = nettoLiter / 10 * 1.25;

      const fmt = (v: number, u: string, d = 1) => v.toLocaleString('de-DE', { maximumFractionDigits: d }) + ' ' + u;
      document.getElementById('lge-result')!.textContent = fmt(empfKg, 'kg');
      document.getElementById('lge-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bruttovolumen</div><div class="text-lg font-bold font-mono">${fmt(bruttoLiter, 'L')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nettovolumen</div><div class="text-lg font-bold font-mono">${fmt(nettoLiter, 'L')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minimum</div><div class="text-lg font-bold font-mono">${fmt(minKg, 'kg')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Maximum</div><div class="text-lg font-bold font-mono">${fmt(maxKg, 'kg')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">kg pro 10 L</div><div class="text-lg font-bold font-mono">${fmt(kgPro10L, 'kg', 2)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Füllstand</div><div class="text-lg font-bold font-mono">${fmt(fuell * 100, '%', 0)}</div></div>`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['lge-l','lge-b','lge-h','lge-fuell'].forEach(id => document.getElementById(id)!.addEventListener('input', calcLge));
      document.getElementById('lge-sys')!.addEventListener('change', calcLge);
      calcLge();
    }, 50);
  </script>
</CalculatorLayout>
