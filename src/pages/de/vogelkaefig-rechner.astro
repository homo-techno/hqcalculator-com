---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Vogelkäfig-Rechner - Mindestmaße, Gitterabstand & Sitzstangen";
const description = "Berechnen Sie Mindestmaße des Vogelkäfigs nach Vogelart, empfohlenen Gitterabstand, Sitzstangenanzahl und Spielzeugempfehlungen.";
const relatedCalcs = [
  { name: "Tier-Kalorien-Rechner", url: "/de/tier-kalorien-rechner", description: "Haustier-Kalorien." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Bootskredit-Rechner", url: "/de/bootskredit-rechner", description: "Kreditberechnung." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Zahnspange-Kosten-Rechner", url: "/de/zahnspange-kosten-rechner", description: "Kostenrechner." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Vogelkäfig-Rechner" enSlug="bird-cage-calculator" keywords="Vogelkäfig Größe, Mindestmaße Käfig, Gitterabstand, Papageienkäfig, Wellensittichkäfig, Sitzstangen" breadcrumbs={[{ name: "Vogelkäfig-Rechner", url: "/de/vogelkaefig-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Vogelkäfig-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die richtigen Käfigmaße, Gitterabstände, Sitzstangenanzahl und Spielzeugempfehlungen für Ihre Vogelart.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Vogelart</label>
            <select id="vk-species" class="vk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="finch">Fink / Kanarienvogel</option>
              <option value="budgie" selected>Wellensittich</option>
              <option value="cockatiel">Nymphensittich</option>
              <option value="conure">Sittich (Conure)</option>
              <option value="amazon">Amazonenpapagei</option>
              <option value="african_grey">Graupapagei</option>
              <option value="cockatoo">Kakadu</option>
              <option value="macaw">Ara</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Vögel</label>
            <input type="number" id="vk-count" class="vk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="20" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mindest-Käfiggröße</div>
          <div class="text-5xl font-extrabold font-mono" id="vk-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Breite (cm)</div><div class="text-xl font-bold font-mono" id="vk-width">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tiefe (cm)</div><div class="text-xl font-bold font-mono" id="vk-depth">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Höhe (cm)</div><div class="text-xl font-bold font-mono" id="vk-height">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gitterabstand</div><div class="text-xl font-bold font-mono" id="vk-bars">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sitzstangen</div><div class="text-xl font-bold font-mono" id="vk-perch">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spielzeug empf.</div><div class="text-xl font-bold font-mono" id="vk-toys">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Futternäpfe</div><div class="text-xl font-bold font-mono" id="vk-dishes">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stangendurchmesser</div><div class="text-xl font-bold font-mono" id="vk-perchd">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="vogelkaefig" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Den richtigen Vogelkäfig wählen</h2>
      <p>Die Käfiggröße ist entscheidend für das Wohlbefinden Ihres Vogels. Der Käfig sollte mindestens so groß sein, dass der Vogel seine Flügel vollständig ausbreiten und kurze Flüge machen kann. Größer ist immer besser! Der Gitterabstand muss zur Vogelart passen, damit sich der Vogel nicht verletzen kann.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Kann der Käfig zu groß sein?</strong> Nein, ein Käfig kann für einen Vogel nicht zu groß sein. Achten Sie nur darauf, dass der Gitterabstand zur Vogelart passt.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcVK() {
      const species = (document.getElementById('vk-species') as HTMLSelectElement).value;
      const count = parseInt((document.getElementById('vk-count') as HTMLInputElement).value) || 1;
      // Minimum dimensions (W x D x H in cm) for 1 bird, bar spacing, perch diameter
      const specs: Record<string, { w: number; d: number; h: number; bar: string; perchD: string }> = {
        finch:        { w: 60, d: 35, h: 45, bar: '10mm', perchD: '10mm' },
        budgie:       { w: 60, d: 40, h: 45, bar: '12mm', perchD: '12mm' },
        cockatiel:    { w: 60, d: 45, h: 60, bar: '16mm', perchD: '16mm' },
        conure:       { w: 75, d: 55, h: 75, bar: '19mm', perchD: '19mm' },
        amazon:       { w: 90, d: 60, h: 90, bar: '19-25mm', perchD: '25mm' },
        african_grey: { w: 90, d: 60, h: 100, bar: '19-25mm', perchD: '25mm' },
        cockatoo:     { w: 100, d: 75, h: 120, bar: '25-38mm', perchD: '32mm' },
        macaw:        { w: 120, d: 90, h: 150, bar: '25-38mm', perchD: '38mm' },
      };
      const spec = specs[species] || specs['budgie'];
      const scale = 1 + (count - 1) * 0.5;
      const width = Math.round(spec.w * scale);
      const depth = Math.round(spec.d * scale);
      const height = Math.round(spec.h * Math.max(1, 1 + (count - 1) * 0.2));
      const totalSize = width + ' x ' + depth + ' x ' + height + ' cm';
      const perches = Math.max(2, count + 1);
      const toys = Math.max(3, count * 2);
      const dishes = count + 1;
      document.getElementById('vk-result')!.textContent = totalSize;
      document.getElementById('vk-width')!.textContent = width.toString();
      document.getElementById('vk-depth')!.textContent = depth.toString();
      document.getElementById('vk-height')!.textContent = height.toString();
      document.getElementById('vk-bars')!.textContent = spec.bar;
      document.getElementById('vk-perch')!.textContent = perches.toString();
      document.getElementById('vk-toys')!.textContent = toys.toString();
      document.getElementById('vk-dishes')!.textContent = dishes.toString();
      document.getElementById('vk-perchd')!.textContent = spec.perchD;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vk-in').forEach(el => { el.addEventListener('input', calcVK); el.addEventListener('change', calcVK); });
      calcVK();
    }, 50);
  </script>
</CalculatorLayout>
