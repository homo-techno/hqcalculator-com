---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schriftliche Division Rechner – Schritt-für-Schritt Anleitung";
const description = "Dividieren Sie Zahlen schriftlich mit Schritt-für-Schritt-Anleitung. Ganzzahldivision mit Rest verständlich erklärt.";

const relatedCalcs = [
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Brüche berechnen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwerte berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Modulo-Rechner", url: "/de/modulo-rechner", description: "Rest einer Division." },
];
---
<CalculatorLayout lang="de" enSlug="long-division-calculator" title={title} description={description} calculatorName="Schriftliche Division Rechner" keywords="schriftliche Division, Division mit Rest, Langdivision, Rechenschritte" breadcrumbs={[{ name: "Schriftliche Division", url: "/de/schriftliche-division-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schriftliche Division Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Dividend und Divisor ein – der Rechner zeigt jeden Schritt der schriftlichen Division.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Dividend (wird geteilt)</label>
            <input type="number" id="sd-dividend" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="1234" step="1" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Divisor (durch)</label>
            <input type="number" id="sd-divisor" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="7" step="1" min="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ergebnis</div>
          <div class="text-4xl font-extrabold font-mono" id="sd-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="sd-rest"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Schrittweise Lösung</h3>
          <div class="text-sm font-mono space-y-1 leading-relaxed" id="sd-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="long-division" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Schriftliche Division – Grundlagen</h2>
      <p>Die schriftliche Division (auch Langdivision genannt) ist eine Methode, um große Zahlen durch schrittweises Teilen zu dividieren. Sie ist ein grundlegendes Verfahren in der Grundschulmathematik und ermöglicht es, Divisionen ohne Taschenrechner durchzuführen. Bei der schriftlichen Division wird der Dividend Ziffer für Ziffer durch den Divisor geteilt, wobei jeweils der Rest in den nächsten Schritt übernommen wird.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen Quotient und Rest?</h3>
      <p>Der Quotient ist das Ergebnis der Division (die ganzzahlige Anzahl, wie oft der Divisor in den Dividenden passt). Der Rest ist der verbleibende Wert, der kleiner als der Divisor ist. Beispiel: 17 ÷ 5 = 3 Rest 2.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie überprüfe ich mein Ergebnis?</h3>
      <p>Multiplizieren Sie Quotient × Divisor und addieren Sie den Rest. Das Ergebnis muss dem Dividenden entsprechen: Quotient × Divisor + Rest = Dividend.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was passiert, wenn der Divisor größer als der Dividend ist?</h3>
      <p>Wenn der Divisor größer als der Dividend ist, ist der Quotient 0 und der Rest entspricht dem Dividenden. Beispiel: 3 ÷ 7 = 0 Rest 3.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Kann man durch 0 dividieren?</h3>
      <p>Nein, die Division durch 0 ist mathematisch nicht definiert und führt zu keinem gültigen Ergebnis.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSD() {
      const dividend = parseInt((document.getElementById('sd-dividend') as HTMLInputElement).value) || 0;
      const divisor = parseInt((document.getElementById('sd-divisor') as HTMLInputElement).value) || 1;
      if (divisor === 0) {
        document.getElementById('sd-result')!.textContent = 'Fehler';
        document.getElementById('sd-rest')!.textContent = 'Division durch 0 ist nicht möglich';
        document.getElementById('sd-steps')!.innerHTML = '';
        return;
      }
      const quotient = Math.floor(Math.abs(dividend) / Math.abs(divisor));
      const remainder = Math.abs(dividend) % Math.abs(divisor);
      const sign = (dividend < 0) !== (divisor < 0) && dividend !== 0 ? '-' : '';
      document.getElementById('sd-result')!.textContent = sign + quotient.toLocaleString('de-DE');
      document.getElementById('sd-rest')!.textContent = remainder > 0 ? `Rest: ${remainder}` : 'Kein Rest – geht glatt auf';

      const divStr = String(Math.abs(dividend));
      const div = Math.abs(divisor);
      let steps = '';
      let current = 0;
      let quotientStr = '';
      for (let i = 0; i < divStr.length; i++) {
        current = current * 10 + parseInt(divStr[i]);
        const q = Math.floor(current / div);
        const r = current % div;
        quotientStr += q;
        steps += `Schritt ${i + 1}: ${current} ÷ ${div} = ${q}, ${q} × ${div} = ${q * div}, Rest ${r}\n`;
        current = r;
      }
      document.getElementById('sd-steps')!.innerHTML = steps.trim().split('\n').map(s => `<div class="py-0.5 border-b border-border/30">${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('sd-dividend')!.addEventListener('input', calcSD);
      document.getElementById('sd-divisor')!.addEventListener('input', calcSD);
      calcSD();
    }, 50);
  </script>
</CalculatorLayout>
