---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Asphaltrechner - Tonnen, Volumen & Kostenschätzung";
const description = "Berechnen Sie den Asphaltbedarf für Einfahrten und Parkplätze. Geben Sie Fläche und Dicke ein, um Tonnen, Volumen und Kosten zu ermitteln.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/concrete-calculator", description: "Betonmengen-Rechner." },
  { name: "Aushubrechner", url: "/excavation-calculator", description: "Aushubvolumen." },
  { name: "Kiesrechner", url: "/gravel-calculator", description: "Kies und Schotter." },
  { name: "Terrassenrechner", url: "/patio-calculator", description: "Terrassenmaterial." },
  { name: "Bewehrungsrechner", url: "/rebar-calculator", description: "Bewehrungsbedarf." },
  { name: "Fundamentrechner", url: "/foundation-calculator", description: "Fundamentplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Asphaltrechner" keywords="Asphaltrechner, Asphalt Tonnen, Asphaltmischung, Einfahrt Asphalt, Asphalt Kosten, Schwarzdecke" lang="de" breadcrumbs={[{ name: "Asphaltrechner", url: "/de/asphalt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Asphaltrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Asphaltmenge, Volumen und Kosten für Pflasterprojekte.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Länge (m)</label>
              <input type="number" id="ap-length" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="15" min="0" step="0.5">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Breite (m)</label>
              <input type="number" id="ap-width" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="6" min="0" step="0.5">
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Dicke (cm)</label>
            <select id="ap-thickness" class="w-full px-3 py-3 border border-border rounded-xl text-lg">
              <option value="3">3 cm (Deckschicht)</option>
              <option value="4">4 cm (Deckschicht)</option>
              <option value="5" selected>5 cm (Einfahrt Standard)</option>
              <option value="8">8 cm (Standard)</option>
              <option value="10">10 cm (Schwerlast)</option>
              <option value="15">15 cm (Gewerbe)</option>
            </select>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-text mb-1">Kosten pro Tonne (\u20AC)</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">\u20AC</span>
                  <input type="number" id="ap-cost" class="w-full pl-7 pr-3 py-2 border border-border rounded-lg" value="80" min="0" step="5">
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label>
                <input type="number" id="ap-waste" class="w-full px-3 py-2 border border-border rounded-lg" value="10" min="0" max="50" step="1">
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Asphalt benötigt</div>
            <div class="text-5xl font-extrabold font-mono" id="ap-tons">0</div>
            <div class="text-sm text-blue-200 mt-1">Tonnen (inkl. Verschnitt)</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Fläche</div>
              <div class="text-xl font-bold" id="ap-area">0 m\u00B2</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Volumen</div>
              <div class="text-xl font-bold" id="ap-volume">0 m\u00B3</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Geschätzte Kosten</div>
              <div class="text-2xl font-bold text-secondary" id="ap-total">0 \u20AC</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">LKW-Ladungen (25 t)</div>
              <div class="text-xl font-bold" id="ap-trucks">0</div>
            </div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="asphalt" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Asphalt berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Volumen:</strong> Fläche (m\u00B2) x Dicke (m) = m\u00B3</p>
        <p><strong>Gewicht:</strong> m\u00B3 x 2,4 t/m\u00B3 = Tonnen</p>
        <p><strong>Faustregel:</strong> 1 Tonne deckt ca. 8 m\u00B2 bei 5 cm Dicke</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Asphaltdicke-Richtwerte</h3>
      <ul>
        <li><strong>3-4 cm:</strong> Deckschicht / Überzug bestehender Beläge</li>
        <li><strong>5 cm:</strong> Standard-Einfahrt</li>
        <li><strong>8-10 cm:</strong> Schwerlast-Einfahrt, leichtes Gewerbe</li>
        <li><strong>15+ cm:</strong> Gewerbliche Parkplätze, Straßen</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAsphalt() {
      const length = parseFloat((document.getElementById('ap-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('ap-width') as HTMLInputElement).value) || 0;
      const thickness = parseFloat((document.getElementById('ap-thickness') as HTMLSelectElement).value) || 5;
      const costPerTon = parseFloat((document.getElementById('ap-cost') as HTMLInputElement).value) || 0;
      const waste = (parseFloat((document.getElementById('ap-waste') as HTMLInputElement).value) || 0) / 100;

      const area = length * width;
      const volumeM3 = area * (thickness / 100);

      // Asphalt density ~2.4 t/m³
      const tonsRaw = volumeM3 * 2.4;
      const tonsWithWaste = tonsRaw * (1 + waste);

      const totalCost = tonsWithWaste * costPerTon;
      const truckLoads = Math.ceil(tonsWithWaste / 25);

      const fmt = (n: number, d: number) => n.toLocaleString('de-DE', { maximumFractionDigits: d });
      document.getElementById('ap-tons')!.textContent = fmt(tonsWithWaste, 1);
      document.getElementById('ap-area')!.textContent = fmt(area, 0) + ' m\u00B2';
      document.getElementById('ap-volume')!.textContent = fmt(volumeM3 * (1 + waste), 1) + ' m\u00B3';
      document.getElementById('ap-total')!.textContent = Math.round(totalCost).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('ap-trucks')!.textContent = String(truckLoads);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('#ap-length, #ap-width, #ap-cost, #ap-waste').forEach(el => {
        el.addEventListener('input', calcAsphalt);
        el.addEventListener('change', calcAsphalt);
      });
      document.querySelectorAll('#ap-thickness').forEach(el => {
        el.addEventListener('input', calcAsphalt);
        el.addEventListener('change', calcAsphalt);
      });
      calcAsphalt();
    }, 50);
  </script>
</CalculatorLayout>
