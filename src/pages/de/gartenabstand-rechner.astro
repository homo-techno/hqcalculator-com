---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gartenabstand-Rechner - Pflanzenabstand & Anzahl";
const description = "Berechnen Sie, wie viele Pflanzen in Ihr Beet passen, basierend auf Abmessungen, Pflanzenabstand und Reihenabstand.";
const relatedCalcs = [
  { name: "Kompost-Rechner", url: "/de/kompost-rechner", description: "Kompostverh\u00E4ltnis." },
  { name: "D\u00FCnger-Rechner", url: "/de/duenger-rechner", description: "D\u00FCngerbedarf." },
  { name: "Bew\u00E4sserungs-Rechner", url: "/de/bewaesserungs-rechner", description: "Bew\u00E4sserung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gartenabstand-Rechner" lang="de" enSlug="garden-spacing-calculator" keywords="gartenabstand, pflanzenabstand rechner, beet bepflanzen, pflanzen pro beet, reihenabstand, gartenplanung" breadcrumbs={[{ name: "Gartenabstand", url: "/de/gartenabstand-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gartenabstand-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie viele Pflanzen mit optimalem Abstand in Ihr Gartenbeet passen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beetl&auml;nge (m)</label>
            <input type="number" id="gab-length" class="gab-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0" step="0.1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beetbreite (m)</label>
            <input type="number" id="gab-width" class="gab-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.2" min="0" step="0.1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Pflanzenabstand (cm)</label>
            <input type="number" id="gab-plant" class="gab-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Reihenabstand (cm)</label>
            <input type="number" id="gab-row" class="gab-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="1" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Pflanzen gesamt</div>
          <div class="text-5xl font-extrabold font-mono" id="gab-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reihen</div><div class="text-xl font-bold font-mono" id="gab-rows">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pflanzen/Reihe</div><div class="text-xl font-bold font-mono" id="gab-perrow">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beetfl&auml;che</div><div class="text-xl font-bold font-mono" id="gab-area">0 m&sup2;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fl&auml;che/Pflanze</div><div class="text-xl font-bold font-mono" id="gab-perplant">0 cm&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anordnung</div><div class="text-xl font-bold font-mono" id="gab-layout">-</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="garden-spacing" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Pflanzenabst&auml;nde richtig berechnen</h2>
      <p>Der richtige Abstand zwischen Pflanzen ist entscheidend f&uuml;r gesundes Wachstum und optimale Ernteertr&auml;ge. Zu enge Pflanzung f&uuml;hrt zu Konkurrenz um Licht, Wasser und N&auml;hrstoffe.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welcher Abstand f&uuml;r Tomaten?</strong> Tomaten ben&ouml;tigen 50-60 cm Pflanzenabstand und 80-100 cm Reihenabstand.</p>
      <p><strong>Was ist der Unterschied zwischen Pflanzen- und Reihenabstand?</strong> Der Pflanzenabstand ist der Abstand innerhalb einer Reihe, der Reihenabstand der Abstand zwischen den Reihen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGAB() {
      const length = parseFloat((document.getElementById('gab-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('gab-width') as HTMLInputElement).value) || 0;
      const plantSpacing = parseFloat((document.getElementById('gab-plant') as HTMLInputElement).value) || 1;
      const rowSpacing = parseFloat((document.getElementById('gab-row') as HTMLInputElement).value) || 1;
      const lengthCm = length * 100;
      const widthCm = width * 100;
      const rows = Math.floor(widthCm / rowSpacing) + 1;
      const plantsPerRow = Math.floor(lengthCm / plantSpacing) + 1;
      const totalPlants = rows * plantsPerRow;
      const bedArea = length * width;
      const areaPerPlant = totalPlants > 0 ? (bedArea * 10000) / totalPlants : 0;
      let layout = 'Raster';
      if (plantSpacing === rowSpacing) layout = 'Quadrat-Raster';
      else if (rowSpacing > plantSpacing) layout = 'Reihen-Raster';
      else layout = 'Dichtes Raster';
      document.getElementById('gab-result')!.textContent = totalPlants.toString();
      document.getElementById('gab-rows')!.textContent = rows.toString();
      document.getElementById('gab-perrow')!.textContent = plantsPerRow.toString();
      document.getElementById('gab-area')!.textContent = bedArea.toFixed(1) + ' m\u00B2';
      document.getElementById('gab-perplant')!.textContent = areaPerPlant.toFixed(0) + ' cm\u00B2';
      document.getElementById('gab-layout')!.textContent = layout;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gab-in').forEach(el => { el.addEventListener('input', calcGAB); el.addEventListener('change', calcGAB); });
      calcGAB();
    }, 50);
  </script>
</CalculatorLayout>
