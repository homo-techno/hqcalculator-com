---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fleisch Garzeit Rechner - Garzeiten und Kerntemperaturen";
const description = "Berechnen Sie optimale Garzeiten und Kerntemperaturen für verschiedene Fleischsorten. Rind, Schwein, Lamm, Geflügel und Wild – perfekt gegart nach Gewicht.";
const relatedCalcs = [
  { name: "Meal-Prep Rechner", url: "/de/mahlzeit-vorbereitung-rechner", description: "Mahlzeitvorbereitung planen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorien berechnen." },
  { name: "Umrechnungsrechner", url: "/de/einheitenrechner", description: "Einheiten umrechnen." },
  { name: "Körpergewicht Rechner", url: "/de/idealgewicht-rechner", description: "Idealgewicht berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="meat-cooking-calculator" calculatorName="Fleisch Garzeit Rechner" keywords="Fleisch Garzeit Rechner, Kerntemperatur, Braten Garzeit, Roastbeef Temperatur, Fleisch richtig garen" breadcrumbs={[{ name: "Fleisch Garzeit Rechner", url: "/de/fleisch-garzeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fleisch Garzeit Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die optimale Garzeit und Kerntemperatur für verschiedene Fleischsorten und Garstufen – für Backofen und Grill.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fleischsorte</label>
            <select id="fg-meat" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="beef" selected>Rindfleisch (Braten/Roastbeef)</option>
              <option value="pork">Schweinefleisch</option>
              <option value="lamb">Lammfleisch</option>
              <option value="chicken">Hähnchen (ganz)</option>
              <option value="turkey">Truthahn (ganz)</option>
              <option value="venison">Wild (Reh/Hirsch)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Garstufe</label>
            <select id="fg-done" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="rare">Rare (blutig)</option>
              <option value="medium-rare" selected>Medium Rare (rosa)</option>
              <option value="medium">Medium (halb durch)</option>
              <option value="well">Well Done (durch)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="fg-weight" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" min="0.1" max="20" step="0.1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ofentemperatur (°C)</label>
            <select id="fg-oven" class="fg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="160">160 °C (Schonend)</option>
              <option value="180" selected>180 °C (Standard)</option>
              <option value="200">200 °C (Kräftig)</option>
              <option value="220">220 °C (Heiß)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Garzeit</div>
          <div class="text-5xl font-extrabold font-mono" id="fg-time">--</div>
          <div class="text-sm text-blue-200 mt-1" id="fg-ready">inkl. 10 Min. Ruhezeit</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ziel-Kerntemperatur</div><div class="text-xl font-bold" id="fg-temp">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Herausnehmen bei</div><div class="text-xl font-bold" id="fg-remove">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Min./kg</div><div class="text-xl font-bold" id="fg-rate">--</div></div>
        </div>
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl">
          <p class="text-sm text-amber-800" id="fg-tip">--</p>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fleisch-garzeit" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kerntemperaturen für sicheres und leckeres Fleisch</h2>
      <p>Die Kerntemperatur ist der zuverlässigste Indikator für den Garzustand von Fleisch. Ein Fleischthermometer sorgt für reproduzierbare Ergebnisse. Geflügel sollte stets vollständig durchgegart werden (mindestens 75 °C Kerntemperatur), während Rindfleisch und Lamm je nach Geschmack rosa serviert werden darf. Nach dem Herausnehmen aus dem Ofen steigt die Kerntemperatur noch um 3–5 °C an (Nachgaren) – dies sollte beim Herausnehmen berücksichtigt werden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange braucht ein Rinderbraten pro kg?</strong> Bei 180 °C benötigt ein Rinderbraten ca. 25–35 Minuten pro Kilogramm für medium rare. Ein Kernthermometer ist die sicherste Methode.</p>
      <p><strong>Wie hoch muss die Kerntemperatur bei Hähnchen sein?</strong> Hähnchen und anderes Geflügel müssen vollständig durchgegart sein: mindestens 75–80 °C Kerntemperatur im dicksten Teil der Brust oder Keule.</p>
      <p><strong>Was bedeutet Ruhezeit nach dem Garen?</strong> Nach dem Herausnehmen aus dem Ofen sollte Fleisch 10–20 Minuten ruhen. In dieser Zeit verteilt sich der Fleischsaft gleichmäßig und die Kerntemperatur steigt noch etwas an.</p>
      <p><strong>Kann ich gefrorenes Fleisch direkt garen?</strong> Gefrorenes Fleisch sollte vor dem Garen vollständig aufgetaut werden, um eine gleichmäßige Garung zu gewährleisten. Die Garzeit verlängert sich sonst erheblich.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const fgData: Record<string, Record<string, { temp: number; min_per_kg: number }>> = {
      beef: { rare: { temp: 52, min_per_kg: 20 }, 'medium-rare': { temp: 57, min_per_kg: 25 }, medium: { temp: 63, min_per_kg: 30 }, well: { temp: 72, min_per_kg: 40 } },
      pork: { rare: { temp: 65, min_per_kg: 30 }, 'medium-rare': { temp: 68, min_per_kg: 35 }, medium: { temp: 72, min_per_kg: 40 }, well: { temp: 77, min_per_kg: 50 } },
      lamb: { rare: { temp: 54, min_per_kg: 20 }, 'medium-rare': { temp: 60, min_per_kg: 25 }, medium: { temp: 65, min_per_kg: 30 }, well: { temp: 72, min_per_kg: 40 } },
      chicken: { rare: { temp: 75, min_per_kg: 40 }, 'medium-rare': { temp: 77, min_per_kg: 45 }, medium: { temp: 80, min_per_kg: 50 }, well: { temp: 82, min_per_kg: 55 } },
      turkey: { rare: { temp: 75, min_per_kg: 35 }, 'medium-rare': { temp: 77, min_per_kg: 40 }, medium: { temp: 80, min_per_kg: 45 }, well: { temp: 82, min_per_kg: 50 } },
      venison: { rare: { temp: 54, min_per_kg: 18 }, 'medium-rare': { temp: 58, min_per_kg: 22 }, medium: { temp: 63, min_per_kg: 28 }, well: { temp: 70, min_per_kg: 35 } }
    };
    const fgTips: Record<string, string> = {
      beef: 'Tipp: Rindfleisch vor dem Garen auf Zimmertemperatur bringen. Bei hoher Hitze kurz anbraten, dann bei niedrigerer Temperatur fertig garen.',
      pork: 'Tipp: Schweinefleisch immer vollständig durchgaren. Lassen Sie es 10 Minuten ruhen, bevor Sie es anschneiden.',
      lamb: 'Tipp: Lamm sollte vor dem Garen mit Knoblauch und Rosmarin gespickt werden. Ruhezeit von mindestens 10 Minuten einhalten.',
      chicken: 'Wichtig: Geflügel immer vollständig durchgaren (min. 75 °C). Kerntemperatur im dicksten Teil der Brust messen.',
      turkey: 'Tipp: Truthahn am besten über Nacht im Kühlschrank auftauen lassen. Regelmäßig mit Bratensaft übergießen.',
      venison: 'Tipp: Wildfleisch ist magerer als Rind und gart schneller. Nicht zu lange garen, da es sonst trocken wird.'
    };
    const fgDoneNames: Record<string, string> = { rare: 'blutig', 'medium-rare': 'rosa', medium: 'halb durch', well: 'durchgegart' };
    function calcFG() {
      const meat = (document.getElementById('fg-meat') as HTMLSelectElement).value;
      const done = (document.getElementById('fg-done') as HTMLSelectElement).value;
      const weight = parseFloat((document.getElementById('fg-weight') as HTMLInputElement).value) || 0;
      const oven = parseInt((document.getElementById('fg-oven') as HTMLSelectElement).value) || 180;
      const ovFactor = oven === 160 ? 1.2 : oven === 200 ? 0.9 : oven === 220 ? 0.8 : 1.0;
      const d = fgData[meat]?.[done];
      if (!d || weight <= 0) return;
      const minPerKg = Math.round(d.min_per_kg * ovFactor);
      const totalMin = Math.round(minPerKg * weight);
      const h = Math.floor(totalMin / 60);
      const m = totalMin % 60;
      const timeStr = h > 0 ? h + ' Std. ' + m + ' Min.' : m + ' Min.';
      document.getElementById('fg-time')!.textContent = timeStr;
      document.getElementById('fg-ready')!.textContent = 'Ziel-Garstufe: ' + fgDoneNames[done] + ' – inkl. 10 Min. Ruhezeit';
      document.getElementById('fg-temp')!.textContent = d.temp + ' °C';
      document.getElementById('fg-remove')!.textContent = (d.temp - 3) + ' °C';
      document.getElementById('fg-rate')!.textContent = minPerKg + ' Min./kg';
      document.getElementById('fg-tip')!.textContent = fgTips[meat] || '';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fg-in').forEach(el => { el.addEventListener('input', calcFG); el.addEventListener('change', calcFG); });
      calcFG();
    }, 50);
  </script>
</CalculatorLayout>
