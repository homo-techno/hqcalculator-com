---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kohlenstoffbindung-Rechner – CO₂-Aufnahme durch Bäume";
const description = "Berechnen Sie die CO₂-Aufnahme durch Bäume basierend auf Anzahl, Alter und Baumart. Schätzen Sie den Wert von CO₂-Zertifikaten.";
const relatedCalcs = [
  { name: "CO₂-Fußabdruck-Rechner", url: "/de/co2-fussabdruck-rechner", description: "Gesamten Fußabdruck berechnen." },
  { name: "CO₂-Kompensation-Rechner", url: "/de/co2-kompensation-rechner", description: "Kompensation berechnen." },
  { name: "CO₂-Steuer-Rechner", url: "/de/co2-steuer-rechner", description: "CO₂-Steuer." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kohlenstoffbindung-Rechner" enSlug="carbon-sequestration-calculator" keywords="Kohlenstoffbindung, CO₂ Absorption, Baum CO₂, CO₂-Zertifikate, Aufforstung, Klimaschutz" breadcrumbs={[{ name: "Kohlenstoffbindung-Rechner", url: "/de/kohlenstoffbindung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kohlenstoffbindung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die CO₂-Absorption durch Bäume und berechnen Sie den Wert von CO₂-Zertifikaten für Aufforstungsprojekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Baumart</label>
          <select id="csq-species" class="csq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="22">Laubbaum - schnell (Pappel, 22 kg CO₂/Jahr)</option>
            <option value="16" selected>Laubbaum - mittel (Eiche/Ahorn, 16 kg CO₂/Jahr)</option>
            <option value="11">Laubbaum - langsam (Walnuss, 11 kg CO₂/Jahr)</option>
            <option value="18">Nadelbaum - schnell (Kiefer, 18 kg CO₂/Jahr)</option>
            <option value="14">Nadelbaum - mittel (Fichte, 14 kg CO₂/Jahr)</option>
            <option value="10">Nadelbaum - langsam (Zeder, 10 kg CO₂/Jahr)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Bäume</label><input type="number" id="csq-count" class="csq-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="1" max="100000" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Durchschnittliches Alter (Jahre)</label><input type="number" id="csq-age" class="csq-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="1" max="200" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">CO₂-Zertifikatspreis (€/Tonne)</label><input type="number" id="csq-credit" class="csq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="200" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Projektlaufzeit (Jahre)</label><input type="number" id="csq-years" class="csq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="100" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jährlich gebundenes CO₂</div>
          <div class="text-5xl font-extrabold font-mono" id="csq-annual">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lebenszeitbindung</div><div class="text-xl font-bold font-mono" id="csq-lifetime">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Projektgesamt</div><div class="text-xl font-bold font-mono" id="csq-project">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tonnen CO₂/Jahr</div><div class="text-xl font-bold font-mono" id="csq-tons">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zertifikatswert/Jahr</div><div class="text-xl font-bold font-mono" id="csq-valueyr">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamter Zertifikatswert</div><div class="text-xl font-bold font-mono" id="csq-valuetot">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Äquivalent ausgeglichene Autos (pro Jahr)</div>
          <div class="text-xl font-bold font-mono" id="csq-cars">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="carbon-sequestration" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kohlenstoffbindung verstehen</h2>
      <p>Bäume absorbieren CO₂ aus der Atmosphäre durch Photosynthese. Die Bindungsrate hängt von Baumart, Alter und Standortbedingungen ab. Junge Bäume binden weniger, ausgewachsene Bäume am meisten, und alte Bäume nehmen wieder ab.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCSQ() {
      const co2PerTreeYr = parseFloat((document.getElementById('csq-species') as HTMLSelectElement).value) || 16;
      const count = parseFloat((document.getElementById('csq-count') as HTMLInputElement).value) || 100;
      const age = parseFloat((document.getElementById('csq-age') as HTMLInputElement).value) || 20;
      const creditPrice = parseFloat((document.getElementById('csq-credit') as HTMLInputElement).value) || 30;
      const projYears = parseFloat((document.getElementById('csq-years') as HTMLInputElement).value) || 10;
      const ageFactor = age < 10 ? 0.5 : age < 30 ? 1.0 : age < 60 ? 0.85 : 0.6;
      const adjustedRate = co2PerTreeYr * ageFactor;
      const annualCO2kg = adjustedRate * count;
      const annualCO2tons = annualCO2kg / 1000;
      const lifetimeCO2 = adjustedRate * count * age;
      const projectCO2 = annualCO2kg * projYears;
      const creditValueYr = annualCO2tons * creditPrice;
      const creditValueTotal = creditValueYr * projYears;
      const carsOffset = annualCO2kg / 4600;
      const fmt = (v: number) => v.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('csq-annual')!.textContent = Math.round(annualCO2kg).toLocaleString('de-DE') + ' kg';
      document.getElementById('csq-lifetime')!.textContent = fmt(lifetimeCO2 / 1000) + ' t';
      document.getElementById('csq-project')!.textContent = fmt(projectCO2 / 1000) + ' t';
      document.getElementById('csq-tons')!.textContent = annualCO2tons.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.getElementById('csq-valueyr')!.textContent = Math.round(creditValueYr).toLocaleString('de-DE') + ' €';
      document.getElementById('csq-valuetot')!.textContent = Math.round(creditValueTotal).toLocaleString('de-DE') + ' €';
      document.getElementById('csq-cars')!.textContent = fmt(carsOffset) + ' Autos';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('csq-count') as HTMLInputElement).value = '100';
      (document.getElementById('csq-age') as HTMLInputElement).value = '20';
      (document.getElementById('csq-credit') as HTMLInputElement).value = '30';
      (document.getElementById('csq-years') as HTMLInputElement).value = '10';
      document.querySelectorAll('.csq-in').forEach(el => { el.addEventListener('input', calcCSQ); el.addEventListener('change', calcCSQ); });
      calcCSQ();
    }, 50);
  </script>
</CalculatorLayout>
