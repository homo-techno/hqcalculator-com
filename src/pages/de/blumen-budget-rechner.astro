---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blumen-Budget-Rechner - Blumenarrangement-Kosten";
const description = "Sch&auml;tzen Sie die Kosten f&uuml;r Blumenarrangements bei Events inkl. Tischgestecke, Brautstrau&szlig;, Ansteckblumen und Zeremonie-Dekoration.";
const relatedCalcs = [
  { name: "Event-Budget", url: "/de/event-budget-rechner", description: "Event-Kosten." },
  { name: "Sitzplan", url: "/de/sitzplan-rechner", description: "Tischplanung." },
  { name: "Hochzeitszeitplan", url: "/de/hochzeitszeitplan-rechner", description: "Tagesablauf." },
  { name: "Tortenrechner", url: "/de/tortenrechner", description: "Tortengr&ouml;&szlig;e." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Blumen-Budget-Rechner" lang="de" enSlug="floral-budget-calculator" keywords="Blumen Budget, Hochzeitsblumen Kosten, Tischgesteck Preis, Brautstrau&szlig; Preis, Event Blumen, Blumenarrangement Rechner" breadcrumbs={[{ name: "Blumen-Budget", url: "/de/blumen-budget-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blumen-Budget-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Blumenkosten f&uuml;r Ihre Veranstaltung oder Hochzeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Preiskategorie</label>
          <select id="blb-tier" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="budget">G&uuml;nstig (&euro;)</option>
            <option value="mid" selected>Mittelklasse (&euro;&euro;)</option>
            <option value="luxury">Luxus (&euro;&euro;&euro;)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Brautstr&auml;u&szlig;e</label><input type="number" id="blb-bridal" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Brautjungfernstr&auml;u&szlig;e</label><input type="number" id="blb-bmaids" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Ansteckblumen</label><input type="number" id="blb-bouts" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Corsagen</label><input type="number" id="blb-corsages" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Tischgestecke</label><input type="number" id="blb-centers" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="1"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Traubogen / Altar-Arrangement</label>
          <select id="blb-arch" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Keiner</option>
            <option value="1" selected>Einfacher Bogen (1 Arrangement)</option>
            <option value="2">Voller Bogen (2 Arrangements)</option>
            <option value="3">Gro&szlig;er Bogen + Gang (3 Arrangements)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Stuhl-/Bankschmuck</label><input type="number" id="blb-pews" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="2"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Blumenm&auml;dchen-Bl&uuml;ten (Beutel)</label><input type="number" id="blb-petals" class="blb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" step="1"></div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tztes Blumenbudget</div>
        <div class="text-5xl font-extrabold" id="blb-total">--</div>
        <div class="text-sm mt-1" id="blb-tier-label">--</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Personen-Blumen</div><div class="text-xl font-bold" id="blb-personal">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeremonie-Blumen</div><div class="text-xl font-bold" id="blb-ceremony">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfangs-Blumen</div><div class="text-xl font-bold" id="blb-reception">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahl Positionen</div><div class="text-xl font-bold" id="blb-items">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="blb-details"></div>
      <ShareButton lang="de" calculatorId="floral-budget" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie viel Prozent des Budgets f&uuml;r Blumen?</strong> Hochzeitsblumen machen typischerweise 8-10% des Gesamtbudgets aus.</p>
      <p><strong>Wie kann man bei Blumen sparen?</strong> Saisonale und regionale Blumen sparen 20-30%. Gr&uuml;npflanzen als Erg&auml;nzung nutzen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBLB() {
      const tier = (document.getElementById('blb-tier') as HTMLSelectElement).value;
      const bridal = parseInt((document.getElementById('blb-bridal') as HTMLInputElement).value) || 0;
      const bmaids = parseInt((document.getElementById('blb-bmaids') as HTMLInputElement).value) || 0;
      const bouts = parseInt((document.getElementById('blb-bouts') as HTMLInputElement).value) || 0;
      const corsages = parseInt((document.getElementById('blb-corsages') as HTMLInputElement).value) || 0;
      const centers = parseInt((document.getElementById('blb-centers') as HTMLInputElement).value) || 0;
      const archCount = parseInt((document.getElementById('blb-arch') as HTMLSelectElement).value) || 0;
      const pews = parseInt((document.getElementById('blb-pews') as HTMLInputElement).value) || 0;
      const petals = parseInt((document.getElementById('blb-petals') as HTMLInputElement).value) || 0;
      let mult = 1;
      let tierLabel = 'Mittelklasse-Preise';
      if (tier === 'budget') { mult = 0.6; tierLabel = 'G\u00fcnstige Preise'; }
      else if (tier === 'luxury') { mult = 1.8; tierLabel = 'Luxus-Preise'; }
      const prices = {
        bridal: 180 * mult, bmaid: 75 * mult, bout: 15 * mult, corsage: 30 * mult,
        center: 100 * mult, arch: 300 * mult, pew: 25 * mult, petals: 20 * mult,
      };
      const pBridal = bridal * prices.bridal;
      const pBmaids = bmaids * prices.bmaid;
      const pBouts = bouts * prices.bout;
      const pCorsages = corsages * prices.corsage;
      const pCenters = centers * prices.center;
      const pArch = archCount * prices.arch;
      const pPews = pews * prices.pew;
      const pPetals = petals * prices.petals;
      const personalTotal = pBridal + pBmaids + pBouts + pCorsages;
      const ceremonyTotal = pArch + pPews + pPetals;
      const receptionTotal = pCenters;
      const deliverySetup = Math.round((personalTotal + ceremonyTotal + receptionTotal) * 0.10);
      const total = personalTotal + ceremonyTotal + receptionTotal + deliverySetup;
      const totalItems = bridal + bmaids + bouts + corsages + centers + archCount + pews + petals;
      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('blb-total')!.textContent = fmt(total);
      document.getElementById('blb-tier-label')!.textContent = tierLabel + ' (inkl. 10% Lieferung/Aufbau)';
      document.getElementById('blb-personal')!.textContent = fmt(personalTotal);
      document.getElementById('blb-ceremony')!.textContent = fmt(ceremonyTotal);
      document.getElementById('blb-reception')!.textContent = fmt(receptionTotal);
      document.getElementById('blb-items')!.textContent = totalItems.toString();
      let details = '<h3 class="font-semibold text-sm text-text mb-2">Aufstellung</h3><ul class="text-sm text-text-secondary space-y-1">';
      if (bridal > 0) details += '<li>Brautstrau\u00df: ' + bridal + ' x ' + fmt(prices.bridal) + ' = ' + fmt(pBridal) + '</li>';
      if (bmaids > 0) details += '<li>Brautjungfern: ' + bmaids + ' x ' + fmt(prices.bmaid) + ' = ' + fmt(pBmaids) + '</li>';
      if (bouts > 0) details += '<li>Ansteckblumen: ' + bouts + ' x ' + fmt(prices.bout) + ' = ' + fmt(pBouts) + '</li>';
      if (corsages > 0) details += '<li>Corsagen: ' + corsages + ' x ' + fmt(prices.corsage) + ' = ' + fmt(pCorsages) + '</li>';
      if (centers > 0) details += '<li>Tischgestecke: ' + centers + ' x ' + fmt(prices.center) + ' = ' + fmt(pCenters) + '</li>';
      if (archCount > 0) details += '<li>Bogen/Altar: ' + archCount + ' x ' + fmt(prices.arch) + ' = ' + fmt(pArch) + '</li>';
      if (pews > 0) details += '<li>Stuhlschmuck: ' + pews + ' x ' + fmt(prices.pew) + ' = ' + fmt(pPews) + '</li>';
      if (petals > 0) details += '<li>Blumenbl\u00e4tter: ' + petals + ' x ' + fmt(prices.petals) + ' = ' + fmt(pPetals) + '</li>';
      details += '<li>Lieferung & Aufbau (10%): ' + fmt(deliverySetup) + '</li></ul>';
      document.getElementById('blb-details')!.innerHTML = details;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.blb-in').forEach(el => { el.addEventListener('input', calcBLB); el.addEventListener('change', calcBLB); });
      calcBLB();
    }, 50);
  </script>
</CalculatorLayout>
