---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Dendrochronologie-Rechner - Baumringdatierung & Wachstumsrate";
const description = "Berechnen Sie das Baumalter aus Ringzaehlungen, analysieren Sie Wachstumsraten, schaetzen Sie fehlende Ringe und bestimmen Sie Kalenderdaten aus dendrochronologischen Daten.";

const relatedCalcs = [
  { name: "Radiokarbondatierung", url: "/de/radiokarbondatierung-rechner", description: "C-14 Altersberechnung." },
  { name: "Stratigraphie-Rechner", url: "/de/stratigraphie-rechner", description: "Schichtalter." },
  { name: "Fossil-Altersrechner", url: "/de/fossil-alter-rechner", description: "Multi-Methoden-Datierung." },
  { name: "Isotopen-Rechner", url: "/de/isotopen-rechner", description: "Isotopenanalyse." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="dendrochronology-calculator" calculatorName="Dendrochronologie-Rechner" keywords="dendrochronologie, baumringdatierung, wachstumsrate, ringbreite, baumalter, kreuzdatierung, masterchronologie" breadcrumbs={[{ name: "Dendrochronologie-Rechner", url: "/de/dendrochronologie-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dendrochronologie-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie Baumringdaten zur Bestimmung von Alter, Wachstumsraten und Kalenderdaten. N&uuml;tzlich f&uuml;r die Datierung von Holzkonstruktionen, Artefakten und Klimarekonstruktion.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl gez&auml;hlter Ringe</label>
          <input type="number" id="dc-rings" class="dc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="1" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">&Auml;u&szlig;erstes Ringjahr (n.Chr./v.Chr.)</label>
          <input type="number" id="dc-outyear" class="dc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1850" step="1">
          <p class="text-xs text-text-muted mt-1">Negativ f&uuml;r v.Chr. (z.B. -500 f&uuml;r 500 v.Chr.)</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Stammradius auf Brusth&ouml;he (cm)</label>
          <input type="number" id="dc-radius" class="dc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0.1" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gesch&auml;tzte fehlende Ringe (Mark/Rinde)</label>
          <input type="number" id="dc-missing" class="dc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Rindenkante vorhanden?</label>
          <select id="dc-bark" class="dc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="yes">Ja &mdash; F&auml;lldatum ist exakt</option>
            <option value="no">Nein &mdash; Datum ist terminus post quem</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tztes Baumalter</div>
          <div class="text-4xl font-extrabold" id="dc-age">0</div>
          <div class="text-sm text-blue-200 mt-1" id="dc-dating">Jahre</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Innerstes Ringjahr</div>
            <div class="text-xl font-bold" id="dc-inyr">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Durchschn. Ringbreite</div>
            <div class="text-xl font-bold" id="dc-avgwidth">0</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wachstumsrate</div>
            <div class="text-xl font-bold" id="dc-growth">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Durchmesser auf BH</div>
            <div class="text-xl font-bold" id="dc-diameter">0</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Datierungsinterpretation</div>
          <div class="text-sm font-bold" id="dc-interp">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="dendrochronology" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Dendrochronologie-Formeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Gesamtalter</strong> = Ringanzahl + fehlende Ringe</p>
        <p><strong>Innerstes Jahr</strong> = &Auml;u&szlig;erstes Jahr &minus; Ringanzahl &minus; fehlende Ringe + 1</p>
        <p><strong>Durchschn. Ringbreite</strong> = Radius / Ringanzahl</p>
      </div>
      <p>Die Dendrochronologie liefert eine der pr&auml;zisesten verf&uuml;gbaren Datierungsmethoden. Jeder Ring repr&auml;sentiert ein Wachstumsjahr, und Ringbreitenmuster k&ouml;nnen mit Masterchronologien &uuml;ber Tausende von Jahren abgeglichen werden.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet terminus post quem?</strong> Ohne Rindenkante ist das Datum ein Fr&uuml;hestdatum &mdash; der Baum wurde fr&uuml;hestens zu diesem Zeitpunkt gef&auml;llt, m&ouml;glicherweise aber sp&auml;ter.</p>
      <p><strong>Wie genau ist die Methode?</strong> Bei Vorhandensein der Rindenkante ist die Datierung auf das Jahr genau. In Mitteleuropa reichen Masterchronologien &uuml;ber 12.000 Jahre zur&uuml;ck.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcDC() {
      const rings = parseFloat((document.getElementById('dc-rings') as HTMLInputElement).value) || 0;
      const outYear = parseFloat((document.getElementById('dc-outyear') as HTMLInputElement).value) || 0;
      const radius = parseFloat((document.getElementById('dc-radius') as HTMLInputElement).value) || 0;
      const missing = parseFloat((document.getElementById('dc-missing') as HTMLInputElement).value) || 0;
      const hasBark = (document.getElementById('dc-bark') as HTMLSelectElement).value;

      const totalAge = rings + missing;
      const innerYear = outYear - rings - missing + 1;
      const avgWidth = rings > 0 ? radius / rings : 0;
      const growthRate = rings > 0 ? (radius * 2) / rings : 0;
      const diameter = radius * 2;

      const formatYear = (yr: number) => {
        if (yr <= 0) return Math.abs(yr - 1) + ' v.Chr.';
        return yr + ' n.Chr.';
      };

      let interp = '';
      if (hasBark === 'yes') {
        interp = 'F\u00e4lldatum: ' + formatYear(outYear) + ' (exakt, Rindenkante vorhanden)';
      } else {
        interp = 'Terminus post quem: nach ' + formatYear(outYear) + ' (\u00e4u\u00dfere Ringe k\u00f6nnen fehlen)';
      }

      document.getElementById('dc-age')!.textContent = totalAge.toString();
      document.getElementById('dc-dating')!.textContent = 'Jahre (' + formatYear(innerYear) + ' bis ' + formatYear(outYear) + ')';
      document.getElementById('dc-inyr')!.textContent = formatYear(innerYear);
      document.getElementById('dc-avgwidth')!.textContent = avgWidth.toFixed(2).replace('.', ',') + ' mm';
      document.getElementById('dc-growth')!.textContent = growthRate.toFixed(2).replace('.', ',') + ' mm/J';
      document.getElementById('dc-diameter')!.textContent = diameter.toFixed(1).replace('.', ',') + ' cm';
      document.getElementById('dc-interp')!.textContent = interp;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dc-in').forEach(el => { el.addEventListener('input', calcDC); el.addEventListener('change', calcDC); });
      calcDC();
    }, 50);
  </script>
</CalculatorLayout>
