---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Frachtversicherung-Rechner – Prämie & Deckung berechnen";
const description = "Berechnen Sie die Frachtversicherungsprämie basierend auf Warenwert, Frachtart, Route und Selbstbeteiligung.";
const relatedCalcs = [
  { name: "Kubikmeter-Rechner", url: "/de/kubikmeter-rechner", description: "Volumenberechnung." },
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
  { name: "Eigenkapitalrendite-Rechner", url: "/de/eigenkapitalrendite-rechner", description: "Rendite." },
  { name: "Cashback-Rechner", url: "/de/cashback-rechner", description: "Cashback." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Frachtversicherung-Rechner" enSlug="cargo-insurance-calculator" keywords="Frachtversicherung, Transportversicherung, Versicherungsprämie, Warenwert, Selbstbeteiligung" breadcrumbs={[{ name: "Frachtversicherung-Rechner", url: "/de/frachtversicherung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Frachtversicherung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Frachtversicherungsprämien basierend auf Wert, Typ, Routenrisiko und Selbstbeteiligung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Warenwert (€)</label><input type="number" id="fvr-value" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="100"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Frachtart</label><select id="fvr-type" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="0.3">Allgemeine Waren</option><option value="0.4">Maschinen/Ausrüstung</option><option value="0.5" selected>Elektronik</option><option value="0.6">Zerbrechlich/Verderblich</option><option value="0.8">Gefahrgut</option></select></div>
        <div><label class="block text-xs font-medium text-text mb-1">Routenrisiko</label><select id="fvr-route" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="0.8">Inland - Niedriges Risiko</option><option value="1.0" selected>Inland - Standard</option><option value="1.3">International - Standard</option><option value="1.6">International - Hohes Risiko</option></select></div>
        <div><label class="block text-xs font-medium text-text mb-1">Deckungsniveau (%)</label><select id="fvr-coverage" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="100">100% - Volldeckung</option><option value="110" selected>110% - Voll + 10% (CIF+10%)</option><option value="80">80% - Teildeckung</option></select></div>
        <div><label class="block text-xs font-medium text-text mb-1">Selbstbeteiligung (€)</label><input type="number" id="fvr-deduct" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Prämie</div>
          <div class="text-5xl font-extrabold font-mono" id="fvr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Deckungssumme</div><div class="text-xl font-bold font-mono" id="fvr-coveramt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Prämiensatz</div><div class="text-xl font-bold font-mono" id="fvr-rate">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Auszahlung</div><div class="text-xl font-bold font-mono" id="fvr-maxpay">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Prämie % vom Wert</div><div class="text-xl font-bold font-mono" id="fvr-pctval">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cargo-insurance" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Frachtversicherung verstehen</h2>
      <p>Die Frachtversicherung schützt gegen Verlust oder Beschädigung von Waren während des Transports. Die Prämie hängt von Warenwert, Art, Transportweg und gewählter Selbstbeteiligung ab.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was bedeutet CIF+10%?</strong> CIF (Cost, Insurance, Freight) plus 10% ist eine gängige Deckungsform im internationalen Handel, die den Warenwert plus Versicherung und Fracht plus einen 10%-Aufschlag abdeckt.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFVR() {
      const value = parseFloat((document.getElementById('fvr-value') as HTMLInputElement).value) || 0;
      const typeRate = parseFloat((document.getElementById('fvr-type') as HTMLSelectElement).value) || 0.5;
      const routeMulti = parseFloat((document.getElementById('fvr-route') as HTMLSelectElement).value) || 1.0;
      const coveragePct = parseFloat((document.getElementById('fvr-coverage') as HTMLSelectElement).value) || 110;
      const deductible = parseFloat((document.getElementById('fvr-deduct') as HTMLInputElement).value) || 0;
      const coverageAmount = value * (coveragePct / 100);
      const baseRate = typeRate * routeMulti;
      const deductDiscount = deductible > 0 ? Math.min(0.15, deductible / value * 0.5) : 0;
      const effectiveRate = Math.max(0.1, baseRate - (deductDiscount * 100));
      const premium = (coverageAmount / 100) * effectiveRate;
      const maxPayout = coverageAmount - deductible;
      const premPctValue = value > 0 ? (premium / value) * 100 : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('fvr-result')!.textContent = fmt(premium);
      document.getElementById('fvr-coveramt')!.textContent = fmt(coverageAmount);
      document.getElementById('fvr-rate')!.textContent = effectiveRate.toFixed(2) + '%';
      document.getElementById('fvr-maxpay')!.textContent = fmt(maxPayout);
      document.getElementById('fvr-pctval')!.textContent = premPctValue.toFixed(2) + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('fvr-value') as HTMLInputElement).value = '50000';
      (document.getElementById('fvr-deduct') as HTMLInputElement).value = '500';
      document.querySelectorAll('.fvr-in').forEach(el => { el.addEventListener('input', calcFVR); el.addEventListener('change', calcFVR); });
      calcFVR();
    }, 50);
  </script>
</CalculatorLayout>
