---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Mode-Aufschlag-Rechner - Vom Einkauf zum Verkaufspreis";
const description = "Berechnen Sie den Mode-Aufschlag vom Einkaufs- zum Verkaufspreis, Keystone-Pricing, Margenanalyse und UVP für Bekleidung und Accessoires.";
const relatedCalcs = [
  { name: "Finanzielle Unabhängigkeit", url: "/de/finanzielle-unabhaengigkeit-rechner", description: "FIRE-Rechner." },
  { name: "Stoff-Rechner", url: "/de/stoff-rechner", description: "Stoffbedarf." },
  { name: "Stoffbreite-Rechner", url: "/de/stoffbreite-rechner", description: "Stoffbreiten-Vergleich." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Mode-Aufschlag-Rechner" lang="de" enSlug="fashion-markup-calculator" keywords="mode aufschlag rechner, einkaufspreis verkaufspreis, keystone pricing, uvp, bekleidung marge, mode preisgestaltung" breadcrumbs={[{ name: "Mode-Aufschlag", url: "/de/mode-aufschlag-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mode-Aufschlag-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Aufschlag vom Einkaufs- zum Verkaufspreis, Keystone-Pricing, Margen und UVP für Modeprodukte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Produktkategorie</label>
          <select id="made-cat" class="made-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="basic">Basis-Bekleidung (2x-2,5x)</option>
            <option value="contemporary" selected>Contemporary (2,5x-3x)</option>
            <option value="designer">Designer / Luxus (3x-5x)</option>
            <option value="accessories">Accessoires (3x-4x)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Herstellungskosten (&euro;)</label><input type="number" id="made-cost" class="made-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">EK-Aufschlagfaktor</label><input type="number" id="made-wmult" class="made-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="10" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">VK-Aufschlagfaktor</label><input type="number" id="made-rmult" class="made-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="1" max="10" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rabatt % (falls zutreffend)</label><input type="number" id="made-map" class="made-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="50" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Monatlich verkaufte St&uuml;ck</label><input type="number" id="made-units" class="made-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Verkaufspreis (UVP)</div>
          <div class="text-4xl font-extrabold font-mono" id="made-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Großhandelspreis</div><div class="text-xl font-bold font-mono" id="made-wholesale">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bruttomarge</div><div class="text-xl font-bold font-mono" id="made-margin">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rabattpreis</div><div class="text-xl font-bold font-mono" id="made-mapprice">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinn / St&uuml;ck</div><div class="text-xl font-bold font-mono" id="made-profit">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatsumsatz</div><div class="text-xl font-bold font-mono" id="made-revenue">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatsgewinn</div><div class="text-xl font-bold font-mono" id="made-monthprofit">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fashion-markup-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mode-Preiskalkulation</h2>
      <p>In der Modeindustrie ist der Aufschlag typischerweise 2x-5x der Herstellungskosten. Der Keystone-Aufschlag (2x) ist das Minimum f&uuml;r profitables Einzelhandelsgesch&auml;ft.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein typischer Mode-Aufschlag?</strong> Basic-Bekleidung hat meist 2-2,5x, Contemporary 2,5-3x und Designer/Luxus 3-5x Aufschlag.</p>
      <p><strong>Was ist Keystone-Pricing?</strong> Keystone bedeutet einen 2x-Aufschlag (100% Marge). Bei einem Einkaufspreis von 25 &euro; ergibt sich ein VK von 50 &euro;.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcMADE() {
      const cat = (document.getElementById('made-cat') as HTMLSelectElement).value;
      const cost = parseFloat((document.getElementById('made-cost') as HTMLInputElement).value) || 25;
      let wmult = parseFloat((document.getElementById('made-wmult') as HTMLInputElement).value) || 2;
      let rmult = parseFloat((document.getElementById('made-rmult') as HTMLInputElement).value) || 2.5;
      const mapDisc = parseFloat((document.getElementById('made-map') as HTMLInputElement).value) || 0;
      const units = parseInt((document.getElementById('made-units') as HTMLInputElement).value) || 100;
      const catMult: Record<string, number[]> = {
        basic: [2, 2.2], contemporary: [2, 2.8],
        designer: [2.2, 4], accessories: [2.5, 3.5]
      };
      if (cat !== 'custom') {
        const m = catMult[cat] || [2, 2.5];
        wmult = m[0]; rmult = m[1];
        (document.getElementById('made-wmult') as HTMLInputElement).value = wmult.toString();
        (document.getElementById('made-rmult') as HTMLInputElement).value = rmult.toString();
      }
      const wholesale = cost * wmult;
      const retail = cost * rmult;
      const grossMargin = ((retail - cost) / retail * 100);
      const mapPrice = mapDisc > 0 ? retail * (1 - mapDisc / 100) : retail;
      const profitPerUnit = retail - cost;
      const monthlyRev = retail * units;
      const monthlyProfit = profitPerUnit * units;
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('made-result')!.textContent = fmtEur(retail);
      document.getElementById('made-wholesale')!.textContent = fmtEur(wholesale);
      document.getElementById('made-margin')!.textContent = grossMargin.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      document.getElementById('made-mapprice')!.textContent = fmtEur(mapPrice);
      document.getElementById('made-profit')!.textContent = fmtEur(profitPerUnit);
      document.getElementById('made-revenue')!.textContent = Math.round(monthlyRev).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('made-monthprofit')!.textContent = Math.round(monthlyProfit).toLocaleString('de-DE') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.made-in').forEach(el => { el.addEventListener('input', calcMADE); el.addEventListener('change', calcMADE); });
      calcMADE();
    }, 50);
  </script>
</CalculatorLayout>
