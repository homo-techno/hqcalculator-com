---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Meeresversauerung Rechner – pH-Veränderungen der Ozeane berechnen";
const description = "Berechnen Sie pH-Veränderungen und CO₂-Absorption der Ozeane.";
const relatedCalcs = [
  { name: "Osmotischer Druck Rechner", url: "/de/osmotischer-druck-rechner", description: "Osmotischen Druck." },
  { name: "Obsidian-Hydration Rechner", url: "/de/obsidian-hydration-rechner", description: "Archäologische Datierung." },
  { name: "Lärmminderung Rechner", url: "/de/laermminderung-rechner", description: "Schallschutz." },
  { name: "Erzgehalt Rechner", url: "/de/erzgehalt-rechner", description: "Bergbau-Kennzahlen." },
];
---
<CalculatorLayout lang="de" enSlug="ocean-acidification-calculator" title={title} description={description} calculatorName="Meeresversauerung Rechner" keywords="Meeresversauerung, pH, CO2, Ozean, Klimawandel, Kohlensäure, Karbonat" breadcrumbs={[{ name: "Meeresversauerung Rechner", url: "/de/meeresversauerung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Meeresversauerung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie pH-Veränderungen in Ozeanen durch CO₂-Absorption und verstehen Sie die Auswirkungen auf das marine Ökosystem.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">CO₂-Konzentration Luft (ppm)</label>
            <input type="number" id="mv-co2" class="mv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="10" min="200" max="2000">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Wassertemperatur (°C)</label>
            <input type="number" id="mv-temp" class="mv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="-2" max="35">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Referenz-CO₂ (ppm)</label>
            <input type="number" id="mv-co2ref" class="mv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="10" min="200">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Referenz-pH</label>
            <input type="number" id="mv-phref" class="mv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.01" min="7" max="9">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Berechneter pH-Wert</div>
          <div class="text-5xl font-extrabold font-mono" id="mv-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="mv-subtitle"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">pH-Änderung</div>
            <div class="text-xl font-bold" id="mv-delta">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">H⁺-Zunahme</div>
            <div class="text-xl font-bold" id="mv-hplus">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">CO₂(aq) (µmol/L)</div>
            <div class="text-xl font-bold" id="mv-co2aq">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Risikostufe</div>
            <div class="text-xl font-bold" id="mv-risk">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsweg</h3>
          <div class="font-mono text-sm space-y-1" id="mv-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="ocean-acidification" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Meeresversauerung – Ursachen und Folgen</h2>
      <p>Seit der Industrialisierung hat der pH-Wert der Ozeane von etwa 8,21 auf 8,10 abgenommen – eine Änderung um 0,11 Einheiten entspricht einer Zunahme der H⁺-Ionenkonzentration um ca. 30%. CO₂ löst sich im Meerwasser und bildet Kohlensäure (H₂CO₃), die in Bikarbonat und Karbonat-Ionen dissoziiert. Die sinkende Konzentration an Karbonat-Ionen bedroht Korallen, Muscheln und andere kalkschalenbildende Organismen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>CO₂(g) + H₂O → H₂CO₃ → HCO₃⁻ + H⁺ → CO₃²⁻ + 2H⁺</p>
        <p>pH ≈ pH_ref - log₁₀(CO₂_neu / CO₂_ref)</p>
        <p>Löslichkeit steigt bei niedrigerer Temperatur</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel CO₂ absorbieren die Ozeane?</strong> Die Weltmeere absorbieren ca. 25–30% des vom Menschen emittierten CO₂ pro Jahr – etwa 2–3 Milliarden Tonnen CO₂ jährlich.</p>
      <p><strong>Ab welchem pH-Wert sind Korallen gefährdet?</strong> Unterhalb von pH 7,8 wird das Meerwasser für viele Kalzifizierungsorganismen aggressiv. Korallenskelette beginnen sich aufzulösen, wenn der Aragonitsättigungszustand unter 1 sinkt.</p>
      <p><strong>Wie unterscheidet sich die Versauerung in verschiedenen Meeresregionen?</strong> Polarmeere versauern schneller, da kaltes Wasser mehr CO₂ aufnimmt. Die Arktis wird voraussichtlich als erste Region aragonituntersättigt.</p>
      <p><strong>Kann Meeresversauerung rückgängig gemacht werden?</strong> Theoretisch ja, durch drastische CO₂-Reduktionen oder geo-engineering-Maßnahmen wie Alkalinisierung. Dies würde jedoch Jahrhunderte dauern, da die natürliche Pufferkapazität der Ozeane Zeit braucht.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMV() {
      const co2 = parseFloat((document.getElementById('mv-co2') as HTMLInputElement).value) || 420;
      const temp = parseFloat((document.getElementById('mv-temp') as HTMLInputElement).value) || 15;
      const co2ref = parseFloat((document.getElementById('mv-co2ref') as HTMLInputElement).value) || 280;
      const phref = parseFloat((document.getElementById('mv-phref') as HTMLInputElement).value) || 8.21;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      const ph = phref - Math.log10(co2 / co2ref);
      const delta = ph - phref;
      const hplusFactor = Math.pow(10, -delta);
      const kh = 3.4e-2 * Math.exp(-2400 * (1/(temp+273.15) - 1/298.15));
      const co2aq = kh * (co2 / 1e6) * 1e6;
      let risk = '—';
      if (ph >= 8.1) risk = 'Gering';
      else if (ph >= 7.9) risk = 'Moderat';
      else if (ph >= 7.7) risk = 'Hoch';
      else risk = 'Kritisch';
      const steps: string[] = [];
      steps.push('pH = ' + fmt(phref, 3) + ' - log₁₀(' + co2 + '/' + co2ref + ')');
      steps.push('= ' + fmt(phref, 3) + ' - ' + fmt(Math.log10(co2/co2ref), 4) + ' = ' + fmt(ph, 3));
      steps.push('pH-Änderung: ' + fmt(delta, 3) + ' (Δ gegenüber Referenz)');
      steps.push('H⁺-Zunahme: ' + fmt(hplusFactor, 2) + 'x');
      steps.push('CO₂(aq) ≈ ' + fmt(co2aq, 2) + ' µmol/L bei ' + temp + '°C');
      document.getElementById('mv-result')!.textContent = fmt(ph, 3);
      document.getElementById('mv-subtitle')!.textContent = 'Δ pH = ' + fmt(delta, 3) + ' gegenüber ' + fmt(phref, 2);
      document.getElementById('mv-delta')!.textContent = fmt(delta, 3) + ' pH';
      document.getElementById('mv-hplus')!.textContent = fmt(hplusFactor, 2) + 'x';
      document.getElementById('mv-co2aq')!.textContent = fmt(co2aq, 2) + ' µmol/L';
      document.getElementById('mv-risk')!.textContent = risk;
      document.getElementById('mv-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('mv-co2') as HTMLInputElement).value = '420';
      (document.getElementById('mv-temp') as HTMLInputElement).value = '15';
      (document.getElementById('mv-co2ref') as HTMLInputElement).value = '280';
      (document.getElementById('mv-phref') as HTMLInputElement).value = '8.21';
      document.querySelectorAll('.mv-in').forEach(el => { el.addEventListener('input', calcMV); el.addEventListener('change', calcMV); });
      calcMV();
    }, 50);
  </script>
</CalculatorLayout>
