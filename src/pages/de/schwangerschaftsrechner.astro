---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schwangerschaftsrechner - Geburtstermin & Woche berechnen 2026";
const description = "Kostenloser Schwangerschaftsrechner. Berechne deinen voraussichtlichen Geburtstermin, die aktuelle Schwangerschaftswoche und wichtige Meilensteine.";

const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Genaues Alter berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Taeglicher Kalorienbedarf." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Gewichtsziele planen." },
  { name: "Grundumsatzrechner", url: "/de/grundumsatzrechner", description: "Grundumsatz berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Schwangerschaftsrechner" keywords="Schwangerschaftsrechner, Geburtsterminrechner, SSW Rechner, Schwangerschaftswoche, voraussichtlicher Geburtstermin" breadcrumbs={[{ name: "Schwangerschaftsrechner", url: "/de/schwangerschaftsrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schwangerschaftsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne deinen voraussichtlichen Geburtstermin und verfolge deine Schwangerschaft Woche fuer Woche.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-6">
            <label class="block text-sm font-medium text-text mb-2">Berechnungsmethode</label>
            <div class="flex gap-2">
              <button class="preg-method-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer" data-method="lmp">Letzte Periode</button>
              <button class="preg-method-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-method="conception">Empfaengnisdatum</button>
              <button class="preg-method-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-method="due">Bekannter Termin</button>
            </div>
          </div>

          <div class="mb-6">
            <label class="block text-sm font-medium text-text mb-1" id="preg-date-label">Erster Tag der letzten Periode</label>
            <input type="date" id="preg-date" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
          </div>

          <div class="mb-6" id="preg-cycle-wrap">
            <label class="block text-sm font-medium text-text mb-1">Durchschnittliche Zykluslaenge</label>
            <div class="flex items-center gap-3">
              <input type="range" id="preg-cycle-slider" min="20" max="45" value="28" class="flex-1">
              <span class="text-lg font-bold w-16 text-center" id="preg-cycle-val">28 Tage</span>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Voraussichtlicher Geburtstermin</div>
            <div class="text-3xl sm:text-4xl font-extrabold" id="preg-due-date">&mdash;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktuelle SSW</div><div class="text-xl font-bold text-primary" id="preg-week">&mdash;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Trimester</div><div class="text-xl font-bold" id="preg-trimester">&mdash;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbleibende Tage</div><div class="text-xl font-bold" id="preg-days-left">&mdash;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfaengnis</div><div class="text-xl font-bold" id="preg-conception">&mdash;</div></div>
          </div>

          <div class="bg-surface-alt rounded-xl p-4">
            <div class="flex justify-between text-xs text-text-muted mb-2"><span>SSW 0</span><span>SSW 13</span><span>SSW 27</span><span>SSW 40</span></div>
            <div class="w-full bg-white rounded-full h-4 overflow-hidden relative">
              <div class="absolute inset-0 flex">
                <div class="h-full bg-pink-200" style="width: 32.5%"></div>
                <div class="h-full bg-purple-200" style="width: 35%"></div>
                <div class="h-full bg-blue-200" style="width: 32.5%"></div>
              </div>
              <div class="absolute inset-0"><div class="h-full bg-primary rounded-full transition-all duration-500" id="preg-bar" style="width: 0%"></div></div>
            </div>
            <div class="flex justify-between text-xs mt-1"><span class="text-pink-500 font-medium">1. Trimester</span><span class="text-purple-500 font-medium">2. Trimester</span><span class="text-blue-500 font-medium">3. Trimester</span></div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="pregnancy" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">Wichtige Termine</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-3 font-semibold">Meilenstein</th><th class="py-2 pr-3 font-semibold">SSW</th><th class="py-2 font-semibold">Voraussichtliches Datum</th></tr></thead>
          <tbody id="preg-milestones" class="text-text-secondary"></tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">Trimester-Uebersicht</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 bg-pink-50 rounded-xl border border-pink-100">
          <h3 class="font-bold text-pink-700 mb-2">1. Trimester (SSW 1-13)</h3>
          <ul class="text-sm text-text-secondary space-y-1">
            <li>SSW 4: Einnistung, Schwangerschaftstest positiv</li>
            <li>SSW 6: Herz beginnt zu schlagen</li>
            <li>SSW 8: Alle wichtigen Organe bilden sich</li>
            <li>SSW 10: Finger und Zehen entwickeln sich</li>
            <li>SSW 12: Erster Ultraschall, Fehlgeburtsrisiko sinkt</li>
          </ul>
        </div>
        <div class="p-5 bg-purple-50 rounded-xl border border-purple-100">
          <h3 class="font-bold text-purple-700 mb-2">2. Trimester (SSW 14-27)</h3>
          <ul class="text-sm text-text-secondary space-y-1">
            <li>SSW 16: Geschlecht moeglicherweise erkennbar</li>
            <li>SSW 18-20: Erste Kindsbewegungen spuerbar</li>
            <li>SSW 20: Grosser Ultraschall (Organscreening)</li>
            <li>SSW 24: Lebensfaehigkeit erreicht</li>
            <li>SSW 27: Augen oeffnen sich, Schlafzyklen beginnen</li>
          </ul>
        </div>
        <div class="p-5 bg-blue-50 rounded-xl border border-blue-100">
          <h3 class="font-bold text-blue-700 mb-2">3. Trimester (SSW 28-40)</h3>
          <ul class="text-sm text-text-secondary space-y-1">
            <li>SSW 28: Lungen entwickeln sich, schnelles Wachstum</li>
            <li>SSW 32: Knochen haerten aus, Atemuebungen</li>
            <li>SSW 36: Baby dreht sich moeglicherweise kopfueber</li>
            <li>SSW 37: Fruehe Termingeburt</li>
            <li>SSW 39-40: Vollstaendig ausgetragen, bereit fuer die Geburt</li>
          </ul>
        </div>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie der Geburtstermin berechnet wird</h2>
      <p>Der voraussichtliche Geburtstermin (ET) wird mit der Naegele-Regel berechnet: Addiere 280 Tage (40 Wochen) zum ersten Tag der letzten Periode. Dies geht von einem 28-Tage-Zyklus aus. Bei laengeren oder kuerzeren Zyklen wird die Berechnung entsprechend angepasst.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Geburtstermin = Letzte Periode + 280 Tage + (Zykluslaenge &minus; 28) Tage</div>

      <h3 class="text-xl font-semibold text-text mt-8">Wie genau ist der Geburtstermin?</h3>
      <p>Nur etwa 5 % der Babys werden am errechneten Termin geboren. Die meisten Babys kommen zwischen der 38. und 42. Schwangerschaftswoche zur Welt. Ein Ultraschall im ersten Trimester kann den Termin genauer bestimmen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let currentMethod = 'lmp';

    function formatDate(d: Date): string {
      return d.toLocaleDateString('de-DE', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
    }
    function shortDate(d: Date): string {
      return d.toLocaleDateString('de-DE', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function calcPregnancy() {
      const dateStr = (document.getElementById('preg-date') as HTMLInputElement).value;
      if (!dateStr) return;

      const inputDate = new Date(dateStr + 'T00:00:00');
      const cycleLength = parseInt((document.getElementById('preg-cycle-slider') as HTMLInputElement).value) || 28;
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      let lmpDate: Date, dueDate: Date, conceptionDate: Date;

      switch (currentMethod) {
        case 'lmp':
          lmpDate = new Date(inputDate);
          conceptionDate = new Date(lmpDate);
          conceptionDate.setDate(conceptionDate.getDate() + (cycleLength - 14));
          dueDate = new Date(lmpDate);
          dueDate.setDate(dueDate.getDate() + 280 + (cycleLength - 28));
          break;
        case 'conception':
          conceptionDate = new Date(inputDate);
          lmpDate = new Date(conceptionDate);
          lmpDate.setDate(lmpDate.getDate() - 14);
          dueDate = new Date(conceptionDate);
          dueDate.setDate(dueDate.getDate() + 266);
          break;
        case 'due':
          dueDate = new Date(inputDate);
          lmpDate = new Date(dueDate);
          lmpDate.setDate(lmpDate.getDate() - 280);
          conceptionDate = new Date(lmpDate);
          conceptionDate.setDate(conceptionDate.getDate() + 14);
          break;
        default: return;
      }

      const diffMs = today.getTime() - lmpDate.getTime();
      const totalDays = Math.floor(diffMs / 86400000);
      const weeks = Math.floor(totalDays / 7);
      const days = totalDays % 7;
      const daysLeft = Math.max(0, Math.ceil((dueDate.getTime() - today.getTime()) / 86400000));

      let trimester: string;
      if (weeks < 13) trimester = '1. Trimester';
      else if (weeks < 27) trimester = '2. Trimester';
      else trimester = '3. Trimester';

      document.getElementById('preg-due-date')!.textContent = formatDate(dueDate);
      document.getElementById('preg-week')!.textContent = totalDays >= 0 ? `SSW ${weeks}+${days}` : '\u2014';
      document.getElementById('preg-trimester')!.textContent = totalDays >= 0 ? trimester : '\u2014';
      document.getElementById('preg-days-left')!.textContent = totalDays >= 0 ? String(daysLeft) : '\u2014';
      document.getElementById('preg-conception')!.textContent = shortDate(conceptionDate);

      const progress = Math.min(100, Math.max(0, (totalDays / 280) * 100));
      document.getElementById('preg-bar')!.style.width = progress + '%';

      const milestones = [
        { name: 'Empfaengnis (geschaetzt)', week: 2, offset: 14 },
        { name: 'Erster Herzschlag erkennbar', week: 6, offset: 42 },
        { name: 'Ende der Embryonalperiode', week: 10, offset: 70 },
        { name: 'Ersttrimester-Screening', week: 12, offset: 84 },
        { name: '2. Trimester beginnt', week: 14, offset: 98 },
        { name: 'Geschlecht moeglicherweise erkennbar', week: 16, offset: 112 },
        { name: 'Grosser Ultraschall', week: 20, offset: 140 },
        { name: 'Lebensfaehigkeit', week: 24, offset: 168 },
        { name: '3. Trimester beginnt', week: 28, offset: 196 },
        { name: 'Baby in Kopflage', week: 36, offset: 252 },
        { name: 'Vollstaendig ausgetragen', week: 39, offset: 273 },
        { name: 'Errechneter Geburtstermin', week: 40, offset: 280 },
      ];

      const tbody = document.getElementById('preg-milestones')!;
      tbody.innerHTML = milestones.map(m => {
        const mDate = new Date(lmpDate);
        mDate.setDate(mDate.getDate() + m.offset);
        const isPast = today >= mDate;
        const isCurrent = Math.abs(weeks - m.week) <= 1;
        return `<tr class="border-b border-border/30 ${isCurrent ? 'bg-primary/5 font-medium' : ''} ${isPast ? 'text-text-muted' : ''}"><td class="py-2 pr-3">${isPast ? '\u2713 ' : ''}${m.name}</td><td class="py-2 pr-3">SSW ${m.week}</td><td class="py-2">${shortDate(mDate)}</td></tr>`;
      }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const defaultDate = new Date();
      defaultDate.setDate(defaultDate.getDate() - 70);
      const dateInput = document.getElementById('preg-date') as HTMLInputElement;
      dateInput.value = defaultDate.toISOString().split('T')[0];

      document.querySelectorAll('.preg-method-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.preg-method-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          currentMethod = (btn as HTMLElement).dataset.method || 'lmp';
          const labels: Record<string, string> = { lmp: 'Erster Tag der letzten Periode', conception: 'Empfaengnisdatum', due: 'Bekannter Geburtstermin' };
          document.getElementById('preg-date-label')!.textContent = labels[currentMethod];
          document.getElementById('preg-cycle-wrap')!.style.display = currentMethod === 'lmp' ? '' : 'none';
          calcPregnancy();
        });
      });

      const cycleSlider = document.getElementById('preg-cycle-slider')!;
      cycleSlider.addEventListener('input', () => { document.getElementById('preg-cycle-val')!.textContent = (cycleSlider as HTMLInputElement).value + ' Tage'; calcPregnancy(); });

      dateInput.addEventListener('change', calcPregnancy);
      calcPregnancy();
    }, 50);
  </script>
</CalculatorLayout>
