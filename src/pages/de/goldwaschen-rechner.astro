---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Goldwaschen-Rechner - Ausbeute & Wert pro Kubikmeter";
const description = "Berechnen Sie die Goldausbeute, den Wert pro Kubikmeter und die Rentabilitätsschwelle beim Goldwaschen.";
const relatedCalcs = [
  { name: "Ziegenfutter-Rechner", url: "/de/ziegenfutter-rechner", description: "Ziegenfutter." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Genauigkeit." },
  { name: "Grünes-Bauen-Rechner", url: "/de/gruenes-bauen-rechner", description: "Nachhaltiges Bauen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Goldwaschen-Rechner" enSlug="gold-panning-calculator" keywords="Goldwaschen, Goldausbeute, Wert pro Kubikmeter, Gold schürfen, Goldsuche, Seifengold" breadcrumbs={[{ name: "Goldwaschen-Rechner", url: "/de/goldwaschen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Goldwaschen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Goldausbeute, den Wert pro Kubikmeter und ob eine Seifengoldlagerstätte sich lohnt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">Goldpreis (€/Feinunze)</label><input type="number" id="gwr-price" class="gwr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="1800" min="0" step="10"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Gold pro m³ (mg)</label><input type="number" id="gwr-mgm3" class="gwr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="150" min="0" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">m³ verarbeitet pro Tag</label><input type="number" id="gwr-m3" class="gwr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="2" min="0" step="0.5"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Ausbeuterate (%)</label><input type="number" id="gwr-recovery" class="gwr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="60" min="0" max="100" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Ausrüstungsmethode</label>
            <select id="gwr-method" class="gwr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="pan">Goldpfanne (langsam, günstig)</option>
              <option value="sluice" selected>Waschrinne (moderat)</option>
              <option value="trommel">Trommel/Highbanker (schnell)</option>
              <option value="dredge">Saugbagger (höchste)</option>
            </select>
          </div>
          <div><label class="block text-sm font-medium text-text mb-1">Betriebskosten (€/Tag)</label><input type="number" id="gwr-cost" class="gwr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="25" min="0" step="5"></div>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Betriebstage</label><input type="number" id="gwr-days" class="gwr-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="30" min="1" step="1"></div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Goldwert</div>
          <div class="text-4xl font-extrabold" id="gwr-daily">0 €</div>
          <div class="text-sm text-blue-200 mt-1" id="gwr-dailygrams">0 Gramm/Tag</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wert pro m³</div><div class="text-xl font-bold text-secondary" id="gwr-perm3">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tagesgewinn netto</div><div class="text-xl font-bold" id="gwr-profit">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt Gold gewonnen</div><div class="text-xl font-bold" id="gwr-totalgold">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtwert</div><div class="text-xl font-bold" id="gwr-totalval">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewinn netto</div><div class="text-xl font-bold" id="gwr-totalprofit">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinnschwelle (mg/m³)</div><div class="text-xl font-bold" id="gwr-breakeven">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Bewertung</div>
          <div class="text-sm font-bold" id="gwr-assess">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="goldwaschen" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wirtschaftlichkeit beim Goldwaschen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Gold gewonnen/Tag</strong> = (mg/m³ x m³/Tag x Ausbeuterate%) / 1000 Gramm</p>
        <p><strong>Wert/Tag</strong> = Gramm x (Preis pro Feinunze / 31,1035)</p>
        <p><strong>1 Feinunze</strong> = 31,1035 Gramm</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Lohnt sich Goldwaschen finanziell?</strong> Für die meisten Hobby-Goldwäscher ist es eher ein Freizeitvergnügen als eine Einnahmequelle. Professionelles Goldwaschen kann sich bei ergiebigen Lagerstätten lohnen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcGWR() {
      const price = parseFloat((document.getElementById('gwr-price') as HTMLInputElement).value) || 0;
      const mgM3 = parseFloat((document.getElementById('gwr-mgm3') as HTMLInputElement).value) || 0;
      const m3 = parseFloat((document.getElementById('gwr-m3') as HTMLInputElement).value) || 0;
      const recovery = (parseFloat((document.getElementById('gwr-recovery') as HTMLInputElement).value) || 0) / 100;
      const cost = parseFloat((document.getElementById('gwr-cost') as HTMLInputElement).value) || 0;
      const days = parseFloat((document.getElementById('gwr-days') as HTMLInputElement).value) || 0;

      const pricePerGram = price / 31.1035;
      const goldPerDayMg = mgM3 * m3 * recovery;
      const goldPerDayG = goldPerDayMg / 1000;
      const dailyValue = goldPerDayG * pricePerGram;
      const valuePerM3 = m3 > 0 ? dailyValue / m3 : 0;
      const dailyProfit = dailyValue - cost;

      const totalGold = goldPerDayG * days;
      const totalValue = dailyValue * days;
      const totalProfit = totalValue - cost * days;

      const breakevenMg = (m3 > 0 && recovery > 0 && pricePerGram > 0) ?
        (cost * 1000) / (m3 * recovery * pricePerGram) : 0;

      let assess = '';
      if (dailyProfit > 100) assess = 'Ausgezeichnet - sehr profitable Lagerstätte';
      else if (dailyProfit > 30) assess = 'Gut - lohnender Betrieb';
      else if (dailyProfit > 0) assess = 'Grenzwertig - deckt Kosten, nettes Hobby-Einkommen';
      else assess = 'Unter Gewinnschwelle - Goldkonzentration zu niedrig für die Kosten';

      const fmt = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 2 });

      document.getElementById('gwr-daily')!.textContent = fmt(dailyValue) + ' \u20ac';
      document.getElementById('gwr-dailygrams')!.textContent = goldPerDayG.toFixed(3) + ' Gramm/Tag';
      document.getElementById('gwr-perm3')!.textContent = fmt(valuePerM3) + ' \u20ac';
      document.getElementById('gwr-profit')!.textContent = (dailyProfit >= 0 ? '' : '-') + fmt(Math.abs(dailyProfit)) + ' \u20ac';
      document.getElementById('gwr-totalgold')!.textContent = fmt(totalGold) + ' g (' + (totalGold / 31.1035).toFixed(3) + ' oz)';
      document.getElementById('gwr-totalval')!.textContent = fmt(totalValue) + ' \u20ac';
      document.getElementById('gwr-totalprofit')!.textContent = (totalProfit >= 0 ? '' : '-') + fmt(Math.abs(totalProfit)) + ' \u20ac';
      document.getElementById('gwr-breakeven')!.textContent = fmt(breakevenMg) + ' mg/m\u00b3';
      document.getElementById('gwr-assess')!.textContent = assess;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gwr-in').forEach(el => { el.addEventListener('input', calcGWR); el.addEventListener('change', calcGWR); });
      calcGWR();
    }, 50);
  </script>
</CalculatorLayout>
