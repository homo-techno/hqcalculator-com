---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "H\u00f6henunterschied-Rechner - Trigonometrische Nivellierung";
const description = "Berechnen Sie den H\u00f6henunterschied mit trigonometrischer Nivellierung: Vertikalwinkel, Schr\u00e4gdistanz, Instrumenten- und Zielh\u00f6he.";
const relatedCalcs = [
  { name: "Erosion-Rechner", url: "/de/erosion-rechner", description: "Bodenerosion berechnen." },
  { name: "Fluchtgeschwindigkeit", url: "/de/fluchtgeschwindigkeit-rechner", description: "Fluchtgeschwindigkeit." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
  { name: "Gleichungsl\u00f6ser", url: "/de/gleichungsloeser", description: "Gleichungen l\u00f6sen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="H\u00f6henunterschied-Rechner" lang="de" enSlug="elevation-difference-calculator" keywords="h\u00f6henunterschied rechner, trigonometrische nivellierung, vertikalwinkel, schr\u00e4gdistanz, vermessung" breadcrumbs={[{ name: "H\u00f6henunterschied-Rechner", url: "/de/hoehenunterschied-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">H&ouml;henunterschied-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den H&ouml;henunterschied aus trigonometrischen Nivellierungsbeobachtungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Schr&auml;gdistanz (m)</label>
          <input type="number" id="hud-sd" class="hud-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Vertikalwinkel (Grad, + oben / - unten)</label>
          <input type="number" id="hud-va" class="hud-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.5" step="0.01">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Instrumentenh&ouml;he (m)</label>
            <input type="number" id="hud-hi" class="hud-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.60" step="0.01">
          </div>
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Zielh&ouml;he (m)</label>
            <input type="number" id="hud-ht" class="hud-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.60" step="0.01">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Bekannte H&ouml;he Standpunkt (m &uuml;. NHN)</label>
          <input type="number" id="hud-elev" class="hud-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" step="0.01">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">H&ouml;henunterschied</div>
          <div class="text-5xl font-extrabold font-mono" id="hud-diff">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zielh&ouml;he (&uuml;. NHN)</div>
            <div class="text-xl font-bold" id="hud-target">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Horizontaldistanz</div>
            <div class="text-xl font-bold" id="hud-hd">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Vertikalkomponente</div>
            <div class="text-xl font-bold" id="hud-vc">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Erdkr&uuml;mmung + Refraktion</div>
            <div class="text-xl font-bold" id="hud-cr">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="elevation-difference-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Trigonometrische Nivellierung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>dH = SD &times; sin(VA) + HI &minus; HT + K&amp;R</p>
        <p>HD = SD &times; cos(VA)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Refraktionskoeffizient?</strong> Die Erdkr&uuml;mmungs- und Refraktionskorrektur ber&uuml;cksichtigt die Biegung des Lichts in der Atmosph&auml;re.</p>
      <p><strong>Wann braucht man trigonometrische Nivellierung?</strong> Wenn geometrische Nivellierung bei gro&szlig;en H&ouml;henunterschieden oder in steilem Gel&auml;nde unpraktisch ist.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcHUD() {
      const sd = parseFloat((document.getElementById('hud-sd') as HTMLInputElement).value) || 0;
      const va = parseFloat((document.getElementById('hud-va') as HTMLInputElement).value) || 0;
      const hi = parseFloat((document.getElementById('hud-hi') as HTMLInputElement).value) || 0;
      const ht = parseFloat((document.getElementById('hud-ht') as HTMLInputElement).value) || 0;
      const elev = parseFloat((document.getElementById('hud-elev') as HTMLInputElement).value) || 0;
      const vaRad = va * Math.PI / 180;
      const hd = sd * Math.cos(vaRad);
      const vc = sd * Math.sin(vaRad);
      const km = hd / 1000;
      const cr = 0.0675 * km * km;
      const diff = vc + hi - ht + cr;
      const targetElev = elev + diff;
      document.getElementById('hud-diff')!.textContent = diff.toFixed(3) + ' m';
      document.getElementById('hud-target')!.textContent = targetElev.toFixed(3) + ' m';
      document.getElementById('hud-hd')!.textContent = hd.toFixed(3) + ' m';
      document.getElementById('hud-vc')!.textContent = vc.toFixed(3) + ' m';
      document.getElementById('hud-cr')!.textContent = cr.toFixed(4) + ' m';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hud-in').forEach(el => { el.addEventListener('input', calcHUD); el.addEventListener('change', calcHUD); });
      calcHUD();
    }, 50);
  </script>
</CalculatorLayout>
