---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Notgroschen-Rechner - Wie viel brauchen Sie?";
const description = "Berechnen Sie, wie viel Sie in Ihrem Notgroschen sparen sollten, basierend auf monatlichen Ausgaben und pers\u00f6nlicher Situation.";

const relatedCalcs = [
  { name: "Treuhandkonto-Rechner", url: "/de/treuhandkonto-rechner", description: "Treuhandzahlungen." },
  { name: "Mitarbeiterfluktuation", url: "/de/mitarbeiterfluktuation-rechner", description: "Fluktuationskosten." },
  { name: "Stromverbrauch-Rechner", url: "/de/stromverbrauch-rechner", description: "Stromkosten." },
  { name: "Energieaudit-Rechner", url: "/de/energieaudit-rechner", description: "Energieeffizienz." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Notgroschen-Rechner" lang="de" enSlug="emergency-fund-calculator" keywords="notgroschen rechner, notfallreserve, finanzpolster, r\u00fccklage berechnen, notfallsparplan" breadcrumbs={[{ name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Notgroschen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie heraus, wie viel Sie in Ihrem Notgroschen ben&ouml;tigen und wie lange der Aufbau dauert.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Monatliche Grundausgaben</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="ngr-expenses" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="2500" min="0" step="100">
            </div>
            <p class="text-xs text-text-muted mt-1">Miete, Essen, Nebenkosten, Versicherung, Transport, Mindestschuldenraten</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Monate Absicherung</label>
            <select id="ngr-months" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3">3 Monate (Minimum)</option>
              <option value="6" selected>6 Monate (empfohlen)</option>
              <option value="9">9 Monate (konservativ)</option>
              <option value="12">12 Monate (Selbstst&auml;ndige / Alleinverdiener)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktuelle Notfallr&uuml;cklagen</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
              <input type="number" id="ngr-current" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="5000" min="0" step="500">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Monatliche Sparrate</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
              <input type="number" id="ngr-contrib" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="400" min="0" step="50">
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ziel Notgroschen</div>
            <div class="text-5xl font-extrabold" id="ngr-target">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Noch ben&ouml;tigt</div>
              <div class="text-xl font-bold text-secondary" id="ngr-need">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Monate bis Ziel</div>
              <div class="text-xl font-bold" id="ngr-time">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Fortschritt</div>
              <div class="text-xl font-bold" id="ngr-progress">0%</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Aktuelle Abdeckung</div>
              <div class="text-xl font-bold" id="ngr-coverage">0 Mo.</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-2">Fortschrittsbalken</h3>
            <div class="w-full h-4 bg-gray-200 rounded-full overflow-hidden">
              <div class="h-full bg-green-500 rounded-full transition-all" id="ngr-bar" style="width:0%"></div>
            </div>
            <div class="text-xs text-text-muted mt-1 text-center" id="ngr-bar-text">0% finanziert</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="emergency-fund-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie viel Notgroschen brauchen Sie?</h2>
      <p>Die meisten Finanzexperten empfehlen 3-6 Monate der Grundausgaben. Selbstst&auml;ndige oder Alleinverdiener sollten 9-12 Monate anstreben.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wo sollte ich meinen Notgroschen aufbewahren?</strong> Auf einem Tagesgeldkonto &mdash; leicht zug&auml;nglich und verzinst. Investieren Sie ihn nicht in Aktien, da Sie m&ouml;glicherweise kurzfristig darauf zugreifen m&uuml;ssen.</p>
      <p><strong>Wie fange ich an?</strong> Richten Sie einen Dauerauftrag auf ein separates Tagesgeldkonto ein. Beginnen Sie mit dem, was m&ouml;glich ist, und erh&ouml;hen Sie schrittweise.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const ngrFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcNGR() {
      const expenses = parseFloat((document.getElementById('ngr-expenses') as HTMLInputElement).value) || 0;
      const months = parseInt((document.getElementById('ngr-months') as HTMLSelectElement).value) || 6;
      const current = parseFloat((document.getElementById('ngr-current') as HTMLInputElement).value) || 0;
      const contrib = parseFloat((document.getElementById('ngr-contrib') as HTMLInputElement).value) || 0;

      const target = expenses * months;
      const need = Math.max(0, target - current);
      const monthsToGoal = contrib > 0 ? Math.ceil(need / contrib) : need > 0 ? Infinity : 0;
      const progress = target > 0 ? Math.min(100, (current / target) * 100) : 0;
      const coverageNow = expenses > 0 ? (current / expenses) : 0;

      document.getElementById('ngr-target')!.textContent = ngrFmt(target);
      document.getElementById('ngr-need')!.textContent = ngrFmt(need);
      document.getElementById('ngr-time')!.textContent = monthsToGoal === Infinity ? 'N/A' : monthsToGoal.toString();
      document.getElementById('ngr-progress')!.textContent = progress.toFixed(0) + '%';
      document.getElementById('ngr-coverage')!.textContent = coverageNow.toFixed(1) + ' Mo.';
      (document.getElementById('ngr-bar') as HTMLElement).style.width = progress + '%';
      document.getElementById('ngr-bar-text')!.textContent = progress.toFixed(0) + '% finanziert' + (need <= 0 ? ' \u2014 Ziel erreicht!' : '');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['ngr-expenses', 'ngr-current', 'ngr-contrib'].forEach(id => document.getElementById(id)!.addEventListener('input', calcNGR));
      document.getElementById('ngr-months')!.addEventListener('change', calcNGR);
      calcNGR();
    }, 50);
  </script>
</CalculatorLayout>
