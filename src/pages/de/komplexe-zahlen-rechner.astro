---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Komplexe-Zahlen-Rechner";
const description = "F\u00fchren Sie Rechenoperationen mit komplexen Zahlen durch: Addieren, Subtrahieren, Multiplizieren, Dividieren und Umrechnung zwischen kartesischer und Polarform.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Br\u00fcche." },
  { name: "Fl\u00e4chenrechner", url: "/de/flaechenrechner", description: "Fl\u00e4chenberechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Komplexe-Zahlen-Rechner" lang="de" enSlug="complex-number-calculator" keywords="komplexe zahlen rechner, imagin\u00e4re zahl, polarform, komplexe arithmetik, realteil, imagin\u00e4rteil" breadcrumbs={[{ name: "Komplexe Zahlen", url: "/de/komplexe-zahlen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Komplexe-Zahlen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Addieren, Subtrahieren, Multiplizieren und Dividieren komplexer Zahlen (a + bi).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Z&#8321; = a + bi</h3>
          <div class="flex gap-2 items-center">
            <input type="number" id="kz-a1" class="kz-in flex-1 px-3 py-2 border border-border rounded-xl text-lg font-bold text-center" value="3" step="0.1">
            <span class="font-bold">+</span>
            <input type="number" id="kz-b1" class="kz-in flex-1 px-3 py-2 border border-border rounded-xl text-lg font-bold text-center" value="4" step="0.1">
            <span class="font-bold text-primary">i</span>
          </div>
        </div>
        <div class="flex gap-2">
          <button class="kz-op flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-op="+">Addieren</button>
          <button class="kz-op flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-op="-">Subtrahieren</button>
          <button class="kz-op flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-op="*">Multiplizieren</button>
          <button class="kz-op flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-op="/">Dividieren</button>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Z&#8322; = c + di</h3>
          <div class="flex gap-2 items-center">
            <input type="number" id="kz-a2" class="kz-in flex-1 px-3 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" step="0.1">
            <span class="font-bold">+</span>
            <input type="number" id="kz-b2" class="kz-in flex-1 px-3 py-2 border border-border rounded-xl text-lg font-bold text-center" value="-2" step="0.1">
            <span class="font-bold text-primary">i</span>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ergebnis</div>
          <div class="text-4xl font-extrabold font-mono" id="kz-result">0 + 0i</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">|Z&#8321;| Betrag</div><div class="text-xl font-bold font-mono" id="kz-mag1">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">|Z&#8322;| Betrag</div><div class="text-xl font-bold font-mono" id="kz-mag2">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Z&#8321; Polarform</div><div class="text-lg font-bold font-mono" id="kz-pol1">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Z&#8322; Polarform</div><div class="text-lg font-bold font-mono" id="kz-pol2">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Z&#8321; Konjugierte</div><div class="text-lg font-bold font-mono" id="kz-conj1">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">|Ergebnis|</div><div class="text-lg font-bold font-mono" id="kz-magR">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="complex-number" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Komplexe Zahlen verstehen</h2>
      <p>Eine komplexe Zahl z = a + bi besteht aus einem Realteil a und einem Imagin&auml;rteil b, wobei i die imagin&auml;re Einheit ist (i&sup2; = -1). Komplexe Zahlen finden Anwendung in der Elektrotechnik, Signalverarbeitung und Quantenmechanik.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Rechenregeln</h3>
      <ul>
        <li><strong>Addition:</strong> (a+bi) + (c+di) = (a+c) + (b+d)i</li>
        <li><strong>Multiplikation:</strong> (a+bi)(c+di) = (ac-bd) + (ad+bc)i</li>
        <li><strong>Betrag:</strong> |z| = &radic;(a&sup2; + b&sup2;)</li>
        <li><strong>Polarform:</strong> z = r(cos&theta; + i&middot;sin&theta;)</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let kzOp = '+';
    function fmtC(r: number, i: number): string {
      if (i === 0) return r.toFixed(2);
      const sign = i >= 0 ? '+' : '-';
      return r.toFixed(2) + ' ' + sign + ' ' + Math.abs(i).toFixed(2) + 'i';
    }
    function toPolar(r: number, i: number): string {
      const mag = Math.sqrt(r * r + i * i);
      const angle = Math.atan2(i, r) * 180 / Math.PI;
      return mag.toFixed(2) + '\u2220' + angle.toFixed(1) + '\u00B0';
    }
    function calcKZ() {
      const a1 = parseFloat((document.getElementById('kz-a1') as HTMLInputElement).value) || 0;
      const b1 = parseFloat((document.getElementById('kz-b1') as HTMLInputElement).value) || 0;
      const a2 = parseFloat((document.getElementById('kz-a2') as HTMLInputElement).value) || 0;
      const b2 = parseFloat((document.getElementById('kz-b2') as HTMLInputElement).value) || 0;
      let rr = 0, ri = 0;
      if (kzOp === '+') { rr = a1 + a2; ri = b1 + b2; }
      else if (kzOp === '-') { rr = a1 - a2; ri = b1 - b2; }
      else if (kzOp === '*') { rr = a1 * a2 - b1 * b2; ri = a1 * b2 + b1 * a2; }
      else if (kzOp === '/') {
        const d = a2 * a2 + b2 * b2;
        if (d > 0) { rr = (a1 * a2 + b1 * b2) / d; ri = (b1 * a2 - a1 * b2) / d; }
      }
      document.getElementById('kz-result')!.textContent = fmtC(rr, ri);
      document.getElementById('kz-mag1')!.textContent = Math.sqrt(a1 * a1 + b1 * b1).toFixed(4);
      document.getElementById('kz-mag2')!.textContent = Math.sqrt(a2 * a2 + b2 * b2).toFixed(4);
      document.getElementById('kz-pol1')!.textContent = toPolar(a1, b1);
      document.getElementById('kz-pol2')!.textContent = toPolar(a2, b2);
      document.getElementById('kz-conj1')!.textContent = fmtC(a1, -b1);
      document.getElementById('kz-magR')!.textContent = Math.sqrt(rr * rr + ri * ri).toFixed(4);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kz-op').forEach(b => b.addEventListener('click', () => {
        kzOp = (b as HTMLButtonElement).dataset.op!;
        document.querySelectorAll('.kz-op').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.op === kzOp;
          (btn as HTMLButtonElement).className = 'kz-op flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        calcKZ();
      }));
      document.querySelectorAll('.kz-in').forEach(el => { el.addEventListener('input', calcKZ); el.addEventListener('change', calcKZ); });
      calcKZ();
    }, 50);
  </script>
</CalculatorLayout>
