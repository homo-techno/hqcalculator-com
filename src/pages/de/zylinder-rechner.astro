---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zylinder-Rechner - Volumen & Oberflaeche berechnen";
const description = "Berechnen Sie Zylindervolumen, Gesamtoberflaeche, Mantelflaeche und Grundflaeche aus Radius und Hoehe.";
const relatedCalcs = [
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "3D-Volumen." },
  { name: "Kreisrechner", url: "/de/kreisrechner", description: "Kreise." },
  { name: "Flaechenrechner", url: "/de/flaechenrechner", description: "2D-Flaechen." },
  { name: "Kugelrechner", url: "/de/kugelrechner", description: "Kugeln." },
  { name: "Kegelrechner", url: "/de/kegelrechner", description: "Kegel." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Zylinder-Rechner" keywords="Zylinder Rechner, Zylindervolumen, Zylinder Oberflaeche, Rohrvolumen, Tankvolumen" breadcrumbs={[{ name: "Zylinder-Rechner", url: "/de/zylinder-rechner" }]} lang="de" enSlug="cylinder-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zylinder-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Zylindervolumen und Oberflaeche.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Radius</label><input type="number" id="zyr-r" class="zyr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hoehe</label><input type="number" id="zyr-h" class="zyr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="10" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-5 bg-primary rounded-2xl text-white text-center"><div class="text-xs uppercase tracking-wide mb-1 opacity-80">Volumen</div><div class="text-2xl font-extrabold font-mono" id="zyr-vol">0</div></div>
          <div class="p-5 bg-secondary rounded-2xl text-white text-center"><div class="text-xs uppercase tracking-wide mb-1 opacity-80">Gesamtoberflaeche</div><div class="text-2xl font-extrabold font-mono" id="zyr-tsa">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mantelflaeche</div><div class="text-xl font-bold" id="zyr-la">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundflaeche</div><div class="text-xl font-bold" id="zyr-ba">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchmesser</div><div class="text-xl font-bold" id="zyr-dia">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formeln</h3>
          <div class="font-mono text-sm space-y-1">
            <div>V = pi x r2 x h</div>
            <div>Mantelflaeche = 2 x pi x r x h</div>
            <div>Gesamtoberflaeche = 2 x pi x r x (r + h)</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="cylinder" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zylinderberechnungen</h2>
      <p>Ein Zylinder ist ein dreidimensionaler Koerper mit zwei parallelen kreisfoermigen Grundflaechen. Die Berechnung von Volumen und Oberflaeche ist in vielen praktischen Anwendungen wichtig, z.B. bei Tanks, Rohren und Behaeltern.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Was ist die Mantelflaeche?</strong> Die Mantelflaeche ist die seitliche Flaeche des Zylinders ohne die beiden Kreisflaechen oben und unten.</li>
        <li><strong>Wie berechne ich das Volumen eines Tanks?</strong> Messen Sie den Innenradius und die Hoehe/Laenge und verwenden Sie V = pi x r2 x h.</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcZYR() {
      const r = parseFloat((document.getElementById('zyr-r') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('zyr-h') as HTMLInputElement).value) || 0;
      const vol = Math.PI * r * r * h;
      const baseArea = Math.PI * r * r;
      const lateralArea = 2 * Math.PI * r * h;
      const totalSA = 2 * Math.PI * r * (r + h);
      document.getElementById('zyr-vol')!.textContent = vol.toFixed(4).replace('.', ',');
      document.getElementById('zyr-tsa')!.textContent = totalSA.toFixed(4).replace('.', ',');
      document.getElementById('zyr-la')!.textContent = lateralArea.toFixed(4).replace('.', ',');
      document.getElementById('zyr-ba')!.textContent = baseArea.toFixed(4).replace('.', ',');
      document.getElementById('zyr-dia')!.textContent = (r * 2).toFixed(4).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.zyr-in').forEach(el => el.addEventListener('input', calcZYR)); calcZYR(); }, 50);
  </script>
</CalculatorLayout>
