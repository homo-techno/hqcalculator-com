---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bodenbelag-Rechner - Material & Kosten sch&auml;tzen";
const description = "Berechnen Sie den Bodenbelagbedarf und sch&auml;tzen Sie die Gesamtkosten inkl. Verschnitt f&uuml;r Parkett, Laminat, Vinyl, Fliesen oder Teppich.";
const relatedCalcs = [
  { name: "Fl&auml;chenrechner", url: "/de/flaechenrechner", description: "Fl&auml;che berechnen." },
  { name: "Fliesenrechner", url: "/de/fliesenrechner", description: "Fliesen berechnen." },
  { name: "Farbrechner", url: "/de/farbrechner", description: "Farbbedarf." },
  { name: "L&auml;ngenumrechner", url: "/de/laengenumrechner", description: "L&auml;ngen umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Bodenbelag-Rechner" lang="de" enSlug="flooring-calculator" keywords="Bodenbelag Rechner, Parkett Rechner, Laminat Rechner, Fliesen Bodenbelag, Bodenbelag Kosten" breadcrumbs={[{ name: "Bodenbelag-Rechner", url: "/de/bodenbelag-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bodenbelag-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Material und Kosten f&uuml;r Ihren Bodenbelag.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Bodenbelag-Typ</label>
          <select id="bbg-type" class="bbg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="parkett" selected>Parkett (40-80 &euro;/m&sup2;)</option>
            <option value="laminat">Laminat (15-35 &euro;/m&sup2;)</option>
            <option value="vinyl">Vinyl/LVT (20-50 &euro;/m&sup2;)</option>
            <option value="fliesen">Fliesen (30-70 &euro;/m&sup2;)</option>
            <option value="teppich">Teppich (15-50 &euro;/m&sup2;)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Rauml&auml;nge (m)</label><input type="number" id="bbg-length" class="bbg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.5" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="bbg-width" class="bbg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0.5" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label><input type="number" id="bbg-waste" class="bbg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro m&sup2; (&euro;)</label><input type="number" id="bbg-price" class="bbg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="55" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtbedarf</div>
          <div class="text-4xl font-extrabold" id="bbg-total">0 m&sup2;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-5 bg-secondary rounded-2xl text-white text-center">
            <div class="text-xs uppercase tracking-wide mb-1 opacity-80">Gesch&auml;tzte Kosten</div>
            <div class="text-2xl font-extrabold" id="bbg-cost">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumfl&auml;che</div><div class="text-xl font-bold" id="bbg-area">0 m&sup2;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschnittmenge</div><div class="text-xl font-bold" id="bbg-wasteamt">0 m&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pakete (2,5 m&sup2;/Pkt.)</div><div class="text-xl font-bold" id="bbg-packs">0</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="flooring" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie viel Verschnitt einplanen?</strong> 10% f&uuml;r gerade Verlegung, 15% f&uuml;r diagonale oder komplexe Muster.</p>
      <p><strong>Warum alles auf einmal kaufen?</strong> Kaufen Sie das gesamte Material auf einmal, um Farbabweichungen zwischen Chargen zu vermeiden.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const bbgPriceRanges: Record<string, number> = { parkett: 55, laminat: 25, vinyl: 35, fliesen: 50, teppich: 30 };
    function calcBBG() {
      const type = (document.getElementById('bbg-type') as HTMLSelectElement).value;
      const length = parseFloat((document.getElementById('bbg-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('bbg-width') as HTMLInputElement).value) || 0;
      const waste = parseFloat((document.getElementById('bbg-waste') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('bbg-price') as HTMLInputElement).value) || 0;
      const area = length * width;
      const wasteAmt = area * (waste / 100);
      const total = area + wasteAmt;
      const cost = total * price;
      const packs = Math.ceil(total / 2.5);
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('bbg-total')!.textContent = fmt(total) + ' m\u00b2';
      document.getElementById('bbg-cost')!.textContent = cost.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('bbg-area')!.textContent = fmt(area) + ' m\u00b2';
      document.getElementById('bbg-wasteamt')!.textContent = fmt(wasteAmt) + ' m\u00b2';
      document.getElementById('bbg-packs')!.textContent = String(packs);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    function setBBGTypePrice() {
      const type = (document.getElementById('bbg-type') as HTMLSelectElement).value;
      (document.getElementById('bbg-price') as HTMLInputElement).value = String(bbgPriceRanges[type]);
      calcBBG();
    }
    setTimeout(() => {
      document.querySelectorAll('.bbg-in').forEach(el => el.addEventListener('input', calcBBG));
      document.getElementById('bbg-type')!.addEventListener('change', setBBGTypePrice);
      calcBBG();
    }, 50);
  </script>
</CalculatorLayout>
