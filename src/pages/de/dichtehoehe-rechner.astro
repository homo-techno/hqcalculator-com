---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Dichteh\u00f6he-Rechner - Druckh\u00f6he, Temperatur & Taupunkt";
const description = "Berechnen Sie die Dichteh\u00f6he aus Druckh\u00f6he, Au\u00dfentemperatur und Taupunkt. Sehen Sie Leistungsauswirkungen und Vergleich mit der Standardatmosph\u00e4re f\u00fcr die Luftfahrt.";

const relatedCalcs = [
  { name: "Druckumrechner", url: "/de/druck-umrechner", description: "Druckeinheiten." },
  { name: "Temperaturumrechner", url: "/de/temperatur-umrechner", description: "Temperaturen." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeits-rechner", description: "Geschwindigkeit." },
  { name: "Kraftrechner", url: "/de/kraft-rechner", description: "Kraft." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="density-altitude-calculator" calculatorName="Dichteh\u00f6he-Rechner" keywords="dichteh\u00f6he, druckh\u00f6he, luftfahrt wetter, flugzeugleistung, standardatmosph\u00e4re, taupunkt" breadcrumbs={[{ name: "Dichteh\u00f6he-Rechner", url: "/de/dichtehoehe-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dichteh&ouml;he-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Dichteh&ouml;he aus Druckh&ouml;he, Au&szlig;entemperatur und Taupunkt zur Beurteilung der Flugleistung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label for="dh2-elev" class="block text-sm font-medium text-text mb-1">Platzh&ouml;he (ft)</label>
          <input type="number" id="dh2-elev" class="dh2-in w-full border border-border rounded-xl px-4 py-3 text-lg font-bold" min="0" max="15000" step="100" />
        </div>
        <div>
          <label for="dh2-altset" class="block text-sm font-medium text-text mb-1">H&ouml;henmessereinstellung (inHg)</label>
          <input type="number" id="dh2-altset" class="dh2-in w-full border border-border rounded-xl px-4 py-3 text-lg font-bold" min="27" max="32" step="0.01" />
        </div>
        <div>
          <label for="dh2-oat" class="block text-sm font-medium text-text mb-1">Au&szlig;entemperatur (&deg;C)</label>
          <input type="number" id="dh2-oat" class="dh2-in w-full border border-border rounded-xl px-4 py-3 text-lg font-bold" min="-50" max="60" step="1" />
        </div>
        <div>
          <label for="dh2-dew" class="block text-sm font-medium text-text mb-1">Taupunkt (&deg;C)</label>
          <input type="number" id="dh2-dew" class="dh2-in w-full border border-border rounded-xl px-4 py-3 text-lg font-bold" min="-50" max="50" step="1" />
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Dichteh&ouml;he</div>
          <div class="text-5xl font-extrabold font-mono" id="dh2-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Druckh&ouml;he</div>
            <div class="text-xl font-bold font-mono" id="dh2-pa">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">ISA-Temp. auf H&ouml;he</div>
            <div class="text-xl font-bold font-mono" id="dh2-isa">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">ISA-Abweichung</div>
            <div class="text-xl font-bold font-mono" id="dh2-dev">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Relative Luftdichte</div>
            <div class="text-xl font-bold font-mono" id="dh2-rho">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Leistungsauswirkung</div>
          <div class="text-lg font-bold font-mono" id="dh2-perf">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="density-altitude" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dichteh&ouml;he verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Druckh&ouml;he</strong> = Platzh&ouml;he + (29,92 &minus; QNH) &times; 1.000</p>
        <p><strong>ISA-Temperatur</strong> = 15 &minus; (Druckh&ouml;he / 1.000) &times; 1,98 &deg;C</p>
        <p><strong>Dichteh&ouml;he</strong> &asymp; Druckh&ouml;he + 118,8 &times; (T<sub>v</sub> &minus; ISA-Temp)</p>
      </div>
      <p>Die Dichteh&ouml;he gibt an, in welcher H&ouml;he der Standardatmosph&auml;re die aktuelle Luftdichte herrscht. Sie ist entscheidend f&uuml;r Start-, Lande- und Steigleistung. In der Luftfahrt werden H&ouml;hen international in Fu&szlig; (ft) angegeben.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum wird in Fu&szlig; gemessen?</strong> In der internationalen Luftfahrt (ICAO) sind Fu&szlig; die Standardeinheit f&uuml;r H&ouml;henangaben. Dies gilt auch in Deutschland (DFS).</p>
      <p><strong>Wann ist die Dichteh&ouml;he kritisch?</strong> An hei&szlig;en Sommertagen auf hochgelegenen Flugpl&auml;tzen kann die Dichteh&ouml;he die tats&auml;chliche H&ouml;he um mehrere tausend Fu&szlig; &uuml;bersteigen und die Flugleistung erheblich beeintr&auml;chtigen.</p>
      <p><strong>Was ist die ISA-Standardatmosph&auml;re?</strong> Die Internationale Standardatmosph&auml;re definiert Referenzbedingungen: 15 &deg;C auf Meeresh&ouml;he, 1013,25 hPa Druck, mit einem Temperaturgradienten von &minus;1,98 &deg;C pro 1.000 ft.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcDH2() {
      const elev = parseFloat((document.getElementById('dh2-elev') as HTMLInputElement).value) || 0;
      const altSet = parseFloat((document.getElementById('dh2-altset') as HTMLInputElement).value) || 29.92;
      const oat = parseFloat((document.getElementById('dh2-oat') as HTMLInputElement).value) || 15;
      const dew = parseFloat((document.getElementById('dh2-dew') as HTMLInputElement).value) || 0;

      const pa = elev + (29.92 - altSet) * 1000;
      const isaTemp = 15 - (pa / 1000) * 1.98;
      const isaDev = oat - isaTemp;

      const esDew = 6.1078 * Math.pow(10, (7.5 * dew) / (237.3 + dew));
      const pMb = altSet * 33.8639 - (elev * 0.12);

      const oatK = oat + 273.15;
      const tvK = oatK / (1 - 0.378 * (esDew / pMb));

      const densAlt = pa + 118.8 * (tvK - (273.15 + isaTemp));

      const rhoRatio = (1 - 6.8756e-6 * densAlt);
      const relDensity = Math.pow(rhoRatio, 4.2559) * (288.15 / tvK);

      document.getElementById('dh2-result')!.textContent = Math.round(densAlt).toLocaleString('de-DE') + ' ft';
      document.getElementById('dh2-pa')!.textContent = Math.round(pa).toLocaleString('de-DE') + ' ft';
      document.getElementById('dh2-isa')!.textContent = isaTemp.toFixed(1).replace('.', ',') + ' \u00b0C';
      document.getElementById('dh2-dev')!.textContent = (isaDev >= 0 ? '+' : '') + isaDev.toFixed(1).replace('.', ',') + ' \u00b0C';
      document.getElementById('dh2-rho')!.textContent = (relDensity * 100).toFixed(1).replace('.', ',') + ' %';

      let perf = '';
      if (densAlt > 8000) perf = 'Stark beeintr\u00e4chtigt \u2013 \u00e4u\u00dferste Vorsicht';
      else if (densAlt > 6000) perf = 'Erheblich reduzierte Leistung';
      else if (densAlt > 4000) perf = 'Sp\u00fcrbar reduzierte Leistung';
      else if (densAlt > 2000) perf = 'Leicht reduzierte Leistung';
      else perf = 'Nahezu Standardleistung';
      document.getElementById('dh2-perf')!.textContent = perf;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('dh2-elev') as HTMLInputElement).value = '5000';
      (document.getElementById('dh2-altset') as HTMLInputElement).value = '29.92';
      (document.getElementById('dh2-oat') as HTMLInputElement).value = '30';
      (document.getElementById('dh2-dew') as HTMLInputElement).value = '15';
      document.querySelectorAll('.dh2-in').forEach(el => { el.addEventListener('input', calcDH2); el.addEventListener('change', calcDH2); });
      calcDH2();
    }, 50);
  </script>
</CalculatorLayout>
