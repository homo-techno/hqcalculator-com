---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Unterhaltsrechner - Ehegattenunterhalt schätzen";
const description = "Schätzen Sie Ehegattenunterhalt basierend auf Einkommensdifferenz, Ehedauer und Unterhaltsleitlinien.";

const relatedCalcs = [
  { name: "Kindesunterhalt", url: "/child-support-calculator", description: "Kindesunterhalt." },
  { name: "Scheidungskosten", url: "/divorce-cost-calculator", description: "Scheidungskosten." },
  { name: "Einkommensteuer", url: "/income-tax-calculator", description: "Steuerschätzung." },
  { name: "Budgetrechner", url: "/budget-calculator", description: "Budgetplanung." },
  { name: "Vermögensrechner", url: "/net-worth-calculator", description: "Nettovermögen." },
  { name: "Gehaltsrechner", url: "/paycheck-calculator", description: "Nettogehalt." },
];
---

<CalculatorLayout lang="de" title={title} description={description} calculatorName="Unterhaltsrechner" keywords="Unterhaltsrechner, Ehegattenunterhalt, Unterhalt berechnen, Scheidung Unterhalt, Trennungsunterhalt" breadcrumbs={[{ name: "Unterhalt", url: "/de/unterhaltsrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Unterhaltsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie den Ehegattenunterhalt basierend auf Einkommensunterschied und Ehedauer. Ergebnisse dienen nur zur Information.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Bruttojahreseinkommen des Besserverdienenden</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">€</span>
              <input type="number" id="al-high-income" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="120000" min="0" step="5000">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bruttojahreseinkommen des Geringerverdienenden</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">€</span>
              <input type="number" id="al-low-income" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="40000" min="0" step="5000">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ehedauer (Jahre)</label>
            <input type="number" id="al-duration" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="12" min="0" max="50" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kinder vorhanden</label>
            <select id="al-children" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="no" selected>Keine Kinder</option>
              <option value="yes">Ja, mit Kindern</option>
            </select>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzter monatlicher Unterhalt</div>
            <div class="text-5xl font-extrabold font-mono" id="al-monthly">0 €</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Jährlicher Betrag</div>
              <div class="text-xl font-bold text-secondary" id="al-annual">0 €</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Geschätzte Dauer</div>
              <div class="text-xl font-bold" id="al-est-duration">0 Jahre</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Geschätzter Gesamtbetrag</div>
              <div class="text-xl font-bold text-orange-600" id="al-total">0 €</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Einkommensdifferenz</div>
              <div class="text-xl font-bold" id="al-diff">0 €</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Steuerhinweis</div>
            <div class="text-sm font-medium" id="al-tax-note">--</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="alimony" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie wird Unterhalt berechnet?</h2>
      <p>In Deutschland wird der nacheheliche Unterhalt häufig nach der Differenzmethode berechnet. Dabei erhält der Geringerverdienende in der Regel 3/7 der Einkommensdifferenz. Die Dauer hängt von der Ehedauer, dem Alter und weiteren Faktoren ab.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Steuerliche Aspekte</h3>
      <p>Unterhaltszahlungen können in Deutschland als Sonderausgaben (Realsplitting) bis zu 13.805 € pro Jahr abgesetzt werden, wenn der Empfänger zustimmt und die Zahlungen als sonstige Einkünfte versteuert.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' €';

    function calcAL() {
      const highIncome = parseFloat((document.getElementById('al-high-income') as HTMLInputElement).value) || 0;
      const lowIncome = parseFloat((document.getElementById('al-low-income') as HTMLInputElement).value) || 0;
      const duration = parseInt((document.getElementById('al-duration') as HTMLInputElement).value) || 0;
      const hasChildren = (document.getElementById('al-children') as HTMLSelectElement).value === 'yes';

      const incomeDiff = Math.max(0, highIncome - lowIncome);

      // German method: 3/7 of income difference
      let rate = hasChildren ? 0.30 : 3/7;
      const annualAlimony = Math.max(0, incomeDiff * rate);
      const monthlyAlimony = annualAlimony / 12;

      let estDuration: number;
      if (duration <= 5) estDuration = Math.ceil(duration * 0.3);
      else if (duration <= 10) estDuration = Math.ceil(duration * 0.4);
      else if (duration <= 20) estDuration = Math.ceil(duration * 0.5);
      else estDuration = Math.ceil(duration * 0.6);

      const totalAlimony = annualAlimony * estDuration;

      document.getElementById('al-monthly')!.textContent = fmt(monthlyAlimony);
      document.getElementById('al-annual')!.textContent = fmt(annualAlimony);
      document.getElementById('al-est-duration')!.textContent = estDuration + (estDuration === 1 ? ' Jahr' : ' Jahre');
      document.getElementById('al-total')!.textContent = fmt(totalAlimony);
      document.getElementById('al-diff')!.textContent = fmt(incomeDiff) + '/Jahr';
      document.getElementById('al-tax-note')!.textContent = 'Realsplitting: Bis 13.805 €/Jahr als Sonderausgaben absetzbar (mit Zustimmung des Empfängers).';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['al-high-income', 'al-low-income', 'al-duration'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcAL); el.addEventListener('change', calcAL); }
      });
      document.getElementById('al-children')!.addEventListener('change', calcAL);
      calcAL();
    }, 50);
  </script>
</CalculatorLayout>
