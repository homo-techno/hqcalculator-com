---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Keramikanalyse-Rechner - Scherbenfrequenz & Mindestgefaesszahl";
const description = "Analysieren Sie Keramikscherben-Fundkomplexe: Berechnen Sie Typfrequenzen, Mindestgefaesszahl (MGZ), Scherben-Gefaess-Verhaeltnisse und Assemblage-Diversitaet.";
const relatedCalcs = [
  { name: "Keramikform-Rechner", url: "/de/keramikform-rechner", description: "Gipsformen berechnen." },
  { name: "Keramikfaser-Rechner", url: "/de/keramikfaser-rechner", description: "Ofen-Isolierung." },
  { name: "Fliesengewicht-Rechner", url: "/de/fliesengewicht-rechner", description: "Fliesengewicht berechnen." },
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
  { name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner", description: "Statistischer Test." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Keramikanalyse-Rechner" enSlug="ceramic-analysis-calculator" keywords="Keramikanalyse, Toepferscherben, MGZ, Mindestgefaesszahl, Typfrequenz, Scherbenanalyse" breadcrumbs={[{ name: "Keramikanalyse-Rechner", url: "/de/keramikanalyse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Keramikanalyse-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie Keramik-Fundkomplexe: Typfrequenzen, Mindestgefaesszahl (MGZ), Fragmentierungsindex und Diversitaetsmasse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gesamtzahl Scherben</label>
          <input type="number" id="ka-total" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="350" min="1" step="1">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">Randscherben</label><input type="number" id="ka-rims" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="0" step="1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Wandungsscherben</label><input type="number" id="ka-body" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="270" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">Bodenscherben</label><input type="number" id="ka-base" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Henkel-/Griff-Scherben</label><input type="number" id="ka-handle" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="1"></div>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl verschiedener Typen/Waren</label><input type="number" id="ka-types" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Verzierte Scherben</label><input type="number" id="ka-decorated" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="55" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Gesamtgewicht (g)</label><input type="number" id="ka-weight" class="ka-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4200" min="0" step="1"></div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mindestgefaesszahl (MGZ)</div>
          <div class="text-4xl font-extrabold" id="ka-mnv">0</div>
          <div class="text-sm text-blue-200 mt-1">basierend auf Randscherben-Methode</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Scherben/Gefaess</div><div class="text-xl font-bold" id="ka-svr">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchschn. Gewicht</div><div class="text-xl font-bold" id="ka-avgwt">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Randanteil</div><div class="text-xl font-bold" id="ka-rimpct">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verzierungsrate</div><div class="text-xl font-bold" id="ka-decpct">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fragmentierungsindex</div><div class="text-xl font-bold" id="ka-broken">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Typdiversitaet</div><div class="text-xl font-bold" id="ka-diversity">0</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="keramikanalyse" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Methoden der Keramikanalyse</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>MGZ (Randmethode)</strong> = Anzahl unterschiedlicher Randprofile</p>
        <p><strong>Fragmentierungsindex</strong> = Gesamtscherben / MGZ</p>
        <p><strong>Typdiversitaet</strong> = Typen / ln(Gesamtscherben)</p>
      </div>
      <p>Die Mindestgefaesszahl (MGZ) schaetzt, wie viele vollstaendige Gefaesse in einem Scherbenkomplex vertreten sind. Randscherben liefern die zuverlaessigste MGZ-Schaetzung. Der Fragmentierungsindex zeigt post-depositionale Stoerungen an, und die Typdiversitaet spiegelt die Bandbreite der Keramiktraditionen wider.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Was ist die MGZ?</strong> Die Mindestgefaesszahl gibt an, wie viele einzelne Gefaesse mindestens im Fundkomplex vertreten sind.</li>
        <li><strong>Warum Randscherben zaehlen?</strong> Randscherben sind diagnostisch am wertvollsten, da sie Gefaessform und -groesse erkennen lassen.</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKA() {
      const total = parseFloat((document.getElementById('ka-total') as HTMLInputElement).value) || 0;
      const rims = parseFloat((document.getElementById('ka-rims') as HTMLInputElement).value) || 0;
      const base = parseFloat((document.getElementById('ka-base') as HTMLInputElement).value) || 0;
      const types = parseFloat((document.getElementById('ka-types') as HTMLInputElement).value) || 1;
      const decorated = parseFloat((document.getElementById('ka-decorated') as HTMLInputElement).value) || 0;
      const weight = parseFloat((document.getElementById('ka-weight') as HTMLInputElement).value) || 0;
      const mnv = Math.max(rims, base);
      const svr = mnv > 0 ? total / mnv : 0;
      const avgWt = total > 0 ? weight / total : 0;
      const rimPct = total > 0 ? (rims / total) * 100 : 0;
      const decPct = total > 0 ? (decorated / total) * 100 : 0;
      const brokenness = mnv > 0 ? total / mnv : 0;
      const diversity = total > 1 ? types / Math.log(total) : 0;
      document.getElementById('ka-mnv')!.textContent = mnv.toString();
      document.getElementById('ka-svr')!.textContent = svr.toFixed(1) + ' Scherben/Gefaess';
      document.getElementById('ka-avgwt')!.textContent = avgWt.toFixed(1) + ' g';
      document.getElementById('ka-rimpct')!.textContent = rimPct.toFixed(1) + '%';
      document.getElementById('ka-decpct')!.textContent = decPct.toFixed(1) + '%';
      document.getElementById('ka-broken')!.textContent = brokenness.toFixed(1);
      document.getElementById('ka-diversity')!.textContent = diversity.toFixed(3);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ka-in').forEach(el => { el.addEventListener('input', calcKA); el.addEventListener('change', calcKA); });
      calcKA();
    }, 50);
  </script>
</CalculatorLayout>
