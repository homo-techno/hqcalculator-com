---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hex-Rechner - Hexadezimal-Konverter &amp; Arithmetik";
const description = "Konvertieren Sie zwischen Hexadezimal, Dezimal, Bin&auml;r und Oktal. F&uuml;hren Sie Hex-Rechenoperationen durch und erkunden Sie Hex-Farbcodes.";

const relatedCalcs = [
  { name: "Bin&auml;rrechner", url: "/de/binaerrechner", description: "Bin&auml;re Mathematik." },
  { name: "Subnetz-Rechner", url: "/de/subnetz-rechner", description: "IP-Subnetze." },
  { name: "R&ouml;mische Zahlen", url: "/de/roemische-zahlen-konverter", description: "R&ouml;mische Ziffern." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Wissenschaftlich." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Hex-Rechner"
  keywords="hex rechner, hexadezimal konverter, hex in dezimal, dezimal in hex, hex arithmetik, hex farbe, zahlensysteme"
  breadcrumbs={[{ name: "Hex-Rechner", url: "/de/hex-rechner" }]}
  lang="de"
  enSlug="hex-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hex-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Konvertieren Sie zwischen Zahlensystemen und f&uuml;hren Sie Hexadezimal-Berechnungen durch.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <!-- Konverter -->
      <h3 class="font-semibold text-text mb-3">Zahlensystem-Konverter</h3>
      <div class="space-y-3 mb-6">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hexadezimal (Basis 16)</label>
          <input type="text" id="hxde-hex" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-mono uppercase" value="FF">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Dezimal (Basis 10)</label>
          <input type="text" id="hxde-dec" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" value="255">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Bin&auml;r (Basis 2)</label>
          <input type="text" id="hxde-bin" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" value="11111111">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Oktal (Basis 8)</label>
          <input type="text" id="hxde-oct" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" value="377">
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mb-6">
        <button class="hxde-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold font-mono" data-val="FF">FF</button>
        <button class="hxde-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold font-mono" data-val="100">100</button>
        <button class="hxde-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold font-mono" data-val="FFFF">FFFF</button>
        <button class="hxde-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold font-mono" data-val="FFFFFF">FFFFFF</button>
        <button class="hxde-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold font-mono" data-val="7F">7F</button>
        <button class="hxde-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold font-mono" data-val="A5">A5</button>
      </div>

      <!-- Hex-Arithmetik -->
      <h3 class="font-semibold text-text mb-3">Hex-Arithmetik</h3>
      <div class="flex items-center gap-2 mb-4">
        <input type="text" id="hxde-a" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-mono uppercase" value="1A" placeholder="Hex A">
        <select id="hxde-op" class="px-3 py-3 border border-border rounded-xl text-lg font-bold">
          <option value="+">+</option>
          <option value="-">&minus;</option>
          <option value="*">&times;</option>
          <option value="/">/</option>
          <option value="&">&amp;</option>
          <option value="|">|</option>
          <option value="^">XOR</option>
        </select>
        <input type="text" id="hxde-b" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg font-mono uppercase" value="0F" placeholder="Hex B">
      </div>

      <div class="p-4 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ergebnis (Hex)</div>
        <div class="text-3xl font-extrabold font-mono" id="hxde-result">0</div>
        <div class="text-sm text-blue-200 mt-1 font-mono" id="hxde-result-dec">(= 0 dezimal)</div>
      </div>

      <!-- Farbvorschau -->
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-2">Farbvorschau</h3>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2 flex-1">
            <span class="text-text-muted font-mono text-sm">#</span>
            <input type="text" id="hxde-color" class="flex-1 px-3 py-2 border border-border rounded-lg font-mono uppercase" value="FF6B35" maxlength="6" placeholder="RRGGBB">
          </div>
          <div id="hxde-color-preview" class="w-16 h-16 rounded-xl border border-border" style="background-color: #FF6B35;"></div>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-3 text-center text-xs">
          <div class="p-2 bg-white rounded-lg"><span class="text-text-muted">R:</span> <span id="hxde-r" class="font-bold font-mono">255</span></div>
          <div class="p-2 bg-white rounded-lg"><span class="text-text-muted">G:</span> <span id="hxde-g" class="font-bold font-mono">107</span></div>
          <div class="p-2 bg-white rounded-lg"><span class="text-text-muted">B:</span> <span id="hxde-b-val" class="font-bold font-mono">53</span></div>
        </div>
      </div>

      <ShareButton calculatorId="hex-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie funktioniert das Hexadezimalsystem?</h2>
      <p>Hexadezimal (Hex) ist ein Stellenwertsystem mit der Basis 16. Es verwendet die Ziffern 0&ndash;9 und die Buchstaben A&ndash;F (A=10, B=11, C=12, D=13, E=14, F=15). Jede Hex-Stelle repr&auml;sentiert genau 4 Bin&auml;rbits &ndash; ein Byte (8 Bit) wird durch zwei Hex-Stellen dargestellt.</p>

      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-center">
        FF&#x2081;&#x2086; = 15&times;16 + 15&times;1 = 255&#x2081;&#x2080; = 11111111&#x2082;
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Hex-Ziffern-Referenz</h3>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead><tr><th class="text-left px-2 py-1">Hex</th><th class="text-left px-2 py-1">Dez</th><th class="text-left px-2 py-1">Bin&auml;r</th><th class="text-left px-2 py-1">Hex</th><th class="text-left px-2 py-1">Dez</th><th class="text-left px-2 py-1">Bin&auml;r</th></tr></thead>
          <tbody>
            <tr><td class="px-2 py-1 font-mono">0</td><td class="px-2 py-1">0</td><td class="px-2 py-1 font-mono">0000</td><td class="px-2 py-1 font-mono">8</td><td class="px-2 py-1">8</td><td class="px-2 py-1 font-mono">1000</td></tr>
            <tr><td class="px-2 py-1 font-mono">1</td><td class="px-2 py-1">1</td><td class="px-2 py-1 font-mono">0001</td><td class="px-2 py-1 font-mono">9</td><td class="px-2 py-1">9</td><td class="px-2 py-1 font-mono">1001</td></tr>
            <tr><td class="px-2 py-1 font-mono">2</td><td class="px-2 py-1">2</td><td class="px-2 py-1 font-mono">0010</td><td class="px-2 py-1 font-mono">A</td><td class="px-2 py-1">10</td><td class="px-2 py-1 font-mono">1010</td></tr>
            <tr><td class="px-2 py-1 font-mono">3</td><td class="px-2 py-1">3</td><td class="px-2 py-1 font-mono">0011</td><td class="px-2 py-1 font-mono">B</td><td class="px-2 py-1">11</td><td class="px-2 py-1 font-mono">1011</td></tr>
            <tr><td class="px-2 py-1 font-mono">4</td><td class="px-2 py-1">4</td><td class="px-2 py-1 font-mono">0100</td><td class="px-2 py-1 font-mono">C</td><td class="px-2 py-1">12</td><td class="px-2 py-1 font-mono">1100</td></tr>
            <tr><td class="px-2 py-1 font-mono">5</td><td class="px-2 py-1">5</td><td class="px-2 py-1 font-mono">0101</td><td class="px-2 py-1 font-mono">D</td><td class="px-2 py-1">13</td><td class="px-2 py-1 font-mono">1101</td></tr>
            <tr><td class="px-2 py-1 font-mono">6</td><td class="px-2 py-1">6</td><td class="px-2 py-1 font-mono">0110</td><td class="px-2 py-1 font-mono">E</td><td class="px-2 py-1">14</td><td class="px-2 py-1 font-mono">1110</td></tr>
            <tr><td class="px-2 py-1 font-mono">7</td><td class="px-2 py-1">7</td><td class="px-2 py-1 font-mono">0111</td><td class="px-2 py-1 font-mono">F</td><td class="px-2 py-1">15</td><td class="px-2 py-1 font-mono">1111</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum wird Hex in der Programmierung verwendet?</strong> Hexadezimal stellt Bin&auml;rdaten kompakt dar &ndash; jede Hex-Stelle entspricht genau 4 Bits. Ein Byte (8 Bit) sind zwei Hex-Stellen. Daher sind Speicheradressen, Farben und Bin&auml;rdaten im Hex-Format leicht lesbar.</p>
      <p><strong>Wie funktionieren Hex-Farben?</strong> HTML/CSS-Farben verwenden das Format #RRGGBB, wobei jedes Paar einen Hex-Wert von 00&ndash;FF (0&ndash;255 dezimal) f&uuml;r Rot-, Gr&uuml;n- und Blauanteil darstellt. #FF0000 ist reines Rot, #00FF00 reines Gr&uuml;n, #0000FF reines Blau.</p>
      <p><strong>Wie rechnet man Hex in Dezimal um?</strong> Multiplizieren Sie jede Stelle von rechts mit der entsprechenden Potenz von 16. Beispiel: 2A&#x2081;&#x2086; = 2&times;16&sup1; + 10&times;16&sup0; = 32 + 10 = 42&#x2081;&#x2080;.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let hxdeUpdatingFrom = '';

    function hxdeUpdateFromDec(dec: number) {
      if (isNaN(dec) || dec < 0) return;
      const n = Math.floor(dec);
      if (hxdeUpdatingFrom !== 'hex') (document.getElementById('hxde-hex') as HTMLInputElement).value = n.toString(16).toUpperCase();
      if (hxdeUpdatingFrom !== 'dec') (document.getElementById('hxde-dec') as HTMLInputElement).value = String(n);
      if (hxdeUpdatingFrom !== 'bin') (document.getElementById('hxde-bin') as HTMLInputElement).value = n.toString(2);
      if (hxdeUpdatingFrom !== 'oct') (document.getElementById('hxde-oct') as HTMLInputElement).value = n.toString(8);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function hxdeCalcArith() {
      const aStr = (document.getElementById('hxde-a') as HTMLInputElement).value.trim();
      const bStr = (document.getElementById('hxde-b') as HTMLInputElement).value.trim();
      const op = (document.getElementById('hxde-op') as HTMLSelectElement).value;

      const a = parseInt(aStr, 16);
      const b = parseInt(bStr, 16);
      if (isNaN(a) || isNaN(b)) return;

      let result: number;
      switch (op) {
        case '+': result = a + b; break;
        case '-': result = Math.max(0, a - b); break;
        case '*': result = a * b; break;
        case '/': result = b !== 0 ? Math.floor(a / b) : 0; break;
        case '&': result = a & b; break;
        case '|': result = a | b; break;
        case '^': result = a ^ b; break;
        default: result = 0;
      }

      document.getElementById('hxde-result')!.textContent = result.toString(16).toUpperCase();
      document.getElementById('hxde-result-dec')!.textContent = '(= ' + result.toLocaleString('de-DE') + ' dezimal)';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function hxdeUpdateColor() {
      const hex = (document.getElementById('hxde-color') as HTMLInputElement).value.trim();
      if (!/^[0-9A-Fa-f]{6}$/.test(hex)) return;
      document.getElementById('hxde-color-preview')!.style.backgroundColor = '#' + hex;
      document.getElementById('hxde-r')!.textContent = String(parseInt(hex.slice(0, 2), 16));
      document.getElementById('hxde-g')!.textContent = String(parseInt(hex.slice(2, 4), 16));
      document.getElementById('hxde-b-val')!.textContent = String(parseInt(hex.slice(4, 6), 16));
    }

    setTimeout(() => {
      document.getElementById('hxde-hex')!.addEventListener('input', () => {
        hxdeUpdatingFrom = 'hex';
        hxdeUpdateFromDec(parseInt((document.getElementById('hxde-hex') as HTMLInputElement).value, 16) || 0);
        hxdeUpdatingFrom = '';
      });
      document.getElementById('hxde-dec')!.addEventListener('input', () => {
        hxdeUpdatingFrom = 'dec';
        hxdeUpdateFromDec(parseInt((document.getElementById('hxde-dec') as HTMLInputElement).value) || 0);
        hxdeUpdatingFrom = '';
      });
      document.getElementById('hxde-bin')!.addEventListener('input', () => {
        hxdeUpdatingFrom = 'bin';
        hxdeUpdateFromDec(parseInt((document.getElementById('hxde-bin') as HTMLInputElement).value, 2) || 0);
        hxdeUpdatingFrom = '';
      });
      document.getElementById('hxde-oct')!.addEventListener('input', () => {
        hxdeUpdatingFrom = 'oct';
        hxdeUpdateFromDec(parseInt((document.getElementById('hxde-oct') as HTMLInputElement).value, 8) || 0);
        hxdeUpdatingFrom = '';
      });

      document.querySelectorAll('.hxde-quick').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = (btn as HTMLElement).dataset.val || 'FF';
          (document.getElementById('hxde-hex') as HTMLInputElement).value = val;
          hxdeUpdatingFrom = 'hex';
          hxdeUpdateFromDec(parseInt(val, 16));
          hxdeUpdatingFrom = '';
        });
      });

      document.getElementById('hxde-a')!.addEventListener('input', hxdeCalcArith);
      document.getElementById('hxde-b')!.addEventListener('input', hxdeCalcArith);
      document.getElementById('hxde-op')!.addEventListener('change', hxdeCalcArith);
      document.getElementById('hxde-color')!.addEventListener('input', hxdeUpdateColor);

      hxdeCalcArith();
      hxdeUpdateColor();
    }, 50);
  </script>
</CalculatorLayout>
