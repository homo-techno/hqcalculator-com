---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Barkeeperrechner - Getränke, Eis & Zubehör für den Barservice";
const description = "Berechnen Sie Getränkemengen, Eis, Gläser, Mixgetränke und Garnituren für den Barservice basierend auf Gästezahl und Veranstaltungsdauer.";
const relatedCalcs = [
  { name: "Catering-Mengenrechner", url: "/de/catering-mengen-rechner", description: "Portionen pro Gast." },
  { name: "Eventbudget-Rechner", url: "/de/eventbudget-rechner", description: "Gesamte Eventkosten." },
  { name: "Event-Personalrechner", url: "/de/event-personal-rechner", description: "Personal für Veranstaltungen." },
  { name: "Partybedarf-Rechner", url: "/de/partybedarf-rechner", description: "Teller, Gläser, Servietten." },
  { name: "Tortenportionen-Rechner", url: "/de/tortenportionen-rechner", description: "Tortengröße nach Gästen." },
  { name: "Eventparkplatz-Rechner", url: "/de/eventparkplatz-rechner", description: "Parkplatzplanung." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Barkeeperrechner"
  keywords="Barkeeper Rechner, Getränkerechner, Barservice, Event Getränke, Party Bar Planung, Eis Rechner"
  breadcrumbs={[{ name: "Barkeeper", url: "/de/barkeeper-rechner" }]}
  lang="de"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Barkeeperrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihren Barservice mit genauen Mengen für Getränke, Eis, Gläser und Mixer.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl Gäste</label>
          <input type="number" id="bar-guests" class="bar-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Barservice-Dauer (Stunden)</label>
          <input type="number" id="bar-hours" class="bar-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="10" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Bartyp</label>
          <select id="bar-type" class="bar-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="full">Vollbar (Bier, Wein, Spirituosen)</option>
            <option value="beerWine">Nur Bier & Wein</option>
            <option value="limited">Eingeschränkte Bar (Signature-Cocktails + Bier/Wein)</option>
            <option value="nonalc">Nur alkoholfrei</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Trinkniveau</label>
          <select id="bar-level" class="bar-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="light">Leicht (1 Getränk/Std.)</option>
            <option value="moderate" selected>Moderat (1,5 Getränke/Std.)</option>
            <option value="heavy">Stark (2 Getränke/Std.)</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Getränke gesamt</div>
        <div class="text-5xl font-extrabold" id="bar-total">--</div>
        <div class="text-sm mt-1" id="bar-perguest">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">kg Eis</div>
          <div class="text-xl font-bold" id="bar-ice">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gläser / Becher</div>
          <div class="text-xl font-bold" id="bar-cups">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Benötigte Barkeeper</div>
          <div class="text-xl font-bold" id="bar-bartenders">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Servietten</div>
          <div class="text-xl font-bold" id="bar-napkins">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="bar-details"></div>

      <ShareButton calculatorId="bartender" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Barservice-Planungsratgeber</h2>
      <p>Die Standardregel ist 2 Getränke pro Person in der ersten Stunde und 1 Getränk pro Stunde danach. Planen Sie 0,5 kg Eis pro Gast für Getränke plus 0,25 kg pro Gast zum Kühlen von Flaschen. Ein Barkeeper kann 50-75 Gäste bedienen.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Flaschen-Schätzungen</h3>
      <ul>
        <li><strong>Wein:</strong> 5 Gläser pro 750ml-Flasche</li>
        <li><strong>Bier:</strong> 1 pro Portion (0,33l oder 0,5l)</li>
        <li><strong>Spirituosen:</strong> 16-20 Cocktails pro 750ml-Flasche</li>
        <li><strong>Mixer:</strong> 1 Liter pro 4-5 Cocktails</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBAR() {
      const guests = parseInt((document.getElementById('bar-guests') as HTMLInputElement).value) || 1;
      const hours = parseFloat((document.getElementById('bar-hours') as HTMLInputElement).value) || 4;
      const barType = (document.getElementById('bar-type') as HTMLSelectElement).value;
      const level = (document.getElementById('bar-level') as HTMLSelectElement).value;

      let drinksPerHr = 1.5;
      if (level === 'light') drinksPerHr = 1;
      else if (level === 'heavy') drinksPerHr = 2;

      const totalDrinksPerGuest = 2 + Math.max(0, hours - 1) * drinksPerHr;
      const totalDrinks = Math.ceil(totalDrinksPerGuest * guests);

      const iceKg = Math.ceil(guests * 0.7);
      const cups = Math.ceil(totalDrinks * 1.2);
      const bartenders = Math.max(1, Math.ceil(guests / 60));
      const napkins = Math.ceil(totalDrinks * 1.5);

      document.getElementById('bar-total')!.textContent = totalDrinks.toLocaleString('de-DE');
      document.getElementById('bar-perguest')!.textContent = totalDrinksPerGuest.toFixed(1).replace('.', ',') + ' Getränke pro Gast';
      document.getElementById('bar-ice')!.textContent = iceKg.toLocaleString('de-DE');
      document.getElementById('bar-cups')!.textContent = cups.toLocaleString('de-DE');
      document.getElementById('bar-bartenders')!.textContent = bartenders.toString();
      document.getElementById('bar-napkins')!.textContent = napkins.toLocaleString('de-DE');

      let details = '<h3 class="font-semibold text-sm text-text mb-2">Bedarfsaufschlüsselung</h3><ul class="text-sm text-text-secondary space-y-1">';

      if (barType === 'full' || barType === 'limited') {
        const liquorDrinks = Math.ceil(totalDrinks * 0.35);
        const wineDrinks = Math.ceil(totalDrinks * 0.30);
        const beerDrinks = Math.ceil(totalDrinks * 0.25);
        const nonAlcDrinks = totalDrinks - liquorDrinks - wineDrinks - beerDrinks;

        const liquorBottles = Math.ceil(liquorDrinks / 17);
        const wineBottles = Math.ceil(wineDrinks / 5);
        const beerUnits = beerDrinks;
        const mixerLiters = Math.ceil(liquorDrinks / 4);

        details += '<li>Spirituosen: ' + liquorBottles + ' Flaschen (750ml) - ' + liquorDrinks + ' Cocktails</li>';
        details += '<li>Wein: ' + wineBottles + ' Flaschen - ' + wineDrinks + ' Gl\u00E4ser</li>';
        details += '<li>Bier: ' + beerUnits + ' Flaschen/Dosen</li>';
        details += '<li>Mixer: ' + mixerLiters + ' Liter (Soda, Tonic, Saft)</li>';
        details += '<li>Alkoholfrei: ' + nonAlcDrinks + ' Getränke (Wasser, Soda, Mocktails)</li>';
      } else if (barType === 'beerWine') {
        const wineDrinks = Math.ceil(totalDrinks * 0.50);
        const beerDrinks = Math.ceil(totalDrinks * 0.35);
        const nonAlcDrinks = totalDrinks - wineDrinks - beerDrinks;
        details += '<li>Wein: ' + Math.ceil(wineDrinks / 5) + ' Flaschen - ' + wineDrinks + ' Gl\u00E4ser</li>';
        details += '<li>Bier: ' + beerDrinks + ' Flaschen/Dosen</li>';
        details += '<li>Alkoholfrei: ' + nonAlcDrinks + ' Getränke</li>';
      } else {
        details += '<li>Alkoholfreie Getränke: ' + totalDrinks + ' Portionen</li>';
        details += '<li>Vorschlag: Sprudelwasser, Säfte, Mocktails, Limonade, Eistee</li>';
      }

      details += '<li>Garnituren: ' + Math.ceil(totalDrinks * 0.3) + ' (Zitronen, Limetten, Oliven)</li>';
      details += '<li>Rührstäbchen/Strohhalme: ' + totalDrinks + '</li>';
      details += '</ul>';
      document.getElementById('bar-details')!.innerHTML = details;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bar-in').forEach(el => { el.addEventListener('input', calcBAR); el.addEventListener('change', calcBAR); });
      calcBAR();
    }, 50);
  </script>
</CalculatorLayout>
