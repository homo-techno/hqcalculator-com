---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Klimazone-Rechner - Köppen-Klimaklassifikation";
const description = "Bestimmen Sie die Köppen-Klimaklassifikation anhand von Temperatur- und Niederschlagsdaten mit Zonenbeschreibungen und Vegetationstypen.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Bruchrechnung." },
  { name: "Standardabweichung", url: "/de/standardabweichung-rechner", description: "Streuung berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Klimazone-Rechner" enSlug="climate-zone-calculator" keywords="Klimazone, Köppen-Klassifikation, Klimatyp, Vegetationszone, tropisch, arid, gemäßigt" breadcrumbs={[{ name: "Klimazone-Rechner", url: "/de/klimazone-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Klimazone-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie Ihre Köppen-Klimaklassifikation anhand durchschnittlicher Temperatur- und Niederschlagsdaten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wärmster Monat Ø (°C)</label><input type="number" id="kz-hot" class="kz-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="25" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kältester Monat Ø (°C)</label><input type="number" id="kz-cold" class="kz-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="2" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Jahresniederschlag (mm)</label><input type="number" id="kz-precip" class="kz-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="800" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Trockenster Monat (mm)</label><input type="number" id="kz-driest" class="kz-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="40" min="0" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Jahresmitteltemp. (°C)</label><input type="number" id="kz-mean" class="kz-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="12" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Trockenzeit</label>
            <select id="kz-dryseason" class="kz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="none">Keine ausgeprägte Trockenzeit</option>
              <option value="summer">Sommer (trockene Sommer)</option>
              <option value="winter">Winter (trockene Winter)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Köppen-Klassifikation</div>
          <div class="text-4xl font-extrabold font-mono" id="kz-result">--</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="kz-zone-box">
          <div class="font-bold text-sm" id="kz-zone">--</div>
          <div class="text-xs mt-1" id="kz-desc">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hauptgruppe</div><div class="text-xl font-bold font-mono" id="kz-group">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vegetation</div><div class="text-sm font-bold" id="kz-veg">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Temp.-Spanne</div><div class="text-xl font-bold font-mono" id="kz-range">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="klimazone" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Köppen-Klimaklassifikation</h2>
      <p>Die Köppen-Klimaklassifikation unterteilt die Erde in fünf Hauptklimazonen: Tropisch (A), Arid (B), Gemäßigt (C), Kontinental (D) und Polar (E). Deutschland liegt überwiegend in der Zone Cfb (ozeanisch gemäßigt).</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Klimazone hat Deutschland?</strong> Deutschland liegt überwiegend in der gemäßigten Zone (Cfb - Ozeanisches Klima) mit milden Sommern und kühlen Wintern.</p>
      <p><strong>Was bedeuten die Buchstaben?</strong> Der erste Buchstabe gibt die Hauptgruppe an, der zweite den Niederschlagstyp und der dritte die Temperaturstufe.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKZ() {
      const hotC = parseFloat((document.getElementById('kz-hot') as HTMLInputElement).value) || 25;
      const coldC = parseFloat((document.getElementById('kz-cold') as HTMLInputElement).value) || 2;
      const precipMm = parseFloat((document.getElementById('kz-precip') as HTMLInputElement).value) || 800;
      const driestMm = parseFloat((document.getElementById('kz-driest') as HTMLInputElement).value) || 40;
      const meanC = parseFloat((document.getElementById('kz-mean') as HTMLInputElement).value) || 12;
      const drySeason = (document.getElementById('kz-dryseason') as HTMLSelectElement).value;
      const tempRange = hotC - coldC;
      const threshold = meanC * 20 + (drySeason === 'summer' ? 280 : drySeason === 'winter' ? 0 : 140);
      let code: string, zone: string, desc: string, group: string, veg: string, color: string;
      if (coldC >= 18) {
        group = 'A - Tropisch';
        if (driestMm >= 60) { code = 'Af'; zone = 'Tropischer Regenwald'; desc = 'Ganzjährig heiß und feucht'; veg = 'Regenwald'; }
        else if (precipMm >= 25 * (100 - driestMm)) { code = 'Am'; zone = 'Tropischer Monsun'; desc = 'Starker saisonaler Niederschlag mit kurzer Trockenzeit'; veg = 'Monsunwald'; }
        else { code = 'Aw'; zone = 'Tropische Savanne'; desc = 'Ausgeprägte Regen- und Trockenzeiten'; veg = 'Savannengrasland'; }
        color = 'bg-green-50 text-green-800';
      }
      else if (precipMm < threshold) {
        group = 'B - Arid';
        if (precipMm < threshold / 2) {
          code = meanC >= 18 ? 'BWh' : 'BWk';
          zone = meanC >= 18 ? 'Heiße Wüste' : 'Kalte Wüste';
          desc = 'Extrem wenig Niederschlag, spärliche Vegetation';
          veg = 'Wüstenvegetation';
        } else {
          code = meanC >= 18 ? 'BSh' : 'BSk';
          zone = meanC >= 18 ? 'Heiße Halbwüste' : 'Kalte Steppe';
          desc = 'Wenig Niederschlag, Grasland und Steppe';
          veg = 'Steppengras';
        }
        color = 'bg-yellow-50 text-yellow-800';
      }
      else if (coldC >= -3 && coldC < 18 && hotC >= 10) {
        group = 'C - Gemäßigt';
        if (drySeason === 'summer' && driestMm < 30) {
          code = hotC >= 22 ? 'Csa' : 'Csb';
          zone = hotC >= 22 ? 'Heißsommer-Mittelmeerklima' : 'Warmsommer-Mittelmeerklima';
          desc = 'Trockene Sommer, milde feuchte Winter';
          veg = 'Mediterrane Macchia';
        } else if (drySeason === 'winter' && driestMm < precipMm / 10) {
          code = hotC >= 22 ? 'Cwa' : 'Cwb';
          zone = hotC >= 22 ? 'Feuchtes Subtropenklima (trockener Winter)' : 'Subtropisches Hochland';
          desc = 'Warme/heiße Sommer, milde trockene Winter';
          veg = 'Subtropischer Wald';
        } else {
          code = hotC >= 22 ? 'Cfa' : 'Cfb';
          zone = hotC >= 22 ? 'Feucht-subtropisch' : 'Ozeanisch';
          desc = hotC >= 22 ? 'Heiße feuchte Sommer, milde Winter' : 'Ganzjährig mild, keine Hitzeextreme';
          veg = hotC >= 22 ? 'Laub-/Mischwald' : 'Gemäßigter Wald';
        }
        color = 'bg-blue-50 text-blue-800';
      }
      else if (coldC < -3 && hotC >= 10) {
        group = 'D - Kontinental';
        if (drySeason === 'summer' && driestMm < 30) {
          code = hotC >= 22 ? 'Dsa' : 'Dsb';
          zone = 'Kontinental (trockener Sommer)';
          desc = 'Kalte Winter, warme Sommer, trockene Sommer';
          veg = 'Mischwald/Steppe';
        } else if (drySeason === 'winter' && driestMm < precipMm / 10) {
          code = hotC >= 22 ? 'Dwa' : 'Dwb';
          zone = 'Kontinental (trockener Winter)';
          desc = 'Kalte trockene Winter, warme feuchte Sommer';
          veg = 'Boreal-/Mischwald';
        } else {
          if (hotC >= 22) { code = 'Dfa'; zone = 'Heißsommer-Kontinental'; desc = 'Kalte Winter, heiße feuchte Sommer'; veg = 'Laubwald'; }
          else if (coldC >= -38) { code = 'Dfb'; zone = 'Warmsommer-Kontinental'; desc = 'Kalte Winter, warme Sommer, ganzjährig Niederschlag'; veg = 'Misch-/Borealwald'; }
          else { code = 'Dfc'; zone = 'Subarktisch'; desc = 'Sehr kalte Winter, kühle kurze Sommer'; veg = 'Boreal/Taiga'; }
        }
        color = 'bg-purple-50 text-purple-800';
      }
      else {
        group = 'E - Polar';
        if (hotC >= 0) { code = 'ET'; zone = 'Tundra'; desc = 'Wärmster Monat über dem Gefrierpunkt aber unter 10°C'; veg = 'Tundramoos/Flechten'; }
        else { code = 'EF'; zone = 'Eiskappe'; desc = 'Alle Monate unter dem Gefrierpunkt'; veg = 'Keine (Eis/Schnee)'; }
        color = 'bg-gray-100 text-gray-800';
      }
      document.getElementById('kz-result')!.textContent = code;
      document.getElementById('kz-zone')!.textContent = zone;
      document.getElementById('kz-desc')!.textContent = desc;
      document.getElementById('kz-zone-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.getElementById('kz-group')!.textContent = group;
      document.getElementById('kz-veg')!.textContent = veg;
      document.getElementById('kz-range')!.textContent = tempRange.toFixed(0) + '°C';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.kz-in').forEach(el => { el.addEventListener('input', calcKZ); el.addEventListener('change', calcKZ); }); calcKZ(); }, 50);
  </script>
</CalculatorLayout>
