---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Meeting-Kostenrechner - Wahre Kosten von Meetings berechnen";
const description = "Berechnen Sie die wahren Kosten von Meetings basierend auf Teilnehmerzahl, Dauer und Stundenlöhnen. Visualisieren Sie den ROI von Besprechungen im Unternehmen.";
const relatedCalcs = [
  { name: "Aufschlagsrechner", url: "/de/aufschlag-rechner", description: "Preisaufschläge berechnen." },
  { name: "Mehrwertsteuer Rechner", url: "/de/mehrwertsteuer-rechner", description: "MwSt berechnen." },
  { name: "Gewinnrechner", url: "/de/gewinnrechner", description: "Gewinn ermitteln." },
  { name: "Stundenlohn Rechner", url: "/de/stundenlohn-rechner", description: "Stundenlohn berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="meeting-cost-calculator" calculatorName="Meeting-Kostenrechner" keywords="Meeting Kosten Rechner, Besprechungskosten, Konferenzkosten, Meetingeffizienz, Personalkosten Meeting" breadcrumbs={[{ name: "Meeting-Kostenrechner", url: "/de/meeting-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Meeting-Kostenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die tatsächlichen Kosten einer Besprechung – inkl. Lohnkosten, Raummiete und Opportunitätskosten für besseres Meetingmanagement.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Teilnehmer</label><input type="number" id="mk2-count" class="mk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="200"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Meetingdauer (Min.)</label><input type="number" id="mk2-dur" class="mk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="5" max="480" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Durchschn. Jahresgehalt (€)</label><input type="number" id="mk2-salary" class="mk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60000" min="10000" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Arbeitgeberfaktor (%)</label><input type="number" id="mk2-factor" class="mk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="100" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Raumkosten (€/Std.)</label><input type="number" id="mk2-room" class="mk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Meetings pro Woche</label><input type="number" id="mk2-freq" class="mk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="50"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kosten pro Meeting</div>
          <div class="text-5xl font-extrabold font-mono" id="mk2-total">--</div>
          <div class="text-sm text-blue-200 mt-1" id="mk2-per-min">-- pro Minute</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lohnkosten</div><div class="text-xl font-bold" id="mk2-wage">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumkosten</div><div class="text-xl font-bold" id="mk2-roomcost">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Woche</div><div class="text-xl font-bold" id="mk2-weekly">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Jahr</div><div class="text-xl font-bold" id="mk2-yearly">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="meeting-kosten" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die versteckten Kosten von Meetings</h2>
      <p>Meetings sind ein notwendiger Teil der Unternehmenskommunikation, verursachen aber erhebliche Kosten. Ein einstündiges Meeting mit 6 Mitarbeitern, die je 60.000 € brutto verdienen, kostet das Unternehmen unter Berücksichtigung der Lohnnebenkosten (ca. 30 %) rund 230–280 Euro. Bei 3 Meetings pro Woche summiert sich das auf über 35.000 Euro pro Jahr – nur für dieses eine Meeting-Format. Studien zeigen, dass bis zu 30 % der Meeting-Zeit als verschwendet wahrgenommen wird.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie teuer sind ineffiziente Meetings für Unternehmen?</strong> Ineffiziente Meetings kosten deutsche Unternehmen Schätzungen zufolge mehrere hundert Milliarden Euro pro Jahr an Produktivitätsverlust.</p>
      <p><strong>Wie kann ich Meeting-Kosten reduzieren?</strong> Halten Sie Meetings kürzer und gezielter, laden Sie nur notwendige Teilnehmer ein, legen Sie klare Agenden fest und nutzen Sie asynchrone Kommunikation wo möglich.</p>
      <p><strong>Was ist der Arbeitgeberfaktor?</strong> Der Arbeitgeberfaktor (Lohnnebenkosten) umfasst Sozialversicherungsbeiträge, Urlaubs- und Krankheitsgeld. Er beträgt in Deutschland typischerweise 20–35 % des Bruttogehalts.</p>
      <p><strong>Wie berechne ich den Stundensatz eines Mitarbeiters?</strong> Jahresgehalt ÷ 1.700 (effektive Arbeitsstunden) × Arbeitgeberfaktor = tatsächliche Stundenkosten.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMK2() {
      const count = parseInt((document.getElementById('mk2-count') as HTMLInputElement).value) || 1;
      const dur = parseFloat((document.getElementById('mk2-dur') as HTMLInputElement).value) || 60;
      const salary = parseFloat((document.getElementById('mk2-salary') as HTMLInputElement).value) || 0;
      const factor = parseFloat((document.getElementById('mk2-factor') as HTMLInputElement).value) / 100 || 0.3;
      const room = parseFloat((document.getElementById('mk2-room') as HTMLInputElement).value) || 0;
      const freq = parseInt((document.getElementById('mk2-freq') as HTMLInputElement).value) || 1;
      const hourlyRate = (salary * (1 + factor)) / 1700;
      const durationH = dur / 60;
      const wageCost = hourlyRate * count * durationH;
      const roomCost = room * durationH;
      const total = wageCost + roomCost;
      const perMin = total / dur;
      const weekly = total * freq;
      const yearly = weekly * 48;
      const fmt = (v: number) => v.toLocaleString('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
      const fmt2 = (v: number) => v.toLocaleString('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });
      document.getElementById('mk2-total')!.textContent = fmt(total);
      document.getElementById('mk2-per-min')!.textContent = fmt2(perMin) + ' pro Minute';
      document.getElementById('mk2-wage')!.textContent = fmt(wageCost);
      document.getElementById('mk2-roomcost')!.textContent = fmt(roomCost);
      document.getElementById('mk2-weekly')!.textContent = fmt(weekly);
      document.getElementById('mk2-yearly')!.textContent = fmt(yearly);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mk2-in').forEach(el => { el.addEventListener('input', calcMK2); el.addEventListener('change', calcMK2); });
      calcMK2();
    }, 50);
  </script>
</CalculatorLayout>
