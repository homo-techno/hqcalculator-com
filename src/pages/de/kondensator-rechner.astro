---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kondensator-Rechner - Reihen- & Parallelschaltung";
const description = "Berechnen Sie die Gesamtkapazit\u00e4t f\u00fcr Kondensatoren in Reihen- und Parallelschaltung, plus Energie und Ladung.";
const relatedCalcs = [
  { name: "Kamerasensor-Rechner", url: "/de/kamerasensor-rechner", description: "Sensoren." },
  { name: "Schleusen-Rechner", url: "/de/schleusen-rechner", description: "Schleusen." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorien." },
  { name: "Kerzen-Brenndauer", url: "/de/kerzen-brenndauer-rechner", description: "Kerzen." },
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kondensator-Rechner" lang="de" enSlug="capacitor-calculator" keywords="kondensator rechner, reihenschaltung parallelschaltung, kapazit\u00e4t, gespeicherte energie, RC-Zeitkonstante" breadcrumbs={[{ name: "Kondensator-Rechner", url: "/de/kondensator-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kondensator-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kapazit&auml;t, Energie und Ladung f&uuml;r Kondensatorschaltungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="ko-m1" class="ko-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="single">Einzeln</button>
          <button id="ko-m2" class="ko-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="series">Reihe</button>
          <button id="ko-m3" class="ko-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="parallel">Parallel</button>
        </div>
        <div id="ko-single">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Kapazit&auml;t (&micro;F)</label><input type="number" id="ko-c" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" step="1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Spannung (V)</label><input type="number" id="ko-v" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.1"></div>
          </div>
        </div>
        <div id="ko-multi" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Kondensatorwerte (&micro;F, kommagetrennt)</label>
          <input type="text" id="ko-vals" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100, 220, 47" placeholder="100, 220, 47">
          <div class="mt-2"><label class="block text-xs font-medium text-text mb-1">Spannung (V)</label><input type="number" id="ko-v2" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="ko-label">Kapazit&auml;t</div>
          <div class="text-5xl font-extrabold font-mono" id="ko-result">100 &micro;F</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ladung</div><div class="text-xl font-bold font-mono" id="ko-charge">0 mC</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Energie</div><div class="text-xl font-bold font-mono" id="ko-energy">0 mJ</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reaktanz @50Hz</div><div class="text-xl font-bold font-mono" id="ko-xc">0 &Omega;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="capacitor" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Wie berechnet man die Gesamtkapazit&auml;t?</h3>
      <p><strong>Parallelschaltung:</strong> C_gesamt = C1 + C2 + C3. <strong>Reihenschaltung:</strong> 1/C_gesamt = 1/C1 + 1/C2 + 1/C3. In Europa betr&auml;gt die Netzfrequenz 50 Hz.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let koMode = 'single';
    function setKoMode(m: string) {
      koMode = m;
      document.getElementById('ko-single')!.classList.toggle('hidden', m !== 'single');
      document.getElementById('ko-multi')!.classList.toggle('hidden', m === 'single');
      document.querySelectorAll('.ko-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'ko-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcKO();
    }
    function calcKO() {
      let capUF: number, voltage: number;
      if (koMode === 'single') {
        capUF = parseFloat((document.getElementById('ko-c') as HTMLInputElement).value) || 0;
        voltage = parseFloat((document.getElementById('ko-v') as HTMLInputElement).value) || 0;
      } else {
        const vals = (document.getElementById('ko-vals') as HTMLInputElement).value.split(',').map(s => parseFloat(s.trim())).filter(n => n > 0);
        voltage = parseFloat((document.getElementById('ko-v2') as HTMLInputElement).value) || 0;
        if (vals.length === 0) { capUF = 0; }
        else if (koMode === 'parallel') { capUF = vals.reduce((a,b) => a+b, 0); }
        else { capUF = 1 / vals.reduce((a,b) => a + 1/b, 0); }
      }
      const capF = capUF * 1e-6;
      const charge = capF * voltage;
      const energy = 0.5 * capF * voltage * voltage;
      const xc = capF > 0 ? 1 / (2 * Math.PI * 50 * capF) : 0;
      let capStr: string;
      if (capUF >= 1000) capStr = (capUF/1000).toFixed(2).replace('.', ',') + ' mF';
      else if (capUF >= 1) capStr = capUF.toFixed(2).replace('.', ',') + ' \u00b5F';
      else capStr = (capUF * 1000).toFixed(2).replace('.', ',') + ' nF';
      const modeLabels: Record<string, string> = { single: 'Kapazit\u00e4t', series: 'Gesamt (Reihe)', parallel: 'Gesamt (Parallel)' };
      document.getElementById('ko-label')!.textContent = modeLabels[koMode] || 'Kapazit\u00e4t';
      document.getElementById('ko-result')!.textContent = capStr;
      document.getElementById('ko-charge')!.textContent = charge >= 0.001 ? (charge*1000).toFixed(3).replace('.', ',') + ' mC' : (charge*1e6).toFixed(3).replace('.', ',') + ' \u00b5C';
      document.getElementById('ko-energy')!.textContent = energy >= 0.001 ? (energy*1000).toFixed(3).replace('.', ',') + ' mJ' : (energy*1e6).toFixed(3).replace('.', ',') + ' \u00b5J';
      document.getElementById('ko-xc')!.textContent = xc >= 1000 ? (xc/1000).toFixed(2).replace('.', ',') + ' k\u03a9' : xc.toFixed(2).replace('.', ',') + ' \u03a9';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ko-mode').forEach(b => b.addEventListener('click', () => setKoMode((b as HTMLButtonElement).dataset.mode!)));
      document.querySelectorAll('.ko-in').forEach(el => { el.addEventListener('input', calcKO); el.addEventListener('change', calcKO); });
      calcKO();
    }, 50);
  </script>
</CalculatorLayout>
