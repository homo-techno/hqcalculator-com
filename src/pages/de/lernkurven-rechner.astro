---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lernkurvenrechner";
const description = "Analysieren Sie Lernkurven und prognostizieren Sie Effizienzgewinne.";

const relatedCalcs = [
  { name: "Sprachlernrechner", url: "/de/sprachlern-rechner", description: "Lernzeit berechnen." },
  { name: "Lieferzeitrechner", url: "/de/lieferzeit-rechner", description: "Lieferzeiten planen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibungen berechnen." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Lernkurvenrechner" lang="de" enSlug="learning-curve-calculator" keywords="lernkurvenrechner, lernkurve berechnen, produktivitätssteigerung, erfahrungskurve" breadcrumbs={[{ name: "Lernkurvenrechner", url: "/de/lernkurven-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lernkurvenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie Lernkurven und berechnen Sie, wie sich Produktionszeiten und Kosten mit steigender Erfahrung entwickeln.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Erste Einheit (Stunden)</label><input type="number" id="lkr-t1" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Lernkurvenrate (%)</label><input type="number" id="lkr-rate" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="50" max="99" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ziel-Einheitszahl</label><input type="number" id="lkr-unit" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="2" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stundensatz (€/Std.)</label><input type="number" id="lkr-rate-eur" class="lkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="1" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Zeit für Ziel-Einheit</div>
          <div class="text-4xl font-extrabold font-mono" id="lkr-tn">0 Std.</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einsparung (%)</div><div class="text-xl font-bold" id="lkr-saving">0 %</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten Einheit 1</div><div class="text-xl font-bold" id="lkr-cost1">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten Einheit N</div><div class="text-xl font-bold" id="lkr-costn">0 €</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl overflow-x-auto">
          <h3 class="font-semibold text-sm text-text mb-3">Lernkurven-Tabelle</h3>
          <table class="w-full text-sm"><thead><tr class="text-xs text-text-muted uppercase"><th class="text-left pb-2">Einheit</th><th class="text-right pb-2">Stunden</th><th class="text-right pb-2">Kosten</th><th class="text-right pb-2">Einsparung</th></tr></thead><tbody id="lkr-table"></tbody></table>
        </div>
      </div>
      <ShareButton calculatorId="learning-curve-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Die Lernkurve – Effizienz durch Erfahrung</h2>
      <p>Die Lernkurventheorie besagt, dass die Zeit und Kosten für die Herstellung einer Einheit mit jeder Verdoppelung der Gesamtproduktion um einen festen Prozentsatz sinken. Eine 80-%-Lernkurve bedeutet: Wenn die produzierte Menge sich verdoppelt, sinkt die Zeit pro Einheit auf 80 % des vorherigen Wertes. Diese Erkenntnis ist in der Fertigungsindustrie, dem Projektmanagement und der Personalentwicklung weit verbreitet.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p><strong>Formel:</strong> T(n) = T(1) × n^(log(r) / log(2))</p>
        <p>wobei r = Lernkurvenrate (z. B. 0,80 für 80 %)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was bedeutet eine 80-%-Lernkurve?</strong> Bei einer 80-%-Lernkurve reduziert sich die Zeit pro Einheit jedes Mal auf 80 %, wenn die Gesamtproduktionsmenge verdoppelt wird. Einheit 1 = 100 h, Einheit 2 = 80 h, Einheit 4 = 64 h usw.</p>
      <p><strong>Welche Lernkurvenrate ist typisch?</strong> In der Fertigungsindustrie liegen typische Werte zwischen 75 % (schnelles Lernen) und 90 % (langsames Lernen). Einfache Tätigkeiten nähern sich schneller der Lernkurvengrenze.</p>
      <p><strong>Wo wird die Lernkurve angewendet?</strong> In der Rüstungsindustrie, Luft- und Raumfahrt, Softwareentwicklung und bei jedem Projekt, das Wiederholungen beinhaltet.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const lkrFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcLKR() {
      const t1 = parseFloat((document.getElementById('lkr-t1') as HTMLInputElement).value) || 100;
      const rate = parseFloat((document.getElementById('lkr-rate') as HTMLInputElement).value) / 100 || 0.8;
      const targetUnit = parseInt((document.getElementById('lkr-unit') as HTMLInputElement).value) || 10;
      const rateEur = parseFloat((document.getElementById('lkr-rate-eur') as HTMLInputElement).value) || 50;
      const b = Math.log(rate) / Math.log(2);
      const tn = t1 * Math.pow(targetUnit, b);
      const saving = ((t1 - tn) / t1 * 100);
      document.getElementById('lkr-tn')!.textContent = tn.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' Std.';
      document.getElementById('lkr-saving')!.textContent = saving.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
      document.getElementById('lkr-cost1')!.textContent = lkrFmt(t1 * rateEur);
      document.getElementById('lkr-costn')!.textContent = lkrFmt(tn * rateEur);
      const milestones = [1, 2, 4, 8, 16, 32, 64, 128].filter(u => u <= Math.max(targetUnit, 128));
      if (!milestones.includes(targetUnit)) milestones.push(targetUnit);
      milestones.sort((a, b) => a - b);
      document.getElementById('lkr-table')!.innerHTML = milestones.map(u => {
        const t = t1 * Math.pow(u, b);
        const sv = ((t1 - t) / t1 * 100).toFixed(1).replace('.', ',');
        return '<tr class="border-t border-border/30"><td class="py-1">' + u + '</td><td class="text-right">' + t.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '</td><td class="text-right">' + lkrFmt(t * rateEur) + '</td><td class="text-right">' + sv + ' %</td></tr>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.lkr-in').forEach(el => { el.addEventListener('input', calcLKR); el.addEventListener('change', calcLKR); }); calcLKR(); }, 50);
  </script>
</CalculatorLayout>
