---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Grauwasser-Rechner - Wiederverwendungsvolumen & Bew&auml;sserungsfl&auml;che";
const description = "Berechnen Sie das Grauwasservolumen aus Haushaltsger&auml;ten, das Wiederverwendungspotenzial, die Tankgr&ouml;&szlig;e und die Bew&auml;sserungsfl&auml;che f&uuml;r die Wassereinsparung.";
const relatedCalcs = [
  { name: "Grauwasser-Wiederverwendung", url: "/de/grauwasser-wiederverwendung-rechner", description: "System-Dimensionierung." },
  { name: "Bew&auml;sserungsrechner", url: "/de/bewaesserungsrechner", description: "Bew&auml;sserungsplanung." },
  { name: "Wasserverbrauch-Rechner", url: "/de/wasserverbrauch-rechner", description: "T&auml;glicher Wasserverbrauch." },
  { name: "Entw&auml;sserungsrechner", url: "/de/entwaesserungsrechner", description: "Entw&auml;sserungsplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Grauwasser-Rechner" lang="de" enSlug="greywater-calculator" keywords="grauwasser rechner, grauwasser wiederverwendung, bew&auml;sserungsfl&auml;che, speichertank, wassereinsparung" breadcrumbs={[{ name: "Grauwasser-Rechner", url: "/de/grauwasser-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Grauwasser-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie, wie viel Grauwasser Ihr Haushalt produziert und welche Bew&auml;sserungsfl&auml;che damit versorgt werden kann.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Anzahl Personen</label>
          <input type="number" id="gwde-people" class="gwde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="20" step="1">
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Grauwasserquellen (ankreuzen)</h3>
          <div class="space-y-2">
            <label class="flex items-center gap-2"><input type="checkbox" id="gwde-shower" class="gwde-in" checked> Duschen/B&auml;der (ca. 55 L/Person/Tag)</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="gwde-lav" class="gwde-in" checked> Waschbecken (ca. 20 L/Person/Tag)</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="gwde-laundry" class="gwde-in" checked> Waschmaschine (ca. 55 L/Ladung, 1 Ladung/2 Tage)</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="gwde-kitchen" class="gwde-in"> K&uuml;chensp&uuml;le (ca. 20 L/Person/Tag - nicht immer erlaubt)</label>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Klimazone</label>
            <select id="gwde-climate" class="gwde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="arid">Trocken/W&uuml;ste</option>
              <option value="semi" selected>Halbtrocken</option>
              <option value="moderate">Gem&auml;&szlig;igt</option>
              <option value="humid">Feucht</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bodenart</label>
            <select id="gwde-soil" class="gwde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="sand">Sandig</option>
              <option value="loam" selected>Lehm</option>
              <option value="clay">Ton</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">T&auml;gliches Grauwasservolumen</div>
          <div class="text-4xl font-extrabold" id="gwde-daily">0 Liter/Tag</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">W&ouml;chentliches Volumen</div><div class="text-xl font-bold" id="gwde-weekly">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliches Volumen</div><div class="text-xl font-bold" id="gwde-annual">0 L</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bew&auml;sserungsfl&auml;che</div><div class="text-xl font-bold" id="gwde-area">0 m&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Speichertank-Gr&ouml;&szlig;e</div><div class="text-xl font-bold" id="gwde-tank">0 L</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Einsparungssch&auml;tzung</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between"><span>Wasserkosten-Ersparnis (j&auml;hrlich)</span><span class="font-bold" id="gwde-savings">0 &euro;</span></div>
            <div class="flex justify-between"><span>Anteil Wiederverwendung</span><span class="font-bold" id="gwde-pct">0 %</span></div>
            <div class="flex justify-between"><span>Wiederverwendungspotenzial</span><span class="font-bold" id="gwde-rating">--</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="greywater-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Grauwasser verstehen</h2>
      <p>Grauwasser ist leicht verschmutztes Abwasser aus Duschen, Waschbecken und Waschmaschinen. Es kann zur Gartenbew&auml;sserung wiederverwendet werden und spart bis zu 30&ndash;50 % des Trinkwasserverbrauchs.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Ist Grauwasser-Wiederverwendung erlaubt?</strong> Die Vorschriften variieren je nach Gemeinde. Informieren Sie sich bei Ihrer lokalen Beh&ouml;rde.</p>
      <p><strong>Wie lange kann Grauwasser gespeichert werden?</strong> Maximal 24&ndash;48 Stunden, da sich sonst Bakterien vermehren.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGWDE() {
      const people = parseInt((document.getElementById('gwde-people') as HTMLInputElement).value) || 4;
      const shower = (document.getElementById('gwde-shower') as HTMLInputElement).checked;
      const lav = (document.getElementById('gwde-lav') as HTMLInputElement).checked;
      const laundry = (document.getElementById('gwde-laundry') as HTMLInputElement).checked;
      const kitchen = (document.getElementById('gwde-kitchen') as HTMLInputElement).checked;
      const climate = (document.getElementById('gwde-climate') as HTMLSelectElement).value;
      const soil = (document.getElementById('gwde-soil') as HTMLSelectElement).value;

      let dailyL = 0;
      if (shower) dailyL += people * 55;
      if (lav) dailyL += people * 20;
      if (laundry) dailyL += 55 * Math.ceil(people / 2) * 0.5;
      if (kitchen) dailyL += people * 20;

      const weeklyL = dailyL * 7;
      const annualL = dailyL * 365;

      const irrigNeed: Record<string, number> = { arid: 5, semi: 3.5, moderate: 2.5, humid: 1.2 };
      const weeklyLPerSqm = irrigNeed[climate] || 3.5;
      const irrigArea = Math.round(weeklyL / weeklyLPerSqm);

      const soilFactor: Record<string, number> = { sand: 1.3, loam: 1.0, clay: 0.7 };
      const adjustedArea = Math.round(irrigArea * (soilFactor[soil] || 1.0));

      const tankSize = Math.ceil(dailyL * 1.5 / 50) * 50;

      const totalUsage = people * 130;
      const reusePct = Math.min(100, (dailyL / totalUsage * 100));

      const annualSavings = annualL * 0.005;

      let rating = 'Niedrig';
      if (reusePct > 40) rating = 'Ausgezeichnet';
      else if (reusePct > 25) rating = 'Gut';
      else if (reusePct > 15) rating = 'Mittel';

      document.getElementById('gwde-daily')!.textContent = Math.round(dailyL).toLocaleString('de-DE') + ' Liter/Tag';
      document.getElementById('gwde-weekly')!.textContent = Math.round(weeklyL).toLocaleString('de-DE') + ' L';
      document.getElementById('gwde-annual')!.textContent = Math.round(annualL).toLocaleString('de-DE') + ' L';
      document.getElementById('gwde-area')!.textContent = adjustedArea.toLocaleString('de-DE') + ' m\u00B2';
      document.getElementById('gwde-tank')!.textContent = tankSize.toLocaleString('de-DE') + ' L';
      document.getElementById('gwde-savings')!.textContent = Math.round(annualSavings).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('gwde-pct')!.textContent = reusePct.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' %';
      document.getElementById('gwde-rating')!.textContent = rating;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gwde-in').forEach(el => { el.addEventListener('input', calcGWDE); el.addEventListener('change', calcGWDE); });
      calcGWDE();
    }, 50);
  </script>
</CalculatorLayout>
