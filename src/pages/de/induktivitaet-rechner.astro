---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Induktivitäts-Rechner - Reihen- & Parallelschaltung";
const description = "Berechnen Sie die Gesamtinduktivität für Induktoren in Reihen- und Parallelschaltung, sowie induktiven Widerstand und Energie.";
const relatedCalcs = [
  { name: "Kondensator-Rechner", url: "/capacitor-calculator", description: "Kondensator." },
  { name: "Ohmsches-Gesetz-Rechner", url: "/ohms-law-calculator", description: "Ohmsches Gesetz." },
  { name: "Widerstandsfarbcode-Rechner", url: "/resistor-color-code-calculator", description: "Widerstand." },
  { name: "Frequenz-Rechner", url: "/frequency-calculator", description: "Frequenz." },
  { name: "Leistungsrechner", url: "/power-calculator", description: "Elektrische Leistung." },
  { name: "Spannungsteiler-Rechner", url: "/voltage-divider-calculator", description: "Spannungsteiler." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie berechne ich Induktoren in Reihenschaltung?",
      "acceptedAnswer": { "@type": "Answer", "text": "Bei Reihenschaltung werden alle Induktivitäten addiert: L_gesamt = L1 + L2 + L3 + ... Die Gesamtinduktivität ist immer größer als der größte Einzelwert." }
    },
    {
      "@type": "Question",
      "name": "Was ist der induktive Widerstand (XL)?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der induktive Widerstand XL = 2π × f × L, wobei f die Frequenz in Hz und L die Induktivität in Henry ist. Bei höherer Frequenz steigt der Widerstand, da Induktoren Wechselstrom stärker begrenzen." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Induktivitäts-Rechner" lang="de" keywords="induktivität rechner, induktoren reihe parallel, induktanz, induktiver widerstand, LC-resonanz" breadcrumbs={[{ name: "Induktivitäts-Rechner", url: "/de/induktivitaet-rechner" }]} enSlug="inductor-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Induktivitäts-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Induktivität, Widerstand und Energie für Induktivitätsschaltungen berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button class="ind-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="single">Einzeln</button>
          <button class="ind-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="series">Reihe</button>
          <button class="ind-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="parallel">Parallel</button>
        </div>
        <div id="ind-single">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Induktivität (mH)</label><input type="number" id="ind-l" class="ind-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="0.1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Strom (A)</label><input type="number" id="ind-i" class="ind-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" step="0.1"></div>
          </div>
          <div class="mt-3"><label class="block text-xs font-medium text-text mb-1">Frequenz (Hz)</label><input type="number" id="ind-f" class="ind-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="1"></div>
        </div>
        <div id="ind-multi" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Induktivitätswerte (mH, kommagetrennt)</label>
          <input type="text" id="ind-vals" class="ind-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10, 22, 47" placeholder="10, 22, 47">
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div><label class="block text-xs font-medium text-text mb-1">Strom (A)</label><input type="number" id="ind-i2" class="ind-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" step="0.1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Frequenz (Hz)</label><input type="number" id="ind-f2" class="ind-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="1"></div>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="ind-label">Induktivität</div>
          <div class="text-5xl font-extrabold font-mono" id="ind-result">10 mH</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Widerstand (XL)</div><div class="text-xl font-bold font-mono" id="ind-xl">0 Ω</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Energie</div><div class="text-xl font-bold font-mono" id="ind-energy">0 mJ</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeitkonstante</div><div class="text-xl font-bold font-mono" id="ind-tau">0 ms</div></div>
        </div>
      </div>
      <ShareButton calculatorId="induktivitaet" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Induktivitäten berechnen</h2>
      <p>Induktoren sind passive Bauelemente, die elektrische Energie in einem Magnetfeld speichern. Die Induktivität wird in Henry (H) oder Millihenry (mH) gemessen. Bei Reihenschaltung addieren sich die Werte, bei Parallelschaltung gilt der Kehrwert der Summe der Kehrwerte.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie berechne ich Induktoren in Reihenschaltung?</h4>
      <p>Bei Reihenschaltung werden alle Induktivitäten addiert: L_gesamt = L1 + L2 + L3 + ...</p>
      <h4 class="text-lg font-semibold text-text mt-4">Was ist der induktive Widerstand (XL)?</h4>
      <p>Der induktive Widerstand XL = 2π × f × L, wobei f die Frequenz in Hz und L die Induktivität in Henry ist.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let indMode = 'single';
    function setIndMode(m: string) {
      indMode = m;
      document.getElementById('ind-single')!.classList.toggle('hidden', m !== 'single');
      document.getElementById('ind-multi')!.classList.toggle('hidden', m === 'single');
      document.querySelectorAll('.ind-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'ind-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcIND();
    }
    function calcIND() {
      let lMH: number, current: number, freq: number;
      if (indMode === 'single') {
        lMH = parseFloat((document.getElementById('ind-l') as HTMLInputElement).value) || 0;
        current = parseFloat((document.getElementById('ind-i') as HTMLInputElement).value) || 0;
        freq = parseFloat((document.getElementById('ind-f') as HTMLInputElement).value) || 50;
      } else {
        const vals = (document.getElementById('ind-vals') as HTMLInputElement).value.split(',').map(s => parseFloat(s.trim())).filter(n => n > 0);
        current = parseFloat((document.getElementById('ind-i2') as HTMLInputElement).value) || 0;
        freq = parseFloat((document.getElementById('ind-f2') as HTMLInputElement).value) || 50;
        if (vals.length === 0) lMH = 0;
        else if (indMode === 'series') lMH = vals.reduce((a, b) => a + b, 0);
        else lMH = 1 / vals.reduce((a, b) => a + 1 / b, 0);
      }
      const lH = lMH / 1000;
      const xl = 2 * Math.PI * freq * lH;
      const energy = 0.5 * lH * current * current;
      const tau = lH / 1;
      let display: string;
      if (lMH >= 1000) display = (lMH / 1000).toFixed(2) + ' H';
      else if (lMH >= 1) display = lMH.toFixed(2) + ' mH';
      else display = (lMH * 1000).toFixed(2) + ' \u00B5H';
      document.getElementById('ind-label')!.textContent = indMode === 'single' ? 'Induktivit\u00e4t' : 'Gesamt (' + indMode + ')';
      document.getElementById('ind-result')!.textContent = display;
      document.getElementById('ind-xl')!.textContent = xl.toFixed(2) + ' \u03A9';
      document.getElementById('ind-energy')!.textContent = (energy * 1000).toFixed(4) + ' mJ';
      document.getElementById('ind-tau')!.textContent = (tau * 1000).toFixed(2) + ' ms';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ind-mode').forEach(b => b.addEventListener('click', () => setIndMode((b as HTMLButtonElement).dataset.mode!)));
      document.querySelectorAll('.ind-in').forEach(el => { el.addEventListener('input', calcIND); el.addEventListener('change', calcIND); });
      calcIND();
    }, 50);
  </script>
</CalculatorLayout>
