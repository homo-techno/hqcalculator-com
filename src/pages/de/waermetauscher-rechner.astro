---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "W&auml;rmetauscher-Rechner - LMTD, NTU &amp; W&auml;rme&uuml;bertragungsrate";
const description = "Berechnen Sie die W&auml;rmetauscher-Leistung mit LMTD- und NTU-Effektivit&auml;ts-Methoden. Ermitteln Sie W&auml;rme&uuml;bertragungsrate, Austrittstemperaturen und ben&ouml;tigte Fl&auml;che.";

const relatedCalcs = [
  { name: "W&auml;rmeverlust-Rechner", url: "/de/waermeverlust-rechner", description: "Geb&auml;ude-W&auml;rmeverlust." },
  { name: "W&auml;rme&uuml;bertragung-Rechner", url: "/de/waermeubertragung-rechner", description: "Q=mc&Delta;T berechnen." },
  { name: "W&auml;rmepumpe-Rechner", url: "/de/waermepumpe-rechner", description: "W&auml;rmepumpen-Dimensionierung." },
  { name: "Hitzeindex-Rechner", url: "/de/hitzeindex-rechner", description: "Gef&uuml;hlte Temperatur." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="W&auml;rmetauscher-Rechner"
  keywords="w&auml;rmetauscher rechner, LMTD, NTU, effektivit&auml;t, w&auml;rme&uuml;bertragungsrate, UA-Wert, gegenstrom, gleichstrom"
  breadcrumbs={[{ name: "W&auml;rmetauscher-Rechner", url: "/de/waermetauscher-rechner" }]}
  lang="de"
  enSlug="heat-exchanger-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">W&auml;rmetauscher-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie W&auml;rmetauscher-Leistung mit LMTD- oder NTU-Effektivit&auml;ts-Methoden.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Str&ouml;mungsanordnung</label>
            <select id="wtde-flow" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="counter" selected>Gegenstrom</option>
              <option value="parallel">Gleichstrom</option>
              <option value="crossflow">Kreuzstrom</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Methode</label>
            <select id="wtde-method" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="lmtd" selected>LMTD (Temperaturen bekannt)</option>
              <option value="ntu">NTU-Effektivit&auml;t</option>
            </select>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">Hei&szlig;e Seite</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Eingangstemperatur hei&szlig; (&deg;C)</label>
            <input type="number" id="wtde-thi" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Ausgangstemperatur hei&szlig; (&deg;C)</label>
            <input type="number" id="wtde-tho" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="65" step="1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Hei&szlig;seitig: Massenstrom &times; cp (W/K)</label>
          <input type="number" id="wtde-ch" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000" min="1" step="100">
        </div>

        <h3 class="text-lg font-bold text-text">Kalte Seite</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Eingangstemperatur kalt (&deg;C)</label>
            <input type="number" id="wtde-tci" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Ausgangstemperatur kalt (&deg;C)</label>
            <input type="number" id="wtde-tco" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" step="1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Kaltseitig: Massenstrom &times; cp (W/K)</label>
          <input type="number" id="wtde-cc" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000" min="1" step="100">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">W&auml;rmedurchgangskoeffizient U (W/m&sup2;K)</label>
          <input type="number" id="wtde-u" class="wtde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="10">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">W&auml;rme&uuml;bertragungsrate</div>
          <div class="text-4xl font-extrabold" id="wtde-q">--</div>
          <div class="text-sm text-blue-200 mt-1">W</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">LMTD</div>
            <div class="text-xl font-bold" id="wtde-lmtd">--</div>
            <div class="text-xs text-text-muted">&deg;C</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Effektivit&auml;t</div>
            <div class="text-xl font-bold" id="wtde-eff">--</div>
            <div class="text-xs text-text-muted">%</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ben&ouml;tigte Fl&auml;che</div>
            <div class="text-xl font-bold" id="wtde-area">--</div>
            <div class="text-xs text-text-muted">m&sup2;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">UA-Produkt</div>
            <div class="text-xl font-bold" id="wtde-ua">--</div>
            <div class="text-xs text-text-muted">W/K</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">NTU</div>
            <div class="text-xl font-bold" id="wtde-ntu">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">W&auml;rme&uuml;bertragung (kW)</div>
            <div class="text-xl font-bold" id="wtde-qkw">--</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="waermetauscher-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl mx-auto prose prose-slate">
      <h2 class="text-2xl font-bold text-text">W&auml;rmetauscher Berechnungsmethoden</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Q = U &times; A &times; LMTD</p>
        <p>LMTD = (&Delta;T1 - &Delta;T2) / ln(&Delta;T1/&Delta;T2)</p>
        <p>Effektivit&auml;t = Q_ist / Q_max</p>
        <p>NTU = UA / C_min</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der LMTD?</strong> Der logarithmische Mittelwert der Temperaturdifferenz (LMTD) ist die treibende Kraft f&uuml;r die W&auml;rme&uuml;bertragung. Er ber&uuml;cksichtigt die &auml;ndernde Temperaturdifferenz entlang des W&auml;rmetauschers.</p>
      <p><strong>Wann Gegenstrom, wann Gleichstrom?</strong> Gegenstrom ist thermodynamisch effizienter als Gleichstrom, da er eine h&ouml;here mittlere treibende Temperaturdifferenz erzeugt.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcWTDE() {
      const flowType = (document.getElementById('wtde-flow') as HTMLSelectElement).value;
      const thi = parseFloat((document.getElementById('wtde-thi') as HTMLInputElement).value) || 0;
      const tho = parseFloat((document.getElementById('wtde-tho') as HTMLInputElement).value) || 0;
      const tci = parseFloat((document.getElementById('wtde-tci') as HTMLInputElement).value) || 0;
      const tco = parseFloat((document.getElementById('wtde-tco') as HTMLInputElement).value) || 0;
      const Ch = parseFloat((document.getElementById('wtde-ch') as HTMLInputElement).value) || 1;
      const Cc = parseFloat((document.getElementById('wtde-cc') as HTMLInputElement).value) || 1;
      const U = parseFloat((document.getElementById('wtde-u') as HTMLInputElement).value) || 1;

      const Qh = Ch * (thi - tho);
      const Qc = Cc * (tco - tci);
      const Q = (Qh + Qc) / 2;

      let dT1: number, dT2: number;
      if (flowType === 'counter') {
        dT1 = thi - tco;
        dT2 = tho - tci;
      } else {
        dT1 = thi - tci;
        dT2 = tho - tco;
      }

      let lmtd: number;
      if (dT1 <= 0 || dT2 <= 0) {
        lmtd = 0;
      } else if (Math.abs(dT1 - dT2) < 0.01) {
        lmtd = dT1;
      } else {
        lmtd = (dT1 - dT2) / Math.log(dT1 / dT2);
      }

      let F = 1.0;
      if (flowType === 'crossflow') F = 0.9;
      const correctedLMTD = lmtd * F;

      const area = correctedLMTD > 0 ? Q / (U * correctedLMTD) : 0;
      const UA = U * area;

      const Cmin = Math.min(Ch, Cc);
      const Qmax = Cmin * (thi - tci);
      const effectiveness = Qmax > 0 ? (Q / Qmax) * 100 : 0;
      const ntu = Cmin > 0 ? UA / Cmin : 0;
      const qKW = Q / 1000;

      document.getElementById('wtde-q')!.textContent = Math.round(Q).toLocaleString('de-DE');
      document.getElementById('wtde-lmtd')!.textContent = correctedLMTD.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('wtde-eff')!.textContent = effectiveness.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('wtde-area')!.textContent = area.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('wtde-ua')!.textContent = UA.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.getElementById('wtde-ntu')!.textContent = ntu.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('wtde-qkw')!.textContent = qKW.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.wtde-in').forEach(el => {
        el.addEventListener('input', calcWTDE);
        el.addEventListener('change', calcWTDE);
      });
      calcWTDE();
    }, 50);
  </script>
</CalculatorLayout>
