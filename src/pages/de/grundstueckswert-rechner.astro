---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Grundstückswert Rechner";
const description = "Schätzen Sie den Wert von Grundstücken und Immobilien in Deutschland.";

const relatedCalcs = [
  { name: "Grundstücksfläche Rechner", url: "/de/grundstuecksflaeche-rechner", description: "Fläche berechnen." },
  { name: "Abschlusskosten-Rechner", url: "/de/abschlusskosten-rechner", description: "Kaufnebenkosten berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlagewachstum." },
  { name: "Geländegradierung Rechner", url: "/de/gelaendegradierung-rechner", description: "Erdarbeiten planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Grundstückswert Rechner" lang="de" enSlug="land-value-calculator" keywords="grundstückswert rechner, bodenwert berechnen, grundstück preis deutschland, immobilienwert schätzen" breadcrumbs={[{ name: "Grundstückswert Rechner", url: "/de/grundstueckswert-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Grundstückswert Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie den Verkehrswert eines Grundstücks anhand von Lage, Größe und Bebaubarkeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Grundstücksfläche (m²)</label><input type="number" id="gsw-area" class="gsw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="600" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bodenrichtwert (€/m²)</label><input type="number" id="gsw-brw" class="gsw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="350" min="1" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lagequalität</label><select id="gsw-lage" class="gsw-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.8">Randlage / ländlich</option>
            <option value="1.0" selected>Durchschnittslage</option>
            <option value="1.2">Gute Lage</option>
            <option value="1.5">Sehr gute / Toplage</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bebaubarkeit</label><select id="gsw-beb" class="gsw-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.6">Landwirtschaft</option>
            <option value="0.8">Bauerwartungsland</option>
            <option value="1.0" selected>Bauland (B-Plan)</option>
            <option value="1.1">Erschlossen &amp; baugenehmigt</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Grunderwerbsteuer (%)</label><input type="number" id="gsw-gest" class="gsw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.0" min="3.5" max="6.5" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Maklergebühr (%)</label><input type="number" id="gsw-makler" class="gsw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.57" min="0" max="10" step="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzter Grundstückswert</div>
          <div class="text-4xl font-extrabold font-mono" id="gsw-val">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grunderwerbsteuer</div><div class="text-xl font-bold" id="gsw-gest-val">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Makler</div><div class="text-xl font-bold" id="gsw-makler-val">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="gsw-gesammt">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="land-value-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Grundstückswert in Deutschland ermitteln</h2>
      <p>Der Wert eines Grundstücks wird maßgeblich durch den Bodenrichtwert bestimmt, den die Gutachterausschüsse der Gemeinden regelmäßig ermitteln. Er gibt den durchschnittlichen Lagewert des Bodens in €/m² an. Faktoren wie Lagequalität, Erschließung und Bebaubarkeit können den tatsächlichen Verkehrswert nach oben oder unten abweichen lassen. Beim Kauf fallen zusätzlich Grunderwerbsteuer (3,5–6,5 %), Notarkosten (~1,5 %) und ggf. Maklergebühren an.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Bodenrichtwert?</strong> Der Bodenrichtwert ist der durchschnittliche Lagewert des Bodens für ein Gebiet mit im Wesentlichen gleichen Nutzungs- und Wertverhältnissen. Er wird von Gutachterausschüssen festgestellt und kann kostenlos beim zuständigen Katasteramt abgefragt werden.</p>
      <p><strong>Wie hoch ist die Grunderwerbsteuer in Deutschland?</strong> Die Grunderwerbsteuer variiert je nach Bundesland: Bayern und Sachsen erheben 3,5 %, die meisten anderen Bundesländer 5–6,5 %.</p>
      <p><strong>Was kostet ein Notar beim Grundstückskauf?</strong> Notargebühren richten sich nach dem Kaufpreis. Bei 200.000 € fallen ca. 1.500–2.000 € Notarkosten an, hinzu kommen Grundbuchgebühren von ca. 0,5 % des Kaufpreises.</p>
      <p><strong>Kann ich den Grundstückswert selbst ermitteln?</strong> Eine erste Schätzung ist mit dem Bodenrichtwert möglich. Für eine rechtssichere Wertermittlung (z. B. für Erbschaftsteuer oder Finanzierung) benötigen Sie ein Gutachten eines zertifizierten Sachverständigen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const gswFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcGSW() {
      const area = parseFloat((document.getElementById('gsw-area') as HTMLInputElement).value) || 0;
      const brw = parseFloat((document.getElementById('gsw-brw') as HTMLInputElement).value) || 0;
      const lage = parseFloat((document.getElementById('gsw-lage') as HTMLSelectElement).value) || 1;
      const beb = parseFloat((document.getElementById('gsw-beb') as HTMLSelectElement).value) || 1;
      const gest = parseFloat((document.getElementById('gsw-gest') as HTMLInputElement).value) || 0;
      const makler = parseFloat((document.getElementById('gsw-makler') as HTMLInputElement).value) || 0;
      const val = area * brw * lage * beb;
      const gestVal = val * gest / 100;
      const maklerVal = val * makler / 100;
      const notar = val * 0.015;
      const gesammt = val + gestVal + maklerVal + notar;
      document.getElementById('gsw-val')!.textContent = gswFmt(val);
      document.getElementById('gsw-gest-val')!.textContent = gswFmt(gestVal);
      document.getElementById('gsw-makler-val')!.textContent = gswFmt(maklerVal);
      document.getElementById('gsw-gesammt')!.textContent = gswFmt(gesammt);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.gsw-in').forEach(el => { el.addEventListener('input', calcGSW); el.addEventListener('change', calcGSW); }); calcGSW(); }, 50);
  </script>
</CalculatorLayout>
