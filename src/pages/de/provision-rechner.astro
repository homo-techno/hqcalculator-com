---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Provisionsrechner - Vertriebsprovision berechnen";
const description = "Berechnen Sie Vertriebsprovisionen basierend auf Umsatz, Provisionssatz und Bonusstufen. Unterst\u00fctzt pauschale und gestaffelte Provisionsmodelle.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Gewinnspannenrechner", url: "/de/gewinnspanne-rechner", description: "Gewinnspanne." },
  { name: "Rabattrechner", url: "/de/rabatt-rechner", description: "Rabatte." },
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Budgetierung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Provisionsrechner" lang="de" enSlug="commission-calculator" keywords="provisionsrechner, vertriebsprovision, provision berechnen, provisionsmodell, verkaufsprovision" breadcrumbs={[{ name: "Provisionsrechner", url: "/de/provision-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Provisionsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Vertriebsprovisionen mit pauschalen oder gestaffelten S&auml;tzen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesamtumsatz (&euro;)</label><input type="number" id="pv-sales" class="pv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Provisionssatz (%)</label><input type="number" id="pv-rate" class="pv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="100" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Grundgehalt (&euro;)</label><input type="number" id="pv-base" class="pv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bonusschwelle (&euro;)</label><input type="number" id="pv-thresh" class="pv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75000" min="0" step="1000"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Bonussatz &uuml;ber Schwelle (%)</label><input type="number" id="pv-bonus" class="pv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" max="100" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtverg&uuml;tung</div>
          <div class="text-4xl font-extrabold font-mono" id="pv-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Provision</div><div class="text-xl font-bold" id="pv-comm">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bonus</div><div class="text-xl font-bold" id="pv-bon">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effektiver Satz</div><div class="text-xl font-bold" id="pv-eff">0%</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatsverdienst</div><div class="text-xl font-bold" id="pv-monthly">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Provisionsanteil</div><div class="text-xl font-bold" id="pv-pct">0%</div></div>
        </div>
      </div>
      <ShareButton calculatorId="commission" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Provisionsmodelle im Vertrieb</h2>
      <p>In Deutschland sind gestaffelte Provisionsmodelle im Vertrieb &uuml;blich. H&auml;ufig wird ein Grundgehalt mit einer variablen Provision kombiniert. Bei &Uuml;berschreitung bestimmter Umsatzschwellen greifen oft erh&ouml;hte Bonuss&auml;tze als zus&auml;tzlicher Leistungsanreiz.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcProv() {
      const sales = parseFloat((document.getElementById('pv-sales') as HTMLInputElement).value) || 0;
      const rate = (parseFloat((document.getElementById('pv-rate') as HTMLInputElement).value) || 0) / 100;
      const base = parseFloat((document.getElementById('pv-base') as HTMLInputElement).value) || 0;
      const thresh = parseFloat((document.getElementById('pv-thresh') as HTMLInputElement).value) || 0;
      const bonusRate = (parseFloat((document.getElementById('pv-bonus') as HTMLInputElement).value) || 0) / 100;
      const baseComm = Math.min(sales, thresh) * rate;
      const bonusComm = sales > thresh ? (sales - thresh) * bonusRate : 0;
      const totalComm = baseComm + bonusComm;
      const total = base + totalComm;
      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC';
      document.getElementById('pv-total')!.textContent = fmt(Math.round(total));
      document.getElementById('pv-comm')!.textContent = fmt(Math.round(baseComm));
      document.getElementById('pv-bon')!.textContent = fmt(Math.round(bonusComm));
      document.getElementById('pv-eff')!.textContent = (sales > 0 ? (totalComm / sales * 100) : 0).toFixed(2).replace('.', ',') + '%';
      document.getElementById('pv-monthly')!.textContent = fmt(Math.round(total / 12));
      document.getElementById('pv-pct')!.textContent = (total > 0 ? (totalComm / total * 100) : 0).toFixed(1).replace('.', ',') + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.pv-in').forEach(el => el.addEventListener('input', calcProv)); calcProv(); }, 50);
  </script>
</CalculatorLayout>
