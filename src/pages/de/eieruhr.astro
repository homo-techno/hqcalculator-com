---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Eieruhr - Perfekte Kochzeit für weiche, mittlere & harte Eier";
const description = "Berechnen Sie die perfekte Kochzeit für Ihr Ei basierend auf Eigröße, Ausgangstemperatur und gewünschter Konsistenz. Weich, mittel oder hartgekocht.";

const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeit berechnen." },
  { name: "Temperaturumrechner", url: "/de/temperaturumrechner", description: "Temperatur umrechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Eieruhr" lang="de" enSlug="egg-timer" keywords="eieruhr, ei kochzeit, eier kochen, weich mittel hart, eier timer, perfektes ei" breadcrumbs={[{ name: "Eieruhr", url: "/de/eieruhr" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Eieruhr</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die perfekte Kochzeit f&uuml;r Ihr Ei nach Gr&ouml;&szlig;e, Temperatur und gew&uuml;nschter Konsistenz.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eigr&ouml;&szlig;e</label><select id="eti-size" class="eti-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="S">S (unter 53g)</option><option value="M" selected>M (53&ndash;63g)</option><option value="L">L (63&ndash;73g)</option><option value="XL">XL (&uuml;ber 73g)</option></select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ausgangstemperatur</label><select id="eti-temp" class="eti-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="fridge">K&uuml;hlschrank (4&deg;C)</option><option value="room">Zimmertemperatur (20&deg;C)</option></select></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschte Konsistenz</label><select id="eti-doneness" class="eti-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="soft">Weich (fl&uuml;ssiges Eigelb)</option><option value="medium">Mittel (wachsweiches Eigelb)</option><option value="hard">Hart (festes Eigelb)</option></select></div>
        <div><label class="block text-xs font-medium text-text mb-1">H&ouml;henlage (m &uuml;.M.)</label><input type="number" id="eti-alt" class="eti-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0" max="5000"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kochzeit</div>
          <div class="text-5xl font-extrabold font-mono" id="eti-result">0:00</div>
          <div class="text-sm text-blue-200 mt-1" id="eti-desc"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Siedetemperatur</div><div class="text-xl font-bold" id="eti-boil">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigewicht (ca.)</div><div class="text-xl font-bold" id="eti-weight">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <button id="eti-start" class="px-6 py-3 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary/90 transition">Timer starten</button>
          <div class="text-3xl font-mono font-bold mt-3" id="eti-countdown"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="eti-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="egg-timer-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das perfekte Ei kochen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Kochzeit basiert auf Eigr&ouml;&szlig;e, Starttemperatur und Zielkonsistenz</p>
        <p>H&ouml;henkorrektur: +10% pro 1000 m (niedrigerer Siedepunkt)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Soll ich Eier in kaltes oder kochendes Wasser legen?</strong> F&uuml;r pr&auml;zisere Ergebnisse empfehlen wir, Eier in bereits kochendes Wasser zu legen.</p>
      <p><strong>Warum beeinflusst die H&ouml;henlage die Kochzeit?</strong> In h&ouml;heren Lagen sinkt der Siedepunkt des Wassers, dadurch dauert das Kochen l&auml;nger.</p>
      <p><strong>Wie erkenne ich ein frisches Ei?</strong> Legen Sie das Ei in Wasser: frische Eier sinken, &auml;ltere schwimmen oben.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let etiTimer: ReturnType<typeof setInterval> | null = null;
    function calcEti() {
      const size = (document.getElementById('eti-size') as HTMLSelectElement).value;
      const temp = (document.getElementById('eti-temp') as HTMLSelectElement).value;
      const doneness = (document.getElementById('eti-doneness') as HTMLSelectElement).value;
      const alt = parseFloat((document.getElementById('eti-alt') as HTMLInputElement).value) || 0;
      const steps: string[] = [];
      const weights: Record<string, number> = { S: 48, M: 58, L: 68, XL: 78 };
      const w = weights[size] || 58;
      steps.push('Eigewicht (ca.) = ' + w + ' g (' + size + ')');
      const baseTimes: Record<string, Record<string, number>> = {
        soft: { fridge: 360, room: 270 },
        medium: { fridge: 480, room: 390 },
        hard: { fridge: 660, room: 570 },
      };
      let baseTime = baseTimes[doneness]?.[temp] || 360;
      const sizeFactor: Record<string, number> = { S: 0.85, M: 1.0, L: 1.15, XL: 1.3 };
      baseTime = baseTime * (sizeFactor[size] || 1.0);
      steps.push('Basiszeit (' + doneness + ', ' + temp + ') = ' + Math.round(baseTime) + ' s');
      const altFactor = 1 + (alt / 1000) * 0.1;
      const finalTime = Math.round(baseTime * altFactor);
      steps.push('Hoehenkorrektur = x ' + altFactor.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}));
      steps.push('Endzeit = ' + finalTime + ' s = ' + Math.floor(finalTime / 60) + ':' + String(finalTime % 60).padStart(2, '0') + ' min');
      const boilTemp = 100 - (alt / 300);
      steps.push('Siedetemperatur = ' + boilTemp.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' C');
      const min = Math.floor(finalTime / 60);
      const sec = finalTime % 60;
      const donenessNames: Record<string, string> = { soft: 'Weich', medium: 'Mittel', hard: 'Hart' };
      document.getElementById('eti-result')!.textContent = min + ':' + String(sec).padStart(2, '0');
      document.getElementById('eti-desc')!.textContent = donenessNames[doneness] || '';
      document.getElementById('eti-boil')!.textContent = boilTemp.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' \u00B0C';
      document.getElementById('eti-weight')!.textContent = w + ' g';
      document.getElementById('eti-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      (document.getElementById('eti-start') as HTMLButtonElement).onclick = function() {
        if (etiTimer) { clearInterval(etiTimer); etiTimer = null; }
        let remaining = finalTime;
        const cdEl = document.getElementById('eti-countdown')!;
        cdEl.textContent = Math.floor(remaining / 60) + ':' + String(remaining % 60).padStart(2, '0');
        etiTimer = setInterval(() => {
          remaining--;
          if (remaining <= 0) { clearInterval(etiTimer!); etiTimer = null; cdEl.textContent = 'Fertig!'; return; }
          cdEl.textContent = Math.floor(remaining / 60) + ':' + String(remaining % 60).padStart(2, '0');
        }, 1000);
      };
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('eti-alt') as HTMLInputElement).value = '0';
      document.querySelectorAll('.eti-in').forEach(el => { el.addEventListener('input', calcEti); el.addEventListener('change', calcEti); });
      calcEti();
    }, 50);
  </script>
</CalculatorLayout>
