---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Krankenversicherung-Rechner - Tarife vergleichen";
const description = "Vergleichen Sie Krankenversicherungstarife durch Analyse von Beitr&auml;gen, Eigenbehalten, Zuzahlungen und Selbstbeteiligungsmax. bei verschiedenen Nutzungsgraden.";

const relatedCalcs = [
  { name: "Lebensversicherung-Rechner", url: "/de/lebensversicherung-rechner", description: "Lebensschutz-Bedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Haushaltsplanung." },
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallfonds." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Krankenversicherung-Rechner"
  keywords="krankenversicherung rechner, tarife vergleichen, pr&auml;mie, selbstbeteiligung, zuzahlung, krankenkasse kosten"
  breadcrumbs={[{ name: "Krankenversicherung-Rechner", url: "/de/krankenversicherung-rechner" }]}
  lang="de"
  enSlug="health-insurance-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Krankenversicherung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Krankenversicherungstarife durch Schätzung der j&auml;hrlichen Gesamtkosten bei niedrigem, mittlerem und hohem Nutzungsgrad.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Monatlicher Beitrag (&euro;)</label>
            <input type="number" id="kvrde-premium" class="kvrde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="350" min="0" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Selbstbeteiligung (&euro;)</label>
            <input type="number" id="kvrde-deductible" class="kvrde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="500" min="0" step="50">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zuzahlung pro Arztbesuch (&euro;)</label>
            <input type="number" id="kvrde-copay" class="kvrde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="0" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Eigenanteil nach Selbstbeteiligung (%)</label>
            <input type="number" id="kvrde-coinsurance" class="kvrde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="20" min="0" max="100" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jahres-Eigenanteil-Maximum (&euro;)</label>
            <input type="number" id="kvrde-oopmax" class="kvrde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="3000" min="0" step="250">
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">J&auml;hrliche Kosten (mittlere Nutzung)</div>
            <div class="text-5xl font-extrabold font-mono" id="kvrde-medium">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Geringe Nutzung</div>
              <div class="text-xl font-bold text-green-600" id="kvrde-low">0 &euro;</div>
              <div class="text-xs text-text-muted">2 Besuche, keine gro&szlig;en Leistungen</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Hohe Nutzung</div>
              <div class="text-xl font-bold text-red-600" id="kvrde-high">0 &euro;</div>
              <div class="text-xs text-text-muted">H&auml;ufige Besuche + Operation</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">J&auml;hrliche Beitr&auml;ge</div>
              <div class="text-xl font-bold" id="kvrde-annual-premium">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Max. m&ouml;gliche Kosten</div>
              <div class="text-xl font-bold text-orange-600" id="kvrde-worst">0 &euro;</div>
            </div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="krankenversicherung-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Krankenversicherungstarife vergleichen</h2>
      <p>Niedrigere Beitr&auml;ge bedeuten oft h&ouml;here Selbstbeteiligungen und Eigenkosten. Ber&uuml;cksichtigen Sie Ihre erwartete Inanspruchnahme: Gesunde k&ouml;nnten Hochselbstbehalts-Tarife bevorzugen, w&auml;hrend Personen mit chronischen Erkrankungen von niedrigeren Eigenbehalten profitieren.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen GKV und PKV?</strong> Die gesetzliche Krankenversicherung (GKV) bietet Pflichtschutz mit einkommensabh&auml;ngigen Beitr&auml;gen. Die private Krankenversicherung (PKV) bietet individuelle Tarife mit meist besseren Leistungen, aber risikobased Pr&auml;mien.</p>
      <p><strong>Was ist eine Selbstbeteiligung?</strong> Die Selbstbeteiligung ist der Betrag, den Sie vor Einsetzen der Versicherungsleistung selbst zahlen m&uuml;ssen. H&ouml;here Selbstbeteiligung bedeutet niedrigere Beitr&auml;ge, aber mehr Eigenrisiko.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmtKVR = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcKVRDE() {
      const premium = parseFloat((document.getElementById('kvrde-premium') as HTMLInputElement).value) || 0;
      const deductible = parseFloat((document.getElementById('kvrde-deductible') as HTMLInputElement).value) || 0;
      const copay = parseFloat((document.getElementById('kvrde-copay') as HTMLInputElement).value) || 0;
      const coinsurance = (parseFloat((document.getElementById('kvrde-coinsurance') as HTMLInputElement).value) || 0) / 100;
      const oopMax = parseFloat((document.getElementById('kvrde-oopmax') as HTMLInputElement).value) || 0;

      const annualPremium = premium * 12;

      const lowServices = 500;
      const lowCopays = 2 * copay;
      const lowAfterDed = Math.max(0, lowServices - deductible);
      const lowCoins = lowAfterDed * coinsurance;
      const lowOOP = Math.min(oopMax, lowCopays + Math.min(deductible, lowServices) + lowCoins);
      const lowTotal = annualPremium + lowOOP;

      const medServices = 5000;
      const medCopays = 6 * copay;
      const medAfterDed = Math.max(0, medServices - deductible);
      const medCoins = medAfterDed * coinsurance;
      const medOOP = Math.min(oopMax, medCopays + Math.min(deductible, medServices) + medCoins);
      const medTotal = annualPremium + medOOP;

      const highServices = 30000;
      const highCopays = 15 * copay;
      const highAfterDed = Math.max(0, highServices - deductible);
      const highCoins = highAfterDed * coinsurance;
      const highOOP = Math.min(oopMax, highCopays + Math.min(deductible, highServices) + highCoins);
      const highTotal = annualPremium + highOOP;

      const worstCase = annualPremium + oopMax;

      document.getElementById('kvrde-medium')!.textContent = fmtKVR(medTotal);
      document.getElementById('kvrde-low')!.textContent = fmtKVR(lowTotal);
      document.getElementById('kvrde-high')!.textContent = fmtKVR(highTotal);
      document.getElementById('kvrde-annual-premium')!.textContent = fmtKVR(annualPremium);
      document.getElementById('kvrde-worst')!.textContent = fmtKVR(worstCase);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['kvrde-premium', 'kvrde-deductible', 'kvrde-copay', 'kvrde-coinsurance', 'kvrde-oopmax'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcKVRDE); el.addEventListener('change', calcKVRDE); }
      });
      calcKVRDE();
    }, 50);
  </script>
</CalculatorLayout>
