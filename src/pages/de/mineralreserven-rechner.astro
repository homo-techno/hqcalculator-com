---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mineralreserven Rechner - JORC & NI 43-101 Ressourcen";
const description = "Berechnen Sie Mineralreserven und Ressourcen nach JORC-Code und NI 43-101. Tonnage, Gehalt, enthaltenes Metall und wirtschaftlichen Wert ermitteln.";

const relatedCalcs = [
  { name: "Bergbaukosten Rechner", url: "/de/bergbau-kosten-rechner", description: "Betriebskosten schätzen." },
  { name: "Mineral-Bestimmung Rechner", url: "/de/mineral-bestimmung-rechner", description: "Mineralien bestimmen." },
  { name: "Mohs-Härte Rechner", url: "/de/mohs-haerte-rechner", description: "Mineralien vergleichen." },
  { name: "Dichte-Rechner", url: "/de/dichterechner", description: "Dichte berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mineral-reserves-calculator" calculatorName="Mineralreserven Rechner" keywords="Mineralreserven, Mineralressourcen, JORC Code, NI 43-101, Tonnage, Metallgehalt, Bergbau" breadcrumbs={[{ name: "Mineralreserven Rechner", url: "/de/mineralreserven-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mineralreserven Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie enthaltenes Metall, Ressourcentonnage und wirtschaftlichen Wert eines Mineralvorkommens nach internationalen Standards (JORC/NI 43-101).</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Volumen (Millionen m³)</label>
            <input type="number" id="mr-volume" class="mr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Rohdichte (t/m³)</label>
            <input type="number" id="mr-density" class="mr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0.1" value="2.8">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Metallgehalt (%)</label>
            <input type="number" id="mr-grade" class="mr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.01" min="0" value="1.5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Metallpreis (€/t)</label>
            <input type="number" id="mr-price" class="mr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0" value="6500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewinnungsrate (%)</label>
            <input type="number" id="mr-recovery" class="mr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" max="100" value="85">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Betriebskosten (€/t Erz)</label>
            <input type="number" id="mr-opex" class="mr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" value="35">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Klassifikation</label>
          <select id="mr-class" class="mr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold bg-white">
            <option value="gemessen">Gemessen (Measured)</option>
            <option value="angezeigt" selected>Angezeigt (Indicated)</option>
            <option value="abgeleitet">Abgeleitet (Inferred)</option>
          </select>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Enthaltenes Metall</div>
          <div class="text-5xl font-extrabold font-mono" id="mr-result">— t</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamttonnage (Mt)</div>
            <div class="text-xl font-bold" id="mr-tonnage">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewinnbares Metall (t)</div>
            <div class="text-xl font-bold" id="mr-recoverable">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bruttowert (Mio. €)</div>
            <div class="text-xl font-bold" id="mr-gross">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Nettowert (Mio. €)</div>
            <div class="text-xl font-bold" id="mr-net">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnung</h3>
          <div class="font-mono text-sm space-y-1" id="mr-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mineral-reserves" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mineralressourcen und -reserven nach JORC/NI 43-101</h2>
      <p>Die Klassifikation von Mineralvorkommen nach JORC Code (Australien/international) oder NI 43-101 (Kanada) unterscheidet zwischen Ressourcen (Measured, Indicated, Inferred) und Reserven (Proven, Probable). Reserven sind der wirtschaftlich gewinnbare Teil der Ressourcen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Tonnage (t) = Volumen (m³) × Dichte (t/m³)</p>
        <p>Enthaltenes Metall = Tonnage × Gehalt / 100</p>
        <p>Gewinnbares Metall = Enthaltenes Metall × Gewinnungsrate / 100</p>
        <p>Bruttowert = Gewinnbares Metall × Metallpreis</p>
        <p>Nettowert = Bruttowert - (Tonnage × Betriebskosten)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen Ressource und Reserve?</p>
          <p>Eine Ressource ist ein Vorkommen mit geologisch belegten Mengen und Gehalten. Eine Reserve ist der Teil der Ressource, der unter aktuellen wirtschaftlichen und technischen Bedingungen profitabel abgebaut werden kann.</p>
        </div>
        <div>
          <p class="font-semibold">Was bedeuten Measured, Indicated und Inferred?</p>
          <p>Measured (gemessen): höchste Konfidenz, dichtes Beprobungsraster. Indicated (angezeigt): mittlere Konfidenz. Inferred (abgeleitet): geringste Konfidenz, weitständige Probennahme. Nur Measured und Indicated können zu Reserven werden.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist der Cut-off-Gehalt?</p>
          <p>Der Cut-off-Gehalt ist der minimale Metallgehalt, bei dem ein Erzkörper noch wirtschaftlich abgebaut werden kann. Er hängt von Metallpreis, Betriebskosten und Gewinnungsrate ab.</p>
        </div>
        <div>
          <p class="font-semibold">Wie wird der Metallgehalt angegeben?</p>
          <p>Goldgehalt wird typischerweise in Gramm pro Tonne (g/t) angegeben, Basismetalle (Kupfer, Zink) in Prozent (%). Dieser Rechner verwendet Prozent; für Gold müssen Sie g/t durch 1.000.000 × 100 umrechnen.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcMr() {
      const volume = parseFloat((document.getElementById('mr-volume') as HTMLInputElement).value) || 0;
      const density = parseFloat((document.getElementById('mr-density') as HTMLInputElement).value) || 0;
      const grade = parseFloat((document.getElementById('mr-grade') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('mr-price') as HTMLInputElement).value) || 0;
      const recovery = parseFloat((document.getElementById('mr-recovery') as HTMLInputElement).value) || 0;
      const opex = parseFloat((document.getElementById('mr-opex') as HTMLInputElement).value) || 0;

      const fmt = (v: number, dec = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });

      const tonnage = volume * 1e6 * density;
      const containedMetal = tonnage * grade / 100;
      const recoverableMetal = containedMetal * recovery / 100;
      const grossValue = recoverableMetal * price;
      const totalOpex = tonnage * opex;
      const netValue = grossValue - totalOpex;

      const steps: string[] = [];
      steps.push(`Tonnage = ${volume} Mio. m³ × ${density} t/m³ = ${fmt(tonnage / 1e6, 2)} Mt`);
      steps.push(`Enthaltenes Metall = ${fmt(tonnage / 1e6, 2)} Mt × ${grade}% = ${fmt(containedMetal, 0)} t`);
      steps.push(`Gewinnbar = ${fmt(containedMetal, 0)} t × ${recovery}% = ${fmt(recoverableMetal, 0)} t`);
      steps.push(`Bruttowert = ${fmt(recoverableMetal, 0)} t × ${fmt(price, 0)} €/t = ${fmt(grossValue / 1e6, 1)} Mio. €`);
      steps.push(`Nettowert = ${fmt(grossValue / 1e6, 1)} - ${fmt(totalOpex / 1e6, 1)} Mio. € = ${fmt(netValue / 1e6, 1)} Mio. €`);

      document.getElementById('mr-result')!.textContent = fmt(containedMetal, 0) + ' t';
      document.getElementById('mr-tonnage')!.textContent = fmt(tonnage / 1e6, 2) + ' Mt';
      document.getElementById('mr-recoverable')!.textContent = fmt(recoverableMetal, 0) + ' t';
      document.getElementById('mr-gross')!.textContent = fmt(grossValue / 1e6, 1) + ' Mio. €';
      const netEl = document.getElementById('mr-net')!;
      netEl.textContent = fmt(netValue / 1e6, 1) + ' Mio. €';
      netEl.className = `text-xl font-bold ${netValue >= 0 ? 'text-green-600' : 'text-red-600'}`;
      document.getElementById('mr-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.mr-in').forEach(el => {
        el.addEventListener('input', calcMr);
        el.addEventListener('change', calcMr);
      });
      calcMr();
    }, 50);
  </script>
</CalculatorLayout>
