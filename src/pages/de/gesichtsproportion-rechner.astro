---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gesichtsproportion-Rechner - Goldener Schnitt & Symmetrie-Analyse";
const description = "Analysieren Sie Gesichtsproportionen mit dem Goldenen Schnitt (Phi = 1,618). Messen Sie Gesichtsdrittel, Augenabstand und Symmetrie.";
const relatedCalcs = [
  { name: "Wimpernverlängerung", url: "/de/wimpernverlaengerung-rechner", description: "Wimpern-Berechnung." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge und Goldener Schnitt." },
  { name: "Mode-Aufschlag", url: "/de/mode-aufschlag-rechner", description: "Mode-Preiskalkulation." },
  { name: "Stoff-Rechner", url: "/de/stoff-rechner", description: "Stoffbedarf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gesichtsproportion-Rechner" lang="de" enSlug="facial-proportion-calculator" keywords="gesichtsproportionen, goldener schnitt, phi, gesichtssymmetrie, gesichtsdrittel, schönheitsverhältnis" breadcrumbs={[{ name: "Gesichtsproportion", url: "/de/gesichtsproportion-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gesichtsproportion-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie Ihre Gesichtsproportionen im Vergleich zum Goldenen Schnitt und den idealen Gesichtsdritteln.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <p class="text-xs text-text-muted">Geben Sie die Maße in Zentimetern ein. Verwenden Sie ein Lineal oder Maßband an einem frontal aufgenommenen Foto für beste Genauigkeit.</p>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesichtslänge (Haaransatz bis Kinn)</label><input type="number" id="gpde-length" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="5" max="35" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gesichtsbreite (breiteste Stelle)</label><input type="number" id="gpde-width" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="13" min="5" max="25" step="0.1"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Oberes Drittel (Haaransatz-Brauen)</label><input type="number" id="gpde-upper" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="15" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Mittleres Drittel (Brauen-Nasenansatz)</label><input type="number" id="gpde-middle" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="15" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Unteres Drittel (Nasenansatz-Kinn)</label><input type="number" id="gpde-lower" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="15" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Augenbreite (ein Auge)</label><input type="number" id="gpde-eye" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.8" min="0.5" max="6" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Augenabstand</label><input type="number" id="gpde-intereye" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0.5" max="6" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Nasenbreite</label><input type="number" id="gpde-nose" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.2" min="0.5" max="8" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Mundbreite</label><input type="number" id="gpde-mouth" class="gpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="10" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Goldener-Schnitt-Bewertung</div>
          <div class="text-5xl font-extrabold font-mono" id="gpde-score">0%</div>
          <div class="text-sm text-blue-200 mt-1">N&auml;he zu Phi (1,618)</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesichtsverh&auml;ltnis (L/B)</div><div class="text-xl font-bold" id="gpde-faceratio">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ideales Verh&auml;ltnis</div><div class="text-xl font-bold">1,618</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Drittel-Balance</div><div class="text-xl font-bold" id="gpde-thirds">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Augenabstand</div><div class="text-xl font-bold" id="gpde-eyespace">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Proportionsanalyse</h3>
          <div class="text-sm space-y-1" id="gpde-analysis"></div>
        </div>
      </div>
      <ShareButton calculatorId="facial-proportion-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Der Goldene Schnitt in der Gesichts&auml;sthetik</h2>
      <p>Der Goldene Schnitt (Phi = 1,618) wird seit langem mit Gesichtssch&ouml;nheit in Verbindung gebracht. Idealerweise n&auml;hert sich das Verh&auml;ltnis von Gesichtsl&auml;nge zu -breite 1,618. Das Gesicht sollte sich in drei gleiche vertikale Drittel teilen. Der Augenabstand sollte einer Augenbreite entsprechen. Diese sind Richtlinien, keine Absolutwerte &ndash; Sch&ouml;nheit ist vielf&auml;ltig und subjektiv.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Ist der Goldene Schnitt wissenschaftlich belegt?</strong> Die Forschung zeigt, dass Gesichter, die dem Goldenen Schnitt näherkommen, oft als attraktiver bewertet werden. Schönheit ist jedoch immer subjektiv.</p>
      <p><strong>Wie messe ich mein Gesicht korrekt?</strong> Verwenden Sie ein gerades Frontalfoto und messen Sie mit einem Lineal auf dem Bildschirm oder drucken Sie das Foto aus.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGPDE() {
      const PHI = 1.618;
      const length = parseFloat((document.getElementById('gpde-length') as HTMLInputElement).value) || 1;
      const width = parseFloat((document.getElementById('gpde-width') as HTMLInputElement).value) || 1;
      const upper = parseFloat((document.getElementById('gpde-upper') as HTMLInputElement).value) || 1;
      const middle = parseFloat((document.getElementById('gpde-middle') as HTMLInputElement).value) || 1;
      const lower = parseFloat((document.getElementById('gpde-lower') as HTMLInputElement).value) || 1;
      const eyeW = parseFloat((document.getElementById('gpde-eye') as HTMLInputElement).value) || 1;
      const interEye = parseFloat((document.getElementById('gpde-intereye') as HTMLInputElement).value) || 1;
      const noseW = parseFloat((document.getElementById('gpde-nose') as HTMLInputElement).value) || 1;
      const mouthW = parseFloat((document.getElementById('gpde-mouth') as HTMLInputElement).value) || 1;
      const faceRatio = length / width;
      const faceRatioDev = Math.abs(faceRatio - PHI) / PHI;
      const avgThird = (upper + middle + lower) / 3;
      const thirdsDev = (Math.abs(upper - avgThird) + Math.abs(middle - avgThird) + Math.abs(lower - avgThird)) / (3 * avgThird);
      const eyeSpacingDev = Math.abs(interEye - eyeW) / eyeW;
      const noseEyeDev = Math.abs(noseW - interEye) / interEye;
      const mouthEyeRatio = mouthW / (eyeW * 2);
      const mouthDev = Math.abs(mouthEyeRatio - 1.0);
      const avgDev = (faceRatioDev + thirdsDev + eyeSpacingDev * 0.5 + noseEyeDev * 0.3 + mouthDev * 0.3) / 2.1;
      const score = Math.max(0, Math.min(100, (1 - avgDev) * 100));
      let thirdsLabel = 'Ausgewogen';
      if (thirdsDev > 0.15) thirdsLabel = 'Unausgewogen';
      else if (thirdsDev > 0.08) thirdsLabel = 'Leicht ungleich';
      let eyeSpaceLabel = 'Ideal';
      if (eyeSpacingDev > 0.2) eyeSpaceLabel = interEye > eyeW ? 'Weit stehend' : 'Eng stehend';
      else if (eyeSpacingDev > 0.1) eyeSpaceLabel = interEye > eyeW ? 'Leicht weit' : 'Leicht eng';
      const analysis: string[] = [];
      analysis.push('Gesichtsverhältnis L:B = ' + faceRatio.toFixed(3) + ' (ideal: 1,618)');
      if (faceRatio > PHI) analysis.push('Das Gesicht ist etwas länger als das Goldener-Schnitt-Ideal.');
      else if (faceRatio < PHI) analysis.push('Das Gesicht ist etwas breiter als das Goldener-Schnitt-Ideal.');
      else analysis.push('Das Gesichtsverhältnis entspricht dem Goldenen Schnitt sehr genau.');
      analysis.push('Oberes Drittel: ' + upper.toFixed(1) + ' cm | Mitte: ' + middle.toFixed(1) + ' cm | Unten: ' + lower.toFixed(1) + ' cm');
      if (upper > middle && upper > lower) analysis.push('Das obere Drittel ist am längsten - hohe Stirn.');
      else if (lower > upper && lower > middle) analysis.push('Das untere Drittel ist am längsten - prominenter Kinnbereich.');
      analysis.push('Nasenbreite (' + noseW.toFixed(1) + ') vs. Augenabstand (' + interEye.toFixed(1) + '): ' + (Math.abs(noseW - interEye) < 0.5 ? 'gut angepasst' : 'Unterschied vorhanden'));
      analysis.push('Mundbreite (' + mouthW.toFixed(1) + ') ist ' + (mouthW > eyeW * 2 ? 'breiter' : 'schmaler') + ' als zwei Augenbreiten (' + (eyeW * 2).toFixed(1) + ')');
      document.getElementById('gpde-score')!.textContent = score.toFixed(1) + '%';
      document.getElementById('gpde-faceratio')!.textContent = faceRatio.toFixed(3);
      document.getElementById('gpde-thirds')!.textContent = thirdsLabel;
      document.getElementById('gpde-eyespace')!.textContent = eyeSpaceLabel;
      document.getElementById('gpde-analysis')!.innerHTML = analysis.map(a => '<p>' + a + '</p>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gpde-in').forEach(el => { el.addEventListener('input', calcGPDE); el.addEventListener('change', calcGPDE); });
      calcGPDE();
    }, 50);
  </script>
</CalculatorLayout>
