---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hunde-Bewegung-Rechner - Taeglicher Bedarf & Spaziergaenge 2026";
const description = "Berechne den taeglichen Bewegungsbedarf deines Hundes nach Rasse, Alter und Groesse. Spaziergangdauer, Kalorienverbrauch und Aktivitaetsempfehlungen.";

const relatedCalcs = [
  { name: "Hundefutter-Rechner", url: "/de/hundefutter-rechner", description: "Taegliche Futterportionen." },
  { name: "Hunde-BMI-Rechner", url: "/de/hunde-bmi-rechner", description: "Koerperkondition Hund." },
  { name: "Hundealter-Rechner", url: "/de/hundealter-rechner", description: "Hundejahre umrechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Menschlicher Kalorienbedarf." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hunde-Bewegung-Rechner" keywords="Hunde Bewegung Rechner, Spaziergang Dauer Hund, Bewegungsbedarf Hund, Kalorien Gassi gehen, taegliche Aktivitaet Hund" breadcrumbs={[{ name: "Hunde-Bewegung", url: "/de/hunde-bewegung-rechner" }]} lang="de" enSlug="dog-exercise-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hunde-Bewegung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finde heraus, wie viel Bewegung dein Hund taeglich braucht, basierend auf Rassetyp, Alter und Groesse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht des Hundes (kg)</label><input type="number" id="hbew-weight" class="hbew-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="1" max="120" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Energie-Level der Rasse</label>
            <select id="hbew-energy" class="hbew-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="low">Niedrig (Bulldogge, Basset)</option>
              <option value="moderate" selected>Mittel (Labrador, Golden R.)</option>
              <option value="high">Hoch (Border Collie, Husky)</option>
              <option value="very_high">Sehr hoch (Pointer, Vizsla)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Alter</label>
            <select id="hbew-age" class="hbew-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="puppy">Welpe (&lt;1 J.)</option>
              <option value="young">Jung (1-3 J.)</option>
              <option value="adult" selected>Erwachsen (3-7 J.)</option>
              <option value="senior">Senior (7+ J.)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Gesundheitszustand</label>
            <select id="hbew-health" class="hbew-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="healthy" selected>Gesund</option>
              <option value="overweight">Uebergewichtig</option>
              <option value="limited">Gelenk-/Gesundheitsprobleme</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Taegliche Bewegung benoetigt</div>
          <div class="text-5xl font-extrabold font-mono" id="hbew-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spaziergangdauer</div><div class="text-xl font-bold font-mono" id="hbew-walk">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spazierg. / Tag</div><div class="text-xl font-bold font-mono" id="hbew-walks">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Distanz (km)</div><div class="text-xl font-bold font-mono" id="hbew-dist">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien verbrannt</div><div class="text-xl font-bold font-mono" id="hbew-cal">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktives Spielen</div><div class="text-xl font-bold font-mono" id="hbew-play">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Woechentlich gesamt</div><div class="text-xl font-bold font-mono" id="hbew-weekly">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dog-exercise" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Bewegungsbedarf beim Hund</h2>
      <p>Die meisten Hunde brauchen 30-120 Minuten Bewegung pro Tag. Welpen brauchen kuerzere, haeufigere Spieleinheiten. Senioren profitieren von sanften, regelmaessigen Spaziergaengen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie viel Bewegung braucht ein Welpe?</strong> Die Faustregel ist 5 Minuten Bewegung pro Lebensmonat, zweimal taeglich. Ein 4 Monate alter Welpe braucht also 2 x 20 Minuten.</p>
      <p><strong>Was zaehlt als Bewegung?</strong> Spaziergaenge, Laufen, Schwimmen, Apportieren, Hundesport und interaktives Spielen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHBEW() {
      const weight = parseFloat((document.getElementById('hbew-weight') as HTMLInputElement).value) || 0;
      const energy = (document.getElementById('hbew-energy') as HTMLSelectElement).value;
      const age = (document.getElementById('hbew-age') as HTMLSelectElement).value;
      const health = (document.getElementById('hbew-health') as HTMLSelectElement).value;

      const baseMins: Record<string, number> = { low: 30, moderate: 60, high: 90, very_high: 120 };
      const ageAdj: Record<string, number> = { puppy: 0.6, young: 1.2, adult: 1.0, senior: 0.6 };
      const healthAdj: Record<string, number> = { healthy: 1.0, overweight: 0.85, limited: 0.5 };

      const totalMins = (baseMins[energy] || 60) * (ageAdj[age] || 1.0) * (healthAdj[health] || 1.0);
      const walkMins = totalMins * 0.6;
      const numWalks = totalMins >= 60 ? 2 : 2;
      const perWalk = Math.round(walkMins / numWalks);
      const walkHours = walkMins / 60;
      const distanceKm = walkHours * 4.8;
      const calBurned = Math.round(1.76 * weight * distanceKm);
      const playMins = Math.round(totalMins * 0.4);
      const weeklyHours = (totalMins * 7) / 60;

      document.getElementById('hbew-result')!.textContent = Math.round(totalMins) + ' Min';
      document.getElementById('hbew-walk')!.textContent = perWalk + ' Min je';
      document.getElementById('hbew-walks')!.textContent = numWalks.toString();
      document.getElementById('hbew-dist')!.textContent = distanceKm.toFixed(1).replace('.', ',');
      document.getElementById('hbew-cal')!.textContent = calBurned + ' kcal';
      document.getElementById('hbew-play')!.textContent = playMins + ' Min';
      document.getElementById('hbew-weekly')!.textContent = weeklyHours.toFixed(1).replace('.', ',') + ' Std';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hbew-in').forEach(el => { el.addEventListener('input', calcHBEW); el.addEventListener('change', calcHBEW); });
      calcHBEW();
    }, 50);
  </script>
</CalculatorLayout>
