---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Seemeilen Rechner - Seemeilen, Kilometer & Meilen konvertieren";
const description = "Konvertieren Sie Seemeilen, Kilometer und Meilen und berechnen Sie Schifffahrtsdistanzen und Fahrtzeiten.";
const relatedCalcs = [
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Bewegungsprofil Rechner", url: "/de/bewegungsprofil-rechner", description: "Kinematik berechnen." },
  { name: "Netzwerk-Latenz Rechner", url: "/de/netzwerk-latenz-rechner", description: "Latenz berechnen." },
  { name: "Ankerketten Rechner", url: "/de/ankerketten-rechner", description: "Ankerkette berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Seemeilen Rechner" enSlug="nautical-mile-calculator" keywords="Seemeilen, nautische Meilen, Kilometer, Meilen, Schifffahrt, Knotenrechner, Fahrtzeit" breadcrumbs={[{ name: "Seemeilen Rechner", url: "/de/seemeilen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Seemeilen Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Konvertieren Sie zwischen Seemeilen (nm), Kilometern (km) und Meilen (mi). Berechnen Sie Fahrtzeiten auf See bei gegebener Geschwindigkeit in Knoten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Eingabewert</label>
          <input type="number" id="sm-input" class="sm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" step="0.1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Eingabeeinheit</label>
          <select id="sm-unit" class="sm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="nm">Seemeilen (nm)</option>
            <option value="km">Kilometer (km)</option>
            <option value="mi">Meilen (mi)</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Geschwindigkeit (Knoten)</label><input type="number" id="sm-speed" class="sm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0.1" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ergebnis in Seemeilen</div>
          <div class="text-5xl font-extrabold font-mono" id="sm-result">0,00 nm</div>
          <div class="text-sm text-blue-200 mt-1" id="sm-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">In Kilometern</div><div class="text-xl font-bold" id="sm-km">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">In Meilen</div><div class="text-xl font-bold" id="sm-mi">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fahrtzeit</div><div class="text-xl font-bold" id="sm-time">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Knoten in km/h</div><div class="text-xl font-bold" id="sm-kph">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="seemeilen" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Seemeilen und nautische Einheiten</h2>
      <p>Eine Seemeile entspricht genau 1.852 Metern und ist international die Standardeinheit für Entfernungen in der Schifffahrt und Luftfahrt. Sie leitet sich von einer Bogenminute des Erdmeridians ab. Ein Knoten ist eine Seemeile pro Stunde (1 kn = 1,852 km/h).</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>1 Seemeile (nm) = 1,852 km = 1,1508 Meilen</p>
        <p>1 Knoten (kn) = 1,852 km/h</p>
        <p>Fahrtzeit (h) = Distanz (nm) / Geschwindigkeit (kn)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Warum verwendet die Schifffahrt Seemeilen?</strong></p><p>Seemeilen sind direkt mit geografischen Koordinaten verknüpft. Eine Bogensekunde Breitengrad entspricht einer Seemeile, was die Navigation vereinfacht.</p></div>
        <div><p><strong>Was ist ein Knoten?</strong></p><p>Ein Knoten (kn) ist die Einheit für Geschwindigkeit auf See: 1 Knoten = 1 Seemeile pro Stunde = 1,852 km/h.</p></div>
        <div><p><strong>Wie lange dauert eine Überfahrt von Hamburg nach New York?</strong></p><p>Die Distanz beträgt ca. 3.400 nm. Bei 20 Knoten (Containerschiff) dauert die Fahrt ca. 170 Stunden (7 Tage).</p></div>
        <div><p><strong>Was ist eine Kabellänge?</strong></p><p>Eine Kabellänge beträgt 1/10 Seemeile = 185,2 m. Sie wird in der Küstennavigation verwendet.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const NM_TO_KM = 1.852;
    const NM_TO_MI = 1.15078;
    function calcSM() {
      const input = parseFloat((document.getElementById('sm-input') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('sm-unit') as HTMLSelectElement).value;
      const speed = parseFloat((document.getElementById('sm-speed') as HTMLInputElement).value) || 8;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      let nm: number;
      if (unit === 'nm') nm = input;
      else if (unit === 'km') nm = input / NM_TO_KM;
      else nm = input / NM_TO_MI;
      const km = nm * NM_TO_KM;
      const mi = nm * NM_TO_MI;
      const timeH = speed > 0 ? nm / speed : 0;
      const days = Math.floor(timeH / 24);
      const hours = Math.floor(timeH % 24);
      const minutes = Math.round((timeH % 1) * 60);
      const timeStr = days > 0
        ? days + ' T ' + hours + ' Std ' + minutes + ' Min'
        : hours + ' Std ' + minutes + ' Min';
      document.getElementById('sm-result')!.textContent = fmt(nm) + ' nm';
      document.getElementById('sm-sub')!.textContent = 'Bei ' + speed + ' kn Fahrtzeit: ' + timeStr;
      document.getElementById('sm-km')!.textContent = fmt(km) + ' km';
      document.getElementById('sm-mi')!.textContent = fmt(mi) + ' mi';
      document.getElementById('sm-time')!.textContent = timeStr;
      document.getElementById('sm-kph')!.textContent = fmt(speed * NM_TO_KM) + ' km/h';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sm-in').forEach(el => { el.addEventListener('input', calcSM); el.addEventListener('change', calcSM); });
      calcSM();
    }, 50);
  </script>
</CalculatorLayout>
