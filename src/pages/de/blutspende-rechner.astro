---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blutspenderechner - Berechtigung & nächster Spendetermin";
const description = "Prüfen Sie Ihre Blutspende-Berechtigung basierend auf letztem Spendedatum und Spendetyp. Zeigt nächsten zulässigen Termin, Spenden pro Jahr und Lebenszeit-Wirkung.";
const relatedCalcs = [
  { name: "Blutvolumenrechner", url: "/de/blutvolumen-rechner", description: "Geschätztes Blutvolumen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Körperwasserrechner", url: "/de/koerperwasser-rechner", description: "Gesamtkörperwasser." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Blutspenderechner" lang="de" keywords="blutspende, blut spenden, berechtigung, thrombozytentspende, plasmaspende, spendehäufigkeit" breadcrumbs={[{ name: "Blutspende", url: "/de/blutspende-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blutspenderechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erfahren Sie, wann Sie das nächste Mal spenden können und welchen Einfluss Ihre Spenden haben.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Spendetyp</label>
          <select id="bd-type" class="bd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="whole" selected>Vollblut</option>
            <option value="platelets">Thrombozyten (Apherese)</option>
            <option value="plasma">Plasma</option>
            <option value="double-red">Doppel-Erythrozyten</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Letzte Spende</label><input type="date" id="bd-date" class="bd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ihr Alter</label><input type="number" id="bd-age" class="bd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="16" max="80" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nächste Spende möglich</div>
          <div class="text-5xl font-extrabold font-mono" id="bd-next">--</div>
          <div class="text-sm text-blue-200 mt-1" id="bd-status"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wartezeit</div><div class="text-xl font-bold" id="bd-wait">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spenden/Jahr</div><div class="text-xl font-bold" id="bd-peryear">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gerettete Leben/Jahr</div><div class="text-xl font-bold" id="bd-lives">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lebenslang Spenden</div><div class="text-xl font-bold" id="bd-lifetime">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gerettete Leben gesamt</div><div class="text-xl font-bold" id="bd-totlives">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Spendeintervalle</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Vollblut</span><span class="font-bold">56 Tage (8 Wochen)</span></div>
            <div class="flex justify-between"><span>Thrombozyten</span><span class="font-bold">7 Tage (bis zu 24/Jahr)</span></div>
            <div class="flex justify-between"><span>Plasma</span><span class="font-bold">28 Tage</span></div>
            <div class="flex justify-between"><span>Doppel-Erythrozyten</span><span class="font-bold">112 Tage (16 Wochen)</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="blood-donation" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Fakten zur Blutspende</h2>
      <p>Eine Vollblutspende kann bis zu 3 Leben retten. Berechtigte Spender können alle 56 Tage Vollblut spenden (ca. 6-mal pro Jahr). Thrombozyten können alle 7 Tage gespendet werden (bis zu 24-mal/Jahr). Jede Thrombozytenspende kann bis zu 3 Patienten helfen. Das maximale Spendealter liegt typischerweise bei 65-70 Jahren.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const donationIntervals: Record<string, {days: number; perYear: number; livesPerDonation: number}> = {
      whole: { days: 56, perYear: 6, livesPerDonation: 3 },
      platelets: { days: 7, perYear: 24, livesPerDonation: 3 },
      plasma: { days: 28, perYear: 13, livesPerDonation: 1 },
      'double-red': { days: 112, perYear: 3, livesPerDonation: 2 },
    };
    function fmtDonDate(d: Date): string {
      return d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }
    function calcBD() {
      const type = (document.getElementById('bd-type') as HTMLSelectElement).value;
      const dateStr = (document.getElementById('bd-date') as HTMLInputElement).value;
      const age = parseInt((document.getElementById('bd-age') as HTMLInputElement).value) || 30;
      const info = donationIntervals[type];
      if (!dateStr) {
        document.getElementById('bd-next')!.textContent = '--';
        document.getElementById('bd-status')!.textContent = 'Geben Sie Ihr letztes Spendedatum ein';
        document.getElementById('bd-wait')!.textContent = info.days + ' Tage';
        document.getElementById('bd-peryear')!.textContent = info.perYear.toString();
        document.getElementById('bd-lives')!.textContent = (info.perYear * info.livesPerDonation).toString();
        const yearsLeft = Math.max(0, 65 - age);
        document.getElementById('bd-lifetime')!.textContent = (info.perYear * yearsLeft).toString();
        document.getElementById('bd-totlives')!.textContent = (info.perYear * yearsLeft * info.livesPerDonation).toString();
        document.dispatchEvent(new CustomEvent('calc-update'));
        return;
      }
      const lastDate = new Date(dateStr + 'T00:00:00');
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const nextDate = new Date(lastDate.getTime() + info.days * 86400000);
      const daysUntil = Math.ceil((nextDate.getTime() - today.getTime()) / 86400000);
      if (daysUntil <= 0) {
        document.getElementById('bd-next')!.textContent = 'Jetzt berechtigt!';
        document.getElementById('bd-status')!.textContent = 'Sie können heute spenden';
      } else {
        document.getElementById('bd-next')!.textContent = fmtDonDate(nextDate);
        document.getElementById('bd-status')!.textContent = daysUntil + ' Tage bis zur Berechtigung';
      }
      document.getElementById('bd-wait')!.textContent = info.days + ' Tage';
      document.getElementById('bd-peryear')!.textContent = info.perYear.toString();
      document.getElementById('bd-lives')!.textContent = (info.perYear * info.livesPerDonation).toString();
      const yearsLeft = Math.max(0, 65 - age);
      document.getElementById('bd-lifetime')!.textContent = (info.perYear * yearsLeft).toString();
      document.getElementById('bd-totlives')!.textContent = (info.perYear * yearsLeft * info.livesPerDonation).toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      const today = new Date();
      const thirtyDaysAgo = new Date(today.getTime() - 30 * 86400000);
      const y = thirtyDaysAgo.getFullYear();
      const m = String(thirtyDaysAgo.getMonth() + 1).padStart(2, '0');
      const d = String(thirtyDaysAgo.getDate()).padStart(2, '0');
      (document.getElementById('bd-date') as HTMLInputElement).value = y + '-' + m + '-' + d;
      document.querySelectorAll('.bd-in').forEach(el => { el.addEventListener('input', calcBD); el.addEventListener('change', calcBD); });
      calcBD();
    }, 50);
  </script>
</CalculatorLayout>
