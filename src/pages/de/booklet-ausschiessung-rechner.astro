---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Booklet-Ausschießung-Rechner - Seitenlayout & Signaturordnung";
const description = "Berechnen Sie das Ausschießungs-Layout für Booklet-Druck inkl. Signaturen, Bogenanzahl, Seitenreihenfolge und Creep-Kompensation.";
const relatedCalcs = [
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Boolesche-Algebra-Rechner", url: "/de/boolesche-algebra-rechner", description: "Logik-Operationen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwerte." },
  { name: "Bäckerprozent-Rechner", url: "/de/baeckerprozent-rechner", description: "Bäckerprozente." },
  { name: "Batteriespeicher-Rechner", url: "/de/batteriespeicher-rechner", description: "Speicher-Rechner." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Booklet-Ausschießung-Rechner" enSlug="booklet-imposition-calculator" keywords="Booklet Ausschießung, Seitenlayout, Signatur, Rückstichheftung, Seitenreihenfolge, Drucklayout, Bogenanzahl" breadcrumbs={[{ name: "Booklet-Ausschießung-Rechner", url: "/de/booklet-ausschiessung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Booklet-Ausschießung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Seitenausschießung für Rückstichheftung-Booklets. Sehen Sie die Seitenreihenfolge pro Bogen, Signaturanzahl und Bogenanzahl.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesamtseitenzahl (Inhalt)</label><input type="number" id="ba2-pages" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="4" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Seiten pro Signatur</label>
            <select id="ba2-sig" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="4">4 (1 Bogen, Einfachfalz)</option>
              <option value="8">8 (2 Bögen)</option>
              <option value="16">16 (4 Bögen, Standard)</option>
              <option value="32">32 (8 Bögen)</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Bindemethode</label>
          <select id="ba2-bind" class="ba2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="saddle">Rückstichheftung (einzelne Signatur)</option>
            <option value="perfect">Klebebindung (mehrere Signaturen)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Bögen gesamt</div>
          <div class="text-5xl font-extrabold font-mono" id="ba2-result">0</div>
          <div class="text-sm text-blue-200 mt-1" id="ba2-subtitle"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Angepasste Seiten</div><div class="text-xl font-bold" id="ba2-adjpages">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Signaturen</div><div class="text-xl font-bold" id="ba2-sigs">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leerseiten</div><div class="text-xl font-bold" id="ba2-blanks">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Seiten pro Bogen</div><div class="text-xl font-bold" id="ba2-pps">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Ausschießungs-Reihenfolge (Bogenlayout)</h3>
          <div class="font-mono text-sm space-y-1 max-h-64 overflow-y-auto" id="ba2-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="booklet-ausschiessung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Grundlagen der Booklet-Ausschießung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Rückstichheftung: Alle Seiten in einer Signatur, gefalzt und geheftet.</p>
        <p>Seitenanzahl muss ein Vielfaches von 4 sein (jeder Bogen hat 4 Seitenpositionen).</p>
        <p>Bogen-Vorderseite: letzte Seite + erste Seite (außen), 2. + vorletzte (innen).</p>
        <p>Klebebindung: Mehrere Signaturen zusammengetragen und am Rücken geklebt.</p>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBA2() {
      const contentPages = parseFloat((document.getElementById('ba2-pages') as HTMLInputElement).value) || 0;
      const sigSize = parseFloat((document.getElementById('ba2-sig') as HTMLSelectElement).value) || 4;
      const bind = (document.getElementById('ba2-bind') as HTMLSelectElement).value;
      let totalPages = contentPages;
      if (bind === 'saddle') {
        totalPages = Math.ceil(contentPages / 4) * 4;
      } else {
        totalPages = Math.ceil(contentPages / sigSize) * sigSize;
      }
      const blanks = totalPages - contentPages;
      const sheets = totalPages / 4;
      const sigs = bind === 'saddle' ? 1 : Math.ceil(totalPages / sigSize);
      const sheetsPerSig = sigSize / 4;
      const steps: string[] = [];
      if (bind === 'saddle') {
        steps.push('R\u00fcckstichheftung (einzelne Signatur):');
        steps.push('Angepasst auf ' + totalPages + ' Seiten (' + blanks + ' leer)');
        steps.push('');
        for (let s = 0; s < sheets; s++) {
          const frontLeft = totalPages - (s * 2);
          const frontRight = (s * 2) + 1;
          const backLeft = (s * 2) + 2;
          const backRight = totalPages - (s * 2) - 1;
          const fl = frontLeft > contentPages ? 'leer' : 'S' + frontLeft;
          const fr = frontRight > contentPages ? 'leer' : 'S' + frontRight;
          const bl = backLeft > contentPages ? 'leer' : 'S' + backLeft;
          const br = backRight > contentPages ? 'leer' : 'S' + backRight;
          steps.push('Bogen ' + (s+1) + ' Vorne: [' + fl + ' | ' + fr + ']');
          steps.push('Bogen ' + (s+1) + ' Hinten: [' + bl + ' | ' + br + ']');
        }
      } else {
        steps.push('Klebebindung (' + sigs + ' Signaturen \u00e0 ' + sigSize + ' Seiten):');
        steps.push('Angepasst auf ' + totalPages + ' Seiten (' + blanks + ' leer)');
        steps.push('');
        for (let sig = 0; sig < sigs; sig++) {
          const sigStart = sig * sigSize;
          const sigSheets = sigSize / 4;
          steps.push('--- Signatur ' + (sig+1) + ' ---');
          for (let s = 0; s < sigSheets; s++) {
            const fL = sigStart + sigSize - (s * 2);
            const fR = sigStart + (s * 2) + 1;
            const bL = sigStart + (s * 2) + 2;
            const bR = sigStart + sigSize - (s * 2) - 1;
            const fl = fL > contentPages ? 'leer' : 'S' + fL;
            const fr = fR > contentPages ? 'leer' : 'S' + fR;
            const bl = bL > contentPages ? 'leer' : 'S' + bL;
            const br = bR > contentPages ? 'leer' : 'S' + bR;
            steps.push('  Bogen ' + (s+1) + ' V: [' + fl + ' | ' + fr + '] H: [' + bl + ' | ' + br + ']');
          }
        }
      }
      document.getElementById('ba2-result')!.textContent = sheets.toString();
      document.getElementById('ba2-subtitle')!.textContent = totalPages + ' Seiten auf ' + sheets + ' B\u00f6gen';
      document.getElementById('ba2-adjpages')!.textContent = totalPages.toString();
      document.getElementById('ba2-sigs')!.textContent = sigs.toString();
      document.getElementById('ba2-blanks')!.textContent = blanks.toString();
      document.getElementById('ba2-pps')!.textContent = '4 (2 pro Seite)';
      document.getElementById('ba2-steps')!.innerHTML = steps.map(s => '<div>' + (s || '&nbsp;') + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ba2-pages') as HTMLInputElement).value = '24';
      document.querySelectorAll('.ba2-in').forEach(el => { el.addEventListener('input', calcBA2); el.addEventListener('change', calcBA2); });
      calcBA2();
    }, 50);
  </script>
</CalculatorLayout>
