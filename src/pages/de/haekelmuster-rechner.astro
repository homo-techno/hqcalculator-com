---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Haekelmuster-Rechner - Maschenanzahl & Garnbedarf";
const description = "Berechnen Sie Luftmaschen- und Maschenanzahl fuer Rechtecke und Kreise, Garnbedarf und Nadelgroessen-Empfehlungen nach Garnstaerke.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Flaechenrechner", url: "/de/flaechenrechner", description: "Flaechen berechnen." },
  { name: "Verhaeltnisrechner", url: "/de/verhaeltnis-rechner", description: "Verhaeltnisse." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitte." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
  { name: "Quadratmeterrechner", url: "/de/quadratmeterrechner", description: "Flaeche berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Haekelmuster-Rechner" keywords="Haekelmuster Rechner, Maschenanzahl, Luftmaschen, Garnbedarf, Nadelgroesse, Haekeln Kreis, Haekeln Rechteck" breadcrumbs={[{ name: "Haekelmuster-Rechner", url: "/de/haekelmuster-rechner" }]} lang="de" enSlug="crochet-pattern-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Haekelmuster-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Maschenanzahl, Garnbedarf und Nadelgroessen fuer Ihre Haekelprojekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Projektform</label>
            <select id="hmr-shape" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="rect" selected>Rechteck / Quadrat</option>
              <option value="circle">Kreis</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Garnstaerke</label>
            <select id="hmr-weight" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1">Fingering (#1)</option>
              <option value="2">Sport (#2)</option>
              <option value="3">DK (#3)</option>
              <option value="4" selected>Worsted (#4)</option>
              <option value="5">Bulky (#5)</option>
              <option value="6">Super Bulky (#6)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Breite / Durchmesser (cm)</label><input type="number" id="hmr-w" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hoehe / Laenge (cm)</label><input type="number" id="hmr-h" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Maschenprobe: Maschen pro 10 cm</label><input type="number" id="hmr-gst" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="14" min="4" max="40" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Maschenprobe: Reihen pro 10 cm</label><input type="number" id="hmr-grow" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="4" max="40" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Meter pro Knaeuel</label><input type="number" id="hmr-mps" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="10" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Knaeuel (EUR)</label><input type="number" id="hmr-price" class="hmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Start-Luftmaschen</div>
          <div class="text-4xl font-extrabold font-mono" id="hmr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reihen gesamt</div><div class="text-xl font-bold font-mono" id="hmr-rows">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Maschen gesamt</div><div class="text-xl font-bold font-mono" id="hmr-totalsts">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nadelgroesse</div><div class="text-xl font-bold font-mono" id="hmr-hook">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Garnbedarf</div><div class="text-xl font-bold font-mono" id="hmr-yarn">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Knaeuel</div><div class="text-xl font-bold font-mono" id="hmr-skeins">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten</div><div class="text-xl font-bold font-mono" id="hmr-cost">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="crochet-pattern" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haekelprojekte planen</h2>
      <p>Die richtige Maschenprobe ist der Schluessel zu einem gelungenen Haekelprojekt. Haekeln Sie immer eine Maschenprobe von mindestens 10 x 10 cm, bevor Sie mit dem Projekt beginnen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Wie berechne ich die Luftmaschen?</strong> Teilen Sie die gewuenschte Breite durch die Maschenprobe und addieren Sie 1 fuer die Wendemasche.</li>
        <li><strong>Wie viel Garn brauche ich?</strong> Das haengt von der Garnstaerke und Projektgroesse ab. Dieser Rechner schaetzt den Bedarf mit 10 % Puffer.</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcHMR() {
      const shape = (document.getElementById('hmr-shape') as HTMLSelectElement).value;
      const wt = parseInt((document.getElementById('hmr-weight') as HTMLSelectElement).value);
      const w = parseFloat((document.getElementById('hmr-w') as HTMLInputElement).value) || 30;
      const h = parseFloat((document.getElementById('hmr-h') as HTMLInputElement).value) || 30;
      const gst = parseFloat((document.getElementById('hmr-gst') as HTMLInputElement).value) || 14;
      const grow = parseFloat((document.getElementById('hmr-grow') as HTMLInputElement).value) || 10;
      const mps = parseFloat((document.getElementById('hmr-mps') as HTMLInputElement).value) || 200;
      const price = parseFloat((document.getElementById('hmr-price') as HTMLInputElement).value) || 0;

      const spcm = gst / 10;
      const rpcm = grow / 10;

      const hookSizes: Record<number, string> = {
        1: '2,25-2,75 mm', 2: '3,25-3,5 mm',
        3: '3,5-4,5 mm', 4: '5-5,5 mm',
        5: '6-6,5 mm', 6: '8-9 mm'
      };

      let chainCount: number, totalRows: number, totalStitches: number;

      if (shape === 'rect') {
        chainCount = Math.round(spcm * w) + 1;
        totalRows = Math.round(rpcm * h);
        totalStitches = chainCount * totalRows;
      } else {
        const radius = w / 2;
        const rounds = Math.round(rpcm * radius);
        chainCount = 4;
        totalRows = rounds;
        totalStitches = 0;
        for (let r = 1; r <= rounds; r++) {
          totalStitches += 6 * r;
        }
      }

      const mPerStitch: Record<number, number> = { 1: 0.036, 2: 0.046, 3: 0.055, 4: 0.064, 5: 0.082, 6: 0.11 };
      const meterFactor = mPerStitch[wt] || 0.064;
      const yarnMeters = totalStitches * meterFactor * 1.1;
      const skeins = Math.ceil(yarnMeters / mps);
      const cost = skeins * price;

      document.getElementById('hmr-result')!.textContent = chainCount + ' Luftmaschen';
      document.getElementById('hmr-rows')!.textContent = totalRows.toString();
      document.getElementById('hmr-totalsts')!.textContent = totalStitches.toLocaleString('de-DE');
      document.getElementById('hmr-hook')!.textContent = hookSizes[wt] || '--';
      document.getElementById('hmr-yarn')!.textContent = Math.round(yarnMeters) + ' m';
      document.getElementById('hmr-skeins')!.textContent = skeins.toString();
      document.getElementById('hmr-cost')!.textContent = cost.toFixed(2).replace('.', ',') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hmr-in').forEach(el => { el.addEventListener('input', calcHMR); el.addEventListener('change', calcHMR); });
      calcHMR();
    }, 50);
  </script>
</CalculatorLayout>
