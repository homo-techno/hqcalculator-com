---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hex zu RGB Rechner - Farbcode Konverter 2026";
const description = "Konvertiere Hex-Farbcodes in RGB- und HSL-Werte mit Live-Farbvorschau. Inklusive CSS-Werte und Farbanalyse.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Erweiterte Berechnungen." },
  { name: "Taschenrechner", url: "/de/taschenrechner", description: "Einfache Berechnungen." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hex zu RGB Rechner" keywords="Hex zu RGB, Farbkonverter, Hex Farbe, RGB Werte, HSL Konverter, Farbvorschau, CSS Farben" breadcrumbs={[{ name: "Hex zu RGB Rechner", url: "/de/hex-zu-rgb-rechner" }]} lang="de" enSlug="hex-to-rgb-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hex zu RGB Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Gib einen Hex-Farbcode ein und erhalte RGB- und HSL-Werte mit Live-Farbvorschau.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Hex-Farbcode</label>
          <input type="text" id="hzr-hex" class="hzr-in w-full px-4 py-2 border border-border rounded-xl text-lg font-mono" value="#3B82F6" placeholder="#3B82F6" />
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Farbvorschau</div>
          <div id="hzr-swatch" class="w-32 h-32 rounded-xl mx-auto border-4 border-white/30 shadow-lg" style="background-color: #3B82F6;"></div>
          <div class="text-2xl font-extrabold font-mono mt-3" id="hzr-result">#3B82F6</div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Rot (R)</div>
            <div class="text-xl font-bold" id="hzr-r">59</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gruen (G)</div>
            <div class="text-xl font-bold" id="hzr-g">130</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Blau (B)</div>
            <div class="text-xl font-bold" id="hzr-b">246</div>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Farbton (H)</div>
            <div class="text-xl font-bold" id="hzr-h">217&deg;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Saettigung (S)</div>
            <div class="text-xl font-bold" id="hzr-s">91%</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Helligkeit (L)</div>
            <div class="text-xl font-bold" id="hzr-l">60%</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">CSS-Werte</h3>
          <div class="text-sm text-text-secondary font-mono whitespace-pre-wrap" id="hzr-css"></div>
        </div>
      </div>

      <ShareButton calculatorId="hex-to-rgb" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Farbcode-Formate</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Hex:</strong> #RRGGBB (z.B. #FF5733)</p>
        <p><strong>RGB:</strong> rgb(R, G, B) wobei jeder Wert 0-255 ist</p>
        <p><strong>HSL:</strong> hsl(H, S%, L%) wobei H 0-360 ist</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist ein Hex-Farbcode?</strong> Ein Hex-Farbcode ist eine sechsstellige hexadezimale Darstellung einer Farbe, bestehend aus je zwei Stellen fuer Rot, Gruen und Blau.</p>
      <p><strong>Wann verwende ich RGB vs HSL?</strong> RGB wird haeufig in digitaler Grafik verwendet, HSL ist intuitiver fuer Farbmanipulation, da Farbton, Saettigung und Helligkeit direkt einstellbar sind.</p>
      <p><strong>Was bedeutet #FFFFFF?</strong> Weiss – alle drei Kanaele (Rot, Gruen, Blau) haben den Maximalwert 255.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHZR() {
      let hex = (document.getElementById('hzr-hex') as HTMLInputElement).value.trim();
      hex = hex.replace(/^#/, '');

      if (/^[0-9A-Fa-f]{3}$/.test(hex)) {
        hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
      }

      if (!/^[0-9A-Fa-f]{6}$/.test(hex)) {
        document.getElementById('hzr-result')!.textContent = 'Ungueltig';
        document.getElementById('hzr-r')!.textContent = '—';
        document.getElementById('hzr-g')!.textContent = '—';
        document.getElementById('hzr-b')!.textContent = '—';
        document.getElementById('hzr-h')!.textContent = '—';
        document.getElementById('hzr-s')!.textContent = '—';
        document.getElementById('hzr-l')!.textContent = '—';
        document.getElementById('hzr-css')!.textContent = '';
        document.dispatchEvent(new CustomEvent('calc-update'));
        return;
      }

      const r = parseInt(hex.substring(0, 2), 16);
      const g = parseInt(hex.substring(2, 4), 16);
      const b = parseInt(hex.substring(4, 6), 16);

      const rN = r / 255, gN = g / 255, bN = b / 255;
      const max = Math.max(rN, gN, bN);
      const min = Math.min(rN, gN, bN);
      const l = (max + min) / 2;
      let h = 0, s = 0;

      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        if (max === rN) h = ((gN - bN) / d + (gN < bN ? 6 : 0)) / 6;
        else if (max === gN) h = ((bN - rN) / d + 2) / 6;
        else h = ((rN - gN) / d + 4) / 6;
      }

      const hDeg = Math.round(h * 360);
      const sPct = Math.round(s * 100);
      const lPct = Math.round(l * 100);
      const fullHex = '#' + hex.toUpperCase();

      document.getElementById('hzr-result')!.textContent = fullHex;
      (document.getElementById('hzr-swatch') as HTMLElement).style.backgroundColor = fullHex;
      document.getElementById('hzr-r')!.textContent = String(r);
      document.getElementById('hzr-g')!.textContent = String(g);
      document.getElementById('hzr-b')!.textContent = String(b);
      document.getElementById('hzr-h')!.innerHTML = hDeg + '&deg;';
      document.getElementById('hzr-s')!.textContent = sPct + '%';
      document.getElementById('hzr-l')!.textContent = lPct + '%';

      let css = 'Hex:  ' + fullHex + '\n';
      css += 'RGB:  rgb(' + r + ', ' + g + ', ' + b + ')\n';
      css += 'RGBA: rgba(' + r + ', ' + g + ', ' + b + ', 1.0)\n';
      css += 'HSL:  hsl(' + hDeg + ', ' + sPct + '%, ' + lPct + '%)\n';
      css += 'HSLA: hsla(' + hDeg + ', ' + sPct + '%, ' + lPct + '%, 1.0)';
      document.getElementById('hzr-css')!.textContent = css;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hzr-in').forEach(el => {
        el.addEventListener('input', calcHZR);
        el.addEventListener('change', calcHZR);
      });
      calcHZR();
    }, 50);
  </script>
</CalculatorLayout>
