---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fastenrechner - Intervallfasten Timer";
const description = "Berechnen Sie Intervallfasten-Fenster für 16:8, 18:6, 20:4 und OMAD-Protokolle. Verfolgen Sie Fastenphasen und Zeitplanung.";
const relatedCalcs = [
  { name: "Finanzielle Unabhängigkeit", url: "/de/finanzielle-unabhaengigkeit-rechner", description: "FIRE-Planung." },
  { name: "Feuer-Rechner", url: "/de/feuer-rechner", description: "FIRE-Rechner." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
  { name: "Dünger-Rechner", url: "/de/duenger-rechner", description: "Düngerbedarf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fastenrechner" lang="de" enSlug="fasting-calculator" keywords="intervallfasten, 16:8, 18:6, 20:4, OMAD, fasten timer, essensfenster" breadcrumbs={[{ name: "Fastenrechner", url: "/de/fastenrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fastenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihren Intervallfasten-Zeitplan und verfolgen Sie die Fastenphasen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Fastenprotokoll</label>
          <select id="fade-proto" class="fade-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="16" selected>16:8 (16h fasten, 8h essen)</option>
            <option value="18">18:6 (18h fasten, 6h essen)</option>
            <option value="20">20:4 (20h fasten, 4h essen)</option>
            <option value="23">OMAD (23h fasten, 1h essen)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fastenbeginn</label><input type="time" id="fade-start" class="fade-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20:00"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fastenstunden</label><input type="number" id="fade-hours" class="fade-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="16" min="1" max="72" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Essensfenster &ouml;ffnet</div>
          <div class="text-5xl font-extrabold font-mono" id="fade-end">--:--</div>
          <div class="text-sm text-blue-200 mt-1" id="fade-window"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Essensfenster</div><div class="text-xl font-bold" id="fade-eat">8h</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fasten endet</div><div class="text-xl font-bold" id="fade-endtime">--:--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fenster schlie&szlig;t</div><div class="text-xl font-bold" id="fade-close">--:--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Fastenphasen</h3>
          <div class="space-y-2 text-sm" id="fade-stages"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Protokoll-Vergleich</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>16:8</span><span class="font-bold">Anf&auml;ngerfreundlich</span></div>
            <div class="flex justify-between"><span>18:6</span><span class="font-bold">Moderat</span></div>
            <div class="flex justify-between"><span>20:4</span><span class="font-bold">Fortgeschritten</span></div>
            <div class="flex justify-between"><span>OMAD</span><span class="font-bold">Expertenlevel</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="fasting-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Intervallfasten</h2>
      <p>Intervallfasten wechselt zwischen Essens- und Fastenperioden. W&auml;hrend des Fastens wechselt der K&ouml;rper von Glukosenutzung zur Fettverbrennung. Wichtige Stoffwechselphasen: Blutzuckerstabilisierung (4-8h), Fettverbrennung (12-14h), Ketose (16-18h) und Autophagie (24h+). Konsultieren Sie immer einen Arzt, bevor Sie mit dem Fasten beginnen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welches Protokoll ist für Anfänger geeignet?</strong> Das 16:8-Protokoll ist am einfachsten zu beginnen, da das Essensfenster 8 Stunden beträgt.</p>
      <p><strong>Darf man während des Fastens trinken?</strong> Ja - Wasser, schwarzer Kaffee und ungesüßter Tee sind erlaubt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function fmtTimeFADE(h: number, m: number): string {
      const hh = ((h % 24) + 24) % 24;
      return String(hh).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ' Uhr';
    }
    function setProtoFADE() {
      const proto = (document.getElementById('fade-proto') as HTMLSelectElement).value;
      if (proto !== 'custom') {
        (document.getElementById('fade-hours') as HTMLInputElement).value = proto;
      }
      calcFADE();
    }
    function calcFADE() {
      const startStr = (document.getElementById('fade-start') as HTMLInputElement).value;
      const fastHours = parseInt((document.getElementById('fade-hours') as HTMLInputElement).value) || 16;
      const parts = startStr.split(':');
      const startH = parseInt(parts[0]) || 0;
      const startM = parseInt(parts[1]) || 0;
      const eatHours = 24 - fastHours;
      const endH = (startH + fastHours) % 24;
      const closeH = (endH + eatHours) % 24;
      document.getElementById('fade-end')!.textContent = fmtTimeFADE(endH, startM);
      document.getElementById('fade-window')!.textContent = fmtTimeFADE(endH, startM) + ' - ' + fmtTimeFADE(closeH, startM);
      document.getElementById('fade-eat')!.textContent = eatHours + 'h';
      document.getElementById('fade-endtime')!.textContent = fmtTimeFADE(endH, startM);
      document.getElementById('fade-close')!.textContent = fmtTimeFADE(closeH, startM);
      const stages = [
        { hour: 0, name: 'Gesättigt', desc: 'Blutzucker steigt, Insulin wird ausgeschüttet' },
        { hour: 4, name: 'Post-absorptiv', desc: 'Blutzucker beginnt zu sinken' },
        { hour: 12, name: 'Fettverbrennung', desc: 'Glykogen erschöpft, Fettoxidation steigt' },
        { hour: 16, name: 'Frühe Ketose', desc: 'Ketonproduktion beginnt' },
        { hour: 18, name: 'Ketose', desc: 'Fett ist primäre Energiequelle' },
        { hour: 24, name: 'Autophagie', desc: 'Zelluläres Recycling und Reparatur' },
        { hour: 48, name: 'Tiefe Autophagie', desc: 'Verstärkte zelluläre Reinigung' },
      ];
      let html = '';
      for (const s of stages) {
        if (s.hour <= fastHours) {
          const active = 'font-bold text-primary';
          html += '<div class="flex justify-between ' + active + '"><span>' + s.hour + 'h - ' + s.name + '</span><span>' + s.desc + '</span></div>';
        }
      }
      document.getElementById('fade-stages')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('fade-proto')!.addEventListener('change', setProtoFADE);
      document.querySelectorAll('.fade-in').forEach(el => { el.addEventListener('input', calcFADE); el.addEventListener('change', calcFADE); });
      calcFADE();
    }, 50);
  </script>
</CalculatorLayout>
