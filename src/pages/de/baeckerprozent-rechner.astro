---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bäckerprozent-Rechner - Zutatenverhältnisse nach Mehlgewicht";
const description = "Berechnen Sie Bäckerprozente für jedes Brot- oder Gebäckrezept. Alle Zutatengewichte als Prozentsatz des Gesamtmehlgewichts.";
const relatedCalcs = [
  { name: "Brotmehl-Rechner", url: "/de/brotmehl-rechner", description: "Mehlprotein und Substitution." },
  { name: "Brot-Hydration-Rechner", url: "/de/brot-hydration-rechner", description: "Teig-Hydration visualisieren." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Alkohol-Kalorien-Rechner", url: "/de/alkohol-kalorien-rechner", description: "Getränke-Kalorien." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglicher Kalorienbedarf." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Bäckerprozent-Rechner" enSlug="baker-percentage-calculator" keywords="Bäckerprozent, Brotrezept, Mehlgewicht Verhältnis, Backmathematik, Teigrezept Skalierung" breadcrumbs={[{ name: "Bäckerprozent-Rechner", url: "/de/baeckerprozent-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bäckerprozent-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Ihr Mehlgewicht und die Zutatengewichte ein, um die Bäckerprozente zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gesamtmehlgewicht (g)</label>
          <input type="number" id="bp-flour" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="1" step="1">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wasser (g)</label><input type="number" id="bp-water" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="650" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Salz (g)</label><input type="number" id="bp-salt" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hefe (g)</label><input type="number" id="bp-yeast" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zucker (g)</label><input type="number" id="bp-sugar" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fett/Öl (g)</label><input type="number" id="bp-fat" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstiges (g)</label><input type="number" id="bp-other" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Hydration</div>
          <div class="text-5xl font-extrabold font-mono" id="bp-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mehl</div><div class="text-xl font-bold font-mono" id="bp-flour-pct">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser %</div><div class="text-xl font-bold font-mono" id="bp-water-pct">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Salz %</div><div class="text-xl font-bold font-mono" id="bp-salt-pct">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hefe %</div><div class="text-xl font-bold font-mono" id="bp-yeast-pct">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zucker %</div><div class="text-xl font-bold font-mono" id="bp-sugar-pct">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fett %</div><div class="text-xl font-bold font-mono" id="bp-fat-pct">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gesamtteiggewicht</div>
          <div class="text-xl font-bold font-mono" id="bp-total">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="baeckerprozent" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was sind Bäckerprozente?</h2>
      <p>Bei Bäckerprozenten wird jede Zutat als Prozentsatz des Gesamtmehlgewichts angegeben. Das Mehl ist immer 100%. So lassen sich Rezepte einfach skalieren und vergleichen. Eine Hydration von 65% bedeutet z.B., dass auf 1000g Mehl 650g Wasser kommen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBP() {
      const flour = parseFloat((document.getElementById('bp-flour') as HTMLInputElement).value) || 0;
      const water = parseFloat((document.getElementById('bp-water') as HTMLInputElement).value) || 0;
      const salt = parseFloat((document.getElementById('bp-salt') as HTMLInputElement).value) || 0;
      const yeast = parseFloat((document.getElementById('bp-yeast') as HTMLInputElement).value) || 0;
      const sugar = parseFloat((document.getElementById('bp-sugar') as HTMLInputElement).value) || 0;
      const fat = parseFloat((document.getElementById('bp-fat') as HTMLInputElement).value) || 0;
      const other = parseFloat((document.getElementById('bp-other') as HTMLInputElement).value) || 0;
      if (flour <= 0) {
        document.getElementById('bp-result')!.textContent = 'Mehlgewicht eingeben';
        return;
      }
      const waterPct = (water / flour) * 100;
      const saltPct = (salt / flour) * 100;
      const yeastPct = (yeast / flour) * 100;
      const sugarPct = (sugar / flour) * 100;
      const fatPct = (fat / flour) * 100;
      const total = flour + water + salt + yeast + sugar + fat + other;
      document.getElementById('bp-result')!.textContent = waterPct.toFixed(1) + '%';
      document.getElementById('bp-flour-pct')!.textContent = '100%';
      document.getElementById('bp-water-pct')!.textContent = waterPct.toFixed(1) + '%';
      document.getElementById('bp-salt-pct')!.textContent = saltPct.toFixed(2) + '%';
      document.getElementById('bp-yeast-pct')!.textContent = yeastPct.toFixed(2) + '%';
      document.getElementById('bp-sugar-pct')!.textContent = sugarPct.toFixed(1) + '%';
      document.getElementById('bp-fat-pct')!.textContent = fatPct.toFixed(1) + '%';
      document.getElementById('bp-total')!.textContent = total.toFixed(0) + ' g';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bp-in').forEach(el => { el.addEventListener('input', calcBP); el.addEventListener('change', calcBP); });
      calcBP();
    }, 50);
  </script>
</CalculatorLayout>
