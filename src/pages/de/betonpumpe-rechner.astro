---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Betonpumpen-Rechner - Leitungsgr\u00f6\u00dfe & F\u00f6rderleistung";
const description = "Berechnen Sie Betonpumpen-Leitungsgr\u00f6\u00dfe, F\u00f6rderleistung und Pumpendruck. Sch\u00e4tzen Sie die Pumpzeit basierend auf Volumen, Entfernung und H\u00f6he.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Betonplattenrechner", url: "/de/betonplatte-rechner", description: "Plattenvolumen." },
  { name: "Betonmischungsrechner", url: "/de/betonmischung-rechner", description: "Mischungsentwurf." },
  { name: "Betonschalungsrechner", url: "/de/betonschalung-rechner", description: "Schalung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Betonpumpen-Rechner" lang="de" enSlug="concrete-pump-calculator" keywords="betonpumpe rechner, pumpenleitungsgr\u00f6\u00dfe, f\u00f6rderleistung, autobetonpumpe, leitungspumpe, betonf\u00f6rderung" breadcrumbs={[{ name: "Betonpumpe", url: "/de/betonpumpe-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Betonpumpen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Leitungsgr&ouml;&szlig;e, F&ouml;rderleistung und Pumpzeit f&uuml;r Ihre Betonage.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Pumpentyp</label>
          <select id="bp-type" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="boom" selected>Autobetonpumpe (Mastpumpe)</option>
            <option value="line">Leitungspumpe (Anh&auml;ngerpumpe)</option>
            <option value="stationary">Station&auml;rpumpe (Hochhausbau)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-2">Gesamtvolumen (m&sup3;)</label><input type="number" id="bp-volume" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="1" step="1"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-2">Horizontale Entfernung (m)</label><input type="number" id="bp-horiz" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="5"></div>
          <div><label class="block text-sm font-medium text-text mb-2">Vertikale H&ouml;he (m)</label><input type="number" id="bp-vert" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="1"></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Leitungsdurchmesser</label>
          <select id="bp-line" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="80">DN 80 (kleine Leitungspumpe)</option>
            <option value="100" selected>DN 100 (Standard)</option>
            <option value="125">DN 125 (Autobetonpumpe / gro&szlig;)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-2">Ausbreitma&szlig; (cm)</label><input type="number" id="bp-slump" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="30" max="60" step="1"></div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Pumpzeit</div>
          <div class="text-4xl font-extrabold" id="bp-time">0 Std.</div>
          <div class="text-sm text-blue-200 mt-1">bei <span id="bp-rate">0</span> m&sup3;/h F&ouml;rderleistung</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">F&ouml;rderleistung</div><div class="text-xl font-bold" id="bp-output">0 m&sup3;/h</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pumpendruck</div><div class="text-xl font-bold" id="bp-pressure">0 bar</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Auml;quivalente L&auml;nge</div><div class="text-xl font-bold" id="bp-eqlen">0 m</div><div class="text-xs text-text-muted">horiz. + vert. &auml;quivalent</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mischfahrzeuge (7 m&sup3;)</div><div class="text-xl font-bold" id="bp-trucks">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfohlene Nenndruckstufe</div><div class="text-xl font-bold" id="bp-rating">- bar</div></div>
      </div>
      <ShareButton calculatorId="concrete-pump" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Richtlinien zur Betonf&ouml;rderung</h2>
      <ul>
        <li><strong>Autobetonpumpe:</strong> 60-120 m&sup3;/h, Reichweite bis 60+ m</li>
        <li><strong>Leitungspumpe:</strong> 15-60 m&sup3;/h, ideal f&uuml;r ebenerdige Betonagen</li>
        <li><strong>Vertikale &Auml;quivalenz:</strong> 1 m vertikal = 3 m horizontal f&uuml;r Druckverlust</li>
        <li><strong>Mindest-Ausbreitma&szlig;:</strong> 42-50 cm zum Pumpen; Flie&szlig;mittel kann helfen</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBP() {
      const pumpType = (document.getElementById('bp-type') as HTMLSelectElement).value;
      const volume = parseFloat((document.getElementById('bp-volume') as HTMLInputElement).value) || 0;
      const horiz = parseFloat((document.getElementById('bp-horiz') as HTMLInputElement).value) || 0;
      const vert = parseFloat((document.getElementById('bp-vert') as HTMLInputElement).value) || 0;
      const lineDiam = parseFloat((document.getElementById('bp-line') as HTMLSelectElement).value) || 100;
      const slump = parseFloat((document.getElementById('bp-slump') as HTMLInputElement).value) || 45;
      const eqLen = horiz + vert * 3;
      let baseRate = 50;
      if (pumpType === 'boom') baseRate = 90;
      else if (pumpType === 'line') baseRate = 40;
      else if (pumpType === 'stationary') baseRate = 60;
      const diamFactor = Math.pow(lineDiam / 100, 2);
      const distFactor = Math.max(0.3, 1 - (eqLen / 30) * 0.05);
      const slumpFactor = Math.max(0.6, 0.7 + (slump / 10) * 0.06);
      const outputRate = baseRate * diamFactor * distFactor * slumpFactor;
      const pumpTime = volume / outputRate;
      const pressurePerM = 0.1 * Math.pow(100 / lineDiam, 2);
      const pressureBar = eqLen * pressurePerM + 3;
      const trucks = Math.ceil(volume / 7);
      const ratingBar = Math.ceil(pressureBar * 1.5 / 5) * 5;
      document.getElementById('bp-time')!.textContent = pumpTime.toFixed(1).replace('.', ',') + ' Std.';
      document.getElementById('bp-rate')!.textContent = outputRate.toFixed(0);
      document.getElementById('bp-output')!.textContent = outputRate.toFixed(0) + ' m\u00B3/h';
      document.getElementById('bp-pressure')!.textContent = pressureBar.toFixed(0) + ' bar';
      document.getElementById('bp-eqlen')!.textContent = Math.round(eqLen) + ' m';
      document.getElementById('bp-trucks')!.textContent = String(trucks);
      document.getElementById('bp-rating')!.textContent = ratingBar + ' bar';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bp-in').forEach(el => { el.addEventListener('input', calcBP); el.addEventListener('change', calcBP); });
      calcBP();
    }, 50);
  </script>
</CalculatorLayout>
