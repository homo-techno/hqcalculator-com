---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kühlturm-Rechner - Kapazität, Grädigkeit & Wasserdurchfluss";
const description = "Berechnen Sie Kühlturmkapazität, Grädigkeit, Spreizung, Verdunstungsrate und Nachspeisewasser-Bedarf aus den Auslegungsdaten.";
const relatedCalcs = [
  { name: "Kühllast-Rechner", url: "/de/kuehllast-rechner", description: "Gebäude-Kühllast." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kühlturm-Rechner" enSlug="cooling-tower-calculator" keywords="Kühlturm Rechner, Kühlturmkapazität, Grädigkeit, Spreizung, Verdunstungsrate, Nachspeisewasser, Kühlwasser" breadcrumbs={[{ name: "Kühlturm-Rechner", url: "/de/kuehlturm-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kühlturm-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kühlturmkapazität, Grädigkeit, Spreizung und Wasserbedarf.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Warmwassertemp. (°F)</label>
            <input type="number" id="ct2-hot" class="ct2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="95" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Kaltwassertemp. (°F)</label>
            <input type="number" id="ct2-cold" class="ct2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="85" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Feuchtkugeltemp. (°F)</label>
            <input type="number" id="ct2-wb" class="ct2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="78" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Wasserdurchfluss (GPM)</label>
            <input type="number" id="ct2-gpm" class="ct2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="1" step="10">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Eindickungszahl</label>
            <input type="number" id="ct2-cycles" class="ct2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="2" max="10" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Schwadenverlust (%)</label>
            <input type="number" id="ct2-drift" class="ct2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.02" min="0" max="1" step="0.01">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Turmkapazität</div>
          <div class="text-4xl font-extrabold" id="ct2-capacity">--</div>
          <div class="text-sm text-blue-200 mt-1">Nominale Tonnen</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Spreizung</div>
            <div class="text-xl font-bold" id="ct2-range">--</div>
            <div class="text-xs text-text-muted">°F</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Grädigkeit</div>
            <div class="text-xl font-bold" id="ct2-approach">--</div>
            <div class="text-xs text-text-muted">°F</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wärmeabfuhr</div>
            <div class="text-xl font-bold" id="ct2-btu">--</div>
            <div class="text-xs text-text-muted">BTU/h</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Verdunstungsrate</div>
            <div class="text-xl font-bold" id="ct2-evap">--</div>
            <div class="text-xs text-text-muted">GPM</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Abschlämmung</div>
            <div class="text-xl font-bold" id="ct2-blow">--</div>
            <div class="text-xs text-text-muted">GPM</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ges. Nachspeisewasser</div>
            <div class="text-xl font-bold" id="ct2-makeup">--</div>
            <div class="text-xs text-text-muted">GPM</div>
          </div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="cooling-tower" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl mx-auto prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Kühlturm-Berechnungen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Spreizung = Warmwassertemp. - Kaltwassertemp.</p>
        <p>Grädigkeit = Kaltwassertemp. - Feuchtkugeltemp.</p>
        <p>Wärmeabfuhr = GPM x 500 x Spreizung (BTU/h)</p>
        <p>Nominale Tonnen = Wärmeabfuhr / 15.000</p>
        <p>Verdunstung = GPM x Spreizung x 0,001 (ca.)</p>
      </div>
      <ul>
        <li><strong>Spreizung:</strong> Temperaturabfall des Wassers im Kühlturm (typisch 10°F)</li>
        <li><strong>Grädigkeit:</strong> Wie nah die Kaltwassertemperatur an die Feuchtkugeltemperatur kommt (typisch 5-10°F)</li>
        <li>Eine nominale Kühlturm-Tonne entspricht 15.000 BTU/h (nicht 12.000 BTU/h)</li>
      </ul>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcCT2() {
      const hotTemp = parseFloat((document.getElementById('ct2-hot') as HTMLInputElement).value) || 0;
      const coldTemp = parseFloat((document.getElementById('ct2-cold') as HTMLInputElement).value) || 0;
      const wetBulb = parseFloat((document.getElementById('ct2-wb') as HTMLInputElement).value) || 0;
      const gpm = parseFloat((document.getElementById('ct2-gpm') as HTMLInputElement).value) || 0;
      const cycles = parseFloat((document.getElementById('ct2-cycles') as HTMLInputElement).value) || 5;
      const driftPct = parseFloat((document.getElementById('ct2-drift') as HTMLInputElement).value) || 0.02;

      const range = hotTemp - coldTemp;
      const approach = coldTemp - wetBulb;
      const btu = gpm * 500 * range;
      const nominalTons = btu / 15000;
      const evapRate = gpm * range * 0.001;
      const driftRate = gpm * (driftPct / 100);
      const blowdown = Math.max(0, evapRate / (cycles - 1) - driftRate);
      const makeup = evapRate + blowdown + driftRate;

      document.getElementById('ct2-capacity')!.textContent = nominalTons.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('ct2-range')!.textContent = range.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('ct2-approach')!.textContent = approach.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('ct2-btu')!.textContent = Math.round(btu).toLocaleString('de-DE');
      document.getElementById('ct2-evap')!.textContent = evapRate.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.getElementById('ct2-blow')!.textContent = blowdown.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.getElementById('ct2-makeup')!.textContent = makeup.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ct2-in').forEach(el => {
        el.addEventListener('input', calcCT2);
        el.addEventListener('change', calcCT2);
      });
      calcCT2();
    }, 50);
  </script>
</CalculatorLayout>
