---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Flug-Treibstoff-Rechner - Kosten, Hobbs- & Tach-Zeit";
const description = "Berechnen Sie Treibstoffkosten f&uuml;r Ihren Flug. Vergleichen Sie Hobbs- vs. Tach-Zeit-Abrechnung und ermitteln Sie Kosten pro Stunde und Seemeile.";
const relatedCalcs = [
  { name: "Flugzeit", url: "/de/flugzeit-rechner", description: "Flugdauer berechnen." },
  { name: "Flugplan", url: "/de/flugplan-rechner", description: "Flugplanung." },
  { name: "Spritkosten", url: "/de/spritkosten-rechner", description: "Kraftstoffkosten." },
  { name: "Geschwindigkeit", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Flug-Treibstoff-Rechner" lang="de" enSlug="flight-fuel-cost-calculator" keywords="Flug Treibstoff, Avgas Preis, Treibstoffverbrauch, Hobbs Zeit, Tach Zeit, Kosten pro Stunde, Kosten pro Seemeile" breadcrumbs={[{ name: "Flug-Treibstoff", url: "/de/flug-treibstoff-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Flug-Treibstoff-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Treibstoffkosten f&uuml;r Ihren Flug und vergleichen Sie Abrechnungsmethoden.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-sm font-medium text-text mb-1">Flugdistanz (NM)</label><input type="number" id="ftr-dist" class="ftr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="10"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Grundgeschwindigkeit (kts)</label><input type="number" id="ftr-gs" class="ftr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Treibstoffverbrauch (L/h)</label><input type="number" id="ftr-burn" class="ftr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Treibstoffpreis (&euro;/L)</label><input type="number" id="ftr-price" class="ftr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="0.10"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Taxi-/Startzeit (min)</label><input type="number" id="ftr-taxi" class="ftr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Tach-Verh&auml;ltnis (Tach/Hobbs, z.B. 0,85)</label><input type="number" id="ftr-tachr" class="ftr-in w-full border border-border rounded-lg px-3 py-2" min="0.5" max="1" step="0.01"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Mietpreis (&euro;/h, 0 wenn Eigentum)</label><input type="number" id="ftr-rental" class="ftr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamt-Treibstoffkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="ftr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbrauch</div><div class="text-xl font-bold font-mono" id="ftr-liters">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flugzeit</div><div class="text-xl font-bold font-mono" id="ftr-time">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hobbs-Zeit</div><div class="text-xl font-bold font-mono" id="ftr-hobbs">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tach-Zeit</div><div class="text-xl font-bold font-mono" id="ftr-tach">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Stunde</div><div class="text-xl font-bold font-mono" id="ftr-cphr">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/NM</div><div class="text-xl font-bold font-mono" id="ftr-cpnm">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Miet-Ersparnis (Tach vs. Hobbs)</div>
          <div class="text-lg font-bold font-mono" id="ftr-savings">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="flight-fuel-cost" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Was ist Hobbs- vs. Tach-Zeit?</strong> Die Hobbs-Zeit misst die reale Betriebszeit, die Tach-Zeit ber&uuml;cksichtigt nur die Motordrehzahl.</p>
      <p><strong>Warum lohnt sich Tach-Abrechnung?</strong> Da die Tach-Zeit bei niedrigerer Drehzahl langsamer l&auml;uft, zahlen Sie weniger bei Taxi und Reiseflug.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFTR() {
      const dist = parseFloat((document.getElementById('ftr-dist') as HTMLInputElement).value) || 0;
      const gs = parseFloat((document.getElementById('ftr-gs') as HTMLInputElement).value) || 120;
      const burn = parseFloat((document.getElementById('ftr-burn') as HTMLInputElement).value) || 38;
      const price = parseFloat((document.getElementById('ftr-price') as HTMLInputElement).value) || 2.80;
      const taxiMin = parseFloat((document.getElementById('ftr-taxi') as HTMLInputElement).value) || 15;
      const tachRatio = parseFloat((document.getElementById('ftr-tachr') as HTMLInputElement).value) || 0.85;
      const rental = parseFloat((document.getElementById('ftr-rental') as HTMLInputElement).value) || 0;
      const flightHrs = gs > 0 ? dist / gs : 0;
      const hobbsHrs = flightHrs + taxiMin / 60;
      const tachHrs = hobbsHrs * tachRatio;
      const fuelUsed = hobbsHrs * burn;
      const fuelCost = fuelUsed * price;
      const fHrs = Math.floor(flightHrs);
      const fMins = Math.round((flightHrs - fHrs) * 60);
      const costPerHr = flightHrs > 0 ? fuelCost / flightHrs : 0;
      const costPerNM = dist > 0 ? fuelCost / dist : 0;
      const savings = rental > 0 ? rental * (hobbsHrs - tachHrs) : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('ftr-result')!.textContent = fmt(fuelCost) + ' \u20AC';
      document.getElementById('ftr-liters')!.textContent = fmt(fuelUsed) + ' L';
      document.getElementById('ftr-time')!.textContent = fHrs + 'h ' + fMins + 'm';
      document.getElementById('ftr-hobbs')!.textContent = fmt(hobbsHrs) + ' h';
      document.getElementById('ftr-tach')!.textContent = fmt(tachHrs) + ' h';
      document.getElementById('ftr-cphr')!.textContent = fmt(costPerHr) + ' \u20AC/h';
      document.getElementById('ftr-cpnm')!.textContent = fmt(costPerNM) + ' \u20AC/NM';
      if (rental > 0) {
        document.getElementById('ftr-savings')!.textContent = fmt(savings) + ' \u20AC Ersparnis mit Tach';
      } else {
        document.getElementById('ftr-savings')!.textContent = 'Mietpreis eingeben zum Vergleichen';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ftr-dist') as HTMLInputElement).value = '200';
      (document.getElementById('ftr-gs') as HTMLInputElement).value = '120';
      (document.getElementById('ftr-burn') as HTMLInputElement).value = '38';
      (document.getElementById('ftr-price') as HTMLInputElement).value = '2.80';
      (document.getElementById('ftr-taxi') as HTMLInputElement).value = '15';
      (document.getElementById('ftr-tachr') as HTMLInputElement).value = '0.85';
      (document.getElementById('ftr-rental') as HTMLInputElement).value = '200';
      document.querySelectorAll('.ftr-in').forEach(el => { el.addEventListener('input', calcFTR); el.addEventListener('change', calcFTR); });
      calcFTR();
    }, 50);
  </script>
</CalculatorLayout>
