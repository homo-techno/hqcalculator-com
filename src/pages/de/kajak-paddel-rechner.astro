---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kajak-Paddel Rechner – Optimale Paddellänge ermitteln";
const description = "Ermitteln Sie die optimale Paddellänge für Ihr Kajak.";
const relatedCalcs = [
  { name: "Intervalltraining Rechner", url: "/de/intervalltraining-rechner", description: "HIIT-Einheiten planen." },
  { name: "Keto Rechner", url: "/de/keto-rechner", description: "Makronährstoffe für Keto." },
  { name: "BMI Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Bewässerungsrechner", url: "/de/bewaesserungs-rechner", description: "Wasserbedarf Garten." },
];
---
<CalculatorLayout lang="de" enSlug="kayak-paddle-calculator" title={title} description={description} calculatorName="Kajak-Paddel Rechner" keywords="Kajak Paddel Länge, Paddellänge berechnen, Kajak Ausrüstung, Kajakpaddeln, Paddel Größe" breadcrumbs={[{ name: "Kajak-Paddel Rechner", url: "/de/kajak-paddel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kajak-Paddel Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die optimale Paddellänge für Ihr Kajak basierend auf Körpergröße, Kajakbreite und Paddeltechnik.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Körpergröße (cm)</label><input type="number" id="kp-height" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="175" min="140" max="220" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kajak-Breite (cm)</label><input type="number" id="kp-width" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="60" min="40" max="100" step="2"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Paddeltechnik / Winkel</label>
          <select id="kp-angle" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="low">Flacher Winkel (Touring / Wandern)</option>
            <option value="high" selected>Hoher Winkel (Sport / Wildwasser)</option>
            <option value="surf">Surf / Downwind</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kajaktyp</label>
          <select id="kp-type" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0">Tourenboot</option>
            <option value="5" selected>Allround-Kajak</option>
            <option value="-5">Wildwasser</option>
            <option value="10">Seekajak</option>
            <option value="-10">Rennkajak</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Paddellänge</div>
          <div class="text-5xl font-extrabold font-mono" id="kp-result">— cm</div>
          <div class="text-sm text-blue-200 mt-1" id="kp-range">Bereich: —</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minimum</div><div class="text-xl font-bold" id="kp-min">— cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfohlen</div><div class="text-xl font-bold" id="kp-rec">— cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Maximum</div><div class="text-xl font-bold" id="kp-max">— cm</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Paddellängen-Referenz nach Körpergröße</h3>
          <div class="text-xs space-y-1" id="kp-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kayak-paddle" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Die richtige Paddellänge wählen</h2>
      <p class="text-text-secondary">Die optimale Paddellänge hängt von drei Hauptfaktoren ab: Ihrer Körpergröße, der Breite Ihres Kajaks und Ihrer bevorzugten Paddeltechnik. Breitere Kajaks erfordern längere Paddel, da der Paddler weiter über den Bootsrand ausholen muss. Hochwinkel-Paddler (aufrechte Haltung) benötigen kürzere Paddel als Tiefwinkel-Paddler (entspannte, flache Technik).</p>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was passiert bei einem zu langen Paddel?</h4>
          <p class="text-text-secondary mt-1">Ein zu langes Paddel führt zu einem flacheren Paddelwinkel, mehr Hebelkraft und schnellerer Ermüdung der Schultern und Handgelenke. Bei Tourenkajakfahrten über längere Strecken kann dies zu Überlastungsschäden führen.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was bedeutet hoher vs. flacher Paddelwinkel?</h4>
          <p class="text-text-secondary mt-1">Beim hohen Winkel wird das Paddel fast senkrecht zum Wasser geführt (ca. 45–60° Schaftwinkel). Diese Technik ist effizienter und wird beim Sport- und Tourenpaddeln bevorzugt. Der flache Winkel (30–40°) ist entspannter und für Freizeitpaddler geeignet, erfordert aber längere Paddel.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welches Material sollte ein Kajak-Paddel haben?</h4>
          <p class="text-text-secondary mt-1">Einsteiger: Aluminium/Kunststoff (günstig, robust, ca. 1–2 kg). Fortgeschrittene: Glasfaser (leichter, bessere Kraftübertragung, ca. 0,9–1,3 kg). Profis: Carbon (leichteste Option, 0,6–0,9 kg, teuer). Leichtere Paddel reduzieren Ermüdung erheblich bei langen Touren.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Brauche ich ein anderes Paddel für Wildwasser?</h4>
          <p class="text-text-secondary mt-1">Wildwasserpaddel sind kürzer (190–200 cm), haben breitere und robustere Blätter für schnelle Manöver und kurze Kraftstöße. Tourenpaddel sind länger und schmaler für effizientes, gleichmäßiges Paddeln. Die Wahl des richtigen Paddels für die Disziplin ist wichtig für Sicherheit und Freude am Sport.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKP() {
      const height = parseInt((document.getElementById('kp-height') as HTMLInputElement).value) || 175;
      const boatWidth = parseInt((document.getElementById('kp-width') as HTMLInputElement).value) || 60;
      const angle = (document.getElementById('kp-angle') as HTMLSelectElement).value;
      const typeAdj = parseInt((document.getElementById('kp-type') as HTMLSelectElement).value) || 0;
      let base = 0;
      if (height < 155) base = 200;
      else if (height < 165) base = 205;
      else if (height < 175) base = 210;
      else if (height < 185) base = 215;
      else if (height < 195) base = 220;
      else base = 225;
      const widthAdj = Math.round((boatWidth - 60) / 5) * 5;
      let angleAdj = 0;
      if (angle === 'low') angleAdj = 10;
      else if (angle === 'surf') angleAdj = -5;
      const recommended = base + widthAdj + angleAdj + typeAdj;
      const minLen = recommended - 5;
      const maxLen = recommended + 5;
      document.getElementById('kp-result')!.textContent = recommended + ' cm';
      document.getElementById('kp-range')!.textContent = 'Bereich: ' + minLen + '–' + maxLen + ' cm';
      document.getElementById('kp-min')!.textContent = minLen + ' cm';
      document.getElementById('kp-rec')!.textContent = recommended + ' cm';
      document.getElementById('kp-max')!.textContent = maxLen + ' cm';
      const rows = [
        { label: 'Unter 155 cm', sizes: ['195–205 cm', '200–210 cm', '205–215 cm'] },
        { label: '155–165 cm', sizes: ['200–210 cm', '205–215 cm', '210–220 cm'] },
        { label: '165–175 cm', sizes: ['205–215 cm', '210–220 cm', '215–225 cm'] },
        { label: '175–185 cm', sizes: ['210–220 cm', '215–225 cm', '220–230 cm'] },
        { label: 'Über 185 cm', sizes: ['215–225 cm', '220–230 cm', '225–235 cm'] },
      ];
      const headers = '<div class="flex font-semibold mb-1"><span class="flex-1">Körpergröße</span><span class="w-24 text-center">Schmal</span><span class="w-24 text-center">Mittel</span><span class="w-24 text-center">Breit</span></div>';
      const heightIdx = height < 155 ? 0 : height < 165 ? 1 : height < 175 ? 2 : height < 185 ? 3 : 4;
      document.getElementById('kp-table')!.innerHTML = headers + rows.map((r, i) =>
        '<div class="flex' + (i === heightIdx ? ' text-blue-700 font-bold' : '') + '"><span class="flex-1">' + r.label + (i === heightIdx ? ' ←' : '') + '</span>' + r.sizes.map(s => '<span class="w-24 text-center">' + s + '</span>').join('') + '</div>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kp-in').forEach(el => { el.addEventListener('input', calcKP); el.addEventListener('change', calcKP); });
      calcKP();
    }, 50);
  </script>
</CalculatorLayout>
