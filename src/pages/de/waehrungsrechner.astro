---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Waehrungsrechner - Wechselkurs-Umrechner";
const description = "Rechnen Sie zwischen den wichtigsten Weltwaehrungen um. Schneller und einfacher Waehrungsumrechner mit Naeherungskursen.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "Trinkgeldrechner", url: "/de/trinkgeldrechner", description: "Trinkgeld." },
  { name: "Rabattrechner", url: "/de/rabattrechner", description: "Rabatte." },
  { name: "Inflationsrechner", url: "/de/inflationsrechner", description: "Inflation." },
  { name: "Devisenkurs-Rechner", url: "/de/devisenkurs-rechner", description: "Devisen." },
  { name: "Krypto-Gewinn-Rechner", url: "/de/krypto-gewinn-rechner", description: "Krypto-Gewinne." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Waehrungsrechner" keywords="Waehrungsrechner, Wechselkurs, Geld umrechnen, EUR USD GBP, Forex Rechner" breadcrumbs={[{ name: "Waehrungsrechner", url: "/de/waehrungsrechner" }]} lang="de" enSlug="currency-converter">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Waehrungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen den wichtigsten Waehrungen mit Naeherungskursen um.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Betrag</label>
          <input type="number" id="whr-amount" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1000" min="0" step="1">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Von</label>
            <select id="whr-from" class="w-full px-4 py-3 border border-border rounded-xl text-lg"></select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Nach</label>
            <select id="whr-to" class="w-full px-4 py-3 border border-border rounded-xl text-lg"></select>
          </div>
        </div>
        <button id="whr-swap" class="w-full py-2 text-sm font-semibold text-primary hover:bg-blue-50 rounded-xl border border-border">Waehrungen tauschen</button>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="whr-label">Ergebnis</div>
          <div class="text-4xl sm:text-5xl font-extrabold" id="whr-result">0</div>
          <div class="text-sm text-blue-200 mt-2" id="whr-rate">1 EUR = 1,00 EUR</div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Haeufige Umrechnungen</h3>
          <div class="space-y-1 text-sm" id="whr-table"></div>
        </div>

        <p class="text-xs text-text-muted text-center">Kurse sind Naeherungswerte und dienen nur als Referenz. Pruefen Sie aktuelle Kurse bei Ihrer Bank.</p>
      </div>
      <ShareButton calculatorId="currency" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Ueber Waehrungsumrechnung</h2>
      <p>Wechselkurse schwanken staendig basierend auf den Marktbedingungen. Die hier verwendeten Kurse sind Naeherungswerte. Fuer tatsaechliche Transaktionen pruefen Sie bitte bei Ihrer Bank oder einem aktuellen Forex-Dienst.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const whrRates: Record<string, { name: string; symbol: string; rate: number }> = {
      EUR: { name: 'Euro', symbol: '\u20AC', rate: 1 },
      USD: { name: 'US-Dollar', symbol: '$', rate: 1.09 },
      GBP: { name: 'Britisches Pfund', symbol: '\u00A3', rate: 0.86 },
      CHF: { name: 'Schweizer Franken', symbol: 'Fr', rate: 0.96 },
      JPY: { name: 'Japanischer Yen', symbol: '\u00A5', rate: 163 },
      CAD: { name: 'Kanadischer Dollar', symbol: 'C$', rate: 1.48 },
      AUD: { name: 'Australischer Dollar', symbol: 'A$', rate: 1.67 },
      CNY: { name: 'Chinesischer Yuan', symbol: '\u00A5', rate: 7.89 },
      INR: { name: 'Indische Rupie', symbol: '\u20B9', rate: 90.6 },
      MXN: { name: 'Mexikanischer Peso', symbol: '$', rate: 18.7 },
      BRL: { name: 'Brasilianischer Real', symbol: 'R$', rate: 5.42 },
      KRW: { name: 'Suedkoreanischer Won', symbol: '\u20A9', rate: 1450 },
      SEK: { name: 'Schwedische Krone', symbol: 'kr', rate: 11.4 },
      NOK: { name: 'Norwegische Krone', symbol: 'kr', rate: 11.5 },
      PLN: { name: 'Polnischer Zloty', symbol: 'z\u0142', rate: 4.38 },
      CZK: { name: 'Tschechische Krone', symbol: 'K\u010D', rate: 25.3 },
      TRY: { name: 'Tuerkische Lira', symbol: '\u20BA', rate: 32.9 },
      HUF: { name: 'Ungarischer Forint', symbol: 'Ft', rate: 395 },
      DKK: { name: 'Daenische Krone', symbol: 'kr', rate: 7.46 },
      SGD: { name: 'Singapur-Dollar', symbol: 'S$', rate: 1.46 },
    };

    function whrPopulate() {
      const opts = Object.entries(whrRates).map(([code, d]) => '<option value="' + code + '">' + code + ' - ' + d.name + '</option>').join('');
      document.getElementById('whr-from')!.innerHTML = opts;
      document.getElementById('whr-to')!.innerHTML = opts;
      (document.getElementById('whr-from') as HTMLSelectElement).value = 'EUR';
      (document.getElementById('whr-to') as HTMLSelectElement).value = 'USD';
    }

    function whrConvert() {
      const amount = parseFloat((document.getElementById('whr-amount') as HTMLInputElement).value) || 0;
      const from = (document.getElementById('whr-from') as HTMLSelectElement).value;
      const to = (document.getElementById('whr-to') as HTMLSelectElement).value;

      const fromRate = whrRates[from]?.rate || 1;
      const toRate = whrRates[to]?.rate || 1;
      const exchangeRate = toRate / fromRate;
      const result = amount * exchangeRate;

      const toInfo = whrRates[to];
      const decimals = result > 100 ? 0 : result > 1 ? 2 : 4;

      document.getElementById('whr-result')!.textContent = toInfo.symbol + ' ' + result.toFixed(decimals).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      document.getElementById('whr-label')!.textContent = amount.toLocaleString('de-DE') + ' ' + from + ' =';
      document.getElementById('whr-rate')!.textContent = '1 ' + from + ' = ' + exchangeRate.toFixed(4).replace('.', ',') + ' ' + to;

      const amounts = [1, 10, 100, 500, 1000, 5000, 10000];
      document.getElementById('whr-table')!.innerHTML =
        amounts.map(a => {
          const r = a * exchangeRate;
          const d = r > 100 ? 0 : 2;
          return '<div class="flex justify-between"><span class="text-text-secondary">' + a.toLocaleString('de-DE') + ' ' + from + '</span><span class="font-semibold">' + r.toFixed(d).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' ' + to + '</span></div>';
        }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      whrPopulate();
      document.getElementById('whr-amount')!.addEventListener('input', whrConvert);
      document.getElementById('whr-from')!.addEventListener('change', whrConvert);
      document.getElementById('whr-to')!.addEventListener('change', whrConvert);
      document.getElementById('whr-swap')!.addEventListener('click', () => {
        const f = document.getElementById('whr-from') as HTMLSelectElement;
        const t = document.getElementById('whr-to') as HTMLSelectElement;
        const tmp = f.value; f.value = t.value; t.value = tmp;
        whrConvert();
      });
      whrConvert();
    }, 50);
  </script>
</CalculatorLayout>
