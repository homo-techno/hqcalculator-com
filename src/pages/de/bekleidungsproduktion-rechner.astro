---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bekleidungsproduktion-Rechner - Zeitplanung & Kosten";
const description = "Berechnen Sie Produktionszeiten, Lohnkosten pro Stück und Tageskapazität für die Bekleidungsherstellung.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Mehrwertsteuer-Rechner", url: "/de/mehrwertsteuer-rechner", description: "MwSt berechnen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Bekleidungsproduktion-Rechner" enSlug="clothing-production-calculator" keywords="Bekleidungsproduktion, Textilherstellung, Produktionszeit, Lohnkosten, Tageskapazität, Nähen" breadcrumbs={[{ name: "Bekleidungsproduktion-Rechner", url: "/de/bekleidungsproduktion-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bekleidungsproduktion-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Produktionszeiträume, berechnen Sie Lohnkosten und schätzen Sie die Tagesproduktion für die Bekleidungsherstellung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kleidungskomplexität</label>
          <select id="bp-complex" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="simple">Einfach (T-Shirt, Top)</option>
            <option value="moderate" selected>Mittel (Kleid, Hose)</option>
            <option value="complex">Komplex (Jacke, Blazer)</option>
            <option value="couture">Couture / Maßschneiderei</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zuschnittzeit / Stück (Min.)</label><input type="number" id="bp-cut" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" max="120" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nähzeit / Stück (Min.)</label><input type="number" id="bp-sew" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" max="600" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Endbearbeitung / Stück (Min.)</label><input type="number" id="bp-finish" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="120" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">QK / Verpackung (Min.)</label><input type="number" id="bp-qc" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="30" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stundenlohn (EUR)</label><input type="number" id="bp-rate" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="5" max="100" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Arbeiter</label><input type="number" id="bp-workers" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="100" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bestellmenge</label><input type="number" id="bp-qty" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Arbeitsstunden / Tag</label><input type="number" id="bp-hours" class="bp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="4" max="12" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Produktionszeit</div>
          <div class="text-4xl font-extrabold font-mono" id="bp-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeit / Stück</div><div class="text-xl font-bold font-mono" id="bp-perunit">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tagesproduktion</div><div class="text-xl font-bold font-mono" id="bp-daily">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tage benötigt</div><div class="text-xl font-bold font-mono" id="bp-days">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lohn / Stück</div><div class="text-xl font-bold font-mono" id="bp-laborcost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtlohn</div><div class="text-xl font-bold font-mono" id="bp-totallabor">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effizienz</div><div class="text-xl font-bold font-mono" id="bp-eff">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="bekleidungsproduktion" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Bekleidungsproduktion planen</h2>
      <p>Die Produktionszeit pro Kleidungsstück hängt von der Komplexität ab. Ein einfaches T-Shirt benötigt ca. 28 Minuten, während ein Blazer bis zu 200 Minuten erfordern kann.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBP() {
      const complex = (document.getElementById('bp-complex') as HTMLSelectElement).value;
      const rate = parseFloat((document.getElementById('bp-rate') as HTMLInputElement).value) || 18;
      const workers = parseInt((document.getElementById('bp-workers') as HTMLInputElement).value) || 3;
      const qty = parseInt((document.getElementById('bp-qty') as HTMLInputElement).value) || 100;
      const hoursPerDay = parseFloat((document.getElementById('bp-hours') as HTMLInputElement).value) || 8;

      const presets: Record<string, number[]> = {
        simple: [5, 15, 5, 3],
        moderate: [8, 30, 10, 5],
        complex: [15, 60, 20, 8],
        couture: [20, 120, 45, 15]
      };
      const p = presets[complex] || presets['moderate'];
      const cutMin = p[0]; const sewMin = p[1]; const finishMin = p[2]; const qcMin = p[3];
      (document.getElementById('bp-cut') as HTMLInputElement).value = cutMin.toString();
      (document.getElementById('bp-sew') as HTMLInputElement).value = sewMin.toString();
      (document.getElementById('bp-finish') as HTMLInputElement).value = finishMin.toString();
      (document.getElementById('bp-qc') as HTMLInputElement).value = qcMin.toString();

      const totalPerUnit = cutMin + sewMin + finishMin + qcMin;
      const laborCostPerUnit = (totalPerUnit / 60) * rate;
      const totalLaborCost = laborCostPerUnit * qty;

      const totalMinutesAll = totalPerUnit * qty;
      const workerMinutesPerDay = hoursPerDay * 60 * workers;
      const daysNeeded = Math.ceil(totalMinutesAll / workerMinutesPerDay);
      const dailyOutput = Math.floor(workerMinutesPerDay / totalPerUnit);

      const efficiency = Math.min(100, (dailyOutput * totalPerUnit / workerMinutesPerDay) * 100 * 0.85);

      const totalHours = totalMinutesAll / 60;
      const displayTime = daysNeeded > 1 ? daysNeeded + ' Arbeitstage' : totalHours.toFixed(1) + ' Stunden';

      document.getElementById('bp-result')!.textContent = displayTime;
      document.getElementById('bp-perunit')!.textContent = totalPerUnit + ' Min.';
      document.getElementById('bp-daily')!.textContent = dailyOutput + ' Stk.';
      document.getElementById('bp-days')!.textContent = daysNeeded.toString();
      document.getElementById('bp-laborcost')!.textContent = laborCostPerUnit.toFixed(2) + ' EUR';
      document.getElementById('bp-totallabor')!.textContent = totalLaborCost.toLocaleString('de-DE', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' EUR';
      document.getElementById('bp-eff')!.textContent = efficiency.toFixed(0) + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bp-in').forEach(el => { el.addEventListener('input', calcBP); el.addEventListener('change', calcBP); });
      calcBP();
    }, 50);
  </script>
</CalculatorLayout>
