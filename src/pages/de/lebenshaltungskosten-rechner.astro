---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lebenshaltungskosten-Rechner - Städte vergleichen";
const description = "Vergleichen Sie die Lebenshaltungskosten zwischen deutschen Städten. Finden Sie heraus, welches Gehalt Sie in einer neuen Stadt benötigen.";
const relatedCalcs = [
  { name: "Gehaltsrechner", url: "/de/gehaltsrechner", description: "Gehalt." },
  { name: "Inflationsrechner", url: "/de/inflationsrechner", description: "Inflation." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budgetplanung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Lebenshaltungskosten-Rechner" enSlug="cost-of-living-calculator" keywords="Lebenshaltungskosten Rechner, Städtevergleich, Gehaltsvergleich, Lebenshaltungsindex, Stadtvergleich Deutschland" breadcrumbs={[{ name: "Lebenshaltungskosten-Rechner", url: "/de/lebenshaltungskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lebenshaltungskosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie die Kosten zwischen Städten und finden Sie heraus, welches Gehalt Sie benötigen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Aktuelles Gehalt (brutto/Jahr)</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">€</span>
              <input type="number" id="col-salary" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="50000" min="0" step="1000">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktuelle Stadt</label>
            <select id="col-from" class="w-full px-4 py-3 border border-border rounded-xl text-lg"></select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zielstadt</label>
            <select id="col-to" class="w-full px-4 py-3 border border-border rounded-xl text-lg"></select>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigtes Äquivalentgehalt</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="col-needed">0 €</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Kostenunterschied</div>
              <div class="text-xl font-bold text-secondary" id="col-diff">0%</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gehaltsunterschied</div>
              <div class="text-xl font-bold" id="col-sal-diff">0 €</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Kategorie-Vergleich</h3>
            <div class="space-y-1 text-sm" id="col-compare"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cost-of-living" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Lebenshaltungskosten verstehen</h2>
      <p>Der Lebenshaltungskosten-Index vergleicht die Preise für Güter, Wohnen und Dienstleistungen zwischen Standorten. Ein Index von 120 bedeutet, dass die Stadt 20% teurer ist als der Durchschnitt (100). München ist die teuerste Großstadt Deutschlands, während ostdeutsche Städte deutlich günstiger sind.</p>
      <p class="text-sm text-text-muted">Hinweis: Dies sind Näherungswerte für Vergleichszwecke. Tatsächliche Kosten variieren je nach Stadtteil und Lebensstil.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    const cities: Record<string, { label: string; overall: number; housing: number; food: number; transport: number; health: number }> = {
      'munich': { label: 'München', overall: 130, housing: 165, food: 110, transport: 115, health: 105 },
      'frankfurt': { label: 'Frankfurt am Main', overall: 120, housing: 145, food: 108, transport: 112, health: 103 },
      'stuttgart': { label: 'Stuttgart', overall: 118, housing: 140, food: 107, transport: 110, health: 104 },
      'hamburg': { label: 'Hamburg', overall: 115, housing: 135, food: 106, transport: 108, health: 102 },
      'dusseldorf': { label: 'D\u00FCsseldorf', overall: 113, housing: 130, food: 105, transport: 108, health: 102 },
      'cologne': { label: 'K\u00F6ln', overall: 110, housing: 125, food: 104, transport: 107, health: 101 },
      'berlin': { label: 'Berlin', overall: 105, housing: 115, food: 103, transport: 105, health: 100 },
      'nuremberg': { label: 'N\u00FCrnberg', overall: 103, housing: 110, food: 102, transport: 104, health: 100 },
      'hanover': { label: 'Hannover', overall: 100, housing: 105, food: 100, transport: 102, health: 100 },
      'bremen': { label: 'Bremen', overall: 98, housing: 100, food: 99, transport: 100, health: 99 },
      'dresden': { label: 'Dresden', overall: 92, housing: 88, food: 97, transport: 98, health: 97 },
      'leipzig': { label: 'Leipzig', overall: 90, housing: 85, food: 96, transport: 97, health: 96 },
      'dortmund': { label: 'Dortmund', overall: 95, housing: 92, food: 98, transport: 100, health: 98 },
      'vienna': { label: 'Wien (\u00D6sterreich)', overall: 108, housing: 120, food: 105, transport: 106, health: 102 },
      'zurich': { label: 'Z\u00FCrich (Schweiz)', overall: 175, housing: 220, food: 140, transport: 130, health: 120 },
      'avg': { label: 'Bundesdurchschnitt', overall: 100, housing: 100, food: 100, transport: 100, health: 100 },
    };

    function populateCities() {
      const opts = Object.entries(cities).map(([k, v]) => '<option value="' + k + '">' + v.label + ' (' + v.overall + ')</option>').join('');
      document.getElementById('col-from')!.innerHTML = opts;
      document.getElementById('col-to')!.innerHTML = opts;
      (document.getElementById('col-from') as HTMLSelectElement).value = 'hanover';
      (document.getElementById('col-to') as HTMLSelectElement).value = 'munich';
    }

    function calcCOL() {
      const salary = parseFloat((document.getElementById('col-salary') as HTMLInputElement).value) || 0;
      const from = (document.getElementById('col-from') as HTMLSelectElement).value;
      const to = (document.getElementById('col-to') as HTMLSelectElement).value;

      const fromCity = cities[from] || cities.avg;
      const toCity = cities[to] || cities.avg;

      const ratio = toCity.overall / fromCity.overall;
      const needed = salary * ratio;
      const diff = ((ratio - 1) * 100);
      const salDiff = needed - salary;

      document.getElementById('col-needed')!.textContent = fmtEur(needed);
      document.getElementById('col-diff')!.textContent = (diff >= 0 ? '+' : '') + diff.toFixed(1) + '%';
      document.getElementById('col-sal-diff')!.textContent = (salDiff >= 0 ? '+' : '-') + fmtEur(Math.abs(salDiff));

      const cats = ['housing', 'food', 'transport', 'health'] as const;
      const catLabels: Record<string, string> = { housing: 'Wohnen', food: 'Lebensmittel', transport: 'Verkehr', health: 'Gesundheit' };
      document.getElementById('col-compare')!.innerHTML =
        '<div class="grid grid-cols-4 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Kategorie</span><span>' + fromCity.label.split(' ')[0] + '</span><span>' + toCity.label.split(' ')[0] + '</span><span>Diff.</span></div>' +
        cats.map(cat => {
          const fv = fromCity[cat];
          const tv = toCity[cat];
          const d = ((tv / fv - 1) * 100);
          return '<div class="grid grid-cols-4 gap-1 text-xs"><span>' + catLabels[cat] + '</span><span>' + fv + '</span><span>' + tv + '</span><span class="' + (d > 0 ? 'text-red-600' : 'text-green-600') + ' font-semibold">' + (d >= 0 ? '+' : '') + d.toFixed(0) + '%</span></div>';
        }).join('') +
        '<div class="grid grid-cols-4 gap-1 text-xs font-bold pt-1 border-t border-border mt-1"><span>Gesamt</span><span>' + fromCity.overall + '</span><span>' + toCity.overall + '</span><span class="' + (diff > 0 ? 'text-red-600' : 'text-green-600') + '">' + (diff >= 0 ? '+' : '') + diff.toFixed(0) + '%</span></div>';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      populateCities();
      document.getElementById('col-salary')!.addEventListener('input', calcCOL);
      ['col-from', 'col-to'].forEach(id => document.getElementById(id)!.addEventListener('change', calcCOL));
      calcCOL();
    }, 50);
  </script>
</CalculatorLayout>
