---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Chemisches Gleichgewicht Rechner - Kc, Kp, Q & Le Chatelier";
const description = "Berechnen Sie Gleichgewichtskonstanten Kc und Kp, Reaktionsquotient Q, konvertieren Sie zwischen Kc und Kp und sagen Sie Le-Chatelier-Verschiebungen vorher.";
const relatedCalcs = [
  { name: "Reaktionskinetik-Rechner", url: "/de/reaktionskinetik-rechner", description: "Reaktionsgeschwindigkeit." },
  { name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner", description: "Statistischer Test." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI fuer Kinder." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Chemisches Gleichgewicht Rechner" enSlug="chemical-equilibrium-calculator" keywords="chemisches Gleichgewicht, Kc, Kp, Reaktionsquotient, Le Chatelier, Gleichgewichtskonstante, Gibbs-Energie" breadcrumbs={[{ name: "Chemisches Gleichgewicht", url: "/de/chemisches-gleichgewicht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Chemisches Gleichgewicht Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kc, Kp, Reaktionsquotient Q und sagen Sie Gleichgewichtsverschiebungen vorher.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="cg-m1" class="cg-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="kc">Kc berechnen</button>
          <button id="cg-m2" class="cg-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="convert">Kc &harr; Kp</button>
          <button id="cg-m3" class="cg-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="quotient">Q vs K</button>
        </div>
        <div id="cg-panel-kc">
          <p class="text-xs text-text-muted mb-2">Fuer aA + bB &harr; cC + dD: Kc = [C]^c[D]^d / [A]^a[B]^b</p>
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">[A] (M)</label><input type="number" id="cg-a" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="0.01"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Koeff. a</label><input type="number" id="cg-ca" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div><label class="block text-xs font-medium text-text mb-1">[B] (M)</label><input type="number" id="cg-b" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="0.01"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Koeff. b</label><input type="number" id="cg-cb" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="1"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div><label class="block text-xs font-medium text-text mb-1">[C] (M)</label><input type="number" id="cg-c" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="0.01"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Koeff. c</label><input type="number" id="cg-cc" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div><label class="block text-xs font-medium text-text mb-1">[D] (M)</label><input type="number" id="cg-d" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="0.01"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Koeff. d</label><input type="number" id="cg-cd" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="1"></div>
          </div>
        </div>
        <div id="cg-panel-convert" class="hidden">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Kc-Wert</label><input type="number" id="cg-kc" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Temperatur (K)</label><input type="number" id="cg-temp" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
          </div>
          <div class="mt-3"><label class="block text-xs font-medium text-text mb-1">Delta n (Mol Gasprodukte - Mol Gasreaktanten)</label><input type="number" id="cg-dn" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" step="1"></div>
        </div>
        <div id="cg-panel-quotient" class="hidden">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Gleichgewichtskonstante (K)</label><input type="number" id="cg-keq" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Reaktionsquotient (Q)</label><input type="number" id="cg-qval" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" step="any"></div>
          </div>
          <div class="mt-3"><label class="block text-xs font-medium text-text mb-1">Temperatur (K)</label><input type="number" id="cg-tq" class="cg-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="cg-label">Gleichgewichtskonstante Kc</div>
          <div class="text-5xl font-extrabold font-mono" id="cg-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="cg-s1l">ln(K)</div><div class="text-xl font-bold font-mono" id="cg-s1">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="cg-s2l">Delta G° (kJ/mol)</div><div class="text-xl font-bold font-mono" id="cg-s2">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="cg-s3l">Beguenstigt</div><div class="text-xl font-bold font-mono" id="cg-s3">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="chemisches-gleichgewicht" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Chemisches Gleichgewicht verstehen</h2>
      <p>Das chemische Gleichgewicht beschreibt den Zustand, in dem die Hin- und Rueckreaktion mit gleicher Geschwindigkeit ablaufen. Die Gleichgewichtskonstante K gibt das Verhaeltnis der Produkt- zu Reaktantenkonzentrationen an.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Was bedeutet ein grosses K?</strong> Die Reaktion liegt auf der Produktseite - es werden mehr Produkte als Edukte gebildet.</li>
        <li><strong>Was ist das Le-Chatelier-Prinzip?</strong> Ein System im Gleichgewicht reagiert auf eine Stoerung, indem es sich so verschiebt, dass die Stoerung verringert wird.</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const RG = 8.314;
    let cgMode = 'kc';
    function setCgMode(m: string) {
      cgMode = m;
      document.getElementById('cg-panel-kc')!.classList.toggle('hidden', m !== 'kc');
      document.getElementById('cg-panel-convert')!.classList.toggle('hidden', m !== 'convert');
      document.getElementById('cg-panel-quotient')!.classList.toggle('hidden', m !== 'quotient');
      document.querySelectorAll('.cg-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'cg-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcCG();
    }
    function calcCG() {
      const label = document.getElementById('cg-label')!;
      const result = document.getElementById('cg-result')!;
      if (cgMode === 'kc') {
        const A = parseFloat((document.getElementById('cg-a') as HTMLInputElement).value) || 0.001;
        const ca = parseFloat((document.getElementById('cg-ca') as HTMLInputElement).value) || 1;
        const B = parseFloat((document.getElementById('cg-b') as HTMLInputElement).value) || 0.001;
        const cb = parseFloat((document.getElementById('cg-cb') as HTMLInputElement).value) || 0;
        const C = parseFloat((document.getElementById('cg-c') as HTMLInputElement).value) || 0.001;
        const cc = parseFloat((document.getElementById('cg-cc') as HTMLInputElement).value) || 1;
        const D = parseFloat((document.getElementById('cg-d') as HTMLInputElement).value) || 0.001;
        const cd = parseFloat((document.getElementById('cg-cd') as HTMLInputElement).value) || 0;
        const numerator = Math.pow(C, cc) * (cd > 0 ? Math.pow(D, cd) : 1);
        const denominator = Math.pow(A, ca) * (cb > 0 ? Math.pow(B, cb) : 1);
        const Kc = denominator > 0 ? numerator / denominator : 0;
        const lnK = Kc > 0 ? Math.log(Kc) : 0;
        const dG = -RG * 298 * lnK / 1000;
        let favors: string;
        if (Kc > 1000) favors = 'Produkte >>';
        else if (Kc > 1) favors = 'Produkte';
        else if (Kc > 0.001) favors = 'Edukte';
        else favors = 'Edukte >>';
        label.textContent = 'Gleichgewichtskonstante Kc';
        result.textContent = Kc >= 1e6 || Kc < 0.001 ? Kc.toExponential(4) : Kc.toFixed(4);
        document.getElementById('cg-s1l')!.textContent = 'ln(K)';
        document.getElementById('cg-s1')!.textContent = lnK.toFixed(4);
        document.getElementById('cg-s2l')!.textContent = '\u0394G\u00B0 (kJ/mol)';
        document.getElementById('cg-s2')!.textContent = dG.toFixed(2);
        document.getElementById('cg-s3l')!.textContent = 'Beguenstigt';
        document.getElementById('cg-s3')!.textContent = favors;
      } else if (cgMode === 'convert') {
        const Kc = parseFloat((document.getElementById('cg-kc') as HTMLInputElement).value) || 1;
        const T = parseFloat((document.getElementById('cg-temp') as HTMLInputElement).value) || 298;
        const dn = parseFloat((document.getElementById('cg-dn') as HTMLInputElement).value) || 0;
        const Kp = Kc * Math.pow(0.08206 * T, dn);
        const lnKp = Kp > 0 ? Math.log(Kp) : 0;
        const dG = -RG * T * lnKp / 1000;
        label.textContent = 'Kp (druckbasiert)';
        result.textContent = Kp >= 1e6 || (Kp > 0 && Kp < 0.001) ? Kp.toExponential(4) : Kp.toFixed(4);
        document.getElementById('cg-s1l')!.textContent = 'Kc (gegeben)';
        document.getElementById('cg-s1')!.textContent = Kc >= 1e6 ? Kc.toExponential(4) : Kc.toFixed(4);
        document.getElementById('cg-s2l')!.textContent = '\u0394G\u00B0 (kJ/mol)';
        document.getElementById('cg-s2')!.textContent = dG.toFixed(2);
        document.getElementById('cg-s3l')!.textContent = '(RT)^\u0394n';
        document.getElementById('cg-s3')!.textContent = Math.pow(0.08206 * T, dn).toFixed(4);
      } else {
        const K = parseFloat((document.getElementById('cg-keq') as HTMLInputElement).value) || 1;
        const Q = parseFloat((document.getElementById('cg-qval') as HTMLInputElement).value) || 1;
        const T = parseFloat((document.getElementById('cg-tq') as HTMLInputElement).value) || 298;
        let direction: string;
        if (Math.abs(Q - K) / Math.max(K, 1e-10) < 0.01) direction = 'Im Gleichgewicht';
        else if (Q < K) direction = 'Verschiebung RECHTS (zu Produkten)';
        else direction = 'Verschiebung LINKS (zu Edukten)';
        const dG = RG * T * Math.log(Q / K) / 1000;
        label.textContent = 'Le-Chatelier-Vorhersage';
        result.textContent = direction;
        document.getElementById('cg-s1l')!.textContent = 'Q/K Verhaeltnis';
        document.getElementById('cg-s1')!.textContent = (Q / K).toFixed(4);
        document.getElementById('cg-s2l')!.textContent = '\u0394G (kJ/mol)';
        document.getElementById('cg-s2')!.textContent = dG.toFixed(2);
        document.getElementById('cg-s3l')!.textContent = 'Richtung';
        document.getElementById('cg-s3')!.textContent = Q < K ? '\u2192 Produkte' : Q > K ? '\u2190 Edukte' : 'Ausgeglichen';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cg-a') as HTMLInputElement).value = '0.5';
      (document.getElementById('cg-ca') as HTMLInputElement).value = '1';
      (document.getElementById('cg-b') as HTMLInputElement).value = '0.3';
      (document.getElementById('cg-cb') as HTMLInputElement).value = '1';
      (document.getElementById('cg-c') as HTMLInputElement).value = '0.8';
      (document.getElementById('cg-cc') as HTMLInputElement).value = '1';
      (document.getElementById('cg-d') as HTMLInputElement).value = '0.4';
      (document.getElementById('cg-cd') as HTMLInputElement).value = '1';
      (document.getElementById('cg-kc') as HTMLInputElement).value = '4.5';
      (document.getElementById('cg-temp') as HTMLInputElement).value = '298';
      (document.getElementById('cg-dn') as HTMLInputElement).value = '-2';
      (document.getElementById('cg-keq') as HTMLInputElement).value = '10';
      (document.getElementById('cg-qval') as HTMLInputElement).value = '5';
      (document.getElementById('cg-tq') as HTMLInputElement).value = '298';
      document.querySelectorAll('.cg-mode').forEach(b => b.addEventListener('click', () => setCgMode((b as HTMLButtonElement).dataset.mode!)));
      document.querySelectorAll('.cg-in').forEach(el => { el.addEventListener('input', calcCG); el.addEventListener('change', calcCG); });
      calcCG();
    }, 50);
  </script>
</CalculatorLayout>
