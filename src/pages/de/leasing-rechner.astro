---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Leasingrechner";
const description = "Berechnen Sie monatliche Leasingraten für Autos und Geräte.";

const relatedCalcs = [
  { name: "Leasing vs. Kauf Rechner", url: "/de/leasing-vs-kauf-rechner", description: "Leasing vs. Kauf vergleichen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "AfA berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlagewachstum berechnen." },
  { name: "Abschlusskosten-Rechner", url: "/de/abschlusskosten-rechner", description: "Kaufnebenkosten berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Leasingrechner" lang="de" enSlug="lease-calculator" keywords="leasingrechner, leasing rate berechnen, auto leasing rechner, monatliche leasingrate" breadcrumbs={[{ name: "Leasingrechner", url: "/de/leasing-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Leasingrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie monatliche Leasingraten für Fahrzeuge und Geräte auf Basis von Kaufpreis, Restwert und Laufzeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Netto-Listenpreis (€)</label><input type="number" id="lsr-price" class="lsr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30000" min="1000" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahlung (€)</label><input type="number" id="lsr-down" class="lsr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="0" step="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Restwert am Laufzeitende (€)</label><input type="number" id="lsr-resid" class="lsr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15000" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Monate)</label><select id="lsr-term" class="lsr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="24">24 Monate</option>
            <option value="36" selected>36 Monate</option>
            <option value="48">48 Monate</option>
            <option value="60">60 Monate</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zinssatz (% p.a.)</label><input type="number" id="lsr-rate" class="lsr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.9" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Mehrwertsteuer (%)</label><select id="lsr-vat" class="lsr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Keine (Netto)</option>
            <option value="19" selected>19 % MwSt.</option>
            <option value="7">7 % MwSt.</option>
          </select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Leasingrate (brutto)</div>
          <div class="text-4xl font-extrabold font-mono" id="lsr-monthly">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rate netto</div><div class="text-xl font-bold" id="lsr-net">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="lsr-total">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zinsanteil gesamt</div><div class="text-xl font-bold" id="lsr-interest">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="lease-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Leasingrate berechnen – so funktioniert's</h2>
      <p>Die monatliche Leasingrate setzt sich aus der Abschreibungsrate (Differenz zwischen Kaufpreis und Restwert, verteilt auf die Laufzeit) und einem Zinsanteil zusammen. Für Gewerbetreibende ist Leasing steuerlich attraktiv, da die Leasingraten als Betriebsausgaben vollständig abgesetzt werden können. Für Privatpersonen lohnt sich ein Vergleich zwischen Leasing und Kredit.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Kilometerleasing und Restwertleasing?</strong> Beim Kilometerleasing ist eine Mindestlaufleistung vereinbart; bei Mehrkilometern fallen Zusatzkosten an. Beim Restwertleasing trägt der Leasingnehmer das Restwertrisiko am Ende der Laufzeit.</p>
      <p><strong>Kann ich ein Leasingfahrzeug kaufen?</strong> Ja, viele Verträge enthalten eine Kaufoption zum Restwert am Ende der Laufzeit. Dies kann sinnvoll sein, wenn der Marktpreis des Fahrzeugs über dem vereinbarten Restwert liegt.</p>
      <p><strong>Ist Leasing oder Kredit günstiger?</strong> Das hängt von Zinssatz, Anzahlung und geplanter Nutzungsdauer ab. Der Leasing vs. Kauf Rechner hilft beim Vergleich.</p>
      <p><strong>Wer ist Eigentümer beim Leasing?</strong> Beim Leasing bleibt der Leasinggeber (z. B. Händler oder Bank) Eigentümer des Fahrzeugs. Der Leasingnehmer hat nur ein Nutzungsrecht.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const lsrFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcLSR() {
      const price = parseFloat((document.getElementById('lsr-price') as HTMLInputElement).value) || 0;
      const down = parseFloat((document.getElementById('lsr-down') as HTMLInputElement).value) || 0;
      const resid = parseFloat((document.getElementById('lsr-resid') as HTMLInputElement).value) || 0;
      const term = parseInt((document.getElementById('lsr-term') as HTMLSelectElement).value) || 36;
      const annualRate = parseFloat((document.getElementById('lsr-rate') as HTMLInputElement).value) / 100 || 0;
      const vat = parseInt((document.getElementById('lsr-vat') as HTMLSelectElement).value) / 100 || 0;
      const financed = price - down;
      const monthlyRate = annualRate / 12;
      let monthlyNet: number;
      if (monthlyRate === 0) {
        monthlyNet = (financed - resid) / term;
      } else {
        const depPart = (financed - resid) / term;
        const intPart = (financed + resid) * monthlyRate / 2;
        monthlyNet = depPart + intPart;
      }
      const monthlyGross = monthlyNet * (1 + vat);
      const totalGross = monthlyGross * term + down;
      const totalInterest = (monthlyNet * term) - (financed - resid);
      document.getElementById('lsr-monthly')!.textContent = lsrFmt(monthlyGross);
      document.getElementById('lsr-net')!.textContent = lsrFmt(monthlyNet);
      document.getElementById('lsr-total')!.textContent = lsrFmt(totalGross);
      document.getElementById('lsr-interest')!.textContent = lsrFmt(Math.max(0, totalInterest));
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.lsr-in').forEach(el => { el.addEventListener('input', calcLSR); el.addEventListener('change', calcLSR); }); calcLSR(); }, 50);
  </script>
</CalculatorLayout>
