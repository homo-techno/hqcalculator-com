---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Boxreichweite-Rechner - Ape Index, Reichweitenvorteil & Gewichtsklasse";
const description = "Berechnen Sie Reichweitenvorteil, Ape Index, Gewichtsklasse und ideale Standbreite für Boxer und MMA-Kämpfer.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Militär-Körperfett-Rechner", url: "/de/militaer-koerperfett-rechner", description: "Körperfettanteil." },
  { name: "Körperoberfläche-Rechner", url: "/de/koerperoberflaeche-rechner", description: "Körperoberfläche." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Bowling-Punkte-Rechner", url: "/de/bowling-punkte-rechner", description: "Bowling-Punkte." },
  { name: "Schlagdurchschnitt-Rechner", url: "/de/schlagdurchschnitt-rechner", description: "Baseball-Statistiken." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Boxreichweite-Rechner" enSlug="boxing-reach-calculator" keywords="Boxreichweite Rechner, Ape Index, Reichweitenvorteil, Gewichtsklasse, Standbreite, Kampfsport" breadcrumbs={[{ name: "Boxreichweite-Rechner", url: "/de/boxreichweite-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Boxreichweite-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren Ape Index, Reichweitenvorteil, Gewichtsklasse und ideale Standbreite für Kampfsport.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Körpergröße (cm)</label><input type="number" id="bx-height" class="bx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="120" max="230" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Armspannweite (cm)</label><input type="number" id="bx-span" class="bx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="120" max="250" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="bx-weight" class="bx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="40" max="180" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gegner-Reichweite (cm)</label><input type="number" id="bx-opp" class="bx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="250" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ape Index</div>
          <div class="text-5xl font-extrabold font-mono" id="bx-ape">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reichweitenvorteil</div><div class="text-xl font-bold font-mono" id="bx-adv">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewichtsklasse</div><div class="text-xl font-bold" id="bx-class">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Standbreite</div><div class="text-xl font-bold font-mono" id="bx-stance">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reichweite (cm)</div><div class="text-xl font-bold font-mono" id="bx-reachcm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Größe (cm)</div><div class="text-xl font-bold font-mono" id="bx-heightcm">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Bewertung</h3>
          <div class="text-sm space-y-1" id="bx-assessment"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Box-Gewichtsklassen</h3>
          <div class="text-xs space-y-1" id="bx-classes"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="boxreichweite" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Reichweite im Boxen verstehen</h2>
      <p>Der Ape Index ist die Differenz zwischen Armspannweite und Körpergröße. Ein positiver Wert bedeutet, dass die Arme länger sind als die Körpergröße - ein Vorteil im Boxen und MMA. Die Gewichtsklassen im Boxen reichen vom Minimumgewicht (bis 47,6 kg) bis zum Schwergewicht (über 90,7 kg).</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBX() {
      const height = parseFloat((document.getElementById('bx-height') as HTMLInputElement).value) || 0;
      const span = parseFloat((document.getElementById('bx-span') as HTMLInputElement).value) || 0;
      const weight = parseFloat((document.getElementById('bx-weight') as HTMLInputElement).value) || 0;
      const oppReach = parseFloat((document.getElementById('bx-opp') as HTMLInputElement).value) || 0;
      if (height <= 0 || span <= 0) return;
      const apeIndex = span - height;
      const apeRatio = span / height;
      const reachAdv = oppReach > 0 ? span - oppReach : 0;
      const stanceWidth = height * 0.35;
      const weightLbs = weight * 2.2046;
      const weightClasses = [
        { name: 'Minimumgewicht', max: 47.6 },
        { name: 'Leicht-Fliegengewicht', max: 49 },
        { name: 'Fliegengewicht', max: 50.8 },
        { name: 'Super-Fliegengewicht', max: 52.2 },
        { name: 'Bantamgewicht', max: 53.5 },
        { name: 'Super-Bantamgewicht', max: 55.3 },
        { name: 'Federgewicht', max: 57.2 },
        { name: 'Super-Federgewicht', max: 59 },
        { name: 'Leichtgewicht', max: 61.2 },
        { name: 'Super-Leichtgewicht', max: 63.5 },
        { name: 'Weltergewicht', max: 66.7 },
        { name: 'Super-Weltergewicht', max: 69.9 },
        { name: 'Mittelgewicht', max: 72.6 },
        { name: 'Super-Mittelgewicht', max: 76.2 },
        { name: 'Halbschwergewicht', max: 79.4 },
        { name: 'Cruisergewicht', max: 90.7 },
        { name: 'Schwergewicht', max: 999 },
      ];
      let weightClass = 'Schwergewicht';
      for (const wc of weightClasses) {
        if (weight <= wc.max) { weightClass = wc.name; break; }
      }
      document.getElementById('bx-ape')!.textContent = (apeIndex >= 0 ? '+' : '') + apeIndex.toFixed(1) + ' cm (' + apeRatio.toFixed(3) + ')';
      document.getElementById('bx-adv')!.textContent = oppReach > 0 ? ((reachAdv >= 0 ? '+' : '') + reachAdv.toFixed(1) + ' cm') : 'N/A';
      document.getElementById('bx-class')!.textContent = weightClass;
      document.getElementById('bx-stance')!.textContent = stanceWidth.toFixed(1) + ' cm';
      document.getElementById('bx-reachcm')!.textContent = span.toFixed(1);
      document.getElementById('bx-heightcm')!.textContent = height.toFixed(1);
      const assessments: string[] = [];
      if (apeIndex > 10) assessments.push('Außergewöhnlicher Reichweitenvorteil. Ihre Spannweite überragt Ihre Körpergröße deutlich.');
      else if (apeIndex > 5) assessments.push('Guter Reichweitenvorteil. Überdurchschnittlich lange Arme für Ihre Größe. Nutzen Sie Jabs und gerade Schläge auf Distanz.');
      else if (apeIndex > 0) assessments.push('Leicht positiver Ape Index. Durchschnittliche Proportionen mit ausgewogener Reichweite.');
      else if (apeIndex > -5) assessments.push('Leicht negativer Ape Index. Konzentrieren Sie sich auf das Verkürzen der Distanz und Infighting.');
      else assessments.push('Kürzere Reichweite relativ zur Größe. Arbeiten Sie an Winkeln und Nahkampftechnik.');
      if (oppReach > 0) {
        if (reachAdv > 8) assessments.push('Deutlicher Reichweitenvorteil gegenüber Gegner. Halten Sie Distanz, nutzen Sie Jabs.');
        else if (reachAdv > 0) assessments.push('Leichter Reichweitenvorteil. Sie können auf Distanz oder im Nahkampf kämpfen.');
        else if (reachAdv > -8) assessments.push('Leichter Reichweitennachteil. Erwägen Sie mehr Nahkampfarbeit.');
        else assessments.push('Deutlicher Reichweitennachteil. Verkürzen Sie schnell die Distanz, arbeiten Sie am Körper.');
      }
      document.getElementById('bx-assessment')!.innerHTML = assessments.map(a => '<p class="text-text-secondary">' + a + '</p>').join('');
      document.getElementById('bx-classes')!.innerHTML = weightClasses.map(wc => {
        const isActive = wc.name === weightClass;
        return '<div class="flex justify-between ' + (isActive ? 'font-bold text-primary' : '') + '"><span>' + wc.name + '</span><span class="font-mono">' + (wc.max < 999 ? wc.max + ' kg' : '90,7+ kg') + '</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bx-height') as HTMLInputElement).value = '180';
      (document.getElementById('bx-span') as HTMLInputElement).value = '188';
      (document.getElementById('bx-weight') as HTMLInputElement).value = '73';
      (document.getElementById('bx-opp') as HTMLInputElement).value = '183';
      document.querySelectorAll('.bx-in').forEach(el => { el.addEventListener('input', calcBX); el.addEventListener('change', calcBX); });
      calcBX();
    }, 50);
  </script>
</CalculatorLayout>
