---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Wasserwechselrechner - Volumen & Häufigkeit";
const description = "Berechnen Sie das optimale Wasserwechselvolumen und die Häufigkeit, um gesunde Nitratwerte in Ihrem Aquarium aufrechtzuerhalten.";
const relatedCalcs = [
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Wassergewicht berechnen." },
  { name: "Aquarium-Stickstoffkreislauf", url: "/aquarium-nitrogen-cycle-calculator", description: "Stickstoffkreislauf verfolgen." },
  { name: "Aquarium-Salz", url: "/de/aquarium-salz-rechner", description: "Salzdosierung für Aquariumbehandlungen." },
  { name: "Fischbesatz", url: "/fish-tank-stocking-calculator", description: "Besatzrechner für Aquarien." },
  { name: "Aquarium-Medikamente", url: "/aquarium-medication-calculator", description: "Dosierungsrechner für Fischmedikamente." },
  { name: "Aquarium-Verdunstung", url: "/aquarium-evaporation-calculator", description: "Wasserverdunstungsrate." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Aquarium-Wasserwechselrechner" keywords="Aquarium Wasserwechsel Rechner, Teilwasserwechsel, Nitrat-Management, Wasserwechsel-Plan, Aquarium-Pflege" lang="de" breadcrumbs={[{ name: "Aquarium-Wasserwechsel", url: "/de/aquarium-wasserwechsel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Wasserwechselrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie das ideale Wasserwechselvolumen und den Plan, um die Nitratwerte für Ihre Fische sicher zu halten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beckenvolumen (Liter)</label>
            <input type="number" id="awc-vol" class="awc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktuelles Nitrat (ppm)</label>
            <input type="number" id="awc-no3" class="awc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="0" step="5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ziel-Nitrat (ppm)</label>
            <input type="number" id="awc-target" class="awc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Leitungswasser-Nitrat (ppm)</label>
            <input type="number" id="awc-tap" class="awc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Besatzdichte</label>
          <select id="awc-stock" class="awc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="light">Gering besetzt</option>
            <option value="moderate" selected>Mäßig besetzt</option>
            <option value="heavy">Stark besetzt</option>
            <option value="overstocked">Überbesetzt</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Erforderlicher Wasserwechsel</div>
          <div class="text-5xl font-extrabold font-mono" id="awc-result">0 %</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zu entfernendes Volumen</div>
            <div class="text-xl font-bold font-mono" id="awc-liters">0 L</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Häufigkeit</div>
            <div class="text-xl font-bold font-mono" id="awc-freq">Wöchentlich</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Nitrat nach Wechsel</div>
            <div class="text-xl font-bold font-mono" id="awc-post">0 ppm</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wassergewicht</div>
            <div class="text-xl font-bold font-mono" id="awc-weight">0 kg</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="aquarium-water-change" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcAWC() {
      const vol = parseFloat((document.getElementById('awc-vol') as HTMLInputElement).value) || 0;
      const no3 = parseFloat((document.getElementById('awc-no3') as HTMLInputElement).value) || 0;
      const target = parseFloat((document.getElementById('awc-target') as HTMLInputElement).value) || 0;
      const tap = parseFloat((document.getElementById('awc-tap') as HTMLInputElement).value) || 0;
      const stock = (document.getElementById('awc-stock') as HTMLSelectElement).value;
      let pct = 0;
      if (no3 > tap && no3 > target) {
        pct = (no3 - target) / (no3 - tap);
      }
      pct = Math.min(pct, 0.9);
      pct = Math.max(pct, 0);
      const changeLiters = vol * pct;
      const postNO3 = no3 * (1 - pct) + tap * pct;
      const weight = changeLiters; // 1 L = 1 kg
      const freqMap: Record<string, string> = {
        light: 'Alle 2 Wochen',
        moderate: 'W\u00F6chentlich',
        heavy: '2x pro Woche',
        overstocked: 'Alle 3 Tage'
      };
      const freq = freqMap[stock] || 'W\u00F6chentlich';
      const fmt = (n: number, d: number) => n.toLocaleString('de-DE', { maximumFractionDigits: d });
      document.getElementById('awc-result')!.textContent = (pct * 100).toFixed(0) + ' %';
      document.getElementById('awc-liters')!.textContent = fmt(changeLiters, 1) + ' L';
      document.getElementById('awc-freq')!.textContent = freq;
      document.getElementById('awc-post')!.textContent = fmt(postNO3, 1) + ' ppm';
      document.getElementById('awc-weight')!.textContent = fmt(weight, 0) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.awc-in').forEach(el => { el.addEventListener('input', calcAWC); el.addEventListener('change', calcAWC); });
      calcAWC();
    }, 50);
  </script>
</CalculatorLayout>
