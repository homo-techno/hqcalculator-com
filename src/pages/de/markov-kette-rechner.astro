---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Markov-Ketten Rechner - Stationäre Verteilung und Übergangswahrscheinlichkeiten";
const description = "Berechnen Sie stationäre Verteilungen und Übergangswahrscheinlichkeiten für Markov-Ketten. Ideal für Statistik, Operations Research und Wahrscheinlichkeitsrechnung.";
const relatedCalcs = [
  { name: "Matrix Rechner", url: "/de/matrix-rechner", description: "Matrixoperationen durchführen." },
  { name: "Mittelwert Rechner", url: "/de/mittelwert-rechner", description: "Statistische Kennzahlen." },
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Wahrscheinlichkeiten berechnen." },
  { name: "Standardabweichung Rechner", url: "/de/standardabweichung-rechner", description: "Standardabweichung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="markov-chain-calculator" calculatorName="Markov-Ketten Rechner" keywords="Markov-Kette Rechner, stationäre Verteilung, Übergangsmatrix, Markov-Prozess, Wahrscheinlichkeitsrechner" breadcrumbs={[{ name: "Markov-Ketten Rechner", url: "/de/markov-kette-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Markov-Ketten Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie eine Übergangsmatrix ein und berechnen Sie die stationäre Verteilung sowie die Zustandswahrscheinlichkeiten nach n Schritten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Anzahl Zustände</label>
          <select id="mk-states" class="mk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="2" selected>2 Zustände</option>
            <option value="3">3 Zustände</option>
          </select>
        </div>
        <div id="mk-matrix-2">
          <p class="text-xs font-medium text-text mb-2">Übergangsmatrix P (Zeile = von, Spalte = nach) – Zeilensumme muss 1 ergeben</p>
          <div class="grid grid-cols-2 gap-2 mb-2">
            <div class="text-center text-xs font-bold text-text-muted">→ Z1</div>
            <div class="text-center text-xs font-bold text-text-muted">→ Z2</div>
          </div>
          <div class="grid grid-cols-2 gap-2 mb-1">
            <input type="number" id="mk-p11" class="mk-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.7" step="0.01" min="0" max="1">
            <input type="number" id="mk-p12" class="mk-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.3" step="0.01" min="0" max="1">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <input type="number" id="mk-p21" class="mk-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.4" step="0.01" min="0" max="1">
            <input type="number" id="mk-p22" class="mk-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.6" step="0.01" min="0" max="1">
          </div>
        </div>
        <div id="mk-matrix-3" class="hidden">
          <p class="text-xs font-medium text-text mb-2">Übergangsmatrix P (3 × 3)</p>
          <div class="grid grid-cols-3 gap-2">
            <input type="number" id="mk-q11" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.5" step="0.01" min="0" max="1">
            <input type="number" id="mk-q12" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.3" step="0.01" min="0" max="1">
            <input type="number" id="mk-q13" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.2" step="0.01" min="0" max="1">
            <input type="number" id="mk-q21" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.2" step="0.01" min="0" max="1">
            <input type="number" id="mk-q22" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.6" step="0.01" min="0" max="1">
            <input type="number" id="mk-q23" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.2" step="0.01" min="0" max="1">
            <input type="number" id="mk-q31" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.1" step="0.01" min="0" max="1">
            <input type="number" id="mk-q32" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.3" step="0.01" min="0" max="1">
            <input type="number" id="mk-q33" class="mk-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0.6" step="0.01" min="0" max="1">
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Schritte n</label><input type="number" id="mk-steps" class="mk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="100"></div>
        <div class="p-6 bg-primary rounded-2xl text-white">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-2 text-center">Stationäre Verteilung</div>
          <div id="mk-stat" class="text-center text-2xl font-extrabold font-mono">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Zustandswahrscheinlichkeiten nach n Schritten (aus Z1 startend)</div>
          <div id="mk-steps-out" class="font-mono text-sm">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Validierung Zeilensummen</div>
          <div id="mk-valid" class="font-bold mt-1">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="markov-kette" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Markov-Ketten einfach erklärt</h2>
      <p>Eine Markov-Kette ist ein stochastischer Prozess, bei dem die Wahrscheinlichkeit zukünftiger Zustände nur vom aktuellen Zustand abhängt (Gedächtnislosigkeit). Die stationäre Verteilung ist die langfristige Gleichgewichtsverteilung, in der sich die Zustandswahrscheinlichkeiten nicht mehr verändern. Sie wird berechnet, indem das lineare Gleichungssystem π·P = π unter der Bedingung Σπᵢ = 1 gelöst wird.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist eine Markov-Kette?</strong> Eine Markov-Kette ist ein Zufallsprozess, bei dem der nächste Zustand nur vom aktuellen Zustand abhängt, nicht von der Vergangenheit. Beispiele: Wettermodelle, Kundenloyalität, Suchmaschinenrankings.</p>
      <p><strong>Was ist die stationäre Verteilung?</strong> Die stationäre Verteilung π ist ein Wahrscheinlichkeitsvektor, der sich beim Multiplizieren mit der Übergangsmatrix nicht verändert: π·P = π.</p>
      <p><strong>Wofür werden Markov-Ketten verwendet?</strong> Anwendungen finden sich in der Qualitätskontrolle, Wartungsplanung, Finanzmodellierung, Sprachverarbeitung (NLP) und bei Google PageRank.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function matMul(A: number[][], B: number[][]): number[][] {
      const n = A.length;
      const C: number[][] = Array.from({ length: n }, () => Array(n).fill(0));
      for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) for (let k = 0; k < n; k++) C[i][j] += A[i][k] * B[k][j];
      return C;
    }
    function calcMK() {
      const statesCount = parseInt((document.getElementById('mk-states') as HTMLSelectElement).value) || 2;
      const steps = parseInt((document.getElementById('mk-steps') as HTMLInputElement).value) || 10;
      document.getElementById('mk-matrix-2')!.classList.toggle('hidden', statesCount !== 2);
      document.getElementById('mk-matrix-3')!.classList.toggle('hidden', statesCount !== 3);
      let P: number[][] = [];
      if (statesCount === 2) {
        const p11 = parseFloat((document.getElementById('mk-p11') as HTMLInputElement).value) || 0;
        const p12 = parseFloat((document.getElementById('mk-p12') as HTMLInputElement).value) || 0;
        const p21 = parseFloat((document.getElementById('mk-p21') as HTMLInputElement).value) || 0;
        const p22 = parseFloat((document.getElementById('mk-p22') as HTMLInputElement).value) || 0;
        P = [[p11, p12], [p21, p22]];
      } else {
        const ids = ['mk-q11','mk-q12','mk-q13','mk-q21','mk-q22','mk-q23','mk-q31','mk-q32','mk-q33'];
        const vals = ids.map(id => parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0);
        P = [[vals[0],vals[1],vals[2]],[vals[3],vals[4],vals[5]],[vals[6],vals[7],vals[8]]];
      }
      const n = statesCount;
      const rowSums = P.map(row => row.reduce((a, b) => a + b, 0));
      const valid = rowSums.every(s => Math.abs(s - 1) < 0.001);
      document.getElementById('mk-valid')!.textContent = valid ? 'Alle Zeilen ergeben 1,00 ✓' : 'Fehler: Zeilensummen: ' + rowSums.map(s => s.toFixed(2)).join(', ');
      document.getElementById('mk-valid')!.className = 'font-bold mt-1 ' + (valid ? 'text-green-600' : 'text-red-600');
      if (!valid) { document.dispatchEvent(new CustomEvent('calc-update')); return; }
      let Pn = P.map(r => [...r]);
      for (let s = 1; s < steps; s++) Pn = matMul(Pn, P);
      const stepsOut = Array.from({ length: n }, (_, j) => 'Z' + (j+1) + ': ' + (Pn[0][j] * 100).toFixed(2).replace('.', ',') + '%').join('  |  ');
      document.getElementById('mk-steps-out')!.textContent = stepsOut;
      let stat: number[] = [];
      if (n === 2) {
        const denom = P[1][0] + P[0][1];
        stat = denom > 0 ? [P[1][0] / denom, P[0][1] / denom] : [0.5, 0.5];
      } else {
        stat = Pn[0];
      }
      document.getElementById('mk-stat')!.textContent = stat.map((v, i) => 'π' + (i+1) + ' = ' + (v*100).toFixed(2).replace('.', ',') + '%').join('  ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mk-in').forEach(el => { el.addEventListener('input', calcMK); el.addEventListener('change', calcMK); });
      calcMK();
    }, 50);
  </script>
</CalculatorLayout>
