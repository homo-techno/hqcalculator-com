---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Glasurchemie-Rechner - Oxidanalyse, COE & Verhältnisse";
const description = "Analysieren Sie die Glasur-Oxidchemie einschließlich Silizium-zu-Aluminium-Verhältnis, Flussmittelverhältnisse und Ausdehnungskoeffizient (COE).";
const relatedCalcs = [
  { name: "Glasurrezept-Rechner", url: "/de/glasurrezept-rechner", description: "Glasurrezepte skalieren." },
  { name: "Glasfusing-Rechner", url: "/de/glasfusing-rechner", description: "Glasfusing-Brennpläne." },
  { name: "Glasdicke-Rechner", url: "/de/glasdicke-rechner", description: "Glasdicke berechnen." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Glasurchemie-Rechner" enSlug="glaze-chemistry-calculator" keywords="Glasurchemie, Oxidanalyse, Seger-Formel, Silizium Aluminium Verhältnis, Glasur COE, Flussmittelverhältnis, Keramikchemie" breadcrumbs={[{ name: "Glasurchemie-Rechner", url: "/de/glasurchemie-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Glasurchemie-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie die Glasurchemie durch Eingabe molarer Oxidwerte. Prüfen Sie das Si:Al-Verhältnis, die Flussmittelbalance und den geschätzten COE.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <h3 class="font-semibold text-text mb-3">Flussmitteloxide (RO/R2O) - Unity = 1,0</h3>
      <div class="grid grid-cols-2 gap-3 mb-5">
        <div><label class="block text-xs font-medium text-text mb-1">Na2O (Natron)</label><input type="number" id="gchem-na2o" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.15" min="0" max="1" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">K2O (Pottasche)</label><input type="number" id="gchem-k2o" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.20" min="0" max="1" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">CaO (Kalzium)</label><input type="number" id="gchem-cao" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.40" min="0" max="1" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">MgO (Magnesium)</label><input type="number" id="gchem-mgo" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.10" min="0" max="1" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">ZnO (Zink)</label><input type="number" id="gchem-zno" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.05" min="0" max="1" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">BaO (Barium)</label><input type="number" id="gchem-bao" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.10" min="0" max="1" step="0.01"></div>
      </div>
      <h3 class="font-semibold text-text mb-3">Amphoter (R2O3)</h3>
      <div class="grid grid-cols-2 gap-3 mb-5">
        <div><label class="block text-xs font-medium text-text mb-1">Al2O3 (Tonerde)</label><input type="number" id="gchem-al2o3" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.35" min="0" max="2" step="0.01"></div>
        <div><label class="block text-xs font-medium text-text mb-1">B2O3 (Bor)</label><input type="number" id="gchem-b2o3" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.00" min="0" max="2" step="0.01"></div>
      </div>
      <h3 class="font-semibold text-text mb-3">Glasbildner (RO2)</h3>
      <div class="mb-5">
        <label class="block text-xs font-medium text-text mb-1">SiO2 (Quarz)</label>
        <input type="number" id="gchem-sio2" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.00" min="0" max="10" step="0.1">
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Brennbereich</label>
        <select id="gchem-range" class="gchem-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="low">Niederbrand (Kegel 06-01)</option>
          <option value="mid" selected>Mittelbrand (Kegel 4-7)</option>
          <option value="high">Hochbrand (Kegel 8-10)</option>
        </select>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Si:Al-Verhältnis</div>
        <div class="text-4xl font-extrabold" id="gchem-si-al">--</div>
        <div class="text-sm text-blue-200 mt-1" id="gchem-si-al-note">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flussmittel Unity</div><div class="text-xl font-bold" id="gchem-flux-total">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. COE (x10^-7)</div><div class="text-xl font-bold" id="gchem-coe">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Alkali-Anteil</div><div class="text-xl font-bold" id="gchem-alkali">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Glasur-Passung</div><div class="text-xl font-bold" id="gchem-fit">--</div></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <h3 class="font-semibold text-sm text-text mb-2">Analyse</h3>
        <ul class="text-xs text-text-muted space-y-1" id="gchem-analysis"></ul>
      </div>

      <ShareButton lang="de" calculatorId="glasurchemie" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Glasurchemie verstehen</h2>
      <p>Die Seger-Einheitsformel drückt die Glasurzusammensetzung in Molverhältnissen aus, wobei die Flussmittel auf 1,0 summiert werden. Schlüsselverhältnisse wie das Silizium-zu-Aluminium-Verhältnis bestimmen Oberflächenqualität, Haltbarkeit und Schmelzverhalten.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist die Seger-Formel?</strong> Die Seger-Formel ist eine normierte Darstellung der Glasurzusammensetzung, bei der die Flussmitteloxide auf 1,0 normiert werden.</p>
      <p><strong>Was bedeutet das Si:Al-Verhältnis?</strong> Ein niedriges Verhältnis (3-5) ergibt matte Oberflächen, ein hohes (6-10) glänzende. Zu hohe Werte können Ablaufen verursachen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcGCHEM() {
      const na2o = parseFloat((document.getElementById('gchem-na2o') as HTMLInputElement).value) || 0;
      const k2o = parseFloat((document.getElementById('gchem-k2o') as HTMLInputElement).value) || 0;
      const cao = parseFloat((document.getElementById('gchem-cao') as HTMLInputElement).value) || 0;
      const mgo = parseFloat((document.getElementById('gchem-mgo') as HTMLInputElement).value) || 0;
      const zno = parseFloat((document.getElementById('gchem-zno') as HTMLInputElement).value) || 0;
      const bao = parseFloat((document.getElementById('gchem-bao') as HTMLInputElement).value) || 0;
      const al2o3 = parseFloat((document.getElementById('gchem-al2o3') as HTMLInputElement).value) || 0;
      const b2o3 = parseFloat((document.getElementById('gchem-b2o3') as HTMLInputElement).value) || 0;
      const sio2 = parseFloat((document.getElementById('gchem-sio2') as HTMLInputElement).value) || 0;
      const range = (document.getElementById('gchem-range') as HTMLSelectElement).value;

      const fluxTotal = na2o + k2o + cao + mgo + zno + bao;
      const alkaliTotal = na2o + k2o;
      const siAlRatio = al2o3 > 0 ? sio2 / al2o3 : 0;

      const coe = (na2o * 39.5 + k2o * 28.3 + cao * 16.7 + mgo * 6.0 +
                   zno * 7.0 + bao * 14.0 + al2o3 * (-5.0) + b2o3 * (-6.5) + sio2 * 3.8) /
                  (fluxTotal + al2o3 + b2o3 + sio2);

      document.getElementById('gchem-si-al')!.textContent = siAlRatio.toFixed(1) + ':1';
      document.getElementById('gchem-flux-total')!.textContent = fluxTotal.toFixed(2);
      document.getElementById('gchem-coe')!.textContent = (coe * 10).toFixed(1);
      document.getElementById('gchem-alkali')!.textContent = (alkaliTotal * 100 / Math.max(fluxTotal, 0.01)).toFixed(0) + '%';

      const idealRanges: Record<string, {siAlMin: number, siAlMax: number, alMin: number, alMax: number, siMin: number, siMax: number}> = {
        low: { siAlMin: 5, siAlMax: 15, alMin: 0.10, alMax: 0.35, siMin: 1.5, siMax: 3.5 },
        mid: { siAlMin: 5, siAlMax: 10, alMin: 0.25, alMax: 0.50, siMin: 2.5, siMax: 4.5 },
        high: { siAlMin: 5, siAlMax: 12, alMin: 0.30, alMax: 0.70, siMin: 3.0, siMax: 6.0 }
      };
      const ideal = idealRanges[range] || idealRanges['mid'];

      let siAlNote = '';
      if (siAlRatio < 5) siAlNote = 'Sehr matt / unterbrandiges Erscheinungsbild';
      else if (siAlRatio < 7) siAlNote = 'Seidig bis matte Oberfläche';
      else if (siAlRatio < 10) siAlNote = 'Glänzende Oberfläche';
      else siAlNote = 'Sehr glänzend / kann ablaufen';
      document.getElementById('gchem-si-al-note')!.textContent = siAlNote;

      const coeVal = coe * 10;
      let fitLabel = 'Gut';
      if (coeVal > 80) fitLabel = 'Hoher COE - kann Haarrisse bilden';
      else if (coeVal > 70) fitLabel = 'Leicht hoch';
      else if (coeVal < 50) fitLabel = 'Niedriger COE - kann abplatzen';
      else if (coeVal < 60) fitLabel = 'Leicht niedrig';
      document.getElementById('gchem-fit')!.textContent = fitLabel;

      const rangeLabels: Record<string, string> = { low: 'Niederbrand', mid: 'Mittelbrand', high: 'Hochbrand' };
      const analysis: string[] = [];
      if (Math.abs(fluxTotal - 1.0) > 0.05) {
        analysis.push('Flussmittel-Summe ist ' + fluxTotal.toFixed(2) + ' (sollte 1,0 sein für Einheitsformel)');
      } else {
        analysis.push('Flussmittel-Unity ist ausgewogen bei ' + fluxTotal.toFixed(2));
      }
      if (al2o3 < ideal.alMin) analysis.push('Al2O3 ist niedrig (' + al2o3.toFixed(2) + ') - Glasur kann zu fließend oder nicht haltbar sein');
      else if (al2o3 > ideal.alMax) analysis.push('Al2O3 ist hoch (' + al2o3.toFixed(2) + ') - Glasur kann zu steif sein');
      else analysis.push('Al2O3 ist im guten Bereich f\u00fcr ' + rangeLabels[range]);
      if (sio2 < ideal.siMin) analysis.push('SiO2 ist niedrig (' + sio2.toFixed(1) + ') - kann an Haltbarkeit mangeln');
      else if (sio2 > ideal.siMax) analysis.push('SiO2 ist hoch (' + sio2.toFixed(1) + ') - kann nicht vollständig schmelzen');
      else analysis.push('SiO2 ist im guten Bereich');
      if (alkaliTotal > 0.40) analysis.push('Hoher Alkali-Flussmittelanteil (' + alkaliTotal.toFixed(2) + ') - erhöhtes Haarriss-Risiko');
      if (cao > 0.50) analysis.push('Hoher CaO-Anteil kann matte oder kristalline Oberfläche erzeugen');
      if (mgo > 0.25) analysis.push('Hoher MgO-Anteil erzeugt glatte, butterweiche matte Oberflächen');

      const ul = document.getElementById('gchem-analysis')!;
      ul.innerHTML = '';
      analysis.forEach(note => {
        const li = document.createElement('li');
        li.textContent = note;
        ul.appendChild(li);
      });

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.gchem-in').forEach(el => {
        el.addEventListener('input', calcGCHEM);
        el.addEventListener('change', calcGCHEM);
      });
      calcGCHEM();
    }, 50);
  </script>
</CalculatorLayout>
