---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Chemisches Peeling Rechner - Tiefe & Erholungszeit";
const description = "Berechnen Sie die empfohlene Peeling-Tiefe, Erholungszeit und erwartete Ergebnisse basierend auf Hauttyp und Saeuretyp.";
const relatedCalcs = [
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI fuer Kinder." },
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrung." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner", description: "Statistik." },
  { name: "Kinderdosierung-Rechner", url: "/de/kinderdosierung-rechner", description: "Medikamentendosierung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Chemisches Peeling Rechner" enSlug="chemical-peel-calculator" keywords="chemisches Peeling, Peeling-Tiefe, Erholungszeit, AHA Peeling, TCA Peeling, Glykolsaeure, Hautresurfacing" breadcrumbs={[{ name: "Chemisches Peeling", url: "/de/chemisches-peeling-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Chemisches Peeling Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die richtige Peeling-Tiefe, Erholungszeit und erwartete Ergebnisse fuer Ihren Hauttyp.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hauptanliegen</label>
          <select id="cp-concern" class="cp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="dullness">Fahle Haut / Unebene Textur</option>
            <option value="acne">Akne / Unreinheiten</option>
            <option value="pigment">Hyperpigmentierung / Dunkle Flecken</option>
            <option value="aging">Feine Linien / Falten</option>
            <option value="scars">Aknenarben / Tiefe Textur</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hauttyp (Fitzpatrick)</label>
          <select id="cp-skin" class="cp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Typ I - Sehr hell</option>
            <option value="2">Typ II - Hell</option>
            <option value="3" selected>Typ III - Mittel</option>
            <option value="4">Typ IV - Oliv</option>
            <option value="5">Typ V - Braun</option>
            <option value="6">Typ VI - Dunkel</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Peeling-Typ</label>
          <select id="cp-type" class="cp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="glycolic">Glykolsaeure (AHA)</option>
            <option value="salicylic">Salicylsaeure (BHA)</option>
            <option value="lactic">Milchsaeure</option>
            <option value="tca">TCA (Trichloressigsaeure)</option>
            <option value="jessner">Jessner-Loesung</option>
            <option value="phenol">Phenol (Tief)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Konzentration / Staerke</label>
          <select id="cp-strength" class="cp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="low">Niedrig (Anfaenger / empfindliche Haut)</option>
            <option value="medium" selected>Mittel (Standardbehandlung)</option>
            <option value="high">Hoch (erfahren / aggressiv)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Peeling-Tiefe</div>
          <div class="text-4xl font-extrabold font-mono" id="cp-depth">--</div>
          <div class="text-sm text-blue-200 mt-1" id="cp-layer">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erholungszeit</div><div class="text-xl font-bold" id="cp-recovery">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sitzungen noetig</div><div class="text-xl font-bold" id="cp-sessions">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sitzungsintervall</div><div class="text-xl font-bold" id="cp-interval">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Risikostufe</div><div class="text-xl font-bold" id="cp-risk">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Nachbehandlungspflege</h3>
          <div class="text-sm space-y-1" id="cp-care"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="chemisches-peeling" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Leitfaden Chemisches Peeling</h2>
      <p>Chemische Peelings verwenden Saeureloesungen, um geschaedigte Hautschichten abzutragen und glattere, ebenmaeßigere Haut freizulegen. Oberflaechliche Peelings (AHA, BHA) behandeln milde Beschwerden mit minimaler Ausfallzeit. Mitteltiefe Peelings (TCA, Jessner) behandeln Pigmentierung und feine Linien mit 5-7 Tagen Erholung. Tiefe Peelings (Phenol) behandeln schwere Narbenbildung, erfordern aber Wochen der Erholung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCP() {
      const concern = (document.getElementById('cp-concern') as HTMLSelectElement).value;
      const skinType = parseInt((document.getElementById('cp-skin') as HTMLSelectElement).value);
      const peelType = (document.getElementById('cp-type') as HTMLSelectElement).value;
      const strength = (document.getElementById('cp-strength') as HTMLSelectElement).value;
      let depth = 'Oberflaechlich'; let layer = 'Nur Epidermis'; let recovery = '1-3 Tage'; let sessions = '4-6'; let interval = '2-4 Wochen'; let risk = 'Niedrig';
      if (peelType === 'glycolic' || peelType === 'lactic') {
        if (strength === 'low') { depth = 'Sehr oberflaechlich'; layer = 'Hornschicht'; recovery = '0-1 Tage'; sessions = '6-8'; interval = '2 Wochen'; risk = 'Sehr niedrig'; }
        else if (strength === 'medium') { depth = 'Oberflaechlich'; layer = 'Epidermis'; recovery = '1-3 Tage'; sessions = '4-6'; interval = '3-4 Wochen'; risk = 'Niedrig'; }
        else { depth = 'Mittel-oberflaechlich'; layer = 'Obere Epidermis bis papillaere Dermis'; recovery = '3-5 Tage'; sessions = '3-4'; interval = '4-6 Wochen'; risk = 'Mittel'; }
      } else if (peelType === 'salicylic') {
        if (strength === 'low') { depth = 'Sehr oberflaechlich'; layer = 'Hornschicht'; recovery = '0-1 Tage'; sessions = '6-8'; interval = '2 Wochen'; risk = 'Sehr niedrig'; }
        else if (strength === 'medium') { depth = 'Oberflaechlich'; layer = 'Epidermis'; recovery = '1-2 Tage'; sessions = '4-6'; interval = '2-4 Wochen'; risk = 'Niedrig'; }
        else { depth = 'Oberflaechlich'; layer = 'Gesamte Epidermis'; recovery = '2-4 Tage'; sessions = '3-5'; interval = '3-4 Wochen'; risk = 'Niedrig'; }
      } else if (peelType === 'tca') {
        if (strength === 'low') { depth = 'Oberflaechlich'; layer = 'Epidermis'; recovery = '3-5 Tage'; sessions = '3-4'; interval = '4-6 Wochen'; risk = 'Niedrig-Mittel'; }
        else if (strength === 'medium') { depth = 'Mitteltief'; layer = 'Papillaere Dermis'; recovery = '5-7 Tage'; sessions = '2-3'; interval = '6-8 Wochen'; risk = 'Mittel'; }
        else { depth = 'Mitteltief-Tief'; layer = 'Retikulaere Dermis'; recovery = '7-14 Tage'; sessions = '1-2'; interval = '3-6 Monate'; risk = 'Hoch'; }
      } else if (peelType === 'jessner') {
        if (strength === 'low') { depth = 'Oberflaechlich'; layer = 'Epidermis'; recovery = '2-4 Tage'; sessions = '3-5'; interval = '3-4 Wochen'; risk = 'Niedrig'; }
        else if (strength === 'medium') { depth = 'Mitteltief'; layer = 'Obere Dermis'; recovery = '5-7 Tage'; sessions = '2-3'; interval = '6-8 Wochen'; risk = 'Mittel'; }
        else { depth = 'Mitteltief'; layer = 'Papillaere Dermis'; recovery = '7-10 Tage'; sessions = '1-2'; interval = '2-3 Monate'; risk = 'Mittel-Hoch'; }
      } else if (peelType === 'phenol') {
        depth = 'Tief'; layer = 'Mittlere retikulaere Dermis'; recovery = '14-21 Tage'; sessions = '1'; interval = 'Einmalig'; risk = 'Hoch';
        if (strength === 'low') { recovery = '10-14 Tage'; risk = 'Mittel-Hoch'; }
        else if (strength === 'high') { recovery = '21-30 Tage'; risk = 'Sehr hoch'; }
      }
      if (skinType >= 4) {
        if (risk === 'Niedrig') risk = 'Mittel';
        else if (risk === 'Mittel') risk = 'Hoch';
        else if (risk === 'Hoch') risk = 'Sehr hoch';
      }
      const care: string[] = [];
      care.push('Mindestens 4 Wochen nach dem Peeling taeglich LSF 30+ auftragen.');
      care.push('Direkte Sonneneinstrahlung waehrend der Erholungszeit meiden.');
      care.push('Haut mit sanften, parfuemfreien Produkten feucht halten.');
      if (depth.includes('Mittel') || depth.includes('Tief')) {
        care.push('Abschaelende Haut nicht abziehen - natuerlich abloesen lassen.');
        care.push('Retinoide und Peelingprodukte bis zur vollstaendigen Heilung meiden.');
      }
      if (skinType >= 4) care.push('Dunklere Hauttypen: Tyrosinase-Hemmer vor/nach dem Peeling verwenden, um PIH zu vermeiden.');
      document.getElementById('cp-depth')!.textContent = depth;
      document.getElementById('cp-layer')!.textContent = layer;
      document.getElementById('cp-recovery')!.textContent = recovery;
      document.getElementById('cp-sessions')!.textContent = sessions;
      document.getElementById('cp-interval')!.textContent = interval;
      document.getElementById('cp-risk')!.textContent = risk;
      document.getElementById('cp-care')!.innerHTML = care.map(c => '<p>' + c + '</p>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.cp-in').forEach(el => { el.addEventListener('input', calcCP); el.addEventListener('change', calcCP); });
      calcCP();
    }, 50);
  </script>
</CalculatorLayout>
