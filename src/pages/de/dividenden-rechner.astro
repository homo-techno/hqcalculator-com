---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Dividendenrechner - Dividendeneinkommen berechnen 2026";
const description = "Berechne dein jaehrliches Dividendeneinkommen aus deinem Aktienportfolio. Rendite, monatliches Einkommen und Wachstumsprognosen mit Wiederanlage anzeigen.";

const relatedCalcs = [
  { name: "Investitionsrechner", url: "/de/investitionsrechner", description: "Investitionswachstum." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Zinseszinsrechner", url: "/de/zinseszins-rechner", description: "Zinseszins berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
  { name: "Rentenrechner", url: "/de/rentenrechner", description: "Altersvorsorge." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Dividendenrechner" keywords="Dividendenrechner, Dividendeneinkommen, Dividendenrendite, DRIP Rechner, Dividenden Wiederanlage" breadcrumbs={[{ name: "Dividendenrechner", url: "/de/dividenden-rechner" }]} lang="de" enSlug="dividend-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dividendenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetze dein Dividendeneinkommen und sieh die Kraft der Wiederanlage ueber die Zeit.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Anlagebetrag</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="dvde-amount" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="50000" min="0" step="1000">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Dividendenrendite (%)</label>
              <input type="number" id="dvde-yield" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3.5" min="0" max="30" step="0.1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Dividendenwachstum (%/Jahr)</label>
              <input type="number" id="dvde-growth" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="5" min="0" max="30" step="0.5">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Haltedauer (Jahre)</label>
              <input type="number" id="dvde-years" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="1" max="50" step="1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Steuersatz auf Dividenden (%)</label>
              <input type="number" id="dvde-tax" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="26" min="0" max="50" step="1">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Dividenden wiederanlegen?</label>
            <select id="dvde-drip" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="yes" selected>Ja — Alle Dividenden wiederanlegen</option>
              <option value="no">Nein — Dividenden als Bargeld auszahlen</option>
            </select>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jaehrliches Dividendeneinkommen (Jahr 1)</div>
            <div class="text-5xl font-extrabold" id="dvde-annual">0 &euro;</div>
            <div class="text-sm text-blue-200 mt-1" id="dvde-monthly-sub">0 &euro; / Monat (nach Steuer)</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Monatliches Einkommen</div>
              <div class="text-xl font-bold text-secondary" id="dvde-monthly">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Nach Steuer jaehrlich</div>
              <div class="text-xl font-bold" id="dvde-after-tax">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Dividenden gesamt</div>
              <div class="text-xl font-bold" id="dvde-total">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Portfoliowert (Ende)</div>
              <div class="text-xl font-bold" id="dvde-portfolio">0 &euro;</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Jahresweise Prognose</h3>
            <div class="space-y-1 text-sm" id="dvde-table"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="dividend" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie Dividendeneinkommen funktioniert</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Jaehrliche Dividende</strong> = Anlage &times; Dividendenrendite</p>
        <p><strong>Nach Steuer</strong> = Jaehrliche Dividende &times; (1 &minus; Steuersatz)</p>
        <p><strong>Wiederanlage:</strong> Reinvestierte Dividenden kaufen weitere Anteile und erhoehen das kuenftige Einkommen</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist eine gute Dividendenrendite?</strong> In Deutschland liegt die durchschnittliche Dividendenrendite bei 2-4 %. Renditen ueber 5 % koennen auf hoehere Risiken hindeuten.</p>
      <p><strong>Was ist der DRIP-Effekt?</strong> DRIP (Dividend Reinvestment Plan) bedeutet, dass Dividenden automatisch wiederangelegt werden. Durch den Zinseszinseffekt waechst das Vermoegen schneller.</p>
      <p><strong>Wie werden Dividenden in Deutschland besteuert?</strong> Dividenden unterliegen der Abgeltungssteuer von 25 % plus Solidaritaetszuschlag, insgesamt ca. 26,375 %.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const dvdeFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcDvde() {
      const amount = parseFloat((document.getElementById('dvde-amount') as HTMLInputElement).value) || 0;
      const yieldPct = (parseFloat((document.getElementById('dvde-yield') as HTMLInputElement).value) || 0) / 100;
      const growthPct = (parseFloat((document.getElementById('dvde-growth') as HTMLInputElement).value) || 0) / 100;
      const years = parseInt((document.getElementById('dvde-years') as HTMLInputElement).value) || 1;
      const taxRate = (parseFloat((document.getElementById('dvde-tax') as HTMLInputElement).value) || 0) / 100;
      const drip = (document.getElementById('dvde-drip') as HTMLSelectElement).value === 'yes';

      const annualDiv = amount * yieldPct;
      const afterTax = annualDiv * (1 - taxRate);

      document.getElementById('dvde-annual')!.textContent = dvdeFmt(annualDiv);
      document.getElementById('dvde-monthly')!.textContent = dvdeFmt(afterTax / 12);
      document.getElementById('dvde-after-tax')!.textContent = dvdeFmt(afterTax);
      document.getElementById('dvde-monthly-sub')!.textContent = dvdeFmt(afterTax / 12) + ' / Monat (nach Steuer)';

      let portfolio = amount;
      let totalDividends = 0;
      let currentYield = yieldPct;
      const rows: string[] = [];

      rows.push('<div class="grid grid-cols-4 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Jahr</span><span>Dividende</span><span>Rendite</span><span>Portfolio</span></div>');

      for (let y = 1; y <= years; y++) {
        const div = portfolio * currentYield;
        totalDividends += div;
        if (drip) portfolio += div * (1 - taxRate);
        currentYield *= (1 + growthPct);

        if (y <= 10 || y === years || y % 5 === 0) {
          rows.push('<div class="grid grid-cols-4 gap-1 text-xs"><span>' + y + '</span><span>' + dvdeFmt(div) + '</span><span>' + (currentYield / (1 + growthPct) * 100).toFixed(1).replace('.', ',') + '%</span><span>' + dvdeFmt(portfolio) + '</span></div>');
        }
      }

      document.getElementById('dvde-total')!.textContent = dvdeFmt(totalDividends);
      document.getElementById('dvde-portfolio')!.textContent = dvdeFmt(portfolio);
      document.getElementById('dvde-table')!.innerHTML = rows.join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['dvde-amount', 'dvde-yield', 'dvde-growth', 'dvde-years', 'dvde-tax'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcDvde);
      });
      document.getElementById('dvde-drip')!.addEventListener('change', calcDvde);
      calcDvde();
    }, 50);
  </script>
</CalculatorLayout>
