---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kinder-BMI-Rechner - BMI-Perzentile nach Alter & Geschlecht";
const description = "Berechnen Sie das BMI-Perzentil Ihres Kindes anhand von Wachstumstabellen. Bestimmen Sie den Gewichtsstatus fuer Kinder von 2-20 Jahren.";
const relatedCalcs = [
  { name: "Kindergroesse-Rechner", url: "/de/kindergroesse-rechner", description: "Groessenvorhersage." },
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrungsbedarf." },
  { name: "Kinderdosierung-Rechner", url: "/de/kinderdosierung-rechner", description: "Medikamentendosierung." },
  { name: "Kindesunterhalt-Rechner", url: "/de/kindesunterhalt-rechner", description: "Unterhalt." },
  { name: "Huehnerfutter-Rechner", url: "/de/huehnerfutter-rechner", description: "Futterberechnung." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kinder-BMI-Rechner" enSlug="child-bmi-calculator" keywords="Kinder-BMI-Rechner, paediatrischer BMI, BMI-Perzentil, Gewichtsstatus Kind, Wachstumskurve" breadcrumbs={[{ name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kinder-BMI-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den BMI und das Perzentil Ihres Kindes fuer Alter 2-20 Jahre.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Geschlecht</label>
          <select id="kb-gender" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="boy">Junge</option>
            <option value="girl">Maedchen</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Alter</label>
          <div class="flex gap-3">
            <div class="flex-1"><label class="block text-xs text-text-muted mb-1">Jahre</label><input type="number" id="kb-years" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="2" max="19" step="1"></div>
            <div class="flex-1"><label class="block text-xs text-text-muted mb-1">Monate</label><input type="number" id="kb-months" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="11" step="1"></div>
          </div>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="kb-weight" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="5" max="150" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Groesse (cm)</label><input type="number" id="kb-height" class="kb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="128" min="50" max="220" step="1"></div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">BMI-Perzentil</div>
        <div class="text-5xl font-extrabold" id="kb-percentile">--</div>
        <div class="text-sm text-blue-200 mt-1" id="kb-category">Gewichtsstatus</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">BMI-Wert</div><div class="text-lg font-bold" id="kb-bmi">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewichtsstatus</div><div class="text-lg font-bold" id="kb-status">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesunder BMI-Bereich</div><div class="text-lg font-bold" id="kb-healthy">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesunder Gewichtsbereich</div><div class="text-lg font-bold" id="kb-weightrange">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">BMI-Kategorien fuer Kinder</h3>
        <div class="text-xs" id="kb-chart"></div>
      </div>
      <ShareButton lang="de" calculatorId="kinder-bmi" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kinder-BMI verstehen</h2>
      <p>Anders als beim Erwachsenen-BMI wird der BMI von Kindern anhand alters- und geschlechtsspezifischer Perzentile interpretiert, da sich die Koerperzusammensetzung waehrend des Wachstums veraendert.</p>
      <h3 class="text-xl font-semibold text-text mt-8">BMI-Perzentil-Kategorien</h3>
      <ul>
        <li><strong>Untergewicht:</strong> Unter dem 5. Perzentil</li>
        <li><strong>Normalgewicht:</strong> 5. bis 84. Perzentil</li>
        <li><strong>Uebergewicht:</strong> 85. bis 94. Perzentil</li>
        <li><strong>Adipositas:</strong> 95. Perzentil oder hoeher</li>
      </ul>
      <p class="mt-4">Der BMI ist ein Screening-Werkzeug, kein Diagnoseinstrument. Sprechen Sie mit dem Kinderarzt fuer eine vollstaendige Beurteilung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKB() {
      const gender = (document.getElementById('kb-gender') as HTMLSelectElement).value;
      const years = parseFloat((document.getElementById('kb-years') as HTMLInputElement).value) || 8;
      const months = parseFloat((document.getElementById('kb-months') as HTMLInputElement).value) || 0;
      const weightKg = parseFloat((document.getElementById('kb-weight') as HTMLInputElement).value) || 25;
      const heightCm = parseFloat((document.getElementById('kb-height') as HTMLInputElement).value) || 128;
      const heightM = heightCm / 100;
      const bmi = weightKg / (heightM * heightM);
      const ageMonths = years * 12 + months;
      const medianBoy: Record<number, number> = {24:16.5,36:16.0,48:15.7,60:15.5,72:15.5,84:15.7,96:16.0,108:16.5,120:17.0,132:17.7,144:18.5,156:19.3,168:20.1,180:20.9,192:21.6,204:22.2,216:22.7,228:23.1,240:23.5};
      const medianGirl: Record<number, number> = {24:16.3,36:15.8,48:15.5,60:15.4,72:15.5,84:15.8,96:16.2,108:16.8,120:17.5,132:18.3,144:19.1,156:19.9,168:20.6,180:21.2,192:21.6,204:21.9,216:22.1,228:22.3,240:22.5};
      const medianData = gender === 'boy' ? medianBoy : medianGirl;
      const ages = Object.keys(medianData).map(Number).sort((a, b) => a - b);
      let median = 16;
      for (let i = 0; i < ages.length - 1; i++) {
        if (ageMonths >= ages[i] && ageMonths <= ages[i + 1]) {
          const frac = (ageMonths - ages[i]) / (ages[i + 1] - ages[i]);
          median = medianData[ages[i]] + frac * (medianData[ages[i + 1]] - medianData[ages[i]]);
          break;
        }
      }
      if (ageMonths >= 240) median = medianData[240];
      if (ageMonths <= 24) median = medianData[24];
      const spread = gender === 'boy' ? 3.0 : 2.8;
      const z = (bmi - median) / spread;
      function zToPercentile(z: number): number {
        const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429;
        const p = 0.3275911;
        const sign = z < 0 ? -1 : 1;
        const x = Math.abs(z) / Math.sqrt(2);
        const t = 1.0 / (1.0 + p * x);
        const erf = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
        return Math.round(((1 + sign * erf) / 2) * 1000) / 10;
      }
      let percentile = zToPercentile(z);
      percentile = Math.max(0.1, Math.min(99.9, percentile));
      let status = '', category = '';
      if (percentile < 5) { status = 'Untergewicht'; category = 'Unter dem 5. Perzentil'; }
      else if (percentile < 85) { status = 'Normalgewicht'; category = '5. - 84. Perzentil'; }
      else if (percentile < 95) { status = 'Uebergewicht'; category = '85. - 94. Perzentil'; }
      else { status = 'Adipositas'; category = '95. Perzentil oder hoeher'; }
      const healthyBmiLow = median - 1.5;
      const healthyBmiHigh = median + 2.5;
      const healthyWeightLow = healthyBmiLow * heightM * heightM;
      const healthyWeightHigh = healthyBmiHigh * heightM * heightM;
      document.getElementById('kb-percentile')!.textContent = percentile.toFixed(1) + '%';
      document.getElementById('kb-category')!.textContent = category;
      document.getElementById('kb-bmi')!.textContent = bmi.toFixed(1);
      document.getElementById('kb-status')!.textContent = status;
      document.getElementById('kb-healthy')!.textContent = healthyBmiLow.toFixed(1) + ' - ' + healthyBmiHigh.toFixed(1);
      document.getElementById('kb-weightrange')!.textContent = Math.round(healthyWeightLow) + ' - ' + Math.round(healthyWeightHigh) + ' kg';
      const categories = [
        { name: 'Untergewicht', range: 'Unter 5.', color: percentile < 5 ? 'bg-blue-50 font-bold' : '' },
        { name: 'Normalgewicht', range: '5. - 84.', color: percentile >= 5 && percentile < 85 ? 'bg-blue-50 font-bold' : '' },
        { name: 'Uebergewicht', range: '85. - 94.', color: percentile >= 85 && percentile < 95 ? 'bg-blue-50 font-bold' : '' },
        { name: 'Adipositas', range: '95. & hoeher', color: percentile >= 95 ? 'bg-blue-50 font-bold' : '' },
      ];
      document.getElementById('kb-chart')!.innerHTML =
        '<div class="grid grid-cols-2 gap-2 font-semibold text-text-muted mb-1"><span>Kategorie</span><span>Perzentilbereich</span></div>' +
        categories.map(c => '<div class="grid grid-cols-2 gap-2 py-1 rounded ' + c.color + '"><span>' + c.name + '</span><span>' + c.range + '</span></div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kb-in').forEach(el => { el.addEventListener('input', calcKB); el.addEventListener('change', calcKB); });
      calcKB();
    }, 50);
  </script>
</CalculatorLayout>
