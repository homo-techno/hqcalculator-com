---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fugenm&ouml;rtel-Rechner - Volumen f&uuml;r Mauerwerk & Verfugung";
const description = "Berechnen Sie das Fugenm&ouml;rtelvolumen f&uuml;r Mauerwerk-Zellenf&uuml;llung und Verfugung. Sch&auml;tzen Sie den Bedarf an M&ouml;rtels&auml;cken.";
const relatedCalcs = [
  { name: "Beton-Rechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Ziegel-Rechner", url: "/de/ziegel-rechner", description: "Ziegelanzahl." },
  { name: "M&ouml;rtel-Rechner", url: "/de/moertel-rechner", description: "M&ouml;rtelsch&auml;tzung." },
  { name: "Bewehrungsstahl-Rechner", url: "/de/bewehrungsstahl-rechner", description: "Bewehrungsbedarf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fugenm&ouml;rtel-Rechner" lang="de" enSlug="grout-volume-calculator" keywords="fugenm&ouml;rtel rechner, verfugung, mauerwerk m&ouml;rtel, m&ouml;rtelbedarf, zellenf&uuml;llung" breadcrumbs={[{ name: "Fugenm&ouml;rtel-Rechner", url: "/de/fugenmoertel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fugenm&ouml;rtel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie das Fugenm&ouml;rtelvolumen f&uuml;r Zellenf&uuml;llung und Mauerwerksfugen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Anwendung</label>
          <select id="fmde-app" class="fmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="cellfull" selected>Zellenf&uuml;llung - Vollverfugung</option>
            <option value="cellpartial">Zellenf&uuml;llung - Teilweise (nur Bewehrungszellen)</option>
            <option value="joint">Mauerwerksfugen / Neuverfugung</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-2">Wandl&auml;nge (m)</label><input type="number" id="fmde-length" class="fmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0.5" step="0.5"></div>
          <div><label class="block text-sm font-medium text-text mb-2">Wandh&ouml;he (m)</label><input type="number" id="fmde-height" class="fmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0.5" step="0.25"></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Steingr&ouml;&szlig;e</label>
          <select id="fmde-block" class="fmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="15">15 cm</option>
            <option value="20" selected>20 cm (Standard)</option>
            <option value="25">25 cm</option>
            <option value="30">30 cm</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Bewehrungsabstand (bei Teilf&uuml;llung)</label>
          <select id="fmde-spacing" class="fmde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0.6">60 cm</option>
            <option value="0.8">80 cm</option>
            <option value="1.0" selected>100 cm</option>
            <option value="1.2">120 cm</option>
          </select>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <label class="block text-xs font-medium text-text mb-1">Verschnitt-/&Uuml;berf&uuml;llungsfaktor (%)</label>
          <input type="number" id="fmde-waste" class="fmde-in w-full px-3 py-2 border border-border rounded-lg" value="15" min="0" max="30" step="1">
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigtes M&ouml;rtelvolumen</div>
          <div class="text-4xl font-extrabold" id="fmde-volume">0 Liter</div>
          <div class="text-sm text-blue-200 mt-1"><span id="fmde-m3">0</span> m&sup3;</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">S&auml;cke (25 kg)</div><div class="text-xl font-bold" id="fmde-bags25">0</div><div class="text-xs text-text-muted">ca. 14 L je Sack</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">S&auml;cke (40 kg)</div><div class="text-xl font-bold" id="fmde-bags40">0</div><div class="text-xs text-text-muted">ca. 22 L je Sack</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zellen zu f&uuml;llen</div><div class="text-xl font-bold" id="fmde-cells">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wandfl&auml;che</div><div class="text-xl font-bold" id="fmde-area">0 m&sup2;</div></div>
        </div>
      </div>

      <ShareButton calculatorId="grout-volume-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Fugenm&ouml;rtel-Volumen berechnen</h2>
      <p>Das ben&ouml;tigte M&ouml;rtelvolumen h&auml;ngt von der Wandgr&ouml;&szlig;e, Steindimensionen und dem Verfugungstyp ab. Planen Sie 10&ndash;15 % zus&auml;tzlich f&uuml;r Verschnitt und Setzung ein.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist Vollverfugung?</strong> Dabei werden alle Hohlr&auml;ume im Mauerwerk mit M&ouml;rtel gef&uuml;llt, was die Stabilit&auml;t erh&ouml;ht.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmdeCellVol: Record<string, number> = {
      '15': 0.96, '20': 1.42, '25': 1.93, '30': 2.49,
    };

    function calcFMDE() {
      const app = (document.getElementById('fmde-app') as HTMLSelectElement).value;
      const wallL = parseFloat((document.getElementById('fmde-length') as HTMLInputElement).value) || 0;
      const wallH = parseFloat((document.getElementById('fmde-height') as HTMLInputElement).value) || 0;
      const blockSize = (document.getElementById('fmde-block') as HTMLSelectElement).value;
      const rebarSpacing = parseFloat((document.getElementById('fmde-spacing') as HTMLSelectElement).value) || 1.0;
      const waste = (parseFloat((document.getElementById('fmde-waste') as HTMLInputElement).value) || 0) / 100;

      const cellVolL = fmdeCellVol[blockSize] || 1.42;
      const area = wallL * wallH;

      const courseH = 0.2;
      const blockL = 0.4;
      const courses = Math.ceil(wallH / courseH);
      const blocksPerCourse = Math.ceil(wallL / blockL);
      const totalBlocks = courses * blocksPerCourse;
      const cellsPerBlock = 2;

      let cellsToFill = 0;
      let groutLiters = 0;

      if (app === 'cellfull') {
        cellsToFill = totalBlocks * cellsPerBlock;
        groutLiters = cellsToFill * cellVolL;
      } else if (app === 'cellpartial') {
        const rebarCols = Math.ceil(wallL / rebarSpacing) + 1;
        cellsToFill = rebarCols * courses * cellsPerBlock;
        groutLiters = cellsToFill * cellVolL;
      } else if (app === 'joint') {
        const jointThick = 0.01;
        const bedJointVol = blockL * (parseFloat(blockSize) / 100) * jointThick * 1000;
        const headJointVol = courseH * (parseFloat(blockSize) / 100) * jointThick * 1000;
        groutLiters = totalBlocks * (bedJointVol + headJointVol);
        cellsToFill = 0;
      }

      const groutWithWaste = groutLiters * (1 + waste);
      const m3 = groutWithWaste / 1000;
      const bags25 = Math.ceil(groutWithWaste / 14);
      const bags40 = Math.ceil(groutWithWaste / 22);

      document.getElementById('fmde-volume')!.textContent = Math.round(groutWithWaste).toLocaleString('de-DE') + ' Liter';
      document.getElementById('fmde-m3')!.textContent = m3.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('fmde-bags25')!.textContent = String(bags25);
      document.getElementById('fmde-bags40')!.textContent = String(bags40);
      document.getElementById('fmde-cells')!.textContent = cellsToFill.toLocaleString('de-DE');
      document.getElementById('fmde-area')!.textContent = area.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m\u00B2';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.fmde-in').forEach(el => {
        el.addEventListener('input', calcFMDE);
        el.addEventListener('change', calcFMDE);
      });
      calcFMDE();
    }, 50);
  </script>
</CalculatorLayout>
