---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Nut-Feder-Rechner - Nut- & Falzverbindungen berechnen";
const description = "Berechnen Sie Nut- und Falzverbindungen inkl. Breite, Tiefe und optimaler Fraeser-Auswahl. Unterstuetzt durchgehende, gestoppte und verdeckte Nuten.";

const relatedCalcs = [
  { name: "Holzverbindung-Rechner", url: "/de/holzverbindung-rechner", description: "Zapfenverbindungen." },
  { name: "Balkenrechner", url: "/de/balken-rechner", description: "Balkenberechnung." },
  { name: "Terrassenrechner", url: "/de/terrasse-rechner", description: "Terrassenplanung." },
  { name: "Holzrechner", url: "/de/holz-rechner", description: "Holzberechnung." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="dado-joint-calculator" calculatorName="Nut-Feder-Rechner" keywords="nut feder rechner, nutverbindung, falzverbindung, fraeser, nutbreite, nuttiefe, sperrholz" breadcrumbs={[{ name: "Nut-Feder-Rechner", url: "/de/nut-feder-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Nut-Feder-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Nut- und Falzverbindungen und w&auml;hlen Sie den passenden Fr&auml;ser oder das Nutschwert.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Verbindungsart</label>
        <select id="nf2-type" class="nf2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="through" selected>Durchgehende Nut</option>
          <option value="stopped">Gestoppte (verdeckte) Nut</option>
          <option value="rabbet">Falz</option>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Einlegematerial</label>
          <select id="nf2-matl" class="nf2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="19" selected>19 mm Massivholz</option>
            <option value="18.5">18,5 mm Sperrholz (19 mm nominal)</option>
            <option value="12">12 mm Massivholz</option>
            <option value="11.5">11,5 mm Sperrholz (12 mm nominal)</option>
            <option value="6">6 mm Massivholz/Hartfaser</option>
            <option value="5.5">5,5 mm Sperrholz</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Korpusmaterial-Dicke (mm)</label>
          <input type="number" id="nf2-case" class="nf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="19" min="6" step="0.5">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Nutl&auml;nge (mm)</label>
          <input type="number" id="nf2-length" class="nf2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="10" step="10">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Schnittmethode</label>
          <select id="nf2-method" class="nf2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="router" selected>Oberfr&auml;se</option>
            <option value="dado-set">Nutschwert (Tischkreiss&auml;ge)</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nutbreite</div>
        <div class="text-4xl font-extrabold" id="nf2-width">--</div>
        <div class="text-sm text-blue-200 mt-1">passend zum Einlegematerial</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Nuttiefe</div>
          <div class="text-xl font-bold" id="nf2-depth">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Restmaterial</div>
          <div class="text-xl font-bold" id="nf2-remain">--</div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Fr&auml;ser/Schwert</div>
          <div class="text-xl font-bold" id="nf2-bit">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Anzahl Durchg&auml;nge</div>
          <div class="text-xl font-bold" id="nf2-passes">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h4 class="font-semibold text-sm text-text mb-1">Hinweise</h4>
        <p class="text-sm text-text-secondary" id="nf2-notes">--</p>
      </div>

      <ShareButton lang="de" calculatorId="dado-joint" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gestaltungsregeln f&uuml;r Nut-Feder-Verbindungen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Nuttiefe = 1/3 bis 1/2 der Korpusmaterial-Dicke</strong></p>
        <p><strong>Nutbreite = exakte Dicke des Einlegematerials</strong></p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Sperrholz-Tipp</h3>
      <p>Nominal 19 mm Sperrholz ist tats&auml;chlich ca. 18,5 mm dick. Ein Standard-19-mm-Fr&auml;ser ist zu breit. Verwenden Sie einen speziellen Sperrholz-Fr&auml;ser oder Unterlegscheiben am Nutschwert.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wann verwende ich eine gestoppte Nut?</strong> Gestoppte Nuten sind von vorne unsichtbar und eignen sich besonders f&uuml;r sichtbare M&ouml;belseiten.</p>
      <p><strong>Wie tief sollte die Nut sein?</strong> Idealerweise 1/3 der Materialst&auml;rke. Niemals mehr als die H&auml;lfte, da sonst das Material zu stark geschw&auml;cht wird.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcNF2() {
      const jointType = (document.getElementById('nf2-type') as HTMLSelectElement).value;
      const insertThick = parseFloat((document.getElementById('nf2-matl') as HTMLSelectElement).value) || 19;
      const caseThick = parseFloat((document.getElementById('nf2-case') as HTMLInputElement).value) || 19;
      const method = (document.getElementById('nf2-method') as HTMLSelectElement).value;

      const dadoWidth = insertThick;
      const dadoDepth = Math.round(caseThick / 3 * 2) / 2;
      const remaining = caseThick - dadoDepth;

      const routerBits = [3, 4, 5, 6, 8, 10, 12, 16, 19, 25];
      let bestBit = 6;
      let passes = 1;

      if (method === 'router') {
        for (let i = routerBits.length - 1; i >= 0; i--) {
          if (routerBits[i] <= dadoWidth) {
            bestBit = routerBits[i];
            passes = Math.ceil(dadoWidth / bestBit);
            break;
          }
        }
        const exactMatch = routerBits.find(b => Math.abs(b - dadoWidth) < 0.3);
        if (exactMatch) { bestBit = exactMatch; passes = 1; }
      } else {
        bestBit = dadoWidth;
        passes = 1;
      }

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

      document.getElementById('nf2-width')!.textContent = fmt(dadoWidth) + ' mm';
      document.getElementById('nf2-depth')!.textContent = fmt(dadoDepth) + ' mm (' + Math.round(dadoDepth / caseThick * 100) + '% des Korpus)';
      document.getElementById('nf2-remain')!.textContent = fmt(remaining) + ' mm';
      document.getElementById('nf2-bit')!.textContent = method === 'router' ? bestBit + ' mm Nutfr\u00e4ser' : 'Nutschwert auf ' + fmt(dadoWidth) + ' mm';
      document.getElementById('nf2-passes')!.textContent = passes + (passes > 1 ? ' (Anschlag verschieben)' : '');

      let notes = '';
      if (jointType === 'stopped') {
        notes = 'Stoppen Sie die Nut 10-25 mm vor der Vorderkante. Schneiden Sie die Regalecke passend aus. Nacharbeiten mit dem Stechbeitel.';
      } else if (jointType === 'rabbet') {
        notes = 'F\u00fcr einen Falz schneiden Sie an der Kante des Bretts. Tiefe entspricht der Einlegedicke f\u00fcr b\u00fcndigen Sitz.';
      } else {
        notes = 'Die durchgehende Nut l\u00e4uft \u00fcber die gesamte Breite der Korpusseite. Am einfachsten zu schneiden, aber von vorne sichtbar.';
      }
      if (Math.abs(insertThick - 19) > 0.3 && insertThick < 19 && insertThick > 17) {
        notes += ' Hinweis: Unterma\u00dfiges Sperrholz erkannt. Verwenden Sie einen speziellen Sperrholz-Fr\u00e4ser oder Unterlegscheiben.';
      }
      document.getElementById('nf2-notes')!.textContent = notes;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.nf2-in').forEach(el => {
        el.addEventListener('input', calcNF2);
        el.addEventListener('change', calcNF2);
      });
      calcNF2();
    }, 50);
  </script>
</CalculatorLayout>
