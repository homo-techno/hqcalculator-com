---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kubikmeter-Rechner (CBM) – Volumen & Containerauslastung";
const description = "Berechnen Sie Kubikmeter aus Abmessungen, CBM pro Karton, Gesamtvolumen und Container-Füllrate für internationalen Frachtversand.";
const relatedCalcs = [
  { name: "Frachtversicherung-Rechner", url: "/de/frachtversicherung-rechner", description: "Frachtversicherung." },
  { name: "Teppich-Rechner", url: "/de/teppich-rechner", description: "Fläche." },
  { name: "Deckenventilator-Rechner", url: "/de/deckenventilator-rechner", description: "Ventilator." },
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kubikmeter-Rechner" enSlug="cbm-calculator" keywords="Kubikmeter, CBM, Volumen, Container, Karton, Frachtvolumen, Containerauslastung" breadcrumbs={[{ name: "Kubikmeter-Rechner", url: "/de/kubikmeter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kubikmeter-Rechner (CBM)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Kubikmeter-Volumen pro Karton, Gesamtvolumen und Container-Füllrate.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Maßeinheit</label><select id="kmr-unit" class="kmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="cm" selected>Zentimeter (cm)</option><option value="in">Zoll (in)</option><option value="m">Meter (m)</option></select></div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Länge</label><input type="number" id="kmr-length" class="kmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite</label><input type="number" id="kmr-width" class="kmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Höhe</label><input type="number" id="kmr-height" class="kmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Anzahl Kartons</label><input type="number" id="kmr-qty" class="kmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Containertyp</label><select id="kmr-container" class="kmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="33.2">20-Fuß Standard (33,2 CBM)</option><option value="67.7" selected>40-Fuß Standard (67,7 CBM)</option><option value="76.3">40-Fuß High Cube (76,3 CBM)</option></select></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtvolumen</div>
          <div class="text-5xl font-extrabold font-mono" id="kmr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CBM pro Karton</div><div class="text-xl font-bold font-mono" id="kmr-per">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Container-Auslastung</div><div class="text-xl font-bold font-mono" id="kmr-fill">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kubikfuß</div><div class="text-xl font-bold font-mono" id="kmr-cuft">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Kartons im Container</div><div class="text-xl font-bold font-mono" id="kmr-maxcartons">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cbm" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kubikmeter berechnen</h2>
      <p>CBM (Kubikmeter) ist die Standardeinheit für Frachtvolumen im internationalen Handel. Die Formel: Länge x Breite x Höhe (in Metern) = Kubikmeter. Die Container-Auslastung hilft bei der Optimierung der Versandkosten.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKMR() {
      const unit = (document.getElementById('kmr-unit') as HTMLSelectElement).value;
      const length = parseFloat((document.getElementById('kmr-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('kmr-width') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('kmr-height') as HTMLInputElement).value) || 0;
      const qty = parseFloat((document.getElementById('kmr-qty') as HTMLInputElement).value) || 1;
      const containerCBM = parseFloat((document.getElementById('kmr-container') as HTMLSelectElement).value) || 67.7;
      let toMeters = 0.01;
      if (unit === 'in') toMeters = 0.0254;
      else if (unit === 'm') toMeters = 1;
      const cbmPerCarton = (length * toMeters) * (width * toMeters) * (height * toMeters);
      const totalCBM = cbmPerCarton * qty;
      const cubicFeet = totalCBM * 35.3147;
      const fillRate = containerCBM > 0 ? (totalCBM / containerCBM) * 100 : 0;
      const maxCartons = cbmPerCarton > 0 ? Math.floor(containerCBM / cbmPerCarton) : 0;
      document.getElementById('kmr-result')!.textContent = totalCBM.toLocaleString('de-DE', {minimumFractionDigits:3, maximumFractionDigits:3}) + ' m\u00B3';
      document.getElementById('kmr-per')!.textContent = cbmPerCarton.toLocaleString('de-DE', {minimumFractionDigits:4, maximumFractionDigits:4}) + ' m\u00B3';
      document.getElementById('kmr-fill')!.textContent = fillRate.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + '%';
      document.getElementById('kmr-cuft')!.textContent = cubicFeet.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' ft\u00B3';
      document.getElementById('kmr-maxcartons')!.textContent = maxCartons.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('kmr-length') as HTMLInputElement).value = '60';
      (document.getElementById('kmr-width') as HTMLInputElement).value = '40';
      (document.getElementById('kmr-height') as HTMLInputElement).value = '30';
      (document.getElementById('kmr-qty') as HTMLInputElement).value = '100';
      document.querySelectorAll('.kmr-in').forEach(el => { el.addEventListener('input', calcKMR); el.addEventListener('change', calcKMR); });
      calcKMR();
    }, 50);
  </script>
</CalculatorLayout>
