---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Körperwasserrechner - Watson-Formel (TBW)";
const description = "Berechnen Sie das Gesamtkörperwasser mit der Watson-Formel. Zeigt intrazelluläre und extrazelluläre Wasserverteilung.";
const relatedCalcs = [
  { name: "Blutvolumenrechner", url: "/de/blutvolumen-rechner", description: "Geschätztes Blutvolumen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Tägliche Kalorien." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="K\u00f6rperwasserrechner" lang="de" keywords="körperwasser, gesamtkörperwasser, watson formel, TBW, intrazellulär, extrazellulär" breadcrumbs={[{ name: "K\u00f6rperwasser", url: "/de/koerperwasser-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">K&ouml;rperwasserrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie das Gesamtk&ouml;rperwasser mit der Watson-Formel.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
          <select id="bw-sex" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="male" selected>Männlich</option>
            <option value="female">Weiblich</option>
          </select>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Alter (Jahre)</label><input type="number" id="bw-age" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="1" max="120" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Größe (cm)</label><input type="number" id="bw-ht" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="175" min="50" max="250" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="bw-wt" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="10" max="300" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkörperwasser</div>
          <div class="text-5xl font-extrabold font-mono" id="bw-total">0</div>
          <div class="text-sm text-blue-200 mt-1">Liter</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">% Körpergewicht</div><div class="text-xl font-bold" id="bw-pct">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Intrazellulär</div><div class="text-xl font-bold" id="bw-icf">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Extrazellulär</div><div class="text-xl font-bold" id="bw-ecf">0 L</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Körperwasser-Verteilung</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Mann (typisch)</span><span class="font-bold">60% des Körpergewichts</span></div>
            <div class="flex justify-between"><span>Frau (typisch)</span><span class="font-bold">50% des Körpergewichts</span></div>
            <div class="flex justify-between"><span>Intrazellulär (IZF)</span><span class="font-bold">ca. 2/3 des TBW</span></div>
            <div class="flex justify-between"><span>Extrazellulär (EZF)</span><span class="font-bold">ca. 1/3 des TBW</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="body-water" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Watson-Formel</h2>
      <p>Die Watson-Formel sch&auml;tzt das Gesamtk&ouml;rperwasser (TBW). F&uuml;r M&auml;nner: TBW = 2,447 - 0,09156 x Alter + 0,1074 x Gr&ouml;&szlig;e(cm) + 0,3362 x Gewicht(kg). F&uuml;r Frauen: TBW = -2,097 + 0,1069 x Gr&ouml;&szlig;e(cm) + 0,2466 x Gewicht(kg). K&ouml;rperwasser teilt sich typisch in intrazellul&auml;r (2/3) und extrazellul&auml;r (1/3).</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBW() {
      const sex = (document.getElementById('bw-sex') as HTMLSelectElement).value;
      const age = parseFloat((document.getElementById('bw-age') as HTMLInputElement).value) || 0;
      const ht = parseFloat((document.getElementById('bw-ht') as HTMLInputElement).value) || 0;
      const wt = parseFloat((document.getElementById('bw-wt') as HTMLInputElement).value) || 0;
      let tbw: number;
      if (sex === 'male') {
        tbw = 2.447 - 0.09156 * age + 0.1074 * ht + 0.3362 * wt;
      } else {
        tbw = -2.097 + 0.1069 * ht + 0.2466 * wt;
      }
      const pct = wt > 0 ? (tbw / wt) * 100 : 0;
      const icf = tbw * (2 / 3);
      const ecf = tbw * (1 / 3);
      document.getElementById('bw-total')!.textContent = tbw.toFixed(1).replace('.', ',');
      document.getElementById('bw-pct')!.textContent = pct.toFixed(0) + '%';
      document.getElementById('bw-icf')!.textContent = icf.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('bw-ecf')!.textContent = ecf.toFixed(1).replace('.', ',') + ' L';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bw-in').forEach(el => { el.addEventListener('input', calcBW); el.addEventListener('change', calcBW); });
      calcBW();
    }, 50);
  </script>
</CalculatorLayout>
