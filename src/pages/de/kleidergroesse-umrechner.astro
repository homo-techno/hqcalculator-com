---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kleidergrößen-Umrechner - US/UK/EU Größentabelle";
const description = "Rechnen Sie Kleidergrößen zwischen US, UK und EU für Damen und Herren bei Oberteilen, Hosen und Schuhen um.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kleidergrößen-Umrechner" enSlug="clothing-size-converter" keywords="Kleidergrößen Umrechner, US zu EU Größe, UK Größentabelle, Schuhgrößen Umrechner, Herrengrößen, Damengrößen" breadcrumbs={[{ name: "Kleidergrößen-Umrechner", url: "/de/kleidergroesse-umrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kleidergrößen-Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie Kleidergrößen zwischen US, UK und EU für verschiedene Kleidungsarten um.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label for="ku-gender" class="block text-sm font-medium text-text mb-1">Geschlecht</label>
          <select id="ku-gender" class="ku-in w-full border border-border rounded-lg px-3 py-2">
            <option value="women">Damen</option>
            <option value="men">Herren</option>
          </select>
        </div>
        <div>
          <label for="ku-category" class="block text-sm font-medium text-text mb-1">Kategorie</label>
          <select id="ku-category" class="ku-in w-full border border-border rounded-lg px-3 py-2">
            <option value="tops">Oberteile / Hemden</option>
            <option value="pants">Hosen</option>
            <option value="shoes">Schuhe</option>
          </select>
        </div>
        <div>
          <label for="ku-from" class="block text-sm font-medium text-text mb-1">Ausgangsregion</label>
          <select id="ku-from" class="ku-in w-full border border-border rounded-lg px-3 py-2">
            <option value="EU" selected>EU</option>
            <option value="US">US</option>
            <option value="UK">UK</option>
          </select>
        </div>
        <div>
          <label for="ku-size" class="block text-sm font-medium text-text mb-1">Ihre Größe</label>
          <select id="ku-size" class="ku-in w-full border border-border rounded-lg px-3 py-2">
            <option value="0">Größe wählen</option>
          </select>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Entsprechende Größen</div>
          <div class="text-3xl font-extrabold font-mono" id="ku-result">--</div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">US-Größe</div>
            <div class="text-xl font-bold" id="ku-us">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">UK-Größe</div>
            <div class="text-xl font-bold" id="ku-uk">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">EU-Größe</div>
            <div class="text-xl font-bold" id="ku-eu">--</div>
          </div>
        </div>

        <div class="mt-4">
          <h3 class="text-sm font-bold text-text mb-2">Vollständige Größentabelle</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm" id="ku-chart">
              <thead>
                <tr class="border-b border-border">
                  <th class="py-1 pr-3 font-semibold text-left">US</th>
                  <th class="py-1 pr-3 font-semibold text-left">UK</th>
                  <th class="py-1 font-semibold text-left">EU</th>
                </tr>
              </thead>
              <tbody id="ku-chart-body"></tbody>
            </table>
          </div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="kleidergroesse" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kleidergrößen international umrechnen</h2>
      <p>Kleidergrößen variieren je nach Land und Hersteller. Die EU-Größen basieren auf Körpermaßen in Zentimetern, während US- und UK-Größen eigene Nummerierungssysteme verwenden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was entspricht EU 38?</strong> EU 38 entspricht ungefähr US 6 (Damen) bzw. UK 10 bei Oberteilen.</p>
      <p><strong>Wie rechne ich Schuhgrößen um?</strong> Nutzen Sie die Kategorie "Schuhe" oben und wählen Sie Ihre Ausgangsgröße für eine genaue Umrechnung.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    type SizeRow = { US: string; UK: string; EU: string };

    const sizeData: Record<string, Record<string, SizeRow[]>> = {
      women: {
        tops: [
          { US: 'XS (0-2)', UK: '4-6', EU: '32-34' },
          { US: 'S (4-6)', UK: '8-10', EU: '36-38' },
          { US: 'M (8-10)', UK: '12-14', EU: '40-42' },
          { US: 'L (12-14)', UK: '16-18', EU: '44-46' },
          { US: 'XL (16-18)', UK: '20-22', EU: '48-50' },
          { US: 'XXL (20)', UK: '24', EU: '52' },
        ],
        pants: [
          { US: '0 (24)', UK: '4', EU: '32' },
          { US: '2 (25)', UK: '6', EU: '34' },
          { US: '4 (26)', UK: '8', EU: '36' },
          { US: '6 (27)', UK: '10', EU: '38' },
          { US: '8 (28)', UK: '12', EU: '40' },
          { US: '10 (29)', UK: '14', EU: '42' },
          { US: '12 (30)', UK: '16', EU: '44' },
          { US: '14 (31)', UK: '18', EU: '46' },
          { US: '16 (32)', UK: '20', EU: '48' },
        ],
        shoes: [
          { US: '5', UK: '3', EU: '35-36' },
          { US: '5.5', UK: '3.5', EU: '36' },
          { US: '6', UK: '4', EU: '36-37' },
          { US: '6.5', UK: '4.5', EU: '37' },
          { US: '7', UK: '5', EU: '37-38' },
          { US: '7.5', UK: '5.5', EU: '38' },
          { US: '8', UK: '6', EU: '38-39' },
          { US: '8.5', UK: '6.5', EU: '39' },
          { US: '9', UK: '7', EU: '39-40' },
          { US: '9.5', UK: '7.5', EU: '40' },
          { US: '10', UK: '8', EU: '40-41' },
          { US: '11', UK: '9', EU: '41-42' },
        ],
      },
      men: {
        tops: [
          { US: 'XS (34)', UK: '34', EU: '44' },
          { US: 'S (36)', UK: '36', EU: '46' },
          { US: 'M (38-40)', UK: '38-40', EU: '48-50' },
          { US: 'L (42-44)', UK: '42-44', EU: '52-54' },
          { US: 'XL (46)', UK: '46', EU: '56' },
          { US: 'XXL (48)', UK: '48', EU: '58' },
        ],
        pants: [
          { US: '28', UK: '28', EU: '44' },
          { US: '30', UK: '30', EU: '46' },
          { US: '32', UK: '32', EU: '48' },
          { US: '34', UK: '34', EU: '50' },
          { US: '36', UK: '36', EU: '52' },
          { US: '38', UK: '38', EU: '54' },
          { US: '40', UK: '40', EU: '56' },
          { US: '42', UK: '42', EU: '58' },
        ],
        shoes: [
          { US: '7', UK: '6', EU: '39-40' },
          { US: '7.5', UK: '6.5', EU: '40' },
          { US: '8', UK: '7', EU: '40-41' },
          { US: '8.5', UK: '7.5', EU: '41' },
          { US: '9', UK: '8', EU: '41-42' },
          { US: '9.5', UK: '8.5', EU: '42' },
          { US: '10', UK: '9', EU: '42-43' },
          { US: '10.5', UK: '9.5', EU: '43' },
          { US: '11', UK: '10', EU: '43-44' },
          { US: '11.5', UK: '10.5', EU: '44' },
          { US: '12', UK: '11', EU: '44-45' },
          { US: '13', UK: '12', EU: '45-46' },
        ],
      },
    };

    function getCurrentData(): SizeRow[] {
      const gender = (document.getElementById('ku-gender') as HTMLSelectElement).value;
      const category = (document.getElementById('ku-category') as HTMLSelectElement).value;
      return sizeData[gender]?.[category] || [];
    }

    function populateSizes() {
      const from = (document.getElementById('ku-from') as HTMLSelectElement).value as 'US' | 'UK' | 'EU';
      const data = getCurrentData();
      const sizeSelect = document.getElementById('ku-size') as HTMLSelectElement;
      sizeSelect.innerHTML = '';
      data.forEach((row, i) => {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = row[from];
        sizeSelect.appendChild(opt);
      });
      calcKU();
    }

    function calcKU() {
      const data = getCurrentData();
      const idx = parseInt((document.getElementById('ku-size') as HTMLSelectElement).value) || 0;
      const row = data[idx];

      if (row) {
        (document.getElementById('ku-result') as HTMLElement).textContent = 'US ' + row.US + ' | UK ' + row.UK + ' | EU ' + row.EU;
        (document.getElementById('ku-us') as HTMLElement).textContent = row.US;
        (document.getElementById('ku-uk') as HTMLElement).textContent = row.UK;
        (document.getElementById('ku-eu') as HTMLElement).textContent = row.EU;
      }

      let html = '';
      data.forEach((r, i) => {
        const highlight = i === idx ? 'bg-blue-50 font-semibold' : '';
        html += '<tr class="border-b border-border/30 ' + highlight + '"><td class="py-1 pr-3">' + r.US + '</td><td class="py-1 pr-3">' + r.UK + '</td><td class="py-1">' + r.EU + '</td></tr>';
      });
      (document.getElementById('ku-chart-body') as HTMLElement).innerHTML = html;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ku-in').forEach(el => {
        el.addEventListener('change', () => {
          const id = (el as HTMLElement).id;
          if (id === 'ku-gender' || id === 'ku-category' || id === 'ku-from') {
            populateSizes();
          } else {
            calcKU();
          }
        });
      });
      populateSizes();
    }, 50);
  </script>
</CalculatorLayout>
