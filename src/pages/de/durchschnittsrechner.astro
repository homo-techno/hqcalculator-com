---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Durchschnittsrechner - Mittelwert, Median, Modus & Spannweite";
const description = "Berechnen Sie Mittelwert, Median, Modus und Spannweite aus beliebigen Zahlenreihen. Inkl. gewichtetem Durchschnitt, geometrischem Mittel und Statistik-Zusammenfassung.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwerte." },
  { name: "A1c-Rechner", url: "/de/a1c-rechner", description: "HbA1c-Umrechnung." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "ANOVA-Rechner", url: "/de/anova-rechner", description: "Varianzanalyse." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Durchschnittsrechner" enSlug="average-calculator" keywords="Durchschnittsrechner, Mittelwert Rechner, Median Rechner, Modus Rechner, gewichteter Durchschnitt, Statistik Rechner" breadcrumbs={[{ name: "Durchschnittsrechner", url: "/de/durchschnittsrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Durchschnittsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Mittelwert, Median, Modus und Spannweite einer beliebigen Datenreihe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-1">Zahlen eingeben <span class="text-text-muted">(getrennt durch Kommas, Leerzeichen oder Zeilenumbrüche)</span></label>
        <textarea id="ds-input" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" rows="4" placeholder="10, 20, 30, 40, 50">85, 90, 78, 92, 88, 76, 95, 82, 91, 87</textarea>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mittelwert (Durchschnitt)</div>
        <div class="text-5xl font-extrabold" id="ds-mean">0</div>
      </div>
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Median</div><div class="text-xl font-bold" id="ds-median">0</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Modus</div><div class="text-xl font-bold" id="ds-mode">&mdash;</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spannweite</div><div class="text-xl font-bold" id="ds-range">0</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahl</div><div class="text-xl font-bold" id="ds-count">0</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Summe</div><div class="text-xl font-bold" id="ds-sum">0</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Min / Max</div><div class="text-xl font-bold" id="ds-minmax">0 / 0</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Standardabweichung</div><div class="text-xl font-bold" id="ds-std">0</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Geometr. Mittel</div><div class="text-xl font-bold" id="ds-geo">0</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-2">Sortierte Daten</h3>
        <div class="text-sm text-text-secondary font-mono" id="ds-sorted"></div>
      </div>
      <ShareButton lang="de" calculatorId="durchschnitt" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Arten von Durchschnitten</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Mittelwert:</strong> Summe aller Werte &div; Anzahl</p>
        <p><strong>Median:</strong> Mittlerer Wert bei Sortierung (bei gerader Anzahl: Durchschnitt der beiden mittleren)</p>
        <p><strong>Modus:</strong> Am häufigsten vorkommender Wert</p>
        <p><strong>Geometrisches Mittel:</strong> N-te Wurzel des Produkts aller N Werte</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Wann welchen Durchschnitt verwenden?</h3>
      <ul>
        <li><strong>Mittelwert:</strong> Am besten für symmetrische Daten ohne Ausreißer (z.B. Testergebnisse)</li>
        <li><strong>Median:</strong> Besser bei Ausreißern (z.B. Einkommen, Immobilienpreise)</li>
        <li><strong>Modus:</strong> Am besten für kategorische Daten oder zur Findung des häufigsten Wertes</li>
        <li><strong>Geometrisches Mittel:</strong> Am besten für Raten und Prozentsätze (z.B. Anlagerenditen)</li>
      </ul>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Mittelwert und Durchschnitt?</strong> Sie sind dasselbe. "Durchschnitt" im Alltag bezieht sich auf den arithmetischen Mittelwert.</p>
      <p><strong>Warum ist der Median oft besser als der Mittelwert?</strong> Der Median ist resistent gegen Ausreißer. Einige extreme Werte können den Mittelwert verzerren, beeinflussen aber nicht den Median.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function parseDsNumbers(input: string): number[] {
      return input.split(/[\s,;\n]+/).map(s => parseFloat(s.trim())).filter(n => !isNaN(n));
    }
    function calcDS() {
      const nums = parseDsNumbers((document.getElementById('ds-input') as HTMLTextAreaElement).value);
      if (nums.length === 0) return;
      const sorted = [...nums].sort((a, b) => a - b);
      const count = nums.length;
      const sum = nums.reduce((a, b) => a + b, 0);
      const mean = sum / count;
      const mid = Math.floor(count / 2);
      const median = count % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];
      const freq: Record<number, number> = {};
      nums.forEach(n => freq[n] = (freq[n] || 0) + 1);
      const maxFreq = Math.max(...Object.values(freq));
      const modes = Object.keys(freq).filter(k => freq[Number(k)] === maxFreq).map(Number);
      const modeStr = maxFreq === 1 ? 'Keiner' : modes.join(', ');
      const min = sorted[0];
      const max = sorted[count - 1];
      const range = max - min;
      const variance = nums.reduce((s, n) => s + (n - mean) ** 2, 0) / count;
      const stdDev = Math.sqrt(variance);
      const allPositive = nums.every(n => n > 0);
      const geoMean = allPositive ? Math.pow(nums.reduce((p, n) => p * n, 1), 1 / count) : NaN;
      const fmt = (n: number) => isNaN(n) ? '\u2014' : Number.isInteger(n) ? String(n) : n.toFixed(4);
      document.getElementById('ds-mean')!.textContent = fmt(mean);
      document.getElementById('ds-median')!.textContent = fmt(median);
      document.getElementById('ds-mode')!.textContent = modeStr;
      document.getElementById('ds-range')!.textContent = fmt(range);
      document.getElementById('ds-count')!.textContent = String(count);
      document.getElementById('ds-sum')!.textContent = fmt(sum);
      document.getElementById('ds-minmax')!.textContent = fmt(min) + ' / ' + fmt(max);
      document.getElementById('ds-std')!.textContent = fmt(stdDev);
      document.getElementById('ds-geo')!.textContent = fmt(geoMean);
      document.getElementById('ds-sorted')!.textContent = sorted.join(', ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('ds-input')!.addEventListener('input', calcDS);
      calcDS();
    }, 50);
  </script>
</CalculatorLayout>
