---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Esports-Einnahmen-Rechner";
const description = "Berechnen Sie die Preispool-Verteilung, Team- und Spieleranteile, Organisationsanteil und Steuerabz\u00fcge f\u00fcr Esports-Turniere.";
const relatedCalcs = [
  { name: "Elo-Bewertung", url: "/de/elo-bewertung-rechner", description: "Rating-System." },
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallreserve." },
  { name: "Mitarbeiterfluktuation", url: "/de/mitarbeiterfluktuation-rechner", description: "Fluktuation." },
  { name: "Treuhandkonto-Rechner", url: "/de/treuhandkonto-rechner", description: "Nebenkosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Esports-Einnahmen-Rechner" lang="de" enSlug="esports-earnings-calculator" keywords="esports einnahmen, preispool verteilung, turniergewinne, esports gehalt, org anteil, steuerabzug" breadcrumbs={[{ name: "Esports-Einnahmen", url: "/de/esports-einnahmen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Esports-Einnahmen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Turniergewinne nach Team-Aufteilung, Org-Anteil und Steuern.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Gesamter Preispool (&euro;)</label>
          <input type="number" class="eede-in w-full px-4 py-2 border border-border rounded-lg" id="eede-pool" min="0" value="100000">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Teamplatzierung</label>
          <select class="eede-in w-full px-4 py-2 border border-border rounded-lg" id="eede-place">
            <option value="0.50">1. Platz (50%)</option>
            <option value="0.25">2. Platz (25%)</option>
            <option value="0.12">3. Platz (12%)</option>
            <option value="0.06">4. Platz (6%)</option>
            <option value="0.03">5.-8. Platz (3%)</option>
            <option value="0.015">9.-16. Platz (1,5%)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Teamgr&ouml;&szlig;e (Spieler)</label>
          <input type="number" class="eede-in w-full px-4 py-2 border border-border rounded-lg" id="eede-team" min="1" max="10" value="5">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Organisationsanteil (%)</label>
          <input type="number" class="eede-in w-full px-4 py-2 border border-border rounded-lg" id="eede-org" min="0" max="100" step="1" value="10">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Trainer/Staff-Anteil (%)</label>
          <input type="number" class="eede-in w-full px-4 py-2 border border-border rounded-lg" id="eede-coach" min="0" max="50" step="1" value="5">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Steuersatz (%)</label>
          <input type="number" class="eede-in w-full px-4 py-2 border border-border rounded-lg" id="eede-tax" min="0" max="50" step="1" value="30">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ihr Netto-Gewinn</div>
          <div class="text-5xl font-extrabold font-mono" id="eede-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Team-Preisanteil</div>
            <div class="text-xl font-bold font-mono" id="eede-teamshare">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Pro Spieler (Brutto)</div>
            <div class="text-xl font-bold font-mono" id="eede-pretax">--</div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Org erh&auml;lt</div>
            <div class="text-lg font-bold font-mono" id="eede-orgamt">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Trainer erh&auml;lt</div>
            <div class="text-lg font-bold font-mono" id="eede-coachamt">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Steuer einbehalten</div>
            <div class="text-lg font-bold font-mono" id="eede-taxamt">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Preispool-&Uuml;bersicht</h3>
          <div class="text-xs font-mono space-y-1" id="eede-breakdown"></div>
        </div>
      </div>
      <ShareButton calculatorId="esports-earnings-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Esports-Einnahmen verstehen</h2>
      <p>Turniergewinne werden typischerweise zun&auml;chst auf das Team verteilt, dann werden Organisations- und Traineranteile abgezogen, bevor Steuern anfallen. In Deutschland unterliegen Preisgelder der Einkommensteuer.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Muss man Esports-Gewinne versteuern?</strong> Ja, in Deutschland sind Preisgelder als sonstige Eink&uuml;nfte steuerpflichtig. Der pers&ouml;nliche Steuersatz h&auml;ngt vom Gesamteinkommen ab.</p>
      <p><strong>Was ist ein &uuml;blicher Org-Anteil?</strong> Typische Organisationsanteile liegen zwischen 0% und 20%, abh&auml;ngig vom Vertrag und den gebotenen Leistungen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcEEDE() {
      const pool = parseFloat((document.getElementById('eede-pool') as HTMLInputElement).value) || 0;
      const placeShare = parseFloat((document.getElementById('eede-place') as HTMLSelectElement).value) || 0.5;
      const teamSize = Math.max(1, parseInt((document.getElementById('eede-team') as HTMLInputElement).value) || 5);
      const orgPct = parseFloat((document.getElementById('eede-org') as HTMLInputElement).value) || 0;
      const coachPct = parseFloat((document.getElementById('eede-coach') as HTMLInputElement).value) || 0;
      const taxPct = parseFloat((document.getElementById('eede-tax') as HTMLInputElement).value) || 0;

      const teamPrize = pool * placeShare;
      const orgCut = teamPrize * (orgPct / 100);
      const coachCut = teamPrize * (coachPct / 100);
      const afterCuts = teamPrize - orgCut - coachCut;
      const perPlayer = afterCuts / teamSize;
      const taxAmount = perPlayer * (taxPct / 100);
      const takeHome = perPlayer - taxAmount;

      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('eede-result')!.textContent = fmtEur(takeHome);
      document.getElementById('eede-teamshare')!.textContent = fmtEur(teamPrize);
      document.getElementById('eede-pretax')!.textContent = fmtEur(perPlayer);
      document.getElementById('eede-orgamt')!.textContent = fmtEur(orgCut);
      document.getElementById('eede-coachamt')!.textContent = fmtEur(coachCut);
      document.getElementById('eede-taxamt')!.textContent = fmtEur(taxAmount);

      const placements = [
        { name: '1. Platz', pct: 0.50 }, { name: '2. Platz', pct: 0.25 }, { name: '3. Platz', pct: 0.12 },
        { name: '4. Platz', pct: 0.06 }, { name: '5.-8.', pct: 0.03 }, { name: '9.-16.', pct: 0.015 }
      ];
      let html = '';
      for (const p of placements) {
        const tp = pool * p.pct;
        const pp = (tp - tp * orgPct / 100 - tp * coachPct / 100) / teamSize;
        const th = pp * (1 - taxPct / 100);
        const marker = p.pct === placeShare ? ' <-' : '';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + p.name + ' (' + fmtEur(tp) + ')</span><span>' + fmtEur(th) + '/Spieler' + marker + '</span></div>';
      }
      document.getElementById('eede-breakdown')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.eede-in').forEach(el => { el.addEventListener('input', calcEEDE); el.addEventListener('change', calcEEDE); });
      calcEEDE();
    }, 50);
  </script>
</CalculatorLayout>
