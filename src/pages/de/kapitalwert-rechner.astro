---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kapitalwertrechner (NPV) - Kapitalwert und IRR von Investitionen";
const description = "Berechnen Sie den Kapitalwert (NPV) und internen Zinsfuß (IRR) von Investitionsprojekten schnell und präzise.";
const relatedCalcs = [
  { name: "Nettovermögen Rechner", url: "/de/nettovermoegen-rechner", description: "Vermögen berechnen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibungen berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionen berechnen." },
  { name: "Netzeinspeisung Rechner", url: "/de/netzeinspeisung-rechner", description: "Solar-Ersparnisse." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kapitalwertrechner (NPV)" enSlug="net-present-value-calculator" keywords="Kapitalwert, NPV, Net Present Value, IRR, interner Zinsfuß, Investitionsrechnung, DCF" breadcrumbs={[{ name: "Kapitalwertrechner (NPV)", url: "/de/kapitalwert-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kapitalwertrechner (NPV)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Netto-Kapitalwert (NPV) und den internen Zinsfuß (IRR) Ihrer Investition. Geben Sie die Anfangsinvestition, jährliche Cashflows und den Kalkulationszinssatz ein.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anfangsinvestition (€)</label><input type="number" id="kw-invest" class="kw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kalkulationszinssatz (%)</label><input type="number" id="kw-rate" class="kw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="0.5"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Jährliche Cashflows (€, kommagetrennt)</label>
          <input type="text" id="kw-cashflows" class="kw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20000,25000,30000,35000,40000">
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Restwert am Ende (€)</label><input type="number" id="kw-residual" class="kw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="0" step="1000"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kapitalwert (NPV)</div>
          <div class="text-5xl font-extrabold font-mono" id="kw-result">0,00 €</div>
          <div class="text-sm text-blue-200 mt-1" id="kw-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Interner Zinsfuß (IRR)</div><div class="text-xl font-bold" id="kw-irr">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Summe Cashflows</div><div class="text-xl font-bold" id="kw-totalcf">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Laufzeit</div><div class="text-xl font-bold" id="kw-years">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bewertung</div><div class="text-xl font-bold" id="kw-verdict">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Diskontierte Cashflows</h3>
          <div class="space-y-1 text-sm font-mono" id="kw-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kapitalwert" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kapitalwertmethode (NPV) erklärt</h2>
      <p>Der Kapitalwert (Net Present Value) ist ein zentrales Instrument der Investitionsrechnung. Er gibt an, wie viel eine Investition in heutigen Geldwerten wert ist. Ein positiver NPV bedeutet, dass die Investition profitabel ist. Der interne Zinsfuß (IRR) ist der Zinssatz, bei dem der NPV genau Null beträgt.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>NPV = -I₀ + CF₁/(1+r)¹ + CF₂/(1+r)² + ... + CFn/(1+r)n</p>
        <p>Investition lohnt sich wenn: NPV &gt; 0 und IRR &gt; Kalkulationszinssatz</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was bedeutet ein negativer NPV?</strong></p><p>Ein negativer NPV bedeutet, dass die Investition bei gegebenem Zinssatz nicht rentabel ist. Das Kapital wäre bei alternativer Anlage rentabler.</p></div>
        <div><p><strong>Was ist der Unterschied zwischen NPV und IRR?</strong></p><p>Der NPV gibt den absoluten Wert in Euro an, der IRR die prozentuale Rendite. Beide Methoden ergänzen sich bei der Investitionsbewertung.</p></div>
        <div><p><strong>Welchen Kalkulationszinssatz soll ich verwenden?</strong></p><p>Üblich sind der WACC (Weighted Average Cost of Capital) oder eine Mindestrenditeerwartung (Hurdle Rate) von 6–12% je nach Branche und Risiko.</p></div>
        <div><p><strong>Was ist ein Restwert?</strong></p><p>Der Restwert (Liquidationswert) ist der Verkaufserlös eines Anlageguts am Ende des Planungshorizonts. Er wird ebenfalls diskontiert.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKW() {
      const invest = parseFloat((document.getElementById('kw-invest') as HTMLInputElement).value) || 0;
      const rate = (parseFloat((document.getElementById('kw-rate') as HTMLInputElement).value) || 0) / 100;
      const cfStr = (document.getElementById('kw-cashflows') as HTMLInputElement).value;
      const residual = parseFloat((document.getElementById('kw-residual') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      const rawCFs = cfStr.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n));
      const cashflows = [...rawCFs];
      if (residual > 0) cashflows[cashflows.length - 1] = (cashflows[cashflows.length - 1] || 0) + residual;
      let npv = -invest;
      const discounted: number[] = [];
      cashflows.forEach((cf, i) => {
        const pv = cf / Math.pow(1 + rate, i + 1);
        npv += pv;
        discounted.push(pv);
      });
      // IRR via Newton-Raphson
      let irr = 0.1;
      for (let iter = 0; iter < 1000; iter++) {
        let f = -invest;
        let df = 0;
        cashflows.forEach((cf, i) => {
          f += cf / Math.pow(1 + irr, i + 1);
          df -= (i + 1) * cf / Math.pow(1 + irr, i + 2);
        });
        if (Math.abs(df) < 1e-12) break;
        const newIrr = irr - f / df;
        if (Math.abs(newIrr - irr) < 1e-8) { irr = newIrr; break; }
        irr = newIrr;
      }
      const totalCF = cashflows.reduce((s, v) => s + v, 0);
      const verdict = npv > 0 ? 'Vorteilhaft' : npv === 0 ? 'Indifferent' : 'Nicht vorteilhaft';
      document.getElementById('kw-result')!.textContent = fmt(npv);
      (document.getElementById('kw-result') as HTMLElement).style.color = npv >= 0 ? '#bbf7d0' : '#fca5a5';
      document.getElementById('kw-sub')!.textContent = 'Investition: ' + fmt(invest) + ' | Laufzeit: ' + cashflows.length + ' Jahre';
      document.getElementById('kw-irr')!.textContent = (irr * 100).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
      document.getElementById('kw-totalcf')!.textContent = fmt(totalCF);
      document.getElementById('kw-years')!.textContent = cashflows.length + ' Jahre';
      document.getElementById('kw-verdict')!.textContent = verdict;
      document.getElementById('kw-table')!.innerHTML = discounted.map((pv, i) =>
        '<div class="flex justify-between"><span>Jahr ' + (i+1) + ': CF=' + rawCFs[i]?.toLocaleString('de-DE') + ' €</span><span>PV=' + fmt(pv) + '</span></div>'
      ).join('') + '<div class="flex justify-between border-t border-border pt-1 mt-1 font-bold"><span>NPV gesamt</span><span>' + fmt(npv) + '</span></div>';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kw-in').forEach(el => { el.addEventListener('input', calcKW); el.addEventListener('change', calcKW); });
      calcKW();
    }, 50);
  </script>
</CalculatorLayout>
