---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Dosierungsrechner - Medikamenten-Dosis nach Gewicht 2026";
const description = "Berechne Medikamentendosierungen nach Koerpergewicht. Dosis in mg, mL und Tabletten fuer Erwachsene und Kinder.";

const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Koerperfettrechner", url: "/de/koerperfettrechner", description: "Koerperfettanteil." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Dosierungsrechner" keywords="Dosierungsrechner, Medikamenten Dosis, mg pro kg, Kinder Dosierung, gewichtsbasierte Dosis" breadcrumbs={[{ name: "Dosierungsrechner", url: "/de/dosierungs-rechner" }]} lang="de" enSlug="dosage-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dosierungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne gewichtsbasierte Medikamentendosierungen. <strong class="text-red-600">Nur zu Informationszwecken — immer einen Arzt oder Apotheker konsultieren.</strong></p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Koerpergewicht</label><input type="number" id="dosde-wt" class="dosde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="70" min="1" max="300" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="dosde-unit" class="dosde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="kg" selected>kg</option>
              <option value="lbs">lbs</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Dosis (mg/kg)</label><input type="number" id="dosde-dose" class="dosde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gaben pro Tag</label><input type="number" id="dosde-freq" class="dosde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="6" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Konzentration (mg/mL)</label><input type="number" id="dosde-conc" class="dosde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0.1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tablettenstaerke (mg)</label><input type="number" id="dosde-tab" class="dosde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="25"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Einzeldosis</div>
          <div class="text-5xl font-extrabold font-mono" id="dosde-result">0 mg</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen (mL)</div><div class="text-xl font-bold font-mono" id="dosde-ml">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tabletten</div><div class="text-xl font-bold font-mono" id="dosde-tabs">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tagesdosis</div><div class="text-xl font-bold font-mono" id="dosde-daily">0 mg</div></div>
        </div>
        <div class="p-3 bg-red-50 rounded-xl text-center text-xs text-red-800 font-bold">
          Dieser Rechner dient nur zu Informationszwecken. Konsultieren Sie immer Ihren Arzt oder Apotheker fuer die tatsaechliche Dosierung.
        </div>
      </div>
      <ShareButton calculatorId="dosage" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gewichtsbasierte Dosierung</h2>
      <p>Die gewichtsbasierte Dosierung berechnet die Medikamentenmenge basierend auf dem Koerpergewicht des Patienten (mg/kg). Dies ist besonders wichtig bei der Dosierung fuer Kinder.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Warum wird nach Gewicht dosiert?</strong> Die benoetigte Medikamentenmenge haengt vom Koerpergewicht ab, da sich das Medikament im Koerper verteilt. Bei Kindern ist dies besonders wichtig.</p>
      <p><strong>Was ist eine typische Dosis?</strong> Die Dosis variiert stark je nach Medikament. Paracetamol z.B. wird mit 10-15 mg/kg dosiert, Ibuprofen mit 5-10 mg/kg.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDOSDE() {
      let wt = parseFloat((document.getElementById('dosde-wt') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('dosde-unit') as HTMLSelectElement).value;
      const dose = parseFloat((document.getElementById('dosde-dose') as HTMLInputElement).value) || 0;
      const freq = parseFloat((document.getElementById('dosde-freq') as HTMLInputElement).value) || 1;
      const conc = parseFloat((document.getElementById('dosde-conc') as HTMLInputElement).value) || 1;
      const tabStr = parseFloat((document.getElementById('dosde-tab') as HTMLInputElement).value) || 1;
      if (unit === 'lbs') wt = wt * 0.453592;
      const singleDose = wt * dose;
      const ml = singleDose / conc;
      const tabs = singleDose / tabStr;
      const daily = singleDose * freq;
      document.getElementById('dosde-result')!.textContent = singleDose.toFixed(1).replace('.', ',') + ' mg';
      document.getElementById('dosde-ml')!.textContent = ml.toFixed(1).replace('.', ',') + ' mL';
      document.getElementById('dosde-tabs')!.textContent = tabs.toFixed(1).replace('.', ',');
      document.getElementById('dosde-daily')!.textContent = daily.toFixed(0) + ' mg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dosde-in').forEach(el => { el.addEventListener('input', calcDOSDE); el.addEventListener('change', calcDOSDE); });
      calcDOSDE();
    }, 50);
  </script>
</CalculatorLayout>
