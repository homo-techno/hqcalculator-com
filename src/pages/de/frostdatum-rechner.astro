---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Frostdatum-Rechner - Frostwahrscheinlichkeit & Vegetationsperiode";
const description = "Sch\u00E4tzen Sie die Frostwahrscheinlichkeit aus Temperatur, Luftfeuchtigkeit, Windgeschwindigkeit und Bew\u00F6lkung. Berechnen Sie die L\u00E4nge der Vegetationsperiode.";
const relatedCalcs = [
  { name: "Taupunkt-Rechner", url: "/de/taupunkt-rechner", description: "Taupunkttemperatur." },
  { name: "Windchill-Rechner", url: "/de/windchill-rechner", description: "Windchill-Faktor." },
  { name: "Luftfeuchtigkeit-Rechner", url: "/de/luftfeuchtigkeit-rechner", description: "Relative Luftfeuchtigkeit." },
  { name: "Temperaturumrechner", url: "/de/temperaturumrechner", description: "Temperatureinheiten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Frostdatum-Rechner" lang="de" enSlug="frost-date-calculator" keywords="frostdatum rechner, frostwahrscheinlichkeit, vegetationsperiode, frostrisiko, frostwarnung" breadcrumbs={[{ name: "Frostdatum", url: "/de/frostdatum-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Frostdatum-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die n&auml;chtliche Frostwahrscheinlichkeit und die L&auml;nge der Vegetationsperiode aus aktuellen Wetterbedingungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Abendtemperatur (&deg;C)</label><input type="number" id="fdr-temp" class="fdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Relative Luftfeuchtigkeit (%)</label><input type="number" id="fdr-rh" class="fdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="70" min="0" max="100" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Windgeschwindigkeit (km/h)</label><input type="number" id="fdr-wind" class="fdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" min="0" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bew&ouml;lkung</label>
            <select id="fdr-cloud" class="fdr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0">Klarer Himmel</option>
              <option value="25">Leicht bew&ouml;lkt</option>
              <option value="50">&Uuml;berwiegend bew&ouml;lkt</option>
              <option value="75">Bedeckt</option>
              <option value="100">Vollst&auml;ndig bedeckt</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Vegetationsperiode (frostfreie Tage/Jahr)</label><input type="number" id="fdr-season" class="fdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="180" min="0" max="365" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Frostwahrscheinlichkeit heute Nacht</div>
          <div class="text-5xl font-extrabold font-mono" id="fdr-result">--</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="fdr-risk-box">
          <div class="font-bold text-sm" id="fdr-risk">--</div>
          <div class="text-xs mt-1" id="fdr-advice">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Minimum</div><div class="text-xl font-bold font-mono" id="fdr-min">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Taupunkt</div><div class="text-xl font-bold font-mono" id="fdr-dp">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vegetationsperiode</div><div class="text-xl font-bold font-mono" id="fdr-len">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="frost-date-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Frostvorhersage verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Klarer Himmel + wenig Wind = maximale Abk&uuml;hlung</p>
        <p>Bew&ouml;lkung reduziert die Abk&uuml;hlung um bis zu 70%</p>
        <p>Wind mischt w&auml;rmere Luft ein und reduziert das Frostrisiko</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wann besteht Frostgefahr?</strong> Wenn die Abendtemperatur unter 5&deg;C liegt, der Himmel klar ist und wenig Wind weht, kann die Temperatur &uuml;ber Nacht unter den Gefrierpunkt fallen.</p>
      <p><strong>Wie sch&uuml;tze ich meine Pflanzen vor Frost?</strong> Abdecken mit Vlies oder Folie, Pflanzen an die Hauswand stellen, empfindliche K&uuml;belpflanzen ins Haus holen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFDR() {
      const tC = parseFloat((document.getElementById('fdr-temp') as HTMLInputElement).value) || 5;
      const rh = parseFloat((document.getElementById('fdr-rh') as HTMLInputElement).value) || 70;
      const windKmh = parseFloat((document.getElementById('fdr-wind') as HTMLInputElement).value) || 5;
      const cloud = parseFloat((document.getElementById('fdr-cloud') as HTMLSelectElement).value) || 0;
      const season = parseFloat((document.getElementById('fdr-season') as HTMLInputElement).value) || 180;
      const a = 17.27, b = 237.7;
      const alpha = (a * tC) / (b + tC) + Math.log(rh / 100);
      const dpC = (b * alpha) / (a - alpha);
      const windMs = windKmh / 3.6;
      const cloudFactor = 1 - (cloud / 100) * 0.7;
      const windFactor = 1 / (1 + windMs * 0.5);
      const maxDrop = 8 * cloudFactor * windFactor;
      const estMinC = tC - maxDrop;
      let frostProb: number;
      if (estMinC <= -2) frostProb = 95;
      else if (estMinC <= 0) frostProb = 70 + (0 - estMinC) * 12.5;
      else if (estMinC <= 2) frostProb = 20 + (2 - estMinC) * 25;
      else if (estMinC <= 4) frostProb = 5 + (4 - estMinC) * 7.5;
      else frostProb = Math.max(0, 5 - (estMinC - 4) * 1);
      if (dpC <= 0 && dpC >= estMinC - 3) frostProb = Math.min(100, frostProb + 10);
      frostProb = Math.min(100, Math.max(0, frostProb));
      document.getElementById('fdr-result')!.textContent = frostProb.toFixed(0) + '%';
      document.getElementById('fdr-min')!.textContent = estMinC.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + '\u00B0C';
      document.getElementById('fdr-dp')!.textContent = dpC.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + '\u00B0C';
      document.getElementById('fdr-len')!.textContent = season + ' Tage';
      let risk: string, advice: string, color: string;
      if (frostProb >= 80) { risk = 'Hohes Frostrisiko'; advice = 'Empfindliche Pflanzen abdecken, Leitungen sch\u00FCtzen'; color = 'bg-red-50 text-red-800'; }
      else if (frostProb >= 50) { risk = 'M\u00E4\u00DFiges Frostrisiko'; advice = 'Zarte Pflanzen \u00FCber Nacht abdecken'; color = 'bg-orange-50 text-orange-800'; }
      else if (frostProb >= 20) { risk = 'Geringes Frostrisiko'; advice = 'Bedingungen beobachten, leichter Frost m\u00F6glich'; color = 'bg-yellow-50 text-yellow-800'; }
      else { risk = 'Minimales Frostrisiko'; advice = 'Keine Ma\u00DFnahmen erforderlich'; color = 'bg-green-50 text-green-800'; }
      document.getElementById('fdr-risk')!.textContent = risk;
      document.getElementById('fdr-advice')!.textContent = advice;
      document.getElementById('fdr-risk-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.fdr-in').forEach(el => { el.addEventListener('input', calcFDR); el.addEventListener('change', calcFDR); }); calcFDR(); }, 50);
  </script>
</CalculatorLayout>
