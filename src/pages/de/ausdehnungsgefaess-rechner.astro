---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Ausdehnungsgef\u00e4\u00df-Rechner - Gr\u00f6\u00dfe aus Systemvolumen & Temperatur";
const description = "Berechnen Sie die Gr\u00f6\u00dfe des Ausdehnungsgef\u00e4\u00dfes aus Systemvolumen, Temperaturanstieg und Vordruck f\u00fcr Heizungs- und Warmwassersysteme.";

const relatedCalcs = [
  { name: "Heizungsrechner", url: "/de/heizungsrechner", description: "Heizungsdimensionierung." },
  { name: "W\u00e4rmepumpe-Rechner", url: "/de/waermepumpe-rechner", description: "W\u00e4rmepumpen-Effizienz." },
  { name: "D\u00e4mmung-Rechner", url: "/de/daemmung-rechner", description: "D\u00e4mmbedarf." },
  { name: "Rohrstr\u00f6mung-Rechner", url: "/de/rohrstroemung-rechner", description: "Durchfluss in Rohren." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Ausdehnungsgef\u00e4\u00df-Rechner" lang="de" enSlug="expansion-tank-calculator" keywords="ausdehnungsgefaess rechner, mag berechnung, vordruck, heizungssystem, membranausdehnungsgefaess" breadcrumbs={[{ name: "Ausdehnungsgef\u00e4\u00df-Rechner", url: "/de/ausdehnungsgefaess-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ausdehnungsgef&auml;&szlig;-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Dimensionieren Sie ein Ausdehnungsgef&auml;&szlig; f&uuml;r Heizungs- oder Trinkwassersysteme basierend auf Systemvolumen und Temperaturbereich.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Systemtyp</label>
          <select id="adg-type" class="adg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="hot" selected>Trinkwarmwasser</option>
            <option value="hydronic">Heizung (geschlossen)</option>
            <option value="chilled">K&uuml;hlsystem</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesamtes Systemvolumen (Liter)</label><input type="number" id="adg-vol" class="adg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="1" step="10"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">F&uuml;lltemperatur (&deg;C)</label><input type="number" id="adg-tcold" class="adg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="50" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Betriebstemp. (&deg;C)</label><input type="number" id="adg-thot" class="adg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="30" max="120" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Statischer Druck (bar)</label><input type="number" id="adg-psupply" class="adg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" min="0.5" max="10" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sicherheitsventil (bar)</label><input type="number" id="adg-prelief" class="adg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.0" min="1.5" max="10" step="0.5"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Systemfl&uuml;ssigkeit</label>
          <select id="adg-fluid" class="adg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="water" selected>Wasser</option>
            <option value="glycol30">30% Propylenglykol</option>
            <option value="glycol50">50% Propylenglykol</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mindestgr&ouml;&szlig;e Ausdehnungsgef&auml;&szlig;</div>
          <div class="text-4xl font-extrabold" id="adg-tank">0 Liter</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ausdehnungsvolumen</div><div class="text-xl font-bold" id="adg-expvol">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufnahmefaktor</div><div class="text-xl font-bold" id="adg-accfact">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vordruck</div><div class="text-xl font-bold" id="adg-precharge">0 bar</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Temperaturhub</div><div class="text-xl font-bold" id="adg-trise">0 &deg;C</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Dimensionierungsdetails</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between"><span>Ausdehnungskoeffizient</span><span class="font-bold" id="adg-coeff">0</span></div>
            <div class="flex justify-between"><span>Max. Betriebsdruck</span><span class="font-bold" id="adg-maxop">0 bar</span></div>
            <div class="flex justify-between"><span>Empfohlene Handelsgr&ouml;&szlig;e</span><span class="font-bold" id="adg-commercial">--</span></div>
            <div class="flex justify-between"><span>Sicherheitsfaktor</span><span class="font-bold" id="adg-safety">1,1x</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="expansion-tank-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Ausdehnungsgef&auml;&szlig; richtig dimensionieren</h2>
      <p>Das Ausdehnungsgef&auml;&szlig; (MAG) kompensiert die Volumenausdehnung des Wassers bei Erw&auml;rmung. Der Vordruck muss auf den statischen Druck der Anlage eingestellt werden.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie stelle ich den Vordruck ein?</strong> Der Vordruck sollte dem statischen Druck der Anlage entsprechen (H&ouml;he der Wassers&auml;ule + 0,3 bar).</p>
      <p><strong>Wann muss das MAG getauscht werden?</strong> Wenn der Druck im System schwankt oder das Sicherheitsventil anspricht, sollte das MAG gepr&uuml;ft werden.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcADG() {
      const sysType = (document.getElementById('adg-type') as HTMLSelectElement).value;
      const vol = parseFloat((document.getElementById('adg-vol') as HTMLInputElement).value) || 200;
      const tCold = parseFloat((document.getElementById('adg-tcold') as HTMLInputElement).value) || 10;
      const tHot = parseFloat((document.getElementById('adg-thot') as HTMLInputElement).value) || 60;
      const pSupply = parseFloat((document.getElementById('adg-psupply') as HTMLInputElement).value) || 1.5;
      const pRelief = parseFloat((document.getElementById('adg-prelief') as HTMLInputElement).value) || 3.0;
      const fluid = (document.getElementById('adg-fluid') as HTMLSelectElement).value;

      const tRise = tHot - tCold;

      // Water expansion coefficient (simplified)
      // Water expands ~0.00023 per degree C at moderate temps
      function waterExpansion(tc: number, th: number) {
        const vCold = 1.0002 + 0.00001 * (tc - 4) + 0.000003 * Math.pow(tc - 4, 2);
        const vHot = 1.0002 + 0.00001 * (th - 4) + 0.000003 * Math.pow(th - 4, 2);
        return (vHot - vCold) / vCold;
      }

      let expCoeff = waterExpansion(tCold, tHot);
      if (fluid === 'glycol30') expCoeff *= 1.15;
      else if (fluid === 'glycol50') expCoeff *= 1.30;

      const expandedVol = vol * expCoeff;

      // Acceptance factor (bar absolute = bar gauge + 1)
      const pMinAbs = pSupply + 1;
      const pMaxAbs = (pRelief * 0.9) + 1;
      const af = (pMaxAbs - pMinAbs) / pMaxAbs;

      const safetyFactor = 1.1;
      const tankSize = af > 0 ? (expandedVol / af * safetyFactor) : expandedVol * 2;

      const commercialSizes = [8, 12, 18, 25, 35, 50, 80, 100, 150, 200, 300, 500];
      let recSize = commercialSizes[commercialSizes.length - 1];
      for (const s of commercialSizes) {
        if (s >= tankSize) { recSize = s; break; }
      }

      document.getElementById('adg-tank')!.textContent = tankSize.toFixed(1).replace('.', ',') + ' Liter';
      document.getElementById('adg-expvol')!.textContent = expandedVol.toFixed(2).replace('.', ',') + ' L';
      document.getElementById('adg-accfact')!.textContent = af.toFixed(3).replace('.', ',');
      document.getElementById('adg-precharge')!.textContent = pSupply.toFixed(1).replace('.', ',') + ' bar';
      document.getElementById('adg-trise')!.textContent = tRise + ' \u00B0C';
      document.getElementById('adg-coeff')!.textContent = (expCoeff * 100).toFixed(3).replace('.', ',') + '%';
      document.getElementById('adg-maxop')!.textContent = (pRelief * 0.9).toFixed(1).replace('.', ',') + ' bar';
      document.getElementById('adg-commercial')!.textContent = recSize + ' Liter Gef\u00E4\u00DF';
      document.getElementById('adg-safety')!.textContent = '1,1x';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.adg-in').forEach(el => { el.addEventListener('input', calcADG); el.addEventListener('change', calcADG); });
      calcADG();
    }, 50);
  </script>
</CalculatorLayout>
