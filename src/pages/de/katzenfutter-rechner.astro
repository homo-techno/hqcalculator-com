---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Katzenfutter-Rechner – Tägliche Kalorien & Portionsgrößen";
const description = "Berechnen Sie den täglichen Kalorienbedarf Ihrer Katze nach Gewicht, Alter und Aktivität. Ermitteln Sie Nass- und Trockenfuttermengen.";
const relatedCalcs = [
  { name: "Katzenalter-Rechner", url: "/de/katzenalter-rechner", description: "Katzenjahre." },
  { name: "Rindergewicht-Rechner", url: "/de/rindergewicht-rechner", description: "Rindergewicht." },
  { name: "Catering-Mengen-Rechner", url: "/de/catering-mengen-rechner", description: "Catering." },
  { name: "Tragfähigkeit-Rechner", url: "/de/tragfaehigkeit-rechner", description: "Tragfähigkeit." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Katzenfutter-Rechner" enSlug="cat-food-calculator" keywords="Katzenfutter Rechner, Katze Kalorien, Portionsgröße, Nassfutter, Trockenfutter, Katze Ernährung" breadcrumbs={[{ name: "Katzenfutter-Rechner", url: "/de/katzenfutter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Katzenfutter-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den täglichen Kalorienbedarf und die optimalen Futtermengen für Ihre Katze.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht der Katze (kg)</label><input type="number" id="kfr-weight" class="kfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.5" max="20" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Altersstufe</label><select id="kfr-age" class="kfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="kitten">Kitten (0-12 Monate)</option><option value="adult" selected>Erwachsen (1-10 Jahre)</option><option value="senior">Senior (10+ Jahre)</option></select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktivitätslevel</label><select id="kfr-activity" class="kfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="low">Niedrig (Stubenhocker)</option><option value="moderate" selected>Mittel</option><option value="high">Hoch (sehr aktiv)</option></select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Haltung</label><select id="kfr-indoor" class="kfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="indoor" selected>Nur drinnen</option><option value="outdoor">Freigänger</option></select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kastriert/Sterilisiert?</label><select id="kfr-fixed" class="kfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="yes" selected>Ja</option><option value="no">Nein (intakt)</option></select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Futterart</label><select id="kfr-type" class="kfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="dry" selected>Trockenfutter</option><option value="wet">Nassfutter</option><option value="mixed">Gemischt (50/50)</option></select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Kalorienbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="kfr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Trockenfutter/Tag</div><div class="text-xl font-bold font-mono" id="kfr-dry">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nassfutter/Tag</div><div class="text-xl font-bold font-mono" id="kfr-wet">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">RER (kcal)</div><div class="text-xl font-bold font-mono" id="kfr-rer">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dosen Nass/Tag</div><div class="text-xl font-bold font-mono" id="kfr-cans">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Portionen Trocken</div><div class="text-xl font-bold font-mono" id="kfr-portions">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Kosten ca.</div><div class="text-xl font-bold font-mono" id="kfr-cost">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cat-food" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Katzen richtig füttern</h2>
      <p>Der Kalorienbedarf einer Katze hängt von Gewicht, Alter, Aktivität und Haltung ab. Der Ruheumsatz (RER) berechnet sich als 70 * Gewicht(kg)^0,75. Der tatsächliche Bedarf ist je nach Lebensphase und Aktivität höher.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Futter braucht eine Katze?</strong> Eine durchschnittliche 4 kg schwere Wohnungskatze benötigt ca. 200-250 kcal pro Tag, was etwa 60-70 g Trockenfutter entspricht.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKFR() {
      const weight = parseFloat((document.getElementById('kfr-weight') as HTMLInputElement).value) || 0;
      const age = (document.getElementById('kfr-age') as HTMLSelectElement).value;
      const activity = (document.getElementById('kfr-activity') as HTMLSelectElement).value;
      const indoor = (document.getElementById('kfr-indoor') as HTMLSelectElement).value;
      const fixed = (document.getElementById('kfr-fixed') as HTMLSelectElement).value;
      const foodType = (document.getElementById('kfr-type') as HTMLSelectElement).value;
      const rer = 70 * Math.pow(weight, 0.75);
      const ageFactors: Record<string, number> = { kitten: 2.5, adult: 1.2, senior: 1.0 };
      const actFactors: Record<string, number> = { low: 0.8, moderate: 1.0, high: 1.2 };
      const indoorFactor = indoor === 'indoor' ? 0.9 : 1.1;
      const fixedFactor = fixed === 'yes' ? 0.9 : 1.0;
      const dailyCal = rer * (ageFactors[age] || 1.2) * (actFactors[activity] || 1.0) * indoorFactor * fixedFactor;
      const dryGrams = dailyCal / 3.5;
      const wetGrams = dailyCal / 0.9;
      const wetCans = dailyCal / 100;
      let dryDisplay = '--';
      let wetDisplay = '--';
      let cansDisplay = '--';
      let portionsDisplay = '--';
      let monthlyCost = 0;
      if (foodType === 'dry') {
        dryDisplay = Math.round(dryGrams) + ' g';
        portionsDisplay = (dryGrams / 30).toFixed(1);
        monthlyCost = (dryGrams / 1000) * 30 * 8;
      } else if (foodType === 'wet') {
        wetDisplay = Math.round(wetGrams) + ' g';
        cansDisplay = wetCans.toFixed(1);
        monthlyCost = wetCans * 30 * 0.80;
      } else {
        const halfCal = dailyCal / 2;
        dryDisplay = Math.round(halfCal / 3.5) + ' g';
        wetDisplay = Math.round(halfCal / 0.9) + ' g';
        cansDisplay = (halfCal / 100).toFixed(1);
        portionsDisplay = ((halfCal / 3.5) / 30).toFixed(1);
        monthlyCost = ((halfCal / 3.5) / 1000 * 30 * 8) + ((halfCal / 100) * 30 * 0.80);
      }
      document.getElementById('kfr-result')!.textContent = Math.round(dailyCal) + ' kcal';
      document.getElementById('kfr-dry')!.textContent = dryDisplay;
      document.getElementById('kfr-wet')!.textContent = wetDisplay;
      document.getElementById('kfr-rer')!.textContent = Math.round(rer).toString();
      document.getElementById('kfr-cans')!.textContent = cansDisplay;
      document.getElementById('kfr-portions')!.textContent = portionsDisplay;
      document.getElementById('kfr-cost')!.textContent = monthlyCost.toLocaleString('de-DE', {minimumFractionDigits:0, maximumFractionDigits:0}) + ' €';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('kfr-weight') as HTMLInputElement).value = '4.5';
      document.querySelectorAll('.kfr-in').forEach(el => { el.addEventListener('input', calcKFR); el.addEventListener('change', calcKFR); });
      calcKFR();
    }, 50);
  </script>
</CalculatorLayout>
