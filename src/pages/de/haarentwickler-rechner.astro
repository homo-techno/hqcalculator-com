---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Haarentwickler-Rechner - Volumenauswahl f&uuml;r Aufhellungsstufen";
const description = "W&auml;hlen Sie das richtige Entwicklervolumen (10, 20, 30, 40 Vol.) basierend auf aktuellem Level, Ziellevel und gew&uuml;nschter Aufhellung.";
const relatedCalcs = [
  { name: "Haarfarbe-Mischen-Rechner", url: "/de/haarfarbe-mischen-rechner", description: "Haarfarbe-Mischverh&auml;ltnisse." },
  { name: "Haaraufhellung-Rechner", url: "/de/haaraufhellung-rechner", description: "Blondierung." },
  { name: "Haarwachstum-Rechner", url: "/de/haarwachstum-rechner", description: "Wachstumsprognose." },
  { name: "Haarporositaet-Rechner", url: "/de/haarporositaet-rechner", description: "Porosit&auml;tsbewertung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Haarentwickler-Rechner" lang="de" enSlug="hair-developer-calculator" keywords="haarentwickler, entwicklervolumen, 10 volumen, 20 volumen, 30 volumen, 40 volumen, aufhellungsstufen, peroxid" breadcrumbs={[{ name: "Haarentwickler", url: "/de/haarentwickler-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Haarentwickler-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie das richtige Entwicklervolumen f&uuml;r Ihre gew&uuml;nschte Aufhellungsstufe und Ihren Haarservice.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktuelles Haarlevel</label>
            <select id="hdvde-current" class="hdvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1">1 - Schwarz</option>
              <option value="2">2 - Dunkelstes Braun</option>
              <option value="3">3 - Dunkelbraun</option>
              <option value="4" selected>4 - Mittelbraun</option>
              <option value="5">5 - Hellbraun</option>
              <option value="6">6 - Dunkelblond</option>
              <option value="7">7 - Mittelblond</option>
              <option value="8">8 - Hellblond</option>
              <option value="9">9 - Sehr Hellblond</option>
              <option value="10">10 - Hellstes Blond</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ziel-Haarlevel</label>
            <select id="hdvde-target" class="hdvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1">1 - Schwarz</option>
              <option value="2">2 - Dunkelstes Braun</option>
              <option value="3">3 - Dunkelbraun</option>
              <option value="4">4 - Mittelbraun</option>
              <option value="5">5 - Hellbraun</option>
              <option value="6" selected>6 - Dunkelblond</option>
              <option value="7">7 - Mittelblond</option>
              <option value="8">8 - Hellblond</option>
              <option value="9">9 - Sehr Hellblond</option>
              <option value="10">10 - Hellstes Blond</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Service-Typ</label>
          <select id="hdvde-service" class="hdvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="permanent" selected>Permanente Farbe</option>
            <option value="demi">Demi-Permanent</option>
            <option value="toner">T&ouml;nung / Gloss</option>
            <option value="bleach">Blondierung / Aufheller</option>
            <option value="gray">Grauabdeckung</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Haarzustand</label>
          <select id="hdvde-condition" class="hdvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="virgin">Naturhaar (nie gef&auml;rbt)</option>
            <option value="healthy" selected>Gesund (minimal behandelt)</option>
            <option value="processed">Bereits gef&auml;rbt</option>
            <option value="damaged">Gesch&auml;digt / &uuml;berbehandelt</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Entwickler</div>
          <div class="text-5xl font-extrabold font-mono" id="hdvde-vol">--</div>
          <div class="text-sm text-blue-200 mt-1" id="hdvde-peroxide">-- Peroxid</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufhellungsstufen</div><div class="text-xl font-bold" id="hdvde-lift">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einwirkzeit</div><div class="text-xl font-bold" id="hdvde-time">-- Min.</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sch&auml;digungsrisiko</div><div class="text-xl font-bold" id="hdvde-damage">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mischverh&auml;ltnis</div><div class="text-xl font-bold" id="hdvde-ratio">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Entwicklervolumen-&Uuml;bersicht</h3>
          <div class="text-sm space-y-1">
            <div class="flex justify-between"><span>10 Vol. (3 %)</span><span class="font-bold">Nur Farbablagerung, 0&ndash;1 Stufe</span></div>
            <div class="flex justify-between"><span>20 Vol. (6 %)</span><span class="font-bold">Standard, 1&ndash;2 Stufen</span></div>
            <div class="flex justify-between"><span>30 Vol. (9 %)</span><span class="font-bold">Mittel, 2&ndash;3 Stufen</span></div>
            <div class="flex justify-between"><span>40 Vol. (12 %)</span><span class="font-bold">Maximum, 3&ndash;4 Stufen</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="hair-developer-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das richtige Entwicklervolumen w&auml;hlen</h2>
      <p>Der Entwickler (Wasserstoffperoxid) aktiviert die Haarfarbe und steuert die Aufhellung. 10 Vol. (3 %) lagert Farbe ohne Aufhellung ab. 20 Vol. (6 %) ist der Standard f&uuml;r Permanentfarbe mit 1&ndash;2 Stufen Aufhellung. Ber&uuml;cksichtigen Sie immer den Haarzustand und die Porosit&auml;t.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wann verwende ich 30 Vol.?</strong> Bei 2&ndash;3 Stufen Aufhellung, besonders bei Blondierungen oder Hochtonfarben.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcHDVDE() {
      const current = parseInt((document.getElementById('hdvde-current') as HTMLSelectElement).value);
      const target = parseInt((document.getElementById('hdvde-target') as HTMLSelectElement).value);
      const service = (document.getElementById('hdvde-service') as HTMLSelectElement).value;
      const condition = (document.getElementById('hdvde-condition') as HTMLSelectElement).value;

      const lift = target - current;
      let recVol = '20 Vol.';
      let peroxide = '6 % Peroxid';
      let time = '35';
      let damage = 'Niedrig';
      let ratio = '1:1';

      if (service === 'demi') { recVol = '10 Vol.'; peroxide = '3 % Peroxid'; time = '20'; damage = 'Sehr niedrig'; ratio = '1:1'; }
      else if (service === 'toner') { recVol = '10 Vol.'; peroxide = '3 % Peroxid'; time = '15\u201320'; damage = 'Minimal'; ratio = '1:2'; }
      else if (service === 'bleach') {
        if (lift <= 2) { recVol = '20 Vol.'; peroxide = '6 % Peroxid'; time = '30\u201340'; damage = 'Mittel'; }
        else if (lift <= 4) { recVol = '30 Vol.'; peroxide = '9 % Peroxid'; time = '35\u201345'; damage = 'Hoch'; }
        else { recVol = '40 Vol.'; peroxide = '12 % Peroxid'; time = '40\u201350'; damage = 'Sehr hoch'; }
        ratio = '1:2';
      } else if (service === 'gray') { recVol = '20 Vol.'; peroxide = '6 % Peroxid'; time = '35\u201345'; damage = 'Niedrig'; ratio = '1:1'; }
      else {
        if (lift <= 0) { recVol = '10 Vol.'; peroxide = '3 % Peroxid'; time = '30\u201335'; damage = 'Sehr niedrig'; }
        else if (lift <= 2) { recVol = '20 Vol.'; peroxide = '6 % Peroxid'; time = '35'; damage = 'Niedrig'; }
        else if (lift <= 3) { recVol = '30 Vol.'; peroxide = '9 % Peroxid'; time = '35\u201340'; damage = 'Mittel'; }
        else { recVol = '40 Vol.'; peroxide = '12 % Peroxid'; time = '40\u201345'; damage = 'Hoch'; }
        ratio = '1:1';
      }

      if (condition === 'damaged') {
        if (recVol === '40 Vol.') { recVol = '30 Vol.'; peroxide = '9 % Peroxid'; }
        else if (recVol === '30 Vol.') { recVol = '20 Vol.'; peroxide = '6 % Peroxid'; }
        damage = damage === 'Sehr niedrig' ? 'Niedrig' : damage === 'Niedrig' ? 'Mittel' : damage === 'Mittel' ? 'Hoch' : 'Sehr hoch';
      }

      document.getElementById('hdvde-vol')!.textContent = recVol;
      document.getElementById('hdvde-peroxide')!.textContent = peroxide;
      document.getElementById('hdvde-lift')!.textContent = Math.max(0, lift).toString();
      document.getElementById('hdvde-time')!.textContent = time + ' Min.';
      document.getElementById('hdvde-damage')!.textContent = damage;
      document.getElementById('hdvde-ratio')!.textContent = ratio;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hdvde-in').forEach(el => { el.addEventListener('input', calcHDVDE); el.addEventListener('change', calcHDVDE); });
      calcHDVDE();
    }, 50);
  </script>
</CalculatorLayout>
