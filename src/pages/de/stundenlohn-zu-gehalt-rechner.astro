---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Stundenlohn zu Gehalt Rechner - Stundenlohn in Jahresgehalt umrechnen 2026";
const description = "Rechne deinen Stundenlohn in ein Jahresgehalt um und umgekehrt. Beruecksichtige Arbeitsstunden und Urlaubswochen fuer eine genaue Kalkulation.";

const relatedCalcs = [
  { name: "Stundenlohn-vs-Gehalt-Rechner", url: "/de/stundenlohn-vs-gehalt-rechner", description: "Vergleich Stundenlohn vs. Gehalt." },
  { name: "Stunden-Rechner", url: "/de/stunden-rechner", description: "Arbeitsstunden berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Steuerrechner", url: "/de/steuerrechner", description: "Steuern berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Stundenlohn-zu-Gehalt-Rechner" keywords="Stundenlohn Jahresgehalt, Stundenlohn umrechnen, Bruttolohn, Arbeitsstunden, Gehaltsrechner Deutschland" breadcrumbs={[{ name: "Stundenlohn-zu-Gehalt-Rechner", url: "/de/stundenlohn-zu-gehalt-rechner" }]} lang="de" enSlug="hourly-to-salary-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stundenlohn-zu-Gehalt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechne deinen Stundenlohn schnell in ein Jahresgehalt um.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-1">Stundenlohn</label>
        <div class="relative">
          <input type="number" id="slg-hourly" class="w-full pl-4 pr-8 py-3 border border-border rounded-xl text-2xl font-bold" value="20" min="0" step="0.25">
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">€</span>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 mb-5">
        <div><label class="block text-xs font-medium text-text mb-1">Stunden/Woche</label><input type="number" id="slg-hours" class="w-full px-3 py-2.5 border border-border rounded-xl text-lg" value="40" min="1" max="60"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Wochen/Jahr</label><input type="number" id="slg-weeks" class="w-full px-3 py-2.5 border border-border rounded-xl text-lg" value="52" min="1" max="52"></div>
      </div>
      <div class="space-y-3 mb-6">
        <div class="p-5 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase mb-1">Jahresgehalt (Brutto)</div>
          <div class="text-4xl font-extrabold" id="slg-annual">41.600 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatlich</div><div class="text-xl font-bold" id="slg-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zweiwochentlich</div><div class="text-xl font-bold" id="slg-biweekly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Woechentlich</div><div class="text-xl font-bold" id="slg-weekly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Taeglich</div><div class="text-xl font-bold" id="slg-daily">0 €</div></div>
        </div>
      </div>
      <div class="bg-surface-alt rounded-xl p-4 mb-6">
        <h3 class="font-semibold text-text text-sm mb-3">Stundenlohn-Jahresgehalt Schnellreferenz</h3>
        <div class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm" id="slg-table"></div>
      </div>

      <ShareButton calculatorId="hourly-to-salary" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Stundenlohn in Jahresgehalt umrechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Jahresgehalt = Stundenlohn × Stunden/Woche × Wochen/Jahr</div>
      <p>Fuer eine Vollzeitstelle: 20 €/Stunde × 40 Stunden × 52 Wochen = 41.600 € Jahresgehalt brutto.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ergibt der Mindestlohn als Jahresgehalt?</strong> Bei 12,41 €/h (gesetzlicher Mindestlohn 2024) und 40h/Woche: ca. 25.812 € Bruttojahresgehalt.</p>
      <p><strong>Welcher Stundenlohn entspricht 50.000 € Jahresgehalt?</strong> 50.000 € / 52 Wochen / 40 Stunden = ca. 24,04 €/Stunde.</p>
      <p><strong>Wie viele Wochen hat ein Arbeitsjahr in Deutschland?</strong> In der Regel 52 Wochen, abzueglich Urlaub (gesetzlich mind. 20 Werktage) ergibt dies ca. 48 bezahlte Arbeitswochen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSLG() {
      const hourly = parseFloat((document.getElementById('slg-hourly') as HTMLInputElement).value) || 0;
      const hours = parseFloat((document.getElementById('slg-hours') as HTMLInputElement).value) || 40;
      const weeks = parseFloat((document.getElementById('slg-weeks') as HTMLInputElement).value) || 52;
      const annual = hourly * hours * weeks;
      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' €';

      document.getElementById('slg-annual')!.textContent = fmt(annual);
      document.getElementById('slg-monthly')!.textContent = fmt(annual / 12);
      document.getElementById('slg-biweekly')!.textContent = fmt(annual / 26);
      document.getElementById('slg-weekly')!.textContent = fmt(hourly * hours);
      document.getElementById('slg-daily')!.textContent = fmt(hourly * hours / 5);

      const table = document.getElementById('slg-table')!;
      const rates = [12, 14, 16, 18, 20, 25, 30, 35, 40, 50, 60, 80];
      table.innerHTML = rates.map(r => '<div class="flex justify-between py-0.5 ' + (r === Math.round(hourly) ? 'font-bold text-primary' : 'text-text-secondary') + '"><span>' + r + ' €/h</span><span>' + fmt(r * 40 * 52) + '/Jahr</span></div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['slg-hourly', 'slg-hours', 'slg-weeks'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', calcSLG);
      });
      calcSLG();
    }, 50);
  </script>
</CalculatorLayout>
