---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hausbrauerei Alkohol Rechner - ABV, OG & FG 2026";
const description = "Berechne den Alkoholgehalt (ABV) aus Stamm- und Endwuerzedichte, Vergaerungsgrad, Kalorien pro Portion und IBU fuer Heimbrauer.";

const relatedCalcs = [
  { name: "Alkohol-Kalorien-Rechner", url: "/de/alkohol-kalorien-rechner", description: "Alkohol-Kalorien." },
  { name: "Alkoholeinheiten-Rechner", url: "/de/alkoholeinheiten-rechner", description: "Alkoholeinheiten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hausbrauerei-Alkohol-Rechner" keywords="ABV Rechner, Heimbrauen, Stammwuerzedichte, Endwuerzedichte, Vergaerungsgrad, IBU, Bier Kalorien, Hausbrauer" breadcrumbs={[{ name: "Hausbrauerei-Alkohol-Rechner", url: "/de/hausbrauerei-alkohol-rechner" }]} lang="de" enSlug="home-brewing-abv-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hausbrauerei-Alkohol-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne ABV, Vergaerungsgrad, Kalorien und Bittere deines Hausbieres aus den Dichtewerten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stammwuerze OG (z.B. 1,050)</label><input type="number" id="hbr-og" class="hbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.050" min="1.000" max="1.200" step="0.001"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Endwuerze FG (z.B. 1,010)</label><input type="number" id="hbr-fg" class="hbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.010" min="0.990" max="1.100" step="0.001"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ansatzmenge (Liter)</label><input type="number" id="hbr-batch" class="hbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Portionsgroesse (ml)</label><input type="number" id="hbr-serv" class="hbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="100" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hopfen Alpha-Saeure (%)</label><input type="number" id="hbr-aa" class="hbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0" max="25" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hopfenmenge (g)</label><input type="number" id="hbr-hops" class="hbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="0" step="5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Kochzeit (Minuten)</label><input type="number" id="hbr-boil" class="hbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="0" max="120" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Alkoholgehalt</div>
          <div class="text-5xl font-extrabold font-mono" id="hbr-result">0% ABV</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ABW (Gew.-%)</div><div class="text-xl font-bold font-mono" id="hbr-abw">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Scheinb. Vergaerungsgrad</div><div class="text-xl font-bold font-mono" id="hbr-aa-out">0%</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Echter Vergaerungsgrad</div><div class="text-xl font-bold font-mono" id="hbr-ra">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kal./Portion</div><div class="text-xl font-bold font-mono" id="hbr-cal">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. IBU</div><div class="text-xl font-bold font-mono" id="hbr-ibu">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Portionen gesamt</div><div class="text-xl font-bold font-mono" id="hbr-servings">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stammwuerze (Grad Plato)</div><div class="text-xl font-bold font-mono" id="hbr-plato">0&deg;P</div></div>
        </div>
      </div>

      <ShareButton calculatorId="home-brewing-abv" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Alkoholgehalt beim Heimbrauen berechnen</h2>
      <p>Der Alkoholgehalt (ABV) ergibt sich aus der Differenz zwischen Stammwuerze (OG) und Endwuerze (FG). Die Standardformel lautet: ABV = (OG - FG) x 131,25.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist OG und FG?</strong> OG (Original Gravity) ist die Dichte der Wuerze vor der Gaerung, FG (Final Gravity) ist die Dichte nach vollstaendiger Vergaerung. Aus der Differenz ergibt sich der Alkoholgehalt.</p>
      <p><strong>Was sind IBU?</strong> IBU (International Bitterness Units) messen die Bittere eines Bieres. Helles Lager hat ca. 10-15 IBU, India Pale Ale 40-70 IBU.</p>
      <p><strong>Was bedeutet Vergaerungsgrad?</strong> Der scheinbare Vergaerungsgrad zeigt, wie viel Zucker in Alkohol umgewandelt wurde. 75-80 % gelten als guter Wert fuer die meisten Biere.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHBR() {
      const og = parseFloat((document.getElementById('hbr-og') as HTMLInputElement).value) || 1.050;
      const fg = parseFloat((document.getElementById('hbr-fg') as HTMLInputElement).value) || 1.010;
      const batch = parseFloat((document.getElementById('hbr-batch') as HTMLInputElement).value) || 20;
      const serv = parseFloat((document.getElementById('hbr-serv') as HTMLInputElement).value) || 500;
      const aa = parseFloat((document.getElementById('hbr-aa') as HTMLInputElement).value) || 6;
      const hops = parseFloat((document.getElementById('hbr-hops') as HTMLInputElement).value) || 40;
      const boil = parseFloat((document.getElementById('hbr-boil') as HTMLInputElement).value) || 60;

      const abv = (og - fg) * 131.25;
      const abw = abv * 0.79336;
      const ogPoints = (og - 1) * 1000;
      const fgPoints = (fg - 1) * 1000;
      const apparentAtten = ogPoints > 0 ? ((ogPoints - fgPoints) / ogPoints) * 100 : 0;
      const realAtten = apparentAtten * 0.8192;
      const plato = (-463.37) + (668.72 * og) - (205.35 * og * og);
      const calSimple = ((abv * 2.5 + fgPoints * 3.55) * serv / 355);

      const gravityFactor = 1.65 * Math.pow(0.000125, (og - 1));
      const timeFactor = (1 - Math.exp(-0.04 * boil)) / 4.15;
      const utilization = gravityFactor * timeFactor;
      const ibu = (aa / 100 * hops * utilization * 1000) / batch;

      const totalMl = batch * 1000;
      const servings = Math.floor(totalMl / serv);

      document.getElementById('hbr-result')!.textContent = abv.toFixed(2).replace('.', ',') + '% ABV';
      document.getElementById('hbr-abw')!.textContent = abw.toFixed(2).replace('.', ',') + '%';
      document.getElementById('hbr-aa-out')!.textContent = apparentAtten.toFixed(1).replace('.', ',') + '%';
      document.getElementById('hbr-ra')!.textContent = realAtten.toFixed(1).replace('.', ',') + '%';
      document.getElementById('hbr-cal')!.textContent = Math.round(calSimple).toString();
      document.getElementById('hbr-ibu')!.textContent = Math.round(ibu).toString();
      document.getElementById('hbr-servings')!.textContent = servings.toString();
      document.getElementById('hbr-plato')!.textContent = plato.toFixed(1).replace('.', ',') + '\u00B0P';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hbr-in').forEach(el => {
        el.addEventListener('input', calcHBR);
        el.addEventListener('change', calcHBR);
      });
      calcHBR();
    }, 50);
  </script>
</CalculatorLayout>
