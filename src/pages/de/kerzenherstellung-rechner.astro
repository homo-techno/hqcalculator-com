---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kerzenherstellung-Rechner - Wachs, Duft & Docht";
const description = "Berechnen Sie Wachsgewicht aus Beh\u00e4ltervolumen, Duftanteil, Dochtgr\u00f6\u00dfenempfehlung und Gie\u00dftemperatur f\u00fcr die Kerzenherstellung.";
const relatedCalcs = [
  { name: "Kerzen-Brenndauer", url: "/de/kerzen-brenndauer-rechner", description: "Brenndauer." },
  { name: "Karamell-Rechner", url: "/de/karamell-rechner", description: "Karamell." },
  { name: "Einmach-Rechner", url: "/de/einmach-rechner", description: "Einmachen." },
  { name: "Kuchenform-Umrechner", url: "/de/kuchenform-umrechner", description: "Backformen." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorien." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kerzenherstellung-Rechner" lang="de" enSlug="candle-making-calculator" keywords="kerzenherstellung rechner, wachsgewicht, duft\u00f6l, dochtgr\u00f6\u00dfe, gie\u00dftemperatur, kerzen selber machen" breadcrumbs={[{ name: "Kerzenherstellung", url: "/de/kerzenherstellung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kerzenherstellung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Wachsgewicht, Duft&ouml;l und Dochtgr&ouml;&szlig;e f&uuml;r Ihre Containerkerzen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Beh&auml;ltervolumen (ml)</label><input type="number" id="kh2-vol" class="kh2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="240" min="30" step="10"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Wachsart</label>
            <select id="kh2-wax" class="kh2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="soy" selected>Sojawachs</option>
              <option value="paraffin">Paraffin</option>
              <option value="beeswax">Bienenwachs</option>
              <option value="coconut">Kokoswachs</option>
              <option value="palm">Palmwachs</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Duftanteil (%)</label><input type="number" id="kh2-frag" class="kh2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" max="15" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Kerzen</label><input type="number" id="kh2-qty" class="kh2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Beh&auml;lterdurchmesser (cm)</label><input type="number" id="kh2-dia" class="kh2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7.5" min="3" max="25" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wachskosten (&euro;/kg)</label><input type="number" id="kh2-cost" class="kh2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wachs pro Kerze</div>
          <div class="text-4xl font-extrabold font-mono" id="kh2-result">0 g</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Duft&ouml;l</div><div class="text-xl font-bold font-mono" id="kh2-fo">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dochtgr&ouml;&szlig;e</div><div class="text-xl font-bold font-mono" id="kh2-wick">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gie&szlig;temperatur</div><div class="text-xl font-bold font-mono" id="kh2-pour">0&deg;C</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wachs gesamt</div><div class="text-xl font-bold font-mono" id="kh2-total">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten</div><div class="text-xl font-bold font-mono" id="kh2-mcost">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="candle-making" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Wie viel Duft&ouml;l soll ich verwenden?</h3>
      <p>6-10% Duftanteil ist der typische Bereich. Sojawachs h&auml;lt bis zu 10-12% Duft&ouml;l, w&auml;hrend Paraffin bis zu 8% aufnehmen kann.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKH2() {
      const vol = parseFloat((document.getElementById('kh2-vol') as HTMLInputElement).value) || 240;
      const waxType = (document.getElementById('kh2-wax') as HTMLSelectElement).value;
      const fragPct = parseFloat((document.getElementById('kh2-frag') as HTMLInputElement).value) || 0;
      const qty = parseInt((document.getElementById('kh2-qty') as HTMLInputElement).value) || 1;
      const dia = parseFloat((document.getElementById('kh2-dia') as HTMLInputElement).value) || 7.5;
      const waxCost = parseFloat((document.getElementById('kh2-cost') as HTMLInputElement).value) || 0;

      const densities: Record<string, number> = { soy: 0.86, paraffin: 0.9, beeswax: 0.96, coconut: 0.82, palm: 0.88 };
      const pourTempsC: Record<string, number> = { soy: 57, paraffin: 82, beeswax: 71, coconut: 52, palm: 93 };
      const density = densities[waxType] || 0.86;
      const pourTemp = pourTempsC[waxType] || 57;

      const totalWeightPerCandle = vol * density;
      const fragG = totalWeightPerCandle * (fragPct / 100);
      const waxG = totalWeightPerCandle - fragG;

      let wickSize = 'Klein (ECO-6)';
      if (dia >= 5 && dia < 6.5) wickSize = 'ECO-6 / CD-5';
      else if (dia >= 6.5 && dia < 7.5) wickSize = 'ECO-8 / CD-8';
      else if (dia >= 7.5 && dia < 9) wickSize = 'ECO-10 / CD-10';
      else if (dia >= 9 && dia < 10) wickSize = 'ECO-12 / CD-12';
      else if (dia >= 10 && dia < 11.5) wickSize = 'ECO-14 / CD-14';
      else if (dia >= 11.5) wickSize = 'ECO-16+ / CD-18';

      const totalWaxG = waxG * qty;
      const totalWaxKg = totalWaxG / 1000;
      const materialCost = totalWaxKg * waxCost;

      const fmt = (v: number) => v.toFixed(1).replace('.', ',');
      document.getElementById('kh2-result')!.textContent = fmt(waxG) + ' g';
      document.getElementById('kh2-fo')!.textContent = fragG.toFixed(1).replace('.', ',') + ' g';
      document.getElementById('kh2-wick')!.textContent = wickSize;
      document.getElementById('kh2-pour')!.textContent = pourTemp + '\u00b0C';
      document.getElementById('kh2-total')!.textContent = totalWaxKg.toFixed(2).replace('.', ',') + ' kg';
      document.getElementById('kh2-mcost')!.textContent = materialCost.toFixed(2).replace('.', ',') + ' \u20ac';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kh2-in').forEach(el => { el.addEventListener('input', calcKH2); el.addEventListener('change', calcKH2); });
      calcKH2();
    }, 50);
  </script>
</CalculatorLayout>
