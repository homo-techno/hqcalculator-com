---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Heimalarmsystem Rechner - Sensoren & Ueberwachungskosten 2026";
const description = "Berechne die Anzahl benoedigter Alarmsensoren nach Tueren, Fenstern und Raeumen. Schaetze Ueberwachungskosten und Akku-Laufzeit fuer dein Sicherheitssystem.";

const relatedCalcs = [
  { name: "Stromkostenrechner", url: "/de/stromkostenrechner", description: "Energiekosten berechnen." },
  { name: "Akkulaufzeit-Rechner", url: "/de/akkulaufzeit-rechner", description: "Akku-Laufzeit." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Heimalarmsystem-Rechner" keywords="Heimalarm Rechner, Alarmsensoren, Sicherheitssystem, Ueberwachungskosten, Alarmanlage, Einbruchschutz" breadcrumbs={[{ name: "Heimalarmsystem-Rechner", url: "/de/heimalarmsystem-rechner" }]} lang="de" enSlug="home-alarm-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Heimalarmsystem-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermittle Sensoranzahl, Ueberwachungskosten und Akku-Laufzeit fuer dein Haussicherheitssystem.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Zugangspunkte & Raeume</h3>
          <div class="grid grid-cols-2 gap-2">
            <div><label class="block text-xs text-text-muted">Aussentueren</label><input type="number" id="has-doors" class="has-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="3" min="0"></div>
            <div><label class="block text-xs text-text-muted">Fenster (Erdgeschoss)</label><input type="number" id="has-windows" class="has-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="8" min="0"></div>
            <div><label class="block text-xs text-text-muted">Terrassent&uuml;ren</label><input type="number" id="has-sliding" class="has-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" min="0"></div>
            <div><label class="block text-xs text-text-muted">Garagentore</label><input type="number" id="has-garage" class="has-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" min="0"></div>
            <div><label class="block text-xs text-text-muted">Raeume f&uuml;r Bewegungsmelder</label><input type="number" id="has-rooms" class="has-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="4" min="0"></div>
            <div><label class="block text-xs text-text-muted">Rauch/CO-Melder</label><input type="number" id="has-smoke" class="has-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="3" min="0"></div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ueberwachungsart</label>
            <select id="has-monitor" class="has-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="self">Selbst&uuml;berwachung (kostenlos)</option>
              <option value="basic" selected>Basis-Profi (15 €/Monat)</option>
              <option value="premium">Premium-Profi (30 €/Monat)</option>
              <option value="full">Vollservice (45 €/Monat)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Systemleistung (Watt)</label>
            <input type="number" id="has-power" class="has-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="1" step="1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Notstromakku (Wh)</label>
          <input type="number" id="has-battery" class="has-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="10" step="10">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benoetgte Sensoren gesamt</div>
          <div class="text-5xl font-extrabold font-mono" id="has-result">0</div>
          <div class="text-sm text-blue-200 mt-1" id="has-note">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kontaktsensoren</div><div class="text-xl font-bold font-mono" id="has-contacts">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bewegungsmelder</div><div class="text-xl font-bold font-mono" id="has-motion">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sicherheitsmelder</div><div class="text-xl font-bold font-mono" id="has-safety">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Notstrom-Laufzeit</div><div class="text-xl font-bold font-mono" id="has-backup">0 Std</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatskosten</div><div class="text-xl font-bold font-mono" id="has-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahreskosten</div><div class="text-xl font-bold font-mono" id="has-annual">0 €</div></div>
        </div>
      </div>

      <ShareButton calculatorId="home-alarm" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Alarmsystem planen</h2>
      <p>Ein gutes Haussicherheitssystem besteht aus Kontaktsensoren an allen Zugangspunkten, Bewegungsmeldern in zentralen Raeumen und einem zuverlaessigen Notstromakku. Professionelle Ueberwachung erhoert die Reaktionszeit im Notfall.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie viele Sensoren brauche ich?</strong> Jede Aussent&uuml;r und jedes Erdgeschossfenster sollte einen Kontaktsensor haben. Zus&auml;tzlich empfehlen sich Bewegungsmelder in Fluren und Wohnbereichen.</p>
      <p><strong>Wie lange haelt der Notstromakku?</strong> Bei einem typischen System mit 15 Watt und 120 Wh Akkukapazit&auml;t h&auml;lt die Sicherung ca. 8 Stunden im Stromausfall.</p>
      <p><strong>Was kostet professionelle &Uuml;berwachung?</strong> Basis-Fernueberwachung kostet ca. 15-45 € pro Monat, je nach Leistungsumfang und Anbieter.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHAS() {
      const doors = parseInt((document.getElementById('has-doors') as HTMLInputElement).value) || 0;
      const windows = parseInt((document.getElementById('has-windows') as HTMLInputElement).value) || 0;
      const sliding = parseInt((document.getElementById('has-sliding') as HTMLInputElement).value) || 0;
      const garage = parseInt((document.getElementById('has-garage') as HTMLInputElement).value) || 0;
      const rooms = parseInt((document.getElementById('has-rooms') as HTMLInputElement).value) || 0;
      const smoke = parseInt((document.getElementById('has-smoke') as HTMLInputElement).value) || 0;
      const monitor = (document.getElementById('has-monitor') as HTMLSelectElement).value;
      const power = parseFloat((document.getElementById('has-power') as HTMLInputElement).value) || 15;
      const batteryWh = parseFloat((document.getElementById('has-battery') as HTMLInputElement).value) || 120;

      const contacts = doors + windows + sliding + garage;
      const motionSensors = rooms;
      const safetyDetectors = smoke;
      const totalSensors = contacts + motionSensors + safetyDetectors;
      const backupHours = power > 0 ? batteryWh / power : 0;

      const monitorCosts: Record<string, number> = { 'self': 0, 'basic': 15, 'premium': 30, 'full': 45 };
      const monthlyCost = monitorCosts[monitor] || 0;
      const annualCost = monthlyCost * 12;

      document.getElementById('has-result')!.textContent = totalSensors.toString();
      document.getElementById('has-note')!.textContent = contacts + ' Kontakt + ' + motionSensors + ' Bewegung + ' + safetyDetectors + ' Sicherheit';
      document.getElementById('has-contacts')!.textContent = contacts.toString();
      document.getElementById('has-motion')!.textContent = motionSensors.toString();
      document.getElementById('has-safety')!.textContent = safetyDetectors.toString();
      document.getElementById('has-backup')!.textContent = backupHours.toFixed(1) + ' Std';
      document.getElementById('has-monthly')!.textContent = monthlyCost.toFixed(2) + ' €';
      document.getElementById('has-annual')!.textContent = annualCost.toFixed(2) + ' €';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.has-in').forEach(el => {
        el.addEventListener('input', calcHAS);
        el.addEventListener('change', calcHAS);
      });
      calcHAS();
    }, 50);
  </script>
</CalculatorLayout>
