---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hutgr&ouml;&szlig;en-Rechner - Kopfumfang zu Hutgr&ouml;&szlig;e";
const description = "Berechnen Sie Ihre Hutgr&ouml;&szlig;e aus dem Kopfumfang mit US-, UK-, EU- und metrischen Umrechnungen.";

const relatedCalcs = [
  { name: "Handschuhgr&ouml;&szlig;en-Rechner", url: "/de/handschuhgroesse-rechner", description: "Handschuhgr&ouml;&szlig;e berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "L&auml;ngen-Umrechner", url: "/de/laengen-umrechner", description: "L&auml;ngenumrechnungen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Hutgr&ouml;&szlig;en-Rechner"
  keywords="hutgr&ouml;&szlig;e rechner, kopfumfang, hutgr&ouml;&szlig;entabelle, US UK EU hutgr&ouml;&szlig;e, gefasste hutgr&ouml;&szlig;e"
  breadcrumbs={[{ name: "Hutgr&ouml;&szlig;en-Rechner", url: "/de/hutgroesse-rechner" }]}
  lang="de"
  enSlug="hat-size-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hutgr&ouml;&szlig;en-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihre Hutgr&ouml;&szlig;e aus dem Kopfumfang mit US-, UK-, EU- und metrischen Umrechnungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kopfumfang</label>
            <input type="number" id="hutde-circ" class="hutde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="56" min="40" max="70" step="0.5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="hutde-unit" class="hutde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="cm" selected>Zentimeter</option>
              <option value="in">Zoll (Inch)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Altersgruppe</label>
          <select id="hutde-age" class="hutde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="baby">Baby (0-12 Monate)</option>
            <option value="toddler">Kleinkind (1-3 Jahre)</option>
            <option value="child">Kind (4-10 Jahre)</option>
            <option value="adult" selected>Erwachsene/r</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">EU Hutgr&ouml;&szlig;e</div>
          <div class="text-4xl font-extrabold font-mono" id="hutde-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">US/UK Gr&ouml;&szlig;e</div><div class="text-xl font-bold font-mono" id="hutde-usuk">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Metrisch (cm)</div><div class="text-xl font-bold font-mono" id="hutde-cm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">S/M/L</div><div class="text-xl font-bold font-mono" id="hutde-alpha">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kronentiefe</div><div class="text-xl font-bold font-mono" id="hutde-crown">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hutdurchmesser</div><div class="text-xl font-bold font-mono" id="hutde-diam">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fitted Gr&ouml;&szlig;e</div><div class="text-xl font-bold font-mono" id="hutde-fitted">--</div></div>
        </div>
      </div>

      <ShareButton calculatorId="hutgroesse-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Hutgr&ouml;&szlig;entabelle</h2>
      <p>Die europ&auml;ische Hutgr&ouml;&szlig;e entspricht dem Kopfumfang in Zentimetern (gerundet). Die US/UK-Gr&ouml;&szlig;e basiert auf dem Kopfumfang in Zoll dividiert durch Pi.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie messe ich meinen Kopfumfang?</strong> Messen Sie mit einem flexiblen Maband um den Kopf, etwa 2,5 cm &uuml;ber den Ohren und quer &uuml;ber die Stirn. Messen Sie mehrmals und nehmen Sie den Durchschnitt.</p>
      <p><strong>Was bedeutet EU-Hutgr&ouml;&szlig;e 56?</strong> Eine EU-Hutgr&ouml;&szlig;e von 56 bedeutet, dass der Innenumfang des Hutes 56 cm betr&auml;gt, passend f&uuml;r einen Kopfumfang von ca. 56 cm.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHUTDE() {
      let circ = parseFloat((document.getElementById('hutde-circ') as HTMLInputElement).value) || 56;
      const unit = (document.getElementById('hutde-unit') as HTMLSelectElement).value;

      let circCm = unit === 'in' ? circ * 2.54 : circ;
      let circIn = unit === 'in' ? circ : circ / 2.54;

      const euSize = Math.round(circCm);
      const usSize = (circIn / Math.PI).toFixed(1);
      const fittedFraction = Math.round(circIn * 8 / Math.PI) / 8;

      let alpha = '--';
      if (circIn < 20.5) alpha = 'XS';
      else if (circIn < 21.5) alpha = 'S';
      else if (circIn < 22.5) alpha = 'M';
      else if (circIn < 23.5) alpha = 'L';
      else if (circIn < 24.5) alpha = 'XL';
      else alpha = 'XXL';

      const crownDepth = circCm / 3;
      const diameter = circCm / Math.PI;

      const fittedBase = Math.floor(fittedFraction);
      const fittedRem = fittedFraction - fittedBase;
      let fittedStr = fittedBase.toString();
      if (Math.abs(fittedRem - 0.125) < 0.01) fittedStr += ' 1/8';
      else if (Math.abs(fittedRem - 0.25) < 0.01) fittedStr += ' 1/4';
      else if (Math.abs(fittedRem - 0.375) < 0.01) fittedStr += ' 3/8';
      else if (Math.abs(fittedRem - 0.5) < 0.01) fittedStr += ' 1/2';
      else if (Math.abs(fittedRem - 0.625) < 0.01) fittedStr += ' 5/8';
      else if (Math.abs(fittedRem - 0.75) < 0.01) fittedStr += ' 3/4';
      else if (Math.abs(fittedRem - 0.875) < 0.01) fittedStr += ' 7/8';

      document.getElementById('hutde-result')!.textContent = euSize.toString();
      document.getElementById('hutde-usuk')!.textContent = fittedStr;
      document.getElementById('hutde-cm')!.textContent = circCm.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' cm';
      document.getElementById('hutde-alpha')!.textContent = alpha;
      document.getElementById('hutde-crown')!.textContent = crownDepth.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' cm';
      document.getElementById('hutde-diam')!.textContent = diameter.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' cm';
      document.getElementById('hutde-fitted')!.textContent = fittedStr;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hutde-in').forEach(el => { el.addEventListener('input', calcHUTDE); el.addEventListener('change', calcHUTDE); });
      calcHUTDE();
    }, 50);
  </script>
</CalculatorLayout>
