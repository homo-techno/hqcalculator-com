---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Zahnimplantat-Kostenrechner - Implantatkosten berechnen";
const description = "Sch\u00e4tzen Sie die Kosten f\u00fcr Zahnimplantate nach Typ (Einzelimplantat, Br\u00fccke, All-on-4), Knochenaufbau, Abutment, Kronenmaterial und Versicherung.";

const relatedCalcs = [
  { name: "Zahnkrone-Rechner", url: "/de/zahnkrone-rechner", description: "Kronenkosten." },
  { name: "Zahnbr\u00fccke-Rechner", url: "/de/zahnbruecke-rechner", description: "Br\u00fcckenkosten." },
  { name: "Zahnversicherung-Rechner", url: "/de/zahnversicherung-rechner", description: "Versicherungsanalyse." },
  { name: "Zahn-R\u00f6ntgen-Rechner", url: "/de/zahn-roentgen-rechner", description: "R\u00f6ntgenstrahlung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Zahnimplantat-Kostenrechner" lang="de" enSlug="dental-implant-cost-calculator" keywords="zahnimplantat kosten, implantat rechner, all-on-4 kosten, knochenaufbau kosten, zahnimplantat versicherung" breadcrumbs={[{ name: "Zahnimplantat-Kostenrechner", url: "/de/zahnimplantat-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zahnimplantat-Kostenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Gesamtkosten Ihres Zahnimplantats inkl. Implantatpfosten, Abutment, Krone und Knochenaufbau.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Implantattyp</label>
          <select id="zdi-type" class="zdi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="single" selected>Einzelimplantat</option>
            <option value="bridge">Implantatgetragene Br&uuml;cke (2 Implantate)</option>
            <option value="allon4">All-on-4 (Vollkiefer)</option>
            <option value="allon6">All-on-6 (Vollkiefer)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zu ersetzende Z&auml;hne</label><input type="number" id="zdi-teeth" class="zdi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="28" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kronenmaterial</label>
            <select id="zdi-crown" class="zdi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="pfm">Metallkeramik</option>
              <option value="zirconia" selected>Zirkonoxid</option>
              <option value="emax">E-Max Keramik</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Knochenaufbau n&ouml;tig?</label>
            <select id="zdi-graft" class="zdi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="none" selected>Kein Aufbau</option>
              <option value="minor">Kleiner Aufbau (250-500 &euro;)</option>
              <option value="major">Sinuslift / gr&ouml;&szlig;erer Aufbau (1.200-2.500 &euro;)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kostenniveau</label>
            <select id="zdi-loc" class="zdi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="low">G&uuml;nstig (l&auml;ndlich)</option>
              <option value="avg" selected>Durchschnitt</option>
              <option value="high">Gro&szlig;stadt / Spezialist</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versicherung/Zuschuss (%)</label><input type="number" id="zdi-ins" class="zdi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Zuschuss (&euro;)</label><input type="number" id="zdi-max" class="zdi-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="0" max="10000" step="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="zdi-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Implantatpfosten</div><div class="text-xl font-bold font-mono" id="zdi-post">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abutments</div><div class="text-xl font-bold font-mono" id="zdi-abut">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kronen</div><div class="text-xl font-bold font-mono" id="zdi-crn">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Knochenaufbau</div><div class="text-xl font-bold font-mono" id="zdi-graftc">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kassenleistung</div><div class="text-xl font-bold font-mono" id="zdi-insc">-0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="zdi-oop">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dental-implant-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Zahnimplantat-Kosten in Deutschland</h2>
      <p>Ein einzelnes Zahnimplantat kostet in Deutschland typischerweise 1.800-3.500 &euro; inkl. Pfosten, Abutment und Krone. Die gesetzliche Krankenkasse zahlt nur den Festzuschuss f&uuml;r die Regelversorgung (Br&uuml;cke/Prothese).</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Zahlt die Krankenkasse Implantate?</strong> Nur den befundorientierten Festzuschuss (wie f&uuml;r konventionellen Zahnersatz). Eine Zahnzusatzversicherung kann bis zu 90% der Kosten &uuml;bernehmen.</p>
      <p><strong>Was kostet All-on-4?</strong> Ein All-on-4-Konzept kostet ca. 12.000-18.000 &euro; pro Kiefer in Deutschland.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const zdiFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcZDI() {
      const type = (document.getElementById('zdi-type') as HTMLSelectElement).value;
      const teeth = parseFloat((document.getElementById('zdi-teeth') as HTMLInputElement).value) || 1;
      const crownMat = (document.getElementById('zdi-crown') as HTMLSelectElement).value;
      const graft = (document.getElementById('zdi-graft') as HTMLSelectElement).value;
      const loc = (document.getElementById('zdi-loc') as HTMLSelectElement).value;
      const insPct = parseFloat((document.getElementById('zdi-ins') as HTMLInputElement).value) || 0;
      const insMax = parseFloat((document.getElementById('zdi-max') as HTMLInputElement).value) || 0;

      const locMult: Record<string, number> = { low: 0.8, avg: 1.0, high: 1.3 };
      const mult = locMult[loc] || 1.0;

      let implantCount = teeth;
      let postCostEach = 1500;
      let abutCostEach = 400;
      let crownCosts: Record<string, number> = { pfm: 750, zirconia: 1000, emax: 950 };
      let crownCostEach = crownCosts[crownMat] || 950;
      let crownCount = teeth;

      if (type === 'bridge') {
        implantCount = 2;
        crownCount = teeth;
      } else if (type === 'allon4') {
        implantCount = 4;
        postCostEach = 1700;
        crownCostEach = 0;
        abutCostEach = 0;
        crownCount = 0;
        var archCost = 15000 * mult;
      } else if (type === 'allon6') {
        implantCount = 6;
        postCostEach = 1700;
        crownCostEach = 0;
        abutCostEach = 0;
        crownCount = 0;
        var archCost = 20000 * mult;
      }

      let graftCost = 0;
      if (graft === 'minor') graftCost = 375 * mult;
      else if (graft === 'major') graftCost = 1850 * mult;

      let postTotal = 0;
      let abutTotal = 0;
      let crownTotal = 0;

      if (type === 'allon4' || type === 'allon6') {
        postTotal = implantCount * postCostEach * mult;
        abutTotal = 0;
        crownTotal = archCost!;
      } else {
        postTotal = implantCount * postCostEach * mult;
        abutTotal = implantCount * abutCostEach * mult;
        crownTotal = crownCount * crownCostEach * mult;
      }

      const subtotal = postTotal + abutTotal + crownTotal + graftCost;
      const insOffset = Math.min(subtotal * (insPct / 100), insMax);
      const oop = subtotal - insOffset;

      document.getElementById('zdi-total')!.textContent = zdiFmt(subtotal);
      document.getElementById('zdi-post')!.textContent = zdiFmt(postTotal);
      document.getElementById('zdi-abut')!.textContent = zdiFmt(abutTotal);
      document.getElementById('zdi-crn')!.textContent = (type === 'allon4' || type === 'allon6') ? zdiFmt(crownTotal) + ' (Kiefer)' : zdiFmt(crownTotal);
      document.getElementById('zdi-graftc')!.textContent = zdiFmt(graftCost);
      document.getElementById('zdi-insc')!.textContent = '-' + zdiFmt(insOffset);
      document.getElementById('zdi-oop')!.textContent = zdiFmt(oop);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zdi-in').forEach(el => { el.addEventListener('input', calcZDI); el.addEventListener('change', calcZDI); });
      calcZDI();
    }, 50);
  </script>
</CalculatorLayout>
