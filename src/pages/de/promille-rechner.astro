---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Promillerechner - Blutalkoholkonzentration schätzen";
const description = "Schätzen Sie Ihre Blutalkoholkonzentration (BAK/Promille) basierend auf Getränken, Gewicht, Geschlecht und Zeit. Erfahren Sie, wann Sie wieder nüchtern und fahrtüchtig sind.";

const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorien-rechner", description: "Tägliche Kalorien." },
  { name: "Wasseraufnahme", url: "/de/wasseraufnahme-rechner", description: "Flüssigkeitszufuhr." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Gewichtsabnahme." },
  { name: "Zeitrechner", url: "/de/zeit-rechner", description: "Zeitrechnung." },
  { name: "Prozentrechner", url: "/de/prozent-rechner", description: "Prozente." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Promillerechner"
  keywords="Promillerechner, Blutalkohol, BAK, Alkoholrechner, nüchtern Rechner, Blutalkoholkonzentration"
  breadcrumbs={[{ name: "Promillerechner", url: "/de/promille-rechner" }]}
  lang="de"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Promillerechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Ihre Blutalkoholkonzentration basierend auf Ihrem Konsum.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="p-3 bg-yellow-50 border border-yellow-200 rounded-xl text-sm text-yellow-800 mb-6">
        <strong>Haftungsausschluss:</strong> Dies ist nur eine Schätzung. Verlassen Sie sich NICHT darauf, um zu beurteilen, ob Sie fahrtüchtig sind. Im Zweifelsfall nicht fahren.
      </div>

      <div class="grid grid-cols-2 gap-4 mb-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Geschlecht</label>
          <div class="flex gap-2">
            <button class="bac-gender-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-primary text-white" data-gender="male">Mann</button>
            <button class="bac-gender-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary" data-gender="female">Frau</button>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Körpergewicht</label>
          <div class="flex gap-1">
            <input type="number" id="bac-weight" class="flex-1 px-3 py-2.5 border border-border rounded-xl text-lg" value="80" min="40" max="200">
            <select id="bac-unit" class="px-2 py-2 border border-border rounded-xl text-sm">
              <option value="kg" selected>kg</option>
              <option value="lbs">lbs</option>
            </select>
          </div>
        </div>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Konsumierte Getränke</label>
        <div class="grid grid-cols-2 gap-3" id="bac-drinks">
          <div class="p-3 bg-surface-alt rounded-xl">
            <div class="text-xs text-text-muted uppercase mb-1">Bier (0,5l, 5%)</div>
            <div class="flex items-center gap-2">
              <button class="bac-dec px-2 py-1 border border-border rounded-lg font-bold" data-drink="beer">&minus;</button>
              <span class="text-2xl font-bold w-8 text-center" id="bac-beer">2</span>
              <button class="bac-inc px-2 py-1 border border-border rounded-lg font-bold" data-drink="beer">+</button>
            </div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl">
            <div class="text-xs text-text-muted uppercase mb-1">Wein (0,2l, 12%)</div>
            <div class="flex items-center gap-2">
              <button class="bac-dec px-2 py-1 border border-border rounded-lg font-bold" data-drink="wine">&minus;</button>
              <span class="text-2xl font-bold w-8 text-center" id="bac-wine">0</span>
              <button class="bac-inc px-2 py-1 border border-border rounded-lg font-bold" data-drink="wine">+</button>
            </div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl">
            <div class="text-xs text-text-muted uppercase mb-1">Schnaps (2cl, 40%)</div>
            <div class="flex items-center gap-2">
              <button class="bac-dec px-2 py-1 border border-border rounded-lg font-bold" data-drink="shot">&minus;</button>
              <span class="text-2xl font-bold w-8 text-center" id="bac-shot">0</span>
              <button class="bac-inc px-2 py-1 border border-border rounded-lg font-bold" data-drink="shot">+</button>
            </div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl">
            <div class="text-xs text-text-muted uppercase mb-1">Cocktail (Mixgetränk)</div>
            <div class="flex items-center gap-2">
              <button class="bac-dec px-2 py-1 border border-border rounded-lg font-bold" data-drink="cocktail">&minus;</button>
              <span class="text-2xl font-bold w-8 text-center" id="bac-cocktail">0</span>
              <button class="bac-inc px-2 py-1 border border-border rounded-lg font-bold" data-drink="cocktail">+</button>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-1">Zeit seit dem ersten Getränk</label>
        <div class="flex gap-2">
          <input type="number" id="bac-hours" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg" value="1" min="0" max="24" step="0.5">
          <span class="self-center text-text-muted font-semibold">Stunden</span>
        </div>
      </div>

      <div class="p-6 rounded-2xl text-white text-center mb-4" id="bac-result-bg">
        <div class="text-sm uppercase tracking-wide mb-1 opacity-80">Geschätzte Promille</div>
        <div class="text-5xl font-extrabold" id="bac-result">0,000 &permil;</div>
        <div class="text-sm mt-2 font-semibold" id="bac-status">Nüchtern</div>
      </div>

      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Standardgetränke</div>
          <div class="text-xl font-bold" id="bac-std-drinks">0</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Nüchtern in (ca.)</div>
          <div class="text-xl font-bold" id="bac-sober-in">0 Std.</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gesamtkalorien</div>
          <div class="text-xl font-bold" id="bac-calories">0</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Grenzwert (0,5 &permil;)</div>
          <div class="text-xl font-bold" id="bac-legal">&mdash;</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-2">Promille-Wirkungstabelle</h3>
        <div class="space-y-1 text-sm" id="bac-guide"></div>
      </div>

      <ShareButton calculatorId="bac" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie wird der Promillewert berechnet?</h2>
      <p>Dieser Rechner verwendet die Widmark-Formel zur Schätzung der Blutalkoholkonzentration:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Promille = (Alkohol in Gramm / (Körpergewicht in kg &times; r)) - (0,15 &times; Stunden)</div>
      <p>Wobei r = 0,68 für Männer und 0,55 für Frauen (Widmark-Faktor für Körperwasseranteil).</p>

      <h3 class="text-xl font-semibold text-text mt-8">Gesetzliche Grenzwerte</h3>
      <ul>
        <li><strong>Deutschland:</strong> 0,5 &permil; (0,0 &permil; für Fahranfänger)</li>
        <li><strong>Österreich:</strong> 0,5 &permil;</li>
        <li><strong>Schweiz:</strong> 0,5 &permil; (0,1 &permil; für Neulenker)</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange dauert es, nüchtern zu werden?</strong> Ihr Körper baut Alkohol mit ca. 0,1-0,15 Promille pro Stunde ab. Es gibt keine Möglichkeit, dies zu beschleunigen - Kaffee, Wasser und Essen senken den Promillewert nicht schneller.</p>
      <p><strong>Ist dieser Rechner genau genug um festzustellen, ob ich fahren kann?</strong> Nein. Der individuelle Stoffwechsel variiert stark. Dies ist nur eine Schätzung. Wenn Sie getrunken haben, nutzen Sie ein Taxi oder einen Fahrdienst.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let bacGender = 'male';
    const drinks: Record<string, number> = { beer: 2, wine: 0, shot: 0, cocktail: 0 };
    const alcGrams: Record<string, number> = { beer: 20, wine: 19, shot: 6.3, cocktail: 20 };
    const calories: Record<string, number> = { beer: 210, wine: 170, shot: 50, cocktail: 200 };

    function calcBAC() {
      let weightKg = parseFloat((document.getElementById('bac-weight') as HTMLInputElement).value) || 80;
      const unit = (document.getElementById('bac-unit') as HTMLSelectElement).value;
      if (unit === 'lbs') weightKg = weightKg / 2.2046;

      const hours = parseFloat((document.getElementById('bac-hours') as HTMLInputElement).value) || 0;
      const r = bacGender === 'male' ? 0.68 : 0.55;

      const totalAlcGrams = Object.entries(drinks).reduce((s, [k, v]) => s + v * alcGrams[k], 0);
      const totalCalories = Object.entries(drinks).reduce((s, [k, v]) => s + v * calories[k], 0);
      const stdDrinks = Object.values(drinks).reduce((a, b) => a + b, 0);

      let promille = (totalAlcGrams / (weightKg * r)) - (0.15 * hours);
      promille = Math.max(0, promille);

      const soberHours = promille > 0 ? promille / 0.15 : 0;

      const bg = document.getElementById('bac-result-bg')!;
      let status: string;
      if (promille === 0) { bg.className = 'p-6 rounded-2xl text-white text-center mb-4 bg-gray-500'; status = 'Nüchtern'; }
      else if (promille < 0.3) { bg.className = 'p-6 rounded-2xl text-white text-center mb-4 bg-green-600'; status = 'Minimale Beeinträchtigung'; }
      else if (promille < 0.5) { bg.className = 'p-6 rounded-2xl text-white text-center mb-4 bg-yellow-600'; status = 'Beeinträchtigt - NICHT FAHREN'; }
      else if (promille < 1.1) { bg.className = 'p-6 rounded-2xl text-white text-center mb-4 bg-orange-600'; status = 'Fahruntüchtig - GEFAHR'; }
      else { bg.className = 'p-6 rounded-2xl text-white text-center mb-4 bg-red-700'; status = 'SCHWERE Beeinträchtigung - GEFÄHRLICH'; }

      document.getElementById('bac-result')!.textContent = promille.toFixed(2).replace('.', ',') + ' \u2030';
      document.getElementById('bac-status')!.textContent = status;
      document.getElementById('bac-std-drinks')!.textContent = String(stdDrinks);
      document.getElementById('bac-sober-in')!.textContent = soberHours > 0 ? soberHours.toFixed(1).replace('.', ',') + ' Std.' : 'Jetzt';
      document.getElementById('bac-calories')!.textContent = Math.round(totalCalories).toLocaleString('de-DE');
      document.getElementById('bac-legal')!.textContent = promille >= 0.5 ? '\u00DCBER' : 'Unter';

      const levels = [
        { bac: 0.2, label: '0,2 \u2030', effect: 'Leichte Stimmungsaufhellung, Entspannung', color: 'text-green-700' },
        { bac: 0.5, label: '0,5 \u2030', effect: 'Gesetzliche Grenze - Reaktion verlangsamt', color: 'text-yellow-700' },
        { bac: 0.8, label: '0,8 \u2030', effect: 'Deutliche Koordinationsstörungen', color: 'text-orange-700' },
        { bac: 1.1, label: '1,1 \u2030', effect: 'Absolute Fahruntüchtigkeit (Straftat)', color: 'text-orange-700' },
        { bac: 1.6, label: '1,6 \u2030', effect: 'MPU-Grenze - Schwere Beeinträchtigung', color: 'text-red-700' },
        { bac: 2.5, label: '2,5 \u2030', effect: 'Möglicher Bewusstseinsverlust', color: 'text-red-800' },
        { bac: 3.5, label: '3,5 \u2030', effect: 'Lebensgefahr', color: 'text-red-900' },
      ];
      document.getElementById('bac-guide')!.innerHTML = levels.map(l =>
        '<div class="flex items-center gap-2 py-1 ' + (promille >= l.bac ? 'font-bold' : '') + '">' +
          '<span class="w-14 font-mono ' + l.color + '">' + l.label + '</span>' +
          '<div class="flex-1 h-1.5 bg-border/30 rounded-full"><div class="h-full rounded-full ' + (promille >= l.bac ? 'bg-primary' : 'bg-border/50') + '" style="width:' + Math.min(100, (l.bac / 3.5) * 100) + '%"></div></div>' +
          '<span class="text-text-secondary text-xs flex-1">' + l.effect + '</span>' +
        '</div>'
      ).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bac-gender-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bac-gender-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          bacGender = (btn as HTMLElement).dataset.gender || 'male';
          calcBAC();
        });
      });

      document.querySelectorAll('.bac-inc').forEach(btn => {
        btn.addEventListener('click', () => {
          const drink = (btn as HTMLElement).dataset.drink!;
          drinks[drink]++;
          document.getElementById('bac-' + drink)!.textContent = String(drinks[drink]);
          calcBAC();
        });
      });

      document.querySelectorAll('.bac-dec').forEach(btn => {
        btn.addEventListener('click', () => {
          const drink = (btn as HTMLElement).dataset.drink!;
          drinks[drink] = Math.max(0, drinks[drink] - 1);
          document.getElementById('bac-' + drink)!.textContent = String(drinks[drink]);
          calcBAC();
        });
      });

      ['bac-weight', 'bac-hours'].forEach(id => document.getElementById(id)!.addEventListener('input', calcBAC));
      document.getElementById('bac-unit')!.addEventListener('change', calcBAC);

      calcBAC();
    }, 50);
  </script>
</CalculatorLayout>
