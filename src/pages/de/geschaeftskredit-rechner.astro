---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gesch&auml;ftskredit-Rechner - Gewerbliche Kreditraten";
const description = "Berechnen Sie Gesch&auml;ftskredit-Raten, Gesamtzinsen und sehen Sie den Tilgungsplan f&uuml;r gewerbliche Darlehen.";
const relatedCalcs = [
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Privatkredite." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Gewinnmargen-Rechner", url: "/de/gewinnmargenrechner", description: "Gewinnmargen." },
  { name: "Anleihe-Rechner", url: "/de/anleihe-rechner", description: "Anleihen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gesch&auml;ftskredit-Rechner" lang="de" enSlug="business-loan-calculator" keywords="gesch&auml;ftskredit rechner, gewerblicher kredit, unternehmenskredit, kreditrate berechnen" breadcrumbs={[{ name: "Gesch&auml;ftskredit-Rechner", url: "/de/geschaeftskredit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gesch&auml;ftskredit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie monatliche Raten und Gesamtkosten f&uuml;r Gesch&auml;ftskredite.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kreditbetrag (&euro;)</label><input type="number" id="bl-amt" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zinssatz (%)</label><input type="number" id="bl-rate" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="30" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Jahre)</label><input type="number" id="bl-term" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bearbeitungsgeb&uuml;hr (%)</label><input type="number" id="bl-fee" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="10" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Rate</div>
          <div class="text-5xl font-extrabold font-mono" id="bl-payment">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtzinsen</div><div class="text-xl font-bold" id="bl-interest">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="bl-total">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bearbeitungsgeb.</div><div class="text-xl font-bold" id="bl-origfee">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">W&ouml;chentliche Rate</div><div class="text-xl font-bold" id="bl-weekly">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ben&ouml;t. Tagesumsatz</div><div class="text-xl font-bold" id="bl-daily">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="business-loan" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Was ist eine typische Bearbeitungsgeb&uuml;hr?</strong> In Deutschland liegen Bearbeitungsgeb&uuml;hren f&uuml;r Gesch&auml;ftskredite bei 0,5-3% der Kreditsumme.</p>
      <p><strong>Wie wird die Rate berechnet?</strong> Die Rate wird mit der Annuit&auml;tenformel berechnet, bei der sich die Zusammensetzung aus Tilgung und Zinsen &uuml;ber die Laufzeit verschiebt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBL() {
      const amt = parseFloat((document.getElementById('bl-amt') as HTMLInputElement).value) || 0;
      const rate = (parseFloat((document.getElementById('bl-rate') as HTMLInputElement).value) || 0) / 100 / 12;
      const term = (parseInt((document.getElementById('bl-term') as HTMLInputElement).value) || 1) * 12;
      const fee = (parseFloat((document.getElementById('bl-fee') as HTMLInputElement).value) || 0) / 100;
      const origFee = amt * fee;
      let payment: number;
      if (rate === 0) { payment = amt / term; }
      else { payment = amt * rate * Math.pow(1 + rate, term) / (Math.pow(1 + rate, term) - 1); }
      const totalPaid = payment * term;
      const totalInterest = totalPaid - amt;
      const fmtEur = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('bl-payment')!.textContent = fmtEur(payment);
      document.getElementById('bl-interest')!.textContent = fmtEur(totalInterest);
      document.getElementById('bl-total')!.textContent = fmtEur(totalPaid + origFee);
      document.getElementById('bl-origfee')!.textContent = fmtEur(origFee);
      document.getElementById('bl-weekly')!.textContent = fmtEur(payment * 12 / 52);
      document.getElementById('bl-daily')!.textContent = fmtEur(payment * 12 / 365);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bl-amt') as HTMLInputElement).value = '250000';
      (document.getElementById('bl-rate') as HTMLInputElement).value = '5.5';
      (document.getElementById('bl-term') as HTMLInputElement).value = '10';
      (document.getElementById('bl-fee') as HTMLInputElement).value = '1.5';
      document.querySelectorAll('.bl-in').forEach(el => el.addEventListener('input', calcBL));
      calcBL();
    }, 50);
  </script>
</CalculatorLayout>
