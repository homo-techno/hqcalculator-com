---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Frachtklasse-Rechner - Frachtklassifizierung & Dichte";
const description = "Bestimmen Sie die Frachtklasse anhand von Dichte, Verstaubarkeit, Handhabung und Haftung. Unverzichtbar f\u00FCr genaue St\u00FCckgut-Angebote.";
const relatedCalcs = [
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen berechnen." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle finden." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Transportkosten-Rechner", url: "/de/transportkosten-rechner", description: "Transportkosten sch\u00E4tzen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Frachtklasse-Rechner" lang="de" enSlug="freight-class-calculator" keywords="frachtklasse, dichte, st\u00FCckgut, frachtklassifizierung, verstaubarkeit, transportklasse" breadcrumbs={[{ name: "Frachtklasse", url: "/de/frachtklasse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Frachtklasse-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die Frachtklasse basierend auf Dichte, Verstaubarkeit, Handhabung und Haftung f&uuml;r St&uuml;ckgut-Sendungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Sendungsgewicht (kg)</label><input type="number" id="fkr-weight" class="fkr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="1" step="1"></div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">L&auml;nge (cm)</label><input type="number" id="fkr-length" class="fkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="fkr-width" class="fkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">H&ouml;he (cm)</label><input type="number" id="fkr-height" class="fkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Verstaubarkeit</label><select id="fkr-stow" class="fkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="easy">Einfach - Standard-Palette</option><option value="moderate">Mittel - Unregelm&auml;&szlig;ige Form</option><option value="difficult">Schwierig - Gefahrgut/&Uuml;bergr&ouml;&szlig;e</option></select></div>
        <div><label class="block text-xs font-medium text-text mb-1">Handhabung</label><select id="fkr-handle" class="fkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="easy">Einfach - Keine besonderen Anforderungen</option><option value="moderate">Mittel - Erfordert Sorgfalt</option><option value="difficult">Schwierig - Zerbrechlich/Gefahrgut</option></select></div>
        <div><label class="block text-xs font-medium text-text mb-1">Haftung</label><select id="fkr-liability" class="fkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="low">Gering - Unter 10 &euro;/kg Wert</option><option value="medium">Mittel - 10-50 &euro;/kg Wert</option><option value="high">Hoch - &Uuml;ber 50 &euro;/kg Wert</option></select></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Frachtklasse</div>
          <div class="text-5xl font-extrabold font-mono" id="fkr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dichte (kg/m&sup3;)</div><div class="text-xl font-bold font-mono" id="fkr-density">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen (m&sup3;)</div><div class="text-xl font-bold font-mono" id="fkr-volume">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dichteklasse</div><div class="text-xl font-bold font-mono" id="fkr-dclass">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tarifstufe</div><div class="text-xl font-bold font-mono" id="fkr-tier">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="freight-class-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Frachtklassen verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Dichte = Gewicht (kg) / Volumen (m&sup3;)</p>
        <p>Volumen = L&auml;nge &times; Breite &times; H&ouml;he</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bestimmt die Frachtklasse?</strong> Vier Faktoren: Dichte, Verstaubarkeit, Handhabung und Haftungsrisiko. Die Dichte ist der wichtigste Faktor.</p>
      <p><strong>Warum ist die Frachtklasse wichtig?</strong> Die Klasse bestimmt den Frachttarif. Niedrigere Klassen (h&ouml;here Dichte) sind g&uuml;nstiger als h&ouml;here Klassen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFKR() {
      const weight = parseFloat((document.getElementById('fkr-weight') as HTMLInputElement).value) || 0;
      const length = parseFloat((document.getElementById('fkr-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('fkr-width') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('fkr-height') as HTMLInputElement).value) || 0;
      const stow = (document.getElementById('fkr-stow') as HTMLSelectElement).value;
      const handle = (document.getElementById('fkr-handle') as HTMLSelectElement).value;
      const liability = (document.getElementById('fkr-liability') as HTMLSelectElement).value;
      const volumeM3 = (length * width * height) / 1000000;
      const density = volumeM3 > 0 ? weight / volumeM3 : 0;
      const pcf = density * 0.062428;
      let densityClass = 500;
      if (pcf >= 50) densityClass = 50;
      else if (pcf >= 35) densityClass = 55;
      else if (pcf >= 30) densityClass = 60;
      else if (pcf >= 22.5) densityClass = 65;
      else if (pcf >= 15) densityClass = 70;
      else if (pcf >= 13.5) densityClass = 77.5;
      else if (pcf >= 12) densityClass = 85;
      else if (pcf >= 10.5) densityClass = 92.5;
      else if (pcf >= 9) densityClass = 100;
      else if (pcf >= 8) densityClass = 110;
      else if (pcf >= 7) densityClass = 125;
      else if (pcf >= 6) densityClass = 150;
      else if (pcf >= 5) densityClass = 175;
      else if (pcf >= 4) densityClass = 200;
      else if (pcf >= 3) densityClass = 250;
      else if (pcf >= 2) densityClass = 300;
      else if (pcf >= 1) densityClass = 400;
      let adjustment = 0;
      if (stow === 'moderate') adjustment += 1;
      if (stow === 'difficult') adjustment += 2;
      if (handle === 'moderate') adjustment += 1;
      if (handle === 'difficult') adjustment += 2;
      if (liability === 'medium') adjustment += 1;
      if (liability === 'high') adjustment += 2;
      const classes = [50, 55, 60, 65, 70, 77.5, 85, 92.5, 100, 110, 125, 150, 175, 200, 250, 300, 400, 500];
      let idx = classes.indexOf(densityClass);
      idx = Math.min(classes.length - 1, idx + Math.floor(adjustment / 2));
      const finalClass = classes[idx];
      let tier = 'Economy';
      if (finalClass >= 300) tier = 'Premium';
      else if (finalClass >= 150) tier = 'Hoch';
      else if (finalClass >= 85) tier = 'Standard';
      document.getElementById('fkr-result')!.textContent = 'Klasse ' + finalClass;
      document.getElementById('fkr-density')!.textContent = density.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' kg/m\u00B3';
      document.getElementById('fkr-volume')!.textContent = volumeM3.toLocaleString('de-DE', {minimumFractionDigits:3, maximumFractionDigits:3}) + ' m\u00B3';
      document.getElementById('fkr-dclass')!.textContent = 'Klasse ' + densityClass;
      document.getElementById('fkr-tier')!.textContent = tier;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('fkr-weight') as HTMLInputElement).value = '230';
      (document.getElementById('fkr-length') as HTMLInputElement).value = '120';
      (document.getElementById('fkr-width') as HTMLInputElement).value = '100';
      (document.getElementById('fkr-height') as HTMLInputElement).value = '90';
      document.querySelectorAll('.fkr-in').forEach(el => { el.addEventListener('input', calcFKR); el.addEventListener('change', calcFKR); });
      calcFKR();
    }, 50);
  </script>
</CalculatorLayout>
