---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Industrieroboter-ROI-Rechner - Amortisationszeit & Gesamtkosten";
const description = "Berechnen Sie die Kapitalrendite für Industrieroboter-Automatisierung. Schätzen Sie Arbeitskosteneinsparungen, Amortisationszeit, Gesamtbetriebskosten und 5-Jahres-ROI.";
const relatedCalcs = [
  { name: "Robotergeschwindigkeit-Rechner", url: "/robot-speed-calculator", description: "Zykluszeit optimieren." },
  { name: "Cobot-Nutzlast-Rechner", url: "/cobot-payload-calculator", description: "Kollaborativroboter-Nutzlast." },
  { name: "Roboterarm-Rechner", url: "/robot-arm-calculator", description: "Roboterarm-Reichweite." },
  { name: "ROI-Rechner", url: "/roi-calculator", description: "Allgemeine Kapitalrendite." },
  { name: "Break-Even-Rechner", url: "/break-even-calculator", description: "Break-Even-Punkt." },
  { name: "Fördergeschwindigkeit-Rechner", url: "/conveyor-speed-calculator", description: "Förderband-Durchsatz." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie berechnet man den ROI für einen Industrieroboter?",
      "acceptedAnswer": { "@type": "Answer", "text": "ROI = (Nettoeinsparungen über Analyseperiode / Gesamtinvestition) × 100 %. Die Amortisationszeit = Gesamtinvestition / Jährliche Nettoeinsparungen. Typische Industrieroboter amortisieren sich in 2–4 Jahren." }
    },
    {
      "@type": "Question",
      "name": "Was kostet ein Industrieroboter durchschnittlich?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ein Industrieroboter kostet je nach Typ 20.000–150.000 €. Hinzu kommen Integrationskosten (20.000–80.000 €), Greifer/Werkzeuge (5.000–30.000 €) und jährliche Wartung (3.000–10.000 €)." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Industrieroboter-ROI-Rechner" lang="de" keywords="industrieroboter roi rechner, automatisierung amortisation, roboter investition, arbeitskosteneinsparungen, gesamtbetriebskosten, automatisierung roi" breadcrumbs={[{ name: "Industrieroboter-ROI-Rechner", url: "/de/industrieroboter-roi-rechner" }]} enSlug="industrial-robot-roi-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Industrieroboter-ROI-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Kapitalrendite für ein Roboter-Automatisierungsprojekt. Berechnen Sie Amortisationszeit, Jährliche Einsparungen und Gesamtbetriebskosten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-6">
        <h3 class="text-lg font-bold text-text">Roboterinvestition</h3>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Roboter-Kaufpreis (€)</label>
          <input type="number" id="ir-robot-cost" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70000" min="1000" step="5000">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Integration / Installation (€)</label>
          <input type="number" id="ir-integration" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45000" min="0" step="5000">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Greifer / Werkzeuge (€)</label>
          <input type="number" id="ir-tooling" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15000" min="0" step="1000">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Jährliche Wartung (€)</label>
          <input type="number" id="ir-maintenance" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000" min="0" step="500">
        </div>

        <h3 class="text-lg font-bold text-text">Arbeitskosteneinsparungen</h3>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Ersetzte Mitarbeiter</label>
          <input type="number" id="ir-workers" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0.5" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Vollständige Arbeitskosten (€/Std.)</label>
          <input type="number" id="ir-labor-rate" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="10" step="1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Schichten pro Tag</label>
          <input type="number" id="ir-shifts" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="3" step="1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Arbeitstage pro Jahr</label>
          <input type="number" id="ir-days" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="250" min="100" max="365" step="5">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Roboter-Stromkosten (€/Jahr)</label>
          <input type="number" id="ir-electric" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2000" min="0" step="100">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Analysezeitraum (Jahre)</label>
          <input type="number" id="ir-years" class="ir-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="15" step="1">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm font-medium opacity-80 mb-1">Amortisationszeit</div>
          <div id="ir-result-payback" class="text-3xl sm:text-4xl font-extrabold">--</div>
          <div class="text-sm opacity-80 mt-1">Monate</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Gesamtinvestition</div>
            <div id="ir-total-invest" class="text-lg font-bold text-text">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Jährl. Arbeitseinsparungen</div>
            <div id="ir-annual-save" class="text-lg font-bold text-text">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Nettojährliche Einsparungen</div>
            <div id="ir-net-save" class="text-lg font-bold text-text">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">ROI über Zeitraum</div>
            <div id="ir-roi" class="text-lg font-bold text-text">--</div>
          </div>
        </div>

        <ShareButton calculatorId="industrieroboter-roi" lang="de" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Industrieroboter-ROI berechnen</h2>
      <p>Die Amortisationszeit eines Industrieroboters hängt von Investitionskosten, Arbeitseinsparungen und laufenden Betriebskosten ab. Typische Industrieroboter amortisieren sich in 2–4 Jahren bei 2-Schichtbetrieb.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie berechnet man den ROI für einen Industrieroboter?</h4>
      <p>ROI = (Nettoeinsparungen / Gesamtinvestition) × 100 %. Die Amortisationszeit = Gesamtinvestition / Jährliche Nettoeinsparungen.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Was kostet ein Industrieroboter durchschnittlich?</h4>
      <p>Ein Industrieroboter kostet 20.000–150.000 €. Hinzu kommen Integrations-, Werkzeug- und Wartungskosten.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcIR() {
      const robotCost = parseFloat((document.getElementById('ir-robot-cost') as HTMLInputElement).value) || 70000;
      const integration = parseFloat((document.getElementById('ir-integration') as HTMLInputElement).value) || 45000;
      const tooling = parseFloat((document.getElementById('ir-tooling') as HTMLInputElement).value) || 15000;
      const maintenance = parseFloat((document.getElementById('ir-maintenance') as HTMLInputElement).value) || 5000;
      const workers = parseFloat((document.getElementById('ir-workers') as HTMLInputElement).value) || 2;
      const laborRate = parseFloat((document.getElementById('ir-labor-rate') as HTMLInputElement).value) || 35;
      const shifts = parseFloat((document.getElementById('ir-shifts') as HTMLInputElement).value) || 2;
      const days = parseFloat((document.getElementById('ir-days') as HTMLInputElement).value) || 250;
      const electric = parseFloat((document.getElementById('ir-electric') as HTMLInputElement).value) || 2000;
      const years = parseFloat((document.getElementById('ir-years') as HTMLInputElement).value) || 5;

      const totalInvestment = robotCost + integration + tooling;
      const annualLaborSavings = workers * laborRate * 8 * shifts * days;
      const annualCosts = maintenance + electric;
      const netAnnualSavings = annualLaborSavings - annualCosts;
      const paybackMonths = netAnnualSavings > 0 ? (totalInvestment / netAnnualSavings) * 12 : Infinity;
      const totalSavings = netAnnualSavings * years - totalInvestment;
      const roiPct = (totalSavings / totalInvestment) * 100;
      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

      document.getElementById('ir-result-payback')!.textContent = paybackMonths === Infinity ? 'Nie' : paybackMonths.toFixed(1);
      document.getElementById('ir-total-invest')!.textContent = fmtEur(totalInvestment);
      document.getElementById('ir-annual-save')!.textContent = fmtEur(annualLaborSavings);
      document.getElementById('ir-net-save')!.textContent = fmtEur(netAnnualSavings);
      document.getElementById('ir-roi')!.textContent = roiPct.toFixed(0) + ' %';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ir-in').forEach(el => { el.addEventListener('input', calcIR); el.addEventListener('change', calcIR); });
      calcIR();
    }, 50);
  </script>
</CalculatorLayout>
