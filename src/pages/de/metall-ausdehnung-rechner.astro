---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Metall-Ausdehnung Rechner - Thermische Längen- und Volumenausdehnung";
const description = "Berechnen Sie thermische Längen- und Volumenausdehnung von Metallen. Ausdehnungskoeffizient für Stahl, Aluminium, Kupfer, Messing und weitere Materialien.";
const relatedCalcs = [
  { name: "Metallgewicht Rechner", url: "/de/metallgewicht-rechner", description: "Metallgewicht berechnen." },
  { name: "Metallermüdung Rechner", url: "/de/metallmuedigkeit-rechner", description: "Schwingspielzahlen." },
  { name: "Metalloberfläche Rechner", url: "/de/metalloberflaeche-rechner", description: "Oberflächenbehandlung." },
  { name: "Mauerwerksanker Rechner", url: "/de/mauerwerksanker-rechner", description: "Ankertragfähigkeiten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="metal-expansion-calculator" calculatorName="Metall-Ausdehnung Rechner" keywords="thermische Ausdehnung Rechner, Längenausdehnung Metall, Ausdehnungskoeffizient, Stahl Ausdehnung, Wärmedehnung berechnen" breadcrumbs={[{ name: "Metall-Ausdehnung Rechner", url: "/de/metall-ausdehnung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Metall-Ausdehnung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die thermische Längen- und Volumenausdehnung von Metallen bei Temperaturänderungen – wichtig für Konstruktion und Maschinenbau.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Material</label>
          <select id="th-mat" class="th-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="11.7" selected>Baustahl (α = 11,7 × 10⁻⁶/K)</option>
            <option value="12">Edelstahl (α = 12 × 10⁻⁶/K)</option>
            <option value="23">Aluminium (α = 23 × 10⁻⁶/K)</option>
            <option value="17">Kupfer (α = 17 × 10⁻⁶/K)</option>
            <option value="19">Messing (α = 19 × 10⁻⁶/K)</option>
            <option value="8.5">Gusseisen (α = 8,5 × 10⁻⁶/K)</option>
            <option value="29">Zink (α = 29 × 10⁻⁶/K)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div id="th-custom-row" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Benutzerdefinierter α-Wert (× 10⁻⁶ /K)</label>
          <input type="number" id="th-alpha-custom" class="th-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" step="0.1" min="0.1">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ausgangslänge (mm)</label><input type="number" id="th-len" class="th-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="0.1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ausgangstemperatur (°C)</label><input type="number" id="th-t1" class="th-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="-273" max="2000"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Endtemperatur (°C)</label><input type="number" id="th-t2" class="th-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="-273" max="2000"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Längenänderung</div>
          <div class="text-5xl font-extrabold font-mono" id="th-dl">--</div>
          <div class="text-sm text-blue-200 mt-1">mm</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Endlänge</div><div class="text-xl font-bold" id="th-lf">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Temperaturdifferenz</div><div class="text-xl font-bold" id="th-dt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Relative Dehnung</div><div class="text-xl font-bold" id="th-eps">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumenausdehnung (rel.)</div><div class="text-xl font-bold" id="th-vol">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Thermische Spannung</div><div class="text-xl font-bold" id="th-stress">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="metall-ausdehnung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Thermische Ausdehnung von Metallen</h2>
      <p>Die thermische Längenausdehnung wird berechnet mit: ΔL = α × L₀ × ΔT, wobei α der lineare Ausdehnungskoeffizient, L₀ die Ausgangslänge und ΔT die Temperaturdifferenz ist. Bei eingespannten Bauteilen entsteht eine thermische Spannung: σ = E × α × ΔT (E = Elastizitätsmodul). Diese Spannungen können zu Verformungen oder Brüchen führen und müssen in der Konstruktion berücksichtigt werden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Warum dehnt sich Metall bei Wärme aus?</strong> Bei steigender Temperatur schwingen die Atome stärker und nehmen mehr Raum ein. Dies führt zur messbaren Ausdehnung des Materials.</p>
      <p><strong>Wie viel dehnt sich ein Meter Stahl bei 80 °C aus?</strong> Ein Meter Baustahl dehnt sich bei 80 K Temperaturdifferenz um ca. 0,94 mm aus (α = 11,7 × 10⁻⁶ /K).</p>
      <p><strong>Wo ist thermische Ausdehnung relevant?</strong> Brücken, Schienen, Rohrleitungen, Maschinenteile und Gebäudekonstruktionen müssen thermische Ausdehnung durch Dehnungsfugen oder flexible Verbindungen berücksichtigen.</p>
      <p><strong>Welches Metall dehnt sich am stärksten aus?</strong> Zink (α ≈ 29 × 10⁻⁶) und Aluminium (α ≈ 23 × 10⁻⁶) dehnen sich deutlich stärker aus als Stahl (α ≈ 11,7 × 10⁻⁶).</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const eModul: Record<string, number> = { '11.7': 210000, '12': 200000, '23': 70000, '17': 120000, '19': 100000, '8.5': 150000, '29': 95000 };
    function calcTH() {
      const matVal = (document.getElementById('th-mat') as HTMLSelectElement).value;
      const isCustom = matVal === 'custom';
      document.getElementById('th-custom-row')!.classList.toggle('hidden', !isCustom);
      const alpha = isCustom
        ? parseFloat((document.getElementById('th-alpha-custom') as HTMLInputElement).value) || 12
        : parseFloat(matVal) || 11.7;
      const L0 = parseFloat((document.getElementById('th-len') as HTMLInputElement).value) || 0;
      const t1 = parseFloat((document.getElementById('th-t1') as HTMLInputElement).value) || 0;
      const t2 = parseFloat((document.getElementById('th-t2') as HTMLInputElement).value) || 0;
      const dT = t2 - t1;
      const dL = alpha * 1e-6 * L0 * dT;
      const Lf = L0 + dL;
      const eps = alpha * 1e-6 * dT;
      const volRel = 3 * alpha * 1e-6 * dT;
      const E = eModul[matVal] || 200000;
      const stress = E * eps;
      const fmt = (v: number, dec = 3) => v.toLocaleString('de-DE', { maximumFractionDigits: dec });
      document.getElementById('th-dl')!.textContent = L0 > 0 ? fmt(dL, 4) : '--';
      document.getElementById('th-lf')!.textContent = L0 > 0 ? fmt(Lf, 3) + ' mm' : '--';
      document.getElementById('th-dt')!.textContent = fmt(dT, 1) + ' K';
      document.getElementById('th-eps')!.textContent = L0 > 0 ? (eps * 1000).toFixed(4).replace('.', ',') + ' mm/m' : '--';
      document.getElementById('th-vol')!.textContent = L0 > 0 ? (volRel * 1000).toFixed(3).replace('.', ',') + ' mm³/m³' : '--';
      document.getElementById('th-stress')!.textContent = L0 > 0 ? fmt(stress, 1) + ' MPa' : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.th-in').forEach(el => { el.addEventListener('input', calcTH); el.addEventListener('change', calcTH); });
      calcTH();
    }, 50);
  </script>
</CalculatorLayout>
