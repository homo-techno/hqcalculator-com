---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Campingausr\u00fcstung-Rechner - Rucksackgewicht planen";
const description = "Berechnen Sie das Rucksackgewicht: Basisgewicht, Verbrauchsmaterial und Gesamtlast f\u00fcr jede Trekkingtour.";
const relatedCalcs = [
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorienverbrauch." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner", description: "Defizit." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "BMI." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlaf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Campingausr\u00fcstung-Rechner" lang="de" enSlug="camping-gear-calculator" keywords="campingausr\u00fcstung rechner, rucksackgewicht, basisgewicht, trekking gewicht, ultraleicht, camping planer" breadcrumbs={[{ name: "Campingausr\u00fcstung", url: "/de/campingausruestung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Campingausr&uuml;stung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihr Rucksackgewicht: Basisgewicht, Verbrauchsmaterial und Gesamtlast f&uuml;r jede Tour.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tourdauer (Tage)</label><input type="number" id="ca2-days" class="ca2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">K&ouml;rpergewicht (kg)</label><input type="number" id="ca2-bw" class="ca2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="40" max="160" step="1"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Basisgewicht (Big 3)</h3>
          <div class="grid grid-cols-3 gap-2">
            <div><label class="block text-xs text-text-muted">Zelt (kg)</label><input type="number" id="ca2-shelter" class="ca2-in w-full px-3 py-2 border border-border rounded-xl text-sm font-bold text-center" min="0" max="7" step="0.1"></div>
            <div><label class="block text-xs text-text-muted">Schlafsystem (kg)</label><input type="number" id="ca2-sleep" class="ca2-in w-full px-3 py-2 border border-border rounded-xl text-sm font-bold text-center" min="0" max="7" step="0.1"></div>
            <div><label class="block text-xs text-text-muted">Rucksack (kg)</label><input type="number" id="ca2-pack" class="ca2-in w-full px-3 py-2 border border-border rounded-xl text-sm font-bold text-center" min="0" max="5" step="0.1"></div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Sonstiges Basisgewicht</h3>
          <div class="grid grid-cols-3 gap-2">
            <div><label class="block text-xs text-text-muted">Kochen (kg)</label><input type="number" id="ca2-cook" class="ca2-in w-full px-3 py-2 border border-border rounded-xl text-sm font-bold text-center" min="0" max="5" step="0.1"></div>
            <div><label class="block text-xs text-text-muted">Kleidung (kg)</label><input type="number" id="ca2-cloth" class="ca2-in w-full px-3 py-2 border border-border rounded-xl text-sm font-bold text-center" min="0" max="7" step="0.1"></div>
            <div><label class="block text-xs text-text-muted">Sonstiges (kg)</label><input type="number" id="ca2-other" class="ca2-in w-full px-3 py-2 border border-border rounded-xl text-sm font-bold text-center" min="0" max="7" step="0.1"></div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Nahrung (kg/Tag)</label><input type="number" id="ca2-food" class="ca2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.3" max="2.5" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wasser (Liter)</label><input type="number" id="ca2-water" class="ca2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="10" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtgewicht (Tag 1)</div>
          <div class="text-5xl font-extrabold font-mono" id="ca2-total">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Basisgewicht</div><div class="text-xl font-bold font-mono" id="ca2-base">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbrauchsmaterial</div><div class="text-xl font-bold font-mono" id="ca2-consumable">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">% K&ouml;rpergewicht</div><div class="text-xl font-bold font-mono" id="ca2-pct">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Komfort-Bewertung</div><div class="text-xl font-bold" id="ca2-comfort">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kategorie</div><div class="text-xl font-bold" id="ca2-cat">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Gewicht nach Tag</h3>
          <div class="text-xs space-y-1 max-h-48 overflow-y-auto" id="ca2-daily"></div>
        </div>
      </div>
      <ShareButton calculatorId="camping-gear" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Was ist ein gutes Basisgewicht?</h3>
      <p>Unter 4,5 kg gilt als ultraleicht, 4,5-7 kg als leicht, 7-9 kg als traditionell. &Uuml;ber 13 kg wird es anstrengend.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcCA2() {
      const days = parseInt((document.getElementById('ca2-days') as HTMLInputElement).value) || 1;
      const bw = parseFloat((document.getElementById('ca2-bw') as HTMLInputElement).value) || 0;
      const shelter = parseFloat((document.getElementById('ca2-shelter') as HTMLInputElement).value) || 0;
      const sleep = parseFloat((document.getElementById('ca2-sleep') as HTMLInputElement).value) || 0;
      const pack = parseFloat((document.getElementById('ca2-pack') as HTMLInputElement).value) || 0;
      const cook = parseFloat((document.getElementById('ca2-cook') as HTMLInputElement).value) || 0;
      const cloth = parseFloat((document.getElementById('ca2-cloth') as HTMLInputElement).value) || 0;
      const other = parseFloat((document.getElementById('ca2-other') as HTMLInputElement).value) || 0;
      const foodPerDay = parseFloat((document.getElementById('ca2-food') as HTMLInputElement).value) || 0;
      const waterL = parseFloat((document.getElementById('ca2-water') as HTMLInputElement).value) || 0;
      const baseWeight = shelter + sleep + pack + cook + cloth + other;
      const waterKg = waterL;
      const totalFood = foodPerDay * days;
      const consumables = totalFood + waterKg;
      const totalDay1 = baseWeight + consumables;
      const pctBW = bw > 0 ? (totalDay1 / bw) * 100 : 0;
      let comfort = '';
      let category = '';
      if (baseWeight < 4.5) { category = 'Ultraleicht'; comfort = 'Exzellent'; }
      else if (baseWeight < 7) { category = 'Leicht'; comfort = 'Sehr gut'; }
      else if (baseWeight < 9) { category = 'Traditionell'; comfort = 'Gut'; }
      else if (baseWeight < 13.5) { category = 'Schwer'; comfort = 'Moderat'; }
      else { category = 'Sehr schwer'; comfort = 'Anstrengend'; }
      if (pctBW > 30) comfort = 'Sehr anstrengend';
      else if (pctBW > 25) comfort = 'Herausfordernd';
      const fmt = (v: number) => v.toFixed(1).replace('.', ',');
      document.getElementById('ca2-total')!.textContent = fmt(totalDay1) + ' kg';
      document.getElementById('ca2-base')!.textContent = fmt(baseWeight) + ' kg';
      document.getElementById('ca2-consumable')!.textContent = fmt(consumables) + ' kg';
      document.getElementById('ca2-pct')!.textContent = fmt(pctBW) + '%';
      document.getElementById('ca2-comfort')!.textContent = comfort;
      document.getElementById('ca2-cat')!.textContent = category;
      const dailyHTML: string[] = [];
      dailyHTML.push('<div class="flex justify-between font-semibold text-text-muted mb-1"><span>Tag</span><span>Nahrung \u00fcbrig</span><span>Gesamtgewicht</span></div>');
      for (let d = 1; d <= days; d++) {
        const foodRemaining = foodPerDay * (days - d + 1);
        const dayTotal = baseWeight + foodRemaining + waterKg;
        const highlight = d === 1 ? 'font-bold text-primary' : '';
        dailyHTML.push('<div class="flex justify-between ' + highlight + '"><span>Tag ' + d + '</span><span class="font-mono">' + fmt(foodRemaining) + ' kg</span><span class="font-mono font-bold">' + fmt(dayTotal) + ' kg</span></div>');
      }
      document.getElementById('ca2-daily')!.innerHTML = dailyHTML.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ca2-days') as HTMLInputElement).value = '3';
      (document.getElementById('ca2-bw') as HTMLInputElement).value = '77';
      (document.getElementById('ca2-shelter') as HTMLInputElement).value = '1.6';
      (document.getElementById('ca2-sleep') as HTMLInputElement).value = '1.4';
      (document.getElementById('ca2-pack') as HTMLInputElement).value = '1.1';
      (document.getElementById('ca2-cook') as HTMLInputElement).value = '0.5';
      (document.getElementById('ca2-cloth') as HTMLInputElement).value = '1.1';
      (document.getElementById('ca2-other') as HTMLInputElement).value = '0.7';
      (document.getElementById('ca2-food') as HTMLInputElement).value = '0.9';
      (document.getElementById('ca2-water') as HTMLInputElement).value = '2';
      document.querySelectorAll('.ca2-in').forEach(el => { el.addEventListener('input', calcCA2); el.addEventListener('change', calcCA2); });
      calcCA2();
    }, 50);
  </script>
</CalculatorLayout>
