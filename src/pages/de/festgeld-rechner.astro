---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Festgeld-Rechner – Zinsen & Ertrag berechnen";
const description = "Berechnen Sie die Zinserträge Ihrer Festgeldanlage. Vergleichen Sie Laufzeiten und sehen Sie, wie viel Ihr Festgeld am Ende wert ist.";
const relatedCalcs = [
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
  { name: "Eigenkapitalrendite-Rechner", url: "/de/eigenkapitalrendite-rechner", description: "Rendite." },
  { name: "Cashback-Rechner", url: "/de/cashback-rechner", description: "Cashback." },
  { name: "CO₂-Steuer-Rechner", url: "/de/co2-steuer-rechner", description: "CO₂-Steuer." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Festgeld-Rechner" enSlug="cd-calculator" keywords="Festgeld Rechner, Festgeldzinsen, Termineinlage, Festgeld Vergleich, Zinsrechner, Sparzinsen" breadcrumbs={[{ name: "Festgeld-Rechner", url: "/de/festgeld-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Festgeld-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie viel Ihr Festgeld am Ende der Laufzeit einbringt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="space-y-4">
            <div><label class="block text-sm font-medium text-text mb-1">Anlagebetrag</label><div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">€</span><input type="number" id="fgr-deposit" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="500"></div></div>
            <div><label class="block text-xs font-medium text-text mb-1">Jahreszins (%)</label><div class="flex gap-2"><input type="number" id="fgr-apy" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg" min="0" max="20" step="0.05"><span class="self-center font-semibold text-text-muted">%</span></div></div>
            <div><label class="block text-xs font-medium text-text mb-1">Laufzeit</label><select id="fgr-term" class="w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="3">3 Monate</option><option value="6">6 Monate</option><option value="12" selected>12 Monate (1 Jahr)</option><option value="18">18 Monate</option><option value="24">24 Monate (2 Jahre)</option><option value="36">36 Monate (3 Jahre)</option><option value="48">48 Monate (4 Jahre)</option><option value="60">60 Monate (5 Jahre)</option></select></div>
            <div><label class="block text-xs font-medium text-text mb-1">Zinseszins</label><select id="fgr-compound" class="w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="365">Täglich</option><option value="12" selected>Monatlich</option><option value="4">Quartalsweise</option><option value="2">Halbjährlich</option><option value="1">Jährlich</option></select></div>
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Endbetrag</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="fgr-total">0 €</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zinsertrag</div><div class="text-xl font-bold text-secondary" id="fgr-interest">0 €</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effektiver Zinssatz</div><div class="text-xl font-bold" id="fgr-effective">0%</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Zinsen (Durchschn.)</div><div class="text-xl font-bold" id="fgr-monthly-int">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Laufzeitvergleich</h3>
            <div class="space-y-1 text-sm" id="fgr-comparison"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cd" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Festgeld verstehen</h2>
      <p>Festgeld (Termineinlage) ist ein Sparprodukt mit festem Zinssatz für eine bestimmte Laufzeit. Im Gegenzug für die Bindung Ihres Kapitals erhalten Sie einen höheren Zinssatz als auf einem Tagesgeldkonto.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was passiert bei vorzeitiger Kündigung?</strong> Die meisten Banken erheben eine Vorfälligkeitsentschädigung, typischerweise 3-6 Monatszinsen.</p>
      <p><strong>Ist Festgeld sicher?</strong> Ja, Festgeld ist in Deutschland bis 100.000 € pro Bank durch die gesetzliche Einlagensicherung geschützt.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const fmtEUR = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    function calcFGR() {
      const deposit = parseFloat((document.getElementById('fgr-deposit') as HTMLInputElement).value) || 0;
      const apy = (parseFloat((document.getElementById('fgr-apy') as HTMLInputElement).value) || 0) / 100;
      const termMonths = parseInt((document.getElementById('fgr-term') as HTMLSelectElement).value) || 12;
      const compPerYear = parseInt((document.getElementById('fgr-compound') as HTMLSelectElement).value) || 12;
      const years = termMonths / 12;
      const total = deposit * Math.pow(1 + apy / compPerYear, compPerYear * years);
      const interest = total - deposit;
      document.getElementById('fgr-total')!.textContent = fmtEUR(total);
      document.getElementById('fgr-interest')!.textContent = fmtEUR(interest);
      document.getElementById('fgr-effective')!.textContent = (apy * 100).toFixed(2) + '%';
      document.getElementById('fgr-monthly-int')!.textContent = fmtEUR(interest / termMonths);
      const terms = [3, 6, 12, 24, 36, 60];
      document.getElementById('fgr-comparison')!.innerHTML =
        '<div class="grid grid-cols-3 gap-2 font-semibold text-xs text-text-muted mb-1"><span>Laufzeit</span><span>Zinsen</span><span>Endbetrag</span></div>' +
        terms.map(t => {
          const y = t / 12;
          const tot = deposit * Math.pow(1 + apy / compPerYear, compPerYear * y);
          const int = tot - deposit;
          const isCurrent = t === termMonths;
          return '<div class="grid grid-cols-3 gap-2 text-xs ' + (isCurrent ? 'font-bold text-primary' : '') + '"><span>' + t + ' Mo.</span><span>' + fmtEUR(int) + '</span><span>' + fmtEUR(tot) + '</span></div>';
        }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('fgr-deposit') as HTMLInputElement).value = '10000';
      (document.getElementById('fgr-apy') as HTMLInputElement).value = '3.5';
      ['fgr-deposit', 'fgr-apy'].forEach(id => document.getElementById(id)!.addEventListener('input', calcFGR));
      ['fgr-term', 'fgr-compound'].forEach(id => document.getElementById(id)!.addEventListener('change', calcFGR));
      calcFGR();
    }, 50);
  </script>
</CalculatorLayout>
