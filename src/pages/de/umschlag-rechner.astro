---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Umschlag-Rechner - Gr\u00f6\u00dfen, Porto & Druckfl\u00e4che";
const description = "Berechnen Sie Umschlaggr\u00f6\u00dfen, Briefgewicht, Portokosten und bedruckbare Fl\u00e4che f\u00fcr Standard- und Sonderumschl\u00e4ge.";
const relatedCalcs = [
  { name: "Epoxidharz-Rechner", url: "/de/epoxidharz-rechner", description: "Epoxid-Mischung." },
  { name: "Stickgarn-Rechner", url: "/de/stickgarn-rechner", description: "Stickgarnbedarf." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
  { name: "Ergonomischer Schreibtisch", url: "/de/ergonomischer-schreibtisch-rechner", description: "Schreibtischh\u00f6he." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Umschlag-Rechner" lang="de" enSlug="envelope-calculator" keywords="umschlag rechner, briefumschlag gr\u00f6\u00dfe, porto berechnen, briefgewicht, druckfl\u00e4che umschlag" breadcrumbs={[{ name: "Umschlag-Rechner", url: "/de/umschlag-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Umschlag-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Umschlaggr&ouml;&szlig;en nachschlagen, Gesamtgewicht berechnen und Portokosten ermitteln.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Umschlaggr&ouml;&szlig;e</label>
          <select id="umr-size" class="umr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="220x110">DL (220 x 110 mm) - Standard</option>
            <option value="162x114">C6 (162 x 114 mm)</option>
            <option value="229x162">C5 (229 x 162 mm)</option>
            <option value="324x229">C4 (324 x 229 mm)</option>
            <option value="353x250">B4 (353 x 250 mm)</option>
            <option value="custom">Eigene Gr&ouml;&szlig;e</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Breite (mm)</label><input type="number" id="umr-width" class="umr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="50" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">H&ouml;he (mm)</label><input type="number" id="umr-height" class="umr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="50" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Seiten im Umschlag</label><input type="number" id="umr-pages" class="umr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Papiergewicht (g/m&sup2;)</label><input type="number" id="umr-gsm" class="umr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Papierformat</label>
          <select id="umr-paper" class="umr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="a4" selected>A4 (210 x 297 mm)</option>
            <option value="a5">A5 (148 x 210 mm)</option>
            <option value="letter">Letter (216 x 279 mm)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtgewicht</div>
          <div class="text-5xl font-extrabold font-mono" id="umr-result">0 g</div>
          <div class="text-sm text-blue-200 mt-1" id="umr-postage"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umschlaggewicht</div><div class="text-xl font-bold" id="umr-envwt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Inhalt-Gewicht</div><div class="text-xl font-bold" id="umr-contwt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Druckfl&auml;che</div><div class="text-xl font-bold" id="umr-printarea">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Porto-Klasse</div><div class="text-xl font-bold" id="umr-class">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="envelope-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Umschlaggr&ouml;&szlig;en & Porto-Leitfaden</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>DL-Umschlag: 220 x 110 mm (Standard-Gesch&auml;ftsbrief)</p>
        <p>Standardbrief: max. 235 x 125 mm, 5 mm dick, 20 g</p>
        <p>Kompaktbrief: max. 235 x 125 mm, 10 mm dick, 50 g</p>
        <p>Gro&szlig;brief: max. 353 x 250 mm, 20 mm dick, 500 g</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welcher Umschlag f&uuml;r A4?</strong> F&uuml;r ungefaltete A4-Bl&auml;tter ben&ouml;tigen Sie einen C4-Umschlag. F&uuml;r einmal gefaltetes A4 einen C5 oder DL-Umschlag.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcUMR() {
      const sizeVal = (document.getElementById('umr-size') as HTMLSelectElement).value;
      if (sizeVal !== 'custom') {
        const parts = sizeVal.split('x');
        (document.getElementById('umr-width') as HTMLInputElement).value = parts[0];
        (document.getElementById('umr-height') as HTMLInputElement).value = parts[1];
      }
      const envW = parseFloat((document.getElementById('umr-width') as HTMLInputElement).value) || 0;
      const envH = parseFloat((document.getElementById('umr-height') as HTMLInputElement).value) || 0;
      const pages = parseFloat((document.getElementById('umr-pages') as HTMLInputElement).value) || 0;
      const gsm = parseFloat((document.getElementById('umr-gsm') as HTMLInputElement).value) || 80;
      const paperSize = (document.getElementById('umr-paper') as HTMLSelectElement).value;
      const paperDims: Record<string, [number, number]> = {
        a4: [210, 297], a5: [148, 210], letter: [216, 279]
      };
      const pd = paperDims[paperSize] || [210, 297];
      const paperAreaM2 = (pd[0] / 1000) * (pd[1] / 1000);
      const paperWeightG = paperAreaM2 * gsm;
      const contentsWeightG = paperWeightG * pages;
      const envAreaM2 = (envW / 1000) * (envH / 1000) * 2;
      const envWeightG = envAreaM2 * 90 + 2;
      const totalWeightG = envWeightG + contentsWeightG;
      const printMarginMm = 5;
      const printW = envW - 2 * printMarginMm;
      const printH = envH - 2 * printMarginMm;
      let mailClass = 'Standardbrief';
      let postageEst = 0.85;
      if (totalWeightG > 20 && totalWeightG <= 50) { mailClass = 'Kompaktbrief'; postageEst = 1.00; }
      else if (totalWeightG > 50 && totalWeightG <= 500) { mailClass = 'Gro\u00DFbrief'; postageEst = 1.60; }
      else if (totalWeightG > 500) { mailClass = 'Maxibrief'; postageEst = 2.75; }
      document.getElementById('umr-result')!.textContent = totalWeightG.toFixed(1) + ' g';
      document.getElementById('umr-postage')!.textContent = 'Gesch. Porto: ~' + postageEst.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' \u20AC (' + mailClass + ')';
      document.getElementById('umr-envwt')!.textContent = envWeightG.toFixed(1) + ' g';
      document.getElementById('umr-contwt')!.textContent = contentsWeightG.toFixed(1) + ' g';
      document.getElementById('umr-printarea')!.textContent = printW.toFixed(0) + ' x ' + printH.toFixed(0) + ' mm';
      document.getElementById('umr-class')!.textContent = mailClass;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('umr-width') as HTMLInputElement).value = '220';
      (document.getElementById('umr-height') as HTMLInputElement).value = '110';
      (document.getElementById('umr-pages') as HTMLInputElement).value = '3';
      (document.getElementById('umr-gsm') as HTMLInputElement).value = '80';
      document.querySelectorAll('.umr-in').forEach(el => { el.addEventListener('input', calcUMR); el.addEventListener('change', calcUMR); });
      calcUMR();
    }, 50);
  </script>
</CalculatorLayout>
