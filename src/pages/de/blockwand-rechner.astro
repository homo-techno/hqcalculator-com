---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Blockwandrechner - Hohlblockstein-Bedarf, Mörtel & Füllung";
const description = "Berechnen Sie Hohlblockstein-Bedarf, Mörtelbedarf und Vergussfüllung für Blockwände. Unterstützt 10, 15, 20, 25 und 30 cm Blöcke.";

const relatedCalcs = [
  { name: "Ziegelrechner", url: "/de/ziegel-rechner", description: "Ziegelmengen-Rechner." },
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Mörtelrechner", url: "/de/moertel-rechner", description: "Mörtelbedarf." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Blockwandrechner"
  lang="de"
  keywords="blockwand rechner, hohlblockstein, betonstein, mörtel berechnen, blockfüllung, verguss"
  breadcrumbs={[{ name: "Blockwandrechner", url: "/de/blockwand-rechner" }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blockwandrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Blockstein-Bedarf, Mörtel und Vergussfüllung für Betonstein-Wände.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-2">Wandlänge (ft)</label>
            <input type="number" id="bwl-length" class="bwl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="1" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-2">Wandhöhe (ft)</label>
            <input type="number" id="bwl-height" class="bwl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" step="0.5">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-2">Blockgröße</label>
          <select id="bwl-size" class="bwl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="4">4" Hohlblock (3,625 x 7,625 x 15,625)</option>
            <option value="6">6" Hohlblock (5,625 x 7,625 x 15,625)</option>
            <option value="8" selected>8" Hohlblock (7,625 x 7,625 x 15,625)</option>
            <option value="10">10" Hohlblock (9,625 x 7,625 x 15,625)</option>
            <option value="12">12" Hohlblock (11,625 x 7,625 x 15,625)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-2">Füllungsoption</label>
          <select id="bwl-fill" class="bwl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="none">Keine Füllung (Hohlraum)</option>
            <option value="partial" selected>Teilfüllung (nur Bewehrungszellen, alle 48")</option>
            <option value="full">Vollverguss (alle Zellen)</option>
          </select>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Verschnittfaktor (%)</label>
              <input type="number" id="bwl-waste" class="bwl-in w-full px-3 py-2 border border-border rounded-lg" value="5" min="0" max="20" step="1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Fugendicke (Zoll)</label>
              <input type="number" id="bwl-joint" class="bwl-in w-full px-3 py-2 border border-border rounded-lg" value="0.375" min="0.25" max="0.75" step="0.125">
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Blöcke</div>
          <div class="text-4xl font-extrabold" id="bwl-blocks">0</div>
          <div class="text-sm text-blue-200 mt-1">inkl. <span id="bwl-waste-pct">5</span>% Verschnitt</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mörtel (36-kg-Säcke)</div>
            <div class="text-xl font-bold" id="bwl-mortar">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Vergussfüllung</div>
            <div class="text-xl font-bold" id="bwl-grout">0 cu ft</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wandfläche</div>
            <div class="text-xl font-bold" id="bwl-area">0 sq ft</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Schichten hoch</div>
            <div class="text-xl font-bold" id="bwl-courses">0</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Geschätztes Wandgewicht</div>
          <div class="text-xl font-bold" id="bwl-weight">0 lbs</div>
        </div>
      </div>

      <ShareButton calculatorId="block-wall" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Grundlagen Hohlblockstein-Wände</h2>
      <ul>
        <li><strong>Standard-Hohlblockstein:</strong> 8x8x16 Nennmaß (7,625x7,625x15,625 tatsächlich)</li>
        <li>1,125 Blöcke pro Quadratfuß Wandfläche (mit 3/8"-Fugen)</li>
        <li>Mörtel: ca. 8,5 Säcke pro 100 Blöcke für 3/8"-Lager- und Stoßfugen</li>
        <li>Vollverguss: ca. 0,025 cu ft pro Zelle bei 8"-Block</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const bwlBlockData: Record<string, { depth: number; cellVol: number; weight: number }> = {
      '4':  { depth: 3.625, cellVol: 0.009, weight: 26 },
      '6':  { depth: 5.625, cellVol: 0.017, weight: 33 },
      '8':  { depth: 7.625, cellVol: 0.025, weight: 38 },
      '10': { depth: 9.625, cellVol: 0.034, weight: 43 },
      '12': { depth: 11.625, cellVol: 0.044, weight: 55 },
    };

    function calcBWL() {
      const wallL = parseFloat((document.getElementById('bwl-length') as HTMLInputElement).value) || 0;
      const wallH = parseFloat((document.getElementById('bwl-height') as HTMLInputElement).value) || 0;
      const blockSize = (document.getElementById('bwl-size') as HTMLSelectElement).value;
      const fillOpt = (document.getElementById('bwl-fill') as HTMLSelectElement).value;
      const waste = (parseFloat((document.getElementById('bwl-waste') as HTMLInputElement).value) || 0) / 100;
      const joint = parseFloat((document.getElementById('bwl-joint') as HTMLInputElement).value) || 0.375;

      const block = bwlBlockData[blockSize] || bwlBlockData['8'];
      const area = wallL * wallH;

      const courseH = (7.625 + joint) / 12;
      const unitL = (15.625 + joint) / 12;

      const courses = Math.ceil(wallH / courseH);
      const blocksPerCourse = Math.ceil(wallL / unitL);
      const totalBlocks = Math.ceil(courses * blocksPerCourse * (1 + waste));

      const mortarBags = Math.ceil(totalBlocks * 0.085);

      let groutCuFt = 0;
      const cellsPerBlock = 2;
      if (fillOpt === 'full') {
        groutCuFt = totalBlocks * cellsPerBlock * block.cellVol;
      } else if (fillOpt === 'partial') {
        const filledCols = Math.ceil(wallL / 4) + 1;
        groutCuFt = filledCols * courses * block.cellVol * cellsPerBlock;
      }

      const wallWeight = totalBlocks * block.weight + groutCuFt * 140;

      document.getElementById('bwl-blocks')!.textContent = totalBlocks.toLocaleString('de-DE');
      document.getElementById('bwl-waste-pct')!.textContent = String(Math.round(waste * 100));
      document.getElementById('bwl-mortar')!.textContent = String(mortarBags);
      document.getElementById('bwl-grout')!.textContent = groutCuFt.toFixed(1) + ' cu ft';
      document.getElementById('bwl-area')!.textContent = Math.round(area) + ' sq ft';
      document.getElementById('bwl-courses')!.textContent = String(courses);
      document.getElementById('bwl-weight')!.textContent = Math.round(wallWeight).toLocaleString('de-DE') + ' lbs';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bwl-in').forEach(el => {
        el.addEventListener('input', calcBWL);
        el.addEventListener('change', calcBWL);
      });
      calcBWL();
    }, 50);
  </script>
</CalculatorLayout>
