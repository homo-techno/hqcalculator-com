---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Stundenlohn vs Gehalt Rechner - Was zahlt sich mehr aus? 2026";
const description = "Vergleiche Stundenlohn- und Gehaltsangebote inklusive Sozialleistungen, um festzustellen, welche Stelle sich mehr lohnt. Effektiver Stundensatz.";

const relatedCalcs = [
  { name: "Stundenlohn-zu-Gehalt-Rechner", url: "/de/stundenlohn-zu-gehalt-rechner", description: "Lohnumrechnung." },
  { name: "Stunden-Rechner", url: "/de/stunden-rechner", description: "Arbeitsstunden." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "Steuerrechner", url: "/de/steuerrechner", description: "Steuern berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Stundenlohn-vs-Gehalt-Rechner" keywords="Stundenlohn vs Gehalt, Gesamtverguetung Vergleich, effektiver Stundensatz, Sozialleistungen Wert, Gehaltsvergleich Deutschland" breadcrumbs={[{ name: "Stundenlohn-vs-Gehalt-Rechner", url: "/de/stundenlohn-vs-gehalt-rechner" }]} lang="de" enSlug="hourly-vs-salary-comparison">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stundenlohn-vs-Gehalt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleiche die Gesamtverguetung von Stundenlohn- und Gehaltsstellen inklusive Sozialleistungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="font-semibold text-text text-lg border-b pb-2">Stundenlohnstelle</h3>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Stundenlohn</label>
            <div class="relative">
              <input type="number" id="svg-hourly" class="w-full pl-4 pr-8 py-3 border border-border rounded-xl text-2xl font-bold" value="22" min="0" step="0.5">
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">€</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Stunden pro Woche</label>
            <input type="number" id="svg-hours" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="40" min="0" max="80" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ueberstunden pro Woche (Durchschnitt)</label>
            <input type="number" id="svg-overtime" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="0" max="40" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Sozialleistungen Stundenlohn (€/Jahr)</label>
            <input type="number" id="svg-hourly-benefits" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="1500" min="0" step="500">
          </div>

          <h3 class="font-semibold text-text text-lg border-b pb-2 pt-2">Gehaltsstelle</h3>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jahresgehalt (Brutto)</label>
            <div class="relative">
              <input type="number" id="svg-salary" class="w-full pl-4 pr-8 py-3 border border-border rounded-xl text-lg" value="50000" min="0" step="1000">
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted">€</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tatsaechliche Wochenstunden</label>
            <input type="number" id="svg-salary-hours" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="45" min="0" max="80" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Sozialleistungen Gehalt (€/Jahr, inkl. VWL, Zuschuss KV etc.)</label>
            <input type="number" id="svg-salary-benefits" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="6000" min="0" step="500">
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Bessere Option</div>
            <div class="text-4xl font-extrabold font-mono" id="svg-winner">--</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stundenlohn Gesamt</div><div class="text-xl font-bold text-blue-600" id="svg-hourly-total">0 €/Jahr</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gehalt Gesamt</div><div class="text-xl font-bold text-purple-600" id="svg-salary-total">0 €/Jahr</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eff. Std.-Satz (St.lohn)</div><div class="text-xl font-bold" id="svg-hourly-eff">0 €/h</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eff. Std.-Satz (Gehalt)</div><div class="text-xl font-bold" id="svg-salary-eff">0 €/h</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Unterschied</div><div class="text-xl font-bold" id="svg-difference">0 €/Jahr</div></div>
        </div>
      </div>

      <ShareButton calculatorId="hourly-vs-salary" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Stundenlohn vs. Gehalt – worauf kommt es an?</h2>
      <p>Ein einfacher Gehaltsvergleich vernachlaessigt wichtige Faktoren. Stundenlohnkraefte erhalten oft Ueberstundenzuschlag (25-50 %), waehrend Gehaltsempfaenger Mehrarbeit oft unbezahlt leisten. Sozialleistungen wie betriebliche Altersvorsorge, Krankengeldzuschuss oder Jobticket koennen 20-40 % des Gehalts ausmachen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Nichtfinanzielle Faktoren beachten</h3>
      <p>Gehaltsstellen bieten oft mehr Arbeitsplatzsicherheit, Karriereperspektiven und umfangreichere Sozialleistungen. Stundenlohnstellen ermöglichen oft mehr Flexibilitaet, klare Arbeitszeitgrenzen und Verguetung jeder geleisteten Stunde.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSVG() {
      const hourlyRate = parseFloat((document.getElementById('svg-hourly') as HTMLInputElement).value) || 0;
      const hoursPerWeek = parseFloat((document.getElementById('svg-hours') as HTMLInputElement).value) || 0;
      const overtimeHours = parseFloat((document.getElementById('svg-overtime') as HTMLInputElement).value) || 0;
      const hourlyBenefits = parseFloat((document.getElementById('svg-hourly-benefits') as HTMLInputElement).value) || 0;
      const salary = parseFloat((document.getElementById('svg-salary') as HTMLInputElement).value) || 0;
      const salaryHours = parseFloat((document.getElementById('svg-salary-hours') as HTMLInputElement).value) || 0;
      const salaryBenefits = parseFloat((document.getElementById('svg-salary-benefits') as HTMLInputElement).value) || 0;

      const weeksPerYear = 52;
      const hourlyAnnualBase = hourlyRate * hoursPerWeek * weeksPerYear;
      const hourlyOvertime = hourlyRate * 1.25 * overtimeHours * weeksPerYear;
      const hourlyTotalComp = hourlyAnnualBase + hourlyOvertime + hourlyBenefits;
      const hourlyTotalHours = (hoursPerWeek + overtimeHours) * weeksPerYear;
      const hourlyEffRate = hourlyTotalHours > 0 ? hourlyTotalComp / hourlyTotalHours : 0;

      const salaryTotalComp = salary + salaryBenefits;
      const salaryTotalHours = salaryHours * weeksPerYear;
      const salaryEffRate = salaryTotalHours > 0 ? salaryTotalComp / salaryTotalHours : 0;

      const difference = hourlyTotalComp - salaryTotalComp;
      let winner = 'Gleichwertig';
      if (Math.abs(difference) < 500) winner = 'In etwa gleich';
      else if (difference > 0) winner = 'Stundenlohn besser';
      else winner = 'Gehalt besser';

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' €';
      document.getElementById('svg-winner')!.textContent = winner;
      document.getElementById('svg-hourly-total')!.textContent = fmt(hourlyTotalComp) + '/Jahr';
      document.getElementById('svg-salary-total')!.textContent = fmt(salaryTotalComp) + '/Jahr';
      document.getElementById('svg-hourly-eff')!.textContent = hourlyEffRate.toFixed(2).replace('.', ',') + ' €/h';
      document.getElementById('svg-salary-eff')!.textContent = salaryEffRate.toFixed(2).replace('.', ',') + ' €/h';
      document.getElementById('svg-difference')!.textContent = fmt(Math.abs(difference)) + '/Jahr ' + (difference > 0 ? '(Stundenlohn hoeher)' : difference < 0 ? '(Gehalt hoeher)' : '');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['svg-hourly', 'svg-hours', 'svg-overtime', 'svg-hourly-benefits', 'svg-salary', 'svg-salary-hours', 'svg-salary-benefits'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcSVG); el.addEventListener('change', calcSVG); }
      });
      calcSVG();
    }, 50);
  </script>
</CalculatorLayout>
