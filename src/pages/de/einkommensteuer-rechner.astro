---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Einkommensteuer-Rechner - Deutsche Lohnsteuer 2025/2026";
const description = "Schätzen Sie Ihre deutsche Einkommensteuer für 2025 und 2026. Berechnen Sie Steuersätze, effektiven Steuersatz und Nettoeinkommen nach Steuerklassen.";
const relatedCalcs = [
  { name: "Gehaltsrechner", url: "/salary-calculator", description: "Gehaltsaufschlüsselung." },
  { name: "Lohnrechner", url: "/paycheck-calculator", description: "Nettolohn berechnen." },
  { name: "Sparzinsrechner", url: "/savings-calculator", description: "Sparwachstum." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlageerträge." },
  { name: "Rentenrechner", url: "/retirement-calculator", description: "Altersvorsorge." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie hoch ist die deutsche Einkommensteuer?",
      "acceptedAnswer": { "@type": "Answer", "text": "In Deutschland beträgt die Einkommensteuer 0 % bis 45 %. Der Grundfreibetrag 2025 beträgt 12.096 €. Darüber beginnt die progressive Besteuerung mit 14 %, der Spitzensteuersatz von 42 % gilt ab ca. 68.430 €, der Reichensteuersatz von 45 % ab 277.826 €." }
    },
    {
      "@type": "Question",
      "name": "Was ist der Unterschied zwischen Grenz- und Durchschnittssteuersatz?",
      "acceptedAnswer": { "@type": "Answer", "text": "Der Grenzsteuersatz ist der Steuersatz, den Sie auf den letzten verdienten Euro zahlen. Der Durchschnittssteuersatz ist die tatsächliche Steuer geteilt durch das Gesamteinkommen – immer niedriger als der Grenzsteuersatz." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Einkommensteuer-Rechner" lang="de" keywords="einkommensteuer rechner, lohnsteuer, steuersätze, steuerschätzer, effektiver steuersatz, 2025 steuer, 2026 steuer" breadcrumbs={[{ name: "Einkommensteuer-Rechner", url: "/de/einkommensteuer-rechner" }]} enSlug="income-tax-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Einkommensteuer-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Ihre deutsche Einkommensteuer basierend auf Steuerklasse, Einkommen und Absetzbeträgen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Steuerjahr</label>
            <div class="flex gap-2">
              <button class="est-year-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-primary text-white" data-year="2025">2025</button>
              <button class="est-year-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary" data-year="2026">2026</button>
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Steuerklasse</label>
            <select id="est-status" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1">Klasse I (ledig, verwitwet)</option>
              <option value="3">Klasse III (verheiratet, höheres Einkommen)</option>
              <option value="4">Klasse IV (verheiratet, ähnliches Einkommen)</option>
              <option value="5">Klasse V (verheiratet, geringeres Einkommen)</option>
            </select>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Jährliches Bruttoeinkommen</label>
            <div class="relative">
              <input type="number" id="est-income" class="w-full px-4 pr-10 py-3 border border-border rounded-xl text-2xl font-bold" value="50000" min="0" step="1000">
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">€</span>
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Werbungskosten / Sonderausgaben (€)</label>
            <input type="number" id="est-deduction" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="0" min="0" step="100">
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Kirchensteuer?</label>
            <select id="est-church" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="0" selected>Nein</option>
              <option value="0.09">Ja (9 % in den meisten Bundesländern)</option>
              <option value="0.08">Ja (8 % in Bayern/Baden-Württemberg)</option>
            </select>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Einkommensteuer</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="est-total">0 €</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Effektiver Steuersatz</div>
              <div class="text-xl font-bold" id="est-effective">0 %</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Grenzsteuersatz</div>
              <div class="text-xl font-bold" id="est-marginal">0 %</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Nettoeinkommen</div>
              <div class="text-xl font-bold text-secondary" id="est-after">0 €</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Monatlich netto</div>
              <div class="text-xl font-bold" id="est-monthly">0 €</div>
            </div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Steueraufschlüsselung</h3>
            <div id="est-brackets" class="space-y-2 text-sm"></div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="einkommensteuer" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie die deutsche Einkommensteuer funktioniert</h2>
      <p>Deutschland verwendet ein progressives Steuersystem. Der Grundfreibetrag 2025 beträgt 12.096 €. Darüber steigt der Steuersatz progressiv von 14 % auf 45 % beim Reichensteuersatz ab 277.826 €. Hinzu kommen Solidaritätszuschlag (für hohe Einkommen) und ggf. Kirchensteuer.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie hoch ist die deutsche Einkommensteuer?</h4>
      <p>Der Grundfreibetrag 2025 beträgt 12.096 €. Darüber beginnt die progressive Besteuerung mit 14 %, der Spitzensteuersatz von 42 % gilt ab ca. 68.430 €.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Was ist der Unterschied zwischen Grenz- und Durchschnittssteuersatz?</h4>
      <p>Der Grenzsteuersatz ist der Steuersatz auf den letzten verdienten Euro. Der Durchschnittssteuersatz ist die Gesamtsteuer geteilt durch das Gesamteinkommen – immer niedriger als der Grenzsteuersatz.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let estYear = '2025';

    const brackets2025 = [
      { rate: 0, max: 12096 },
      { rate: 14, max: 17005 },
      { rate: 24, max: 68430 },
      { rate: 42, max: 277826 },
      { rate: 45, max: Infinity }
    ];
    const brackets2026 = [
      { rate: 0, max: 12348 },
      { rate: 14, max: 17443 },
      { rate: 24, max: 70012 },
      { rate: 42, max: 284227 },
      { rate: 45, max: Infinity }
    ];

    const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

    function calcEST() {
      const income = parseFloat((document.getElementById('est-income') as HTMLInputElement).value) || 0;
      const statusClass = (document.getElementById('est-status') as HTMLSelectElement).value;
      const deduction = parseFloat((document.getElementById('est-deduction') as HTMLInputElement).value) || 0;
      const churchRate = parseFloat((document.getElementById('est-church') as HTMLSelectElement).value) || 0;

      const brackets = estYear === '2026' ? brackets2026 : brackets2025;
      let stdDed = 1230;
      const werbungskosten = Math.max(stdDed, deduction);

      let multiplier = 1;
      if (statusClass === '3') multiplier = 2;
      if (statusClass === '5') multiplier = 0;

      const taxableIncome = Math.max(0, income * multiplier - werbungskosten);
      let totalTax = 0;
      let marginalRate = 0;
      let prevMax = 0;
      const breakdown: { rate: number; taxed: number; tax: number }[] = [];

      for (const b of brackets) {
        if (taxableIncome <= prevMax) break;
        const inBracket = Math.min(taxableIncome, b.max) - prevMax;
        if (inBracket > 0 && b.rate > 0) {
          const tax = inBracket * b.rate / 100;
          totalTax += tax;
          breakdown.push({ rate: b.rate, taxed: inBracket, tax });
          marginalRate = b.rate;
        }
        prevMax = b.max;
      }

      if (statusClass === '3') totalTax = totalTax / 2;
      if (statusClass === '5') totalTax = income * 0.30;

      const soli = totalTax > 17742 ? totalTax * 0.055 : 0;
      const church = totalTax * churchRate;
      const totalWithSoli = totalTax + soli + church;
      const afterTax = income - totalWithSoli;
      const effectiveRate = income > 0 ? (totalWithSoli / income * 100) : 0;

      document.getElementById('est-total')!.textContent = fmtEur(totalWithSoli);
      document.getElementById('est-effective')!.textContent = effectiveRate.toFixed(1) + ' %';
      document.getElementById('est-marginal')!.textContent = marginalRate + ' %';
      document.getElementById('est-after')!.textContent = fmtEur(afterTax);
      document.getElementById('est-monthly')!.textContent = fmtEur(afterTax / 12);

      const bDiv = document.getElementById('est-brackets')!;
      bDiv.innerHTML = breakdown.map(b =>
        '<div class="flex justify-between items-center"><span class="text-text-secondary">' + b.rate + ' % auf ' + fmtEur(b.taxed) + '</span><span class="font-semibold">' + fmtEur(b.tax) + '</span></div>'
      ).join('');
      if (soli > 0) bDiv.innerHTML += '<div class="flex justify-between items-center border-t border-border/30 pt-1 mt-1"><span class="text-text-secondary">Solidaritätszuschlag (5,5 %)</span><span class="font-semibold">' + fmtEur(soli) + '</span></div>';
      if (church > 0) bDiv.innerHTML += '<div class="flex justify-between items-center"><span class="text-text-secondary">Kirchensteuer</span><span class="font-semibold">' + fmtEur(church) + '</span></div>';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.est-year-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.est-year-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          estYear = (btn as HTMLElement).dataset.year || '2025';
          calcEST();
        });
      });
      document.getElementById('est-income')!.addEventListener('input', calcEST);
      document.getElementById('est-status')!.addEventListener('change', calcEST);
      document.getElementById('est-deduction')!.addEventListener('input', calcEST);
      document.getElementById('est-church')!.addEventListener('change', calcEST);
      calcEST();
    }, 50);
  </script>
</CalculatorLayout>
