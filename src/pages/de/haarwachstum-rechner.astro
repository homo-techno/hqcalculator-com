---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Haarwachstum-Rechner - Wachstumsrate &amp; L&auml;ngenprognose";
const description = "Sch&auml;tzen Sie Ihre pers&ouml;nliche Haarwachstumsrate und berechnen Sie, wie lange es dauert, Ihre Wunschl&auml;nge zu erreichen.";
const relatedCalcs = [
  { name: "Haarfarbe-Mischen-Rechner", url: "/de/haarfarbe-mischen-rechner", description: "Haarfarbe mischen." },
  { name: "Haarporosit&auml;t-Rechner", url: "/de/haarporositaet-rechner", description: "Porosit&auml;tsbeurteilung." },
  { name: "Haarverl&auml;ngerung-Rechner", url: "/de/haarverlaengerung-rechner", description: "Extensions berechnen." },
  { name: "Haarentwickler-Rechner", url: "/de/haarentwickler-rechner", description: "Entwickler ausw&auml;hlen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Haarwachstum-Rechner" lang="de" enSlug="hair-growth-calculator" keywords="haarwachstum rechner, haarl&auml;nge berechnen, wachstumsrate haare, haarwachstum prognose, haare wachsen lassen" breadcrumbs={[{ name: "Haarwachstum-Rechner", url: "/de/haarwachstum-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Haarwachstum-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihre Haarwachstumsrate und berechnen Sie die Zeit bis zu Ihrer Wunschl&auml;nge.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelle L&auml;nge (cm)</label><input type="number" id="hgr-current" class="hgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="150" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ziell&auml;nge (cm)</label><input type="number" id="hgr-goal" class="hgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="0" max="150" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Altersgruppe</label>
          <select id="hgr-age" class="hgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.0">Unter 20</option>
            <option value="1.0" selected>20&ndash;35</option>
            <option value="0.9">36&ndash;50</option>
            <option value="0.8">51&ndash;65</option>
            <option value="0.7">&Uuml;ber 65</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Haartyp</label>
          <select id="hgr-type" class="hgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.1">Asiatisch (schnellstes Wachstum)</option>
            <option value="1.0" selected>Europ&auml;isch (durchschnittlich)</option>
            <option value="0.85">Afro (langsamster L&auml;ngenzuwachs)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Allgemeine Gesundheit &amp; Ern&auml;hrung</label>
          <select id="hgr-health" class="hgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.1">Ausgezeichnet (ausgewogene Ern&auml;hrung, Supplemente)</option>
            <option value="1.0" selected>Gut (durchschnittliche Ern&auml;hrung)</option>
            <option value="0.9">M&auml;&szlig;ig (leichte M&auml;ngel)</option>
            <option value="0.8">Schlecht (erheblicher Stress oder Mangel)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Schneideh&auml;ufigkeit</label>
          <select id="hgr-trim" class="hgr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Keine Schnitte</option>
            <option value="0.64" selected>Alle 3 Monate (0,6 cm/Schnitt)</option>
            <option value="1.27">Alle 6 Wochen (1,3 cm/Schnitt)</option>
            <option value="1.9">Monatlich (1,9 cm/Schnitt)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Zeit bis Ziell&auml;nge</div>
          <div class="text-5xl font-extrabold font-mono" id="hgr-time">0</div>
          <div class="text-sm text-blue-200 mt-1">Monate</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Wachstumsrate</div><div class="text-xl font-bold" id="hgr-rate">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fehlende L&auml;nge</div><div class="text-xl font-bold" id="hgr-needed">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wachstum in 6 Monaten</div><div class="text-xl font-bold" id="hgr-six">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wachstum in 1 Jahr</div><div class="text-xl font-bold" id="hgr-year">0 cm</div></div>
        </div>
      </div>
      <ShareButton calculatorId="hair-growth-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haarwachstumsraten im &Uuml;berblick</h2>
      <p>Haare wachsen im Durchschnitt etwa 1,25 cm pro Monat, also rund 15 cm pro Jahr. Die Wachstumsrate h&auml;ngt von Genetik, Alter, Ern&auml;hrung und Haartyp ab. Asiatisches Haar w&auml;chst am schnellsten (ca. 16 cm/Jahr), w&auml;hrend Afro-Haar den langsamsten L&auml;ngenzuwachs zeigt. Eine ausgewogene Ern&auml;hrung reich an Biotin, Eisen und Protein unterst&uuml;tzt das Haarwachstum.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie schnell wachsen Haare?</strong> Haare wachsen durchschnittlich 1&ndash;1,5 cm pro Monat. Individuell gibt es jedoch deutliche Schwankungen.</p>
      <p><strong>K&ouml;nnen Schnitte das Wachstum f&ouml;rdern?</strong> Regelmige Schnitte verhindern, dass sich gespaltene Enden nach oben arbeiten und L&auml;nge kosten &ndash; das Wachstum selbst wird dadurch nicht beschleunigt.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHGR() {
      const current = parseFloat((document.getElementById('hgr-current') as HTMLInputElement).value) || 0;
      const goal = parseFloat((document.getElementById('hgr-goal') as HTMLInputElement).value) || 0;
      const ageFactor = parseFloat((document.getElementById('hgr-age') as HTMLSelectElement).value);
      const typeFactor = parseFloat((document.getElementById('hgr-type') as HTMLSelectElement).value);
      const healthFactor = parseFloat((document.getElementById('hgr-health') as HTMLSelectElement).value);
      const trimPerVisit = parseFloat((document.getElementById('hgr-trim') as HTMLSelectElement).value);

      const baseRate = 1.25; // cm pro Monat
      const monthlyGrowth = baseRate * ageFactor * typeFactor * healthFactor;

      let trimPerMonth = 0;
      if (trimPerVisit === 0.64) trimPerMonth = 0.64 / 3;
      else if (trimPerVisit === 1.27) trimPerMonth = 1.27 / 1.5;
      else if (trimPerVisit === 1.9) trimPerMonth = 1.9;

      const netGrowth = Math.max(0.1, monthlyGrowth - trimPerMonth);
      const cmNeeded = Math.max(0, goal - current);
      const months = cmNeeded > 0 ? Math.ceil(cmNeeded / netGrowth) : 0;

      const sixMonthGrowth = netGrowth * 6;
      const yearGrowth = netGrowth * 12;

      document.getElementById('hgr-time')!.textContent = months.toLocaleString('de-DE');
      document.getElementById('hgr-rate')!.textContent = monthlyGrowth.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' cm';
      document.getElementById('hgr-needed')!.textContent = cmNeeded.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' cm';
      document.getElementById('hgr-six')!.textContent = sixMonthGrowth.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' cm';
      document.getElementById('hgr-year')!.textContent = yearGrowth.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' cm';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hgr-in').forEach(el => { el.addEventListener('input', calcHGR); el.addEventListener('change', calcHGR); });
      calcHGR();
    }, 50);
  </script>
</CalculatorLayout>
