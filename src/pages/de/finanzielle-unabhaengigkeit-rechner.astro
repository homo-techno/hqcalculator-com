---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Finanzielle Unabhängigkeit Rechner (FIRE) - Wann können Sie in Rente gehen?";
const description = "Berechnen Sie Ihren Weg zur finanziellen Unabhängigkeit. Finden Sie Ihre FIRE-Zahl, Jahre bis zur FI und sichere Entnahmerate.";
const relatedCalcs = [
  { name: "Feuer-Rechner", url: "/de/feuer-rechner", description: "FIRE-Rechner." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
  { name: "Mode-Aufschlag", url: "/de/mode-aufschlag-rechner", description: "Mode-Preiskalkulation." },
  { name: "Dünger-Rechner", url: "/de/duenger-rechner", description: "Düngerbedarf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Finanzielle Unabhängigkeit Rechner" lang="de" enSlug="financial-independence-calculator" keywords="FIRE rechner, finanzielle unabhängigkeit, frühzeitig in rente, FI zahl, sichere entnahmerate, sparquote" breadcrumbs={[{ name: "Finanzielle Unabhängigkeit", url: "/de/finanzielle-unabhaengigkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Finanzielle Unabhängigkeit (FIRE) Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie, wann Sie basierend auf Ihrer Sparquote und Investitionen finanzielle Unabhängigkeit erreichen können.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div><label class="block text-sm font-medium text-text mb-1">Jährliche Ausgaben (&euro;)</label><input type="number" id="fude-expenses" class="fude-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="36000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Jährliches Nettoeinkommen (&euro;)</label><input type="number" id="fude-income" class="fude-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="55000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Anlagekapital (&euro;)</label><input type="number" id="fude-savings" class="fude-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="100000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Erwartete j&auml;hrliche Rendite (%)</label><input type="number" id="fude-return" class="fude-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="7" min="0" max="15" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sichere Entnahmerate (%)</label><input type="number" id="fude-swr" class="fude-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="4" min="1" max="6" step="0.25"></div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jahre bis zur finanziellen Unabh&auml;ngigkeit</div>
            <div class="text-5xl font-extrabold font-mono" id="fude-years">0</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">FI-Zahl</div><div class="text-xl font-bold text-secondary" id="fude-number">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sichere Entnahme</div><div class="text-xl font-bold" id="fude-withdrawal">0 &euro;/Jahr</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sparquote</div><div class="text-xl font-bold text-green-600" id="fude-rate">0%</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Ersparnis</div><div class="text-xl font-bold" id="fude-annual-save">0 &euro;</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fortschritt zur FI</div>
            <div class="w-full h-4 bg-gray-200 rounded-full overflow-hidden mt-2">
              <div class="h-full bg-green-500 rounded-full transition-all" id="fude-bar" style="width:0%"></div>
            </div>
            <div class="text-sm font-bold mt-1" id="fude-progress">0%</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="financial-independence-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist FIRE?</h2>
      <p>FIRE steht f&uuml;r Financial Independence, Retire Early (Finanzielle Unabh&auml;ngigkeit, Fr&uuml;her Ruhestand). Ihre FI-Zahl ist typischerweise das 25-fache Ihrer j&auml;hrlichen Ausgaben (basierend auf einer 4%-Entnahmerate). Sobald Ihre Investitionen diesen Betrag erreichen, k&ouml;nnen Sie von den Anlagerenditen leben.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Die Macht der Sparquote</h3>
      <p>Ihre Sparquote ist der wichtigste Faktor auf dem Weg zur FI. Eine Sparquote von 50% bedeutet, dass Sie in ca. 17 Jahren FI erreichen, w&auml;hrend 75% Sie in unter 7 Jahren dorthin bringen kann (bei 7% realer Rendite).</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Funktioniert die 4%-Regel auch in Deutschland?</strong> Die Regel basiert auf US-Daten. In Deutschland sollten Sie Kapitalertragsteuer (ca. 26,375%) und mögliche Inflation berücksichtigen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcFUDE() {
      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      const expenses = parseFloat((document.getElementById('fude-expenses') as HTMLInputElement).value) || 0;
      const income = parseFloat((document.getElementById('fude-income') as HTMLInputElement).value) || 0;
      const savings = parseFloat((document.getElementById('fude-savings') as HTMLInputElement).value) || 0;
      const annualReturn = (parseFloat((document.getElementById('fude-return') as HTMLInputElement).value) || 0) / 100;
      const swr = (parseFloat((document.getElementById('fude-swr') as HTMLInputElement).value) || 4) / 100;
      const fiNumber = expenses / swr;
      const annualSavings = Math.max(0, income - expenses);
      const savingsRate = income > 0 ? (annualSavings / income) * 100 : 0;
      const safeWithdrawal = fiNumber * swr;
      let yearsToFI = 0;
      if (savings >= fiNumber) {
        yearsToFI = 0;
      } else if (annualSavings <= 0 && savings < fiNumber) {
        yearsToFI = 999;
      } else {
        let balance = savings;
        while (balance < fiNumber && yearsToFI < 100) {
          balance = balance * (1 + annualReturn) + annualSavings;
          yearsToFI++;
        }
        if (balance < fiNumber) yearsToFI = 999;
      }
      const progress = fiNumber > 0 ? Math.min(100, (savings / fiNumber) * 100) : 0;
      document.getElementById('fude-years')!.textContent = yearsToFI >= 999 ? 'N/A' : yearsToFI.toString();
      document.getElementById('fude-number')!.textContent = fmtEur(fiNumber);
      document.getElementById('fude-withdrawal')!.textContent = fmtEur(safeWithdrawal) + '/Jahr';
      document.getElementById('fude-rate')!.textContent = savingsRate.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      document.getElementById('fude-annual-save')!.textContent = fmtEur(annualSavings);
      (document.getElementById('fude-bar') as HTMLElement).style.width = progress + '%';
      document.getElementById('fude-progress')!.textContent = progress.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '% zur FI';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['fude-expenses', 'fude-income', 'fude-savings', 'fude-return', 'fude-swr'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcFUDE); el.addEventListener('change', calcFUDE); }
      });
      calcFUDE();
    }, 50);
  </script>
</CalculatorLayout>
