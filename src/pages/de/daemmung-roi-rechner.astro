---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Dämmungs-ROI-Rechner - Amortisationszeit & Energieeinsparungen";
const description = "Berechnen Sie die Kapitalrendite von Dämmmaßnahmen basierend auf R-Wert-Verbesserung, Klimazone und Energiekosten. Ermitteln Sie Amortisationszeit und 10-Jahres-ROI.";
const relatedCalcs = [
  { name: "Energieaudit-Rechner", url: "/energy-audit-calculator", description: "Hausinspektion." },
  { name: "Wärmepumpen-Rechner", url: "/heat-pump-efficiency-calculator", description: "Wärmepumpen-COP." },
  { name: "Passivhaus-Rechner", url: "/passive-house-calculator", description: "Passivhaus-Design." },
  { name: "BTU-Rechner", url: "/btu-calculator", description: "BTU-Berechnung." },
  { name: "Stromkosten-Rechner", url: "/electricity-cost-calculator", description: "Stromrechnung." },
  { name: "ROI-Rechner", url: "/roi-calculator", description: "Kapitalrendite." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie schnell amortisiert sich Dachdämmung?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dachdämmung amortisiert sich in Deutschland typischerweise in 5–15 Jahren, abhängig von Heizkosten, Klimazone und Ausgangszustand. Bei Altbauten mit schlechter Dämmung kann die Amortisationszeit deutlich kürzer sein, da die Energieeinsparungen sehr hoch sind." }
    },
    {
      "@type": "Question",
      "name": "Wie berechnet man Wärmeverlust durch Dämmung?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wärmeverlust Q = Fläche × Temperaturdifferenz / R-Wert. Eine Verbesserung von R-11 auf R-38 reduziert den Wärmefluss um ca. 71 %. Die jährlichen Einsparungen hängen von Heizgradtagen (HDD) und den lokalen Energiekosten ab." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Dämmungs-ROI-Rechner" lang="de" keywords="dämmungs roi rechner, r-wert verbesserung, dämmung amortisation, energieeinsparungen, wärmedämmung wirtschaftlichkeit, heizkosten sparen" breadcrumbs={[{ name: "Dämmungs-ROI-Rechner", url: "/de/daemmung-roi-rechner" }]} enSlug="insulation-roi-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dämmungs-ROI-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie schnell sich eine Dämmmaßnahme durch Energieeinsparungen amortisiert.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Dämmungsdetails</h3>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Bereich</label>
          <select id="dro-area" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="attic" selected>Dach / Decke</option>
            <option value="wall">Außenwände</option>
            <option value="floor">Fußboden / Kriechkeller</option>
            <option value="basement">Kellerwände</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fläche (m\u00B2)</label><input type="number" id="dro-sqm" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="111" min="5" max="1000" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Aktueller R-Wert</label><input type="number" id="dro-rold" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="11" min="0" max="60" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Neuer R-Wert</label><input type="number" id="dro-rnew" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="38" min="1" max="80" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einbaukosten (€/m\u00B2)</label><input type="number" id="dro-costpsm" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="2" max="100" step="1"></div>
        </div>
        <h3 class="font-semibold text-text">Klima & Energie</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Heizgradtage (HGT)</label><input type="number" id="dro-hdd" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3500" min="500" max="8000" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kühlgradtage (KGT)</label><input type="number" id="dro-cdd" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="0" max="3000" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Heizkosten (€/kWh)</label><input type="number" id="dro-fuel" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.12" min="0.04" max="0.50" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stromkosten (€/kWh)</label><input type="number" id="dro-cool" class="dro-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.32" min="0.05" max="0.80" step="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Amortisationszeit</div>
          <div class="text-4xl font-extrabold" id="dro-payback">0</div>
          <div class="text-sm text-blue-200 mt-1">Jahre</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="dro-total">0 \u20ac</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährl. Einsparungen</div><div class="text-xl font-bold" id="dro-savings">0 \u20ac/J.</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">10-Jahres-ROI</div><div class="text-xl font-bold" id="dro-roi10">0 %</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wärmeverlust-Reduktion</div><div class="text-xl font-bold" id="dro-reduction">0 %</div></div>
        </div>
      </div>
      <ShareButton calculatorId="daemmung-roi" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wirtschaftlichkeit von Dämmmaßnahmen</h2>
      <p>Der Wärmeverlust durch eine Fläche ist umgekehrt proportional zum R-Wert: Q = Fläche × Temperaturdifferenz / R. Eine Verbesserung von R-11 auf R-38 reduziert den Wärmefluss um ca. 71 %. Die Einsparungen hängen von Heizgradtagen (HGT) ab, die die Klimabelastung messen. Dachdämmung bietet typischerweise den besten ROI – oft 5–10 Jahre Amortisationszeit.</p>

      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Wärmeverlust-Reduktion = (1/R_alt - 1/R_neu) / (1/R_alt) \u00D7 100 %</p>
        <p>Jährl. Heizkosteneinsparung = Fläche \u00D7 (U_alt - U_neu) \u00D7 HGT \u00D7 24 / Heizeffizienz</p>
        <p>Amortisationszeit = Gesamtkosten / Jährl. Einsparungen</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie schnell amortisiert sich Dachdämmung?</h4>
      <p>In Deutschland typischerweise 5–15 Jahre, je nach Heizkosten und Klimazone. Bei Altbauten kann die Amortisation schneller erfolgen.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Wie berechnet man Wärmeverlust durch Dämmung?</h4>
      <p>Q = Fläche × Temperaturdifferenz / R-Wert. Eine Verbesserung von R-11 auf R-38 reduziert den Wärmefluss um ca. 71 %.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDRO() {
      const sqm = parseFloat((document.getElementById('dro-sqm') as HTMLInputElement).value) || 111;
      const rOld = parseFloat((document.getElementById('dro-rold') as HTMLInputElement).value) || 11;
      const rNew = parseFloat((document.getElementById('dro-rnew') as HTMLInputElement).value) || 38;
      const costPSM = parseFloat((document.getElementById('dro-costpsm') as HTMLInputElement).value) || 15;
      const hdd = parseFloat((document.getElementById('dro-hdd') as HTMLInputElement).value) || 3500;
      const cdd = parseFloat((document.getElementById('dro-cdd') as HTMLInputElement).value) || 200;
      const fuelCost = parseFloat((document.getElementById('dro-fuel') as HTMLInputElement).value) || 0.12;
      const coolCost = parseFloat((document.getElementById('dro-cool') as HTMLInputElement).value) || 0.32;

      // Convert m² to ft² for BTU calculation (1 m² = 10.764 ft²)
      const sqft = sqm * 10.764;
      const totalCost = sqm * costPSM;
      const uOld = rOld > 0 ? 1 / rOld : 1;
      const uNew = rNew > 0 ? 1 / rNew : 1;

      // Heat loss in BTU
      const heatSaveBTU = sqft * (uOld - uNew) * hdd * 24;
      const coolSaveBTU = sqft * (uOld - uNew) * cdd * 24;

      // Convert BTU to kWh (1 kWh = 3412 BTU), accounting for efficiency
      const heatSaveKWh = heatSaveBTU / 3412 / 0.85;
      const coolSaveKWh = coolSaveBTU / 3412 / 3;

      const heatSaveEur = heatSaveKWh * fuelCost;
      const coolSaveEur = coolSaveKWh * coolCost;
      const annualSavings = heatSaveEur + coolSaveEur;
      const payback = annualSavings > 0 ? totalCost / annualSavings : 99;
      const roi10 = totalCost > 0 ? ((annualSavings * 10 - totalCost) / totalCost * 100) : 0;
      const reduction = rOld > 0 ? ((1 / rOld - 1 / rNew) / (1 / rOld) * 100) : 0;

      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

      document.getElementById('dro-payback')!.textContent = payback < 50 ? payback.toFixed(1) : 'N/A';
      document.getElementById('dro-total')!.textContent = fmtEur(totalCost);
      document.getElementById('dro-savings')!.textContent = fmtEur(annualSavings) + '/J.';
      document.getElementById('dro-roi10')!.textContent = roi10.toFixed(0) + ' %';
      document.getElementById('dro-reduction')!.textContent = reduction.toFixed(0) + ' %';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dro-in').forEach(el => { el.addEventListener('input', calcDRO); el.addEventListener('change', calcDRO); });
      calcDRO();
    }, 50);
  </script>
</CalculatorLayout>
