---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "G\u00fcrtelgr\u00f6\u00dfenrechner - Taillenma\u00df zu G\u00fcrtelgr\u00f6\u00dfe";
const description = "Berechnen Sie Ihre G\u00fcrtelgr\u00f6\u00dfe aus dem Taillenma\u00df mit US-, EU- und UK-Umrechnungen. Finden Sie die richtige G\u00fcrtellaenge f\u00fcr Ihre Taillenweite.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/bmi-calculator", description: "Body-Mass-Index." },
  { name: "K\u00f6rperfett-Rechner", url: "/body-fat-calculator", description: "K\u00f6rperfettanteil." },
  { name: "L\u00e4ngenumrechner", url: "/length-converter", description: "L\u00e4ngenumrechnungen." },
  { name: "Stoff-Rechner", url: "/fabric-calculator", description: "Stoffbedarf." },
  { name: "Idealgewicht-Rechner", url: "/ideal-weight-calculator", description: "Ideales K\u00f6rpergewicht." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozentberechnungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="G\u00fcrtelgr\u00f6\u00dfenrechner" lang="de" keywords="g\u00fcrtelgr\u00f6\u00dfe rechner, taillenma\u00df zu g\u00fcrtelgr\u00f6\u00dfe, g\u00fcrtellaenge, US EU UK g\u00fcrtelgr\u00f6\u00dfe" breadcrumbs={[{ name: "G\u00fcrtelgr\u00f6\u00dfenrechner", url: "/de/guertelgroesse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">G&uuml;rtelgr&ouml;&szlig;enrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihre G&uuml;rtelgr&ouml;&szlig;e anhand des Taillenma&szlig;es mit internationalen Gr&ouml;&szlig;enumrechnungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Taillenumfang / Hosenweite</label><input type="number" id="bl-waist" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="85" min="50" max="150" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="bl-unit" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="cm" selected>Zentimeter</option>
              <option value="in">Zoll (Inches)</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">G&uuml;rtelstil</label>
          <select id="bl-style" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="dress" selected>Anzugg&uuml;rtel (an der Taille)</option>
            <option value="casual">Freizeitg&uuml;rtel (an der H&uuml;fte)</option>
            <option value="western">Western / Breiter G&uuml;rtel</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Messmethode</label>
          <select id="bl-method" class="bl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="trouser" selected>Hosenweite / Konfektionsgr&ouml;&szlig;e</option>
            <option value="body">K&ouml;rperma&szlig; (um die Taille)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene G&uuml;rtelgr&ouml;&szlig;e (EU)</div>
          <div class="text-4xl font-extrabold font-mono" id="bl-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">US/UK Gr&ouml;&szlig;e (Zoll)</div><div class="text-xl font-bold font-mono" id="bl-eu">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">UK Gr&ouml;&szlig;e</div><div class="text-xl font-bold font-mono" id="bl-uk">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Alpha</div><div class="text-xl font-bold font-mono" id="bl-alpha">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte G&uuml;rtell&auml;nge</div><div class="text-xl font-bold font-mono" id="bl-total">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mittleres Loch</div><div class="text-xl font-bold font-mono" id="bl-middle">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="belt-size" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBL() {
      let waist = parseFloat((document.getElementById('bl-waist') as HTMLInputElement).value) || 85;
      const unit = (document.getElementById('bl-unit') as HTMLSelectElement).value;
      const style = (document.getElementById('bl-style') as HTMLSelectElement).value;
      const method = (document.getElementById('bl-method') as HTMLSelectElement).value;
      let waistCm = unit === 'in' ? waist * 2.54 : waist;
      let waistIn = unit === 'in' ? waist : waist / 2.54;
      let addCm = 5;
      if (style === 'casual') addCm = 8;
      else if (style === 'western') addCm = 10;
      const beltSizeCm = Math.round((waistCm + addCm) / 5) * 5;
      const beltSizeIn = Math.round(beltSizeCm / 2.54);
      let alpha = '--';
      if (beltSizeCm <= 75) alpha = 'XS';
      else if (beltSizeCm <= 80) alpha = 'S';
      else if (beltSizeCm <= 90) alpha = 'M';
      else if (beltSizeCm <= 100) alpha = 'L';
      else if (beltSizeCm <= 110) alpha = 'XL';
      else if (beltSizeCm <= 120) alpha = 'XXL';
      else alpha = '3XL';
      const totalLengthCm = beltSizeCm + 20;
      const middleHoleCm = beltSizeCm;
      document.getElementById('bl-result')!.textContent = beltSizeCm + ' cm';
      document.getElementById('bl-eu')!.textContent = beltSizeIn + '"';
      document.getElementById('bl-uk')!.textContent = beltSizeIn + '"';
      document.getElementById('bl-alpha')!.textContent = alpha;
      document.getElementById('bl-total')!.textContent = totalLengthCm + ' cm';
      document.getElementById('bl-middle')!.textContent = middleHoleCm + ' cm ab Schnalle';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bl-in').forEach(el => { el.addEventListener('input', calcBL); el.addEventListener('change', calcBL); });
      calcBL();
    }, 50);
  </script>
</CalculatorLayout>
