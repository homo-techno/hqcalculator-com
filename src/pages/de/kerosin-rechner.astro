---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kerosin Rechner – Treibstoffverbrauch & Reichweite Flugzeuge";
const description = "Berechnen Sie Treibstoffverbrauch und Reichweite für Flugzeuge.";
const relatedCalcs = [
  { name: "Kinetische Energie Rechner", url: "/de/kinetische-energie-rechner", description: "Kinetische Energie (E=½mv²)." },
  { name: "Bewässerungsrechner", url: "/de/bewaesserungs-rechner", description: "Wasserbedarf für Garten." },
  { name: "Internetgeschwindigkeit Rechner", url: "/de/internetgeschwindigkeit-rechner", description: "Download/Upload-Zeiten." },
  { name: "Infusionsraten Rechner", url: "/de/infusionsrate-rechner", description: "IV Tropfraten." },
];
---
<CalculatorLayout lang="de" enSlug="jet-fuel-calculator" title={title} description={description} calculatorName="Kerosin Rechner" keywords="Kerosin Rechner, Treibstoffverbrauch Flugzeug, Kerosinverbrauch, Reichweite berechnen, Jet-A1, Avgas" breadcrumbs={[{ name: "Kerosin Rechner", url: "/de/kerosin-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kerosin Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Treibstoffverbrauch, Reichweite und Kerosinkosten für Propeller-, Turbo- und Jet-Flugzeuge.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Flugzeugtyp</label>
          <select id="kr-type" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="150,230">Cessna 172 (150 L/h, 230 km/h)</option>
            <option value="850,870">Boeing 737-800 (850 kg/h je Triebwerk, 870 km/h)</option>
            <option value="3200,905" selected>Airbus A320 (3.200 kg/h ges., 905 km/h)</option>
            <option value="13000,900">Boeing 747-400 (13.000 kg/h ges., 900 km/h)</option>
            <option value="custom,custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (kg/h oder L/h)</label><input type="number" id="kr-burn" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold" value="3200" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Reisegeschwindigkeit (km/h)</label><input type="number" id="kr-speed" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold" value="905" min="0" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Flugdistanz (km)</label><input type="number" id="kr-dist" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold" value="3500" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kerosinpreis (€/L oder €/kg)</label><input type="number" id="kr-price" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold" value="0.70" min="0" step="0.05"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Treibstoffverbrauch</div>
          <div class="text-5xl font-extrabold font-mono" id="kr-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="kr-cost">—</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flugzeit</div><div class="text-xl font-bold" id="kr-time">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbrauch pro km</div><div class="text-xl font-bold" id="kr-perkm">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reichweite bei 100 % Tank</div><div class="text-xl font-bold" id="kr-range">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="jet-fuel" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Kerosin – Treibstoff der Luftfahrt</h2>
      <p class="text-text-secondary">Kerosin (Jet-A1 für kommerzielle Flüge, Avgas für Kolbenmotoren) ist der Standard-Treibstoff der Luftfahrt. Ein Airbus A320 verbraucht auf einem 3.500-km-Flug ca. 15.000 kg Kerosin – umgerechnet etwa 5 Liter pro 100 km je Passagier. Der Kerosinpreis variiert stark und macht typisch 25–35 % der Betriebskosten einer Airline aus.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Flugzeit (h) = Distanz (km) / Geschwindigkeit (km/h)</p>
        <p>Verbrauch = Flugzeit × Verbrauch/h</p>
        <p>Kosten = Verbrauch × Preis pro Einheit</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel Kerosin verbraucht ein Passagierflugzeug pro Stunde?</h4>
          <p class="text-text-secondary mt-1">Ein Airbus A320 verbraucht ca. 2.500–3.500 kg Kerosin pro Stunde, ein Boeing 747 etwa 10.000–14.000 kg/h. Kleine Propellerflugzeuge wie die Cessna 172 benötigen nur 30–50 Liter Avgas pro Stunde.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zwischen Jet-A1 und Avgas?</h4>
          <p class="text-text-secondary mt-1">Jet-A1 ist Kerosin für Turbinen- und Strahltriebwerke bei Temperaturstabilität bis −47 °C. Avgas (Aviation Gasoline) ist Hochoktanbenzin für Kolbenmotoren in Kleinflugzeugen. Beide Treibstoffe sind nicht untereinander austauschbar.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Warum schwanken Kerosinpreise so stark?</h4>
          <p class="text-text-secondary mt-1">Kerosinpreise folgen eng dem Rohölpreis (Brent/WTI), der durch geopolitische Lage, OPEC-Entscheidungen, Dollarkurs und Nachfrageschwankungen beeinflusst wird. Airlines sichern sich oft über Hedging-Verträge gegen Preisschwankungen ab.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel CO₂ erzeugt ein Flug?</h4>
          <p class="text-text-secondary mt-1">Die Verbrennung von 1 kg Kerosin erzeugt ca. 3,16 kg CO₂. Ein A320-Flug von Frankfurt nach New York (ca. 6.200 km) verbraucht etwa 26.000 kg Kerosin und erzeugt damit rund 82 Tonnen CO₂ – je Passagier etwa 0,5–1 Tonne CO₂ inkl. Strahlungseffekt.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKR() {
      const typeVal = (document.getElementById('kr-type') as HTMLSelectElement).value;
      if (typeVal !== 'custom,custom') {
        const parts = typeVal.split(',');
        (document.getElementById('kr-burn') as HTMLInputElement).value = parts[0];
        (document.getElementById('kr-speed') as HTMLInputElement).value = parts[1];
      }
      const burn = parseFloat((document.getElementById('kr-burn') as HTMLInputElement).value) || 0;
      const speed = parseFloat((document.getElementById('kr-speed') as HTMLInputElement).value) || 0;
      const dist = parseFloat((document.getElementById('kr-dist') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('kr-price') as HTMLInputElement).value) || 0;
      const flightH = speed > 0 ? dist / speed : 0;
      const totalFuel = burn * flightH;
      const cost = totalFuel * price;
      const perKm = dist > 0 ? totalFuel / dist : 0;
      const maxFlightH = 12;
      const range = burn > 0 ? (burn * maxFlightH) / burn * speed : 0;
      const fmtH = (h: number) => {
        const hh = Math.floor(h);
        const mm = Math.round((h - hh) * 60);
        return hh + ' Std. ' + mm + ' Min.';
      };
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('kr-result')!.textContent = fmt(totalFuel) + ' kg/L';
      document.getElementById('kr-cost')!.textContent = 'Kosten: ' + fmtEur(cost);
      document.getElementById('kr-time')!.textContent = flightH > 0 ? fmtH(flightH) : '—';
      document.getElementById('kr-perkm')!.textContent = perKm.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' /km';
      document.getElementById('kr-range')!.textContent = (speed * maxFlightH).toLocaleString('de-DE') + ' km';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kr-in').forEach(el => { el.addEventListener('input', calcKR); el.addEventListener('change', calcKR); });
      calcKR();
    }, 50);
  </script>
</CalculatorLayout>
