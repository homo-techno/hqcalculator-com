---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Auto-Leasing-Rechner - Monatliche Leasingrate berechnen";
const description = "Berechnen Sie Ihre monatliche Leasingrate, Gesamtkosten und vergleichen Sie Leasing vs. Kauf. Inklusive Restwert, Zinsfaktor und Anzahlung.";
const relatedCalcs = [
  { name: "Autorate-Rechner", url: "/de/autorate-rechner", description: "Autofinanzierung." },
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
  { name: "Kfz-Versicherung", url: "/de/kfz-versicherung-rechner", description: "Versicherung." },
  { name: "Kapitalertragssteuer", url: "/de/kapitalertragssteuer-rechner", description: "Kapitalertr\u00e4ge." },
  { name: "Kapitalisierungsrate", url: "/de/kapitalisierungsrate-rechner", description: "Cap Rate." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlage." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Auto-Leasing-Rechner" lang="de" enSlug="car-lease-calculator" keywords="auto leasing rechner, leasingrate berechnen, autofinanzierung, monatliche leasingrate, restwert, leasing vergleich" breadcrumbs={[{ name: "Auto-Leasing", url: "/de/auto-leasing-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Auto-Leasing-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihre monatliche Leasingrate, Gesamtkosten und vergleichen Sie Leasing vs. Kauf.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Fahrzeug-Listenpreis (&euro;)</label>
          <input type="number" id="al-msrp" class="al-in w-full border border-border rounded-lg px-3 py-2" value="35000" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Verhandelter Preis (&euro;)</label>
          <input type="number" id="al-negotiated" class="al-in w-full border border-border rounded-lg px-3 py-2" value="33000" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Restwert (%)</label>
          <input type="number" id="al-residual" class="al-in w-full border border-border rounded-lg px-3 py-2" value="55" min="0" max="100" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Effektiver Jahreszins (%)</label>
          <input type="number" id="al-rate" class="al-in w-full border border-border rounded-lg px-3 py-2" value="3.0" min="0" max="20" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Laufzeit (Monate)</label>
          <select id="al-term" class="al-in w-full border border-border rounded-lg px-3 py-2">
            <option value="24">24 Monate</option>
            <option value="36" selected>36 Monate</option>
            <option value="48">48 Monate</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahlung (&euro;)</label>
          <input type="number" id="al-down" class="al-in w-full border border-border rounded-lg px-3 py-2" value="2000" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">MwSt.-Satz (%)</label>
          <input type="number" id="al-tax" class="al-in w-full border border-border rounded-lg px-3 py-2" value="19" min="0" max="25" step="0.5">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Leasingrate</div>
          <div class="text-5xl font-extrabold font-mono" id="al-result">0 &euro;</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamte Leasingkosten</div>
            <div class="text-xl font-bold" id="al-total">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wertverlust</div>
            <div class="text-xl font-bold" id="al-depreciation">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Finanzierungskosten</div>
            <div class="text-xl font-bold text-danger" id="al-finance">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kaufkosten (Kredit)</div>
            <div class="text-xl font-bold" id="al-buy-compare">0 &euro;</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="car-lease" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Leasing oder Kauf - was ist besser?</h3>
      <p>Leasing bietet niedrigere monatliche Raten, aber Sie besitzen das Auto nicht. Beim Kauf zahlen Sie mehr pro Monat, behalten aber den Restwert. F&uuml;r Gesch&auml;ftskunden ist Leasing oft steuerlich vorteilhaft.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAL() {
      const msrp = parseFloat((document.getElementById('al-msrp') as HTMLInputElement).value) || 0;
      const negotiated = parseFloat((document.getElementById('al-negotiated') as HTMLInputElement).value) || 0;
      const residualPct = parseFloat((document.getElementById('al-residual') as HTMLInputElement).value) || 0;
      const annualRate = parseFloat((document.getElementById('al-rate') as HTMLInputElement).value) || 0;
      const term = parseInt((document.getElementById('al-term') as HTMLSelectElement).value) || 36;
      const down = parseFloat((document.getElementById('al-down') as HTMLInputElement).value) || 0;
      const taxRate = parseFloat((document.getElementById('al-tax') as HTMLInputElement).value) || 0;

      const residualValue = msrp * (residualPct / 100);
      const capCost = negotiated - down;
      const monthlyRate = annualRate / 100 / 12;

      const depreciation = (capCost - residualValue) / term;
      const financeCharge = (capCost + residualValue) * monthlyRate / 2;
      const preTaxPayment = depreciation + financeCharge;
      const monthlyTax = preTaxPayment * (taxRate / 100);
      const monthlyPayment = preTaxPayment + monthlyTax;

      const totalLeaseCost = monthlyPayment * term + down;
      const totalDepreciation = depreciation * term;
      const totalFinance = financeCharge * term;

      // Compare: buying with loan
      const buyLoanRate = annualRate / 100 / 12;
      const buyTerm = 60;
      const buyLoan = negotiated - down;
      let buyMonthly = 0;
      if (buyLoanRate > 0) {
        buyMonthly = buyLoan * (buyLoanRate * Math.pow(1 + buyLoanRate, buyTerm)) / (Math.pow(1 + buyLoanRate, buyTerm) - 1);
      } else {
        buyMonthly = buyLoan / buyTerm;
      }
      const buyTotal = buyMonthly * buyTerm + down;

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

      document.getElementById('al-result')!.textContent = fmt(monthlyPayment);
      document.getElementById('al-total')!.textContent = fmt(totalLeaseCost);
      document.getElementById('al-depreciation')!.textContent = fmt(totalDepreciation);
      document.getElementById('al-finance')!.textContent = fmt(totalFinance);
      document.getElementById('al-buy-compare')!.textContent = fmt(buyTotal);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.al-in').forEach(el => {
        el.addEventListener('input', calcAL);
        el.addEventListener('change', calcAL);
      });
      calcAL();
    }, 50);
  </script>
</CalculatorLayout>
