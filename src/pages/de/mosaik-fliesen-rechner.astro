---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mosaik-Fliesen Rechner - Fliesenmengen und Kosten berechnen";
const description = "Berechnen Sie Fliesenmengen, Schnitte und Materialkosten für Mosaikarbeiten. Mit Verschnitt-Kalkulation und Preisermittlung für verschiedene Fliesenformate.";

const relatedCalcs = [
  { name: "Mosaik-Fugenmasse Rechner", url: "/de/mosaik-fugenmasse-rechner", description: "Fugenmasse berechnen." },
  { name: "Fliesen-Rechner", url: "/de/fliesenrechner", description: "Fliesen berechnen." },
  { name: "Mörtelrechner", url: "/de/moertel-rechner", description: "Mörtel berechnen." },
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Fläche berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mosaic-tile-calculator" calculatorName="Mosaik-Fliesen Rechner" keywords="Mosaik Fliesen Rechner, Fliesenmengen berechnen, Mosaik Kosten, Tesseras berechnen, Fliesenfläche" breadcrumbs={[{ name: "Mosaik-Fliesen Rechner", url: "/de/mosaik-fliesen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mosaik-Fliesen Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Fliesenmengen, Verschnitt und Gesamtkosten für Ihr Mosaikprojekt – für Böden, Wände, Kunstobjekte und Gartenprojekte.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="mf-btn-room" class="mf-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer">Raum/Fläche</button>
          <button id="mf-btn-tiles" class="mf-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer">Direkte Fläche</button>
        </div>

        <div id="mf-room-mode">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label>
              <input type="number" id="mf-rw" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="3">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Raumlänge (m)</label>
              <input type="number" id="mf-rl" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="4">
            </div>
          </div>
          <div class="mt-3">
            <label class="block text-xs font-medium text-text mb-1">Abzüge (Türen, Fenster) (m²)</label>
            <input type="number" id="mf-deduct" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="0.5">
          </div>
        </div>

        <div id="mf-tiles-mode" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Zu fliesnde Fläche (m²)</label>
          <input type="number" id="mf-direct-area" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="11.5">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fliesenbreite (mm)</label>
            <input type="number" id="mf-fw" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="5" value="25">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fliesenhöhe (mm)</label>
            <input type="number" id="mf-fh" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="5" value="25">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fugenbreite (mm)</label>
            <input type="number" id="mf-gw" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0.5" value="2">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Verschnittaufschlag (%)</label>
            <input type="number" id="mf-waste" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="5" min="0" value="15">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Preis pro m² (€)</label>
            <input type="number" id="mf-price" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" value="45">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Blattgröße (cm × cm, optional)</label>
            <input type="text" id="mf-sheet" class="mf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" placeholder="30×30">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Fliesen</div>
          <div class="text-5xl font-extrabold font-mono" id="mf-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="mf-result-m2">— m²</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Nettofläche</div>
            <div class="text-xl font-bold" id="mf-net-area">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bruttofläche (mit Verschnitt)</div>
            <div class="text-xl font-bold" id="mf-gross-area">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Materialkosten</div>
            <div class="text-xl font-bold" id="mf-cost">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Matten/Blätter (30×30 cm)</div>
            <div class="text-xl font-bold" id="mf-sheets">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnung</h3>
          <div class="font-mono text-sm space-y-1" id="mf-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mosaic-tile" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="mt-10 bg-white border border-border rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-text mb-4">Gängige Mosaikformate</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-4 font-semibold">Format</th><th class="py-2 pr-4 font-semibold">Tessera-Größe</th><th class="py-2 pr-4 font-semibold">Typische Fuge</th><th class="py-2 font-semibold">Anwendung</th></tr></thead>
          <tbody class="text-text-secondary">
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">Mikromosaik</td><td class="py-2 pr-4">5–10 mm</td><td class="py-2 pr-4">1–2 mm</td><td class="py-2">Kunstobjekte, Schmuck</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">Standardmosaik</td><td class="py-2 pr-4">23×23 mm</td><td class="py-2 pr-4">2–3 mm</td><td class="py-2">Wand, Bad, Schwimmbad</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">Glasmosaik</td><td class="py-2 pr-4">25×25 mm</td><td class="py-2 pr-4">2 mm</td><td class="py-2">Dekor, Fassade</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4 font-medium">Großformat-Mosaik</td><td class="py-2 pr-4">48×48 mm</td><td class="py-2 pr-4">3–5 mm</td><td class="py-2">Boden, Außenbereich</td></tr>
            <tr><td class="py-2 pr-4 font-medium">Naturstein-Mosaik</td><td class="py-2 pr-4">30×30 mm</td><td class="py-2 pr-4">3–4 mm</td><td class="py-2">Garten, Terrasse</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mosaikfliesen planen und berechnen</h2>
      <p>Mosaikarbeiten erfordern sorgfältige Materialplanung. Durch die vielen kleinen Stücke und Schnitte entsteht mehr Verschnitt als bei großen Fliesen. Ein Aufschlag von 10-20% ist üblich, bei komplexen Mustern und Diagonalverlegung sollten es 20-25% sein.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Wie viel Verschnitt sollte ich einplanen?</p>
          <p>Geradlinige Verlegung: 10% Aufschlag. Diagonalverlegung (45°): 15-20%. Komplexe Muster oder viele Ecken: 20-25%. Bei teuren Materialien lohnt sich eine detaillierte Planung mit Verlegeplänen.</p>
        </div>
        <div>
          <p class="font-semibold">Was sind Mosaikmatten?</p>
          <p>Mosaikmatten (Mesh-Matten) sind Mosaiktesseras, die auf Netzgewebe oder Papier vorgefertigt aufgeklebt sind – meistens 30×30 cm. Sie erleichtern das gleichmäßige Verlegen erheblich und sind der Standard für professionelle Mosaik-Anwendungen.</p>
        </div>
        <div>
          <p class="font-semibold">Welcher Kleber eignet sich für Mosaik?</p>
          <p>Für Innenräume: weißer Fliesenkleber (Flexkleber). Für Nassbereich und Außen: Flexkleber C2 nach DIN EN 12004. Für schwere Natursteine oder Glas: Epoxidkleber. Immer weißen Kleber für transparentes Glas wählen.</p>
        </div>
        <div>
          <p class="font-semibold">Wie teuer sind Mosaike im Vergleich zu Standardfliesen?</p>
          <p>Mosaike kosten materialbedingt 20-100% mehr als vergleichbare Standardfliesen, da mehr Verarbeitungsschritte nötig sind. Der Zeitaufwand beim Verlegen ist 3-5x höher. Glasmosaike beginnen bei ca. 20 €/m², Natursteinmosaike bei 40-80 €/m².</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let mfMode = 'room';

    function calcMf() {
      const fw = parseFloat((document.getElementById('mf-fw') as HTMLInputElement).value) || 25;
      const fh = parseFloat((document.getElementById('mf-fh') as HTMLInputElement).value) || 25;
      const gw = parseFloat((document.getElementById('mf-gw') as HTMLInputElement).value) || 2;
      const wastePct = parseFloat((document.getElementById('mf-waste') as HTMLInputElement).value) || 15;
      const pricePerM2 = parseFloat((document.getElementById('mf-price') as HTMLInputElement).value) || 45;
      const sheetStr = (document.getElementById('mf-sheet') as HTMLInputElement).value;

      let netArea = 0;
      if (mfMode === 'room') {
        const rw = parseFloat((document.getElementById('mf-rw') as HTMLInputElement).value) || 0;
        const rl = parseFloat((document.getElementById('mf-rl') as HTMLInputElement).value) || 0;
        const deduct = parseFloat((document.getElementById('mf-deduct') as HTMLInputElement).value) || 0;
        netArea = rw * rl - deduct;
      } else {
        netArea = parseFloat((document.getElementById('mf-direct-area') as HTMLInputElement).value) || 0;
      }

      const fmt = (v: number, dec = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });

      const grossArea = netArea * (1 + wastePct / 100);

      const pitchW = fw + gw;
      const pitchH = fh + gw;
      const tileAreaMm2 = pitchW * pitchH;
      const tilesPerM2 = 1e6 / tileAreaMm2;
      const totalTiles = Math.ceil(grossArea * tilesPerM2);
      const cost = grossArea * pricePerM2;

      let sheetsParts = '';
      let sheetsCount = 0;
      const sheetMatch = sheetStr.match(/(\d+)[×x](\d+)/i);
      if (sheetMatch) {
        const sw = parseInt(sheetMatch[1]) * 10;
        const sh = parseInt(sheetMatch[2]) * 10;
        const tilesPerSheet = Math.floor(sw / pitchW) * Math.floor(sh / pitchH);
        sheetsCount = tilesPerSheet > 0 ? Math.ceil(totalTiles / tilesPerSheet) : 0;
        sheetsParts = `${sheetsCount} Matten`;
      }

      const steps: string[] = [];
      steps.push(`Nettofläche = ${fmt(netArea)} m²`);
      steps.push(`Bruttofläche = ${fmt(netArea)} × (1 + ${wastePct}%) = ${fmt(grossArea)} m²`);
      steps.push(`Fliesen/m² = 1.000.000 / (${fw+gw}×${fh+gw}) = ${fmt(tilesPerM2, 0)} Stück`);
      steps.push(`Gesamt = ${fmt(grossArea)} m² × ${fmt(tilesPerM2, 0)}/m² = ${totalTiles.toLocaleString('de-DE')} Fliesen`);
      steps.push(`Kosten = ${fmt(grossArea)} m² × ${fmt(pricePerM2)} €/m² = ${fmt(cost)} €`);

      document.getElementById('mf-result')!.textContent = totalTiles.toLocaleString('de-DE') + ' Stück';
      document.getElementById('mf-result-m2')!.textContent = fmt(grossArea) + ' m²';
      document.getElementById('mf-net-area')!.textContent = fmt(netArea) + ' m²';
      document.getElementById('mf-gross-area')!.textContent = fmt(grossArea) + ' m²';
      document.getElementById('mf-cost')!.textContent = fmt(cost) + ' €';
      document.getElementById('mf-sheets')!.textContent = sheetsCount > 0 ? sheetsParts : '—';
      document.getElementById('mf-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('mf-btn-room')!.addEventListener('click', () => {
        mfMode = 'room';
        document.getElementById('mf-room-mode')!.classList.remove('hidden');
        document.getElementById('mf-tiles-mode')!.classList.add('hidden');
        document.getElementById('mf-btn-room')!.className = 'mf-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer';
        document.getElementById('mf-btn-tiles')!.className = 'mf-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer';
        calcMf();
      });
      document.getElementById('mf-btn-tiles')!.addEventListener('click', () => {
        mfMode = 'direct';
        document.getElementById('mf-tiles-mode')!.classList.remove('hidden');
        document.getElementById('mf-room-mode')!.classList.add('hidden');
        document.getElementById('mf-btn-tiles')!.className = 'mf-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer';
        document.getElementById('mf-btn-room')!.className = 'mf-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer';
        calcMf();
      });
      document.querySelectorAll('.mf-in').forEach(el => {
        el.addEventListener('input', calcMf);
        el.addEventListener('change', calcMf);
      });
      calcMf();
    }, 50);
  </script>
</CalculatorLayout>
