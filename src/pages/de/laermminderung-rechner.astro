---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lärmminderung Rechner – Schallreduzierung durch Dämmung berechnen";
const description = "Berechnen Sie Schallreduzierung durch Dämmung und Schallschutzmaßnahmen.";
const relatedCalcs = [
  { name: "Osmotischer Druck Rechner", url: "/de/osmotischer-druck-rechner", description: "Osmotischen Druck berechnen." },
  { name: "Ohmsches Gesetz Rechner", url: "/de/ohmsches-gesetz-rechner", description: "Spannung, Strom, Widerstand." },
  { name: "Operationsverstärker Rechner", url: "/de/operationsverstaerker-rechner", description: "Op-Amp-Verstärkung." },
  { name: "Meeresversauerung Rechner", url: "/de/meeresversauerung-rechner", description: "pH-Veränderungen der Ozeane." },
];
---
<CalculatorLayout lang="de" enSlug="noise-reduction-calculator" title={title} description={description} calculatorName="Lärmminderung Rechner" keywords="Lärmminderung, Schallreduzierung, Schallschutz, Dämmung, dB, Schallpegel" breadcrumbs={[{ name: "Lärmminderung Rechner", url: "/de/laermminderung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lärmminderung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Schallreduzierung durch Dämmmaßnahmen. Geben Sie den Ausgangspegel und die Dämmung in Dezibel ein.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ausgangspegel (dB)</label>
            <input type="number" id="lm-source" class="lm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" max="200">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Dämmwert Rw (dB)</label>
            <input type="number" id="lm-rw" class="lm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" max="100">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Dämmschichten</label>
            <input type="number" id="lm-layers" class="lm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" max="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Referenzpegel (dB) – optional</label>
            <input type="number" id="lm-ref" class="lm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" max="200" placeholder="z.B. 40">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Resultierender Schallpegel</div>
          <div class="text-5xl font-extrabold font-mono" id="lm-result">— dB</div>
          <div class="text-sm text-blue-200 mt-1" id="lm-reduction-label"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Reduzierung</div>
            <div class="text-xl font-bold" id="lm-reduction">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Intensitätsverhältnis</div>
            <div class="text-xl font-bold" id="lm-ratio">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wahrnehmung</div>
            <div class="text-xl font-bold" id="lm-perception">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Unter Referenz?</div>
            <div class="text-xl font-bold" id="lm-ref-compare">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsweg</h3>
          <div class="font-mono text-sm space-y-1" id="lm-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="noise-reduction" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Schallschutz und Lärmminderung verstehen</h2>
      <p>Die Dämmwirkung von Schallschutzmaßnahmen wird in Dezibel (dB) angegeben. Der bewertete Schalldämm-Maß Rw beschreibt, wie viel Schall ein Bauteil reduziert. Eine Reduzierung um 10 dB halbiert die wahrgenommene Lautstärke für das menschliche Ohr. Mehrere Schichten können die Dämmwirkung addieren, wobei in der Praxis Flankenübertragungen zu berücksichtigen sind.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Resultpegel = Ausgangspegel - (Rw × Schichten)</p>
        <p>Intensitätsverhältnis = 10^(Reduzierung / 10)</p>
        <p>Wahrnehmung: 10 dB ≈ doppelte/halbe Lautstärke</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was bedeutet der Rw-Wert?</strong> Der bewertete Schalldämm-Maß Rw ist ein einzahliger Kennwert für die Luftschalldämmung eines Bauteils nach DIN EN ISO 717-1. Je höher der Wert, desto besser die Dämmung.</p>
      <p><strong>Wie viel dB sind nötig für guten Schallschutz?</strong> Für Innenwände zwischen Wohnungen empfiehlt die DIN 4109 mindestens 53 dB, für Außenwände gegen Straßenlärm je nach Lärmzone 30–50 dB.</p>
      <p><strong>Kann ich Dämmschichten addieren?</strong> Theoretisch addieren sich die Dämmwerte mehrerer unabhängiger Schichten. In der Praxis begrenzen Flanken- und Körperschallübertragungen die erreichbare Dämmung.</p>
      <p><strong>Ab wann ist Lärm gesundheitsschädlich?</strong> Dauerhafter Lärm über 85 dB kann das Gehör schädigen. Ab 65 dB tagsüber gelten Bereiche laut Umgebungslärmrichtlinie als belastet.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLM() {
      const source = parseFloat((document.getElementById('lm-source') as HTMLInputElement).value) || 0;
      const rw = parseFloat((document.getElementById('lm-rw') as HTMLInputElement).value) || 0;
      const layers = parseFloat((document.getElementById('lm-layers') as HTMLInputElement).value) || 1;
      const ref = parseFloat((document.getElementById('lm-ref') as HTMLInputElement).value);
      const fmt1 = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      const totalRed = rw * layers;
      const result = source - totalRed;
      const intensityRatio = Math.pow(10, totalRed / 10);
      let perception = '';
      if (totalRed >= 20) perception = 'Viertel der Lautstärke';
      else if (totalRed >= 10) perception = 'Halbe Lautstärke';
      else if (totalRed >= 6) perception = 'Deutlich leiser';
      else if (totalRed >= 3) perception = 'Merklich leiser';
      else perception = 'Kaum wahrnehmbar';
      const steps: string[] = [];
      steps.push('Gesamtdämmung = ' + fmt1(rw) + ' dB × ' + layers + ' = ' + fmt1(totalRed) + ' dB');
      steps.push('Resultpegel = ' + fmt1(source) + ' dB - ' + fmt1(totalRed) + ' dB = ' + fmt1(result) + ' dB');
      steps.push('Intensitätsverhältnis = 10^(' + fmt1(totalRed) + '/10) = ' + intensityRatio.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + 'x');
      document.getElementById('lm-result')!.textContent = fmt1(result) + ' dB';
      document.getElementById('lm-reduction-label')!.textContent = 'Reduzierung um ' + fmt1(totalRed) + ' dB';
      document.getElementById('lm-reduction')!.textContent = '-' + fmt1(totalRed) + ' dB';
      document.getElementById('lm-ratio')!.textContent = '1 : ' + intensityRatio.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.getElementById('lm-perception')!.textContent = perception;
      const hasRef = !isNaN(ref);
      if (hasRef) {
        const diff = result - ref;
        document.getElementById('lm-ref-compare')!.textContent = diff <= 0 ? 'Ja, ' + fmt1(Math.abs(diff)) + ' dB darunter' : 'Nein, ' + fmt1(diff) + ' dB darüber';
        steps.push('Vergleich Referenz ' + fmt1(ref) + ' dB: ' + (diff <= 0 ? 'Ziel erreicht' : 'Ziel nicht erreicht'));
      } else {
        document.getElementById('lm-ref-compare')!.textContent = 'Kein Referenzwert';
      }
      document.getElementById('lm-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('lm-source') as HTMLInputElement).value = '80';
      (document.getElementById('lm-rw') as HTMLInputElement).value = '45';
      (document.getElementById('lm-layers') as HTMLInputElement).value = '1';
      document.querySelectorAll('.lm-in').forEach(el => { el.addEventListener('input', calcLM); el.addEventListener('change', calcLM); });
      calcLM();
    }, 50);
  </script>
</CalculatorLayout>
