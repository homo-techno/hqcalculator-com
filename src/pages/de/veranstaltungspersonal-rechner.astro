---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Veranstaltungspersonal-Rechner - Service, Barkeeper & Crew";
const description = "Berechnen Sie den Personalbedarf f\u00fcr Ihre Veranstaltung: Servicekr\u00e4fte, Barkeeper, Aufbauteam und Koordinatoren nach G\u00e4steanzahl und Eventtyp.";

const relatedCalcs = [
  { name: "Veranstaltungsbudget-Rechner", url: "/de/veranstaltungsbudget-rechner", description: "Eventbudget." },
  { name: "Veranstaltungszeitplan-Rechner", url: "/de/veranstaltungszeitplan-rechner", description: "Zeitplanung." },
  { name: "Veranstaltungsbeleuchtung-Rechner", url: "/de/veranstaltungsbeleuchtung-rechner", description: "Beleuchtung." },
  { name: "Veranstaltungsversicherung-Rechner", url: "/de/veranstaltungsversicherung-rechner", description: "Versicherung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Veranstaltungspersonal-Rechner" lang="de" enSlug="event-staffing-calculator" keywords="veranstaltungspersonal rechner, eventpersonal, servicepersonal, barkeeper bedarf, catering personal" breadcrumbs={[{ name: "Veranstaltungspersonal-Rechner", url: "/de/veranstaltungspersonal-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Veranstaltungspersonal-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie, wie viele Mitarbeiter Sie f&uuml;r eine gut organisierte Veranstaltung ben&ouml;tigen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl G&auml;ste</label><input type="number" id="vpe-guests" class="vpe-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="1" step="1"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Veranstaltungsart</label>
          <select id="vpe-type" class="vpe-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="seated">Sitzendes Dinner</option>
            <option value="buffet">Buffet</option>
            <option value="cocktail">Cocktailempfang</option>
            <option value="corporate">Firmenveranstaltung</option>
            <option value="wedding">Hochzeit</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Serviceniveau</label>
          <select id="vpe-level" class="vpe-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="standard">Standard</option>
            <option value="premium">Premium / Erstklassig</option>
            <option value="casual">Zwanglos / Selbstbedienung</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Veranstaltungsdauer (Stunden)</label><input type="number" id="vpe-hours" class="vpe-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="12" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Stundenlohn pro Person (&euro;)</label><input type="number" id="vpe-rate" class="vpe-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="10" step="1"></div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Personal gesamt</div>
        <div class="text-5xl font-extrabold" id="vpe-total">--</div>
        <div class="text-sm mt-1" id="vpe-ratio">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Servicekr&auml;fte</div><div class="text-xl font-bold" id="vpe-servers">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Barkeeper</div><div class="text-xl font-bold" id="vpe-bartenders">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Auf-/Abbau</div><div class="text-xl font-bold" id="vpe-setup">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Personalkosten</div><div class="text-xl font-bold" id="vpe-cost">--</div></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="vpe-details"></div>

      <ShareButton calculatorId="event-staffing-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Personalrichtlinien f&uuml;r Veranstaltungen</h2>
      <p>Standardverh&auml;ltnis: 1 Servicekraft pro 20 G&auml;ste beim Dinner, 1 pro 30 beim Buffet. Premium-Service: 1 pro 10-12 G&auml;ste. Barkeeper: 1 pro 50-75 G&auml;ste.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel Personal f&uuml;r eine Hochzeit?</strong> Bei 150 G&auml;sten: ca. 8-10 Servicekr&auml;fte, 2-3 Barkeeper und 3-4 K&uuml;chenmitarbeiter.</p>
      <p><strong>Was kostet das Personal?</strong> Rechnen Sie mit Auf-/Abbauzeit von ca. 2 Stunden zus&auml;tzlich zur Veranstaltungsdauer.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcVPE() {
      const guests = parseInt((document.getElementById('vpe-guests') as HTMLInputElement).value) || 1;
      const eventType = (document.getElementById('vpe-type') as HTMLSelectElement).value;
      const level = (document.getElementById('vpe-level') as HTMLSelectElement).value;
      const hours = parseFloat((document.getElementById('vpe-hours') as HTMLInputElement).value) || 5;
      const rate = parseFloat((document.getElementById('vpe-rate') as HTMLInputElement).value) || 18;

      let serverRatio = 20;
      if (eventType === 'seated') serverRatio = 20;
      else if (eventType === 'buffet') serverRatio = 30;
      else if (eventType === 'cocktail') serverRatio = 25;
      else if (eventType === 'corporate') serverRatio = 25;
      else if (eventType === 'wedding') serverRatio = 18;

      if (level === 'premium') serverRatio = Math.floor(serverRatio * 0.55);
      else if (level === 'casual') serverRatio = Math.floor(serverRatio * 1.5);

      const servers = Math.max(1, Math.ceil(guests / serverRatio));
      const bartenders = Math.max(1, Math.ceil(guests / (level === 'premium' ? 40 : 60)));
      const setupCrew = Math.max(2, Math.ceil(guests / 50));
      const kitchen = Math.max(1, Math.ceil(guests / 40));
      const coordinator = guests > 75 ? 1 : 0;
      const captains = Math.max(0, Math.floor(servers / 5));

      const totalStaff = servers + bartenders + setupCrew + kitchen + coordinator + captains;
      const totalHours = hours + 2;
      const laborCost = totalStaff * rate * totalHours;

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('vpe-total')!.textContent = totalStaff.toString();
      document.getElementById('vpe-ratio')!.textContent = '1 Servicekraft pro ' + serverRatio + ' G\u00E4ste';
      document.getElementById('vpe-servers')!.textContent = servers.toString();
      document.getElementById('vpe-bartenders')!.textContent = bartenders.toString();
      document.getElementById('vpe-setup')!.textContent = setupCrew.toString();
      document.getElementById('vpe-cost')!.textContent = fmt(laborCost);

      let details = '<h3 class="font-semibold text-sm text-text mb-2">Detaillierter Personalplan</h3><ul class="text-sm text-text-secondary space-y-1">';
      details += '<li>Servicekr\u00E4fte: ' + servers + '</li>';
      details += '<li>Barkeeper: ' + bartenders + '</li>';
      details += '<li>K\u00FCchenpersonal: ' + kitchen + '</li>';
      details += '<li>Auf-/Abbauteam: ' + setupCrew + '</li>';
      if (captains > 0) details += '<li>Serviceleiter: ' + captains + '</li>';
      if (coordinator > 0) details += '<li>Eventkoordinator: ' + coordinator + '</li>';
      details += '<li>Gesamte Arbeitsstunden: ' + (totalStaff * totalHours) + ' Std. (inkl. 2 Std. Auf-/Abbau)</li>';
      details += '<li>Gesch\u00E4tzte Personalkosten: ' + fmt(laborCost) + ' bei ' + rate + ' \u20AC/Std.</li>';
      details += '</ul>';
      document.getElementById('vpe-details')!.innerHTML = details;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vpe-in').forEach(el => { el.addEventListener('input', calcVPE); el.addEventListener('change', calcVPE); });
      calcVPE();
    }, 50);
  </script>
</CalculatorLayout>
