---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Korallenriff-Rechner - Riff-Gesundheitsindex & Bleichgrenzwert";
const description = "Berechnen Sie den Riff-Gesundheitsindex aus Korallenbedeckung, Artenvielfalt, Algenanteil und Fischbiomasse. Bewerten Sie Bleichrisiko und Schutzstatus.";
const relatedCalcs = [
  { name: "Wasserqualität", url: "/de/wasserqualitaet-rechner", description: "Wasserqualitätsanalyse." },
  { name: "Aquarium-Rechner", url: "/de/aquarium-rechner", description: "Aquarium-Berechnungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Korallenriff-Rechner" enSlug="coral-reef-calculator" keywords="Korallenriff Rechner, Riff Gesundheitsindex, Korallenbedeckung, Bleichgrenzwert, Artenvielfalt, Fischbiomasse, Riffschutz" breadcrumbs={[{ name: "Korallenriff-Rechner", url: "/de/korallenriff-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Korallenriff-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie die Gesundheit von Korallenriffen anhand wichtiger ökologischer Indikatoren wie Korallenbedeckung, Artenvielfalt, Algenanteil und Fischbiomasse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lebende Korallenbedeckung (%)</label><input type="number" id="co-coral" class="co-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Makroalgen-Bedeckung (%)</label><input type="number" id="co-algae" class="co-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Artenreichtum (Anzahl Arten)</label><input type="number" id="co-species" class="co-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fischbiomasse (g/m²)</label><input type="number" id="co-fish" class="co-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wassertemp. (°C)</label><input type="number" id="co-temp" class="co-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="15" max="38" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Monatsmittel (°C)</label><input type="number" id="co-mmm" class="co-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="20" max="32" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Pflanzenfresser-Dichte (Fische/100m²)</label><input type="number" id="co-herb" class="co-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Riff-Gesundheitsindex</div>
          <div class="text-5xl font-extrabold font-mono" id="co-rhi">--</div>
          <div class="text-sm text-blue-200 mt-1" id="co-grade">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Korallen-Score</div><div class="text-xl font-bold" id="co-cscore">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Algen-Score</div><div class="text-xl font-bold" id="co-ascore">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fisch-Score</div><div class="text-xl font-bold" id="co-fscore">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bleichrisiko</div><div class="text-xl font-bold" id="co-bleach">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">DHW</div><div class="text-xl font-bold" id="co-dhw">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Resilienz</div><div class="text-xl font-bold" id="co-resil">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="coral-reef" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Korallenriff-Gesundheit bewerten</h2>
      <p>Der Riff-Gesundheitsindex (RHI) kombiniert Korallenbedeckung, Algenanteil und Fischbiomasse zu einer Gesamtbewertung. Werte über 4,5 gelten als sehr gut, unter 1,5 als kritisch. Regelmäßiges Monitoring hilft, Veränderungen frühzeitig zu erkennen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCO() {
      const coralCover = parseFloat((document.getElementById('co-coral') as HTMLInputElement).value) || 0;
      const algaeCover = parseFloat((document.getElementById('co-algae') as HTMLInputElement).value) || 0;
      const species = parseFloat((document.getElementById('co-species') as HTMLInputElement).value) || 0;
      const fishBiomass = parseFloat((document.getElementById('co-fish') as HTMLInputElement).value) || 0;
      const waterTemp = parseFloat((document.getElementById('co-temp') as HTMLInputElement).value) || 27;
      const mmm = parseFloat((document.getElementById('co-mmm') as HTMLInputElement).value) || 28;
      const herbivore = parseFloat((document.getElementById('co-herb') as HTMLInputElement).value) || 0;

      let coralScore: number;
      if (coralCover >= 40) coralScore = 5;
      else if (coralCover >= 20) coralScore = 4;
      else if (coralCover >= 10) coralScore = 3;
      else if (coralCover >= 5) coralScore = 2;
      else coralScore = 1;

      let algaeScore: number;
      if (algaeCover <= 5) algaeScore = 5;
      else if (algaeCover <= 12) algaeScore = 4;
      else if (algaeCover <= 25) algaeScore = 3;
      else if (algaeCover <= 50) algaeScore = 2;
      else algaeScore = 1;

      let fishScore: number;
      if (fishBiomass >= 60) fishScore = 5;
      else if (fishBiomass >= 40) fishScore = 4;
      else if (fishBiomass >= 20) fishScore = 3;
      else if (fishBiomass >= 10) fishScore = 2;
      else fishScore = 1;

      const rhi = (coralScore * 0.35 + algaeScore * 0.25 + fishScore * 0.40);

      let grade = '';
      if (rhi >= 4.5) grade = 'Sehr gut';
      else if (rhi >= 3.5) grade = 'Gut';
      else if (rhi >= 2.5) grade = 'Mäßig';
      else if (rhi >= 1.5) grade = 'Schlecht';
      else grade = 'Kritisch';

      const tempAnomaly = Math.max(0, waterTemp - mmm);
      const dhw = tempAnomaly * 4;
      let bleachRisk = 'Gering';
      if (dhw >= 8) bleachRisk = 'Schwer';
      else if (dhw >= 4) bleachRisk = 'Hoch';
      else if (dhw >= 1) bleachRisk = 'Mäßig';

      const resilience = herbivore >= 30 && coralCover >= 20 && species >= 20 ? 'Hoch'
        : herbivore >= 15 && coralCover >= 10 ? 'Mäßig' : 'Gering';

      document.getElementById('co-rhi')!.textContent = rhi.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('co-grade')!.textContent = grade;
      document.getElementById('co-cscore')!.textContent = coralScore + '/5';
      document.getElementById('co-ascore')!.textContent = algaeScore + '/5';
      document.getElementById('co-fscore')!.textContent = fishScore + '/5';
      document.getElementById('co-bleach')!.textContent = bleachRisk;
      document.getElementById('co-dhw')!.textContent = dhw.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' °C-Wo.';
      document.getElementById('co-resil')!.textContent = resilience;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('co-coral') as HTMLInputElement).value = '25';
      (document.getElementById('co-algae') as HTMLInputElement).value = '15';
      (document.getElementById('co-species') as HTMLInputElement).value = '30';
      (document.getElementById('co-fish') as HTMLInputElement).value = '35';
      (document.getElementById('co-temp') as HTMLInputElement).value = '28';
      (document.getElementById('co-mmm') as HTMLInputElement).value = '28.5';
      (document.getElementById('co-herb') as HTMLInputElement).value = '20';
      document.querySelectorAll('.co-in').forEach(el => { el.addEventListener('input', calcCO); el.addEventListener('change', calcCO); });
      calcCO();
    }, 50);
  </script>
</CalculatorLayout>
