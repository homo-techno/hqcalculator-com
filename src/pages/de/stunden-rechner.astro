---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Stunden Rechner - Arbeitsstunden & Stundenzettel 2026";
const description = "Berechne Gesamtarbeitsstunden zwischen Kommen und Gehen. Verfolge Wochenstunden, Ueberstunden und Bruttolohn. Kostenloser Stundenzettel-Rechner.";

const relatedCalcs = [
  { name: "Stundenlohn-zu-Gehalt-Rechner", url: "/de/stundenlohn-zu-gehalt-rechner", description: "Lohnumrechnung." },
  { name: "Stundenlohn-vs-Gehalt-Rechner", url: "/de/stundenlohn-vs-gehalt-rechner", description: "Lohnvergleich." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeit berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Steuerrechner", url: "/de/steuerrechner", description: "Steuern berechnen." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Stunden-Rechner" keywords="Stundenrechner, Arbeitsstunden berechnen, Stundenzettel, Zeiterfassung, Ueberstunden, Bruttolohn berechnen" breadcrumbs={[{ name: "Stunden-Rechner", url: "/de/stunden-rechner" }]} lang="de" enSlug="hours-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stunden-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erfasse Arbeitsstunden von Kommen bis Gehen. Berechne Gesamtstunden, Ueberstunden und Bruttolohn.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border text-left">
                  <th class="py-2 pr-2 font-semibold">Tag</th>
                  <th class="py-2 pr-2 font-semibold">Beginn</th>
                  <th class="py-2 pr-2 font-semibold">Ende</th>
                  <th class="py-2 pr-2 font-semibold">Pause (Min)</th>
                  <th class="py-2 font-semibold text-right">Stunden</th>
                </tr>
              </thead>
              <tbody id="str-tbody">
                <tr class="str-day border-b border-border/30" data-day="Mo">
                  <td class="py-2 pr-2 font-medium">Mo</td>
                  <td class="py-2 pr-2"><input type="time" class="str-start px-2 py-1.5 border border-border rounded-lg" value="08:00"></td>
                  <td class="py-2 pr-2"><input type="time" class="str-end px-2 py-1.5 border border-border rounded-lg" value="17:00"></td>
                  <td class="py-2 pr-2"><input type="number" class="str-break w-16 px-2 py-1.5 border border-border rounded-lg text-center" value="30" min="0"></td>
                  <td class="py-2 text-right font-bold str-day-hours">0</td>
                </tr>
                <tr class="str-day border-b border-border/30" data-day="Di">
                  <td class="py-2 pr-2 font-medium">Di</td>
                  <td class="py-2 pr-2"><input type="time" class="str-start px-2 py-1.5 border border-border rounded-lg" value="08:00"></td>
                  <td class="py-2 pr-2"><input type="time" class="str-end px-2 py-1.5 border border-border rounded-lg" value="17:00"></td>
                  <td class="py-2 pr-2"><input type="number" class="str-break w-16 px-2 py-1.5 border border-border rounded-lg text-center" value="30" min="0"></td>
                  <td class="py-2 text-right font-bold str-day-hours">0</td>
                </tr>
                <tr class="str-day border-b border-border/30" data-day="Mi">
                  <td class="py-2 pr-2 font-medium">Mi</td>
                  <td class="py-2 pr-2"><input type="time" class="str-start px-2 py-1.5 border border-border rounded-lg" value="08:00"></td>
                  <td class="py-2 pr-2"><input type="time" class="str-end px-2 py-1.5 border border-border rounded-lg" value="17:00"></td>
                  <td class="py-2 pr-2"><input type="number" class="str-break w-16 px-2 py-1.5 border border-border rounded-lg text-center" value="30" min="0"></td>
                  <td class="py-2 text-right font-bold str-day-hours">0</td>
                </tr>
                <tr class="str-day border-b border-border/30" data-day="Do">
                  <td class="py-2 pr-2 font-medium">Do</td>
                  <td class="py-2 pr-2"><input type="time" class="str-start px-2 py-1.5 border border-border rounded-lg" value="08:00"></td>
                  <td class="py-2 pr-2"><input type="time" class="str-end px-2 py-1.5 border border-border rounded-lg" value="17:00"></td>
                  <td class="py-2 pr-2"><input type="number" class="str-break w-16 px-2 py-1.5 border border-border rounded-lg text-center" value="30" min="0"></td>
                  <td class="py-2 text-right font-bold str-day-hours">0</td>
                </tr>
                <tr class="str-day border-b border-border/30" data-day="Fr">
                  <td class="py-2 pr-2 font-medium">Fr</td>
                  <td class="py-2 pr-2"><input type="time" class="str-start px-2 py-1.5 border border-border rounded-lg" value="08:00"></td>
                  <td class="py-2 pr-2"><input type="time" class="str-end px-2 py-1.5 border border-border rounded-lg" value="17:00"></td>
                  <td class="py-2 pr-2"><input type="number" class="str-break w-16 px-2 py-1.5 border border-border rounded-lg text-center" value="30" min="0"></td>
                  <td class="py-2 text-right font-bold str-day-hours">0</td>
                </tr>
                <tr class="str-day border-b border-border/30" data-day="Sa">
                  <td class="py-2 pr-2 font-medium text-text-muted">Sa</td>
                  <td class="py-2 pr-2"><input type="time" class="str-start px-2 py-1.5 border border-border rounded-lg" value=""></td>
                  <td class="py-2 pr-2"><input type="time" class="str-end px-2 py-1.5 border border-border rounded-lg" value=""></td>
                  <td class="py-2 pr-2"><input type="number" class="str-break w-16 px-2 py-1.5 border border-border rounded-lg text-center" value="0" min="0"></td>
                  <td class="py-2 text-right font-bold str-day-hours">0</td>
                </tr>
                <tr class="str-day" data-day="So">
                  <td class="py-2 pr-2 font-medium text-text-muted">So</td>
                  <td class="py-2 pr-2"><input type="time" class="str-start px-2 py-1.5 border border-border rounded-lg" value=""></td>
                  <td class="py-2 pr-2"><input type="time" class="str-end px-2 py-1.5 border border-border rounded-lg" value=""></td>
                  <td class="py-2 pr-2"><input type="number" class="str-break w-16 px-2 py-1.5 border border-border rounded-lg text-center" value="0" min="0"></td>
                  <td class="py-2 text-right font-bold str-day-hours">0</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="mt-4 p-4 bg-surface-alt rounded-xl">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-text mb-1">Stundenlohn (optional)</label>
                <div class="relative">
                  <input type="number" id="str-rate" class="w-full pl-4 pr-8 py-2 border border-border rounded-lg" value="20" min="0" step="0.25">
                  <span class="absolute right-3 top-1/2 -translate-y-1/2 text-text-muted">€</span>
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-text mb-1">Ueberstunden ab (Std./Woche)</label>
                <input type="number" id="str-ot-after" class="w-full px-3 py-2 border border-border rounded-lg" value="40" min="0">
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtstunden</div>
            <div class="text-4xl font-extrabold" id="str-total">0:00</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Regelstunden</div><div class="text-xl font-bold" id="str-regular">0:00</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ueberstunden</div><div class="text-xl font-bold text-danger" id="str-overtime">0:00</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dezimalstunden</div><div class="text-xl font-bold" id="str-decimal">0,00</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Arbeitstage</div><div class="text-xl font-bold" id="str-days">0</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bruttolohn</div>
            <div class="text-2xl font-bold text-secondary" id="str-pay">0,00 €</div>
            <div class="text-xs text-text-muted mt-1" id="str-pay-detail"></div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="hours" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Arbeitsstunden korrekt berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Arbeitsstunden = (Feierabend - Beginn) - Pausenzeit</div>
      <p>Gib fuer jeden Tag Beginn- und Endzeit sowie die Pausendauer ein. Der Rechner summiert deine Wochenstunden automatisch und ermittelt Ueberstunden ab dem eingestellten Schwellenwert.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Ueberstundenregelungen in Deutschland</h3>
      <ul>
        <li><strong>Arbeitszeitgesetz (ArbZG):</strong> Max. 10 Stunden/Tag, 48 Stunden/Woche (im Durchschnitt 8h/Tag)</li>
        <li><strong>Tarifliche Regelarbeitszeit:</strong> Meist 35-40 Stunden/Woche</li>
        <li>Ueberstunden sind innerhalb von 6 Monaten auszugleichen oder zusaetzlich zu vergueten</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Zaehllen Pausen als Arbeitszeit?</strong> Unbezahlte Pausen (ab 30 Minuten) werden abgezogen. Kurze Erholungspausen (bis 15 Minuten) gelten gemaess ArbZG als Arbeitszeit.</p>
      <p><strong>Wie werden Ueberstunden verguetest?</strong> Das haengt vom Tarif- bzw. Arbeitsvertrag ab. Haeufig gibt es einen Zuschlag von 25-50 % oder Freizeitausgleich.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function timeToMinSTR(t: string): number {
      if (!t) return -1;
      const [h, m] = t.split(':').map(Number);
      return h * 60 + m;
    }

    function formatHMSTR(totalMin: number): string {
      const h = Math.floor(totalMin / 60);
      const m = Math.round(totalMin % 60);
      return h + ':' + String(m).padStart(2, '0');
    }

    function calcSTR() {
      let totalMin = 0;
      let daysWorked = 0;

      document.querySelectorAll('.str-day').forEach(row => {
        const start = timeToMinSTR((row.querySelector('.str-start') as HTMLInputElement).value);
        const end = timeToMinSTR((row.querySelector('.str-end') as HTMLInputElement).value);
        const brk = parseInt((row.querySelector('.str-break') as HTMLInputElement).value) || 0;
        const display = row.querySelector('.str-day-hours') as HTMLElement;

        if (start >= 0 && end >= 0) {
          let diff = end - start;
          if (diff < 0) diff += 24 * 60;
          diff = Math.max(0, diff - brk);
          totalMin += diff;
          daysWorked++;
          display.textContent = (diff / 60).toFixed(2).replace('.', ',');
        } else {
          display.textContent = '—';
        }
      });

      const totalHrs = totalMin / 60;
      const otAfter = parseFloat((document.getElementById('str-ot-after') as HTMLInputElement).value) || 40;
      const regularMin = Math.min(totalMin, otAfter * 60);
      const otMin = Math.max(0, totalMin - otAfter * 60);

      document.getElementById('str-total')!.textContent = formatHMSTR(totalMin);
      document.getElementById('str-regular')!.textContent = formatHMSTR(regularMin);
      document.getElementById('str-overtime')!.textContent = formatHMSTR(otMin);
      document.getElementById('str-decimal')!.textContent = totalHrs.toFixed(2).replace('.', ',');
      document.getElementById('str-days')!.textContent = String(daysWorked);

      const rate = parseFloat((document.getElementById('str-rate') as HTMLInputElement).value) || 0;
      const regularPay = (regularMin / 60) * rate;
      const otPay = (otMin / 60) * rate * 1.25;
      const totalPay = regularPay + otPay;
      document.getElementById('str-pay')!.textContent = totalPay.toFixed(2).replace('.', ',') + ' €';
      document.getElementById('str-pay-detail')!.textContent = otMin > 0
        ? 'Regelstd.: ' + regularPay.toFixed(2).replace('.', ',') + ' € + Ü-Std.: ' + otPay.toFixed(2).replace('.', ',') + ' €'
        : totalHrs.toFixed(1).replace('.', ',') + ' Std. × ' + rate + ' €/h';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.str-start, .str-end, .str-break').forEach(el => el.addEventListener('input', calcSTR));
      document.getElementById('str-rate')!.addEventListener('input', calcSTR);
      document.getElementById('str-ot-after')!.addEventListener('input', calcSTR);
      calcSTR();
    }, 50);
  </script>
</CalculatorLayout>
