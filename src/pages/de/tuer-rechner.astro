---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Tuer-Rechner - Masse, Rohbauoeffnung & Kosten 2026";
const description = "Berechne Tuergroessen, Rohbauoeffnungen und Materialkosten fuer Innen- und Aussentueren.";

const relatedCalcs = [
  { name: "Fenster-Rechner", url: "/de/fenster-rechner", description: "Fensterberechnungen." },
  { name: "Quadratmeter-Rechner", url: "/de/quadratmeter-rechner", description: "Flaeche berechnen." },
  { name: "Boden-Rechner", url: "/de/boden-rechner", description: "Bodenbelag berechnen." },
  { name: "Renovierungskosten-Rechner", url: "/de/renovierungskosten-rechner", description: "Renovierungskosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Tuer-Rechner" keywords="Tuer Rechner, Rohbauoeffnung, Tuermasse, Innentuer, Aussentuer, Tuerkosten" breadcrumbs={[{ name: "Tuer-Rechner", url: "/de/tuer-rechner" }]} lang="de" enSlug="door-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Tuer-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne Tuergroessen, Rohbauoeffnungen und Kosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="trde-type flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-type="int">Innentuer</button>
          <button class="trde-type flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-type="ext">Aussentuer</button>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tuerbreite (cm)</label>
            <select id="trde-w" class="trde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="61">61 cm (Schrank)</option>
              <option value="73.5">73,5 cm (Bad)</option>
              <option value="86" selected>86 cm (Standard)</option>
              <option value="98.5">98,5 cm (breit)</option>
              <option value="110">110 cm (Doppeltuer)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Tuerhoehe (cm)</label>
            <select id="trde-h" class="trde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="198.5" selected>198,5 cm (Standard)</option>
              <option value="211">211 cm</option>
              <option value="231">231 cm (hoch)</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Anzahl Tueren</label><input type="number" id="trde-num" class="trde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="20" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Rohbauoeffnung</div>
          <div class="text-4xl font-extrabold font-mono" id="trde-result">0 cm &times; 0 cm</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tuergroesse</div><div class="text-lg font-bold font-mono" id="trde-size">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tuerflaeche</div><div class="text-lg font-bold font-mono" id="trde-area">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tuerkosten</div><div class="text-lg font-bold font-mono" id="trde-cost">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zargenbedarf</div><div class="text-xl font-bold font-mono" id="trde-trim">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold font-mono" id="trde-total">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="door" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Tuermasse und Einbau</h2>
      <p>Standardtueren in Deutschland sind 86 cm breit und 198,5 cm hoch. Die Rohbauoeffnung muss ca. 2-3 cm breiter und 1-2 cm hoeher sein als die Zarge.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist die Standard-Tuergroesse?</strong> In Deutschland betraegt die Standard-Innentuer 86 x 198,5 cm (DIN 18101). Barrierefreie Tueren muessen mindestens 90 cm breit sein.</p>
      <p><strong>Was kostet eine neue Tuer mit Einbau?</strong> Einfache Innentueren kosten 100-300 Euro, hochwertige 400-800 Euro. Der Einbau kostet zusaetzlich 100-250 Euro.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let trdeType = 'int';
    function calcTRDE() {
      const w = parseFloat((document.getElementById('trde-w') as HTMLSelectElement).value);
      const h = parseFloat((document.getElementById('trde-h') as HTMLSelectElement).value);
      const num = parseInt((document.getElementById('trde-num') as HTMLInputElement).value) || 1;
      const roW = w + 6;
      const roH = h + 4;
      const areaSqM = (w * h) / 10000;
      const trimPerDoor = (2 * (h + 10) + (w + 10)) / 100;
      const doorCost = trdeType === 'int' ? (w <= 75 ? 120 : w <= 90 ? 200 : 350) : (w <= 100 ? 500 : 800);
      const trimCost = 80;
      const installCost = trdeType === 'int' ? 150 : 300;

      document.getElementById('trde-result')!.textContent = roW.toFixed(0) + ' cm \u00D7 ' + roH.toFixed(0) + ' cm';
      document.getElementById('trde-size')!.textContent = w.toFixed(0) + ' \u00D7 ' + h.toFixed(0) + ' cm';
      document.getElementById('trde-area')!.textContent = areaSqM.toFixed(2).replace('.', ',') + ' m\u00B2';
      document.getElementById('trde-cost')!.textContent = (doorCost * num).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('trde-trim')!.textContent = (trimPerDoor * num).toFixed(1).replace('.', ',') + ' m';
      document.getElementById('trde-total')!.textContent = ((doorCost + trimCost + installCost) * num).toLocaleString('de-DE') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.trde-type').forEach(b => b.addEventListener('click', () => {
        trdeType = (b as HTMLButtonElement).dataset.type!;
        document.querySelectorAll('.trde-type').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.type === trdeType;
          (btn as HTMLButtonElement).className = 'trde-type flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        calcTRDE();
      }));
      document.querySelectorAll('.trde-in').forEach(el => { el.addEventListener('input', calcTRDE); el.addEventListener('change', calcTRDE); });
      calcTRDE();
    }, 50);
  </script>
</CalculatorLayout>
