---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Längeneinheit Umrechner – Meter, km, Meilen, Fuß, Zoll";
const description = "Konvertieren Sie alle Längeneinheiten: Meter, Kilometer, Meilen, Fuß, Zoll und mehr. Schnell und präzise.";
const relatedCalcs = [
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Flächen berechnen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
  { name: "Lichtlaufzeit Rechner", url: "/de/lichtlaufzeit-rechner", description: "Astronomische Distanzen." },
  { name: "Lineare Gleichung Rechner", url: "/de/lineare-gleichung-rechner", description: "Gleichungen lösen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="length-converter" calculatorName="Längeneinheit Umrechner" keywords="Längeneinheit umrechnen, Meter Kilometer, Meilen Fuß, Zoll cm, Einheitenrechner" breadcrumbs={[{ name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Längeneinheit Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Alle Längeneinheiten umrechnen – metrisch, imperial und astronomisch.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Wert</label>
            <input type="number" id="leu-value" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" step="any">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Von Einheit</label>
            <select id="leu-from" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1e-9">Nanometer (nm)</option>
              <option value="1e-6">Mikrometer (µm)</option>
              <option value="1e-3">Millimeter (mm)</option>
              <option value="1e-2">Zentimeter (cm)</option>
              <option value="1e-1">Dezimeter (dm)</option>
              <option value="1" selected>Meter (m)</option>
              <option value="1e3">Kilometer (km)</option>
              <option value="1609.344">Meile (mi)</option>
              <option value="0.9144">Yard (yd)</option>
              <option value="0.3048">Fuß (ft)</option>
              <option value="0.0254">Zoll (in)</option>
              <option value="1852">Seemeile (nmi)</option>
              <option value="9.461e15">Lichtjahr (ly)</option>
              <option value="1.496e11">Astronomische Einheit (AE)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Nach Einheit</label>
          <select id="leu-to" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1e-9">Nanometer (nm)</option>
            <option value="1e-6">Mikrometer (µm)</option>
            <option value="1e-3">Millimeter (mm)</option>
            <option value="1e-2">Zentimeter (cm)</option>
            <option value="1e-1">Dezimeter (dm)</option>
            <option value="1">Meter (m)</option>
            <option value="1e3">Kilometer (km)</option>
            <option value="1609.344" selected>Meile (mi)</option>
            <option value="0.9144">Yard (yd)</option>
            <option value="0.3048">Fuß (ft)</option>
            <option value="0.0254">Zoll (in)</option>
            <option value="1852">Seemeile (nmi)</option>
            <option value="9.461e15">Lichtjahr (ly)</option>
            <option value="1.496e11">Astronomische Einheit (AE)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ergebnis</div>
          <div class="text-4xl font-extrabold font-mono" id="leu-result">0</div>
        </div>
        <div id="leu-table" class="overflow-x-auto"></div>
      </div>
      <ShareButton lang="de" calculatorId="laengeneinheit" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Längeneinheiten im Überblick</h2>
      <p>Das internationale Einheitensystem (SI) definiert den Meter als Basiseinheit für Längen. Davon abgeleitet sind Kilometer (1000 m) und Zentimeter (0,01 m). Im angelsächsischen Raum sind Fuß (30,48 cm), Zoll (2,54 cm) und Meilen (1609,34 m) gebräuchlich. In der Astronomie werden Lichtjahre und Astronomische Einheiten (AE) verwendet.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viele Meter sind eine Meile?</summary>
          <p class="mt-2 text-sm text-text-secondary">Eine statute Meile (mi) entspricht exakt 1.609,344 Metern oder 1,609344 Kilometern.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen Meile und Seemeile?</summary>
          <p class="mt-2 text-sm text-text-secondary">Eine Seemeile (nmi) entspricht 1852 Metern, eine statute Meile 1609,344 Metern. Seemeilen werden in der Schiff- und Luftfahrt verwendet.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie groß ist ein Lichtjahr in Kilometern?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ein Lichtjahr entspricht ca. 9,461 Billionen Kilometern (9,461 × 10¹² km). Es ist die Strecke, die Licht in einem Jahr zurücklegt.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie rechne ich Fuß in Meter um?</summary>
          <p class="mt-2 text-sm text-text-secondary">1 Fuß (ft) = 0,3048 Meter. Um Fuß in Meter umzurechnen, multiplizieren Sie die Anzahl der Fuß mit 0,3048.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const leuUnits: Record<string, string> = {
      "1e-9": "nm", "1e-6": "µm", "1e-3": "mm", "1e-2": "cm", "1e-1": "dm",
      "1": "m", "1e3": "km", "1609.344": "mi", "0.9144": "yd", "0.3048": "ft",
      "0.0254": "in", "1852": "nmi", "9.461e15": "ly", "1.496e11": "AE"
    };
    const leuNames: Record<string, string> = {
      "1e-9": "Nanometer", "1e-6": "Mikrometer", "1e-3": "Millimeter", "1e-2": "Zentimeter",
      "1e-1": "Dezimeter", "1": "Meter", "1e3": "Kilometer", "1609.344": "Meile",
      "0.9144": "Yard", "0.3048": "Fuß", "0.0254": "Zoll", "1852": "Seemeile",
      "9.461e15": "Lichtjahr", "1.496e11": "Astron. Einheit"
    };
    function calcLeu() {
      const val = parseFloat((document.getElementById('leu-value') as HTMLInputElement).value) || 0;
      const fromFactor = parseFloat((document.getElementById('leu-from') as HTMLSelectElement).value);
      const toFactor = parseFloat((document.getElementById('leu-to') as HTMLSelectElement).value);
      const toKey = (document.getElementById('leu-to') as HTMLSelectElement).value;
      const meters = val * fromFactor;
      const result = meters / toFactor;
      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumSignificantDigits: 8 });
      document.getElementById('leu-result')!.textContent = fmt(result) + ' ' + leuUnits[toKey];

      const commonKeys = ["1e-3", "1e-2", "1", "1e3", "1609.344", "0.3048", "0.0254"];
      let tableHtml = '<table class="w-full text-sm"><thead><tr class="text-left text-text-muted"><th class="py-1">Einheit</th><th class="py-1 text-right">Wert</th></tr></thead><tbody>';
      for (const key of commonKeys) {
        const v = meters / parseFloat(key);
        tableHtml += `<tr class="border-t border-border"><td class="py-1">${leuNames[key]}</td><td class="py-1 text-right font-mono">${fmt(v)} ${leuUnits[key]}</td></tr>`;
      }
      tableHtml += '</tbody></table>';
      document.getElementById('leu-table')!.innerHTML = tableHtml;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('leu-value')!.addEventListener('input', calcLeu);
      document.getElementById('leu-from')!.addEventListener('change', calcLeu);
      document.getElementById('leu-to')!.addEventListener('change', calcLeu);
      calcLeu();
    }, 50);
  </script>
</CalculatorLayout>
