---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ziegel-Rechner - Ziegelsteine f&uuml;r Mauer berechnen";
const description = "Berechnen Sie, wie viele Ziegel Sie f&uuml;r eine Wand oder ein Projekt ben&ouml;tigen. Inkl. M&ouml;rtelfugen, Verschnittfaktor und Kostensch&auml;tzung.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/de/betonrechner", description: "Beton berechnen." },
  { name: "Fl&auml;chenrechner", url: "/de/flaechenrechner", description: "Fl&auml;chen berechnen." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Ziegel-Rechner" lang="de" enSlug="brick-calculator" keywords="ziegel rechner, mauerziegel, m&ouml;rtelfuge, ziegelkosten, mauerbau" breadcrumbs={[{ name: "Ziegel-Rechner", url: "/de/ziegel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ziegel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie den Ziegelbedarf f&uuml;r Ihre Mauer oder Ihr Projekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wandl&auml;nge (m)</label><input type="number" id="bk-len" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wandh&ouml;he (m)</label><input type="number" id="bk-ht" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="0.1"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Ziegelma&szlig;e</h3>
          <div class="grid grid-cols-3 gap-2">
            <div><label class="block text-xs text-text-muted">L&auml;nge (mm)</label><input type="number" id="bk-bl" class="bk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" step="1"></div>
            <div><label class="block text-xs text-text-muted">H&ouml;he (mm)</label><input type="number" id="bk-bh" class="bk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" step="1"></div>
            <div><label class="block text-xs text-text-muted">Fuge (mm)</label><input type="number" id="bk-mj" class="bk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" step="1"></div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label><input type="number" id="bk-waste" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Ziegel (&euro;)</label><input type="number" id="bk-price" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.05"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Ziegel</div>
          <div class="text-5xl font-extrabold font-mono" id="bk-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wandfl&auml;che</div><div class="text-lg font-bold font-mono" id="bk-area">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro m&sup2;</div><div class="text-lg font-bold font-mono" id="bk-persf">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Kosten</div><div class="text-lg font-bold font-mono" id="bk-cost">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">M&ouml;rtel (25kg-S&auml;cke)</div><div class="text-xl font-bold font-mono" id="bk-mortar">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschnitt-Ziegel</div><div class="text-xl font-bold font-mono" id="bk-wcount">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="brick" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Ziegelbedarf berechnen</h2>
      <p>Das deutsche Normalformat (NF) hat die Ma&szlig;e 240 &times; 115 &times; 71 mm. Mit einer Standardfuge von 10 mm ergibt sich ein Bedarf von ca. 48 Ziegeln pro m&sup2; im L&auml;uferverband.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBK() {
      const len = parseFloat((document.getElementById('bk-len') as HTMLInputElement).value) || 0;
      const ht = parseFloat((document.getElementById('bk-ht') as HTMLInputElement).value) || 0;
      const bl = parseFloat((document.getElementById('bk-bl') as HTMLInputElement).value) || 240;
      const bh = parseFloat((document.getElementById('bk-bh') as HTMLInputElement).value) || 71;
      const mj = parseFloat((document.getElementById('bk-mj') as HTMLInputElement).value) || 10;
      const waste = parseFloat((document.getElementById('bk-waste') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('bk-price') as HTMLInputElement).value) || 0;
      const areaSqM = len * ht;
      const brickWithMortarL = (bl + mj) / 1000;
      const brickWithMortarH = (bh + mj) / 1000;
      const bricksPerSqM = brickWithMortarL > 0 && brickWithMortarH > 0 ? 1 / (brickWithMortarL * brickWithMortarH) : 0;
      const baseBricks = Math.ceil(areaSqM * bricksPerSqM);
      const wasteBricks = Math.ceil(baseBricks * waste / 100);
      const totalBricks = baseBricks + wasteBricks;
      const mortarBags = Math.ceil(areaSqM * 1.2);
      document.getElementById('bk-result')!.textContent = totalBricks.toLocaleString('de-DE');
      document.getElementById('bk-area')!.textContent = areaSqM.toFixed(1).replace('.', ',') + ' m\u00B2';
      document.getElementById('bk-persf')!.textContent = bricksPerSqM.toFixed(1).replace('.', ',');
      document.getElementById('bk-cost')!.textContent = (totalBricks * price).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('bk-mortar')!.textContent = mortarBags.toString();
      document.getElementById('bk-wcount')!.textContent = wasteBricks.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bk-len') as HTMLInputElement).value = '6';
      (document.getElementById('bk-ht') as HTMLInputElement).value = '2.5';
      (document.getElementById('bk-bl') as HTMLInputElement).value = '240';
      (document.getElementById('bk-bh') as HTMLInputElement).value = '71';
      (document.getElementById('bk-mj') as HTMLInputElement).value = '10';
      (document.getElementById('bk-waste') as HTMLInputElement).value = '5';
      (document.getElementById('bk-price') as HTMLInputElement).value = '0.60';
      document.querySelectorAll('.bk-in').forEach(el => { el.addEventListener('input', calcBK); el.addEventListener('change', calcBK); });
      calcBK();
    }, 50);
  </script>
</CalculatorLayout>
