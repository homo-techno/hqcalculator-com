---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Weiderotation Rechner - Flächenbedarf & Tierbestand";
const description = "Planen Sie die Weiderotation und berechnen Sie Flächenbedarf pro Tier, Anzahl Koppeln und Ruhezeiten für optimale Weidewirtschaft.";

const relatedCalcs = [
  { name: "Hektar-Rechner", url: "/de/hektar-rechner", description: "Fläche berechnen." },
  { name: "Ertragsrechner", url: "/de/ertragsrechner", description: "Ernte schätzen." },
  { name: "Tierbestand-Rechner", url: "/de/tierbestand-rechner", description: "Tierbestand." },
  { name: "Futterrechner", url: "/de/futterrechner", description: "Futtermenge." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Weiderotation Rechner" lang="de" enSlug="pasture-rotation-calculator" keywords="weiderotation rechner, koppelwirtschaft berechnen, flächenbedarf weide, weidetage tier, weidemanagement" breadcrumbs={[{ name: "Weiderotation Rechner", url: "/de/weiderotation-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Weiderotation Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie optimale Weiderotationen für Ihren Tierbestand und berechnen Sie Flächenbedarf und Koppelanzahl.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tierart</label>
            <select id="wr-animal" class="wr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="cattle">Rinder (Milchkuh)</option>
              <option value="beef">Rinder (Fleisch)</option>
              <option value="horse">Pferde</option>
              <option value="sheep">Schafe</option>
              <option value="goat">Ziegen</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Tiere</label><input type="number" id="wr-count" class="wr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Besatzzeit pro Koppel (Tage)</label><input type="number" id="wr-grazedays" class="wr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ruhezeit (Tage)</label><input type="number" id="wr-rest" class="wr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="10" max="90" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesamtfläche (ha)</label><input type="number" id="wr-totalha" class="wr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0.1" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Weidesaison (Monate)</label><input type="number" id="wr-season" class="wr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="12" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Koppelanzahl</div>
          <div class="text-4xl font-extrabold font-mono" id="wr-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fläche/Koppel</div><div class="text-xl font-bold" id="wr-perpad">0 ha</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bedarf/Tier (ha)</div><div class="text-xl font-bold" id="wr-pertier">0 ha</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rotationszyklen</div><div class="text-xl font-bold" id="wr-cycles">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tiereinheiten (GVE)</div><div class="text-xl font-bold" id="wr-gve">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Besatzdichte (GVE/ha)</div><div class="text-xl font-bold" id="wr-density">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="weiderotation-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Weiderotation: Grundprinzipien</h2>
      <p class="text-text-secondary mt-2">Eine durchdachte Weiderotation schützt den Grünlandbestand vor Überweidung und ermöglicht eine vollständige Regeneration der Gräser. Beim Koppelsystem wird die Gesamtfläche in mehrere Parzellen unterteilt. Während die Tiere eine Koppel beweiden, erholen sich die anderen. Für eine Ruhezeit von 35 Tagen und 5 Tage Besatzzeit werden mindestens 8 Koppeln benötigt.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Anzahl Koppeln:</strong> ceil((Ruhezeit + Besatzzeit) / Besatzzeit)</p>
        <p><strong>Besatzdichte:</strong> GVE / Gesamtfläche (ha)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist eine Tiereinheit (GVE)?</strong> Eine Großvieheinheit (GVE) entspricht einem Rind mit 500 kg Lebendmasse. Andere Tierarten werden über Faktoren umgerechnet: Pferd = 1,1 GVE, Schaf = 0,15 GVE, Ziege = 0,15 GVE.</p>
      <p><strong>Wie lange sollte die Ruhezeit einer Weide sein?</strong> Auf Hochleistungsgrünland in feuchten Lagen: 21–28 Tage. In trockeneren Regionen oder bei extensiver Nutzung: 35–45 Tage. Längere Ruhezeiten fördern tiefwurzelnde Gräser.</p>
      <p><strong>Wie viel Fläche braucht eine Milchkuh?</strong> Als Richtwert gilt ca. 0,3–0,5 ha pro Milchkuh je nach Aufwuchs. Bei intensiver Bewirtschaftung mit Zufütterung kann dieser Wert unterschritten werden.</p>
      <p><strong>Was ist der Vorteil der Kurzrasenweide?</strong> Bei der Kurzrasenweide grasen Tiere auf einer großen Fläche und halten den Bestand gleichmäßig kurz. Dies ist arbeitsextensiver als das Koppelsystem, erfordert aber eine höhere Gesamtfläche.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcWR() {
      const animal = (document.getElementById('wr-animal') as HTMLSelectElement).value;
      const count = parseInt((document.getElementById('wr-count') as HTMLInputElement).value) || 20;
      const grazeDays = parseInt((document.getElementById('wr-grazedays') as HTMLInputElement).value) || 5;
      const restDays = parseInt((document.getElementById('wr-rest') as HTMLInputElement).value) || 35;
      const totalHa = parseFloat((document.getElementById('wr-totalha') as HTMLInputElement).value) || 10;
      const seasonMonths = parseInt((document.getElementById('wr-season') as HTMLInputElement).value) || 6;

      const gveFactor: Record<string, number> = { cattle: 1.0, beef: 0.8, horse: 1.1, sheep: 0.15, goat: 0.15 };
      const haPerGVE: Record<string, number> = { cattle: 0.4, beef: 0.5, horse: 0.5, sheep: 0.35, goat: 0.3 };
      const gve = count * (gveFactor[animal] || 1.0);
      const requiredHa = gve * (haPerGVE[animal] || 0.4);

      const numPaddocks = Math.ceil((restDays + grazeDays) / grazeDays);
      const haPerPaddock = totalHa / numPaddocks;
      const seasonDays = seasonMonths * 30;
      const cycles = Math.floor(seasonDays / (grazeDays + restDays));
      const density = totalHa > 0 ? gve / totalHa : 0;

      document.getElementById('wr-result')!.textContent = numPaddocks.toLocaleString('de-DE');
      document.getElementById('wr-perpad')!.textContent = haPerPaddock.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ha';
      document.getElementById('wr-pertier')!.textContent = (requiredHa / count).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ha';
      document.getElementById('wr-cycles')!.textContent = cycles.toLocaleString('de-DE');
      document.getElementById('wr-gve')!.textContent = gve.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('wr-density')!.textContent = density.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.wr-in').forEach(el => { el.addEventListener('input', calcWR); el.addEventListener('change', calcWR); });
      calcWR();
    }, 50);
  </script>
</CalculatorLayout>
