---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hitzeindex-Rechner - Gef&uuml;hlte Temperatur";
const description = "Berechnen Sie den Hitzeindex (gef&uuml;hlte Temperatur) aus Lufttemperatur und relativer Luftfeuchtigkeit.";

const relatedCalcs = [
  { name: "Windchill-Rechner", url: "/de/windchill-rechner", description: "Windchill-Temperatur." },
  { name: "Temperatur-Umrechner", url: "/de/temperatur-umrechner", description: "Temperatur umrechnen." },
  { name: "Wasseraufnahme-Rechner", url: "/de/wasseraufnahme-rechner", description: "Wasseraufnahme." },
  { name: "Hitzestress-Rechner", url: "/de/hitzestress-rechner", description: "Hitzestress-Risiko." },
  { name: "Taupunkt-Rechner", url: "/de/taupunkt-rechner", description: "Taupunkt." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Hitzeindex-Rechner"
  keywords="hitzeindex rechner, gef&uuml;hlte temperatur, scheinbare temperatur, luftfeuchtigkeit hitze, hitzegef&auml;hr"
  breadcrumbs={[{ name: "Hitzeindex-Rechner", url: "/de/hitzeindex-rechner" }]}
  lang="de"
  enSlug="heat-index-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hitzeindex-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie sich die Temperatur mit Luftfeuchtigkeit "anf&uuml;hlt".</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Temperatur (&deg;C)</label><input type="number" id="hide-temp" class="hide-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="35" min="15" max="55" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Luftfeuchtigkeit (%)</label><input type="number" id="hide-hum" class="hide-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="60" min="0" max="100" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Hitzeindex (Gef&uuml;hlte Temperatur)</div>
          <div class="text-5xl font-extrabold font-mono" id="hide-result">0&deg;C</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="hide-danger-box">
          <div class="font-bold text-sm" id="hide-danger">-</div>
          <div class="text-xs mt-1" id="hide-effects">-</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hitzeindex (&deg;F)</div><div class="text-xl font-bold font-mono" id="hide-fahrenheit">0&deg;F</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erh&ouml;hung</div><div class="text-xl font-bold font-mono" id="hide-inc">+0&deg;C</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Hitzeindex-Skala</h3>
          <div class="text-xs space-y-1">
            <div class="flex gap-2"><span class="w-3 h-3 rounded bg-yellow-400 flex-shrink-0 mt-0.5"></span>Vorsicht: 27-32&deg;C &mdash; Erm&uuml;dung m&ouml;glich</div>
            <div class="flex gap-2"><span class="w-3 h-3 rounded bg-orange-400 flex-shrink-0 mt-0.5"></span>Extreme Vorsicht: 32-39&deg;C &mdash; Hitzekr&auml;mpfe/-ersch&ouml;pfung</div>
            <div class="flex gap-2"><span class="w-3 h-3 rounded bg-red-400 flex-shrink-0 mt-0.5"></span>Gef&auml;hrlich: 39-51&deg;C &mdash; Hitzschlag wahrscheinlich</div>
            <div class="flex gap-2"><span class="w-3 h-3 rounded bg-red-700 flex-shrink-0 mt-0.5"></span>Extrem gef&auml;hrlich: 51&deg;C+ &mdash; Hitzschlag unmittelbar</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="hitzeindex-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist der Hitzeindex?</h2>
      <p>Der Hitzeindex (auch Schwuligkeit oder Apparent Temperature genannt) kombiniert Lufttemperatur und relative Luftfeuchtigkeit, um anzugeben, wie hei&szlig; es sich wirklich anf&uuml;hlt. Hohe Luftfeuchtigkeit verringert die Verdunstung vom K&ouml;rper und erh&ouml;ht das Hitzestress-Risiko erheblich.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum f&uuml;hlt sich feuchte Hitze schlimmer an?</strong> Bei hoher Luftfeuchtigkeit kann der K&ouml;rper weniger schwitzen, weil die Luft bereits viel Feuchtigkeit enth&auml;lt. Schwitzen ist der Hauptk&uuml;hlmechanismus des K&ouml;rpers, daher f&uuml;hlt sich der gleiche Temperatur bei h&ouml;herer Feuchtigkeit hei&szlig;er an.</p>
      <p><strong>Ab welchem Hitzeindex ist Vorsicht geboten?</strong> Ab einem Hitzeindex von 27&deg;C ist Erm&uuml;dung m&ouml;glich. Ab 32&deg;C sind Hitzekr&auml;mpfe und -ersch&ouml;pfung m&ouml;glich, besonders bei k&ouml;rperlicher Aktivit&auml;t.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHIDE() {
      const tC = parseFloat((document.getElementById('hide-temp') as HTMLInputElement).value) || 25;
      const rh = parseFloat((document.getElementById('hide-hum') as HTMLInputElement).value) || 40;
      const tF = tC * 9 / 5 + 32;

      let hi = 0.5 * (tF + 61.0 + ((tF - 68.0) * 1.2) + (rh * 0.094));
      if (hi >= 80) {
        hi = -42.379 + 2.04901523*tF + 10.14333127*rh - 0.22475541*tF*rh
          - 0.00683783*tF*tF - 0.05481717*rh*rh + 0.00122874*tF*tF*rh
          + 0.00085282*tF*rh*rh - 0.00000199*tF*tF*rh*rh;
        if (rh < 13 && tF >= 80 && tF <= 112) hi -= ((13 - rh) / 4) * Math.sqrt((17 - Math.abs(tF - 95)) / 17);
        if (rh > 85 && tF >= 80 && tF <= 87) hi += ((rh - 85) / 10) * ((87 - tF) / 5);
      }

      const hiC = (hi - 32) * 5 / 9;
      const incC = hiC - tC;

      document.getElementById('hide-result')!.textContent = hiC.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '\u00B0C';
      document.getElementById('hide-fahrenheit')!.textContent = hi.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '\u00B0F';
      document.getElementById('hide-inc')!.textContent = '+' + incC.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '\u00B0C';

      let danger: string, effects: string, color: string;
      if (hiC < 27) { danger = 'Normal'; effects = 'Keine hitzebedingten Bedenken'; color = 'bg-green-50 text-green-800'; }
      else if (hiC < 32) { danger = 'Vorsicht'; effects = 'Erm\u00FCdung bei l\u00E4ngerer Belastung m\u00F6glich'; color = 'bg-yellow-50 text-yellow-800'; }
      else if (hiC < 39) { danger = 'Extreme Vorsicht'; effects = 'Hitzekr\u00E4mpfe und -ersch\u00F6pfung m\u00F6glich'; color = 'bg-orange-50 text-orange-800'; }
      else if (hiC < 51) { danger = 'Gef\u00E4hrlich'; effects = 'Hitzekr\u00E4mpfe, Ersch\u00F6pfung wahrscheinlich; Hitzschlag m\u00F6glich'; color = 'bg-red-50 text-red-800'; }
      else { danger = 'Extrem gef\u00E4hrlich'; effects = 'Hitzschlag hoch wahrscheinlich'; color = 'bg-red-100 text-red-900'; }

      document.getElementById('hide-danger')!.textContent = danger;
      document.getElementById('hide-effects')!.textContent = effects;
      document.getElementById('hide-danger-box')!.className = 'p-4 rounded-xl text-center ' + color;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hide-in').forEach(el => el.addEventListener('input', calcHIDE));
      calcHIDE();
    }, 50);
  </script>
</CalculatorLayout>
