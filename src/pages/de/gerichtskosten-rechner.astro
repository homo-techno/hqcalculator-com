---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gerichtskosten-Rechner - Gebuehren nach Streitwert berechnen";
const description = "Berechnen Sie Gerichtskosten und Gebuehren basierend auf Verfahrensart und Streitwert. Schaetzen Sie Gesamtkosten fuer Zivilverfahren, Familienrecht und Verwaltungsgerichte.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
  { name: "Zinsrechner", url: "/de/zinseszinsrechner", description: "Zinsen berechnen." },
  { name: "Steuerrechner", url: "/de/steuerrechner", description: "Steuern berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Waehrungsrechner", url: "/de/waehrungsrechner", description: "Waehrung umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gerichtskosten-Rechner" keywords="Gerichtskosten Rechner, Gebuehren, Streitwert, Zivilverfahren, Familienrecht, Gerichtsgebuehren" breadcrumbs={[{ name: "Gerichtskosten-Rechner", url: "/de/gerichtskosten-rechner" }]} lang="de" enSlug="court-fee-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gerichtskosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie Gerichtsgebuehren nach Verfahrensart und Streitwert.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Verfahrensart</label>
          <select id="gkr-case" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="civil-limited">Zivilverfahren - bis 5.000 EUR</option>
            <option value="civil-unlimited" selected>Zivilverfahren - ueber 5.000 EUR</option>
            <option value="family">Familienrecht (Scheidung, Sorgerecht)</option>
            <option value="small-claims">Mahnverfahren</option>
            <option value="probate">Nachlassverfahren</option>
            <option value="criminal">Strafverfahren</option>
            <option value="eviction">Raeumungsklage</option>
            <option value="name-change">Namensaenderung</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gerichtsinstanz</label>
          <select id="gkr-level" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="state-trial" selected>Amtsgericht / Landgericht</option>
            <option value="state-appeal">Oberlandesgericht</option>
            <option value="federal-district">Bundesgericht 1. Instanz</option>
            <option value="federal-appeal">Bundesgerichtshof</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Streitwert (EUR)</label>
          <input type="number" id="gkr-value" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl zusaetzlicher Antraege</label>
          <input type="number" id="gkr-motions" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="20" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Prozesskostenhilfe?</label>
          <select id="gkr-waiver" class="gkr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none" selected>Nicht beantragt</option>
            <option value="partial">Teilweise (50 %)</option>
            <option value="full">Volle Prozesskostenhilfe</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzte Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="gkr-total"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gerichtsgebuehr</div>
            <div class="text-xl font-bold text-secondary" id="gkr-filing"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Antragsgebuehren</div>
            <div class="text-xl font-bold" id="gkr-motion-cost"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gebuehrenwert</div>
            <div class="text-xl font-bold text-orange-600" id="gkr-fee-value"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">PKH-Ersparnis</div>
            <div class="text-xl font-bold text-green-600" id="gkr-waiver-amt"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="court-fee" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gerichtskosten in Deutschland verstehen</h2>
      <p>Gerichtskosten in Deutschland richten sich nach dem Gerichtskostengesetz (GKG) und dem Streitwert. Die Gebuehren werden in Gebuehrensaetzen berechnet, die sich am Streitwert orientieren. Prozesskostenhilfe ist fuer Personen mit geringem Einkommen verfuegbar.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Wie berechnen sich Gerichtskosten?</strong> Die Kosten basieren auf dem Streitwert und werden in Gebuehrensaetzen berechnet.</li>
        <li><strong>Wer traegt die Kosten?</strong> In der Regel traegt die unterlegene Partei die Gerichtskosten.</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmtGKR = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' \u20AC';

    function calcGKR() {
      const caseType = (document.getElementById('gkr-case') as HTMLSelectElement).value;
      const courtLevel = (document.getElementById('gkr-level') as HTMLSelectElement).value;
      const streitwert = parseFloat((document.getElementById('gkr-value') as HTMLInputElement).value) || 0;
      const motions = parseInt((document.getElementById('gkr-motions') as HTMLInputElement).value) || 0;
      const waiver = (document.getElementById('gkr-waiver') as HTMLSelectElement).value;

      const baseFees: Record<string, number> = {
        'civil-limited': 225, 'civil-unlimited': 435, 'family': 355,
        'small-claims': 75, 'probate': 465, 'criminal': 60,
        'eviction': 240, 'name-change': 435
      };

      const levelMultipliers: Record<string, number> = {
        'state-trial': 1.0, 'state-appeal': 1.4,
        'federal-district': 1.15, 'federal-appeal': 1.3
      };

      // GKG-Gebuehrenberechnung vereinfacht
      let filingFee = (baseFees[caseType] || 350) * (levelMultipliers[courtLevel] || 1);
      // Streitwert-Zuschlag
      if (streitwert > 5000) filingFee += Math.floor(streitwert / 5000) * 50;

      const motionFee = motions * 65;
      let subtotal = filingFee + motionFee;
      let discount = 0;
      if (waiver === 'partial') discount = subtotal * 0.5;
      else if (waiver === 'full') discount = subtotal;

      const total = subtotal - discount;

      document.getElementById('gkr-total')!.textContent = fmtGKR(total);
      document.getElementById('gkr-filing')!.textContent = fmtGKR(filingFee);
      document.getElementById('gkr-motion-cost')!.textContent = fmtGKR(motionFee);
      document.getElementById('gkr-fee-value')!.textContent = streitwert.toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('gkr-waiver-amt')!.textContent = '-' + fmtGKR(discount);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.gkr-in').forEach(el => {
        el.addEventListener('input', calcGKR);
        el.addEventListener('change', calcGKR);
      });
      calcGKR();
    }, 50);
  </script>
</CalculatorLayout>
