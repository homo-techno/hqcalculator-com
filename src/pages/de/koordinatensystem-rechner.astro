---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Koordinatensystem-Rechner - WGS84, NAD83, NAD27, ETRS89";
const description = "Konvertieren Sie geografische Koordinaten zwischen geodaetischen Bezugssystemen wie WGS84, NAD83, NAD27 und ETRS89 mit Molodensky-Transformationen.";

const relatedCalcs = [
  { name: "Koordinatenumrechner", url: "/de/koordinatenumrechner", description: "DD/DMS/UTM-Umrechnung." },
  { name: "GPS-Genauigkeit", url: "/de/gps-genauigkeit-rechner", description: "GPS-Fehlersch\u00e4tzung." },
  { name: "Entfernung & Peilung", url: "/de/entfernung-peilung-rechner", description: "GPS-Entfernung." },
  { name: "Gro\u00dfkreis-Rechner", url: "/de/grosskreis-rechner", description: "Gro\u00dfkreisentfernung." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="datum-conversion-calculator" calculatorName="Koordinatensystem-Rechner" keywords="datum konvertierung, WGS84, NAD83, NAD27, ETRS89, Molodensky, geodaetisches datum, koordinatentransformation" breadcrumbs={[{ name: "Koordinatensystem-Rechner", url: "/de/koordinatensystem-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Koordinatensystem-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Konvertieren Sie Koordinaten zwischen geod&auml;tischen Bezugssystemen mit vereinfachter Molodensky-Transformation.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Von Datum</label>
            <select id="ks2-from" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="NAD27">NAD27</option>
              <option value="WGS84" selected>WGS84</option>
              <option value="NAD83">NAD83</option>
              <option value="ETRS89">ETRS89</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Nach Datum</label>
            <select id="ks2-to" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="NAD27">NAD27</option>
              <option value="WGS84">WGS84</option>
              <option value="NAD83" selected>NAD83</option>
              <option value="ETRS89">ETRS89</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Breitengrad (DD)</label>
            <input type="number" id="ks2-lat" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="52.5200" step="0.000001">
          </div>
          <div>
            <label class="block text-sm font-semibold text-text mb-1">L&auml;ngengrad (DD)</label>
            <input type="number" id="ks2-lon" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="13.4050" step="0.000001">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">H&ouml;he (Meter, ellipsoidisch)</label>
          <input type="number" id="ks2-h" class="ks2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" step="0.1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Konvertierte Koordinaten</div>
          <div class="text-3xl font-extrabold font-mono" id="ks2-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Breitengrad-Verschiebung</div>
            <div class="text-xl font-bold" id="ks2-dlat">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">L&auml;ngengrad-Verschiebung</div>
            <div class="text-xl font-bold" id="ks2-dlon">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">H&ouml;hen&auml;nderung</div>
          <div class="text-xl font-bold" id="ks2-dh">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="datum-conversion" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Datumstransformation</h2>
      <p>Dieser Rechner verwendet die vereinfachte Molodensky-Transformation mit Standard-Translationsparametern (dX, dY, dZ) zwischen Bezugssystemen. WGS84 und NAD83 sind nahezu identisch (Unterschiede kleiner als 2 Meter). NAD27 kann je nach Standort um Dutzende Meter von WGS84 abweichen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ETRS89?</strong> Das Europ&auml;ische Terrestrische Referenzsystem 1989 ist das Standard-Bezugssystem f&uuml;r Europa und praktisch identisch mit WGS84.</p>
      <p><strong>Wann brauche ich eine Datumstransformation?</strong> Wenn Sie Koordinaten aus verschiedenen Quellen oder Epochen kombinieren, z.B. historische Karten mit modernem GPS.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKS2() {
      const fromDatum = (document.getElementById('ks2-from') as HTMLSelectElement).value;
      const toDatum = (document.getElementById('ks2-to') as HTMLSelectElement).value;
      const lat = parseFloat((document.getElementById('ks2-lat') as HTMLInputElement).value) || 0;
      const lon = parseFloat((document.getElementById('ks2-lon') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('ks2-h') as HTMLInputElement).value) || 0;
      const toWGS84: Record<string, number[]> = {
        'WGS84': [0, 0, 0, 0, 0],
        'NAD83': [0.9956, -1.9013, -0.5215, 0.0, 0.0],
        'NAD27': [-8, 160, 176, -69.4, -0.37264639],
        'ETRS89': [0, 0, 0, 0, 0],
      };
      const p1 = toWGS84[fromDatum] || [0,0,0,0,0];
      const p2 = toWGS84[toDatum] || [0,0,0,0,0];
      const dx = p1[0] - p2[0];
      const dy = p1[1] - p2[1];
      const dz = p1[2] - p2[2];
      const da = p1[3] - p2[3];
      const df = (p1[4] - p2[4]) * 1e-4;
      const aWGS = 6378137;
      const fWGS = 1 / 298.257223563;
      const a = aWGS + p1[3];
      const f = fWGS + p1[4] * 1e-4;
      const e2 = 2 * f - f * f;
      const latR = lat * Math.PI / 180;
      const lonR = lon * Math.PI / 180;
      const sinLat = Math.sin(latR);
      const cosLat = Math.cos(latR);
      const sinLon = Math.sin(lonR);
      const cosLon = Math.cos(lonR);
      const Rn = a / Math.sqrt(1 - e2 * sinLat * sinLat);
      const Rm = a * (1 - e2) / Math.pow(1 - e2 * sinLat * sinLat, 1.5);
      const dLat = (-dx * sinLat * cosLon - dy * sinLat * sinLon + dz * cosLat + (a * df + f * da) * Math.sin(2 * latR)) / (Rm + h);
      const dLon = (-dx * sinLon + dy * cosLon) / ((Rn + h) * cosLat);
      const dH = dx * cosLat * cosLon + dy * cosLat * sinLon + dz * sinLat - a * df * sinLat * sinLat - da * (1 - e2) * Rn / a + da;
      const newLat = lat + dLat * 180 / Math.PI;
      const newLon = lon + dLon * 180 / Math.PI;
      document.getElementById('ks2-result')!.textContent = newLat.toFixed(8) + ', ' + newLon.toFixed(8);
      const dLatSec = dLat * 180 / Math.PI * 3600;
      const dLonSec = dLon * 180 / Math.PI * 3600;
      document.getElementById('ks2-dlat')!.textContent = dLatSec.toFixed(4) + '"';
      document.getElementById('ks2-dlon')!.textContent = dLonSec.toFixed(4) + '"';
      document.getElementById('ks2-dh')!.textContent = dH.toFixed(3) + ' m';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ks2-in').forEach(el => { el.addEventListener('input', calcKS2); el.addEventListener('change', calcKS2); });
      calcKS2();
    }, 50);
  </script>
</CalculatorLayout>
