---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Audiokabel-Rechner - Kapazität, Widerstand & Signalverlust";
const description = "Berechnen Sie Kapazität, Widerstand und Signalverlust von Audiokabeln basierend auf Länge und Querschnitt. Finden Sie maximale Kabellängen für verschiedene Anwendungen.";
const relatedCalcs = [
  { name: "Ohmsches Gesetz", url: "/ohms-law-calculator", description: "Elektrische Berechnungen." },
  { name: "Kondensator-Rechner", url: "/capacitor-calculator", description: "Kondensatorwerte." },
  { name: "Frequenzrechner", url: "/frequency-calculator", description: "Frequenzeinheiten." },
  { name: "Dezibel-Rechner", url: "/decibel-calculator", description: "Dezibel-Rechnung." },
  { name: "Spulenrechner", url: "/inductor-calculator", description: "Spulenwerte." },
  { name: "LED-Widerstand", url: "/led-resistor-calculator", description: "Widerstandswerte." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Audiokabel-Rechner" keywords="Audiokabel, Kabelkapazität, Kabelwiderstand, Signalverlust, Kabellänge, Lautsprecherkabel, Instrumentenkabel" lang="de" breadcrumbs={[{ name: "Audiokabel", url: "/de/audiokabel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Audiokabel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die elektrischen Eigenschaften und den Signalverlust von Kabeln für Audioanwendungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kabeltyp</label>
            <select id="cb-type" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="instrument">Instrumentenkabel (unsymmetrisch)</option>
              <option value="microphone">Mikrofonkabel (symmetrisch)</option>
              <option value="speaker" selected>Lautsprecherkabel</option>
              <option value="rca">Cinch / Koaxial</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kabelquerschnitt (mm\u00B2)</label>
            <select id="cb-gauge" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="10">5,3 mm\u00B2 (10 AWG)</option>
              <option value="12" selected>3,3 mm\u00B2 (12 AWG)</option>
              <option value="14">2,1 mm\u00B2 (14 AWG)</option>
              <option value="16">1,3 mm\u00B2 (16 AWG)</option>
              <option value="18">0,82 mm\u00B2 (18 AWG)</option>
              <option value="20">0,52 mm\u00B2 (20 AWG)</option>
              <option value="22">0,33 mm\u00B2 (22 AWG)</option>
              <option value="24">0,20 mm\u00B2 (24 AWG)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kabellänge (Meter)</label>
            <input type="number" id="cb-len" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0.5" max="300" step="0.5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Lautsprecher-Impedanz (Ohm)</label>
            <input type="number" id="cb-imp" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg" min="1" max="100" step="1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Signalfrequenz (Hz)</label>
          <input type="number" id="cb-freq" class="cb-in w-full px-4 py-3 border border-border rounded-xl text-lg" min="20" max="20000" step="10">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Kabelwiderstand</div>
          <div class="text-4xl font-extrabold font-mono" id="cb-res">0 \u03A9</div>
          <div class="text-sm text-blue-200 mt-1" id="cb-pct">0 % der Lastimpedanz</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kabelkapazität</div><div class="text-xl font-bold font-mono" id="cb-cap">0 pF</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Signalverlust</div><div class="text-xl font-bold font-mono" id="cb-loss">0 dB</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Resonanzfrequenz</div><div class="text-xl font-bold font-mono" id="cb-resfreq">0 Hz</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leistungsverlust (W bei 100 W)</div><div class="text-xl font-bold font-mono" id="cb-ploss">0 W</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Maximale empfohlene Kabellängen</div>
          <div class="grid grid-cols-2 gap-2" id="cb-maxruns"></div>
        </div>
      </div>
      <ShareButton calculatorId="audio-cable" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const awgResistance: Record<string, number> = {
      '10': 1.00, '12': 1.59, '14': 2.52, '16': 4.02, '18': 6.39, '20': 10.1, '22': 16.1, '24': 25.7
    };
    const awgMm2: Record<string, string> = {
      '10': '5,3', '12': '3,3', '14': '2,1', '16': '1,3', '18': '0,82', '20': '0,52', '22': '0,33', '24': '0,20'
    };
    const capPerFt: Record<string, number> = {
      instrument: 30, microphone: 20, speaker: 15, rca: 25
    };

    function calcCB() {
      const type = (document.getElementById('cb-type') as HTMLSelectElement).value;
      const gauge = (document.getElementById('cb-gauge') as HTMLSelectElement).value;
      const lenM = parseFloat((document.getElementById('cb-len') as HTMLInputElement).value) || 0;
      const imp = parseFloat((document.getElementById('cb-imp') as HTMLInputElement).value) || 8;
      const freq = parseFloat((document.getElementById('cb-freq') as HTMLInputElement).value) || 1000;

      if (lenM <= 0) return;
      const lenFt = lenM * 3.281;

      const resPerKft = awgResistance[gauge] || 1.59;
      const totalRes = resPerKft * (lenFt * 2) / 1000;
      const resPct = (totalRes / imp) * 100;

      document.getElementById('cb-res')!.textContent = totalRes.toLocaleString('de-DE', { maximumFractionDigits: 3 }) + ' \u03A9';
      document.getElementById('cb-pct')!.textContent = resPct.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' % der Lastimpedanz';

      const capPF = (capPerFt[type] || 25) * lenFt;
      document.getElementById('cb-cap')!.textContent = capPF >= 1000 ? (capPF / 1000).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' nF' : capPF.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' pF';

      const capF = capPF * 1e-12;
      const signalLoss = -20 * Math.log10(imp / Math.sqrt(imp * imp + Math.pow(totalRes, 2)));
      document.getElementById('cb-loss')!.textContent = signalLoss.toLocaleString('de-DE', { maximumFractionDigits: 3 }) + ' dB';

      const resFreq = 1 / (2 * Math.PI * Math.sqrt(totalRes * 0.001 * capF));
      document.getElementById('cb-resfreq')!.textContent = resFreq > 0 && isFinite(resFreq) ? (resFreq / 1000).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' kHz' : '--';

      const powerLoss = 100 * (totalRes / (imp + totalRes));
      document.getElementById('cb-ploss')!.textContent = powerLoss.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' W';

      const maxRuns = document.getElementById('cb-maxruns')!;
      const gauges = ['12', '14', '16', '18'];
      maxRuns.innerHTML = gauges.map(g => {
        const r = awgResistance[g] || 1.59;
        const maxFt = (imp * 0.05 * 1000) / (r * 2);
        const maxM = (maxFt * 0.3048).toLocaleString('de-DE', { maximumFractionDigits: 1 });
        return '<div class="text-sm"><span class="font-bold">' + (awgMm2[g] || g) + ' mm\u00B2:</span> <span class="font-mono">' + maxM + ' m</span> <span class="text-text-muted">(5 % Verlust)</span></div>';
      }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('cb-len') as HTMLInputElement).value = '8';
      (document.getElementById('cb-imp') as HTMLInputElement).value = '8';
      (document.getElementById('cb-freq') as HTMLInputElement).value = '1000';
      document.querySelectorAll('.cb-in').forEach(el => { el.addEventListener('input', calcCB); el.addEventListener('change', calcCB); });
      calcCB();
    }, 50);
  </script>
</CalculatorLayout>
