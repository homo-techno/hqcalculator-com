---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blitzentfernung Rechner – Abstand zum Gewitter berechnen";
const description = "Berechnen Sie die Entfernung eines Blitzes anhand der Zeitdifferenz zwischen Blitz und Donner. Mit Sicherheitstipps für Gewitter.";
const relatedCalcs = [
  { name: "Lichtlaufzeit Rechner", url: "/de/lichtlaufzeit-rechner", description: "Lichtgeschwindigkeit." },
  { name: "Lichtintensität Rechner", url: "/de/lichtintensitaet-rechner", description: "Lux & Lumen." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
  { name: "Lineare Gleichung Rechner", url: "/de/lineare-gleichung-rechner", description: "Gleichungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="lightning-distance-calculator" calculatorName="Blitzentfernung Rechner" keywords="Blitzentfernung berechnen, Donner Blitz Sekunden, Gewitter Entfernung, Schallgeschwindigkeit" breadcrumbs={[{ name: "Blitzentfernung Rechner", url: "/de/blitzentfernung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blitzentfernung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie weit ein Blitz entfernt ist – zählen Sie die Sekunden zwischen Blitz und Donner.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Zeitdifferenz: Blitz bis Donner (Sekunden)</label>
          <input type="number" id="blt-sek" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="5" step="0.5" min="0">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Lufttemperatur (°C)</label>
          <input type="number" id="blt-temp" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="1" min="-50" max="50">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Entfernung des Blitzes</div>
          <div class="text-5xl font-extrabold font-mono" id="blt-result">0 km</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="blt-details"></div>
        <div id="blt-warnung" class="p-4 rounded-xl text-sm font-semibold text-center hidden"></div>
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl">
          <h3 class="font-semibold text-sm text-amber-800 mb-1">Sicherheitshinweis</h3>
          <p class="text-xs text-amber-700">Bei weniger als 10 km Entfernung sofort Schutz suchen! Suchen Sie ein Gebäude oder ein Auto mit Metall-Karosserie auf. Meiden Sie freie Flächen, Bäume und Gewässer.</p>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="blitzentfernung" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Die 3-Sekunden-Regel beim Gewitter</h2>
      <p>Da Licht mit ca. 300.000 km/s fast instantan ankommt, kann man die Zeit zwischen Blitz und Donner nutzen, um die Entfernung zu berechnen. Die Schallgeschwindigkeit beträgt bei 20°C ca. 343 m/s. Als grobe Faustregel gilt: 3 Sekunden = ca. 1 km Entfernung. Unter 10 km (unter 30 Sekunden) besteht Blitzgefahr – sofort Schutz suchen!</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie schnell ist der Schall bei verschiedenen Temperaturen?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die Schallgeschwindigkeit hängt von der Temperatur ab: v = 331,3 + 0,606 × T (m/s). Bei 0°C sind es 331 m/s, bei 20°C 343 m/s, bei 35°C 352 m/s.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Warum sieht man den Blitz vor dem Donner?</summary>
          <p class="mt-2 text-sm text-text-secondary">Licht bewegt sich mit ca. 300.000 km/s, Schall nur mit ca. 343 m/s. Licht ist also fast eine Million Mal schneller und erreicht uns praktisch sofort, während der Schall einige Sekunden braucht.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Ab wann ist ein Gewitter gefährlich?</summary>
          <p class="mt-2 text-sm text-text-secondary">Experten empfehlen bei unter 30 Sekunden (ca. 10 km) sofort Schutz zu suchen. Die 30-30-Regel: Bei unter 30 Sekunden zwischen Blitz und Donner Schutz suchen und 30 Minuten nach dem letzten Donner warten.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Kann man von einem Blitz getroffen werden, wenn der Donner noch nicht zu hören ist?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ja! Blitze können seitlich über 10 km Entfernung schlagen (sog. "Blitz aus heiterem Himmel"). Daher sollte man auch bei weitem Donner Schutz suchen, bevor das Gewitter näher kommt.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBlt() {
      const sek = parseFloat((document.getElementById('blt-sek') as HTMLInputElement).value) || 0;
      const temp = parseFloat((document.getElementById('blt-temp') as HTMLInputElement).value) || 20;
      const schall = 331.3 + 0.606 * temp; // m/s
      const distM = sek * schall;
      const distKm = distM / 1000;

      const fmt = (v: number, u: string, d = 2) => v.toLocaleString('de-DE', { maximumFractionDigits: d }) + ' ' + u;
      document.getElementById('blt-result')!.textContent = fmt(distKm, 'km');
      document.getElementById('blt-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Entfernung (m)</div><div class="text-lg font-bold font-mono">${fmt(distM, 'm', 0)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schallgeschwindigkeit</div><div class="text-lg font-bold font-mono">${fmt(schall, 'm/s')}</div></div>`;

      const warnEl = document.getElementById('blt-warnung')!;
      if (distKm < 3) {
        warnEl.className = 'p-4 rounded-xl text-sm font-semibold text-center bg-red-100 text-red-800 border border-red-300';
        warnEl.textContent = 'GEFAHR! Blitz sehr nahe – sofort sicheres Gebäude aufsuchen!';
        warnEl.classList.remove('hidden');
      } else if (distKm < 10) {
        warnEl.className = 'p-4 rounded-xl text-sm font-semibold text-center bg-orange-100 text-orange-800 border border-orange-300';
        warnEl.textContent = 'Warnung! Gewitter in unmittelbarer Nähe – Schutz suchen!';
        warnEl.classList.remove('hidden');
      } else if (distKm < 20) {
        warnEl.className = 'p-4 rounded-xl text-sm font-semibold text-center bg-yellow-100 text-yellow-800 border border-yellow-300';
        warnEl.textContent = 'Achtung! Gewitter nähert sich – Schutzmöglichkeiten bereithalten.';
        warnEl.classList.remove('hidden');
      } else {
        warnEl.classList.add('hidden');
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('blt-sek')!.addEventListener('input', calcBlt);
      document.getElementById('blt-temp')!.addEventListener('input', calcBlt);
      calcBlt();
    }, 50);
  </script>
</CalculatorLayout>
