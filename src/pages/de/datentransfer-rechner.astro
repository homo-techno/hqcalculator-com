---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Datentransfer-Rechner - Uebertragungszeit berechnen";
const description = "Berechnen Sie die Uebertragungszeit einer Datei basierend auf Dateigroesse und Bandbreite. Unterstuetzt alle gaengigen Groessen- und Geschwindigkeitseinheiten.";

const relatedCalcs = [
  { name: "Datenspeicher-Umrechner", url: "/de/datenspeicher-umrechner", description: "Speichereinheiten." },
  { name: "Bandbreiten-Rechner", url: "/de/bandbreiten-rechner", description: "Netzwerkbandbreite." },
  { name: "Prozentrechner", url: "/de/prozent-rechner", description: "Prozentrechnung." },
  { name: "Pixel-Rechner", url: "/de/pixel-rechner", description: "Pixel." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="data-transfer-calculator" calculatorName="Datentransfer-Rechner" keywords="datentransfer rechner, uebertragungszeit, download zeit, upload zeit, bandbreite, transfergeschwindigkeit" breadcrumbs={[{ name: "Datentransfer-Rechner", url: "/de/datentransfer-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Datentransfer-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die &Uuml;bertragungszeit basierend auf Dateigr&ouml;&szlig;e und verf&uuml;gbarer Bandbreite.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-4">
        <label class="block text-sm font-medium text-text mb-1">Dateigr&ouml;&szlig;e</label>
        <div class="flex gap-2">
          <input type="number" id="dtc-size" class="dtc-in flex-1 px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.7" step="0.1" min="0">
          <select id="dtc-size-unit" class="dtc-in px-4 py-3 border border-border rounded-xl text-lg">
            <option value="B">Bytes</option>
            <option value="KB">KB</option>
            <option value="MB">MB</option>
            <option value="GB" selected>GB</option>
            <option value="TB">TB</option>
          </select>
        </div>
      </div>

      <div class="mb-4">
        <label class="block text-sm font-medium text-text mb-1">&Uuml;bertragungsgeschwindigkeit</label>
        <div class="flex gap-2">
          <input type="number" id="dtc-speed" class="dtc-in flex-1 px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" step="0.1" min="0.001">
          <select id="dtc-speed-unit" class="dtc-in px-4 py-3 border border-border rounded-xl text-lg">
            <option value="bps">bps</option>
            <option value="Kbps">Kbps</option>
            <option value="Mbps" selected>Mbps</option>
            <option value="Gbps">Gbps</option>
            <option value="KBps">KB/s</option>
            <option value="MBps">MB/s</option>
            <option value="GBps">GB/s</option>
          </select>
        </div>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-medium text-text mb-1">Effizienz (%)</label>
        <input type="number" id="dtc-efficiency" class="dtc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" step="1" min="1" max="100">
        <p class="text-xs text-text-muted mt-1">Protokoll-Overhead ber&uuml;cksichtigen (TCP ~90-95%, real ~70-90%)</p>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm font-medium text-blue-100 mb-1">&Uuml;bertragungszeit</div>
        <div class="text-4xl font-extrabold" id="dtc-result">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted mb-1">Sekunden gesamt</div>
          <div class="text-xl font-bold text-text" id="dtc-seconds">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted mb-1">Effektive Geschwindigkeit</div>
          <div class="text-xl font-bold text-text" id="dtc-effective">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted mb-1">Dateigr&ouml;&szlig;e (Bits)</div>
          <div class="text-xl font-bold text-text" id="dtc-bits">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted mb-1">Dateigr&ouml;&szlig;e (Bytes)</div>
          <div class="text-xl font-bold text-text" id="dtc-bytes">--</div>
        </div>
      </div>

      <div class="bg-surface-alt rounded-xl p-4 mb-6">
        <h3 class="font-semibold text-text mb-3 text-sm">&Uuml;bertragungszeiten bei g&auml;ngigen Geschwindigkeiten</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="text-text-muted text-xs uppercase"><th class="pb-2 text-left">Geschwindigkeit</th><th class="pb-2 text-right">Zeit</th></tr></thead>
            <tbody id="dtc-table"></tbody>
          </table>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="data-transfer" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">So berechnen Sie die &Uuml;bertragungszeit</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono text-sm">
        Zeit (Sekunden) = Dateigr&ouml;&szlig;e (Bits) / (Geschwindigkeit (bps) &times; Effizienz)
      </div>
      <p>Internetgeschwindigkeiten werden in Bits pro Sekunde (Mbit/s) gemessen, w&auml;hrend Dateigr&ouml;&szlig;en in Bytes angegeben werden. Es gibt 8 Bits pro Byte. Reale Geschwindigkeiten liegen aufgrund von Protokoll-Overhead, Auslastung und Latenz unter dem theoretischen Maximum.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum dauert mein Download l&auml;nger als berechnet?</strong> Reale Geschwindigkeiten werden durch Netzwerklast, WLAN-Interferenzen und Entfernung zum Server beeinflusst.</p>
      <p><strong>Was ist der Unterschied zwischen Mbit/s und MB/s?</strong> 1 MB/s = 8 Mbit/s. Internetanbieter geben die Geschwindigkeit in Mbit/s an.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcDTC() {
      const sizeVal = parseFloat((document.getElementById('dtc-size') as HTMLInputElement).value) || 0;
      const sizeUnit = (document.getElementById('dtc-size-unit') as HTMLSelectElement).value;
      const speedVal = parseFloat((document.getElementById('dtc-speed') as HTMLInputElement).value) || 0.001;
      const speedUnit = (document.getElementById('dtc-speed-unit') as HTMLSelectElement).value;
      const efficiency = (parseFloat((document.getElementById('dtc-efficiency') as HTMLInputElement).value) || 90) / 100;

      const sizeMultipliers: Record<string, number> = { B: 1, KB: 1024, MB: 1048576, GB: 1073741824, TB: 1099511627776 };
      const sizeBytes = sizeVal * (sizeMultipliers[sizeUnit] || 1);
      const sizeBits = sizeBytes * 8;

      const speedMultipliers: Record<string, number> = { bps: 1, Kbps: 1000, Mbps: 1e6, Gbps: 1e9, KBps: 8000, MBps: 8e6, GBps: 8e9 };
      const speedBps = speedVal * (speedMultipliers[speedUnit] || 1);

      const effectiveBps = speedBps * efficiency;
      const seconds = sizeBits / effectiveBps;

      const formatTime = (s: number) => {
        if (s < 1) return (s * 1000).toFixed(0) + ' ms';
        if (s < 60) return s.toFixed(1) + ' Sek';
        if (s < 3600) return Math.floor(s / 60) + ' Min ' + Math.floor(s % 60) + ' Sek';
        if (s < 86400) return Math.floor(s / 3600) + ' Std ' + Math.floor((s % 3600) / 60) + ' Min ' + Math.floor(s % 60) + ' Sek';
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        return d + ' T ' + h + ' Std ' + Math.floor((s % 3600) / 60) + ' Min';
      };

      const formatBytes = (b: number) => {
        if (b >= 1099511627776) return (b / 1099511627776).toFixed(2) + ' TB';
        if (b >= 1073741824) return (b / 1073741824).toFixed(2) + ' GB';
        if (b >= 1048576) return (b / 1048576).toFixed(2) + ' MB';
        if (b >= 1024) return (b / 1024).toFixed(2) + ' KB';
        return b.toFixed(0) + ' B';
      };

      const formatBits = (b: number) => {
        if (b >= 1e12) return (b / 1e12).toFixed(2) + ' Tb';
        if (b >= 1e9) return (b / 1e9).toFixed(2) + ' Gb';
        if (b >= 1e6) return (b / 1e6).toFixed(2) + ' Mb';
        if (b >= 1e3) return (b / 1e3).toFixed(2) + ' Kb';
        return b.toFixed(0) + ' b';
      };

      document.getElementById('dtc-result')!.textContent = formatTime(seconds);
      document.getElementById('dtc-seconds')!.textContent = seconds.toLocaleString('de-DE', { maximumFractionDigits: 2 });
      document.getElementById('dtc-effective')!.textContent = (effectiveBps / 1e6).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Mbps';
      document.getElementById('dtc-bits')!.textContent = formatBits(sizeBits);
      document.getElementById('dtc-bytes')!.textContent = formatBytes(sizeBytes);

      const speeds = [1, 10, 25, 50, 100, 250, 500, 1000, 10000];
      const tbody = document.getElementById('dtc-table')!;
      tbody.innerHTML = speeds.map(sp => {
        const t = sizeBits / (sp * 1e6 * efficiency);
        const spLabel = sp >= 1000 ? (sp / 1000) + ' Gbps' : sp + ' Mbps';
        return '<tr class="text-text-secondary border-b border-border/20"><td class="py-1.5">' + spLabel + '</td><td class="py-1.5 text-right">' + formatTime(t) + '</td></tr>';
      }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dtc-in').forEach(el => { el.addEventListener('input', calcDTC); el.addEventListener('change', calcDTC); });
      calcDTC();
    }, 50);
  </script>
</CalculatorLayout>
