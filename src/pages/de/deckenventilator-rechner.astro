---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Deckenventilator-Rechner – Größe, Luftstrom & Energieeinsparung";
const description = "Berechnen Sie die richtige Deckenventilatorgröße für Ihren Raum, den benötigten Luftstrom (CFM) und die Energieeinsparung im Vergleich zur Klimaanlage.";
const relatedCalcs = [
  { name: "Teppich-Rechner", url: "/de/teppich-rechner", description: "Teppich." },
  { name: "Kubikmeter-Rechner", url: "/de/kubikmeter-rechner", description: "Volumen." },
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
  { name: "CO₂-Fußabdruck-Rechner", url: "/de/co2-fussabdruck-rechner", description: "CO₂." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Deckenventilator-Rechner" enSlug="ceiling-fan-calculator" keywords="Deckenventilator, Ventilatorgröße, CFM, Luftstrom, Energieeinsparung, Raumkühlung" breadcrumbs={[{ name: "Deckenventilator-Rechner", url: "/de/deckenventilator-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Deckenventilator-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die richtige Ventilatorgröße für Ihren Raum und schätzen Sie die Energieeinsparung gegenüber Klimaanlagen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Raumlänge (m)</label><input type="number" id="dvr-len" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="dvr-wid" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Deckenhöhe (m)</label><input type="number" id="dvr-ht" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="2" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Klimaanlagenkosten (€/Stunde)</label><input type="number" id="dvr-ac" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.01"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kühlstunden pro Tag</label><input type="number" id="dvr-hrs" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kühlmonate pro Jahr</label><input type="number" id="dvr-months" class="dvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="12" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Ventilatorgröße</div>
          <div class="text-5xl font-extrabold font-mono" id="dvr-result">0 cm</div>
          <div class="text-sm text-blue-200 mt-1" id="dvr-note">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumfläche</div><div class="text-xl font-bold font-mono" id="dvr-area">0 m²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Min. CFM</div><div class="text-xl font-bold font-mono" id="dvr-cfm">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ventilatorleistung</div><div class="text-xl font-bold font-mono" id="dvr-watts">0 W</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährl. Klimakosten</div><div class="text-xl font-bold font-mono" id="dvr-accost">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährl. Einsparung mit Ventilator</div><div class="text-xl font-bold font-mono" id="dvr-savings">0 €</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Montageempfehlung</h3>
          <div class="text-sm" id="dvr-mount">-</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="ceiling-fan" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Deckenventilator richtig auswählen</h2>
      <p>Ein Deckenventilator kann die gefühlte Temperatur um 3-4 °C senken und so die Klimaanlage entlasten. Die richtige Größe hängt von der Raumfläche ab. Deckenventilatoren verbrauchen nur einen Bruchteil der Energie einer Klimaanlage.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcDVR() {
      const roomLenM = parseFloat((document.getElementById('dvr-len') as HTMLInputElement).value) || 4;
      const roomWidM = parseFloat((document.getElementById('dvr-wid') as HTMLInputElement).value) || 3.5;
      const ceilingHtM = parseFloat((document.getElementById('dvr-ht') as HTMLInputElement).value) || 2.7;
      const acCostHr = parseFloat((document.getElementById('dvr-ac') as HTMLInputElement).value) || 0.30;
      const coolHrs = parseFloat((document.getElementById('dvr-hrs') as HTMLInputElement).value) || 6;
      const coolMonths = parseFloat((document.getElementById('dvr-months') as HTMLInputElement).value) || 3;
      const areaSqM = roomLenM * roomWidM;
      const areaSqFt = areaSqM * 10.764;
      let fanSizeIn: number, cfm: number, watts: number;
      if (areaSqFt <= 75) { fanSizeIn = 36; cfm = 2400; watts = 30; }
      else if (areaSqFt <= 144) { fanSizeIn = 42; cfm = 3500; watts = 40; }
      else if (areaSqFt <= 225) { fanSizeIn = 52; cfm = 5000; watts = 55; }
      else if (areaSqFt <= 400) { fanSizeIn = 60; cfm = 7000; watts = 70; }
      else { fanSizeIn = 72; cfm = 9000; watts = 85; }
      const fanSizeCm = Math.round(fanSizeIn * 2.54);
      const fansNeeded = areaSqFt > 400 ? Math.ceil(areaSqFt / 400) : 1;
      const coolingDays = coolMonths * 30;
      const annualACCost = acCostHr * coolHrs * coolingDays;
      const fanAnnualCost = (watts * fansNeeded * coolHrs * coolingDays) / 1000 * 0.30;
      const acSavings = annualACCost * 0.14;
      const netSavings = acSavings - fanAnnualCost;
      const fmt = (v: number) => v.toLocaleString('de-DE', {minimumFractionDigits:0, maximumFractionDigits:0});
      document.getElementById('dvr-result')!.textContent = fanSizeCm + ' cm';
      document.getElementById('dvr-note')!.textContent = fansNeeded > 1 ? fansNeeded + ' Ventilatoren empfohlen f\u00FCr ' + areaSqM.toFixed(1) + ' m²' : fanSizeCm + ' cm Flügelspannweite f\u00FCr ' + areaSqM.toFixed(1) + ' m²';
      document.getElementById('dvr-area')!.textContent = areaSqM.toFixed(1) + ' m²';
      document.getElementById('dvr-cfm')!.textContent = cfm.toLocaleString('de-DE');
      document.getElementById('dvr-watts')!.textContent = watts + ' W';
      document.getElementById('dvr-accost')!.textContent = fmt(annualACCost) + ' €';
      document.getElementById('dvr-savings')!.textContent = fmt(netSavings) + ' €';
      let mount: string;
      if (ceilingHtM < 2.4) { mount = 'Direkte Deckenmontage (Hugger) erforderlich. Mindestens 2,1 m Abstand der Flügel zum Boden.'; }
      else if (ceilingHtM <= 2.7) { mount = 'Standardmontage mit kurzem Stab. Flügel sollten 2,4-2,7 m über dem Boden sein.'; }
      else {
        const downrodCm = Math.round((ceilingHtM - 2.6) * 100);
        mount = 'Verlängerungsstab empfohlen. Verwenden Sie einen ' + downrodCm + ' cm Stab für optimalen Luftstrom bei 2,6 m Flügelhöhe.';
      }
      document.getElementById('dvr-mount')!.textContent = mount;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('dvr-len') as HTMLInputElement).value = '4.5';
      (document.getElementById('dvr-wid') as HTMLInputElement).value = '3.5';
      (document.getElementById('dvr-ht') as HTMLInputElement).value = '2.7';
      (document.getElementById('dvr-ac') as HTMLInputElement).value = '0.30';
      (document.getElementById('dvr-hrs') as HTMLInputElement).value = '6';
      (document.getElementById('dvr-months') as HTMLInputElement).value = '3';
      document.querySelectorAll('.dvr-in').forEach(el => { el.addEventListener('input', calcDVR); el.addEventListener('change', calcDVR); });
      calcDVR();
    }, 50);
  </script>
</CalculatorLayout>
