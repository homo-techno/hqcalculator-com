---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lebensmittelkonservierung-Rechner - Einkochen, Trocknen & Einfrieren";
const description = "Berechnen Sie Einkochzeiten, Dörreinstellungen und Gefriermengen für die Konservierung von Obst, Gemüse und Fleisch.";
const relatedCalcs = [
  { name: "Backumrechner", url: "/de/backumrechner", description: "Backmaße umrechnen." },
  { name: "Rezeptskalierer", url: "/de/rezeptskalierer", description: "Rezepte skalieren." },
  { name: "Temperaturumrechner", url: "/de/temperaturumrechner", description: "Temperatur umrechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Lebensmittelkonservierung-Rechner" lang="de" enSlug="food-preservation-calculator" keywords="lebensmittel konservierung, einkochen zeit, dörren einstellungen, einfrieren, wassereinkochen, druckeinkochen" breadcrumbs={[{ name: "Lebensmittelkonservierung", url: "/de/lebensmittelkonservierung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lebensmittelkonservierung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erhalten Sie Verarbeitungszeiten, Temperaturen und Mengen f&uuml;r das Einkochen, Trocknen und Einfrieren von Lebensmitteln.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Konservierungsmethode</label>
          <select id="lkv-method" class="lkv-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="waterbath">Wasserbad-Einkochen (s&auml;urehaltig)</option>
            <option value="pressure">Druck-Einkochen (s&auml;urearm)</option>
            <option value="dehydrate">D&ouml;rren / Trocknen</option>
            <option value="freeze">Einfrieren</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Lebensmittelart</label>
          <select id="lkv-food" class="lkv-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="tomatoes">Tomaten</option>
            <option value="peaches">Pfirsiche / Birnen</option>
            <option value="pickles">Essiggurken / Gurken</option>
            <option value="jam">Marmelade / Gelee</option>
            <option value="applesauce">Apfelmus</option>
            <option value="greenbeans">Gr&uuml;ne Bohnen</option>
            <option value="corn">Mais</option>
            <option value="carrots">Karotten</option>
            <option value="chicken">H&uuml;hnchen / Gefl&uuml;gel</option>
            <option value="beef">Rindfleisch / Wild</option>
            <option value="berries">Beeren</option>
            <option value="peppers">Paprika</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Menge (kg Rohware)</label>
            <input type="number" id="lkv-qty" class="lkv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">H&ouml;henlage (Meter)</label>
            <input type="number" id="lkv-alt" class="lkv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="3000" step="100">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Verarbeitungszeit</div>
          <div class="text-5xl font-extrabold font-mono" id="lkv-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Temperatur</div>
            <div class="text-xl font-bold font-mono" id="lkv-temp">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gl&auml;ser / Beh&auml;lter</div>
            <div class="text-xl font-bold font-mono" id="lkv-jars">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ergiebigkeit</div>
            <div class="text-xl font-bold font-mono" id="lkv-yield">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Haltbarkeit</div>
            <div class="text-xl font-bold font-mono" id="lkv-shelf">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Wichtige Hinweise</div>
          <div class="text-sm text-text-secondary" id="lkv-notes">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="food-preservation-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Methoden der Lebensmittelkonservierung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Wasserbad:</strong> F&uuml;r s&auml;urehaltige Lebensmittel (pH &lt; 4,6)</p>
        <p><strong>Druck-Einkochen:</strong> F&uuml;r s&auml;urearme Lebensmittel (Gem&uuml;se, Fleisch)</p>
        <p><strong>D&ouml;rren:</strong> Wasseraktivit&auml;t auf unter 0,6 senken</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum ist Druck-Einkochen f&uuml;r s&auml;urearme Lebensmittel notwendig?</strong> S&auml;urearme Lebensmittel k&ouml;nnen Botulinumtoxin enthalten. Nur Temperaturen &uuml;ber 116&deg;C t&ouml;ten die Sporen zuverl&auml;ssig ab.</p>
      <p><strong>Wie lange sind eingekochte Lebensmittel haltbar?</strong> Bei korrekter Verarbeitung und Lagerung 12-18 Monate. Nach dem &Ouml;ffnen im K&uuml;hlschrank aufbewahren und innerhalb einer Woche verbrauchen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLKV() {
      const method = (document.getElementById('lkv-method') as HTMLSelectElement).value;
      const food = (document.getElementById('lkv-food') as HTMLSelectElement).value;
      const qty = parseFloat((document.getElementById('lkv-qty') as HTMLInputElement).value) || 5;
      const alt = parseFloat((document.getElementById('lkv-alt') as HTMLInputElement).value) || 0;
      const data: Record<string, {wb: number, pres: number, pressPSI: number, kgPerL: number, dehydTemp: number, dehydHrs: number, shelf: string}> = {
        tomatoes:   { wb: 45, pres: 25, pressPSI: 10, kgPerL: 1.4, dehydTemp: 57, dehydHrs: 10, shelf: '12-18 Monate' },
        peaches:    { wb: 30, pres: 10, pressPSI: 6,  kgPerL: 1.1, dehydTemp: 57, dehydHrs: 12, shelf: '12-18 Monate' },
        pickles:    { wb: 15, pres: 10, pressPSI: 6,  kgPerL: 0.7, dehydTemp: 52, dehydHrs: 8,  shelf: '12 Monate' },
        jam:        { wb: 10, pres: 10, pressPSI: 6,  kgPerL: 0.5, dehydTemp: 57, dehydHrs: 14, shelf: '12 Monate' },
        applesauce: { wb: 20, pres: 10, pressPSI: 6,  kgPerL: 1.1, dehydTemp: 57, dehydHrs: 8,  shelf: '12-18 Monate' },
        greenbeans: { wb: 0,  pres: 25, pressPSI: 10, kgPerL: 0.9, dehydTemp: 52, dehydHrs: 10, shelf: '12-18 Monate' },
        corn:       { wb: 0,  pres: 85, pressPSI: 10, kgPerL: 2.0, dehydTemp: 57, dehydHrs: 12, shelf: '12-18 Monate' },
        carrots:    { wb: 0,  pres: 30, pressPSI: 10, kgPerL: 1.1, dehydTemp: 52, dehydHrs: 10, shelf: '12-18 Monate' },
        chicken:    { wb: 0,  pres: 75, pressPSI: 10, kgPerL: 0.9, dehydTemp: 71, dehydHrs: 8,  shelf: '12 Monate' },
        beef:       { wb: 0,  pres: 90, pressPSI: 10, kgPerL: 0.9, dehydTemp: 71, dehydHrs: 8,  shelf: '12 Monate' },
        berries:    { wb: 15, pres: 8,  pressPSI: 6,  kgPerL: 0.7, dehydTemp: 57, dehydHrs: 14, shelf: '12-18 Monate' },
        peppers:    { wb: 0,  pres: 35, pressPSI: 10, kgPerL: 0.5, dehydTemp: 52, dehydHrs: 10, shelf: '12 Monate' },
      };
      const d = data[food] || data['tomatoes'];
      const jars = Math.ceil(qty / d.kgPerL);
      let processTime = 0, tempStr = '', notes = '', shelf = d.shelf;
      const altAdj = Math.max(0, Math.floor((alt - 300) / 300)) * 5;
      if (method === 'waterbath') {
        if (d.wb === 0) {
          processTime = 0;
          tempStr = 'NICHT SICHER f\u00FCr Wasserbad';
          notes = 'Dieses Lebensmittel ist s\u00E4urearm und MUSS unter Druck eingekocht werden. Botulismus-Gefahr!';
        } else {
          processTime = d.wb + altAdj;
          tempStr = '100\u00B0C (kochend)';
          notes = '1 cm Kopfraum einhalten. Verarbeitungszeit beginnt, wenn das Wasser wieder sprudelnd kocht.';
        }
      } else if (method === 'pressure') {
        processTime = d.pres + Math.floor(altAdj * 0.5);
        let psi = d.pressPSI;
        if (alt > 300) psi += 5;
        const barVal = (psi * 0.0689476).toFixed(1);
        tempStr = barVal + ' bar (' + (psi === 10 ? '116' : '109') + '\u00B0C)';
        notes = 'Verwenden Sie nur gepr\u00FCfte Einkochrezepte. Stellen Sie sicher, dass das Manometer korrekt ist. Entl\u00FCften Sie 10 Minuten vor dem Druckaufbau.';
      } else if (method === 'dehydrate') {
        processTime = d.dehydHrs * 60;
        tempStr = d.dehydTemp + '\u00B0C';
        shelf = '6-12 Monate (vakuumversiegelt)';
        notes = 'Einsch\u00FCbe alle 2-3 Stunden drehen. Fertig wenn lederartig/knusprig ohne Feuchtigkeitsstellen. In luftdichten Beh\u00E4ltern lagern.';
      } else {
        processTime = 0;
        tempStr = '-18\u00B0C';
        shelf = '8-12 Monate (korrekt verpackt)';
        notes = 'Gem\u00FCse vor dem Einfrieren 2-4 Minuten blanchieren. Gefrierbeutel ohne Luft verwenden oder vakuumversiegeln. Mit Datum beschriften.';
      }
      if (method === 'dehydrate') {
        document.getElementById('lkv-result')!.textContent = d.dehydHrs + '-' + (d.dehydHrs + 4) + ' Stunden';
      } else if (processTime === 0 && method === 'freeze') {
        document.getElementById('lkv-result')!.textContent = 'Schockfrosten 2-4 Std.';
      } else if (processTime === 0) {
        document.getElementById('lkv-result')!.textContent = 'Nicht empfohlen';
      } else {
        document.getElementById('lkv-result')!.textContent = processTime + ' Minuten';
      }
      document.getElementById('lkv-temp')!.textContent = tempStr;
      document.getElementById('lkv-jars')!.textContent = jars + ' Liter-Gl\u00E4ser';
      document.getElementById('lkv-yield')!.textContent = (qty * 0.45).toFixed(1) + ' Liter';
      document.getElementById('lkv-shelf')!.textContent = shelf;
      document.getElementById('lkv-notes')!.textContent = notes;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.lkv-in').forEach(el => { el.addEventListener('input', calcLKV); el.addEventListener('change', calcLKV); });
      calcLKV();
    }, 50);
  </script>
</CalculatorLayout>
