---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Magazin-Layout Rechner – Rastermaße und Spaltenbreiten";
const description = "Berechnen Sie Rastermaße, Spaltenbreiten und Weißraum für Magazinlayouts. Typografisch korrektes Seitenraster für Print und Digital.";

const relatedCalcs = [
  { name: "Maßstabsrechner", url: "/de/massstab-rechner", description: "Maßstäbe." },
  { name: "Makramee Rechner", url: "/de/makramee-rechner", description: "Materialmengen." },
  { name: "Kartenentfernung Rechner", url: "/de/kartenentfernung-rechner", description: "Entfernungen." },
];
---
<CalculatorLayout lang="de" enSlug="magazine-layout-calculator" title={title} description={description} calculatorName="Magazin-Layout Rechner" keywords="Magazin Layout Rechner, Spaltenbreite, Seitenraster, Typografie, Printlayout" breadcrumbs={[{ name: "Magazin-Layout Rechner", url: "/de/magazin-layout-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Magazin-Layout Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie optimale Spaltenbreiten, Stege und Randabstände für professionelle Magazinlayouts.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Seitenformat</label>
          <select id="ml-format" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="210_297" selected>A4 (210 × 297 mm)</option>
            <option value="148_210">A5 (148 × 210 mm)</option>
            <option value="215_280">US Letter (215 × 280 mm)</option>
            <option value="230_300">Magazinformat (230 × 300 mm)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div id="ml-custom" class="hidden grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (mm)</label>
            <input type="number" id="ml-pw" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="210" step="1" min="50">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Höhe (mm)</label>
            <input type="number" id="ml-ph" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="297" step="1" min="50">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Außenrand (mm)</label>
            <input type="number" id="ml-outer" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="20" step="0.5" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Innenrand/Bund (mm)</label>
            <input type="number" id="ml-inner" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="15" step="0.5" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kopfsteg (mm)</label>
            <input type="number" id="ml-top" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="18" step="0.5" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fußsteg (mm)</label>
            <input type="number" id="ml-bottom" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="22" step="0.5" min="0">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Spalten</label>
            <input type="number" id="ml-cols" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="3" step="1" min="1" max="12">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Spaltenabstand (mm)</label>
            <input type="number" id="ml-gutter" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="5" step="0.5" min="0">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Spaltenbreite</div>
          <div class="text-5xl font-extrabold font-mono" id="ml-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="ml-sub">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Textbreite gesamt</div>
            <div class="text-xl font-bold font-mono" id="ml-textw">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Texthöhe gesamt</div>
            <div class="text-xl font-bold font-mono" id="ml-texth">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="magazine-layout" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Grundlagen des Magazinlayouts</h2>
      <p>Ein gutes Magazinlayout basiert auf einem durchdachten Rastersystem. Das Seitenraster definiert Spalten, Randabstände und Weißraum und sorgt für eine konsistente, professionelle Optik. In der Printgestaltung empfiehlt sich ein Innenrand (Bund), der beim gebundenen Magazin nicht verdeckt wird.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Wie viele Spalten sollte ein Magazin haben?</h3>
      <p>Für Textmagazine sind 2–3 Spalten ideal. Lifestyle-Magazine nutzen oft 4–6 Spalten für mehr Flexibilität. Wissenschaftliche Zeitschriften verwenden häufig 2 breite Spalten.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen Innenrand und Außenrand?</h3>
      <p>Der Innenrand (Bund) liegt am Rücken des gebundenen Heftes und sollte etwas größer sein, da er teilweise verdeckt wird. Der Außenrand ist am offenen Rand und kann schmaler sein.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist Weißraum und warum ist er wichtig?</h3>
      <p>Weißraum (Whitespace) sind unbeschriftete Bereiche auf der Seite. Er verbessert Lesbarkeit, lenkt den Blick und lässt das Layout atmen. Weniger ist oft mehr in der Printgestaltung.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcML() {
      const fmt = (document.getElementById('ml-format') as HTMLSelectElement).value;
      const isCustom = fmt === 'custom';
      document.getElementById('ml-custom')!.classList.toggle('hidden', !isCustom);
      let pw: number, ph: number;
      if (isCustom) {
        pw = parseFloat((document.getElementById('ml-pw') as HTMLInputElement).value) || 210;
        ph = parseFloat((document.getElementById('ml-ph') as HTMLInputElement).value) || 297;
      } else {
        const parts = fmt.split('_');
        pw = parseInt(parts[0]);
        ph = parseInt(parts[1]);
      }
      const outer = parseFloat((document.getElementById('ml-outer') as HTMLInputElement).value) || 20;
      const inner = parseFloat((document.getElementById('ml-inner') as HTMLInputElement).value) || 15;
      const top = parseFloat((document.getElementById('ml-top') as HTMLInputElement).value) || 18;
      const bottom = parseFloat((document.getElementById('ml-bottom') as HTMLInputElement).value) || 22;
      const cols = parseInt((document.getElementById('ml-cols') as HTMLInputElement).value) || 3;
      const gutter = parseFloat((document.getElementById('ml-gutter') as HTMLInputElement).value) || 5;
      const textW = pw - outer - inner;
      const textH = ph - top - bottom;
      const colW = (textW - (cols - 1) * gutter) / cols;
      document.getElementById('ml-result')!.textContent = colW.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' mm';
      document.getElementById('ml-sub')!.textContent = cols + ' Spalten × ' + colW.toFixed(1) + ' mm + ' + (cols - 1) + ' Stege à ' + gutter + ' mm';
      document.getElementById('ml-textw')!.textContent = textW.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' mm';
      document.getElementById('ml-texth')!.textContent = textH.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' mm';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['ml-format'].forEach(id => document.getElementById(id)!.addEventListener('change', calcML));
      ['ml-pw', 'ml-ph', 'ml-outer', 'ml-inner', 'ml-top', 'ml-bottom', 'ml-cols', 'ml-gutter'].forEach(id => document.getElementById(id)!.addEventListener('input', calcML));
      calcML();
    }, 50);
  </script>
</CalculatorLayout>
