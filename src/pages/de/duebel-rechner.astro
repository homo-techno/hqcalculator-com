---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Duebel-Rechner - Durchmesser, Tiefe & Abstand 2026";
const description = "Berechne Duebeldurchmesser, -tiefe, -abstand und -anzahl fuer Kanten- und Flaechenverbindungen. Bohrgroesse und Bohrlehren-Empfehlungen.";

const relatedCalcs = [
  { name: "Schwalbenschwanz-Rechner", url: "/de/schwalbenschwanz-rechner", description: "Schwalbenschwanz-Layout." },
  { name: "Holzrechner", url: "/de/holzrechner", description: "Holzberechnung." },
  { name: "Bohrer-Rechner", url: "/de/bohrer-rechner", description: "Bohrergroesse bestimmen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Duebel-Rechner" keywords="Duebel Rechner, Duebeldurchmesser, Duebelabstand, Kantenverbindung, Flaechenverbindung, Duebellehre, Duebeltiefe" breadcrumbs={[{ name: "Duebel-Rechner", url: "/de/duebel-rechner" }]} lang="de" enSlug="dowel-joint-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Duebel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne die optimale Duebelgroesse, -tiefe und -abstande fuer starke Kanten- und Flaechenverbindungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5"><label class="block text-sm font-medium text-text mb-2">Verbindungstyp</label>
        <select id="drde-type" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="edge" selected>Kantenverbindung (Plattenverleimung)</option>
          <option value="face">Flaechenverbindung (T-Verbindung / Rahmen)</option>
          <option value="miter">Gehrungsverbindung (Verstaerkung)</option>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-5">
        <div><label class="block text-sm font-medium text-text mb-2">Brettstaerke (mm)</label><input type="number" id="drde-thick" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="19" min="6" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-2">Verbindungslaenge (mm)</label><input type="number" id="drde-length" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="600" min="50" step="10"></div>
      </div>
      <div class="mb-5"><label class="block text-sm font-medium text-text mb-2">Duebeldurchmesser (mm)</label>
        <select id="drde-diam" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="0">Automatisch (nach Brettstaerke)</option>
          <option value="6">6 mm</option>
          <option value="8">8 mm</option>
          <option value="10">10 mm</option>
          <option value="12">12 mm</option>
        </select>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Duebelanzahl</div>
        <div class="text-4xl font-extrabold" id="drde-count">--</div>
        <div class="text-sm text-blue-200 mt-1" id="drde-count-sub">--</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Duebeldurchmesser</div><div class="text-xl font-bold" id="drde-dd">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Duebellaenge</div><div class="text-xl font-bold" id="drde-dl">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bohrtiefe (je Seite)</div><div class="text-xl font-bold" id="drde-hd">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abstand (Mitte zu Mitte)</div><div class="text-xl font-bold" id="drde-space">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bohrergroesse</div><div class="text-xl font-bold" id="drde-bit">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Randabstand (min)</div><div class="text-xl font-bold" id="drde-edge">--</div></div>
      </div>
      <ShareButton calculatorId="dowel-joint" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Duebelverbindung planen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Duebeldurchmesser = 1/3 bis 1/2 der Brettstaerke</strong></p>
        <p><strong>Duebellaenge = 5x Durchmesser (2,5x je Seite)</strong></p>
        <p><strong>Abstand = 150-200 mm entlang der Verbindung</strong></p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Welchen Duebeldurchmesser waehlen?</strong> Faustregel: 1/3 bis 1/2 der Brettstaerke. Bei 19 mm Brett also 6-10 mm Duebel.</p>
      <p><strong>Brauche ich eine Duebellehre?</strong> Eine Duebellehre ist sehr empfehlenswert fuer praezise Ausrichtung. Ohne Lehre ist eine genaue Bohrung sehr schwierig.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDRDE() {
      const jointType = (document.getElementById('drde-type') as HTMLSelectElement).value;
      const thick = parseFloat((document.getElementById('drde-thick') as HTMLInputElement).value) || 19;
      const length = parseFloat((document.getElementById('drde-length') as HTMLInputElement).value) || 600;
      let dowelDiam = parseFloat((document.getElementById('drde-diam') as HTMLSelectElement).value) || 0;

      if (dowelDiam === 0) {
        const ideal = thick * 0.4;
        const sizes = [6, 8, 10, 12];
        dowelDiam = sizes[0];
        let minDiff = Math.abs(ideal - sizes[0]);
        for (const s of sizes) {
          if (s <= thick * 0.5) {
            const diff = Math.abs(ideal - s);
            if (diff <= minDiff) { minDiff = diff; dowelDiam = s; }
          }
        }
      }

      const lengthMultiplier = jointType === 'edge' ? 5 : 4;
      const dowelLength = Math.round(dowelDiam * lengthMultiplier);
      const holeDepth = dowelLength / 2 + 2;
      const idealSpacing = jointType === 'miter' ? 100 : 150;
      const dowelCount = Math.max(2, Math.ceil(length / idealSpacing) + 1);
      const actualSpacing = length / (dowelCount - 1);
      const edgeDist = Math.max(50, actualSpacing / 2);

      document.getElementById('drde-count')!.textContent = dowelCount.toString();
      document.getElementById('drde-count-sub')!.textContent = 'Duebel auf ' + length + ' mm Verbindung';
      document.getElementById('drde-dd')!.textContent = dowelDiam + ' mm';
      document.getElementById('drde-dl')!.textContent = dowelLength + ' mm';
      document.getElementById('drde-hd')!.textContent = holeDepth.toFixed(0) + ' mm';
      document.getElementById('drde-space')!.textContent = actualSpacing.toFixed(0) + ' mm';
      document.getElementById('drde-bit')!.textContent = dowelDiam + ' mm Holzbohrer';
      document.getElementById('drde-edge')!.textContent = edgeDist.toFixed(0) + ' mm';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.drde-in').forEach(el => { el.addEventListener('input', calcDRDE); el.addEventListener('change', calcDRDE); });
      calcDRDE();
    }, 50);
  </script>
</CalculatorLayout>
