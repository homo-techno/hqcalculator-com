---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquakultur-Futterrechner - FVR, Tagesfutter & Erntezeitplan";
const description = "Berechnen Sie Futterverwertungsrate, tägliche Futtermenge, Wachstumsrate und Erntezeitplan für Aquakultur-Fischzuchtbetriebe.";
const relatedCalcs = [
  { name: "Aquaponik", url: "/de/aquaponik-rechner", description: "Aquaponik-Systemdesign." },
  { name: "Fischbesatz", url: "/de/fischbesatz-rechner", description: "Fischbesatzmengen." },
  { name: "Teichbesatz", url: "/de/teichbesatz-rechner", description: "Teich-Fischbesatz." },
  { name: "Aquarium", url: "/de/aquarium-rechner", description: "Aquarium-Berechnungen." },
  { name: "Wasserqualität", url: "/de/wasserqualitaet-rechner", description: "Wasserqualitätsanalyse." },
  { name: "Angelschnur", url: "/de/angelschnur-rechner", description: "Angelschnur-Auswahl." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquakultur-Futterrechner" keywords="Aquakultur-Futterrechner, FVR, Futterverwertungsrate, Fischfutter, Fischwachstumsrate, Erntezeitplan, Fischzucht" breadcrumbs={[{ name: "Aquakultur-Futter", url: "/de/aquakultur-futter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquakultur-Futterrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie optimale Fütterungsraten, Futterverwertungsraten und Erntezeitpläne für Fischzuchtbetriebe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fischart</label>
            <select id="af2-species" class="af2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1.6">Tilapia (FVR 1,6)</option>
              <option value="1.2">Lachs (FVR 1,2)</option>
              <option value="1.3">Forelle (FVR 1,3)</option>
              <option value="1.8">Wels (FVR 1,8)</option>
              <option value="1.5">Barramundi (FVR 1,5)</option>
              <option value="2.0">Garnele (FVR 2,0)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Fische</label><input type="number" id="af2-count" class="af2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Durchschn.-Gewicht (g)</label><input type="number" id="af2-curr" class="af2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ziel-Erntegewicht (g)</label><input type="number" id="af2-target" class="af2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wassertemp. (&deg;C)</label><input type="number" id="af2-temp" class="af2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="10" max="35" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Futterkosten (&euro;/kg)</label><input type="number" id="af2-cost" class="af2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.01" step="0.10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Tägliche Futtermenge</div>
          <div class="text-5xl font-extrabold font-mono" id="af2-daily">--</div>
          <div class="text-sm text-blue-200 mt-1">kg/Tag</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fütterungsrate</div><div class="text-xl font-bold" id="af2-rate">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtfutter</div><div class="text-xl font-bold" id="af2-total">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Futterkosten</div><div class="text-xl font-bold" id="af2-fcost">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tage bis Ernte</div><div class="text-xl font-bold" id="af2-days">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wachstumsrate</div><div class="text-xl font-bold" id="af2-growth">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ernteertrag</div><div class="text-xl font-bold" id="af2-yield">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquaculture-feed" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAF2() {
      const fcr = parseFloat((document.getElementById('af2-species') as HTMLSelectElement).value) || 1.6;
      const count = parseInt((document.getElementById('af2-count') as HTMLInputElement).value) || 0;
      const currWt = parseFloat((document.getElementById('af2-curr') as HTMLInputElement).value) || 0;
      const targetWt = parseFloat((document.getElementById('af2-target') as HTMLInputElement).value) || 0;
      const temp = parseFloat((document.getElementById('af2-temp') as HTMLInputElement).value) || 25;
      const feedCostPerKg = parseFloat((document.getElementById('af2-cost') as HTMLInputElement).value) || 0;

      const tempFactor = temp >= 25 ? 1.0 : temp >= 20 ? 0.8 : temp >= 15 ? 0.5 : 0.3;
      const sizeFactor = currWt < 50 ? 5 : currWt < 200 ? 3 : currWt < 500 ? 2 : 1.5;
      const feedRatePct = sizeFactor * tempFactor;

      const dailyPerFishG = currWt * (feedRatePct / 100);
      const dailyTotalKg = (dailyPerFishG * count) / 1000;

      const dailyGainG = dailyPerFishG / fcr;

      const weightGain = targetWt - currWt;
      const daysToHarvest = dailyGainG > 0 ? weightGain / dailyGainG : 0;

      const totalFeedKg = (weightGain * count * fcr) / 1000;
      const totalFeedCost = totalFeedKg * feedCostPerKg;

      const harvestKg = (targetWt * count) / 1000;

      const fmtDE = (v: number) => v.toLocaleString('de-DE');

      document.getElementById('af2-daily')!.textContent = dailyTotalKg > 0 ? dailyTotalKg.toFixed(1).replace('.', ',') : '--';
      document.getElementById('af2-rate')!.textContent = feedRatePct > 0 ? feedRatePct.toFixed(1).replace('.', ',') + '% KG' : '--';
      document.getElementById('af2-total')!.textContent = totalFeedKg > 0 ? fmtDE(Math.round(totalFeedKg)) + ' kg' : '--';
      document.getElementById('af2-fcost')!.textContent = totalFeedCost > 0 ? fmtDE(Math.round(totalFeedCost)) + ' \u20AC' : '--';
      document.getElementById('af2-days')!.textContent = daysToHarvest > 0 ? Math.round(daysToHarvest).toString() : '--';
      document.getElementById('af2-growth')!.textContent = dailyGainG > 0 ? dailyGainG.toFixed(1).replace('.', ',') + ' g/Tag' : '--';
      document.getElementById('af2-yield')!.textContent = harvestKg > 0 ? fmtDE(Math.round(harvestKg)) + ' kg' : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('af2-count') as HTMLInputElement).value = '5000';
      (document.getElementById('af2-curr') as HTMLInputElement).value = '100';
      (document.getElementById('af2-target') as HTMLInputElement).value = '500';
      (document.getElementById('af2-temp') as HTMLInputElement).value = '26';
      (document.getElementById('af2-cost') as HTMLInputElement).value = '1.20';
      document.querySelectorAll('.af2-in').forEach(el => { el.addEventListener('input', calcAF2); el.addEventListener('change', calcAF2); });
      calcAF2();
    }, 50);
  </script>
</CalculatorLayout>
