---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Nachlassplanung-Rechner - Erbschaftssteuer & Trust-Ersparnisse";
const description = "Sch\u00e4tzen Sie die Erbschaftssteuerbelastung, Nachlasskosten und potenzielle Trust-Ersparnisse f\u00fcr eine effiziente Nachlassplanung.";

const relatedCalcs = [
  { name: "Verm\u00f6gensrechner", url: "/de/vermoegensrechner", description: "Nettoverm\u00f6gen berechnen." },
  { name: "Lebensversicherung-Rechner", url: "/de/lebensversicherung-rechner", description: "Lebensversicherung." },
  { name: "Rentenrechner", url: "/de/rentenrechner", description: "Ruhestandsplanung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlagerenditen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Nachlassplanung-Rechner" lang="de" enSlug="estate-planning-calculator" keywords="nachlassplanung rechner, erbschaftssteuer, nachlasskosten, trust ersparnisse, erben, testament" breadcrumbs={[{ name: "Nachlassplanung-Rechner", url: "/de/nachlassplanung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Nachlassplanung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Erbschaftssteuern, Nachlasskosten und Ersparnisse durch eine Stiftung/Trust.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Gesamter Nachlasswert</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="npl-estate" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="2500000" min="0" step="50000">
            </div>
            <p class="text-xs text-text-muted mt-1">Immobilien, Investitionen, Rentenkonten, Versicherungen, Gesch&auml;ftsanteile</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl der Erben</label>
            <input type="number" id="npl-beneficiaries" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="1" max="20" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Steuerklasse</label>
            <select id="npl-filing" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="single" selected>Einzelperson</option>
              <option value="married">Ehepaar (mit Freibetrags&uuml;bertragung)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Nachlassplan-Typ</label>
            <select id="npl-plan" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="none">Kein Trust (nur Testament / Nachlassgericht)</option>
              <option value="revocable" selected>Widerrufliche Stiftung</option>
              <option value="irrevocable">Unwiderrufliche Stiftung</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Steuerklasse der Erben</label>
            <select id="npl-state" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="class1" selected>Steuerklasse I (Ehepartner/Kinder)</option>
              <option value="class2">Steuerklasse II (Geschwister/Nichten)</option>
              <option value="class3">Steuerklasse III (Andere)</option>
            </select>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Erbschaftssteuer</div>
            <div class="text-5xl font-extrabold font-mono" id="npl-tax">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Nachlasskosten</div>
              <div class="text-xl font-bold text-red-600" id="npl-probate">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Trust-Ersparnisse</div>
              <div class="text-xl font-bold text-green-600" id="npl-trust-savings">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Pro Erbe</div>
              <div class="text-xl font-bold" id="npl-per-bene">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Netto an Erben</div>
              <div class="text-xl font-bold text-secondary" id="npl-net">0 &euro;</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Freibetrag verwendet</div>
            <div class="text-sm font-bold" id="npl-exemption">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="estate-planning-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Erbschaftssteuer und Nachlassplanung in Deutschland</h2>
      <p>In Deutschland gelten je nach Steuerklasse unterschiedliche Freibetr&auml;ge: Ehepartner 500.000 &euro;, Kinder 400.000 &euro;, Enkel 200.000 &euro;. Die Steuers&auml;tze liegen zwischen 7% und 50% je nach Steuerklasse und Wert.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Testament vs. Stiftung</h3>
      <p>Eine <strong>widerrufliche Stiftung</strong> vermeidet Nachlassgerichtskosten und bietet Privatsph&auml;re. Eine <strong>unwiderrufliche Stiftung</strong> kann die Erbschaftssteuerbelastung reduzieren, da Verm&ouml;genswerte aus dem steuerpflichtigen Nachlass entfernt werden.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Freibetr&auml;ge gibt es?</strong> Ehepartner: 500.000 &euro;, Kinder: 400.000 &euro;, Enkel: 200.000 &euro;, Geschwister: 20.000 &euro;, Sonstige: 20.000 &euro;.</p>
      <p><strong>Wie oft k&ouml;nnen Freibetr&auml;ge genutzt werden?</strong> Freibetr&auml;ge erneuern sich alle 10 Jahre, was eine langfristige Nachlassplanung erm&ouml;glicht.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const nplFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcNPL() {
      const estate = parseFloat((document.getElementById('npl-estate') as HTMLInputElement).value) || 0;
      const beneficiaries = parseInt((document.getElementById('npl-beneficiaries') as HTMLInputElement).value) || 1;
      const filing = (document.getElementById('npl-filing') as HTMLSelectElement).value;
      const plan = (document.getElementById('npl-plan') as HTMLSelectElement).value;
      const stateLevel = (document.getElementById('npl-state') as HTMLSelectElement).value;

      // German exemptions per beneficiary
      const exemptions: Record<string, number> = {
        'class1': filing === 'married' ? 500000 : 400000,
        'class2': 20000,
        'class3': 20000
      };
      const exemptionPer = exemptions[stateLevel] || 400000;
      const totalExemption = exemptionPer * beneficiaries;

      // Taxable estate
      let taxableEstate = plan === 'irrevocable' ? estate * 0.6 : estate;
      let taxableAfterExemption = Math.max(0, taxableEstate - totalExemption);

      // German tax rates by class
      const rates: Record<string, number> = { 'class1': 0.15, 'class2': 0.25, 'class3': 0.30 };
      const rate = rates[stateLevel] || 0.15;
      let totalTax = taxableAfterExemption * rate;

      // Probate costs (Nachlassgerichtskosten ~1-3%)
      let probateCost = 0;
      if (plan === 'none') {
        if (estate < 500000) probateCost = estate * 0.03;
        else if (estate < 2000000) probateCost = estate * 0.02;
        else probateCost = estate * 0.015;
      }

      const trustSavings = plan !== 'none' ? (
        estate < 500000 ? estate * 0.03 :
        estate < 2000000 ? estate * 0.02 :
        estate * 0.015
      ) : 0;

      const netToHeirs = estate - totalTax - probateCost;
      const perBeneficiary = netToHeirs / beneficiaries;

      const exemptionText = taxableEstate <= totalExemption
        ? nplFmt(totalExemption) + ' (Nachlass unter Freibetrag)'
        : nplFmt(totalExemption) + ' (' + nplFmt(taxableAfterExemption) + ' steuerpflichtig)';

      document.getElementById('npl-tax')!.textContent = nplFmt(totalTax);
      document.getElementById('npl-probate')!.textContent = nplFmt(probateCost);
      document.getElementById('npl-trust-savings')!.textContent = nplFmt(trustSavings);
      document.getElementById('npl-per-bene')!.textContent = nplFmt(perBeneficiary);
      document.getElementById('npl-net')!.textContent = nplFmt(netToHeirs);
      document.getElementById('npl-exemption')!.textContent = exemptionText;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['npl-estate', 'npl-beneficiaries'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcNPL); el.addEventListener('change', calcNPL); }
      });
      ['npl-filing', 'npl-plan', 'npl-state'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('change', calcNPL); }
      });
      calcNPL();
    }, 50);
  </script>
</CalculatorLayout>
