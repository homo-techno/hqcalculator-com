---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Elektrische Last-Rechner - Leistungsbedarf & Absicherung";
const description = "Berechnen Sie die elektrische Gesamtlast Ihrer Anlage. Ermitteln Sie den Strombedarf, die benötigte Absicherung und den Gleichzeitigkeitsfaktor.";

const relatedCalcs = [
  { name: "Schaltschrank-Rechner", url: "/de/schaltschrank-rechner", description: "Verteilung planen." },
  { name: "Ohmsches Gesetz", url: "/de/ohmsches-gesetz-rechner", description: "U=I*R." },
  { name: "Kabelquerschnitt-Rechner", url: "/de/kabelquerschnitt-rechner", description: "Kabelquerschnitt." },
  { name: "Elektrokosten-Rechner", url: "/de/elektrokosten-rechner", description: "Stromkosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Elektrische Last-Rechner" lang="de" enSlug="electrical-load-calculator" keywords="elektrische last rechner, leistungsbedarf, absicherung berechnen, gleichzeitigkeitsfaktor, stromaufnahme" breadcrumbs={[{ name: "Elektrische Last-Rechner", url: "/de/elektrische-last-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Elektrische Last-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die elektrische Gesamtlast, den Strombedarf und die ben&ouml;tigte Absicherung f&uuml;r Ihre Anlage.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Spannung (V)</label><input type="number" id="ell-volt" class="ell-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Phasen</label><select id="ell-phase" class="ell-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="1">Einphasig (230V)</option><option value="3">Dreiphasig (400V)</option></select></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Verbraucher (Watt, kommagetrennt)</label><textarea id="ell-loads" class="ell-in w-full px-4 py-3 border border-border rounded-xl text-sm font-mono" rows="3" placeholder="z.B. 2000, 1500, 3500, 800"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gleichzeitigkeitsfaktor</label><input type="number" id="ell-gf" class="ell-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.05" min="0" max="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Leistungsfaktor (cos&phi;)</label><input type="number" id="ell-pf" class="ell-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.05" min="0.1" max="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtlast</div>
          <div class="text-5xl font-extrabold font-mono" id="ell-result">0 W</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Strom (A)</div><div class="text-xl font-bold" id="ell-amps">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Scheinleistung (VA)</div><div class="text-xl font-bold" id="ell-va">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empf. Sicherung</div><div class="text-xl font-bold" id="ell-breaker">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahl Verbraucher</div><div class="text-xl font-bold" id="ell-count">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="ell-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="electrical-load-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Elektrische Last berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Gesamtlast = Summe aller Verbraucher &times; Gleichzeitigkeitsfaktor</p>
        <p>Strom (1~) = Leistung / (Spannung &times; cos&phi;)</p>
        <p>Strom (3~) = Leistung / (&radic;3 &times; Spannung &times; cos&phi;)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Gleichzeitigkeitsfaktor?</strong> Er ber&uuml;cksichtigt, dass nicht alle Ger&auml;te gleichzeitig laufen. Typische Werte: Wohnung 0,4&ndash;0,6, Gewerbe 0,5&ndash;0,8.</p>
      <p><strong>Wie w&auml;hle ich die richtige Sicherung?</strong> Die Sicherung muss gr&ouml;&szlig;er als der berechnete Strom sein, aber den Kabelquerschnitt nicht &uuml;berlasten.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEll() {
      const volt = parseFloat((document.getElementById('ell-volt') as HTMLInputElement).value) || 230;
      const phase = parseInt((document.getElementById('ell-phase') as HTMLSelectElement).value) || 1;
      const loadsStr = (document.getElementById('ell-loads') as HTMLTextAreaElement).value;
      const gf = parseFloat((document.getElementById('ell-gf') as HTMLInputElement).value) || 0.7;
      const pf = parseFloat((document.getElementById('ell-pf') as HTMLInputElement).value) || 0.9;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const loads = loadsStr.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n) && n > 0);
      const totalRaw = loads.reduce((a, b) => a + b, 0);
      steps.push('Verbraucher: ' + loads.length + ' Stueck, Summe = ' + fmt(totalRaw) + ' W');
      const totalLoad = totalRaw * gf;
      steps.push('Gesamtlast = ' + fmt(totalRaw) + ' W x ' + gf + ' (GF) = ' + fmt(totalLoad) + ' W');
      const va = totalLoad / pf;
      steps.push('Scheinleistung = ' + fmt(totalLoad) + ' / ' + pf + ' = ' + fmt(va) + ' VA');
      let amps = 0;
      if (phase === 3) {
        amps = totalLoad / (Math.sqrt(3) * volt * pf);
        steps.push('Strom = ' + fmt(totalLoad) + ' / (1,732 x ' + volt + ' x ' + pf + ') = ' + fmt(amps) + ' A');
      } else {
        amps = totalLoad / (volt * pf);
        steps.push('Strom = ' + fmt(totalLoad) + ' / (' + volt + ' x ' + pf + ') = ' + fmt(amps) + ' A');
      }
      const breakerSizes = [6, 10, 13, 16, 20, 25, 32, 40, 50, 63, 80, 100, 125];
      const breaker = breakerSizes.find(b => b >= amps * 1.25) || breakerSizes[breakerSizes.length - 1];
      steps.push('Empf. Sicherung = ' + breaker + ' A (naechster Nennwert ueber ' + fmt(amps * 1.25) + ' A)');
      document.getElementById('ell-result')!.textContent = fmt(totalLoad) + ' W';
      document.getElementById('ell-amps')!.textContent = fmt(amps) + ' A';
      document.getElementById('ell-va')!.textContent = fmt(va) + ' VA';
      document.getElementById('ell-breaker')!.textContent = breaker + ' A';
      document.getElementById('ell-count')!.textContent = loads.length.toString();
      document.getElementById('ell-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ell-volt') as HTMLInputElement).value = '230';
      (document.getElementById('ell-loads') as HTMLTextAreaElement).value = '2000, 1500, 3500, 800, 1200';
      (document.getElementById('ell-gf') as HTMLInputElement).value = '0.7';
      (document.getElementById('ell-pf') as HTMLInputElement).value = '0.9';
      document.querySelectorAll('.ell-in').forEach(el => { el.addEventListener('input', calcEll); el.addEventListener('change', calcEll); });
      calcEll();
    }, 50);
  </script>
</CalculatorLayout>
