---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Obsidian-Hydration Rechner – Datierung von Obsidian-Artefakten";
const description = "Berechnen Sie Datierungen von Obsidian-Artefakten durch Hydrationsmessung.";
const relatedCalcs = [
  { name: "Meeresversauerung Rechner", url: "/de/meeresversauerung-rechner", description: "Ozean-pH berechnen." },
  { name: "Erzgehalt Rechner", url: "/de/erzgehalt-rechner", description: "Bergbauprojekte." },
  { name: "Umlaufzeit Rechner", url: "/de/umlaufzeit-rechner", description: "Keplersche Gesetze." },
  { name: "Osmotischer Druck Rechner", url: "/de/osmotischer-druck-rechner", description: "Osmotischen Druck." },
];
---
<CalculatorLayout lang="de" enSlug="obsidian-hydration-calculator" title={title} description={description} calculatorName="Obsidian-Hydration Rechner" keywords="Obsidian-Hydration, Datierung, Archäologie, Hydrationsmessung, Obsidian, Artefakt" breadcrumbs={[{ name: "Obsidian-Hydration Rechner", url: "/de/obsidian-hydration-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Obsidian-Hydration Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Alter von Obsidian-Artefakten anhand der gemessenen Hydratationsschichtdicke und der Hydrationskonstante.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Hydratationsdicke (µm)</label>
            <input type="number" id="oh-thick" class="oh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Hydrationskonstante (µm²/Jahr)</label>
            <input type="number" id="oh-k" class="oh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0.01">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mittlere Temperatur (°C)</label>
            <input type="number" id="oh-temp" class="oh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="-20" max="60">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktivierungsenergie (kcal/mol)</label>
            <input type="number" id="oh-ea" class="oh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätztes Alter</div>
          <div class="text-5xl font-extrabold font-mono" id="oh-result">— Jahre</div>
          <div class="text-sm text-blue-200 mt-1" id="oh-subtitle"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Alter (Jahrtausende)</div>
            <div class="text-xl font-bold" id="oh-ka">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Epochenzuordnung</div>
            <div class="text-xl font-bold" id="oh-epoch">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Dicke² (µm²)</div>
            <div class="text-xl font-bold" id="oh-thick2">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Temperaturkorr. K</div>
            <div class="text-xl font-bold" id="oh-tcorr">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsweg</h3>
          <div class="font-mono text-sm space-y-1" id="oh-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="obsidian-hydration" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Obsidian-Hydrationsdatierung</h2>
      <p>Die Obsidian-Hydrationsdatierung ist eine archäologische Datierungsmethode, die auf der Tatsache basiert, dass frisch geschlagene Obsidianflächen Wasser aus der Umgebung absorbieren. Mit der Zeit bildet sich eine messbare Hydratationsschicht. Die Dicke dieser Schicht wächst proportional zur Quadratwurzel der Zeit. Die Methode wurde 1960 von Friedman und Smith entwickelt und ist besonders nützlich für die Datierung von Steinwerkzeugen aus vulkanischem Glas.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>t = x² / k (einfaches Modell)</p>
        <p>x = Hydratationsdicke (µm)</p>
        <p>k = temperaturabhängige Hydrationskonstante (µm²/a)</p>
        <p>Arrhenius-Korrektur: k(T) = A · e^(-Ea/RT)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie genau ist die Obsidian-Hydrationsdatierung?</strong> Die Methode hat typisch Fehlermargen von 10–20%, da die Hydrationskonstante von der Obsidianquelle und den Umgebungsbedingungen abhängt. Kalibrierung mit bekannten Referenzproben verbessert die Genauigkeit erheblich.</p>
      <p><strong>Welche Arten von Artefakten können datiert werden?</strong> Die Methode eignet sich für alle frisch geschlagenen Obsidianoberflächen: Klingen, Pfeilspitzen, Schaber und andere Steinwerkzeuge aus vulkanischem Glas.</p>
      <p><strong>Was beeinflusst die Hydrationskonstante?</strong> Die chemische Zusammensetzung des Obsidians (insbesondere Wassergehalt und intrinsische Wasseraufnahme) sowie die mittlere Umgebungstemperatur bestimmen die Hydrationskonstante maßgeblich.</p>
      <p><strong>Wie wird die Hydratationsschicht gemessen?</strong> Die Messung erfolgt mit einem polarisierenden Lichtmikroskop an dünn geschliffenen Querschnitten der Oberfläche. Die Schicht erscheint als helle Linie unter UV-Licht.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcOH() {
      const x = parseFloat((document.getElementById('oh-thick') as HTMLInputElement).value) || 0;
      const k = parseFloat((document.getElementById('oh-k') as HTMLInputElement).value) || 1;
      const tempC = parseFloat((document.getElementById('oh-temp') as HTMLInputElement).value) || 20;
      const ea = parseFloat((document.getElementById('oh-ea') as HTMLInputElement).value) || 19.6;
      const R = 1.987e-3;
      const T = tempC + 273.15;
      const Tref = 20 + 273.15;
      const tCorr = Math.exp((ea / R) * (1/Tref - 1/T));
      const kAdj = k * tCorr;
      const x2 = x * x;
      const age = kAdj > 0 ? x2 / kAdj : 0;
      const ka = age / 1000;
      let epoch = '—';
      if (age < 500) epoch = 'Moderne Zeit';
      else if (age < 2000) epoch = 'Mittelalter';
      else if (age < 10000) epoch = 'Jungsteinzeit';
      else if (age < 40000) epoch = 'Mittelsteinzeit';
      else epoch = 'Altsteinzeit';
      const fmt = (v: number, d = 1) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      const steps: string[] = [];
      steps.push('x = ' + fmt(x, 2) + ' µm → x² = ' + fmt(x2, 4) + ' µm²');
      steps.push('Temperaturkorrektur: e^(Ea/R·(1/Tref - 1/T)) = ' + fmt(tCorr, 4));
      steps.push('k(adj) = ' + fmt(k, 2) + ' × ' + fmt(tCorr, 4) + ' = ' + fmt(kAdj, 4) + ' µm²/a');
      steps.push('Alter = x² / k = ' + fmt(x2, 2) + ' / ' + fmt(kAdj, 4) + ' = ' + Math.round(age).toLocaleString('de-DE') + ' Jahre');
      document.getElementById('oh-result')!.textContent = Math.round(age).toLocaleString('de-DE') + ' Jahre';
      document.getElementById('oh-subtitle')!.textContent = fmt(ka, 2) + ' ka (Jahrtausende)';
      document.getElementById('oh-ka')!.textContent = fmt(ka, 2) + ' ka';
      document.getElementById('oh-epoch')!.textContent = epoch;
      document.getElementById('oh-thick2')!.textContent = fmt(x2, 4) + ' µm²';
      document.getElementById('oh-tcorr')!.textContent = fmt(tCorr, 4);
      document.getElementById('oh-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('oh-thick') as HTMLInputElement).value = '4.5';
      (document.getElementById('oh-k') as HTMLInputElement).value = '1.2';
      (document.getElementById('oh-temp') as HTMLInputElement).value = '15';
      (document.getElementById('oh-ea') as HTMLInputElement).value = '19.6';
      document.querySelectorAll('.oh-in').forEach(el => { el.addEventListener('input', calcOH); el.addEventListener('change', calcOH); });
      calcOH();
    }, 50);
  </script>
</CalculatorLayout>
