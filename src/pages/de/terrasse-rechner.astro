---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Terrassen-Rechner - Terrassendielen & Kosten berechnen";
const description = "Berechnen Sie Terrassendielen, Unterkonstruktion, Pfosten, Gelaender und Befestigungsmaterial fuer Ihr Terrassenprojekt mit Kostenschaetzung.";

const relatedCalcs = [
  { name: "Quadratmeter-Rechner", url: "/de/quadratmeter-rechner", description: "Fl\u00e4chenberechnung." },
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Beton." },
  { name: "Holzrechner", url: "/de/holz-rechner", description: "Holz." },
  { name: "Farbrechner", url: "/de/farb-rechner", description: "Farbe." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="deck-calculator" calculatorName="Terrassen-Rechner" keywords="terrasse rechner, terrassendielen, terrassenkosten, wpc terrasse, holzterrasse, unterkonstruktion" breadcrumbs={[{ name: "Terrassen-Rechner", url: "/de/terrasse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Terrassen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Material und Kosten f&uuml;r Ihr Terrassenprojekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Terrassenl&auml;nge (m)</label><input type="number" id="tr-l" class="tr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Terrassenbreite (m)</label><input type="number" id="tr-w" class="tr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Material</label><select id="tr-mat" class="tr-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="kdi">Kesseldruckimpr&auml;gniert</option><option value="laerche">L&auml;rche</option><option value="wpc">WPC/Komposit</option><option value="bangkirai">Bangkirai/Hartholz</option></select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gel&auml;nderseiten</label><input type="number" id="tr-rail" class="tr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="4" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Terrassenfl&auml;che</div>
          <div class="text-4xl font-extrabold font-mono" id="tr-area">0</div>
          <div class="text-sm text-blue-200 mt-1">m&sup2;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Terrassendielen</div><div class="text-xl font-bold" id="tr-boards">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Unterkonstruktion</div><div class="text-xl font-bold" id="tr-joists">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pfosten</div><div class="text-xl font-bold" id="tr-posts">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gel&auml;nder (m)</div><div class="text-xl font-bold" id="tr-railing">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schrauben (kg)</div><div class="text-xl font-bold" id="tr-screws">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Kosten</div><div class="text-xl font-bold" id="tr-cost">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="deck" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Terrassenbau planen</h2>
      <p>Die Materialwahl beeinflusst sowohl Kosten als auch Lebensdauer. KDI-Holz ist g&uuml;nstig, L&auml;rche langlebiger, WPC/Komposit pflegeleicht und Bangkirai extrem widerstandsf&auml;hig.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Brauche ich eine Baugenehmigung?</strong> In den meisten Bundesl&auml;ndern ist eine ebenerdige Terrasse genehmigungsfrei. Bei Aufst&auml;nderung oder Gel&auml;nder k&ouml;nnen Vorschriften gelten.</p>
      <p><strong>Welcher Abstand f&uuml;r die Unterkonstruktion?</strong> Typisch 40-50 cm bei Holz, 30-40 cm bei WPC.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const trMatPrices: Record<string, number> = { kdi: 45, laerche: 65, wpc: 90, bangkirai: 120 };
    function calcTR() {
      const l = parseFloat((document.getElementById('tr-l') as HTMLInputElement).value) || 0;
      const w = parseFloat((document.getElementById('tr-w') as HTMLInputElement).value) || 0;
      const mat = (document.getElementById('tr-mat') as HTMLSelectElement).value;
      const railSides = parseInt((document.getElementById('tr-rail') as HTMLInputElement).value) || 0;
      const area = l * w;
      const boardWidth = 0.145;
      const boards = Math.ceil(w / boardWidth);
      const joistSpacing = 0.45;
      const joists = Math.ceil(l / joistSpacing) + 1;
      const posts = Math.ceil(l / 2) * 2 + 2;
      const railLen = railSides <= 2 ? (railSides === 1 ? l : (railSides === 2 ? l + w : 0)) : (railSides >= 3 ? 2 * l + w : 0);
      const actualRail = railSides === 4 ? 2 * (l + w) : railLen;
      const screws = Math.ceil(area * 1.5);
      const price = area * trMatPrices[mat];
      document.getElementById('tr-area')!.textContent = area.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('tr-boards')!.textContent = String(boards);
      document.getElementById('tr-joists')!.textContent = String(joists);
      document.getElementById('tr-posts')!.textContent = String(posts);
      document.getElementById('tr-railing')!.textContent = actualRail.toFixed(1).replace('.', ',') + ' m';
      document.getElementById('tr-screws')!.textContent = (screws * 0.01).toFixed(1).replace('.', ',');
      document.getElementById('tr-cost')!.textContent = Math.round(price).toLocaleString('de-DE') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.tr-in').forEach(el => { el.addEventListener('input', calcTR); el.addEventListener('change', calcTR); }); calcTR(); }, 50);
  </script>
</CalculatorLayout>
