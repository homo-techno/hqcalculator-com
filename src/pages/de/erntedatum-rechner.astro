---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Erntedatum-Rechner - Wann ist Ihre Ernte bereit?";
const description = "Berechnen Sie das voraussichtliche Erntedatum basierend auf Pflanzenart und Pflanzdatum. Enth&auml;lt die Reifezeit f&uuml;r g&auml;ngiges Gem&uuml;se.";

const relatedCalcs = [
  { name: "Gartenabstand-Rechner", url: "/de/gartenabstand-rechner", description: "Gartenbeetplanung." },
  { name: "Saatgut-Rechner", url: "/de/saatgut-rechner", description: "Ben&ouml;tigtes Saatgut." },
  { name: "Kompost-Rechner", url: "/de/kompost-rechner", description: "Kompostzusammensetzung." },
  { name: "D&uuml;nger-Rechner", url: "/de/duenger-rechner", description: "D&uuml;ngerbedarf." },
  { name: "Bew&auml;sserungs-Rechner", url: "/de/bewaesserungs-rechner", description: "Bew&auml;sserungspl&auml;ne." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Erntedatum-Rechner"
  keywords="erntedatum rechner, reifezeit, wann ernten, pflanzenkalender, gem&uuml;seernte, erntereife"
  breadcrumbs={[{ name: "Erntedatum-Rechner", url: "/de/erntedatum-rechner" }]}
  lang="de"
  enSlug="harvest-date-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Erntedatum-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie heraus, wann Ihre Pflanzen erntereif sind &ndash; basierend auf Pflanzdatum und Pflanzenart.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Pflanze</label>
          <select id="erd-crop" class="erd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="70,85">Tomate (70-85 Tage)</option>
            <option value="60,100">Mais (60-100 Tage)</option>
            <option value="50,70">Gurke (50-70 Tage)</option>
            <option value="60,90">Paprika (60-90 Tage)</option>
            <option value="20,30">Salat (20-30 Tage)</option>
            <option value="20,35">Radieschen (20-35 Tage)</option>
            <option value="50,65">Bohne (50-65 Tage)</option>
            <option value="55,75">Zucchini (55-75 Tage)</option>
            <option value="60,80">Aubergine (60-80 Tage)</option>
            <option value="90,120">Wassermelone (90-120 Tage)</option>
            <option value="100,130">K&uuml;rbis (100-130 Tage)</option>
            <option value="70,80">Brokkoli (70-80 Tage)</option>
            <option value="50,70">M&ouml;hre (50-70 Tage)</option>
            <option value="90,120">Kartoffel (90-120 Tage)</option>
            <option value="30,50">Spinat (30-50 Tage)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Pflanzdatum</label>
          <input type="date" id="erd-date" class="erd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Voraussichtliche Ernte</div>
          <div class="text-5xl font-extrabold font-mono" id="erd-result">-</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fr&uuml;heste Ernte</div><div class="text-xl font-bold font-mono" id="erd-early">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sp&auml;teste Ernte</div><div class="text-xl font-bold font-mono" id="erd-late">-</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reifezeit (Tage)</div><div class="text-xl font-bold font-mono" id="erd-days">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbleibende Tage</div><div class="text-xl font-bold font-mono" id="erd-remaining">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Status</div><div class="text-xl font-bold font-mono" id="erd-status">-</div></div>
        </div>
      </div>

      <ShareButton calculatorId="erntedatum-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Erntezeitpunkt richtig bestimmen</h2>
      <p>Die Reifezeit variiert je nach Sorte, Klima und Boden. Die angegebenen Tage sind Durchschnittswerte unter normalen Anbaubedingungen. Warme Temperaturen beschleunigen das Wachstum, k&uuml;hle verz&ouml;gern es.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wann ist eine Tomate erntereif?</strong> Tomaten sind erntereif, wenn sie vollst&auml;ndig gefarbt sind, auf leichten Druck leicht nachgeben und sich leicht vom Stiel l&ouml;sen. Je nach Sorte dauert das 70-85 Tage ab der Pflanzung.</p>
      <p><strong>Wie erkenne ich reife Gurken?</strong> Gurken sind bei 15-20 cm L&auml;nge und tiefgr&uuml;ner Farbe erntereif. &Uuml;berreife Gurken werden gelb und bitter.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcERD() {
      const cropVal = (document.getElementById('erd-crop') as HTMLSelectElement).value;
      const dateStr = (document.getElementById('erd-date') as HTMLInputElement).value;
      if (!dateStr) {
        document.getElementById('erd-result')!.textContent = '-';
        return;
      }
      const parts = cropVal.split(',').map(Number);
      const minDays = parts[0];
      const maxDays = parts[1];
      const plantDate = new Date(dateStr + 'T00:00:00');
      const earlyDate = new Date(plantDate);
      earlyDate.setDate(earlyDate.getDate() + minDays);
      const lateDate = new Date(plantDate);
      lateDate.setDate(lateDate.getDate() + maxDays);
      const avgDays = Math.round((minDays + maxDays) / 2);
      const avgDate = new Date(plantDate);
      avgDate.setDate(avgDate.getDate() + avgDays);
      const fmtDE = (d: Date) => d.toLocaleDateString('de-DE', { day: 'numeric', month: 'short', year: 'numeric' });
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const daysRemaining = Math.ceil((earlyDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      let status = '';
      if (daysRemaining < 0) status = 'Erntereif!';
      else if (daysRemaining < 14) status = 'Fast!';
      else if (daysRemaining < 30) status = 'Bald';
      else status = 'W&auml;chst';
      document.getElementById('erd-result')!.textContent = fmtDE(avgDate);
      document.getElementById('erd-early')!.textContent = fmtDE(earlyDate);
      document.getElementById('erd-late')!.textContent = fmtDE(lateDate);
      document.getElementById('erd-days')!.textContent = minDays + '-' + maxDays;
      document.getElementById('erd-remaining')!.textContent = daysRemaining > 0 ? daysRemaining + ' Tage' : '&Uuml;berf&auml;llig';
      document.getElementById('erd-status')!.textContent = status;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      (document.getElementById('erd-date') as HTMLInputElement).value = yyyy + '-' + mm + '-' + dd;
      document.querySelectorAll('.erd-in').forEach(el => { el.addEventListener('input', calcERD); el.addEventListener('change', calcERD); });
      calcERD();
    }, 50);
  </script>
</CalculatorLayout>
