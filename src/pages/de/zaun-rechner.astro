---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zaun-Rechner - Material- & Kostenschätzer";
const description = "Berechnen Sie den Zaunmaterialbedarf und die Gesamtkosten für Ihr Zaunprojekt.";
const relatedCalcs = [
  { name: "Zaunpfosten-Rechner", url: "/de/zaunpfosten-rechner", description: "Pfostenabstand." },
  { name: "Zaunlinie-Rechner", url: "/de/zaunlinie-rechner", description: "Zaunlinie planen." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
  { name: "Feuerstelle-Rechner", url: "/de/feuerstelle-rechner", description: "Feuerstellen-Material." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Zaun-Rechner" lang="de" enSlug="fencing-calculator" keywords="zaun rechner, zaun kosten, zaun pfosten, zaun materialien, zaun länge" breadcrumbs={[{ name: "Zaun-Rechner", url: "/de/zaun-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zaun-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Materialien und Kosten für Ihr Zaunprojekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Zauntyp</label>
          <select id="zrde-type" class="zrde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="wood" selected>Holz Sichtschutz (50-80 &euro;/m)</option>
            <option value="chainlink">Maschendraht (30-55 &euro;/m)</option>
            <option value="vinyl">Kunststoff (65-110 &euro;/m)</option>
            <option value="aluminum">Aluminium (80-130 &euro;/m)</option>
            <option value="wrought">Schmiedeeisen (100-160 &euro;/m)</option>
          </select>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesamtlänge (m)</label><input type="number" id="zrde-length" class="zrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zaunhöhe (m)</label><input type="number" id="zrde-height" class="zrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.8" min="0.9" max="3" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tore</label><input type="number" id="zrde-gates" class="zrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" max="10" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Pfostenabstand (m)</label><input type="number" id="zrde-spacing" class="zrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="1" max="4" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kosten pro lfd. Meter (&euro;)</label><input type="number" id="zrde-cost" class="zrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="65" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten</div>
          <div class="text-4xl font-extrabold" id="zrde-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pfosten</div><div class="text-xl font-bold" id="zrde-posts">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sektionen</div><div class="text-xl font-bold" id="zrde-panels">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Riegel</div><div class="text-xl font-bold" id="zrde-rails">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten</div><div class="text-xl font-bold" id="zrde-matcost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Torkosten (gesch.)</div><div class="text-xl font-bold" id="zrde-gatecost">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fencing-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zaun-Tipps</h2>
      <p>Pfosten werden typischerweise alle 2-3 Meter gesetzt. Jede Sektion benötigt 2-3 horizontale Riegel. Prüfen Sie immer die lokalen Vorschriften zu Höhenbeschränkungen und Grenzabständen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Brauche ich eine Baugenehmigung?</strong> In vielen Gemeinden ist für Zäune über 1,8 m eine Genehmigung erforderlich. Informieren Sie sich beim Bauamt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const zrdeTypeCosts: Record<string, [number, number]> = { wood: [65, 250], chainlink: [45, 180], vinyl: [90, 300], aluminum: [105, 350], wrought: [130, 400] };
    function calcZRDE() {
      const type = (document.getElementById('zrde-type') as HTMLSelectElement).value;
      const length = parseFloat((document.getElementById('zrde-length') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('zrde-height') as HTMLInputElement).value) || 1.8;
      const gates = parseInt((document.getElementById('zrde-gates') as HTMLInputElement).value) || 0;
      const spacing = parseFloat((document.getElementById('zrde-spacing') as HTMLInputElement).value) || 2.5;
      const costM = parseFloat((document.getElementById('zrde-cost') as HTMLInputElement).value) || 0;
      const posts = Math.ceil(length / spacing) + 1;
      const panels = posts - 1;
      const railsPerSection = height > 1.5 ? 3 : 2;
      const rails = panels * railsPerSection;
      const gateCostEach = zrdeTypeCosts[type][1];
      const matCost = length * costM;
      const gateTotal = gates * gateCostEach;
      const total = matCost + gateTotal;
      const fmtEur = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('zrde-total')!.textContent = fmtEur(total);
      document.getElementById('zrde-posts')!.textContent = String(posts);
      document.getElementById('zrde-panels')!.textContent = String(panels);
      document.getElementById('zrde-rails')!.textContent = String(rails);
      document.getElementById('zrde-matcost')!.textContent = fmtEur(matCost);
      document.getElementById('zrde-gatecost')!.textContent = fmtEur(gateTotal);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    function setZRDETypeCost() {
      const type = (document.getElementById('zrde-type') as HTMLSelectElement).value;
      (document.getElementById('zrde-cost') as HTMLInputElement).value = String(zrdeTypeCosts[type][0]);
      calcZRDE();
    }
    setTimeout(() => {
      document.querySelectorAll('.zrde-in').forEach(el => el.addEventListener('input', calcZRDE));
      document.getElementById('zrde-type')!.addEventListener('change', setZRDETypeCost);
      calcZRDE();
    }, 50);
  </script>
</CalculatorLayout>
