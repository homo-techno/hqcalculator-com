---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kühllast-Rechner - BTU/h für Klimaanlagen-Dimensionierung";
const description = "Berechnen Sie die Gebäude-Kühllast in BTU/h aus Fläche, Fenstern, Personen, Geräten und Ausrichtung. Dimensionieren Sie Ihre Klimaanlage korrekt.";
const relatedCalcs = [
  { name: "Kühlturm-Rechner", url: "/de/kuehlturm-rechner", description: "Kühlturmkapazität." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kühllast-Rechner" enSlug="cooling-load-calculator" keywords="Kühllast Rechner, BTU Rechner, Klimaanlage Dimensionierung, Kühlleistung, HVAC, Kühllast berechnen" breadcrumbs={[{ name: "Kühllast-Rechner", url: "/de/kuehllast-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kühllast-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Gebäude-Kühllast in BTU/h zur korrekten Dimensionierung Ihrer Klimaanlage.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <h3 class="text-lg font-bold text-text">Raumabmessungen</h3>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Länge (m)</label>
            <input type="number" id="cll-length" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Breite (m)</label>
            <input type="number" id="cll-width" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.5" min="1" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Höhe (m)</label>
            <input type="number" id="cll-height" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.7" min="1" step="0.1">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Dämmstandard</label>
            <select id="cll-insulation" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="poor">Schlecht (Altbau)</option>
              <option value="average" selected>Durchschnittlich</option>
              <option value="good">Gut (gut gedämmt)</option>
              <option value="excellent">Ausgezeichnet (Neubau)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Klimazone</label>
            <select id="cll-climate" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="hot">Heiß (35°C+ Auslegung)</option>
              <option value="warm" selected>Warm (30-35°C Auslegung)</option>
              <option value="moderate">Gemäßigt (25-30°C)</option>
              <option value="cool">Kühl (&lt;25°C)</option>
            </select>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">Fenster</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Fensterfläche (m²)</label>
            <input type="number" id="cll-windows" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="0.5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Sonneneinstrahlung</label>
            <select id="cll-sun" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="north">Norden (schattig)</option>
              <option value="east">Osten</option>
              <option value="south" selected>Süden</option>
              <option value="west">Westen (max. Sonne)</option>
            </select>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">Interne Lasten</h3>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Personen</label>
            <input type="number" id="cll-occupants" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Geräte (W)</label>
            <input type="number" id="cll-equipment" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" step="100">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Beleuchtung (W)</label>
            <input type="number" id="cll-lighting" class="cll-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="0" step="50">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Kühllast</div>
          <div class="text-4xl font-extrabold" id="cll-total">--</div>
          <div class="text-sm text-blue-200 mt-1">BTU/h</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kühltonnen</div>
            <div class="text-xl font-bold" id="cll-tons">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">kW Äquivalent</div>
            <div class="text-xl font-bold" id="cll-kw">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gebäudehülle</div>
            <div class="text-xl font-bold" id="cll-envelope">--</div>
            <div class="text-xs text-text-muted">BTU/h</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Interne Last</div>
            <div class="text-xl font-bold" id="cll-internal">--</div>
            <div class="text-xs text-text-muted">BTU/h</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-1">Empfohlene Klimaanlagengröße</div>
          <div class="text-xl font-bold" id="cll-rec">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="cooling-load" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl mx-auto prose prose-slate">
      <h2 class="text-2xl font-bold text-text">So wird die Kühllast berechnet</h2>
      <p>Die Kühllastberechnung schätzt den gesamten Wärmeeintrag in einen Raum, den die Klimaanlage abführen muss. Wichtige Komponenten sind:</p>
      <ul>
        <li><strong>Gebäudehülle:</strong> Wärmeeintrag durch Wände, Dach und Fenster</li>
        <li><strong>Solare Gewinne:</strong> Sonnenwärme durch Fenster, je nach Ausrichtung</li>
        <li><strong>Interne Gewinne:</strong> Wärme von Personen (~400 BTU/h pro Person), Geräten und Beleuchtung</li>
        <li><strong>Infiltration:</strong> Warme Außenluft durch Undichtigkeiten</li>
      </ul>
      <p><strong>1 Kühlton = 12.000 BTU/h = ca. 3,5 kW.</strong></p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcCLL() {
      const length = parseFloat((document.getElementById('cll-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('cll-width') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('cll-height') as HTMLInputElement).value) || 0;
      const insulation = (document.getElementById('cll-insulation') as HTMLSelectElement).value;
      const climate = (document.getElementById('cll-climate') as HTMLSelectElement).value;
      const windowArea = parseFloat((document.getElementById('cll-windows') as HTMLInputElement).value) || 0;
      const sun = (document.getElementById('cll-sun') as HTMLSelectElement).value;
      const occupants = parseFloat((document.getElementById('cll-occupants') as HTMLInputElement).value) || 0;
      const equipment = parseFloat((document.getElementById('cll-equipment') as HTMLInputElement).value) || 0;
      const lighting = parseFloat((document.getElementById('cll-lighting') as HTMLInputElement).value) || 0;

      // Convert m to ft for calculation
      const areaFt = length * width * 10.764;
      const volumeFt = length * width * height * 35.315;
      const windowFt = windowArea * 10.764;

      const insulFactors: Record<string, number> = { poor: 35, average: 25, good: 18, excellent: 12 };
      const insulFactor = insulFactors[insulation] || 25;
      const climateMulti: Record<string, number> = { hot: 1.3, warm: 1.0, moderate: 0.8, cool: 0.6 };
      const climateFactor = climateMulti[climate] || 1.0;

      const envelopeLoad = areaFt * insulFactor * climateFactor;
      const sunFactors: Record<string, number> = { north: 20, east: 80, south: 100, west: 150 };
      const solarGain = windowFt * (sunFactors[sun] || 100) * climateFactor;
      const infiltration = volumeFt * 0.5 * 0.018 * (climateFactor * 15);

      const peopleBTU = occupants * 400;
      const equipBTU = equipment * 3.412;
      const lightBTU = lighting * 3.412;
      const internalLoad = peopleBTU + equipBTU + lightBTU;

      const totalEnvelope = envelopeLoad + solarGain + infiltration;
      const totalLoad = totalEnvelope + internalLoad;
      const totalWithSafety = totalLoad * 1.1;

      const tons = totalWithSafety / 12000;
      const kw = totalWithSafety * 0.000293071;

      let rec = '';
      if (tons <= 1.5) rec = '1,5 Tonnen (18.000 BTU/h) / ca. 5 kW';
      else if (tons <= 2) rec = '2 Tonnen (24.000 BTU/h) / ca. 7 kW';
      else if (tons <= 2.5) rec = '2,5 Tonnen (30.000 BTU/h) / ca. 9 kW';
      else if (tons <= 3) rec = '3 Tonnen (36.000 BTU/h) / ca. 10,5 kW';
      else if (tons <= 3.5) rec = '3,5 Tonnen (42.000 BTU/h) / ca. 12 kW';
      else if (tons <= 4) rec = '4 Tonnen (48.000 BTU/h) / ca. 14 kW';
      else if (tons <= 5) rec = '5 Tonnen (60.000 BTU/h) / ca. 17,5 kW';
      else rec = Math.ceil(tons) + ' Tonnen (' + (Math.ceil(tons) * 12000).toLocaleString('de-DE') + ' BTU/h)';

      document.getElementById('cll-total')!.textContent = Math.round(totalWithSafety).toLocaleString('de-DE');
      document.getElementById('cll-tons')!.textContent = tons.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.getElementById('cll-kw')!.textContent = kw.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.getElementById('cll-envelope')!.textContent = Math.round(totalEnvelope).toLocaleString('de-DE');
      document.getElementById('cll-internal')!.textContent = Math.round(internalLoad).toLocaleString('de-DE');
      document.getElementById('cll-rec')!.textContent = rec;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.cll-in').forEach(el => {
        el.addEventListener('input', calcCLL);
        el.addEventListener('change', calcCLL);
      });
      calcCLL();
    }, 50);
  </script>
</CalculatorLayout>
