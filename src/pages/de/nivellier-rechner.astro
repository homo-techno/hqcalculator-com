---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Nivellierrechner – Höhenunterschiede & Ausgleichsmenge berechnen";
const description = "Berechnen Sie Höhenunterschiede und benötigte Ausgleichsmenge beim Bodennivellieren für Estrich, Beton und Bodenbeläge.";
const relatedCalcs = [
  { name: "Tragwand Rechner", url: "/de/tragwand-rechner", description: "Tragfähigkeit." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
  { name: "Auslastungsgrad Rechner", url: "/de/auslastungsgrad-rechner", description: "Kapazitätsnutzung." },
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="leveling-calculator" calculatorName="Nivellierrechner" keywords="Nivellierrechner, Bodennivellierung, Ausgleichsmasse, Höhenunterschied, Estrich berechnen" breadcrumbs={[{ name: "Nivellierrechner", url: "/de/nivellier-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Nivellierrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie benötigte Ausgleichsmasse und Material für Bodennivellierungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Raumlänge (m)</label>
            <input type="number" id="niv-l" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" step="0.1" min="0.1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Raumbreite (m)</label>
            <input type="number" id="niv-b" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" step="0.1" min="0.1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Max. Höhenunterschied (mm)</label>
            <input type="number" id="niv-hmax" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" step="1" min="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Min. Schichtdicke (mm)</label>
            <input type="number" id="niv-hmin" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" step="1" min="1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Material</label>
          <select id="niv-mat" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.5">Fließestrich (1,5 kg/L)</option>
            <option value="1.8" selected>Zementestrich (1,8 kg/L)</option>
            <option value="1.2">Ausgleichsmasse selbstverlaufend (1,2 kg/L)</option>
            <option value="1.4">Calciumsulfat-Estrich (1,4 kg/L)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigtes Material</div>
          <div class="text-5xl font-extrabold font-mono" id="niv-result">0 kg</div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="niv-details"></div>
      </div>
      <ShareButton lang="de" calculatorId="nivellier" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Bodennivellierung richtig berechnen</h2>
      <p>Beim Bodennivellieren wird eine Ausgleichsmasse aufgetragen, um Unebenheiten auszugleichen. Die benötigte Materialmenge hängt von der Raumfläche, dem maximalen Höhenunterschied und der Mindestschichtdicke ab. Als Faustregel gilt: Pro m² Fläche und mm Dicke werden ca. 1,5–1,8 kg Ausgleichsmasse benötigt. Planen Sie immer einen Sicherheitszuschlag von 10–15 % ein.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viel Ausgleichsmasse brauche ich pro m²?</summary>
          <p class="mt-2 text-sm text-text-secondary">Als Richtwert gilt: ca. 1,5–1,8 kg pro m² und mm Schichtdicke. Bei 10 m² und 5 mm Dicke benötigen Sie also ca. 75–90 kg Material plus Sicherheitszuschlag.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Welche Mindestschichtdicke ist erforderlich?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die meisten Ausgleichsmassen benötigen eine Mindestschichtdicke von 3–5 mm. Dünnere Schichten können reißen oder sich ablösen. Beachten Sie die Herstellerangaben.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wann ist Fließestrich besser als Zementestrich?</summary>
          <p class="mt-2 text-sm text-text-secondary">Fließestrich (Calciumsulfat-Fließestrich) ist für große Flächen und Fußbodenheizung geeignet. Er verlegt sich selbst und hat weniger Schwundrisse. Zementestrich ist feuchtigkeitsbeständiger und für Nassräume besser geeignet.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Muss der Untergrund vorbereitet werden?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ja, der Untergrund muss sauber, tragfähig und frei von Staub und Ölen sein. Bei saugfähigen Untergründen ist eine Grundierung (Primer) erforderlich, um das Wasser nicht zu schnell zu entziehen.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcNiv() {
      const l = parseFloat((document.getElementById('niv-l') as HTMLInputElement).value) || 0;
      const b = parseFloat((document.getElementById('niv-b') as HTMLInputElement).value) || 0;
      const hmax = parseFloat((document.getElementById('niv-hmax') as HTMLInputElement).value) || 0;
      const hmin = parseFloat((document.getElementById('niv-hmin') as HTMLInputElement).value) || 0;
      const dichte = parseFloat((document.getElementById('niv-mat') as HTMLSelectElement).value) || 1.8;

      const flaeche = l * b; // m²
      const avgDicke = hmin + hmax / 2; // mm (Durchschnitt)
      const volumen = flaeche * (avgDicke / 1000); // m³
      const volumenLiter = volumen * 1000; // Liter
      const gewicht = volumenLiter * dichte; // kg
      const gewichtMitZuschlag = gewicht * 1.12; // 12% Sicherheitszuschlag
      const saecke25 = Math.ceil(gewichtMitZuschlag / 25);
      const saecke20 = Math.ceil(gewichtMitZuschlag / 20);

      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('niv-result')!.textContent = fmt(gewichtMitZuschlag) + ' kg';
      document.getElementById('niv-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumfläche</div><div class="text-lg font-bold font-mono">${fmt(flaeche)} m²</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchschn. Dicke</div><div class="text-lg font-bold font-mono">${fmt(avgDicke)} mm</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen</div><div class="text-lg font-bold font-mono">${fmt(volumenLiter)} L</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Netto ohne Zuschlag</div><div class="text-lg font-bold font-mono">${fmt(gewicht)} kg</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Säcke à 25 kg</div><div class="text-lg font-bold font-mono">${saecke25} Stk.</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Säcke à 20 kg</div><div class="text-lg font-bold font-mono">${saecke20} Stk.</div></div>`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['niv-l','niv-b','niv-hmax','niv-hmin'].forEach(id => document.getElementById(id)!.addEventListener('input', calcNiv));
      document.getElementById('niv-mat')!.addEventListener('change', calcNiv);
      calcNiv();
    }, 50);
  </script>
</CalculatorLayout>
