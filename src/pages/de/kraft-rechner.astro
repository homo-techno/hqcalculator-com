---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kraft-Rechner - F = m·a (Newtons zweites Gesetz)";
const description = "Berechnen Sie Kraft, Masse oder Beschleunigung mit Newtons zweitem Gesetz F = m·a.";
const relatedCalcs = [
  { name: "Beschleunigungsrechner", url: "/de/beschleunigungsrechner", description: "Beschleunigung." },
  { name: "Impuls-Rechner", url: "/de/impuls-rechner", description: "Impuls." },
  { name: "Drehmoment-Rechner", url: "/de/drehmoment-rechner", description: "Drehmoment." },
  { name: "Dichte-Rechner", url: "/de/dichte-rechner", description: "Dichte." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kraft-Rechner" lang="de" enSlug="force-calculator" keywords="kraft rechner, f=ma, newtons zweites gesetz, kraft masse beschleunigung, newton rechner" breadcrumbs={[{ name: "Kraft-Rechner", url: "/de/kraft-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kraft-Rechner (F = m&middot;a)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kraft, Masse oder Beschleunigung mit Newtons zweitem Gesetz.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Berechne</label><select id="krf-solve" class="w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="force" selected>Kraft (F)</option><option value="mass">Masse (m)</option><option value="accel">Beschleunigung (a)</option></select></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Masse (kg)</label><input type="number" id="krf-m" class="krf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Beschleunigung (m/s&sup2;)</label><input type="number" id="krf-a" class="krf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9.81" step="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="krf-label">Kraft</div>
          <div class="text-5xl font-extrabold font-mono" id="krf-result">0</div>
          <div class="text-sm text-blue-200 mt-1" id="krf-unit">Newton (N)</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraft (N)</div><div class="text-xl font-bold" id="krf-fn">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraft (lbf)</div><div class="text-xl font-bold" id="krf-flb">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraft (kN)</div><div class="text-xl font-bold" id="krf-fkn">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formel</h3>
          <div class="font-mono text-sm" id="krf-formula">F = m &times; a</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="force-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Newtons zweites Gesetz</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>F = m &times; a</p>
        <p>m = F / a</p>
        <p>a = F / m</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein Newton?</strong> Ein Newton ist die Kraft, die ben&ouml;tigt wird, um eine Masse von 1 kg mit 1 m/s&sup2; zu beschleunigen.</p>
      <p><strong>Was ist der Unterschied zwischen Masse und Gewicht?</strong> Masse ist die Menge an Materie (in kg), Gewicht ist die Gravitationskraft (in Newton). Auf der Erde: Gewicht = Masse &times; 9,81 m/s&sup2;.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKRF() {
      const solve = (document.getElementById('krf-solve') as HTMLSelectElement).value;
      const m = parseFloat((document.getElementById('krf-m') as HTMLInputElement).value) || 0;
      const a = parseFloat((document.getElementById('krf-a') as HTMLInputElement).value) || 0;
      let result: number, label: string, unit: string;
      if (solve === 'force') { result = m * a; label = 'Kraft'; unit = 'Newton (N)'; }
      else if (solve === 'mass') { result = a !== 0 ? m / a : 0; label = 'Masse'; unit = 'kg'; }
      else { result = m !== 0 ? a / m : 0; label = 'Beschleunigung'; unit = 'm/s\u00B2'; }
      const forceN = solve === 'force' ? result : m * a;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      document.getElementById('krf-result')!.textContent = fmt(result);
      document.getElementById('krf-label')!.textContent = label;
      document.getElementById('krf-unit')!.textContent = unit;
      document.getElementById('krf-fn')!.textContent = fmt(forceN);
      document.getElementById('krf-flb')!.textContent = fmt(forceN * 0.224809);
      document.getElementById('krf-fkn')!.textContent = fmt(forceN / 1000);
      document.getElementById('krf-formula')!.textContent = 'F = ' + m.toLocaleString('de-DE') + ' \u00D7 ' + a.toLocaleString('de-DE') + ' = ' + fmt(forceN) + ' N';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.krf-in').forEach(el => el.addEventListener('input', calcKRF)); document.getElementById('krf-solve')!.addEventListener('change', calcKRF); calcKRF(); }, 50);
  </script>
</CalculatorLayout>
