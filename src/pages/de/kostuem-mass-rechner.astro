---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kostüm-Maß-Rechner - Größen & historische Anpassungen";
const description = "Berechnen Sie Kostümgrößen aus Körpermaßen mit historischen Perioden-Anpassungen, Rüstungszuschlägen und Requisiten-Berücksichtigung für Cosplay und Theater.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kostüm-Maß-Rechner" enSlug="costume-measurement-calculator" keywords="Kostüm Maßrechner, Kostümgrößen, Cosplay Maße, historisches Kostüm, Rüstungszuschlag, Kostümschneiderei" breadcrumbs={[{ name: "Kostüm-Maß-Rechner", url: "/de/kostuem-mass-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kostüm-Maß-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kostümmaße mit Perioden-Anpassungen, Rüstungszuschlägen und Requisiten-Berücksichtigung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kostüm-Epoche / Stil</label>
          <select id="cm2-period" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="modern" selected>Modern / Zeitgenössisch</option>
            <option value="victorian">Viktorianisch (1837-1901)</option>
            <option value="medieval">Mittelalter (500-1500)</option>
            <option value="renaissance">Renaissance (1400-1600)</option>
            <option value="regency">Regency (1811-1820)</option>
            <option value="1920s">1920er Jahre / Flapper</option>
            <option value="1950s">1950er Jahre / Petticoat</option>
            <option value="anime">Anime / Fantasy</option>
            <option value="armor">Rüstung / Mech</option>
            <option value="superhero">Superheld / Bodysuit</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Brust-/Brustumfang (cm)</label><input type="number" id="cm2-bust" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="91" min="50" max="150" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Taillenumfang (cm)</label><input type="number" id="cm2-waist" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="71" min="45" max="140" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hüftumfang (cm)</label><input type="number" id="cm2-hip" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="97" min="60" max="150" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Körpergröße (cm)</label><input type="number" id="cm2-height" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="168" min="120" max="210" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schulterbreite (cm)</label><input type="number" id="cm2-shoulder" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="38" min="25" max="60" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Armlänge (cm)</label><input type="number" id="cm2-arm" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="61" min="35" max="90" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Unterlage / Polsterung</label>
          <select id="cm2-under" class="cm2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="none" selected>Keine</option>
            <option value="thin">Dünne Unterkleidung (+1 cm)</option>
            <option value="corset">Korsett / Shapewear</option>
            <option value="padding">Muskelpolster (+5 cm)</option>
            <option value="armor">Schaumstoff-Rüstung (+8 cm)</option>
            <option value="heavy">Schwere Rüstung / Requisiten (+10-15 cm)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Angepasster Brustumfang</div>
          <div class="text-4xl font-extrabold font-mono" id="cm2-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ang. Taille</div><div class="text-xl font-bold font-mono" id="cm2-adjwaist">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ang. Hüfte</div><div class="text-xl font-bold font-mono" id="cm2-adjhip">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ang. Schulter</div><div class="text-xl font-bold font-mono" id="cm2-adjshoulder">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rocklänge</div><div class="text-xl font-bold font-mono" id="cm2-skirt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stoffbedarf</div><div class="text-xl font-bold font-mono" id="cm2-fabric">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Epochen-Hinweis</div><div class="text-xl font-bold font-mono" id="cm2-note">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="costume-measurement" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kostümmaße richtig nehmen</h2>
      <p>Beim Kostümnähen müssen historische Epochen-spezifische Zugaben berücksichtigt werden. Viktorianische Kostüme erfordern Korsett-Anpassungen, mittelalterliche Gewänder brauchen großzügige Weiten für Überwürfe, und Rüstungskostüme benötigen erhebliche Zuschläge für Schaumstoff- oder Thermoplastik-Schichten.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Zugabe braucht ein Cosplay-Kostüm?</strong> Das hängt von der Epoche und dem Material ab. Rüstungen brauchen 8-15 cm Zuschlag, historische Kleider 5-10 cm.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCM2() {
      const period = (document.getElementById('cm2-period') as HTMLSelectElement).value;
      const bust = parseFloat((document.getElementById('cm2-bust') as HTMLInputElement).value) || 91;
      const waist = parseFloat((document.getElementById('cm2-waist') as HTMLInputElement).value) || 71;
      const hip = parseFloat((document.getElementById('cm2-hip') as HTMLInputElement).value) || 97;
      const height = parseFloat((document.getElementById('cm2-height') as HTMLInputElement).value) || 168;
      const shoulder = parseFloat((document.getElementById('cm2-shoulder') as HTMLInputElement).value) || 38;
      const arm = parseFloat((document.getElementById('cm2-arm') as HTMLInputElement).value) || 61;
      const under = (document.getElementById('cm2-under') as HTMLSelectElement).value;

      // Underlayer additions in cm
      const underAdd: Record<string, number[]> = {
        none: [0, 0, 0, 0],
        thin: [1, 1, 1, 0],
        corset: [2.5, -5, 0, 0],
        padding: [5, 2.5, 2.5, 2.5],
        armor: [8, 5, 5, 5],
        heavy: [13, 10, 8, 8]
      };
      const ua = underAdd[under] || [0, 0, 0, 0];

      // Period ease adjustments in cm [bust, waist, hip, shoulder_extra]
      interface PeriodData { ease: number[]; skirtMult: number; note: string; fabricM: number }
      const periodData: Record<string, PeriodData> = {
        modern:      { ease: [8, 5, 8, 0], skirtMult: 0.55, note: 'Standard-Zugabe', fabricM: 2.3 },
        victorian:   { ease: [10, -2.5, 15, 0], skirtMult: 0.85, note: 'Korsett-Taille, Krinoline', fabricM: 7.3 },
        medieval:    { ease: [13, 10, 13, 2.5], skirtMult: 0.8, note: 'Weite Schichten', fabricM: 5.5 },
        renaissance: { ease: [10, 0, 13, 5], skirtMult: 0.8, note: 'Strukturiertes Mieder', fabricM: 6.4 },
        regency:     { ease: [5, 15, 10, 0], skirtMult: 0.75, note: 'Empire-Taille, flie\u00DFend', fabricM: 4.6 },
        '1920s':     { ease: [10, 10, 5, 0], skirtMult: 0.35, note: 'Tiefe Taille, gerade', fabricM: 2.7 },
        '1950s':     { ease: [8, -2.5, 13, 0], skirtMult: 0.6, note: 'Wespentaille, Tellerrock', fabricM: 4.6 },
        anime:       { ease: [8, 5, 8, 2.5], skirtMult: 0.5, note: '\u00DCbertriebene Proportionen', fabricM: 3.2 },
        armor:       { ease: [15, 10, 10, 10], skirtMult: 0, note: 'Schaum/Thermoplastik', fabricM: 0 },
        superhero:   { ease: [0, 0, 0, 0], skirtMult: 0, note: 'Hautenges Stretch-Material', fabricM: 1.8 }
      };

      const pd = periodData[period] || periodData['modern'];

      const adjBust = bust + pd.ease[0] + ua[0];
      const adjWaist = waist + pd.ease[1] + ua[1];
      const adjHip = hip + pd.ease[2] + ua[2];
      const adjShoulder = shoulder + pd.ease[3] + ua[3];
      const skirtLen = pd.skirtMult > 0 ? (height * pd.skirtMult) : 0;
      const fabricMeters = pd.fabricM;

      document.getElementById('cm2-result')!.textContent = adjBust.toFixed(1) + ' cm';
      document.getElementById('cm2-adjwaist')!.textContent = adjWaist.toFixed(1) + ' cm';
      document.getElementById('cm2-adjhip')!.textContent = adjHip.toFixed(1) + ' cm';
      document.getElementById('cm2-adjshoulder')!.textContent = adjShoulder.toFixed(1) + ' cm';
      document.getElementById('cm2-skirt')!.textContent = skirtLen > 0 ? skirtLen.toFixed(1) + ' cm' : 'N/A';
      document.getElementById('cm2-fabric')!.textContent = fabricMeters > 0 ? fabricMeters + ' m' : 'Schaum/Worbla';
      document.getElementById('cm2-note')!.textContent = pd.note;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.cm2-in').forEach(el => { el.addEventListener('input', calcCM2); el.addEventListener('change', calcCM2); });
      calcCM2();
    }, 50);
  </script>
</CalculatorLayout>
