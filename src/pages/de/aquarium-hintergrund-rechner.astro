---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Hintergrundrechner - Material & Abdeckung";
const description = "Berechnen Sie die Abmessungen und Materialmenge für einen Aquarium-Hintergrund, einschließlich Schaum, Vinyl, gemalter oder 3D-Hintergründe.";
const relatedCalcs = [
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen berechnen." },
  { name: "Aquarium-Substrat", url: "/de/aquarium-substrat-rechner", description: "Substratmenge berechnen." },
  { name: "Aquarium-Kosten", url: "/de/aquarium-kosten-rechner", description: "Gesamte Einrichtungskosten." },
  { name: "Aquarium-Glasdicke", url: "/de/aquarium-glasdicke-rechner", description: "Glasdicke für Becken." },
  { name: "Aquarium-Ständer", url: "/de/aquarium-staender-rechner", description: "Ständer-Tragfähigkeit." },
  { name: "Aquarium-Beleuchtung", url: "/de/aquarium-beleuchtung-rechner", description: "Beleuchtungsrechner." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquarium-Hintergrundrechner" keywords="Aquarium-Hintergrund-Rechner, Aquarium-Rückwand, 3D-Hintergrund, Aquarium-Kulisse, Becken-Hintergrundgröße" breadcrumbs={[{ name: "Aquarium-Hintergrund", url: "/de/aquarium-hintergrund-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Hintergrundrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Hintergrundmaterial-Abmessungen und Abdeckung für die Rückseite Ihres Aquariums.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beckenlänge (cm)</label>
            <input type="number" id="abg-len" class="abg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="15" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beckenhöhe (cm)</label>
            <input type="number" id="abg-hgt" class="abg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="15" step="1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hintergrundtyp</label>
          <select id="abg-type" class="abg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="vinyl" selected>Vinyl / Poster (dünne Folie)</option>
            <option value="foam">Schaum / 3D-Modelliert</option>
            <option value="paint">Gestrichen (Sprühfarbe)</option>
            <option value="cling">Statische Haftfolie</option>
            <option value="tile">Fliese / Schiefer</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Auch Seiten abdecken?</label>
          <select id="abg-sides" class="abg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="back" selected>Nur Rückwand</option>
            <option value="both">Rückwand + beide Seiten</option>
            <option value="one">Rückwand + eine Seite</option>
          </select>
        </div>
        <div id="abg-sidewidth-wrap">
          <label class="block text-xs font-medium text-text mb-1">Seitenwandbreite (cm)</label>
          <input type="number" id="abg-sidew" class="abg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="15" step="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigtes Material</div>
          <div class="text-5xl font-extrabold font-mono" id="abg-result">0 cm&sup2;</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Quadratmeter</div>
            <div class="text-xl font-bold font-mono" id="abg-sqft">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Abmessungen (Zuschnitt)</div>
            <div class="text-xl font-bold font-mono" id="abg-dims">0 x 0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesch. Materialkosten</div>
            <div class="text-xl font-bold font-mono" id="abg-cost">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zusätzliches Gewicht</div>
            <div class="text-xl font-bold font-mono" id="abg-weight">0 kg</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquarium-background" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcABG() {
      const len = parseFloat((document.getElementById('abg-len') as HTMLInputElement).value) || 0;
      const hgt = parseFloat((document.getElementById('abg-hgt') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('abg-type') as HTMLSelectElement).value;
      const sides = (document.getElementById('abg-sides') as HTMLSelectElement).value;
      const sideW = parseFloat((document.getElementById('abg-sidew') as HTMLInputElement).value) || 0;
      let totalSqCm = len * hgt;
      let dims = len + ' x ' + hgt + ' cm';
      if (sides === 'both') {
        totalSqCm += 2 * sideW * hgt;
        dims = len + '+2x' + sideW + ' x ' + hgt + ' cm';
      } else if (sides === 'one') {
        totalSqCm += sideW * hgt;
        dims = len + '+' + sideW + ' x ' + hgt + ' cm';
      }
      const sqM = totalSqCm / 10000;
      const costPerSqM: Record<string, number> = {
        vinyl: 22, foam: 86, paint: 5, cling: 32, tile: 129
      };
      const cost = sqM * (costPerSqM[type] || 22);
      const weightPerSqM: Record<string, number> = {
        vinyl: 0.5, foam: 10, paint: 0, cling: 0.2, tile: 39
      };
      const weight = sqM * (weightPerSqM[type] || 0.5);
      document.getElementById('abg-result')!.textContent = Math.round(totalSqCm).toLocaleString('de-DE') + ' cm\u00B2';
      document.getElementById('abg-sqft')!.textContent = sqM.toFixed(2).replace('.', ',') + ' m\u00B2';
      document.getElementById('abg-dims')!.textContent = dims;
      document.getElementById('abg-cost')!.textContent = cost.toFixed(2).replace('.', ',') + ' \u20AC';
      document.getElementById('abg-weight')!.textContent = weight.toFixed(1).replace('.', ',') + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.abg-in').forEach(el => { el.addEventListener('input', calcABG); el.addEventListener('change', calcABG); });
      calcABG();
    }, 50);
  </script>
</CalculatorLayout>
