---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Erosion-Rechner - ABAG Bodenabtrag & Risikobewertung";
const description = "Berechnen Sie den Bodenabtrag mit der Allgemeinen Bodenabtragsgleichung (ABAG: A=RKLSCP). Bewerten Sie Erosionsrisiken und Schutzma\u00dfnahmen.";
const relatedCalcs = [
  { name: "H\u00f6henunterschied-Rechner", url: "/de/hoehenunterschied-rechner", description: "H\u00f6henberechnung." },
  { name: "Epoxidharz-Rechner", url: "/de/epoxidharz-rechner", description: "Epoxid-Mischung." },
  { name: "Energieaudit-Rechner", url: "/de/energieaudit-rechner", description: "Energieeffizienz." },
  { name: "Fluchtgeschwindigkeit", url: "/de/fluchtgeschwindigkeit-rechner", description: "Fluchtgeschwindigkeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Erosion-Rechner" lang="de" enSlug="erosion-calculator" keywords="erosion rechner, ABAG, bodenabtrag, R-Faktor, K-Faktor, LS-Faktor, erosionsschutz, bodenverlust" breadcrumbs={[{ name: "Erosion-Rechner", url: "/de/erosion-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Erosion-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie den j&auml;hrlichen Bodenabtrag mit der ABAG-Gleichung (A = R &times; K &times; LS &times; C &times; P).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">R-Faktor (Regenerosivit&auml;t)</label>
            <select id="erde-r" class="erde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="30">Gering (30)</option>
              <option value="60" selected>M&auml;&szlig;ig (60)</option>
              <option value="90">Hoch (90)</option>
              <option value="120">Sehr hoch (120)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">K-Faktor (Bodenerodierbarkeit)</label>
            <select id="erde-k" class="erde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0.10">Ton (0,10)</option>
              <option value="0.20">Sandiger Lehm (0,20)</option>
              <option value="0.32" selected>Schlufflehm (0,32)</option>
              <option value="0.40">Schluffton (0,40)</option>
              <option value="0.49">Feinsand (0,49)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Hangl&auml;nge (m)</label>
            <input type="number" id="erde-len" class="erde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="5" max="1000" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Hangneigung (%)</label>
            <input type="number" id="erde-slope" class="erde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.5" max="50" step="0.5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">C-Faktor (Bodenbedeckung)</label>
            <select id="erde-c" class="erde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1.0">Nackter Boden (1,0)</option>
              <option value="0.50">Reihenfrucht, konventionell (0,50)</option>
              <option value="0.25" selected>Reihenfrucht, Mulchsaat (0,25)</option>
              <option value="0.10">Getreide (0,10)</option>
              <option value="0.01">Dauergrünland/Wald (0,01)</option>
              <option value="0.004">Ungest&ouml;rter Wald (0,004)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">P-Faktor (Schutzma&szlig;nahmen)</label>
            <select id="erde-p" class="erde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1.0">Keine Ma&szlig;nahme (1,0)</option>
              <option value="0.75">Querbearbeitung (0,75)</option>
              <option value="0.50" selected>Konturbearbeitung (0,50)</option>
              <option value="0.25">Terrassierung (0,25)</option>
              <option value="0.10">Gr&uuml;nstreifen (0,10)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Feldgr&ouml;&szlig;e (ha)</label>
          <input type="number" id="erde-area" class="erde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0.1" max="1000" step="0.1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">J&auml;hrlicher Bodenabtrag (t/ha/Jahr)</div>
          <div class="text-5xl font-extrabold font-mono" id="erde-loss">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">LS-Faktor</div>
            <div class="text-xl font-bold font-mono" id="erde-ls">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtverlust Feld</div>
            <div class="text-xl font-bold font-mono" id="erde-total">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Risikobewertung</div>
            <div class="text-xl font-bold font-mono" id="erde-risk">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bodentiefe-Verlust/Jahr</div>
            <div class="text-xl font-bold font-mono" id="erde-depth">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Toleranzgrenze (T)</div>
            <div class="text-xl font-bold font-mono" id="erde-tval">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="erosion-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Die ABAG-Gleichung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>A = R &times; K &times; LS &times; C &times; P</p>
        <p>Toleranzwert: ca. 5 t/ha/Jahr f&uuml;r die meisten B&ouml;den</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein tolerabler Bodenabtrag?</strong> F&uuml;r die meisten B&ouml;den gilt 5 t/ha/Jahr als Obergrenze, bei der die Bodenbildung den Verlust noch ausgleichen kann.</p>
      <p><strong>Wie reduziert man Erosion?</strong> Dauerhafte Bodenbedeckung, Mulchsaat, Konturbearbeitung und Gr&uuml;nstreifen sind effektive Ma&szlig;nahmen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcERDE() {
      const R = parseFloat((document.getElementById('erde-r') as HTMLSelectElement).value) || 60;
      const K = parseFloat((document.getElementById('erde-k') as HTMLSelectElement).value) || 0.32;
      const slopeLen = parseFloat((document.getElementById('erde-len') as HTMLInputElement).value) || 100;
      const slopePct = parseFloat((document.getElementById('erde-slope') as HTMLInputElement).value) || 5;
      const C = parseFloat((document.getElementById('erde-c') as HTMLSelectElement).value) || 0.25;
      const P = parseFloat((document.getElementById('erde-p') as HTMLSelectElement).value) || 0.50;
      const area = parseFloat((document.getElementById('erde-area') as HTMLInputElement).value) || 10;
      const m = slopePct < 1 ? 0.2 : slopePct < 3 ? 0.3 : slopePct < 5 ? 0.4 : 0.5;
      const L = Math.pow(slopeLen / 22.13, m);
      const theta = Math.atan(slopePct / 100);
      const S = (slopePct < 9) ?
        10.8 * Math.sin(theta) + 0.03 :
        16.8 * Math.sin(theta) - 0.50;
      const LS = L * S;
      const A = R * K * LS * C * P;
      const totalLoss = A * area;
      const depthMm = A / 1.3 * 10 / 10000;
      let risk = 'Sehr gering';
      if (A > 15) risk = 'Schwer';
      else if (A > 10) risk = 'Hoch';
      else if (A > 5) risk = 'M\u00E4\u00DFig';
      else if (A > 2) risk = 'Gering';
      document.getElementById('erde-loss')!.textContent = A.toFixed(1).replace('.', ',') + ' t/ha/a';
      document.getElementById('erde-ls')!.textContent = LS.toFixed(2).replace('.', ',');
      document.getElementById('erde-total')!.textContent = Math.round(totalLoss).toLocaleString('de-DE') + ' t';
      document.getElementById('erde-risk')!.textContent = risk;
      document.getElementById('erde-depth')!.textContent = (depthMm * 1000).toFixed(2).replace('.', ',') + ' mm';
      document.getElementById('erde-tval')!.textContent = '5 t/ha/a';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.erde-in').forEach(el => { el.addEventListener('input', calcERDE); el.addEventListener('change', calcERDE); });
      calcERDE();
    }, 50);
  </script>
</CalculatorLayout>
