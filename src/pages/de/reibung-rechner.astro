---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Reibung-Rechner - Haft- & Gleitreibung";
const description = "Berechnen Sie Reibungskraft, Reibungskoeffizient und Normalkraft f\u00FCr Haft- und Gleitreibung.";
const relatedCalcs = [
  { name: "Kraft-Rechner", url: "/de/kraft-rechner", description: "Kraft." },
  { name: "Beschleunigungsrechner", url: "/de/beschleunigungsrechner", description: "Beschleunigung." },
  { name: "Impuls-Rechner", url: "/de/impuls-rechner", description: "Impuls." },
  { name: "Kinetische Energie", url: "/de/kinetische-energie-rechner", description: "Kinetische Energie." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Reibung-Rechner" lang="de" enSlug="friction-calculator" keywords="reibung rechner, reibungskoeffizient, haftreibung, gleitreibung, normalkraft" breadcrumbs={[{ name: "Reibung", url: "/de/reibung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Reibung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Reibungskraft mit F = &mu;N.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Masse (kg)</label><input type="number" id="rbr-mass" class="rbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Neigungswinkel (&deg;)</label><input type="number" id="rbr-angle" class="rbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="90" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Oberfl&auml;chenmaterial</label>
          <select id="rbr-mat" class="rbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0.74|0.57" selected>Gummi auf Beton</option>
            <option value="0.61|0.47">Gummi auf Asphalt (nass)</option>
            <option value="0.50|0.36">Holz auf Holz</option>
            <option value="0.80|0.50">Stahl auf Stahl (trocken)</option>
            <option value="0.15|0.06">Stahl auf Stahl (ge&ouml;lt)</option>
            <option value="0.04|0.04">Eis auf Eis</option>
            <option value="0.10|0.05">Teflon auf Stahl</option>
            <option value="0.35|0.25">Glas auf Glas</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Reibungskraft</div>
          <div class="text-5xl font-extrabold font-mono" id="rbr-result">0 N</div>
          <div class="text-sm text-blue-200 mt-1" id="rbr-type">Haftreibung</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Haftreibung</div><div class="text-xl font-bold font-mono" id="rbr-static">0 N</div><div class="text-xs text-text-muted" id="rbr-us">&mu;s = 0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gleitreibung</div><div class="text-xl font-bold font-mono" id="rbr-kinetic">0 N</div><div class="text-xs text-text-muted" id="rbr-uk">&mu;k = 0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Normalkraft</div><div class="text-xl font-bold font-mono" id="rbr-normal">0 N</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hangabtriebskraft</div><div class="text-xl font-bold font-mono" id="rbr-parallel">0 N</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="friction-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Reibungskraft berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>F_Reibung = &mu; &times; F_Normal</p>
        <p>F_Normal = m &times; g &times; cos(&alpha;)</p>
        <p>F_Hangabtrieb = m &times; g &times; sin(&alpha;)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Haft- und Gleitreibung?</strong> Haftreibung wirkt, wenn ein K&ouml;rper in Ruhe ist und verhindert die Bewegung. Gleitreibung wirkt, wenn sich ein K&ouml;rper bereits bewegt. Haftreibung ist immer gr&ouml;&szlig;er als Gleitreibung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcRBR() {
      const mass = parseFloat((document.getElementById('rbr-mass') as HTMLInputElement).value) || 0;
      const angle = parseFloat((document.getElementById('rbr-angle') as HTMLInputElement).value) || 0;
      const matVal = (document.getElementById('rbr-mat') as HTMLSelectElement).value;
      const [us, uk] = matVal.split('|').map(Number);
      const g = 9.81;
      const aRad = angle * Math.PI / 180;
      const weight = mass * g;
      const normal = weight * Math.cos(aRad);
      const parallel = weight * Math.sin(aRad);
      const staticF = us * normal;
      const kineticF = uk * normal;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('rbr-result')!.textContent = fmt(staticF) + ' N';
      document.getElementById('rbr-static')!.textContent = fmt(staticF) + ' N';
      document.getElementById('rbr-kinetic')!.textContent = fmt(kineticF) + ' N';
      document.getElementById('rbr-us')!.textContent = '\u00B5s = ' + us.toLocaleString('de-DE');
      document.getElementById('rbr-uk')!.textContent = '\u00B5k = ' + uk.toLocaleString('de-DE');
      document.getElementById('rbr-normal')!.textContent = fmt(normal) + ' N';
      document.getElementById('rbr-parallel')!.textContent = fmt(parallel) + ' N';
      document.getElementById('rbr-type')!.textContent = parallel > staticF ? 'Objekt rutscht!' : 'Haftreibung (in Ruhe)';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.rbr-in').forEach(el => { el.addEventListener('input', calcRBR); el.addEventListener('change', calcRBR); });
      calcRBR();
    }, 50);
  </script>
</CalculatorLayout>
