---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Militär-Körperfett-Rechner - US Army Tape Test";
const description = "Berechnen Sie Ihren Körperfettanteil mit der US-Militär-Umfangsmethode (DoD Tape Test). Ergebnisse nach Geschlecht und Altersgruppe.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglicher Kalorienbedarf." },
  { name: "Körperoberfläche-Rechner", url: "/de/koerperoberflaeche-rechner", description: "Körperoberfläche berechnen." },
  { name: "Abnehmenrechner", url: "/de/abnehmenrechner", description: "Abnehm-Planung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Militär-Körperfett-Rechner" enSlug="army-body-fat-calculator" keywords="Militär Körperfett, Army Tape Test, DoD Körperfett, Umfangsmethode, Militär Fitness" breadcrumbs={[{ name: "Militär-Körperfett-Rechner", url: "/de/militaer-koerperfett-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Militär-Körperfett-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Körperfettschätzung nach US-Militär-Umfangsmethode (Tape Test).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="mkf-gen flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-g="male">Männlich</button>
          <button class="mkf-gen flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-g="female">Weiblich</button>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Größe (cm)</label><input type="number" id="mkf-ht" class="mkf-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="178" min="130" max="220" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Halsumfang (cm)</label><input type="number" id="mkf-neck" class="mkf-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="39" min="20" max="75" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Taillenumfang (cm)</label><input type="number" id="mkf-waist" class="mkf-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="86" min="40" max="150" step="0.5"></div>
          <div id="mkf-hip-wrap"><label class="block text-xs font-medium text-text mb-1">Hüftumfang (cm) — Frauen</label><input type="number" id="mkf-hip" class="mkf-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="97" min="50" max="150" step="0.5" disabled></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Alter</label><input type="number" id="mkf-age" class="mkf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="17" max="60" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Körperfettanteil</div>
          <div class="text-5xl font-extrabold font-mono" id="mkf-result">0%</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="mkf-status-box"><div class="font-bold text-sm" id="mkf-status">-</div></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Army-Standards nach Alter</h3>
          <div class="text-xs space-y-1" id="mkf-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="militaer-koerperfett" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Der US Army Tape Test</h2>
      <p>Der Tape Test ist die offizielle Methode der US-Armee zur Körperfettmessung. Er verwendet Umfangsmessungen von Hals, Taille und bei Frauen zusätzlich der Hüfte. Die Formel basiert auf logarithmischen Berechnungen und liefert eine Schätzung des Körperfettanteils.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie genau ist der Tape Test?</strong> Die Methode hat eine Fehlertoleranz von ±3-4%. Sie dient als Screening-Tool und ersetzt keine professionelle Körperfettmessung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let mkfGender = 'male';
    const MKF_MALE_MAX: Record<string, number> = { '17-20': 20, '21-27': 22, '28-39': 24, '40+': 26 };
    const MKF_FEMALE_MAX: Record<string, number> = { '17-20': 30, '21-27': 32, '28-39': 34, '40+': 36 };
    function getMkfAgeGroup(age: number): string {
      if (age <= 20) return '17-20';
      if (age <= 27) return '21-27';
      if (age <= 39) return '28-39';
      return '40+';
    }
    function calcMKF() {
      const htCm = parseFloat((document.getElementById('mkf-ht') as HTMLInputElement).value) || 0;
      const neckCm = parseFloat((document.getElementById('mkf-neck') as HTMLInputElement).value) || 0;
      const waistCm = parseFloat((document.getElementById('mkf-waist') as HTMLInputElement).value) || 0;
      const hipCm = parseFloat((document.getElementById('mkf-hip') as HTMLInputElement).value) || 0;
      const age = parseInt((document.getElementById('mkf-age') as HTMLInputElement).value) || 25;
      // Convert cm to inches for the formula
      const ht = htCm / 2.54;
      const neck = neckCm / 2.54;
      const waist = waistCm / 2.54;
      const hip = hipCm / 2.54;
      let bf: number;
      if (mkfGender === 'male') {
        bf = 86.010 * Math.log10(waist - neck) - 70.041 * Math.log10(ht) + 36.76;
      } else {
        bf = 163.205 * Math.log10(waist + hip - neck) - 97.684 * Math.log10(ht) - 78.387;
      }
      bf = Math.max(0, bf);
      const ageGroup = getMkfAgeGroup(age);
      const maxBF = mkfGender === 'male' ? MKF_MALE_MAX[ageGroup] : MKF_FEMALE_MAX[ageGroup];
      const pass = bf <= maxBF;
      document.getElementById('mkf-result')!.textContent = bf.toFixed(1) + '%';
      document.getElementById('mkf-status')!.textContent = pass ? 'BESTANDEN \u2014 Unter ' + maxBF + '% Grenze f\u00fcr ' + ageGroup : 'NICHT BESTANDEN \u2014 \u00dcber ' + maxBF + '% Grenze f\u00fcr ' + ageGroup;
      document.getElementById('mkf-status-box')!.className = 'p-4 rounded-xl text-center ' + (pass ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800');
      const standards = mkfGender === 'male' ? MKF_MALE_MAX : MKF_FEMALE_MAX;
      document.getElementById('mkf-table')!.innerHTML = Object.entries(standards).map(([ag, max]) => {
        const current = ag === ageGroup;
        return '<div class="flex justify-between ' + (current ? 'font-bold text-primary' : '') + '"><span>Alter ' + ag + '</span><span>Max: ' + max + '%' + (current ? ' \u2190 Ihre Gruppe' : '') + '</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mkf-gen').forEach(b => b.addEventListener('click', () => {
        mkfGender = (b as HTMLButtonElement).dataset.g!;
        document.querySelectorAll('.mkf-gen').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.g === mkfGender;
          (btn as HTMLButtonElement).className = 'mkf-gen flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        (document.getElementById('mkf-hip') as HTMLInputElement).disabled = mkfGender === 'male';
        calcMKF();
      }));
      document.querySelectorAll('.mkf-in').forEach(el => { el.addEventListener('input', calcMKF); el.addEventListener('change', calcMKF); });
      calcMKF();
    }, 50);
  </script>
</CalculatorLayout>
