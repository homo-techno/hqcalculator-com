---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Koi-Teich Rechner";
const description = "Berechnen Sie Teichvolumen, Filtergröße und Besatzdichte für Koi-Teiche.";

const relatedCalcs = [
  { name: "Rasenrechner", url: "/de/rasen-rechner", description: "Rasenbedarf berechnen." },
  { name: "Gartenbeleuchtung Rechner", url: "/de/gartenbeleuchtung-rechner", description: "Beleuchtung planen." },
  { name: "Grundstücksfläche Rechner", url: "/de/grundstuecksflaeche-rechner", description: "Flächen berechnen." },
  { name: "Geländegradierung Rechner", url: "/de/gelaendegradierung-rechner", description: "Erdarbeiten planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Koi-Teich Rechner" lang="de" enSlug="koi-pond-calculator" keywords="koi teich rechner, teichvolumen berechnen, koi besatzdichte, teichfilter größe" breadcrumbs={[{ name: "Koi-Teich Rechner", url: "/de/koi-teich-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Koi-Teich Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Wasservolumen, die empfohlene Filtergröße und die maximale Besatzdichte für Ihren Koi-Teich.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Länge (m)</label><input type="number" id="ktr-len" class="ktr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0.5" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (m)</label><input type="number" id="ktr-wid" class="ktr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0.5" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tiefe (m)</label><input type="number" id="ktr-dep" class="ktr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" min="0.5" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Teichform</label><select id="ktr-shape" class="ktr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1" selected>Rechteckig</option>
            <option value="0.785">Oval / Ellipse</option>
            <option value="0.75">Nierenform</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Koi-Größe (cm)</label><select id="ktr-koisize" class="ktr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="20">Klein (bis 20 cm)</option>
            <option value="40" selected>Mittel (20–40 cm)</option>
            <option value="60">Groß (40–60 cm)</option>
            <option value="80">Jumbo (über 60 cm)</option>
          </select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Teichvolumen</div>
          <div class="text-4xl font-extrabold font-mono" id="ktr-vol">0 L</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Koi</div><div class="text-xl font-bold" id="ktr-koi">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Filter (L/h)</div><div class="text-xl font-bold" id="ktr-filter">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pumpe (L/h)</div><div class="text-xl font-bold" id="ktr-pump">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="koi-pond-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Koi-Teich richtig planen</h2>
      <p>Ein gesunder Koi-Teich erfordert sorgfältige Planung. Die Faustregel lautet: Pro ausgewachsener Koi (40–60 cm) werden mindestens 1.000–2.000 Liter Wasser benötigt. Das Filtervolumen sollte mindestens 10 % des Teichvolumens betragen, die Pumpe muss das gesamte Wasser mindestens einmal pro Stunde umwälzen. Eine Mindesttiefe von 1,5 m schützt die Koi vor Räubern und Temperaturschwankungen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie tief sollte ein Koi-Teich sein?</strong> Mindestens 1,5 m, besser 2 m. Eine ausreichende Tiefe schützt vor Frost, Räubern (z. B. Graureiher) und starken Temperaturschwankungen.</p>
      <p><strong>Wie viele Koi passen in meinen Teich?</strong> Als Faustregel gilt: 1 cm Fischlänge pro 10–20 Liter Wasser. Ein 10.000-Liter-Teich fasst also max. 5–10 ausgewachsene Koi (50 cm).</p>
      <p><strong>Welche Filtergröße brauche ich?</strong> Der Filter sollte das komplette Teichvolumen in 1–2 Stunden umwälzen. Bei starkem Besatz empfiehlt sich eine Überdimensionierung.</p>
      <p><strong>Muss ich den Teich im Winter abdecken?</strong> Bei Tiefen über 1,5 m und milden Wintern ist eine Abdeckung nicht zwingend nötig. Wichtig ist, dass das Wasser nicht komplett einfriert – ein Eisfreihalter hilft dabei.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKTR() {
      const len = parseFloat((document.getElementById('ktr-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('ktr-wid') as HTMLInputElement).value) || 0;
      const dep = parseFloat((document.getElementById('ktr-dep') as HTMLInputElement).value) || 0;
      const shape = parseFloat((document.getElementById('ktr-shape') as HTMLSelectElement).value) || 1;
      const koiSize = parseInt((document.getElementById('ktr-koisize') as HTMLSelectElement).value) || 40;
      const volM3 = len * wid * dep * shape;
      const volL = Math.round(volM3 * 1000);
      const litersPerCm = koiSize <= 20 ? 10 : koiSize <= 40 ? 20 : koiSize <= 60 ? 40 : 80;
      const maxKoi = Math.floor(volL / (koiSize * litersPerCm));
      const filterLh = Math.round(volL * 1.5);
      const pumpLh = Math.round(volL);
      document.getElementById('ktr-vol')!.textContent = volL.toLocaleString('de-DE') + ' L';
      document.getElementById('ktr-koi')!.textContent = maxKoi.toLocaleString('de-DE');
      document.getElementById('ktr-filter')!.textContent = filterLh.toLocaleString('de-DE');
      document.getElementById('ktr-pump')!.textContent = pumpLh.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.ktr-in').forEach(el => { el.addEventListener('input', calcKTR); el.addEventListener('change', calcKTR); }); calcKTR(); }, 50);
  </script>
</CalculatorLayout>
