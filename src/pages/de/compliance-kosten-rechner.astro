---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Compliance-Kosten-Rechner - J\u00e4hrliches Compliance-Budget";
const description = "Sch\u00e4tzen Sie die j\u00e4hrlichen Compliance-Kosten f\u00fcr Ihr Unternehmen basierend auf Branche, Unternehmensgr\u00f6\u00dfe und regulatorischen Anforderungen.";
const relatedCalcs = [
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Budgetierung." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Gewinnspannenrechner", url: "/de/gewinnspanne-rechner", description: "Gewinnspanne." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Compliance-Kosten-Rechner" lang="de" enSlug="compliance-cost-calculator" keywords="compliance kosten, regulatorische compliance, compliance budget, branchenspezifisch, DSGVO kosten, compliance personal" breadcrumbs={[{ name: "Compliance-Kosten", url: "/de/compliance-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Compliance-Kosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihr j&auml;hrliches Compliance-Budget nach Branche und Unternehmensgr&ouml;&szlig;e.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Branche</label>
          <select id="ck-industry" class="ck-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="finance">Finanzdienstleistungen / Banken</option>
            <option value="healthcare" selected>Gesundheitswesen / Pharma</option>
            <option value="tech">Technologie / SaaS</option>
            <option value="manufacturing">Produktion / Industrie</option>
            <option value="energy">Energie / Versorgung</option>
            <option value="retail">Einzelhandel / E-Commerce</option>
            <option value="construction">Bauwesen</option>
            <option value="food">Lebensmittel &amp; Getr&auml;nke</option>
            <option value="general">Sonstige</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl Mitarbeiter</label>
          <input type="number" id="ck-employees" class="ck-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="1" max="100000" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Jahresumsatz (&euro;)</label>
          <input type="number" id="ck-revenue" class="ck-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000000" min="0" step="100000">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Regulatorischer Rahmen</label>
          <select id="ck-framework" class="ck-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="basic" selected>Basis (nur nationale Vorschriften)</option>
            <option value="moderate">Mittel (+ EU-Verordnungen)</option>
            <option value="heavy">Umfangreich (DSGVO, BaFin, MiFID etc.)</option>
            <option value="international">International (+ ISO, SOX etc.)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">B&ouml;rsennotiert?</label>
          <select id="ck-public" class="ck-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="no" selected>Nein - Privatunternehmen</option>
            <option value="yes">Ja - B&ouml;rsennotiert</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Datenverarbeitungsniveau</label>
          <select id="ck-data" class="ck-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="minimal">Minimale personenbezogene Daten</option>
            <option value="moderate" selected>Mittlere Datenverarbeitung</option>
            <option value="extensive">Umfangreiche / sensible Daten (PII, Gesundheitsdaten)</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte j&auml;hrliche Compliance-Kosten</div>
          <div class="text-5xl font-extrabold font-mono" id="ck-total"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Personalkosten</div>
            <div class="text-xl font-bold text-secondary" id="ck-staff"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Technologie &amp; Tools</div>
            <div class="text-xl font-bold" id="ck-tech"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Audit &amp; Beratung</div>
            <div class="text-xl font-bold text-orange-600" id="ck-audit"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">% vom Umsatz</div>
            <div class="text-xl font-bold" id="ck-pct"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="compliance-cost" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Compliance-Kosten verstehen</h2>
      <p>Compliance-Kosten liegen typischerweise zwischen 1,5% und 10% des Umsatzes, abh&auml;ngig von Branche und regulatorischer Belastung. Im DACH-Raum kommen insbesondere DSGVO, GwG (Geldw&auml;schegesetz) und branchenspezifische Vorschriften hinzu. Die Kosten f&uuml;r Nicht-Compliance (&Uuml;berpr&uuml;fungen, Bu&szlig;gelder, Reputationsschaden) sind typischerweise 2-3 mal h&ouml;her als die Compliance-Kosten selbst.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Wichtige Kostentreiber</h3>
      <p>Zu den wesentlichen Kostenkomponenten geh&ouml;ren dediziertes Compliance-Personal, Regulierungstechnologie (RegTech), externe Pr&uuml;fungen, Rechtsberatung, Schulungsprogramme und Meldepflichten.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcCK() {
      const industry = (document.getElementById('ck-industry') as HTMLSelectElement).value;
      const employees = parseInt((document.getElementById('ck-employees') as HTMLInputElement).value) || 50;
      const revenue = parseFloat((document.getElementById('ck-revenue') as HTMLInputElement).value) || 0;
      const framework = (document.getElementById('ck-framework') as HTMLSelectElement).value;
      const isPublic = (document.getElementById('ck-public') as HTMLSelectElement).value;
      const dataLevel = (document.getElementById('ck-data') as HTMLSelectElement).value;

      const industryBase: Record<string, number> = {
        finance: 3500, healthcare: 3200, tech: 2000, manufacturing: 1800,
        energy: 2800, retail: 1200, construction: 1500, food: 1600, general: 1000
      };

      const frameworkMultiplier: Record<string, number> = {
        basic: 1.0, moderate: 1.5, heavy: 2.2, international: 2.8
      };

      const dataMultiplier: Record<string, number> = { minimal: 0.8, moderate: 1.0, extensive: 1.5 };

      let complianceStaff = Math.max(1, Math.ceil(employees / 100));
      if (framework === 'heavy' || framework === 'international') complianceStaff = Math.max(2, Math.ceil(employees / 50));
      const avgSalary = industry === 'finance' ? 85000 : industry === 'healthcare' ? 75000 : 65000;
      const staffingCost = complianceStaff * avgSalary;

      const techCost = employees * (dataLevel === 'extensive' ? 500 : dataLevel === 'moderate' ? 250 : 100);

      let auditCost = 15000;
      if (isPublic === 'yes') auditCost += 120000;
      if (framework === 'heavy') auditCost += 30000;
      if (framework === 'international') auditCost += 50000;
      if (employees > 500) auditCost *= 1.5;

      const total = staffingCost + techCost + auditCost;
      const pctRevenue = revenue > 0 ? ((total / revenue) * 100).toFixed(1).replace('.', ',') + '%' : 'k.A.';

      document.getElementById('ck-total')!.textContent = fmtEur(total);
      document.getElementById('ck-staff')!.textContent = fmtEur(staffingCost);
      document.getElementById('ck-tech')!.textContent = fmtEur(techCost);
      document.getElementById('ck-audit')!.textContent = fmtEur(auditCost);
      document.getElementById('ck-pct')!.textContent = pctRevenue;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ck-in').forEach(el => {
        el.addEventListener('input', calcCK);
        el.addEventListener('change', calcCK);
      });
      calcCK();
    }, 50);
  </script>
</CalculatorLayout>
