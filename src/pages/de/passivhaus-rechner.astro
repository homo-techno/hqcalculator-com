---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Passivhaus Rechner - Heizwärmebedarf & Energiekennzahlen";
const description = "Berechnen Sie Heizwärmebedarf und Energiekennzahlen für Passivhäuser nach dem Passivhaus-Institut Standard (max. 15 kWh/m²a).";

const relatedCalcs = [
  { name: "Heizkosten-Rechner", url: "/de/heizkosten-rechner", description: "Heizkosten." },
  { name: "Dämmung-Rechner", url: "/de/daemmung-rechner", description: "Wärmedämmung." },
  { name: "Wohnflächen-Rechner", url: "/de/wohnflaechen-rechner", description: "Wohnfläche." },
  { name: "Energiekosten-Rechner", url: "/de/energiekosten-rechner", description: "Energiekosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Passivhaus Rechner" lang="de" enSlug="passive-house-calculator" keywords="passivhaus rechner, heizwärmebedarf berechnen, passivhaus standard, kWh m2a, passivhaus institut" breadcrumbs={[{ name: "Passivhaus Rechner", url: "/de/passivhaus-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Passivhaus Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Heizwärmebedarf und Primärenergiebedarf für Ihr Passivhaus-Projekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wohnfläche (m²)</label><input type="number" id="phw-area" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="20" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Klimazone</label>
            <select id="phw-climate" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="mild">Mild (Hamburg, Köln)</option>
              <option value="moderate" selected>Gemäßigt (Frankfurt, Berlin)</option>
              <option value="cold">Kalt (München, Stuttgart)</option>
              <option value="alpine">Alpin (&gt;600 m ü. NN)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">U-Wert Außenwand (W/m²K)</label><input type="number" id="phw-uwall" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.13" min="0.05" max="2" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">U-Wert Dach (W/m²K)</label><input type="number" id="phw-uroof" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.10" min="0.05" max="2" step="0.01"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">U-Wert Fenster (W/m²K)</label><input type="number" id="phw-uwin" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.80" min="0.3" max="3" step="0.05"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fensterfläche (m²)</label><input type="number" id="phw-warea" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lüftung WRG-Effizienz (%)</label><input type="number" id="phw-hrv" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="85" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bewohner</label><input type="number" id="phw-persons" class="phw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="20" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Heizwärmebedarf</div>
          <div class="text-4xl font-extrabold font-mono" id="phw-result">0 kWh/m²a</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Passivhaus-Standard</div><div class="text-xl font-bold" id="phw-standard">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährl. Heizenergie</div><div class="text-xl font-bold" id="phw-annual">0 kWh</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Heizkosten/Jahr</div><div class="text-xl font-bold" id="phw-cost">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="passivhaus-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Der Passivhaus-Standard</h2>
      <p class="text-text-secondary mt-2">Ein Passivhaus benötigt laut Passivhaus Institut Darmstadt maximal 15 kWh/(m²a) Heizwärme. Zum Vergleich: Ein Altbau verbraucht oft 150–300 kWh/(m²a). Erreicht wird dies durch sehr gute Wärmedämmung (U-Werte unter 0,15 W/m²K), Wärmebrückenfreiheit, luftdichte Gebäudehülle und eine kontrollierte Wohnraumlüftung mit Wärmerückgewinnung (WRG ≥ 75 %).</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Passivhaus:</strong> Heizwärmebedarf ≤ 15 kWh/(m²a)</p>
        <p><strong>Primärenergie:</strong> ≤ 120 kWh/(m²a) (klassisch)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was kostet ein Passivhaus mehr als ein Standardbau?</strong> Passivhäuser kosten in der Errichtung ca. 5–15 % mehr als vergleichbare Niedrigenergiehäuser. Die Mehrkosten amortisieren sich durch niedrige Energiekosten meist in 10–20 Jahren.</p>
      <p><strong>Brauche ich noch eine Heizung im Passivhaus?</strong> Ja, aber sehr kleine. Oft reicht ein Luft-Wasser-Wärmepumpen-System oder eine Holzpelletheizung. Viele Passivhäuser nutzen die Nachheizung integriert in der Lüftungsanlage.</p>
      <p><strong>Wie funktioniert die Wärmerückgewinnung?</strong> Die Abluft erwärmt über einen Wärmetauscher die frische Außenluft, ohne dass die Luftströme sich mischen. Effizienzen von 75–95 % sind möglich.</p>
      <p><strong>Was ist der Unterschied zwischen Passivhaus und KfW-Effizienzhaus?</strong> KfW-Effizienzhäuser (z.B. KfW 40) sind eine deutsche Förderkategorie. Das Passivhaus-Zertifikat ist strenger und international anerkannt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const phwEuro = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' \u20AC';

    function calcPHW() {
      const area = parseFloat((document.getElementById('phw-area') as HTMLInputElement).value) || 150;
      const climate = (document.getElementById('phw-climate') as HTMLSelectElement).value;
      const uWall = parseFloat((document.getElementById('phw-uwall') as HTMLInputElement).value) || 0.13;
      const uRoof = parseFloat((document.getElementById('phw-uroof') as HTMLInputElement).value) || 0.10;
      const uWin = parseFloat((document.getElementById('phw-uwin') as HTMLInputElement).value) || 0.80;
      const winArea = parseFloat((document.getElementById('phw-warea') as HTMLInputElement).value) || 25;
      const hrv = parseFloat((document.getElementById('phw-hrv') as HTMLInputElement).value) || 85;
      const persons = parseInt((document.getElementById('phw-persons') as HTMLInputElement).value) || 3;

      const hdd: Record<string, number> = { mild: 3200, moderate: 3800, cold: 4400, alpine: 5200 };
      const heatingDegDays = hdd[climate] || 3800;

      const wallArea = area * 0.7;
      const roofArea = area * 0.6;
      const transmissionLoss = (uWall * wallArea + uRoof * roofArea + uWin * winArea) * heatingDegDays * 0.024;
      const ventLoss = area * 2.5 * 0.33 * heatingDegDays * 0.024 * (1 - hrv / 100);
      const internalGains = persons * 80 * 8760 / 1000;
      const solarGains = winArea * 0.4 * 800;
      const demandKWh = Math.max(transmissionLoss + ventLoss - internalGains - solarGains, 0);
      const demandPerM2 = demandKWh / area;

      const standard = demandPerM2 <= 15 ? 'Passivhaus' : demandPerM2 <= 25 ? 'EnerPhit' : demandPerM2 <= 50 ? 'KfW 40' : demandPerM2 <= 75 ? 'KfW 55' : 'Niedrigenergiehaus';
      const standardColor = demandPerM2 <= 15 ? 'text-green-700' : demandPerM2 <= 50 ? 'text-yellow-700' : 'text-red-700';
      const heatCost = demandKWh * 0.12;

      document.getElementById('phw-result')!.textContent = demandPerM2.toFixed(1).replace('.', ',') + ' kWh/m\u00B2a';
      const el = document.getElementById('phw-standard')!;
      el.textContent = standard;
      el.className = 'text-xl font-bold ' + standardColor;
      document.getElementById('phw-annual')!.textContent = Math.round(demandKWh).toLocaleString('de-DE') + ' kWh';
      document.getElementById('phw-cost')!.textContent = phwEuro(heatCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.phw-in').forEach(el => { el.addEventListener('input', calcPHW); el.addEventListener('change', calcPHW); });
      calcPHW();
    }, 50);
  </script>
</CalculatorLayout>
