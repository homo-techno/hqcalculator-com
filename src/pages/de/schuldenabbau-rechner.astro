---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schuldenabbau-Rechner - Schneeball- & Lawinen-Methode";
const description = "Berechnen Sie, wie schnell Sie Ihre Schulden tilgen koennen. Vergleichen Sie Schneeball- vs. Lawinen-Methode mit Tilgungsplaenen und Zinsersparnis.";

const relatedCalcs = [
  { name: "Kreditrechner", url: "/de/kredit-rechner", description: "Kreditraten." },
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Immobilienkredite." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
  { name: "Zinseszinsrechner", url: "/de/zinseszins-rechner", description: "Zinseszins." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="debt-payoff-calculator" calculatorName="Schuldenabbau-Rechner" keywords="schuldenabbau rechner, schneeball methode, lawinen methode, schulden tilgen, kreditkarte tilgen, schuldenfrei" breadcrumbs={[{ name: "Schuldenabbau-Rechner", url: "/de/schuldenabbau-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schuldenabbau-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sehen Sie, wie schnell Sie schuldenfrei werden k&ouml;nnen &ndash; mit Schneeball- oder Lawinen-Strategie.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border text-left">
              <th class="py-2 pr-2 font-semibold">Bezeichnung</th>
              <th class="py-2 pr-2 font-semibold">Saldo</th>
              <th class="py-2 pr-2 font-semibold">Zinssatz (%)</th>
              <th class="py-2 pr-2 font-semibold">Mindestrate</th>
              <th class="py-2"></th>
            </tr>
          </thead>
          <tbody id="sa-tbody">
            <tr class="sa-row border-b border-border/30">
              <td class="py-2 pr-2"><input type="text" class="sa-name w-full px-2 py-1.5 border border-border rounded-lg" value="Kreditkarte 1"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-bal w-28 px-2 py-1.5 border border-border rounded-lg" value="5000" min="0"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-apr w-20 px-2 py-1.5 border border-border rounded-lg" value="18.9" min="0" step="0.01"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-min w-24 px-2 py-1.5 border border-border rounded-lg" value="100" min="0"></td>
              <td class="py-2"><button class="sa-rm text-danger text-lg hover:text-red-700">&times;</button></td>
            </tr>
            <tr class="sa-row border-b border-border/30">
              <td class="py-2 pr-2"><input type="text" class="sa-name w-full px-2 py-1.5 border border-border rounded-lg" value="Kreditkarte 2"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-bal w-28 px-2 py-1.5 border border-border rounded-lg" value="3000" min="0"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-apr w-20 px-2 py-1.5 border border-border rounded-lg" value="14.9" min="0" step="0.01"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-min w-24 px-2 py-1.5 border border-border rounded-lg" value="75" min="0"></td>
              <td class="py-2"><button class="sa-rm text-danger text-lg hover:text-red-700">&times;</button></td>
            </tr>
            <tr class="sa-row border-b border-border/30">
              <td class="py-2 pr-2"><input type="text" class="sa-name w-full px-2 py-1.5 border border-border rounded-lg" value="Autokredit"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-bal w-28 px-2 py-1.5 border border-border rounded-lg" value="12000" min="0"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-apr w-20 px-2 py-1.5 border border-border rounded-lg" value="4.9" min="0" step="0.01"></td>
              <td class="py-2 pr-2"><input type="number" class="sa-min w-24 px-2 py-1.5 border border-border rounded-lg" value="350" min="0"></td>
              <td class="py-2"><button class="sa-rm text-danger text-lg hover:text-red-700">&times;</button></td>
            </tr>
          </tbody>
        </table>
      </div>
      <button id="sa-add" class="px-4 py-2 border border-border rounded-xl text-sm font-semibold hover:bg-surface-alt mb-6">+ Schuld hinzuf&uuml;gen</button>

      <div class="grid grid-cols-2 gap-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Zusatzzahlung monatlich</label>
          <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span><input type="number" id="sa-extra" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-lg" value="200" min="0" step="25"></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Strategie</label>
          <div class="flex gap-2">
            <button class="sa-strat-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-primary text-white" data-strat="avalanche">Lawine</button>
            <button class="sa-strat-btn flex-1 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary" data-strat="snowball">Schneeball</button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Schuldenfrei-Datum</div>
          <div class="text-3xl font-extrabold" id="sa-date">&mdash;</div>
          <div class="text-sm text-blue-200 mt-1" id="sa-months">0 Monate</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtschulden</div>
            <div class="text-xl font-bold" id="sa-total-debt">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gezahlte Zinsen</div>
            <div class="text-xl font-bold text-danger" id="sa-total-int">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamt bezahlt</div>
            <div class="text-xl font-bold" id="sa-total-paid">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zinsersparnis</div>
            <div class="text-xl font-bold text-secondary" id="sa-saved">0 &euro;</div>
          </div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Tilgungsreihenfolge</h3>
        <div id="sa-order" class="space-y-2 text-sm"></div>
      </div>

      <ShareButton lang="de" calculatorId="debt-payoff" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Schneeball- vs. Lawinen-Methode</h2>
      <ul>
        <li><strong>Lawine (empfohlen):</strong> Zuerst den h&ouml;chsten Zinssatz tilgen. Spart mathematisch am meisten.</li>
        <li><strong>Schneeball:</strong> Zuerst den kleinsten Saldo tilgen. Bietet psychologische Erfolgserlebnisse.</li>
      </ul>
      <p>Beide Methoden: Mindestrate auf alle Schulden zahlen, dann den &Uuml;berschuss auf die Zielschuld anwenden.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Methode ist besser?</strong> Lawine spart mehr Zinsen. Schneeball bietet schnellere Erfolgserlebnisse. W&auml;hlen Sie Schneeball, wenn Sie Motivation brauchen; Lawine, wenn Sie Kosten minimieren wollen.</p>
      <p><strong>Wie viel extra sollte ich zahlen?</strong> Jeder Extrabetrag hilft. Schon 50-100 &euro; monatlich k&ouml;nnen Jahre abschneiden und Tausende an Zinsen sparen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let saStrat = 'avalanche';
    const saFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    type SADebt = { name: string; balance: number; apr: number; minPay: number };

    function getSADebts(): SADebt[] {
      const debts: SADebt[] = [];
      document.querySelectorAll('.sa-row').forEach(row => {
        const name = (row.querySelector('.sa-name') as HTMLInputElement).value || 'Schuld';
        const balance = parseFloat((row.querySelector('.sa-bal') as HTMLInputElement).value) || 0;
        const apr = parseFloat((row.querySelector('.sa-apr') as HTMLInputElement).value) || 0;
        const minPay = parseFloat((row.querySelector('.sa-min') as HTMLInputElement).value) || 0;
        if (balance > 0) debts.push({ name, balance, apr, minPay });
      });
      return debts;
    }

    function simulateSA(debts: SADebt[], extra: number, strategy: string): { months: number; totalInterest: number; totalPaid: number; order: { name: string; month: number }[] } {
      const balances = debts.map(d => d.balance);
      let months = 0; let totalInterest = 0; let totalPaid = 0;
      const order: { name: string; month: number }[] = [];
      while (balances.some(b => b > 0.01) && months < 600) {
        months++;
        let extraLeft = extra;
        for (let i = 0; i < debts.length; i++) {
          if (balances[i] <= 0) continue;
          const interest = balances[i] * debts[i].apr / 100 / 12;
          totalInterest += interest;
          balances[i] += interest;
          const payment = Math.min(balances[i], debts[i].minPay);
          balances[i] -= payment;
          totalPaid += payment;
        }
        let priorityOrder: number[];
        if (strategy === 'snowball') {
          priorityOrder = debts.map((_, i) => i).filter(i => balances[i] > 0).sort((a, b) => balances[a] - balances[b]);
        } else {
          priorityOrder = debts.map((_, i) => i).filter(i => balances[i] > 0).sort((a, b) => debts[b].apr - debts[a].apr);
        }
        for (const i of priorityOrder) {
          if (extraLeft <= 0) break;
          const payment = Math.min(balances[i], extraLeft);
          balances[i] -= payment;
          totalPaid += payment;
          extraLeft -= payment;
        }
        for (let i = 0; i < debts.length; i++) {
          if (balances[i] <= 0.01 && !order.find(o => o.name === debts[i].name)) {
            order.push({ name: debts[i].name, month: months });
            balances[i] = 0;
          }
        }
      }
      return { months, totalInterest, totalPaid, order };
    }

    function calcSA() {
      const debts = getSADebts();
      if (debts.length === 0) return;
      const extra = parseFloat((document.getElementById('sa-extra') as HTMLInputElement).value) || 0;
      const result = simulateSA(debts, extra, saStrat);
      const baseResult = simulateSA(debts, 0, saStrat);
      const totalDebt = debts.reduce((s, d) => s + d.balance, 0);
      const saved = baseResult.totalInterest - result.totalInterest;

      const now = new Date();
      const payoffDate = new Date(now.getFullYear(), now.getMonth() + result.months);
      const monthNames = ['Jan', 'Feb', 'M\u00e4r', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];

      document.getElementById('sa-date')!.textContent = monthNames[payoffDate.getMonth()] + ' ' + payoffDate.getFullYear();
      document.getElementById('sa-months')!.textContent = result.months + ' Monate (' + (result.months / 12).toFixed(1) + ' Jahre)';
      document.getElementById('sa-total-debt')!.textContent = saFmt(totalDebt);
      document.getElementById('sa-total-int')!.textContent = saFmt(result.totalInterest);
      document.getElementById('sa-total-paid')!.textContent = saFmt(result.totalPaid);
      document.getElementById('sa-saved')!.textContent = saFmt(saved);

      document.getElementById('sa-order')!.innerHTML = result.order.map((o, i) =>
        '<div class="flex justify-between items-center py-1.5 px-3 rounded-lg ' + (i === 0 ? 'bg-primary/10 font-semibold' : '') + '"><span>' + (i + 1) + '. ' + o.name + '</span><span class="text-text-muted">Monat ' + o.month + ' (' + monthNames[new Date(now.getFullYear(), now.getMonth() + o.month).getMonth()] + ' ' + new Date(now.getFullYear(), now.getMonth() + o.month).getFullYear() + ')</span></div>'
      ).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function addSARow() {
      const tbody = document.getElementById('sa-tbody')!;
      const tr = document.createElement('tr');
      tr.className = 'sa-row border-b border-border/30';
      tr.innerHTML = '<td class="py-2 pr-2"><input type="text" class="sa-name w-full px-2 py-1.5 border border-border rounded-lg" value="Neue Schuld"></td><td class="py-2 pr-2"><input type="number" class="sa-bal w-28 px-2 py-1.5 border border-border rounded-lg" value="1000" min="0"></td><td class="py-2 pr-2"><input type="number" class="sa-apr w-20 px-2 py-1.5 border border-border rounded-lg" value="12" min="0" step="0.01"></td><td class="py-2 pr-2"><input type="number" class="sa-min w-24 px-2 py-1.5 border border-border rounded-lg" value="50" min="0"></td><td class="py-2"><button class="sa-rm text-danger text-lg hover:text-red-700">\u00d7</button></td>';
      tbody.appendChild(tr);
      tr.querySelectorAll('input').forEach(el => el.addEventListener('input', calcSA));
      tr.querySelector('.sa-rm')!.addEventListener('click', () => { tr.remove(); calcSA(); });
    }

    setTimeout(() => {
      document.querySelectorAll('.sa-strat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.sa-strat-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          saStrat = (btn as HTMLElement).dataset.strat || 'avalanche';
          calcSA();
        });
      });
      document.querySelectorAll('.sa-row input').forEach(el => el.addEventListener('input', calcSA));
      document.querySelectorAll('.sa-rm').forEach(btn => {
        btn.addEventListener('click', () => { (btn as HTMLElement).closest('.sa-row')!.remove(); calcSA(); });
      });
      document.getElementById('sa-add')!.addEventListener('click', addSARow);
      document.getElementById('sa-extra')!.addEventListener('input', calcSA);
      calcSA();
    }, 50);
  </script>
</CalculatorLayout>
