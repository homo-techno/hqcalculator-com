---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fischvertr&auml;glichkeit-Rechner - Kompatibilit&auml;t nach Art";
const description = "Pr&uuml;fen Sie die Vertr&auml;glichkeit von Fischarten anhand von Temperament, Gr&ouml;&szlig;e, Wasserparametern und Schwimmzone f&uuml;r ein friedliches Gesellschaftsaquarium.";
const relatedCalcs = [
  { name: "Aquarium-Besatz", url: "/de/aquarium-besatz-rechner", description: "Besatzdichte berechnen." },
  { name: "Fischf&uuml;tterung", url: "/de/fischfuetterung-rechner", description: "Futtermenge berechnen." },
  { name: "Zuchtbecken", url: "/de/zuchtbecken-rechner", description: "Zuchtbecken planen." },
  { name: "Aquarium-Heizung", url: "/de/aquarium-heizung-rechner", description: "Heizleistung berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fischvertr&auml;glichkeit-Rechner" lang="de" enSlug="fish-compatibility-calculator" keywords="Fischvertr&auml;glichkeit, Gesellschaftsaquarium, Fisch Temperament, Aquarium Besatz, Fischarten Kompatibilit&auml;t" breadcrumbs={[{ name: "Fischvertr&auml;glichkeit", url: "/de/fischvertraeglichkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fischvertr&auml;glichkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie die Vertr&auml;glichkeit anhand von Temperament, Gr&ouml;&szlig;e, Wassertemperatur und Schwimmzone.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <p class="text-sm font-semibold text-text">Fischart 1</p>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Temperament</label>
            <select id="fvr-t1" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="peaceful">Friedlich</option>
              <option value="semi" selected>Halb-aggressiv</option>
              <option value="aggressive">Aggressiv</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Max. Gr&ouml;&szlig;e (cm)</label>
            <input type="number" id="fvr-s1" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" max="90" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bevorzugte Temp. (&deg;C)</label>
            <input type="number" id="fvr-temp1" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="15" max="32" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Schwimmzone</label>
            <select id="fvr-z1" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="top">Oben</option>
              <option value="mid" selected>Mitte</option>
              <option value="bottom">Unten</option>
              <option value="all">Alle Zonen</option>
            </select>
          </div>
        </div>
        <p class="text-sm font-semibold text-text">Fischart 2</p>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Temperament</label>
            <select id="fvr-t2" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="peaceful" selected>Friedlich</option>
              <option value="semi">Halb-aggressiv</option>
              <option value="aggressive">Aggressiv</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Max. Gr&ouml;&szlig;e (cm)</label>
            <input type="number" id="fvr-s2" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="90" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bevorzugte Temp. (&deg;C)</label>
            <input type="number" id="fvr-temp2" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="26" min="15" max="32" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Schwimmzone</label>
            <select id="fvr-z2" class="fvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="top">Oben</option>
              <option value="mid">Mitte</option>
              <option value="bottom" selected>Unten</option>
              <option value="all">Alle Zonen</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Vertr&auml;glichkeitswert</div>
          <div class="text-5xl font-extrabold font-mono" id="fvr-result">0 / 100</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Temperament</div><div class="text-xl font-bold font-mono" id="fvr-temper">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gr&ouml;&szlig;enverh&auml;ltnis</div><div class="text-xl font-bold font-mono" id="fvr-sizeratio">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Temp.-&Uuml;berlappung</div><div class="text-xl font-bold font-mono" id="fvr-tempov">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zonenkonflikt</div><div class="text-xl font-bold font-mono" id="fvr-zone">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fish-compatibility" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie wird die Vertr&auml;glichkeit berechnet?</strong> Der Rechner bewertet Temperament, Gr&ouml;&szlig;enverh&auml;ltnis, Temperatur&uuml;berlappung und Schwimmzonen-Konkurrenz.</p>
      <p><strong>Was ist ein guter Vertr&auml;glichkeitswert?</strong> &Uuml;ber 70 Punkte gelten als gut vertr&auml;glich, unter 40 als problematisch.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFVR() {
      const t1 = (document.getElementById('fvr-t1') as HTMLSelectElement).value;
      const t2 = (document.getElementById('fvr-t2') as HTMLSelectElement).value;
      const s1 = parseFloat((document.getElementById('fvr-s1') as HTMLInputElement).value) || 1;
      const s2 = parseFloat((document.getElementById('fvr-s2') as HTMLInputElement).value) || 1;
      const temp1 = parseFloat((document.getElementById('fvr-temp1') as HTMLInputElement).value) || 25;
      const temp2 = parseFloat((document.getElementById('fvr-temp2') as HTMLInputElement).value) || 25;
      const z1 = (document.getElementById('fvr-z1') as HTMLSelectElement).value;
      const z2 = (document.getElementById('fvr-z2') as HTMLSelectElement).value;
      const tScores: Record<string, number> = { peaceful: 0, semi: 1, aggressive: 2 };
      const tDiff = Math.abs((tScores[t1] || 0) - (tScores[t2] || 0));
      let temperScore = tDiff === 0 ? 30 : tDiff === 1 ? 15 : 0;
      if ((t1 === 'aggressive' && t2 === 'peaceful') || (t2 === 'aggressive' && t1 === 'peaceful')) temperScore = 0;
      const temperLabel = temperScore >= 25 ? 'Gut' : temperScore >= 10 ? 'Vorsicht' : 'Schlecht';
      const sizeRatio = Math.max(s1, s2) / Math.min(s1, s2);
      let sizeScore = sizeRatio <= 1.5 ? 25 : sizeRatio <= 2 ? 20 : sizeRatio <= 3 ? 10 : 0;
      const sizeLabel = sizeRatio.toFixed(1) + ':1';
      const tempDiff = Math.abs(temp1 - temp2);
      let tempScore = tempDiff <= 1 ? 25 : tempDiff <= 2 ? 20 : tempDiff <= 3 ? 10 : 0;
      const tempLabel = tempDiff <= 1 ? 'Ausgezeichnet' : tempDiff <= 2 ? 'Gut' : tempDiff <= 3 ? 'Akzeptabel' : 'Schlecht';
      let zoneScore = 20;
      let zoneLabel = 'Keiner';
      if (z1 === z2) { zoneScore = 10; zoneLabel = 'Gleiche Zone'; }
      if (z1 === 'all' || z2 === 'all') { zoneScore = 15; zoneLabel = 'Teilweise'; }
      if (z1 !== z2 && z1 !== 'all' && z2 !== 'all') { zoneScore = 20; zoneLabel = 'Keiner'; }
      const total = temperScore + sizeScore + tempScore + zoneScore;
      document.getElementById('fvr-result')!.textContent = total + ' / 100';
      document.getElementById('fvr-temper')!.textContent = temperLabel;
      document.getElementById('fvr-sizeratio')!.textContent = sizeLabel;
      document.getElementById('fvr-tempov')!.textContent = tempLabel;
      document.getElementById('fvr-zone')!.textContent = zoneLabel;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fvr-in').forEach(el => { el.addEventListener('input', calcFVR); el.addEventListener('change', calcFVR); });
      calcFVR();
    }, 50);
  </script>
</CalculatorLayout>
