---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "HELOC-Rechner - Eigenheimkreditlinie berechnen";
const description = "Berechnen Sie Ihre verf&uuml;gbare Eigenheimkreditlinie (HELOC), monatliche R&uuml;ckzahlungen und Gesamtzinskosten.";

const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothek berechnen." },
  { name: "Darlehensrechner", url: "/de/darlehensrechner", description: "Kredit berechnen." },
  { name: "Tilgungsrechner", url: "/de/tilgungsrechner", description: "Tilgungsplan." },
  { name: "Immobilienrechner", url: "/de/immobilienwert-rechner", description: "Immobilienwert." },
  { name: "Zinsrechner", url: "/de/zinsrechner", description: "Zinsen berechnen." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="HELOC-Rechner"
  keywords="heloc rechner, eigenheimkreditlinie, eigenkapitalkredit, nachrangdarlehen, immobilienkredit eigenkapital"
  breadcrumbs={[{ name: "HELOC-Rechner", url: "/de/heloc-rechner" }]}
  lang="de"
  enSlug="heloc-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">HELOC-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihre verf&uuml;gbare Eigenheimkreditlinie und die R&uuml;ckzahlungskosten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Immobilienwert (&euro;)</label><input type="number" id="hlde-val" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="400000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Restschuld Hypothek (&euro;)</label><input type="number" id="hlde-bal" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="250000" min="0" step="1000"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">CLTV-Grenze (%)</label><input type="number" id="hlde-cltv" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="50" max="100" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zinssatz (%)</label><input type="number" id="hlde-rate" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.5" min="0" max="20" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kreditbetrag (&euro;)</label><input type="number" id="hlde-borrow" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Jahre)</label><input type="number" id="hlde-term" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="30" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Max. verf&uuml;gbarer Kredit</div>
          <div class="text-4xl font-extrabold font-mono" id="hlde-max">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenkapital</div><div class="text-xl font-bold" id="hlde-equity">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Rate</div><div class="text-xl font-bold" id="hlde-monthly">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtzinsen</div><div class="text-xl font-bold" id="hlde-interest">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beleihungsauslauf (LTV)</div><div class="text-xl font-bold" id="hlde-ltv">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nur-Zins-Rate</div><div class="text-xl font-bold" id="hlde-io">0 &euro;</div></div>
        </div>
      </div>

      <ShareButton calculatorId="heloc-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist eine Eigenheimkreditlinie?</h2>
      <p>Eine Eigenheimkreditlinie (englisch: HELOC &ndash; Home Equity Line of Credit) ist ein revolvierender Kredit, der durch den Eigenkapitalanteil Ihrer Immobilie besichert ist. In Deutschland entspricht dies am ehesten einem Immobilien-Nachrangdarlehen oder einer Grundschuld-Kreditlinie.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Eigenkapital = Immobilienwert &minus; Restschuld</p>
        <p>Max. Kredit = Immobilienwert &times; CLTV &minus; Restschuld</p>
        <p>Monatliche Rate = K &times; i &times; (1+i)^n / ((1+i)^n &minus; 1)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">CLTV-Grenze (Combined Loan-to-Value)</h3>
      <p>Der CLTV-Wert gibt an, wie viel des Immobilienwertes durch Kredite belastet werden darf. In Deutschland vergeben Banken Immobilienkredite h&auml;ufig bis zu einem Beleihungsauslauf von 60&ndash;80%. Ein CLTV von 80% bedeutet, dass Erst- und Zweitkredit zusammen maximal 80% des Immobilienwertes betragen d&uuml;rfen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen HELOC und Immobiliendarlehen?</strong> Ein HELOC funktioniert wie ein Kreditrahmen &ndash; Sie k&ouml;nnen Betr&auml;ge entnehmen und zur&uuml;ckzahlen. Ein klassisches Immobiliendarlehen wird als Einmalbetrag ausgezahlt und in festen Raten getilgt.</p>
      <p><strong>Wie hoch ist der typische Zinssatz?</strong> Zinss&auml;tze f&uuml;r Nachrangdarlehen und Eigenheimkredite liegen in Deutschland meist 0,5&ndash;2% &uuml;ber dem Niveau erstrangiger Hypothekendarlehen, abh&auml;ngig von Bonit&auml;t und Beleihungsauslauf.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHLDE() {
      const val = parseFloat((document.getElementById('hlde-val') as HTMLInputElement).value) || 0;
      const bal = parseFloat((document.getElementById('hlde-bal') as HTMLInputElement).value) || 0;
      const cltv = (parseFloat((document.getElementById('hlde-cltv') as HTMLInputElement).value) || 80) / 100;
      const rate = (parseFloat((document.getElementById('hlde-rate') as HTMLInputElement).value) || 0) / 100 / 12;
      const borrow = parseFloat((document.getElementById('hlde-borrow') as HTMLInputElement).value) || 0;
      const term = (parseInt((document.getElementById('hlde-term') as HTMLInputElement).value) || 10) * 12;

      const equity = val - bal;
      const maxHELOC = Math.max(0, val * cltv - bal);

      const fmtE = (n: number) => Math.round(n).toLocaleString('de-DE') + '\u00A0\u20AC';

      document.getElementById('hlde-max')!.textContent = fmtE(maxHELOC);
      document.getElementById('hlde-equity')!.textContent = fmtE(equity);
      document.getElementById('hlde-ltv')!.textContent = (val > 0 ? (bal / val * 100) : 0).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';

      const amount = Math.min(borrow, maxHELOC);
      let payment: number;
      if (rate === 0) {
        payment = term > 0 ? amount / term : 0;
      } else {
        payment = amount * rate * Math.pow(1 + rate, term) / (Math.pow(1 + rate, term) - 1);
      }
      const totalInterest = payment * term - amount;
      const ioPayment = amount * rate;

      document.getElementById('hlde-monthly')!.textContent = fmtE(payment);
      document.getElementById('hlde-interest')!.textContent = fmtE(totalInterest);
      document.getElementById('hlde-io')!.textContent = fmtE(ioPayment);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hlde-in').forEach(el => el.addEventListener('input', calcHLDE));
      calcHLDE();
    }, 50);
  </script>
</CalculatorLayout>
