---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lumineszenz-Datierung Rechner – OSL/TL Alter berechnen";
const description = "Berechnen Sie OSL/TL-Datierungen für archäologische und geologische Proben. Paläodosis und Dosisleistung eingeben, Alter erhalten.";

const relatedCalcs = [
  { name: "Mach-Zahl Rechner", url: "/de/mach-zahl-rechner", description: "Physikalische Berechnungen." },
  { name: "Magnetfeld Rechner", url: "/de/magnetfeld-rechner", description: "Magnetismus." },
  { name: "Magnetische Deklination", url: "/de/magnetische-deklination-rechner", description: "Navigation." },
];
---
<CalculatorLayout lang="de" enSlug="luminescence-dating-calculator" title={title} description={description} calculatorName="Lumineszenz-Datierung Rechner" keywords="OSL Datierung, TL Datierung, Lumineszenz Alter, Paläodosis, Dosisleistung, Archäologie" breadcrumbs={[{ name: "Lumineszenz-Datierung", url: "/de/lumineszenz-datierung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lumineszenz-Datierung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Alter einer Probe mittels OSL (Optisch Stimulierter Lumineszenz) oder TL (Thermolumineszenz).</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Methode</label>
          <select id="ld-method" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="osl" selected>OSL (Optisch Stimulierte Lumineszenz)</option>
            <option value="tl">TL (Thermolumineszenz)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Paläodosis / äquivalente Dosis D_e (Gy = Gray)</label>
          <input type="number" id="ld-de" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="50" step="0.1" min="0">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Jährliche Dosisleistung D_r (mGy/Jahr)</label>
          <input type="number" id="ld-dr" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="2.5" step="0.01" min="0.001">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Unsicherheit Paläodosis (%)</label>
          <input type="number" id="ld-unc" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="5" step="0.1" min="0" max="50">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Berechnetes Alter</div>
          <div class="text-4xl font-extrabold font-mono" id="ld-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="ld-range"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Alter (Jahre vor heute)</div>
            <div class="text-xl font-bold font-mono" id="ld-years">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Entspricht ca. Epoche</div>
            <div class="text-lg font-bold" id="ld-epoch">–</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-xs text-text mb-2 uppercase">Formel</h3>
          <div class="text-xs font-mono text-text-secondary" id="ld-formula">Alter = D_e / D_r</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="luminescence-dating" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist Lumineszenz-Datierung?</h2>
      <p>Die Lumineszenz-Datierung ist eine physikalische Datierungsmethode, die in der Archäologie und Geologie eingesetzt wird, um das Alter von mineralischen Proben zu bestimmen. Kristalline Minerale wie Quarz und Feldspat speichern Strahlungsenergie aus der natürlichen Umgebungsstrahlung. Durch Licht (OSL) oder Wärme (TL) kann diese gespeicherte Energie als Lichtemission freigesetzt werden. Das gemessene Signal ist proportional zur absorbierten Strahlungsdosis und damit zum Alter der Probe seit der letzten Belichtung oder Erhitzung.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen OSL und TL?</h3>
      <p>OSL (Optisch Stimulierte Lumineszenz) nutzt Licht zur Stimulation des Signals und datiert hauptsächlich Quarz und Feldspat. TL (Thermolumineszenz) nutzt Wärme und ist besonders für gebrannte Materialien wie Keramik, Ziegel oder erhitzte Steine geeignet.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Für welche Zeiträume eignet sich die Methode?</h3>
      <p>OSL eignet sich für Alter von einigen Jahren bis ca. 150.000 Jahren, TL kann bis zu 500.000 Jahre zurückdatieren. Bei sehr alten Proben können Sättigungseffekte die Messung beeinflussen.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist die Paläodosis?</h3>
      <p>Die Paläodosis (auch äquivalente Dosis D_e) ist die Strahlungsdosis in Gray (Gy), die ein Mineral seit seiner letzten vollständigen Nullstellung absorbiert hat. Sie wird im Labor gemessen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function getEpoch(years: number): string {
      if (years < 500) return 'Neuzeit / Modern';
      if (years < 2000) return 'Mittelalter / Antike';
      if (years < 10000) return 'Neolithikum / Jungsteinzeit';
      if (years < 50000) return 'Paläolithikum / Altsteinzeit';
      if (years < 200000) return 'Mittleres Paläolithikum';
      return 'Frühes Pleistozän';
    }
    function calcLD() {
      const de = parseFloat((document.getElementById('ld-de') as HTMLInputElement).value) || 0;
      const drMgy = parseFloat((document.getElementById('ld-dr') as HTMLInputElement).value) || 1;
      const unc = parseFloat((document.getElementById('ld-unc') as HTMLInputElement).value) / 100 || 0.05;
      const dr = drMgy / 1000;
      const ageYears = de / dr;
      const ageKa = ageYears / 1000;
      const errYears = ageYears * unc;
      const errKa = ageKa * unc;
      document.getElementById('ld-result')!.textContent = ageKa.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' ka';
      document.getElementById('ld-range')!.textContent = '± ' + errKa.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' ka (' + (unc * 100).toFixed(0) + '% Unsicherheit)';
      document.getElementById('ld-years')!.textContent = ageYears.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' J';
      document.getElementById('ld-epoch')!.textContent = getEpoch(ageYears);
      document.getElementById('ld-formula')!.textContent = 'Alter = ' + de + ' Gy / ' + drMgy + ' mGy·a⁻¹ = ' + ageKa.toFixed(1) + ' ka ± ' + errKa.toFixed(1) + ' ka';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['ld-de', 'ld-dr', 'ld-unc'].forEach(id => document.getElementById(id)!.addEventListener('input', calcLD));
      document.getElementById('ld-method')!.addEventListener('change', calcLD);
      calcLD();
    }, 50);
  </script>
</CalculatorLayout>
