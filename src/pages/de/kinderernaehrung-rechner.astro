---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kinderernaehrung-Rechner - Taeglicher Naehrstoffbedarf nach Alter";
const description = "Berechnen Sie den taeglichen Naehrstoffbedarf Ihres Kindes: Kalorien, Protein, Ballaststoffe, Kalzium, Eisen und wichtige Vitamine nach Alter und Aktivitaet.";
const relatedCalcs = [
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI-Perzentil." },
  { name: "Kinderdosierung-Rechner", url: "/de/kinderdosierung-rechner", description: "Medikamentendosen." },
  { name: "Kindergroesse-Rechner", url: "/de/kindergroesse-rechner", description: "Groessenvorhersage." },
  { name: "Huehnerfutter-Rechner", url: "/de/huehnerfutter-rechner", description: "Futterberechnung." },
  { name: "Kindesunterhalt-Rechner", url: "/de/kindesunterhalt-rechner", description: "Unterhalt." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kinderernaehrung-Rechner" enSlug="child-nutrition-calculator" keywords="Kinderernaehrung, taegliche Kalorien Kinder, Proteinbedarf Kind, paediatrische Ernaehrung, Vitaminbedarf Kinder" breadcrumbs={[{ name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kinderernaehrung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie den taeglichen Naehrstoffbedarf Ihres Kindes -- Kalorien, Protein, Ballaststoffe, Kalzium, Eisen und Vitamine.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Alter des Kindes (Jahre)</label><input type="number" id="ke-age" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="17" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Geschlecht</label>
          <select id="ke-gender" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="male">Maennlich</option>
            <option value="female">Weiblich</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="ke-weight" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="5" max="120" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Aktivitaetsniveau</label>
          <select id="ke-activity" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="sedentary">Wenig aktiv (kaum Bewegung)</option>
            <option value="moderate" selected>Maessig aktiv (etwas Sport/Spiel)</option>
            <option value="active">Aktiv (taeglich Sport/Toben)</option>
          </select>
        </div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzter Tagesbedarf</div>
        <div class="text-5xl font-extrabold" id="ke-calories">--</div>
        <div class="text-sm text-blue-200 mt-1" id="ke-desc">kcal pro Tag</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Protein</div><div class="text-lg font-bold" id="ke-protein">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ballaststoffe</div><div class="text-lg font-bold" id="ke-fiber">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalzium</div><div class="text-lg font-bold" id="ke-calcium">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eisen</div><div class="text-lg font-bold" id="ke-iron">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Vollstaendige Naehrstoffuebersicht</h3>
        <div class="text-xs space-y-1" id="ke-breakdown"></div>
      </div>
      <ShareButton lang="de" calculatorId="kinderernaehrung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Ernaehrungsbedarf von Kindern</h2>
      <p>Der Naehrstoffbedarf von Kindern aendert sich erheblich waehrend des Wachstums. Dieser Rechner nutzt DGE-Referenzwerte fuer alters- und geschlechtsspezifische Empfehlungen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Tipps fuer ausgewogene Kinderernaehrung</h3>
      <ul>
        <li>Bieten Sie bei jeder Mahlzeit Obst und Gemuese an</li>
        <li>Bevorzugen Sie Vollkornprodukte gegenueber Weissmehl</li>
        <li>Integrieren Sie magere Proteinquellen wie Geflügel, Fisch, Huelsenfruechte und Eier</li>
        <li>Begrenzen Sie zugesetzten Zucker auf weniger als 10% der taeglichen Kalorien</li>
        <li>Sorgen Sie fuer ausreichend Milchprodukte oder kalziumangereicherte Alternativen</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKE() {
      const age = parseFloat((document.getElementById('ke-age') as HTMLInputElement).value) || 5;
      const gender = (document.getElementById('ke-gender') as HTMLSelectElement).value;
      const weightKg = parseFloat((document.getElementById('ke-weight') as HTMLInputElement).value) || 18;
      const activity = (document.getElementById('ke-activity') as HTMLSelectElement).value;
      let baseCalories: number;
      if (age <= 3) baseCalories = gender === 'male' ? 1000 + (age - 1) * 100 : 1000 + (age - 1) * 80;
      else if (age <= 8) baseCalories = gender === 'male' ? 1200 + (age - 4) * 100 : 1200 + (age - 4) * 70;
      else if (age <= 13) baseCalories = gender === 'male' ? 1600 + (age - 9) * 120 : 1400 + (age - 9) * 80;
      else baseCalories = gender === 'male' ? 2000 + (age - 14) * 100 : 1800 + (age - 14) * 50;
      const activityMult: Record<string, number> = { sedentary: 0.9, moderate: 1.0, active: 1.15 };
      const calories = Math.round(baseCalories * activityMult[activity]);
      let proteinPerKg: number;
      if (age <= 3) proteinPerKg = 1.05; else if (age <= 8) proteinPerKg = 0.95; else if (age <= 13) proteinPerKg = 0.95; else proteinPerKg = 0.85;
      const proteinG = Math.round(weightKg * proteinPerKg);
      let fiberG: number;
      if (age <= 3) fiberG = 19; else if (age <= 8) fiberG = 25; else if (age <= 13) fiberG = gender === 'male' ? 31 : 26; else fiberG = gender === 'male' ? 38 : 26;
      let calciumMg: number;
      if (age <= 3) calciumMg = 700; else if (age <= 8) calciumMg = 1000; else calciumMg = 1300;
      let ironMg: number;
      if (age <= 3) ironMg = 7; else if (age <= 8) ironMg = 10; else if (age <= 13) ironMg = 8; else ironMg = gender === 'male' ? 11 : 15;
      const vitDIU = 600;
      let vitCMg: number;
      if (age <= 3) vitCMg = 15; else if (age <= 8) vitCMg = 25; else if (age <= 13) vitCMg = 45; else vitCMg = gender === 'male' ? 75 : 65;
      let vitAMcg: number;
      if (age <= 3) vitAMcg = 300; else if (age <= 8) vitAMcg = 400; else if (age <= 13) vitAMcg = 600; else vitAMcg = gender === 'male' ? 900 : 700;
      let zincMg: number;
      if (age <= 3) zincMg = 3; else if (age <= 8) zincMg = 5; else if (age <= 13) zincMg = 8; else zincMg = gender === 'male' ? 11 : 9;
      let waterCups: number;
      if (age <= 3) waterCups = 4; else if (age <= 8) waterCups = 5; else if (age <= 13) waterCups = gender === 'male' ? 8 : 7; else waterCups = gender === 'male' ? 11 : 8;
      let fatG: number;
      if (age <= 3) fatG = Math.round((calories * 0.35) / 9); else fatG = Math.round((calories * 0.30) / 9);
      const carbG = Math.round((calories - proteinG * 4 - fatG * 9) / 4);
      document.getElementById('ke-calories')!.textContent = calories.toLocaleString('de-DE') + ' kcal';
      document.getElementById('ke-desc')!.textContent = gender === 'male' ? 'fuer einen ' + age + '-jaehrigen Jungen' : 'fuer ein ' + age + '-jaehriges Maedchen';
      document.getElementById('ke-protein')!.textContent = proteinG + ' g/Tag';
      document.getElementById('ke-fiber')!.textContent = fiberG + ' g/Tag';
      document.getElementById('ke-calcium')!.textContent = calciumMg + ' mg/Tag';
      document.getElementById('ke-iron')!.textContent = ironMg + ' mg/Tag';
      const rows = [
        ['Kalorien', calories + ' kcal', 'Taeglicher Energiebedarf'],
        ['Protein', proteinG + ' g', Math.round(proteinG * 4 / calories * 100) + '% der Kalorien'],
        ['Kohlenhydrate', carbG + ' g', Math.round(carbG * 4 / calories * 100) + '% der Kalorien'],
        ['Fett', fatG + ' g', Math.round(fatG * 9 / calories * 100) + '% der Kalorien'],
        ['Ballaststoffe', fiberG + ' g', 'Empfohlene Zufuhr'],
        ['Kalzium', calciumMg + ' mg', 'Knochenentwicklung'],
        ['Eisen', ironMg + ' mg', 'Blut und Hirngesundheit'],
        ['Vitamin D', vitDIU + ' IE', 'Knochen und Immunsystem'],
        ['Vitamin C', vitCMg + ' mg', 'Immunsystem und Haut'],
        ['Vitamin A', vitAMcg + ' mcg RAE', 'Sehkraft und Wachstum'],
        ['Zink', zincMg + ' mg', 'Immunfunktion'],
        ['Wasser', waterCups + ' Glaeser', 'Taegl. Fluessigkeitszufuhr'],
      ];
      document.getElementById('ke-breakdown')!.innerHTML =
        '<div class="grid grid-cols-3 gap-2 font-semibold text-text-muted mb-2 pb-1 border-b border-border"><span>Naehrstoff</span><span>Menge</span><span>Hinweise</span></div>' +
        rows.map(r => '<div class="grid grid-cols-3 gap-2 py-1"><span class="font-medium">' + r[0] + '</span><span>' + r[1] + '</span><span class="text-text-muted">' + r[2] + '</span></div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ke-in').forEach(el => { el.addEventListener('input', calcKE); el.addEventListener('change', calcKE); });
      calcKE();
    }, 50);
  </script>
</CalculatorLayout>
