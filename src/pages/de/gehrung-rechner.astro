---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Gehrungsrechner - Gehrungswinkel für Rahmen berechnen";
const description = "Berechnen Sie Gehrungswinkel für Rahmen, Bilderrahmen und Holzverbindungen. Für beliebige Eckenanzahl und Winkel.";

const relatedCalcs = [
  { name: "Zapfenverbindung Rechner", url: "/de/zapfenverbindung-rechner", description: "Zapfen berechnen." },
  { name: "Winkelrechner", url: "/de/winkelrechner", description: "Winkel berechnen." },
  { name: "Holz-Rechner", url: "/de/holzrechner", description: "Holzmengen berechnen." },
  { name: "Pythagoras-Rechner", url: "/de/pythagoras-rechner", description: "Dreiecke berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="miter-joint-calculator" calculatorName="Gehrungsrechner" keywords="Gehrungsrechner, Gehrungswinkel, Rahmen Winkel, Bilderrahmen, Gehrungsschnitt, Holzverbindung" breadcrumbs={[{ name: "Gehrungsrechner", url: "/de/gehrung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gehrungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Gehrungswinkel für Eckenverbindungen bei Rahmen, Bilderrahmen, Fußleisten und Zierleisten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="ghr-btn-corner" class="ghr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer">Eckwinkel</button>
          <button id="ghr-btn-sides" class="ghr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer">Vieleck</button>
        </div>

        <div id="ghr-corner-mode">
          <label class="block text-xs font-medium text-text mb-1">Innenwinkel der Ecke (°)</label>
          <input type="number" id="ghr-angle" class="ghr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" max="359" value="90">
          <p class="text-xs text-text-muted mt-1">Für einen normalen rechten Winkel: 90°. Für ein regelmäßiges Fünfeck: 108°.</p>
        </div>

        <div id="ghr-sides-mode" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Anzahl der Ecken</label>
          <input type="number" id="ghr-sides" class="ghr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="3" max="20" value="4">
          <p class="text-xs text-text-muted mt-1">Viereck = 4, Fünfeck = 5, Sechseck = 6 usw.</p>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gehrungswinkel</div>
          <div class="text-5xl font-extrabold font-mono" id="ghr-result">45,0°</div>
          <div class="text-sm text-blue-200 mt-1" id="ghr-result-sub">Sägewinkel: 45,0° von der Lotrechten</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gehrungswinkel</div>
            <div class="text-xl font-bold" id="ghr-miter">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Innenwinkel</div>
            <div class="text-xl font-bold" id="ghr-inner">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sägeeinstellung</div>
            <div class="text-xl font-bold" id="ghr-saw">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Außenwinkel</div>
            <div class="text-xl font-bold" id="ghr-outer">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnung</h3>
          <div class="font-mono text-sm space-y-1" id="ghr-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="miter-joint" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="mt-10 bg-white border border-border rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-text mb-4">Gehrungswinkel für gängige Formen</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-4 font-semibold">Form</th><th class="py-2 pr-4 font-semibold">Ecken</th><th class="py-2 pr-4 font-semibold">Innenwinkel</th><th class="py-2 font-semibold">Gehrungswinkel</th></tr></thead>
          <tbody class="text-text-secondary">
            <tr class="border-b border-border/30"><td class="py-2 pr-4">Dreieck</td><td class="py-2 pr-4">3</td><td class="py-2 pr-4">60°</td><td class="py-2 font-semibold">30°</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4">Viereck / Rahmen</td><td class="py-2 pr-4">4</td><td class="py-2 pr-4">90°</td><td class="py-2 font-semibold">45°</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4">Fünfeck</td><td class="py-2 pr-4">5</td><td class="py-2 pr-4">108°</td><td class="py-2 font-semibold">54°</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-4">Sechseck</td><td class="py-2 pr-4">6</td><td class="py-2 pr-4">120°</td><td class="py-2 font-semibold">60°</td></tr>
            <tr><td class="py-2 pr-4">Achteck</td><td class="py-2 pr-4">8</td><td class="py-2 pr-4">135°</td><td class="py-2 font-semibold">67,5°</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gehrungsschnitte richtig berechnen</h2>
      <p>Bei einer Gehrungsverbindung wird jedes Werkstück schräg geschnitten, sodass beide Schnittflächen zusammen den gewünschten Eckwinkel ergeben. Der Gehrungswinkel ist stets die Hälfte des Innenwinkels.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>Gehrungswinkel = Innenwinkel / 2</p>
        <p>Innenwinkel (regelmäßiges Vieleck) = (n-2) × 180 / n</p>
        <p>Sägewinkel (von Lotrechten) = 90° - Gehrungswinkel</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Warum wird ein Bilderrahmen mit 45° geschnitten?</p>
          <p>Ein Bilderrahmen hat vier rechte Ecken (90°). Da sich die Schnittflächen zweier Werkstücke addieren müssen, wird jede auf 45° (= 90°/2) geschnitten. 45° + 45° = 90°.</p>
        </div>
        <div>
          <p class="font-semibold">Wie stelle ich meine Kappsäge auf den richtigen Winkel ein?</p>
          <p>Die meisten Kappsägen sind von 0° (gerade) bis 45° oder 50° einstellbar. Der angezeigte Winkel an der Säge ist der Winkel von der Lotrechten, also direkt der Gehrungswinkel (z.B. 45° für rechtwinklige Ecken).</p>
        </div>
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen Gehrung und Schifterschnitt?</p>
          <p>Eine einfache Gehrung wird nur in einer Achse geschnitten (Säge kippt horizontal). Beim Schifterschnitt (compound miter) kommen sowohl Neigung als auch Winkel zum Einsatz, z.B. für geneigte Rahmen oder Pfettenanschlüsse im Dachbau.</p>
        </div>
        <div>
          <p class="font-semibold">Warum schließen meine Gehrungsverbindungen nicht bündig?</p>
          <p>Häufige Ursachen: ungenaue Sägeeinstellung, Holzverzug, nicht rechtwinklige Rahmenteile oder Messfehler. Tipp: Alle vier Rahmenteile erst auf leichtem Übermaß schneiden, dann passen und korrigieren.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let ghrMode = 'corner';

    function calcGhr() {
      const fmt1 = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

      let innerAngle: number;
      if (ghrMode === 'corner') {
        innerAngle = parseFloat((document.getElementById('ghr-angle') as HTMLInputElement).value) || 90;
      } else {
        const sides = parseFloat((document.getElementById('ghr-sides') as HTMLInputElement).value) || 4;
        innerAngle = (sides - 2) * 180 / sides;
      }

      const miterAngle = innerAngle / 2;
      const sawAngle = 90 - miterAngle;
      const outerAngle = 180 - innerAngle;

      const steps: string[] = [];
      if (ghrMode === 'sides') {
        const sides = parseFloat((document.getElementById('ghr-sides') as HTMLInputElement).value) || 4;
        steps.push(`Innenwinkel = (${sides}-2) × 180° / ${sides} = ${fmt1(innerAngle)}°`);
      }
      steps.push(`Gehrungswinkel = ${fmt1(innerAngle)}° / 2 = ${fmt1(miterAngle)}°`);
      steps.push(`Sägewinkel (von Lotrechten) = 90° - ${fmt1(miterAngle)}° = ${fmt1(sawAngle)}°`);
      steps.push(`Außenwinkel = 180° - ${fmt1(innerAngle)}° = ${fmt1(outerAngle)}°`);

      document.getElementById('ghr-result')!.textContent = fmt1(miterAngle) + '°';
      document.getElementById('ghr-result-sub')!.textContent = `Sägewinkel: ${fmt1(sawAngle)}° von der Lotrechten`;
      document.getElementById('ghr-miter')!.textContent = fmt1(miterAngle) + '°';
      document.getElementById('ghr-inner')!.textContent = fmt1(innerAngle) + '°';
      document.getElementById('ghr-saw')!.textContent = fmt1(sawAngle) + '°';
      document.getElementById('ghr-outer')!.textContent = fmt1(outerAngle) + '°';
      document.getElementById('ghr-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('ghr-btn-corner')!.addEventListener('click', () => {
        ghrMode = 'corner';
        document.getElementById('ghr-corner-mode')!.classList.remove('hidden');
        document.getElementById('ghr-sides-mode')!.classList.add('hidden');
        document.getElementById('ghr-btn-corner')!.className = 'ghr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer';
        document.getElementById('ghr-btn-sides')!.className = 'ghr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer';
        calcGhr();
      });
      document.getElementById('ghr-btn-sides')!.addEventListener('click', () => {
        ghrMode = 'sides';
        document.getElementById('ghr-sides-mode')!.classList.remove('hidden');
        document.getElementById('ghr-corner-mode')!.classList.add('hidden');
        document.getElementById('ghr-btn-sides')!.className = 'ghr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white cursor-pointer';
        document.getElementById('ghr-btn-corner')!.className = 'ghr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer';
        calcGhr();
      });
      document.querySelectorAll('.ghr-in').forEach(el => {
        el.addEventListener('input', calcGhr);
        el.addEventListener('change', calcGhr);
      });
      calcGhr();
    }, 50);
  </script>
</CalculatorLayout>
