---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Baby-Kostenrechner - Kosten im ersten Jahr";
const description = "Schätzen Sie die Kosten im ersten Babyjahr einschließlich Windeln, Nahrung, Betreuung, Kleidung und Ausstattung mit detaillierter Aufschlüsselung.";

const relatedCalcs = [
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Budgetplanung." },
  { name: "Kindesunterhalt", url: "/de/kindesunterhalt-rechner", description: "Kindesunterhalt." },
  { name: "Studienkosten", url: "/de/studienkosten-rechner", description: "Studienersparnisse." },
  { name: "Lebensversicherung", url: "/de/lebensversicherung-rechner", description: "Lebensversicherung." },
  { name: "Notfallfonds", url: "/de/notfallfonds-rechner", description: "Notfall-Ersparnisse." },
  { name: "Krankenversicherung", url: "/de/krankenversicherung-rechner", description: "Gesundheitskosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Baby-Kostenrechner" keywords="Baby Kosten Rechner, erstes Jahr Baby Kosten, Neugeborene Kosten, Windeln, Babynahrung, Kinderbetreuung, Baby Budget" breadcrumbs={[{ name: "Baby-Kosten", url: "/de/baby-kosten-rechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Baby-Kostenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Kosten im ersten Babyjahr mit detaillierter Aufschlüsselung nach Kategorien.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Ernährungsmethode</label>
            <select id="bc2-feeding" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="breast">Stillen (Pumpe + Zubehör)</option>
              <option value="formula" selected>Säuglingsnahrung</option>
              <option value="combo">Kombination</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Windelart</label>
            <select id="bc2-diapers" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="disposable" selected>Einwegwindeln</option>
              <option value="cloth">Stoffwindeln</option>
              <option value="eco">Öko-Einwegwindeln</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Monatliche Betreuungskosten</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
              <input type="number" id="bc2-childcare" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="800" min="0" step="50">
            </div>
            <p class="text-xs text-text-muted mt-1">0 &euro; wenn ein Elternteil zu Hause bleibt; Kita durchschn.: 400-1.200 &euro;/Monat</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kleidungsbudget (monatlich)</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
              <input type="number" id="bc2-clothing" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="50" min="0" step="10">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einmalige Erstausstattung</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
              <input type="number" id="bc2-gear" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="2000" min="0" step="100">
            </div>
            <p class="text-xs text-text-muted mt-1">Babybett, Kinderwagen, Autositz, Hochstuhl usw.</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Monatliche Gesundheitskosten (Zuzahlungen, Zubehör)</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">&euro;</span>
              <input type="number" id="bc2-medical" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="50" min="0" step="25">
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten erstes Jahr</div>
            <div class="text-5xl font-extrabold font-mono" id="bc2-total">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Monatlicher Durchschnitt</div>
              <div class="text-xl font-bold text-secondary" id="bc2-monthly">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Ernährungskosten</div>
              <div class="text-xl font-bold" id="bc2-feeding-cost">0 &euro;/Jahr</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Windelkosten</div>
              <div class="text-xl font-bold" id="bc2-diaper-cost">0 &euro;/Jahr</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Betreuung</div>
              <div class="text-xl font-bold text-orange-600" id="bc2-childcare-total">0 &euro;/Jahr</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Spartipp</div>
            <div class="text-sm font-medium" id="bc2-tip">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="baby-cost" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Kostenaufschlüsselung im ersten Babyjahr</h2>
      <p>Familien geben im ersten Lebensjahr eines Babys durchschnittlich 6.000-10.000 Euro aus. Die größten Posten sind Kinderbetreuung (falls zutreffend), gefolgt von Ausstattung, Ernährung und Windeln.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Spartipps</h3>
      <p>Kaufen Sie Ausstattung gebraucht, nehmen Sie Secondhand-Kleidung an, verwenden Sie Stoffwindeln (spart ca. 500 Euro/Jahr), stillen Sie wenn möglich, und nutzen Sie Babywunschlisten und Cashback-Programme.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcBC2() {
      const feeding = (document.getElementById('bc2-feeding') as HTMLSelectElement).value;
      const diaperType = (document.getElementById('bc2-diapers') as HTMLSelectElement).value;
      const childcareMonthly = parseFloat((document.getElementById('bc2-childcare') as HTMLInputElement).value) || 0;
      const clothingMonthly = parseFloat((document.getElementById('bc2-clothing') as HTMLInputElement).value) || 0;
      const gear = parseFloat((document.getElementById('bc2-gear') as HTMLInputElement).value) || 0;
      const medicalMonthly = parseFloat((document.getElementById('bc2-medical') as HTMLInputElement).value) || 0;

      const feedingCosts: Record<string, number> = {
        breast: 400,
        formula: 1800,
        combo: 1100
      };
      const feedingAnnual = feedingCosts[feeding] || 1800;

      const diaperCosts: Record<string, number> = {
        disposable: 700,
        cloth: 300,
        eco: 950
      };
      const diaperAnnual = diaperCosts[diaperType] || 700;

      const childcareAnnual = childcareMonthly * 12;
      const clothingAnnual = clothingMonthly * 12;
      const medicalAnnual = medicalMonthly * 12;

      const total = feedingAnnual + diaperAnnual + childcareAnnual + clothingAnnual + gear + medicalAnnual;
      const monthlyAvg = total / 12;

      let tip = '';
      if (feeding === 'formula') tip = 'Stillen könnte ca. 1.400 \u20AC/Jahr an Säuglingsnahrungskosten sparen.';
      else if (diaperType === 'disposable') tip = 'Stoffwindeln könnten ca. 400 \u20AC/Jahr gegenüber Einwegwindeln sparen.';
      else if (childcareMonthly > 1000) tip = 'Erwägen Sie Tagesmutter-Sharing oder familiäre Betreuung zur Kostensenkung.';
      else tip = 'Kaufen Sie Ausstattung gebraucht (Kinderwagen, Kleidung) und sparen Sie 50-70%.';

      document.getElementById('bc2-total')!.textContent = fmt(total);
      document.getElementById('bc2-monthly')!.textContent = fmt(monthlyAvg) + '/Mo.';
      document.getElementById('bc2-feeding-cost')!.textContent = fmt(feedingAnnual) + '/Jahr';
      document.getElementById('bc2-diaper-cost')!.textContent = fmt(diaperAnnual) + '/Jahr';
      document.getElementById('bc2-childcare-total')!.textContent = fmt(childcareAnnual) + '/Jahr';
      document.getElementById('bc2-tip')!.textContent = tip;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['bc2-childcare', 'bc2-clothing', 'bc2-gear', 'bc2-medical'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcBC2); el.addEventListener('change', calcBC2); }
      });
      ['bc2-feeding', 'bc2-diapers'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('change', calcBC2); }
      });
      calcBC2();
    }, 50);
  </script>
</CalculatorLayout>
