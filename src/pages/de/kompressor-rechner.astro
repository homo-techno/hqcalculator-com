---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kompressor-Rechner - Hubvolumen, Effizienz & Massenstrom";
const description = "Berechnen Sie Kompressor-Hubvolumen, volumetrischen Wirkungsgrad, Massenstrom und Leistungsaufnahme f\u00fcr K\u00e4lte- und Klimakompressoren.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Fl\u00e4chenrechner", url: "/de/flaechenrechner", description: "Fl\u00e4chen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kompressor-Rechner" lang="de" enSlug="compressor-calculator" keywords="kompressor rechner, hubvolumen, volumetrischer wirkungsgrad, massenstrom, verdichtungsverh\u00e4ltnis, k\u00e4ltekompressor" breadcrumbs={[{ name: "Kompressor-Rechner", url: "/de/kompressor-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kompressor-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Hubvolumen, Massenstrom und Wirkungsgrad f&uuml;r K&auml;ltekompressoren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Kompressortyp</label>
          <select id="kp-type" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="reciprocating" selected>Kolbenkompressor</option>
            <option value="scroll">Scrollkompressor</option>
            <option value="screw">Schraubenkompressor</option>
            <option value="centrifugal">Turbokompressor</option>
          </select>
        </div>
        <h3 class="text-lg font-bold text-text">Kompressorgeometrie (Kolben)</h3>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Bohrung (mm)</label>
            <input type="number" id="kp-bore" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="63" min="10" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Hub (mm)</label>
            <input type="number" id="kp-stroke" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="44" min="10" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Zylinder</label>
            <input type="number" id="kp-cyl" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="16" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Drehzahl (U/min)</label>
            <input type="number" id="kp-rpm" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1450" min="100" step="50">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Schadraum (%)</label>
            <input type="number" id="kp-clearance" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="20" step="0.5">
          </div>
        </div>
        <h3 class="text-lg font-bold text-text">Betriebsbedingungen</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Saugdruck (bar abs.)</label>
            <input type="number" id="kp-psuct" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.8" min="0.5" step="0.1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Hochdruck (bar abs.)</label>
            <input type="number" id="kp-pdisch" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="17" min="1" step="0.5">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Spez. Volumen Sauggas (m&sup3;/kg)</label>
          <input type="number" id="kp-specvol" class="kp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.04" min="0.001" step="0.001">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geometrisches Hubvolumen</div>
          <div class="text-4xl font-extrabold" id="kp-disp">--</div>
          <div class="text-sm text-blue-200 mt-1">m&sup3;/h</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Verdichtungsverh&auml;ltnis</div>
            <div class="text-xl font-bold" id="kp-ratio">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Volum. Wirkungsgrad</div>
            <div class="text-xl font-bold" id="kp-voleff">--</div>
            <div class="text-xs text-text-muted">%</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Tats&auml;chlicher Volumenstrom</div>
            <div class="text-xl font-bold" id="kp-actual">--</div>
            <div class="text-xs text-text-muted">m&sup3;/h</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Massenstrom</div>
            <div class="text-xl font-bold" id="kp-mass">--</div>
            <div class="text-xs text-text-muted">kg/h</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Hubvolumen (cm&sup3;/Umdrehung)</div>
            <div class="text-xl font-bold" id="kp-disprev">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Massenstrom (kg/min)</div>
            <div class="text-xl font-bold" id="kp-massmin">--</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="compressor" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl mx-auto prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Kompressor-Berechnungen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Hubvolumen = &pi;/4 x Bohrung&sup2; x Hub x Zylinder x Drehzahl</p>
        <p>Verdichtungsverh&auml;ltnis = P_Hochdruck / P_Saugdruck</p>
        <p>Vol. Wirkungsgrad = 1 - C x [(P_h/P_s)^(1/n) - 1]</p>
        <p>Massenstrom = Tats&auml;chlicher Volumenstrom / Spez. Volumen</p>
      </div>
      <p>wobei C = Schadraumverh&auml;ltnis und n = polytropischer Exponent (~1,15 f&uuml;r K&auml;ltemittel)</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKP() {
      const boreMM = parseFloat((document.getElementById('kp-bore') as HTMLInputElement).value) || 0;
      const strokeMM = parseFloat((document.getElementById('kp-stroke') as HTMLInputElement).value) || 0;
      const cylinders = parseFloat((document.getElementById('kp-cyl') as HTMLInputElement).value) || 1;
      const rpm = parseFloat((document.getElementById('kp-rpm') as HTMLInputElement).value) || 0;
      const clearance = (parseFloat((document.getElementById('kp-clearance') as HTMLInputElement).value) || 5) / 100;
      const pSuct = parseFloat((document.getElementById('kp-psuct') as HTMLInputElement).value) || 1;
      const pDisch = parseFloat((document.getElementById('kp-pdisch') as HTMLInputElement).value) || 1;
      const specVol = parseFloat((document.getElementById('kp-specvol') as HTMLInputElement).value) || 0.04;

      // Displacement per revolution (cm3)
      const boreM = boreMM / 1000;
      const strokeM = strokeMM / 1000;
      const dispPerRevM3 = (Math.PI / 4) * Math.pow(boreM, 2) * strokeM * cylinders;
      const dispPerRevCM3 = dispPerRevM3 * 1e6;

      // Swept displacement (m3/h)
      const sweptM3H = dispPerRevM3 * rpm * 60;

      // Compression ratio
      const compRatio = pDisch / pSuct;

      // Volumetric efficiency
      const n = 1.15;
      const volEff = 1 - clearance * (Math.pow(compRatio, 1 / n) - 1);
      const volEffPct = Math.max(0, volEff * 100);

      // Actual volume flow
      const actualM3H = sweptM3H * Math.max(0, volEff);

      // Mass flow rate
      const massFlowKgH = specVol > 0 ? actualM3H / specVol : 0;
      const massFlowKgMin = massFlowKgH / 60;

      document.getElementById('kp-disp')!.textContent = sweptM3H.toFixed(2);
      document.getElementById('kp-ratio')!.textContent = compRatio.toFixed(2);
      document.getElementById('kp-voleff')!.textContent = volEffPct.toFixed(1);
      document.getElementById('kp-actual')!.textContent = actualM3H.toFixed(2);
      document.getElementById('kp-mass')!.textContent = massFlowKgH.toFixed(1);
      document.getElementById('kp-disprev')!.textContent = dispPerRevCM3.toFixed(1);
      document.getElementById('kp-massmin')!.textContent = massFlowKgMin.toFixed(2);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.kp-in').forEach(el => {
        el.addEventListener('input', calcKP);
        el.addEventListener('change', calcKP);
      });
      calcKP();
    }, 50);
  </script>
</CalculatorLayout>
