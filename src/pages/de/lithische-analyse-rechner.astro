---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lithische Analyse Rechner – Steinwerkzeug-Attribute berechnen";
const description = "Berechnen Sie Steinwerkzeug-Attribute für archäologische Analysen: Volumen, Oberfläche, Schlagwinkel und Formindizes nach lithischer Technologie.";
const relatedCalcs = [
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
  { name: "Lineare Gleichung Rechner", url: "/de/lineare-gleichung-rechner", description: "Gleichungen." },
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="lithic-analysis-calculator" calculatorName="Lithische Analyse Rechner" keywords="lithische Analyse, Steinwerkzeug, Abschlag, Artefakt, Archäologie Rechner, Formindex" breadcrumbs={[{ name: "Lithische Analyse Rechner", url: "/de/lithische-analyse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lithische Analyse Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie morphologische Attribute und Indizes für die quantitative Analyse lithischer Artefakte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Länge (mm)</label>
            <input type="number" id="lia-l" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="85" step="0.1" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (mm)</label>
            <input type="number" id="lia-b" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="42" step="0.1" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Dicke (mm)</label>
            <input type="number" id="lia-d" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" step="0.1" min="0">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewicht (g)</label>
            <input type="number" id="lia-g" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" step="0.1" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Schlagwinkel (°)</label>
            <input type="number" id="lia-w" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="115" step="1" min="0" max="180">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Rohmaterial</label>
          <select id="lia-mat" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="2.65">Flint / Feuerstein (ρ = 2,65 g/cm³)</option>
            <option value="2.5">Quartzit (ρ = 2,50 g/cm³)</option>
            <option value="2.7">Obsidian (ρ = 2,70 g/cm³)</option>
            <option value="2.6">Schiefer (ρ = 2,60 g/cm³)</option>
            <option value="2.8">Basalt (ρ = 2,80 g/cm³)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Elongationsindex (L/B)</div>
          <div class="text-5xl font-extrabold font-mono" id="lia-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="lia-details"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-xs text-text mb-2 uppercase">Artefaktklassifikation</h3>
          <div id="lia-class" class="text-sm text-text-secondary"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="lithische-analyse" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Quantitative Analyse lithischer Artefakte</h2>
      <p>Die lithische Analyse beschäftigt sich mit der systematischen Untersuchung von Steinwerkzeugen aus archäologischen Kontexten. Zu den wichtigsten metrischen Attributen zählen Länge, Breite und Dicke des Artefakts sowie der Schlagwinkel (EPA – Exterior Platform Angle). Aus diesen Grundmaßen werden Formindizes wie der Elongationsindex (L/B), der Flächenindex und das Volumen berechnet, die Rückschlüsse auf Herstellungstechnik und Funktion erlauben.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</html>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Elongationsindex?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der Elongationsindex (L/B) ist das Verhältnis von Länge zu Breite. Werte über 2 gelten als elongiert (lang und schmal), Werte unter 1,5 als kompakt (breit). Klingen haben typischerweise L/B > 2.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Exterior Platform Angle (EPA)?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der EPA (Schlagwinkel) ist der Winkel zwischen der Schlagflächenkante und der Ventralfläche des Abschlags. Werte unter 90° deuten auf präparative Kerne hin, Werte von 90–115° sind typisch für Levallois-Technik.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie unterscheidet man Abschlag und Klinge?</summary>
          <p class="mt-2 text-sm text-text-secondary">Nach der gängigen Definition (Inizan et al. 1999) ist ein Artefakt eine Klinge, wenn Länge mindestens doppelt so groß wie die Breite ist (L ≥ 2B) und parallele Kanten aufweist. Artefakte mit L/B zwischen 1,5 und 2 gelten als Lamellen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist ein Flächenindex bei Steinwerkzeugen?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der Flächenindex (B/D = Breite/Dicke) gibt die relative Dicke eines Artefakts an. Hohe Werte (flach) deuten auf fortgeschrittene Bearbeitung hin, niedrige Werte (dick) auf frühe Abbaustufen oder Kerne.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLia() {
      const l = parseFloat((document.getElementById('lia-l') as HTMLInputElement).value) || 0;
      const b = parseFloat((document.getElementById('lia-b') as HTMLInputElement).value) || 0;
      const d = parseFloat((document.getElementById('lia-d') as HTMLInputElement).value) || 0;
      const g = parseFloat((document.getElementById('lia-g') as HTMLInputElement).value) || 0;
      const w = parseFloat((document.getElementById('lia-w') as HTMLInputElement).value) || 0;
      const rho = parseFloat((document.getElementById('lia-mat') as HTMLSelectElement).value) || 2.65;

      const elongation = b > 0 ? l / b : 0;
      const flatness = d > 0 ? b / d : 0;
      const volumen = (l * b * d) / 1000; // cm³ (näherungsweise ellipsoid * Faktor)
      const volEllipsoid = (Math.PI / 6) * l * b * d / 1000; // cm³
      const berechnetesDichte = volEllipsoid > 0 ? g / volEllipsoid : 0;
      const schlagwinkelRad = (w - 90) * Math.PI / 180;

      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { maximumFractionDigits: d });
      document.getElementById('lia-result')!.textContent = fmt(elongation);
      document.getElementById('lia-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flächenindex (B/D)</div><div class="text-lg font-bold font-mono">${fmt(flatness)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen (Ellips.)</div><div class="text-lg font-bold font-mono">${fmt(volEllipsoid)} cm³</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Berechnete Dichte</div><div class="text-lg font-bold font-mono">${fmt(berechnetesDichte)} g/cm³</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schlagwinkel (EPA)</div><div class="text-lg font-bold font-mono">${fmt(w, 0)}°</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewicht</div><div class="text-lg font-bold font-mono">${fmt(g, 1)} g</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Länge × Breite</div><div class="text-lg font-bold font-mono">${fmt(l * b, 0)} mm²</div></div>`;

      let klassifikation = '';
      if (elongation >= 2) klassifikation = 'Klinge (L/B ≥ 2): langer, schmaler Abschlag mit parallelen Kanten.';
      else if (elongation >= 1.5) klassifikation = 'Lamelle (1,5 ≤ L/B < 2): übergangsform zwischen Klinge und Abschlag.';
      else klassifikation = 'Abschlag (L/B < 1,5): kompakter, breiter Abschlag.';
      if (flatness > 5) klassifikation += ' Sehr flaches Artefakt (B/D > 5): möglicherweise fortgeschrittene Bearbeitung.';
      if (w > 90 && w < 115) klassifikation += ' Schlagwinkel typisch für Levallois oder weiche Schlagtechnik.';
      document.getElementById('lia-class')!.textContent = klassifikation;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['lia-l','lia-b','lia-d','lia-g','lia-w'].forEach(id => document.getElementById(id)!.addEventListener('input', calcLia));
      document.getElementById('lia-mat')!.addEventListener('change', calcLia);
      calcLia();
    }, 50);
  </script>
</CalculatorLayout>
