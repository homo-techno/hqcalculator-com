---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "A/B-Test Rechner - Statistische Signifikanz & Power";
const description = "Berechnen Sie die statistische Signifikanz von A/B-Tests, benötigte Stichprobengröße, Lift-Prozentsatz, Konfidenzniveau und statistische Power.";
const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/probability-calculator", description: "Ereigniswahrscheinlichkeit." },
  { name: "Konfidenzintervall", url: "/confidence-interval-calculator", description: "Konfidenzbereiche." },
  { name: "Stichprobenrechner", url: "/sample-size-calculator", description: "Stichprobengröße." },
  { name: "Chi-Quadrat-Rechner", url: "/chi-square-calculator", description: "Chi-Quadrat-Test." },
  { name: "Z-Wert-Rechner", url: "/z-score-calculator", description: "Z-Wert-Analyse." },
  { name: "Standardabweichung", url: "/standard-deviation-calculator", description: "Streuungsanalyse." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="A/B-Test Rechner" keywords="AB Test Rechner, statistische Signifikanz, Stichprobengröße, Konversionsrate, Lift, Power-Analyse" breadcrumbs={[{ name: "A/B-Test", url: "/de/ab-test-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">A/B-Test Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Prüfen Sie, ob Ihre A/B-Test-Ergebnisse statistisch signifikant sind, und planen Sie die richtige Stichprobengröße für zukünftige Tests.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-4 flex-wrap">
          <button class="ab-mode px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white" data-mode="results">Ergebnisse analysieren</button>
          <button class="ab-mode px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary" data-mode="plan">Stichprobe planen</button>
        </div>

        <div id="ab-results-section">
          <h3 class="font-semibold text-text text-sm mb-3">Kontrolle (A)</h3>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <label class="block text-sm font-semibold text-text mb-1">Besucher</label>
              <input type="number" class="ab-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="ab-va" min="1" value="5000">
            </div>
            <div>
              <label class="block text-sm font-semibold text-text mb-1">Konversionen</label>
              <input type="number" class="ab-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="ab-ca" min="0" value="150">
            </div>
          </div>

          <h3 class="font-semibold text-text text-sm mb-3">Variante (B)</h3>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <label class="block text-sm font-semibold text-text mb-1">Besucher</label>
              <input type="number" class="ab-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="ab-vb" min="1" value="5000">
            </div>
            <div>
              <label class="block text-sm font-semibold text-text mb-1">Konversionen</label>
              <input type="number" class="ab-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="ab-cb" min="0" value="185">
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-text mb-1">Konfidenzniveau</label>
            <select class="ab-in w-full px-4 py-2 border border-border rounded-xl" id="ab-conf">
              <option value="0.90">90%</option>
              <option value="0.95" selected>95%</option>
              <option value="0.99">99%</option>
            </select>
          </div>
        </div>

        <div id="ab-plan-section" class="hidden">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Basis-Konversionsrate (%)</label>
            <input type="number" class="ab-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="ab-baseline" min="0.01" max="100" step="0.01" value="3">
          </div>
          <div class="mt-3">
            <label class="block text-sm font-semibold text-text mb-1">Minimaler erkennbarer Effekt (relativ %)</label>
            <input type="number" class="ab-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="ab-mde" min="0.1" step="0.1" value="10">
          </div>
          <div class="mt-3 grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-text mb-1">Konfidenzniveau</label>
              <select class="ab-in w-full px-4 py-2 border border-border rounded-xl" id="ab-planconf">
                <option value="0.90">90%</option>
                <option value="0.95" selected>95%</option>
                <option value="0.99">99%</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-text mb-1">Statistische Power</label>
              <select class="ab-in w-full px-4 py-2 border border-border rounded-xl" id="ab-power">
                <option value="0.80" selected>80%</option>
                <option value="0.90">90%</option>
                <option value="0.95">95%</option>
              </select>
            </div>
          </div>
          <div class="mt-3">
            <label class="block text-sm font-semibold text-text mb-1">Tägliche Besucher (pro Variante)</label>
            <input type="number" class="ab-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" id="ab-daily" min="1" value="1000">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="ab-mainlabel">Statistische Signifikanz</div>
          <div class="text-4xl font-extrabold" id="ab-main">--</div>
          <div class="text-sm text-blue-200 mt-1" id="ab-subtitle">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="ab-s1l">Kontrollrate</div>
            <div class="text-xl font-bold font-mono" id="ab-s1">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="ab-s2l">Variantenrate</div>
            <div class="text-xl font-bold font-mono" id="ab-s2">--</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="ab-s3l">Relativer Lift</div>
            <div class="text-xl font-bold font-mono" id="ab-s3">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="ab-s4l">P-Wert</div>
            <div class="text-xl font-bold font-mono" id="ab-s4">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2" id="ab-tableh">Details</h3>
          <div class="text-xs font-mono space-y-1" id="ab-details"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="ab-test" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Statistik beim A/B-Testing</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Z-Test:</strong> z = (pB - pA) / sqrt(p*(1-p)*(1/nA + 1/nB))</p>
        <p><strong>P-Wert:</strong> 2 * (1 - Phi(|z|)) für zweiseitigen Test</p>
        <p><strong>Stichprobe:</strong> n = (z_alpha + z_beta)^2 * (p1(1-p1) + p2(1-p2)) / (p2-p1)^2</p>
        <p><strong>Lift:</strong> (pB - pA) / pA * 100%</p>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let abMode = 'results';

    function normalCDF(z: number): number {
      if (z < -8) return 0;
      if (z > 8) return 1;
      let sum = 0;
      let term = z;
      for (let i = 3; sum + term !== sum; i += 2) {
        sum += term;
        term = term * z * z / i;
      }
      return 0.5 + sum * Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI);
    }

    function normalInv(p: number): number {
      if (p <= 0) return -8;
      if (p >= 1) return 8;
      if (p === 0.5) return 0;
      if (p > 0.5) return -normalInv(1 - p);
      const t = Math.sqrt(-2 * Math.log(p));
      const c0 = 2.515517, c1 = 0.802853, c2 = 0.010328;
      const d1 = 1.432788, d2 = 0.189269, d3 = 0.001308;
      return -(t - (c0 + c1 * t + c2 * t * t) / (1 + d1 * t + d2 * t * t + d3 * t * t * t));
    }

    function calcAB() {
      if (abMode === 'results') {
        const va = parseInt((document.getElementById('ab-va') as HTMLInputElement).value) || 1;
        const ca = parseInt((document.getElementById('ab-ca') as HTMLInputElement).value) || 0;
        const vb = parseInt((document.getElementById('ab-vb') as HTMLInputElement).value) || 1;
        const cb = parseInt((document.getElementById('ab-cb') as HTMLInputElement).value) || 0;
        const confLevel = parseFloat((document.getElementById('ab-conf') as HTMLSelectElement).value);

        const pA = ca / va;
        const pB = cb / vb;
        const pPooled = (ca + cb) / (va + vb);
        const se = Math.sqrt(pPooled * (1 - pPooled) * (1 / va + 1 / vb));
        const z = se > 0 ? (pB - pA) / se : 0;
        const pValue = 2 * (1 - normalCDF(Math.abs(z)));
        const lift = pA > 0 ? ((pB - pA) / pA) * 100 : 0;
        const isSignificant = pValue < (1 - confLevel);

        const seDiff = Math.sqrt(pA * (1 - pA) / va + pB * (1 - pB) / vb);
        const zAlpha = normalInv(1 - (1 - confLevel) / 2);
        const ciLow = (pB - pA) - zAlpha * seDiff;
        const ciHigh = (pB - pA) + zAlpha * seDiff;

        document.getElementById('ab-mainlabel')!.textContent = 'Statistische Signifikanz';
        document.getElementById('ab-main')!.textContent = isSignificant ? 'SIGNIFIKANT' : 'NICHT signifikant';
        document.getElementById('ab-subtitle')!.textContent = isSignificant
          ? 'B ist mit hoher Wahrscheinlichkeit ' + (pB > pA ? 'besser' : 'schlechter') + ' als A'
          : 'Nicht genügend Evidenz für einen Gewinner';

        document.getElementById('ab-s1l')!.textContent = 'Kontrollrate (A)';
        document.getElementById('ab-s1')!.textContent = (pA * 100).toFixed(2) + '%';
        document.getElementById('ab-s2l')!.textContent = 'Variantenrate (B)';
        document.getElementById('ab-s2')!.textContent = (pB * 100).toFixed(2) + '%';
        document.getElementById('ab-s3l')!.textContent = 'Relativer Lift';
        document.getElementById('ab-s3')!.textContent = (lift >= 0 ? '+' : '') + lift.toFixed(2) + '%';
        document.getElementById('ab-s4l')!.textContent = 'P-Wert';
        document.getElementById('ab-s4')!.textContent = pValue < 0.001 ? pValue.toExponential(3) : pValue.toFixed(4);

        let html = '';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>Z-Wert</span><span>' + z.toFixed(4) + '</span></div>';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>Standardfehler</span><span>' + se.toFixed(6) + '</span></div>';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>Absolute Differenz</span><span>' + ((pB - pA) * 100).toFixed(3) + ' Pp</span></div>';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + (confLevel * 100) + '% KI für Differenz</span><span>' + (ciLow * 100).toFixed(3) + ' bis ' + (ciHigh * 100).toFixed(3) + ' Pp</span></div>';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>Gepoolte Konversionsrate</span><span>' + (pPooled * 100).toFixed(3) + '%</span></div>';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>Gesamtstichprobe</span><span>' + (va + vb).toLocaleString('de-DE') + '</span></div>';

        const effectSize = Math.abs(pB - pA) / Math.sqrt(pPooled * (1 - pPooled));
        const power = 1 - normalCDF(zAlpha - effectSize * Math.sqrt(va));
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>Statistische Power</span><span>' + (power * 100).toFixed(1) + '%</span></div>';

        document.getElementById('ab-tableh')!.textContent = 'Testdetails';
        document.getElementById('ab-details')!.innerHTML = html;

      } else {
        const baseline = (parseFloat((document.getElementById('ab-baseline') as HTMLInputElement).value) || 3) / 100;
        const mde = (parseFloat((document.getElementById('ab-mde') as HTMLInputElement).value) || 10) / 100;
        const confLevel = parseFloat((document.getElementById('ab-planconf') as HTMLSelectElement).value);
        const power = parseFloat((document.getElementById('ab-power') as HTMLSelectElement).value);
        const daily = parseInt((document.getElementById('ab-daily') as HTMLInputElement).value) || 1000;

        const p1 = baseline;
        const p2 = baseline * (1 + mde);
        const zAlpha = normalInv(1 - (1 - confLevel) / 2);
        const zBeta = normalInv(power);

        const num = Math.pow(zAlpha + zBeta, 2) * (p1 * (1 - p1) + p2 * (1 - p2));
        const den = Math.pow(p2 - p1, 2);
        const samplePerVariant = Math.ceil(num / den);
        const totalSample = samplePerVariant * 2;
        const daysNeeded = Math.ceil(samplePerVariant / daily);

        document.getElementById('ab-mainlabel')!.textContent = 'Benötigte Stichprobe (pro Variante)';
        document.getElementById('ab-main')!.textContent = samplePerVariant.toLocaleString('de-DE');
        document.getElementById('ab-subtitle')!.textContent = totalSample.toLocaleString('de-DE') + ' Besucher insgesamt benötigt';

        document.getElementById('ab-s1l')!.textContent = 'Basisrate';
        document.getElementById('ab-s1')!.textContent = (p1 * 100).toFixed(2) + '%';
        document.getElementById('ab-s2l')!.textContent = 'Zielrate (B)';
        document.getElementById('ab-s2')!.textContent = (p2 * 100).toFixed(2) + '%';
        document.getElementById('ab-s3l')!.textContent = 'MDE (relativ)';
        document.getElementById('ab-s3')!.textContent = (mde * 100).toFixed(1) + '%';
        document.getElementById('ab-s4l')!.textContent = 'Benötigte Tage';
        document.getElementById('ab-s4')!.textContent = daysNeeded + ' Tage';

        const mdes = [2, 5, 10, 15, 20, 25, 30, 50];
        let html = '';
        for (const m of mdes) {
          const mp = m / 100;
          const tp2 = baseline * (1 + mp);
          const tn = Math.pow(zAlpha + zBeta, 2) * (p1 * (1 - p1) + tp2 * (1 - tp2)) / Math.pow(tp2 - p1, 2);
          const ts = Math.ceil(tn);
          const td = Math.ceil(ts / daily);
          const marker = Math.abs(m - mde * 100) < 0.5 ? ' font-bold text-primary' : '';
          html += '<div class="flex justify-between py-0.5 border-b border-border' + marker + '"><span>MDE ' + m + '%</span><span>' + ts.toLocaleString('de-DE') + '/Variante | ' + td + ' Tage</span></div>';
        }
        document.getElementById('ab-tableh')!.textContent = 'Stichprobengröße nach MDE';
        document.getElementById('ab-details')!.innerHTML = html;
      }

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ab-mode').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.ab-mode').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          abMode = (btn as HTMLElement).dataset.mode || 'results';
          document.getElementById('ab-results-section')!.classList.toggle('hidden', abMode !== 'results');
          document.getElementById('ab-plan-section')!.classList.toggle('hidden', abMode !== 'plan');
          calcAB();
        });
      });
      document.querySelectorAll('.ab-in').forEach(el => { el.addEventListener('input', calcAB); el.addEventListener('change', calcAB); });
      calcAB();
    }, 50);
  </script>
</CalculatorLayout>
