---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Einladungsrechner – Druckkosten & Mengen für Einladungskarten";
const description = "Berechnen Sie Druckkosten und Mengen für Einladungskarten.";
const relatedCalcs = [
  { name: "Rechnungsrechner", url: "/de/rechnungs-rechner", description: "Rechnungen mit MwSt. berechnen." },
  { name: "Lagerumschlag Rechner", url: "/de/lagerumschlag-rechner", description: "Lagerumschlaghäufigkeit." },
  { name: "Brennofen Energierechner", url: "/de/brennofen-energie-rechner", description: "Energiebedarf Brennofen." },
  { name: "3D-Drucker Kostenrechner", url: "/de/3d-drucker-kosten-rechner", description: "3D-Druck Kosten." },
];
---
<CalculatorLayout lang="de" enSlug="invitation-calculator" title={title} description={description} calculatorName="Einladungsrechner" keywords="Einladungskarten Kosten, Druckkosten berechnen, Einladungen drucken, Briefumschlag, Portokosten" breadcrumbs={[{ name: "Einladungsrechner", url: "/de/einladungs-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Einladungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Gesamtkosten für Einladungskarten inklusive Druck, Umschläge, Porto und Rücklaufkarten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Einladungen</label><input type="number" id="er-count" class="er-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="80" min="1" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Puffer / Zusatzkarten (%)</label><input type="number" id="er-buffer" class="er-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Druckkosten pro Karte (€)</label><input type="number" id="er-print" class="er-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.80" min="0" step="0.05"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Umschlag pro Stück (€)</label><input type="number" id="er-env" class="er-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.30" min="0" step="0.05"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Porto pro Brief (€)</label><input type="number" id="er-postage" class="er-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.85" min="0" step="0.05"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rücklaufkarte Porto (€)</label><input type="number" id="er-rsvp" class="er-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.85" min="0" step="0.05"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Design/Gestaltung einmalig (€)</label><input type="number" id="er-design" class="er-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="10"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="er-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="er-per-unit"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Benötigte Karten</div><div class="text-xl font-bold" id="er-total-count">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Druckkosten gesamt</div><div class="text-xl font-bold" id="er-print-total">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Porto gesamt</div><div class="text-xl font-bold" id="er-postage-total">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umschläge gesamt</div><div class="text-xl font-bold" id="er-env-total">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="invitation" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Einladungskarten – Kosten im Überblick</h2>
      <p class="text-text-secondary">Die Kosten für Einladungskarten setzen sich aus Druck, Papier, Umschlägen, Porto und optionalem Designerhonorar zusammen. Für Hochzeiten, Geburtstage oder Firmenevents empfiehlt sich ein Puffer von 10–15 % für vergessene Gäste oder beschädigte Karten. Das aktuelle Deutsche-Post-Porto für Standardbriefe beträgt seit 2024 0,85 €.</p>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel kosten professionell gedruckte Einladungen?</h4>
          <p class="text-text-secondary mt-1">Professionelle Einladungskarten kosten je nach Qualität und Auflage 0,50–5,00 € pro Stück. Bei kleinen Auflagen (unter 50) sind die Stückkosten höher. Online-Druckdienstleister wie Canva, Vistaprint oder Minted bieten ab ca. 0,70 € pro Karte an.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wann sollten Einladungen versendet werden?</h4>
          <p class="text-text-secondary mt-1">Für Hochzeiten 6–8 Wochen im Voraus, für Geburtstagsfeiern 3–4 Wochen, für Firmenevents mindestens 4 Wochen. Save-the-Date-Karten können bereits 6–12 Monate vor dem Event verschickt werden.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Lohnt sich digitale statt gedruckter Einladungen?</html4>
          <p class="text-text-secondary mt-1">Digitale Einladungen (z.B. per WhatsApp, E-Mail oder Evite) sind nahezu kostenlos und sofort zustellbar. Für formelle Anlässe wie Hochzeiten bevorzugen viele Gäste jedoch gedruckte Einladungen als Erinnerungsstück. Eine Kombination aus digitaler und gedruckter Einladung ist oft der beste Kompromiss.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel Porto kostet ein Standardbrief in Deutschland?</h4>
          <p class="text-text-secondary mt-1">Das Porto für einen Standardbrief (bis 20 g, bis 23,5 × 12,5 cm) beträgt seit 2024 0,85 €. Für Großbriefe fallen höhere Kosten an. Die Deutsche Post erhöht die Preise regelmäßig, daher empfiehlt sich eine aktuelle Prüfung auf der Post-Website.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcER() {
      const count = parseInt((document.getElementById('er-count') as HTMLInputElement).value) || 0;
      const buffer = parseFloat((document.getElementById('er-buffer') as HTMLInputElement).value) || 0;
      const printCost = parseFloat((document.getElementById('er-print') as HTMLInputElement).value) || 0;
      const envCost = parseFloat((document.getElementById('er-env') as HTMLInputElement).value) || 0;
      const postage = parseFloat((document.getElementById('er-postage') as HTMLInputElement).value) || 0;
      const rsvp = parseFloat((document.getElementById('er-rsvp') as HTMLInputElement).value) || 0;
      const design = parseFloat((document.getElementById('er-design') as HTMLInputElement).value) || 0;
      const totalCards = Math.ceil(count * (1 + buffer / 100));
      const printTotal = totalCards * printCost;
      const envTotal = totalCards * envCost;
      const postageTotal = count * (postage + rsvp);
      const total = printTotal + envTotal + postageTotal + design;
      const perUnit = count > 0 ? total / count : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('er-result')!.textContent = fmt(total);
      document.getElementById('er-per-unit')!.textContent = 'Kosten pro Einladung: ' + fmt(perUnit);
      document.getElementById('er-total-count')!.textContent = totalCards.toLocaleString('de-DE') + ' Stück';
      document.getElementById('er-print-total')!.textContent = fmt(printTotal);
      document.getElementById('er-postage-total')!.textContent = fmt(postageTotal);
      document.getElementById('er-env-total')!.textContent = fmt(envTotal);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.er-in').forEach(el => { el.addEventListener('input', calcER); el.addEventListener('change', calcER); });
      calcER();
    }, 50);
  </script>
</CalculatorLayout>
