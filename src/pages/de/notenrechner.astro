---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Notenrechner - Notendurchschnitt berechnen 2026";
const description = "Berechne deinen Notendurchschnitt sofort. Fächer, Credits und Noten eingeben. Unterstützt deutsches Notensystem und GPA.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Brüche berechnen." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Wissenschaftliche Berechnungen." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Genaues Alter berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Notenrechner" keywords="Notenrechner, Notendurchschnitt, GPA Rechner, Notenschnitt berechnen, Uni Notenrechner" breadcrumbs={[{ name: "Notenrechner", url: "/de/notenrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Notenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne deinen Semester- oder Gesamtnotendurchschnitt. Fächer, Credits und Noten eingeben.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Semester-Durchschnitt</div>
          <div class="text-4xl sm:text-5xl font-extrabold" id="gpa-semester">0,00</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center flex flex-col justify-center"><div class="text-xs text-text-muted uppercase">Gesamt-Credits</div><div class="text-2xl font-bold" id="gpa-credits">0</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center flex flex-col justify-center"><div class="text-xs text-text-muted uppercase">Notenpunkte</div><div class="text-2xl font-bold" id="gpa-points">0,00</div></div>
      </div>

      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm" id="gpa-table">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-2 font-semibold w-2/5">Fachname</th><th class="py-2 pr-2 font-semibold w-1/5">Credits</th><th class="py-2 pr-2 font-semibold w-1/5">Note</th><th class="py-2 pr-2 font-semibold w-1/10 text-right">Punkte</th><th class="py-2 w-8"></th></tr></thead>
          <tbody id="gpa-tbody"></tbody>
        </table>
      </div>
      <button id="gpa-add-btn" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold hover:bg-primary/90 transition-colors cursor-pointer">+ Fach hinzufügen</button>

      <div class="mt-8 pt-6 border-t border-border">
        <h3 class="font-semibold text-text mb-4">Gesamtdurchschnitt (optional)</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div><label class="block text-sm font-medium text-text mb-1">Aktueller Gesamtdurchschnitt</label><input type="number" id="gpa-cum-current" class="w-full px-3 py-2 border border-border rounded-lg" placeholder="2.0" step="0.1" min="1" max="5"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Bisherige Credits</label><input type="number" id="gpa-cum-credits" class="w-full px-3 py-2 border border-border rounded-lg" placeholder="60" step="1" min="0"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Neuer Gesamtdurchschnitt</div><div class="text-3xl font-bold text-primary" id="gpa-cumulative">—</div></div>
      </div>
      <div class="mt-6"><ShareButton calculatorId="gpa" lang="de" /><FeedbackWidget lang="de" /></div>
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">Deutsches Notensystem</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-3 font-semibold">Note</th><th class="py-2 pr-3 font-semibold">Bewertung</th><th class="py-2 font-semibold">Beschreibung</th></tr></thead>
          <tbody class="text-text-secondary">
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-medium text-primary">1,0 - 1,3</td><td class="py-2 pr-3">Sehr gut</td><td class="py-2">Hervorragende Leistung</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-medium">1,7 - 2,3</td><td class="py-2 pr-3">Gut</td><td class="py-2">Erheblich über dem Durchschnitt</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-medium">2,7 - 3,3</td><td class="py-2 pr-3">Befriedigend</td><td class="py-2">Durchschnittliche Leistung</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-medium">3,7 - 4,0</td><td class="py-2 pr-3">Ausreichend</td><td class="py-2">Trotz Mängeln noch ausreichend</td></tr>
            <tr><td class="py-2 pr-3 font-medium text-danger">5,0</td><td class="py-2 pr-3">Nicht bestanden</td><td class="py-2">Leistung nicht ausreichend</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie der Notendurchschnitt berechnet wird</h2>
      <p>Der gewichtete Notendurchschnitt wird berechnet, indem jede Note mit den zugehörigen Credits multipliziert wird, die Summe gebildet und durch die Gesamtzahl der Credits geteilt wird.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Durchschnitt = Summe(Note &times; Credits) / Gesamt-Credits</div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const gradeOptions = [
      { label: '1,0 (Sehr gut)', value: 1.0 },
      { label: '1,3', value: 1.3 },
      { label: '1,7', value: 1.7 },
      { label: '2,0 (Gut)', value: 2.0 },
      { label: '2,3', value: 2.3 },
      { label: '2,7', value: 2.7 },
      { label: '3,0 (Befriedigend)', value: 3.0 },
      { label: '3,3', value: 3.3 },
      { label: '3,7', value: 3.7 },
      { label: '4,0 (Ausreichend)', value: 4.0 },
      { label: '5,0 (Nicht bestanden)', value: 5.0 },
    ];
    const gradeOptionsHTML = gradeOptions.map(g => `<option value="${g.value}">${g.label}</option>`).join('');
    let courseCount = 0;

    function addCourse(name = '', credits = '5', gradeVal = '2.0') {
      courseCount++;
      const tbody = document.getElementById('gpa-tbody')!;
      const tr = document.createElement('tr');
      tr.className = 'border-b border-border/30 gpa-row';
      tr.innerHTML = `<td class="py-2 pr-2"><input type="text" class="w-full px-2 py-1.5 border border-border rounded-lg text-sm gpa-name" placeholder="Fach ${courseCount}" value="${name}"></td><td class="py-2 pr-2"><input type="number" class="w-full px-2 py-1.5 border border-border rounded-lg text-sm gpa-credit" min="0" max="30" step="1" value="${credits}"></td><td class="py-2 pr-2"><select class="w-full px-2 py-1.5 border border-border rounded-lg text-sm gpa-grade">${gradeOptionsHTML}</select></td><td class="py-2 pr-2 text-right font-medium gpa-row-points">0,0</td><td class="py-2 text-center"><button class="text-text-muted hover:text-danger transition-colors gpa-remove cursor-pointer">&times;</button></td>`;
      tbody.appendChild(tr);
      (tr.querySelector('.gpa-grade') as HTMLSelectElement).value = gradeVal;
      tr.querySelector('.gpa-credit')!.addEventListener('input', calcGPA);
      tr.querySelector('.gpa-grade')!.addEventListener('change', calcGPA);
      tr.querySelector('.gpa-remove')!.addEventListener('click', () => { tr.remove(); calcGPA(); });
      calcGPA();
    }

    function calcGPA() {
      const rows = document.querySelectorAll('.gpa-row');
      let totalPoints = 0, totalCredits = 0;
      rows.forEach(row => {
        const credits = parseFloat((row.querySelector('.gpa-credit') as HTMLInputElement).value) || 0;
        const grade = parseFloat((row.querySelector('.gpa-grade') as HTMLSelectElement).value) || 0;
        const points = grade * credits;
        (row.querySelector('.gpa-row-points') as HTMLElement).textContent = points.toFixed(1).replace('.', ',');
        totalPoints += points;
        totalCredits += credits;
      });
      const avg = totalCredits > 0 ? totalPoints / totalCredits : 0;
      document.getElementById('gpa-semester')!.textContent = avg.toFixed(2).replace('.', ',');
      document.getElementById('gpa-credits')!.textContent = String(totalCredits);
      document.getElementById('gpa-points')!.textContent = totalPoints.toFixed(2).replace('.', ',');

      const gpaEl = document.getElementById('gpa-semester')!;
      gpaEl.parentElement!.className = 'p-6 rounded-2xl text-white text-center ' + (avg <= 1.5 ? 'bg-primary' : avg <= 2.5 ? 'bg-secondary' : avg <= 3.5 ? 'bg-accent' : 'bg-danger');

      const cumGPA = parseFloat((document.getElementById('gpa-cum-current') as HTMLInputElement).value) || 0;
      const cumCredits = parseFloat((document.getElementById('gpa-cum-credits') as HTMLInputElement).value) || 0;
      if (cumGPA > 0 && cumCredits > 0 && totalCredits > 0) {
        const newCum = (cumGPA * cumCredits + totalPoints) / (cumCredits + totalCredits);
        document.getElementById('gpa-cumulative')!.textContent = newCum.toFixed(2).replace('.', ',');
      } else {
        document.getElementById('gpa-cumulative')!.textContent = '—';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('gpa-add-btn')!.addEventListener('click', () => addCourse());
      document.getElementById('gpa-cum-current')!.addEventListener('input', calcGPA);
      document.getElementById('gpa-cum-credits')!.addEventListener('input', calcGPA);
      addCourse('', '5', '1.7');
      addCourse('', '5', '2.3');
      addCourse('', '6', '1.3');
      addCourse('', '5', '2.0');
    }, 50);
  </script>
</CalculatorLayout>
