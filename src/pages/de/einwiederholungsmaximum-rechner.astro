---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "1RM Rechner – Einwiederholungsmaximum für Krafttraining berechnen";
const description = "Berechnen Sie Ihr Einwiederholungsmaximum (1RM) für Krafttraining nach Epley, Brzycki und Lander.";
const relatedCalcs = [
  { name: "Abnehmen Rechner", url: "/de/abnehmenrechner", description: "Kaloriendefizit berechnen." },
  { name: "Tempo-Zonen Rechner", url: "/de/tempo-zonen-rechner", description: "Trainingszonen." },
  { name: "Tempo Rechner", url: "/de/tempo-rechner", description: "Lauftempo berechnen." },
  { name: "A1C Rechner", url: "/de/a1c-rechner", description: "HbA1c-Wert." },
];
---
<CalculatorLayout lang="de" enSlug="one-rep-max-calculator" title={title} description={description} calculatorName="1RM Rechner" keywords="1RM, Einwiederholungsmaximum, Krafttraining, Epley, Brzycki, Lander, Maximalkraft" breadcrumbs={[{ name: "1RM Rechner", url: "/de/einwiederholungsmaximum-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">1RM Rechner – Einwiederholungsmaximum</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihr theoretisches Einwiederholungsmaximum (1RM) anhand von Gewicht und Wiederholungsanzahl nach verschiedenen Formeln.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label>
            <input type="number" id="rm-weight" class="rm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="2.5" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Wiederholungen</label>
            <input type="number" id="rm-reps" class="rm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" max="30">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätztes 1RM (Epley)</div>
          <div class="text-5xl font-extrabold font-mono" id="rm-result">— kg</div>
          <div class="text-sm text-blue-200 mt-1" id="rm-subtitle"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Epley</div>
            <div class="text-xl font-bold" id="rm-epley">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Brzycki</div>
            <div class="text-xl font-bold" id="rm-brzycki">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Lander</div>
            <div class="text-xl font-bold" id="rm-lander">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Durchschnitt</div>
            <div class="text-xl font-bold" id="rm-avg">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Trainingsgewichte (% 1RM)</h3>
          <div class="font-mono text-sm space-y-1" id="rm-pcts"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="one-rep-max" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Einwiederholungsmaximum im Krafttraining</h2>
      <p>Das Einwiederholungsmaximum (1RM) ist das maximale Gewicht, das eine Person genau einmal in einer bestimmten Übung heben kann. Es dient als Referenzwert für die Trainingsplanung im Krafttraining. Da das direkte Testen des 1RM verletzungsrisikoreicher ist, werden oft Submaximaltests mit berechneten Formeln verwendet.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Epley: 1RM = Gewicht × (1 + Wdh/30)</p>
        <p>Brzycki: 1RM = Gewicht × 36 / (37 - Wdh)</p>
        <p>Lander: 1RM = 100 × Gewicht / (101,3 - 2,67123 × Wdh)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Formel ist am genauesten?</strong> Bei 1–10 Wiederholungen liefern alle drei Formeln ähnliche Ergebnisse. Die Brzycki-Formel wird für weniger als 10 Wiederholungen empfohlen, die Epley-Formel ist einfacher zu berechnen.</p>
      <p><strong>Wie oft sollte ich mein 1RM testen?</strong> Ein direkter 1RM-Test sollte höchstens alle 4–6 Wochen durchgeführt werden und erfordert eine gründliche Aufwärmphase. Submaximaltests können häufiger durchgeführt werden.</p>
      <p><strong>Welche Intensitäten nutze ich für verschiedene Trainingsziele?</strong> Maximalkraft: 90–100% 1RM (1–3 Wdh), Kraftausdauer: 70–85% 1RM (6–10 Wdh), Muskelaufbau: 65–80% 1RM (8–12 Wdh), Kraftausdauer: 50–65% 1RM (15+ Wdh).</p>
      <p><strong>Ist das 1RM für alle Übungen gleich?</strong> Nein. Das 1RM ist übungsspezifisch. Ein hohes Kniebeugen-1RM bedeutet nicht automatisch ein proportional hohes Kreuzheben-1RM.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcRM() {
      const w = parseFloat((document.getElementById('rm-weight') as HTMLInputElement).value) || 0;
      const r = parseFloat((document.getElementById('rm-reps') as HTMLInputElement).value) || 1;
      const fmt1 = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      const epley = r === 1 ? w : w * (1 + r / 30);
      const brzycki = r === 1 ? w : w * 36 / (37 - r);
      const lander = r === 1 ? w : 100 * w / (101.3 - 2.67123 * r);
      const avg = (epley + brzycki + lander) / 3;
      const pcts = [100, 95, 90, 85, 80, 75, 70, 65, 60];
      document.getElementById('rm-result')!.textContent = fmt1(epley) + ' kg';
      document.getElementById('rm-subtitle')!.textContent = 'Durchschnitt aller Formeln: ' + fmt1(avg) + ' kg';
      document.getElementById('rm-epley')!.textContent = fmt1(epley) + ' kg';
      document.getElementById('rm-brzycki')!.textContent = fmt1(brzycki) + ' kg';
      document.getElementById('rm-lander')!.textContent = fmt1(lander) + ' kg';
      document.getElementById('rm-avg')!.textContent = fmt1(avg) + ' kg';
      document.getElementById('rm-pcts')!.innerHTML = pcts.map(p => {
        const kg = avg * p / 100;
        return '<div class="flex justify-between"><span>' + p + '% 1RM</span><span class="font-bold">' + fmt1(kg) + ' kg</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('rm-weight') as HTMLInputElement).value = '100';
      (document.getElementById('rm-reps') as HTMLInputElement).value = '5';
      document.querySelectorAll('.rm-in').forEach(el => { el.addEventListener('input', calcRM); el.addEventListener('change', calcRM); });
      calcRM();
    }, 50);
  </script>
</CalculatorLayout>
