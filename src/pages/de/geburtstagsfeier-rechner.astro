---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Geburtstagsfeier-Rechner - Partybudget planen für Kinder";
const description = "Planen Sie das Budget für die Geburtstagsfeier Ihres Kindes inklusive Location, Essen, Dekoration, Gastgeschenke und Unterhaltung. Kostenschätzung nach Partygröße und Stil.";

const relatedCalcs = [
  { name: "Taschengeldrechner", url: "/de/taschengeld-rechner", description: "Taschengeld für Kinder." },
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Familienbudget." },
  { name: "Trinkgeldrechner", url: "/de/trinkgeld-rechner", description: "Trinkgeld-Ratgeber." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Geburtstagsfeier-Rechner"
  lang="de"
  keywords="geburtstagsfeier rechner, kindergeburtstag kosten, partybudget rechner, geburtstag planen, kinderparty budget"
  breadcrumbs={[{ name: "Geburtstagsfeier-Rechner", url: "/de/geburtstagsfeier-rechner" }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Geburtstagsfeier-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie die Geburtstagsfeier Ihres Kindes mit detaillierter Kostenaufstellung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl der Gäste</label>
          <input type="number" id="bpc-guests" class="bpc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="3" max="50" step="1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Alter des Kindes</label>
          <input type="number" id="bpc-age" class="bpc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="18" step="1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Location</label>
          <select id="bpc-venue" class="bpc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="home" selected>Zuhause / Garten</option>
            <option value="park">Öffentlicher Park (kostenlos)</option>
            <option value="restaurant">Restaurant / Pizzeria</option>
            <option value="activity">Aktivitäts-Location (Trampolin, Bowling)</option>
            <option value="premium">Premium-Location (Partyhalle, Bauernhof)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Essen & Getränke</label>
          <select id="bpc-food" class="bpc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="simple">Einfach (Kuchen & Snacks)</option>
            <option value="pizza" selected>Pizza & Getränke</option>
            <option value="catered">Catering</option>
            <option value="full">Komplett (Vorspeisen, Hauptgericht, Dessert)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Unterhaltung</label>
          <select id="bpc-entertain" class="bpc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="diy" selected>Selbst organisierte Spiele</option>
            <option value="character">Figur / Kinderschminken</option>
            <option value="performer">Zauberer / Entertainer</option>
            <option value="bounce">Hüpfburg-Verleih</option>
            <option value="none">Keine Unterhaltung</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Dekorations-Level</label>
          <select id="bpc-decor" class="bpc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="minimal">Minimal (einfache Ballons)</option>
            <option value="standard" selected>Standard (Motto-Party)</option>
            <option value="elaborate">Aufwendig (individuelle Gestaltung)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Gastgeschenke</label>
          <select id="bpc-favors" class="bpc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Keine</option>
            <option value="simple" selected>Einfache Mitgebsel (3-5 € pro Stück)</option>
            <option value="medium">Mittlere Qualität (5-10 € pro Stück)</option>
            <option value="premium">Premium (10-15 € pro Stück)</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamt-Partybudget</div>
        <div class="text-5xl font-extrabold" id="bpc-total">--</div>
        <div class="text-sm text-blue-200 mt-1" id="bpc-perguest">Kosten pro Gast</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Location-Kosten</div>
          <div class="text-lg font-bold" id="bpc-venuecost">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Essen & Kuchen</div>
          <div class="text-lg font-bold" id="bpc-foodcost">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Unterhaltung</div>
          <div class="text-lg font-bold" id="bpc-entertaincost">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Deko & Geschenke</div>
          <div class="text-lg font-bold" id="bpc-decorcost">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Detaillierte Aufstellung</h3>
        <div class="text-xs" id="bpc-breakdown"></div>
      </div>

      <ShareButton calculatorId="birthday-party" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Geburtstagsfeier-Budget planen</h2>
      <p>Ein durchschnittlicher Kindergeburtstag kostet 200-400 €, kann aber von 80 € für eine einfache Feier zuhause bis über 800 € für eine Premium-Location reichen. Entscheidend ist, ein Budget festzulegen und die Prioritäten nach den Wünschen des Kindes zu setzen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Budget-Tipps</h3>
      <ul>
        <li>Zuhause oder in einem kostenlosen Park feiern</li>
        <li>Dekoration und Kuchen selbst machen</li>
        <li>Selbst organisierte Spiele statt Entertainer buchen</li>
        <li>Gästeliste überschaubar halten (Faustregel: Alter des Kindes + 1)</li>
        <li>Partyartikel und Mitgebsel günstig einkaufen</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Durchschnittliche Partykosten nach Alter</h3>
      <ul>
        <li><strong>1-3 Jahre:</strong> 80-250 € (kleinere, einfachere Feiern)</li>
        <li><strong>4-7 Jahre:</strong> 150-400 € (Motto-Partys, mehr Gäste)</li>
        <li><strong>8-12 Jahre:</strong> 250-600 € (Aktivitäts-Partys)</li>
        <li><strong>13+ Jahre:</strong> 150-700 € (Ausflüge, Erlebnisse)</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBPC() {
      const guests = parseFloat((document.getElementById('bpc-guests') as HTMLInputElement).value) || 15;
      const age = parseFloat((document.getElementById('bpc-age') as HTMLInputElement).value) || 6;
      const venue = (document.getElementById('bpc-venue') as HTMLSelectElement).value;
      const food = (document.getElementById('bpc-food') as HTMLSelectElement).value;
      const entertain = (document.getElementById('bpc-entertain') as HTMLSelectElement).value;
      const decor = (document.getElementById('bpc-decor') as HTMLSelectElement).value;
      const favors = (document.getElementById('bpc-favors') as HTMLSelectElement).value;

      const venueCosts: Record<string, number> = {
        home: 0, park: 0, restaurant: 8 * guests, activity: 20 * guests, premium: 300 + 15 * guests
      };

      const foodPerPerson: Record<string, number> = {
        simple: 3, pizza: 6, catered: 15, full: 22
      };
      const cakeCost = guests <= 15 ? 30 : guests <= 25 ? 50 : 75;

      const entertainCosts: Record<string, number> = {
        diy: 20, character: 175, performer: 250, bounce: 200, none: 0
      };

      const decorCosts: Record<string, number> = {
        minimal: 20, standard: 60, elaborate: 150
      };

      const favorPerGuest: Record<string, number> = {
        none: 0, simple: 4, medium: 7.5, premium: 12.5
      };

      const invitations = guests <= 10 ? 10 : 20;

      interface CostItem { name: string; amount: number; }
      const items: CostItem[] = [
        { name: 'Location', amount: venueCosts[venue] },
        { name: 'Essen & Getränke', amount: foodPerPerson[food] * guests },
        { name: 'Geburtstagskuchen', amount: cakeCost },
        { name: 'Unterhaltung', amount: entertainCosts[entertain] },
        { name: 'Dekoration', amount: decorCosts[decor] },
        { name: 'Gastgeschenke', amount: favorPerGuest[favors] * guests },
        { name: 'Einladungen', amount: invitations },
        { name: 'Teller/Becher/Servietten', amount: Math.ceil(guests / 8) * 5 },
      ];

      const total = items.reduce((s, i) => s + i.amount, 0);
      const perGuest = total / guests;

      const venueTot = venueCosts[venue];
      const foodTot = foodPerPerson[food] * guests + cakeCost;
      const entertainTot = entertainCosts[entertain];
      const decorTot = decorCosts[decor] + favorPerGuest[favors] * guests;

      const fmtEur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';

      document.getElementById('bpc-total')!.textContent = fmtEur(Math.round(total));
      document.getElementById('bpc-perguest')!.textContent = fmtEur(Math.round(perGuest)) + ' pro Gast';
      document.getElementById('bpc-venuecost')!.textContent = fmtEur(Math.round(venueTot));
      document.getElementById('bpc-foodcost')!.textContent = fmtEur(Math.round(foodTot));
      document.getElementById('bpc-entertaincost')!.textContent = fmtEur(Math.round(entertainTot));
      document.getElementById('bpc-decorcost')!.textContent = fmtEur(Math.round(decorTot));

      document.getElementById('bpc-breakdown')!.innerHTML =
        '<div class="grid grid-cols-2 gap-2 font-semibold text-text-muted mb-1"><span>Position</span><span class="text-right">Kosten</span></div>' +
        items.map(i => `<div class="grid grid-cols-2 gap-2 py-1"><span>${i.name}</span><span class="text-right font-semibold">${fmtEur(Math.round(i.amount))}</span></div>`).join('') +
        `<div class="grid grid-cols-2 gap-2 py-1 mt-1 border-t border-border font-bold"><span>Gesamt</span><span class="text-right">${fmtEur(Math.round(total))}</span></div>`;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bpc-in').forEach(el => {
        el.addEventListener('input', calcBPC);
        el.addEventListener('change', calcBPC);
      });
      calcBPC();
    }, 50);
  </script>
</CalculatorLayout>
