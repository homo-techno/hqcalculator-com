---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Rabatt-Rechner - Verkaufspreis & Ersparnis";
const description = "Berechnen Sie Verkaufspreise, Rabattbetr\u00e4ge und Ersparnisse sofort. Doppelrabatt, Originalpreis und Rabattprozent berechnen.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Mehrwertsteuer-Rechner", url: "/de/mehrwertsteuer-rechner", description: "MwSt-Berechnung." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Rabatt-Rechner" lang="de" enSlug="discount-calculator" keywords="rabatt rechner, verkaufspreis rechner, prozent rabatt, ersparnis rechner, doppelrabatt, preissenkung" breadcrumbs={[{ name: "Rabatt-Rechner", url: "/de/rabatt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Rabatt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Verkaufspreise, Ersparnisse und Doppelrabatte sofort.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="flex gap-2 mb-6">
        <button class="rbr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white" data-mode="price">Verkaufspreis</button>
        <button class="rbr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary" data-mode="percent">% Rabatt finden</button>
        <button class="rbr-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary" data-mode="original">Originalpreis</button>
      </div>

      <div id="rbr-price-mode">
        <div class="mb-5">
          <label class="block text-sm font-medium text-text mb-1">Originalpreis</label>
          <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span><input type="number" id="rbr-orig" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="100" min="0" step="0.01"></div>
        </div>
        <div class="mb-5">
          <label class="block text-sm font-medium text-text mb-1">Rabatt</label>
          <div class="flex gap-2">
            <input type="number" id="rbr-pct" class="flex-1 px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="25" min="0" max="100" step="0.5">
            <span class="self-center text-text-muted font-bold text-xl">%</span>
          </div>
          <div class="flex gap-2 mt-2">
            <button class="rbr-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt" data-pct="10">10%</button>
            <button class="rbr-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt" data-pct="15">15%</button>
            <button class="rbr-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt" data-pct="20">20%</button>
            <button class="rbr-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt" data-pct="25">25%</button>
            <button class="rbr-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt" data-pct="30">30%</button>
            <button class="rbr-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt" data-pct="40">40%</button>
            <button class="rbr-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt" data-pct="50">50%</button>
          </div>
        </div>
        <div class="mb-5">
          <label class="block text-sm font-medium text-text mb-1">Zweiter Rabatt <span class="text-text-muted">(optional)</span></label>
          <div class="flex gap-2">
            <input type="number" id="rbr-pct2" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg" value="0" min="0" max="100" step="0.5">
            <span class="self-center text-text-muted font-bold">%</span>
          </div>
        </div>
      </div>

      <div id="rbr-percent-mode" class="hidden">
        <div class="mb-5">
          <label class="block text-sm font-medium text-text mb-1">Originalpreis</label>
          <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span><input type="number" id="rbr-fp-orig" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="80" min="0" step="0.01"></div>
        </div>
        <div class="mb-5">
          <label class="block text-sm font-medium text-text mb-1">Verkaufspreis</label>
          <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span><input type="number" id="rbr-fp-sale" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="60" min="0" step="0.01"></div>
        </div>
      </div>

      <div id="rbr-original-mode" class="hidden">
        <div class="mb-5">
          <label class="block text-sm font-medium text-text mb-1">Verkaufspreis</label>
          <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span><input type="number" id="rbr-op-sale" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="75" min="0" step="0.01"></div>
        </div>
        <div class="mb-5">
          <label class="block text-sm font-medium text-text mb-1">Gew&auml;hrter Rabatt</label>
          <div class="flex gap-2">
            <input type="number" id="rbr-op-pct" class="flex-1 px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="25" min="0" max="100" step="0.5">
            <span class="self-center text-text-muted font-bold text-xl">%</span>
          </div>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="rbr-label">Verkaufspreis</div>
        <div class="text-5xl font-extrabold" id="rbr-result">75,00 &euro;</div>
      </div>
      <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Sie sparen</div>
          <div class="text-xl font-bold text-secondary" id="rbr-savings">25,00 &euro;</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gesamtrabatt</div>
          <div class="text-xl font-bold" id="rbr-total-pct">25%</div>
        </div>
      </div>

      <div class="bg-surface-alt rounded-xl p-4 mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Rabatttabelle</h3>
        <div class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm" id="rbr-table"></div>
      </div>

      <ShareButton calculatorId="discount-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Rabatte berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Verkaufspreis = Originalpreis &times; (1 &minus; Rabatt%/100)</div>
      <p>F&uuml;r einen Artikel von 100 &euro; mit 25% Rabatt: 100 &euro; &times; (1 &minus; 0,25) = 75 &euro;. Sie sparen 25 &euro;.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Sind 20% + 10% Rabatt dasselbe wie 30%?</strong> Nein. 20% + 10% gestapelt = 28% gesamt. Der zweite Rabatt wird auf den bereits reduzierten Preis angewendet.</p>
      <p><strong>Wie berechne ich den Rabattprozentsatz?</strong> Rabatt% = (Original &minus; Verkauf) / Original &times; 100.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let rbrMode = 'price';
    const rbrFmt = (n: number) => n.toFixed(2).replace('.', ',') + ' \u20AC';

    function calcRBR() {
      let origPrice = 0, salePrice = 0, savings = 0, pctOff = 0;

      if (rbrMode === 'price') {
        origPrice = parseFloat((document.getElementById('rbr-orig') as HTMLInputElement).value) || 0;
        const pct1 = (parseFloat((document.getElementById('rbr-pct') as HTMLInputElement).value) || 0) / 100;
        const pct2 = (parseFloat((document.getElementById('rbr-pct2') as HTMLInputElement).value) || 0) / 100;
        salePrice = origPrice * (1 - pct1) * (1 - pct2);
        savings = origPrice - salePrice;
        pctOff = origPrice > 0 ? (savings / origPrice * 100) : 0;
        document.getElementById('rbr-label')!.textContent = 'Verkaufspreis';
        document.getElementById('rbr-result')!.textContent = rbrFmt(salePrice);
      } else if (rbrMode === 'percent') {
        origPrice = parseFloat((document.getElementById('rbr-fp-orig') as HTMLInputElement).value) || 0;
        salePrice = parseFloat((document.getElementById('rbr-fp-sale') as HTMLInputElement).value) || 0;
        savings = origPrice - salePrice;
        pctOff = origPrice > 0 ? (savings / origPrice * 100) : 0;
        document.getElementById('rbr-label')!.textContent = 'Rabattprozent';
        document.getElementById('rbr-result')!.textContent = pctOff.toFixed(1).replace('.', ',') + '% RABATT';
      } else {
        salePrice = parseFloat((document.getElementById('rbr-op-sale') as HTMLInputElement).value) || 0;
        const pct = (parseFloat((document.getElementById('rbr-op-pct') as HTMLInputElement).value) || 0) / 100;
        origPrice = pct < 1 ? salePrice / (1 - pct) : 0;
        savings = origPrice - salePrice;
        pctOff = pct * 100;
        document.getElementById('rbr-label')!.textContent = 'Originalpreis';
        document.getElementById('rbr-result')!.textContent = rbrFmt(origPrice);
      }

      document.getElementById('rbr-savings')!.textContent = rbrFmt(savings);
      document.getElementById('rbr-total-pct')!.textContent = pctOff.toFixed(1).replace('.', ',') + '%';

      const basePrice = origPrice || 100;
      const pcts = [5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 60, 75];
      document.getElementById('rbr-table')!.innerHTML = pcts.map(p => {
        const sp = basePrice * (1 - p / 100);
        const highlight = Math.abs(p - pctOff) < 1;
        return '<div class="flex justify-between py-0.5 ' + (highlight ? 'font-bold text-primary' : 'text-text-secondary') + '"><span>' + p + '% Rabatt</span><span>' + rbrFmt(sp) + '</span></div>';
      }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.rbr-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.rbr-mode-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white'); b.classList.add('bg-surface-alt', 'text-text-secondary'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary'); btn.classList.add('bg-primary', 'text-white');
          rbrMode = (btn as HTMLElement).dataset.mode || 'price';
          document.getElementById('rbr-price-mode')!.classList.toggle('hidden', rbrMode !== 'price');
          document.getElementById('rbr-percent-mode')!.classList.toggle('hidden', rbrMode !== 'percent');
          document.getElementById('rbr-original-mode')!.classList.toggle('hidden', rbrMode !== 'original');
          calcRBR();
        });
      });

      document.querySelectorAll('.rbr-quick').forEach(btn => {
        btn.addEventListener('click', () => {
          (document.getElementById('rbr-pct') as HTMLInputElement).value = (btn as HTMLElement).dataset.pct || '25';
          calcRBR();
        });
      });

      ['rbr-orig', 'rbr-pct', 'rbr-pct2', 'rbr-fp-orig', 'rbr-fp-sale', 'rbr-op-sale', 'rbr-op-pct'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcRBR);
      });

      calcRBR();
    }, 50);
  </script>
</CalculatorLayout>
