---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Zapfenverbindung Rechner - Zapfen und Schlitz berechnen";
const description = "Berechnen Sie Maße für Zapfen und Schlitze bei traditionellen Holzverbindungen. Mit Toleranzen und Werkzeugkorrektur für Tischler und Heimwerker.";

const relatedCalcs = [
  { name: "Gehrungsrechner", url: "/de/gehrung-rechner", description: "Gehrungswinkel berechnen." },
  { name: "Holz-Rechner", url: "/de/holzrechner", description: "Holzmengen berechnen." },
  { name: "Winkelrechner", url: "/de/winkelrechner", description: "Winkel berechnen." },
  { name: "Mosaik-Fliesen Rechner", url: "/de/mosaik-fliesen-rechner", description: "Fliesen berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mortise-tenon-calculator" calculatorName="Zapfenverbindung Rechner" keywords="Zapfenverbindung, Mortise Tenon, Zapfen Schlitz, Holzverbindung, Tischler Rechner, Zapfen berechnen" breadcrumbs={[{ name: "Zapfenverbindung Rechner", url: "/de/zapfenverbindung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zapfenverbindung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie alle Maße für traditionelle Zapfen-Schlitz-Verbindungen (Mortise and Tenon) im Tischlerhandwerk und Holzbau.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Werkstückmaße</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Werkstückbreite (mm)</label>
            <input type="number" id="zv-width" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="10" value="60">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Werkstückstärke (mm)</label>
            <input type="number" id="zv-thick" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="10" value="30">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Gesamtlänge des Querstücks (mm)</label>
          <input type="number" id="zv-total-len" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="5" min="50" value="400">
        </div>

        <h3 class="font-semibold text-text mt-2">Zapfenparameter</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zapfenlänge (mm)</label>
            <input type="number" id="zv-tenon-len" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="5" value="40">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zapfendicke (% der Stärke)</label>
            <input type="number" id="zv-tenon-pct" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="5" min="20" max="60" value="33">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Schultertiefe (% der Breite)</label>
            <input type="number" id="zv-shoulder-pct" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="5" min="10" max="40" value="15">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Spielpassung (mm)</label>
            <input type="number" id="zv-clearance" class="zv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" value="0.2">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Zapfendicke</div>
          <div class="text-5xl font-extrabold font-mono" id="zv-result">— mm</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl">
            <h4 class="text-xs font-bold text-text-muted uppercase mb-2">Zapfen (Tenon)</h4>
            <div class="space-y-1 text-sm">
              <div class="flex justify-between"><span>Länge:</span><span class="font-bold" id="zv-tl">—</span></div>
              <div class="flex justify-between"><span>Breite:</span><span class="font-bold" id="zv-tw">—</span></div>
              <div class="flex justify-between"><span>Dicke:</span><span class="font-bold" id="zv-tt">—</span></div>
              <div class="flex justify-between"><span>Schulter:</span><span class="font-bold" id="zv-ts">—</span></div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h4 class="text-xs font-bold text-text-muted uppercase mb-2">Schlitz (Mortise)</h4>
            <div class="space-y-1 text-sm">
              <div class="flex justify-between"><span>Tiefe:</span><span class="font-bold" id="zv-md">—</span></div>
              <div class="flex justify-between"><span>Breite:</span><span class="font-bold" id="zv-mw">—</span></div>
              <div class="flex justify-between"><span>Dicke:</span><span class="font-bold" id="zv-mt">—</span></div>
              <div class="flex justify-between"><span>Abstand Kante:</span><span class="font-bold" id="zv-me">—</span></div>
            </div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schnittliste</h3>
          <div class="font-mono text-sm space-y-1" id="zv-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mortise-tenon" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die Zapfen-Schlitz-Verbindung</h2>
      <p>Die Zapfenverbindung (Mortise and Tenon) ist eine der ältesten und stabilsten Holzverbindungstechniken. Sie wird seit über 7.000 Jahren verwendet, wurde in Ägypten, Griechenland und China unabhängig voneinander entwickelt und ist heute im Möbelbau, Fachwerkbau und Bootsbau unverzichtbar.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Welche Grundregeln gelten für Zapfenverbindungen?</p>
          <p>Klassische Faustregeln: Zapfendicke = 1/3 der Werkstückstärke. Zapfenlänge = 4-5× Zapfendicke. Schulterhöhe = 10-20% der Werkstückbreite. Diese Proportionen sorgen für optimale Festigkeit ohne Schwächung des Materials.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen Durchzapfung und Stumpfzapfung?</p>
          <p>Bei der Durchzapfung geht der Zapfen vollständig durch das Gegenstück und ist von außen sichtbar (oft mit Holzkeil gesichert). Bei der Stumpfzapfung geht er nur teilweise hinein und ist unsichtbar – besser für sichtbare Oberflächen.</p>
        </div>
        <div>
          <p class="font-semibold">Wie viel Spielraum braucht ein Zapfen?</p>
          <p>Für eine Leimverbindung: 0,1-0,3 mm Spiel, damit der Leim ausreichend Raum hat. Für eine trockene Steckverbindung: 0,5-1 mm. Zu stramm splittert das Holz beim Einschlagen, zu lose gibt keine Stabilität.</p>
        </div>
        <div>
          <p class="font-semibold">Welches Werkzeug benötigt man für Zapfenverbindungen?</p>
          <p>Traditionell: Stechbeitel, Holzhammer, Feinsäge, Anreißmesser. Modern: Oberfräse mit Zapfenfrässchablone, Tischfräse oder Zapfenschneider. Die Schlitzfräsung mit der Oberfräse ergibt sauberere Ergebnisse als mit dem Stechbeitel.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcZv() {
      const width = parseFloat((document.getElementById('zv-width') as HTMLInputElement).value) || 60;
      const thick = parseFloat((document.getElementById('zv-thick') as HTMLInputElement).value) || 30;
      const totalLen = parseFloat((document.getElementById('zv-total-len') as HTMLInputElement).value) || 400;
      const tenonLen = parseFloat((document.getElementById('zv-tenon-len') as HTMLInputElement).value) || 40;
      const tenonPct = parseFloat((document.getElementById('zv-tenon-pct') as HTMLInputElement).value) || 33;
      const shoulderPct = parseFloat((document.getElementById('zv-shoulder-pct') as HTMLInputElement).value) || 15;
      const clearance = parseFloat((document.getElementById('zv-clearance') as HTMLInputElement).value) || 0.2;

      const fmt1 = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      const fmt0 = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });

      const tenonThick = thick * tenonPct / 100;
      const shoulderHeight = width * shoulderPct / 100;
      const tenonWidth = width - 2 * shoulderHeight;
      const mortiseThick = tenonThick + clearance;
      const mortiseWidth = tenonWidth + clearance;
      const mortiseDepth = tenonLen + 2; // 2mm Spielraum
      const mortiseEdgeDist = shoulderHeight;

      const netLen = totalLen - 2 * tenonLen;

      const steps: string[] = [];
      steps.push(`Zapfendicke = ${fmt0(thick)} mm × ${tenonPct}% = ${fmt1(tenonThick)} mm`);
      steps.push(`Schulter = ${fmt0(width)} mm × ${shoulderPct}% = ${fmt1(shoulderHeight)} mm (beidseitig)`);
      steps.push(`Zapfenbreite = ${fmt0(width)} - 2×${fmt1(shoulderHeight)} = ${fmt1(tenonWidth)} mm`);
      steps.push(`Schlitzdicke = ${fmt1(tenonThick)} + ${clearance} mm Spiel = ${fmt1(mortiseThick)} mm`);
      steps.push(`Nutzlänge = ${fmt0(totalLen)} - 2×${fmt0(tenonLen)} = ${fmt0(netLen)} mm`);

      document.getElementById('zv-result')!.textContent = fmt1(tenonThick) + ' mm';
      document.getElementById('zv-tl')!.textContent = fmt0(tenonLen) + ' mm';
      document.getElementById('zv-tw')!.textContent = fmt1(tenonWidth) + ' mm';
      document.getElementById('zv-tt')!.textContent = fmt1(tenonThick) + ' mm';
      document.getElementById('zv-ts')!.textContent = fmt1(shoulderHeight) + ' mm';
      document.getElementById('zv-md')!.textContent = fmt0(mortiseDepth) + ' mm';
      document.getElementById('zv-mw')!.textContent = fmt1(mortiseWidth) + ' mm';
      document.getElementById('zv-mt')!.textContent = fmt1(mortiseThick) + ' mm';
      document.getElementById('zv-me')!.textContent = fmt1(mortiseEdgeDist) + ' mm';
      document.getElementById('zv-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.zv-in').forEach(el => {
        el.addEventListener('input', calcZv);
        el.addEventListener('change', calcZv);
      });
      calcZv();
    }, 50);
  </script>
</CalculatorLayout>
