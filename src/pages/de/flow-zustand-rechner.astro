---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Flow-Zustand-Rechner - Herausforderung/F&auml;higkeit-Balance";
const description = "Bewerten Sie Ihre Bedingungen f&uuml;r den Flow-Zustand. Evaluieren Sie Herausforderung/F&auml;higkeit-Balance, Flow-Kanal-Position und gesch&auml;tzte Flow-Zeit.";
const relatedCalcs = [
  { name: "Produktivit&auml;t", url: "/de/produktivitaet-rechner", description: "Produktivit&auml;tsmetriken." },
  { name: "Pomodoro", url: "/de/pomodoro-rechner", description: "Pomodoro-Timer." },
  { name: "Lernzeit", url: "/de/lernzeit-rechner", description: "Lernplanung." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Flow-Zustand-Rechner" lang="de" enSlug="flow-state-calculator" keywords="Flow Zustand, Flow Erlebnis, Csikszentmihalyi, Herausforderung F&auml;higkeit, Deep Work, Fokus, optimale Erfahrung" breadcrumbs={[{ name: "Flow-Zustand", url: "/de/flow-zustand-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Flow-Zustand-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie Ihre Bedingungen f&uuml;r Flow (Csikszentmihalyis Theorie der optimalen Erfahrung).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Herausforderungsniveau (1-10)</label>
          <input type="range" id="flz-challenge" class="flz-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Sehr einfach (1)</span><span>Extrem schwer (10)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ihr F&auml;higkeitslevel (1-10)</label>
          <input type="range" id="flz-skill" class="flz-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Anf&auml;nger (1)</span><span>Experte (10)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Klare Ziele f&uuml;r die Aufgabe?</label>
          <select id="flz-goals" class="flz-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="3">Ja, sehr klar</option>
            <option value="2">Einigerma&szlig;en klar</option>
            <option value="1">Vage</option>
            <option value="0">Keine klaren Ziele</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Sofortiges Feedback verf&uuml;gbar?</label>
          <select id="flz-feedback" class="flz-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="3">Ja, sofortiges Feedback</option>
            <option value="2">Etwas Feedback</option>
            <option value="1">Verz&ouml;gertes Feedback</option>
            <option value="0">Kein Feedback</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ablenkungsniveau (1-10)</label>
          <input type="range" id="flz-distract" class="flz-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Keine (1)</span><span>St&auml;ndig (10)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Intrinsische Motivation (1-10)</label>
          <input type="range" id="flz-motiv" class="flz-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Pflicht (1)</span><span>Tief motiviert (10)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Verf&uuml;gbare ununterbrochene Zeit (Minuten)</label>
          <input type="number" id="flz-time" class="flz-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="5" max="480" step="5">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Flow-Zustand-Bewertung</div>
          <div class="text-2xl font-extrabold mt-1" id="flz-state">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary">Flow-Kanal-Position</div><div class="text-xl font-bold text-text mt-1" id="flz-channel">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary">Gesch. Zeit im Flow</div><div class="text-xl font-bold text-text mt-1" id="flz-flowtime">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-secondary">Flow-Bereitschaftswert</div>
          <div class="text-xl font-bold text-text mt-1" id="flz-ready">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Flow-Bedingungen Checkliste</div>
          <div class="text-sm text-text" id="flz-check">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Anpassungen f&uuml;r Flow</div>
          <div class="text-sm text-text" id="flz-adjust">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="flow-state" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Was ist der Flow-Zustand?</strong> Flow ist ein Zustand v&ouml;lliger Vertiefung in eine T&auml;tigkeit, beschrieben von Csikszentmihalyi als optimale Erfahrung.</p>
      <p><strong>Wie erreicht man Flow?</strong> Herausforderung und F&auml;higkeit m&uuml;ssen beide hoch und ausgeglichen sein, mit klaren Zielen und sofortigem Feedback.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFLZ() {
      const challenge = parseInt((document.getElementById('flz-challenge') as HTMLInputElement).value) || 5;
      const skill = parseInt((document.getElementById('flz-skill') as HTMLInputElement).value) || 5;
      const goals = parseInt((document.getElementById('flz-goals') as HTMLSelectElement).value) || 2;
      const feedback = parseInt((document.getElementById('flz-feedback') as HTMLSelectElement).value) || 2;
      const distract = parseInt((document.getElementById('flz-distract') as HTMLInputElement).value) || 3;
      const motiv = parseInt((document.getElementById('flz-motiv') as HTMLInputElement).value) || 5;
      const availTime = parseInt((document.getElementById('flz-time') as HTMLInputElement).value) || 60;
      const diff = challenge - skill;
      let channel = 'Flow';
      if (challenge < 4 && skill < 4) channel = 'Apathie';
      else if (diff > 2) channel = '\u00dcberforderung';
      else if (diff > 1) channel = 'Erregung (nahe Flow)';
      else if (diff < -2) channel = 'Langeweile';
      else if (diff < -1) channel = 'Entspannung';
      else if (challenge >= 5 && skill >= 5) channel = 'Flow';
      else channel = 'Kontrolle';
      const balanceScore = Math.max(0, 10 - Math.abs(diff) * 2.5) * 10;
      const conditionScore = (goals + feedback) / 6 * 100;
      const envScore = (10 - distract) / 9 * 100;
      const motivScore = motiv / 10 * 100;
      const readiness = Math.round((balanceScore * 0.35 + conditionScore * 0.2 + envScore * 0.2 + motivScore * 0.25));
      let stateLabel = '';
      if (readiness >= 75 && channel === 'Flow') stateLabel = 'Ausgezeichnete Flow-Bedingungen';
      else if (readiness >= 60) stateLabel = 'Gut - Flow m\u00f6glich';
      else if (readiness >= 40) stateLabel = 'M\u00e4\u00dfig - Anpassungen n\u00f6tig';
      else stateLabel = 'Schlecht - Flow unwahrscheinlich';
      let flowMin = 0;
      if (readiness >= 60) {
        const rampUp = 15;
        flowMin = Math.max(0, Math.min(availTime - rampUp, (readiness / 100) * (availTime - rampUp)));
      }
      document.getElementById('flz-state')!.textContent = stateLabel;
      document.getElementById('flz-channel')!.textContent = channel;
      document.getElementById('flz-flowtime')!.textContent = flowMin > 0 ? Math.round(flowMin) + ' min' : 'Derzeit unwahrsch.';
      document.getElementById('flz-ready')!.textContent = readiness + ' / 100';
      const checks: string[] = [];
      checks.push((Math.abs(diff) <= 1 && challenge >= 5) ? 'Herausforderung/F\u00e4higkeit: GUT' : 'Herausforderung/F\u00e4higkeit: ANPASSUNG N\u00d6TIG');
      checks.push(goals >= 2 ? 'Klare Ziele: JA' : 'Klare Ziele: NEIN');
      checks.push(feedback >= 2 ? 'Sofortiges Feedback: JA' : 'Sofortiges Feedback: SCHWACH');
      checks.push(distract <= 3 ? 'Wenig Ablenkung: JA' : 'Wenig Ablenkung: NEIN');
      checks.push(motiv >= 6 ? 'Intrinsische Motivation: HOCH' : 'Intrinsische Motivation: NIEDRIG');
      checks.push(availTime >= 45 ? 'Ausreichend Zeit (45+ min): JA' : 'Ausreichend Zeit: NEIN (45+ min n\u00f6tig)');
      document.getElementById('flz-check')!.innerHTML = checks.map(c => '<div>' + c + '</div>').join('');
      const adj: string[] = [];
      if (diff > 1) adj.push('Herausforderung \u00fcbersteigt F\u00e4higkeit. Aufgabe in kleinere Teilaufgaben zerlegen.');
      if (diff < -1) adj.push('Aufgabe zu einfach. Schwierigkeitsgrad erh\u00f6hen oder schnelleres Tempo setzen.');
      if (goals < 2) adj.push('Definieren Sie spezifische, messbare Ziele vor Beginn.');
      if (feedback < 2) adj.push('Feedback-Mechanismen einrichten: Tests, Metriken oder Peer-Review nutzen.');
      if (distract > 5) adj.push('Ablenkungen reduzieren: Handy stumm, E-Mail schlie\u00dfen, ruhigen Ort suchen.');
      if (motiv < 5) adj.push('Motivation steigern: Aufgabe mit pers\u00f6nlicher Bedeutung verkn\u00fcpfen.');
      if (availTime < 45) adj.push('Mindestens 45-90 Minuten ununterbrochene Zeit einplanen.');
      if (adj.length === 0) adj.push('Bedingungen sehen hervorragend aus. Sofort beginnen und diese Zeit sch\u00fctzen.');
      document.getElementById('flz-adjust')!.textContent = adj.join(' ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('flz-challenge') as HTMLInputElement).value = '6';
      (document.getElementById('flz-skill') as HTMLInputElement).value = '6';
      (document.getElementById('flz-distract') as HTMLInputElement).value = '3';
      (document.getElementById('flz-motiv') as HTMLInputElement).value = '7';
      (document.getElementById('flz-time') as HTMLInputElement).value = '60';
      document.querySelectorAll('.flz-in').forEach(el => { el.addEventListener('input', calcFLZ); el.addEventListener('change', calcFLZ); });
      calcFLZ();
    }, 50);
  </script>
</CalculatorLayout>
