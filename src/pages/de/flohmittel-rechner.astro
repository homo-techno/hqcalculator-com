---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Flohmittel-Rechner - Zeitplan, Dosierung & Kosten";
const description = "Berechnen Sie Flohmittel-Zeitplan, Dosierung nach Gewicht, Gartenbehandlungsfl&auml;che und j&auml;hrliche Pr&auml;ventionskosten f&uuml;r Ihre Haustiere.";
const relatedCalcs = [
  { name: "Tiermedikation", url: "/de/tiermedikation-rechner", description: "Medikamentendosierung." },
  { name: "Hundefutter", url: "/de/hundefutter-rechner", description: "Futterportionen." },
  { name: "Tierversicherung", url: "/de/tierversicherung-rechner", description: "Versicherungspr&auml;mien." },
  { name: "Tierkosten", url: "/de/tierkosten-rechner", description: "J&auml;hrliche Tierkosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Flohmittel-Rechner" lang="de" enSlug="flea-treatment-calculator" keywords="Flohmittel Rechner, Flohbehandlung, Floh Dosierung, Gartenbehandlung, Flohkosten, Flohpr&auml;vention" breadcrumbs={[{ name: "Flohmittel-Rechner", url: "/de/flohmittel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Flohmittel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Flohmittel-Zeitplan, Dosierung, Gartenbehandlung und j&auml;hrliche Kosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tierart</label>
            <select id="fmr-type" class="fmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="dog" selected>Hund</option>
              <option value="cat">Katze</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label>
            <input type="number" id="fmr-weight" class="fmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="16" min="1" max="90" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Tiere</label>
            <input type="number" id="fmr-count" class="fmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="20" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Behandlungsart</label>
            <select id="fmr-treatment" class="fmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="topical" selected>Spot-on (monatlich)</option>
              <option value="oral">Tablette (monatlich)</option>
              <option value="collar">Flohhalsband (8 Monate)</option>
              <option value="oral3">Tablette (alle 3 Monate)</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gartenfl&auml;che (m&sup2;) - f&uuml;r Outdoor-Behandlung</label>
          <input type="number" id="fmr-yard" class="fmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="0" step="50">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gewichtskategorie / Dosierung</div>
          <div class="text-5xl font-extrabold font-mono" id="fmr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Behandlungen/Jahr</div><div class="text-xl font-bold font-mono" id="fmr-peryear">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Behandlung</div><div class="text-xl font-bold font-mono" id="fmr-pertx">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Kosten</div><div class="text-xl font-bold font-mono" id="fmr-annual">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">N&auml;chste Behandlung</div><div class="text-xl font-bold font-mono" id="fmr-next">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gartenspray (L)</div><div class="text-xl font-bold font-mono" id="fmr-spray">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Alle Tiere/Jahr</div><div class="text-xl font-bold font-mono" id="fmr-total">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="flea-treatment" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie oft sollte man gegen Fl&ouml;he behandeln?</strong> Spot-on und Tabletten werden monatlich angewendet, Halbb&auml;nder halten ca. 8 Monate.</p>
      <p><strong>Muss der Garten auch behandelt werden?</strong> Ja, bei starkem Befall sollte der Au&szlig;enbereich alle 2-3 Monate behandelt werden.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFMR() {
      const type = (document.getElementById('fmr-type') as HTMLSelectElement).value;
      const weight = parseFloat((document.getElementById('fmr-weight') as HTMLInputElement).value) || 0;
      const count = parseInt((document.getElementById('fmr-count') as HTMLInputElement).value) || 1;
      const treatment = (document.getElementById('fmr-treatment') as HTMLSelectElement).value;
      const yard = parseFloat((document.getElementById('fmr-yard') as HTMLInputElement).value) || 0;
      let category = '';
      if (type === 'dog') {
        if (weight <= 5) category = '2-5 kg';
        else if (weight <= 10) category = '5-10 kg';
        else if (weight <= 20) category = '10-20 kg';
        else if (weight <= 40) category = '20-40 kg';
        else category = '40-60 kg';
      } else {
        if (weight <= 2.5) category = '1-2,5 kg';
        else if (weight <= 4) category = '2,5-4 kg';
        else category = '4-8 kg';
      }
      const txData: Record<string, { perYear: number; cost: number; interval: string }> = {
        topical:  { perYear: 12, cost: type === 'dog' ? 15 : 12, interval: '30 Tage' },
        oral:     { perYear: 12, cost: type === 'dog' ? 20 : 16, interval: '30 Tage' },
        collar:   { perYear: 1.5, cost: type === 'dog' ? 45 : 38, interval: '8 Monate' },
        oral3:    { perYear: 4, cost: type === 'dog' ? 40 : 30, interval: '3 Monate' },
      };
      const data = txData[treatment] || txData['topical'];
      const annualPerPet = data.perYear * data.cost;
      const totalAnnual = annualPerPet * count;
      const sprayLiters = yard > 0 ? (yard / 100) : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      document.getElementById('fmr-result')!.textContent = category;
      document.getElementById('fmr-peryear')!.textContent = data.perYear.toString();
      document.getElementById('fmr-pertx')!.textContent = fmt(data.cost) + ' \u20AC';
      document.getElementById('fmr-annual')!.textContent = fmt(annualPerPet) + ' \u20AC';
      document.getElementById('fmr-next')!.textContent = data.interval;
      document.getElementById('fmr-spray')!.textContent = sprayLiters > 0 ? sprayLiters.toFixed(1).replace('.', ',') : 'k.A.';
      document.getElementById('fmr-total')!.textContent = fmt(totalAnnual) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fmr-in').forEach(el => { el.addEventListener('input', calcFMR); el.addEventListener('change', calcFMR); });
      calcFMR();
    }, 50);
  </script>
</CalculatorLayout>
