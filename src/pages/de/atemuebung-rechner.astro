---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Atem&uuml;bung-Rechner - Box-Atmung & 4-7-8";
const description = "Berechnen Sie die Dauer Ihrer Atem&uuml;bungssitzung f&uuml;r Box-Atmung, 4-7-8 und andere Muster. Zeigt Gesamtzeit, Atemz&uuml;ge pro Minute und Sitzungsdetails.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "T&auml;glicher Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen optimieren." },
  { name: "Herzfrequenz-Rechner", url: "/de/herzfrequenz-rechner", description: "Herzfrequenzzonen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Atem&uuml;bung-Rechner" lang="de" enSlug="breathing-exercise-calculator" keywords="atem&uuml;bung, box atmung, 4-7-8 atmung, achtsamkeit, atemarbeit" breadcrumbs={[{ name: "Atem&uuml;bung-Rechner", url: "/de/atemuebung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Atem&uuml;bung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Atem&uuml;bungssitzungen mit pr&auml;zisem Timing.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Atemmuster</label>
          <select id="bx2-pat" class="bx2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="4,4,4,4" selected>Box-Atmung (4-4-4-4)</option>
            <option value="4,7,8,0">4-7-8 Entspannungsatmung</option>
            <option value="4,0,6,0">Einfache Ruhe (4-0-6-0)</option>
            <option value="5,5,5,5">Erweiterte Box (5-5-5-5)</option>
            <option value="4,4,6,2">Navy SEAL (4-4-6-2)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div class="grid grid-cols-4 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Einatmen (s)</label><input type="number" id="bx2-in" class="bx2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Halten (s)</label><input type="number" id="bx2-hold1" class="bx2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ausatmen (s)</label><input type="number" id="bx2-out" class="bx2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Pause (s)</label><input type="number" id="bx2-hold2" class="bx2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="20" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Anzahl der Zyklen</label>
          <input type="number" id="bx2-cyc" class="bx2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="100" step="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Sitzungsdauer</div>
          <div class="text-5xl font-extrabold font-mono" id="bx2-total">0:00</div>
          <div class="text-sm text-blue-200 mt-1" id="bx2-secs">0 Sekunden</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Atemz&uuml;ge/Min</div><div class="text-xl font-bold" id="bx2-bpm">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zykluszeit</div><div class="text-xl font-bold" id="bx2-cycle">0s</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Atemz&uuml;ge</div><div class="text-xl font-bold" id="bx2-breaths">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Vorteile nach Muster</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Box-Atmung</span><span class="font-bold">Fokus & Ruhe</span></div>
            <div class="flex justify-between"><span>4-7-8</span><span class="font-bold">Schlaf & Entspannung</span></div>
            <div class="flex justify-between"><span>Einfache Ruhe</span><span class="font-bold">Schneller Stressabbau</span></div>
            <div class="flex justify-between"><span>Navy SEAL</span><span class="font-bold">Leistungsangst</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="breathing-exercise" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Atem&uuml;bungstechniken</h2>
      <p>Kontrolliertes Atmen aktiviert das parasympathische Nervensystem und reduziert Stress und Angst. Die Box-Atmung (von Navy SEALs verwendet) beinhaltet gleiche Phasen f&uuml;r Einatmen, Halten, Ausatmen und Pause. Die 4-7-8-Technik wurde von Dr. Andrew Weil f&uuml;r Entspannung und Schlaf popularisiert. Regelm&auml;&szlig;iges &Uuml;ben kann Herzfrequenz, Blutdruck und Cortisolspiegel senken.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function setPattern() {
      const val = (document.getElementById('bx2-pat') as HTMLSelectElement).value;
      if (val !== 'custom') {
        const p = val.split(',');
        (document.getElementById('bx2-in') as HTMLInputElement).value = p[0];
        (document.getElementById('bx2-hold1') as HTMLInputElement).value = p[1];
        (document.getElementById('bx2-out') as HTMLInputElement).value = p[2];
        (document.getElementById('bx2-hold2') as HTMLInputElement).value = p[3];
      }
      calcBreath();
    }
    function calcBreath() {
      const inhale = parseInt((document.getElementById('bx2-in') as HTMLInputElement).value) || 0;
      const hold1 = parseInt((document.getElementById('bx2-hold1') as HTMLInputElement).value) || 0;
      const exhale = parseInt((document.getElementById('bx2-out') as HTMLInputElement).value) || 0;
      const hold2 = parseInt((document.getElementById('bx2-hold2') as HTMLInputElement).value) || 0;
      const cycles = parseInt((document.getElementById('bx2-cyc') as HTMLInputElement).value) || 1;
      const cycleTime = inhale + hold1 + exhale + hold2;
      const totalSecs = cycleTime * cycles;
      const bpm = cycleTime > 0 ? (60 / cycleTime) : 0;
      const mins = Math.floor(totalSecs / 60);
      const secs = totalSecs % 60;
      document.getElementById('bx2-total')!.textContent = mins + ':' + String(secs).padStart(2, '0');
      document.getElementById('bx2-secs')!.textContent = totalSecs + ' Sekunden';
      document.getElementById('bx2-bpm')!.textContent = bpm.toFixed(1).replace('.', ',');
      document.getElementById('bx2-cycle')!.textContent = cycleTime + 's';
      document.getElementById('bx2-breaths')!.textContent = cycles.toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bx2-in') as HTMLInputElement).value = '4';
      (document.getElementById('bx2-hold1') as HTMLInputElement).value = '4';
      (document.getElementById('bx2-out') as HTMLInputElement).value = '4';
      (document.getElementById('bx2-hold2') as HTMLInputElement).value = '4';
      (document.getElementById('bx2-cyc') as HTMLInputElement).value = '10';
      document.getElementById('bx2-pat')!.addEventListener('change', setPattern);
      document.querySelectorAll('.bx2-in').forEach(el => { el.addEventListener('input', calcBreath); el.addEventListener('change', calcBreath); });
      calcBreath();
    }, 50);
  </script>
</CalculatorLayout>
