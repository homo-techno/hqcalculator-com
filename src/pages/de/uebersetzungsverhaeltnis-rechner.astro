---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "\u00DCbersetzungsverh\u00E4ltnis-Rechner - Drehzahl & Drehmoment";
const description = "Berechnen Sie \u00DCbersetzungsverh\u00E4ltnis, Abtriebsdrehzahl und Drehmoment f\u00FCr Zahnradgetriebe. Unterst\u00FCtzt Verbundgetriebe.";
const relatedCalcs = [
  { name: "Drehmoment-Rechner", url: "/de/drehmoment-rechner", description: "Drehmoment." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Kraft-Rechner", url: "/de/kraft-rechner", description: "Kraft." },
  { name: "Verh\u00E4ltnis-Rechner", url: "/de/verhaeltnis-rechner", description: "Verh\u00E4ltnisse." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="\u00DCbersetzungsverh\u00E4ltnis-Rechner" lang="de" enSlug="gear-ratio-calculator" keywords="\u00FCbersetzungsverh\u00E4ltnis rechner, getriebe, drehzahl, drehmomentverst\u00E4rkung, antriebsrad, abtriebsrad" breadcrumbs={[{ name: "\u00DCbersetzungsverh\u00E4ltnis", url: "/de/uebersetzungsverhaeltnis-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">&Uuml;bersetzungsverh&auml;ltnis-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie &Uuml;bersetzungsverh&auml;ltnis, Abtriebsdrehzahl und Drehmomentverst&auml;rkung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Antriebsrad (Z&auml;hne)</label><input type="number" id="uvr-drive" class="uvr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="20" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Abtriebsrad (Z&auml;hne)</label><input type="number" id="uvr-driven" class="uvr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="60" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eingangsdrehzahl (U/min)</label><input type="number" id="uvr-rpm" class="uvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Eingangsdrehmoment (N&middot;m)</label><input type="number" id="uvr-torque" class="uvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">&Uuml;bersetzungsverh&auml;ltnis</div>
          <div class="text-5xl font-extrabold font-mono" id="uvr-result">3:1</div>
          <div class="text-sm text-blue-200 mt-1" id="uvr-type">Drehzahluntersetzung / Drehmomentverst&auml;rkung</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abtriebsdrehzahl</div><div class="text-xl font-bold font-mono" id="uvr-out-rpm">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abtriebsdrehmoment</div><div class="text-xl font-bold font-mono" id="uvr-out-torque">0 N&middot;m</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verh&auml;ltnis (dezimal)</div><div class="text-xl font-bold font-mono" id="uvr-dec">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mechanischer Vorteil</div><div class="text-xl font-bold font-mono" id="uvr-ma">0&times;</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gear-ratio" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">&Uuml;bersetzungsverh&auml;ltnis erkl&auml;rt</h2>
      <p>Das &Uuml;bersetzungsverh&auml;ltnis bestimmt, wie Drehzahl und Drehmoment zwischen Antriebs- und Abtriebswelle &uuml;bertragen werden. Ein Verh&auml;ltnis &gt; 1 reduziert die Drehzahl und erh&ouml;ht das Drehmoment proportional.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist 1:1 &Uuml;bersetzung?</strong> Bei 1:1 drehen sich Antriebs- und Abtriebsrad mit gleicher Drehzahl (Direktantrieb).</p>
      <p><strong>Wie berechnet man das Drehmoment?</strong> Abtriebsdrehmoment = Eingangsdrehmoment &times; &Uuml;bersetzungsverh&auml;ltnis.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function gcdUVR(a: number, b: number): number { return b === 0 ? a : gcdUVR(b, a % b); }
    function calcUVR() {
      const drive = parseInt((document.getElementById('uvr-drive') as HTMLInputElement).value) || 1;
      const driven = parseInt((document.getElementById('uvr-driven') as HTMLInputElement).value) || 1;
      const rpm = parseFloat((document.getElementById('uvr-rpm') as HTMLInputElement).value) || 0;
      const torque = parseFloat((document.getElementById('uvr-torque') as HTMLInputElement).value) || 0;
      const ratio = driven / drive;
      const g = gcdUVR(driven, drive);
      const outRPM = ratio > 0 ? rpm / ratio : 0;
      const outTorque = torque * ratio;
      document.getElementById('uvr-result')!.textContent = (driven/g) + ':' + (drive/g);
      document.getElementById('uvr-dec')!.textContent = ratio.toFixed(4);
      document.getElementById('uvr-out-rpm')!.textContent = outRPM.toFixed(1);
      document.getElementById('uvr-out-torque')!.textContent = outTorque.toFixed(2) + ' N\u00B7m';
      document.getElementById('uvr-ma')!.textContent = ratio.toFixed(2) + '\u00D7';
      if (ratio > 1) document.getElementById('uvr-type')!.textContent = 'Drehzahluntersetzung / Drehmomentverst\u00E4rkung';
      else if (ratio < 1) document.getElementById('uvr-type')!.textContent = 'Drehzahlerh\u00F6hung / Drehmomentreduktion';
      else document.getElementById('uvr-type')!.textContent = '1:1 \u2014 Direktantrieb';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.uvr-in').forEach(el => { el.addEventListener('input', calcUVR); el.addEventListener('change', calcUVR); });
      calcUVR();
    }, 50);
  </script>
</CalculatorLayout>
