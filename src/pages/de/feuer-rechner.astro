---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "FIRE-Rechner - Finanzielle Unabhängigkeit, Frühzeitige Rente";
const description = "Berechnen Sie, wann Sie finanzielle Unabhängigkeit erreichen und frühzeitig in Rente gehen können. FIRE-Zahl, Sparquote und Zeitplan.";
const relatedCalcs = [
  { name: "Finanzielle Unabhängigkeit", url: "/de/finanzielle-unabhaengigkeit-rechner", description: "FIRE-Planung." },
  { name: "Mode-Aufschlag", url: "/de/mode-aufschlag-rechner", description: "Mode-Preiskalkulation." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
  { name: "Feuerstelle-Rechner", url: "/de/feuerstelle-rechner", description: "Feuerstellen-Material." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="FIRE-Rechner" lang="de" enSlug="fire-calculator" keywords="FIRE rechner, finanzielle unabhängigkeit, frühzeitig in rente, FIRE zahl, sparquote, frühruhestand" breadcrumbs={[{ name: "FIRE-Rechner", url: "/de/feuer-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">FIRE-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihre FIRE-Zahl und wie lange es bis zur finanziellen Unabh&auml;ngigkeit dauert.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div><label class="block text-sm font-medium text-text mb-1">J&auml;hrliches Nettoeinkommen (&euro;)</label><input type="number" id="frde-income" class="frde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="55000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Ausgaben (&euro;)</label><input type="number" id="frde-expenses" class="frde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="32000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Portfolio (&euro;)</label><input type="number" id="frde-portfolio" class="frde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="100000" min="0" step="10000"></div>
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Erwartete Rendite (%/Jahr)</label><input type="number" id="frde-return" class="frde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="7" min="0" max="15" step="0.5"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Entnahmerate (%)</label><input type="number" id="frde-swr" class="frde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="4" min="2" max="6" step="0.5"><p class="text-xs text-text-muted mt-1">Standard: 4% (Trinity-Studie)</p></div>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Alter</label><input type="number" id="frde-age" class="frde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="30" min="18" max="70" step="1"></div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">FIRE-Zahl</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="frde-number">0 &euro;</div>
            <div class="text-sm text-blue-200 mt-1">J&auml;hrliche Ausgaben &divide; Entnahmerate</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahre bis FIRE</div><div class="text-xl font-bold text-secondary" id="frde-years">0</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">FIRE-Alter</div><div class="text-xl font-bold" id="frde-fire-age">0</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sparquote</div><div class="text-xl font-bold" id="frde-savings-rate">0%</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Ersparnis</div><div class="text-xl font-bold" id="frde-annual-save">0 &euro;</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fortschritt</div><div class="text-xl font-bold" id="frde-progress">0%</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatseinkommen bei FIRE</div><div class="text-xl font-bold" id="frde-monthly">0 &euro;</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Wachstumsprojektion</h3>
            <div class="space-y-1 text-sm" id="frde-table"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="fire-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist FIRE?</h2>
      <p>FIRE (Financial Independence, Retire Early) bedeutet, gen&uuml;gend Investitionen anzusammeln, damit das passive Einkommen die Lebenshaltungskosten deckt. Ihre <strong>FIRE-Zahl</strong> = j&auml;hrliche Ausgaben &divide; sichere Entnahmerate (typischerweise 4%).</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Ist FIRE in Deutschland realistisch?</strong> Ja, aber beachten Sie die Kapitalertragsteuer und passen Sie die Entnahmerate entsprechend an.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcFRDE() {
      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      const income = parseFloat((document.getElementById('frde-income') as HTMLInputElement).value) || 0;
      const expenses = parseFloat((document.getElementById('frde-expenses') as HTMLInputElement).value) || 0;
      const portfolio = parseFloat((document.getElementById('frde-portfolio') as HTMLInputElement).value) || 0;
      const returnRate = (parseFloat((document.getElementById('frde-return') as HTMLInputElement).value) || 0) / 100;
      const swr = (parseFloat((document.getElementById('frde-swr') as HTMLInputElement).value) || 4) / 100;
      const age = parseInt((document.getElementById('frde-age') as HTMLInputElement).value) || 30;
      const fireNumber = expenses / swr;
      const annualSavings = income - expenses;
      const savingsRate = income > 0 ? (annualSavings / income) * 100 : 0;
      const progress = fireNumber > 0 ? (portfolio / fireNumber) * 100 : 0;
      let bal = portfolio;
      let yearsToFire = 0;
      const rows: string[] = [];
      rows.push('<div class="grid grid-cols-3 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Jahr</span><span>Alter</span><span>Portfolio</span></div>');
      if (annualSavings > 0) {
        for (let y = 0; y <= 50; y++) {
          if (y <= 5 || y % 5 === 0 || bal >= fireNumber) {
            const isFire = bal >= fireNumber && (y === 0 || (bal - annualSavings) * (1 + returnRate) < fireNumber);
            rows.push('<div class="grid grid-cols-3 gap-1 text-xs ' + (isFire ? 'font-bold text-primary bg-blue-50 rounded p-1' : '') + '"><span>' + y + '</span><span>' + (age + y) + '</span><span>' + fmtEur(bal) + '</span></div>');
          }
          if (bal >= fireNumber) { yearsToFire = y; break; }
          bal = (bal + annualSavings) * (1 + returnRate);
          yearsToFire = y + 1;
        }
      } else {
        yearsToFire = portfolio >= fireNumber ? 0 : -1;
      }
      document.getElementById('frde-number')!.textContent = fmtEur(fireNumber);
      document.getElementById('frde-years')!.textContent = yearsToFire < 0 ? 'N/A' : yearsToFire.toString();
      document.getElementById('frde-fire-age')!.textContent = yearsToFire < 0 ? 'N/A' : String(age + yearsToFire);
      document.getElementById('frde-savings-rate')!.textContent = savingsRate.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      document.getElementById('frde-annual-save')!.textContent = fmtEur(annualSavings);
      document.getElementById('frde-progress')!.textContent = Math.min(100, progress).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      document.getElementById('frde-monthly')!.textContent = fmtEur(expenses / 12);
      document.getElementById('frde-table')!.innerHTML = rows.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['frde-income', 'frde-expenses', 'frde-portfolio', 'frde-return', 'frde-swr', 'frde-age'].forEach(id =>
        document.getElementById(id)!.addEventListener('input', calcFRDE));
      calcFRDE();
    }, 50);
  </script>
</CalculatorLayout>
