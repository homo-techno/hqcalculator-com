---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hausverkabelung Rechner - Kabelmenge & Materialkosten 2026";
const description = "Berechne den Kabelbedarf nach Raumtyp, benoetigte Kabelrollen, Kanalfuehrung und Materialkosten fuer dein Elektroinstallationsprojekt.";

const relatedCalcs = [
  { name: "Stromkostenrechner", url: "/de/stromkostenrechner", description: "Energiekosten berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hausverkabelung-Rechner" keywords="Hausverkabelung Rechner, Elektroinstallation, Kabelmenge, Elektrokosten, Kabeltypen, Installationsrechner" breadcrumbs={[{ name: "Hausverkabelung-Rechner", url: "/de/hausverkabelung-rechner" }]} lang="de" enSlug="home-wiring-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hausverkabelung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetze Kabelmengen, Kanalfuehrung und Materialkosten fuer Wohngebaeude-Elektroinstallationen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Raumanzahl</h3>
          <div class="grid grid-cols-2 gap-2">
            <div><label class="block text-xs text-text-muted">Schlafzimmer</label><input type="number" id="hvk-bed" class="hvk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="3" min="0"></div>
            <div><label class="block text-xs text-text-muted">Baederzimmer</label><input type="number" id="hvk-bath" class="hvk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="2" min="0"></div>
            <div><label class="block text-xs text-text-muted">Kueche</label><input type="number" id="hvk-kit" class="hvk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" min="0"></div>
            <div><label class="block text-xs text-text-muted">Wohn-/Esszimmer</label><input type="number" id="hvk-living" class="hvk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="2" min="0"></div>
            <div><label class="block text-xs text-text-muted">Garage</label><input type="number" id="hvk-garage" class="hvk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" min="0"></div>
            <div><label class="block text-xs text-text-muted">Keller/Technik</label><input type="number" id="hvk-base" class="hvk-in w-full px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" min="0"></div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Durchschn. Verlegelaenge (m)</label>
            <input type="number" id="hvk-run" class="hvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="3" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kabelpreis (€/m NYM-J 3x1,5)</label>
            <input type="number" id="hvk-price" class="hvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.90" min="0.1" step="0.05">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Kabelbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="hvk-result">0 m</div>
          <div class="text-sm text-blue-200 mt-1" id="hvk-note">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stromkreise gesamt</div><div class="text-xl font-bold font-mono" id="hvk-circuits">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kabelringe (100m)</div><div class="text-xl font-bold font-mono" id="hvk-rolls">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten ca.</div><div class="text-xl font-bold font-mono" id="hvk-cost">0 €</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Aufschluesselung nach Kabeltyp</h3>
          <div class="text-xs space-y-1" id="hvk-breakdown"></div>
        </div>
      </div>

      <ShareButton calculatorId="home-wiring" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Hausverkabelung planen</h2>
      <p>Eine sorgfaeltige Kabelmengenplanung spart Zeit und Geld. In Deutschland gelten fuer Elektroinstallationen die DIN VDE-Normen. Jeder Stromkreis muss korrekt ausgelegt und gesichert werden.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Welche Kabeltypen brauche ich?</strong> Fuer Allgemeinstromkreise NYM-J 3x1,5 mm², fuer Kueche und Bad NYM-J 3x2,5 mm². Fuer grosse Geraete wie Herd oder Waschmaschine sind staerkere Kabel erforderlich.</p>
      <p><strong>Wie viel Verschnitt sollte ich einplanen?</strong> Als Sicherheitspuffer sollten 10-15 % zusaetzliche Laenge eingeplant werden, um Maßabweichungen und Verbindungsstellen zu beruecksichtigen.</p>
      <p><strong>Muss ein Elektriker die Arbeiten ausfuehren?</strong> In Deutschland duerfen Elektroarbeiten nur von zugelassenen Fachbetrieben ausgefuehrt werden. Die Ausnahme ist die Eigenleistung unter Aufsicht eines Elektrikers.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHVK() {
      const beds = parseInt((document.getElementById('hvk-bed') as HTMLInputElement).value) || 0;
      const baths = parseInt((document.getElementById('hvk-bath') as HTMLInputElement).value) || 0;
      const kit = parseInt((document.getElementById('hvk-kit') as HTMLInputElement).value) || 0;
      const living = parseInt((document.getElementById('hvk-living') as HTMLInputElement).value) || 0;
      const garage = parseInt((document.getElementById('hvk-garage') as HTMLInputElement).value) || 0;
      const base = parseInt((document.getElementById('hvk-base') as HTMLInputElement).value) || 0;
      const avgRun = parseFloat((document.getElementById('hvk-run') as HTMLInputElement).value) || 12;
      const pricePerM = parseFloat((document.getElementById('hvk-price') as HTMLInputElement).value) || 0.90;

      const wire15_circuits = beds * 2 + living * 3 + base * 2;
      const wire25_circuits = baths * 2 + kit * 5 + garage * 2 + base * 1;
      const wire40_circuits = kit > 0 ? 1 : 0;
      const wire60_circuits = kit > 0 ? 1 : 0;

      const totalCircuits = wire15_circuits + wire25_circuits + wire40_circuits + wire60_circuits;
      const waste = 1.15;
      const m15 = Math.ceil(wire15_circuits * avgRun * waste);
      const m25 = Math.ceil(wire25_circuits * avgRun * waste);
      const m40 = Math.ceil(wire40_circuits * avgRun * 1.5 * waste);
      const m60 = Math.ceil(wire60_circuits * avgRun * 1.5 * waste);
      const totalM = m15 + m25 + m40 + m60;

      const cost15 = m15 * pricePerM;
      const cost25 = m25 * pricePerM * 1.4;
      const cost40 = m40 * pricePerM * 2.5;
      const cost60 = m60 * pricePerM * 4.5;
      const totalCost = cost15 + cost25 + cost40 + cost60;

      const rolls100 = Math.ceil(totalM / 100);

      document.getElementById('hvk-result')!.textContent = totalM.toLocaleString('de-DE') + ' m';
      document.getElementById('hvk-note')!.textContent = totalCircuits + ' Stromkreise mit 15% Verschnitt';
      document.getElementById('hvk-circuits')!.textContent = totalCircuits.toString();
      document.getElementById('hvk-rolls')!.textContent = rolls100.toString();
      document.getElementById('hvk-cost')!.textContent = totalCost.toFixed(0) + ' €';

      let breakdown = '';
      if (m15 > 0) breakdown += '<div class="flex justify-between"><span>NYM-J 3x1,5 mm² (Allgemein/Licht) - ' + wire15_circuits + ' Kreise</span><span>' + m15.toLocaleString('de-DE') + ' m (' + cost15.toFixed(0) + ' €)</span></div>';
      if (m25 > 0) breakdown += '<div class="flex justify-between"><span>NYM-J 3x2,5 mm² (Bad/Kueche/FI) - ' + wire25_circuits + ' Kreise</span><span>' + m25.toLocaleString('de-DE') + ' m (' + cost25.toFixed(0) + ' €)</span></div>';
      if (m40 > 0) breakdown += '<div class="flex justify-between"><span>NYM-J 5x4 mm² (Herd) - ' + wire40_circuits + ' Kreis</span><span>' + m40.toLocaleString('de-DE') + ' m (' + cost40.toFixed(0) + ' €)</span></div>';
      if (m60 > 0) breakdown += '<div class="flex justify-between"><span>NYM-J 5x6 mm² (Trockner/Sonderbedarf) - ' + wire60_circuits + ' Kreis</span><span>' + m60.toLocaleString('de-DE') + ' m (' + cost60.toFixed(0) + ' €)</span></div>';
      document.getElementById('hvk-breakdown')!.innerHTML = breakdown;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hvk-in').forEach(el => {
        el.addEventListener('input', calcHVK);
        el.addEventListener('change', calcHVK);
      });
      calcHVK();
    }, 50);
  </script>
</CalculatorLayout>
