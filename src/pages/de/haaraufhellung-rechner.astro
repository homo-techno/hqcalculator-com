---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Haaraufhellung-Rechner - Bleichmischung &amp; Einwirkzeit";
const description = "Berechnen Sie Bleichmischungsverh&auml;ltnisse, Entwicklervolumen und Einwirkzeit f&uuml;r Ihre Zielaufhellung. Inklusive Sch&auml;denbeurteilung und T&ouml;ner-Empfehlung.";
const relatedCalcs = [
  { name: "Haarentwickler-Rechner", url: "/de/haarentwickler-rechner", description: "Entwickler ausw&auml;hlen." },
  { name: "Haarfarbe-Mischen-Rechner", url: "/de/haarfarbe-mischen-rechner", description: "Haarfarbe mischen." },
  { name: "Haarporosit&auml;t-Rechner", url: "/de/haarporositaet-rechner", description: "Porosit&auml;tsbeurteilung." },
  { name: "Haarwachstum-Rechner", url: "/de/haarwachstum-rechner", description: "Wachstumsprognose." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Haaraufhellung-Rechner" lang="de" enSlug="hair-lightening-calculator" keywords="haaraufhellung rechner, bleichmischung, entwicklervolumen, aufhellungsstufen, bleichen haare, einwirkzeit" breadcrumbs={[{ name: "Haaraufhellung-Rechner", url: "/de/haaraufhellung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Haaraufhellung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Bleichmischungsverh&auml;ltnis und Einwirkzeit f&uuml;r Ihre Zielaufhellungsstufe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktueller Farbton (Stufe)</label>
            <select id="hlt-current" class="hlt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1">1 &ndash; Schwarz</option>
              <option value="2">2 &ndash; Dunkelbraun</option>
              <option value="3">3 &ndash; Braun</option>
              <option value="4" selected>4 &ndash; Mittelbraun</option>
              <option value="5">5 &ndash; Hellbraun</option>
              <option value="6">6 &ndash; Dunkelblond</option>
              <option value="7">7 &ndash; Mittelblond</option>
              <option value="8">8 &ndash; Hellblond</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zielfarbton (Stufe)</label>
            <select id="hlt-target" class="hlt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="6">6 &ndash; Dunkelblond</option>
              <option value="7">7 &ndash; Mittelblond</option>
              <option value="8" selected>8 &ndash; Hellblond</option>
              <option value="9">9 &ndash; Sehr hellblond</option>
              <option value="10">10 &ndash; Aufgehelltes Blond / Platin</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Bleichmitteltyp</label>
          <select id="hlt-bleach" class="hlt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="powder" selected>Pulveraufheller (Standard)</option>
            <option value="clay">Tonaufheller (schonend)</option>
            <option value="oil">Ölaufheller (pflegend)</option>
            <option value="cream">Cremeheller (Balayfage)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Haarzustand</label>
          <select id="hlt-condition" class="hlt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="virgin">Unbehandelt (noch nie gef&auml;rbt)</option>
            <option value="healthy" selected>Gesund (minimale Sch&auml;den)</option>
            <option value="colored">Bereits gef&auml;rbt</option>
            <option value="damaged">Bereits gebleicht / gesch&auml;digt</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bleichmittelmenge (g)</label><input type="number" id="hlt-amount" class="hlt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="10" max="200" step="5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kopfhautempfindlichkeit</label>
            <select id="hlt-scalp" class="hlt-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="low">Gering</option>
              <option value="normal" selected>Normal</option>
              <option value="high">Hoch</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Entwickler</div>
          <div class="text-5xl font-extrabold font-mono" id="hlt-developer">--</div>
          <div class="text-sm text-blue-200 mt-1" id="hlt-ratio">Mischungsverh&auml;ltnis: --</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bleichmittelmenge</div><div class="text-xl font-bold" id="hlt-powder">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Entwicklermenge</div><div class="text-xl font-bold" id="hlt-devamt">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einwirkzeit</div><div class="text-xl font-bold" id="hlt-time">-- min</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufhellungsstufen</div><div class="text-xl font-bold" id="hlt-lift">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sch&auml;digendes Risiko</div><div class="text-xl font-bold" id="hlt-risk">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Unterliegendes Pigment</div><div class="text-xl font-bold" id="hlt-pigment">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">T&ouml;ner-Empfehlung</h3>
          <div class="text-sm space-y-1" id="hlt-toner"></div>
        </div>
      </div>
      <ShareButton calculatorId="hair-lightening-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haaraufhellung &ndash; Leitfaden</h2>
      <p>Haaraufhellung entfernt das nat&uuml;rliche Melaninpigment. Das Standard-Mischungsverh&auml;ltnis f&uuml;r Pulveraufheller betr&auml;gt 1:2 (Bleichmittel zu Entwickler). Entwickler 20 Vol. f&uuml;r 1&ndash;2 Stufen, 30 Vol. f&uuml;r 2&ndash;3 Stufen, 40 Vol. f&uuml;r 3&ndash;4 Stufen. Die maximale Einwirkzeit betr&auml;gt 45 Minuten. Jede Haarfarbstufe zeigt unterliegende Pigmente (Rot, Orange, Gelb), die nach dem Bleichen get&ouml;nt werden sollten. Immer einen Str&auml;hnchen-Test vorher durchf&uuml;hren.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welchen Entwickler brauche ich?</strong> Das h&auml;ngt von der Anzahl der Aufhellungsstufen ab. 20 Vol. f&uuml;r 1&ndash;2 Stufen, 30 Vol. f&uuml;r 2&ndash;3, 40 Vol. f&uuml;r 3&ndash;4 Stufen.</p>
      <p><strong>Wie lange darf die Einwirkzeit sein?</strong> Nie l&auml;nger als 45 Minuten. Bei gesch&auml;digtem Haar maximal 25 Minuten und alle 5 Minuten kontrollieren.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHLT() {
      const current = parseInt((document.getElementById('hlt-current') as HTMLSelectElement).value);
      const target = parseInt((document.getElementById('hlt-target') as HTMLSelectElement).value);
      const bleachType = (document.getElementById('hlt-bleach') as HTMLSelectElement).value;
      const condition = (document.getElementById('hlt-condition') as HTMLSelectElement).value;
      const amount = parseFloat((document.getElementById('hlt-amount') as HTMLInputElement).value) || 30;
      const scalp = (document.getElementById('hlt-scalp') as HTMLSelectElement).value;

      const lift = Math.max(0, target - current);

      let devVol = '20 Vol.';
      let devRatio = 2;
      if (lift <= 2) { devVol = '20 Vol.'; devRatio = 2; }
      else if (lift <= 4) { devVol = '30 Vol.'; devRatio = 2; }
      else { devVol = '40 Vol.'; devRatio = 2; }

      if (bleachType === 'clay' || bleachType === 'oil') {
        if (devVol === '40 Vol.') devVol = '30 Vol.';
        devRatio = bleachType === 'oil' ? 1.5 : 2;
      }
      if (bleachType === 'cream') devRatio = 1;

      if (condition === 'damaged') {
        if (devVol === '40 Vol.') devVol = '30 Vol.';
        else if (devVol === '30 Vol.') devVol = '20 Vol.';
      }

      const devAmount = amount * devRatio;

      let processTime = '25-35';
      if (lift <= 2) processTime = '20-30';
      else if (lift <= 4) processTime = '30-40';
      else processTime = '35-45';

      if (condition === 'damaged') processTime = 'Max. 25';
      if (scalp === 'high') processTime += ' (alle 5 Min. pr&uuml;fen)';

      let risk = 'Mittel';
      if (lift <= 2 && condition === 'virgin') risk = 'Gering';
      else if (lift <= 2) risk = 'Gering-Mittel';
      else if (lift <= 4) risk = 'Mittel';
      else risk = 'Hoch';
      if (condition === 'damaged') risk = 'Sehr hoch';

      const pigments: Record<number, string> = {
        1: 'Rot', 2: 'Rot', 3: 'Rotoran', 4: 'Orange',
        5: 'Orangegelb', 6: 'Gelboran', 7: 'Gelb',
        8: 'Blassgelb', 9: 'Sehr blassgelb', 10: 'Hellstes Blassgelb'
      };
      const underlyingPigment = pigments[target] || 'Gelb';

      const toner: string[] = [];
      if (target >= 9) {
        toner.push('Violettbasierter T&ouml;ner zum Neutralisieren von Blassgelb.');
        toner.push('Empfohlen: Stufe 10 Asch- oder Perlt&ouml;ner mit 10 Vol. Entwickler.');
      } else if (target >= 7) {
        toner.push('Violett-/Blaut&ouml;ner zum Neutralisieren von Gelb/Gold.');
        toner.push('Empfohlen: Aschblondt&ouml;ner oder Lila-Shampoo zur Pflege.');
      } else if (target >= 5) {
        toner.push('Blau-/Gr&uuml;nt&ouml;ner zum Neutralisieren von Orange/Kupfer.');
        toner.push('Empfohlen: Asch oder k&uuml;hle Demi-Permanent-Farbe.');
      }
      toner.push('24&ndash;48 Stunden nach dem Bleichen mit dem T&ouml;nen warten, wenn das Haar beansprucht wirkt.');

      document.getElementById('hlt-developer')!.textContent = devVol;
      document.getElementById('hlt-ratio')!.textContent = 'Mischungsverh\u00E4ltnis: 1:' + devRatio;
      document.getElementById('hlt-powder')!.textContent = amount.toLocaleString('de-DE') + ' g';
      document.getElementById('hlt-devamt')!.textContent = Math.round(devAmount).toLocaleString('de-DE') + ' g';
      document.getElementById('hlt-time')!.textContent = processTime + ' min';
      document.getElementById('hlt-lift')!.textContent = lift.toLocaleString('de-DE');
      document.getElementById('hlt-risk')!.textContent = risk;
      document.getElementById('hlt-pigment')!.textContent = underlyingPigment;
      document.getElementById('hlt-toner')!.innerHTML = toner.map(t => '<p>' + t + '</p>').join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hlt-in').forEach(el => { el.addEventListener('input', calcHLT); el.addEventListener('change', calcHLT); });
      calcHLT();
    }, 50);
  </script>
</CalculatorLayout>
