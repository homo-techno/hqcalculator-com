---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fibonacci-Rechner - Folge, n-ter Term & Goldener Schnitt";
const description = "Generieren Sie Fibonacci-Zahlen, finden Sie den n-ten Term, prüfen Sie ob eine Zahl eine Fibonacci-Zahl ist, und erkunden Sie den Goldenen Schnitt.";
const relatedCalcs = [
  { name: "Gesichtsproportion", url: "/de/gesichtsproportion-rechner", description: "Goldener Schnitt im Gesicht." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
  { name: "Glasfaser-Dämpfung", url: "/de/glasfaser-daempfung-rechner", description: "Optische Verluste." },
  { name: "Finanzielle Unabhängigkeit", url: "/de/finanzielle-unabhaengigkeit-rechner", description: "FIRE-Planung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fibonacci-Rechner" lang="de" enSlug="fibonacci-calculator" keywords="fibonacci rechner, fibonacci folge, goldener schnitt, n-ter fibonacci, fibonacci zahl" breadcrumbs={[{ name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fibonacci-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Generieren Sie Fibonacci-Zahlen und erkunden Sie den Goldenen Schnitt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="fibde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-mode="nth">N-ten Term finden</button>
          <button class="fibde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="seq">Folge</button>
          <button class="fibde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="check">Zahl pr&uuml;fen</button>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1" id="fibde-label">Position (n)</label><input type="number" id="fibde-input" class="fibde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="10" min="0" max="78" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="fibde-result-label">F(10)</div>
          <div class="text-5xl font-extrabold font-mono" id="fibde-result">55</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Goldener Schnitt</div><div class="text-xl font-bold font-mono" id="fibde-phi">1,6180</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">F(n)/F(n-1)</div><div class="text-xl font-bold font-mono" id="fibde-ratio">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ziffern</div><div class="text-xl font-bold font-mono" id="fibde-digits">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2" id="fibde-table-title">Folge</h3>
          <div class="text-xs font-mono leading-relaxed" id="fibde-table"></div>
        </div>
      </div>
      <ShareButton calculatorId="fibonacci-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die Fibonacci-Folge</h2>
      <p>Die Fibonacci-Folge beginnt mit 0 und 1, jede weitere Zahl ist die Summe der beiden vorherigen: 0, 1, 1, 2, 3, 5, 8, 13, 21, ... Das Verh&auml;ltnis aufeinanderfolgender Fibonacci-Zahlen n&auml;hert sich dem Goldenen Schnitt (Phi &asymp; 1,618).</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wo kommt die Fibonacci-Folge in der Natur vor?</strong> In Spiralmustern von Sonnenblumen, Tannenzapfen, Muscheln und der Anordnung von Blättern an Stängeln.</p>
      <p><strong>Was ist der Goldene Schnitt?</strong> Phi (1,618...) ist das Verhältnis, dem F(n)/F(n-1) für große n zustrebt. Er findet Anwendung in Kunst, Architektur und Natur.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let fibdeMode = 'nth';
    function fibDE(n: number): number {
      if (n <= 0) return 0;
      if (n === 1) return 1;
      let a = 0, b = 1;
      for (let i = 2; i <= n; i++) { const t = a + b; a = b; b = t; }
      return b;
    }
    function isFibDE(num: number): { is: boolean; pos: number } {
      if (num < 0) return { is: false, pos: -1 };
      if (num === 0) return { is: true, pos: 0 };
      let a = 0, b = 1, pos = 1;
      while (b < num) { const t = a + b; a = b; b = t; pos++; }
      return { is: b === num, pos: b === num ? pos : -1 };
    }
    function calcFibDE() {
      const input = parseInt((document.getElementById('fibde-input') as HTMLInputElement).value) || 0;
      const PHI = (1 + Math.sqrt(5)) / 2;
      document.getElementById('fibde-phi')!.textContent = PHI.toFixed(4).replace('.', ',');
      if (fibdeMode === 'nth') {
        const n = Math.min(78, Math.max(0, input));
        const val = fibDE(n);
        const prev = n > 0 ? fibDE(n - 1) : 0;
        document.getElementById('fibde-result-label')!.textContent = 'F(' + n + ')';
        document.getElementById('fibde-result')!.textContent = val.toLocaleString('de-DE');
        document.getElementById('fibde-ratio')!.textContent = prev > 0 ? (val / prev).toFixed(6).replace('.', ',') : '-';
        document.getElementById('fibde-digits')!.textContent = val.toString().length.toString();
        const seqStart = Math.max(0, n - 5);
        const seqEnd = Math.min(78, n + 5);
        const items: string[] = [];
        for (let i = seqStart; i <= seqEnd; i++) {
          const v = fibDE(i);
          items.push('<span class="' + (i === n ? 'text-primary font-bold' : '') + '">F(' + i + ')=' + v.toLocaleString('de-DE') + '</span>');
        }
        document.getElementById('fibde-table-title')!.textContent = 'Benachbarte Terme';
        document.getElementById('fibde-table')!.innerHTML = items.join(', ');
      } else if (fibdeMode === 'seq') {
        const count = Math.min(50, Math.max(1, input));
        const items: string[] = [];
        for (let i = 0; i < count; i++) items.push(fibDE(i).toLocaleString('de-DE'));
        document.getElementById('fibde-result-label')!.textContent = 'Erste ' + count + ' Terme';
        document.getElementById('fibde-result')!.textContent = count + ' Terme';
        document.getElementById('fibde-ratio')!.textContent = count > 1 ? (fibDE(count - 1) / fibDE(count - 2)).toFixed(6).replace('.', ',') : '-';
        document.getElementById('fibde-digits')!.textContent = fibDE(count - 1).toString().length.toString();
        document.getElementById('fibde-table-title')!.textContent = 'Fibonacci-Folge';
        document.getElementById('fibde-table')!.innerHTML = items.join(', ');
      } else {
        const result = isFibDE(input);
        document.getElementById('fibde-result-label')!.textContent = 'Ist ' + input + ' eine Fibonacci-Zahl?';
        document.getElementById('fibde-result')!.textContent = result.is ? 'Ja \u2014 F(' + result.pos + ')' : 'Nein';
        document.getElementById('fibde-ratio')!.textContent = '-';
        document.getElementById('fibde-digits')!.textContent = input.toString().length.toString();
        const nearby: string[] = [];
        let a = 0, b = 1;
        while (b < input * 2 && nearby.length < 15) {
          if (Math.abs(b - input) < input * 0.5 || b <= input) nearby.push(b.toLocaleString('de-DE'));
          const t = a + b; a = b; b = t;
        }
        document.getElementById('fibde-table-title')!.textContent = 'Benachbarte Fibonacci-Zahlen';
        document.getElementById('fibde-table')!.innerHTML = nearby.join(', ');
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fibde-mode').forEach(b => b.addEventListener('click', () => {
        fibdeMode = (b as HTMLButtonElement).dataset.mode!;
        document.querySelectorAll('.fibde-mode').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.mode === fibdeMode;
          (btn as HTMLButtonElement).className = 'fibde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        const labels: Record<string, string> = { nth: 'Position (n)', seq: 'Anzahl Terme', check: 'Zahl pr\u00FCfen' };
        document.getElementById('fibde-label')!.textContent = labels[fibdeMode];
        (document.getElementById('fibde-input') as HTMLInputElement).value = fibdeMode === 'check' ? '55' : '10';
        calcFibDE();
      }));
      document.querySelectorAll('.fibde-in').forEach(el => { el.addEventListener('input', calcFibDE); el.addEventListener('change', calcFibDE); });
      calcFibDE();
    }, 50);
  </script>
</CalculatorLayout>
