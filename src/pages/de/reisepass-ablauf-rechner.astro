---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Reisepass Ablauf Rechner - Ablaufdatum & Einreise";
const description = "Berechnen Sie das Ablaufdatum Ihres Reisepasses und prüfen Sie, ob Ihr Pass für geplante Reisen noch ausreichend gültig ist.";

const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "Datumsrechner", url: "/de/datumsrechner", description: "Datumsdifferenz." },
  { name: "Reisekostenrechner", url: "/de/reisekostenrechner", description: "Reisekosten." },
  { name: "Urlaubsrechner", url: "/de/urlaubsrechner", description: "Urlaubstage." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Reisepass Ablauf Rechner" lang="de" enSlug="passport-expiration-calculator" keywords="reisepass ablauf rechner, reisepass gültigkeit, reisepass verlängerung, reisepass prüfen, einreisebestimmungen" breadcrumbs={[{ name: "Reisepass Ablauf Rechner", url: "/de/reisepass-ablauf-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Reisepass Ablauf Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Prüfen Sie die Gültigkeit Ihres Reisepasses für geplante Reisen und erfahren Sie, wann Sie ihn verlängern müssen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ausstellungsdatum</label><input type="date" id="rpa-issued" class="rpa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2020-03-15"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Passinhaber</label>
            <select id="rpa-holder" class="rpa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="adult">Erwachsener (10 J. Gültigkeit)</option>
              <option value="child">Kind unter 12 Jahren (6 J.)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Reisedatum (Hinflug)</label><input type="date" id="rpa-travel" class="rpa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rückreisedatum</label><input type="date" id="rpa-return" class="rpa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Reiseziel</label>
          <select id="rpa-dest" class="rpa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="eu">EU / Schengen-Raum</option>
            <option value="3months">Nicht-EU (3 Monate Restgültigkeit)</option>
            <option value="6months">USA / Kanada / Australien (6 Monate)</option>
            <option value="custom">Sonstiges (eigene Anforderung)</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Mindestgültigkeit bei Einreise (Tage)</label><input type="number" id="rpa-mindays" class="rpa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" min="0" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ablaufdatum Reisepass</div>
          <div class="text-4xl font-extrabold font-mono" id="rpa-result">-</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Noch gültig</div><div class="text-xl font-bold" id="rpa-remaining">0 Tage</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reise möglich</div><div class="text-2xl font-bold" id="rpa-status">-</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gültigkeit bei Abreise</div><div class="text-xl font-bold" id="rpa-atdep">- Tage</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verlängerung empfohlen ab</div><div class="text-xl font-bold" id="rpa-renew">-</div></div>
        </div>
      </div>
      <ShareButton calculatorId="reisepass-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Reisepassgültigkeit richtig prüfen</h2>
      <p class="text-text-secondary mt-2">Ein abgelaufener oder kurz vor dem Ablauf stehender Reisepass kann zur Einreiseverweigerung führen. Viele Länder verlangen eine Restgültigkeit von mindestens 3 oder 6 Monaten nach der Einreise. Der deutsche Reisepass ist für Erwachsene 10 Jahre gültig, für Kinder unter 12 Jahren 6 Jahre. Eine Verlängerung des deutschen Reisepasses ist nicht möglich – er muss neu beantragt werden.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange dauert die Beantragung eines neuen Reisepasses?</strong> In Deutschland dauert die Ausstellung ca. 4–6 Wochen. Bei dringendem Bedarf kann ein vorläufiger Reisepass innerhalb weniger Tage ausgestellt werden.</p>
      <p><strong>Kann ich mit dem Personalausweis in die EU reisen?</strong> Ja, für Reisen innerhalb der EU und in viele europäische Länder genügt ein gültiger Personalausweis. Für Drittländer (z.B. USA, Türkei) ist ein Reisepass erforderlich.</p>
      <p><strong>Was ist die Mindestgültigkeit für die USA?</strong> Die USA verlangen keinen 6-Monate-Puffer, aber der Pass muss bei der Einreise und für die gesamte Aufenthaltsdauer gültig sein. Airlines empfehlen 6 Monate Restgültigkeit.</p>
      <p><strong>Ab wann sollte ich den Reisepass verlängern?</strong> Experten empfehlen, den Reisepass spätestens 6 Monate vor Ablauf zu erneuern, damit Sie für spontane Reisen immer gut vorbereitet sind.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcRPA() {
      const issued = (document.getElementById('rpa-issued') as HTMLInputElement).value;
      const holder = (document.getElementById('rpa-holder') as HTMLSelectElement).value;
      const travel = (document.getElementById('rpa-travel') as HTMLInputElement).value;
      const ret = (document.getElementById('rpa-return') as HTMLInputElement).value;
      const dest = (document.getElementById('rpa-dest') as HTMLSelectElement).value;
      const minDays = parseInt((document.getElementById('rpa-mindays') as HTMLInputElement).value) || 90;

      if (!issued) return;

      const issuedDate = new Date(issued);
      const years = holder === 'child' ? 6 : 10;
      const expDate = new Date(issuedDate);
      expDate.setFullYear(expDate.getFullYear() + years);

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const msPerDay = 86400000;
      const remaining = Math.floor((expDate.getTime() - today.getTime()) / msPerDay);

      const fmt = (d: Date) => d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
      document.getElementById('rpa-result')!.textContent = fmt(expDate);
      document.getElementById('rpa-remaining')!.textContent = remaining > 0 ? remaining.toLocaleString('de-DE') + ' Tage' : 'Abgelaufen';

      const renewDate = new Date(expDate);
      renewDate.setMonth(renewDate.getMonth() - 6);
      document.getElementById('rpa-renew')!.textContent = fmt(renewDate);

      if (travel) {
        const travelDate = new Date(travel);
        const retDate = ret ? new Date(ret) : travelDate;
        const daysAtDep = Math.floor((expDate.getTime() - travelDate.getTime()) / msPerDay);
        const daysAtReturn = Math.floor((expDate.getTime() - retDate.getTime()) / msPerDay);
        document.getElementById('rpa-atdep')!.textContent = daysAtDep > 0 ? daysAtDep.toLocaleString('de-DE') + ' Tage' : 'Abgelaufen';

        let reqMin = minDays;
        if (dest === 'eu') reqMin = 0;
        else if (dest === '3months') reqMin = 90;
        else if (dest === '6months') reqMin = 180;

        const tripDays = Math.floor((retDate.getTime() - travelDate.getTime()) / msPerDay);
        const valid = daysAtDep > 0 && daysAtReturn >= 0 && daysAtDep >= (reqMin + tripDays);
        const el = document.getElementById('rpa-status')!;
        el.textContent = valid ? 'Ja' : 'Nein';
        el.className = 'text-2xl font-bold ' + (valid ? 'text-green-700' : 'text-red-700');
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      const today = new Date();
      const travelDefault = new Date(today.getTime() + 60 * 86400000);
      const returnDefault = new Date(today.getTime() + 74 * 86400000);
      const fmt2 = (d: Date) => d.toISOString().split('T')[0];
      (document.getElementById('rpa-travel') as HTMLInputElement).value = fmt2(travelDefault);
      (document.getElementById('rpa-return') as HTMLInputElement).value = fmt2(returnDefault);
      document.querySelectorAll('.rpa-in').forEach(el => { el.addEventListener('input', calcRPA); el.addEventListener('change', calcRPA); });
      calcRPA();
    }, 50);
  </script>
</CalculatorLayout>
