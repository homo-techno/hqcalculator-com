---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Zahnkrone-Rechner - Kosten nach Material & Versicherung";
const description = "Berechnen Sie die Kosten einer Zahnkrone nach Material (Keramik, Zirkon, Gold), Vorbehandlung und Kassenleistung.";

const relatedCalcs = [
  { name: "Zahnimplantat-Kostenrechner", url: "/de/zahnimplantat-kosten-rechner", description: "Implantatkosten." },
  { name: "Zahnbr\u00fccke-Rechner", url: "/de/zahnbruecke-rechner", description: "Br\u00fcckenkosten." },
  { name: "Zahnversicherung-Rechner", url: "/de/zahnversicherung-rechner", description: "Versicherungsanalyse." },
  { name: "Zahn-R\u00f6ntgen-Rechner", url: "/de/zahn-roentgen-rechner", description: "R\u00f6ntgenstrahlung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Zahnkrone-Rechner" lang="de" enSlug="dental-crown-calculator" keywords="zahnkrone kosten, zirkonkrone, keramikkrone, zahnkrone rechner, zahnkrone versicherung" breadcrumbs={[{ name: "Zahnkrone-Rechner", url: "/de/zahnkrone-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zahnkrone-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Kosten einer Zahnkrone inkl. Material, Vorbehandlung und Kassenleistung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kronenmaterial</label>
            <select id="zdc-mat" class="zdc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="pfm" selected>Metallkeramik (VMK)</option>
              <option value="allceramic">Vollkeramik</option>
              <option value="zirconia">Zirkonoxid</option>
              <option value="emax">E-Max Lithiumdisilikat</option>
              <option value="gold">Goldlegierung</option>
              <option value="basemetal">NEM-Legierung</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zahnposition</label>
            <select id="zdc-loc" class="zdc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="anterior">Frontzahn</option>
              <option value="premolar" selected>Pr&auml;molar</option>
              <option value="molar">Molar</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Kronen</label><input type="number" id="zdc-count" class="zdc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="28" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zusatzbehandlung</label>
            <select id="zdc-prep" class="zdc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="none" selected>Nur Standardpr&auml;paration</option>
              <option value="buildup">Stiftaufbau (150-350 &euro;)</option>
              <option value="post">Stift und Aufbau (300-500 &euro;)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versicherung/Zuschuss (%)</label><input type="number" id="zdc-ins" class="zdc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Zuschuss (&euro;)</label><input type="number" id="zdc-max" class="zdc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2000" min="0" max="10000" step="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten Krone</div>
          <div class="text-5xl font-extrabold font-mono" id="zdc-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krone + Labor</div><div class="text-xl font-bold font-mono" id="zdc-crown">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vorbehandlung</div><div class="text-xl font-bold font-mono" id="zdc-prepc">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kassenleistung</div><div class="text-xl font-bold font-mono" id="zdc-insc">-0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Krone</div><div class="text-xl font-bold font-mono" id="zdc-each">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="zdc-oop">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dental-crown-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Zahnkronen in Deutschland</h2>
      <p>Die gesetzliche Krankenkasse gew&auml;hrt einen Festzuschuss f&uuml;r Zahnkronen. Der Eigenanteil h&auml;ngt von der gew&auml;hlten Versorgung ab. Vollkeramik und Zirkon kosten mehr als Metallkeramik, bieten aber bessere &Auml;sthetik.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was kostet eine Zahnkrone?</strong> Je nach Material zwischen 300 &euro; (NEM) und 1.200 &euro; (Vollkeramik/Zirkon) pro Krone.</p>
      <p><strong>Wie hoch ist der Kassenzuschuss?</strong> Ca. 60% der Regelversorgung. Mit l&uuml;ckenlosem Bonusheft bis zu 75%.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const zdcFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcZDC() {
      const mat = (document.getElementById('zdc-mat') as HTMLSelectElement).value;
      const loc = (document.getElementById('zdc-loc') as HTMLSelectElement).value;
      const count = parseFloat((document.getElementById('zdc-count') as HTMLInputElement).value) || 1;
      const prep = (document.getElementById('zdc-prep') as HTMLSelectElement).value;
      const insPct = parseFloat((document.getElementById('zdc-ins') as HTMLInputElement).value) || 0;
      const insMax = parseFloat((document.getElementById('zdc-max') as HTMLInputElement).value) || 0;

      const matCosts: Record<string, number> = { pfm: 900, allceramic: 1050, zirconia: 1200, emax: 1150, gold: 1300, basemetal: 700 };
      const locMult: Record<string, number> = { anterior: 1.05, premolar: 1.0, molar: 1.1 };
      const prepCosts: Record<string, number> = { none: 0, buildup: 250, post: 400 };

      const crownEach = Math.round(matCosts[mat] * locMult[loc]);
      const prepEach = prepCosts[prep];
      const perCrown = crownEach + prepEach;
      const crownTotal = crownEach * count;
      const prepTotal = prepEach * count;
      const subtotal = crownTotal + prepTotal;
      const insOffset = Math.min(subtotal * (insPct / 100), insMax);
      const oop = subtotal - insOffset;

      document.getElementById('zdc-total')!.textContent = zdcFmt(subtotal);
      document.getElementById('zdc-crown')!.textContent = zdcFmt(crownTotal);
      document.getElementById('zdc-prepc')!.textContent = zdcFmt(prepTotal);
      document.getElementById('zdc-insc')!.textContent = '-' + zdcFmt(insOffset);
      document.getElementById('zdc-each')!.textContent = zdcFmt(perCrown);
      document.getElementById('zdc-oop')!.textContent = zdcFmt(oop);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zdc-in').forEach(el => { el.addEventListener('input', calcZDC); el.addEventListener('change', calcZDC); });
      calcZDC();
    }, 50);
  </script>
</CalculatorLayout>
