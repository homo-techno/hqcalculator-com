---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Unterschrankrechner - Tragfähigkeit & Gewicht";
const description = "Berechnen Sie das Gesamtgewicht, das Ihr Aquarium-Unterschrank tragen muss, einschließlich Wasser, Becken, Substrat, Ausrüstung und Sicherheitsreserve.";
const relatedCalcs = [
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Wassergewicht berechnen." },
  { name: "Aquarium-Substrat", url: "/de/aquarium-substrat-rechner", description: "Substratgewicht-Rechner." },
  { name: "Aquarium-Filterbecken", url: "/de/aquarium-filterbecken-rechner", description: "Filterbeckendimensionierung." },
  { name: "Aquarium-Kosten", url: "/aquarium-cost-calculator", description: "Gesamtkosten der Aquariumeinrichtung." },
  { name: "Aquarium-Glasstärke", url: "/aquarium-glass-thickness-calculator", description: "Glasstärke für individuelle Becken." },
  { name: "Aquarium-Heizung", url: "/aquarium-heater-calculator", description: "Heizungsleistung berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Aquarium-Unterschrankrechner" keywords="Aquarium Unterschrank Rechner, Aquarium Gewicht, Tragfähigkeit, Beckengewicht, Bodenbelastung" lang="de" breadcrumbs={[{ name: "Aquarium-Unterschrank", url: "/de/aquarium-unterschrank-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Unterschrankrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Gesamtgewicht, das Ihr Unterschrank und Boden für ein sicher aufgestelltes Aquarium tragen müssen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Länge (cm)</label>
            <input type="number" id="ast-len" class="ast-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="15" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Breite (cm)</label>
            <input type="number" id="ast-wid" class="ast-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="15" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Höhe (cm)</label>
            <input type="number" id="ast-hgt" class="ast-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="15" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beckenmaterial</label>
            <select id="ast-mat" class="ast-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="glass" selected>Glas</option>
              <option value="acrylic">Acryl</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Substrathöhe (cm)</label>
            <input type="number" id="ast-sub" class="ast-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="15" step="1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Filterbecken darunter?</label>
          <select id="ast-sump" class="ast-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Kein Filterbecken</option>
            <option value="80">Kleines Filterbecken (~80 L)</option>
            <option value="150">Mittleres Filterbecken (~150 L)</option>
            <option value="280">Großes Filterbecken (~280 L)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtgewicht auf dem Unterschrank</div>
          <div class="text-5xl font-extrabold font-mono" id="ast-result">0 kg</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wassergewicht</div>
            <div class="text-xl font-bold font-mono" id="ast-water">0 kg</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Beckengewicht (leer)</div>
            <div class="text-xl font-bold font-mono" id="ast-tank">0 kg</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Substrat + Deko</div>
            <div class="text-xl font-bold font-mono" id="ast-extras">0 kg</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bodenbelastung (kg/m²)</div>
            <div class="text-xl font-bold font-mono" id="ast-floor">0</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="aquarium-stand" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcAST() {
      const len = parseFloat((document.getElementById('ast-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('ast-wid') as HTMLInputElement).value) || 0;
      const hgt = parseFloat((document.getElementById('ast-hgt') as HTMLInputElement).value) || 0;
      const mat = (document.getElementById('ast-mat') as HTMLSelectElement).value;
      const sub = parseFloat((document.getElementById('ast-sub') as HTMLInputElement).value) || 0;
      const sumpLiters = parseFloat((document.getElementById('ast-sump') as HTMLSelectElement).value) || 0;
      // Tank volume in liters
      const liters = (len * wid * hgt) / 1000;
      const waterWeight = liters; // 1 liter = 1 kg
      // Tank weight (empty): glass ~0.7 kg per liter capacity, acrylic ~0.25 kg
      const tankWeightPerLiter = mat === 'glass' ? 0.7 : 0.25;
      const tankWeight = liters * tankWeightPerLiter;
      // Substrate weight: density of gravel ~1.6 kg/L
      const subVolLiters = (len * wid * sub) / 1000;
      const subWeight = subVolLiters * 1.6;
      // Decor/rock estimate
      const decorWeight = liters * 0.05;
      // Sump
      const sumpWeight = sumpLiters * 1.0 + sumpLiters * 0.25;
      const totalWeight = waterWeight + tankWeight + subWeight + decorWeight + sumpWeight;
      // Floor load: weight per square meter
      const footprintM2 = (len * wid) / 10000;
      const floorLoad = footprintM2 > 0 ? (totalWeight / footprintM2).toFixed(0) : '0';
      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE');
      document.getElementById('ast-result')!.textContent = fmt(totalWeight) + ' kg';
      document.getElementById('ast-water')!.textContent = fmt(waterWeight + sumpLiters) + ' kg';
      document.getElementById('ast-tank')!.textContent = fmt(tankWeight) + ' kg';
      document.getElementById('ast-extras')!.textContent = fmt(subWeight + decorWeight) + ' kg';
      document.getElementById('ast-floor')!.textContent = parseInt(floorLoad).toLocaleString('de-DE') + ' kg/m\u00B2';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ast-in').forEach(el => { el.addEventListener('input', calcAST); el.addEventListener('change', calcAST); });
      calcAST();
    }, 50);
  </script>
</CalculatorLayout>
