---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Keks-Rechner - Rezepte nach Menge & Größe skalieren";
const description = "Skalieren Sie Keksrezepte auf beliebige Mengen in der gewünschten Größe. Erhalten Sie genaue Zutatenmengen für verschiedene Keksarten.";
const relatedCalcs = [
  { name: "Backumrechner", url: "/de/backumrechner", description: "Backeinheiten umrechnen." },
  { name: "Kochumrechner", url: "/de/kochumrechner", description: "Küchenmaße umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Keks-Rechner" enSlug="cookie-batch-calculator" keywords="Keks Rechner, Keksrezept skalieren, Plätzchen Menge, Keksteig Rechner, Backrezept anpassen" breadcrumbs={[{ name: "Keks-Rechner", url: "/de/keks-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Keks-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Skalieren Sie jedes Keksrezept auf die gewünschte Anzahl und Größe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kekssorte</label>
          <select id="cob-type" class="cob-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="chocchip">Schokoladen-Cookies</option>
            <option value="sugar">Butterplätzchen</option>
            <option value="oatmeal">Haferflocken-Rosinen</option>
            <option value="peanut">Erdnussbutter</option>
            <option value="snicker">Zimtzucker (Snickerdoodle)</option>
            <option value="shortbread">Shortbread / Mürbeteig</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gewünschte Anzahl Kekse</label>
            <input type="number" id="cob-count" class="cob-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="24" min="1" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Keksgröße</label>
            <select id="cob-size" class="cob-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="small">Klein (1 EL / 15 g)</option>
              <option value="medium" selected>Mittel (2 EL / 30 g)</option>
              <option value="large">Groß (3 EL / 45 g)</option>
              <option value="bakery">Bäckerei-Größe (60 g)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtes Teiggewicht</div>
          <div class="text-5xl font-extrabold font-mono" id="cob-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mehl</div>
            <div class="text-xl font-bold font-mono" id="cob-flour">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Butter</div>
            <div class="text-xl font-bold font-mono" id="cob-butter">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zucker</div>
            <div class="text-xl font-bold font-mono" id="cob-sugar">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Eier</div>
            <div class="text-xl font-bold font-mono" id="cob-eggs">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zutaten / Spezial</div>
            <div class="text-xl font-bold font-mono" id="cob-mixin">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Backbleche benötigt</div>
            <div class="text-xl font-bold font-mono" id="cob-pans">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Backtemperatur & -zeit</div>
          <div class="text-xl font-bold font-mono" id="cob-bake">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cookie-batch" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Keksrezepte richtig skalieren</h2>
      <p>Beim Skalieren von Keksrezepten ist es wichtig, alle Zutaten proportional anzupassen. Dieser Rechner berechnet die exakten Mengen basierend auf der gewünschten Anzahl und Größe der Kekse.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Wie viele Kekse passen auf ein Backblech?</strong> Bei mittlerer Größe ca. 16 Kekse, bei großen ca. 12 Kekse.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCOB() {
      const type = (document.getElementById('cob-type') as HTMLSelectElement).value;
      const count = parseFloat((document.getElementById('cob-count') as HTMLInputElement).value) || 24;
      const size = (document.getElementById('cob-size') as HTMLSelectElement).value;

      const sizeG: Record<string, number> = { small: 15, medium: 30, large: 45, bakery: 60 };
      const doughPerCookie = sizeG[size];
      const totalDough = count * doughPerCookie;

      const recipes: Record<string, {flour: number, butter: number, sugar: number, egg: number, mixin: number, mixinName: string, temp: string}> = {
        chocchip: { flour: 0.33, butter: 0.22, sugar: 0.27, egg: 0.08, mixin: 0.10, mixinName: 'Schokost\u00FCckchen', temp: '190\u00B0C' },
        sugar:    { flour: 0.40, butter: 0.24, sugar: 0.26, egg: 0.08, mixin: 0.02, mixinName: 'Vanilleextrakt', temp: '175\u00B0C' },
        oatmeal:  { flour: 0.22, butter: 0.18, sugar: 0.22, egg: 0.07, mixin: 0.31, mixinName: 'Haferflocken + Rosinen', temp: '175\u00B0C' },
        peanut:   { flour: 0.28, butter: 0.14, sugar: 0.24, egg: 0.07, mixin: 0.27, mixinName: 'Erdnussbutter', temp: '175\u00B0C' },
        snicker:  { flour: 0.38, butter: 0.24, sugar: 0.28, egg: 0.08, mixin: 0.02, mixinName: 'Zimt-Zucker-H\u00FClle', temp: '190\u00B0C' },
        shortbread: { flour: 0.48, butter: 0.32, sugar: 0.18, egg: 0.00, mixin: 0.02, mixinName: 'Vanille/Salz', temp: '163\u00B0C' },
      };

      const r = recipes[type];
      const flourG = totalDough * r.flour;
      const butterG = totalDough * r.butter;
      const sugarG = totalDough * r.sugar;
      const eggG = totalDough * r.egg;
      const mixinG = totalDough * r.mixin;
      const eggs = eggG / 50;

      const perPan: Record<string, number> = { small: 24, medium: 16, large: 12, bakery: 9 };
      const pans = Math.ceil(count / perPan[size]);

      const times: Record<string, string> = { small: '8-10 Min.', medium: '10-12 Min.', large: '12-14 Min.', bakery: '14-16 Min.' };

      document.getElementById('cob-result')!.textContent = totalDough.toFixed(0) + ' g';
      document.getElementById('cob-flour')!.textContent = flourG.toFixed(0) + ' g';
      document.getElementById('cob-butter')!.textContent = butterG.toFixed(0) + ' g';
      document.getElementById('cob-sugar')!.textContent = sugarG.toFixed(0) + ' g';
      document.getElementById('cob-eggs')!.textContent = eggs < 0.3 ? 'Keine' : Math.round(eggs) + ' St\u00FCck (' + eggG.toFixed(0) + ' g)';
      document.getElementById('cob-mixin')!.textContent = mixinG.toFixed(0) + ' g ' + r.mixinName;
      document.getElementById('cob-pans')!.textContent = pans + ' Blech' + (pans > 1 ? 'e' : '');
      document.getElementById('cob-bake')!.textContent = r.temp + ', ' + times[size];
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.cob-in').forEach(el => { el.addEventListener('input', calcCOB); el.addEventListener('change', calcCOB); });
      calcCOB();
    }, 50);
  </script>
</CalculatorLayout>
