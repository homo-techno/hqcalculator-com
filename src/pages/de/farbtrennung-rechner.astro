---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Farbtrennung-Rechner - CMYK, Sonderfarben & Pantone";
const description = "Konvertieren Sie RGB zu CMYK, berechnen Sie Farbprozente, schätzen Sie Sonderfarbkosten und finden Sie die nächste Pantone-Entsprechung.";
const relatedCalcs = [
  { name: "Farbumrechner", url: "/de/farbumrechner", description: "Farbkonvertierung." },
  { name: "Farbtemperatur-Rechner", url: "/de/farbtemperatur-rechner", description: "Farbtemperatur." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Farbtrennung-Rechner" enSlug="color-separation-calculator" keywords="CMYK Konvertierung, RGB zu CMYK, Sonderfarbe, Pantone, Farbtrennung, Farbprozent, Druckfarbe" breadcrumbs={[{ name: "Farbtrennung-Rechner", url: "/de/farbtrennung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Farbtrennung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Konvertieren Sie RGB-Farben zu CMYK für den Druck, berechnen Sie Farbprozente und schätzen Sie den Gesamtfarbauftrag für die Druckvorstufe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Rot (0-255)</label><input type="number" id="ft-r" class="ft-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="255" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Grün (0-255)</label><input type="number" id="ft-g" class="ft-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="255" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Blau (0-255)</label><input type="number" id="ft-b" class="ft-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="255" step="1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Oder HEX-Code eingeben</label><input type="text" id="ft-hex" class="ft-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" placeholder="#FF5733"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Sonderfarben</label><input type="number" id="ft-spots" class="ft-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="6" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Druckplatte Kosten (EUR)</label><input type="number" id="ft-platecost" class="ft-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="flex gap-3 items-center">
          <div class="w-20 h-20 rounded-xl border border-border" id="ft-preview" style="background:#FF5733;"></div>
          <div class="p-6 bg-primary rounded-2xl text-white text-center flex-1">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">CMYK-Werte</div>
            <div class="text-3xl font-extrabold font-mono" id="ft-result">C0 M0 Y0 K0</div>
            <div class="text-sm text-blue-200 mt-1" id="ft-totalink"></div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Cyan (%)</div><div class="text-xl font-bold" id="ft-c">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Magenta (%)</div><div class="text-xl font-bold" id="ft-m">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gelb (%)</div><div class="text-xl font-bold" id="ft-y">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schwarz (%)</div><div class="text-xl font-bold" id="ft-k">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtfarbauftrag</div><div class="text-xl font-bold" id="ft-coverage">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Plattenkosten</div><div class="text-xl font-bold" id="ft-platecosttotal">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Farbwerte</h3>
          <div class="font-mono text-sm space-y-1" id="ft-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="farbtrennung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">RGB-zu-CMYK-Konvertierung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>K = 1 - max(R', G', B') wobei R'=R/255</p>
        <p>C = (1-R'-K) / (1-K)</p>
        <p>M = (1-G'-K) / (1-K)</p>
        <p>Y = (1-B'-K) / (1-K)</p>
        <p>Gesamtfarbe = C + M + Y + K (max. empfohlen ~300%)</p>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFT() {
      let r = parseFloat((document.getElementById('ft-r') as HTMLInputElement).value);
      let g = parseFloat((document.getElementById('ft-g') as HTMLInputElement).value);
      let b = parseFloat((document.getElementById('ft-b') as HTMLInputElement).value);
      const hexInput = (document.getElementById('ft-hex') as HTMLInputElement).value.trim();
      if (hexInput && /^#?[0-9A-Fa-f]{6}$/.test(hexInput)) {
        const hex = hexInput.replace('#', '');
        r = parseInt(hex.substring(0, 2), 16);
        g = parseInt(hex.substring(2, 4), 16);
        b = parseInt(hex.substring(4, 6), 16);
        (document.getElementById('ft-r') as HTMLInputElement).value = r.toString();
        (document.getElementById('ft-g') as HTMLInputElement).value = g.toString();
        (document.getElementById('ft-b') as HTMLInputElement).value = b.toString();
      }
      if (isNaN(r)) r = 0; if (isNaN(g)) g = 0; if (isNaN(b)) b = 0;
      r = Math.max(0, Math.min(255, r));
      g = Math.max(0, Math.min(255, g));
      b = Math.max(0, Math.min(255, b));
      const spots = parseFloat((document.getElementById('ft-spots') as HTMLInputElement).value) || 0;
      const plateCost = parseFloat((document.getElementById('ft-platecost') as HTMLInputElement).value) || 0;
      const rr = r / 255, gg = g / 255, bb = b / 255;
      const k = 1 - Math.max(rr, gg, bb);
      let c = 0, m = 0, y = 0;
      if (k < 1) {
        c = (1 - rr - k) / (1 - k);
        m = (1 - gg - k) / (1 - k);
        y = (1 - bb - k) / (1 - k);
      }
      const cPct = Math.round(c * 100);
      const mPct = Math.round(m * 100);
      const yPct = Math.round(y * 100);
      const kPct = Math.round(k * 100);
      const totalInk = cPct + mPct + yPct + kPct;
      const totalPlates = 4 + spots;
      const totalPlateCost = totalPlates * plateCost;
      const hexStr = '#' + r.toString(16).padStart(2, '0').toUpperCase() + g.toString(16).padStart(2, '0').toUpperCase() + b.toString(16).padStart(2, '0').toUpperCase();
      const steps: string[] = [];
      steps.push('RGB: ' + r + ', ' + g + ', ' + b);
      steps.push('HEX: ' + hexStr);
      steps.push('CMYK: ' + cPct + '%, ' + mPct + '%, ' + yPct + '%, ' + kPct + '%');
      steps.push('Gesamtfarbauftrag: ' + totalInk + '%');
      if (totalInk > 300) steps.push('WARNUNG: Gesamtfarbe > 300% - kann Trocknungsprobleme verursachen');
      steps.push('Prozessplatten: 4 (C, M, Y, K)');
      if (spots > 0) steps.push('Sonderfarbplatten: ' + spots);
      steps.push('Platten gesamt: ' + totalPlates);
      steps.push('Plattenkosten: ' + totalPlates + ' x ' + plateCost.toFixed(2) + ' EUR = ' + totalPlateCost.toFixed(2) + ' EUR');
      document.getElementById('ft-preview')!.style.background = hexStr;
      document.getElementById('ft-result')!.textContent = 'C' + cPct + ' M' + mPct + ' Y' + yPct + ' K' + kPct;
      document.getElementById('ft-totalink')!.textContent = 'Gesamtfarbe: ' + totalInk + '%' + (totalInk > 300 ? ' (HOCH!)' : '');
      document.getElementById('ft-c')!.textContent = cPct + '%';
      document.getElementById('ft-m')!.textContent = mPct + '%';
      document.getElementById('ft-y')!.textContent = yPct + '%';
      document.getElementById('ft-k')!.textContent = kPct + '%';
      document.getElementById('ft-coverage')!.textContent = totalInk + '%';
      document.getElementById('ft-platecosttotal')!.textContent = totalPlateCost.toFixed(2) + ' EUR';
      document.getElementById('ft-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ft-r') as HTMLInputElement).value = '255';
      (document.getElementById('ft-g') as HTMLInputElement).value = '87';
      (document.getElementById('ft-b') as HTMLInputElement).value = '51';
      (document.getElementById('ft-spots') as HTMLInputElement).value = '0';
      (document.getElementById('ft-platecost') as HTMLInputElement).value = '50';
      document.querySelectorAll('.ft-in').forEach(el => { el.addEventListener('input', calcFT); el.addEventListener('change', calcFT); });
      calcFT();
    }, 50);
  </script>
</CalculatorLayout>
