---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Stromkosten-Rechner - Verbrauch, Kosten & Einsparpotenzial";
const description = "Berechnen Sie Ihre Stromkosten nach Verbrauch und Tarif. Vergleichen Sie Anbieter, finden Sie Einsparpotenziale und optimieren Sie Ihren Energieverbrauch.";

const relatedCalcs = [
  { name: "Stromrechnung-Rechner", url: "/de/stromrechnung-rechner", description: "Stromrechnung prüfen." },
  { name: "Elektrokosten-Rechner", url: "/de/elektrokosten-rechner", description: "Gerätekosten." },
  { name: "Elektrofahrzeug-Rechner", url: "/de/elektrofahrzeug-rechner", description: "E-Auto Kosten." },
  { name: "Ökologischer Fußabdruck", url: "/de/oekologischer-fussabdruck-rechner", description: "Umweltbelastung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Stromkosten-Rechner" lang="de" enSlug="electricity-cost-calculator" keywords="stromkosten rechner, stromverbrauch kosten, strom tarif vergleich, energiekosten, kwh kosten" breadcrumbs={[{ name: "Stromkosten-Rechner", url: "/de/stromkosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stromkosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen und vergleichen Sie Ihre Stromkosten. Finden Sie Einsparpotenziale mit verschiedenen Tarifen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Jahresverbrauch (kWh)</label><input type="number" id="stk-kwh" class="stk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Aktueller Tarif (&euro;ct/kWh)</label><input type="number" id="stk-rate1" class="stk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Vergleichstarif (&euro;ct/kWh)</label><input type="number" id="stk-rate2" class="stk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Grundgeb&uuml;hr aktuell (&euro;/Mon.)</label><input type="number" id="stk-base1" class="stk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Grundgeb&uuml;hr Vergleich (&euro;/Mon.)</label><input type="number" id="stk-base2" class="stk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jahreskosten (aktuell)</div>
          <div class="text-5xl font-extrabold font-mono" id="stk-result">0,00 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatskosten (aktuell)</div><div class="text-xl font-bold" id="stk-monthly1">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahreskosten (Vergleich)</div><div class="text-xl font-bold" id="stk-year2">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Ersparnis</div><div class="text-xl font-bold" id="stk-savings">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro kWh (eff.)</div><div class="text-xl font-bold" id="stk-effrate">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="stk-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="electricity-cost-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Stromkosten berechnen &amp; vergleichen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Jahreskosten = Verbrauch &times; Arbeitspreis/100 + Grundgeb&uuml;hr &times; 12</p>
        <p>Effektiver Preis = Jahreskosten / Verbrauch &times; 100 (ct/kWh)</p>
        <p>Ersparnis = Kosten Tarif 1 &minus; Kosten Tarif 2</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Lohnt sich ein Anbieterwechsel?</strong> Bei einem Verbrauch von 3.000 kWh und 5 ct/kWh Unterschied sparen Sie 150 &euro; pro Jahr.</p>
      <p><strong>Was ist der effektive Strompreis?</strong> Der effektive Preis ber&uuml;cksichtigt auch die Grundgeb&uuml;hr und zeigt die tats&auml;chlichen Kosten pro kWh.</p>
      <p><strong>Wie senke ich meinen Stromverbrauch?</strong> Gr&ouml;&szlig;te Hebel: energieeffiziente Ger&auml;te, LED-Lampen, Standby vermeiden, smarte Thermostate.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcStk() {
      const kwh = parseFloat((document.getElementById('stk-kwh') as HTMLInputElement).value) || 0;
      const rate1 = parseFloat((document.getElementById('stk-rate1') as HTMLInputElement).value) || 0;
      const rate2 = parseFloat((document.getElementById('stk-rate2') as HTMLInputElement).value) || 0;
      const base1 = parseFloat((document.getElementById('stk-base1') as HTMLInputElement).value) || 0;
      const base2 = parseFloat((document.getElementById('stk-base2') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const usage1 = kwh * rate1 / 100;
      const baseYear1 = base1 * 12;
      const total1 = usage1 + baseYear1;
      steps.push('Tarif 1: ' + kwh + ' kWh x ' + fmt(rate1) + ' ct/100 + ' + fmt(base1) + ' x 12 = ' + fmt(total1) + ' EUR');
      const usage2 = kwh * rate2 / 100;
      const baseYear2 = base2 * 12;
      const total2 = usage2 + baseYear2;
      steps.push('Tarif 2: ' + kwh + ' kWh x ' + fmt(rate2) + ' ct/100 + ' + fmt(base2) + ' x 12 = ' + fmt(total2) + ' EUR');
      const savings = total1 - total2;
      steps.push('Ersparnis = ' + fmt(total1) + ' - ' + fmt(total2) + ' = ' + fmt(savings) + ' EUR/Jahr');
      const effRate = kwh > 0 ? (total1 / kwh * 100) : 0;
      steps.push('Effektiver Preis (T1) = ' + fmt(total1) + ' / ' + kwh + ' x 100 = ' + fmt(effRate) + ' ct/kWh');
      const monthly1 = total1 / 12;
      document.getElementById('stk-result')!.textContent = fmt(total1) + ' \u20AC';
      document.getElementById('stk-monthly1')!.textContent = fmt(monthly1) + ' \u20AC';
      document.getElementById('stk-year2')!.textContent = fmt(total2) + ' \u20AC';
      document.getElementById('stk-savings')!.textContent = fmt(savings) + ' \u20AC';
      document.getElementById('stk-effrate')!.textContent = fmt(effRate) + ' ct';
      document.getElementById('stk-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('stk-kwh') as HTMLInputElement).value = '3000';
      (document.getElementById('stk-rate1') as HTMLInputElement).value = '32';
      (document.getElementById('stk-rate2') as HTMLInputElement).value = '28';
      (document.getElementById('stk-base1') as HTMLInputElement).value = '10';
      (document.getElementById('stk-base2') as HTMLInputElement).value = '12';
      document.querySelectorAll('.stk-in').forEach(el => { el.addEventListener('input', calcStk); el.addEventListener('change', calcStk); });
      calcStk();
    }, 50);
  </script>
</CalculatorLayout>
