---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Linsengleichung Rechner – Brennweite, Bildweite berechnen";
const description = "Berechnen Sie Brennweite, Gegenstandsweite und Bildweite mit der Linsengleichung 1/f = 1/g + 1/b.";
const relatedCalcs = [
  { name: "Linsendicke Rechner", url: "/de/linsendicke-rechner", description: "Brillengläser." },
  { name: "Lichtintensität Rechner", url: "/de/lichtintensitaet-rechner", description: "Beleuchtungsstärke." },
  { name: "Lichtlaufzeit Rechner", url: "/de/lichtlaufzeit-rechner", description: "Lichtgeschwindigkeit." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="lens-equation-calculator" calculatorName="Linsengleichung Rechner" keywords="Linsengleichung, Brennweite berechnen, Bildweite, Gegenstandsweite, Optik Rechner" breadcrumbs={[{ name: "Linsengleichung Rechner", url: "/de/linsen-gleichung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Linsengleichung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Brennweite, Gegenstands- oder Bildweite mit der Abbildungsgleichung 1/f = 1/g + 1/b.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gesuchte Größe</label>
          <div class="flex gap-2">
            <button id="lgl-bf" class="lgl-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="f">Brennweite f</button>
            <button id="lgl-bg" class="lgl-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="g">Gegenstandsw. g</button>
            <button id="lgl-bb" class="lgl-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="b">Bildweite b</button>
          </div>
        </div>
        <div id="lgl-inputs" class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gegenstandsweite g (mm)</label>
            <input type="number" id="lgl-g" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" step="any" min="0.01">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bildweite b (mm)</label>
            <input type="number" id="lgl-b" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" step="any">
          </div>
        </div>
        <div id="lgl-f-input" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Brennweite f (mm)</label>
          <input type="number" id="lgl-f-val" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" step="any">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="lgl-label">Brennweite f</div>
          <div class="text-5xl font-extrabold font-mono" id="lgl-result">0 mm</div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="lgl-extra"></div>
        <div class="p-4 bg-surface-alt rounded-xl font-mono text-sm" id="lgl-formel"></div>
      </div>
      <ShareButton lang="de" calculatorId="linsen-gleichung" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Die Linsengleichung in der Optik</h2>
      <p>Die dünne Linsengleichung (Abbildungsgleichung) lautet: 1/f = 1/g + 1/b. Dabei ist f die Brennweite, g die Gegenstandsweite (Abstand Objekt–Linse) und b die Bildweite (Abstand Linse–Bild). Ein positiver Wert für b bedeutet ein reelles Bild auf der anderen Seite der Linse. Die Brechkraft D einer Linse ergibt sich als D = 1/f (in Dioptrien, wenn f in Metern).</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist die Brennweite einer Linse?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die Brennweite f ist der Abstand zwischen der Linse und dem Brennpunkt (Fokus), in dem parallele Strahlen gebündelt werden. Für Sammellinsen ist f positiv, für Zerstreuungslinsen negativ.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was sind Dioptrien?</summary>
          <p class="mt-2 text-sm text-text-secondary">Dioptrien (dpt) sind die Einheit der Brechkraft: D = 1/f [m]. Eine Linse mit f = 0,5 m hat eine Brechkraft von 2 dpt. Brillengläser werden in Dioptrien angegeben.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen reellem und virtuellem Bild?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ein reelles Bild (b > 0) entsteht auf der dem Objekt gegenüberliegenden Seite und kann auf einem Schirm abgebildet werden. Ein virtuelles Bild (b &lt; 0) entsteht auf derselben Seite wie das Objekt und ist nur durch die Linse sichtbar (z.B. Lupe).</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie berechnet man den Abbildungsmaßstab?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der Abbildungsmaßstab m = b/g gibt das Verhältnis von Bildgröße zu Gegenstandsgröße an. Bei m = 2 ist das Bild doppelt so groß wie der Gegenstand.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let lglMode = 'f';
    function setLglMode(m: string) {
      lglMode = m;
      document.querySelectorAll('.lgl-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = `lgl-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ${active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted'}`;
      });
      const fInput = document.getElementById('lgl-f-input')!;
      const gbInputs = document.getElementById('lgl-inputs')!;
      if (m === 'f') {
        gbInputs.classList.remove('hidden');
        fInput.classList.add('hidden');
        (document.getElementById('lgl-g') as HTMLInputElement).readOnly = false;
        (document.getElementById('lgl-b') as HTMLInputElement).readOnly = false;
      } else if (m === 'g') {
        gbInputs.classList.remove('hidden');
        fInput.classList.remove('hidden');
        (document.getElementById('lgl-g') as HTMLInputElement).readOnly = true;
        (document.getElementById('lgl-g') as HTMLInputElement).classList.add('bg-gray-50');
        (document.getElementById('lgl-b') as HTMLInputElement).readOnly = false;
        (document.getElementById('lgl-b') as HTMLInputElement).classList.remove('bg-gray-50');
      } else {
        gbInputs.classList.remove('hidden');
        fInput.classList.remove('hidden');
        (document.getElementById('lgl-b') as HTMLInputElement).readOnly = true;
        (document.getElementById('lgl-b') as HTMLInputElement).classList.add('bg-gray-50');
        (document.getElementById('lgl-g') as HTMLInputElement).readOnly = false;
        (document.getElementById('lgl-g') as HTMLInputElement).classList.remove('bg-gray-50');
      }
      calcLgl();
    }
    function calcLgl() {
      const g = parseFloat((document.getElementById('lgl-g') as HTMLInputElement).value) || 0;
      const b = parseFloat((document.getElementById('lgl-b') as HTMLInputElement).value) || 0;
      const fv = parseFloat((document.getElementById('lgl-f-val') as HTMLInputElement)?.value) || 0;
      let f = 0, gRes = 0, bRes = 0, label = '', formel = '';
      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 4 });

      if (lglMode === 'f') {
        if (g === 0 || b === 0) return;
        f = 1 / (1/g + 1/b);
        label = 'Brennweite f';
        document.getElementById('lgl-result')!.textContent = fmt(f) + ' mm';
        formel = `1/f = 1/${g} + 1/${b} = ${fmt(1/f)} mm⁻¹ → f = ${fmt(f)} mm`;
        const D = 1000 / f;
        document.getElementById('lgl-extra')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Brechkraft D</div><div class="font-bold font-mono">${fmt(D)} dpt</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Maßstab m</div><div class="font-bold font-mono">${fmt(b/g)}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Bildtyp</div><div class="font-bold">${b > 0 ? 'Reell' : 'Virtuell'}</div></div>`;
      } else if (lglMode === 'g') {
        if (fv === 0 || b === 0) return;
        gRes = 1 / (1/fv - 1/b);
        label = 'Gegenstandsweite g';
        document.getElementById('lgl-result')!.textContent = fmt(gRes) + ' mm';
        formel = `1/g = 1/${fv} - 1/${b} → g = ${fmt(gRes)} mm`;
        document.getElementById('lgl-extra')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Brennweite f</div><div class="font-bold font-mono">${fv} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Bildweite b</div><div class="font-bold font-mono">${b} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Maßstab m</div><div class="font-bold font-mono">${fmt(b/gRes)}</div></div>`;
      } else {
        if (fv === 0 || g === 0) return;
        bRes = 1 / (1/fv - 1/g);
        label = 'Bildweite b';
        document.getElementById('lgl-result')!.textContent = fmt(bRes) + ' mm';
        formel = `1/b = 1/${fv} - 1/${g} → b = ${fmt(bRes)} mm`;
        document.getElementById('lgl-extra')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Brennweite f</div><div class="font-bold font-mono">${fv} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Gegenstandsw. g</div><div class="font-bold font-mono">${g} mm</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">Bildtyp</div><div class="font-bold">${bRes > 0 ? 'Reell' : 'Virtuell'}</div></div>`;
      }
      document.getElementById('lgl-label')!.textContent = label;
      document.getElementById('lgl-formel')!.textContent = formel;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.lgl-mode').forEach(b => b.addEventListener('click', () => setLglMode((b as HTMLButtonElement).dataset.mode!)));
      ['lgl-g','lgl-b','lgl-f-val'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcLgl); el.addEventListener('change', calcLgl); }
      });
      calcLgl();
    }, 50);
  </script>
</CalculatorLayout>
