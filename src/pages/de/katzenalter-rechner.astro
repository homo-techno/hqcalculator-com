---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Katzenalter-Rechner – Katzenjahre in Menschenjahre";
const description = "Rechnen Sie das Alter Ihrer Katze in Menschenjahre um und erfahren Sie die aktuelle Lebensphase nach aktuellen tierärztlichen Richtlinien.";
const relatedCalcs = [
  { name: "Katzenfutter-Rechner", url: "/de/katzenfutter-rechner", description: "Katzenfutter-Portionen." },
  { name: "Rindergewicht-Rechner", url: "/de/rindergewicht-rechner", description: "Rindergewicht." },
  { name: "Catering-Mengen-Rechner", url: "/de/catering-mengen-rechner", description: "Catering." },
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Katzenalter-Rechner" enSlug="cat-age-calculator" keywords="Katzenalter Rechner, Katzenjahre Menschenjahre, Katze Lebensphase, Katze Alter" breadcrumbs={[{ name: "Katzenalter-Rechner", url: "/de/katzenalter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Katzenalter-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie heraus, wie alt Ihre Katze in Menschenjahren ist.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Alter der Katze (Jahre)</label><input type="number" id="kar-years" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" max="30" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Lebensweise</label><select id="kar-life" class="w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="indoor" selected>Nur drinnen</option><option value="outdoor">Freigänger</option></select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Menschliches Äquivalent</div>
          <div class="text-5xl font-extrabold" id="kar-human">0</div>
          <div class="text-sm text-blue-200 mt-1">Menschenjahre</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lebensphase</div><div class="text-xl font-bold" id="kar-stage">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchschn. Lebenserwartung</div><div class="text-xl font-bold" id="kar-lifespan">-</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Umrechnungstabelle</h3>
          <div class="grid grid-cols-4 gap-1 text-sm text-center">
            <span class="font-semibold text-xs">Katze</span><span class="font-semibold text-xs">Mensch</span><span class="font-semibold text-xs">Katze</span><span class="font-semibold text-xs">Mensch</span>
          </div>
          <div class="grid grid-cols-4 gap-1 text-sm text-center" id="kar-table"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Lebensphasen der Katze</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Kitten</span><span class="font-bold">0-1 Jahr</span></div>
            <div class="flex justify-between"><span>Junior</span><span class="font-bold">1-2 Jahre</span></div>
            <div class="flex justify-between"><span>Erwachsen</span><span class="font-bold">3-6 Jahre</span></div>
            <div class="flex justify-between"><span>Reif</span><span class="font-bold">7-10 Jahre</span></div>
            <div class="flex justify-between"><span>Senior</span><span class="font-bold">11-14 Jahre</span></div>
            <div class="flex justify-between"><span>Hochbetagt</span><span class="font-bold">15+ Jahre</span></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cat-age" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Katzenalter-Umrechnung</h2>
      <p>Das erste Lebensjahr einer Katze entspricht etwa 15 Menschenjahren, das zweite Jahr bringt 9 weitere, und jedes folgende Jahr entspricht etwa 4 Menschenjahren.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Wie alt werden Katzen?</strong> Wohnungskatzen werden durchschnittlich 12-18 Jahre alt, Freigänger 5-12 Jahre.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function catToHumanDE(catYears: number): number {
      if (catYears <= 0) return 0;
      if (catYears <= 1) return catYears * 15;
      if (catYears <= 2) return 15 + (catYears - 1) * 9;
      return 24 + (catYears - 2) * 4;
    }
    function getStageDE(years: number): string {
      if (years < 1) return 'Kitten';
      if (years < 2) return 'Junior';
      if (years < 7) return 'Erwachsen';
      if (years < 11) return 'Reif';
      if (years < 15) return 'Senior';
      return 'Hochbetagt';
    }
    function calcKAR() {
      const years = parseFloat((document.getElementById('kar-years') as HTMLInputElement).value) || 0;
      const lifestyle = (document.getElementById('kar-life') as HTMLSelectElement).value;
      const humanAge = catToHumanDE(years);
      document.getElementById('kar-human')!.textContent = Math.round(humanAge).toString();
      document.getElementById('kar-stage')!.textContent = getStageDE(years);
      document.getElementById('kar-lifespan')!.textContent = lifestyle === 'indoor' ? '12-18 Jahre' : '5-12 Jahre';
      const tableRows: string[] = [];
      const ages = [0.5, 1, 2, 3, 5, 7, 10, 12, 15, 18, 20, 25];
      for (let i = 0; i < ages.length; i += 2) {
        const a1 = ages[i], a2 = ages[i + 1];
        const isCurrent1 = Math.abs(a1 - years) < 0.5;
        const isCurrent2 = a2 !== undefined && Math.abs(a2 - years) < 0.5;
        tableRows.push('<span class="' + (isCurrent1 ? 'font-bold text-primary' : '') + '">' + a1 + ' J.</span>');
        tableRows.push('<span class="' + (isCurrent1 ? 'font-bold text-primary' : '') + '">' + Math.round(catToHumanDE(a1)) + '</span>');
        if (a2 !== undefined) {
          tableRows.push('<span class="' + (isCurrent2 ? 'font-bold text-primary' : '') + '">' + a2 + ' J.</span>');
          tableRows.push('<span class="' + (isCurrent2 ? 'font-bold text-primary' : '') + '">' + Math.round(catToHumanDE(a2)) + '</span>');
        }
      }
      document.getElementById('kar-table')!.innerHTML = tableRows.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('kar-years') as HTMLInputElement).value = '5';
      document.getElementById('kar-years')!.addEventListener('input', calcKAR);
      document.getElementById('kar-life')!.addEventListener('change', calcKAR);
      calcKAR();
    }, 50);
  </script>
</CalculatorLayout>
