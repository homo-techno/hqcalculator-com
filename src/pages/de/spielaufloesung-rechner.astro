---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Spielaufl\u00F6sung-Rechner - Pixelz\u00E4hlung, PPI & VRAM";
const description = "Vergleichen Sie Pixelanzahlen zwischen Aufl\u00F6sungen, berechnen Sie PPI bei Betrachtungsabstand, sch\u00E4tzen Sie VRAM-Verbrauch und analysieren Sie Seitenverh\u00E4ltnisse f\u00FCr Gaming-Displays.";
const relatedCalcs = [
  { name: "Bildschirmgr\u00F6\u00DFen-Rechner", url: "/de/bildschirmgroessen-rechner", description: "Display-Gr\u00F6\u00DFe." },
  { name: "Seitenverh\u00E4ltnis-Rechner", url: "/de/seitenverhaeltnis-rechner", description: "Seitenverh\u00E4ltnis." },
  { name: "Foto-Aufl\u00F6sung-Rechner", url: "/de/foto-aufloesung-rechner", description: "Aufl\u00F6sung." },
  { name: "Video-Bitrate-Rechner", url: "/de/video-bitrate-rechner", description: "Bitrate-Berechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Spielaufl\u00F6sung-Rechner" lang="de" enSlug="game-resolution-calculator" keywords="spielaufl\u00F6sung, pixelanzahl, ppi rechner, vram verbrauch, 4k vs 1440p, seitenverh\u00E4ltnis gaming, aufl\u00F6sungsvergleich" breadcrumbs={[{ name: "Spielaufl\u00F6sung", url: "/de/spielaufloesung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Spielaufl&ouml;sung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Aufl&ouml;sungen, berechnen Sie Pixeldichte und sch&auml;tzen Sie VRAM-Anforderungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Aufl&ouml;sung</label>
          <select class="sar-in w-full px-4 py-2 border border-border rounded-lg" id="sar-res">
            <option value="1280x720">720p (1280x720)</option>
            <option value="1920x1080" selected>1080p (1920x1080)</option>
            <option value="2560x1080">Ultrawide 1080p (2560x1080)</option>
            <option value="2560x1440">1440p (2560x1440)</option>
            <option value="3440x1440">Ultrawide 1440p (3440x1440)</option>
            <option value="3840x2160">4K (3840x2160)</option>
            <option value="5120x1440">Super Ultrawide (5120x1440)</option>
            <option value="5120x2880">5K (5120x2880)</option>
            <option value="7680x4320">8K (7680x4320)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Monitorgr&ouml;&szlig;e (Zoll Diagonale)</label>
          <input type="number" class="sar-in w-full px-4 py-2 border border-border rounded-lg" id="sar-size" min="10" max="100" step="0.5" value="27">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Betrachtungsabstand (cm)</label>
          <input type="number" class="sar-in w-full px-4 py-2 border border-border rounded-lg" id="sar-dist" min="15" max="300" value="60">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Farbtiefe</label>
          <select class="sar-in w-full px-4 py-2 border border-border rounded-lg" id="sar-depth">
            <option value="24">8-Bit (24bpp)</option>
            <option value="30" selected>10-Bit (30bpp / HDR)</option>
            <option value="48">16-Bit (48bpp)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtpixel</div>
          <div class="text-5xl font-extrabold font-mono" id="sar-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Pixel pro Zoll</div>
            <div class="text-xl font-bold font-mono" id="sar-ppi">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Seitenverh&auml;ltnis</div>
            <div class="text-xl font-bold font-mono" id="sar-aspect">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">VRAM pro Frame</div>
            <div class="text-xl font-bold font-mono" id="sar-vram">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Retina-Qualit&auml;t</div>
            <div class="text-xl font-bold font-mono" id="sar-retina">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Aufl&ouml;sungsvergleich</h3>
          <div class="text-xs font-mono space-y-1" id="sar-compare"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="game-resolution-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Spielaufl&ouml;sungen im Vergleich</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>PPI = &radic;(Breite&sup2; + H&ouml;he&sup2;) / Diagonale (Zoll)</p>
        <p>VRAM = Pixel &times; Bytes pro Pixel &times; 2 (Double Buffer)</p>
        <p>4K hat 4&times; so viele Pixel wie 1080p</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Lohnt sich 4K f&uuml;r Gaming?</strong> Bei einem 27-Zoll-Monitor und normalem Sitzabstand (60 cm) ist der Unterschied zwischen 1440p und 4K gering. 4K lohnt sich eher bei Monitoren ab 32 Zoll.</p>
      <p><strong>Was bedeutet Retina-Qualit&auml;t?</strong> Retina bedeutet, dass die Pixeldichte so hoch ist, dass das menschliche Auge bei normalem Betrachtungsabstand keine einzelnen Pixel mehr erkennen kann.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function sarGcd(a: number, b: number): number { return b === 0 ? a : sarGcd(b, a % b); }
    function calcSAR() {
      const resStr = (document.getElementById('sar-res') as HTMLSelectElement).value;
      const [w, h] = resStr.split('x').map(Number);
      const size = parseFloat((document.getElementById('sar-size') as HTMLInputElement).value) || 27;
      const distCm = parseFloat((document.getElementById('sar-dist') as HTMLInputElement).value) || 60;
      const depth = parseInt((document.getElementById('sar-depth') as HTMLSelectElement).value) || 30;
      const dist = distCm / 2.54;
      const totalPixels = w * h;
      const diag = Math.sqrt(w * w + h * h);
      const ppi = diag / size;
      const g = sarGcd(w, h);
      const aspectW = w / g;
      const aspectH = h / g;
      const bytesPerPixel = depth / 8;
      const framebufferMB = (totalPixels * bytesPerPixel * 2) / (1024 * 1024);
      const estimatedVram = framebufferMB * 1.3;
      const retinaPPI = 3438 / dist;
      const isRetina = ppi >= retinaPPI;
      document.getElementById('sar-result')!.textContent = (totalPixels / 1000000).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' MP';
      document.getElementById('sar-ppi')!.textContent = ppi.toFixed(0) + ' PPI';
      document.getElementById('sar-aspect')!.textContent = aspectW + ':' + aspectH;
      document.getElementById('sar-vram')!.textContent = estimatedVram.toFixed(0) + ' MB';
      document.getElementById('sar-retina')!.textContent = isRetina ? 'Ja' : 'Nein (' + Math.round(retinaPPI) + ' ben\u00F6tigt)';
      const resolutions = [
        { name: '720p', w: 1280, h: 720 },
        { name: '1080p', w: 1920, h: 1080 },
        { name: 'UW 1080p', w: 2560, h: 1080 },
        { name: '1440p', w: 2560, h: 1440 },
        { name: 'UW 1440p', w: 3440, h: 1440 },
        { name: '4K', w: 3840, h: 2160 },
        { name: '8K', w: 7680, h: 4320 }
      ];
      let html = '';
      const basePixels = 1920 * 1080;
      for (const r of resolutions) {
        const px = r.w * r.h;
        const ratio = (px / basePixels).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
        const marker = r.w === w && r.h === h ? ' <-' : '';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + r.name + ' (' + r.w + 'x' + r.h + ')</span><span>' + (px / 1000000).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' MP (' + ratio + 'x 1080p)' + marker + '</span></div>';
      }
      document.getElementById('sar-compare')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sar-in').forEach(el => { el.addEventListener('input', calcSAR); el.addEventListener('change', calcSAR); });
      calcSAR();
    }, 50);
  </script>
</CalculatorLayout>
