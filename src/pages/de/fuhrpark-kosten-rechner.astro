---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fuhrpark-Kosten-Rechner - Gesamtbetriebskosten";
const description = "Berechnen Sie die gesamten Fuhrpark-Betriebskosten inkl. Kraftstoff, Wartung, Versicherung und Abschreibung. Kosten pro km und pro Fahrzeug.";
const relatedCalcs = [
  { name: "Spritkosten", url: "/de/spritkosten-rechner", description: "Kraftstoffkosten." },
  { name: "Pendelkosten", url: "/de/pendelkosten-rechner", description: "Pendlerausgaben." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Gewinnmarge", url: "/de/gewinnmargen-rechner", description: "Gewinnmargen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fuhrpark-Kosten-Rechner" lang="de" enSlug="fleet-cost-calculator" keywords="Fuhrpark Kosten, Flottenmanagement, Kosten pro km, Kraftstoffkosten Flotte, Wartungskosten, Abschreibung Fahrzeug" breadcrumbs={[{ name: "Fuhrpark-Kosten", url: "/de/fuhrpark-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fuhrpark-Kosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die gesamten Betriebskosten Ihres Fuhrparks inkl. Kraftstoff, Wartung, Versicherung und Abschreibung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Anzahl Fahrzeuge</label><input type="number" id="fpk-vehicles" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="1" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche km pro Fahrzeug</label><input type="number" id="fpk-km" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1000"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kraftstoffpreis (&euro;/L)</label><input type="number" id="fpk-fuelprice" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.01" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Durchschn. Verbrauch (L/100km)</label><input type="number" id="fpk-consumption" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Wartung pro Fahrzeug/Jahr (&euro;)</label><input type="number" id="fpk-maint" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Versicherung pro Fahrzeug/Jahr (&euro;)</label><input type="number" id="fpk-insurance" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Abschreibung pro Fahrzeug/Jahr (&euro;)</label><input type="number" id="fpk-deprec" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Sonstige Kosten pro Fahrzeug/Jahr (&euro;)</label><input type="number" id="fpk-other" class="fpk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">J&auml;hrliche Fuhrparkkosten gesamt</div>
          <div class="text-5xl font-extrabold font-mono" id="fpk-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro km</div><div class="text-xl font-bold font-mono" id="fpk-perkm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Meile</div><div class="text-xl font-bold font-mono" id="fpk-permile">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraftstoffkosten/Jahr</div><div class="text-xl font-bold font-mono" id="fpk-fuelcost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Fahrzeug</div><div class="text-xl font-bold font-mono" id="fpk-perveh">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraftstoff % gesamt</div><div class="text-xl font-bold font-mono" id="fpk-fuelpct">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt-km Flotte</div><div class="text-xl font-bold font-mono" id="fpk-totalkm">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fleet-cost" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Was sind typische Fuhrparkkosten pro km?</strong> In Deutschland liegen die Gesamtkosten je nach Fahrzeugtyp zwischen 0,30 &euro; und 0,80 &euro; pro km.</p>
      <p><strong>Wie kann man Fuhrparkkosten senken?</strong> Effizientere Fahrzeuge, regelm&auml;&szlig;ige Wartung, Fahrtraining und Routenoptimierung helfen Kosten zu reduzieren.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFPK() {
      const vehicles = parseFloat((document.getElementById('fpk-vehicles') as HTMLInputElement).value) || 0;
      const km = parseFloat((document.getElementById('fpk-km') as HTMLInputElement).value) || 0;
      const fuelPrice = parseFloat((document.getElementById('fpk-fuelprice') as HTMLInputElement).value) || 0;
      const consumption = parseFloat((document.getElementById('fpk-consumption') as HTMLInputElement).value) || 1;
      const maint = parseFloat((document.getElementById('fpk-maint') as HTMLInputElement).value) || 0;
      const insurance = parseFloat((document.getElementById('fpk-insurance') as HTMLInputElement).value) || 0;
      const deprec = parseFloat((document.getElementById('fpk-deprec') as HTMLInputElement).value) || 0;
      const other = parseFloat((document.getElementById('fpk-other') as HTMLInputElement).value) || 0;
      const fuelPerVehicle = (km / 100) * consumption * fuelPrice;
      const totalFuel = fuelPerVehicle * vehicles;
      const totalFleetCost = (fuelPerVehicle + maint + insurance + deprec + other) * vehicles;
      const totalKm = km * vehicles;
      const costPerKm = totalKm > 0 ? totalFleetCost / totalKm : 0;
      const costPerMile = costPerKm * 1.60934;
      const costPerVehicle = vehicles > 0 ? totalFleetCost / vehicles : 0;
      const fuelPct = totalFleetCost > 0 ? (totalFuel / totalFleetCost) * 100 : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC';
      document.getElementById('fpk-result')!.textContent = fmt(totalFleetCost);
      document.getElementById('fpk-perkm')!.textContent = costPerKm.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('fpk-permile')!.textContent = costPerMile.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('fpk-fuelcost')!.textContent = fmt(totalFuel);
      document.getElementById('fpk-perveh')!.textContent = fmt(costPerVehicle);
      document.getElementById('fpk-fuelpct')!.textContent = fuelPct.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      document.getElementById('fpk-totalkm')!.textContent = totalKm.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('fpk-vehicles') as HTMLInputElement).value = '10';
      (document.getElementById('fpk-km') as HTMLInputElement).value = '80000';
      (document.getElementById('fpk-fuelprice') as HTMLInputElement).value = '1.75';
      (document.getElementById('fpk-consumption') as HTMLInputElement).value = '25';
      (document.getElementById('fpk-maint') as HTMLInputElement).value = '6000';
      (document.getElementById('fpk-insurance') as HTMLInputElement).value = '4500';
      (document.getElementById('fpk-deprec') as HTMLInputElement).value = '10000';
      (document.getElementById('fpk-other') as HTMLInputElement).value = '1500';
      document.querySelectorAll('.fpk-in').forEach(el => { el.addEventListener('input', calcFPK); el.addEventListener('change', calcFPK); });
      calcFPK();
    }, 50);
  </script>
</CalculatorLayout>
