---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Wimpernverlängerung Rechner - Anzahl, Länge & Biegung nach Augenform";
const description = "Berechnen Sie die ideale Wimpernverlängerung: Anzahl, Länge und Biegungstyp basierend auf Ihrer Augenform, natürlichen Wimpern und gewünschtem Look.";
const relatedCalcs = [
  { name: "Gesichtsproportion-Rechner", url: "/de/gesichtsproportion-rechner", description: "Goldener Schnitt Analyse." },
  { name: "Mode-Aufschlag-Rechner", url: "/de/mode-aufschlag-rechner", description: "Mode-Preiskalkulation." },
  { name: "Stoff-Rechner", url: "/de/stoff-rechner", description: "Stoffbedarf berechnen." },
  { name: "Fibonacci-Rechner", url: "/de/fibonacci-rechner", description: "Fibonacci-Folge." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Wimpernverlängerung Rechner" lang="de" enSlug="eyelash-extension-calculator" keywords="wimpernverlängerung, wimpern extensions, wimpernanzahl, wimpernbiegung, augenform, wimpernlänge, classic wimpern, volume wimpern" breadcrumbs={[{ name: "Wimpernverlängerung Rechner", url: "/de/wimpernverlaengerung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Wimpernverlängerung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die idealen Wimpernverlängerungs-Spezifikationen für Ihre Augenform und Ihren gewünschten Look.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Augenform</label>
          <select id="wvde-shape" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="almond" selected>Mandelförmig</option>
            <option value="round">Rund</option>
            <option value="hooded">Schlupflid</option>
            <option value="monolid">Monolid</option>
            <option value="downturned">Abwärts gerichtet</option>
            <option value="upturned">Aufwärts gerichtet</option>
            <option value="closeset">Eng stehend</option>
            <option value="wideset">Weit stehend</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gewünschter Look</label>
          <select id="wvde-look" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="natural">Natürliche Betonung</option>
            <option value="classic" selected>Klassisch Glamourös</option>
            <option value="dramatic">Dramatisch / Voll</option>
            <option value="cat">Cat Eye</option>
            <option value="doll">Puppen-Auge</option>
            <option value="wispy">Wispy / Texturiert</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Verlängerungstyp</label>
          <select id="wvde-type" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="classic" selected>Classic (1:1)</option>
            <option value="hybrid">Hybrid (Mix Classic + Volume)</option>
            <option value="volume">Volume (2-6 Fächer)</option>
            <option value="mega">Mega Volume (6-16 Fächer)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Natürliche Wimpern</label>
          <select id="wvde-natural" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="strong">Stark / Dick</option>
            <option value="average" selected>Durchschnittlich</option>
            <option value="fine">Fein / Spärlich</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kosten pro Vollset (&euro;)</label>
          <input type="number" id="wvde-cost" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="180" min="50" max="600" step="10">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Wimpernanzahl</div>
          <div class="text-5xl font-extrabold font-mono" id="wvde-count">0</div>
          <div class="text-sm text-blue-200 mt-1">Extensions pro Auge</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfohlene Biegung</div><div class="text-xl font-bold" id="wvde-curl">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Längenbereich</div><div class="text-xl font-bold" id="wvde-length">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchmesser</div><div class="text-xl font-bold" id="wvde-diameter">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anwendungszeit</div><div class="text-xl font-bold" id="wvde-time">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Auffüllkosten (2-3 Wo.)</div><div class="text-xl font-bold" id="wvde-fill">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährliche Kosten</div><div class="text-xl font-bold" id="wvde-annual">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Stil-Empfehlung</h3>
          <div class="text-sm space-y-1" id="wvde-mapping"></div>
        </div>
      </div>
      <ShareButton calculatorId="eyelash-extension-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Ratgeber Wimpernverlängerung</h2>
      <p>Wimpernverlängerungen werden nach Anzahl, Länge, Biegung und Durchmesser individuell angepasst, um Ihre Augenform zu betonen. Classic-Wimpern (1:1-Verhältnis) bieten eine natürliche Betonung, während Volume (2-6 Fächer) und Mega Volume (6-16 Fächer) dramatische Fülle erzeugen. Biegungstypen reichen von J (dezent) bis D und L (dramatischer Lift). Die Länge liegt typischerweise zwischen 8-15mm. Auffüllungen alle 2-3 Wochen erhalten den Look.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange halten Wimpernverlängerungen?</strong> Mit regelmäßigen Auffüllungen alle 2-3 Wochen können Wimpernverlängerungen dauerhaft getragen werden. Ohne Auffüllung fallen sie mit dem natürlichen Wimpernzyklus innerhalb von 4-6 Wochen aus.</p>
      <p><strong>Schaden Extensions den natürlichen Wimpern?</strong> Bei fachgerechter Anwendung und korrekter Dicke nicht. Zu schwere Extensions können die natürlichen Wimpern jedoch schädigen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcWVDE() {
      const shape = (document.getElementById('wvde-shape') as HTMLSelectElement).value;
      const look = (document.getElementById('wvde-look') as HTMLSelectElement).value;
      const type = (document.getElementById('wvde-type') as HTMLSelectElement).value;
      const natural = (document.getElementById('wvde-natural') as HTMLSelectElement).value;
      const cost = parseFloat((document.getElementById('wvde-cost') as HTMLInputElement).value) || 180;

      let baseCount = 80;
      if (type === 'classic') baseCount = 80;
      else if (type === 'hybrid') baseCount = 100;
      else if (type === 'volume') baseCount = 120;
      else baseCount = 140;

      if (look === 'natural') baseCount *= 0.8;
      else if (look === 'dramatic' || look === 'cat') baseCount *= 1.2;
      else if (look === 'doll') baseCount *= 1.1;

      if (natural === 'fine') baseCount *= 0.85;
      else if (natural === 'strong') baseCount *= 1.1;

      let curl = 'C-Biegung';
      if (shape === 'hooded' || shape === 'monolid') curl = 'D- oder L-Biegung';
      else if (shape === 'round') curl = 'B- oder C-Biegung';
      else if (shape === 'downturned') curl = 'C- oder D-Biegung';
      else if (shape === 'upturned') curl = 'B- oder C-Biegung';
      else curl = 'C-Biegung';

      if (look === 'dramatic') curl = 'D-Biegung';
      else if (look === 'natural') curl = 'B- oder C-Biegung';

      let lengthRange = '9-12mm';
      if (look === 'natural') lengthRange = '8-10mm';
      else if (look === 'classic') lengthRange = '9-12mm';
      else if (look === 'dramatic') lengthRange = '11-14mm';
      else if (look === 'cat') lengthRange = '10-14mm';
      else if (look === 'doll') lengthRange = '10-13mm';
      else if (look === 'wispy') lengthRange = '9-13mm';

      let diameter = '0,15mm';
      if (type === 'classic') diameter = '0,15-0,20mm';
      else if (type === 'hybrid') diameter = '0,10-0,15mm';
      else if (type === 'volume') diameter = '0,05-0,07mm';
      else diameter = '0,03-0,05mm';

      let appTime = '90-120 Min.';
      if (type === 'classic') appTime = '90-120 Min.';
      else if (type === 'hybrid') appTime = '120-150 Min.';
      else if (type === 'volume') appTime = '150-180 Min.';
      else appTime = '180-240 Min.';

      const fillCost = cost * 0.5;
      const annualCost = cost + (fillCost * 17);
      const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

      const mapping: string[] = [];
      if (shape === 'almond') mapping.push('Mandelförmige Augen: Am vielseitigsten - fast jeder Stil passt gut.');
      else if (shape === 'round') mapping.push('Runde Augen: Cat-Eye-Platzierung verlängert optisch; vermeiden Sie zu viel Volumen in der Mitte.');
      else if (shape === 'hooded') mapping.push('Schlupflider: D/L-Biegung verwenden, um das Auge zu öffnen und anzuheben.');
      else if (shape === 'monolid') mapping.push('Monolid: L-Biegung empfohlen für maximale Sichtbarkeit und Lift.');
      else if (shape === 'downturned') mapping.push('Abwärts gerichtete Augen: Längere äußere Wimpern mit starker Biegung heben die Ecken an.');
      else if (shape === 'upturned') mapping.push('Aufwärts gerichtete Augen: Ausgeglichene Längen; keine zusätzliche äußere Länge für Symmetrie.');
      else if (shape === 'closeset') mapping.push('Eng stehende Augen: Längere äußere Extensions erzeugen optisch mehr Abstand.');
      else if (shape === 'wideset') mapping.push('Weit stehende Augen: Länge in der Mitte und innen betonen, um die Augen zusammenzuführen.');

      const typeLabels: Record<string, string> = { classic: 'dezente, natürliche Dichte', hybrid: 'eine Mischung aus Textur und Fülle', volume: 'volle, fluffige Dichte', mega: 'maximale dramatische Dichte' };
      mapping.push('Wimperntyp: ' + type.charAt(0).toUpperCase() + type.slice(1) + ' bietet ' + (typeLabels[type] || 'Dichte') + '.');
      mapping.push('Empfohlene Pflege: Auffüllungen alle 2-3 Wochen, um ausgefallene Wimpern zu ersetzen.');

      const count = Math.round(baseCount);
      document.getElementById('wvde-count')!.textContent = count.toString();
      document.getElementById('wvde-curl')!.textContent = curl;
      document.getElementById('wvde-length')!.textContent = lengthRange;
      document.getElementById('wvde-diameter')!.textContent = diameter;
      document.getElementById('wvde-time')!.textContent = appTime;
      document.getElementById('wvde-fill')!.textContent = fmtEur(fillCost);
      document.getElementById('wvde-annual')!.textContent = fmtEur(annualCost);
      document.getElementById('wvde-mapping')!.innerHTML = mapping.map(m => '<p>' + m + '</p>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.wvde-in').forEach(el => { el.addEventListener('input', calcWVDE); el.addEventListener('change', calcWVDE); });
      calcWVDE();
    }, 50);
  </script>
</CalculatorLayout>
