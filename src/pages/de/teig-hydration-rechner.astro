---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Teig-Hydration-Rechner - Wasser-Prozentsatz & Anpassung 2026";
const description = "Berechne den Hydrationsprozentsatz deines Teiges und passe die Wassermengen fuer dein Brotrezept an. Finde die perfekte Hydration fuer verschiedene Brotsorten.";

const relatedCalcs = [
  { name: "Sauerteig-Rechner", url: "/de/sauerteig-rechner", description: "Sauerteig-Starter-Verhaeltnisse." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Teig-Hydration-Rechner" keywords="Teig Hydration, Wasser Prozentsatz, Brot Hydration, Teig Wasser Verhaeltnis, Hydration Rechner" breadcrumbs={[{ name: "Teig-Hydration", url: "/de/teig-hydration-rechner" }]} lang="de" enSlug="dough-hydration-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Teig-Hydration-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne den Hydrationsprozentsatz deines Teiges und wie viel Wasser du hinzufuegen oder entfernen musst, um deine Zielhydration zu erreichen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Gesamtes Mehlgewicht (g)</label><input type="number" id="thde-flour" class="thde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesamtes Wasser / Fluessigkeit (g)</label><input type="number" id="thde-water" class="thde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="325" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Sauerteig-Starter Gewicht (g) - falls verwendet</label><input type="number" id="thde-starter" class="thde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Starter-Hydration (%)</label><input type="number" id="thde-starter-hyd" class="thde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Ziel-Hydration (%)</label><input type="number" id="thde-target" class="thde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="1" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Aktuelle Hydration</div>
          <div class="text-5xl font-extrabold font-mono" id="thde-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mehl gesamt (inkl. Starter)</div><div class="text-xl font-bold font-mono" id="thde-total-flour">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser gesamt (inkl. Starter)</div><div class="text-xl font-bold font-mono" id="thde-total-water">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser-Anpassung</div><div class="text-xl font-bold font-mono" id="thde-adjust">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Brotsorte</div><div class="text-xl font-bold font-mono" id="thde-style">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dough-hydration" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Teig-Hydration erklaert</h2>
      <p>Die Hydration ist das Verhaeltnis von Wasser zu Mehl in Prozent. Sie bestimmt massgeblich die Textur und Krume des Brotes.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist eine gute Hydration fuer Anfaenger?</strong> 60-65 % ist ideal fuer Anfaenger. Der Teig laesst sich leicht verarbeiten und ergibt ein gutes Sandwichbrot.</p>
      <p><strong>Welche Hydration fuer welches Brot?</strong> Pasta: unter 55 %. Baguette: 65-70 %. Ciabatta: 75-80 %. Focaccia: 80-90 %.</p>
      <p><strong>Wie beeinflusst der Sauerteig-Starter die Hydration?</strong> Der Starter bringt sowohl Mehl als auch Wasser ein. Bei 100 % Hydration besteht er zu gleichen Teilen aus Mehl und Wasser.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcTHDE() {
      const flour = parseFloat((document.getElementById('thde-flour') as HTMLInputElement).value) || 0;
      const water = parseFloat((document.getElementById('thde-water') as HTMLInputElement).value) || 0;
      const starter = parseFloat((document.getElementById('thde-starter') as HTMLInputElement).value) || 0;
      const starterHyd = parseFloat((document.getElementById('thde-starter-hyd') as HTMLInputElement).value) || 100;
      const target = parseFloat((document.getElementById('thde-target') as HTMLInputElement).value) || 75;

      const starterFlour = starter / (1 + starterHyd / 100);
      const starterWater = starter - starterFlour;
      const totalFlour = flour + starterFlour;
      const totalWater = water + starterWater;

      if (totalFlour <= 0) {
        document.getElementById('thde-result')!.textContent = 'Mehlgewicht eingeben';
        return;
      }

      const currentHyd = (totalWater / totalFlour) * 100;
      const targetWater = totalFlour * (target / 100);
      const adjustment = targetWater - totalWater;

      let style = '';
      if (currentHyd < 55) style = 'Sehr fest (Pasta)';
      else if (currentHyd < 60) style = 'Fest (Bagels)';
      else if (currentHyd < 65) style = 'Standard (Sandwichbrot)';
      else if (currentHyd < 70) style = 'Mittel (Weissbrot)';
      else if (currentHyd < 75) style = 'Weich (Baguette)';
      else if (currentHyd < 80) style = 'Feucht (Ciabatta)';
      else if (currentHyd < 90) style = 'Sehr feucht (Focaccia)';
      else style = 'Extrem feucht';

      document.getElementById('thde-result')!.textContent = currentHyd.toFixed(1).replace('.', ',') + '%';
      document.getElementById('thde-total-flour')!.textContent = totalFlour.toFixed(0) + ' g';
      document.getElementById('thde-total-water')!.textContent = totalWater.toFixed(0) + ' g';
      document.getElementById('thde-adjust')!.textContent = (adjustment >= 0 ? '+' : '') + adjustment.toFixed(0) + ' g';
      document.getElementById('thde-style')!.textContent = style;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.thde-in').forEach(el => { el.addEventListener('input', calcTHDE); el.addEventListener('change', calcTHDE); });
      calcTHDE();
    }, 50);
  </script>
</CalculatorLayout>
