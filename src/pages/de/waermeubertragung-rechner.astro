---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "W&auml;rme&uuml;bertragungs-Rechner - Q = mc&Delta;T";
const description = "Berechnen Sie W&auml;rmeenergie&uuml;bertragung mit Q = mc&Delta;T. Ermitteln Sie Energie, Masse, spezifische W&auml;rmekapazit&auml;t oder Temperatur&auml;nderung.";

const relatedCalcs = [
  { name: "W&auml;rmetauscher-Rechner", url: "/de/waermetauscher-rechner", description: "W&auml;rmetauscher." },
  { name: "Temperatur-Umrechner", url: "/de/temperatur-umrechner", description: "Temperatur." },
  { name: "Energie-Umrechner", url: "/de/energie-umrechner", description: "Energie." },
  { name: "Kinetische-Energie-Rechner", url: "/de/kinetische-energie-rechner", description: "Kinetische Energie." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Wissenschaftlich." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="W&auml;rme&uuml;bertragungs-Rechner"
  keywords="w&auml;rme&uuml;bertragung rechner, Q=mc&Delta;T, spezifische w&auml;rmekapazit&auml;t, kalorimetrie, thermische energie"
  breadcrumbs={[{ name: "W&auml;rme&uuml;bertragungs-Rechner", url: "/de/waermeubertragung-rechner" }]}
  lang="de"
  enSlug="heat-transfer-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">W&auml;rme&uuml;bertragungs-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie W&auml;rmeenergie mit Q = mc&Delta;T.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Masse (kg)</label><input type="number" id="wude-m" class="wude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" step="0.1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Material</label>
            <select id="wude-mat" class="wude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="4186" selected>Wasser (4186)</option>
              <option value="900">Aluminium (900)</option>
              <option value="385">Kupfer (385)</option>
              <option value="449">Eisen (449)</option>
              <option value="129">Gold (129)</option>
              <option value="235">Silber (235)</option>
              <option value="502">Stahl (502)</option>
              <option value="710">Glas (710)</option>
              <option value="1005">Luft (1005)</option>
              <option value="0">Benutzerdefiniert</option>
            </select>
          </div>
        </div>
        <div id="wude-custom-c" class="hidden"><label class="block text-xs font-medium text-text mb-1">Spez. W&auml;rmekapazit&auml;t c (J/kg&middot;&deg;C)</label><input type="number" id="wude-c" class="wude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4186" min="0" step="1"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anfangstemperatur (&deg;C)</label><input type="number" id="wude-t1" class="wude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Endtemperatur (&deg;C)</label><input type="number" id="wude-t2" class="wude-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">W&auml;rmeenergie (Q)</div>
          <div class="text-5xl font-extrabold font-mono" id="wude-result">0</div>
          <div class="text-sm text-blue-200 mt-1" id="wude-unit">J</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">kJ</div><div class="text-xl font-bold font-mono" id="wude-kj">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">BTU</div><div class="text-xl font-bold font-mono" id="wude-btu">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">kcal</div><div class="text-xl font-bold font-mono" id="wude-kcal">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Delta;T</div><div class="text-xl font-bold font-mono" id="wude-dt">0&deg;C</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spez. W&auml;rmekapazit&auml;t</div><div class="text-xl font-bold font-mono" id="wude-sh">0 J/kg&middot;&deg;C</div></div>
        </div>
      </div>

      <ShareButton calculatorId="waermeubertragung-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">W&auml;rme&uuml;bertragung Q = mc&Delta;T</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Q = m &times; c &times; &Delta;T</p>
        <p>Q = W&auml;rmeenergie (J)</p>
        <p>m = Masse (kg), c = Spez. W&auml;rmekapazit&auml;t (J/kg&middot;&deg;C), &Delta;T = Temperatur&auml;nderung (&deg;C)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die spezifische W&auml;rmekapazit&auml;t?</strong> Die spezifische W&auml;rmekapazit&auml;t c gibt an, wie viel Energie (in Joule) ben&ouml;tigt wird, um 1 kg eines Stoffes um 1 Kelvin zu erw&auml;rmen. Wasser hat mit 4186 J/kg&middot;K eine sehr hohe Kapazit&auml;t.</p>
      <p><strong>Was bedeutet positives vs. negatives Q?</strong> Positives Q bedeutet, dass W&auml;rme vom Stoff aufgenommen wird (Erw&auml;rmung). Negatives Q bedeutet, dass W&auml;rme abgegeben wird (Abk&uuml;hlung).</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcWUDE() {
      const m = parseFloat((document.getElementById('wude-m') as HTMLInputElement).value) || 0;
      const matVal = (document.getElementById('wude-mat') as HTMLSelectElement).value;
      let c: number;
      if (matVal === '0') {
        document.getElementById('wude-custom-c')!.classList.remove('hidden');
        c = parseFloat((document.getElementById('wude-c') as HTMLInputElement).value) || 0;
      } else {
        document.getElementById('wude-custom-c')!.classList.add('hidden');
        c = parseFloat(matVal);
      }
      const t1 = parseFloat((document.getElementById('wude-t1') as HTMLInputElement).value) || 0;
      const t2 = parseFloat((document.getElementById('wude-t2') as HTMLInputElement).value) || 0;
      const dt = t2 - t1;
      const q = m * c * dt;
      const absQ = Math.abs(q);
      let display: string;
      if (absQ >= 1e6) display = (q/1e6).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MJ';
      else if (absQ >= 1e3) display = (q/1e3).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kJ';
      else display = q.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' J';
      document.getElementById('wude-result')!.textContent = display;
      document.getElementById('wude-unit')!.textContent = q < 0 ? '(W\u00E4rme abgegeben)' : '(W\u00E4rme aufgenommen)';
      document.getElementById('wude-kj')!.textContent = (q/1000).toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      document.getElementById('wude-btu')!.textContent = (q/1055.06).toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      document.getElementById('wude-kcal')!.textContent = (q/4184).toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      document.getElementById('wude-dt')!.textContent = dt.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '\u00B0C';
      document.getElementById('wude-sh')!.textContent = c + ' J/kg\u00B7\u00B0C';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.wude-in').forEach(el => { el.addEventListener('input', calcWUDE); el.addEventListener('change', calcWUDE); });
      calcWUDE();
    }, 50);
  </script>
</CalculatorLayout>
