---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Netzwerk Verfügbarkeit Rechner - Uptime, Ausfallzeit & SLA";
const description = "Berechnen Sie Uptime, Ausfallzeit und SLA-Verfügbarkeit (99,9%, 99,99% etc.) für Ihre IT-Infrastruktur.";
const relatedCalcs = [
  { name: "Netzwerk-Latenz Rechner", url: "/de/netzwerk-latenz-rechner", description: "Latenz berechnen." },
  { name: "Netzwerk-Durchsatz Rechner", url: "/de/netzwerk-durchsatz-rechner", description: "Durchsatz berechnen." },
  { name: "Netzeinspeisung Rechner", url: "/de/netzeinspeisung-rechner", description: "Solar-Ersparnisse." },
  { name: "Akkulaufzeit Rechner", url: "/de/akkulaufzeit-rechner", description: "Akkulaufzeit berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Netzwerk Verfügbarkeit Rechner" enSlug="network-availability-calculator" keywords="Netzwerk Verfügbarkeit, Uptime, SLA, 99,9 Prozent, Ausfallzeit, Hochverfügbarkeit, MTTR MTBF" breadcrumbs={[{ name: "Netzwerk Verfügbarkeit Rechner", url: "/de/netzwerk-verfuegbarkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Netzwerk Verfügbarkeit Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie erlaubte Ausfallzeiten für SLA-Klassen und analysieren Sie MTBF/MTTR-Kennzahlen Ihrer Systeme.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">SLA-Klasse (Vorauswahl)</label>
          <select id="nva-sla" class="nva-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="99">99% (zwei Neunen)</option>
            <option value="99.9" selected>99,9% (drei Neunen)</option>
            <option value="99.99">99,99% (vier Neunen)</option>
            <option value="99.999">99,999% (fünf Neunen)</option>
            <option value="99.9999">99,9999% (sechs Neunen)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Benutzerdefinierte Verfügbarkeit (%)</label><input type="number" id="nva-custom" class="nva-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="99.9" min="0" max="100" step="0.001"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">MTBF (Stunden)</label><input type="number" id="nva-mtbf" class="nva-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">MTTR (Stunden)</label><input type="number" id="nva-mttr" class="nva-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0.1" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">SLA-Verfügbarkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="nva-result">99,900 %</div>
          <div class="text-sm text-blue-200 mt-1" id="nva-sub"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Erlaubte Ausfallzeit</h3>
          <div class="grid grid-cols-2 gap-2 text-sm" id="nva-downtimes"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MTBF-Verfügbarkeit</div><div class="text-xl font-bold" id="nva-mtbfavail">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ausfallrate (λ)</div><div class="text-xl font-bold" id="nva-failrate">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="netzwerk-verfuegbarkeit" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">SLA-Verfügbarkeit und Hochverfügbarkeit</h2>
      <p>Die Verfügbarkeit von IT-Systemen wird in Prozent gemessen. 99,9% klingt hoch, erlaubt aber noch 8,77 Stunden Ausfall pro Jahr. Hochverfügbare Systeme (99,99%) dürfen maximal 52 Minuten pro Jahr ausfallen. Fünf Neunen (99,999%) bedeuten nur 5,26 Minuten Ausfall pro Jahr.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was bedeutet MTBF?</strong></p><p>MTBF (Mean Time Between Failures) ist die mittlere Zeit zwischen zwei Ausfällen. Ein hoher MTBF bedeutet ein zuverlässigeres System.</p></div>
        <div><p><strong>Was bedeutet MTTR?</strong></p><p>MTTR (Mean Time To Repair) ist die durchschnittliche Zeit, um ein ausgefallenes System wiederherzustellen. Kurzes MTTR ist entscheidend für hohe Verfügbarkeit.</p></div>
        <div><p><strong>Wie berechnet man die Verfügbarkeit?</strong></p><p>Verfügbarkeit = MTBF / (MTBF + MTTR). Bei MTBF = 1000 h und MTTR = 4 h ergibt sich 1000/1004 = 99,60%.</p></div>
        <div><p><strong>Was ist ein SLA?</strong></p><p>Ein SLA (Service Level Agreement) ist ein Vertrag, der die zugesicherte Verfügbarkeit eines Dienstes festlegt. Bei Unterschreitung können Vertragsstrafen anfallen.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcNVA() {
      const slaPreset = (document.getElementById('nva-sla') as HTMLSelectElement).value;
      const customVal = parseFloat((document.getElementById('nva-custom') as HTMLInputElement).value) || 99.9;
      const avail = slaPreset === 'custom' ? customVal : parseFloat(slaPreset);
      const mtbf = parseFloat((document.getElementById('nva-mtbf') as HTMLInputElement).value) || 1000;
      const mttr = parseFloat((document.getElementById('nva-mttr') as HTMLInputElement).value) || 4;
      const unavail = 1 - avail / 100;
      const periods: [string, number][] = [
        ['Pro Tag', 24],
        ['Pro Woche', 24 * 7],
        ['Pro Monat', 24 * 30.44],
        ['Pro Jahr', 24 * 365.25],
      ];
      function fmtDuration(h: number): string {
        if (h < 1/60) return (h * 3600).toLocaleString('de-DE', {maximumFractionDigits: 1}) + ' Sek.';
        if (h < 1) return (h * 60).toLocaleString('de-DE', {maximumFractionDigits: 1}) + ' Min.';
        if (h < 24) return h.toLocaleString('de-DE', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Std.';
        return (h / 24).toLocaleString('de-DE', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Tage';
      }
      const mtbfAvail = mtbf / (mtbf + mttr) * 100;
      const failRate = 1 / mtbf;
      document.getElementById('nva-result')!.textContent = avail.toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 5 }) + ' %';
      document.getElementById('nva-sub')!.textContent = 'Ausfallzeit/Jahr: ' + fmtDuration(unavail * 8760);
      document.getElementById('nva-downtimes')!.innerHTML = periods.map(([label, hours]) => {
        const dt = unavail * hours;
        return '<div class="text-text-muted">' + label + '</div><div class="font-bold">' + fmtDuration(dt) + '</div>';
      }).join('');
      document.getElementById('nva-mtbfavail')!.textContent = mtbfAvail.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
      document.getElementById('nva-failrate')!.textContent = failRate.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 6 }) + '/h';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.nva-in').forEach(el => { el.addEventListener('input', calcNVA); el.addEventListener('change', calcNVA); });
      (document.getElementById('nva-sla') as HTMLSelectElement).addEventListener('change', function() {
        if (this.value !== 'custom') {
          (document.getElementById('nva-custom') as HTMLInputElement).value = this.value;
        }
        calcNVA();
      });
      calcNVA();
    }, 50);
  </script>
</CalculatorLayout>
