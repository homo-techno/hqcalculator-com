---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Cashflow-Rechner – Einnahmen & Ausgaben im Überblick";
const description = "Berechnen Sie Ihren monatlichen und jährlichen Cashflow aus Einnahmen und Ausgaben. Ermitteln Sie Ihre Sparquote.";
const relatedCalcs = [
  { name: "Cashback-Rechner", url: "/de/cashback-rechner", description: "Cashback." },
  { name: "Eigenkapitalrendite-Rechner", url: "/de/eigenkapitalrendite-rechner", description: "Rendite." },
  { name: "Festgeld-Rechner", url: "/de/festgeld-rechner", description: "Festgeld." },
  { name: "CO₂-Steuer-Rechner", url: "/de/co2-steuer-rechner", description: "CO₂-Steuer." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Cashflow-Rechner" enSlug="cash-flow-calculator" keywords="Cashflow Rechner, Einnahmen Ausgaben, monatlicher Cashflow, Sparquote, Finanzplanung" breadcrumbs={[{ name: "Cashflow-Rechner", url: "/de/cashflow-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Cashflow-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie monatliche Einnahmen mit Ausgaben und ermitteln Sie Ihren Netto-Cashflow.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-sm text-text">Monatliche Einnahmen</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gehalt / Lohn (€)</label><input type="number" id="cfr-salary" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nebeneinkünfte (€)</label><input type="number" id="cfr-side" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Mieteinnahmen (€)</label><input type="number" id="cfr-rental" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstige Einnahmen (€)</label><input type="number" id="cfr-other-in" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
        </div>
        <h3 class="font-semibold text-sm text-text">Monatliche Ausgaben</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wohnen (€)</label><input type="number" id="cfr-housing" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nebenkosten (€)</label><input type="number" id="cfr-util" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lebensmittel (€)</label><input type="number" id="cfr-food" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Mobilität (€)</label><input type="number" id="cfr-transport" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versicherungen (€)</label><input type="number" id="cfr-ins" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kredite / Schulden (€)</label><input type="number" id="cfr-debt" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Freizeit (€)</label><input type="number" id="cfr-ent" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstige Ausgaben (€)</label><input type="number" id="cfr-other-ex" class="cfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="25"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatlicher Cashflow</div>
          <div class="text-5xl font-extrabold font-mono" id="cfr-result">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einnahmen gesamt</div><div class="text-xl font-bold font-mono" id="cfr-inc">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ausgaben gesamt</div><div class="text-xl font-bold font-mono" id="cfr-exp">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährlicher Cashflow</div><div class="text-xl font-bold font-mono" id="cfr-annual">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sparquote</div><div class="text-xl font-bold font-mono" id="cfr-rate">0%</div></div>
          <div class="p-4 rounded-xl text-center" id="cfr-status-box"><div class="font-bold text-sm" id="cfr-status">-</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cash-flow" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Cashflow-Management</h2>
      <p>Ein positiver Cashflow ist die Grundlage für Vermögensaufbau. Finanzexperten empfehlen eine Sparquote von mindestens 20% des Nettoeinkommens.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCFR() {
      const salary = parseFloat((document.getElementById('cfr-salary') as HTMLInputElement).value) || 0;
      const side = parseFloat((document.getElementById('cfr-side') as HTMLInputElement).value) || 0;
      const rental = parseFloat((document.getElementById('cfr-rental') as HTMLInputElement).value) || 0;
      const otherIn = parseFloat((document.getElementById('cfr-other-in') as HTMLInputElement).value) || 0;
      const housing = parseFloat((document.getElementById('cfr-housing') as HTMLInputElement).value) || 0;
      const util = parseFloat((document.getElementById('cfr-util') as HTMLInputElement).value) || 0;
      const food = parseFloat((document.getElementById('cfr-food') as HTMLInputElement).value) || 0;
      const transport = parseFloat((document.getElementById('cfr-transport') as HTMLInputElement).value) || 0;
      const ins = parseFloat((document.getElementById('cfr-ins') as HTMLInputElement).value) || 0;
      const debt = parseFloat((document.getElementById('cfr-debt') as HTMLInputElement).value) || 0;
      const ent = parseFloat((document.getElementById('cfr-ent') as HTMLInputElement).value) || 0;
      const otherEx = parseFloat((document.getElementById('cfr-other-ex') as HTMLInputElement).value) || 0;
      const totalIncome = salary + side + rental + otherIn;
      const totalExpenses = housing + util + food + transport + ins + debt + ent + otherEx;
      const cashFlow = totalIncome - totalExpenses;
      const savingsRate = totalIncome > 0 ? (cashFlow / totalIncome) * 100 : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', {minimumFractionDigits:0, maximumFractionDigits:0});
      document.getElementById('cfr-result')!.textContent = (cashFlow >= 0 ? '+' : '-') + fmt(Math.abs(cashFlow)) + ' €';
      document.getElementById('cfr-inc')!.textContent = fmt(totalIncome) + ' €';
      document.getElementById('cfr-exp')!.textContent = fmt(totalExpenses) + ' €';
      document.getElementById('cfr-annual')!.textContent = (cashFlow >= 0 ? '+' : '-') + fmt(Math.abs(cashFlow * 12)) + ' €';
      document.getElementById('cfr-rate')!.textContent = savingsRate.toFixed(1) + '%';
      let status: string, color: string;
      if (cashFlow > 0 && savingsRate >= 20) { status = 'Ausgezeichneter Cashflow!'; color = 'bg-green-50 text-green-800'; }
      else if (cashFlow > 0) { status = 'Positiv — 20%+ Sparquote anstreben'; color = 'bg-blue-50 text-blue-800'; }
      else if (cashFlow === 0) { status = 'Ausgeglichen'; color = 'bg-yellow-50 text-yellow-800'; }
      else { status = 'Negativer Cashflow — Ausgaben prüfen'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('cfr-status')!.textContent = status;
      document.getElementById('cfr-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cfr-salary') as HTMLInputElement).value = '3500';
      (document.getElementById('cfr-side') as HTMLInputElement).value = '300';
      (document.getElementById('cfr-rental') as HTMLInputElement).value = '0';
      (document.getElementById('cfr-other-in') as HTMLInputElement).value = '0';
      (document.getElementById('cfr-housing') as HTMLInputElement).value = '900';
      (document.getElementById('cfr-util') as HTMLInputElement).value = '200';
      (document.getElementById('cfr-food') as HTMLInputElement).value = '400';
      (document.getElementById('cfr-transport') as HTMLInputElement).value = '200';
      (document.getElementById('cfr-ins') as HTMLInputElement).value = '250';
      (document.getElementById('cfr-debt') as HTMLInputElement).value = '150';
      (document.getElementById('cfr-ent') as HTMLInputElement).value = '200';
      (document.getElementById('cfr-other-ex') as HTMLInputElement).value = '200';
      document.querySelectorAll('.cfr-in').forEach(el => { el.addEventListener('input', calcCFR); el.addEventListener('change', calcCFR); });
      calcCFR();
    }, 50);
  </script>
</CalculatorLayout>
