---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kindergroesse-Rechner - Erwachsenengroesse vorhersagen";
const description = "Sagen Sie die Erwachsenengroesse Ihres Kindes mit der Elterngroessen-Methode vorher. Nutzt die Groesse beider Eltern und aktuelle Masse.";
const relatedCalcs = [
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI-Perzentile." },
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Tagesnaehrstoffe." },
  { name: "Kinderdosierung-Rechner", url: "/de/kinderdosierung-rechner", description: "Medikamentendosierung." },
  { name: "Kindesunterhalt-Rechner", url: "/de/kindesunterhalt-rechner", description: "Unterhalt." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kindergroesse-Rechner" enSlug="child-height-calculator" keywords="Kindergroesse, Erwachsenengroesse vorhersagen, wie gross wird mein Kind, Elterngroessen-Methode, Wachstumsprognose" breadcrumbs={[{ name: "Kindergroesse-Rechner", url: "/de/kindergroesse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kindergroesse-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sagen Sie die Erwachsenengroesse Ihres Kindes mit der Elterngroessen-Formel vorher.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Geschlecht des Kindes</label>
          <select id="kg-gender" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="boy">Junge</option>
            <option value="girl">Maedchen</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Aktuelles Alter (Jahre)</label><input type="number" id="kg-age" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="2" max="17" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Aktuelle Groesse des Kindes (cm)</label><input type="number" id="kg-cheight" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="110" min="50" max="200" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Groesse des Vaters (cm)</label><input type="number" id="kg-dheight" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="178" min="140" max="220" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Groesse der Mutter (cm)</label><input type="number" id="kg-mheight" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="165" min="130" max="200" step="1"></div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Vorhergesagte Erwachsenengroesse</div>
        <div class="text-5xl font-extrabold" id="kg-result">--</div>
        <div class="text-sm text-blue-200 mt-1" id="kg-range">vorhergesagter Bereich</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eltern-Zielgroesse</div><div class="text-lg font-bold" id="kg-midparent">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbleibendes Wachstum</div><div class="text-lg font-bold" id="kg-remaining">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktuelles Perzentil</div><div class="text-lg font-bold" id="kg-percentile">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wachstum % abgeschlossen</div><div class="text-lg font-bold" id="kg-complete">--</div></div>
      </div>
      <ShareButton lang="de" calculatorId="kindergroesse" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Erwachsenengroesse vorhersagen</h2>
      <p>Die Elterngroessen-Methode ist das am haeufigsten verwendete Vorhersagewerkzeug. Fuer Jungen: 13 cm zur Muttergroesse addieren, Mittelwert mit Vatergroesse bilden. Fuer Maedchen: 13 cm von der Vatergroesse abziehen, Mittelwert mit Muttergroesse bilden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Einflussfaktoren auf die Koerpergroesse</h3>
      <ul>
        <li><strong>Genetik:</strong> 60-80% der Groesse sind genetisch bestimmt</li>
        <li><strong>Ernaehrung:</strong> Ausgewogene Ernaehrung in Wachstumsjahren ist essentiell</li>
        <li><strong>Schlaf:</strong> Wachstumshormon wird hauptsaechlich im Tiefschlaf ausgeschuettet</li>
        <li><strong>Gesundheit:</strong> Chronische Krankheiten koennen das Wachstum beeinflussen</li>
      </ul>
      <p class="mt-4">Die Genauigkeit liegt bei etwa +/- 5 cm. Fuer genauere Vorhersagen kann der Kinderarzt Roentgenaufnahmen des Handgelenks zur Knochenalterbestimmung nutzen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKG() {
      const gender = (document.getElementById('kg-gender') as HTMLSelectElement).value;
      const age = parseFloat((document.getElementById('kg-age') as HTMLInputElement).value) || 5;
      const childCm = parseFloat((document.getElementById('kg-cheight') as HTMLInputElement).value) || 110;
      const dadCm = parseFloat((document.getElementById('kg-dheight') as HTMLInputElement).value) || 178;
      const momCm = parseFloat((document.getElementById('kg-mheight') as HTMLInputElement).value) || 165;
      let midParent: number;
      if (gender === 'boy') midParent = (dadCm + momCm + 13) / 2;
      else midParent = (dadCm - 13 + momCm) / 2;
      const pctByAge: Record<string, number[]> = {
        boy:  [0,0,0.49,0.52,0.55,0.58,0.61,0.64,0.67,0.70,0.73,0.76,0.80,0.84,0.88,0.93,0.97,0.99],
        girl: [0,0,0.52,0.55,0.59,0.62,0.65,0.68,0.72,0.76,0.80,0.84,0.88,0.93,0.97,0.99,1.0,1.0],
      };
      const ageIdx = Math.min(Math.max(Math.round(age), 2), 17);
      const pct = pctByAge[gender][ageIdx];
      const predictedFromCurrent = childCm / pct;
      const predicted = (midParent + predictedFromCurrent) / 2;
      const remaining = Math.max(0, predicted - childCm);
      const growthPct = Math.min(100, Math.round((childCm / predicted) * 100));
      const avgBoy = 175.3, avgGirl = 162.0;
      const avg = gender === 'boy' ? avgBoy : avgGirl;
      const diff = predicted - avg;
      let percentile = 50 + diff * 3;
      percentile = Math.max(1, Math.min(99, Math.round(percentile)));
      document.getElementById('kg-result')!.textContent = Math.round(predicted) + ' cm';
      document.getElementById('kg-range')!.textContent = Math.round(predicted - 5) + ' - ' + Math.round(predicted + 5) + ' cm (+/- 5 cm)';
      document.getElementById('kg-midparent')!.textContent = Math.round(midParent) + ' cm';
      document.getElementById('kg-remaining')!.textContent = Math.round(remaining) + ' cm';
      document.getElementById('kg-percentile')!.textContent = percentile + '. Perzentil';
      document.getElementById('kg-complete')!.textContent = growthPct + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kg-in').forEach(el => { el.addEventListener('input', calcKG); el.addEventListener('change', calcKG); });
      calcKG();
    }, 50);
  </script>
</CalculatorLayout>
