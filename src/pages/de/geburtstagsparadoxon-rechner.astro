---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Geburtstagsparadoxon-Rechner - Wahrscheinlichkeit gleicher Geburtstage";
const description = "Berechnen Sie die Wahrscheinlichkeit, dass zwei oder mehr Personen in einer Gruppe den gleichen Geburtstag haben. Finden Sie die kritische Gruppengr\u00f6\u00dfe f\u00fcr 50%- und 99%-Schwellenwerte.";
const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/probability-calculator", description: "Allgemeine Wahrscheinlichkeit." },
  { name: "Statistik-Rechner", url: "/statistics-calculator", description: "Statistische Analyse." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozentrechnung." },
  { name: "Kombinationsrechner", url: "/permutation-combination-calculator", description: "Kombinationen." },
  { name: "Standardabweichung", url: "/standard-deviation-calculator", description: "Streuungsanalyse." },
  { name: "Stichprobengr\u00f6\u00dfe", url: "/sample-size-calculator", description: "Stichprobenplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Geburtstagsparadoxon-Rechner" lang="de" keywords="geburtstagsparadoxon, geburtstagsproblem, gleicher geburtstag wahrscheinlichkeit, kollisionswahrscheinlichkeit, gruppengr\u00f6\u00dfe rechner" breadcrumbs={[{ name: "Geburtstagsparadoxon-Rechner", url: "/de/geburtstagsparadoxon-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Geburtstagsparadoxon-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die Wahrscheinlichkeit, dass mindestens zwei Personen in einer Gruppe den gleichen Geburtstag haben, und entdecken Sie die &uuml;berraschend kleinen Gruppengr&ouml;&szlig;en.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Anzahl Personen in der Gruppe</label>
          <input type="number" class="bp2-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="bp2-people" min="2" max="365" value="23">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Tage im Jahr (m&ouml;gliche Geburtstage)</label>
          <input type="number" class="bp2-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="bp2-days" min="2" max="10000" value="365">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wahrscheinlichkeit eines gleichen Geburtstags</div>
          <div class="text-5xl font-extrabold font-mono" id="bp2-prob">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">P(Kein Treffer)</div><div class="text-xl font-bold font-mono" id="bp2-nomatch">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erwartete Paare</div><div class="text-xl font-bold font-mono" id="bp2-pairs">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gruppe f&uuml;r 50%</div><div class="text-xl font-bold font-mono" id="bp2-fifty">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gruppe f&uuml;r 99%</div><div class="text-xl font-bold font-mono" id="bp2-ninety">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Wahrscheinlichkeit nach Gruppengr&ouml;&szlig;e</h3>
          <div class="text-xs font-mono space-y-1" id="bp2-table"></div>
        </div>
      </div>
      <ShareButton calculatorId="birthday-paradox" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Geburtstagsparadoxon verstehen</h2>
      <p>Das Geburtstagsparadoxon zeigt, dass in einer Gruppe von nur 23 Personen eine 50,7%ige Wahrscheinlichkeit besteht, dass mindestens zwei den gleichen Geburtstag haben. Dies ist kontraintuitiv, weil wir Paare vergleichen, nicht Individuen. Bei 23 Personen gibt es 253 m&ouml;gliche Paare, was einen Treffer &uuml;berraschend wahrscheinlich macht.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>P(Treffer):</strong> 1 - (364/365) &times; (363/365) &times; ... &times; ((365-n+1)/365)</p>
        <p><strong>N&auml;herung:</strong> 1 - e^(-n(n-1)/(2 &times; 365))</p>
        <p><strong>50%-Schwelle:</strong> ~23 Personen</p>
        <p><strong>99%-Schwelle:</strong> ~57 Personen</p>
      </div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBP2() {
      const n = parseInt((document.getElementById('bp2-people') as HTMLInputElement).value) || 2;
      const d = parseInt((document.getElementById('bp2-days') as HTMLInputElement).value) || 365;
      let pNoMatch = 1;
      const clampN = Math.min(n, d);
      for (let i = 1; i < clampN; i++) {
        pNoMatch *= (d - i) / d;
      }
      const pMatch = 1 - pNoMatch;
      const totalPairs = (n * (n - 1)) / 2;
      const expectedPairs = totalPairs / d;
      function groupForProb(target: number): number {
        let p = 1;
        for (let i = 1; i < d; i++) {
          p *= (d - i) / d;
          if (1 - p >= target) return i + 1;
        }
        return d + 1;
      }
      const fifty = groupForProb(0.5);
      const ninety9 = groupForProb(0.99);
      document.getElementById('bp2-prob')!.textContent = (pMatch * 100).toFixed(2).replace('.', ',') + '%';
      document.getElementById('bp2-nomatch')!.textContent = (pNoMatch * 100).toFixed(4).replace('.', ',') + '%';
      document.getElementById('bp2-pairs')!.textContent = expectedPairs.toFixed(2).replace('.', ',');
      document.getElementById('bp2-fifty')!.textContent = fifty + ' Personen';
      document.getElementById('bp2-ninety')!.textContent = ninety9 + ' Personen';
      const sizes = [5, 10, 15, 20, 23, 30, 40, 50, 57, 70, 100];
      let html = '';
      for (const s of sizes) {
        if (s > d) break;
        let p = 1;
        for (let i = 1; i < s; i++) p *= (d - i) / d;
        const marker = s === n ? ' font-bold text-primary' : '';
        html += '<div class="flex justify-between py-0.5 border-b border-border' + marker + '"><span>' + s + ' Personen</span><span>' + ((1 - p) * 100).toFixed(2).replace('.', ',') + '%</span></div>';
      }
      document.getElementById('bp2-table')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bp2-in').forEach(el => { el.addEventListener('input', calcBP2); el.addEventListener('change', calcBP2); });
      calcBP2();
    }, 50);
  </script>
</CalculatorLayout>
