---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Alkoholeinheiten-Rechner - Einheiten, Kalorien & Standardgetränke";
const description = "Berechnen Sie Alkoholeinheiten, Kalorien und Standardgetränke aus Getränketyp, Volumen und Alkoholgehalt. Vergleich mit Wochenlimits.";
const relatedCalcs = [
  { name: "Alkohol-Kalorienrechner", url: "/alcohol-calorie-calculator", description: "Getränke-Kalorien." },
  { name: "Kalorienrechner", url: "/calorie-calculator", description: "Täglicher Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Trinkwasserrechner", url: "/hydration-calculator", description: "Wasserbedarf." },
  { name: "Raucherkosten", url: "/smoking-cost-calculator", description: "Kosten des Rauchens." },
  { name: "Makro-Rechner", url: "/macro-calculator", description: "Makronährstoffe." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Alkoholeinheiten-Rechner" keywords="Alkoholeinheiten, Standardgetränke, Alkohol Kalorien, Wochenlimit, Alkoholgehalt, Getränkeeinheiten" breadcrumbs={[{ name: "Alkoholeinheiten", url: "/de/alkoholeinheiten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Alkoholeinheiten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Alkoholeinheiten, Kalorien und Standardgetränke für jedes Getränk.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Getränketyp</label>
          <select id="au-type" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="330,5" selected>Bier (330ml, 5%)</option>
            <option value="500,5">Großes Bier (500ml, 5%)</option>
            <option value="175,13">Weinglas (175ml, 13%)</option>
            <option value="250,13">Großes Weinglas (250ml, 13%)</option>
            <option value="20,40">Schnaps einfach (20ml, 40%)</option>
            <option value="40,40">Schnaps doppelt (40ml, 40%)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Volumen (ml)</label><input type="number" id="au-vol" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="330" min="1" max="5000" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Alkoholgehalt (%)</label><input type="number" id="au-abv" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="100" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Menge</label><input type="number" id="au-qty" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="50" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Alkoholeinheiten</div>
          <div class="text-5xl font-extrabold font-mono" id="au-units">0</div>
          <div class="text-sm text-blue-200 mt-1" id="au-perwk"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien</div><div class="text-xl font-bold" id="au-cals">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Standardgetränke</div><div class="text-xl font-bold" id="au-std">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wochenlimit %</div><div class="text-xl font-bold" id="au-wklim">0%</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Wochenlimits</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>UK-Richtlinie</span><span class="font-bold">14 Einheiten/Woche</span></div>
            <div class="flex justify-between"><span>Deutsche Richtlinie (Männer)</span><span class="font-bold">~24g Reinalkohol/Tag</span></div>
            <div class="flex justify-between"><span>Deutsche Richtlinie (Frauen)</span><span class="font-bold">~12g Reinalkohol/Tag</span></div>
            <div class="flex justify-between"><span>1 UK-Einheit</span><span class="font-bold">10 mL reiner Alkohol</span></div>
            <div class="flex justify-between"><span>1 Standardgetränk (DE)</span><span class="font-bold">~10g reiner Alkohol</span></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="alcohol-unit" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Alkoholeinheiten verstehen</h2>
      <p>Eine UK-Alkoholeinheit entspricht 10 mL (8g) reinem Alkohol. Einheiten = Volumen (mL) x Vol.-% / 1000. Ein deutsches Standardgetränk enthält etwa 10g reinen Alkohol. Die Deutsche Hauptstelle für Suchtfragen empfiehlt für Männer maximal 24g und für Frauen maximal 12g reinen Alkohol pro Tag, mit mindestens 2 alkoholfreien Tagen pro Woche.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function setDrinkType() {
      const val = (document.getElementById('au-type') as HTMLSelectElement).value;
      if (val !== 'custom') {
        const p = val.split(',');
        (document.getElementById('au-vol') as HTMLInputElement).value = p[0];
        (document.getElementById('au-abv') as HTMLInputElement).value = p[1];
      }
      calcAU();
    }
    function calcAU() {
      const vol = parseFloat((document.getElementById('au-vol') as HTMLInputElement).value) || 0;
      const abv = parseFloat((document.getElementById('au-abv') as HTMLInputElement).value) || 0;
      const qty = parseInt((document.getElementById('au-qty') as HTMLInputElement).value) || 1;
      const unitsEach = (vol * abv) / 1000;
      const totalUnits = unitsEach * qty;
      const pureAlcMl = vol * (abv / 100) * qty;
      const pureAlcG = pureAlcMl * 0.789;
      const cals = Math.round(pureAlcG * 7);
      const stdDrinks = pureAlcG / 10;
      const wkPct = (totalUnits / 14) * 100;
      document.getElementById('au-units')!.textContent = totalUnits.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('au-perwk')!.textContent = totalUnits.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' von 14 Wocheneinheiten';
      document.getElementById('au-cals')!.textContent = cals.toLocaleString('de-DE');
      document.getElementById('au-std')!.textContent = stdDrinks.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('au-wklim')!.textContent = wkPct.toFixed(0) + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('au-type')!.addEventListener('change', setDrinkType);
      document.querySelectorAll('.au-in').forEach(el => { el.addEventListener('input', calcAU); el.addEventListener('change', calcAU); });
      calcAU();
    }, 50);
  </script>
</CalculatorLayout>
