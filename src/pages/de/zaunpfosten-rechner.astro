---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zaunpfosten-Rechner - Pfosten, Riegel, Latten & Material";
const description = "Berechnen Sie Zaunpfosten, Riegel, Latten und Materialien für jede Zaunlänge. Inklusive Kostenschätzung.";
const relatedCalcs = [
  { name: "Zaunlinie-Rechner", url: "/de/zaunlinie-rechner", description: "Zaunlinie planen." },
  { name: "Zaun-Rechner", url: "/de/zaun-rechner", description: "Zaun-Materialschätzung." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
  { name: "Feuerstelle-Rechner", url: "/de/feuerstelle-rechner", description: "Feuerstellen-Material." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Zaunpfosten-Rechner" lang="de" enSlug="fence-post-calculator" keywords="zaunpfosten rechner, zaun pfosten, zaun latten, zaun kosten, zaun materialien, zaun riegel" breadcrumbs={[{ name: "Zaunpfosten", url: "/de/zaunpfosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zaunpfosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Materialien für Ihr Zaunprojekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zaunlänge (m)</label><input type="number" id="zpde-len" class="zpde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="30" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zaunhöhe</label>
            <select id="zpde-ht" class="zpde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold">
              <option value="1.2">1,2 m</option>
              <option value="1.8" selected>1,8 m</option>
              <option value="2.4">2,4 m</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Pfostenabstand (m)</label><input type="number" id="zpde-space" class="zpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="1" max="4" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Riegel pro Sektion</label>
            <select id="zpde-rails" class="zpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="2">2 Riegel</option>
              <option value="3" selected>3 Riegel</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Zaunstil</label>
          <select id="zpde-style" class="zpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="picket" selected>Holzlatten</option>
            <option value="privacy">Sichtschutz (Bretter)</option>
            <option value="chain">Maschendraht</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Pfosten</div>
          <div class="text-5xl font-extrabold font-mono" id="zpde-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sektionen</div><div class="text-xl font-bold font-mono" id="zpde-sections">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Riegel</div><div class="text-xl font-bold font-mono" id="zpde-railcount">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Latten</div><div class="text-xl font-bold font-mono" id="zpde-pickets">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beton (S&auml;cke)</div><div class="text-xl font-bold font-mono" id="zpde-concrete">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Kosten</div><div class="text-xl font-bold font-mono" id="zpde-cost">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fence-post-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zaunpfosten berechnen</h2>
      <p>Pfosten werden typischerweise alle 2-3 Meter gesetzt. Jede Sektion ben&ouml;tigt 2-3 horizontale Riegel.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie tief müssen Zaunpfosten eingesetzt werden?</strong> Mindestens ein Drittel der Gesamtlänge des Pfostens sollte im Boden sein, typischerweise 60-80 cm.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcZPDE() {
      const len = parseFloat((document.getElementById('zpde-len') as HTMLInputElement).value) || 0;
      const ht = parseFloat((document.getElementById('zpde-ht') as HTMLSelectElement).value);
      const spacing = parseFloat((document.getElementById('zpde-space') as HTMLInputElement).value) || 2.5;
      const railsPerSection = parseInt((document.getElementById('zpde-rails') as HTMLSelectElement).value);
      const style = (document.getElementById('zpde-style') as HTMLSelectElement).value;
      const sections = Math.ceil(len / spacing);
      const posts = sections + 1;
      const rails = sections * railsPerSection;
      const picketWidthCm = style === 'privacy' ? 14 : 9;
      const picketGapCm = style === 'privacy' ? 0 : 5;
      const pickets = style === 'chain' ? 0 : Math.ceil(len * 100 / (picketWidthCm + picketGapCm));
      const concreteBags = posts * (ht >= 2.4 ? 3 : 2);
      const postCost = posts * (ht <= 1.2 ? 10 : ht <= 1.8 ? 15 : 22);
      const railCost = rails * 8;
      const picketCost = pickets * 2.5;
      const chainCost = style === 'chain' ? len * 15 : 0;
      const concreteCost = concreteBags * 5;
      const totalCost = postCost + railCost + picketCost + chainCost + concreteCost;
      document.getElementById('zpde-result')!.textContent = posts.toString();
      document.getElementById('zpde-sections')!.textContent = sections.toString();
      document.getElementById('zpde-railcount')!.textContent = rails.toString();
      document.getElementById('zpde-pickets')!.textContent = style === 'chain' ? 'N/A' : pickets.toLocaleString('de-DE');
      document.getElementById('zpde-concrete')!.textContent = concreteBags.toString();
      document.getElementById('zpde-cost')!.textContent = Math.round(totalCost).toLocaleString('de-DE') + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zpde-in').forEach(el => { el.addEventListener('input', calcZPDE); el.addEventListener('change', calcZPDE); });
      calcZPDE();
    }, 50);
  </script>
</CalculatorLayout>
