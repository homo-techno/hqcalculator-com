---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Elastizität-Rechner - Elastizitätsmodul, Spannung & Dehnung";
const description = "Berechnen Sie den Elastizitätsmodul (E-Modul), die mechanische Spannung und Dehnung nach dem Hookeschen Gesetz für verschiedene Materialien.";

const relatedCalcs = [
  { name: "Spannungsrechner", url: "/de/spannungsrechner", description: "Mechanische Spannung." },
  { name: "Kraftrechner", url: "/de/kraftrechner", description: "Kräfte berechnen." },
  { name: "Balkenrechner", url: "/de/balkenrechner", description: "Balken dimensionieren." },
  { name: "Druckrechner", url: "/de/druckrechner", description: "Druck berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Elastizität-Rechner" lang="de" enSlug="elastic-calculator" keywords="elastizitätsmodul, e-modul rechner, hookesches gesetz, spannung dehnung, youngs modul" breadcrumbs={[{ name: "Elastizität-Rechner", url: "/de/elastizitaet-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Elastizit&auml;t-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Elastizit&auml;tsmodul, Spannung und Dehnung nach dem Hookeschen Gesetz.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Berechne</label><select id="ela-solve" class="ela-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="modulus">Elastizit&auml;tsmodul (E)</option><option value="stress">Spannung (&sigma;)</option><option value="strain">Dehnung (&epsilon;)</option></select></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kraft (N)</label><input type="number" id="ela-force" class="ela-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Querschnitt (mm&sup2;)</label><input type="number" id="ela-area" class="ela-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ursprungsl&auml;nge (mm)</label><input type="number" id="ela-length" class="ela-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">L&auml;ngen&auml;nderung (mm)</label><input type="number" id="ela-delta" class="ela-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.01" min="0"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">E-Modul (GPa) &mdash; bei Bedarf</label><input type="number" id="ela-emod" class="ela-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="ela-label">Ergebnis</div>
          <div class="text-5xl font-extrabold font-mono" id="ela-result">&mdash;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spannung (MPa)</div><div class="text-xl font-bold" id="ela-stress">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dehnung</div><div class="text-xl font-bold" id="ela-strain">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">E-Modul (GPa)</div><div class="text-xl font-bold" id="ela-mod">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dehnung (%)</div><div class="text-xl font-bold" id="ela-strainpct">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="ela-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="elastic-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Hookesches Gesetz &amp; Elastizit&auml;tsmodul</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>&sigma; = F / A (Spannung = Kraft / Fl&auml;che)</p>
        <p>&epsilon; = &Delta;L / L (Dehnung = L&auml;ngen&auml;nderung / Ursprungsl&auml;nge)</p>
        <p>E = &sigma; / &epsilon; (Elastizit&auml;tsmodul = Spannung / Dehnung)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Elastizit&auml;tsmodul?</strong> Der E-Modul beschreibt die Steifigkeit eines Materials &ndash; je h&ouml;her, desto steifer. Stahl hat ca. 210 GPa, Aluminium ca. 70 GPa.</p>
      <p><strong>Gilt das Hookesche Gesetz immer?</strong> Nur im linear-elastischen Bereich, also bis zur Proportionalit&auml;tsgrenze des Materials.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEla() {
      const solve = (document.getElementById('ela-solve') as HTMLSelectElement).value;
      const force = parseFloat((document.getElementById('ela-force') as HTMLInputElement).value) || 0;
      const area = parseFloat((document.getElementById('ela-area') as HTMLInputElement).value) || 0;
      const length = parseFloat((document.getElementById('ela-length') as HTMLInputElement).value) || 0;
      const delta = parseFloat((document.getElementById('ela-delta') as HTMLInputElement).value) || 0;
      const emod = parseFloat((document.getElementById('ela-emod') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      let stress = 0, strain = 0, modulus = 0;
      if (area > 0) { stress = force / area; steps.push('Spannung = ' + force + ' N / ' + area + ' mm2 = ' + fmt(stress) + ' MPa'); }
      if (length > 0) { strain = delta / length; steps.push('Dehnung = ' + fmt(delta) + ' / ' + fmt(length) + ' = ' + strain.toExponential(4)); }
      if (solve === 'modulus' && strain > 0) {
        modulus = stress / strain / 1000;
        steps.push('E-Modul = ' + fmt(stress) + ' MPa / ' + strain.toExponential(4) + ' = ' + fmt(modulus) + ' GPa');
      } else if (solve === 'stress' && emod > 0) {
        stress = emod * 1000 * strain;
        steps.push('Spannung = ' + fmt(emod) + ' GPa x ' + strain.toExponential(4) + ' = ' + fmt(stress) + ' MPa');
        modulus = emod;
      } else if (solve === 'strain' && emod > 0 && stress > 0) {
        strain = stress / (emod * 1000);
        steps.push('Dehnung = ' + fmt(stress) + ' MPa / ' + fmt(emod * 1000) + ' MPa = ' + strain.toExponential(4));
        modulus = emod;
      }
      const labels: Record<string, string> = { modulus: 'Elastizitaetsmodul', stress: 'Spannung', strain: 'Dehnung' };
      let resultText = '';
      if (solve === 'modulus') resultText = fmt(modulus) + ' GPa';
      else if (solve === 'stress') resultText = fmt(stress) + ' MPa';
      else resultText = strain.toExponential(4);
      document.getElementById('ela-label')!.textContent = labels[solve] || 'Ergebnis';
      document.getElementById('ela-result')!.textContent = resultText;
      document.getElementById('ela-stress')!.textContent = fmt(stress);
      document.getElementById('ela-strain')!.textContent = strain.toExponential(4);
      document.getElementById('ela-mod')!.textContent = fmt(modulus);
      document.getElementById('ela-strainpct')!.textContent = fmt(strain * 100);
      document.getElementById('ela-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ela-force') as HTMLInputElement).value = '10000';
      (document.getElementById('ela-area') as HTMLInputElement).value = '100';
      (document.getElementById('ela-length') as HTMLInputElement).value = '1000';
      (document.getElementById('ela-delta') as HTMLInputElement).value = '0.48';
      document.querySelectorAll('.ela-in').forEach(el => { el.addEventListener('input', calcEla); el.addEventListener('change', calcEla); });
      calcEla();
    }, 50);
  </script>
</CalculatorLayout>
