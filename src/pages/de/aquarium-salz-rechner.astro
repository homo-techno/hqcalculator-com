---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Salzrechner - Dosierung für Brack- & Meerwasserbecken";
const description = "Berechnen Sie die Salzdosierung für Brackwasser, Meerwasserbecken und Süßwasserbehandlungen basierend auf Beckenvolumen und Zielsalinität.";
const relatedCalcs = [
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Wassergewicht berechnen." },
  { name: "Riffbecken", url: "/de/riffbecken-rechner", description: "Kalzium- und Alkalitätsdosierung für Riffbecken." },
  { name: "Aquarium-Wasserwechsel", url: "/de/aquarium-wasserwechsel-rechner", description: "Wasserwechselvolumen und -häufigkeit." },
  { name: "Aquarium-Medikamente", url: "/aquarium-medication-calculator", description: "Dosierungsrechner für Fischmedikamente." },
  { name: "Lebendgestein", url: "/live-rock-calculator", description: "Lebendgesteinmenge für Meerwasserbecken." },
  { name: "Aquarium-Filterbecken", url: "/de/aquarium-filterbecken-rechner", description: "Filterbeckendimensionierung und Rückförderpumpe." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Aquarium-Salzrechner" keywords="Aquarium Salzrechner, Meersalzmischung, Brackwasser Salz, Aquarium Salzdosierung, Salinität" lang="de" breadcrumbs={[{ name: "Aquarium-Salz", url: "/de/aquarium-salz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Salzrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Salzdosierung für Brackwasser, Meerwasserbecken oder Süßwasserbehandlungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Beckenvolumen (Liter)</label>
          <input type="number" id="as2-vol" class="as2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="1" step="1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Verwendungszweck</label>
          <select id="as2-purpose" class="as2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="marine">Meerwasser / Salzwasser (SG 1,025)</option>
            <option value="brackish">Brackwasser (SG 1,005-1,015)</option>
            <option value="treatment">Süßwasserbehandlung (1 EL/20 L)</option>
            <option value="dip">Salzbad (hohe Konzentration)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Aktuelle spezifische Dichte</label>
          <input type="number" id="as2-cur" class="as2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.000" min="1.000" max="1.035" step="0.001">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Salz hinzufügen</div>
          <div class="text-5xl font-extrabold font-mono" id="as2-result">0 g</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewicht (g)</div>
            <div class="text-xl font-bold font-mono" id="as2-grams">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewicht (kg)</div>
            <div class="text-xl font-bold font-mono" id="as2-kg">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ziel-SG</div>
            <div class="text-xl font-bold font-mono" id="as2-sg">1,000</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">PPT Salinität</div>
            <div class="text-xl font-bold font-mono" id="as2-ppt">0</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="aquarium-salt" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcAS2() {
      const vol = parseFloat((document.getElementById('as2-vol') as HTMLInputElement).value) || 0;
      const purpose = (document.getElementById('as2-purpose') as HTMLSelectElement).value;
      const curSG = parseFloat((document.getElementById('as2-cur') as HTMLInputElement).value) || 1.0;
      const targets: Record<string, number> = { marine: 1.025, brackish: 1.010, treatment: 1.002, dip: 1.015 };
      const targetSG = targets[purpose] || 1.025;
      const sgDiff = Math.max(0, targetSG - curSG);
      // Approx: 35g salt per liter raises SG by ~0.025 from fresh
      let grams = vol * (sgDiff / 0.025) * 35;
      if (purpose === 'treatment') {
        // Simple: 1 tablespoon per 20 liters ≈ 15g per 20L
        grams = vol / 20 * 15;
      }
      const kg = grams / 1000;
      const ppt = ((targetSG - 1) * 1000 * 1.3).toFixed(1);
      const fmt = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('as2-result')!.textContent = fmt(grams) + ' g';
      document.getElementById('as2-grams')!.textContent = fmt(grams);
      document.getElementById('as2-kg')!.textContent = kg.toLocaleString('de-DE', { maximumFractionDigits: 2 });
      document.getElementById('as2-sg')!.textContent = targetSG.toLocaleString('de-DE', { minimumFractionDigits: 3 });
      document.getElementById('as2-ppt')!.textContent = ppt.replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.as2-in').forEach(el => { el.addEventListener('input', calcAS2); el.addEventListener('change', calcAS2); });
      calcAS2();
    }, 50);
  </script>
</CalculatorLayout>
