---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Absolutwert-Rechner - |x| Löser";
const description = "Berechnen Sie den Absolutwert, lösen Sie Betragsgleichungen und -ungleichungen, und stellen Sie |x|-Ausdrücke grafisch dar.";
const relatedCalcs = [
  { name: "Wissenschaftlicher Rechner", url: "/scientific-calculator", description: "Wissenschaftlich." },
  { name: "Prozentuale Änderung", url: "/percentage-change-calculator", description: "% Änderung." },
  { name: "Signifikante Stellen", url: "/significant-figures-calculator", description: "Sig. Stellen." },
  { name: "Modulo-Rechner", url: "/modulo-calculator", description: "Modulo." },
  { name: "Zahlensystem-Umrechner", url: "/number-base-converter", description: "Basisumrechnung." },
  { name: "Bruchrechner", url: "/fraction-calculator", description: "Brüche." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Absolutwert-Rechner" keywords="Absolutwert Rechner, Betragsgleichung, |x|, Abstand von Null, Betrag" breadcrumbs={[{ name: "Absolutwert", url: "/de/absolutwert-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Absolutwert-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Absolutwerte berechnen und |ax + b| = c Gleichungen lösen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="av-m1" class="av-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="value">|x| Wert</button>
          <button id="av-m2" class="av-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="equation">Gleichung</button>
        </div>
        <div id="av-panel-value">
          <div><label class="block text-xs font-medium text-text mb-1">Zahl eingeben</label><input type="number" id="av-x" class="av-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="-7.5" step="any"></div>
        </div>
        <div id="av-panel-equation" class="hidden">
          <p class="text-xs text-text-muted mb-2">Löse |ax + b| = c</p>
          <div class="grid grid-cols-3 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">a</label><input type="number" id="av-a" class="av-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="2" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">b</label><input type="number" id="av-b" class="av-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="-3" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">c</label><input type="number" id="av-c" class="av-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="5" min="0" step="any"></div>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="av-label">|x|</div>
          <div class="text-5xl font-extrabold font-mono" id="av-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="av-extra"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Erklärung</h3>
          <div class="text-sm font-mono" id="av-explain">-</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="absolute-value" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let avMode = 'value';
    function setAvMode(m: string) {
      avMode = m;
      document.getElementById('av-panel-value')!.classList.toggle('hidden', m !== 'value');
      document.getElementById('av-panel-equation')!.classList.toggle('hidden', m !== 'equation');
      document.querySelectorAll('.av-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = `av-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ${active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted'}`;
      });
      calcAV();
    }
    function calcAV() {
      const extra = document.getElementById('av-extra')!;
      if (avMode === 'value') {
        const x = parseFloat((document.getElementById('av-x') as HTMLInputElement).value) || 0;
        const abs = Math.abs(x);
        document.getElementById('av-label')!.textContent = `|${x}|`;
        document.getElementById('av-result')!.textContent = abs.toFixed(6);
        document.getElementById('av-explain')!.textContent = x >= 0
          ? `${x} ist nicht-negativ, also |${x}| = ${x}`
          : `${x} ist negativ, also |${x}| = −(${x}) = ${abs}`;
        extra.innerHTML = `
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abstand von 0</div><div class="text-xl font-bold font-mono">${abs}</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Quadratwurzel von x²</div><div class="text-xl font-bold font-mono">${Math.sqrt(x * x).toFixed(6)}</div></div>`;
      } else {
        const a = parseFloat((document.getElementById('av-a') as HTMLInputElement).value) || 0;
        const b = parseFloat((document.getElementById('av-b') as HTMLInputElement).value) || 0;
        const c = parseFloat((document.getElementById('av-c') as HTMLInputElement).value) || 0;
        document.getElementById('av-label')!.textContent = `|${a}x + ${b}| = ${c}`;
        if (c < 0) {
          document.getElementById('av-result')!.textContent = 'Keine Lösung';
          document.getElementById('av-explain')!.textContent = 'Der Absolutwert kann nicht negativ sein.';
          extra.innerHTML = '';
        } else if (a === 0) {
          const works = Math.abs(b) === c;
          document.getElementById('av-result')!.textContent = works ? 'Alle x' : 'Keine Lösung';
          document.getElementById('av-explain')!.textContent = `|${b}| = ${Math.abs(b)} ${works ? '=' : '\u2260'} ${c}`;
          extra.innerHTML = '';
        } else {
          const x1 = (c - b) / a;
          const x2 = (-c - b) / a;
          document.getElementById('av-result')!.textContent = `x = ${x1.toFixed(4)} oder ${x2.toFixed(4)}`;
          document.getElementById('av-explain')!.innerHTML = `Fall 1: ${a}x + ${b} = ${c} \u2192 x = ${x1.toFixed(4)}<br>Fall 2: ${a}x + ${b} = ${-c} \u2192 x = ${x2.toFixed(4)}`;
          extra.innerHTML = `
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lösung 1</div><div class="text-xl font-bold font-mono">x = ${x1.toFixed(6)}</div></div>
            <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lösung 2</div><div class="text-xl font-bold font-mono">x = ${x2.toFixed(6)}</div></div>`;
        }
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.av-mode').forEach(b => b.addEventListener('click', () => setAvMode((b as HTMLButtonElement).dataset.mode!)));
      document.querySelectorAll('.av-in').forEach(el => { el.addEventListener('input', calcAV); el.addEventListener('change', calcAV); });
      calcAV();
    }, 50);
  </script>
</CalculatorLayout>
