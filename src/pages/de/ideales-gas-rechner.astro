---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ideales-Gas-Rechner - PV = nRT Gleichung lösen";
const description = "Berechnen Sie Druck, Volumen, Temperatur oder Stoffmenge mit dem idealen Gasgesetz PV = nRT.";
const relatedCalcs = [
  { name: "Molaritäts-Rechner", url: "/molarity-calculator", description: "Molarität." },
  { name: "Mol-Rechner", url: "/mole-calculator", description: "Mol berechnen." },
  { name: "pH-Rechner", url: "/ph-calculator", description: "pH-Wert." },
  { name: "Verdünnungs-Rechner", url: "/dilution-calculator", description: "Verdünnung." },
  { name: "Wissenschaftliche Notation", url: "/scientific-notation-calculator", description: "Notation." },
  { name: "Temperaturumrechner", url: "/temperature-converter", description: "Temperatur." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist das ideale Gasgesetz?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das ideale Gasgesetz PV = nRT beschreibt den Zusammenhang zwischen Druck (P), Volumen (V), Stoffmenge (n) und Temperatur (T) eines idealen Gases. R ist die universelle Gaskonstante (0,08206 L·atm/mol·K)." }
    },
    {
      "@type": "Question",
      "name": "Wie rechne ich Celsius in Kelvin um?",
      "acceptedAnswer": { "@type": "Answer", "text": "T(K) = T(°C) + 273,15. Das ideale Gasgesetz erfordert immer die Verwendung von Kelvin, da negative Kelvin-Werte physikalisch nicht möglich sind." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Ideales-Gas-Rechner" lang="de" keywords="ideales gasgesetz rechner, PV=nRT, gasdruck, gasvolumen, gastemperatur, mol berechnen" breadcrumbs={[{ name: "Ideales-Gas-Rechner", url: "/de/ideales-gas-rechner" }]} enSlug="ideal-gas-law-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ideales-Gas-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">PV = nRT — lösen Sie für jede Variable.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 flex-wrap">
          <button class="ig2-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-mode="P">P berechnen</button>
          <button class="ig2-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="V">V berechnen</button>
          <button class="ig2-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="n">n berechnen</button>
          <button class="ig2-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="T">T berechnen</button>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Druck (atm)</label><input type="number" id="ig2-p" class="ig2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Volumen (L)</label><input type="number" id="ig2-v" class="ig2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="22.414" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stoffmenge (mol)</label><input type="number" id="ig2-n" class="ig2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Temperatur (K)</label><input type="number" id="ig2-t" class="ig2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="273.15" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="ig2-label">Druck</div>
          <div class="text-5xl font-extrabold font-mono" id="ig2-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">P in kPa</div><div class="text-xl font-bold font-mono" id="ig2-kpa">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">T in °C</div><div class="text-xl font-bold font-mono" id="ig2-celsius">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formel</h3>
          <div class="text-xs font-mono" id="ig2-formula">PV = nRT, R = 0,08206 L·atm/(mol·K)</div>
        </div>
      </div>
      <ShareButton calculatorId="ideales-gas" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das ideale Gasgesetz erklärt</h2>
      <p>Das ideale Gasgesetz PV = nRT ist eine Zustandsgleichung für ideale Gase. Es kombiniert das Boyle'sche Gesetz (P × V = const. bei T = const.), das Charles'sche Gesetz (V/T = const. bei P = const.) und das Gay-Lussac'sche Gesetz.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Was ist das ideale Gasgesetz?</h4>
      <p>Das ideale Gasgesetz PV = nRT beschreibt den Zusammenhang zwischen Druck, Volumen, Stoffmenge und Temperatur eines idealen Gases. R ist die universelle Gaskonstante.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Wie rechne ich Celsius in Kelvin um?</h4>
      <p>T(K) = T(°C) + 273,15. Das ideale Gasgesetz erfordert immer die Verwendung von Kelvin.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let ig2Mode = 'P';
    const R = 0.08206;
    function calcIG2() {
      const p = parseFloat((document.getElementById('ig2-p') as HTMLInputElement).value) || 0;
      const v = parseFloat((document.getElementById('ig2-v') as HTMLInputElement).value) || 0;
      const n = parseFloat((document.getElementById('ig2-n') as HTMLInputElement).value) || 0;
      const t = parseFloat((document.getElementById('ig2-t') as HTMLInputElement).value) || 0;
      let result = 0, label = '';
      if (ig2Mode === 'P') {
        result = v > 0 ? (n * R * t) / v : 0;
        label = result.toFixed(4) + ' atm';
        document.getElementById('ig2-label')!.textContent = 'Druck';
      } else if (ig2Mode === 'V') {
        result = p > 0 ? (n * R * t) / p : 0;
        label = result.toFixed(4) + ' L';
        document.getElementById('ig2-label')!.textContent = 'Volumen';
      } else if (ig2Mode === 'n') {
        result = (R * t) > 0 ? (p * v) / (R * t) : 0;
        label = result.toFixed(4) + ' mol';
        document.getElementById('ig2-label')!.textContent = 'Stoffmenge';
      } else {
        result = (n * R) > 0 ? (p * v) / (n * R) : 0;
        label = result.toFixed(2) + ' K';
        document.getElementById('ig2-label')!.textContent = 'Temperatur';
      }
      document.getElementById('ig2-result')!.textContent = label;
      const pAtm = ig2Mode === 'P' ? result : p;
      const tK = ig2Mode === 'T' ? result : t;
      document.getElementById('ig2-kpa')!.textContent = (pAtm * 101.325).toFixed(2);
      document.getElementById('ig2-celsius')!.textContent = (tK - 273.15).toFixed(2) + ' \u00B0C';
      document.getElementById('ig2-formula')!.textContent = 'PV = nRT \u2192 ' + ig2Mode + ' = ' + label;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ig2-mode').forEach(b => b.addEventListener('click', () => {
        ig2Mode = (b as HTMLButtonElement).dataset.mode!;
        document.querySelectorAll('.ig2-mode').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.mode === ig2Mode;
          (btn as HTMLButtonElement).className = 'ig2-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        calcIG2();
      }));
      document.querySelectorAll('.ig2-in').forEach(el => { el.addEventListener('input', calcIG2); el.addEventListener('change', calcIG2); });
      calcIG2();
    }, 50);
  </script>
</CalculatorLayout>
