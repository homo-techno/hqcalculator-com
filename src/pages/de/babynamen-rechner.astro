---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Babynamen-Rechner - Namensanalyse & Harmonie";
const description = "Analysieren Sie Babynamen nach Buchstabenzusammensetzung, Silbenanzahl, Klangharmonie und Kompatibilitätsbewertung.";

const relatedCalcs = [
  { name: "Baby-Meilensteinrechner", url: "/de/baby-meilenstein-rechner", description: "Meilensteine verfolgen." },
  { name: "Kindergrößenrechner", url: "/de/kindergroesse-rechner", description: "Größenvorhersage." },
  { name: "Babynahrungsrechner", url: "/de/babynahrung-rechner", description: "Nahrungsbedarf." },
  { name: "Windelkosten-Rechner", url: "/de/windelkosten-rechner", description: "Windelkosten." },
  { name: "Kitakosten-Rechner", url: "/de/kitakosten-rechner", description: "Betreuungskosten." },
  { name: "Geburtstagsparty-Rechner", url: "/de/geburtstagsparty-rechner", description: "Partyplanung." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Babynamen-Rechner"
  keywords="Babynamen Rechner, Namensbeliebtheit, Babynamen Rang, Namensanalyse, Babynamen Bedeutung, Namensharmonie"
  breadcrumbs={[{ name: "Babynamen-Rechner", url: "/de/babynamen-rechner" }]}
  lang="de"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Babynamen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie Babynamen nach Buchstabenzusammensetzung, Silbenanzahl und Kompatibilitätsbewertung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Vorname</label>
          <input type="text" id="bnm-first" class="bnm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="Hannah" placeholder="Vorname eingeben">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Zweiter Vorname (optional)</label>
          <input type="text" id="bnm-middle" class="bnm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="" placeholder="Zweiten Vornamen eingeben">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Nachname</label>
          <input type="text" id="bnm-last" class="bnm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="Müller" placeholder="Nachname eingeben">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Namensharmonie-Wertung</div>
        <div class="text-5xl font-extrabold" id="bnm-score">--</div>
        <div class="text-sm text-blue-200 mt-1" id="bnm-rating">Name wird analysiert</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Buchstaben gesamt</div>
          <div class="text-lg font-bold" id="bnm-letters">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Silben</div>
          <div class="text-lg font-bold" id="bnm-syllables">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Vokale/Konsonanten</div>
          <div class="text-lg font-bold" id="bnm-vc">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Initialen</div>
          <div class="text-lg font-bold" id="bnm-initials">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <h3 class="font-semibold text-sm text-text mb-3">Namensanalyse</h3>
        <div class="text-sm space-y-2" id="bnm-analysis"></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Buchstabenhäufigkeit</h3>
        <div class="text-xs" id="bnm-freq"></div>
      </div>

      <ShareButton calculatorId="baby-name" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Den perfekten Babynamen wählen</h2>
      <p>Ein guter Name hat Rhythmus, Lesbarkeit und persönliche Bedeutung. Dieser Rechner hilft Ihnen, die strukturellen Elemente eines Namens zu analysieren - Buchstabenbalance, Silbenfluss und wie der vollständige Name zusammen klingt.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Tipps zur Namenswahl</h3>
      <ul>
        <li><strong>Silbenbalance:</strong> Variieren Sie die Silbenanzahl zwischen Vor- und Nachname für besseren Klang</li>
        <li><strong>Initialenprüfung:</strong> Stellen Sie sicher, dass Initialen keine unbeabsichtigten Wörter ergeben</li>
        <li><strong>Spitzname-Test:</strong> Bedenken Sie mögliche Spitznamen und Kurzformen</li>
        <li><strong>Laut aussprechen:</strong> Üben Sie, den vollständigen Namen mehrmals laut auszusprechen</li>
        <li><strong>Rechtschreibprüfung:</strong> Bedenken Sie, wie leicht der Name geschrieben und ausgesprochen werden kann</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBNM() {
      const first = (document.getElementById('bnm-first') as HTMLInputElement).value.trim();
      const middle = (document.getElementById('bnm-middle') as HTMLInputElement).value.trim();
      const last = (document.getElementById('bnm-last') as HTMLInputElement).value.trim();

      if (!first) {
        document.getElementById('bnm-score')!.textContent = '--';
        return;
      }

      const vowels = 'aeiouAEIOUäöüÄÖÜ';
      function countVowels(s: string): number { return [...s].filter(c => vowels.includes(c)).length; }
      function countConsonants(s: string): number { return [...s].filter(c => /[a-zA-ZäöüÄÖÜß]/.test(c) && !vowels.includes(c)).length; }

      function countSyllables(word: string): number {
        word = word.toLowerCase();
        if (word.length <= 3) return 1;
        let count = 0;
        let prevVowel = false;
        for (const c of word) {
          const isVowel = 'aeiouäöü'.includes(c);
          if (isVowel && !prevVowel) count++;
          prevVowel = isVowel;
        }
        if (word.endsWith('e') && count > 1) count--;
        return Math.max(1, count);
      }

      const fullName = [first, middle, last].filter(Boolean).join(' ');
      const lettersOnly = fullName.replace(/[^a-zA-ZäöüÄÖÜß]/g, '');
      const totalLetters = lettersOnly.length;
      const totalVowels = countVowels(lettersOnly);
      const totalConsonants = countConsonants(lettersOnly);

      const firstSyl = countSyllables(first);
      const lastSyl = countSyllables(last);
      const midSyl = middle ? countSyllables(middle) : 0;
      const totalSyl = firstSyl + midSyl + lastSyl;

      const initials = [first, middle, last].filter(Boolean).map(n => n[0].toUpperCase()).join('');

      let score = 50;
      if (firstSyl !== lastSyl) score += 15;
      if (totalLetters >= 8 && totalLetters <= 20) score += 10;
      const ratio = totalVowels / Math.max(1, totalConsonants);
      if (ratio >= 0.35 && ratio <= 0.65) score += 10;
      if (first[0]?.toLowerCase() !== last[0]?.toLowerCase()) score += 10;
      if (first.slice(-1).toLowerCase() !== last[0]?.toLowerCase()) score += 5;

      score = Math.min(100, Math.max(10, score));

      let rating = '';
      if (score >= 85) rating = 'Ausgezeichnete Harmonie';
      else if (score >= 70) rating = 'Gute Harmonie';
      else if (score >= 50) rating = 'Mittlere Harmonie';
      else rating = 'Alternativen erwägen';

      document.getElementById('bnm-score')!.textContent = score + '/100';
      document.getElementById('bnm-rating')!.textContent = rating;
      document.getElementById('bnm-letters')!.textContent = String(totalLetters);
      document.getElementById('bnm-syllables')!.textContent = String(totalSyl);
      document.getElementById('bnm-vc')!.textContent = totalVowels + 'V / ' + totalConsonants + 'K';
      document.getElementById('bnm-initials')!.textContent = initials;

      const tips: string[] = [];
      if (firstSyl === lastSyl) tips.push('Tipp: Unterschiedliche Silbenanzahl zwischen Vor- und Nachname erzeugt oft besseren Klang.');
      if (first[0]?.toLowerCase() === last[0]?.toLowerCase()) tips.push('Hinweis: Alliterative Namen (gleicher Anfangsbuchstabe) können einprägsam sein, klingen aber manchmal repetitiv.');
      if (totalLetters > 25) tips.push('Der volle Name ist recht lang - ein kürzerer zweiter Vorname könnte helfen.');
      if (totalLetters < 6) tips.push('Der volle Name ist sehr kurz - ein längerer zweiter Vorname könnte Balance schaffen.');
      if (tips.length === 0) tips.push('Dieser Name hat eine tolle Balance und einen guten Klang!');

      tips.push('Vorname: ' + firstSyl + ' Silbe(n), Nachname: ' + lastSyl + ' Silbe(n)');

      document.getElementById('bnm-analysis')!.innerHTML = tips.map(t => '<p class="text-text-secondary">' + t + '</p>').join('');

      const freq: Record<string, number> = {};
      for (const c of lettersOnly.toLowerCase()) {
        freq[c] = (freq[c] || 0) + 1;
      }
      const sorted = Object.entries(freq).sort((a, b) => b[1] - a[1]);
      const maxCount = sorted[0]?.[1] || 1;
      document.getElementById('bnm-freq')!.innerHTML = sorted.map(([letter, count]) => {
        const pct = (count / maxCount) * 100;
        return '<div class="flex items-center gap-2 py-0.5"><span class="w-6 font-bold uppercase">' + letter + '</span><div class="flex-1 bg-gray-200 rounded-full h-3"><div class="bg-primary h-3 rounded-full" style="width:' + pct + '%"></div></div><span class="w-6 text-right">' + count + '</span></div>';
      }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bnm-in').forEach(el => {
        el.addEventListener('input', calcBNM);
        el.addEventListener('change', calcBNM);
      });
      calcBNM();
    }, 50);
  </script>
</CalculatorLayout>
