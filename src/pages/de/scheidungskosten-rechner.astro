---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Scheidungskosten-Rechner - Anwalts- & Gerichtskosten schaetzen 2026";
const description = "Schaetze die Kosten einer Scheidung in Deutschland: Anwaltsgebuehren, Gerichtskosten und weitere Ausgaben basierend auf Verfahrensart und Vermoegen.";

const relatedCalcs = [
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budgetplanung." },
  { name: "Nettovermoegen-Rechner", url: "/de/nettovermoegen-rechner", description: "Nettovermoegen berechnen." },
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallruecklagen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
  { name: "Rentenrechner", url: "/de/rentenrechner", description: "Altersvorsorge." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Scheidungskosten-Rechner" keywords="Scheidungskosten, Scheidung Kosten, Anwaltskosten Scheidung, Gerichtskosten Scheidung, einvernehmliche Scheidung" breadcrumbs={[{ name: "Scheidungskosten", url: "/de/scheidungskosten-rechner" }]} lang="de" enSlug="divorce-cost-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Scheidungskosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetze die Gesamtkosten einer Scheidung basierend auf deiner Situation. Ergebnisse sind allgemeine Richtwerte.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Scheidungsart</label>
            <select id="skr-type" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="uncontested">Einvernehmlich (Einigung ueber alle Punkte)</option>
              <option value="mediated" selected>Mit Mediation (einige Meinungsverschiedenheiten)</option>
              <option value="contested">Strittig (erhebliche Konflikte)</option>
              <option value="high-conflict">Hochstrittig (Gerichtsverfahren wahrscheinlich)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kinder beteiligt</label>
            <select id="skr-children" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="no" selected>Keine Kinder</option>
              <option value="yes-agree">Ja, Sorgerecht einvernehmlich</option>
              <option value="yes-dispute">Ja, Sorgerecht strittig</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Vermoegens-Komplexitaet</label>
            <select id="skr-property" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="simple">Einfach (wenig Vermoegen)</option>
              <option value="moderate" selected>Mittel (Haus, Altersvorsorge)</option>
              <option value="complex">Komplex (Unternehmen, mehrere Immobilien)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Nettoeinkommen beider Partner (monatlich)</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="skr-income" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-lg" value="5000" min="0" step="500">
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzte Gesamtkosten</div>
            <div class="text-5xl font-extrabold font-mono" id="skr-total">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Anwaltskosten</div>
              <div class="text-xl font-bold text-secondary" id="skr-attorney">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Mediationskosten</div>
              <div class="text-xl font-bold" id="skr-mediation">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gerichtskosten</div>
              <div class="text-xl font-bold" id="skr-court">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Sonstige Kosten</div>
              <div class="text-xl font-bold" id="skr-other">0 &euro;</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Geschaetzte Dauer</div>
            <div class="text-xl font-bold" id="skr-timeline">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="divorce-cost" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was kostet eine Scheidung in Deutschland?</h2>
      <p>Die Kosten einer Scheidung in Deutschland richten sich nach dem Verfahrenswert, der sich aus dem gemeinsamen Nettoeinkommen und Vermoegen berechnet. Eine einvernehmliche Scheidung mit einem Anwalt kostet in der Regel 1.000-3.000 Euro, waehrend strittige Verfahren 5.000-30.000 Euro und mehr kosten koennen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Brauche ich einen Anwalt?</strong> In Deutschland herrscht Anwaltszwang bei Scheidungen. Mindestens ein Ehepartner muss anwaltlich vertreten sein.</p>
      <p><strong>Wie kann ich Kosten sparen?</strong> Eine einvernehmliche Scheidung mit nur einem Anwalt (der andere Partner stimmt zu) ist die guenstigste Variante. Mediation kann bei Meinungsverschiedenheiten guenstiger sein als ein Gerichtsverfahren.</p>
      <p><strong>Was ist das Trennungsjahr?</strong> Vor der Scheidung muessen Ehepaare in Deutschland mindestens ein Jahr getrennt leben.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const skrFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcSKR() {
      const divorceType = (document.getElementById('skr-type') as HTMLSelectElement).value;
      const children = (document.getElementById('skr-children') as HTMLSelectElement).value;
      const property = (document.getElementById('skr-property') as HTMLSelectElement).value;
      const income = parseFloat((document.getElementById('skr-income') as HTMLInputElement).value) || 0;

      const baseFees: Record<string, number> = {
        uncontested: 1500,
        mediated: 4000,
        contested: 12000,
        'high-conflict': 25000
      };
      let attorneyFees = baseFees[divorceType] || 4000;

      if (children === 'yes-agree') attorneyFees *= 1.2;
      else if (children === 'yes-dispute') attorneyFees *= 1.8;

      if (property === 'moderate') attorneyFees *= 1.15;
      else if (property === 'complex') attorneyFees *= 1.5;

      // Einkommen beeinflusst Verfahrenswert
      const incomeMultiplier = Math.max(0.8, Math.min(2.0, income / 5000));
      attorneyFees *= incomeMultiplier;

      let mediationCost = 0;
      if (divorceType === 'mediated') mediationCost = 2500;
      else if (divorceType === 'contested') mediationCost = 1500;
      if (children === 'yes-dispute') mediationCost += 1200;

      const courtFees = Math.round(400 + income * 0.15);

      let other = 400;
      if (property === 'complex') other += 2500;
      if (children === 'yes-dispute') other += 1500;

      const total = attorneyFees + mediationCost + courtFees + other;

      let timeline = '';
      if (divorceType === 'uncontested') timeline = '4-6 Monate';
      else if (divorceType === 'mediated') timeline = '6-12 Monate';
      else if (divorceType === 'contested') timeline = '12-24 Monate';
      else timeline = '1-3 Jahre';

      document.getElementById('skr-total')!.textContent = skrFmt(total);
      document.getElementById('skr-attorney')!.textContent = skrFmt(attorneyFees);
      document.getElementById('skr-mediation')!.textContent = skrFmt(mediationCost);
      document.getElementById('skr-court')!.textContent = skrFmt(courtFees);
      document.getElementById('skr-other')!.textContent = skrFmt(other);
      document.getElementById('skr-timeline')!.textContent = timeline;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['skr-type', 'skr-children', 'skr-property'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('change', calcSKR);
      });
      document.getElementById('skr-income')!.addEventListener('input', calcSKR);
      calcSKR();
    }, 50);
  </script>
</CalculatorLayout>
