---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Idealgewicht-Rechner - Gesundes Gewicht für Ihre Größe 2026";
const description = "Berechnen Sie Ihr ideales Körpergewicht basierend auf Größe, Geschlecht und Körperbau. Mehrere Formeln: Devine, Robinson, Miller, Hamwi und BMI-Bereich.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/bmi-calculator", description: "Body-Mass-Index." },
  { name: "Körperfett-Rechner", url: "/body-fat-calculator", description: "Körperfettanteil." },
  { name: "Grundumsatz-Rechner", url: "/bmr-calculator", description: "Grundumsatz." },
  { name: "Kalorienrechner", url: "/calorie-calculator", description: "Täglicher Kalorienbedarf." },
  { name: "Tageskalorienbedarf-Rechner", url: "/tdee-calculator", description: "Gesamtenergieverbrauch." },
  { name: "Abnehmen-Rechner", url: "/weight-loss-calculator", description: "Kaloriendefizit-Plan." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie berechnet man das Idealgewicht?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das Idealgewicht wird mit verschiedenen Formeln (Devine, Robinson, Miller, Hamwi) basierend auf Körpergröße und Geschlecht berechnet. Der gesunde BMI-Bereich (18,5–24,9) × Körpergröße² gibt ebenfalls eine gute Orientierung." }
    },
    {
      "@type": "Question",
      "name": "Welche Formel ist am genauesten?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Devine-Formel wird am häufigsten in klinischen Umgebungen verwendet. Der gesunde BMI-Bereich (18,5–24,9) gilt allgemein als die beste Gesamtreferenz, da er auch die Körpergröße berücksichtigt." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Idealgewicht-Rechner" lang="de" keywords="idealgewicht rechner, ideales körpergewicht, gesundes gewicht, IBW rechner, gewicht für größe, zielgewicht" breadcrumbs={[{ name: "Idealgewicht-Rechner", url: "/de/idealgewicht-rechner" }]} enSlug="ideal-weight-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Idealgewicht-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihr ideales Körpergewicht basierend auf mehreren wissenschaftlichen Formeln und Ihrer Körpergröße.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Geschlecht</label>
            <div class="flex gap-2">
              <button class="iw2-gender-btn flex-1 py-3 rounded-xl font-semibold bg-primary text-white border border-primary" data-gender="male">Männlich</button>
              <button class="iw2-gender-btn flex-1 py-3 rounded-xl font-semibold bg-surface-alt text-text-secondary border border-border" data-gender="female">Weiblich</button>
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Körpergröße (cm)</label>
            <input type="number" id="iw2-cm" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="178" min="120" max="230">
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Aktuelles Gewicht <span class="text-text-muted">(optional)</span></label>
            <div class="flex gap-2">
              <input type="number" id="iw2-current" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg" placeholder="z.B. 80">
              <span class="self-center text-text-muted font-semibold">kg</span>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Idealgewicht-Bereich</div>
            <div class="text-3xl sm:text-4xl font-extrabold" id="iw2-range">0 – 0 kg</div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl">
            <div class="flex justify-between items-center py-1.5 border-b border-border/30">
              <div><span class="font-semibold text-sm">Devine (1974)</span><span class="text-xs text-text-muted ml-2">Am häufigsten verwendet</span></div>
              <span class="font-bold" id="iw2-devine">0</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-border/30">
              <div><span class="font-semibold text-sm">Robinson (1983)</span></div>
              <span class="font-bold" id="iw2-robinson">0</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-border/30">
              <div><span class="font-semibold text-sm">Miller (1983)</span></div>
              <span class="font-bold" id="iw2-miller">0</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-border/30">
              <div><span class="font-semibold text-sm">Hamwi (1964)</span></div>
              <span class="font-bold" id="iw2-hamwi">0</span>
            </div>
            <div class="flex justify-between items-center py-1.5">
              <div><span class="font-semibold text-sm text-primary">Gesunder BMI-Bereich</span><span class="text-xs text-text-muted ml-2">BMI 18,5–24,9</span></div>
              <span class="font-bold text-primary" id="iw2-bmi-range">0</span>
            </div>
          </div>

          <div class="p-4 bg-surface-alt rounded-xl hidden" id="iw2-comparison">
            <h3 class="font-semibold text-sm text-text mb-2">Ihr Status</h3>
            <div class="text-sm text-text-secondary" id="iw2-status"></div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="idealgewicht" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie das Idealgewicht berechnet wird</h2>
      <p>Es gibt kein einzelnes „ideales Gewicht" — es hängt von vielen Faktoren ab. Dieser Rechner verwendet mehrere etablierte Formeln, die jeweils aus unterschiedlichen Forschungspopulationen entwickelt wurden. Die Ergebnisse liefern einen Bereich als allgemeine Richtlinie.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie berechnet man das Idealgewicht?</h4>
      <p>Das Idealgewicht wird mit verschiedenen Formeln (Devine, Robinson, Miller, Hamwi) basierend auf Körpergröße und Geschlecht berechnet. Der gesunde BMI-Bereich gibt ebenfalls eine gute Orientierung.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Welche Formel ist am genauesten?</h4>
      <p>Die Devine-Formel wird am häufigsten in klinischen Umgebungen verwendet. Der gesunde BMI-Bereich (18,5–24,9) gilt allgemein als die beste Gesamtreferenz.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let iw2Gender = 'male';

    function fmtKg(kg: number): string {
      return Math.round(kg) + ' kg';
    }

    function calcIW2() {
      const cm = parseFloat((document.getElementById('iw2-cm') as HTMLInputElement).value) || 0;
      const inches = cm / 2.54;
      const over60 = Math.max(0, inches - 60);
      const heightM = cm / 100;

      let devine: number, robinson: number, miller: number, hamwi: number;
      if (iw2Gender === 'male') {
        devine = 50 + 2.3 * over60;
        robinson = 52 + 1.9 * over60;
        miller = 56.2 + 1.41 * over60;
        hamwi = 48 + 2.7 * over60;
      } else {
        devine = 45.5 + 2.3 * over60;
        robinson = 49 + 1.7 * over60;
        miller = 53.1 + 1.36 * over60;
        hamwi = 45.5 + 2.2 * over60;
      }

      const bmiLow = 18.5 * heightM * heightM;
      const bmiHigh = 24.9 * heightM * heightM;
      const allValues = [devine, robinson, miller, hamwi, bmiLow, bmiHigh];
      const minV = Math.min(...allValues);
      const maxV = Math.max(...allValues);

      document.getElementById('iw2-range')!.textContent = fmtKg(minV) + ' \u2013 ' + fmtKg(maxV);
      document.getElementById('iw2-devine')!.textContent = fmtKg(devine);
      document.getElementById('iw2-robinson')!.textContent = fmtKg(robinson);
      document.getElementById('iw2-miller')!.textContent = fmtKg(miller);
      document.getElementById('iw2-hamwi')!.textContent = fmtKg(hamwi);
      document.getElementById('iw2-bmi-range')!.textContent = fmtKg(bmiLow) + ' \u2013 ' + fmtKg(bmiHigh);

      const currentInput = parseFloat((document.getElementById('iw2-current') as HTMLInputElement).value);
      const compDiv = document.getElementById('iw2-comparison')!;
      if (currentInput > 0) {
        compDiv.classList.remove('hidden');
        const avg = (devine + robinson + miller + hamwi) / 4;
        const diff = currentInput - avg;
        const diffDisplay = Math.abs(Math.round(diff));
        let status: string;
        if (Math.abs(diff) < 2) {
          status = '<span class="text-secondary font-semibold">Sie sind bei Ihrem Idealgewicht!</span> Ihr aktuelles Gewicht liegt sehr nahe am Formel-Durchschnitt.';
        } else if (diff > 0) {
          status = 'Sie sind ca. <span class="font-semibold text-danger">' + diffDisplay + ' kg über</span> dem Formel-Durchschnitt von ' + fmtKg(avg) + '. Der gesunde BMI-Bereich für Ihre Größe ist ' + fmtKg(bmiLow) + ' \u2013 ' + fmtKg(bmiHigh) + '.';
        } else {
          status = 'Sie sind ca. <span class="font-semibold text-primary">' + diffDisplay + ' kg unter</span> dem Formel-Durchschnitt von ' + fmtKg(avg) + '. Der gesunde BMI-Bereich für Ihre Größe ist ' + fmtKg(bmiLow) + ' \u2013 ' + fmtKg(bmiHigh) + '.';
        }
        document.getElementById('iw2-status')!.innerHTML = status;
      } else {
        compDiv.classList.add('hidden');
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.iw2-gender-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.iw2-gender-btn').forEach(b => {
            b.classList.remove('bg-primary', 'text-white', 'border-primary');
            b.classList.add('bg-surface-alt', 'text-text-secondary', 'border-border');
          });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary', 'border-border');
          btn.classList.add('bg-primary', 'text-white', 'border-primary');
          iw2Gender = (btn as HTMLElement).dataset.gender || 'male';
          calcIW2();
        });
      });
      ['iw2-cm', 'iw2-current'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcIW2);
      });
      calcIW2();
    }, 50);
  </script>
</CalculatorLayout>
