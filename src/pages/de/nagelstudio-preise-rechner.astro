---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Nagelstudio Preisrechner - Preise für Nagelbehandlungen kalkulieren";
const description = "Kalkulieren Sie Preise für Nagelbehandlungen unter Berücksichtigung von Material, Arbeitszeit und Gewinnmarge.";
const relatedCalcs = [
  { name: "Pilzzucht Rechner", url: "/de/pilzzucht-rechner", description: "Ertrag berechnen." },
  { name: "Umzugskosten Rechner", url: "/de/umzugskosten-rechner", description: "Kosten berechnen." },
  { name: "Kapitalwert Rechner", url: "/de/kapitalwert-rechner", description: "Investitionen bewerten." },
  { name: "Nettovermögen Rechner", url: "/de/nettovermoegen-rechner", description: "Vermögen berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Nagelstudio Preisrechner" enSlug="nail-salon-pricing-calculator" keywords="Nagelstudio Preise, Nagelbehandlung Kalkulation, Gelnägel Preis, Maniküre Kosten, Nageldesign Preisliste" breadcrumbs={[{ name: "Nagelstudio Preisrechner", url: "/de/nagelstudio-preise-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Nagelstudio Preisrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Kalkulieren Sie den optimalen Preis für Ihre Nagelbehandlungen auf Basis von Materialkosten, Arbeitszeit und Betriebskosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Materialkosten (€)</label><input type="number" id="ns-material" class="ns-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Arbeitszeit (Minuten)</label><input type="number" id="ns-time" class="ns-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="1" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stundenlohn (€/h)</label><input type="number" id="ns-wage" class="ns-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Betriebskosten anteilig (€)</label><input type="number" id="ns-overhead" class="ns-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewinnmarge (%)</label><input type="number" id="ns-margin" class="ns-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="200" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">MwSt. (%)</label><input type="number" id="ns-tax" class="ns-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="19" min="0" max="30" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Verkaufspreis (inkl. MwSt.)</div>
          <div class="text-5xl font-extrabold font-mono" id="ns-result">0,00 €</div>
          <div class="text-sm text-blue-200 mt-1" id="ns-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Selbstkosten</div><div class="text-xl font-bold" id="ns-cost">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Netto-Preis</div><div class="text-xl font-bold" id="ns-netto">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinn pro Behandlung</div><div class="text-xl font-bold" id="ns-profit">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Arbeitskosten</div><div class="text-xl font-bold" id="ns-laboramt">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="nagelstudio" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Preiskalkulation im Nagelstudio</h2>
      <p>Eine korrekte Preiskalkulation ist entscheidend für den Erfolg eines Nagelstudios. Neben den direkten Materialkosten (Gel, Lack, Pinsel, Schablonen) müssen Lohnkosten, Miete, Strom und Verbrauchsmaterialien eingerechnet werden. Die Gewinnmarge sollte mindestens 25–40% betragen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was kosten Gelnägel im Durchschnitt?</strong></p><p>Gelnägel kosten in Deutschland durchschnittlich 40–80 €, je nach Region, Studio und Aufwand. Nageldesign kann den Preis erheblich erhöhen.</p></div>
        <div><p><strong>Wie hoch sollte die Gewinnmarge sein?</strong></p><p>Eine Gewinnmarge von 30–50% ist für Nagelstudios üblich. Damit können laufende Kosten gedeckt und Rücklagen gebildet werden.</p></div>
        <div><p><strong>Müssen Nagelstudios MwSt. ausweisen?</strong></p><p>Ja, Nagelstudios sind umsatzsteuerpflichtig (19%). Kleinunternehmer nach §19 UStG können von der MwSt. befreit sein.</p></div>
        <div><p><strong>Welche Materialkosten fallen an?</strong></p><p>Typische Materialkosten pro Behandlung: Gel/Acryl (2–5 €), Pinsel, Feilen, Schablonen (1–2 €), Desinfektionsmittel und Verbrauchsmaterialien (1–2 €).</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcNS() {
      const material = parseFloat((document.getElementById('ns-material') as HTMLInputElement).value) || 0;
      const time = parseFloat((document.getElementById('ns-time') as HTMLInputElement).value) || 0;
      const wage = parseFloat((document.getElementById('ns-wage') as HTMLInputElement).value) || 0;
      const overhead = parseFloat((document.getElementById('ns-overhead') as HTMLInputElement).value) || 0;
      const margin = parseFloat((document.getElementById('ns-margin') as HTMLInputElement).value) || 0;
      const tax = parseFloat((document.getElementById('ns-tax') as HTMLInputElement).value) || 19;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      const laborCost = wage * time / 60;
      const costBase = material + laborCost + overhead;
      const netto = costBase * (1 + margin / 100);
      const brutto = netto * (1 + tax / 100);
      const profit = netto - costBase;
      document.getElementById('ns-result')!.textContent = fmt(brutto);
      document.getElementById('ns-sub')!.textContent = 'Netto: ' + fmt(netto) + ' | MwSt.: ' + fmt(brutto - netto);
      document.getElementById('ns-cost')!.textContent = fmt(costBase);
      document.getElementById('ns-netto')!.textContent = fmt(netto);
      document.getElementById('ns-profit')!.textContent = fmt(profit);
      document.getElementById('ns-laboramt')!.textContent = fmt(laborCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ns-in').forEach(el => { el.addEventListener('input', calcNS); el.addEventListener('change', calcNS); });
      calcNS();
    }, 50);
  </script>
</CalculatorLayout>
