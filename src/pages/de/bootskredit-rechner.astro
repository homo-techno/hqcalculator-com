---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bootskredit-Rechner - Bootsfinanzierung berechnen";
const description = "Berechnen Sie monatliche Raten, Gesamtzinsen und Betriebskosten für Boots- und Marinekredite.";
const relatedCalcs = [
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "Anleihe-Rechner", url: "/de/anleihe-rechner", description: "Anleihen." },
  { name: "Zahnspange-Kosten-Rechner", url: "/de/zahnspange-kosten-rechner", description: "Kosten berechnen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Batteriespeicher-Rechner", url: "/de/batteriespeicher-rechner", description: "Speicher-Dimensionierung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Bootskredit-Rechner" enSlug="boat-loan-calculator" keywords="Bootskredit Rechner, Bootsfinanzierung, Bootsrate, Yachtkredit, Bootskreditraten, Marinekredit" breadcrumbs={[{ name: "Bootskredit-Rechner", url: "/de/bootskredit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bootskredit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kreditraten und Gesamtfinanzierungskosten für Ihr Boot.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bootspreis (€)</label><input type="number" id="bk-price" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahlung (€)</label><input type="number" id="bk-down" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="0" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zinssatz (%)</label><input type="number" id="bk-rate" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.99" min="0" max="25" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Jahre)</label><input type="number" id="bk-term" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="20" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Jährl. Versicherung (€)</label><input type="number" id="bk-ins" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="800" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Jährl. Wartung (€)</label><input type="number" id="bk-maint" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="0" step="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Rate</div>
          <div class="text-5xl font-extrabold font-mono" id="bk-payment">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kreditbetrag</div><div class="text-xl font-bold" id="bk-loan">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtzinsen</div><div class="text-xl font-bold" id="bk-interest">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="bk-total">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Besitzkosten</div><div class="text-xl font-bold" id="bk-own">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährl. Besitzkosten</div><div class="text-xl font-bold" id="bk-annual">0 €</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="bootskredit" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Bootsfinanzierung in Deutschland</h2>
      <p>Bootskredite in Deutschland haben typischerweise Laufzeiten von 5 bis 15 Jahren. Die Zinssätze liegen meist zwischen 3% und 8%, je nach Bonität und Kreditlaufzeit. Bedenken Sie auch die laufenden Kosten wie Liegeplatz, Versicherung und Wartung, die erheblich sein können.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie hoch sollte die Anzahlung sein?</strong> Experten empfehlen mindestens 20% des Kaufpreises als Anzahlung, um bessere Zinssätze zu erhalten.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBK() {
      const price = parseFloat((document.getElementById('bk-price') as HTMLInputElement).value) || 0;
      const down = parseFloat((document.getElementById('bk-down') as HTMLInputElement).value) || 0;
      const rate = (parseFloat((document.getElementById('bk-rate') as HTMLInputElement).value) || 0) / 100 / 12;
      const term = (parseInt((document.getElementById('bk-term') as HTMLInputElement).value) || 1) * 12;
      const ins = parseFloat((document.getElementById('bk-ins') as HTMLInputElement).value) || 0;
      const maint = parseFloat((document.getElementById('bk-maint') as HTMLInputElement).value) || 0;
      const loan = price - down;
      let payment: number;
      if (rate === 0) payment = loan / term;
      else payment = loan * rate * Math.pow(1 + rate, term) / (Math.pow(1 + rate, term) - 1);
      const totalPaid = payment * term;
      const totalInterest = totalPaid - loan;
      const monthlyOwn = payment + ins / 12 + maint / 12;
      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('bk-payment')!.textContent = fmt(payment);
      document.getElementById('bk-loan')!.textContent = fmt(loan);
      document.getElementById('bk-interest')!.textContent = fmt(totalInterest);
      document.getElementById('bk-total')!.textContent = fmt(totalPaid + down);
      document.getElementById('bk-own')!.textContent = fmt(monthlyOwn);
      document.getElementById('bk-annual')!.textContent = fmt(monthlyOwn * 12);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.bk-in').forEach(el => el.addEventListener('input', calcBK)); calcBK(); }, 50);
  </script>
</CalculatorLayout>
