---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Mittelwert Rechner - Mittelwert, Median, Modus und Standardabweichung";
const description = "Berechnen Sie Mittelwert, Median, Modus und Standardabweichung für Datensätze. Statistik-Rechner für Schule, Studium und Beruf mit ausführlicher Ergebnisanzeige.";
const relatedCalcs = [
  { name: "Standardabweichung Rechner", url: "/de/standardabweichung-rechner", description: "Standardabweichung berechnen." },
  { name: "Markov-Ketten Rechner", url: "/de/markov-kette-rechner", description: "Markov-Ketten." },
  { name: "Matrix Rechner", url: "/de/matrix-rechner", description: "Matrixoperationen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mean-median-mode-calculator" calculatorName="Mittelwert Rechner" keywords="Mittelwert Rechner, Median berechnen, Modus Statistik, Standardabweichung Rechner, Statistik online" breadcrumbs={[{ name: "Mittelwert Rechner", url: "/de/mittelwert-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mittelwert Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Zahlen durch Komma oder Leerzeichen getrennt ein und erhalten Sie sofort Mittelwert, Median, Modus, Spannweite und Standardabweichung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Datensatz (Zahlen komma- oder leerzeichen-getrennt)</label>
          <textarea id="mw-data" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold resize-none" rows="3" placeholder="z.B. 4, 7, 3, 9, 2, 7, 5, 8">4, 7, 3, 9, 2, 7, 5, 8</textarea>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Arithmetischer Mittelwert</div>
          <div class="text-5xl font-extrabold font-mono" id="mw-mean">--</div>
          <div class="text-sm text-blue-200 mt-1" id="mw-count">-- Datenwerte</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Median</div><div class="text-xl font-bold" id="mw-median">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Modus</div><div class="text-xl font-bold" id="mw-mode">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Standardabweichung (s)</div><div class="text-xl font-bold" id="mw-std">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Varianz</div><div class="text-xl font-bold" id="mw-var">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Minimum</div><div class="text-xl font-bold" id="mw-min">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Maximum</div><div class="text-xl font-bold" id="mw-max">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spannweite</div><div class="text-xl font-bold" id="mw-range">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-1">Sortierter Datensatz</div>
          <div id="mw-sorted" class="font-mono text-sm text-text break-words">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mittelwert" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Statistische Lagemaße und Streuungsmaße</h2>
      <p>In der deskriptiven Statistik beschreiben Lagemaße (Mittelwert, Median, Modus) die zentrale Tendenz eines Datensatzes, während Streuungsmaße (Standardabweichung, Varianz, Spannweite) die Variabilität der Daten angeben. Der arithmetische Mittelwert ist empfindlich gegenüber Ausreißern; der Median ist robuster. Der Modus ist der häufigste Wert und kann bei mehrgipfligen Verteilungen mehrfach vorkommen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Mittelwert und Median?</strong> Der Mittelwert ist der Durchschnitt aller Werte. Der Median ist der mittlere Wert im sortierten Datensatz. Bei schiefen Verteilungen ist der Median robuster gegenüber Ausreißern.</p>
      <p><strong>Was ist der Modus?</strong> Der Modus (auch Modalwert) ist der Wert, der im Datensatz am häufigsten vorkommt. Es können mehrere Modi existieren (bimodal, multimodal).</p>
      <p><strong>Was ist Standardabweichung?</strong> Die Standardabweichung misst, wie weit die Datenwerte im Durchschnitt vom Mittelwert entfernt sind. Sie ist die Wurzel der Varianz.</p>
      <p><strong>Wann nutze ich Median statt Mittelwert?</strong> Bei schiefen Verteilungen oder Datensätzen mit Ausreißern (z. B. Einkommensverteilung) ist der Median aussagekräftiger als der Mittelwert.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMW() {
      const raw = (document.getElementById('mw-data') as HTMLTextAreaElement).value;
      const nums = raw.split(/[\s,;]+/).map(s => parseFloat(s.replace(',', '.'))).filter(n => !isNaN(n));
      if (nums.length === 0) { document.getElementById('mw-mean')!.textContent = '--'; return; }
      const sorted = [...nums].sort((a, b) => a - b);
      const n = nums.length;
      const mean = nums.reduce((s, v) => s + v, 0) / n;
      const median = n % 2 === 0 ? (sorted[n/2 - 1] + sorted[n/2]) / 2 : sorted[Math.floor(n/2)];
      const freq: Record<string, number> = {};
      nums.forEach(v => { freq[v] = (freq[v] || 0) + 1; });
      const maxFreq = Math.max(...Object.values(freq));
      const modes = Object.entries(freq).filter(([, f]) => f === maxFreq).map(([v]) => parseFloat(v));
      const variance = nums.reduce((s, v) => s + (v - mean) ** 2, 0) / (n > 1 ? n - 1 : 1);
      const std = Math.sqrt(variance);
      const fmt = (v: number) => parseFloat(v.toFixed(4)).toLocaleString('de-DE');
      document.getElementById('mw-mean')!.textContent = fmt(mean);
      document.getElementById('mw-count')!.textContent = n + ' Datenwerte';
      document.getElementById('mw-median')!.textContent = fmt(median);
      document.getElementById('mw-mode')!.textContent = maxFreq > 1 ? modes.map(fmt).join(', ') : 'Kein eindeutiger Modus';
      document.getElementById('mw-std')!.textContent = fmt(std);
      document.getElementById('mw-var')!.textContent = fmt(variance);
      document.getElementById('mw-min')!.textContent = fmt(sorted[0]);
      document.getElementById('mw-max')!.textContent = fmt(sorted[n - 1]);
      document.getElementById('mw-range')!.textContent = fmt(sorted[n - 1] - sorted[0]);
      document.getElementById('mw-sorted')!.textContent = sorted.map(fmt).join(', ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('mw-data')!.addEventListener('input', calcMW);
      calcMW();
    }, 50);
  </script>
</CalculatorLayout>
