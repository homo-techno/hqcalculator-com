---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Catering-Mengen-Rechner – Essen & Getränke pro Gast";
const description = "Berechnen Sie genau, wie viel Essen und Getränke Sie pro Gast für Ihr Event benötigen. Vorspeisen, Hauptgang, Dessert und Getränke.";
const relatedCalcs = [
  { name: "Katzenfutter-Rechner", url: "/de/katzenfutter-rechner", description: "Katzenfutter." },
  { name: "Tragfähigkeit-Rechner", url: "/de/tragfaehigkeit-rechner", description: "Tragfähigkeit." },
  { name: "Teppich-Rechner", url: "/de/teppich-rechner", description: "Teppich." },
  { name: "Kubikmeter-Rechner", url: "/de/kubikmeter-rechner", description: "Volumen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Catering-Mengen-Rechner" enSlug="catering-quantity-calculator" keywords="Catering Rechner, Essensmengen pro Gast, Event Catering, Partyplanung, Portionsgrößen" breadcrumbs={[{ name: "Catering-Mengen-Rechner", url: "/de/catering-mengen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Catering-Mengen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie genau, wie viel Essen und Getränke Sie für Ihr Event bestellen sollten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl Gäste</label><input type="number" id="cmr-guests" class="cmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Eventdauer (Stunden)</label><input type="number" id="cmr-hours" class="cmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="12" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Art der Bewirtung</label><select id="cmr-meal" class="cmr-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="full">Vollständiges Dinner (Vorspeise + Hauptgang + Dessert)</option><option value="buffet">Buffet</option><option value="cocktail">Empfang / Fingerfood</option><option value="light">Leichtes Mittagessen / Brunch</option></select></div>
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl Vorspeisen-Varianten</label><input type="number" id="cmr-appvar" class="cmr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="20" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Getränke einplanen?</label><select id="cmr-bev" class="cmr-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="yes">Ja (alkoholfrei + alkoholisch)</option><option value="nonalc">Nur alkoholfrei</option><option value="no">Keine Getränke</option></select></div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamt Vorspeisen-Stücke</div>
        <div class="text-5xl font-extrabold" id="cmr-totalapp">--</div>
        <div class="text-sm mt-1" id="cmr-pervar">--</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hauptgerichte</div><div class="text-xl font-bold" id="cmr-mains">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dessert-Portionen</div><div class="text-xl font-bold" id="cmr-desserts">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Getränke gesamt</div><div class="text-xl font-bold" id="cmr-drinks">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">kg Essen (ca.)</div><div class="text-xl font-bold" id="cmr-weight">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="cmr-details"></div>
      <ShareButton lang="de" calculatorId="catering-quantity" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Catering-Mengen richtig planen</h2>
      <p>Als Faustregel gilt: 6-8 Vorspeisen-Häppchen pro Gast für einen Empfang, 1 Hauptgang und 1 Dessert. Bei Getränken: 2 Getränke in der ersten Stunde und 1 pro weitere Stunde.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Portionsgrößen pro Gast</h3>
      <ul>
        <li><strong>Vorspeisen:</strong> 6-8 Stück/Person (Empfang), 12-15 bei Fingerfood-Event</li>
        <li><strong>Hauptgang:</strong> 150-200 g Protein, 150 g Beilage, 100 g Gemüse</li>
        <li><strong>Dessert:</strong> 1-1,5 Portionen pro Person</li>
        <li><strong>Getränke:</strong> 2 Getränke erste Stunde, 1 pro weitere Stunde</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCMR() {
      const guests = parseInt((document.getElementById('cmr-guests') as HTMLInputElement).value) || 1;
      const hours = parseFloat((document.getElementById('cmr-hours') as HTMLInputElement).value) || 4;
      const meal = (document.getElementById('cmr-meal') as HTMLSelectElement).value;
      const appVar = parseInt((document.getElementById('cmr-appvar') as HTMLInputElement).value) || 4;
      const bev = (document.getElementById('cmr-bev') as HTMLSelectElement).value;
      let appPerGuest = 6;
      let mainServings = guests;
      let dessertServings = guests;
      let kgPerGuest = 0.7;
      if (meal === 'full') { appPerGuest = 6; mainServings = guests; dessertServings = guests; kgPerGuest = 0.7; }
      else if (meal === 'buffet') { appPerGuest = 8; mainServings = Math.ceil(guests * 1.15); dessertServings = Math.ceil(guests * 1.1); kgPerGuest = 0.8; }
      else if (meal === 'cocktail') { appPerGuest = 14; mainServings = 0; dessertServings = Math.ceil(guests * 0.75); kgPerGuest = 0.55; }
      else if (meal === 'light') { appPerGuest = 4; mainServings = guests; dessertServings = Math.ceil(guests * 0.8); kgPerGuest = 0.45; }
      const totalApp = appPerGuest * guests;
      const perVariety = Math.ceil(totalApp / appVar);
      let totalDrinks = 0;
      if (bev === 'yes' || bev === 'nonalc') {
        totalDrinks = guests * (2 + Math.max(0, hours - 1));
      }
      const totalWeight = Math.round(guests * kgPerGuest);
      document.getElementById('cmr-totalapp')!.textContent = totalApp.toLocaleString('de-DE');
      document.getElementById('cmr-pervar')!.textContent = perVariety + ' Stück pro Sorte (' + appVar + ' Sorten)';
      document.getElementById('cmr-mains')!.textContent = mainServings > 0 ? mainServings.toLocaleString('de-DE') : 'Entfällt';
      document.getElementById('cmr-desserts')!.textContent = dessertServings.toLocaleString('de-DE');
      document.getElementById('cmr-drinks')!.textContent = totalDrinks > 0 ? totalDrinks.toLocaleString('de-DE') : 'Entfällt';
      document.getElementById('cmr-weight')!.textContent = totalWeight.toLocaleString('de-DE');
      let details = '<h3 class="font-semibold text-sm text-text mb-2">Detaillierte Aufschlüsselung</h3><ul class="text-sm text-text-secondary space-y-1">';
      details += '<li>Vorspeisen: ' + appPerGuest + ' Stück/Gast x ' + guests + ' Gäste = ' + totalApp + ' Stück</li>';
      if (mainServings > 0) details += '<li>Hauptgerichte: ' + mainServings + ' Portionen (150-200 g Protein)</li>';
      details += '<li>Desserts: ' + dessertServings + ' Portionen</li>';
      if (totalDrinks > 0) {
        const softDrinks = Math.ceil(totalDrinks * 0.35);
        const water = Math.ceil(totalDrinks * 0.25);
        const alcDrinks = bev === 'yes' ? totalDrinks - softDrinks - water : 0;
        details += '<li>Getränke: ' + totalDrinks + ' gesamt';
        if (bev === 'yes') details += ' (Alkoholisch: ' + alcDrinks + ', Softdrinks: ' + softDrinks + ', Wasser: ' + water + ')';
        details += '</li>';
      }
      details += '<li>Gesamtgewicht Essen: ~' + totalWeight + ' kg</li>';
      details += '</ul>';
      document.getElementById('cmr-details')!.innerHTML = details;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cmr-guests') as HTMLInputElement).value = '80';
      (document.getElementById('cmr-hours') as HTMLInputElement).value = '4';
      (document.getElementById('cmr-appvar') as HTMLInputElement).value = '4';
      document.querySelectorAll('.cmr-in').forEach(el => { el.addEventListener('input', calcCMR); el.addEventListener('change', calcCMR); });
      calcCMR();
    }, 50);
  </script>
</CalculatorLayout>
