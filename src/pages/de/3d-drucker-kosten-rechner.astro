---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "3D-Drucker Kostenrechner - Material, Strom & Gesamtkosten";
const description = "Berechnen Sie die Gesamtkosten eines 3D-Drucks inklusive Filamentkosten, Stromkosten und Arbeitszeit. Geben Sie Gewicht, Filamentpreis, Leistung und Druckzeit ein.";
const relatedCalcs = [
  { name: "Schrittmotor-Rechner", url: "/stepper-motor-calculator", description: "Motorschritte." },
  { name: "Zahnrad-Rechner", url: "/gear-calculator", description: "Zahnrad-Verhältnis." },
  { name: "Riemenlängen-Rechner", url: "/belt-length-calculator", description: "Riemen/Umlenkung." },
  { name: "Spannungs-Rechner", url: "/stress-strain-calculator", description: "Materialspannung." },
  { name: "Akkulaufzeit-Rechner", url: "/battery-life-calculator", description: "Akkulaufzeit." },
  { name: "Einheitenumrechner", url: "/unit-converter", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="3D-Drucker Kostenrechner" keywords="3D-Drucker Kosten, Filamentkosten, Druckkosten, Stromkosten, 3D-Druck, Materialkosten" breadcrumbs={[{ name: "3D-Drucker Kostenrechner", url: "/de/3d-drucker-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">3D-Drucker Kostenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Gesamtkosten Ihres 3D-Drucks, indem Sie Filamentgewicht, Preis pro kg, Druckerleistung, Druckzeit und Stundenlohn eingeben.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Filamentverbrauch (Gramm)</label><input type="number" id="3d-weight" class="td-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Filamentpreis (€/kg)</label><input type="number" id="3d-fpcost" class="td-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Druckerleistung (Watt)</label><input type="number" id="3d-watts" class="td-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="10" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Druckzeit (Stunden)</label><input type="number" id="3d-hours" class="td-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (€/kWh)</label><input type="number" id="3d-rate" class="td-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.01" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stundenlohn (€/h) — optional</label><input type="number" id="3d-labor" class="td-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Aufschlag / Gewinnmarge (%)</label>
          <input type="number" id="3d-markup" class="td-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="5" min="0">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="3d-result">0,00 €</div>
          <div class="text-sm text-blue-200 mt-1" id="3d-with-markup"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten</div><div class="text-xl font-bold" id="3d-matcost">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stromkosten</div><div class="text-xl font-bold" id="3d-elcost">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Arbeitskosten</div><div class="text-xl font-bold" id="3d-laborcost">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Gramm</div><div class="text-xl font-bold" id="3d-pergram">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schritt für Schritt</h3>
          <div class="font-mono text-sm space-y-1" id="3d-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="3d-printer-cost" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kostenaufschlüsselung beim 3D-Druck</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Materialkosten = Gewicht(g) × Preis(€/kg) / 1000</p>
        <p>Stromkosten = Watt × Stunden / 1000 × Tarif(€/kWh)</p>
        <p>Arbeitskosten = Stunden × Stundenlohn(€/h)</p>
        <p>Gesamt = Material + Strom + Arbeit</p>
        <p>Verkaufspreis = Gesamt × (1 + Aufschlag%/100)</p>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcTd() {
      const weight = parseFloat((document.getElementById('3d-weight') as HTMLInputElement).value) || 0;
      const fpCost = parseFloat((document.getElementById('3d-fpcost') as HTMLInputElement).value) || 0;
      const watts = parseFloat((document.getElementById('3d-watts') as HTMLInputElement).value) || 0;
      const hours = parseFloat((document.getElementById('3d-hours') as HTMLInputElement).value) || 0;
      const elRate = parseFloat((document.getElementById('3d-rate') as HTMLInputElement).value) || 0;
      const laborRate = parseFloat((document.getElementById('3d-labor') as HTMLInputElement).value) || 0;
      const markup = parseFloat((document.getElementById('3d-markup') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const matCost = (weight * fpCost) / 1000;
      steps.push(`Material = ${weight}g × ${fmt(fpCost)} €/kg / 1000 = ${fmt(matCost)} €`);
      const kWh = (watts * hours) / 1000;
      const elCost = kWh * elRate;
      steps.push(`Strom = ${watts}W × ${hours}h / 1000 × ${fmt(elRate)} €/kWh`);
      steps.push(`= ${kWh.toLocaleString('de-DE', {minimumFractionDigits:3, maximumFractionDigits:3})} kWh × ${fmt(elRate)} € = ${fmt(elCost)} €`);
      const labCost = laborRate * hours;
      if (laborRate > 0) {
        steps.push(`Arbeit = ${fmt(laborRate)} €/h × ${hours}h = ${fmt(labCost)} €`);
      }
      const total = matCost + elCost + labCost;
      steps.push(`Gesamtkosten = ${fmt(matCost)} € + ${fmt(elCost)} € + ${fmt(labCost)} € = ${fmt(total)} €`);
      let withMarkup = total;
      if (markup > 0) {
        withMarkup = total * (1 + markup / 100);
        steps.push(`Mit ${markup}% Aufschlag: ${fmt(total)} € × ${(1 + markup/100).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2})} = ${fmt(withMarkup)} €`);
      }
      const perGram = weight > 0 ? total / weight : 0;
      document.getElementById('3d-result')!.textContent = fmt(total) + ' €';
      document.getElementById('3d-with-markup')!.textContent = markup > 0 ? `Mit ${markup}% Aufschlag: ${fmt(withMarkup)} €` : '';
      document.getElementById('3d-matcost')!.textContent = fmt(matCost) + ' €';
      document.getElementById('3d-elcost')!.textContent = fmt(elCost) + ' €';
      document.getElementById('3d-laborcost')!.textContent = laborRate > 0 ? fmt(labCost) + ' €' : '0,00 €';
      document.getElementById('3d-pergram')!.textContent = perGram > 0 ? perGram.toLocaleString('de-DE', {minimumFractionDigits:4, maximumFractionDigits:4}) + ' €/g' : '—';
      document.getElementById('3d-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('3d-weight') as HTMLInputElement).value = '50';
      (document.getElementById('3d-fpcost') as HTMLInputElement).value = '25';
      (document.getElementById('3d-watts') as HTMLInputElement).value = '200';
      (document.getElementById('3d-hours') as HTMLInputElement).value = '4';
      (document.getElementById('3d-rate') as HTMLInputElement).value = '0.30';
      (document.getElementById('3d-labor') as HTMLInputElement).value = '0';
      (document.getElementById('3d-markup') as HTMLInputElement).value = '0';
      document.querySelectorAll('.td-in').forEach(el => { el.addEventListener('input', calcTd); el.addEventListener('change', calcTd); });
      calcTd();
    }, 50);
  </script>
</CalculatorLayout>
