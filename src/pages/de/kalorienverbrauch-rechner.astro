---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kalorienverbrauch-Rechner - Kalorien pro Aktivit\u00e4t berechnen";
const description = "Berechnen Sie den Kalorienverbrauch nach Aktivit\u00e4tsart und Dauer. \u00dcber 50 \u00dcbungen inkl. Gehen, Laufen, Radfahren, Schwimmen.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner", description: "Defizit." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "BMI." },
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffein." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlaf." },
  { name: "Campingausr\u00fcstung", url: "/de/campingausruestung-rechner", description: "Camping." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kalorienverbrauch-Rechner" lang="de" enSlug="calories-burned-calculator" keywords="kalorienverbrauch rechner, sport kalorien, MET rechner, aktivit\u00e4t kalorien, training kalorien" breadcrumbs={[{ name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kalorienverbrauch-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie den Kalorienverbrauch bei Sport basierend auf Aktivit&auml;t, Dauer und K&ouml;rpergewicht.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">K&ouml;rpergewicht</label>
            <div class="flex gap-2">
              <input type="number" id="kv-weight" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg" value="70" min="30" max="250">
              <select id="kv-unit" class="px-3 py-3 border border-border rounded-xl">
                <option value="kg" selected>kg</option>
                <option value="lbs">lbs</option>
              </select>
            </div>
          </div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Dauer</label>
            <div class="flex gap-2 items-center">
              <input type="number" id="kv-duration" class="flex-1 px-4 py-3 border border-border rounded-xl text-lg" value="30" min="1" max="600">
              <span class="text-text-muted font-semibold">Minuten</span>
            </div>
          </div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Aktivit&auml;tskategorie</label>
            <select id="kv-category" class="w-full px-4 py-3 border border-border rounded-xl text-lg mb-3">
              <option value="cardio">Ausdauer &amp; Laufen</option>
              <option value="sports">Sport</option>
              <option value="gym">Fitnessstudio &amp; Gewichte</option>
              <option value="daily">Alltagsaktivit&auml;ten</option>
              <option value="water">Wassersport</option>
            </select>
          </div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Aktivit&auml;t</label>
            <div class="grid grid-cols-1 gap-2 max-h-64 overflow-y-auto" id="kv-activities"></div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Verbrannte Kalorien</div>
            <div class="text-5xl font-extrabold" id="kv-calories">0</div>
            <div class="text-sm text-blue-200 mt-1" id="kv-activity-name">Aktivit&auml;t w&auml;hlen</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Pro Minute</div>
              <div class="text-xl font-bold" id="kv-per-min">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Pro Stunde</div>
              <div class="text-xl font-bold" id="kv-per-hour">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">MET-Wert</div>
              <div class="text-xl font-bold" id="kv-met">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Fett-&Auml;quivalent</div>
              <div class="text-xl font-bold" id="kv-fat">0 g</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-2">Das entspricht</h3>
            <div class="space-y-1 text-sm text-text-secondary" id="kv-equiv"></div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="calories-burned" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie der Kalorienverbrauch berechnet wird</h2>
      <p>Der Kalorienverbrauch wird mit MET-Werten (Metabolisches &Auml;quivalent) gesch&auml;tzt, die den Energieverbrauch als Vielfaches des Ruheumsatzes darstellen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">Kalorien = MET &times; Gewicht (kg) &times; Dauer (Stunden)</div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie genau ist das?</strong> MET-basierte Sch&auml;tzungen sind f&uuml;r die meisten Menschen auf 15-20% genau.</p>
      <p><strong>Wie viele Kalorien f&uuml;r 1 kg?</strong> Sie ben&ouml;tigen ein Defizit von ca. 7.700 Kalorien, um 1 kg K&ouml;rperfett zu verlieren.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    type Activity = { name: string; met: number };

    const activities: Record<string, Activity[]> = {
      cardio: [
        { name: 'Gehen (3 km/h, langsam)', met: 2.5 },
        { name: 'Gehen (5 km/h, moderat)', met: 3.5 },
        { name: 'Gehen (6,5 km/h, z\u00fcgig)', met: 5.0 },
        { name: 'Wandern', met: 6.0 },
        { name: 'Joggen (8 km/h)', met: 8.0 },
        { name: 'Laufen (10 km/h)', met: 9.8 },
        { name: 'Laufen (11 km/h)', met: 11.0 },
        { name: 'Laufen (13 km/h)', met: 11.8 },
        { name: 'Laufen (16 km/h)', met: 14.5 },
        { name: 'Radfahren (16-19 km/h)', met: 6.0 },
        { name: 'Radfahren (22-26 km/h)', met: 10.0 },
        { name: 'Radfahren (> 32 km/h)', met: 16.0 },
        { name: 'Heimtrainer (moderat)', met: 7.0 },
        { name: 'Heimtrainer (intensiv)', met: 10.5 },
        { name: 'Crosstrainer', met: 5.0 },
        { name: 'Ruderger\u00e4t (moderat)', met: 7.0 },
        { name: 'Ruderger\u00e4t (intensiv)', met: 12.0 },
        { name: 'Seilspringen (moderat)', met: 11.8 },
        { name: 'Treppensteigen', met: 9.0 },
      ],
      sports: [
        { name: 'Basketball (Spiel)', met: 8.0 },
        { name: 'Fu\u00dfball (Freizeit)', met: 7.0 },
        { name: 'Fu\u00dfball (Wettkampf)', met: 10.0 },
        { name: 'Tennis (Einzel)', met: 8.0 },
        { name: 'Tennis (Doppel)', met: 5.0 },
        { name: 'Volleyball', met: 4.0 },
        { name: 'Golf (zu Fu\u00df)', met: 4.5 },
        { name: 'Badminton', met: 5.5 },
        { name: 'Tischtennis', met: 4.0 },
        { name: 'Boxen (Sparring)', met: 9.0 },
        { name: 'Kampfsport', met: 10.3 },
        { name: 'Ringen', met: 6.0 },
        { name: 'Eislaufen', met: 7.0 },
        { name: 'Skifahren (Abfahrt)', met: 6.0 },
        { name: 'Langlauf', met: 9.0 },
      ],
      gym: [
        { name: 'Krafttraining (leicht)', met: 3.5 },
        { name: 'Krafttraining (intensiv)', met: 6.0 },
        { name: 'Zirkeltraining', met: 8.0 },
        { name: 'CrossFit', met: 8.0 },
        { name: 'Pilates', met: 3.0 },
        { name: 'Yoga (Hatha)', met: 2.5 },
        { name: 'Yoga (Power/Vinyasa)', met: 4.0 },
        { name: 'Dehnen', met: 2.3 },
        { name: 'Eigengewichts\u00fcbungen', met: 8.0 },
        { name: 'HIIT-Training', met: 8.0 },
      ],
      daily: [
        { name: 'Kochen', met: 2.5 },
        { name: 'Putzen', met: 3.5 },
        { name: 'Gartenarbeit', met: 4.0 },
        { name: 'Rasenm\u00e4hen (Handm\u00e4her)', met: 5.5 },
        { name: 'Schneeschippen', met: 6.0 },
        { name: 'M\u00f6bel bewegen', met: 6.0 },
        { name: 'Mit Kindern spielen', met: 4.0 },
        { name: 'Hund ausf\u00fchren', met: 3.0 },
        { name: 'Einkaufen', met: 2.3 },
        { name: 'Tanzen (Gesellschaft)', met: 4.5 },
      ],
      water: [
        { name: 'Schwimmen (Freizeit)', met: 6.0 },
        { name: 'Bahnen schwimmen (moderat)', met: 7.0 },
        { name: 'Bahnen schwimmen (intensiv)', met: 10.0 },
        { name: 'Wassergymnastik', met: 5.5 },
        { name: 'Kajakfahren', met: 5.0 },
        { name: 'Surfen', met: 3.0 },
        { name: 'Wasserball', met: 10.0 },
        { name: 'Stand-Up-Paddling', met: 6.0 },
      ],
    };

    let selectedActivity: Activity | null = null;

    function renderActivities() {
      const cat = (document.getElementById('kv-category') as HTMLSelectElement).value;
      const list = activities[cat] || [];
      const container = document.getElementById('kv-activities')!;
      container.innerHTML = list.map((a, i) =>
        '<button class="kv-act-btn flex justify-between items-center px-4 py-2.5 border rounded-xl text-left text-sm hover:bg-surface-alt transition ' + (i === 0 ? 'border-primary bg-blue-50' : 'border-border') + '" data-idx="' + i + '"><span class="font-medium">' + a.name + '</span><span class="text-text-muted text-xs">' + a.met + ' MET</span></button>'
      ).join('');

      container.querySelectorAll('.kv-act-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.kv-act-btn').forEach(b => { b.classList.remove('border-primary', 'bg-blue-50'); b.classList.add('border-border'); });
          btn.classList.remove('border-border'); btn.classList.add('border-primary', 'bg-blue-50');
          selectedActivity = list[parseInt((btn as HTMLElement).dataset.idx || '0')];
          calcBurned();
        });
      });

      selectedActivity = list[0] || null;
      calcBurned();
    }

    function calcBurned() {
      if (!selectedActivity) return;

      let weightKg = parseFloat((document.getElementById('kv-weight') as HTMLInputElement).value) || 70;
      const unit = (document.getElementById('kv-unit') as HTMLSelectElement).value;
      if (unit === 'lbs') weightKg = weightKg / 2.2046;

      const duration = parseFloat((document.getElementById('kv-duration') as HTMLInputElement).value) || 30;
      const met = selectedActivity.met;
      const hours = duration / 60;
      const calories = met * weightKg * hours;
      const perMin = calories / duration;
      const perHour = met * weightKg;
      const fatGrams = calories / 7700 * 1000;

      document.getElementById('kv-calories')!.textContent = Math.round(calories).toLocaleString('de-DE');
      document.getElementById('kv-activity-name')!.textContent = selectedActivity.name;
      document.getElementById('kv-per-min')!.textContent = perMin.toFixed(1).replace('.', ',');
      document.getElementById('kv-per-hour')!.textContent = Math.round(perHour).toLocaleString('de-DE');
      document.getElementById('kv-met')!.textContent = String(met);
      document.getElementById('kv-fat')!.textContent = fatGrams.toFixed(0) + ' g';

      const equiv = [
        { item: 'Scheiben Pizza', cal: 285 },
        { item: 'Dosen Cola', cal: 140 },
        { item: 'Schokoriegel', cal: 230 },
        { item: '\u00c4pfel', cal: 95 },
        { item: 'Bier (0,5l)', cal: 200 },
        { item: 'Berliner/Donuts', cal: 300 },
      ];
      document.getElementById('kv-equiv')!.innerHTML = equiv.map(e =>
        '<div class="flex justify-between"><span>' + e.item + '</span><span class="font-semibold">' + (calories / e.cal).toFixed(1).replace('.', ',') + '</span></div>'
      ).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('kv-category')!.addEventListener('change', renderActivities);
      ['kv-weight', 'kv-duration'].forEach(id => document.getElementById(id)!.addEventListener('input', calcBurned));
      document.getElementById('kv-unit')!.addEventListener('change', calcBurned);
      renderActivities();
    }, 50);
  </script>
</CalculatorLayout>
