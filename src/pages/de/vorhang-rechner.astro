---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Vorhang-Rechner - Stoffbedarf & Panelbreiten berechnen";
const description = "Berechnen Sie den Vorhangstoffbedarf, Panelbreiten und Stangengroesse fuer Ihre Fenster.";
const relatedCalcs = [
  { name: "Quadratmeterrechner", url: "/de/quadratmeterrechner", description: "Flaeche berechnen." },
  { name: "Stuckleisten-Rechner", url: "/de/stuckleisten-rechner", description: "Stuckleisten." },
  { name: "Arbeitsplatten-Rechner", url: "/de/arbeitsplatte-rechner", description: "Arbeitsplatten." },
  { name: "Flaechenrechner", url: "/de/flaechenrechner", description: "Flaechen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Vorhang-Rechner" keywords="Vorhang Rechner, Vorhangstoff, Gardinenpanel, Fensterdekoration, Vorhangstange, Gardinen" breadcrumbs={[{ name: "Vorhang-Rechner", url: "/de/vorhang-rechner" }]} lang="de" enSlug="curtain-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Vorhang-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie Vorhangstoff und Panels fuer Ihre Fenster.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fensterbreite (cm)</label><input type="number" id="vhr-ww" class="vhr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="150" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fensterhoehe (cm)</label><input type="number" id="vhr-wh" class="vhr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="120" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Faltenverhaeltnis</label>
            <select id="vhr-full" class="vhr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1.5">1,5x (Standard)</option>
              <option value="2" selected>2x (empfohlen)</option>
              <option value="2.5">2,5x (voll/luxurioes)</option>
              <option value="3">3x (sehr voll)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Vorhanglaenge</label>
            <select id="vhr-hang" class="vhr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="sill">Fensterbank</option>
              <option value="below">Unter Fensterbank (+10 cm)</option>
              <option value="floor" selected>Bodenlang</option>
              <option value="puddle">Aufliegend (+8 cm)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stange ueber Fenster (cm)</label><input type="number" id="vhr-above" class="vhr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Boden ab Fensterunterkan. (cm)</label><input type="number" id="vhr-floor" class="vhr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Stoffbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="vhr-result">0 m</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtbreite</div><div class="text-lg font-bold font-mono" id="vhr-tw">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schnittlaenge</div><div class="text-lg font-bold font-mono" id="vhr-cl">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Panels</div><div class="text-lg font-bold font-mono" id="vhr-panels">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stangenbreite</div><div class="text-xl font-bold font-mono" id="vhr-rod">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Panelbreite</div><div class="text-xl font-bold font-mono" id="vhr-pwidth">0 cm</div></div>
        </div>
      </div>
      <ShareButton calculatorId="curtain" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Vorhaenge richtig ausmessen</h2>
      <p>Fuer schoene Falten empfehlen wir ein Faltenverhaeltnis von 2x. Die Vorhangstange sollte etwa 15-30 cm ueber dem Fenster und 15 cm auf jeder Seite ueber die Fensterbreite hinaus montiert werden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Wie breit sollte der Stoff sein?</strong> Mindestens das 1,5-fache der Fensterbreite fuer leichte Falten, ideal das 2-fache.</li>
        <li><strong>Wie lang sollten Vorhaenge sein?</strong> Bodenlange Vorhaenge sollten 1-2 cm ueber dem Boden enden.</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcVHR() {
      const ww = parseFloat((document.getElementById('vhr-ww') as HTMLInputElement).value) || 150;
      const wh = parseFloat((document.getElementById('vhr-wh') as HTMLInputElement).value) || 120;
      const fullness = parseFloat((document.getElementById('vhr-full') as HTMLSelectElement).value);
      const hang = (document.getElementById('vhr-hang') as HTMLSelectElement).value;
      const above = parseFloat((document.getElementById('vhr-above') as HTMLInputElement).value) || 0;
      const floorDist = parseFloat((document.getElementById('vhr-floor') as HTMLInputElement).value) || 0;
      const rodWidth = ww + 30;
      const totalFabricWidth = rodWidth * fullness;
      const fabricWidthPerPanel = 140;
      const panels = Math.ceil(totalFabricWidth / fabricWidthPerPanel);
      let curtainLength = wh + above;
      if (hang === 'sill') curtainLength = wh + above;
      else if (hang === 'below') curtainLength = wh + above + 10;
      else if (hang === 'floor') curtainLength = wh + above + floorDist - 1;
      else if (hang === 'puddle') curtainLength = wh + above + floorDist + 8;
      const cutLength = curtainLength + 20;
      const fabricMeters = (panels * cutLength) / 100;
      document.getElementById('vhr-result')!.textContent = fabricMeters.toFixed(1).replace('.', ',') + ' m';
      document.getElementById('vhr-tw')!.textContent = totalFabricWidth.toFixed(0) + ' cm';
      document.getElementById('vhr-cl')!.textContent = cutLength.toFixed(0) + ' cm';
      document.getElementById('vhr-panels')!.textContent = panels.toString();
      document.getElementById('vhr-rod')!.textContent = rodWidth.toFixed(0) + ' cm';
      document.getElementById('vhr-pwidth')!.textContent = (totalFabricWidth / panels).toFixed(0) + ' cm';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vhr-in').forEach(el => { el.addEventListener('input', calcVHR); el.addEventListener('change', calcVHR); });
      calcVHR();
    }, 50);
  </script>
</CalculatorLayout>
