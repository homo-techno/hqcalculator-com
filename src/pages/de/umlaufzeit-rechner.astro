---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Umlaufzeit Rechner – Drittes Keplersches Gesetz berechnen";
const description = "Berechnen Sie Umlaufzeiten von Planeten und Satelliten mit dem Dritten Keplerschen Gesetz.";
const relatedCalcs = [
  { name: "Obsidian-Hydration Rechner", url: "/de/obsidian-hydration-rechner", description: "Archäologische Datierung." },
  { name: "Zahlenfolge Rechner", url: "/de/zahlenfolge-rechner", description: "Arithmetische Folgen." },
  { name: "Osmotischer Druck Rechner", url: "/de/osmotischer-druck-rechner", description: "Osmotischen Druck." },
  { name: "Meeresversauerung Rechner", url: "/de/meeresversauerung-rechner", description: "Ozean-pH berechnen." },
];
---
<CalculatorLayout lang="de" enSlug="orbital-period-calculator" title={title} description={description} calculatorName="Umlaufzeit Rechner" keywords="Umlaufzeit, Kepler, Satellit, Planet, Gravitationsgesetz, Kreisbahn, astronomische Einheit" breadcrumbs={[{ name: "Umlaufzeit Rechner", url: "/de/umlaufzeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Umlaufzeit Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Umlaufzeit von Planeten, Monden und Satelliten nach dem Dritten Keplerschen Gesetz und dem Gravitationsgesetz von Newton.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Berechnungsmodus</label>
          <select id="ul-mode" class="ul-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="kepler">Keplersch (Relativzur Erde/Sonne)</option>
            <option value="newton">Newton (allgemein)</option>
            <option value="sat">Erdsatellit (LEO/GEO)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1" id="ul-lbl1">Große Halbachse a (AU)</label>
            <input type="number" id="ul-a" class="ul-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1" id="ul-lbl2">Zentralmasse M (Sonnenmassen)</label>
            <input type="number" id="ul-m" class="ul-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" placeholder="nur Newton-Modus">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Umlaufzeit T</div>
          <div class="text-5xl font-extrabold font-mono" id="ul-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="ul-subtitle"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">In Jahren</div>
            <div class="text-xl font-bold" id="ul-years">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">In Tagen</div>
            <div class="text-xl font-bold" id="ul-days">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">In Stunden</div>
            <div class="text-xl font-bold" id="ul-hours">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Orbitalgeschw.</div>
            <div class="text-xl font-bold" id="ul-vel">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsweg</h3>
          <div class="font-mono text-sm space-y-1" id="ul-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="orbital-period" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Dritte Keplersche Gesetz</h2>
      <p>Das Dritte Keplersche Gesetz (1619) besagt: Das Quadrat der Umlaufzeit ist proportional zum Kubus der großen Halbachse der Ellipsenbahn. Für unser Sonnensystem gilt: T² = a³, wenn T in Jahren und a in astronomischen Einheiten (AU) gemessen wird. Newton erkannte, dass diese Beziehung eine Konsequenz seines Gravitationsgesetzes ist und allgemein für jede Zweikörperbewegung gilt.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Kepler (Sonnensystem): T² = a³ [T in Jahren, a in AU]</p>
        <p>Newton (allgemein): T = 2π · √(a³ / G·M)</p>
        <p>G = 6,674 × 10⁻¹¹ N·m²/kg²</p>
        <p>v_orbital = 2πa / T</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist eine geostationäre Umlaufbahn?</strong> Eine geostationäre Umlaufbahn (GEO) liegt in ca. 35.786 km Höhe über dem Äquator. Satelliten dort haben eine Umlaufzeit von genau 24 Stunden und erscheinen von der Erde aus stillstehend.</p>
      <p><strong>Was ist die ISS-Umlaufbahn?</strong> Die Internationale Raumstation (ISS) umläuft die Erde in ca. 408 km Höhe mit einer Umlaufzeit von ca. 92 Minuten und einer Geschwindigkeit von etwa 7,66 km/s.</p>
      <p><strong>Warum ist die Mars-Umlaufzeit fast doppelt so lang wie die Erdumlaufzeit?</strong> Der Mars ist ca. 1,52 AU von der Sonne entfernt. Nach Keplers drittem Gesetz: T = 1,52^(3/2) ≈ 1,88 Jahre.</p>
      <p><strong>Was ist eine astronomische Einheit (AU)?</strong> Eine astronomische Einheit entspricht dem mittleren Abstand Erde-Sonne: 149.597.870,7 km (ca. 150 Millionen km).</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcUL() {
      const mode = (document.getElementById('ul-mode') as HTMLSelectElement).value;
      const a = parseFloat((document.getElementById('ul-a') as HTMLInputElement).value) || 1;
      const mSun = parseFloat((document.getElementById('ul-m') as HTMLInputElement).value) || 1;
      const lbl1 = document.getElementById('ul-lbl1')!;
      const lbl2 = document.getElementById('ul-lbl2')!;
      const fmt2 = (v: number) => v.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:4});
      const G = 6.674e-11;
      const MSun = 1.989e30;
      const AU = 1.496e11;
      let Tsec: number;
      const steps: string[] = [];
      if (mode === 'kepler') {
        lbl1.textContent = 'Große Halbachse a (AU)';
        lbl2.textContent = 'Zentralmasse (nur Newton-Modus)';
        const Tyr = Math.pow(a * a * a, 0.5);
        Tsec = Tyr * 365.25 * 86400;
        steps.push('Kepler: T² = a³ → T = √(' + fmt2(a) + '³) = ' + fmt2(Tyr) + ' Jahre');
      } else if (mode === 'newton') {
        lbl1.textContent = 'Große Halbachse a (AU)';
        lbl2.textContent = 'Zentralmasse M (Sonnenmassen)';
        const aM = a * AU;
        const M = mSun * MSun;
        Tsec = 2 * Math.PI * Math.sqrt(Math.pow(aM, 3) / (G * M));
        steps.push('Newton: T = 2π · √(a³/G·M)');
        steps.push('a = ' + fmt2(a) + ' AU = ' + (aM/1e9).toLocaleString('de-DE', {maximumFractionDigits:0}) + ' Mio. km');
        steps.push('T = ' + (Tsec/86400/365.25).toLocaleString('de-DE', {minimumFractionDigits:3, maximumFractionDigits:3}) + ' Jahre');
      } else {
        lbl1.textContent = 'Orbithöhe h (km über Erde)';
        lbl2.textContent = 'Erdmasse (fest: 5,972×10²⁴ kg)';
        const RE = 6371e3;
        const ME = 5.972e24;
        const r = (a * 1e3) + RE;
        Tsec = 2 * Math.PI * Math.sqrt(Math.pow(r, 3) / (G * ME));
        const vOrbKms = 2 * Math.PI * r / Tsec / 1000;
        steps.push('Erdsatellit: r = RE + h = ' + (r/1e3).toLocaleString('de-DE', {maximumFractionDigits:0}) + ' km');
        steps.push('T = 2π · √(r³/G·M_E) = ' + (Tsec/60).toLocaleString('de-DE', {maximumFractionDigits:1}) + ' min');
        steps.push('v = ' + vOrbKms.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' km/s');
      }
      const days = Tsec / 86400;
      const years = days / 365.25;
      const hours = Tsec / 3600;
      const aM2 = mode === 'sat' ? (a * 1e3 + 6371e3) : (a * AU);
      const velKms = 2 * Math.PI * aM2 / Tsec / 1000;
      document.getElementById('ul-result')!.textContent = years >= 1 ? fmt2(years) + ' Jahre' : days >= 1 ? fmt2(days) + ' Tage' : (hours).toLocaleString('de-DE', {maximumFractionDigits:1}) + ' Stunden';
      document.getElementById('ul-subtitle')!.textContent = mode === 'kepler' ? 'Keplersches Modell (Sonnensystem)' : mode === 'newton' ? 'Newtonsches Gravitationsgesetz' : 'Erdsatellit';
      document.getElementById('ul-years')!.textContent = years.toLocaleString('de-DE', {minimumFractionDigits:4, maximumFractionDigits:4}) + ' a';
      document.getElementById('ul-days')!.textContent = days.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' Tage';
      document.getElementById('ul-hours')!.textContent = hours.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' h';
      document.getElementById('ul-vel')!.textContent = velKms.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' km/s';
      document.getElementById('ul-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ul-a') as HTMLInputElement).value = '1.524';
      (document.getElementById('ul-m') as HTMLInputElement).value = '1';
      document.querySelectorAll('.ul-in').forEach(el => { el.addEventListener('input', calcUL); el.addEventListener('change', calcUL); });
      calcUL();
    }, 50);
  </script>
</CalculatorLayout>
