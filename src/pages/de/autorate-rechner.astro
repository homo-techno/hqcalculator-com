---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Autorate-Rechner - Monatliche Kreditrate berechnen";
const description = "Berechnen Sie Ihre monatliche Autokreditrate mit Anzahlung, Inzahlungnahme, Zinssatz und Laufzeit. Sehen Sie Gesamtzinsen und Tilgungsplan.";
const relatedCalcs = [
  { name: "Auto-Leasing", url: "/de/auto-leasing-rechner", description: "Leasing." },
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
  { name: "Kfz-Versicherung", url: "/de/kfz-versicherung-rechner", description: "Versicherung." },
  { name: "Kapitalertragssteuer", url: "/de/kapitalertragssteuer-rechner", description: "Kapitalertr\u00e4ge." },
  { name: "Kindersitz-Rechner", url: "/de/kindersitz-rechner", description: "Kindersitz." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlage." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Autorate-Rechner" lang="de" enSlug="car-payment-calculator" keywords="autorate rechner, autokredit, monatliche rate, autofinanzierung, zinsen autokredit" breadcrumbs={[{ name: "Autorate-Rechner", url: "/de/autorate-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Autorate-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihre monatliche Autokredit-Rate, Gesamtzinsen und sehen Sie eine Tilgungs&uuml;bersicht.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Fahrzeugpreis (&euro;)</label>
          <input type="number" id="ar-price" class="ar-in w-full border border-border rounded-lg px-3 py-2" value="30000" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahlung (&euro;)</label>
          <input type="number" id="ar-down" class="ar-in w-full border border-border rounded-lg px-3 py-2" value="3000" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Inzahlungnahme (&euro;)</label>
          <input type="number" id="ar-trade" class="ar-in w-full border border-border rounded-lg px-3 py-2" value="0" min="0" step="500">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Effektiver Jahreszins (%)</label>
          <input type="number" id="ar-rate" class="ar-in w-full border border-border rounded-lg px-3 py-2" value="4.9" min="0" max="20" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Laufzeit (Monate)</label>
          <select id="ar-term" class="ar-in w-full border border-border rounded-lg px-3 py-2">
            <option value="24">24 Monate</option>
            <option value="36">36 Monate</option>
            <option value="48" selected>48 Monate</option>
            <option value="60">60 Monate</option>
            <option value="72">72 Monate</option>
            <option value="84">84 Monate</option>
          </select>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Rate</div>
          <div class="text-5xl font-extrabold font-mono" id="ar-result">0 &euro;</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kreditbetrag</div>
            <div class="text-xl font-bold" id="ar-loan-amt">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtzinsen</div>
            <div class="text-xl font-bold text-danger" id="ar-interest">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtkosten</div>
            <div class="text-xl font-bold" id="ar-total-cost">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">MwSt. (19%)</div>
            <div class="text-xl font-bold" id="ar-tax-amt">0 &euro;</div>
          </div>
        </div>

        <div class="mt-4">
          <h3 class="text-lg font-bold text-text mb-2">Tilgungs&uuml;bersicht</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border text-left">
                  <th class="py-2 pr-3 font-semibold">Jahr</th>
                  <th class="py-2 pr-3 font-semibold text-right">Tilgung</th>
                  <th class="py-2 pr-3 font-semibold text-right">Zinsen</th>
                  <th class="py-2 font-semibold text-right">Restschuld</th>
                </tr>
              </thead>
              <tbody id="ar-amort"></tbody>
            </table>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="car-payment" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Wie berechnet sich die Autorate?</h3>
      <p>Die monatliche Rate berechnet sich aus dem Kreditbetrag, dem effektiven Jahreszins und der Laufzeit. Eine l&auml;ngere Laufzeit senkt die Rate, erh&ouml;ht aber die Gesamtzinsen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAR() {
      const price = parseFloat((document.getElementById('ar-price') as HTMLInputElement).value) || 0;
      const down = parseFloat((document.getElementById('ar-down') as HTMLInputElement).value) || 0;
      const trade = parseFloat((document.getElementById('ar-trade') as HTMLInputElement).value) || 0;
      const annualRate = parseFloat((document.getElementById('ar-rate') as HTMLInputElement).value) || 0;
      const term = parseInt((document.getElementById('ar-term') as HTMLSelectElement).value) || 48;

      const loanAmount = Math.max(0, price - down - trade);
      const r = annualRate / 100 / 12;

      let monthly = 0;
      if (r > 0 && term > 0) {
        monthly = loanAmount * (r * Math.pow(1 + r, term)) / (Math.pow(1 + r, term) - 1);
      } else if (term > 0) {
        monthly = loanAmount / term;
      }

      const totalPayment = monthly * term;
      const totalInterest = totalPayment - loanAmount;
      const totalCost = totalPayment + down + trade;
      const mwst = price * 0.19;

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

      document.getElementById('ar-result')!.textContent = fmt(monthly);
      document.getElementById('ar-loan-amt')!.textContent = fmt(loanAmount);
      document.getElementById('ar-interest')!.textContent = fmt(totalInterest);
      document.getElementById('ar-total-cost')!.textContent = fmt(totalCost);
      document.getElementById('ar-tax-amt')!.textContent = fmt(mwst);

      let balance = loanAmount;
      const years = Math.ceil(term / 12);
      let html = '';
      for (let y = 1; y <= years; y++) {
        let yPrinc = 0, yInt = 0;
        const monthsThisYear = Math.min(12, term - (y - 1) * 12);
        for (let m = 0; m < monthsThisYear; m++) {
          const interest = balance * r;
          const princ = monthly - interest;
          balance = Math.max(0, balance - princ);
          yPrinc += princ;
          yInt += interest;
        }
        html += '<tr class="border-b border-border/30"><td class="py-2 pr-3 text-text-secondary">Jahr ' + y + '</td><td class="py-2 pr-3 text-right text-primary">' + fmt(yPrinc) + '</td><td class="py-2 pr-3 text-right text-danger">' + fmt(yInt) + '</td><td class="py-2 text-right font-medium">' + fmt(balance) + '</td></tr>';
      }
      document.getElementById('ar-amort')!.innerHTML = html;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ar-in').forEach(el => {
        el.addEventListener('input', calcAR);
        el.addEventListener('change', calcAR);
      });
      calcAR();
    }, 50);
  </script>
</CalculatorLayout>
