---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mohs-Härte Rechner - Mineralien auf der Härteskala vergleichen";
const description = "Vergleichen Sie Mineralien auf der Mohs-Härteskala von 1 (Talk) bis 10 (Diamant). Mit interaktivem Vergleich und Alltagsobjekten als Referenz.";

const relatedCalcs = [
  { name: "Mineral-Bestimmung Rechner", url: "/de/mineral-bestimmung-rechner", description: "Mineralien bestimmen." },
  { name: "Mineralreserven Rechner", url: "/de/mineralreserven-rechner", description: "Reserven berechnen." },
  { name: "Dichte-Rechner", url: "/de/dichterechner", description: "Dichte berechnen." },
  { name: "Bergbaukosten Rechner", url: "/de/bergbau-kosten-rechner", description: "Bergbaukosten schätzen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mohs-hardness-calculator" calculatorName="Mohs-Härte Rechner" keywords="Mohs Härte, Härteskala, Mineral Härte, Mohs Skala, Mineralbestimmung, Ritzhärte" breadcrumbs={[{ name: "Mohs-Härte Rechner", url: "/de/mohs-haerte-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mohs-Härte Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Mineralien auf der Mohs-Härteskala und finden Sie heraus, welche Mineralien sich gegenseitig ritzen können.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mineral A – Härte (1–10)</label>
            <input type="number" id="mh-a" class="mh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="1" max="10" value="7">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mineral B – Härte (1–10)</label>
            <input type="number" id="mh-b" class="mh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="1" max="10" value="5">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Vergleichsergebnis</div>
          <div class="text-2xl font-extrabold" id="mh-result">Mineral A ritzt Mineral B</div>
          <div class="text-sm text-blue-200 mt-1" id="mh-result-sub"></div>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-text mb-3">Mohs-Härteskala</h3>
          <div id="mh-scale" class="space-y-1"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mohs-hardness" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="mt-10 bg-white border border-border rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-text mb-4">Mohs-Härteskala mit Alltagsreferenzen</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border text-left"><th class="py-2 pr-3 font-semibold">Härte</th><th class="py-2 pr-3 font-semibold">Mineral</th><th class="py-2 pr-3 font-semibold">Alltagsobjekt</th><th class="py-2 font-semibold">Bemerkung</th></tr></thead>
          <tbody class="text-text-secondary">
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">1</td><td class="py-2 pr-3">Talk</td><td class="py-2 pr-3">Fingernagel kratzt</td><td class="py-2">Weichstes Mineral, schmierig</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">2</td><td class="py-2 pr-3">Gips</td><td class="py-2 pr-3">Fingernagel (2,5)</td><td class="py-2">Münze kratzt leicht</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">3</td><td class="py-2 pr-3">Calcit</td><td class="py-2 pr-3">Kupfermünze (3,5)</td><td class="py-2">Reagiert mit HCl</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">4</td><td class="py-2 pr-3">Fluorit</td><td class="py-2 pr-3">Eisennagel (4–5)</td><td class="py-2">Flussspat, CaF₂</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">5</td><td class="py-2 pr-3">Apatit</td><td class="py-2 pr-3">Messerklinge (5,5)</td><td class="py-2">Zahnschmelz ≈ 5</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">6</td><td class="py-2 pr-3">Orthoklas</td><td class="py-2 pr-3">Fensterglas (5,5–6)</td><td class="py-2">Feldspatgruppe</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">7</td><td class="py-2 pr-3">Quarz</td><td class="py-2 pr-3">Stahlfeile (6,5–7)</td><td class="py-2">Ritzt Glas</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">8</td><td class="py-2 pr-3">Topas</td><td class="py-2 pr-3">Hartmetall (9)</td><td class="py-2">Edelstein, Al₂SiO₄F₂</td></tr>
            <tr class="border-b border-border/30"><td class="py-2 pr-3 font-bold text-primary">9</td><td class="py-2 pr-3">Korund</td><td class="py-2 pr-3">Saphir, Rubin</td><td class="py-2">Al₂O₃, Schleifmittel</td></tr>
            <tr><td class="py-2 pr-3 font-bold text-primary">10</td><td class="py-2 pr-3">Diamant</td><td class="py-2 pr-3">Glasschneider</td><td class="py-2">Härtestes Naturmineral</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die Mohs-Härteskala</h2>
      <p>Die Mohs-Härteskala wurde 1812 vom deutschen Mineralogen Friedrich Mohs entwickelt. Sie ist eine relative Skala: Ein Mineral mit höherer Härtezahl kann das Mineral mit niedrigerer Zahl ritzen, aber nicht umgekehrt. Die Skala ist nicht linear – Diamant (10) ist etwa 1.600-mal härter als Korund (9) in absoluten Einheiten.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Ist die Mohs-Skala linear?</p>
          <p>Nein. Die Mohs-Skala ist eine Ordinalskala, keine rationale Skala. Der Sprung von 9 (Korund) zu 10 (Diamant) ist in Wirklichkeit viel größer als der Sprung von 1 zu 9. Absolute Härtemessungen (Vickers, Knoop) sind linear.</p>
        </div>
        <div>
          <p class="font-semibold">Wie teste ich die Härte eines Minerals?</p>
          <p>Versuchen Sie, das unbekannte Mineral mit bekannten Referenzmineralien oder Alltagsgegenständen zu ritzen. Fingernagel ≈ 2,5; Kupfermünze ≈ 3,5; Messer ≈ 5,5; Glasscherbe ≈ 5,5; Stahlfeile ≈ 6,5.</p>
        </div>
        <div>
          <p class="font-semibold">Kann ein Mineral sich selbst ritzen?</p>
          <p>Mineralien mit gleicher Mohshärte können sich gegenseitig ritzen, da die Skala die Ritzhärte misst. Bei exakt gleicher Härte ist das Ritzen möglich, hängt aber auch von der Kristallorientierung ab.</p>
        </div>
        <div>
          <p class="font-semibold">Warum ist Diamant so viel härter als alle anderen?</p>
          <p>Diamant besteht aus reinem Kohlenstoff in einer Kristallstruktur, bei der jedes Atom kovalent mit vier Nachbarn gebunden ist. Diese tetraedrische sp³-Bindungsstruktur erzeugt die höchste bekannte Ritzhärte aller natürlichen Materialien.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const MH_SCALE = [
      { h: 1, name: 'Talk', ref: 'Streichholz' },
      { h: 2, name: 'Gips', ref: 'Fingernagel (2,5)' },
      { h: 3, name: 'Calcit', ref: 'Kupfermünze (3,5)' },
      { h: 4, name: 'Fluorit', ref: 'Eisennagel (4–5)' },
      { h: 5, name: 'Apatit', ref: 'Messer (5,5)' },
      { h: 6, name: 'Orthoklas', ref: 'Glas (5,5–6)' },
      { h: 7, name: 'Quarz', ref: 'Stahlfeile (6,5–7)' },
      { h: 8, name: 'Topas', ref: 'Hartmetall' },
      { h: 9, name: 'Korund', ref: 'Saphir / Rubin' },
      { h: 10, name: 'Diamant', ref: 'Glasschneider' },
    ];

    function renderScale(ha: number, hb: number) {
      const scaleEl = document.getElementById('mh-scale')!;
      scaleEl.innerHTML = MH_SCALE.map(m => {
        let cls = 'bg-surface-alt text-text';
        if (Math.abs(m.h - ha) < 0.3) cls = 'bg-blue-600 text-white';
        else if (Math.abs(m.h - hb) < 0.3) cls = 'bg-orange-500 text-white';
        const pct = m.h * 10;
        return `<div class="flex items-center gap-3">
          <span class="w-6 text-right text-xs font-bold text-text-muted">${m.h}</span>
          <div class="flex-1 h-6 bg-gray-100 rounded-full overflow-hidden">
            <div class="${cls} h-full rounded-full flex items-center pl-2 text-xs font-semibold transition-all" style="width:${pct}%">${m.name}</div>
          </div>
          <span class="text-xs text-text-muted w-32 truncate">${m.ref}</span>
        </div>`;
      }).join('');
    }

    function calcMh() {
      const ha = parseFloat((document.getElementById('mh-a') as HTMLInputElement).value) || 0;
      const hb = parseFloat((document.getElementById('mh-b') as HTMLInputElement).value) || 0;

      let result: string;
      let sub: string;

      if (ha > hb) {
        result = `Mineral A (${ha}) ritzt Mineral B (${hb})`;
        sub = `Differenz: ${(ha - hb).toLocaleString('de-DE', {maximumFractionDigits: 1})} Härtestufen`;
      } else if (hb > ha) {
        result = `Mineral B (${hb}) ritzt Mineral A (${ha})`;
        sub = `Differenz: ${(hb - ha).toLocaleString('de-DE', {maximumFractionDigits: 1})} Härtestufen`;
      } else {
        result = `Gleiche Härte (${ha})`;
        sub = 'Mineralien können sich gegenseitig ritzen';
      }

      document.getElementById('mh-result')!.textContent = result;
      document.getElementById('mh-result-sub')!.textContent = sub;
      renderScale(ha, hb);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.mh-in').forEach(el => {
        el.addEventListener('input', calcMh);
        el.addEventListener('change', calcMh);
      });
      calcMh();
    }, 50);
  </script>
</CalculatorLayout>
