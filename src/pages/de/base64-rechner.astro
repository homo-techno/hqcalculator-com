---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Base64-Rechner - Base64 kodieren & dekodieren";
const description = "Text in Base64 kodieren oder Base64 in Text dekodieren. Zwischen Modi umschalten mit Zeichenanzahl und Validierung.";

const relatedCalcs = [
  { name: "Binär-zu-Text Rechner", url: "/de/binaer-zu-text-rechner", description: "Binär/Text-Konverter." },
  { name: "Hash-Generator", url: "/hash-generator-calculator", description: "Text-Hash-Generator." },
  { name: "JSON-Formatierer", url: "/json-formatter-calculator", description: "JSON formatieren/validieren." },
  { name: "Hex zu RGB", url: "/hex-to-rgb-calculator", description: "Hex-Farbkonverter." },
  { name: "Boolesche Algebra", url: "/boolean-algebra-calculator", description: "Boolesche Logikoperationen." },
  { name: "ASCII-Tabelle", url: "/ascii-table-calculator", description: "ASCII-Zeichentabelle." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Base64-Rechner"
  lang="de"
  keywords="base64 kodieren, base64 dekodieren, base64 rechner, text zu base64, base64 zu text, base64 konverter"
  breadcrumbs={[{ name: "Base64-Rechner", url: "/de/base64-rechner" }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Base64-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Text in Base64 kodieren oder Base64 zurück in Text dekodieren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Modus</label>
          <select id="b6-mode" class="b6-in w-full px-4 py-2 border border-border rounded-xl text-lg">
            <option value="encode" selected>Kodieren (Text &rarr; Base64)</option>
            <option value="decode">Dekodieren (Base64 &rarr; Text)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1" id="b6-input-label">Texteingabe</label>
          <textarea id="b6-input" class="b6-in w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" rows="4" placeholder="Text zum Kodieren eingeben...">Hallo Welt! Dies ist ein Base64-Kodierungstest.</textarea>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="b6-result-label">Base64-Ausgabe</div>
          <div class="text-lg font-extrabold font-mono break-all" id="b6-result">&mdash;</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Eingabezeichen</div>
            <div class="text-xl font-bold" id="b6-in-chars">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ausgabezeichen</div>
            <div class="text-xl font-bold" id="b6-out-chars">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Eingabe-Bytes</div>
            <div class="text-xl font-bold" id="b6-in-bytes">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gr&ouml;&szlig;enverh&auml;ltnis</div>
            <div class="text-xl font-bold" id="b6-ratio">&mdash;</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl" id="b6-valid-wrap">
          <h3 class="font-semibold text-sm text-text mb-2">Validierung</h3>
          <div class="text-sm text-text-secondary" id="b6-valid"></div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">So funktioniert Base64</h3>
          <div class="text-sm text-text-secondary" id="b6-explain"></div>
        </div>
      </div>

      <ShareButton calculatorId="base64" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Base64-Kodierung</h2>
      <p>Base64 kodiert Bin&auml;rdaten in eine ASCII-Zeichenkette mit 64 Zeichen (A-Z, a-z, 0-9, +, /). Die Gr&ouml;&szlig;e erh&ouml;ht sich um etwa 33%, aber die sichere &Uuml;bertragung &uuml;ber textbasierte Protokolle wird gew&auml;hrleistet.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>Alle 3 Bytes Eingabe werden zu 4 Base64-Zeichen</p>
        <p>Das F&uuml;llzeichen '=' wird verwendet, wenn die Eingabel&auml;nge kein Vielfaches von 3 ist</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufige Anwendungen</h3>
      <ul>
        <li>E-Mail-Anh&auml;nge (MIME-Kodierung)</li>
        <li>Einbettung von Bildern in HTML/CSS (Data-URIs)</li>
        <li>API-Authentifizierungstoken</li>
        <li>Kodierung von Bin&auml;rdaten in JSON</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcB6() {
      const mode = (document.getElementById('b6-mode') as HTMLSelectElement).value;
      const input = (document.getElementById('b6-input') as HTMLTextAreaElement).value;

      if (mode === 'encode') {
        document.getElementById('b6-input-label')!.textContent = 'Texteingabe';
        document.getElementById('b6-result-label')!.textContent = 'Base64-Ausgabe';

        if (!input) {
          document.getElementById('b6-result')!.textContent = '\u2014';
          document.getElementById('b6-in-chars')!.textContent = '0';
          document.getElementById('b6-out-chars')!.textContent = '0';
          document.getElementById('b6-in-bytes')!.textContent = '0';
          document.getElementById('b6-ratio')!.textContent = '\u2014';
          document.getElementById('b6-valid')!.textContent = '';
          document.getElementById('b6-explain')!.textContent = '';
          document.dispatchEvent(new CustomEvent('calc-update'));
          return;
        }

        try {
          const encoded = btoa(unescape(encodeURIComponent(input)));

          document.getElementById('b6-result')!.textContent = encoded;
          document.getElementById('b6-in-chars')!.textContent = String(input.length);
          document.getElementById('b6-out-chars')!.textContent = String(encoded.length);

          const byteSize = new Blob([input]).size;
          document.getElementById('b6-in-bytes')!.textContent = String(byteSize);

          const ratio = byteSize > 0 ? (encoded.length / byteSize * 100).toFixed(1) : '0';
          document.getElementById('b6-ratio')!.textContent = ratio + '% des Originals';

          document.getElementById('b6-valid')!.textContent = 'G\u00fcltige Eingabe \u2013 erfolgreich in Base64 kodiert.';

          const padding = encoded.endsWith('==') ? 2 : encoded.endsWith('=') ? 1 : 0;
          document.getElementById('b6-explain')!.textContent =
            `${byteSize} Eingabe-Bytes \u2192 ${Math.ceil(byteSize / 3)} Gruppen zu je 3 Bytes \u2192 ${encoded.length} Base64-Zeichen (${padding} F\u00fcllzeichen).`;

        } catch (e: any) {
          document.getElementById('b6-result')!.textContent = 'Kodierungsfehler';
          document.getElementById('b6-valid')!.textContent = 'Fehler: ' + (e.message || 'Unbekannter Fehler');
        }

      } else {
        document.getElementById('b6-input-label')!.textContent = 'Base64-Eingabe';
        document.getElementById('b6-result-label')!.textContent = 'Dekodierter Text';

        if (!input) {
          document.getElementById('b6-result')!.textContent = '\u2014';
          document.getElementById('b6-in-chars')!.textContent = '0';
          document.getElementById('b6-out-chars')!.textContent = '0';
          document.getElementById('b6-in-bytes')!.textContent = '0';
          document.getElementById('b6-ratio')!.textContent = '\u2014';
          document.getElementById('b6-valid')!.textContent = '';
          document.getElementById('b6-explain')!.textContent = '';
          document.dispatchEvent(new CustomEvent('calc-update'));
          return;
        }

        const trimmed = input.trim();
        const isValidB64 = /^[A-Za-z0-9+/]*={0,2}$/.test(trimmed) && trimmed.length % 4 === 0;

        if (!isValidB64) {
          document.getElementById('b6-result')!.textContent = 'Ung\u00fcltiges Base64';
          document.getElementById('b6-in-chars')!.textContent = String(trimmed.length);
          document.getElementById('b6-out-chars')!.textContent = '\u2014';
          document.getElementById('b6-in-bytes')!.textContent = String(trimmed.length);
          document.getElementById('b6-ratio')!.textContent = '\u2014';

          let issues: string[] = [];
          if (trimmed.length % 4 !== 0) issues.push(`L\u00e4nge (${trimmed.length}) ist kein Vielfaches von 4.`);
          if (/[^A-Za-z0-9+/=]/.test(trimmed)) issues.push('Enth\u00e4lt ung\u00fcltige Zeichen.');
          document.getElementById('b6-valid')!.textContent = 'Ung\u00fcltiges Base64: ' + issues.join(' ');
          document.getElementById('b6-explain')!.textContent = '';
          document.dispatchEvent(new CustomEvent('calc-update'));
          return;
        }

        try {
          const decoded = decodeURIComponent(escape(atob(trimmed)));

          document.getElementById('b6-result')!.textContent = decoded;
          document.getElementById('b6-in-chars')!.textContent = String(trimmed.length);
          document.getElementById('b6-out-chars')!.textContent = String(decoded.length);
          document.getElementById('b6-in-bytes')!.textContent = String(trimmed.length);

          const outBytes = new Blob([decoded]).size;
          const ratio = trimmed.length > 0 ? (outBytes / trimmed.length * 100).toFixed(1) : '0';
          document.getElementById('b6-ratio')!.textContent = `${outBytes} Bytes dekodiert`;

          document.getElementById('b6-valid')!.textContent = 'G\u00fcltiges Base64 \u2013 erfolgreich dekodiert.';
          document.getElementById('b6-explain')!.textContent =
            `${trimmed.length} Base64-Zeichen \u2192 ${outBytes} Bytes dekodierte Daten.`;

        } catch (e: any) {
          document.getElementById('b6-result')!.textContent = 'Dekodierungsfehler';
          document.getElementById('b6-valid')!.textContent = 'Fehler: ' + (e.message || 'Unbekannter Fehler');
        }
      }

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.b6-in').forEach(el => {
        el.addEventListener('input', calcB6);
        el.addEventListener('change', calcB6);
      });
      calcB6();
    }, 50);
  </script>
</CalculatorLayout>
