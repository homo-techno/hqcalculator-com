---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bewegungsmelder Rechner - Erfassungswinkel, Reichweite & Abdeckung";
const description = "Berechnen Sie Erfassungswinkel, Reichweite und Abdeckungsbereich von Bewegungsmeldern für Innen- und Außenbereiche.";
const relatedCalcs = [
  { name: "Netzeinspeisung Rechner", url: "/de/netzeinspeisung-rechner", description: "Solar-Einspeisung berechnen." },
  { name: "Netzwerk Verfügbarkeit", url: "/de/netzwerk-verfuegbarkeit-rechner", description: "Uptime berechnen." },
  { name: "Lärmpegel Rechner", url: "/de/laermpegel-rechner", description: "Schallpegel berechnen." },
  { name: "Bewegungsprofil Rechner", url: "/de/bewegungsprofil-rechner", description: "Kinematik berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Bewegungsmelder Rechner" enSlug="motion-sensor-calculator" keywords="Bewegungsmelder, Erfassungswinkel, Reichweite, PIR-Sensor, Abdeckungsbereich, Sicherheitstechnik" breadcrumbs={[{ name: "Bewegungsmelder Rechner", url: "/de/bewegungsmelder-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bewegungsmelder Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Abdeckungsbereich, die benötigte Sensoranzahl und den Erfassungswinkel Ihres Bewegungsmelders für optimale Raumüberwachung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Reichweite (m)</label><input type="number" id="bm-range" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Erfassungswinkel (°)</label><input type="number" id="bm-angle" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="1" max="360" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="bm-width" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Raumlänge (m)</label><input type="number" id="bm-length" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Montagehöhe (m)</label><input type="number" id="bm-height" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0.5" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Abdeckungsfläche (ein Sensor)</div>
          <div class="text-5xl font-extrabold font-mono" id="bm-result">0,00 m²</div>
          <div class="text-sm text-blue-200 mt-1" id="bm-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Raumfläche</div><div class="text-xl font-bold" id="bm-roomarea">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Benötigte Sensoren</div><div class="text-xl font-bold" id="bm-sensors">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effektive Reichweite</div><div class="text-xl font-bold" id="bm-effrange">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abdeckungsgrad</div><div class="text-xl font-bold" id="bm-coverage">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="bewegungsmelder" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Bewegungsmelder richtig planen und installieren</h2>
      <p>Für eine lückenlose Überwachung ist die richtige Positionierung von Bewegungsmeldern entscheidend. Die Abdeckungsfläche eines Sektors berechnet sich aus dem Erfassungswinkel und der Reichweite. Bei der Planung sollten Montagehöhe, Hindernisse und Überlappungsbereiche berücksichtigt werden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Wie groß ist die Abdeckungsfläche eines Bewegungsmelders?</strong></p><p>Die Fläche eines Kreissektors berechnet sich mit F = (α/360) × π × r². Bei 120° Winkel und 8 m Reichweite ergibt das etwa 67 m².</p></div>
        <div><p><strong>In welcher Höhe sollte ein Bewegungsmelder montiert werden?</strong></p><p>Empfohlen werden 2,0 bis 2,5 m. Zu hoch montierte Sensoren erfassen Personen weniger zuverlässig, da der Winkel zur Horizontalen zu steil wird.</p></div>
        <div><p><strong>Wie viele Bewegungsmelder brauche ich für einen Raum?</strong></p><p>Das hängt von der Raumgröße, dem Sensorwinkel und möglichen Hindernissen ab. Unser Rechner gibt Ihnen eine Mindestanzahl auf Basis der Flächen.</p></div>
        <div><p><strong>Was ist der Unterschied zwischen PIR- und Mikrowellen-Sensor?</strong></p><p>PIR-Sensoren erfassen Wärmebewegungen und sind günstig, aber durch Wände nicht wirksam. Mikrowellensensoren können durch Wände detektieren, erzeugen aber mehr Fehlalarme.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBM() {
      const range = parseFloat((document.getElementById('bm-range') as HTMLInputElement).value) || 8;
      const angle = parseFloat((document.getElementById('bm-angle') as HTMLInputElement).value) || 120;
      const width = parseFloat((document.getElementById('bm-width') as HTMLInputElement).value) || 6;
      const length = parseFloat((document.getElementById('bm-length') as HTMLInputElement).value) || 8;
      const height = parseFloat((document.getElementById('bm-height') as HTMLInputElement).value) || 2.5;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      const angleRad = (angle / 360) * Math.PI;
      const effectiveRange = Math.min(range, Math.sqrt(width * width + length * length));
      const sectorArea = (angle / 360) * Math.PI * effectiveRange * effectiveRange;
      const roomArea = width * length;
      const sensorsNeeded = Math.ceil(roomArea / sectorArea);
      const coveragePct = Math.min(100, (sectorArea / roomArea) * 100);
      document.getElementById('bm-result')!.textContent = fmt(sectorArea) + ' m²';
      document.getElementById('bm-sub')!.textContent = 'Winkel: ' + angle + '° | Reichweite: ' + fmt(effectiveRange) + ' m';
      document.getElementById('bm-roomarea')!.textContent = fmt(roomArea) + ' m²';
      document.getElementById('bm-sensors')!.textContent = sensorsNeeded.toLocaleString('de-DE');
      document.getElementById('bm-effrange')!.textContent = fmt(effectiveRange) + ' m';
      document.getElementById('bm-coverage')!.textContent = fmt(coveragePct, 1) + ' %';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bm-in').forEach(el => { el.addEventListener('input', calcBM); el.addEventListener('change', calcBM); });
      calcBM();
    }, 50);
  </script>
</CalculatorLayout>
