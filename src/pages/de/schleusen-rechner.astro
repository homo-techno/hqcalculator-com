---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schleusen-Rechner - Wasservolumen & Durchfahrtszeit";
const description = "Berechnen Sie das Wasservolumen pro Schleusenzyklus, Hubh\u00f6he, Durchfahrtszeit und Schiffsspielraum f\u00fcr die Kanalschleusendurchfahrt.";
const relatedCalcs = [
  { name: "Kondensator-Rechner", url: "/de/kondensator-rechner", description: "Kondensatoren." },
  { name: "Kamerasensor-Rechner", url: "/de/kamerasensor-rechner", description: "Sensoren." },
  { name: "Campingausr\u00fcstung", url: "/de/campingausruestung-rechner", description: "Camping." },
  { name: "Kerzen-Brenndauer", url: "/de/kerzen-brenndauer-rechner", description: "Kerzen." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorienverbrauch." },
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Schleusen-Rechner" lang="de" enSlug="canal-lock-calculator" keywords="schleusen rechner, schleusenvolumen, durchfahrtszeit, hubh\u00f6he, kanal navigation" breadcrumbs={[{ name: "Schleusen-Rechner", url: "/de/schleusen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schleusen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Wasservolumen pro Schleusenzyklus, Durchfahrtszeiten und Schiffsspielraum.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schleusenl&auml;nge (m)</label><input type="number" id="sl-len" class="sl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Schleusenbreite (m)</label><input type="number" id="sl-wid" class="sl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hubh&ouml;he (m)</label><input type="number" id="sl-rise" class="sl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.5" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">F&uuml;llzeit (Minuten)</label><input type="number" id="sl-fill" class="sl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schiffsl&auml;nge (m)</label><input type="number" id="sl-loa" class="sl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Schiffsbreite (m)</label><input type="number" id="sl-vbeam" class="sl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Anzahl Schleusen</label><input type="number" id="sl-num" class="sl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="50" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wasser pro Schleusenzyklus</div>
          <div class="text-5xl font-extrabold font-mono" id="sl-vol">--</div>
          <div class="text-sm text-blue-200 mt-1">Liter</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen (m&sup3;)</div><div class="text-xl font-bold" id="sl-m3">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Durchfahrt</div><div class="text-xl font-bold" id="sl-transit">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Hubh&ouml;he</div><div class="text-xl font-bold" id="sl-trise">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">L&auml;ngenspielraum</div><div class="text-xl font-bold" id="sl-lclear">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Breitenspielraum</div><div class="text-xl font-bold" id="sl-bclear">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Passt?</div><div class="text-xl font-bold" id="sl-fit">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="canal-lock" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Wie funktioniert eine Schleuse?</h3>
      <p>Eine Schleuse gleicht H&ouml;henunterschiede in Wasserstra&szlig;en aus. Das Schiff f&auml;hrt in die Kammer, Tore schlie&szlig;en sich, und durch Einlassen oder Ablassen von Wasser wird das Schiff auf das n&auml;chste Niveau gehoben oder gesenkt.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcSL() {
      const lockLen = parseFloat((document.getElementById('sl-len') as HTMLInputElement).value) || 0;
      const lockWid = parseFloat((document.getElementById('sl-wid') as HTMLInputElement).value) || 0;
      const rise = parseFloat((document.getElementById('sl-rise') as HTMLInputElement).value) || 0;
      const fillTime = parseFloat((document.getElementById('sl-fill') as HTMLInputElement).value) || 0;
      const vesselLOA = parseFloat((document.getElementById('sl-loa') as HTMLInputElement).value) || 0;
      const vesselBeam = parseFloat((document.getElementById('sl-vbeam') as HTMLInputElement).value) || 0;
      const numLocks = parseInt((document.getElementById('sl-num') as HTMLInputElement).value) || 1;

      const volumeM3 = lockLen * lockWid * rise;
      const volumeL = volumeM3 * 1000;
      const totalTransitMin = numLocks * (fillTime + 5);
      const totalRise = rise * numLocks;
      const lengthClear = lockLen - vesselLOA;
      const beamClear = lockWid - vesselBeam;

      let fitStatus = 'Passt';
      if (lengthClear < 0 || beamClear < 0) fitStatus = 'ZU GROSS';
      else if (lengthClear < 1.5 || beamClear < 0.5) fitStatus = 'Knapp';
      else fitStatus = 'Guter Spielraum';

      const fmt = (v: number) => v.toFixed(1).replace('.', ',');
      document.getElementById('sl-vol')!.textContent = volumeL > 0 ? Math.round(volumeL).toLocaleString('de-DE') : '--';
      document.getElementById('sl-m3')!.textContent = volumeM3 > 0 ? fmt(volumeM3) : '--';
      document.getElementById('sl-transit')!.textContent = totalTransitMin > 0 ? Math.round(totalTransitMin) + ' Min.' : '--';
      document.getElementById('sl-trise')!.textContent = totalRise > 0 ? fmt(totalRise) + ' m' : '--';
      document.getElementById('sl-lclear')!.textContent = lengthClear > 0 ? fmt(lengthClear) + ' m' : lengthClear < 0 ? 'KEINER' : '--';
      document.getElementById('sl-bclear')!.textContent = beamClear > 0 ? fmt(beamClear) + ' m' : beamClear < 0 ? 'KEINER' : '--';
      document.getElementById('sl-fit')!.textContent = fitStatus;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('sl-len') as HTMLInputElement).value = '180';
      (document.getElementById('sl-wid') as HTMLInputElement).value = '33';
      (document.getElementById('sl-rise') as HTMLInputElement).value = '8.5';
      (document.getElementById('sl-fill') as HTMLInputElement).value = '8';
      (document.getElementById('sl-loa') as HTMLInputElement).value = '12';
      (document.getElementById('sl-vbeam') as HTMLInputElement).value = '4';
      (document.getElementById('sl-num') as HTMLInputElement).value = '3';
      document.querySelectorAll('.sl-in').forEach(el => { el.addEventListener('input', calcSL); el.addEventListener('change', calcSL); });
      calcSL();
    }, 50);
  </script>
</CalculatorLayout>
