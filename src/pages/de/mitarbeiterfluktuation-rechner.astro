---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Mitarbeiterfluktuation-Rechner - Kosten & Analyse";
const description = "Berechnen Sie Fluktuationsrate, Kosten pro Abgang und j\u00e4hrliche Gesamtkosten der Mitarbeiterfluktuation.";
const relatedCalcs = [
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallreserve." },
  { name: "Treuhandkonto-Rechner", url: "/de/treuhandkonto-rechner", description: "Treuhandzahlungen." },
  { name: "Esports-Einnahmen", url: "/de/esports-einnahmen-rechner", description: "Turniereinnahmen." },
  { name: "Stromverbrauch-Rechner", url: "/de/stromverbrauch-rechner", description: "Stromkosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Mitarbeiterfluktuation-Rechner" lang="de" enSlug="employee-turnover-calculator" keywords="mitarbeiterfluktuation, fluktuationsrate, fluktuationskosten, einstellungskosten, mitarbeiterbindung" breadcrumbs={[{ name: "Mitarbeiterfluktuation", url: "/de/mitarbeiterfluktuation-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mitarbeiterfluktuation-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Quantifizieren Sie die finanziellen Auswirkungen der Mitarbeiterfluktuation.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesamtmitarbeiter</label><input type="number" id="mfr-total" class="mfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Abg&auml;nge</label><input type="number" id="mfr-dep" class="mfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Durchschn. Jahresgehalt (&euro;)</label><input type="number" id="mfr-salary" class="mfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="55000" min="0" step="5000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einstellungskosten-Faktor (x Gehalt)</label><input type="number" id="mfr-mult" class="mfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" min="0.5" max="3" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Fluktuationsrate</div>
          <div class="text-5xl font-extrabold font-mono" id="mfr-rate">0%</div>
          <div class="text-sm text-blue-200 mt-1">j&auml;hrliche Fluktuation</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Abgang</div><div class="text-xl font-bold" id="mfr-costper">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Fluktuationskosten</div><div class="text-xl font-bold" id="mfr-annual">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchschn. Nachbesetzungszeit</div><div class="text-xl font-bold" id="mfr-fill">42 Tage</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Produktivit&auml;tsverlust</div><div class="text-xl font-bold" id="mfr-prod">0 &euro;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Kostenaufschl&uuml;sselung</h3>
          <div class="space-y-2" id="mfr-breakdown"></div>
        </div>
      </div>
      <ShareButton calculatorId="employee-turnover-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Fluktuationskosten verstehen</h2>
      <p>Die Neubesetzung einer Stelle kostet 0,5-2x des Jahresgehalts, wenn man Recruiting, Einarbeitung, Schulung und verlorene Produktivit&auml;t ber&uuml;cksichtigt. Schon eine Senkung um wenige Prozentpunkte bringt erhebliche Einsparungen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist eine normale Fluktuationsrate?</strong> In Deutschland liegt die durchschnittliche Fluktuationsrate bei etwa 10-15% j&auml;hrlich, je nach Branche.</p>
      <p><strong>Wie senkt man die Fluktuation?</strong> Wettbewerbsf&auml;hige Geh&auml;lter, gute F&uuml;hrung, Entwicklungsm&ouml;glichkeiten und eine positive Unternehmenskultur sind Schl&uuml;sselfaktoren.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcMFR() {
      const total = parseFloat((document.getElementById('mfr-total') as HTMLInputElement).value) || 100;
      const dep = parseFloat((document.getElementById('mfr-dep') as HTMLInputElement).value) || 0;
      const salary = parseFloat((document.getElementById('mfr-salary') as HTMLInputElement).value) || 55000;
      const mult = parseFloat((document.getElementById('mfr-mult') as HTMLInputElement).value) || 1.5;
      const rate = total > 0 ? (dep / total * 100) : 0;
      const costPer = Math.round(salary * mult);
      const annualCost = costPer * dep;
      const prodLoss = Math.round(dep * salary * 0.25);
      const recruiting = Math.round(salary * 0.20);
      const onboarding = Math.round(salary * 0.30);
      const training = Math.round(salary * 0.25);
      const lostProd = Math.round(salary * (mult - 0.75));
      const fmtEur = (n: number) => n.toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('mfr-rate')!.textContent = rate.toFixed(1).replace('.', ',') + '%';
      document.getElementById('mfr-costper')!.textContent = fmtEur(costPer);
      document.getElementById('mfr-annual')!.textContent = fmtEur(annualCost);
      document.getElementById('mfr-prod')!.textContent = fmtEur(prodLoss);
      const breakdownHTML = [
        { label: 'Recruiting & Einstellung', val: recruiting },
        { label: 'Einarbeitung', val: onboarding },
        { label: 'Schulung', val: training },
        { label: 'Produktivit\u00E4tsverlust', val: lostProd },
      ].map(b => '<div class="flex justify-between items-center py-1 border-b border-border last:border-0"><span class="text-sm">' + b.label + '</span><span class="text-sm font-bold">' + fmtEur(b.val) + '/Abgang</span></div>').join('');
      document.getElementById('mfr-breakdown')!.innerHTML = breakdownHTML;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.mfr-in').forEach(el => { el.addEventListener('input', calcMFR); el.addEventListener('change', calcMFR); }); calcMFR(); }, 50);
  </script>
</CalculatorLayout>
