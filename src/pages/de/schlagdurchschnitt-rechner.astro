---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schlagdurchschnitt-Rechner - Baseball-Statistiken";
const description = "Berechnen Sie Schlagdurchschnitt (BA), On-Base-Percentage (OBP), Slugging (SLG) und OPS für Baseball und Softball.";
const relatedCalcs = [
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Bowling-Punkte-Rechner", url: "/de/bowling-punkte-rechner", description: "Bowling-Punktestand." },
  { name: "BPM-Rechner", url: "/de/bpm-rechner", description: "Beats pro Minute." },
  { name: "Boxreichweite-Rechner", url: "/de/boxreichweite-rechner", description: "Boxreichweite." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwerte." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Schlagdurchschnitt-Rechner" enSlug="batting-average-calculator" keywords="Schlagdurchschnitt, OBP, Slugging, OPS, Baseball Statistik, Softball Statistik" breadcrumbs={[{ name: "Schlagdurchschnitt-Rechner", url: "/de/schlagdurchschnitt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schlagdurchschnitt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie BA, OBP, SLG und OPS aus Ihren Statistiken.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">At Bats (AB)</label><input type="number" id="sd-ab" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="400" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hits (H)</label><input type="number" id="sd-h" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="120" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Doubles (2B)</label><input type="number" id="sd-2b" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Triples (3B)</label><input type="number" id="sd-3b" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Home Runs (HR)</label><input type="number" id="sd-hr" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Walks (BB)</label><input type="number" id="sd-bb" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hit By Pitch (HBP)</label><input type="number" id="sd-hbp" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sacrifice Flies (SF)</label><input type="number" id="sd-sf" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Schlagdurchschnitt</div>
          <div class="text-5xl font-extrabold font-mono" id="sd-result">.000</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">OBP</div><div class="text-xl font-bold font-mono" id="sd-obp">.000</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">SLG</div><div class="text-xl font-bold font-mono" id="sd-slg">.000</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">OPS</div><div class="text-xl font-bold font-mono" id="sd-ops">.000</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Singles</div><div class="text-xl font-bold font-mono" id="sd-1b">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Total Bases</div><div class="text-xl font-bold font-mono" id="sd-tb">0</div></div>
        </div>
        <div class="p-4 rounded-xl text-center" id="sd-status-box"><div class="font-bold text-sm" id="sd-status">-</div></div>
      </div>
      <ShareButton lang="de" calculatorId="schlagdurchschnitt" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Baseball-Statistiken erklärt</h2>
      <p>Der Schlagdurchschnitt (BA) = Hits / At Bats. OBP berücksichtigt zusätzlich Walks und HBP. SLG gewichtet Extra-Base-Hits. OPS = OBP + SLG und gilt als guter Gesamtindikator für einen Schlagmann.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSD() {
      const ab = parseFloat((document.getElementById('sd-ab') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('sd-h') as HTMLInputElement).value) || 0;
      const d = parseFloat((document.getElementById('sd-2b') as HTMLInputElement).value) || 0;
      const t = parseFloat((document.getElementById('sd-3b') as HTMLInputElement).value) || 0;
      const hr = parseFloat((document.getElementById('sd-hr') as HTMLInputElement).value) || 0;
      const bb = parseFloat((document.getElementById('sd-bb') as HTMLInputElement).value) || 0;
      const hbp = parseFloat((document.getElementById('sd-hbp') as HTMLInputElement).value) || 0;
      const sf = parseFloat((document.getElementById('sd-sf') as HTMLInputElement).value) || 0;
      const singles = h - d - t - hr;
      const tb = singles + 2 * d + 3 * t + 4 * hr;
      const ba = ab > 0 ? h / ab : 0;
      const obpDenom = ab + bb + hbp + sf;
      const obp = obpDenom > 0 ? (h + bb + hbp) / obpDenom : 0;
      const slg = ab > 0 ? tb / ab : 0;
      const ops = obp + slg;
      const fmt = (v: number) => v.toFixed(3);
      document.getElementById('sd-result')!.textContent = fmt(ba);
      document.getElementById('sd-obp')!.textContent = fmt(obp);
      document.getElementById('sd-slg')!.textContent = fmt(slg);
      document.getElementById('sd-ops')!.textContent = fmt(ops);
      document.getElementById('sd-1b')!.textContent = Math.max(0, singles).toFixed(0);
      document.getElementById('sd-tb')!.textContent = tb.toFixed(0);
      let status: string, color: string;
      if (ba >= .300) { status = 'Elite-Schlagmann (.300+)'; color = 'bg-green-50 text-green-800'; }
      else if (ba >= .270) { status = '\u00dcberdurchschnittlich (.270+)'; color = 'bg-blue-50 text-blue-800'; }
      else if (ba >= .250) { status = 'Durchschnittlicher Schlagmann'; color = 'bg-yellow-50 text-yellow-800'; }
      else { status = 'Unterdurchschnittlich'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('sd-status')!.textContent = status;
      document.getElementById('sd-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sd-in').forEach(el => { el.addEventListener('input', calcSD); el.addEventListener('change', calcSD); });
      calcSD();
    }, 50);
  </script>
</CalculatorLayout>
