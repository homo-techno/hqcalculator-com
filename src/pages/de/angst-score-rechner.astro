---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Angst-Score Rechner - GAD-7 Screening-Tool";
const description = "Berechnen Sie Ihren Angstlevel mit dem GAD-7 (Generalisierte Angststörung 7-Punkte-Skala). Erhalten Sie Schweregrad-Einstufung und Hinweise, wann Sie Hilfe suchen sollten.";
const relatedCalcs = [
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen optimieren." },
  { name: "Herzfrequenzrechner", url: "/de/herzfrequenzrechner", description: "Herzfrequenzzonen." },
  { name: "Blutdruck", url: "/de/blutdruck-rechner", description: "Blutdruck-Einstufung." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglicher Kalorienbedarf." },
  { name: "Koffeinrechner", url: "/de/koffeinrechner", description: "Koffeinaufnahme." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Angst-Score Rechner" keywords="Angst-Score, GAD-7, generalisierte Angststörung, Angst-Screening, Angstschweregrad, psychische Gesundheit" breadcrumbs={[{ name: "Angst-Score", url: "/de/angst-score-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Angst-Score Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie, wie oft Sie in den letzten 2 Wochen von den folgenden Problemen betroffen waren, anhand der GAD-7-Skala.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <p class="text-xs text-text-secondary mb-1 italic">Dies ist ein Screening-Tool, keine Diagnose. Konsultieren Sie immer einen Arzt.</p>
      <p class="text-sm text-text-secondary mb-4">0 = Überhaupt nicht, 1 = An einzelnen Tagen, 2 = An mehr als der Hälfte der Tage, 3 = Beinahe jeden Tag</p>

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">1. Nervosität, Ängstlichkeit oder Anspannung</label>
          <input type="range" id="ax-q1" class="ax-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Überhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">2. Nicht in der Lage sein, Sorgen zu stoppen oder zu kontrollieren</label>
          <input type="range" id="ax-q2" class="ax-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Überhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">3. Übermäßige Sorgen bezüglich verschiedener Angelegenheiten</label>
          <input type="range" id="ax-q3" class="ax-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Überhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">4. Schwierigkeiten beim Entspannen</label>
          <input type="range" id="ax-q4" class="ax-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Überhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">5. So unruhig sein, dass Stillsitzen schwerfällt</label>
          <input type="range" id="ax-q5" class="ax-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Überhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">6. Leicht verärgert oder reizbar werden</label>
          <input type="range" id="ax-q6" class="ax-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Überhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">7. Angst haben, als ob etwas Schreckliches passieren könnte</label>
          <input type="range" id="ax-q7" class="ax-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Überhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Angstschweregrad</div>
          <div class="text-2xl font-extrabold mt-1" id="ax-sev">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">GAD-7 Score</div>
            <div class="text-xl font-bold text-text mt-1" id="ax-score">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Professionelle Hilfe suchen?</div>
            <div class="text-xl font-bold text-text mt-1" id="ax-seek">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Hinweis zur Symptomverfolgung</div>
          <div class="text-sm text-text" id="ax-track">--</div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">GAD-7 Schweregrad-Schwellenwerte</div>
          <div class="space-y-1 text-sm">
            <div class="flex justify-between"><span>0 - 4</span><span>Minimale Angst</span></div>
            <div class="flex justify-between"><span>5 - 9</span><span>Leichte Angst</span></div>
            <div class="flex justify-between"><span>10 - 14</span><span>Moderate Angst</span></div>
            <div class="flex justify-between"><span>15 - 21</span><span>Schwere Angst</span></div>
          </div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="anxiety-score" />
      <FeedbackWidget lang="de" />
    </div>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcAX() {
      let total = 0;
      for (let i = 1; i <= 7; i++) {
        total += parseInt((document.getElementById('ax-q' + i) as HTMLInputElement).value) || 0;
      }

      let severity = 'Minimale Angst';
      let seek = 'Nicht angezeigt';
      let track = '';

      if (total <= 4) {
        severity = 'Minimale Angst';
        seek = 'Nicht angezeigt';
        track = 'Ihr Score deutet auf minimale Angst hin. Überprüfen Sie in 2-4 Wochen erneut, wenn Sie Veränderungen bemerken. Pflegen Sie gesunde Routinen mit Bewegung, Schlafhygiene und sozialen Kontakten.';
      } else if (total <= 9) {
        severity = 'Leichte Angst';
        seek = 'Genau beobachten';
        track = 'Leichte Angst festgestellt. Verfolgen Sie Ihren Score wöchentlich. Erwägen Sie Selbsthilfestrategien: regelmäßige Bewegung, Achtsamkeitsmeditation, Begrenzung von Koffein und Alkohol. Bei anhaltenden Symptomen über 4 Wochen einen Fachmann konsultieren.';
      } else if (total <= 14) {
        severity = 'Moderate Angst';
        seek = 'Empfohlen';
        track = 'Moderater Angstlevel. Eine professionelle Beratung wird empfohlen. Evidenzbasierte Behandlungen umfassen KVT (Kognitive Verhaltenstherapie) und gegebenenfalls Medikation. Weiterhin wöchentlich überprüfen.';
      } else {
        severity = 'Schwere Angst';
        seek = 'Dringend empfohlen';
        track = 'Schwere Angst festgestellt. Bitte suchen Sie umgehend professionelle Hilfe auf. Wirksame Behandlungen sind verfügbar. Bei einer Krise kontaktieren Sie die Telefonseelsorge (0800 111 0 111 / 0800 111 0 222) oder begeben Sie sich in die nächste Notaufnahme.';
      }

      document.getElementById('ax-score')!.textContent = total + ' / 21';
      document.getElementById('ax-sev')!.textContent = severity;
      document.getElementById('ax-seek')!.textContent = seek;
      document.getElementById('ax-track')!.textContent = track;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      for (let i = 1; i <= 7; i++) {
        (document.getElementById('ax-q' + i) as HTMLInputElement).value = '1';
      }
      document.querySelectorAll('.ax-in').forEach(el => {
        el.addEventListener('input', calcAX);
        el.addEventListener('change', calcAX);
      });
      calcAX();
    }, 50);
  </script>
</CalculatorLayout>
