---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "CO₂-Kompensation-Rechner – Emissionen & Ausgleichskosten";
const description = "Berechnen Sie Ihre CO₂-Emissionen aus Flügen, Autofahren und Hausenergie und ermitteln Sie die Kosten für eine CO₂-Kompensation.";
const relatedCalcs = [
  { name: "CO₂-Fußabdruck-Rechner", url: "/de/co2-fussabdruck-rechner", description: "Gesamter Fußabdruck." },
  { name: "CO₂-Steuer-Rechner", url: "/de/co2-steuer-rechner", description: "CO₂-Steuer." },
  { name: "Kohlenstoffbindung-Rechner", url: "/de/kohlenstoffbindung-rechner", description: "Bäume & CO₂." },
  { name: "Kubikmeter-Rechner", url: "/de/kubikmeter-rechner", description: "Volumenberechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="CO₂-Kompensation-Rechner" enSlug="carbon-offset-calculator" keywords="CO₂ Kompensation, Carbon Offset, Klimaneutral, Emissionsausgleich, CO₂-Zertifikate" breadcrumbs={[{ name: "CO₂-Kompensation-Rechner", url: "/de/co2-kompensation-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">CO₂-Kompensation-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Ihre CO₂-Emissionen und die Kosten für deren Kompensation.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Jährliche Emissionsquellen</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Flugkilometer/Jahr</label><input type="number" id="cok-flights" class="cok-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Autokilometer/Jahr</label><input type="number" id="cok-car" class="cok-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Strom (kWh/Monat)</label><input type="number" id="cok-elec" class="cok-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Erdgas (kWh/Monat)</label><input type="number" id="cok-gas" class="cok-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="50"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte CO₂-Emissionen</div>
          <div class="text-5xl font-extrabold font-mono" id="cok-total">0</div>
          <div class="text-sm text-blue-200 mt-1">Tonnen CO₂/Jahr</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kompensationskosten (25 €/t)</div><div class="text-xl font-bold" id="cok-cost">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bäume-Äquivalent</div><div class="text-xl font-bold" id="cok-trees">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Emissionsaufschlüsselung</h3>
          <div class="space-y-2" id="cok-breakdown"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Reduktions-Tipps</h3>
          <div class="space-y-1 text-sm text-text-secondary" id="cok-tips"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="carbon-offset" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">CO₂-Kompensation erklärt</h2>
      <p>CO₂-Kompensation finanziert Projekte zur Reduktion von Treibhausgasemissionen, z. B. Aufforstung, erneuerbare Energien und Methanabscheidung. Der freiwillige Markt bewertet Kompensationen typischerweise mit 10–50 € pro Tonne CO₂. Ein ausgewachsener Baum absorbiert etwa 22 kg (0,022 Tonnen) CO₂ pro Jahr.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was kostet CO₂-Kompensation?</strong> Die Kosten variieren zwischen 10 und 50 € pro Tonne CO₂, je nach Projektart und Qualitätsstandard.</p>
      <p><strong>Ist Kompensation sinnvoll?</strong> Kompensation sollte zusätzlich zu eigenen Reduktionsmaßnahmen erfolgen, nicht als Ersatz.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCOK() {
      const flightKm = parseFloat((document.getElementById('cok-flights') as HTMLInputElement).value) || 0;
      const carKm = parseFloat((document.getElementById('cok-car') as HTMLInputElement).value) || 0;
      const elec = parseFloat((document.getElementById('cok-elec') as HTMLInputElement).value) || 0;
      const gas = parseFloat((document.getElementById('cok-gas') as HTMLInputElement).value) || 0;
      const flightCO2 = flightKm * 0.000255;
      const carCO2 = carKm * 0.00015;
      const elecCO2 = elec * 12 * 0.000385;
      const gasCO2 = gas * 12 * 0.000201;
      const total = flightCO2 + carCO2 + elecCO2 + gasCO2;
      const costPerTon = 25;
      const offsetCost = Math.round(total * costPerTon);
      const trees = Math.ceil(total / 0.022);
      document.getElementById('cok-total')!.textContent = total.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('cok-cost')!.textContent = offsetCost.toLocaleString('de-DE') + ' €';
      document.getElementById('cok-trees')!.textContent = trees.toLocaleString('de-DE') + ' Bäume';
      const items = [
        { label: 'Flüge', val: flightCO2 },
        { label: 'Autofahren', val: carCO2 },
        { label: 'Strom', val: elecCO2 },
        { label: 'Erdgas', val: gasCO2 },
      ];
      const breakdownHTML = items.map(i => {
        const pct = total > 0 ? Math.round(i.val / total * 100) : 0;
        return '<div class="flex justify-between items-center py-1 border-b border-border last:border-0"><span class="text-sm">' + i.label + '</span><div class="flex items-center gap-2"><div class="w-20 bg-gray-200 rounded-full h-2"><div class="bg-primary rounded-full h-2" style="width:' + pct + '%"></div></div><span class="text-sm font-bold">' + i.val.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + 't (' + pct + '%)</span></div></div>';
      }).join('');
      document.getElementById('cok-breakdown')!.innerHTML = breakdownHTML;
      const tips: string[] = [];
      if (flightCO2 > 2) tips.push('Einen Hin- und Rückflug weniger spart ca. 1,6 t CO₂/Jahr.');
      if (carCO2 > 2) tips.push('Auf E-Auto oder ÖPNV umsteigen, um Fahrtemissionen zu senken.');
      if (elecCO2 > 1) tips.push('Zu Ökostrom wechseln oder Solaranlage installieren.');
      if (gasCO2 > 1) tips.push('Wärmepumpe in Betracht ziehen, um Gasverbrauch zu reduzieren.');
      tips.push('Bäume pflanzen: Ein Baum absorbiert ca. 22 kg CO₂/Jahr.');
      document.getElementById('cok-tips')!.innerHTML = tips.map(t => '<div class="py-1">&#8226; ' + t + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('cok-flights') as HTMLInputElement).value = '8000';
      (document.getElementById('cok-car') as HTMLInputElement).value = '15000';
      (document.getElementById('cok-elec') as HTMLInputElement).value = '300';
      (document.getElementById('cok-gas') as HTMLInputElement).value = '800';
      document.querySelectorAll('.cok-in').forEach(el => { el.addEventListener('input', calcCOK); el.addEventListener('change', calcCOK); });
      calcCOK();
    }, 50);
  </script>
</CalculatorLayout>
