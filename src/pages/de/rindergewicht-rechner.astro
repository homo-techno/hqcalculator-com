---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Rindergewicht-Rechner – Gewicht aus Brustumfang schätzen";
const description = "Schätzen Sie das Rindergewicht aus dem Brustumfang. Berechnen Sie die tägliche Zunahme (TZ) und die Zeitlinie zum Zielgewicht.";
const relatedCalcs = [
  { name: "Katzenfutter-Rechner", url: "/de/katzenfutter-rechner", description: "Katzenfutter." },
  { name: "Katzenalter-Rechner", url: "/de/katzenalter-rechner", description: "Katzenalter." },
  { name: "Tragfähigkeit-Rechner", url: "/de/tragfaehigkeit-rechner", description: "Tragfähigkeit." },
  { name: "Catering-Mengen-Rechner", url: "/de/catering-mengen-rechner", description: "Catering." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Rindergewicht-Rechner" enSlug="cattle-weight-calculator" keywords="Rindergewicht, Brustumfang, Rindermast, tägliche Zunahme, Zielgewicht, Viehwirtschaft" breadcrumbs={[{ name: "Rindergewicht-Rechner", url: "/de/rindergewicht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Rindergewicht-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie das Rindergewicht anhand des Brustumfangs, berechnen Sie die tägliche Zunahme und projizieren Sie das Zielgewicht.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Brustumfang (cm)</label><input type="number" id="rgr-girth" class="rgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="50" max="280" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rindertyp</label><select id="rgr-type" class="rgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="beef" selected>Fleischrind</option><option value="dairy">Milchrind</option><option value="calf">Kalb (unter 1 Jahr)</option></select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zielgewicht (kg)</label><input type="number" id="rgr-target" class="rgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="50" max="1500" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tägliche Zunahme (kg/Tag)</label><input type="number" id="rgr-adg" class="rgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.2" max="2.5" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätztes Gewicht</div>
          <div class="text-5xl font-extrabold font-mono" id="rgr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bis Zielgewicht</div><div class="text-xl font-bold font-mono" id="rgr-totarget">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tage bis Ziel</div><div class="text-xl font-bold font-mono" id="rgr-days">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewicht (lbs)</div><div class="text-xl font-bold font-mono" id="rgr-lbs">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">30-Tage-Gewicht</div><div class="text-xl font-bold font-mono" id="rgr-30d">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">60-Tage-Gewicht</div><div class="text-xl font-bold font-mono" id="rgr-60d">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">90-Tage-Gewicht</div><div class="text-xl font-bold font-mono" id="rgr-90d">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cattle-weight" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Rindergewicht aus Brustumfang</h2>
      <p>Die Schätzung des Rindergewichts aus dem Brustumfang ist eine bewährte Methode in der Landwirtschaft. Die Formel berücksichtigt den Typ des Rindes (Fleisch-, Milchrind, Kalb) und verwendet eine Potenzfunktion des Brustumfangs.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcRGR() {
      const girthCm = parseFloat((document.getElementById('rgr-girth') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('rgr-type') as HTMLSelectElement).value;
      const target = parseFloat((document.getElementById('rgr-target') as HTMLInputElement).value) || 600;
      const adg = parseFloat((document.getElementById('rgr-adg') as HTMLInputElement).value) || 1.1;
      const girth = girthCm / 2.54;
      let weightLbs = 0;
      if (type === 'beef') { weightLbs = Math.pow(girth, 2.7) / 660; }
      else if (type === 'dairy') { weightLbs = Math.pow(girth, 2.7) / 700; }
      else { weightLbs = Math.pow(girth, 2.7) / 780; }
      const weightKg = weightLbs * 0.4536;
      const toTarget = target - weightKg;
      const daysToTarget = toTarget > 0 ? Math.ceil(toTarget / adg) : 0;
      const weight30 = weightKg + adg * 30;
      const weight60 = weightKg + adg * 60;
      const weight90 = weightKg + adg * 90;
      document.getElementById('rgr-result')!.textContent = Math.round(weightKg) + ' kg';
      document.getElementById('rgr-lbs')!.textContent = Math.round(weightLbs) + ' lbs';
      document.getElementById('rgr-totarget')!.textContent = (toTarget > 0 ? '+' : '') + Math.round(toTarget) + ' kg';
      document.getElementById('rgr-days')!.textContent = daysToTarget > 0 ? daysToTarget + ' Tage' : 'Am Ziel';
      document.getElementById('rgr-30d')!.textContent = Math.round(weight30) + ' kg';
      document.getElementById('rgr-60d')!.textContent = Math.round(weight60) + ' kg';
      document.getElementById('rgr-90d')!.textContent = Math.round(weight90) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('rgr-girth') as HTMLInputElement).value = '183';
      (document.getElementById('rgr-target') as HTMLInputElement).value = '600';
      (document.getElementById('rgr-adg') as HTMLInputElement).value = '1.1';
      document.querySelectorAll('.rgr-in').forEach(el => { el.addEventListener('input', calcRGR); el.addEventListener('change', calcRGR); });
      calcRGR();
    }, 50);
  </script>
</CalculatorLayout>
