---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zinssatz Rechner – Zinssätze & Zinseszinsen berechnen";
const description = "Berechnen Sie Zinssätze, Zinseszinsen und Kreditkosten schnell und einfach.";
const relatedCalcs = [
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditkosten ermitteln." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziele berechnen." },
  { name: "Rechnungsrechner", url: "/de/rechnungs-rechner", description: "Rechnungen mit MwSt." },
];
---
<CalculatorLayout lang="de" enSlug="interest-rate-calculator" title={title} description={description} calculatorName="Zinssatz Rechner" keywords="Zinssatz Rechner, Zinsen berechnen, Zinseszins, Kreditkosten, Rendite berechnen" breadcrumbs={[{ name: "Zinssatz Rechner", url: "/de/zinssatz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zinssatz Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den benötigten Zinssatz, um Ihr Startkapital auf einen Zielwert zu steigern – mit Zinseszins-Analyse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Startkapital (€)</label><input type="number" id="zr-start" class="zr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="10000" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zielkapital (€)</label><input type="number" id="zr-target" class="zr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="50000" min="0" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Jahre)</label><input type="number" id="zr-years" class="zr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="100" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Verzinsungsintervall</label>
            <select id="zr-comp" class="zr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1">Jährlich</option>
              <option value="2">Halbjährlich</option>
              <option value="4">Vierteljährlich</option>
              <option value="12" selected>Monatlich</option>
              <option value="365">Täglich</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Erforderlicher Jahreszinssatz</div>
          <div class="text-5xl font-extrabold font-mono" id="zr-result">0,00 %</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wertzuwachs</div><div class="text-xl font-bold font-mono" id="zr-growth">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wachstumsfaktor</div><div class="text-xl font-bold font-mono" id="zr-mult">0x</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verdoppelungszeit</div><div class="text-xl font-bold font-mono" id="zr-double">— J.</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Endkapital bei verschiedenen Zinssätzen</h3>
          <div class="text-xs space-y-1" id="zr-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="interest-rate" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">So berechnen Sie den Zinssatz</h2>
      <p class="text-text-secondary">Der Zinssatz-Rechner ermittelt den jährlichen Zinssatz (p.a.), der notwendig ist, um ein Startkapital innerhalb einer bestimmten Laufzeit auf ein Zielkapital anwachsen zu lassen. Die Berechnung basiert auf der Zinseszins-Formel: <strong>r = n × ((Ziel/Start)^(1/n×t) − 1)</strong>, wobei n die Anzahl der Verzinsungsperioden pro Jahr und t die Laufzeit in Jahren ist. Je häufiger der Zins gutgeschrieben wird, desto geringer ist der nominale Zinssatz, der benötigt wird.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>r = n × ((Ziel / Start)^(1 / (n × Jahre)) − 1)</p>
        <p>Verdoppelungszeit ≈ ln(2) / ln(1 + r)</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zwischen nominalem und effektivem Zinssatz?</h4>
          <p class="text-text-secondary mt-1">Der nominale Zinssatz ist der vertraglich vereinbarte Satz ohne Berücksichtigung der Zinseszinsfrequenz. Der effektive Jahreszins (Effektivzins) berücksichtigt, wie oft die Zinsen im Jahr verrechnet werden. Bei monatlicher Verzinsung ist der Effektivzins höher als der Nominalzins.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welchen Einfluss hat die Verzinsungsfrequenz?</h4>
          <p class="text-text-secondary mt-1">Je öfter Zinsen gutgeschrieben werden, desto stärker wirkt der Zinseszinseffekt. Bei gleichem Nominalzins führt monatliche Verzinsung zu einem höheren Endkapital als jährliche Verzinsung. Für den Kreditnehmer bedeutet häufigere Verzinsung höhere Gesamtkosten.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist die Verdoppelungszeit?</h4>
          <p class="text-text-secondary mt-1">Die Verdoppelungszeit gibt an, nach wie vielen Jahren sich eine Anlage bei konstantem Zinssatz verdoppelt hat. Als Faustregel gilt die „Regel 72": Teilen Sie 72 durch den Jahreszinssatz in Prozent. Bei 6 % p.a. dauert die Verdoppelung ca. 12 Jahre.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie hoch ist ein realistischer Zinssatz für Sparkonten in Deutschland?</h4>
          <p class="text-text-secondary mt-1">Tagesgeld- und Festgeldkonten boten 2024 je nach Laufzeit und Anbieter zwischen 2,5 % und 4,5 % p.a. Langfristig erzielen breit diversifizierte Aktien-ETFs historisch 7–10 % p.a. vor Inflation, jedoch mit deutlich höherem Risiko.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Gilt der berechnete Zinssatz als Brutto- oder Nettowert?</h4>
          <p class="text-text-secondary mt-1">Der Rechner berechnet den Brutto-Zinssatz vor Steuern. In Deutschland wird auf Kapitalerträge die Abgeltungsteuer von 25 % plus Solidaritätszuschlag erhoben. Den Nettowert erhalten Sie, indem Sie den Bruttowert mit dem Faktor 0,7375 multiplizieren (ohne Kirchensteuer).</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcZR() {
      const start = parseFloat((document.getElementById('zr-start') as HTMLInputElement).value) || 0;
      const target = parseFloat((document.getElementById('zr-target') as HTMLInputElement).value) || 0;
      const years = parseFloat((document.getElementById('zr-years') as HTMLInputElement).value) || 0;
      const comp = parseInt((document.getElementById('zr-comp') as HTMLSelectElement).value) || 1;
      const growth = target - start;
      const mult = start > 0 ? target / start : 0;
      let rate = 0;
      if (start > 0 && target > start && years > 0) {
        const n = comp * years;
        rate = comp * (Math.pow(target / start, 1 / n) - 1);
      }
      const doubleTime = rate > 0 ? Math.log(2) / Math.log(1 + rate) : 0;
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('zr-result')!.textContent = (rate * 100).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
      document.getElementById('zr-growth')!.textContent = fmtEur(growth);
      document.getElementById('zr-mult')!.textContent = mult.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + 'x';
      document.getElementById('zr-double')!.textContent = doubleTime > 0 ? doubleTime.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' J.' : '— J.';
      const rates = [1, 2, 3, 5, 7, 10, 12];
      document.getElementById('zr-table')!.innerHTML = rates.map(r => {
        const fv = start * Math.pow(1 + r / 100 / comp, comp * years);
        const hit = fv >= target;
        const fvStr = fv.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
        return '<div class="flex justify-between' + (hit ? ' text-green-700 font-bold' : '') + '"><span>' + r + ' % p.a.</span><span>' + fvStr + ' nach ' + years + ' J.' + (hit ? ' ✓' : '') + '</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zr-in').forEach(el => { el.addEventListener('input', calcZR); el.addEventListener('change', calcZR); });
      calcZR();
    }, 50);
  </script>
</CalculatorLayout>
