---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kfz-Versicherung-Rechner - Pr\u00e4mie sch\u00e4tzen";
const description = "Sch\u00e4tzen Sie Ihre Kfz-Versicherungspr\u00e4mie basierend auf Fahrzeugwert, Alter, Deckungsart und Selbstbeteiligung.";
const relatedCalcs = [
  { name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner", description: "Wertverlust." },
  { name: "Auto-Leasing", url: "/de/auto-leasing-rechner", description: "Leasing." },
  { name: "Autorate", url: "/de/autorate-rechner", description: "Autofinanzierung." },
  { name: "Kapitalertragssteuer", url: "/de/kapitalertragssteuer-rechner", description: "Kapitalertr\u00e4ge." },
  { name: "Kapitalisierungsrate", url: "/de/kapitalisierungsrate-rechner", description: "Cap Rate." },
  { name: "Kindersitz-Rechner", url: "/de/kindersitz-rechner", description: "Kindersitz." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kfz-Versicherung-Rechner" lang="de" enSlug="car-insurance-calculator" keywords="kfz versicherung rechner, autoversicherung sch\u00e4tzen, pr\u00e4mie, haftpflicht, kasko, selbstbeteiligung" breadcrumbs={[{ name: "Kfz-Versicherung", url: "/de/kfz-versicherung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kfz-Versicherung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihre j&auml;hrliche Kfz-Versicherungspr&auml;mie basierend auf Fahrzeug und Deckung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Fahrzeugwert</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="kv2-value" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="25000" min="0" step="1000">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fahrzeugalter (Jahre)</label>
            <input type="number" id="kv2-age" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="0" max="30" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Deckungsart</label>
            <select id="kv2-coverage" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="haftpflicht">Nur Haftpflicht</option>
              <option value="teilkasko" selected>Haftpflicht + Teilkasko</option>
              <option value="vollkasko">Vollkasko</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Selbstbeteiligung</label>
            <select id="kv2-deductible" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="150">150 &euro;</option>
              <option value="300" selected>300 &euro;</option>
              <option value="500">500 &euro;</option>
              <option value="1000">1.000 &euro;</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fahreralter</label>
            <input type="number" id="kv2-driver-age" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="35" min="18" max="90" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Schadenfreiheitsklasse (SF)</label>
            <select id="kv2-sf" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="2.5">SF 0 (250%)</option>
              <option value="1.4">SF 1 (140%)</option>
              <option value="1.0">SF 3 (100%)</option>
              <option value="0.7" selected>SF 10 (70%)</option>
              <option value="0.5">SF 20 (50%)</option>
              <option value="0.3">SF 35+ (30%)</option>
            </select>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch. Jahrespr&auml;mie</div>
            <div class="text-5xl font-extrabold font-mono" id="kv2-annual">0 &euro;</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Monatlich</div>
              <div class="text-xl font-bold text-secondary" id="kv2-monthly">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Halbj&auml;hrlich</div>
              <div class="text-xl font-bold" id="kv2-semi">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Haftpflicht-Anteil</div>
              <div class="text-xl font-bold text-green-600" id="kv2-liability">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Kasko-Anteil</div>
              <div class="text-xl font-bold text-orange-600" id="kv2-extra">0 &euro;</div>
            </div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="car-insurance" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kfz-Versicherung verstehen</h2>
      <p><strong>Haftpflicht</strong> ist in Deutschland Pflicht und deckt Sch&auml;den an Dritten. <strong>Teilkasko</strong> sch&uuml;tzt zus&auml;tzlich gegen Diebstahl, Glasbruch, Unwetter. <strong>Vollkasko</strong> deckt auch selbstverschuldete Unf&auml;lle ab.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Schadenfreiheitsklasse</h3>
      <p>Je l&auml;nger Sie schadensfrei fahren, desto niedriger Ihre Pr&auml;mie. SF 0 bedeutet 250% des Grundbeitrags, SF 35+ nur ca. 30%.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKV2() {
      const value = parseFloat((document.getElementById('kv2-value') as HTMLInputElement).value) || 0;
      const vehicleAge = parseInt((document.getElementById('kv2-age') as HTMLInputElement).value) || 0;
      const coverage = (document.getElementById('kv2-coverage') as HTMLSelectElement).value;
      const deductible = parseFloat((document.getElementById('kv2-deductible') as HTMLSelectElement).value) || 300;
      const driverAge = parseInt((document.getElementById('kv2-driver-age') as HTMLInputElement).value) || 35;
      const sfFactor = parseFloat((document.getElementById('kv2-sf') as HTMLSelectElement).value) || 0.7;

      let baseLiability = 500;

      let ageFactor = 1.0;
      if (driverAge < 21) ageFactor = 2.0;
      else if (driverAge < 25) ageFactor = 1.5;
      else if (driverAge < 30) ageFactor = 1.15;
      else if (driverAge > 65) ageFactor = 1.2;

      const liabilityCost = baseLiability * ageFactor * sfFactor;

      let extraCost = 0;
      if (coverage === 'teilkasko' || coverage === 'vollkasko') {
        const kaskoRate = 0.03;
        extraCost = value * kaskoRate;
        extraCost *= Math.max(0.4, 1 - vehicleAge * 0.06);
        const dedFactor = deductible <= 150 ? 1.2 : deductible <= 300 ? 1.0 : deductible <= 500 ? 0.85 : 0.7;
        extraCost *= dedFactor;
      }
      if (coverage === 'vollkasko') {
        extraCost *= 1.8;
        extraCost *= sfFactor;
      }

      const annual = liabilityCost + extraCost;
      const monthly = annual / 12;
      const semi = annual / 2;
      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

      document.getElementById('kv2-annual')!.textContent = fmt(annual);
      document.getElementById('kv2-monthly')!.textContent = fmt(monthly);
      document.getElementById('kv2-semi')!.textContent = fmt(semi);
      document.getElementById('kv2-liability')!.textContent = fmt(liabilityCost);
      document.getElementById('kv2-extra')!.textContent = fmt(extraCost);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['kv2-value', 'kv2-age', 'kv2-driver-age'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcKV2); el.addEventListener('change', calcKV2); }
      });
      ['kv2-coverage', 'kv2-deductible', 'kv2-sf'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('change', calcKV2); }
      });
      calcKV2();
    }, 50);
  </script>
</CalculatorLayout>
