---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "BH-Größe-Rechner - Finden Sie Ihre perfekte Passform";
const description = "Berechnen Sie Ihre BH-Größe anhand von Unterbrustweite und Brustumfang. Unterstützt EU, US und UK Größensysteme.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Körperoberfläche-Rechner", url: "/de/koerperoberflaeche-rechner", description: "Körperoberfläche." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Militär-Körperfett-Rechner", url: "/de/militaer-koerperfett-rechner", description: "Körperfettanteil." },
  { name: "Botox-Einheiten-Rechner", url: "/de/botox-einheiten-rechner", description: "Botox-Einheiten." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="BH-Größe-Rechner" enSlug="bra-size-calculator" keywords="BH Größe Rechner, BH Anpassung, Körbchengröße, Unterbrustweite, BH Messung, EU US UK BH Größe" breadcrumbs={[{ name: "BH-Größe-Rechner", url: "/de/bh-groesse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">BH-Größe-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihre perfekte BH-Größe anhand Ihrer Maße.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Unterbrustweite (cm)</label><input type="number" id="bg-band" class="bg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="60" max="130" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Brustumfang (cm)</label><input type="number" id="bg-bust" class="bg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="95" min="65" max="145" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ihre BH-Größe (EU)</div>
          <div class="text-5xl font-extrabold font-mono" id="bg-size">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">EU Größe</div><div class="text-xl font-bold" id="bg-eu">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">US Größe</div><div class="text-xl font-bold" id="bg-us">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">UK Größe</div><div class="text-xl font-bold" id="bg-uk">-</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Unterbrustweite</div><div class="text-xl font-bold" id="bg-bandSize">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Differenz</div><div class="text-xl font-bold" id="bg-diff">-</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Kreuzgrößen</h3>
          <div class="text-sm font-mono" id="bg-sister">-</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="bh-groesse" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">BH-Größe richtig bestimmen</h2>
      <p>Messen Sie die Unterbrustweite fest direkt unter der Brust und den Brustumfang locker an der weitesten Stelle. Die EU-Größe ergibt sich aus der Unterbrustweite (gerundet auf 5er-Schritte) und der Differenz zum Brustumfang bestimmt die Körbchengröße (AA bei 10-12cm, A bei 12-14cm, B bei 14-16cm usw.).</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was sind Kreuzgrößen?</strong> Kreuzgrößen haben das gleiche Körbchenvolumen bei unterschiedlicher Bandweite. Z.B. hat 75C das gleiche Körbchenvolumen wie 80B und 70D.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const bgEuCups = ['AA','A','B','C','D','E','F','G','H','I','J','K'];
    const bgUsCups = ['AA','A','B','C','D','DD','DDD','G','H','I','J','K'];
    const bgUkCups = ['AA','A','B','C','D','DD','E','F','FF','G','GG','H'];
    function calcBG() {
      const bandCm = parseFloat((document.getElementById('bg-band') as HTMLInputElement).value) || 0;
      const bustCm = parseFloat((document.getElementById('bg-bust') as HTMLInputElement).value) || 0;
      // EU band size: round to nearest 5
      const euBand = Math.round(bandCm / 5) * 5;
      const diff = bustCm - bandCm;
      // EU cup: each 2cm difference is one cup size, starting from ~10cm = AA
      const cupIdx = Math.max(0, Math.min(Math.round((diff - 11) / 2), bgEuCups.length - 1));
      const euCup = diff >= 10 ? bgEuCups[cupIdx] : 'AA';
      // US conversion
      const usBand = Math.round(bandCm / 2.54);
      const usBandEven = usBand % 2 === 0 ? usBand : usBand + 1;
      const usCup = diff >= 10 ? bgUsCups[Math.min(cupIdx, bgUsCups.length - 1)] : 'AA';
      const ukCup = diff >= 10 ? bgUkCups[Math.min(cupIdx, bgUkCups.length - 1)] : 'AA';
      document.getElementById('bg-size')!.textContent = euBand + euCup;
      document.getElementById('bg-eu')!.textContent = euBand + euCup;
      document.getElementById('bg-us')!.textContent = usBandEven + usCup;
      document.getElementById('bg-uk')!.textContent = usBandEven + ukCup;
      document.getElementById('bg-bandSize')!.textContent = euBand + ' (EU)';
      document.getElementById('bg-diff')!.textContent = diff.toFixed(0) + ' cm';
      // Sister sizes
      const sisters: string[] = [];
      if (euBand >= 70 && cupIdx < bgEuCups.length - 1) sisters.push((euBand - 5) + bgEuCups[cupIdx + 1]);
      sisters.push(euBand + euCup);
      if (cupIdx > 0) sisters.push((euBand + 5) + bgEuCups[cupIdx - 1]);
      document.getElementById('bg-sister')!.textContent = sisters.join(' \u2194 ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.bg-in').forEach(el => el.addEventListener('input', calcBG)); calcBG(); }, 50);
  </script>
</CalculatorLayout>
