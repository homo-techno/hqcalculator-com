---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Augenuntersuchung-Rechner - Kosten & Empfehlungen";
const description = "Sch\u00e4tzen Sie die Kosten einer Augenuntersuchung nach Typ, Anbieter, Alter und Zusatzuntersuchungen. Mit Empfehlungen zur H\u00e4ufigkeit.";

const relatedCalcs = [
  { name: "Brillen-Rechner", url: "/de/brillen-rechner", description: "Brillenkosten." },
  { name: "Kontaktlinsen-Rechner", url: "/de/kontaktlinsen-rechner", description: "Kontaktlinsenkosten." },
  { name: "Krankenversicherung-Rechner", url: "/de/krankenversicherung-rechner", description: "Versicherungsvergleich." },
  { name: "Sehst\u00e4rke-Rechner", url: "/de/sehstaerke-rechner", description: "Brillenwerte verstehen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Augenuntersuchung-Rechner" lang="de" enSlug="eye-exam-calculator" keywords="augenuntersuchung kosten, augenarzt, sehtest, kontaktlinsenanpassung, vorsorgeuntersuchung augen" breadcrumbs={[{ name: "Augenuntersuchung-Rechner", url: "/de/augenuntersuchung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Augenuntersuchung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Kosten einer Augenuntersuchung, empfohlene H&auml;ufigkeit und Versicherungsersparnisse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Untersuchungsart</label>
            <select id="aug-type" class="aug-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="routine" selected>Routine-Sehtest</option>
              <option value="comprehensive">Umfassende Untersuchung</option>
              <option value="contact">Kontaktlinsenanpassung</option>
              <option value="medical">Medizinische Augenuntersuchung</option>
              <option value="pediatric">Kinderaugenuntersuchung</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anbieter</label>
            <select id="aug-prov" class="aug-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="chain">Optikerkette (Fielmann, etc.)</option>
              <option value="private" selected>Augenarzt (Privatpraxis)</option>
              <option value="hospital">Augenklinik</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Alter des Patienten</label><input type="number" id="aug-age" class="aug-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="1" max="100" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Risikofaktoren</label>
            <select id="aug-risk" class="aug-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="none" selected>Keine</option>
              <option value="diabetes">Diabetes</option>
              <option value="family">Familiengeschichte (Glaukom/AMD)</option>
              <option value="high_rx">Hohe Fehlsichtigkeit (&uuml;ber -6,00)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Versicherung?</label>
            <select id="aug-ins" class="aug-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="none">Keine / Selbstzahler</option>
              <option value="basic" selected>Gesetzlich versichert (GKV)</option>
              <option value="premium">Privat versichert (PKV)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zusatzuntersuchungen</label>
            <select id="aug-extra" class="aug-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="none" selected>Keine</option>
              <option value="retinal">Netzhaut-Bildgebung (30-50 &euro;)</option>
              <option value="oct">OCT-Scan (50-100 &euro;)</option>
              <option value="visual">Gesichtsfeld-Test (40-70 &euro;)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Untersuchungskosten</div>
          <div class="text-5xl font-extrabold font-mono" id="aug-cost">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="aug-oop">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfohlene H&auml;ufigkeit</div><div class="text-xl font-bold font-mono" id="aug-freq">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Kosten</div><div class="text-xl font-bold font-mono" id="aug-annual">0 &euro;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase mb-1">N&auml;chste Untersuchung empfohlen</div>
          <div class="text-xl font-bold font-mono" id="aug-next">-</div>
        </div>
      </div>
      <ShareButton calculatorId="eye-exam-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Augenuntersuchung in Deutschland</h2>
      <p>In Deutschland werden Vorsorgeuntersuchungen beim Augenarzt von der GKV nur bei medizinischer Indikation &uuml;bernommen. IGeL-Leistungen wie Glaukom-Vorsorge oder OCT m&uuml;ssen meist selbst bezahlt werden.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie oft zum Augenarzt?</strong> Ab 40 Jahren alle 2 Jahre, ab 60 Jahren j&auml;hrlich. Bei Risikofaktoren wie Diabetes j&auml;hrlich ab Diagnose.</p>
      <p><strong>Was zahlt die Krankenkasse?</strong> Die GKV &uuml;bernimmt Untersuchungen bei Beschwerden. Vorsorge-IGeL wie Netzhaut-Screening kosten 20-100 &euro; selbst.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAUG() {
      const type = (document.getElementById('aug-type') as HTMLSelectElement).value;
      const prov = (document.getElementById('aug-prov') as HTMLSelectElement).value;
      const age = parseFloat((document.getElementById('aug-age') as HTMLInputElement).value) || 35;
      const risk = (document.getElementById('aug-risk') as HTMLSelectElement).value;
      const ins = (document.getElementById('aug-ins') as HTMLSelectElement).value;
      const extra = (document.getElementById('aug-extra') as HTMLSelectElement).value;

      const baseCosts: Record<string, Record<string, number>> = {
        routine:       { chain: 20, private: 40, hospital: 60 },
        comprehensive: { chain: 40, private: 80, hospital: 120 },
        contact:       { chain: 30, private: 60, hospital: 90 },
        medical:       { chain: 50, private: 100, hospital: 150 },
        pediatric:     { chain: 20, private: 40, hospital: 70 }
      };

      const extraCosts: Record<string, number> = { none: 0, retinal: 40, oct: 75, visual: 55 };
      const totalCost = baseCosts[type][prov] + extraCosts[extra];

      let copay = totalCost;
      if (ins === 'basic') copay = Math.max(0, extraCosts[extra]);
      else if (ins === 'premium') copay = 0;

      let freqMonths: number;
      if (risk !== 'none' || age >= 60) freqMonths = 12;
      else if (age >= 40) freqMonths = 24;
      else if (age >= 18) freqMonths = 24;
      else freqMonths = 12;

      const freqText = freqMonths === 12 ? 'Alle 12 Monate' : 'Alle 24 Monate';
      const annualCost = Math.round(copay * (12 / freqMonths));

      let nextText: string;
      if (age < 5) nextText = 'Mit 3, 5, dann j\u00E4hrlich';
      else if (age < 18) nextText = 'J\u00E4hrlich f\u00FCr Kinder';
      else if (risk !== 'none') nextText = 'J\u00E4hrlich (Risikofaktoren)';
      else if (age >= 60) nextText = 'J\u00E4hrlich (ab 60)';
      else if (age >= 40) nextText = 'Alle 2 Jahre (ab 40)';
      else nextText = 'Alle 2 Jahre (niedriges Risiko)';

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('aug-cost')!.textContent = fmt(totalCost);
      document.getElementById('aug-oop')!.textContent = fmt(copay);
      document.getElementById('aug-freq')!.textContent = freqText;
      document.getElementById('aug-annual')!.textContent = fmt(annualCost) + '/Jahr';
      document.getElementById('aug-next')!.textContent = nextText;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.aug-in').forEach(el => { el.addEventListener('input', calcAUG); el.addEventListener('change', calcAUG); });
      calcAUG();
    }, 50);
  </script>
</CalculatorLayout>
