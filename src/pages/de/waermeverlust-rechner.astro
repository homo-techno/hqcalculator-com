---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "W&auml;rmeverlust-Rechner - Geb&auml;ude-W&auml;rmeverlust berechnen";
const description = "Berechnen Sie den Geb&auml;ude-W&auml;rmeverlust durch W&auml;nde, Fenster, Dach, Boden und Infiltration. Bestimmen Sie die ben&ouml;tigte Heizungsleistung in Watt f&uuml;r die Heizungsauslegung.";

const relatedCalcs = [
  { name: "W&auml;rmetauscher-Rechner", url: "/de/waermetauscher-rechner", description: "W&auml;rmetauscher." },
  { name: "W&auml;rmepumpe-Rechner", url: "/de/waermepumpe-rechner", description: "W&auml;rmepumpen." },
  { name: "W&auml;rme&uuml;bertragung-Rechner", url: "/de/waermeubertragung-rechner", description: "Q=mc&Delta;T." },
  { name: "Energieaudit-Rechner", url: "/de/energieaudit-rechner", description: "Energieaudit." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="W&auml;rmeverlust-Rechner"
  keywords="w&auml;rmeverlust rechner, geb&auml;ude w&auml;rmeverlust, heizungsauslegung, w&auml;nde w&auml;rmeverlust, fenster w&auml;rmeverlust, infiltration, U-Wert"
  breadcrumbs={[{ name: "W&auml;rmeverlust-Rechner", url: "/de/waermeverlust-rechner" }]}
  lang="de"
  enSlug="heat-loss-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">W&auml;rmeverlust-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den W&auml;rmeverlust durch die Geb&auml;udeh&uuml;lle, um Ihre Heizungsanlage zu dimensionieren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <h3 class="text-lg font-bold text-text">Auslegungstemperaturen</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Innentemperatur (&deg;C)</label>
            <input type="number" id="wvde-indoor" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Au&szlig;enauslegungstemperatur (&deg;C)</label>
            <input type="number" id="wvde-outdoor" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="-12" step="1">
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">W&auml;nde</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Wandfl&auml;che (m&sup2;)</label>
            <input type="number" id="wvde-wallarea" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="0" step="5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Wand U-Wert (W/m&sup2;K)</label>
            <select id="wvde-wallu" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1.5">Unged&auml;mmt (U=1,5)</option>
              <option value="0.5">Teilged&auml;mmt (U=0,5)</option>
              <option value="0.28" selected>Gut ged&auml;mmt (U=0,28)</option>
              <option value="0.15">Passivhaus (U=0,15)</option>
            </select>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">Fenster</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Fensterfl&auml;che (m&sup2;)</label>
            <input type="number" id="wvde-winarea" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Fenstertyp</label>
            <select id="wvde-winu" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="5.8">Einfachverglasung (U=5,8)</option>
              <option value="2.8" selected>Zweifach-WS (U=2,8)</option>
              <option value="1.1">Dreifach-WS (U=1,1)</option>
              <option value="0.8">Passivhaus-Fenster (U=0,8)</option>
            </select>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">Dach / Decke</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Dachfl&auml;che (m&sup2;)</label>
            <input type="number" id="wvde-roofarea" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Dach U-Wert (W/m&sup2;K)</label>
            <select id="wvde-roofu" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="0.8">Schwach ged&auml;mmt (U=0,8)</option>
              <option value="0.22" selected>Standard (U=0,22)</option>
              <option value="0.15">Gut ged&auml;mmt (U=0,15)</option>
              <option value="0.10">Passivhaus (U=0,10)</option>
            </select>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">Boden</h3>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Bodenfl&auml;che (m&sup2;)</label>
            <input type="number" id="wvde-floorarea" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="5">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Bodentyp</label>
            <select id="wvde-flooru" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="0.7">Unged&auml;mmt (U=0,7)</option>
              <option value="0.35" selected>Ged&auml;mmt (U=0,35)</option>
              <option value="0.15">Gut ged&auml;mmt (U=0,15)</option>
            </select>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text">Infiltration</h3>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Geb&auml;udedichtigkeit</label>
          <select id="wvde-infil" class="wvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.5">Undicht (1,5 Luftwechsel/h)</option>
            <option value="0.75" selected>Durchschnittlich (0,75 Lw/h)</option>
            <option value="0.35">Dicht (0,35 Lw/h)</option>
            <option value="0.15">Sehr dicht / Passivhaus (0,15 Lw/h)</option>
          </select>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter W&auml;rmeverlust</div>
          <div class="text-4xl font-extrabold" id="wvde-total">--</div>
          <div class="text-sm text-blue-200 mt-1">W</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wand-Verlust</div>
            <div class="text-xl font-bold" id="wvde-wallloss">--</div>
            <div class="text-xs text-text-muted">W</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Fenster-Verlust</div>
            <div class="text-xl font-bold" id="wvde-winloss">--</div>
            <div class="text-xs text-text-muted">W</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Dach-Verlust</div>
            <div class="text-xl font-bold" id="wvde-roofloss">--</div>
            <div class="text-xs text-text-muted">W</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Boden + Infiltration</div>
            <div class="text-xl font-bold" id="wvde-otherloss">--</div>
            <div class="text-xs text-text-muted">W</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Empfohlene Heizleistung</div>
          <div class="text-xl font-bold" id="wvde-heater">--</div>
        </div>
      </div>

      <ShareButton calculatorId="waermeverlust-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl mx-auto prose prose-slate">
      <h2 class="text-2xl font-bold text-text">W&auml;rmeverlust-Berechnung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>Q = U &times; A &times; &Delta;T (Transmission)</p>
        <p>Q_Inf = 0,34 &times; n &times; V &times; &Delta;T (Infiltration)</p>
      </div>
      <p>Der Gesamtw&auml;rmeverlust ist die Summe der Transmissionsw&auml;rmeverluste durch alle Bauteile plus den Infiltrationsverlust durch Luftundichtigkeiten. Heizanlagen werden &uuml;blicherweise mit 125% des Norm-W&auml;rmeverlustes dimensioniert.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der U-Wert?</strong> Der W&auml;rmedurchgangskoeffizient U gibt an, wie viel W&auml;rme pro Sekunde durch 1 m&sup2; eines Bauteils bei 1 Kelvin Temperaturdifferenz str&ouml;mt. Ein niedrigerer U-Wert bedeutet bessere D&auml;mmung.</p>
      <p><strong>Wie gro&szlig; sollte meine Heizungsanlage sein?</strong> Die Heizungsleistung sollte den Norm-W&auml;rmeverlust bei der k&auml;ltesten Norm-Au&szlig;entemperatur Ihres Standorts decken k&ouml;nnen, plus einen Sicherheitszuschlag von 20-25%.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcWVDE() {
      const indoor = parseFloat((document.getElementById('wvde-indoor') as HTMLInputElement).value) || 20;
      const outdoor = parseFloat((document.getElementById('wvde-outdoor') as HTMLInputElement).value) || -12;
      const deltaT = indoor - outdoor;

      const wallArea = parseFloat((document.getElementById('wvde-wallarea') as HTMLInputElement).value) || 0;
      const wallU = parseFloat((document.getElementById('wvde-wallu') as HTMLSelectElement).value) || 0.28;
      const winArea = parseFloat((document.getElementById('wvde-winarea') as HTMLInputElement).value) || 0;
      const winU = parseFloat((document.getElementById('wvde-winu') as HTMLSelectElement).value) || 2.8;
      const roofArea = parseFloat((document.getElementById('wvde-roofarea') as HTMLInputElement).value) || 0;
      const roofU = parseFloat((document.getElementById('wvde-roofu') as HTMLSelectElement).value) || 0.22;
      const floorArea = parseFloat((document.getElementById('wvde-floorarea') as HTMLInputElement).value) || 0;
      const floorU = parseFloat((document.getElementById('wvde-flooru') as HTMLSelectElement).value) || 0.35;
      const ach = parseFloat((document.getElementById('wvde-infil') as HTMLSelectElement).value) || 0.75;

      const netWall = Math.max(0, wallArea - winArea);
      const wallLoss = netWall * deltaT * wallU;
      const winLoss = winArea * deltaT * winU;
      const roofLoss = roofArea * deltaT * roofU;
      const floorLoss = floorArea * deltaT * floorU;

      const volume = floorArea * 2.7; // assume 2.7m ceiling height
      const infilLoss = 0.34 * ach * volume * deltaT;

      const otherLoss = floorLoss + infilLoss;
      const totalLoss = wallLoss + winLoss + roofLoss + otherLoss;
      const heaterSize = totalLoss * 1.25;

      let heaterRec = '';
      const stdSizes = [2000, 3000, 4000, 5000, 6000, 8000, 10000, 12000, 15000, 20000, 25000, 30000];
      for (const s of stdSizes) {
        if (s >= heaterSize) { heaterRec = (s / 1000).toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' kW'; break; }
      }
      if (!heaterRec) heaterRec = Math.ceil(heaterSize / 1000) + ' kW';

      document.getElementById('wvde-total')!.textContent = Math.round(totalLoss).toLocaleString('de-DE');
      document.getElementById('wvde-wallloss')!.textContent = Math.round(wallLoss).toLocaleString('de-DE');
      document.getElementById('wvde-winloss')!.textContent = Math.round(winLoss).toLocaleString('de-DE');
      document.getElementById('wvde-roofloss')!.textContent = Math.round(roofLoss).toLocaleString('de-DE');
      document.getElementById('wvde-otherloss')!.textContent = Math.round(otherLoss).toLocaleString('de-DE');
      document.getElementById('wvde-heater')!.textContent = heaterRec;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.wvde-in').forEach(el => {
        el.addEventListener('input', calcWVDE);
        el.addEventListener('change', calcWVDE);
      });
      calcWVDE();
    }, 50);
  </script>
</CalculatorLayout>
