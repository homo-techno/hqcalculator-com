---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Beauty-Budget Rechner - Monatliche & j\u00e4hrliche Ausgaben\u00fcbersicht";
const description = "Berechnen Sie Ihre monatlichen und j\u00e4hrlichen Beauty-Ausgaben nach Kategorie: Hautpflege, Haarpflege, Make-up, N\u00e4gel und professionelle Behandlungen.";
const relatedCalcs = [
  { name: "Nagelstudio-Preisrechner", url: "/nail-salon-pricing-calculator", description: "Nagelservice-Preise." },
  { name: "Salon-Umsatzrechner", url: "/salon-revenue-calculator", description: "Salon-Umsatzprognose." },
  { name: "Kosmetik-Verfallsrechner", url: "/cosmetic-expiration-calculator", description: "Haltbarkeit von Produkten." },
  { name: "Hautpflege-Routinenrechner", url: "/skincare-routine-calculator", description: "Hautpflegeprodukt-Reihenfolge." },
  { name: "Wimpernverl\u00e4ngerungsrechner", url: "/eyelash-extension-calculator", description: "Wimpernverl\u00e4ngerungskosten." },
  { name: "Haarfarbmisch-Rechner", url: "/hair-color-mixing-calculator", description: "Haarfarbe-Mischverh\u00e4ltnisse." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Beauty-Budget Rechner" lang="de" keywords="beauty budget, beauty ausgaben, make-up budget, hautpflege kosten, beauty-kosten, j\u00e4hrliche beauty-kosten" breadcrumbs={[{ name: "Beauty-Budget Rechner", url: "/de/beauty-budget-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Beauty-Budget Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Verfolgen und planen Sie Ihre Beauty-Ausgaben &uuml;ber alle Kategorien hinweg.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <p class="text-xs text-text-muted">Geben Sie Ihre gesch&auml;tzten monatlichen Ausgaben pro Kategorie ein.</p>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hautpflegeprodukte (&euro;/Monat)</label><input type="number" id="bbu-skincare" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" max="2000" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Make-up-Produkte (&euro;/Monat)</label><input type="number" id="bbu-makeup" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="2000" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Haarpflegeprodukte (&euro;/Monat)</label><input type="number" id="bbu-hairprod" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" max="1000" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Friseur-Dienstleistungen (&euro;/Monat)</label><input type="number" id="bbu-hairsalon" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="0" max="2000" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Nagelservice (&euro;/Monat)</label><input type="number" id="bbu-nails" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="0" max="1000" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wimpern-/Brauen-Service (&euro;/Monat)</label><input type="number" id="bbu-lash" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="1000" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Waxing / Haarentfernung (&euro;/Monat)</label><input type="number" id="bbu-waxing" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="1000" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gesichtsbehandlungen / Spa (&euro;/Monat)</label><input type="number" id="bbu-spa" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="2000" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Parf&uuml;m (&euro;/Monat)</label><input type="number" id="bbu-fragrance" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" max="500" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Werkzeuge & Zubeh&ouml;r (&euro;/Monat)</label><input type="number" id="bbu-tools" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="500" step="5"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Monatliches Einkommen (&euro;)</label>
          <input type="number" id="bbu-income" class="bbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3500" min="0" max="100000" step="100">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Beauty-Ausgaben</div>
          <div class="text-5xl font-extrabold font-mono" id="bbu-monthly">0 &euro;</div>
          <div class="text-sm text-blue-200 mt-1" id="bbu-pct">0% des Einkommens</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrlich gesamt</div><div class="text-xl font-bold" id="bbu-annual">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">T&auml;glicher Durchschnitt</div><div class="text-xl font-bold" id="bbu-daily">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Produkte vs. Services</div><div class="text-xl font-bold" id="bbu-split">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Top-Kategorie</div><div class="text-xl font-bold" id="bbu-top">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Ausgabenaufschl&uuml;sselung</h3>
          <div class="text-sm space-y-1" id="bbu-breakdown"></div>
        </div>
      </div>
      <ShareButton calculatorId="beauty-budget" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Beauty-Ausgaben-Ratgeber</h2>
      <p>Die durchschnittliche Frau in Deutschland gibt etwa 150&ndash;250 &euro; pro Monat f&uuml;r Beauty-Produkte und -Dienstleistungen aus, was j&auml;hrlich 1.800&ndash;3.000 &euro; ergibt. Die gr&ouml;&szlig;ten Kategorien sind typischerweise Haarpflege, Hautpflege und Make-up. Um Ihr Beauty-Budget zu optimieren, setzen Sie auf Qualit&auml;tsklassiker statt Trendprodukte, nutzen Sie Angebote und Treueprogramme und ziehen Sie Multifunktionsprodukte in Betracht.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBBU() {
      const categories: {id:string, name:string, isService:boolean}[] = [
        {id:'bbu-skincare', name:'Hautpflegeprodukte', isService:false},
        {id:'bbu-makeup', name:'Make-up-Produkte', isService:false},
        {id:'bbu-hairprod', name:'Haarpflegeprodukte', isService:false},
        {id:'bbu-hairsalon', name:'Friseur-Dienstleistungen', isService:true},
        {id:'bbu-nails', name:'Nagelservice', isService:true},
        {id:'bbu-lash', name:'Wimpern-/Brauen-Service', isService:true},
        {id:'bbu-waxing', name:'Waxing / Haarentfernung', isService:true},
        {id:'bbu-spa', name:'Gesichtsbehandlungen / Spa', isService:true},
        {id:'bbu-fragrance', name:'Parf\u00fcm', isService:false},
        {id:'bbu-tools', name:'Werkzeuge & Zubeh\u00f6r', isService:false},
      ];
      let total = 0;
      let productTotal = 0;
      let serviceTotal = 0;
      let topCat = '';
      let topAmount = 0;
      const breakdown: string[] = [];
      categories.forEach(c => {
        const val = parseFloat((document.getElementById(c.id) as HTMLInputElement).value) || 0;
        total += val;
        if (c.isService) serviceTotal += val;
        else productTotal += val;
        if (val > topAmount) { topAmount = val; topCat = c.name; }
        if (val > 0) {
          breakdown.push('<div class="flex justify-between"><span>' + c.name + '</span><span class="font-bold">' + val.toFixed(0) + ' \u20ac/Mo.</span></div>');
        }
      });
      const income = parseFloat((document.getElementById('bbu-income') as HTMLInputElement).value) || 1;
      const pct = (total / income) * 100;
      const annual = total * 12;
      const daily = total / 30;
      const splitText = productTotal.toFixed(0) + ' \u20ac / ' + serviceTotal.toFixed(0) + ' \u20ac';
      document.getElementById('bbu-monthly')!.textContent = total.toFixed(0) + ' \u20ac';
      document.getElementById('bbu-pct')!.textContent = pct.toFixed(1).replace('.', ',') + '% des Einkommens';
      document.getElementById('bbu-annual')!.textContent = annual.toFixed(0) + ' \u20ac';
      document.getElementById('bbu-daily')!.textContent = daily.toFixed(2).replace('.', ',') + ' \u20ac';
      document.getElementById('bbu-split')!.textContent = splitText;
      document.getElementById('bbu-top')!.textContent = topCat || '--';
      document.getElementById('bbu-breakdown')!.innerHTML = breakdown.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bbu-in').forEach(el => { el.addEventListener('input', calcBBU); el.addEventListener('change', calcBBU); });
      calcBBU();
    }, 50);
  </script>
</CalculatorLayout>
