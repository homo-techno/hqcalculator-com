---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bayes-Theorem Rechner - A-posteriori-Wahrscheinlichkeit";
const description = "Berechnen Sie die A-posteriori-Wahrscheinlichkeit mit dem Satz von Bayes. Geben Sie P(A), P(B|A) und P(B|\u00acA) ein, um P(A|B) zu finden.";
const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/probability-calculator", description: "Allgemeine Wahrscheinlichkeit." },
  { name: "T-Test-Rechner", url: "/t-test-calculator", description: "Statistische Signifikanz." },
  { name: "Chi-Quadrat-Rechner", url: "/chi-square-calculator", description: "Chi-Quadrat-Test." },
  { name: "Durchschnittsrechner", url: "/average-calculator", description: "Mittelwert, Median, Modus." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozentberechnungen." },
  { name: "Korrelationsrechner", url: "/correlation-calculator", description: "Pearson-Korrelation." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Bayes-Theorem Rechner" lang="de" keywords="bayes theorem rechner, a-posteriori wahrscheinlichkeit, a-priori wahrscheinlichkeit, bedingte wahrscheinlichkeit, bayesianisch" breadcrumbs={[{ name: "Bayes-Theorem Rechner", url: "/de/bayes-theorem-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bayes-Theorem Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die A-posteriori-Wahrscheinlichkeit P(A|B) mit dem Satz von Bayes aus A-priori- und Likelihood-Werten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">P(A) &mdash; A-priori-Wahrscheinlichkeit <span class="text-text-muted">(0 bis 1)</span></label>
          <input type="number" id="bt-pa" class="bt-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="0.01" step="0.01" min="0" max="1" />
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">P(B|A) &mdash; Likelihood <span class="text-text-muted">(Wahrscheinlichkeit von B gegeben A)</span></label>
          <input type="number" id="bt-pba" class="bt-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="0.90" step="0.01" min="0" max="1" />
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">P(B|&not;A) &mdash; Falsch-positiv-Rate <span class="text-text-muted">(Wahrscheinlichkeit von B gegeben nicht A)</span></label>
          <input type="number" id="bt-pbna" class="bt-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="0.05" step="0.01" min="0" max="1" />
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">P(A|B) &mdash; A-posteriori-Wahrscheinlichkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="bt-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">P(B) &mdash; Gesamtwahrscheinlichkeit</div><div class="text-xl font-bold" id="bt-pb">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">P(&not;A|B)</div><div class="text-xl font-bold" id="bt-pnab">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A-priori P(A)</div><div class="text-xl font-bold" id="bt-prior">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktualisierungsfaktor</div><div class="text-xl font-bold" id="bt-factor">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schritt f&uuml;r Schritt</h3>
          <div class="text-sm text-text-secondary font-mono whitespace-pre-wrap" id="bt-steps"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Interpretation</h3>
          <div class="text-sm text-text-secondary" id="bt-interpret"></div>
        </div>
      </div>
      <ShareButton calculatorId="bayes-theorem" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Satz von Bayes</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>P(A|B) = P(B|A) &times; P(A) / P(B)</p>
        <p>P(B) = P(B|A) &times; P(A) + P(B|&not;A) &times; P(&not;A)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufige Anwendungen</h3>
      <ul>
        <li>Medizinische Diagnostik (Sensitivit&auml;t/Spezifit&auml;t)</li>
        <li>Spam-E-Mail-Filterung</li>
        <li>Maschinelles Lernen &ndash; Klassifikation</li>
        <li>Risikobewertung</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBT() {
      const pA = parseFloat((document.getElementById('bt-pa') as HTMLInputElement).value) || 0;
      const pBA = parseFloat((document.getElementById('bt-pba') as HTMLInputElement).value) || 0;
      const pBnA = parseFloat((document.getElementById('bt-pbna') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toFixed(6).replace('.', ',');
      const pct = (v: number) => (v * 100).toFixed(2).replace('.', ',') + '%';
      const pNotA = 1 - pA;
      const pB = pBA * pA + pBnA * pNotA;
      let pAB = 0;
      if (pB > 0) { pAB = (pBA * pA) / pB; }
      const pNotAB = 1 - pAB;
      const updateFactor = pA > 0 ? pAB / pA : 0;
      document.getElementById('bt-result')!.textContent = fmt(pAB);
      document.getElementById('bt-pb')!.textContent = fmt(pB);
      document.getElementById('bt-pnab')!.textContent = fmt(pNotAB);
      document.getElementById('bt-prior')!.textContent = fmt(pA);
      document.getElementById('bt-factor')!.textContent = updateFactor.toFixed(2).replace('.', ',') + 'x';
      let steps = `1. P(B) = P(B|A)\u00d7P(A) + P(B|\u00acA)\u00d7P(\u00acA)\n`;
      steps += `       = ${pBA}\u00d7${pA} + ${pBnA}\u00d7${pNotA.toFixed(4)}\n`;
      steps += `       = ${fmt(pBA * pA)} + ${fmt(pBnA * pNotA)}\n`;
      steps += `       = ${fmt(pB)}\n\n`;
      steps += `2. P(A|B) = P(B|A)\u00d7P(A) / P(B)\n`;
      steps += `          = ${pBA}\u00d7${pA} / ${fmt(pB)}\n`;
      steps += `          = ${fmt(pBA * pA)} / ${fmt(pB)}\n`;
      steps += `          = ${fmt(pAB)}`;
      document.getElementById('bt-steps')!.textContent = steps;
      let interpret = `Ausgehend von einer A-priori-Wahrscheinlichkeit von ${pct(pA)}, `;
      interpret += `aktualisiert sich die A-posteriori-Wahrscheinlichkeit nach Beobachtung von Ereignis B auf ${pct(pAB)}. `;
      if (pAB > pA) {
        interpret += `Dies ist eine ${updateFactor.toFixed(1).replace('.', ',')}fache Erh\u00f6hung gegen\u00fcber dem A-priori-Wert, was bedeutet, dass die Evidenz Hypothese A stark st\u00fctzt.`;
      } else if (pAB < pA) {
        interpret += `Der A-posteriori-Wert ist niedriger als der A-priori-Wert, was bedeutet, dass die Evidenz Hypothese A tats\u00e4chlich schw\u00e4cht.`;
      } else {
        interpret += `Der A-posteriori-Wert entspricht dem A-priori-Wert, was bedeutet, dass die Evidenz keine Auswirkung auf Hypothese A hat.`;
      }
      document.getElementById('bt-interpret')!.textContent = interpret;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bt-in').forEach(el => { el.addEventListener('input', calcBT); el.addEventListener('change', calcBT); });
      calcBT();
    }, 50);
  </script>
</CalculatorLayout>
