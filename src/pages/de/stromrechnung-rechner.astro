---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Stromrechnung-Rechner - Monatliche & jährliche Stromkosten";
const description = "Berechnen Sie Ihre Stromrechnung basierend auf Verbrauch, Grundgebühr und Arbeitspreis. Mit Vergleich zum Durchschnitt und Spartipps.";

const relatedCalcs = [
  { name: "Stromkosten-Rechner", url: "/de/stromkosten-rechner", description: "Gesamtstromkosten." },
  { name: "Elektrokosten-Rechner", url: "/de/elektrokosten-rechner", description: "Gerätekosten." },
  { name: "Elektrofahrzeug-Rechner", url: "/de/elektrofahrzeug-rechner", description: "E-Auto Kosten." },
  { name: "Energieeffizienz-Rechner", url: "/de/energieeffizienz-rechner", description: "Effizienz." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Stromrechnung-Rechner" lang="de" enSlug="electricity-bill-calculator" keywords="stromrechnung rechner, stromkosten berechnen, monatsabschlag, jahresverbrauch, strom abrechnung" breadcrumbs={[{ name: "Stromrechnung-Rechner", url: "/de/stromrechnung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stromrechnung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihre Stromrechnung anhand von Verbrauch, Grundgeb&uuml;hr und Arbeitspreis.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Jahresverbrauch (kWh)</label><input type="number" id="stb-kwh" class="stb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Arbeitspreis (&euro;ct/kWh)</label><input type="number" id="stb-rate" class="stb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Grundgeb&uuml;hr (&euro;/Monat)</label><input type="number" id="stb-base" class="stb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Haushaltsgr&ouml;&szlig;e</label><select id="stb-size" class="stb-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="1">1 Person</option><option value="2">2 Personen</option><option value="3">3 Personen</option><option value="4">4 Personen</option><option value="5">5+ Personen</option></select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jahreskosten gesamt</div>
          <div class="text-5xl font-extrabold font-mono" id="stb-result">0,00 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatlicher Abschlag</div><div class="text-xl font-bold" id="stb-monthly">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbrauchskosten/Jahr</div><div class="text-xl font-bold" id="stb-usage">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundgeb&uuml;hr/Jahr</div><div class="text-xl font-bold" id="stb-baseyear">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vs. Durchschnitt</div><div class="text-xl font-bold" id="stb-compare">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="stb-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="electricity-bill-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Stromrechnung verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Verbrauchskosten = Jahresverbrauch &times; Arbeitspreis / 100</p>
        <p>Grundkosten = Grundgeb&uuml;hr &times; 12</p>
        <p>Gesamtkosten = Verbrauchskosten + Grundkosten</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie hoch ist der durchschnittliche Stromverbrauch?</strong> 1 Person ca. 1.500 kWh, 2 Personen ca. 2.500 kWh, 4 Personen ca. 4.000 kWh pro Jahr.</p>
      <p><strong>Was beeinflusst meine Stromrechnung am meisten?</strong> Die gr&ouml;&szlig;ten Verbraucher sind W&auml;rmepumpe/Heizung, Warmwasser, K&uuml;hlger&auml;te und Waschmaschine/Trockner.</p>
      <p><strong>Wie kann ich Strom sparen?</strong> LED-Beleuchtung, energieeffiziente Ger&auml;te (A+++), Standby vermeiden und bewusstes Heizen/K&uuml;hlen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcStb() {
      const kwh = parseFloat((document.getElementById('stb-kwh') as HTMLInputElement).value) || 0;
      const rateCt = parseFloat((document.getElementById('stb-rate') as HTMLInputElement).value) || 0;
      const baseMo = parseFloat((document.getElementById('stb-base') as HTMLInputElement).value) || 0;
      const size = parseInt((document.getElementById('stb-size') as HTMLSelectElement).value) || 1;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const usageCost = kwh * rateCt / 100;
      steps.push('Verbrauchskosten = ' + kwh + ' kWh x ' + fmt(rateCt) + ' ct / 100 = ' + fmt(usageCost) + ' EUR');
      const baseYear = baseMo * 12;
      steps.push('Grundgebuehr = ' + fmt(baseMo) + ' EUR x 12 = ' + fmt(baseYear) + ' EUR');
      const total = usageCost + baseYear;
      steps.push('Gesamt = ' + fmt(usageCost) + ' + ' + fmt(baseYear) + ' = ' + fmt(total) + ' EUR/Jahr');
      const monthly = total / 12;
      steps.push('Monatsabschlag = ' + fmt(total) + ' / 12 = ' + fmt(monthly) + ' EUR');
      const avgKwh: Record<number, number> = { 1: 1500, 2: 2500, 3: 3500, 4: 4000, 5: 5000 };
      const avg = avgKwh[size] || 2500;
      const diff = kwh - avg;
      const pct = avg > 0 ? ((diff / avg) * 100) : 0;
      steps.push('Durchschnitt (' + size + ' Pers.) = ' + avg + ' kWh, Differenz = ' + (diff > 0 ? '+' : '') + diff + ' kWh (' + (pct > 0 ? '+' : '') + fmt(pct) + '%)');
      document.getElementById('stb-result')!.textContent = fmt(total) + ' \u20AC';
      document.getElementById('stb-monthly')!.textContent = fmt(monthly) + ' \u20AC';
      document.getElementById('stb-usage')!.textContent = fmt(usageCost) + ' \u20AC';
      document.getElementById('stb-baseyear')!.textContent = fmt(baseYear) + ' \u20AC';
      document.getElementById('stb-compare')!.textContent = (diff > 0 ? '+' : '') + diff + ' kWh (' + (pct > 0 ? '+' : '') + fmt(pct) + '%)';
      document.getElementById('stb-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('stb-kwh') as HTMLInputElement).value = '3000';
      (document.getElementById('stb-rate') as HTMLInputElement).value = '30';
      (document.getElementById('stb-base') as HTMLInputElement).value = '10';
      document.querySelectorAll('.stb-in').forEach(el => { el.addEventListener('input', calcStb); el.addEventListener('change', calcStb); });
      calcStb();
    }, 50);
  </script>
</CalculatorLayout>
