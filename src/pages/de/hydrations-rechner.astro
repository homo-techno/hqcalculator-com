---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Hydrations-Rechner - Täglicher Wasserbedarf berechnen";
const description = "Berechnen Sie Ihren täglichen Wasserbedarf basierend auf Gewicht, Aktivitätsniveau, Klima und Koffeinkonsum. Zeigt Liter, Gläser und Flaschen an.";
const relatedCalcs = [
  { name: "Körperwasser-Rechner", url: "/body-water-calculator", description: "Gesamtes Körperwasser." },
  { name: "Kalorienrechner", url: "/calorie-calculator", description: "Täglicher Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/bmi-calculator", description: "Body-Mass-Index." },
  { name: "Natriumaufnahme-Rechner", url: "/sodium-intake-calculator", description: "Tägliches Natrium." },
  { name: "Trainingsvolumen-Rechner", url: "/workout-volume-calculator", description: "Trainingsvolumen." },
  { name: "Fastenrechner", url: "/fasting-calculator", description: "Intermittierendes Fasten." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie viel Wasser sollte ich täglich trinken?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die allgemeine Empfehlung beträgt 35 ml Wasser pro kg Körpergewicht pro Tag. Bei 70 kg wären das 2,45 Liter täglich. Aktivität, Klima und Koffeinkonsum erhöhen den Bedarf." }
    },
    {
      "@type": "Question",
      "name": "Wann bin ich ausreichend hydriert?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ein zuverlässiges Zeichen für ausreichende Hydration ist hellgelber Urin. Dunkler Urin deutet auf Dehydration hin. Auch das Durstgefühl ist ein wichtiger Indikator." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Hydrations-Rechner" lang="de" keywords="hydrations rechner, wasserbedarf, tägliches wasser, gläser wasser, dehydration, flüssigkeitsbedarf" breadcrumbs={[{ name: "Hydrations-Rechner", url: "/de/hydrations-rechner" }]} enSlug="hydration-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hydrations-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren persönlichen täglichen Wasserbedarf.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="hd-wt" class="hd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70" min="20" max="250" step="0.5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktivitätsniveau</label>
            <select id="hd-act" class="hd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1.0">Sitzend (Büroarbeit)</option>
              <option value="1.2" selected>Leicht aktiv</option>
              <option value="1.4">Mäßig aktiv</option>
              <option value="1.6">Sehr aktiv</option>
              <option value="1.8">Athlet / schwere Arbeit</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Klima</label>
            <select id="hd-clim" class="hd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1.0" selected>Gemäßigt</option>
              <option value="1.1">Warm</option>
              <option value="1.2">Heiß / feucht</option>
              <option value="1.15">Trocken / arid</option>
              <option value="1.05">Kalt</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Koffein (Tassen/Tag)</label><input type="number" id="hd-caf" class="hd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" max="20" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Wasserbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="hd-liters">0</div>
          <div class="text-sm text-blue-200 mt-1">Liter</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Milliliter</div><div class="text-xl font-bold" id="hd-ml">0 ml</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gläser (250 ml)</div><div class="text-xl font-bold" id="hd-glass">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flaschen (500 ml)</div><div class="text-xl font-bold" id="hd-bottles">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Anpassungsfaktoren</h3>
          <div class="space-y-1 text-sm" id="hd-factors"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Hydrations-Tipps</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Morgens</span><span class="font-bold">500 ml nach dem Aufwachen</span></div>
            <div class="flex justify-between"><span>Mahlzeiten</span><span class="font-bold">250 ml zu jeder Mahlzeit</span></div>
            <div class="flex justify-between"><span>Sport</span><span class="font-bold">500 ml pro Stunde</span></div>
            <div class="flex justify-between"><span>Urinfarbe</span><span class="font-bold">Hellgelb = gut hydriert</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="hydration-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Täglicher Wasserbedarf</h2>
      <p>Eine allgemeine Richtlinie ist 35 ml Wasser pro kg Körpergewicht pro Tag, angepasst für Aktivität, Klima und Koffeinkonsum. Koffein ist ein milder Harntreiber, sodass jede Tasse Kaffee/Tee etwa 120 ml extra Wasser erfordert. Aktive Menschen und solche in heißen Klimazonen benötigen deutlich mehr Flüssigkeit.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie viel Wasser sollte ich täglich trinken?</h4>
      <p>Die allgemeine Empfehlung beträgt 35 ml Wasser pro kg Körpergewicht pro Tag. Bei 70 kg wären das 2,45 Liter täglich.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Wann bin ich ausreichend hydriert?</h4>
      <p>Ein zuverlässiges Zeichen für ausreichende Hydration ist hellgelber Urin. Dunkler Urin deutet auf Dehydration hin.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcHD() {
      const wt = parseFloat((document.getElementById('hd-wt') as HTMLInputElement).value) || 70;
      const act = parseFloat((document.getElementById('hd-act') as HTMLSelectElement).value) || 1.2;
      const clim = parseFloat((document.getElementById('hd-clim') as HTMLSelectElement).value) || 1.0;
      const caf = parseInt((document.getElementById('hd-caf') as HTMLInputElement).value) || 0;
      const baseML = wt * 35;
      const adjustedML = baseML * act * clim + caf * 120;
      const liters = adjustedML / 1000;
      const ml = Math.round(adjustedML);
      const glasses = ml / 250;
      const bottles = liters / 0.5;
      document.getElementById('hd-liters')!.textContent = liters.toFixed(1);
      document.getElementById('hd-ml')!.textContent = ml.toLocaleString('de-DE') + ' ml';
      document.getElementById('hd-glass')!.textContent = Math.round(glasses).toString();
      document.getElementById('hd-bottles')!.textContent = Math.round(bottles).toString();
      const factors: string[] = [];
      factors.push('<div class="flex justify-between"><span>Basis (35 ml/kg)</span><span class="font-bold">' + (baseML / 1000).toFixed(1) + ' L</span></div>');
      if (act > 1.0) factors.push('<div class="flex justify-between"><span>Aktivit\u00e4t (+' + ((act - 1) * 100).toFixed(0) + '%)</span><span class="font-bold">+' + ((baseML * (act - 1)) / 1000).toFixed(1) + ' L</span></div>');
      if (clim > 1.0) factors.push('<div class="flex justify-between"><span>Klima (+' + ((clim - 1) * 100).toFixed(0) + '%)</span><span class="font-bold">+' + ((baseML * act * (clim - 1)) / 1000).toFixed(1) + ' L</span></div>');
      if (caf > 0) factors.push('<div class="flex justify-between"><span>Koffein (' + caf + ' Tassen)</span><span class="font-bold">+' + ((caf * 120) / 1000).toFixed(1) + ' L</span></div>');
      document.getElementById('hd-factors')!.innerHTML = factors.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hd-in').forEach(el => { el.addEventListener('input', calcHD); el.addEventListener('change', calcHD); });
      calcHD();
    }, 50);
  </script>
</CalculatorLayout>
