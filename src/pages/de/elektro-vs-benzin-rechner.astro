---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Elektro-vs-Benzin-Rechner - Gesamtkostenvergleich";
const description = "Vergleichen Sie die Gesamtkosten eines Elektrofahrzeugs mit einem Verbrenner: Kaufpreis, Energie, Wartung und Wertverlust.";

const relatedCalcs = [
  { name: "Elektroauto-Laden-Rechner", url: "/de/elektroauto-laden-rechner", description: "Ladekosten." },
  { name: "Spritkosten-Rechner", url: "/de/spritkosten-rechner", description: "Kraftstoffkosten." },
  { name: "CO2-Rechner", url: "/de/co2-rechner", description: "CO2-Emissionen." },
  { name: "Solarpanel-Rechner", url: "/de/solarpanel-rechner", description: "Solar-ROI." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Elektro-vs-Benzin-Rechner" lang="de" enSlug="ev-vs-gas-calculator" keywords="elektroauto vergleich, e-auto vs verbrenner, gesamtkosten elektroauto, tco vergleich, elektroauto einsparung" breadcrumbs={[{ name: "Elektro-vs-Benzin-Rechner", url: "/de/elektro-vs-benzin-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Elektro-vs-Benzin-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie die Gesamtkosten von Elektro- und Benzinfahrzeugen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Fahrprofil</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Fahrleistung (km)</label><input type="number" id="evb-km" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15000" min="1000" max="80000" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Haltedauer (Jahre)</label><input type="number" id="evb-years" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="1" max="20" step="1"></div>
        </div>
        <h3 class="font-semibold text-text">Elektrofahrzeug</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">E-Auto Kaufpreis (&euro;)</label><input type="number" id="evb-evprice" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40000" min="15000" max="120000" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">F&ouml;rderung/Pr&auml;mie (&euro;)</label><input type="number" id="evb-credit" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="12000" step="500"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (kWh/100km)</label><input type="number" id="evb-eff" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="10" max="35" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (&euro;/kWh)</label><input type="number" id="evb-elec" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.35" min="0.01" max="0.80" step="0.01"></div>
        </div>
        <h3 class="font-semibold text-text">Verbrenner</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verbrenner Kaufpreis (&euro;)</label><input type="number" id="evb-gasprice" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="32000" min="10000" max="100000" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (l/100km)</label><input type="number" id="evb-lper100" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7" min="3" max="20" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Benzinpreis (&euro;/Liter)</label><input type="number" id="evb-gas" class="evb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.80" min="0.50" max="4" step="0.05"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="evb-winner">E-Auto vs Verbrenner</div>
          <div class="text-4xl font-extrabold" id="evb-diff">0 &euro;</div>
          <div class="text-sm text-blue-200 mt-1" id="evb-label">Ersparnis</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">E-Auto Gesamtkosten</div><div class="text-xl font-bold" id="evb-evtotal">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbrenner Gesamtkosten</div><div class="text-xl font-bold" id="evb-gastotal">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">E-Auto Energiekosten/Jahr</div><div class="text-xl font-bold" id="evb-evfuel">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Benzinkosten/Jahr</div><div class="text-xl font-bold" id="evb-gasfuel">0 &euro;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">CO&sub2;-Einsparung &uuml;ber Haltedauer</div>
          <div class="text-2xl font-bold" id="evb-co2">0 Tonnen</div>
        </div>
      </div>
      <ShareButton calculatorId="ev-vs-gas-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">E-Auto vs. Verbrenner: Gesamtkosten</h2>
      <p>Die Gesamtkosten umfassen Kaufpreis, Energie, Wartung und Versicherung. Elektroautos kosten ca. 4-6 Cent pro Kilometer f&uuml;r Energie vs. 10-15 Cent f&uuml;r Benzin. Die Wartungskosten sind 40-50% niedriger.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Ab wann lohnt sich ein E-Auto?</strong> Der Break-even liegt typischerweise bei 3-5 Jahren Haltedauer, abh&auml;ngig von Fahrleistung und Strompreis.</p>
      <p><strong>Wie hoch sind die Wartungskosten?</strong> E-Autos ben&ouml;tigen keinen &Ouml;lwechsel, weniger Bremsenverschlei&szlig; und haben insgesamt weniger Verschlei&szlig;teile.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEVB() {
      const km = parseFloat((document.getElementById('evb-km') as HTMLInputElement).value) || 15000;
      const years = parseFloat((document.getElementById('evb-years') as HTMLInputElement).value) || 8;
      const evPrice = parseFloat((document.getElementById('evb-evprice') as HTMLInputElement).value) || 40000;
      const credit = parseFloat((document.getElementById('evb-credit') as HTMLInputElement).value) || 0;
      const eff = parseFloat((document.getElementById('evb-eff') as HTMLInputElement).value) || 18;
      const elec = parseFloat((document.getElementById('evb-elec') as HTMLInputElement).value) || 0.35;
      const gasCarPrice = parseFloat((document.getElementById('evb-gasprice') as HTMLInputElement).value) || 32000;
      const lper100 = parseFloat((document.getElementById('evb-lper100') as HTMLInputElement).value) || 7;
      const gas = parseFloat((document.getElementById('evb-gas') as HTMLInputElement).value) || 1.80;

      const evFuelYear = km * (eff / 100) * elec;
      const gasFuelYear = km * (lper100 / 100) * gas;
      const evMaintYear = km * 0.03;
      const gasMaintYear = km * 0.06;
      const evNetPrice = evPrice - credit;
      const evTotal = evNetPrice + (evFuelYear + evMaintYear) * years;
      const gasTotal = gasCarPrice + (gasFuelYear + gasMaintYear) * years;
      const diff = Math.abs(evTotal - gasTotal);
      const winner = evTotal < gasTotal ? 'E-Auto spart' : 'Verbrenner spart';
      const co2GasTons = km * years * (lper100 / 100) * 2.37 / 1000;
      const co2EvTons = km * years * (eff / 100) * 0.420 / 1000;
      const co2Saved = co2GasTons - co2EvTons;

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('evb-winner')!.textContent = winner;
      document.getElementById('evb-diff')!.textContent = fmt(diff);
      document.getElementById('evb-label')!.textContent = '\u00FCber ' + years + ' Jahre';
      document.getElementById('evb-evtotal')!.textContent = fmt(evTotal);
      document.getElementById('evb-gastotal')!.textContent = fmt(gasTotal);
      document.getElementById('evb-evfuel')!.textContent = fmt(evFuelYear);
      document.getElementById('evb-gasfuel')!.textContent = fmt(gasFuelYear);
      document.getElementById('evb-co2')!.textContent = co2Saved.toFixed(1).replace('.', ',') + ' Tonnen';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.evb-in').forEach(el => { el.addEventListener('input', calcEVB); el.addEventListener('change', calcEVB); }); calcEVB(); }, 50);
  </script>
</CalculatorLayout>
