---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Veranstaltungsparkplatz-Rechner - Stellpl\u00e4tze berechnen";
const description = "Berechnen Sie den Parkplatzbedarf f\u00fcr Ihre Veranstaltung basierend auf G\u00e4steanzahl, Anreisemix und Veranstaltungsort.";

const relatedCalcs = [
  { name: "Veranstaltungsbudget-Rechner", url: "/de/veranstaltungsbudget-rechner", description: "Eventbudget." },
  { name: "Veranstaltungspersonal-Rechner", url: "/de/veranstaltungspersonal-rechner", description: "Personalbedarf." },
  { name: "Veranstaltungszeitplan-Rechner", url: "/de/veranstaltungszeitplan-rechner", description: "Zeitplanung." },
  { name: "Veranstaltungsversicherung-Rechner", url: "/de/veranstaltungsversicherung-rechner", description: "Versicherung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Veranstaltungsparkplatz-Rechner" lang="de" enSlug="event-parking-calculator" keywords="veranstaltung parkplatz rechner, stellplaetze berechnen, event parken, parkplatzplanung" breadcrumbs={[{ name: "Veranstaltungsparkplatz-Rechner", url: "/de/veranstaltungsparkplatz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Veranstaltungsparkplatz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie, wie viele Parkpl&auml;tze Sie f&uuml;r Ihre Veranstaltung ben&ouml;tigen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl G&auml;ste</label><input type="number" id="vpp-guests" class="vpp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="1" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">G&auml;ste pro Fahrzeug (Durchschnitt)</label><input type="number" id="vpp-percar" class="vpp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.2" min="1" max="6" step="0.1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">G&auml;ste mit Taxi / Rideshare (%)</label><input type="number" id="vpp-rideshare" class="vpp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="100" step="5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">G&auml;ste mit Shuttle / Bus (%)</label><input type="number" id="vpp-shuttle" class="vpp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="100" step="5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Personal- &amp; Dienstleister-Fahrzeuge</label><input type="number" id="vpp-staff" class="vpp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="1"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Parkart</label>
          <select id="vpp-type" class="vpp-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="self">Selbstparken</option>
            <option value="valet">Valet (enger parkbar)</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Stellpl&auml;tze</div>
        <div class="text-5xl font-extrabold" id="vpp-spaces">--</div>
        <div class="text-sm mt-1" id="vpp-note">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gast-Fahrzeuge</div><div class="text-xl font-bold" id="vpp-guestveh">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Parkfl&auml;che (m&sup2;)</div><div class="text-xl font-bold" id="vpp-lotsqm">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Behindertenparkpl&auml;tze</div><div class="text-xl font-bold" id="vpp-accessible">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spitzen-Ankunft Autos/Std</div><div class="text-xl font-bold" id="vpp-peak">--</div></div>
      </div>

      <ShareButton calculatorId="event-parking-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Parkplatzplanung f&uuml;r Veranstaltungen</h2>
      <p>Durchschnittlich kommen 2-2,5 Personen pro Auto zu Events. Ein Standard-Stellplatz ben&ouml;tigt ca. 12,5 m&sup2; plus Fahrgasse. Valet-Parken kann 30-40% mehr Autos unterbringen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viele Behindertenparkpl&auml;tze brauche ich?</strong> In Deutschland sind je nach Gesamtanzahl der Stellpl&auml;tze 3-5% als barrierefreie Parkpl&auml;tze vorgeschrieben.</p>
      <p><strong>Sollte ich einen Shuttle-Service anbieten?</strong> Ab 200 G&auml;sten oder bei begrenztem Parkraum ist ein Shuttle-Service empfehlenswert.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcVPP() {
      const guests = parseInt((document.getElementById('vpp-guests') as HTMLInputElement).value) || 1;
      const perCar = parseFloat((document.getElementById('vpp-percar') as HTMLInputElement).value) || 2.2;
      const rideshare = parseFloat((document.getElementById('vpp-rideshare') as HTMLInputElement).value) || 0;
      const shuttle = parseFloat((document.getElementById('vpp-shuttle') as HTMLInputElement).value) || 0;
      const staffVeh = parseInt((document.getElementById('vpp-staff') as HTMLInputElement).value) || 0;
      const parkType = (document.getElementById('vpp-type') as HTMLSelectElement).value;

      const drivingPct = Math.max(0, 100 - rideshare - shuttle) / 100;
      const guestVehicles = Math.ceil(guests * drivingPct / perCar);
      const totalSpaces = guestVehicles + staffVeh;

      const sqmPerSpace = parkType === 'valet' ? 12 : 16.7;
      const lotSqm = Math.round(totalSpaces * sqmPerSpace);

      let accessibleSpaces = Math.max(1, Math.ceil(totalSpaces * 0.035));

      const peakCarsPerHr = Math.ceil(guestVehicles * 0.6);

      document.getElementById('vpp-spaces')!.textContent = totalSpaces.toLocaleString('de-DE');
      document.getElementById('vpp-note')!.textContent = guestVehicles + ' Gast + ' + staffVeh + ' Personal/Dienstleister';
      document.getElementById('vpp-guestveh')!.textContent = guestVehicles.toString();
      document.getElementById('vpp-lotsqm')!.textContent = lotSqm.toLocaleString('de-DE');
      document.getElementById('vpp-accessible')!.textContent = accessibleSpaces + ' Pl\u00E4tze';
      document.getElementById('vpp-peak')!.textContent = peakCarsPerHr.toString();

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vpp-in').forEach(el => { el.addEventListener('input', calcVPP); el.addEventListener('change', calcVPP); });
      calcVPP();
    }, 50);
  </script>
</CalculatorLayout>
