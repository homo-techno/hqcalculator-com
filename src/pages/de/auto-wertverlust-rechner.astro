---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Auto-Wertverlust-Rechner - Fahrzeugwert \u00fcber Zeit";
const description = "Berechnen Sie, wie viel Ihr Auto im Laufe der Zeit an Wert verliert. Sehen Sie den j\u00e4hrlichen Wertverlauf und finden Sie den besten Verkaufszeitpunkt.";
const relatedCalcs = [
  { name: "Kfz-Versicherung", url: "/de/kfz-versicherung-rechner", description: "Versicherung." },
  { name: "Auto-Leasing", url: "/de/auto-leasing-rechner", description: "Leasing." },
  { name: "Autorate", url: "/de/autorate-rechner", description: "Autofinanzierung." },
  { name: "Kapitalertragssteuer", url: "/de/kapitalertragssteuer-rechner", description: "Kapitalertr\u00e4ge." },
  { name: "Kapitalisierungsrate", url: "/de/kapitalisierungsrate-rechner", description: "Cap Rate." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlage." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Auto-Wertverlust-Rechner" lang="de" enSlug="car-depreciation-calculator" keywords="auto wertverlust rechner, fahrzeug wert, auto wert zeit, restwert, wertminderung" breadcrumbs={[{ name: "Auto-Wertverlust", url: "/de/auto-wertverlust-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Auto-Wertverlust-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sehen Sie, wie der Wert Ihres Autos Jahr f&uuml;r Jahr sinkt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Kaufpreis</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="aw-price" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="35000" min="0" step="1000">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fahrzeugtyp</label>
            <select id="aw-type" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="sedan">Limousine / PKW</option>
              <option value="suv" selected>SUV / Crossover</option>
              <option value="truck">Transporter</option>
              <option value="luxury">Luxusfahrzeug</option>
              <option value="ev">Elektrofahrzeug</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jahre prognostizieren</label>
            <input type="number" id="aw-years" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="1" max="20" step="1">
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wert nach 5 Jahren</div>
            <div class="text-5xl font-extrabold" id="aw-val5">0 &euro;</div>
            <div class="text-sm text-blue-200 mt-1" id="aw-lost5">0 &euro; Wertverlust</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Nach 1 Jahr</div>
              <div class="text-xl font-bold" id="aw-val1">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Nach 3 Jahren</div>
              <div class="text-xl font-bold" id="aw-val3">0 &euro;</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">J&auml;hrlicher Wertverlauf</h3>
            <div class="space-y-1 text-sm" id="aw-table"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="car-depreciation" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie Autos an Wert verlieren</h2>
      <p>Im Durchschnitt verliert ein Neuwagen im ersten Jahr 20-25% seines Wertes, dann ca. 15% pro Jahr f&uuml;r die folgenden Jahre. Nach 5 Jahren sind die meisten Autos noch 35-40% des Neupreises wert.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const depRates: Record<string, number[]> = {
      sedan: [0.23, 0.15, 0.13, 0.12, 0.11, 0.09, 0.08, 0.07, 0.06, 0.05],
      suv: [0.20, 0.14, 0.12, 0.11, 0.10, 0.08, 0.07, 0.06, 0.05, 0.05],
      truck: [0.18, 0.12, 0.11, 0.10, 0.09, 0.08, 0.07, 0.06, 0.05, 0.05],
      luxury: [0.27, 0.18, 0.15, 0.13, 0.12, 0.10, 0.09, 0.08, 0.07, 0.06],
      ev: [0.25, 0.16, 0.14, 0.12, 0.10, 0.09, 0.08, 0.07, 0.06, 0.05],
    };

    function calcAW() {
      const price = parseFloat((document.getElementById('aw-price') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('aw-type') as HTMLSelectElement).value;
      const years = parseInt((document.getElementById('aw-years') as HTMLInputElement).value) || 10;
      const rates = depRates[type] || depRates.sedan;
      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

      let value = price;
      const rows: string[] = [];
      rows.push('<div class="grid grid-cols-4 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Jahr</span><span>Wert</span><span>Verlust</span><span>Restwert</span></div>');

      let val1 = 0, val3 = 0, val5 = 0;

      for (let y = 1; y <= years; y++) {
        const rate = rates[Math.min(y - 1, rates.length - 1)];
        const lost = value * rate;
        value -= lost;
        const retained = price > 0 ? (value / price * 100) : 0;

        if (y === 1) val1 = value;
        if (y === 3) val3 = value;
        if (y === 5) val5 = value;

        rows.push('<div class="grid grid-cols-4 gap-1 text-xs ' + (y === 5 ? 'font-bold text-primary bg-blue-50 rounded p-1' : '') + '"><span>' + y + '</span><span>' + fmt(value) + '</span><span>-' + fmt(lost) + '</span><span>' + retained.toFixed(0) + '%</span></div>');
      }

      document.getElementById('aw-val5')!.textContent = fmt(val5);
      document.getElementById('aw-lost5')!.textContent = fmt(price - val5) + ' Wertverlust';
      document.getElementById('aw-val1')!.textContent = fmt(val1);
      document.getElementById('aw-val3')!.textContent = fmt(val3);
      document.getElementById('aw-table')!.innerHTML = rows.join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['aw-price', 'aw-years'].forEach(id => document.getElementById(id)!.addEventListener('input', calcAW));
      document.getElementById('aw-type')!.addEventListener('change', calcAW);
      calcAW();
    }, 50);
  </script>
</CalculatorLayout>
