---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gutschein-Guthaben-Rechner - Restbetrag verwalten";
const description = "Gutscheinguthaben verfolgen, Restwert nach Eink\u00E4ufen berechnen und mehrere Karten verwalten.";
const relatedCalcs = [
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
  { name: "Rabattrechner", url: "/de/rabattrechner", description: "Rabattberechnung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gutschein-Guthaben-Rechner" lang="de" enSlug="gift-card-balance-calculator" keywords="gutschein guthaben rechner, gutscheinkarte restbetrag, gutschein tracker, restwert, gutschein guthaben" breadcrumbs={[{ name: "Gutschein-Guthaben", url: "/de/gutschein-guthaben-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gutschein-Guthaben-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Gutscheinguthaben und Restwert verfolgen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Urspr&uuml;nglicher Betrag (&euro;)</label><input type="number" id="ggb-orig" class="ggb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="50" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bereits ausgegeben (&euro;)</label><input type="number" id="ggb-spent" class="ggb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="17.50" min="0" step="0.01"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Geplanter Kauf (&euro;)</label><input type="number" id="ggb-next" class="ggb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="0.01"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Verbleibendes Guthaben</div>
          <div class="text-5xl font-extrabold font-mono" id="ggb-result">0,00 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbraucht</div><div class="text-xl font-bold font-mono" id="ggb-used">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">% verbleibend</div><div class="text-xl font-bold font-mono" id="ggb-pct">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nach Kauf</div><div class="text-xl font-bold font-mono" id="ggb-after">0 &euro;</div></div>
        </div>
        <div class="p-4 rounded-xl text-center" id="ggb-status-box">
          <div class="font-bold text-sm" id="ggb-status">-</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gift-card-balance" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gutscheine clever nutzen</h2>
      <p>Gutscheinkarten haben oft ein Ablaufdatum &ndash; pr&uuml;fen Sie die G&uuml;ltigkeitsdauer. Kleine Restbetr&auml;ge werden manchmal bar ausgezahlt (abh&auml;ngig vom Bundesland). Bewahren Sie die Gutscheinkarte bis zur vollst&auml;ndigen Einl&ouml;sung auf.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>K&ouml;nnen Gutscheine verfallen?</strong> In Deutschland d&uuml;rfen Gutscheine in der Regel 3 Jahre nicht verfallen (gesetzliche Verj&auml;hrungsfrist). L&auml;ngere Laufzeiten sind vom Aussteller festzulegen.</p>
      <p><strong>Was tun mit kleinem Restbetrag?</strong> Viele H&auml;ndler zahlen Restbetr&auml;ge unter 1-5 &euro; auf Wunsch bar aus oder kombinieren Sie den Gutschein mit einem anderen Zahlungsmittel.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGGB() {
      const orig = parseFloat((document.getElementById('ggb-orig') as HTMLInputElement).value) || 0;
      const spent = parseFloat((document.getElementById('ggb-spent') as HTMLInputElement).value) || 0;
      const next = parseFloat((document.getElementById('ggb-next') as HTMLInputElement).value) || 0;
      const remaining = Math.max(0, orig - spent);
      const afterPurchase = Math.max(0, remaining - next);
      const pct = orig > 0 ? (remaining / orig) * 100 : 0;
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('ggb-result')!.textContent = fmtEur(remaining);
      document.getElementById('ggb-used')!.textContent = fmtEur(spent);
      document.getElementById('ggb-pct')!.textContent = pct.toFixed(0) + '%';
      document.getElementById('ggb-after')!.textContent = fmtEur(afterPurchase);
      let status: string, color: string;
      if (next > remaining) {
        status = 'Nicht gen\u00FCgend Guthaben! Fehlender Betrag: ' + fmtEur(next - remaining);
        color = 'bg-red-50 text-red-800';
      } else if (remaining === 0) {
        status = 'Gutschein aufgebraucht';
        color = 'bg-gray-50 text-gray-800';
      } else if (pct < 10) {
        status = 'Fast leer \u2013 bald einl\u00F6sen!';
        color = 'bg-yellow-50 text-yellow-800';
      } else {
        status = fmtEur(remaining) + ' verf\u00FCgbar';
        color = 'bg-green-50 text-green-800';
      }
      document.getElementById('ggb-status')!.textContent = status;
      document.getElementById('ggb-status-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ggb-in').forEach(el => { el.addEventListener('input', calcGGB); el.addEventListener('change', calcGGB); });
      calcGGB();
    }, 50);
  </script>
</CalculatorLayout>
