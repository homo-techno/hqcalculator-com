---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blutalkohol-Zeitverlauf - BAK über die Zeit berechnen";
const description = "Sehen Sie, wie sich Ihre Blutalkoholkonzentration nach dem Trinken über die Zeit verändert. Schätzen Sie, wann Sie wieder nüchtern sind.";
const relatedCalcs = [
  { name: "Promillerechner", url: "/de/promille-rechner", description: "BAK." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorien." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "BMI." },
  { name: "Wasserbedarfsrechner", url: "/de/wasserbedarf-rechner", description: "Wasser." },
  { name: "Schlafrechner", url: "/de/schlaf-rechner", description: "Schlaf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Blutalkohol-Zeitverlauf" lang="de" keywords="BAK zeitverlauf, blutalkohol über zeit, nüchtern rechner, BAK abbau, wann nüchtern" breadcrumbs={[{ name: "BAK-Zeitverlauf", url: "/de/blutalkohol-zeitverlauf" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blutalkohol-Zeitverlauf</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Verfolgen Sie Ihre geschätzte BAK über die Zeit und wann Sie 0,00 Promille erreichen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="bat-wt" class="bat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="77" min="40" max="200" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Geschlecht</label><select id="bat-gen" class="bat-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="male">Männlich</option><option value="female">Weiblich</option></select></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Getränke</label><input type="number" id="bat-drinks" class="bat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">ml pro Getränk</label><input type="number" id="bat-oz" class="bat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="330" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Alkohol (%)</label><input type="number" id="bat-abv" class="bat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="100" step="0.5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Trinkdauer (Stunden)</label><input type="number" id="bat-dur" class="bat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0.5" max="12" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Spitzen-BAK</div>
          <div class="text-5xl font-extrabold font-mono" id="bat-peak">0,000 ‰</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeit bis nüchtern</div><div class="text-xl font-bold" id="bat-sober">0 Std</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bei 0,5 ‰ (Grenzwert)</div><div class="text-xl font-bold" id="bat-legal">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktueller Zustand</div><div class="text-xl font-bold" id="bat-level">-</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">BAK-Zeitverlauf (stündlich)</h3>
          <div class="space-y-1 text-sm font-mono" id="bat-timeline"></div>
        </div>
      </div>
      <ShareButton calculatorId="bac-timeline" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBAT() {
      const wtKg = parseFloat((document.getElementById('bat-wt') as HTMLInputElement).value) || 77;
      const gen = (document.getElementById('bat-gen') as HTMLSelectElement).value;
      const drinks = parseInt((document.getElementById('bat-drinks') as HTMLInputElement).value) || 1;
      const ml = parseFloat((document.getElementById('bat-oz') as HTMLInputElement).value) || 330;
      const abv = (parseFloat((document.getElementById('bat-abv') as HTMLInputElement).value) || 5) / 100;
      const dur = parseFloat((document.getElementById('bat-dur') as HTMLInputElement).value) || 1;
      const r = gen === 'male' ? 0.68 : 0.55;
      const elimRate = 0.15; // Promille per hour
      const totalAlcoholGrams = drinks * ml * abv * 0.789;
      const peakBAK = (totalAlcoholGrams / (wtKg * r)) - elimRate * dur;
      const adjustedPeak = Math.max(0, peakBAK);
      document.getElementById('bat-peak')!.textContent = adjustedPeak.toFixed(3).replace('.', ',') + ' \u2030';
      const hoursToSober = adjustedPeak / elimRate;
      document.getElementById('bat-sober')!.textContent = hoursToSober.toFixed(1).replace('.', ',') + ' Std';
      const hoursToLegal = adjustedPeak > 0.5 ? (adjustedPeak - 0.5) / elimRate : 0;
      document.getElementById('bat-legal')!.textContent = adjustedPeak > 0.5 ? hoursToLegal.toFixed(1).replace('.', ',') + ' Std nach Spitze' : 'Unter Grenzwert';
      let level = 'Nüchtern';
      if (adjustedPeak >= 3.0) level = 'Lebensbedrohlich';
      else if (adjustedPeak >= 2.0) level = 'Stark beeinträchtigt';
      else if (adjustedPeak >= 0.5) level = 'Fahruntüchtig';
      else if (adjustedPeak >= 0.3) level = 'Leicht beeinträchtigt';
      else if (adjustedPeak > 0) level = 'Minimale Wirkung';
      document.getElementById('bat-level')!.textContent = level;
      const timeline: string[] = [];
      for (let h = 0; h <= Math.ceil(hoursToSober) + 1; h++) {
        const bac = Math.max(0, adjustedPeak - elimRate * h);
        const bar = '\u2588'.repeat(Math.round(bac * 20));
        const legalMark = bac <= 0.5 && adjustedPeak > 0.5 && h > 0 ? ' \u2713 fahrfähig' : '';
        timeline.push(`${String(h).padStart(2, ' ')} Std: ${bac.toFixed(3).replace('.', ',')} \u2030 ${bar}${legalMark}`);
        if (bac <= 0) break;
      }
      document.getElementById('bat-timeline')!.innerHTML = timeline.map(t => `<div>${t}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.bat-in').forEach(el => { el.addEventListener('input', calcBAT); el.addEventListener('change', calcBAT); }); calcBAT(); }, 50);
  </script>
</CalculatorLayout>
