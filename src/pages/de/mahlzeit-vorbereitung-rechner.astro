---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Meal-Prep Rechner - Zutatenmengen und Kalorien für Mahlzeitvorbereitung";
const description = "Berechnen Sie Zutatenmengen und Kalorien für wöchentliche Mahlzeitvorbereitung. Meal-Prep Planung für 1–10 Personen mit Makronährstoff-Übersicht.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglichen Kalorienbedarf." },
  { name: "Fleisch Garzeit Rechner", url: "/de/fleisch-garzeit-rechner", description: "Garzeiten für Fleisch." },
  { name: "Makro-Rechner", url: "/de/makro-rechner", description: "Makronährstoffe berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="meal-prep-calculator" calculatorName="Meal-Prep Rechner" keywords="Meal Prep Rechner, Mahlzeitvorbereitung, Wochenplanung Essen, Kalorien Vorbereitung, Zutatenmengen berechnen" breadcrumbs={[{ name: "Meal-Prep Rechner", url: "/de/mahlzeit-vorbereitung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Meal-Prep Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre wöchentliche Mahlzeitvorbereitung: Zutatenmengen, Kalorien und Makronährstoffe für mehrere Personen und Tage.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Personen</label><input type="number" id="mp-persons" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="20"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Mahlzeiten/Tag</label><input type="number" id="mp-meals" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="6"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Vorbereitungstage</label><input type="number" id="mp-days" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="7"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Ernährungsziel</label>
          <select id="mp-goal" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="maintain" selected>Gewicht halten (2000 kcal/Person/Tag)</option>
            <option value="lose">Abnehmen (1600 kcal/Person/Tag)</option>
            <option value="gain">Zunehmen (2500 kcal/Person/Tag)</option>
            <option value="sport">Sport/Aufbau (2800 kcal/Person/Tag)</option>
          </select>
        </div>
        <h3 class="font-semibold text-sm text-text">Zutaten pro Mahlzeit (Rohgewicht, g/Person)</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Protein (Fleisch/Fisch/Tofu)</label><input type="number" id="mp-prot" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kohlenhydrate (Reis/Nudeln)</label><input type="number" id="mp-carb" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="0" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gemüse (g)</label><input type="number" id="mp-veg" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Öl/Fette (g)</label><input type="number" id="mp-fat" class="mp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkalorien (Woche)</div>
          <div class="text-5xl font-extrabold font-mono" id="mp-total-kcal">--</div>
          <div class="text-sm text-blue-200 mt-1" id="mp-per-day">-- kcal / Person / Tag</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Protein gesamt</div><div class="text-xl font-bold" id="mp-total-prot">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kohlenhydrate gesamt</div><div class="text-xl font-bold" id="mp-total-carb">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gemüse gesamt</div><div class="text-xl font-bold" id="mp-total-veg">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mahlzeiten gesamt</div><div class="text-xl font-bold" id="mp-total-meals">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="meal-prep" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Meal Prep – Mahlzeitvorbereitung effizient planen</h2>
      <p>Meal Prep (Mahlzeitvorbereitung) ist eine effektive Methode, um gesund und kosteneffizient zu essen. Durch die gesammelte Zubereitung mehrerer Mahlzeiten spart man Zeit und vermeidet spontane, weniger gesunde Lebensmittelentscheidungen. Typischerweise werden Mahlzeiten für 3–5 Tage vorbereitet und im Kühlschrank oder Gefrierschrank gelagert. Eine gute Planung berücksichtigt Kalorien, Makronährstoffe und Vielfalt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange hält sich Meal Prep im Kühlschrank?</strong> Fertig zubereitete Mahlzeiten halten sich im Kühlschrank in der Regel 3–5 Tage. Im Gefrierschrank sind sie bis zu 3 Monate haltbar.</p>
      <p><strong>Was eignet sich gut für Meal Prep?</strong> Gekochte Getreide (Reis, Quinoa), gegarte Proteine (Hühnchen, Hackfleisch, Tofu) und vorbereitete Gemüsemischungen eignen sich besonders gut.</p>
      <p><strong>Wie viel g Protein pro Mahlzeit ist empfohlen?</strong> Für Muskelaufbau empfiehlt man 1,6–2,2 g Protein pro kg Körpergewicht täglich. Pro Mahlzeit sind 30–40 g Protein ideal.</p>
      <p><strong>Welche Behälter eignen sich für Meal Prep?</strong> Glasbehälter mit Deckel sind hygienisch und mikrowellengeeignet. Lebensmittelechte Kunststoffboxen sind leichter und günstiger.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const mpKcalGoal: Record<string, number> = { maintain: 2000, lose: 1600, gain: 2500, sport: 2800 };
    function calcMP() {
      const persons = parseInt((document.getElementById('mp-persons') as HTMLInputElement).value) || 1;
      const meals = parseInt((document.getElementById('mp-meals') as HTMLInputElement).value) || 3;
      const days = parseInt((document.getElementById('mp-days') as HTMLInputElement).value) || 5;
      const goal = (document.getElementById('mp-goal') as HTMLSelectElement).value;
      const protG = parseFloat((document.getElementById('mp-prot') as HTMLInputElement).value) || 0;
      const carbG = parseFloat((document.getElementById('mp-carb') as HTMLInputElement).value) || 0;
      const vegG = parseFloat((document.getElementById('mp-veg') as HTMLInputElement).value) || 0;
      const fatG = parseFloat((document.getElementById('mp-fat') as HTMLInputElement).value) || 0;
      const totalMeals = persons * meals * days;
      const kcalPerMeal = protG * 0.7 * 1.2 * 4 + carbG * 3.5 + vegG * 0.003 * 1000 * 0.25 + fatG * 9;
      const kcalPerDayPerPerson = kcalPerMeal * meals;
      const totalKcal = Math.round(kcalPerDayPerPerson * days * persons);
      const totalProt = Math.round(protG * 0.7 * totalMeals / 1000);
      const totalCarb = Math.round(carbG * totalMeals / 1000 * 2.5);
      const totalVeg = Math.round(vegG * totalMeals / 1000);
      const targetKcal = mpKcalGoal[goal] || 2000;
      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE');
      document.getElementById('mp-total-kcal')!.textContent = fmt(totalKcal) + ' kcal';
      document.getElementById('mp-per-day')!.textContent = fmt(kcalPerDayPerPerson) + ' kcal / Person / Tag (Ziel: ' + fmt(targetKcal) + ')';
      document.getElementById('mp-total-prot')!.textContent = totalProt + ' kg';
      document.getElementById('mp-total-carb')!.textContent = totalCarb + ' kg';
      document.getElementById('mp-total-veg')!.textContent = totalVeg + ' kg';
      document.getElementById('mp-total-meals')!.textContent = totalMeals + ' Portionen';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mp-in').forEach(el => { el.addEventListener('input', calcMP); el.addEventListener('change', calcMP); });
      calcMP();
    }, 50);
  </script>
</CalculatorLayout>
