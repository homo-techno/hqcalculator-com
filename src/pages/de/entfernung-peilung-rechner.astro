---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Entfernung-Peilung-Rechner - GPS Punkt zu Punkt";
const description = "Berechnen Sie Entfernung und Peilung zwischen zwei GPS-Koordinatenpunkten mit der Haversine-Formel und dem Vorw\u00e4rtsazimut.";

const relatedCalcs = [
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Sinkrate-Rechner", url: "/de/sinkrate-rechner", description: "Sinkflugplanung." },
  { name: "Tauchplanung-Rechner", url: "/de/tauchplanung-rechner", description: "Tauchplanung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Entfernung-Peilung-Rechner" lang="de" enSlug="distance-bearing-calculator" keywords="entfernung peilung rechner, gps entfernung, haversine formel, vorwaertsazimut, koordinaten entfernung" breadcrumbs={[{ name: "Entfernung-Peilung-Rechner", url: "/de/entfernung-peilung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Entfernung &amp; Peilung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie zwei GPS-Punkte (Breiten-/L&auml;ngengrad) ein, um Entfernung und Peilung zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <h3 class="font-semibold text-sm text-text mb-2">Punkt 1 (z.B. Berlin)</h3>
          <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-xs text-text mb-1">Breitengrad</label><input type="number" id="epb-lat1" class="epb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="52.5200" step="0.0001"></div>
            <div><label class="block text-xs text-text mb-1">L&auml;ngengrad</label><input type="number" id="epb-lon1" class="epb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="13.4050" step="0.0001"></div>
          </div>
        </div>
        <div>
          <h3 class="font-semibold text-sm text-text mb-2">Punkt 2 (z.B. M&uuml;nchen)</h3>
          <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-xs text-text mb-1">Breitengrad</label><input type="number" id="epb-lat2" class="epb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="48.1351" step="0.0001"></div>
            <div><label class="block text-xs text-text mb-1">L&auml;ngengrad</label><input type="number" id="epb-lon2" class="epb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="11.5820" step="0.0001"></div>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Entfernung</div>
          <div class="text-4xl font-extrabold font-mono" id="epb-dist">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Vorw&auml;rtspeilung</div>
            <div class="text-xl font-bold" id="epb-bearing">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">R&uuml;ckpeilung</div>
            <div class="text-xl font-bold" id="epb-reverse">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Meilen</div>
            <div class="text-xl font-bold" id="epb-miles">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Seemeilen</div>
            <div class="text-xl font-bold" id="epb-nm">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="distance-bearing-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haversine-Formel</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>a = sin&sup2;(dlat/2) + cos(lat1) &middot; cos(lat2) &middot; sin&sup2;(dlon/2)</p>
        <p>c = 2 &middot; atan2(sqrt(a), sqrt(1-a))</p>
        <p>d = R &middot; c (R = 6.371 km)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die Haversine-Formel?</strong> Sie berechnet die k&uuml;rzeste Entfernung zwischen zwei Punkten auf einer Kugeloberfl&auml;che (Gro&szlig;kreisdistanz).</p>
      <p><strong>Was ist eine Peilung?</strong> Der Winkel im Uhrzeigersinn von Norden zur Richtung des Zielpunkts, gemessen in Grad (0&deg;-360&deg;).</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEPB() {
      const lat1 = parseFloat((document.getElementById('epb-lat1') as HTMLInputElement).value) || 0;
      const lon1 = parseFloat((document.getElementById('epb-lon1') as HTMLInputElement).value) || 0;
      const lat2 = parseFloat((document.getElementById('epb-lat2') as HTMLInputElement).value) || 0;
      const lon2 = parseFloat((document.getElementById('epb-lon2') as HTMLInputElement).value) || 0;
      const R = 6371;
      const toRad = (d: number) => d * Math.PI / 180;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon/2)**2;
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      const km = R * c;
      const miles = km * 0.621371;
      const nm = km * 0.539957;
      const y = Math.sin(dLon) * Math.cos(toRad(lat2));
      const x = Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) - Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(dLon);
      let bearing = Math.atan2(y, x) * 180 / Math.PI;
      bearing = (bearing + 360) % 360;
      let reverse = (bearing + 180) % 360;

      document.getElementById('epb-dist')!.textContent = km.toFixed(2).replace('.', ',') + ' km';
      document.getElementById('epb-bearing')!.textContent = bearing.toFixed(2).replace('.', ',') + '\u00B0';
      document.getElementById('epb-reverse')!.textContent = reverse.toFixed(2).replace('.', ',') + '\u00B0';
      document.getElementById('epb-miles')!.textContent = miles.toFixed(2).replace('.', ',');
      document.getElementById('epb-nm')!.textContent = nm.toFixed(2).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.epb-in').forEach(el => { el.addEventListener('input', calcEPB); el.addEventListener('change', calcEPB); });
      calcEPB();
    }, 50);
  </script>
</CalculatorLayout>
