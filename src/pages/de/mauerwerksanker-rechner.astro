---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Mauerwerksanker Rechner - Ankerlängen und Tragfähigkeiten";
const description = "Berechnen Sie Ankerlängen und Tragfähigkeiten für Mauerwerksverbindungen. Mauerwerksanker nach DIN EN 845 für verschiedene Wanddicken und Belastungen.";
const relatedCalcs = [
  { name: "Mauermörtel Rechner", url: "/de/mauermoertel-rechner", description: "Mörtelmengen berechnen." },
  { name: "Mauerwerksanker Rechner", url: "/de/mauerwerksanker-rechner", description: "Ankertragfähigkeiten." },
  { name: "Metallgewicht Rechner", url: "/de/metallgewicht-rechner", description: "Metallgewicht berechnen." },
  { name: "Betonrechner", url: "/de/betonrechner", description: "Betonmenge berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="masonry-anchor-calculator" calculatorName="Mauerwerksanker Rechner" keywords="Mauerwerksanker Rechner, Ankerlänge, Wandanker DIN EN 845, Tragfähigkeit Mauerwerk, Mauerwerkverbindung" breadcrumbs={[{ name: "Mauerwerksanker Rechner", url: "/de/mauerwerksanker-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mauerwerksanker Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie Ankerlänge, Einbindetiefe und zulässige Tragfähigkeit für Mauerwerksanker gemäß DIN EN 845.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Außenschalendicke (mm)</label><input type="number" id="ma-outer" class="ma-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="115" min="50" max="365" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kerndämmdicke (mm)</label><input type="number" id="ma-insul" class="ma-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="140" min="0" max="400" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Innenschalendicke (mm)</label><input type="number" id="ma-inner" class="ma-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="175" min="50" max="365" step="5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mauerwerksart</label>
            <select id="ma-type" class="ma-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="KS" selected>Kalksandstein</option>
              <option value="ZI">Ziegel</option>
              <option value="PP">Porenbeton</option>
              <option value="BET">Beton</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ankertyp</label>
            <select id="ma-anchor" class="ma-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="flat" selected>Flachanker (Edelstahl)</option>
              <option value="round">Drahtanker (Edelstahl)</option>
              <option value="heavy">Schwerlastanker</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Windlast q (kN/m²)</label><input type="number" id="ma-wind" class="ma-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.5" min="0.1" max="3" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Ankerlänge</div>
          <div class="text-5xl font-extrabold font-mono" id="ma-len">--</div>
          <div class="text-sm text-blue-200 mt-1">mm Gesamtlänge</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einbindetiefe außen</div><div class="text-xl font-bold" id="ma-embed">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ankerdichte</div><div class="text-xl font-bold" id="ma-density">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zul. Zug/Druck</div><div class="text-xl font-bold" id="ma-cap">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mauerwerksanker" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mauerwerksanker nach DIN EN 845</h2>
      <p>Mauerwerksanker verbinden Außen- und Innenschale bei zweischaligem Mauerwerk. Die Anforderungen sind in DIN EN 845-1 geregelt. Die Ankerlänge ergibt sich aus der Gesamtdicke des Wandaufbaus plus der notwendigen Einbindetiefe in beiden Schalen (mind. 50 mm). Die Ankerdichte richtet sich nach Windlastzone und Wandhöhe; typisch sind 5–7 Anker pro m². Alle Anker im Außenbereich müssen aus nichtrostendem Stahl (A2 oder A4) bestehen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viele Mauerwerksanker brauche ich pro m²?</strong> Laut DIN 1053 und DIN EN 1996 werden mindestens 5 Anker pro m² empfohlen. Bei höheren Windlasten oder größeren Wandhöhen sind mehr Anker erforderlich.</p>
      <p><strong>Welches Material für Mauerwerksanker?</strong> Im Außenbereich sind Edelstahlqualitäten A2 (1.4301) oder A4 (1.4401) vorgeschrieben. Verzinkter Stahl ist nur im Innenbereich zulässig.</p>
      <p><strong>Wie tief müssen Mauerwerksanker eingebunden sein?</strong> Die Mindest-Einbindetiefe in jede Mauerwerkschale beträgt 50 mm. Empfohlen werden 60–80 mm für ausreichende Tragfähigkeit.</p>
      <p><strong>Was sind die häufigsten Fehler bei Mauerwerksankern?</strong> Zu geringer Abstand zur Mauerwerksfuge, zu kurze Einbindetiefe, falsches Material (verzinkt statt Edelstahl) und zu geringe Ankerdichte sind die häufigsten Fehler.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const maCapacity: Record<string, number> = { flat: 0.6, round: 0.5, heavy: 1.2 };
    const maDensityBase: Record<string, number> = { KS: 5, ZI: 5, PP: 6, BET: 4 };
    function calcMA() {
      const outer = parseFloat((document.getElementById('ma-outer') as HTMLInputElement).value) || 0;
      const insul = parseFloat((document.getElementById('ma-insul') as HTMLInputElement).value) || 0;
      const inner = parseFloat((document.getElementById('ma-inner') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('ma-type') as HTMLSelectElement).value;
      const anchor = (document.getElementById('ma-anchor') as HTMLSelectElement).value;
      const wind = parseFloat((document.getElementById('ma-wind') as HTMLInputElement).value) || 0.5;
      const embedOuter = Math.max(60, outer * 0.5);
      const totalLen = embedOuter + insul + 60;
      const cap = maCapacity[anchor] || 0.6;
      const baseDensity = maDensityBase[type] || 5;
      const density = Math.ceil(baseDensity + wind * 2);
      const fmtMm = (v: number) => Math.round(v) + ' mm';
      document.getElementById('ma-len')!.textContent = totalLen > 0 ? fmtMm(totalLen) : '--';
      document.getElementById('ma-embed')!.textContent = embedOuter > 0 ? fmtMm(embedOuter) : '--';
      document.getElementById('ma-density')!.textContent = density > 0 ? density + '/m²' : '--';
      document.getElementById('ma-cap')!.textContent = cap > 0 ? cap.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' kN' : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ma-in').forEach(el => { el.addEventListener('input', calcMA); el.addEventListener('change', calcMA); });
      calcMA();
    }, 50);
  </script>
</CalculatorLayout>
