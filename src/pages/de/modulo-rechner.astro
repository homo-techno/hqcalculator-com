---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Modulo Rechner - Divisionsrest und modulare Arithmetik";
const description = "Berechnen Sie Modulo (Divisionsrest) für beliebige Zahlen und erkunden Sie modulare Arithmetik. Mit ausführlichem Rechenweg und Anwendungsbeispielen.";

const relatedCalcs = [
  { name: "Gemischte Zahlen Rechner", url: "/de/gemischte-zahl-rechner", description: "Brüche berechnen." },
  { name: "Primzahl-Rechner", url: "/de/primzahl-rechner", description: "Primzahlen finden." },
  { name: "ggT-Rechner", url: "/de/ggt-rechner", description: "ggT berechnen." },
  { name: "Dezimal-Binär Rechner", url: "/de/dezimal-binaer-rechner", description: "Zahlen umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="modulo-calculator" calculatorName="Modulo Rechner" keywords="Modulo Rechner, Divisionsrest, modulare Arithmetik, mod Rechner, Rest Division" breadcrumbs={[{ name: "Modulo Rechner", url: "/de/modulo-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Modulo Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Divisionsrest (Modulo) von ganzen und Dezimalzahlen. Erkunden Sie modulare Arithmetik mit Beispielen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3 items-end">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Dividend (a)</label>
            <input type="number" id="mod-a" class="mod-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" value="17">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Divisor (n)</label>
            <input type="number" id="mod-n" class="mod-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" value="5">
          </div>
        </div>

        <div class="flex items-center justify-center py-2 text-2xl text-text-secondary font-bold">
          a mod n = r
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Rest (a mod n)</div>
          <div class="text-6xl font-extrabold font-mono" id="mod-result">2</div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ganzzahliger Quotient</div>
            <div class="text-xl font-bold" id="mod-quotient">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Rest</div>
            <div class="text-xl font-bold" id="mod-remainder">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Dezimalquotient</div>
            <div class="text-xl font-bold" id="mod-decimal">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rechenweg</h3>
          <div class="font-mono text-sm space-y-1" id="mod-steps"></div>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-text mb-2">Modulare Zahlenreihe (a mod n für a = 0..19)</h3>
          <div class="flex flex-wrap gap-1" id="mod-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="modulo" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Modulo und modulare Arithmetik</h2>
      <p>Die Modulooperation (a mod n oder a % n) liefert den Rest einer ganzzahligen Division. Sie ist fundamental in der Informatik, Kryptografie, Kalenderberechnungen und Zahlentheorie.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>a mod n = a - n × floor(a / n)</p>
        <p>Beispiel: 17 mod 5 = 17 - 5 × 3 = 2</p>
        <p>Probe: n × Quotient + Rest = a</p>
        <p>Probe: 5 × 3 + 2 = 17 ✓</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen mod und Divisionsrest?</p>
          <p>In den meisten Fällen identisch. Der Unterschied zeigt sich bei negativen Zahlen: -7 mod 3 = 2 (immer positiv), aber der Rest bei Division -7 ÷ 3 = -1 (mit Vorzeichen). In der Mathematik ist mod stets nicht-negativ.</p>
        </div>
        <div>
          <p class="font-semibold">Wo wird Modulo in der Informatik verwendet?</p>
          <p>Modulo ist allgegenwärtig: Prüfung auf gerade/ungerade Zahlen (n%2==0), Hash-Funktionen, Ringpuffer, Zufallszahlengeneratoren, Kryptografie (RSA), und zyklische Datenstrukturen.</p>
        </div>
        <div>
          <p class="font-semibold">Kann Modulo auf Dezimalzahlen angewendet werden?</p>
          <p>Ja. 7,5 mod 2,5 = 0; 10,3 mod 3 = 1,3. Die Formel bleibt dieselbe: a - n × floor(a/n). Viele Programmiersprachen unterstützen dies mit dem %-Operator für Gleitkommazahlen.</p>
        </div>
        <div>
          <p class="font-semibold">Wie berechnet man den Wochentag mit Modulo?</p>
          <p>Das Zeller-Algorithmus und ähnliche Methoden nutzen Modulo 7, da es 7 Wochentage gibt. Addiert man n Tage zu einem bekannten Datum, berechnet (Starttag + n) mod 7 den neuen Wochentag.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist kongruente Arithmetik?</p>
          <p>Zwei Zahlen a und b sind kongruent modulo n (geschrieben: a ≡ b mod n), wenn sie denselben Rest bei Division durch n haben. Zum Beispiel: 14 ≡ 2 mod 4 (beide haben Rest 2 bei Division durch 4).</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcMod() {
      const a = parseFloat((document.getElementById('mod-a') as HTMLInputElement).value);
      const n = parseFloat((document.getElementById('mod-n') as HTMLInputElement).value);

      if (isNaN(a) || isNaN(n) || n === 0) {
        document.getElementById('mod-result')!.textContent = n === 0 ? 'Div/0' : '—';
        return;
      }

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 6 });

      const quotient = Math.floor(a / n);
      const remainder = a - n * quotient;
      const decimal = a / n;

      const steps: string[] = [];
      steps.push(`${fmt(a)} ÷ ${fmt(n)} = ${fmt(decimal)}`);
      steps.push(`Ganzzahliger Quotient q = floor(${fmt(a)} / ${fmt(n)}) = ${fmt(quotient)}`);
      steps.push(`Rest r = ${fmt(a)} - ${fmt(n)} × ${fmt(quotient)}`);
      steps.push(`r = ${fmt(a)} - ${fmt(n * quotient)} = ${fmt(remainder)}`);
      steps.push(`Probe: ${fmt(n)} × ${fmt(quotient)} + ${fmt(remainder)} = ${fmt(n * quotient + remainder)}`);

      document.getElementById('mod-result')!.textContent = fmt(remainder);
      document.getElementById('mod-quotient')!.textContent = fmt(quotient);
      document.getElementById('mod-remainder')!.textContent = fmt(remainder);
      document.getElementById('mod-decimal')!.textContent = fmt(decimal);
      document.getElementById('mod-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');

      const tableEl = document.getElementById('mod-table')!;
      const modN = Math.round(n);
      if (modN > 0 && modN <= 50) {
        const cells: string[] = [];
        for (let i = 0; i < 20; i++) {
          const r = ((i % modN) + modN) % modN;
          const highlight = i === Math.round(a) ? 'bg-primary text-white' : 'bg-surface-alt text-text';
          cells.push(`<span class="inline-flex flex-col items-center px-2 py-1 rounded text-xs font-mono ${highlight}"><span>${i}</span><span class="text-xs opacity-70">${r}</span></span>`);
        }
        tableEl.innerHTML = cells.join('');
      } else {
        tableEl.innerHTML = '<span class="text-text-muted text-sm">Nur für ganzzahlige Moduln ≤ 50 verfügbar</span>';
      }

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.mod-in').forEach(el => {
        el.addEventListener('input', calcMod);
        el.addEventListener('change', calcMod);
      });
      calcMod();
    }, 50);
  </script>
</CalculatorLayout>
