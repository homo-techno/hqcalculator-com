---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bienenwachstuchrechner - Wachs, Harz & Stoff";
const description = "Berechnen Sie den Bienenwachsbedarf aus Stoffgr\u00f6\u00dfe, Harz-/\u00d6l-Verh\u00e4ltnis, Anzahl der T\u00fccher und Materialkosten f\u00fcr DIY-Bienenwachst\u00fccher.";
const relatedCalcs = [
  { name: "Stoff-Rechner", url: "/fabric-calculator", description: "Stoffbedarf." },
  { name: "Fl\u00e4chenrechner", url: "/area-calculator", description: "Fl\u00e4chenberechnungen." },
  { name: "Gewichtsumrechner", url: "/weight-converter", description: "Gewichtsumrechnung." },
  { name: "Budget-Rechner", url: "/budget-calculator", description: "Budgetplanung." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozente." },
  { name: "St\u00fcckpreis-Rechner", url: "/unit-price-calculator", description: "St\u00fcckpreisvergleich." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Bienenwachstuchrechner" lang="de" keywords="bienenwachstuch rechner, bienenwachs food wrap, DIY wachstuch, baumharz, jojoba\u00f6l, \u00f6ko tuch" breadcrumbs={[{ name: "Bienenwachstuchrechner", url: "/de/bienenwachstuch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bienenwachstuchrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Bienenwachs-, Baumharz- und Jojoba&ouml;l-Mengen f&uuml;r die Herstellung von DIY-Lebensmittelt&uuml;chern.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Tuchgr&ouml;&szlig;e</label>
          <select id="bw-size" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="small" selected>Klein (20&times;20 cm)</option>
            <option value="medium">Mittel (25&times;28 cm)</option>
            <option value="large">Gro&szlig; (33&times;36 cm)</option>
            <option value="xlarge">Extra gro&szlig; (40&times;40 cm)</option>
            <option value="custom">Eigene Gr&ouml;&szlig;e</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="bw-w" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="5" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">H&ouml;he (cm)</label><input type="number" id="bw-h" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="5" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl T&uuml;cher</label><input type="number" id="bw-qty" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="50" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rezepttyp</label>
            <select id="bw-recipe" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="standard" selected>Standard (Wachs + Harz + &Ouml;l)</option>
              <option value="simple">Einfach (nur Wachs)</option>
              <option value="vegan">Vegan (Sojawachs + Harz)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wachs (&euro;/100g)</label><input type="number" id="bw-wc" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Harz (&euro;/100g)</label><input type="number" id="bw-rc" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">&Ouml;l (&euro;/100ml)</label><input type="number" id="bw-oc" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigtes Bienenwachs</div>
          <div class="text-4xl font-extrabold font-mono" id="bw-result">0 g</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Baumharz</div><div class="text-xl font-bold font-mono" id="bw-resin">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jojoba&ouml;l</div><div class="text-xl font-bold font-mono" id="bw-oil">0 g</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stofffl&auml;che</div><div class="text-xl font-bold font-mono" id="bw-area">0 cm&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Wachsmischung</div><div class="text-xl font-bold font-mono" id="bw-total">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten</div><div class="text-xl font-bold font-mono" id="bw-cost">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="beeswax-wrap" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBW() {
      const size = (document.getElementById('bw-size') as HTMLSelectElement).value;
      let w = parseFloat((document.getElementById('bw-w') as HTMLInputElement).value) || 20;
      let h = parseFloat((document.getElementById('bw-h') as HTMLInputElement).value) || 20;
      const qty = parseInt((document.getElementById('bw-qty') as HTMLInputElement).value) || 1;
      const recipe = (document.getElementById('bw-recipe') as HTMLSelectElement).value;
      const waxCostPer100g = parseFloat((document.getElementById('bw-wc') as HTMLInputElement).value) || 0;
      const resinCostPer100g = parseFloat((document.getElementById('bw-rc') as HTMLInputElement).value) || 0;
      const oilCostPer100ml = parseFloat((document.getElementById('bw-oc') as HTMLInputElement).value) || 0;
      const sizes: Record<string, [number, number]> = {
        small: [20, 20], medium: [25, 28], large: [33, 36], xlarge: [40, 40]
      };
      if (size !== 'custom' && sizes[size]) {
        w = sizes[size][0]; h = sizes[size][1];
        (document.getElementById('bw-w') as HTMLInputElement).value = w.toString();
        (document.getElementById('bw-h') as HTMLInputElement).value = h.toString();
      }
      const areaCm2 = w * h;
      const totalAreaCm2 = areaCm2 * qty;
      // ca. 0.035 g Wachs pro cm²
      const waxPerCm2 = 0.035;
      const totalWaxBase = totalAreaCm2 * waxPerCm2;
      let waxG = 0, resinG = 0, oilG = 0;
      if (recipe === 'standard') {
        const totalMix = totalWaxBase * (7 / 5);
        waxG = totalMix * (5 / 7);
        resinG = totalMix * (1 / 7);
        oilG = totalMix * (1 / 7);
      } else if (recipe === 'simple') {
        waxG = totalWaxBase;
      } else {
        const totalMix = totalWaxBase * (7 / 5);
        waxG = totalMix * (5 / 7);
        resinG = totalMix * (2 / 7);
      }
      const totalMixG = waxG + resinG + oilG;
      const materialCost = (waxG / 100) * waxCostPer100g + (resinG / 100) * resinCostPer100g + (oilG / 100) * oilCostPer100ml;
      document.getElementById('bw-result')!.textContent = waxG.toFixed(1).replace('.', ',') + ' g';
      document.getElementById('bw-resin')!.textContent = resinG.toFixed(1).replace('.', ',') + ' g';
      document.getElementById('bw-oil')!.textContent = oilG.toFixed(1).replace('.', ',') + ' g';
      document.getElementById('bw-area')!.textContent = totalAreaCm2.toFixed(0) + ' cm\u00b2';
      document.getElementById('bw-total')!.textContent = totalMixG.toFixed(1).replace('.', ',') + ' g';
      document.getElementById('bw-cost')!.textContent = materialCost.toFixed(2).replace('.', ',') + ' \u20ac';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bw-in').forEach(el => { el.addEventListener('input', calcBW); el.addEventListener('change', calcBW); });
      calcBW();
    }, 50);
  </script>
</CalculatorLayout>
