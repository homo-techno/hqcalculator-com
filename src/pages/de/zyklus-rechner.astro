---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zyklusrechner - Menstruationszyklus, fruchtbare Tage und nächste Periode";
const description = "Berechnen Sie Ihren Menstruationszyklus, fruchtbare Tage und das Datum der nächsten Periode. Ovulationsrechner und Fruchtbarkeitskalender für die Familienplanung.";
const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "Stoffwechselalter Rechner", url: "/de/stoffwechselalter-rechner", description: "Metabolisches Alter." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="menstrual-cycle-calculator" calculatorName="Zyklusrechner" keywords="Zyklusrechner, Menstruationszyklus, fruchtbare Tage, Ovulationsrechner, nächste Periode berechnen" breadcrumbs={[{ name: "Zyklusrechner", url: "/de/zyklus-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zyklusrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren Menstruationszyklus, fruchtbare Tage, Ovulationstermin und das voraussichtliche Datum Ihrer nächsten Periode.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Erster Tag der letzten Periode</label>
          <input type="date" id="zr-last" class="zr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zykluslänge (Tage)</label><input type="number" id="zr-cycle" class="zr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="28" min="21" max="45"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Periodendauer (Tage)</label><input type="number" id="zr-period" class="zr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nächste Periode</div>
          <div class="text-3xl font-extrabold font-mono" id="zr-next">--</div>
          <div class="text-sm text-blue-200 mt-1" id="zr-days-left">-- Tage</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ovulationstag</div><div class="text-xl font-bold" id="zr-ovul">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fruchtbares Fenster</div><div class="text-lg font-bold" id="zr-fertile">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lutealphase</div><div class="text-xl font-bold" id="zr-luteal">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Follikelphase</div><div class="text-xl font-bold" id="zr-follic">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Nächste 3 Perioden</div>
          <div id="zr-future" class="text-sm text-text space-y-1">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="zyklus" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Den Menstruationszyklus verstehen</h2>
      <p>Ein typischer Menstruationszyklus dauert 21–45 Tage, wobei 28 Tage der häufigste Wert ist. Der Zyklus beginnt am ersten Tag der Periode und endet mit Beginn der nächsten. Die Ovulation (Eisprung) findet in der Regel 14 Tage vor der nächsten Periode statt, also bei einem 28-Tage-Zyklus um Tag 14. Das fruchtbare Fenster umfasst die 5 Tage vor dem Eisprung und den Ovulationstag selbst. Bitte beachten Sie, dass dieser Rechner nur eine Schätzung liefert und medizinischen Rat nicht ersetzt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wann sind fruchtbare Tage?</strong> Das fruchtbare Fenster liegt typischerweise 5 Tage vor dem Eisprung bis zum Ovulationstag. Bei einem 28-Tage-Zyklus sind dies die Tage 9–14.</p>
      <p><strong>Wie genau ist der Zyklusrechner?</strong> Der Rechner basiert auf durchschnittlichen Werten. Individuelle Schwankungen, Stress, Erkrankungen oder Hormonveränderungen können den Zyklus beeinflussen. Für präzise Familienplanung empfiehlt sich zusätzlich die Basaltemperaturmessung.</p>
      <p><strong>Was ist die Lutealphase?</strong> Die Lutealphase ist die zweite Hälfte des Zyklus nach dem Eisprung. Sie dauert bei den meisten Frauen 12–16 Tage und endet mit der nächsten Menstruation.</p>
      <p><strong>Was tun bei unregelmäßigem Zyklus?</strong> Bei einem unregelmäßigen Zyklus sollte ein Arzt aufgesucht werden. Mögliche Ursachen sind hormonelle Störungen, PCOS, Stress oder Schilddrüsenerkrankungen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function addDays(d: Date, n: number): Date { const r = new Date(d); r.setDate(r.getDate() + n); return r; }
    function fmtDate(d: Date): string { return d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }); }
    function calcZR() {
      const lastStr = (document.getElementById('zr-last') as HTMLInputElement).value;
      const cycle = parseInt((document.getElementById('zr-cycle') as HTMLInputElement).value) || 28;
      const period = parseInt((document.getElementById('zr-period') as HTMLInputElement).value) || 5;
      if (!lastStr) return;
      const last = new Date(lastStr);
      const ovulation = addDays(last, cycle - 14);
      const fertileStart = addDays(ovulation, -5);
      const fertileEnd = ovulation;
      const nextPeriod = addDays(last, cycle);
      const today = new Date();
      const daysLeft = Math.ceil((nextPeriod.getTime() - today.getTime()) / 86400000);
      const luteal = 14;
      const follic = cycle - luteal - period;
      const fut = [1, 2, 3].map(i => fmtDate(addDays(last, cycle * i)));
      document.getElementById('zr-next')!.textContent = fmtDate(nextPeriod);
      document.getElementById('zr-days-left')!.textContent = daysLeft > 0 ? 'in ' + daysLeft + ' Tagen' : daysLeft === 0 ? 'Heute' : 'Bereits begonnen';
      document.getElementById('zr-ovul')!.textContent = fmtDate(ovulation);
      document.getElementById('zr-fertile')!.textContent = fmtDate(fertileStart) + ' – ' + fmtDate(fertileEnd);
      document.getElementById('zr-luteal')!.textContent = luteal + ' Tage';
      document.getElementById('zr-follic')!.textContent = Math.max(follic, 1) + ' Tage';
      const futEl = document.getElementById('zr-future')!;
      futEl.innerHTML = fut.map((d, i) => '<div>' + (i + 1) + '. Periode: <strong>' + d + '</strong></div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      const today = new Date();
      const defDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 7);
      (document.getElementById('zr-last') as HTMLInputElement).value = defDate.toISOString().split('T')[0];
      document.querySelectorAll('.zr-in').forEach(el => { el.addEventListener('input', calcZR); el.addEventListener('change', calcZR); });
      calcZR();
    }, 50);
  </script>
</CalculatorLayout>
