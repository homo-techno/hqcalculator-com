---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Verd\u00fcnnungs-Rechner - C1V1 = C2V2";
const description = "Berechnen Sie Verd\u00fcnnungen mit der Formel C1V1 = C2V2. Finden Sie Konzentration oder Volumen f\u00fcr Reihenverd\u00fcnnungen.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Berechnungen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Mittelwert." },
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Bruchrechnung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Verd\u00fcnnungs-Rechner" lang="de" enSlug="dilution-calculator" keywords="verduennungs rechner, c1v1 c2v2, reihenverdunnung, loesungsverdunnung, konzentration" breadcrumbs={[{ name: "Verd\u00fcnnungs-Rechner", url: "/de/verduennungs-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Verd&uuml;nnungs-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Verd&uuml;nnungen mit C1V1 = C2V2.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="vdr-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-mode="v2">V&#8322; finden</button>
          <button class="vdr-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="c2">C&#8322; finden</button>
          <button class="vdr-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="v1">V&#8321; finden</button>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">C&#8321; (Ausgangskonz.)</label><input type="number" id="vdr-c1" class="vdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="10" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">V&#8321; (Ausgangsvolumen)</label><input type="number" id="vdr-v1" class="vdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="50" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">C&#8322; (Endkonz.)</label><input type="number" id="vdr-c2" class="vdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="2" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">V&#8322; (Endvolumen)</label><input type="number" id="vdr-v2" class="vdr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="0" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="vdr-label">V&#8322;</div>
          <div class="text-5xl font-extrabold font-mono" id="vdr-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verd&uuml;nnungsfaktor</div><div class="text-xl font-bold font-mono" id="vdr-factor">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">L&ouml;sungsmittel hinzuf&uuml;gen</div><div class="text-xl font-bold font-mono" id="vdr-add">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formel</h3>
          <div class="text-xs font-mono" id="vdr-formula">C&#8321; &times; V&#8321; = C&#8322; &times; V&#8322;</div>
        </div>
      </div>
      <ShareButton calculatorId="dilution-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Verd&uuml;nnungsformel</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 text-center font-mono">C&#8321; &times; V&#8321; = C&#8322; &times; V&#8322;</div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet C1V1 = C2V2?</strong> Die Stoffmenge bleibt bei der Verd&uuml;nnung gleich: Ausgangskonzentration mal Volumen = Endkonzentration mal Endvolumen.</p>
      <p><strong>Was ist eine Reihenverd&uuml;nnung?</strong> Eine serielle Verd&uuml;nnung, bei der jede Stufe mit dem Ergebnis der vorherigen Stufe hergestellt wird.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let vdrMode = 'v2';
    function calcVDR() {
      const c1 = parseFloat((document.getElementById('vdr-c1') as HTMLInputElement).value) || 0;
      const v1 = parseFloat((document.getElementById('vdr-v1') as HTMLInputElement).value) || 0;
      const c2 = parseFloat((document.getElementById('vdr-c2') as HTMLInputElement).value) || 0;
      const v2 = parseFloat((document.getElementById('vdr-v2') as HTMLInputElement).value) || 0;
      let result = 0, label = '', factor = 0, solventAdd = 0;
      if (vdrMode === 'v2') {
        result = c2 > 0 ? (c1 * v1) / c2 : 0;
        label = 'V\u2082 = ' + result.toFixed(2).replace('.', ',');
        factor = c2 > 0 ? c1 / c2 : 0;
        solventAdd = result - v1;
      } else if (vdrMode === 'c2') {
        const useV2 = v2 || 100;
        result = useV2 > 0 ? (c1 * v1) / useV2 : 0;
        label = 'C\u2082 = ' + result.toFixed(4).replace('.', ',');
        factor = result > 0 ? c1 / result : 0;
        solventAdd = useV2 - v1;
      } else {
        result = c1 > 0 ? (c2 * v2) / c1 : 0;
        label = 'V\u2081 = ' + result.toFixed(2).replace('.', ',');
        factor = c2 > 0 ? c1 / c2 : 0;
        solventAdd = v2 - result;
      }
      document.getElementById('vdr-label')!.textContent = vdrMode === 'v2' ? 'Endvolumen (V\u2082)' : vdrMode === 'c2' ? 'Endkonzentration (C\u2082)' : 'Ausgangsvolumen (V\u2081)';
      document.getElementById('vdr-result')!.textContent = label;
      document.getElementById('vdr-factor')!.textContent = factor.toFixed(1).replace('.', ',') + '\u00d7';
      document.getElementById('vdr-add')!.textContent = Math.max(0, solventAdd).toFixed(1).replace('.', ',');
      document.getElementById('vdr-formula')!.textContent = c1 + ' \u00d7 ' + v1 + ' = ' + (c2 || '?') + ' \u00d7 ' + (v2 || '?') + ' \u2192 ' + label;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vdr-mode').forEach(b => b.addEventListener('click', () => {
        vdrMode = (b as HTMLButtonElement).dataset.mode!;
        document.querySelectorAll('.vdr-mode').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.mode === vdrMode;
          (btn as HTMLButtonElement).className = 'vdr-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        calcVDR();
      }));
      document.querySelectorAll('.vdr-in').forEach(el => { el.addEventListener('input', calcVDR); el.addEventListener('change', calcVDR); });
      calcVDR();
    }, 50);
  </script>
</CalculatorLayout>
