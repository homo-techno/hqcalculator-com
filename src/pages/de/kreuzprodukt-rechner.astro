---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kreuzprodukt-Rechner - 3D-Vektor-Kreuzprodukt";
const description = "Berechnen Sie das Kreuzprodukt zweier 3D-Vektoren. Ermitteln Sie den Ergebnisvektor, seinen Betrag und den Winkel zwischen den Eingabevektoren.";
const relatedCalcs = [
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Erweiterte Mathematik." },
  { name: "Flaechenrechner", url: "/de/flaechenrechner", description: "Flaechen berechnen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitte." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Standardabweichungsrechner", url: "/de/standardabweichung-rechner", description: "Streuung." },
  { name: "Statistikrechner", url: "/de/statistik-rechner", description: "Statistische Auswertungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kreuzprodukt-Rechner" keywords="Kreuzprodukt Rechner, Vektorprodukt, 3D Vektor, Ergebnisvektor, Betrag, Winkel zwischen Vektoren" breadcrumbs={[{ name: "Kreuzprodukt-Rechner", url: "/de/kreuzprodukt-rechner" }]} lang="de" enSlug="cross-product-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kreuzprodukt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Kreuzprodukt zweier 3D-Vektoren, zusammen mit dem resultierenden Betrag und dem Winkel zwischen den Vektoren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Vektor A</h3>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">A<sub>x</sub></label><input type="number" id="kpr-ax" class="kpr-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="2" /></div>
          <div><label class="block text-sm font-medium text-text mb-1">A<sub>y</sub></label><input type="number" id="kpr-ay" class="kpr-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="3" /></div>
          <div><label class="block text-sm font-medium text-text mb-1">A<sub>z</sub></label><input type="number" id="kpr-az" class="kpr-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="4" /></div>
        </div>

        <h3 class="font-semibold text-text">Vektor B</h3>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">B<sub>x</sub></label><input type="number" id="kpr-bx" class="kpr-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="5" /></div>
          <div><label class="block text-sm font-medium text-text mb-1">B<sub>y</sub></label><input type="number" id="kpr-by" class="kpr-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="6" /></div>
          <div><label class="block text-sm font-medium text-text mb-1">B<sub>z</sub></label><input type="number" id="kpr-bz" class="kpr-in w-full px-4 py-2 border border-border rounded-xl text-lg" value="7" /></div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kreuzprodukt A &times; B</div>
          <div class="text-4xl font-extrabold font-mono" id="kpr-result">(0, 0, 0)</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Betrag |A &times; B|</div>
            <div class="text-xl font-bold" id="kpr-mag">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Winkel zwischen Vektoren</div>
            <div class="text-xl font-bold" id="kpr-angle">0&deg;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">|A|</div>
            <div class="text-xl font-bold" id="kpr-maga">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">|B|</div>
            <div class="text-xl font-bold" id="kpr-magb">0</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formel</h3>
          <div class="text-sm text-text-secondary font-mono" id="kpr-formula"></div>
        </div>
      </div>
      <ShareButton calculatorId="cross-product" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist das Kreuzprodukt?</h2>
      <p>Das Kreuzprodukt zweier 3D-Vektoren erzeugt einen neuen Vektor, der senkrecht auf beiden Eingabevektoren steht. Es wird berechnet als:</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p><strong>A &times; B</strong> = (A<sub>y</sub>B<sub>z</sub> - A<sub>z</sub>B<sub>y</sub>, A<sub>z</sub>B<sub>x</sub> - A<sub>x</sub>B<sub>z</sub>, A<sub>x</sub>B<sub>y</sub> - A<sub>y</sub>B<sub>x</sub>)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Eigenschaften</h3>
      <ul>
        <li>Das Kreuzprodukt ist antikommutativ: A &times; B = -(B &times; A)</li>
        <li>Der Betrag entspricht der Flaeche des von A und B aufgespannten Parallelogramms</li>
        <li>Wenn A &times; B = 0, sind die Vektoren parallel</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcKPR() {
      const ax = parseFloat((document.getElementById('kpr-ax') as HTMLInputElement).value) || 0;
      const ay = parseFloat((document.getElementById('kpr-ay') as HTMLInputElement).value) || 0;
      const az = parseFloat((document.getElementById('kpr-az') as HTMLInputElement).value) || 0;
      const bx = parseFloat((document.getElementById('kpr-bx') as HTMLInputElement).value) || 0;
      const by = parseFloat((document.getElementById('kpr-by') as HTMLInputElement).value) || 0;
      const bz = parseFloat((document.getElementById('kpr-bz') as HTMLInputElement).value) || 0;

      const cx = ay * bz - az * by;
      const cy = az * bx - ax * bz;
      const cz = ax * by - ay * bx;

      const magA = Math.sqrt(ax * ax + ay * ay + az * az);
      const magB = Math.sqrt(bx * bx + by * by + bz * bz);
      const magC = Math.sqrt(cx * cx + cy * cy + cz * cz);

      const dot = ax * bx + ay * by + az * bz;
      let angle = 0;
      if (magA > 0 && magB > 0) {
        angle = Math.acos(Math.min(1, Math.max(-1, dot / (magA * magB)))) * (180 / Math.PI);
      }

      const fmt = (n: number) => Number.isInteger(n) ? String(n) : n.toFixed(4).replace('.', ',');

      document.getElementById('kpr-result')!.textContent = '(' + fmt(cx) + ', ' + fmt(cy) + ', ' + fmt(cz) + ')';
      document.getElementById('kpr-mag')!.textContent = fmt(magC);
      document.getElementById('kpr-angle')!.innerHTML = fmt(angle) + '&deg;';
      document.getElementById('kpr-maga')!.textContent = fmt(magA);
      document.getElementById('kpr-magb')!.textContent = fmt(magB);
      document.getElementById('kpr-formula')!.innerHTML =
        'A &times; B = (' + ay + '&middot;' + bz + ' - ' + az + '&middot;' + by + ', ' + az + '&middot;' + bx + ' - ' + ax + '&middot;' + bz + ', ' + ax + '&middot;' + by + ' - ' + ay + '&middot;' + bx + ') = (' + fmt(cx) + ', ' + fmt(cy) + ', ' + fmt(cz) + ')';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.kpr-in').forEach(el => {
        el.addEventListener('input', calcKPR);
        el.addEventListener('change', calcKPR);
      });
      calcKPR();
    }, 50);
  </script>
</CalculatorLayout>
