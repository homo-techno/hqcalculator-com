---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquaponik-Rechner - Fische, Pflanzen & Durchfluss";
const description = "Berechnen Sie Fisch-zu-Pflanzen-Verhältnis, Tankvolumen, Beetgröße, Fütterungsrate und Wasserdurchfluss für Aquaponik-Systeme.";
const relatedCalcs = [
  { name: "Aquarium-Rechner", url: "/de/aquarium-rechner", description: "Aquariumvolumen." },
  { name: "Gartenabstand", url: "/de/gartenabstand-rechner", description: "Pflanzenabstand." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumenberechnungen." },
  { name: "Wasserbedarf", url: "/de/hydrations-rechner", description: "Wasserbedarf." },
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Flächenberechnungen." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budgetplanung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquaponik-Rechner" keywords="Aquaponik-Rechner, Fisch-Pflanzen-Verhältnis, Anbaubeet, Tankvolumen, Wasserdurchfluss, Fütterungsrate" breadcrumbs={[{ name: "Aquaponik", url: "/de/aquaponik-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquaponik-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Fisch-zu-Pflanzen-Verhältnisse, Tankgrößen, Beetflächen und Wasserdurchfluss für Aquaponik-Systeme.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fischtank-Volumen (Liter)</label><input type="number" id="aq-tank" class="aq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="380" min="40" step="10"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Fischart</label>
            <select id="aq-fish" class="aq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="tilapia" selected>Tilapia</option>
              <option value="goldfish">Goldfisch</option>
              <option value="trout">Forelle</option>
              <option value="catfish">Wels</option>
              <option value="koi">Koi</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beettyp</label>
            <select id="aq-bed" class="aq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="media" selected>Substratbeet (Kies)</option>
              <option value="raft">Tiefwasserkultur (Floß)</option>
              <option value="nft">NFT (Nährstofffilmtechnik)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Pflanzenart</label>
            <select id="aq-plant" class="aq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="lettuce" selected>Blattgemüse / Salat</option>
              <option value="herbs">Kräuter</option>
              <option value="tomato">Tomaten / Paprika</option>
              <option value="strawberry">Erdbeeren</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wassertemperatur (&deg;C)</label><input type="number" id="aq-temp" class="aq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="24" min="10" max="32" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Besatzdichte (Fische/100L)</label><input type="number" id="aq-dens" class="aq-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="20" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Fischanzahl</div>
          <div class="text-4xl font-extrabold font-mono" id="aq-result">0 Fische</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beetfläche</div><div class="text-xl font-bold font-mono" id="aq-area">0 m&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pflanzplätze</div><div class="text-xl font-bold font-mono" id="aq-plants">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Futter/Tag</div><div class="text-xl font-bold font-mono" id="aq-feed">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasserdurchfluss</div><div class="text-xl font-bold font-mono" id="aq-flow">0 L/h</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Systemvol.</div><div class="text-xl font-bold font-mono" id="aq-sys">0 L</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquaponics" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAQ() {
      const tank = parseFloat((document.getElementById('aq-tank') as HTMLInputElement).value) || 380;
      const fishType = (document.getElementById('aq-fish') as HTMLSelectElement).value;
      const bedType = (document.getElementById('aq-bed') as HTMLSelectElement).value;
      const plantType = (document.getElementById('aq-plant') as HTMLSelectElement).value;
      const temp = parseFloat((document.getElementById('aq-temp') as HTMLInputElement).value) || 24;
      const density = parseFloat((document.getElementById('aq-dens') as HTMLInputElement).value) || 5;

      const fishCount = Math.floor(tank * density / 100);

      const avgWeightKg: Record<string, number> = { tilapia: 0.68, goldfish: 0.14, trout: 0.9, catfish: 1.1, koi: 1.4 };
      const totalFishKg = fishCount * (avgWeightKg[fishType] || 0.5);

      const feedRate = temp > 18 ? 0.02 : 0.015;
      const feedGPerDay = totalFishKg * feedRate * 1000;

      const bedRatios: Record<string, number> = { media: 1, raft: 1.5, nft: 2 };
      const bedRatio = bedRatios[bedType] || 1;
      const growBedLiters = tank * bedRatio;
      const growBedM2 = growBedLiters / 300;

      const plantsPerM2: Record<string, number> = { lettuce: 43, herbs: 65, tomato: 11, strawberry: 32 };
      const plantSites = Math.floor(growBedM2 * (plantsPerM2[plantType] || 43));

      const flowLPH = Math.round(tank);

      const sysVolume = tank + growBedLiters * 0.4;

      document.getElementById('aq-result')!.textContent = fishCount + ' Fische';
      document.getElementById('aq-area')!.textContent = growBedM2.toFixed(1).replace('.', ',') + ' m\u00B2';
      document.getElementById('aq-plants')!.textContent = plantSites.toString();
      document.getElementById('aq-feed')!.textContent = feedGPerDay.toFixed(0) + ' g';
      document.getElementById('aq-flow')!.textContent = flowLPH + ' L/h';
      document.getElementById('aq-sys')!.textContent = Math.round(sysVolume) + ' L';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.aq-in').forEach(el => { el.addEventListener('input', calcAQ); el.addEventListener('change', calcAQ); });
      calcAQ();
    }, 50);
  </script>
</CalculatorLayout>
