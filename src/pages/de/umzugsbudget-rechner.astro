---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Umzugsbudget Rechner - Alle Kostenpositionen planen";
const description = "Planen Sie Ihr Umzugsbudget mit allen Kostenpositionen: Umzugsunternehmen, Verpackung, Kaution und mehr.";
const relatedCalcs = [
  { name: "Umzugskosten Rechner", url: "/de/umzugskosten-rechner", description: "Umzugskosten berechnen." },
  { name: "Abschlusskosten Rechner", url: "/de/abschlusskosten-rechner", description: "Immobilien-Nebenkosten." },
  { name: "Nettovermögen Rechner", url: "/de/nettovermoegen-rechner", description: "Vermögen berechnen." },
  { name: "Kapitalwert Rechner", url: "/de/kapitalwert-rechner", description: "Investitionen bewerten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Umzugsbudget Rechner" enSlug="moving-budget-calculator" keywords="Umzugsbudget, Umzugskosten, Kostenplan Umzug, Umzug planen, Umzugspauschale" breadcrumbs={[{ name: "Umzugsbudget Rechner", url: "/de/umzugsbudget-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Umzugsbudget Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erfassen Sie alle Kostenpositionen Ihres Umzugs und erhalten Sie eine detaillierte Budgetübersicht.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Umzugsunternehmen (€)</label><input type="number" id="ub-company" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1200" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verpackungsmaterial (€)</label><input type="number" id="ub-packing" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="0" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Neue Kaution (€)</label><input type="number" id="ub-deposit" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1800" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Reinigungskosten (€)</label><input type="number" id="ub-cleaning" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="0" step="50"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Renovierung neue Wohnung (€)</label><input type="number" id="ub-reno" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ummeldung & Behörden (€)</label><input type="number" id="ub-admin" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Neue Möbel (€)</label><input type="number" id="ub-furniture" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="800" min="0" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstiges (€)</label><input type="number" id="ub-misc" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="0" step="50"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Puffer / Reserve (%)</label><input type="number" id="ub-buffer" class="ub-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="50" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtbudget (inkl. Puffer)</div>
          <div class="text-5xl font-extrabold font-mono" id="ub-result">0,00 €</div>
          <div class="text-sm text-blue-200 mt-1" id="ub-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundkosten</div><div class="text-xl font-bold" id="ub-base">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pufferbetrag</div><div class="text-xl font-bold" id="ub-bufferamt">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Kostenaufstellung</h3>
          <div class="space-y-1 text-sm" id="ub-breakdown"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="umzugsbudget" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Umzug richtig budgetieren</h2>
      <p>Ein Umzug kostet in Deutschland durchschnittlich 1.500 bis 5.000 Euro – je nach Distanz, Wohnungsgröße und ob ein professionelles Umzugsunternehmen beauftragt wird. Neben den direkten Umzugskosten sollten Kautionszahlungen, Renovierungen und neue Einrichtungsgegenstände eingeplant werden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was kostet ein Umzug in Deutschland durchschnittlich?</strong></p><p>Ein lokaler Umzug innerhalb einer Stadt kostet meist 800–2.000 €. Fernumzüge können 2.000–6.000 € und mehr kosten.</p></div>
        <div><p><strong>Kann ich Umzugskosten steuerlich absetzen?</strong></p><p>Ja, bei beruflich bedingtem Umzug können die Kosten als Werbungskosten geltend gemacht werden. Der Pauschalbetrag beträgt derzeit 886 € (2024).</p></div>
        <div><p><strong>Wie hoch ist die Kaution bei einer neuen Wohnung?</strong></p><p>Die Kaution darf maximal drei Kaltmieten betragen. Häufig werden zwei bis drei Monatsmieten verlangt.</p></div>
        <div><p><strong>Wie viel Puffer sollte ich einplanen?</strong></p><p>Empfohlen werden mindestens 10–15 % des Gesamtbudgets als Reserve für unvorhergesehene Ausgaben.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcUB() {
      const company = parseFloat((document.getElementById('ub-company') as HTMLInputElement).value) || 0;
      const packing = parseFloat((document.getElementById('ub-packing') as HTMLInputElement).value) || 0;
      const deposit = parseFloat((document.getElementById('ub-deposit') as HTMLInputElement).value) || 0;
      const cleaning = parseFloat((document.getElementById('ub-cleaning') as HTMLInputElement).value) || 0;
      const reno = parseFloat((document.getElementById('ub-reno') as HTMLInputElement).value) || 0;
      const admin = parseFloat((document.getElementById('ub-admin') as HTMLInputElement).value) || 0;
      const furniture = parseFloat((document.getElementById('ub-furniture') as HTMLInputElement).value) || 0;
      const misc = parseFloat((document.getElementById('ub-misc') as HTMLInputElement).value) || 0;
      const bufferPct = parseFloat((document.getElementById('ub-buffer') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      const items: [string, number][] = [
        ['Umzugsunternehmen', company],
        ['Verpackungsmaterial', packing],
        ['Neue Kaution', deposit],
        ['Reinigungskosten', cleaning],
        ['Renovierung', reno],
        ['Ummeldung & Behörden', admin],
        ['Neue Möbel', furniture],
        ['Sonstiges', misc],
      ];
      const base = items.reduce((s, [, v]) => s + v, 0);
      const bufferAmt = base * bufferPct / 100;
      const total = base + bufferAmt;
      document.getElementById('ub-result')!.textContent = fmt(total);
      document.getElementById('ub-sub')!.textContent = 'Grundkosten: ' + fmt(base) + ' | Puffer (' + bufferPct + '%): ' + fmt(bufferAmt);
      document.getElementById('ub-base')!.textContent = fmt(base);
      document.getElementById('ub-bufferamt')!.textContent = fmt(bufferAmt);
      document.getElementById('ub-breakdown')!.innerHTML = items.filter(([, v]) => v > 0).map(([name, val]) =>
        '<div class="flex justify-between"><span class="text-text-muted">' + name + '</span><span class="font-bold">' + fmt(val) + '</span></div>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ub-in').forEach(el => { el.addEventListener('input', calcUB); el.addEventListener('change', calcUB); });
      calcUB();
    }, 50);
  </script>
</CalculatorLayout>
