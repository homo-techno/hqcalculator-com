---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Pareto-Analyse Rechner - 80/20-Regel";
const description = "Führen Sie eine Pareto-Analyse durch und identifizieren Sie die wichtigsten 20% Ursachen, die 80% der Wirkungen verursachen.";

const relatedCalcs = [
  { name: "Statistik-Rechner", url: "/de/statistik-rechner", description: "Statistische Kennzahlen." },
  { name: "Prozentsatz-Rechner", url: "/de/prozentsatz-rechner", description: "Prozente berechnen." },
  { name: "Kostenrechner", url: "/de/kostenrechner", description: "Kostenkalkulation." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Pareto-Analyse Rechner" lang="de" enSlug="pareto-calculator" keywords="pareto analyse rechner, 80 20 regel, pareto diagramm, abc analyse, qualitätsmanagement" breadcrumbs={[{ name: "Pareto-Analyse Rechner", url: "/de/pareto-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Pareto-Analyse Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Identifizieren Sie die wesentlichen Faktoren nach der 80/20-Regel (Pareto-Prinzip).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-2">Kategorien und Werte (kommagetrennt: Name:Wert)</label>
          <textarea id="prt-data" class="prt-in w-full px-4 py-3 border border-border rounded-xl text-sm font-mono" rows="8">Transportschäden:45
Falschlieferungen:30
Verpackungsfehler:18
Fehlende Teile:12
Beschriftungsfehler:8
Sonstige:5</textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Pareto-Schwellenwert (%)</label><input type="number" id="prt-threshold" class="prt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="50" max="99" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einheit</label><input type="text" id="prt-unit" class="prt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="Fehler" maxlength="20"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wesentliche Kategorien</div>
          <div class="text-4xl font-extrabold font-mono" id="prt-result">0 von 0</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl overflow-x-auto">
          <h3 class="font-semibold text-sm text-text mb-3">Pareto-Tabelle</h3>
          <table class="w-full text-sm"><thead><tr class="text-xs text-text-muted uppercase"><th class="text-left pb-2">Kategorie</th><th class="text-right pb-2">Wert</th><th class="text-right pb-2">Anteil</th><th class="text-right pb-2">Kumuliert</th><th class="text-right pb-2">Klasse</th></tr></thead><tbody id="prt-table"></tbody></table>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtwert</div><div class="text-xl font-bold" id="prt-total">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A-Kategorien (%)</div><div class="text-xl font-bold" id="prt-apct">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A-Wert Anteil</div><div class="text-xl font-bold" id="prt-aval">0%</div></div>
        </div>
      </div>
      <ShareButton calculatorId="pareto-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Das Pareto-Prinzip im Qualitätsmanagement</h2>
      <p class="text-text-secondary mt-2">Das Pareto-Prinzip, benannt nach dem italienischen Ökonomen Vilfredo Pareto, besagt, dass 80 % der Wirkungen auf 20 % der Ursachen zurückzuführen sind. In der Praxis des Qualitätsmanagements (ISO 9001) hilft die Pareto-Analyse dabei, die wesentlichen Fehlerursachen zu identifizieren und Ressourcen gezielt einzusetzen. Das Pareto-Diagramm ist Teil der sieben Qualitätswerkzeuge (Q7).</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Klasse A:</strong> Kumulierter Anteil bis zum Schwellenwert (z.B. 80%)</p>
        <p><strong>Klasse B:</strong> Kumulierter Anteil 80–95%</p>
        <p><strong>Klasse C:</strong> Kumulierter Anteil über 95%</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist das Pareto-Prinzip?</strong> Es ist die Beobachtung, dass ein kleiner Anteil der Ursachen (ca. 20 %) für den Großteil der Auswirkungen (ca. 80 %) verantwortlich ist. Diese Regel gilt in vielen Bereichen wie Wirtschaft, Qualitätssicherung und Zeitmanagement.</p>
      <p><strong>Wie erstelle ich eine Pareto-Analyse?</strong> Sammeln Sie Fehlerdaten, sortieren Sie diese nach Häufigkeit absteigend, berechnen Sie kumulative Prozentwerte und markieren Sie den Punkt, bei dem 80 % erreicht sind.</p>
      <p><strong>Was ist der Unterschied zwischen Pareto und ABC-Analyse?</strong> Beide sind ähnlich. Die ABC-Analyse klassifiziert in drei Gruppen. Die Pareto-Analyse hebt besonders die vitalen wenigen hervor und visualisiert diese im Diagramm.</p>
      <p><strong>In welchen Bereichen wird die Pareto-Analyse angewendet?</strong> Qualitätsmanagement, Lagerhaltung, Kundenpflege, Kostenanalyse und Zeitmanagement sind typische Anwendungsgebiete.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcPRT() {
      const raw = (document.getElementById('prt-data') as HTMLTextAreaElement).value;
      const threshold = parseFloat((document.getElementById('prt-threshold') as HTMLInputElement).value) || 80;
      const unit = (document.getElementById('prt-unit') as HTMLInputElement).value || 'Fehler';

      const items: { name: string; val: number }[] = [];
      raw.split('\n').forEach(line => {
        const parts = line.trim().split(':');
        if (parts.length >= 2) {
          const val = parseFloat(parts[parts.length - 1]);
          const name = parts.slice(0, parts.length - 1).join(':').trim();
          if (!isNaN(val) && name) items.push({ name, val });
        }
      });

      items.sort((a, b) => b.val - a.val);
      const total = items.reduce((s, i) => s + i.val, 0);

      let cumPct = 0;
      let aCount = 0;
      let aVal = 0;
      const rows = items.map(item => {
        const pct = total > 0 ? (item.val / total) * 100 : 0;
        cumPct += pct;
        const cls = cumPct <= threshold ? 'A' : cumPct <= 95 ? 'B' : 'C';
        if (cls === 'A') { aCount++; aVal += item.val; }
        const clsColor = cls === 'A' ? 'text-green-700 font-bold' : cls === 'B' ? 'text-yellow-700' : 'text-text-muted';
        return '<tr class="border-t border-border/30"><td class="py-1">' + item.name + '</td><td class="text-right">' + item.val.toLocaleString('de-DE') + '</td><td class="text-right">' + pct.toFixed(1).replace('.', ',') + '%</td><td class="text-right">' + Math.min(cumPct, 100).toFixed(1).replace('.', ',') + '%</td><td class="text-right ' + clsColor + '">' + cls + '</td></tr>';
      });

      document.getElementById('prt-result')!.textContent = aCount + ' von ' + items.length;
      document.getElementById('prt-total')!.textContent = total.toLocaleString('de-DE') + ' ' + unit;
      document.getElementById('prt-apct')!.textContent = (items.length > 0 ? (aCount / items.length * 100) : 0).toFixed(1).replace('.', ',') + '%';
      document.getElementById('prt-aval')!.textContent = (total > 0 ? (aVal / total * 100) : 0).toFixed(1).replace('.', ',') + '%';
      document.getElementById('prt-table')!.innerHTML = rows.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.prt-in').forEach(el => { el.addEventListener('input', calcPRT); el.addEventListener('change', calcPRT); });
      calcPRT();
    }, 50);
  </script>
</CalculatorLayout>
