---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const title = "Über uns - HQ Calculator";
const description = "Erfahren Sie mehr über HQ Calculator — die kostenlose Online-Rechner-Plattform mit über 1.300 Tools für Finanzen, Gesundheit, Mathematik, Bauwesen und mehr.";

const stats = [
  { value: '1.300+', label: 'Rechner' },
  { value: '50+', label: 'Kategorien' },
  { value: '100 %', label: 'Kostenlos' },
  { value: '<1s', label: 'Ladezeit' },
];
---

<CalculatorLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: 'Über uns', url: '/de/ueber-uns' }]}
  lang="de"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-text mb-6">Über HQ Calculator</h1>

    <div class="space-y-6 text-text-secondary leading-relaxed">
      <p>
        HQ Calculator ist eine kostenlose Online-Plattform mit über 1.300 Rechnern in Dutzenden von Kategorien — von Finanzen und Gesundheit über Ingenieurwesen und Bauwesen bis hin zu Naturwissenschaften und Alltag.
      </p>

      <p>
        Unsere Mission ist einfach: <strong class="text-text">Die besten kostenlosen Rechner im Internet bereitstellen</strong>. Jeder Rechner ist darauf ausgelegt, sofortige und präzise Ergebnisse zu liefern — ohne Anmeldung, ohne Werbebarrieren und ohne versteckte Kosten.
      </p>
    </div>

    <!-- Statistiken -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-10">
      {stats.map(stat => (
        <div class="bg-surface-alt rounded-xl p-5 text-center">
          <div class="text-2xl font-bold text-primary">{stat.value}</div>
          <div class="text-sm text-text-muted mt-1">{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="space-y-8">
      <section>
        <h2 class="text-xl font-semibold text-text mb-3">Was uns unterscheidet</h2>
        <ul class="space-y-3 text-text-secondary">
          <li class="flex items-start gap-3">
            <span class="text-primary font-bold mt-0.5">1.</span>
            <span><strong class="text-text">Clientseitige Berechnungen</strong> — alle Berechnungen finden in Ihrem Browser statt. Ihre Daten verlassen niemals Ihr Gerät. Keine Serveranfragen, keine Datenerfassung.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary font-bold mt-0.5">2.</span>
            <span><strong class="text-text">Sofortige Ergebnisse</strong> — die Ergebnisse aktualisieren sich während der Eingabe. Kein „Berechnen"-Button nötig. Jede Seite lädt in unter 1 Sekunde.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary font-bold mt-0.5">3.</span>
            <span><strong class="text-text">Datenschutz an erster Stelle</strong> — keine Cookies, keine Tracking-Pixel, keine Erhebung personenbezogener Daten. Wir verwenden Cloudflare Web Analytics, das vollständig DSGVO-konform und cookie-frei ist.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary font-bold mt-0.5">4.</span>
            <span><strong class="text-text">Mobilfreundlich</strong> — jeder Rechner ist vollständig responsiv und funktioniert auf jedem Gerät, vom Smartphone bis zum Desktop.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary font-bold mt-0.5">5.</span>
            <span><strong class="text-text">Keine Anmeldung</strong> — komplett kostenlos, für immer. Keine E-Mail-Hürden, keine Premium-Stufen, keine Registrierung.</span>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-text mb-3">Unsere Kategorien</h2>
        <p class="text-text-secondary leading-relaxed mb-4">
          Wir decken ein breites Spektrum professioneller und alltäglicher Berechnungsanforderungen ab:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-sm text-text-secondary">
          {[
            'Finanzen & Bankwesen', 'Gesundheit & Fitness', 'Mathematik', 'Bau & Haus',
            'Ingenieurwesen', 'Naturwissenschaften & Physik', 'Kochen & Backen', 'Immobilien',
            'Bildung', 'Elektronik', 'Umwelt', 'Fotografie & Medien',
            'Automobil', 'Astronomie', 'Landwirtschaft', 'Holzbearbeitung',
            'Schweißen & Metallbearbeitung', 'Netzwerk & IT', 'Recht & Compliance', 'Eventplanung',
          ].map(cat => (
            <span class="px-3 py-2 bg-surface-alt rounded-lg">{cat}</span>
          ))}
          <span class="px-3 py-2 bg-primary/10 text-primary rounded-lg font-medium">Und 30+ weitere...</span>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-text mb-3">Genauigkeit & Haftungsausschluss</h2>
        <p class="text-text-secondary leading-relaxed">
          Wir bemühen uns, dass alle Rechner genaue Ergebnisse auf Basis etablierter Formeln und Methoden liefern. Unsere Tools dienen jedoch ausschließlich zu Informations- und Bildungszwecken. Sie ersetzen keine professionelle Beratung durch qualifizierte Finanzberater, Ärzte, Ingenieure oder andere Fachleute. Bitte beachten Sie unsere <a href="/de/nutzungsbedingungen" class="text-primary hover:underline">Nutzungsbedingungen</a> für alle Einzelheiten.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-text mb-3">Kontakt</h2>
        <p class="text-text-secondary leading-relaxed">
          Haben Sie einen Vorschlag für einen neuen Rechner? Einen Fehler gefunden? Wir freuen uns über Ihre Nachricht.
        </p>
        <p class="text-text-secondary mt-2">
          E-Mail: <strong>hello@hqcalculator.com</strong>
        </p>
      </section>
    </div>
  </div>
</CalculatorLayout>
