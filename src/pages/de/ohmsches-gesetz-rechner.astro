---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ohmsches Gesetz Rechner – Spannung, Strom, Widerstand, Leistung";
const description = "Berechnen Sie Spannung, Strom, Widerstand und Leistung mit dem Ohmschen Gesetz.";
const relatedCalcs = [
  { name: "Operationsverstärker Rechner", url: "/de/operationsverstaerker-rechner", description: "Op-Amp-Schaltungen." },
  { name: "ADC-Auflösung Rechner", url: "/de/adc-aufloesung-rechner", description: "ADC-Auflösung." },
  { name: "Akkulaufzeit Rechner", url: "/de/akkulaufzeit-rechner", description: "Akkulaufzeit berechnen." },
  { name: "Lärmminderung Rechner", url: "/de/laermminderung-rechner", description: "Schallschutz." },
];
---
<CalculatorLayout lang="de" enSlug="ohms-law-calculator" title={title} description={description} calculatorName="Ohmsches Gesetz Rechner" keywords="Ohmsches Gesetz, Spannung, Strom, Widerstand, Leistung, Elektrotechnik, Volt, Ampere, Ohm, Watt" breadcrumbs={[{ name: "Ohmsches Gesetz Rechner", url: "/de/ohmsches-gesetz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ohmsches Gesetz Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie zwei der vier elektrischen Größen ein, um die anderen beiden zu berechnen. Das Ohmsche Gesetz verknüpft Spannung, Strom, Widerstand und Leistung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Berechne aus:</label>
          <select id="og-mode" class="og-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="UI">Spannung U und Strom I → R, P</option>
            <option value="UR">Spannung U und Widerstand R → I, P</option>
            <option value="UP">Spannung U und Leistung P → I, R</option>
            <option value="IR">Strom I und Widerstand R → U, P</option>
            <option value="IP">Strom I und Leistung P → U, R</option>
            <option value="RP">Widerstand R und Leistung P → U, I</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3" id="og-inputs">
          <div>
            <label class="block text-xs font-medium text-text mb-1" id="og-lbl1">Spannung U (V)</label>
            <input type="number" id="og-val1" class="og-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1" id="og-lbl2">Strom I (A)</label>
            <input type="number" id="og-val2" class="og-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Spannung U</div>
            <div class="text-2xl font-extrabold font-mono" id="og-U">—</div>
          </div>
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Strom I</div>
            <div class="text-2xl font-extrabold font-mono" id="og-I">—</div>
          </div>
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Widerstand R</div>
            <div class="text-2xl font-extrabold font-mono" id="og-R">—</div>
          </div>
          <div class="p-4 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase">Leistung P</div>
            <div class="text-2xl font-extrabold font-mono" id="og-P">—</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formelweg</h3>
          <div class="font-mono text-sm space-y-1" id="og-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="ohms-law" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Ohmsche Gesetz in der Elektrotechnik</h2>
      <p>Das Ohmsche Gesetz wurde 1826 von Georg Simon Ohm formuliert und ist eines der grundlegendsten Gesetze der Elektrotechnik. Es beschreibt die lineare Beziehung zwischen Spannung, Strom und Widerstand in einem elektrischen Leiter. Zusammen mit der Leistungsformel P = U × I bildet es die Basis für die Analyse elektrischer Schaltkreise.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>U = R × I (Spannung = Widerstand × Strom)</p>
        <p>I = U / R (Strom = Spannung / Widerstand)</p>
        <p>R = U / I (Widerstand = Spannung / Strom)</p>
        <p>P = U × I = U²/R = I²×R (Leistung)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Gilt das Ohmsche Gesetz für alle Bauteile?</strong> Nein. Das Ohmsche Gesetz gilt nur für ohmsche Widerstände. Für Halbleiter (Dioden, Transistoren), Kondensatoren und Spulen gelten andere Gesetzmäßigkeiten.</p>
      <p><strong>Was ist der Unterschied zwischen Gleichstrom und Wechselstrom?</strong> Bei Gleichstrom (DC) sind Spannung und Strom zeitlich konstant. Bei Wechselstrom (AC) schwingen beide periodisch, und es treten reaktive Widerstände (Impedanz) auf.</p>
      <p><strong>Warum wird ein Widerstand warm?</strong> Elektrische Energie wird im Widerstand in Wärme umgewandelt (Joulesches Gesetz). Die Verlustleistung beträgt P = I² × R Watt.</p>
      <p><strong>Was bedeutet der spezifische Widerstand?</strong> Der spezifische Widerstand ρ (rho) ist eine Materialkonstante in Ω·m, die beschreibt, wie gut ein Material elektrischen Strom leitet. Kupfer hat z.B. ρ = 1,68 × 10⁻⁸ Ω·m.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function fmtVal(v: number): string {
      if (!isFinite(v)) return '—';
      const abs = Math.abs(v);
      if (abs >= 1e6) return (v/1e6).toLocaleString('de-DE', {minimumFractionDigits:2,maximumFractionDigits:3}) + ' M';
      if (abs >= 1e3) return (v/1e3).toLocaleString('de-DE', {minimumFractionDigits:2,maximumFractionDigits:3}) + ' k';
      if (abs >= 1) return v.toLocaleString('de-DE', {minimumFractionDigits:2,maximumFractionDigits:4});
      if (abs >= 1e-3) return (v*1e3).toLocaleString('de-DE', {minimumFractionDigits:2,maximumFractionDigits:3}) + ' m';
      if (abs >= 1e-6) return (v*1e6).toLocaleString('de-DE', {minimumFractionDigits:2,maximumFractionDigits:3}) + ' µ';
      return v.toExponential(3);
    }
    function updateLabels() {
      const mode = (document.getElementById('og-mode') as HTMLSelectElement).value;
      const labels: Record<string, [string,string]> = {
        'UI': ['Spannung U (V)', 'Strom I (A)'],
        'UR': ['Spannung U (V)', 'Widerstand R (Ω)'],
        'UP': ['Spannung U (V)', 'Leistung P (W)'],
        'IR': ['Strom I (A)', 'Widerstand R (Ω)'],
        'IP': ['Strom I (A)', 'Leistung P (W)'],
        'RP': ['Widerstand R (Ω)', 'Leistung P (W)'],
      };
      document.getElementById('og-lbl1')!.textContent = labels[mode][0];
      document.getElementById('og-lbl2')!.textContent = labels[mode][1];
    }
    function calcOG() {
      updateLabels();
      const mode = (document.getElementById('og-mode') as HTMLSelectElement).value;
      const v1 = parseFloat((document.getElementById('og-val1') as HTMLInputElement).value);
      const v2 = parseFloat((document.getElementById('og-val2') as HTMLInputElement).value);
      if (isNaN(v1) || isNaN(v2) || v1 <= 0 || v2 <= 0) return;
      let U: number, I: number, R: number, P: number;
      const steps: string[] = [];
      switch(mode) {
        case 'UI': U=v1; I=v2; R=U/I; P=U*I; steps.push('R = U/I = '+fmtVal(U)+'V / '+fmtVal(I)+'A = '+fmtVal(R)+'Ω'); steps.push('P = U×I = '+fmtVal(U)+'V × '+fmtVal(I)+'A = '+fmtVal(P)+'W'); break;
        case 'UR': U=v1; R=v2; I=U/R; P=U*I; steps.push('I = U/R = '+fmtVal(U)+'V / '+fmtVal(R)+'Ω = '+fmtVal(I)+'A'); steps.push('P = U²/R = '+fmtVal(U)+'²/'+fmtVal(R)+' = '+fmtVal(P)+'W'); break;
        case 'UP': U=v1; P=v2; I=P/U; R=U/I; steps.push('I = P/U = '+fmtVal(P)+'W / '+fmtVal(U)+'V = '+fmtVal(I)+'A'); steps.push('R = U/I = '+fmtVal(U)+'V / '+fmtVal(I)+'A = '+fmtVal(R)+'Ω'); break;
        case 'IR': I=v1; R=v2; U=I*R; P=U*I; steps.push('U = I×R = '+fmtVal(I)+'A × '+fmtVal(R)+'Ω = '+fmtVal(U)+'V'); steps.push('P = I²×R = '+fmtVal(I)+'²×'+fmtVal(R)+' = '+fmtVal(P)+'W'); break;
        case 'IP': I=v1; P=v2; U=P/I; R=U/I; steps.push('U = P/I = '+fmtVal(P)+'W / '+fmtVal(I)+'A = '+fmtVal(U)+'V'); steps.push('R = U/I = '+fmtVal(U)+'V / '+fmtVal(I)+'A = '+fmtVal(R)+'Ω'); break;
        case 'RP': default: R=v1; P=v2; U=Math.sqrt(P*R); I=U/R; steps.push('U = √(P×R) = √('+fmtVal(P)+'×'+fmtVal(R)+') = '+fmtVal(U)+'V'); steps.push('I = U/R = '+fmtVal(U)+'V / '+fmtVal(R)+'Ω = '+fmtVal(I)+'A'); break;
      }
      document.getElementById('og-U')!.textContent = fmtVal(U!) + ' V';
      document.getElementById('og-I')!.textContent = fmtVal(I!) + ' A';
      document.getElementById('og-R')!.textContent = fmtVal(R!) + ' Ω';
      document.getElementById('og-P')!.textContent = fmtVal(P!) + ' W';
      document.getElementById('og-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('og-val1') as HTMLInputElement).value = '12';
      (document.getElementById('og-val2') as HTMLInputElement).value = '2';
      document.querySelectorAll('.og-in').forEach(el => { el.addEventListener('input', calcOG); el.addEventListener('change', calcOG); });
      calcOG();
    }, 50);
  </script>
</CalculatorLayout>
