---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mol Rechner - Mol, Gramm und Teilchenanzahl umrechnen";
const description = "Konvertieren Sie zwischen Mol, Gramm und Teilchenanzahl für chemische Berechnungen. Mit Avogadro-Konstante und Molmasse-Eingabe.";

const relatedCalcs = [
  { name: "Molaritäts Rechner", url: "/de/molaritaet-rechner", description: "Molarität berechnen." },
  { name: "pH-Wert Rechner", url: "/de/ph-wert-rechner", description: "pH-Wert berechnen." },
  { name: "Stöchiometrie-Rechner", url: "/de/stoichiometrie-rechner", description: "Reaktionsgleichungen." },
  { name: "Dichte-Rechner", url: "/de/dichterechner", description: "Dichte berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mole-calculator" calculatorName="Mol Rechner" keywords="Mol Rechner, Mol umrechnen, Avogadro, Teilchenanzahl, Molmasse, Gramm zu Mol" breadcrumbs={[{ name: "Mol Rechner", url: "/de/mol-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mol Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen Mol, Gramm, Teilchenanzahl und Gasvolumen (bei Normbedingungen) um. Grundlage für stöchiometrische Berechnungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Molmasse (g/mol)</label>
          <input type="number" id="mo-mw" class="mo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0.001" value="18.015">
          <p class="text-xs text-text-muted mt-1">H₂O = 18,015 | NaCl = 58,44 | CO₂ = 44,01 | C₆H₁₂O₆ = 180,16</p>
        </div>

        <div>
          <label class="block text-xs font-medium text-text mb-1">Bekannte Größe – Eingabe</label>
          <div class="flex gap-2">
            <select id="mo-unit" class="mo-in px-3 py-3 border border-border rounded-xl font-bold bg-white">
              <option value="mol">Mol (mol)</option>
              <option value="gram">Gramm (g)</option>
              <option value="particles">Teilchenanzahl</option>
            </select>
            <input type="number" id="mo-value" class="mo-in flex-1 px-4 py-3 border border-border rounded-xl text-lg font-bold" step="any" min="0" value="2">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mol</div>
          <div class="text-5xl font-extrabold font-mono" id="mo-mol">— mol</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Masse</div>
            <div class="text-xl font-bold" id="mo-gram">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Teilchenanzahl</div>
            <div class="text-sm font-bold" id="mo-particles">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gasvolumen (STP, 0°C)</div>
            <div class="text-xl font-bold" id="mo-vol-stp">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gasvolumen (NTP, 25°C)</div>
            <div class="text-xl font-bold" id="mo-vol-ntp">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rechenweg</h3>
          <div class="font-mono text-sm space-y-1" id="mo-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mole" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Mol – Grundeinheit der Stoffmenge</h2>
      <p>Das Mol (Einheitenzeichen: mol) ist die SI-Einheit der Stoffmenge. Ein Mol enthält genau 6,022 × 10²³ Teilchen (Atome, Moleküle, Ionen). Diese Zahl heißt Avogadro-Konstante (N_A). Die Molmasse M gibt an, wie viele Gramm ein Mol einer Substanz wiegt.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>n (mol) = m (g) / M (g/mol)</p>
        <p>N (Teilchen) = n × N_A = n × 6,022×10²³</p>
        <p>V_STP (L) = n × 22,414 L/mol (0°C, 101,325 kPa)</p>
        <p>V_NTP (L) = n × 24,465 L/mol (25°C, 101,325 kPa)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist die Avogadro-Konstante?</p>
          <p>Die Avogadro-Konstante N_A = 6,022 × 10²³ mol⁻¹ ist die Anzahl der Teilchen in einem Mol. Sie ist nach dem italienischen Chemiker Amedeo Avogadro benannt und ist eine fundamentale Naturkonstante.</p>
        </div>
        <div>
          <p class="font-semibold">Wie finde ich die Molmasse einer Verbindung?</p>
          <p>Addieren Sie die Atommassen aller Atome aus dem Periodensystem. Beispiel: CO₂ = 12,011 (C) + 2 × 15,999 (O) = 44,009 g/mol. Die Atommassen stehen unter dem Elementsymbol im PSE.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen STP und NTP?</p>
          <p>STP (Standard Temperature and Pressure): 0°C und 101,325 kPa. 1 mol Gas = 22,414 L. NTP (Normal Temperature and Pressure): 25°C und 101,325 kPa. 1 mol Gas = 24,465 L. Neuere IUPAC-Definitionen verwenden abweichende Werte.</p>
        </div>
        <div>
          <p class="font-semibold">Warum ist das Mol so wichtig in der Chemie?</p>
          <p>Chemische Reaktionen laufen nach festen Mol-Verhältnissen ab (Stöchiometrie). Ohne das Mol wäre es unmöglich, die für eine Reaktion benötigten Massen zu berechnen, da Atome auf Basis ihrer Anzahl, nicht ihrer Masse reagieren.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const AVOGADRO = 6.02214076e23;
    const MOLAR_VOL_STP = 22.414;
    const MOLAR_VOL_NTP = 24.465;

    function calcMo() {
      const mw = parseFloat((document.getElementById('mo-mw') as HTMLInputElement).value) || 18.015;
      const val = parseFloat((document.getElementById('mo-value') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('mo-unit') as HTMLSelectElement).value;

      const fmtSci = (v: number) => v.toExponential(4).replace('.', ',').replace('e+', '×10^').replace('e', '×10^');
      const fmt = (v: number, dec = 4) => v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });
      const steps: string[] = [];

      let moles: number;

      if (unit === 'mol') {
        moles = val;
        steps.push(`n = ${fmt(val)} mol (direkte Eingabe)`);
      } else if (unit === 'gram') {
        moles = val / mw;
        steps.push(`n = m / M = ${fmt(val)} g / ${fmt(mw)} g/mol = ${fmt(moles)} mol`);
      } else {
        moles = val / AVOGADRO;
        steps.push(`n = N / N_A = ${fmtSci(val)} / 6,022×10²³ = ${fmt(moles, 6)} mol`);
      }

      const mass = moles * mw;
      const particles = moles * AVOGADRO;
      const volSTP = moles * MOLAR_VOL_STP;
      const volNTP = moles * MOLAR_VOL_NTP;

      steps.push(`m = n × M = ${fmt(moles)} mol × ${fmt(mw)} g/mol = ${fmt(mass)} g`);
      steps.push(`N = n × N_A = ${fmt(moles)} × 6,022×10²³ = ${fmtSci(particles)}`);
      steps.push(`V(STP) = ${fmt(moles)} × 22,414 L/mol = ${fmt(volSTP)} L`);

      document.getElementById('mo-mol')!.textContent = fmt(moles) + ' mol';
      document.getElementById('mo-gram')!.textContent = fmt(mass) + ' g';
      document.getElementById('mo-particles')!.textContent = fmtSci(particles);
      document.getElementById('mo-vol-stp')!.textContent = fmt(volSTP) + ' L';
      document.getElementById('mo-vol-ntp')!.textContent = fmt(volNTP) + ' L';
      document.getElementById('mo-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.mo-in').forEach(el => {
        el.addEventListener('input', calcMo);
        el.addEventListener('change', calcMo);
      });
      calcMo();
    }, 50);
  </script>
</CalculatorLayout>
