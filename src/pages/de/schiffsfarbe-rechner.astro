---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schiffsfarbe Rechner - Farbverbrauch für Unterwasser und Decksanstrich";
const description = "Berechnen Sie den Farbverbrauch für Unterwasser- und Decksanstriche von Booten und Schiffen. Antifouling, Decksfarbe und Lacke richtig kalkulieren.";
const relatedCalcs = [
  { name: "Liegeplatz Rechner", url: "/de/liegeplatz-rechner", description: "Marinakosten berechnen." },
  { name: "Schiffsdiesel Rechner", url: "/de/schiffsdiesel-rechner", description: "Kraftstoffverbrauch Boot." },
  { name: "Mauermoertel Rechner", url: "/de/mauermoertel-rechner", description: "Mörtelmengen berechnen." },
  { name: "Metalloberfläche Rechner", url: "/de/metalloberflaeche-rechner", description: "Oberflächenbehandlung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="marine-paint-calculator" calculatorName="Schiffsfarbe Rechner" keywords="Schiffsfarbe Rechner, Antifouling Verbrauch, Bootslack, Deckfarbe Boot, Farbmenge Schiff" breadcrumbs={[{ name: "Schiffsfarbe Rechner", url: "/de/schiffsfarbe-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schiffsfarbe Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den genauen Farbverbrauch für den Unterwasseranstrich (Antifouling) und den Decksanstrich Ihres Bootes.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bootslänge (m)</label><input type="number" id="sf-len" class="sf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" min="2" max="60" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bootsbreite (m)</label><input type="number" id="sf-beam" class="sf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.2" min="0.5" max="20" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tiefgang (m)</label><input type="number" id="sf-draft" class="sf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.2" min="0.1" max="10" step="0.1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Rumpfform</label>
            <select id="sf-hull" class="sf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0.5">Segelboot / schlanker Rumpf</option>
              <option value="0.65" selected>Motorboot / Standardrumpf</option>
              <option value="0.8">Flachbodner / Arbeitsboot</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anstrichart</label>
            <select id="sf-type" class="sf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="antifouling" selected>Antifouling (Unterwasser)</option>
              <option value="deck">Decksfarbe</option>
              <option value="topside">Bordwandlack</option>
              <option value="primer">Grundierung</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Anstriche</label><input type="number" id="sf-coats" class="sf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Farbmenge</div>
          <div class="text-5xl font-extrabold font-mono" id="sf-total">--</div>
          <div class="text-sm text-blue-200 mt-1">Liter</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fläche</div><div class="text-xl font-bold" id="sf-area">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Anstrich</div><div class="text-xl font-bold" id="sf-per-coat">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empf. Gebindegröße</div><div class="text-xl font-bold" id="sf-packs">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="schiffsfarbe" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Anstriche für Boote und Schiffe</h2>
      <p>Der Farbverbrauch für Schiffsanstriche hängt von der Rumpfoberfläche, der Anstrichart und der Anzahl der Lagen ab. Antifouling-Farben für den Unterwasserbereich verbrauchen typischerweise 0,12–0,15 Liter pro Quadratmeter pro Anstrich. Decksfarben und Bordwandlacke benötigen ähnliche Mengen, bieten aber bessere Deckkraft. Planen Sie immer 10–15 % Verschnitt ein.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie oft muss Antifouling erneuert werden?</strong> In der Regel jährlich vor der Saison. Boote in wärmeren Gewässern oder mit intensiver Nutzung benötigen möglicherweise häufigere Erneuerungen.</p>
      <p><strong>Wie viel Liter Antifouling brauche ich?</strong> Für ein 9 Meter Boot mit Standardrumpf und 2 Anstrichen benötigen Sie ca. 4–6 Liter Antifouling-Farbe.</p>
      <p><strong>Was ist der Unterschied zwischen Hartantifouling und Weichantifouling?</strong> Hartantifouling eignet sich für schnelle Boote, Weichantifouling für langsame Schiffe und Dauerliegeplätze. Die Schichtdicke und Verbrauch unterscheiden sich kaum.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const sfCoverage: Record<string, number> = { antifouling: 8, deck: 10, topside: 12, primer: 7 };
    function calcSF() {
      const len = parseFloat((document.getElementById('sf-len') as HTMLInputElement).value) || 0;
      const beam = parseFloat((document.getElementById('sf-beam') as HTMLInputElement).value) || 0;
      const draft = parseFloat((document.getElementById('sf-draft') as HTMLInputElement).value) || 0;
      const prismatic = parseFloat((document.getElementById('sf-hull') as HTMLSelectElement).value) || 0.65;
      const type = (document.getElementById('sf-type') as HTMLSelectElement).value;
      const coats = parseInt((document.getElementById('sf-coats') as HTMLInputElement).value) || 1;
      let area = 0;
      if (type === 'antifouling') {
        area = (len * beam * 0.45 + 2 * len * draft + beam * draft) * prismatic;
      } else if (type === 'deck') {
        area = len * beam * 0.85;
      } else {
        area = (2 * len + beam) * 1.2;
      }
      const coverage = sfCoverage[type] || 10;
      const perCoat = area / coverage;
      const total = perCoat * coats * 1.1;
      const packs = Math.ceil(total / 2.5) * 2.5;
      const fmtM2 = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m²';
      const fmtL = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' L';
      document.getElementById('sf-total')!.textContent = total > 0 ? fmtL(total) : '--';
      document.getElementById('sf-area')!.textContent = area > 0 ? fmtM2(area) : '--';
      document.getElementById('sf-per-coat')!.textContent = perCoat > 0 ? fmtL(perCoat) : '--';
      document.getElementById('sf-packs')!.textContent = packs > 0 ? fmtL(packs) : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sf-in').forEach(el => { el.addEventListener('input', calcSF); el.addEventListener('change', calcSF); });
      calcSF();
    }, 50);
  </script>
</CalculatorLayout>
