---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Exponenten-Rechner - Potenzen berechnen";
const description = "Berechnen Sie Potenzen und Exponenten sofort. Finden Sie x hoch y, negative Exponenten, Br\u00fcche und wissenschaftliche Notation.";

const relatedCalcs = [
  { name: "Quadratwurzel-Rechner", url: "/de/quadratwurzel-rechner", description: "Wurzelberechnung." },
  { name: "Logarithmus-Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Bruchrechnung." },
  { name: "Prozent-Rechner", url: "/de/prozent-rechner", description: "Prozentrechnungen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Exponenten-Rechner" lang="de" enSlug="exponent-calculator" keywords="exponenten rechner, potenz rechner, x hoch y, potenzen, exponenten, wissenschaftliche notation" breadcrumbs={[{ name: "Exponenten-Rechner", url: "/de/exponenten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Exponenten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie jede Basis hoch jeden Exponenten. Unterst&uuml;tzt negative und gebrochene Exponenten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="flex items-end gap-3 justify-center mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Basis (x)</label><input type="number" id="exr-base" class="w-32 px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="2" step="any"></div>
        <div class="relative"><label class="block text-sm font-medium text-text mb-1">Exponent (y)</label><input type="number" id="exr-power" class="w-32 px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="10" step="any"></div>
        <div class="text-2xl font-bold text-text pb-3">=</div>
        <div class="pb-3"><div class="text-3xl font-extrabold text-primary" id="exr-result">1.024</div></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dezimal</div><div class="text-lg font-bold" id="exr-decimal">1024</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wissenschaftlich</div><div class="text-lg font-bold" id="exr-scientific">1.024e3</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kehrwert</div><div class="text-lg font-bold" id="exr-reciprocal">0,000977</div></div>
      </div>
      <div class="bg-surface-alt rounded-xl p-4 mb-6">
        <h3 class="font-semibold text-text text-sm mb-3">Potenzen von <span id="exr-table-base">2</span></h3>
        <div class="grid grid-cols-4 gap-2 text-sm" id="exr-powers-table"></div>
      </div>
      <ShareButton calculatorId="exponent-de" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Potenzregeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>x<sup>a</sup> &times; x<sup>b</sup> = x<sup>a+b</sup></p>
        <p>x<sup>a</sup> / x<sup>b</sup> = x<sup>a-b</sup></p>
        <p>(x<sup>a</sup>)<sup>b</sup> = x<sup>a&times;b</sup></p>
        <p>x<sup>0</sup> = 1 (jede Zahl au&szlig;er 0)</p>
        <p>x<sup>-a</sup> = 1 / x<sup>a</sup></p>
        <p>x<sup>1/n</sup> = n-te Wurzel von x</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist 0 hoch 0?</strong> Mathematisch wird 0&sup0; h&auml;ufig als 1 definiert, obwohl es in manchen Kontexten unbestimmt ist.</p>
      <p><strong>K&ouml;nnen Exponenten Br&uuml;che sein?</strong> Ja! x^(1/2) = Wurzel(x), x^(1/3) = Kubikwurzel(x).</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEXR() {
      const base = parseFloat((document.getElementById('exr-base') as HTMLInputElement).value);
      const power = parseFloat((document.getElementById('exr-power') as HTMLInputElement).value);
      if (isNaN(base) || isNaN(power)) return;
      const result = Math.pow(base, power);
      const isWhole = Number.isFinite(result) && Math.abs(result) < 1e15 && result === Math.round(result);
      document.getElementById('exr-result')!.textContent = isWhole ? Math.round(result).toLocaleString('de-DE') : (Number.isFinite(result) ? result.toPrecision(6) : 'Unendlich');
      document.getElementById('exr-decimal')!.textContent = Number.isFinite(result) ? result.toLocaleString('de-DE', { maximumFractionDigits: 8 }) : String(result);
      document.getElementById('exr-scientific')!.textContent = Number.isFinite(result) && result !== 0 ? result.toExponential(3) : String(result);
      const recip = result !== 0 ? 1 / result : Infinity;
      document.getElementById('exr-reciprocal')!.textContent = Number.isFinite(recip) ? recip.toPrecision(6) : String(recip);
      document.getElementById('exr-table-base')!.textContent = String(base);
      const table = document.getElementById('exr-powers-table')!;
      table.innerHTML = Array.from({ length: 12 }, (_, i) => {
        const p = i + 1; const v = Math.pow(base, p);
        const display = Math.abs(v) < 1e12 && v === Math.round(v) ? Math.round(v).toLocaleString('de-DE') : v.toExponential(2);
        return '<div class="p-1.5 ' + (p === power ? 'bg-primary/10 rounded font-bold text-primary' : '') + '"><span class="text-text-muted">' + base + '<sup>' + p + '</sup> = </span>' + display + '</div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('exr-base')!.addEventListener('input', calcEXR);
      document.getElementById('exr-power')!.addEventListener('input', calcEXR);
      calcEXR();
    }, 50);
  </script>
</CalculatorLayout>
