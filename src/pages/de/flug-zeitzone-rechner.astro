---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Flug-Zeitzone-Rechner - Ankunftszeiten & UTC-Offset";
const description = "Berechnen Sie Abflug- und Ankunftszeiten &uuml;ber Zeitzonen hinweg. Ber&uuml;cksichtigen Sie Datumsgrenze, UTC-Offsets und Jetlag-Schwere.";
const relatedCalcs = [
  { name: "Flugzeit", url: "/de/flugzeit-rechner", description: "Flugdauer." },
  { name: "Flugplan", url: "/de/flugplan-rechner", description: "Flugplanung." },
  { name: "Geschwindigkeit", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Peilungsrechner", url: "/de/peilungsrechner", description: "Peilungswinkel." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Flug-Zeitzone-Rechner" lang="de" enSlug="flight-time-zone-calculator" keywords="Flug Zeitzone, Ankunftszeit, Abflugzeit, UTC Offset, Datumsgrenze, Jetlag, Zeitzonendifferenz" breadcrumbs={[{ name: "Flug-Zeitzone", url: "/de/flug-zeitzone-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Flug-Zeitzone-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Abflug- und Ankunftszeiten &uuml;ber Zeitzonen hinweg mit Jetlag-Einsch&auml;tzung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-sm font-medium text-text mb-1">Abflugzeit (Ortszeit, 24h)</label><input type="time" id="fzz-deptime" class="fzz-in w-full border border-border rounded-lg px-3 py-2"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Abflug UTC-Offset (Stunden)</label>
          <select id="fzz-depoff" class="fzz-in w-full border border-border rounded-lg px-3 py-2">
            <option value="-12">UTC-12</option><option value="-11">UTC-11</option><option value="-10">UTC-10 (Hawaii)</option>
            <option value="-9">UTC-9 (Alaska)</option><option value="-8">UTC-8 (Pazifik)</option><option value="-7">UTC-7 (Mountain)</option>
            <option value="-6">UTC-6 (Central)</option><option value="-5">UTC-5 (Eastern)</option><option value="-4">UTC-4 (Atlantik)</option>
            <option value="-3">UTC-3 (Brasilien)</option><option value="-2">UTC-2</option><option value="-1">UTC-1</option>
            <option value="0">UTC+0 (London)</option><option value="1" selected>UTC+1 (Berlin/Paris)</option><option value="2">UTC+2 (Athen)</option>
            <option value="3">UTC+3 (Moskau)</option><option value="4">UTC+4 (Dubai)</option><option value="5">UTC+5 (Pakistan)</option>
            <option value="5.5">UTC+5:30 (Indien)</option><option value="6">UTC+6 (Bangladesch)</option><option value="7">UTC+7 (Bangkok)</option>
            <option value="8">UTC+8 (Singapur/Peking)</option><option value="9">UTC+9 (Tokio)</option><option value="10">UTC+10 (Sydney)</option>
            <option value="11">UTC+11</option><option value="12">UTC+12 (Auckland)</option><option value="13">UTC+13 (Samoa)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ankunft UTC-Offset (Stunden)</label>
          <select id="fzz-arroff" class="fzz-in w-full border border-border rounded-lg px-3 py-2">
            <option value="-12">UTC-12</option><option value="-11">UTC-11</option><option value="-10">UTC-10 (Hawaii)</option>
            <option value="-9">UTC-9 (Alaska)</option><option value="-8">UTC-8 (Pazifik)</option><option value="-7">UTC-7 (Mountain)</option>
            <option value="-6">UTC-6 (Central)</option><option value="-5" selected>UTC-5 (Eastern)</option><option value="-4">UTC-4 (Atlantik)</option>
            <option value="-3">UTC-3 (Brasilien)</option><option value="-2">UTC-2</option><option value="-1">UTC-1</option>
            <option value="0">UTC+0 (London)</option><option value="1">UTC+1 (Berlin/Paris)</option><option value="2">UTC+2 (Athen)</option>
            <option value="3">UTC+3 (Moskau)</option><option value="4">UTC+4 (Dubai)</option><option value="5">UTC+5 (Pakistan)</option>
            <option value="5.5">UTC+5:30 (Indien)</option><option value="6">UTC+6 (Bangladesch)</option><option value="7">UTC+7 (Bangkok)</option>
            <option value="8">UTC+8 (Singapur/Peking)</option><option value="9">UTC+9 (Tokio)</option><option value="10">UTC+10 (Sydney)</option>
            <option value="11">UTC+11</option><option value="12">UTC+12 (Auckland)</option><option value="13">UTC+13 (Samoa)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Flugdauer (Stunden)</label><input type="number" id="fzz-dur" class="fzz-in w-full border border-border rounded-lg px-3 py-2" min="0" max="24" step="0.25"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Flugdauer (Minuten)</label><input type="number" id="fzz-durm" class="fzz-in w-full border border-border rounded-lg px-3 py-2" min="0" max="59" step="5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ankunftszeit (Ortszeit)</div>
          <div class="text-5xl font-extrabold font-mono" id="fzz-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abflug UTC (Zulu)</div><div class="text-xl font-bold font-mono" id="fzz-depz">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ankunft UTC (Zulu)</div><div class="text-xl font-bold font-mono" id="fzz-arrz">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeitzonendifferenz</div><div class="text-xl font-bold font-mono" id="fzz-diff">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tageswechsel</div><div class="text-xl font-bold font-mono" id="fzz-day">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jetlag-Schwere</div><div class="text-xl font-bold font-mono" id="fzz-jetlag">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erholungstage (ca.)</div><div class="text-xl font-bold font-mono" id="fzz-recovery">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Flugrichtung</div>
          <div class="text-lg font-bold font-mono" id="fzz-direction">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="flight-time-zone" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Was ist Jetlag?</strong> Jetlag entsteht durch schnellen Wechsel &uuml;ber mehrere Zeitzonen und st&ouml;rt den Schlaf-Wach-Rhythmus.</p>
      <p><strong>Ist Ostwarts-Fliegen schlimmer?</strong> Ja, da der K&ouml;rper leichter verz&ouml;gert als beschleunigt, ist Jetlag bei Ostfl&uuml;gen st&auml;rker.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFZZ() {
      const depTimeStr = (document.getElementById('fzz-deptime') as HTMLInputElement).value || '08:00';
      const depOff = parseFloat((document.getElementById('fzz-depoff') as HTMLSelectElement).value);
      const arrOff = parseFloat((document.getElementById('fzz-arroff') as HTMLSelectElement).value);
      const durH = parseFloat((document.getElementById('fzz-dur') as HTMLInputElement).value) || 0;
      const durM = parseFloat((document.getElementById('fzz-durm') as HTMLInputElement).value) || 0;
      const parts = depTimeStr.split(':');
      const depHour = parseInt(parts[0]) || 0;
      const depMin = parseInt(parts[1]) || 0;
      const depLocalMins = depHour * 60 + depMin;
      const depUTCMins = depLocalMins - depOff * 60;
      const flightMins = durH * 60 + durM;
      const arrUTCMins = depUTCMins + flightMins;
      const arrLocalMins = arrUTCMins + arrOff * 60;
      let arrDays = Math.floor(arrLocalMins / (24 * 60));
      let arrMinsOfDay = ((arrLocalMins % (24 * 60)) + (24 * 60)) % (24 * 60);
      let depDays = Math.floor(depLocalMins / (24 * 60));
      let dayChange = arrDays - depDays;
      const arrH = Math.floor(arrMinsOfDay / 60);
      const arrMi = Math.round(arrMinsOfDay % 60);
      const pad = (n: number) => n.toString().padStart(2, '0');
      let depUTCNorm = ((depUTCMins % (24 * 60)) + (24 * 60)) % (24 * 60);
      let arrUTCNorm = ((arrUTCMins % (24 * 60)) + (24 * 60)) % (24 * 60);
      const tzDiff = arrOff - depOff;
      const absZoneDiff = Math.abs(tzDiff);
      let jetlag = '';
      let recovery = 0;
      if (absZoneDiff <= 2) { jetlag = 'Minimal'; recovery = 0; }
      else if (absZoneDiff <= 5) { jetlag = 'Leicht'; recovery = Math.ceil(absZoneDiff * 0.5); }
      else if (absZoneDiff <= 8) { jetlag = 'M\u00e4\u00dfig'; recovery = Math.ceil(absZoneDiff * 0.66); }
      else { jetlag = 'Stark'; recovery = Math.ceil(absZoneDiff * 0.75); }
      let direction = '';
      if (tzDiff > 0) direction = 'Ostw\u00e4rts (Zeitverlust, st\u00e4rkerer Jetlag)';
      else if (tzDiff < 0) direction = 'Westw\u00e4rts (Zeitgewinn, leichterer Jetlag)';
      else direction = 'Gleiche Zeitzone';
      document.getElementById('fzz-result')!.textContent = pad(arrH) + ':' + pad(arrMi);
      document.getElementById('fzz-depz')!.textContent = pad(Math.floor(depUTCNorm / 60)) + ':' + pad(Math.round(depUTCNorm % 60)) + 'Z';
      document.getElementById('fzz-arrz')!.textContent = pad(Math.floor(arrUTCNorm / 60)) + ':' + pad(Math.round(arrUTCNorm % 60)) + 'Z';
      document.getElementById('fzz-diff')!.textContent = (tzDiff >= 0 ? '+' : '') + tzDiff + ' Stunden';
      if (dayChange === 0) document.getElementById('fzz-day')!.textContent = 'Gleicher Tag';
      else if (dayChange === 1) document.getElementById('fzz-day')!.textContent = 'N\u00e4chster Tag (+1)';
      else if (dayChange === -1) document.getElementById('fzz-day')!.textContent = 'Vortag (-1)';
      else document.getElementById('fzz-day')!.textContent = (dayChange > 0 ? '+' : '') + dayChange + ' Tage';
      document.getElementById('fzz-jetlag')!.textContent = jetlag + ' (' + absZoneDiff + ' Zonen)';
      document.getElementById('fzz-recovery')!.textContent = recovery > 0 ? '~' + recovery + ' Tage' : 'Nicht n\u00f6tig';
      document.getElementById('fzz-direction')!.textContent = direction;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('fzz-deptime') as HTMLInputElement).value = '14:00';
      (document.getElementById('fzz-dur') as HTMLInputElement).value = '9';
      (document.getElementById('fzz-durm') as HTMLInputElement).value = '30';
      document.querySelectorAll('.fzz-in').forEach(el => { el.addEventListener('input', calcFZZ); el.addEventListener('change', calcFZZ); });
      calcFZZ();
    }, 50);
  </script>
</CalculatorLayout>
