---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Viehtränke Rechner – Wasserbedarf für Nutztiere berechnen";
const description = "Berechnen Sie den täglichen Wasserbedarf für verschiedene Nutztiere: Rinder, Schweine, Schafe, Geflügel und mehr.";
const relatedCalcs = [
  { name: "Lebendgestein Rechner", url: "/de/lebendgestein-rechner", description: "Aquarium." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten umrechnen." },
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
  { name: "Auslastungsgrad Rechner", url: "/de/auslastungsgrad-rechner", description: "Kapazität." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="livestock-water-calculator" calculatorName="Viehtränke Rechner" keywords="Viehtränke Rechner, Wasserbedarf Tiere, Rinder Wasser, Schweine Wasserbedarf, Geflügel Tränke" breadcrumbs={[{ name: "Viehtränke Rechner", url: "/de/viehtraenk-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Viehtränke Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den täglichen Gesamtwasserbedarf Ihres Tierbestands – für optimale Tränkeplanung und Wasserversorgung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <p class="text-sm font-semibold text-text">Tierbestand eingeben:</p>
        <div id="vtr-tiere" class="space-y-3"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Temperaturzuschlag</label>
          <select id="vtr-temp" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.0">Normal (unter 20°C)</option>
            <option value="1.15" selected>Warm (20–30°C) +15%</option>
            <option value="1.3">Heiß (über 30°C) +30%</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Gesamtwasserbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="vtr-result">0 L</div>
        </div>
        <div id="vtr-details" class="space-y-2"></div>
      </div>
      <ShareButton lang="de" calculatorId="viehtraenke" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Wasserbedarf von Nutztieren</h2>
      <p>Wasser ist das wichtigste Nährstoffmittel für Nutztiere. Wassermangel führt bereits bei 10 % Wasserverlust zu schwerwiegenden Gesundheitsschäden. Der Bedarf hängt von Tierart, Gewicht, Leistung (Milch, Eier), Futterfeuchte und Umgebungstemperatur ab. Kühe in der Hochlaktation können über 100 Liter täglich benötigen. Eine ausreichende, saubere Wasserversorgung ist nach Tierschutzgesetz gesetzlich vorgeschrieben.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viel Wasser braucht eine Milchkuh täglich?</summary>
          <p class="mt-2 text-sm text-text-secondary">Eine laktierende Milchkuh benötigt 80–120 Liter Wasser pro Tag, abhängig von Milchleistung, Futterart und Temperatur. Pro Liter produzierter Milch wird ca. 4–5 Liter Wasser benötigt.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viel Wasser braucht ein Schwein?</summary>
          <p class="mt-2 text-sm text-text-secondary">Mastschweine benötigen 5–10 Liter pro Tag, Sauen mit Ferkeln bis zu 30 Liter. Bei Trockenfütterung ist der Bedarf höher als bei Flüssigfütterung.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Warum steigt der Wasserbedarf bei Hitze?</summary>
          <p class="mt-2 text-sm text-text-secondary">Bei hohen Temperaturen erhöhen Tiere ihren Wasserverbrauch zur Thermoregulation (Schwitzen, Hecheln). Bei über 30°C kann der Bedarf um 30 % oder mehr steigen. Frisches, kühles Wasser ist dann besonders wichtig.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Welche Vorschriften gelten für die Wasserversorgung von Nutztieren?</summary>
          <p class="mt-2 text-sm text-text-secondary">Nach dem Tierschutzgesetz und der Tierschutz-Nutztierhaltungsverordnung müssen Nutztiere jederzeit Zugang zu frischem, sauberem Wasser haben. Tränkeeinrichtungen müssen regelmäßig gereinigt werden.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const vtrTierarten = [
      { name: "Milchkühe (laktierend)", id: "kuh_lakt", lPro: 80 },
      { name: "Rinder (Mast)", id: "rind_mast", lPro: 30 },
      { name: "Kälber", id: "kaelber", lPro: 8 },
      { name: "Schweine (Mast)", id: "schwein_mast", lPro: 7 },
      { name: "Sauen (mit Ferkeln)", id: "sauen", lPro: 20 },
      { name: "Schafe", id: "schafe", lPro: 5 },
      { name: "Ziegen", id: "ziegen", lPro: 4 },
      { name: "Pferde", id: "pferde", lPro: 40 },
      { name: "Legehennen (je 100 Tiere)", id: "hennen100", lPro: 25 },
      { name: "Masthähnchen (je 100 Tiere)", id: "haehner100", lPro: 20 },
    ];
    function renderTiere() {
      const container = document.getElementById('vtr-tiere')!;
      container.innerHTML = vtrTierarten.map(t => `
        <div class="flex items-center gap-3">
          <label class="flex-1 text-sm text-text">${t.name}</label>
          <input type="number" id="${t.id}" class="w-24 px-3 py-2 border border-border rounded-xl text-lg font-bold text-center" value="0" min="0" step="1" data-lpro="${t.lPro}">
          <span class="text-xs text-text-muted w-16">${t.lPro} L/Tag</span>
        </div>`).join('');
      vtrTierarten.forEach(t => document.getElementById(t.id)!.addEventListener('input', calcVtr));
    }
    function calcVtr() {
      const tempFaktor = parseFloat((document.getElementById('vtr-temp') as HTMLSelectElement).value) || 1.0;
      let gesamt = 0;
      const details: string[] = [];
      vtrTierarten.forEach(t => {
        const el = document.getElementById(t.id) as HTMLInputElement;
        const anz = parseFloat(el?.value) || 0;
        if (anz > 0) {
          const bedarf = anz * t.lPro * tempFaktor;
          gesamt += bedarf;
          details.push(`<div class="flex justify-between text-sm"><span>${t.name} (${anz} Stk.)</span><span class="font-mono font-bold">${bedarf.toLocaleString('de-DE', { maximumFractionDigits: 0 })} L</span></div>`);
        }
      });
      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.getElementById('vtr-result')!.textContent = fmt(gesamt) + ' L';
      const detailsEl = document.getElementById('vtr-details')!;
      if (details.length > 0) {
        detailsEl.innerHTML = '<div class="p-4 bg-surface-alt rounded-xl space-y-2"><h3 class="font-semibold text-sm text-text mb-2">Aufschlüsselung</h3>' + details.join('') + `<div class="border-t border-border pt-2 flex justify-between font-bold"><span>Gesamt</span><span class="font-mono">${fmt(gesamt)} L/Tag</span></div></div>`;
      } else {
        detailsEl.innerHTML = '<p class="text-sm text-text-muted text-center">Geben Sie Tieranzahlen ein, um den Bedarf zu berechnen.</p>';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      renderTiere();
      document.getElementById('vtr-temp')!.addEventListener('change', calcVtr);
      calcVtr();
    }, 50);
  </script>
</CalculatorLayout>
