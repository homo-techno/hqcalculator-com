---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Datumsrechner - Tage zwischen Daten, Tage addieren/subtrahieren";
const description = "Kostenloser Datumsrechner. Finden Sie die Anzahl der Tage zwischen zwei Daten oder addieren/subtrahieren Sie Tage von einem Datum. Arbeitstage und Kalenderrechnung.";

const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Exaktes Alter berechnen." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeit addieren." },
  { name: "Stundenrechner", url: "/de/stundenrechner", description: "Stunden zwischen Zeiten." },
  { name: "Schwangerschaftsrechner", url: "/de/schwangerschaftsrechner", description: "Geburtstermin." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="date-calculator" calculatorName="Datumsrechner" keywords="datumsrechner, tage zwischen daten, tage addieren, datumsdifferenz, arbeitstage rechner, datumsberechnung" breadcrumbs={[{ name: "Datumsrechner", url: "/de/datumsrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Datumsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Differenz zwischen Daten oder addieren/subtrahieren Sie Tage, Wochen, Monate oder Jahre.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="flex gap-2 mb-8">
        <button class="dtde-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-primary text-white" data-mode="diff">Tage zwischen Daten</button>
        <button class="dtde-mode-btn px-4 py-2 rounded-full text-sm font-semibold bg-surface-alt text-text-secondary" data-mode="add">Tage addieren/subtrahieren</button>
      </div>

      <div id="dtde-diff-mode">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Startdatum</label>
            <input type="date" id="dtde-start" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Enddatum</label>
            <input type="date" id="dtde-end" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Differenz</div>
          <div class="text-4xl sm:text-5xl font-extrabold" id="dtde-diff-days">0 Tage</div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Jahre, Monate, Tage</div>
            <div class="text-lg font-bold" id="dtde-diff-ymd">0J 0M 0T</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wochen</div>
            <div class="text-lg font-bold" id="dtde-diff-weeks">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Arbeitstage</div>
            <div class="text-lg font-bold" id="dtde-diff-business">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Stunden</div>
            <div class="text-lg font-bold" id="dtde-diff-hours">0</div>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Minuten</div>
            <div class="text-lg font-bold" id="dtde-diff-minutes">0</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sekunden</div>
            <div class="text-lg font-bold" id="dtde-diff-seconds">0</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wochenenden</div>
            <div class="text-lg font-bold" id="dtde-diff-weekends">0</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Monate gesamt</div>
            <div class="text-lg font-bold" id="dtde-diff-months">0</div>
          </div>
        </div>
      </div>

      <div id="dtde-add-mode" class="hidden">
        <div class="mb-6">
          <label class="block text-sm font-medium text-text mb-1">Startdatum</label>
          <input type="date" id="dtde-add-start" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
        </div>

        <div class="mb-6">
          <div class="flex gap-2 mb-3">
            <button class="dtde-addop-btn px-4 py-2 rounded-lg text-sm font-semibold bg-primary text-white" data-op="add">Addieren (+)</button>
            <button class="dtde-addop-btn px-4 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary" data-op="sub">Subtrahieren (&minus;)</button>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div>
              <label class="text-xs text-text-muted">Jahre</label>
              <input type="number" id="dtde-add-years" class="w-full px-3 py-2 border border-border rounded-lg text-center" value="0" min="0">
            </div>
            <div>
              <label class="text-xs text-text-muted">Monate</label>
              <input type="number" id="dtde-add-months" class="w-full px-3 py-2 border border-border rounded-lg text-center" value="0" min="0">
            </div>
            <div>
              <label class="text-xs text-text-muted">Wochen</label>
              <input type="number" id="dtde-add-weeks" class="w-full px-3 py-2 border border-border rounded-lg text-center" value="0" min="0">
            </div>
            <div>
              <label class="text-xs text-text-muted">Tage</label>
              <input type="number" id="dtde-add-days" class="w-full px-3 py-2 border border-border rounded-lg text-center" value="30" min="0">
            </div>
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ergebnis-Datum</div>
          <div class="text-3xl sm:text-4xl font-extrabold" id="dtde-add-result">&mdash;</div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wochentag</div>
            <div class="text-lg font-bold" id="dtde-add-dow">&mdash;</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Kalenderwoche</div>
            <div class="text-lg font-bold" id="dtde-add-weeknum">&mdash;</div>
          </div>
          <div class="p-3 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Tag im Jahr</div>
            <div class="text-lg font-bold" id="dtde-add-doy">&mdash;</div>
          </div>
        </div>
      </div>

      <div class="mt-6">
        <ShareButton lang="de" calculatorId="date" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">Schnelle Datumsreferenz</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" id="dtde-quick-ref"></div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">So funktionieren Datumsberechnungen</h2>
      <p>Datumsberechnungen helfen Ihnen, die Differenz zwischen zwei Daten zu finden oder ein zuk&uuml;nftiges/vergangenes Datum durch Addieren oder Subtrahieren von Zeiteinheiten zu bestimmen. Unser Rechner ber&uuml;cksichtigt automatisch Monate mit unterschiedlicher L&auml;nge, Schaltjahre und Arbeitstage.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Arbeitstage vs. Kalendertage</h3>
      <p>Arbeitstage (Werktage) schlie&szlig;en Samstage und Sonntage aus. Eine Kalenderwoche hat 7 Kalendertage, aber nur 5 Arbeitstage.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wird der Starttag mitgez&auml;hlt?</strong> Nein &mdash; die Z&auml;hlung beginnt ab dem Tag nach dem Startdatum. Beispiel: 1. Januar bis 2. Januar = 1 Tag.</p>
      <p><strong>Wie werden Arbeitstage berechnet?</strong> Arbeitstage schlie&szlig;en Samstage und Sonntage aus. Feiertage werden nicht ber&uuml;cksichtigt, da sie je nach Bundesland variieren.</p>
      <p><strong>Wie funktioniert das Addieren von Monaten?</strong> Einen Monat zum 31. Januar addieren ergibt den 28. Februar (oder 29. im Schaltjahr).</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let dtdeMode = 'diff';
    let dtdeAddOp = 'add';

    function formatDateLongDE(d: Date): string {
      return d.toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    }

    function getBusinessDaysDE(start: Date, end: Date): number {
      let count = 0;
      const d = new Date(start);
      while (d < end) {
        d.setDate(d.getDate() + 1);
        const dow = d.getDay();
        if (dow !== 0 && dow !== 6) count++;
      }
      return count;
    }

    function getWeekendDaysDE(start: Date, end: Date): number {
      let count = 0;
      const d = new Date(start);
      while (d < end) {
        d.setDate(d.getDate() + 1);
        const dow = d.getDay();
        if (dow === 0 || dow === 6) count++;
      }
      return count;
    }

    function getWeekNumberDE(d: Date): number {
      const oneJan = new Date(d.getFullYear(), 0, 1);
      const days = Math.floor((d.getTime() - oneJan.getTime()) / 86400000);
      return Math.ceil((days + oneJan.getDay() + 1) / 7);
    }

    function getDayOfYearDE(d: Date): number {
      const start = new Date(d.getFullYear(), 0, 0);
      return Math.floor((d.getTime() - start.getTime()) / 86400000);
    }

    function dateDiffDE(start: Date, end: Date): { years: number; months: number; days: number } {
      let years = end.getFullYear() - start.getFullYear();
      let months = end.getMonth() - start.getMonth();
      let days = end.getDate() - start.getDate();
      if (days < 0) {
        months--;
        const prevMonth = new Date(end.getFullYear(), end.getMonth(), 0);
        days += prevMonth.getDate();
      }
      if (months < 0) { years--; months += 12; }
      return { years, months, days };
    }

    function calcDateDiffDE() {
      const startStr = (document.getElementById('dtde-start') as HTMLInputElement).value;
      const endStr = (document.getElementById('dtde-end') as HTMLInputElement).value;
      if (!startStr || !endStr) return;

      const start = new Date(startStr + 'T00:00:00');
      const end = new Date(endStr + 'T00:00:00');
      const diffMs = Math.abs(end.getTime() - start.getTime());
      const totalDays = Math.round(diffMs / 86400000);

      const earlier = start < end ? start : end;
      const later = start < end ? end : start;
      const ymd = dateDiffDE(earlier, later);

      document.getElementById('dtde-diff-days')!.textContent = totalDays.toLocaleString('de-DE') + ' Tage';
      document.getElementById('dtde-diff-ymd')!.textContent = ymd.years + 'J ' + ymd.months + 'M ' + ymd.days + 'T';
      document.getElementById('dtde-diff-weeks')!.textContent = (totalDays / 7).toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('dtde-diff-business')!.textContent = getBusinessDaysDE(earlier, later).toLocaleString('de-DE');
      document.getElementById('dtde-diff-hours')!.textContent = (totalDays * 24).toLocaleString('de-DE');
      document.getElementById('dtde-diff-minutes')!.textContent = (totalDays * 1440).toLocaleString('de-DE');
      document.getElementById('dtde-diff-seconds')!.textContent = (totalDays * 86400).toLocaleString('de-DE');
      document.getElementById('dtde-diff-weekends')!.textContent = getWeekendDaysDE(earlier, later).toLocaleString('de-DE');
      document.getElementById('dtde-diff-months')!.textContent = String(ymd.years * 12 + ymd.months);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function calcDateAddDE() {
      const startStr = (document.getElementById('dtde-add-start') as HTMLInputElement).value;
      if (!startStr) return;

      const start = new Date(startStr + 'T00:00:00');
      const years = parseInt((document.getElementById('dtde-add-years') as HTMLInputElement).value) || 0;
      const months = parseInt((document.getElementById('dtde-add-months') as HTMLInputElement).value) || 0;
      const weeks = parseInt((document.getElementById('dtde-add-weeks') as HTMLInputElement).value) || 0;
      const days = parseInt((document.getElementById('dtde-add-days') as HTMLInputElement).value) || 0;

      const sign = dtdeAddOp === 'add' ? 1 : -1;
      const result = new Date(start);
      result.setFullYear(result.getFullYear() + sign * years);
      result.setMonth(result.getMonth() + sign * months);
      result.setDate(result.getDate() + sign * (weeks * 7 + days));

      document.getElementById('dtde-add-result')!.textContent = formatDateLongDE(result);
      document.getElementById('dtde-add-dow')!.textContent = result.toLocaleDateString('de-DE', { weekday: 'long' });
      document.getElementById('dtde-add-weeknum')!.textContent = 'KW ' + getWeekNumberDE(result);
      document.getElementById('dtde-add-doy')!.textContent = 'Tag ' + getDayOfYearDE(result);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function buildQuickRefDE() {
      const today = new Date();
      const items = [
        { label: '30 Tage ab jetzt', days: 30 },
        { label: '60 Tage ab jetzt', days: 60 },
        { label: '90 Tage ab jetzt', days: 90 },
        { label: '180 Tage ab jetzt', days: 180 },
        { label: '365 Tage ab jetzt', days: 365 },
        { label: 'Vor 30 Tagen', days: -30 },
        { label: 'Vor 90 Tagen', days: -90 },
        { label: 'Vor 1 Jahr', days: -365 },
      ];
      const container = document.getElementById('dtde-quick-ref')!;
      container.innerHTML = items.map(item => {
        const d = new Date(today);
        d.setDate(d.getDate() + item.days);
        return '<div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted">' + item.label + '</div><div class="font-bold text-sm">' + d.toLocaleDateString('de-DE', { day: 'numeric', month: 'short', year: 'numeric' }) + '</div></div>';
      }).join('');
    }

    setTimeout(() => {
      const today = new Date();
      const todayStr = today.toISOString().split('T')[0];
      const thirtyAgo = new Date(today);
      thirtyAgo.setDate(thirtyAgo.getDate() - 30);

      (document.getElementById('dtde-start') as HTMLInputElement).value = thirtyAgo.toISOString().split('T')[0];
      (document.getElementById('dtde-end') as HTMLInputElement).value = todayStr;
      (document.getElementById('dtde-add-start') as HTMLInputElement).value = todayStr;

      document.querySelectorAll('.dtde-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.dtde-mode-btn').forEach(b => {
            b.classList.remove('bg-primary', 'text-white');
            b.classList.add('bg-surface-alt', 'text-text-secondary');
          });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary');
          btn.classList.add('bg-primary', 'text-white');
          dtdeMode = (btn as HTMLElement).dataset.mode || 'diff';
          document.getElementById('dtde-diff-mode')!.classList.toggle('hidden', dtdeMode !== 'diff');
          document.getElementById('dtde-add-mode')!.classList.toggle('hidden', dtdeMode !== 'add');
        });
      });

      document.querySelectorAll('.dtde-addop-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.dtde-addop-btn').forEach(b => {
            b.classList.remove('bg-primary', 'text-white');
            b.classList.add('bg-surface-alt', 'text-text-secondary');
          });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary');
          btn.classList.add('bg-primary', 'text-white');
          dtdeAddOp = (btn as HTMLElement).dataset.op || 'add';
          calcDateAddDE();
        });
      });

      ['dtde-start', 'dtde-end'].forEach(id => {
        document.getElementById(id)!.addEventListener('change', calcDateDiffDE);
      });
      ['dtde-add-start'].forEach(id => {
        document.getElementById(id)!.addEventListener('change', calcDateAddDE);
      });
      ['dtde-add-years', 'dtde-add-months', 'dtde-add-weeks', 'dtde-add-days'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcDateAddDE);
      });

      calcDateDiffDE();
      calcDateAddDE();
      buildQuickRefDE();
    }, 50);
  </script>
</CalculatorLayout>
