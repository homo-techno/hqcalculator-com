---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Logarithmus Rechner – log₂, log₁₀, ln & beliebige Basis";
const description = "Berechnen Sie Logarithmen zu beliebigen Basen: log₂, log₁₀ (dekadischer Logarithmus), ln (natürlicher Logarithmus) und mehr.";
const relatedCalcs = [
  { name: "Lineare Gleichung Rechner", url: "/de/lineare-gleichung-rechner", description: "Gleichungen lösen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
  { name: "Linkbudget Rechner", url: "/de/linkbudget-rechner", description: "Dezibel & dB." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="logarithm-calculator" calculatorName="Logarithmus Rechner" keywords="Logarithmus Rechner, log berechnen, ln natürlicher Logarithmus, log2 log10, Logarithmenregeln" breadcrumbs={[{ name: "Logarithmus Rechner", url: "/de/logarithmus-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Logarithmus Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Logarithmen zu beliebigen Basen und wenden Sie Logarithmengesetze an.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Numerus x</label>
            <input type="number" id="log-x" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="100" step="any" min="0.000001">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Basis b</label>
            <select id="log-basis-sel" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="e">e (natürlicher Logarithmus)</option>
              <option value="10" selected>10 (dekadischer Logarithmus)</option>
              <option value="2">2 (Binärlogarithmus)</option>
              <option value="custom">Benutzerdefiniert</option>
            </select>
          </div>
        </div>
        <div id="log-custom-wrap" class="hidden">
          <label class="block text-sm font-medium text-text mb-1">Benutzerdefinierte Basis</label>
          <input type="number" id="log-basis-custom" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" step="any" min="0.001">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="log-label">log₁₀(100)</div>
          <div class="text-5xl font-extrabold font-mono" id="log-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="log-vergleich"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Logarithmengesetze</h3>
          <div class="text-sm space-y-1 font-mono" id="log-regeln"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Umkehrfunktion</h3>
          <div class="text-sm font-mono" id="log-umkehr"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="logarithmus" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Logarithmen verstehen und anwenden</h2>
      <p>Der Logarithmus ist die Umkehrfunktion der Potenz. log_b(x) = y bedeutet b^y = x. Wichtige Logarithmen sind: ln (natürlicher Logarithmus, Basis e ≈ 2,718), log₁₀ (dekadischer Logarithmus, Basis 10) und log₂ (Binärlogarithmus, Basis 2). Logarithmen spielen in der Mathematik, Informatik, Akustik (Dezibel) und Chemie (pH-Wert) eine zentrale Rolle.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der natürliche Logarithmus ln?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der natürliche Logarithmus (ln) hat die Eulersche Zahl e ≈ 2,71828 als Basis. Er ist die wichtigste Logarithmusfunktion in der Analysis und Mathematik. ln(e) = 1, ln(1) = 0.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was sind die Logarithmengesetze?</summary>
          <p class="mt-2 text-sm text-text-secondary">log(a × b) = log(a) + log(b) — Produktregel. log(a / b) = log(a) - log(b) — Quotientenregel. log(a^n) = n × log(a) — Potenzregel. log_b(x) = log(x) / log(b) — Basiswechsel.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wofür wird der Logarithmus verwendet?</summary>
          <p class="mt-2 text-sm text-text-secondary">Logarithmen beschreiben exponentielles Wachstum (Bevölkerung, Zinsen), Schallpegel (Dezibel = 20×log₁₀(p/p₀)), pH-Wert (pH = -log₁₀([H⁺])), Erdbebenstärke (Richterskala) und Informationsgehalt (Bit = log₂(n)).</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Warum ist der Logarithmus negativer Zahlen nicht definiert?</summary>
          <p class="mt-2 text-sm text-text-secondary">Im reellen Zahlenbereich ist b^y immer positiv (für b > 0). Daher kann log_b(x) nur für x > 0 berechnet werden. log_b(0) ist nicht definiert (geht gegen -∞), log_b(1) = 0 für jede Basis b.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie rechnet man den Logarithmus einer anderen Basis um?</summary>
          <p class="mt-2 text-sm text-text-secondary">Basiswechselformel: log_b(x) = ln(x) / ln(b) = log₁₀(x) / log₁₀(b). Damit kann jeder Logarithmus über den natürlichen oder dekadischen Logarithmus berechnet werden.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLog() {
      const x = parseFloat((document.getElementById('log-x') as HTMLInputElement).value) || 0;
      const basisSel = (document.getElementById('log-basis-sel') as HTMLSelectElement).value;
      const customWrap = document.getElementById('log-custom-wrap')!;
      customWrap.classList.toggle('hidden', basisSel !== 'custom');

      if (x <= 0) {
        document.getElementById('log-result')!.textContent = 'Ungültig (x > 0)';
        return;
      }

      let basis = 10, basisLabel = '10';
      if (basisSel === 'e') { basis = Math.E; basisLabel = 'e'; }
      else if (basisSel === '2') { basis = 2; basisLabel = '2'; }
      else if (basisSel === 'custom') {
        basis = parseFloat((document.getElementById('log-basis-custom') as HTMLInputElement).value) || 10;
        if (basis <= 0 || basis === 1) { document.getElementById('log-result')!.textContent = 'Basis ungültig'; return; }
        basisLabel = basis.toString();
      }

      const logVal = Math.log(x) / Math.log(basis);
      const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 8 });
      const fmtS = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 6 });

      document.getElementById('log-label')!.textContent = `log${basisLabel === 'e' ? '' : ('_' + basisLabel)}(${x})`;
      document.getElementById('log-result')!.textContent = fmt(logVal);

      const ln10 = Math.log10(x);
      const lnE = Math.log(x);
      const ln2 = Math.log2(x);
      document.getElementById('log-vergleich')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ln(x)</div><div class="text-lg font-bold font-mono">${fmtS(lnE)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">log₁₀(x)</div><div class="text-lg font-bold font-mono">${fmtS(ln10)}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">log₂(x)</div><div class="text-lg font-bold font-mono">${fmtS(ln2)}</div></div>`;

      const logAB = `log(${fmtS(x)} × ${fmtS(basis)}) = log(${fmtS(x)}) + log(${fmtS(basis)}) = ${fmtS(logVal)} + 1 = ${fmtS(logVal + 1)}`;
      document.getElementById('log-regeln')!.innerHTML = `
        <div>log(a × b) = log(a) + log(b)</div>
        <div>log(${fmtS(x)} × ${fmtS(basis)}) = ${fmtS(logVal)} + 1 = ${fmtS(logVal + 1)}</div>
        <div class="mt-2">log(a^n) = n × log(a)</div>
        <div>log(${fmtS(x)}²) = 2 × ${fmtS(logVal)} = ${fmtS(2 * logVal)}</div>`;
      document.getElementById('log-umkehr')!.textContent = `${basisLabel}^${fmtS(logVal)} = ${fmtS(x)} (Probe: ${fmtS(Math.pow(basis, logVal))})`;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('log-x')!.addEventListener('input', calcLog);
      document.getElementById('log-basis-sel')!.addEventListener('change', calcLog);
      document.getElementById('log-basis-custom')!.addEventListener('input', calcLog);
      calcLog();
    }, 50);
  </script>
</CalculatorLayout>
