---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Papierrechner - Menge, Gewicht & Kosten";
const description = "Berechnen Sie Papiermengen, -gewicht und -kosten für Druckprojekte. Ermitteln Sie den Papierbedarf für Broschüren, Flyer und Büropapier.";

const relatedCalcs = [
  { name: "Druckkosten-Rechner", url: "/de/druckkosten-rechner", description: "Druckkosten." },
  { name: "Papiergewicht-Rechner", url: "/de/papiergewicht-rechner", description: "Papiergewicht." },
  { name: "Papier-Falz Rechner", url: "/de/papier-falz-rechner", description: "Papierfaltung." },
  { name: "Kostenrechner", url: "/de/kostenrechner", description: "Projektkosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Papierrechner" lang="de" enSlug="paper-calculator" keywords="papierrechner, papierbedarf berechnen, papiergewicht, druckpapier kosten, g/m2 papier" breadcrumbs={[{ name: "Papierrechner", url: "/de/papier-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Papierrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Papiermengen, Gewicht und Kosten für Ihre Druckprojekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Papierformat</label>
            <select id="pp-format" class="pp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="a4">A4 (210 × 297 mm)</option>
              <option value="a3">A3 (297 × 420 mm)</option>
              <option value="a5">A5 (148 × 210 mm)</option>
              <option value="letter">Letter (216 × 279 mm)</option>
              <option value="a2">A2 (420 × 594 mm)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Grammatur (g/m²)</label><input type="number" id="pp-grm" class="pp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="40" max="400" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Seiten</label><input type="number" id="pp-pages" class="pp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Auflagenhöhe (Stück)</label><input type="number" id="pp-copies" class="pp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Doppelseitig</label><select id="pp-duplex" class="pp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="yes">Ja</option><option value="no">Nein</option></select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro 500 Blatt (€)</label><input type="number" id="pp-price" class="pp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.99" min="0" step="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Blätter</div>
          <div class="text-4xl font-extrabold font-mono" id="pp-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-xl font-bold" id="pp-weight">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pakete (500 Bl.)</div><div class="text-xl font-bold" id="pp-packs">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Papierkosten</div><div class="text-xl font-bold" id="pp-cost">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="papier-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Papierbedarf für Druckprojekte</h2>
      <p class="text-text-secondary mt-2">Die genaue Berechnung des Papierbedarfs vermeidet Engpässe und unnötige Mehrkosten. Beim Drucken von Broschüren, Flyern oder Geschäftsberichten müssen Seitenanzahl, Auflage und gewünschte Grammatur berücksichtigt werden. Schweres Papier (130–170 g/m²) eignet sich für Broschüren, leichtes Büropapier (80 g/m²) für Alltagsdrucke.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Blätter gesamt:</strong> ceil(Seiten / (Doppelseitig ? 2 : 1)) × Auflage</p>
        <p><strong>Gewicht:</strong> Blätter × Formatfläche (m²) × Grammatur (g/m²)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Grammatur ist für Bürodruck geeignet?</strong> Standardbüropapier hat 80 g/m². Für Präsentationen empfehlen sich 90–100 g/m², für Visitenkarten 250–350 g/m².</p>
      <p><strong>Wie viele DIN-A4-Blätter passen in einen Drucker?</strong> Die meisten Bürodrucker fassen 250–500 Blatt (80 g/m²). Bei schwereren Papieren reduziert sich die Kapazität entsprechend.</p>
      <p><strong>Was ist der Unterschied zwischen A4 und Letter?</strong> A4 (210 × 297 mm) ist der europäische Standard. Letter (216 × 279 mm) wird hauptsächlich in den USA verwendet und ist etwas breiter aber kürzer.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const ppEuro = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

    function calcPP() {
      const format = (document.getElementById('pp-format') as HTMLSelectElement).value;
      const grm = parseFloat((document.getElementById('pp-grm') as HTMLInputElement).value) || 80;
      const pages = parseInt((document.getElementById('pp-pages') as HTMLInputElement).value) || 100;
      const copies = parseInt((document.getElementById('pp-copies') as HTMLInputElement).value) || 500;
      const duplex = (document.getElementById('pp-duplex') as HTMLSelectElement).value === 'yes';
      const price500 = parseFloat((document.getElementById('pp-price') as HTMLInputElement).value) || 4.99;

      const areas: Record<string, number> = { a4: 0.210 * 0.297, a3: 0.297 * 0.420, a5: 0.148 * 0.210, letter: 0.216 * 0.279, a2: 0.420 * 0.594 };
      const area = areas[format] || areas['a4'];
      const pagesPerSheet = duplex ? 2 : 1;
      const sheetsPerCopy = Math.ceil(pages / pagesPerSheet);
      const totalSheets = sheetsPerCopy * copies;
      const weightG = totalSheets * area * grm;
      const packs = Math.ceil(totalSheets / 500);
      const cost = packs * price500;

      document.getElementById('pp-result')!.textContent = totalSheets.toLocaleString('de-DE');
      document.getElementById('pp-weight')!.textContent = (weightG / 1000).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' kg';
      document.getElementById('pp-packs')!.textContent = packs.toLocaleString('de-DE');
      document.getElementById('pp-cost')!.textContent = ppEuro(cost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pp-in').forEach(el => { el.addEventListener('input', calcPP); el.addEventListener('change', calcPP); });
      calcPP();
    }, 50);
  </script>
</CalculatorLayout>
