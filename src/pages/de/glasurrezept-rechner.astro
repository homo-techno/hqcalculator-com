---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Glasurrezept-Rechner - Ansatz-Skalierung & Seger-Formel";
const description = "Skalieren Sie Glasurrezepte von der Einheitsformel (Seger-Formel). Umrechnung zwischen Prozent- und Grammgewicht für jede Ansatzgröße.";
const relatedCalcs = [
  { name: "Glasurchemie-Rechner", url: "/de/glasurchemie-rechner", description: "Glasur-Oxidverhältnisse." },
  { name: "Glasfusing-Rechner", url: "/de/glasfusing-rechner", description: "Glasfusing-Brennpläne." },
  { name: "Glasdicke-Rechner", url: "/de/glasdicke-rechner", description: "Glasdicke berechnen." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Glasurrezept-Rechner" enSlug="glaze-recipe-calculator" keywords="Glasurrezept, Ansatzrezept, Seger-Formel, Einheitsformel, Glasur skalieren, Keramikglasur, Töpferglasur" breadcrumbs={[{ name: "Glasurrezept-Rechner", url: "/de/glasurrezept-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Glasurrezept-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Skalieren Sie Glasurrezepte auf jede gewünschte Ansatzgröße. Geben Sie Ihre Rezeptprozente und die gewünschte Gesamtmenge ein.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Gewünschte Ansatzgröße (Gramm)</label>
        <input type="number" id="grz-batch" class="grz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="1" step="50">
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Basis-Glasurrezept (Prozentrezept)</label>
        <div class="space-y-2" id="grz-ingredients">
          <div class="grid grid-cols-12 gap-2 items-center">
            <div class="col-span-6"><input type="text" class="grz-name w-full px-3 py-2 border border-border rounded-lg text-sm" value="Feldspat" placeholder="Materialname"></div>
            <div class="col-span-4"><input type="number" class="grz-pct grz-in w-full px-3 py-2 border border-border rounded-lg text-sm font-bold" value="40" min="0" max="100" step="0.1" placeholder="%"></div>
            <div class="col-span-2 text-right"><span class="grz-grams text-sm font-mono font-bold">--</span></div>
          </div>
          <div class="grid grid-cols-12 gap-2 items-center">
            <div class="col-span-6"><input type="text" class="grz-name w-full px-3 py-2 border border-border rounded-lg text-sm" value="Quarz" placeholder="Materialname"></div>
            <div class="col-span-4"><input type="number" class="grz-pct grz-in w-full px-3 py-2 border border-border rounded-lg text-sm font-bold" value="25" min="0" max="100" step="0.1" placeholder="%"></div>
            <div class="col-span-2 text-right"><span class="grz-grams text-sm font-mono font-bold">--</span></div>
          </div>
          <div class="grid grid-cols-12 gap-2 items-center">
            <div class="col-span-6"><input type="text" class="grz-name w-full px-3 py-2 border border-border rounded-lg text-sm" value="Kreide" placeholder="Materialname"></div>
            <div class="col-span-4"><input type="number" class="grz-pct grz-in w-full px-3 py-2 border border-border rounded-lg text-sm font-bold" value="20" min="0" max="100" step="0.1" placeholder="%"></div>
            <div class="col-span-2 text-right"><span class="grz-grams text-sm font-mono font-bold">--</span></div>
          </div>
          <div class="grid grid-cols-12 gap-2 items-center">
            <div class="col-span-6"><input type="text" class="grz-name w-full px-3 py-2 border border-border rounded-lg text-sm" value="Kaolin" placeholder="Materialname"></div>
            <div class="col-span-4"><input type="number" class="grz-pct grz-in w-full px-3 py-2 border border-border rounded-lg text-sm font-bold" value="15" min="0" max="100" step="0.1" placeholder="%"></div>
            <div class="col-span-2 text-right"><span class="grz-grams text-sm font-mono font-bold">--</span></div>
          </div>
          <div class="grid grid-cols-12 gap-2 items-center">
            <div class="col-span-6"><input type="text" class="grz-name w-full px-3 py-2 border border-border rounded-lg text-sm" value="" placeholder="Materialname"></div>
            <div class="col-span-4"><input type="number" class="grz-pct grz-in w-full px-3 py-2 border border-border rounded-lg text-sm font-bold" value="" min="0" max="100" step="0.1" placeholder="%"></div>
            <div class="col-span-2 text-right"><span class="grz-grams text-sm font-mono font-bold">--</span></div>
          </div>
          <div class="grid grid-cols-12 gap-2 items-center">
            <div class="col-span-6"><input type="text" class="grz-name w-full px-3 py-2 border border-border rounded-lg text-sm" value="" placeholder="Materialname"></div>
            <div class="col-span-4"><input type="number" class="grz-pct grz-in w-full px-3 py-2 border border-border rounded-lg text-sm font-bold" value="" min="0" max="100" step="0.1" placeholder="%"></div>
            <div class="col-span-2 text-right"><span class="grz-grams text-sm font-mono font-bold">--</span></div>
          </div>
        </div>
        <div class="text-xs text-text-muted mt-1">Geben Sie Materialnamen und Prozente ein. Gramm werden automatisch berechnet.</div>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Farbmittel / Zusatz (% der Basis, wird obendrauf addiert)</label>
        <div class="grid grid-cols-12 gap-2 items-center">
          <div class="col-span-6"><input type="text" id="grz-add-name" class="w-full px-3 py-2 border border-border rounded-lg text-sm" value="" placeholder="z.B. Eisenoxid"></div>
          <div class="col-span-4"><input type="number" id="grz-add-pct" class="grz-in w-full px-3 py-2 border border-border rounded-lg text-sm font-bold" value="" min="0" max="50" step="0.1" placeholder="%"></div>
          <div class="col-span-2 text-right"><span id="grz-add-grams" class="text-sm font-mono font-bold">--</span></div>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtgewicht Ansatz</div>
        <div class="text-4xl font-extrabold" id="grz-total">--</div>
        <div class="text-sm text-blue-200 mt-1">Gramm</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rezept Gesamt %</div><div class="text-xl font-bold" id="grz-pct-total">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser zugeben (~)</div><div class="text-xl font-bold" id="grz-water">--</div></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <p class="text-xs text-text-muted" id="grz-note">--</p>
      </div>

      <ShareButton lang="de" calculatorId="glasurrezept" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">So skalieren Sie Glasurrezepte</h2>
      <p>Ein Glasurrezept wird typischerweise in Prozenten angegeben, die zusammen 100% ergeben. Um auf eine Ansatzgröße zu skalieren, multiplizieren Sie jeden Prozentsatz mit der gewünschten Gesamtgramm-Menge und teilen durch 100. Farbmittel und Zusätze werden auf die 100%-Basis obendrauf addiert.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Wasser brauche ich?</strong> Typischerweise 50-70% Wasser bezogen auf das Trockengewicht der Materialien. Für Tauchglasuren etwa 55%.</p>
      <p><strong>Wie mische ich eine Glasur richtig?</strong> Wiegen Sie alle Materialien auf einer Grammwaage ab, mischen Sie trocken, geben Sie Wasser schrittweise hinzu und sieben Sie mindestens zweimal durch ein 80er-Sieb.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcGRZ() {
      const batch = parseFloat((document.getElementById('grz-batch') as HTMLInputElement).value) || 0;
      const pctInputs = document.querySelectorAll('.grz-pct');
      const gramSpans = document.querySelectorAll('.grz-grams');

      let totalPct = 0;
      let totalGrams = 0;

      pctInputs.forEach((input, i) => {
        const pct = parseFloat((input as HTMLInputElement).value) || 0;
        totalPct += pct;
        const grams = (pct / 100) * batch;
        totalGrams += grams;
        if (gramSpans[i]) {
          (gramSpans[i] as HTMLElement).textContent = grams > 0 ? grams.toFixed(1) + 'g' : '--';
        }
      });

      const addPct = parseFloat((document.getElementById('grz-add-pct') as HTMLInputElement).value) || 0;
      const addGrams = (addPct / 100) * batch;
      document.getElementById('grz-add-grams')!.textContent = addGrams > 0 ? addGrams.toFixed(1) + 'g' : '--';

      const grandTotal = totalGrams + addGrams;
      document.getElementById('grz-total')!.textContent = grandTotal.toFixed(0);
      document.getElementById('grz-pct-total')!.textContent = totalPct.toFixed(1) + '%';

      const water = Math.round(grandTotal * 0.55);
      document.getElementById('grz-water')!.textContent = water + 'g';

      let note = '';
      if (totalPct < 99.5) note = 'Achtung: Rezeptprozente summieren sich auf weniger als 100%. Pr\u00fcfen Sie Ihr Rezept.';
      else if (totalPct > 100.5) note = 'Achtung: Rezeptprozente summieren sich auf mehr als 100%. Pr\u00fcfen Sie Ihr Rezept.';
      else note = 'Rezept sieht ausgewogen aus. Wasser schrittweise zugeben und durch 80er-Sieb sieben.';
      document.getElementById('grz-note')!.textContent = note;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.grz-in').forEach(el => {
        el.addEventListener('input', calcGRZ);
        el.addEventListener('change', calcGRZ);
      });
      calcGRZ();
    }, 50);
  </script>
</CalculatorLayout>
