---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ballastrechner - Stabilität, Metazentrische Höhe & Aufrichtendes Moment";
const description = "Berechnen Sie Ballastgewicht für Bootsstabilität, metazentrische Höhe und aufrichtendes Moment für sichere Schiffskonstruktion.";
const relatedCalcs = [
  { name: "Auftrieb", url: "/de/auftrieb-rechner", description: "Auftriebsberechnungen." },
  { name: "Bootskredit", url: "/de/bootskredit-rechner", description: "Schiffsfinanzierung." },
  { name: "Dichte", url: "/de/dichte-rechner", description: "Dichteberechnungen." },
  { name: "Seemeile", url: "/de/seemeile-rechner", description: "Nautische Entfernung." },
  { name: "Großkreis", url: "/de/grosskreis-rechner", description: "Großkreisnavigation." },
  { name: "Peilung", url: "/de/peilung-rechner", description: "Navigationspeilungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Ballastrechner" keywords="Ballastrechner, metazentrische Höhe, aufrichtendes Moment, Bootsstabilität, Ballastgewicht, GM Stabilität, Schiffsstabilität" breadcrumbs={[{ name: "Ballast", url: "/de/ballast-rechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ballastrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ballastgewichtsbedarf, metazentrische Höhe (GM) und aufrichtendes Moment für Schiffsstabilitätsanalyse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verdrängung (kg)</label><input type="number" id="ba-disp" class="ba-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (m)</label><input type="number" id="ba-beam" class="ba-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.5" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tiefgang (m)</label><input type="number" id="ba-draft" class="ba-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">VCG über Wasserlinie (m)</label><input type="number" id="ba-vcg" class="ba-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ballasttiefe unter WL (m)</label><input type="number" id="ba-bdepth" class="ba-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.1" step="0.1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ballastmaterial</label>
            <select id="ba-mat" class="ba-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="11370">Blei (11.370 kg/m&sup3;)</option>
              <option value="7200">Gusseisen (7.200 kg/m&sup3;)</option>
              <option value="7850">Stahl (7.850 kg/m&sup3;)</option>
              <option value="2400">Beton (2.400 kg/m&sup3;)</option>
              <option value="1025">Wasserballast (1.025 kg/m&sup3;)</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Gewünschtes Ballastverhältnis (%)</label><input type="number" id="ba-ratio" class="ba-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="10" max="60" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Ballast</div>
          <div class="text-5xl font-extrabold font-mono" id="ba-weight">--</div>
          <div class="text-sm text-blue-200 mt-1">Kilogramm</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">GM (Metazentrisch)</div><div class="text-xl font-bold" id="ba-gm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufr. Moment</div><div class="text-xl font-bold" id="ba-rm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ballastvolumen</div><div class="text-xl font-bold" id="ba-vol">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stabilitätsbewertung</div><div class="text-xl font-bold" id="ba-stab">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">AVS Schätzung</div><div class="text-xl font-bold" id="ba-avs">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="ballast" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBA() {
      const disp = parseFloat((document.getElementById('ba-disp') as HTMLInputElement).value) || 0;
      const beam = parseFloat((document.getElementById('ba-beam') as HTMLInputElement).value) || 0;
      const draft = parseFloat((document.getElementById('ba-draft') as HTMLInputElement).value) || 0;
      const vcg = parseFloat((document.getElementById('ba-vcg') as HTMLInputElement).value) || 0;
      const bDepth = parseFloat((document.getElementById('ba-bdepth') as HTMLInputElement).value) || 0;
      const matDensity = parseFloat((document.getElementById('ba-mat') as HTMLSelectElement).value) || 11370;
      const ratio = (parseFloat((document.getElementById('ba-ratio') as HTMLInputElement).value) || 35) / 100;

      const ballastWeight = disp * ratio;
      const ballastVolume = matDensity > 0 ? ballastWeight / matDensity : 0;

      const bm = draft > 0 ? (beam * beam) / (12 * draft) : 0;
      const cb = draft / 2;
      const cg = (disp * vcg - ballastWeight * bDepth) / disp;
      const bg = cb + cg;
      const gm = bm - bg;

      const rm15 = disp * 9.81 * gm * Math.sin(15 * Math.PI / 180);

      let stability = '--';
      if (gm > 0) {
        if (gm >= 1) stability = 'Sehr steif';
        else if (gm >= 0.6) stability = 'Steif';
        else if (gm >= 0.3) stability = 'Moderat';
        else if (gm >= 0.15) stability = 'Rank';
        else stability = 'Sehr rank';
      } else if (gm <= 0) {
        stability = 'INSTABIL';
      }

      const avs = gm > 0 ? Math.min(180, 90 + (gm / beam) * 100 + ratio * 100) : 0;

      document.getElementById('ba-weight')!.textContent = ballastWeight > 0 ? Math.round(ballastWeight).toLocaleString('de-DE') : '--';
      document.getElementById('ba-gm')!.textContent = gm !== 0 ? gm.toFixed(2).replace('.', ',') + ' m' : '--';
      document.getElementById('ba-rm')!.textContent = rm15 !== 0 ? Math.round(rm15).toLocaleString('de-DE') + ' N\u00B7m' : '--';
      document.getElementById('ba-vol')!.textContent = ballastVolume > 0 ? ballastVolume.toFixed(3).replace('.', ',') + ' m\u00B3' : '--';
      document.getElementById('ba-stab')!.textContent = stability;
      document.getElementById('ba-avs')!.textContent = avs > 0 ? avs.toFixed(0) + '\u00B0' : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ba-disp') as HTMLInputElement).value = '7000';
      (document.getElementById('ba-beam') as HTMLInputElement).value = '3';
      (document.getElementById('ba-draft') as HTMLInputElement).value = '1.5';
      (document.getElementById('ba-vcg') as HTMLInputElement).value = '0.6';
      (document.getElementById('ba-bdepth') as HTMLInputElement).value = '1.2';
      (document.getElementById('ba-ratio') as HTMLInputElement).value = '35';
      document.querySelectorAll('.ba-in').forEach(el => { el.addEventListener('input', calcBA); el.addEventListener('change', calcBA); });
      calcBA();
    }, 50);
  </script>
</CalculatorLayout>
