---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lieferroute-Rechner - Routenplanung & Kosten";
const description = "Schaetzen Sie Routenentfernung, Zeit, Stopps pro Route, Kosten pro Lieferung und Effizienzmetriken fuer die Lieferplanung.";

const relatedCalcs = [
  { name: "Spritkostenrechner", url: "/de/spritkosten-rechner", description: "Kraftstoffkosten." },
  { name: "Pendelkosten-Rechner", url: "/de/pendelkosten-rechner", description: "Pendelkosten." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="delivery-route-calculator" calculatorName="Lieferroute-Rechner" keywords="lieferroute, routenplanung, kosten pro lieferung, liefereffizienz, stopps pro route, letzte meile" breadcrumbs={[{ name: "Lieferroute-Rechner", url: "/de/lieferroute-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lieferroute-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Lieferrouten mit Kosten pro Stopp, Zeitsch&auml;tzungen und Effizienzmetriken.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Gesamte Routenentfernung (km)</label><input type="number" id="lr-distance" class="lr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="1" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Anzahl Stopps</label><input type="number" id="lr-stops" class="lr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Durchschnittl. Zeit pro Stopp (Min.)</label><input type="number" id="lr-stoptime" class="lr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Durchschnittl. Geschwindigkeit (km/h)</label><input type="number" id="lr-speed" class="lr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="5" step="1"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kraftstoffkosten (&euro;/km)</label><input type="number" id="lr-fuelcost" class="lr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0.01" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fahrer-Stundensatz (&euro;)</label><input type="number" id="lr-hourly" class="lr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kosten pro Lieferung</div>
          <div class="text-5xl font-extrabold font-mono" id="lr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Routenzeit</div><div class="text-xl font-bold font-mono" id="lr-totaltime">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Routenkosten</div><div class="text-xl font-bold font-mono" id="lr-totalcost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">km pro Stopp</div><div class="text-xl font-bold font-mono" id="lr-kmstop">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stopps pro Stunde</div><div class="text-xl font-bold font-mono" id="lr-stopshr">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="delivery-route" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Lieferrouten effizient planen</h2>
      <p>Die Kosten pro Lieferung setzen sich aus Kraftstoff, Arbeitszeit und Fahrzeugeinsatz zusammen. Effiziente Routenplanung kann diese Kosten erheblich senken.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie reduziere ich die Kosten pro Lieferung?</strong> Stopps clustern, Routen optimieren, R&uuml;ckfahrten vermeiden und Lieferzeitfenster effizient planen.</p>
      <p><strong>Was ist eine gute Stopp-Rate?</strong> 3-5 Stopps pro Stunde in st&auml;dtischen Gebieten, 1-2 Stopps pro Stunde im l&auml;ndlichen Raum.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLR() {
      const distance = parseFloat((document.getElementById('lr-distance') as HTMLInputElement).value) || 0;
      const stops = parseFloat((document.getElementById('lr-stops') as HTMLInputElement).value) || 0;
      const stopTime = parseFloat((document.getElementById('lr-stoptime') as HTMLInputElement).value) || 0;
      const speed = parseFloat((document.getElementById('lr-speed') as HTMLInputElement).value) || 1;
      const fuelCost = parseFloat((document.getElementById('lr-fuelcost') as HTMLInputElement).value) || 0;
      const hourly = parseFloat((document.getElementById('lr-hourly') as HTMLInputElement).value) || 0;

      const driveTimeHrs = distance / speed;
      const stopTimeHrs = (stops * stopTime) / 60;
      const totalTimeHrs = driveTimeHrs + stopTimeHrs;

      const fuelTotal = distance * fuelCost;
      const laborTotal = totalTimeHrs * hourly;
      const totalCost = fuelTotal + laborTotal;
      const costPerDelivery = stops > 0 ? totalCost / stops : 0;
      const kmPerStop = stops > 0 ? distance / stops : 0;
      const stopsPerHour = totalTimeHrs > 0 ? stops / totalTimeHrs : 0;

      const hrs = Math.floor(totalTimeHrs);
      const mins = Math.round((totalTimeHrs - hrs) * 60);

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

      document.getElementById('lr-result')!.textContent = fmt(costPerDelivery);
      document.getElementById('lr-totaltime')!.textContent = hrs + ' Std ' + mins + ' Min';
      document.getElementById('lr-totalcost')!.textContent = fmt(totalCost);
      document.getElementById('lr-kmstop')!.textContent = kmPerStop.toFixed(1).replace('.', ',') + ' km';
      document.getElementById('lr-stopshr')!.textContent = stopsPerHour.toFixed(1).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('lr-distance') as HTMLInputElement).value = '200';
      (document.getElementById('lr-stops') as HTMLInputElement).value = '25';
      (document.getElementById('lr-stoptime') as HTMLInputElement).value = '8';
      (document.getElementById('lr-speed') as HTMLInputElement).value = '50';
      (document.getElementById('lr-fuelcost') as HTMLInputElement).value = '0.15';
      (document.getElementById('lr-hourly') as HTMLInputElement).value = '18';
      document.querySelectorAll('.lr-in').forEach(el => { el.addEventListener('input', calcLR); el.addEventListener('change', calcLR); });
      calcLR();
    }, 50);
  </script>
</CalculatorLayout>
