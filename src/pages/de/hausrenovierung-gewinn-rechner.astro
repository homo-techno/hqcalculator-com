---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hausrenovierung Gewinn Rechner - Immobilien Flip Gewinn 2026";
const description = "Berechne den Gewinn, ROI und pruefe die 70%-Regel beim Immobilien-Flipping mit Kaufpreis, Renovierungskosten und Verkehrswert nach Sanierung.";

const relatedCalcs = [
  { name: "Eigenkapital-Rechner", url: "/de/eigenkapital-rechner", description: "Eigenkapital berechnen." },
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothekenrate." },
  { name: "Hauskauf-Leistbarkeit-Rechner", url: "/de/hauskauf-leistbarkeit-rechner", description: "Leistbarkeit pruefen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Kapitalrendite." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hausrenovierung-Gewinn-Rechner" keywords="Immobilien Flip Rechner, Renovierung Gewinn, ARV, Sanierungskosten, 70-Prozent-Regel, Immobilien ROI" breadcrumbs={[{ name: "Hausrenovierung-Gewinn-Rechner", url: "/de/hausrenovierung-gewinn-rechner" }]} lang="de" enSlug="house-flipping-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hausrenovierung-Gewinn-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetze deinen Flip-Gewinn, ROI und pruefe, ob das Objekt die 70-%-Regel erfuellt.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Kaufpreis (€)</label><input type="number" id="hrg-purchase" class="hrg-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="150000" min="0" step="1000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Renovierungs-/Sanierungskosten (€)</label><input type="number" id="hrg-rehab" class="hrg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40000" min="0" step="1000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Verkehrswert nach Sanierung (VNS, €)</label><input type="number" id="hrg-arv" class="hrg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="250000" min="0" step="1000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Haltekosten (€) (Grundsteuer, Versicherung, Zinsen)</label><input type="number" id="hrg-holding" class="hrg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8000" min="0" step="500"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Verkaufskosten (%) (Makler, Notar, Grunderwerbsteuer)</label><input type="number" id="hrg-selling" class="hrg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" max="20" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzter Gewinn</div>
          <div class="text-5xl font-extrabold font-mono" id="hrg-result">0 €</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ROI</div><div class="text-xl font-bold font-mono" id="hrg-roi">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtinvestition</div><div class="text-xl font-bold font-mono" id="hrg-total">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verkaufskosten</div><div class="text-xl font-bold font-mono" id="hrg-sellcost">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nettoerloese</div><div class="text-xl font-bold font-mono" id="hrg-proceeds">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">70%-Regel Max-Preis</div><div class="text-xl font-bold font-mono" id="hrg-rule70">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">70%-Regel</div><div class="text-xl font-bold font-mono" id="hrg-check">--</div></div>
        </div>
      </div>

      <ShareButton calculatorId="house-flipping" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die 70-%-Regel beim Immobilien-Flipping</h2>
      <p>Die 70-%-Regel besagt: Zahle hoechstens 70 % des Verkehrswertes nach Sanierung (VNS) abzueglich der Sanierungskosten. Diese Formel schuetzt deine Gewinnmarge und berucksichtigt unvorhergesehene Ausgaben.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist der VNS (ARV)?</strong> Der Verkehrswert nach Sanierung ist der erwartete Marktpreis nach vollstaendiger Renovierung. Er sollte durch vergleichbare Verkaufspreise in der Umgebung gestuetzt werden.</p>
      <p><strong>Welche Kosten werden beim ROI einberechnet?</strong> Kaufpreis, Renovierung, Haltekosten (Finanzierungskosten, Steuern, Versicherung) und Verkaufsnebenkosten (Makler ca. 3,57 %, Notar ca. 1,5 %).</p>
      <p><strong>Wie lange dauert ein typischer Flip?</strong> Ein Renovierungsprojekt dauert typischerweise 3-9 Monate. Laengere Haltezeiten reduzieren die Rendite erheblich durch steigende Finanzierungskosten.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHRG() {
      const purchase = parseFloat((document.getElementById('hrg-purchase') as HTMLInputElement).value) || 0;
      const rehab = parseFloat((document.getElementById('hrg-rehab') as HTMLInputElement).value) || 0;
      const arv = parseFloat((document.getElementById('hrg-arv') as HTMLInputElement).value) || 0;
      const holding = parseFloat((document.getElementById('hrg-holding') as HTMLInputElement).value) || 0;
      const sellingPct = parseFloat((document.getElementById('hrg-selling') as HTMLInputElement).value) || 0;

      const sellingCosts = arv * (sellingPct / 100);
      const totalInvestment = purchase + rehab + holding;
      const netProceeds = arv - sellingCosts;
      const profit = netProceeds - totalInvestment;
      const roi = totalInvestment > 0 ? (profit / totalInvestment) * 100 : 0;
      const maxOffer70 = arv * 0.7 - rehab;
      const passes70 = purchase <= maxOffer70;

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' €';
      document.getElementById('hrg-result')!.textContent = fmt(profit);
      document.getElementById('hrg-roi')!.textContent = roi.toFixed(1).replace('.', ',') + '%';
      document.getElementById('hrg-total')!.textContent = fmt(totalInvestment);
      document.getElementById('hrg-sellcost')!.textContent = fmt(sellingCosts);
      document.getElementById('hrg-proceeds')!.textContent = fmt(netProceeds);
      document.getElementById('hrg-rule70')!.textContent = fmt(maxOffer70);
      document.getElementById('hrg-check')!.textContent = passes70 ? 'BESTANDEN' : 'NICHT BESTANDEN';
      (document.getElementById('hrg-check') as HTMLElement).style.color = passes70 ? '#16a34a' : '#dc2626';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hrg-in').forEach(el => {
        el.addEventListener('input', calcHRG);
        el.addEventListener('change', calcHRG);
      });
      calcHRG();
    }, 50);
  </script>
</CalculatorLayout>
