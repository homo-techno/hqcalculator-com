---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Papiergewicht Rechner - g/m², lbs & Stapelgewicht";
const description = "Konvertieren Sie Papiergewichte zwischen g/m², lbs und berechnen Sie Stapelgewichte für verschiedene Papierformate und Mengen.";

const relatedCalcs = [
  { name: "Papierrechner", url: "/de/papier-rechner", description: "Papiermenge." },
  { name: "Papier-Falz Rechner", url: "/de/papier-falz-rechner", description: "Papierfaltung." },
  { name: "Einheitenrechner", url: "/de/einheitenrechner", description: "Einheiten umrechnen." },
  { name: "Gewichtsrechner", url: "/de/gewichtsrechner", description: "Gewicht umrechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Papiergewicht Rechner" lang="de" enSlug="paper-weight-calculator" keywords="papiergewicht rechner, g/m2 umrechnen, papier lbs gramm, papierstapel gewicht, grammatur" breadcrumbs={[{ name: "Papiergewicht Rechner", url: "/de/papiergewicht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Papiergewicht Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Konvertieren Sie Papiergewichte zwischen g/m² und lbs, und berechnen Sie das Gewicht von Papierstapeln.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Grammatur (g/m²)</label><input type="number" id="pgw-gsm" class="pgw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="20" max="1000" step="5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Papierformat</label>
            <select id="pgw-format" class="pgw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="a4">A4 (210 × 297 mm)</option>
              <option value="a3">A3 (297 × 420 mm)</option>
              <option value="a5">A5 (148 × 210 mm)</option>
              <option value="letter">Letter (216 × 279 mm)</option>
              <option value="a0">A0 (841 × 1189 mm)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Blätter</label><input type="number" id="pgw-sheets" class="pgw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Papiertyp (US)</label>
            <select id="pgw-ustype" class="pgw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="bond">Bond / Writing</option>
              <option value="text">Text / Book</option>
              <option value="cover">Cover</option>
              <option value="cardstock">Cardstock</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gewicht des Stapels</div>
          <div class="text-4xl font-extrabold font-mono" id="pgw-result">0 kg</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewicht/Blatt</div><div class="text-xl font-bold" id="pgw-persheet">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">US lbs (500 Bl.)</div><div class="text-xl font-bold" id="pgw-lbs">0 lbs</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stapeldicke</div><div class="text-xl font-bold" id="pgw-thickness">0 mm</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Papiertyp (DE)</div><div class="text-sm font-bold" id="pgw-detype">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewicht pro 1000 Bl.</div><div class="text-xl font-bold" id="pgw-per1000">0 kg</div></div>
        </div>
      </div>
      <ShareButton calculatorId="papiergewicht-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Papiergewichte richtig verstehen</h2>
      <p class="text-text-secondary mt-2">In Deutschland und Europa wird Papiergewicht in g/m² (Gramm pro Quadratmeter) angegeben. In den USA verwendet man lbs (Pfund), bezogen auf ein Ries (500 Blatt) im jeweiligen Basisformat. Dieselbe Grammatur von 80 g/m² entspricht ungefähr 20 lbs Bond-Papier. Die Kenntnis dieser Umrechnungen ist wichtig für die Beschaffung von Papier aus internationalen Quellen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Blattgewicht (g):</strong> Grammatur × Formatfläche (m²)</p>
        <p><strong>US lbs (Bond):</strong> g/m² × 0,675 (ca. Faktor für Bond 17×22 in.)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was bedeutet 80 g/m²?</strong> Ein Quadratmeter dieses Papiers wiegt 80 Gramm. Ein A4-Blatt (0,0623 m²) wiegt damit ca. 5 g.</p>
      <p><strong>Wie rechne ich g/m² in lbs um?</strong> Der Umrechnungsfaktor hängt vom US-Papiertyp ab. Für Bond-Papier gilt: lbs ≈ g/m² × 0,675. Für Text-Papier: lbs ≈ g/m² × 1,35.</p>
      <p><strong>Wie dick ist ein Blatt Papier?</strong> Bei 80 g/m² beträgt die Dicke eines Blattes ca. 0,1 mm. Bei 120 g/m² etwa 0,13 mm.</p>
      <p><strong>Welche Grammatur für Visitenkarten?</strong> Visitenkarten werden üblicherweise auf 300–400 g/m² gedruckt, um ausreichende Steifigkeit zu gewährleisten.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcPGW() {
      const gsm = parseFloat((document.getElementById('pgw-gsm') as HTMLInputElement).value) || 80;
      const format = (document.getElementById('pgw-format') as HTMLSelectElement).value;
      const sheets = parseInt((document.getElementById('pgw-sheets') as HTMLInputElement).value) || 500;
      const ustype = (document.getElementById('pgw-ustype') as HTMLSelectElement).value;

      const areas: Record<string, number> = { a4: 0.210 * 0.297, a3: 0.297 * 0.420, a5: 0.148 * 0.210, letter: 0.216 * 0.279, a0: 0.841 * 1.189 };
      const area = areas[format] || areas['a4'];
      const sheetWeightG = gsm * area;
      const totalWeightKg = (sheetWeightG * sheets) / 1000;

      const lbsFactors: Record<string, number> = { bond: 0.675, text: 1.35, cover: 2.703, cardstock: 2.703 };
      const lbs500 = gsm * (lbsFactors[ustype] || 0.675);

      const thicknessPerSheet = gsm / 800;
      const totalThickness = thicknessPerSheet * sheets;

      const getDeType = (g: number) => {
        if (g <= 60) return 'Leichtpapier';
        if (g <= 90) return 'Schreibpapier / Kopierpapier';
        if (g <= 115) return 'Prospektpapier';
        if (g <= 170) return 'Broschürenpapier';
        if (g <= 250) return 'Karton leicht';
        if (g <= 400) return 'Karton schwer / Visitenkarte';
        return 'Pappe';
      };

      document.getElementById('pgw-result')!.textContent = totalWeightKg.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kg';
      document.getElementById('pgw-persheet')!.textContent = sheetWeightG.toFixed(2).replace('.', ',') + ' g';
      document.getElementById('pgw-lbs')!.textContent = lbs500.toFixed(1).replace('.', ',') + ' lbs';
      document.getElementById('pgw-thickness')!.textContent = totalThickness.toFixed(1).replace('.', ',') + ' mm';
      document.getElementById('pgw-detype')!.textContent = getDeType(gsm);
      document.getElementById('pgw-per1000')!.textContent = ((sheetWeightG * 1000) / 1000).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pgw-in').forEach(el => { el.addEventListener('input', calcPGW); el.addEventListener('change', calcPGW); });
      calcPGW();
    }, 50);
  </script>
</CalculatorLayout>
