---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Aushubvolumen-Rechner - Einheitsvolumen & Bodengewicht";
const description = "Berechnen Sie das Aushubvolumen und sch\u00e4tzen Sie das Bodengewicht f\u00fcr arch\u00e4ologische Grabungen. Planen Sie Verf\u00fcllung, Siebzeit und Arbeitsbedarf.";

const relatedCalcs = [
  { name: "Aushub-Rechner", url: "/de/aushub-rechner", description: "Aushubkosten." },
  { name: "Beton-Rechner", url: "/de/beton-rechner", description: "Volumenberechnung." },
  { name: "Quadratmeter-Rechner", url: "/de/quadratmeter-rechner", description: "Fl\u00e4chenberechnung." },
  { name: "Fundament-Rechner", url: "/de/fundament-rechner", description: "Fundamentbedarf." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Aushubvolumen-Rechner" lang="de" enSlug="excavation-volume-calculator" keywords="aushubvolumen, bodenentfernung, archaeologische grabung, einheitsvolumen, verfuellung, bodengewicht" breadcrumbs={[{ name: "Aushubvolumen-Rechner", url: "/de/aushubvolumen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aushubvolumen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Bodenvolumen, Gewicht, Siebzeit und Arbeitsbedarf f&uuml;r Grabungseinheiten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-1">Einheitsl&auml;nge (m)</label><input type="number" id="avr-len" class="avr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0.1" step="0.1"></div>
          <div><label class="block text-sm font-medium text-text mb-1">Einheitsbreite (m)</label><input type="number" id="avr-wid" class="avr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0.1" step="0.1"></div>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Grabungstiefe (cm)</label><input type="number" id="avr-depth" class="avr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Bodendichte (kg/m&sup3;)</label>
          <input type="number" id="avr-soildens" class="avr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="100" step="50">
          <p class="text-xs text-text-muted mt-1">Typisch: Trockener Sand 1600, Lehm 1800, Humus 1400, Schluff 1300</p>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl Einheiten</label><input type="number" id="avr-units" class="avr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Schichtdicke (cm)</label><input type="number" id="avr-level" class="avr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" step="1"></div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtvolumen</div>
          <div class="text-4xl font-extrabold" id="avr-vol">0</div>
          <div class="text-sm text-blue-200 mt-1">Kubikmeter</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-xl font-bold" id="avr-weight">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vol. pro Einheit</div><div class="text-xl font-bold" id="avr-unitvol">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahl Schichten</div><div class="text-xl font-bold" id="avr-levels">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vol. pro Schicht</div><div class="text-xl font-bold" id="avr-lvlvol">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eimer (10 L)</div><div class="text-xl font-bold" id="avr-buckets">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schubkarrenladungen</div><div class="text-xl font-bold" id="avr-wheel">0</div></div>
        </div>
      </div>

      <ShareButton calculatorId="excavation-volume-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Aushubvolumen-Formeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Volumen</strong> = L&auml;nge &times; Breite &times; Tiefe &times; Anzahl Einheiten</p>
        <p><strong>Gewicht</strong> = Volumen &times; Bodendichte</p>
        <p><strong>Schichten</strong> = Gesamttiefe / Schichtdicke</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie schwer ist der Boden?</strong> Ein Kubikmeter Erde wiegt je nach Zusammensetzung 1.300-2.000 kg.</p>
      <p><strong>Wie viel passt in eine Schubkarre?</strong> Eine Standard-Schubkarre fasst ca. 85 Liter (0,085 m&sup3;).</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAVR() {
      const len = parseFloat((document.getElementById('avr-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('avr-wid') as HTMLInputElement).value) || 0;
      const depth = parseFloat((document.getElementById('avr-depth') as HTMLInputElement).value) || 0;
      const soilDens = parseFloat((document.getElementById('avr-soildens') as HTMLInputElement).value) || 0;
      const numUnits = parseFloat((document.getElementById('avr-units') as HTMLInputElement).value) || 1;
      const levelThick = parseFloat((document.getElementById('avr-level') as HTMLInputElement).value) || 10;

      const depthM = depth / 100;
      const unitVol = len * wid * depthM;
      const totalVol = unitVol * numUnits;
      const totalWeight = totalVol * soilDens;
      const numLevels = Math.ceil(depth / levelThick);
      const levelVol = len * wid * (levelThick / 100);
      const buckets = totalVol / 0.01;
      const wheelbarrows = totalVol / 0.085;

      let weightStr = '';
      if (totalWeight >= 1000) {
        weightStr = (totalWeight / 1000).toFixed(2).replace('.', ',') + ' t';
      } else {
        weightStr = totalWeight.toFixed(0) + ' kg';
      }

      document.getElementById('avr-vol')!.textContent = totalVol.toFixed(3).replace('.', ',');
      document.getElementById('avr-weight')!.textContent = weightStr;
      document.getElementById('avr-unitvol')!.textContent = unitVol.toFixed(3).replace('.', ',') + ' m\u00B3';
      document.getElementById('avr-levels')!.textContent = numLevels.toString();
      document.getElementById('avr-lvlvol')!.textContent = levelVol.toFixed(4).replace('.', ',') + ' m\u00B3';
      document.getElementById('avr-buckets')!.textContent = Math.ceil(buckets).toLocaleString('de-DE');
      document.getElementById('avr-wheel')!.textContent = Math.ceil(wheelbarrows).toLocaleString('de-DE');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.avr-in').forEach(el => { el.addEventListener('input', calcAVR); el.addEventListener('change', calcAVR); });
      calcAVR();
    }, 50);
  </script>
</CalculatorLayout>
