---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Gemischte Zahlen Rechner - Brüche und gemischte Zahlen";
const description = "Konvertieren und rechnen Sie mit gemischten Zahlen und unechten Brüchen. Addition, Subtraktion, Multiplikation und Division von gemischten Zahlen.";

const relatedCalcs = [
  { name: "Bruchrechner", url: "/de/bruchrechner", description: "Brüche berechnen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Dezimalrechner", url: "/de/dezimalrechner", description: "Dezimalzahlen." },
  { name: "Modulo Rechner", url: "/de/modulo-rechner", description: "Divisionsrest berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="mixed-number-calculator" calculatorName="Gemischte Zahlen Rechner" keywords="Gemischte Zahlen, unechte Brüche, Bruchrechnung, gemischte Zahl umrechnen, Bruch addieren" breadcrumbs={[{ name: "Gemischte Zahlen Rechner", url: "/de/gemischte-zahl-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gemischte Zahlen Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie mit gemischten Zahlen (z.B. 2 ¾) und unechten Brüchen. Addieren, subtrahieren, multiplizieren oder dividieren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button class="gz-op-btn px-3 py-2 rounded-lg text-sm font-semibold bg-primary text-white cursor-pointer" data-op="add">Addition</button>
          <button class="gz-op-btn px-3 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-op="sub">Subtraktion</button>
          <button class="gz-op-btn px-3 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-op="mul">Multiplikation</button>
          <button class="gz-op-btn px-3 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary cursor-pointer" data-op="div">Division</button>
        </div>

        <div>
          <h3 class="text-xs font-semibold text-text mb-2">Erste gemischte Zahl (Ganzzahl Zähler/Nenner)</h3>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Ganzzahl</label>
              <input type="number" id="gz-w1" class="gz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" value="2">
            </div>
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Zähler</label>
              <input type="number" id="gz-n1" class="gz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" value="3">
            </div>
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Nenner</label>
              <input type="number" id="gz-d1" class="gz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" value="4">
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-xs font-semibold text-text mb-2">Zweite gemischte Zahl</h3>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Ganzzahl</label>
              <input type="number" id="gz-w2" class="gz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" value="1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Zähler</label>
              <input type="number" id="gz-n2" class="gz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" value="1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Nenner</label>
              <input type="number" id="gz-d2" class="gz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" value="2">
            </div>
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ergebnis</div>
          <div class="text-4xl font-extrabold font-mono" id="gz-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="gz-decimal">—</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gemischte Zahl</div>
            <div class="text-xl font-bold" id="gz-mixed">—</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Unechter Bruch</div>
            <div class="text-xl font-bold" id="gz-improper">—</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rechenweg</h3>
          <div class="font-mono text-sm space-y-1" id="gz-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mixed-number" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gemischte Zahlen und Bruchrechnung</h2>
      <p>Eine gemischte Zahl besteht aus einem ganzzahligen Teil und einem echten Bruch, z.B. 2¾ (gesprochen: zwei drei Viertel). Sie entspricht dem unechten Bruch 11/4. Für Rechenoperationen werden gemischte Zahlen zunächst in unechte Brüche umgewandelt.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Gemischte Zahl → Unechter Bruch: a b/c = (a×c + b) / c</p>
        <p>Addition: a/b + c/d = (a×d + c×b) / (b×d)</p>
        <p>Multiplikation: a/b × c/d = (a×c) / (b×d)</p>
        <p>Division: a/b ÷ c/d = (a×d) / (b×c)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <div class="space-y-4 mt-4">
        <div>
          <p class="font-semibold">Was ist der Unterschied zwischen echtem und unechtem Bruch?</p>
          <p>Bei einem echten Bruch ist der Zähler kleiner als der Nenner (z.B. 3/4). Bei einem unechten Bruch ist der Zähler größer oder gleich dem Nenner (z.B. 11/4). Jede gemischte Zahl kann als unechter Bruch geschrieben werden.</p>
        </div>
        <div>
          <p class="font-semibold">Wie addiert man gemischte Zahlen?</p>
          <p>Methode 1: Ganzzahlteile und Bruchteile getrennt addieren. Methode 2: Beide in unechte Brüche umwandeln, auf gemeinsamen Nenner bringen und addieren. Methode 2 ist fehlerärmer.</p>
        </div>
        <div>
          <p class="font-semibold">Was ist der größte gemeinsame Teiler (ggT)?</p>
          <p>Der ggT zweier Zahlen ist die größte Zahl, durch die beide teilbar sind. Er wird zur Vereinfachung von Brüchen verwendet: Zähler und Nenner werden durch den ggT geteilt.</p>
        </div>
        <div>
          <p class="font-semibold">Wo verwendet man gemischte Zahlen im Alltag?</p>
          <p>Gemischte Zahlen sind in Rezepten (2½ Tassen), Messungen (3¾ Meter), Bauarbeiten und im amerikanischen Maßsystem (1⅜ Zoll) verbreitet. In der Wissenschaft werden stattdessen Dezimalzahlen bevorzugt.</p>
        </div>
      </div>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let gzOp = 'add';

    function gcd(a: number, b: number): number {
      a = Math.abs(a); b = Math.abs(b);
      while (b) { const t = b; b = a % b; a = t; }
      return a;
    }

    function toFraction(whole: number, num: number, den: number): [number, number] {
      const sign = (whole < 0 || (whole === 0 && num < 0)) ? -1 : 1;
      const w = Math.abs(whole);
      const n = Math.abs(num);
      const d = Math.abs(den);
      return [sign * (w * d + n), d];
    }

    function simplify(num: number, den: number): [number, number] {
      if (den === 0) return [num, den];
      const g = gcd(Math.abs(num), Math.abs(den));
      return [num / g, den / g];
    }

    function toMixed(num: number, den: number): string {
      if (den === 0) return 'Ungültig';
      const whole = Math.trunc(num / den);
      const rem = Math.abs(num % den);
      if (rem === 0) return String(whole);
      if (whole === 0) return `${num}/${den}`;
      return `${whole} ${rem}/${Math.abs(den)}`;
    }

    function calcGz() {
      const w1 = parseInt((document.getElementById('gz-w1') as HTMLInputElement).value) || 0;
      const n1 = parseInt((document.getElementById('gz-n1') as HTMLInputElement).value) || 0;
      const d1 = parseInt((document.getElementById('gz-d1') as HTMLInputElement).value) || 1;
      const w2 = parseInt((document.getElementById('gz-w2') as HTMLInputElement).value) || 0;
      const n2 = parseInt((document.getElementById('gz-n2') as HTMLInputElement).value) || 0;
      const d2 = parseInt((document.getElementById('gz-d2') as HTMLInputElement).value) || 1;

      const [a, b] = toFraction(w1, n1, d1);
      const [c, d] = toFraction(w2, n2, d2);

      const steps: string[] = [];
      steps.push(`Erste Zahl: ${w1} ${n1}/${d1} = ${a}/${b}`);
      steps.push(`Zweite Zahl: ${w2} ${n2}/${d2} = ${c}/${d}`);

      let rn: number, rd: number;

      if (gzOp === 'add') {
        rn = a * d + c * b; rd = b * d;
        steps.push(`${a}/${b} + ${c}/${d} = (${a}×${d} + ${c}×${b}) / (${b}×${d}) = ${rn}/${rd}`);
      } else if (gzOp === 'sub') {
        rn = a * d - c * b; rd = b * d;
        steps.push(`${a}/${b} - ${c}/${d} = (${a}×${d} - ${c}×${b}) / (${b}×${d}) = ${rn}/${rd}`);
      } else if (gzOp === 'mul') {
        rn = a * c; rd = b * d;
        steps.push(`${a}/${b} × ${c}/${d} = (${a}×${c}) / (${b}×${d}) = ${rn}/${rd}`);
      } else {
        if (c === 0) { document.getElementById('gz-result')!.textContent = 'Division durch 0'; return; }
        rn = a * d; rd = b * c;
        steps.push(`${a}/${b} ÷ ${c}/${d} = ${a}/${b} × ${d}/${c} = (${a}×${d}) / (${b}×${c}) = ${rn}/${rd}`);
      }

      const [sn, sd] = simplify(rn, rd);
      steps.push(`Vereinfacht: ${sn}/${sd}`);

      const decVal = sn / sd;
      const mixedStr = toMixed(sn, sd);

      document.getElementById('gz-result')!.textContent = mixedStr;
      document.getElementById('gz-decimal')!.textContent = `Dezimal: ${decVal.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 6 })}`;
      document.getElementById('gz-mixed')!.textContent = mixedStr;
      document.getElementById('gz-improper')!.textContent = `${sn}/${sd}`;
      document.getElementById('gz-steps')!.innerHTML = steps.map(s => `<div>${s}</div>`).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.gz-op-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          gzOp = (btn as HTMLElement).dataset.op || 'add';
          document.querySelectorAll('.gz-op-btn').forEach(b => {
            b.className = `gz-op-btn px-3 py-2 rounded-lg text-sm font-semibold cursor-pointer ${b === btn ? 'bg-primary text-white' : 'bg-surface-alt text-text-secondary'}`;
          });
          calcGz();
        });
      });
      document.querySelectorAll('.gz-in').forEach(el => {
        el.addEventListener('input', calcGz);
        el.addEventListener('change', calcGz);
      });
      calcGz();
    }, 50);
  </script>
</CalculatorLayout>
