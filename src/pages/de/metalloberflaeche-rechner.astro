---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Metalloberfläche Rechner - Galvanik, Beschichtung und Oberflächenbehandlung";
const description = "Berechnen Sie Materialmengen für Galvanik, Beschichtung und Oberflächenbehandlung von Metallteilen. Schichtdicke, Materialverbrauch und Kosten ermitteln.";
const relatedCalcs = [
  { name: "Metallgewicht Rechner", url: "/de/metallgewicht-rechner", description: "Metallgewicht berechnen." },
  { name: "Metall-Ausdehnung Rechner", url: "/de/metall-ausdehnung-rechner", description: "Thermische Ausdehnung." },
  { name: "Metallermüdung Rechner", url: "/de/metallmuedigkeit-rechner", description: "Ermüdungsberechnung." },
  { name: "Schiffsfarbe Rechner", url: "/de/schiffsfarbe-rechner", description: "Farbverbrauch Schiff." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="metal-finishing-calculator" calculatorName="Metalloberfläche Rechner" keywords="Galvanik Rechner, Beschichtung Metall, Schichtdicke berechnen, Oberflächenbehandlung, Verzinkung Materialverbrauch" breadcrumbs={[{ name: "Metalloberfläche Rechner", url: "/de/metalloberflaeche-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Metalloberfläche Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Schichtdicken, Materialbedarf und Kosten für galvanische Beschichtungen, Verzinkung, Lackierung und andere Oberflächenbehandlungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Beschichtungsverfahren</label>
          <select id="mo-proc" class="mo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="zinc,7.13,2.5" selected>Feuerverzinkung (Zink, 85 μm)</option>
            <option value="nickel,8.9,8">Galvanisch Vernickeln (Ni, 20 μm)</option>
            <option value="chrome,7.19,15">Hartverchromung (Cr, 50 μm)</option>
            <option value="copper,8.9,5">Kupferbeschichtung (Cu, 30 μm)</option>
            <option value="powder,1.5,3">Pulverbeschichtung (30–80 μm)</option>
            <option value="paint,1.4,2">Nasslackierung (60–120 μm)</option>
          </select>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Länge (mm)</label><input type="number" id="mo-l" class="mo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (mm)</label><input type="number" id="mo-w" class="mo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Höhe (mm)</label><input type="number" id="mo-h" class="mo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schichtdicke (μm)</label><input type="number" id="mo-thick" class="mo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="85" min="1" max="5000" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Materialpreis (€/kg)</label><input type="number" id="mo-price" class="mo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0.1" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Beschichtungsmasse</div>
          <div class="text-5xl font-extrabold font-mono" id="mo-mass">--</div>
          <div class="text-sm text-blue-200 mt-1">Gramm</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Oberfläche</div><div class="text-xl font-bold" id="mo-area">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumen Schicht</div><div class="text-xl font-bold" id="mo-vol">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Materialkosten</div><div class="text-xl font-bold" id="mo-cost">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="metalloberflaeche" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Oberflächenbehandlung von Metallen</h2>
      <p>Metallische Beschichtungen verbessern Korrosionsbeständigkeit, Härte und Optik von Bauteilen. Bei der Feuerverzinkung wird das Bauteil in flüssiges Zink getaucht und erhält eine Schicht von 50–150 μm. Galvanische Verfahren ermöglichen dünnere, gleichmäßigere Schichten (5–50 μm). Die benötigte Materialmenge berechnet sich aus Oberfläche × Schichtdicke × Dichte des Beschichtungsmaterials.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Feuerverzinkung und galvanischer Verzinkung?</strong> Feuerverzinkung erzeugt dickere Schichten (85–100 μm) mit legierter Zwischenschicht. Galvanisches Verzinken liefert dünnere (5–20 μm), gleichmäßigere Schichten.</p>
      <p><strong>Wie lange hält eine Feuerverzinkung?</strong> In normaler Atmosphäre hält Feuerverzinkung 50–100 Jahre. In aggressiven Umgebungen (Meeresluft, Industrieluft) ist die Lebensdauer kürzer.</p>
      <p><strong>Was ist Pulverbeschichtung?</strong> Pulverbeschichtung ist ein elektrostatisches Verfahren, bei dem Kunststoffpulver aufgetragen und bei 180–200 °C eingebrannt wird. Es entsteht eine robuste, lösungsmittelfreie Oberfläche.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMO() {
      const procVal = (document.getElementById('mo-proc') as HTMLSelectElement).value;
      const parts = procVal.split(',');
      const density = parseFloat(parts[1]) || 7.13;
      const L = parseFloat((document.getElementById('mo-l') as HTMLInputElement).value) || 0;
      const W = parseFloat((document.getElementById('mo-w') as HTMLInputElement).value) || 0;
      const H = parseFloat((document.getElementById('mo-h') as HTMLInputElement).value) || 0;
      const thick = parseFloat((document.getElementById('mo-thick') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('mo-price') as HTMLInputElement).value) || 0;
      const area = H > 0 ? 2 * (L * W + L * H + W * H) : 2 * (L * W);
      const areaM2 = area / 1e6;
      const volM3 = areaM2 * (thick / 1e6);
      const massG = volM3 * density * 1e6;
      const massKg = massG / 1000;
      const cost = massKg * price;
      const fmtArea = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' dm²';
      const fmtG = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' g';
      const fmtVol = (v: number) => (v * 1e9).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' mm³';
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
      document.getElementById('mo-mass')!.textContent = massG > 0 ? fmtG(massG) : '--';
      document.getElementById('mo-area')!.textContent = areaM2 > 0 ? fmtArea(areaM2 * 100) : '--';
      document.getElementById('mo-vol')!.textContent = volM3 > 0 ? fmtVol(volM3) : '--';
      document.getElementById('mo-cost')!.textContent = cost > 0 ? fmtEur(cost) : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mo-in').forEach(el => { el.addEventListener('input', calcMO); el.addEventListener('change', calcMO); });
      calcMO();
    }, 50);
  </script>
</CalculatorLayout>
