---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Handschuhgröße-Rechner - Handvermessung zur Handschuhgröße";
const description = "Berechnen Sie Ihre Handschuhgröße aus Handumfang und Handlänge mit US- und EU-Größenumrechnung.";
const relatedCalcs = [
  { name: "Brillen-Kosten-Rechner", url: "/de/brillen-kosten-rechner", description: "Brillenkosten." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Genauigkeit." },
  { name: "Notendurchschnitt-Rechner", url: "/de/notendurchschnitt-rechner", description: "GPA berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Handschuhgröße-Rechner" enSlug="glove-size-calculator" keywords="Handschuhgröße, Handvermessung, Handschuh Größentabelle, EU Handschuhgröße, Handumfang, Fingerlänge" breadcrumbs={[{ name: "Handschuhgröße-Rechner", url: "/de/handschuhgroesse-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Handschuhgröße-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihre Handschuhgröße anhand von Handmessungen mit US- und EU-Größenumrechnung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Handumfang</label><input type="number" id="hsg-circ" class="hsg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="10" max="35" step="0.5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="hsg-unit" class="hsg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="cm" selected>Zentimeter</option>
              <option value="in">Zoll</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Handlänge (Spitze bis Handgelenk)</label><input type="number" id="hsg-len" class="hsg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="19" min="10" max="30" step="0.5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
            <select id="hsg-gender" class="hsg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="m" selected>Herren</option>
              <option value="f">Damen</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Handschuhgröße (EU)</div>
          <div class="text-4xl font-extrabold font-mono" id="hsg-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">US-Größe</div><div class="text-xl font-bold font-mono" id="hsg-us">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Buchstabengröße</div><div class="text-xl font-bold font-mono" id="hsg-alpha">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umfang (cm)</div><div class="text-xl font-bold font-mono" id="hsg-cm">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bestimmendes Maß</div><div class="text-xl font-bold font-mono" id="hsg-dom">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Handlänge (cm)</div><div class="text-xl font-bold font-mono" id="hsg-lencm">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="handschuhgroesse" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Handschuhgröße richtig ermitteln</h2>
      <p>Die Handschuhgröße wird primär durch den Handumfang bestimmt. Messen Sie den Umfang an der breitesten Stelle Ihrer Hand (über den Knöcheln, ohne Daumen) mit einem Maßband. Die EU-Größe entspricht dem Umfang in französischen Zoll (2,54 cm).</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie messe ich meinen Handumfang?</strong> Wickeln Sie ein Maßband um die breiteste Stelle Ihrer Hand (über den Knöcheln, ohne Daumen). Bilden Sie dabei eine leichte Faust.</p>
      <p><strong>Was ist der Unterschied zwischen EU- und US-Größen?</strong> EU-Größen basieren auf dem Umfang in französischen Zoll, US-Größen auf dem Umfang in englischen Zoll.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcHSG() {
      let circ = parseFloat((document.getElementById('hsg-circ') as HTMLInputElement).value) || 20;
      const unit = (document.getElementById('hsg-unit') as HTMLSelectElement).value;
      let len = parseFloat((document.getElementById('hsg-len') as HTMLInputElement).value) || 19;
      const gender = (document.getElementById('hsg-gender') as HTMLSelectElement).value;

      let circIn = unit === 'cm' ? circ / 2.54 : circ;
      let circCm = unit === 'cm' ? circ : circ * 2.54;
      let lenCm = unit === 'cm' ? len : len * 2.54;

      const euSize = Math.round(circCm / 2.54 * 2) / 2;

      let alpha = '--';
      if (gender === 'm') {
        if (circIn < 7.5) alpha = 'XS';
        else if (circIn < 8.5) alpha = 'S';
        else if (circIn < 9.5) alpha = 'M';
        else if (circIn < 10.5) alpha = 'L';
        else if (circIn < 11.5) alpha = 'XL';
        else alpha = 'XXL';
      } else {
        if (circIn < 6.5) alpha = 'XS';
        else if (circIn < 7.5) alpha = 'S';
        else if (circIn < 8) alpha = 'M';
        else if (circIn < 8.5) alpha = 'L';
        else if (circIn < 9) alpha = 'XL';
        else alpha = 'XXL';
      }

      const sizeByCirc = circIn;
      const sizeByLen = unit === 'cm' ? len / 2.54 : len;
      const dominant = sizeByCirc >= sizeByLen ? 'Umfang' : 'L\u00e4nge';
      const usSize = Math.round(Math.max(sizeByCirc, sizeByLen) * 2) / 2;

      document.getElementById('hsg-result')!.textContent = euSize.toString();
      document.getElementById('hsg-us')!.textContent = usSize.toString();
      document.getElementById('hsg-alpha')!.textContent = alpha;
      document.getElementById('hsg-cm')!.textContent = circCm.toFixed(1);
      document.getElementById('hsg-dom')!.textContent = dominant;
      document.getElementById('hsg-lencm')!.textContent = lenCm.toFixed(1);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hsg-in').forEach(el => { el.addEventListener('input', calcHSG); el.addEventListener('change', calcHSG); });
      calcHSG();
    }, 50);
  </script>
</CalculatorLayout>
