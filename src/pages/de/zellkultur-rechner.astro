---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zellkultur-Rechner – Verdopplungszeit & Aussaatdichte";
const description = "Berechnen Sie Zellverdopplungszeit, Aussaatdichte, Passagenzahl-Empfehlungen, Viabilität und Wachstumsprognosen für die Zellkultur.";
const relatedCalcs = [
  { name: "Funkturm-Abdeckung-Rechner", url: "/de/funkturm-abdeckung-rechner", description: "Funkabdeckung." },
  { name: "Himmelskoordinaten-Rechner", url: "/de/himmelskoordinaten-rechner", description: "Koordinaten." },
  { name: "Kohlenstoffbindung-Rechner", url: "/de/kohlenstoffbindung-rechner", description: "Kohlenstoffbindung." },
  { name: "CO₂-Fußabdruck-Rechner", url: "/de/co2-fussabdruck-rechner", description: "CO₂." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Zellkultur-Rechner" enSlug="cell-culture-calculator" keywords="Zellkultur, Verdopplungszeit, Aussaatdichte, Passagenzahl, Viabilität, Zellwachstum, Zellzählung" breadcrumbs={[{ name: "Zellkultur-Rechner", url: "/de/zellkultur-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zellkultur-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Verdopplungszeit, Aussaatdichte, Viabilität und Wachstumsprognosen für die Zellkultur.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button id="zkr-m1" class="zkr-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="doubling">Verdopplungszeit</button>
          <button id="zkr-m2" class="zkr-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="seeding">Aussaatdichte</button>
          <button id="zkr-m3" class="zkr-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="viability">Viabilität</button>
        </div>
        <div id="zkr-panel-doubling">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Anfangs-Zellzahl</label><input type="number" id="zkr-n0" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">End-Zellzahl</label><input type="number" id="zkr-nf" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div><label class="block text-xs font-medium text-text mb-1">Verstrichene Zeit (Stunden)</label><input type="number" id="zkr-time" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Prognose bei (Stunden)</label><input type="number" id="zkr-pred" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="1"></div>
          </div>
        </div>
        <div id="zkr-panel-seeding" class="hidden">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Ziel-Zellzahl</label><input type="number" id="zkr-target" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Wachstumszeit (Stunden)</label><input type="number" id="zkr-gt" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div><label class="block text-xs font-medium text-text mb-1">Verdopplungszeit (Stunden)</label><input type="number" id="zkr-dt" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0.1" step="0.1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Gefäßfläche (cm²)</label><select id="zkr-vessel" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold"><option value="9.6">96-Well (0,32 cm²)</option><option value="1.9">24-Well (1,9 cm²)</option><option value="9.5">6-Well (9,5 cm²)</option><option value="25" selected>T-25 (25 cm²)</option><option value="75">T-75 (75 cm²)</option><option value="175">T-175 (175 cm²)</option></select></div>
          </div>
        </div>
        <div id="zkr-panel-viability" class="hidden">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Gezählte Zellen (gesamt)</label><input type="number" id="zkr-total" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Tote Zellen (Trypanblau)</label><input type="number" id="zkr-dead" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="0" step="1"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div><label class="block text-xs font-medium text-text mb-1">Gezählte Quadrate</label><input type="number" id="zkr-sq" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">Verdünnungsfaktor</label><input type="number" id="zkr-dil" class="zkr-in w-full px-4 py-3 border border-border rounded-xl font-bold" min="1" step="1"></div>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="zkr-label">Verdopplungszeit</div>
          <div class="text-5xl font-extrabold font-mono" id="zkr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="zkr-s1l">Wachstumsrate</div><div class="text-xl font-bold font-mono" id="zkr-s1">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="zkr-s2l">Verdopplungen</div><div class="text-xl font-bold font-mono" id="zkr-s2">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="zkr-s3l">Prognostizierte Zahl</div><div class="text-xl font-bold font-mono" id="zkr-s3">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cell-culture" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zellkultur-Berechnungen</h2>
      <p>Die Verdopplungszeit beschreibt, wie lange eine Zellpopulation benötigt, um sich zu verdoppeln. Sie ist ein wichtiger Parameter für die Planung von Experimenten und die Qualitätskontrolle in der Zellkultur.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let zkrMode = 'doubling';
    function setZkrMode(m: string) {
      zkrMode = m;
      document.getElementById('zkr-panel-doubling')!.classList.toggle('hidden', m !== 'doubling');
      document.getElementById('zkr-panel-seeding')!.classList.toggle('hidden', m !== 'seeding');
      document.getElementById('zkr-panel-viability')!.classList.toggle('hidden', m !== 'viability');
      document.querySelectorAll('.zkr-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'zkr-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcZKR();
    }
    function calcZKR() {
      const label = document.getElementById('zkr-label')!;
      const result = document.getElementById('zkr-result')!;
      if (zkrMode === 'doubling') {
        const n0 = parseFloat((document.getElementById('zkr-n0') as HTMLInputElement).value) || 1;
        const nf = parseFloat((document.getElementById('zkr-nf') as HTMLInputElement).value) || 1;
        const t = parseFloat((document.getElementById('zkr-time') as HTMLInputElement).value) || 1;
        const predT = parseFloat((document.getElementById('zkr-pred') as HTMLInputElement).value) || 0;
        const doublings = nf > n0 ? Math.log2(nf / n0) : 0;
        const dt = doublings > 0 ? t / doublings : 0;
        const growthRate = dt > 0 ? Math.LN2 / dt : 0;
        const predicted = predT > 0 && growthRate > 0 ? n0 * Math.exp(growthRate * predT) : nf;
        label.textContent = 'Verdopplungszeit';
        result.textContent = dt.toFixed(1) + ' Stunden';
        document.getElementById('zkr-s1l')!.textContent = 'Wachstumsrate (h\u207B\u00B9)';
        document.getElementById('zkr-s1')!.textContent = growthRate.toFixed(4);
        document.getElementById('zkr-s2l')!.textContent = 'Verdopplungen';
        document.getElementById('zkr-s2')!.textContent = doublings.toFixed(2);
        document.getElementById('zkr-s3l')!.textContent = 'Prognose bei ' + predT + 'h';
        document.getElementById('zkr-s3')!.textContent = predicted >= 1e6 ? predicted.toExponential(2) : Math.round(predicted).toLocaleString('de-DE');
      } else if (zkrMode === 'seeding') {
        const target = parseFloat((document.getElementById('zkr-target') as HTMLInputElement).value) || 1e6;
        const gt = parseFloat((document.getElementById('zkr-gt') as HTMLInputElement).value) || 48;
        const dt = parseFloat((document.getElementById('zkr-dt') as HTMLInputElement).value) || 24;
        const area = parseFloat((document.getElementById('zkr-vessel') as HTMLSelectElement).value) || 25;
        const doublings = gt / dt;
        const seedCount = target / Math.pow(2, doublings);
        const seedDensity = seedCount / area;
        label.textContent = 'Benötigte Aussaatzahl';
        result.textContent = seedCount >= 1e6 ? seedCount.toExponential(2) : Math.round(seedCount).toLocaleString('de-DE');
        document.getElementById('zkr-s1l')!.textContent = 'Aussaatdichte (Zellen/cm\u00B2)';
        document.getElementById('zkr-s1')!.textContent = Math.round(seedDensity).toLocaleString('de-DE');
        document.getElementById('zkr-s2l')!.textContent = 'Ben\u00F6tigte Verdopplungen';
        document.getElementById('zkr-s2')!.textContent = doublings.toFixed(1);
        document.getElementById('zkr-s3l')!.textContent = 'Ziel bei ' + gt + 'h';
        document.getElementById('zkr-s3')!.textContent = target >= 1e6 ? target.toExponential(2) : Math.round(target).toLocaleString('de-DE');
      } else {
        const total = parseFloat((document.getElementById('zkr-total') as HTMLInputElement).value) || 0;
        const dead = parseFloat((document.getElementById('zkr-dead') as HTMLInputElement).value) || 0;
        const sq = parseFloat((document.getElementById('zkr-sq') as HTMLInputElement).value) || 4;
        const dil = parseFloat((document.getElementById('zkr-dil') as HTMLInputElement).value) || 2;
        const live = total - dead;
        const viability = total > 0 ? (live / total) * 100 : 0;
        const cellsPerMl = (total / sq) * dil * 1e4;
        const viableCellsPerMl = (live / sq) * dil * 1e4;
        label.textContent = 'Viabilit\u00E4t';
        result.textContent = viability.toFixed(1) + '%';
        document.getElementById('zkr-s1l')!.textContent = 'Zellen/mL (gesamt)';
        document.getElementById('zkr-s1')!.textContent = cellsPerMl.toExponential(2);
        document.getElementById('zkr-s2l')!.textContent = 'Viable Zellen/mL';
        document.getElementById('zkr-s2')!.textContent = viableCellsPerMl.toExponential(2);
        document.getElementById('zkr-s3l')!.textContent = 'Lebend / Tot';
        document.getElementById('zkr-s3')!.textContent = live + ' / ' + dead;
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('zkr-n0') as HTMLInputElement).value = '100000';
      (document.getElementById('zkr-nf') as HTMLInputElement).value = '800000';
      (document.getElementById('zkr-time') as HTMLInputElement).value = '72';
      (document.getElementById('zkr-pred') as HTMLInputElement).value = '96';
      (document.getElementById('zkr-target') as HTMLInputElement).value = '1000000';
      (document.getElementById('zkr-gt') as HTMLInputElement).value = '48';
      (document.getElementById('zkr-dt') as HTMLInputElement).value = '24';
      (document.getElementById('zkr-total') as HTMLInputElement).value = '150';
      (document.getElementById('zkr-dead') as HTMLInputElement).value = '12';
      (document.getElementById('zkr-sq') as HTMLInputElement).value = '4';
      (document.getElementById('zkr-dil') as HTMLInputElement).value = '2';
      document.querySelectorAll('.zkr-mode').forEach(b => b.addEventListener('click', () => setZkrMode((b as HTMLButtonElement).dataset.mode!)));
      document.querySelectorAll('.zkr-in').forEach(el => { el.addEventListener('input', calcZKR); el.addEventListener('change', calcZKR); });
      calcZKR();
    }, 50);
  </script>
</CalculatorLayout>
