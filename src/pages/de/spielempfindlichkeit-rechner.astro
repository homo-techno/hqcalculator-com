---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Spielempfindlichkeit-Rechner - Maus-Sensitivit\u00E4t umrechnen";
const description = "Maus-Empfindlichkeit zwischen Spielen umrechnen, cm/360, eDPI und DPI-Einstellungen f\u00FCr verschiedene FPS-Spiele berechnen.";
const relatedCalcs = [
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Bildschirmgr\u00F6\u00DFen-Rechner", url: "/de/bildschirmgroessen-rechner", description: "Display-Berechnung." },
  { name: "Seitenverh\u00E4ltnis-Rechner", url: "/de/seitenverhaeltnis-rechner", description: "Seitenverh\u00E4ltnis." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Spielempfindlichkeit-Rechner" lang="de" enSlug="game-sensitivity-calculator" keywords="empfindlichkeit umrechner, cm pro 360, edpi rechner, maus dpi, fps sensitivit\u00E4t, spielempfindlichkeit" breadcrumbs={[{ name: "Spielempfindlichkeit", url: "/de/spielempfindlichkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Spielempfindlichkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Empfindlichkeit zwischen Spielen umrechnen und cm/360 sowie eDPI-Werte berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Maus-DPI</label>
          <input type="number" class="sep-in w-full px-4 py-2 border border-border rounded-lg" id="sep-dpi" min="100" max="32000" value="800">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Quellspiel</label>
          <select class="sep-in w-full px-4 py-2 border border-border rounded-lg" id="sep-from">
            <option value="csgo" selected>CS2 / CS:GO</option>
            <option value="valorant">Valorant</option>
            <option value="overwatch">Overwatch 2</option>
            <option value="apex">Apex Legends</option>
            <option value="fortnite">Fortnite</option>
            <option value="cod">Call of Duty</option>
            <option value="r6">Rainbow Six Siege</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Quell-Empfindlichkeit</label>
          <input type="number" class="sep-in w-full px-4 py-2 border border-border rounded-lg" id="sep-sens" step="0.01" value="1.0">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Zielspiel</label>
          <select class="sep-in w-full px-4 py-2 border border-border rounded-lg" id="sep-to">
            <option value="csgo">CS2 / CS:GO</option>
            <option value="valorant" selected>Valorant</option>
            <option value="overwatch">Overwatch 2</option>
            <option value="apex">Apex Legends</option>
            <option value="fortnite">Fortnite</option>
            <option value="cod">Call of Duty</option>
            <option value="r6">Rainbow Six Siege</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Umgerechnete Empfindlichkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="sep-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">cm / 360</div>
            <div class="text-xl font-bold font-mono" id="sep-cm360">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">eDPI (Quelle)</div>
            <div class="text-xl font-bold font-mono" id="sep-edpi">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zoll / 360</div>
            <div class="text-xl font-bold font-mono" id="sep-in360">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Empfindlichkeitsstufe</div>
            <div class="text-xl font-bold font-mono" id="sep-tier">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Alle Spiel-Empfindlichkeiten</h3>
          <div class="text-xs font-mono space-y-1" id="sep-all"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="game-sensitivity" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie funktioniert die Empfindlichkeitsumrechnung?</h2>
      <p>Jedes Spiel verwendet unterschiedliche Yaw-Werte (Grad pro Mausbewegungseinheit). Um die gleiche 360-Grad-Drehung in verschiedenen Spielen zu erreichen, m&uuml;ssen die Empfindlichkeitswerte entsprechend umgerechnet werden.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>eDPI = DPI &times; Empfindlichkeit</p>
        <p>cm/360 = (360 / (Yaw &times; Sens)) / DPI &times; 2,54</p>
        <p>Ziel-Sens = (Quell-Yaw &times; Quell-Sens) / Ziel-Yaw</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist eDPI?</strong> eDPI (effektiver DPI) ist das Produkt aus Maus-DPI und Spielempfindlichkeit und erm&ouml;glicht den Vergleich zwischen verschiedenen Setups.</p>
      <p><strong>Was ist ein guter cm/360-Wert?</strong> Die meisten Profi-FPS-Spieler verwenden 25-50 cm/360. Niedrigere Werte bedeuten h&ouml;here Empfindlichkeit.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSEP() {
      const yawValues: Record<string, number> = {
        csgo: 0.022, valorant: 0.07, overwatch: 0.0066,
        apex: 0.022, fortnite: 0.5555, cod: 0.0066, r6: 0.00572
      };
      const gameNames: Record<string, string> = {
        csgo: 'CS2/CS:GO', valorant: 'Valorant', overwatch: 'Overwatch 2',
        apex: 'Apex Legends', fortnite: 'Fortnite', cod: 'Call of Duty', r6: 'Rainbow Six'
      };
      const dpi = parseFloat((document.getElementById('sep-dpi') as HTMLInputElement).value) || 800;
      const fromGame = (document.getElementById('sep-from') as HTMLSelectElement).value;
      const sens = parseFloat((document.getElementById('sep-sens') as HTMLInputElement).value) || 1;
      const toGame = (document.getElementById('sep-to') as HTMLSelectElement).value;
      const fromYaw = yawValues[fromGame] || 0.022;
      const toYaw = yawValues[toGame] || 0.022;
      const degPerCount = fromYaw * sens;
      const countsFor360 = 360 / degPerCount;
      const cm360 = (countsFor360 / dpi) * 2.54;
      const in360 = cm360 / 2.54;
      const targetSens = degPerCount / toYaw;
      const edpi = dpi * sens;
      let tier = 'Mittel';
      if (cm360 > 60) tier = 'Sehr niedrig';
      else if (cm360 > 40) tier = 'Niedrig';
      else if (cm360 > 25) tier = 'Mittel';
      else if (cm360 > 15) tier = 'Hoch';
      else tier = 'Sehr hoch';
      document.getElementById('sep-result')!.textContent = targetSens.toFixed(4);
      document.getElementById('sep-cm360')!.textContent = cm360.toFixed(1) + ' cm';
      document.getElementById('sep-edpi')!.textContent = edpi.toFixed(0);
      document.getElementById('sep-in360')!.textContent = in360.toFixed(1) + ' in';
      document.getElementById('sep-tier')!.textContent = tier;
      let allHtml = '';
      for (const [game, yaw] of Object.entries(yawValues)) {
        const converted = degPerCount / yaw;
        allHtml += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + gameNames[game] + '</span><span>' + converted.toFixed(4) + '</span></div>';
      }
      document.getElementById('sep-all')!.innerHTML = allHtml;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sep-in').forEach(el => { el.addEventListener('input', calcSEP); el.addEventListener('change', calcSEP); });
      calcSEP();
    }, 50);
  </script>
</CalculatorLayout>
