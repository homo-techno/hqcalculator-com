---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Luftkanal-Rechner - Kanaldimensionierung & Luftgeschwindigkeit";
const description = "Berechnen Sie die optimale Kanalgröße für Lüftungsanlagen. Ermitteln Sie Querschnitt, Luftgeschwindigkeit und Druckverlust für runde und rechteckige Kanäle.";

const relatedCalcs = [
  { name: "HVAC-Rechner", url: "/de/hvac-rechner", description: "Heizlast berechnen." },
  { name: "Volumenstrom-Rechner", url: "/de/volumenstrom-rechner", description: "Volumenstrom berechnen." },
  { name: "Druckverlust-Rechner", url: "/de/druckverlust-rechner", description: "Druckverluste." },
  { name: "Energieeffizienz-Rechner", url: "/de/energieeffizienz-rechner", description: "Effizienz berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Luftkanal-Rechner" lang="de" enSlug="duct-sizing-calculator" keywords="luftkanal rechner, kanaldimensionierung, luftgeschwindigkeit, lüftungskanal, druckverlust kanal" breadcrumbs={[{ name: "Luftkanal-Rechner", url: "/de/luftkanal-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Luftkanal-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Dimensionieren Sie Luftkan&auml;le f&uuml;r Ihre L&uuml;ftungsanlage. Berechnen Sie Querschnitt, Luftgeschwindigkeit und &auml;quivalenten Durchmesser.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Volumenstrom (m&sup3;/h)</label><input type="number" id="duc-flow" class="duc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="10" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Luftgeschwindigkeit (m/s)</label><input type="number" id="duc-vel" class="duc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0.1"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Kanalform</label><select id="duc-shape" class="duc-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="round">Rund</option><option value="rect">Rechteckig</option></select></div>
        <div class="grid grid-cols-2 gap-3" id="duc-rect-fields" style="display:none">
          <div><label class="block text-xs font-medium text-text mb-1">Kanalbreite (mm)</label><input type="number" id="duc-width" class="duc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="25" min="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kanalh&ouml;he (mm)</label><input type="number" id="duc-ht" class="duc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="25" min="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Durchmesser</div>
          <div class="text-5xl font-extrabold font-mono" id="duc-result">0 mm</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Querschnitt</div><div class="text-xl font-bold" id="duc-area">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tats. Geschwindigkeit</div><div class="text-xl font-bold" id="duc-actvel">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Auml;quiv. Durchmesser</div><div class="text-xl font-bold" id="duc-equiv">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Volumenstrom (m&sup3;/s)</div><div class="text-xl font-bold" id="duc-flowms">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="duc-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="duct-sizing-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Luftkan&auml;le dimensionieren</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Querschnitt (m&sup2;) = Volumenstrom (m&sup3;/s) / Geschwindigkeit (m/s)</p>
        <p>Durchmesser (mm) = &radic;(4 &times; Querschnitt / &pi;) &times; 1000</p>
        <p>&Auml;quiv. &empty; = 1,3 &times; (a&times;b)^0,625 / (a+b)^0,25</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Luftgeschwindigkeit ist optimal?</strong> F&uuml;r Hauptkan&auml;le 4&ndash;6 m/s, Abzweigungen 3&ndash;4 m/s, Zuluftdurchl&auml;sse 1,5&ndash;2,5 m/s.</p>
      <p><strong>Warum ist der &auml;quivalente Durchmesser wichtig?</strong> Er erlaubt den Vergleich von rechteckigen und runden Kan&auml;len hinsichtlich Druckverlust.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDuc() {
      const flowH = parseFloat((document.getElementById('duc-flow') as HTMLInputElement).value) || 0;
      const maxVel = parseFloat((document.getElementById('duc-vel') as HTMLInputElement).value) || 5;
      const shape = (document.getElementById('duc-shape') as HTMLSelectElement).value;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const flowS = flowH / 3600;
      steps.push('Volumenstrom = ' + flowH + ' m3/h / 3600 = ' + fmt(flowS) + ' m3/s');
      const areaNeeded = flowS / maxVel;
      steps.push('Min. Querschnitt = ' + fmt(flowS) + ' / ' + fmt(maxVel) + ' = ' + (areaNeeded * 10000).toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' cm2');
      const diamM = Math.sqrt(4 * areaNeeded / Math.PI);
      const diamMm = Math.ceil(diamM * 1000 / 25) * 25;
      steps.push('Durchmesser = sqrt(4 x ' + fmt(areaNeeded) + ' / pi) x 1000 = ' + diamMm + ' mm (gerundet)');
      const actualArea = Math.PI * Math.pow(diamMm / 1000 / 2, 2);
      const actualVel = flowS / actualArea;
      steps.push('Tats. Geschwindigkeit = ' + fmt(flowS) + ' / ' + fmt(actualArea) + ' = ' + fmt(actualVel) + ' m/s');
      let equivDiam = diamMm;
      if (shape === 'rect') {
        const w = parseFloat((document.getElementById('duc-width') as HTMLInputElement).value) || 300;
        const h = parseFloat((document.getElementById('duc-ht') as HTMLInputElement).value) || 200;
        equivDiam = Math.round(1.3 * Math.pow(w * h, 0.625) / Math.pow(w + h, 0.25));
        steps.push('Aequiv. Durchmesser = 1,3 x (' + w + ' x ' + h + ')^0,625 / (' + w + ' + ' + h + ')^0,25 = ' + equivDiam + ' mm');
      }
      document.getElementById('duc-result')!.textContent = diamMm + ' mm';
      document.getElementById('duc-area')!.textContent = (areaNeeded * 10000).toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' cm\u00B2';
      document.getElementById('duc-actvel')!.textContent = fmt(actualVel) + ' m/s';
      document.getElementById('duc-equiv')!.textContent = equivDiam + ' mm';
      document.getElementById('duc-flowms')!.textContent = fmt(flowS) + ' m\u00B3/s';
      document.getElementById('duc-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.getElementById('duc-rect-fields')!.style.display = shape === 'rect' ? '' : 'none';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('duc-flow') as HTMLInputElement).value = '500';
      (document.getElementById('duc-vel') as HTMLInputElement).value = '5';
      (document.getElementById('duc-width') as HTMLInputElement).value = '300';
      (document.getElementById('duc-ht') as HTMLInputElement).value = '200';
      document.querySelectorAll('.duc-in').forEach(el => { el.addEventListener('input', calcDuc); el.addEventListener('change', calcDuc); });
      calcDuc();
    }, 50);
  </script>
</CalculatorLayout>
