---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "401k-Rechner - Altersvorsorge & Vermögensaufbau";
const description = "Berechnen Sie, wie Ihr 401(k) über die Zeit mit Beiträgen, Arbeitgeberzuschuss und Kapitalerträgen wächst. Planen Sie Ihre Altersvorsorge.";

const relatedCalcs = [
  { name: "Rentenrechner", url: "/retirement-calculator", description: "Rentenplanung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Kapitalanlagen." },
  { name: "Zinseszinsrechner", url: "/compound-interest-calculator", description: "Zinseszins." },
  { name: "Gehaltsrechner", url: "/salary-calculator", description: "Gehalt." },
  { name: "Einkommensteuer", url: "/income-tax-calculator", description: "Einkommensteuer." },
  { name: "Tilgungsrechner", url: "/de/tilgungsrechner", description: "Tilgungsplan." },
];
---

<CalculatorLayout lang="de" title={title} description={description} calculatorName="401k-Rechner" keywords="401k Rechner, Altersvorsorge, Arbeitgeberzuschuss, 401k Wachstum, Rentenplanung" breadcrumbs={[{ name: "401k-Rechner", url: "/de/401k-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">401k-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Ihr 401(k)-Guthaben bei Renteneintritt mit Arbeitgeberzuschuss.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Jahresgehalt</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">€</span>
              <input type="number" id="k-salary" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="75000" min="0" step="1000">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Eigenbeitrag (%)</label>
              <input type="number" id="k-contrib" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="0" max="100" step="1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Gehaltssteigerung (%/Jahr)</label>
              <input type="number" id="k-raise" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="0" max="15" step="0.5">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Arbeitgeberzuschuss (%)</label>
              <input type="number" id="k-match" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="50" min="0" max="100" step="5">
              <p class="text-xs text-text-muted mt-1">% Ihres Beitrags, den der Arbeitgeber zuschießt</p>
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Zuschussgrenze (% Gehalt)</label>
              <input type="number" id="k-match-limit" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="6" min="0" max="100" step="1">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Aktuelles 401(k)-Guthaben</label>
              <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">€</span>
                <input type="number" id="k-balance" class="w-full pl-7 pr-3 py-3 border border-border rounded-xl text-lg" value="25000" min="0" step="5000">
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Jahre bis zur Rente</label>
              <input type="number" id="k-years" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="30" min="1" max="50" step="1">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Erwartete Rendite (%/Jahr)</label>
            <input type="number" id="k-return" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="7" min="0" max="15" step="0.5">
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Prognostiziertes 401(k)-Guthaben</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="k-total">0 €</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Ihre Beiträge</div>
              <div class="text-xl font-bold" id="k-yours">0 €</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Arbeitgeberzuschuss</div>
              <div class="text-xl font-bold text-secondary" id="k-employer">0 €</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Kapitalertrag</div>
              <div class="text-xl font-bold" id="k-growth">0 €</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Geschenktes Geld (Zuschuss)</div>
              <div class="text-xl font-bold text-green-600" id="k-free">0 €</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Wachstumsmeilensteine</h3>
            <div class="space-y-1 text-sm" id="k-table"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="401k" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie 401(k)-Pläne funktionieren</h2>
      <p>Ein 401(k) ermöglicht es Ihnen, Einkommen vor Steuern in ein Rentenkonto einzuzahlen. Viele Arbeitgeber stocken einen Teil Ihrer Beiträge auf — das ist im Grunde geschenktes Geld. Die Beitragsgrenze 2024 beträgt $23.000 ($30.500 ab 50 Jahren).</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel sollte ich einzahlen?</strong> Zahlen Sie mindestens so viel ein, dass Sie den vollen Arbeitgeberzuschuss erhalten. Idealerweise streben Sie 15% Ihres Gehalts inklusive Zuschuss an.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' €';

    function calc401k() {
      let salary = parseFloat((document.getElementById('k-salary') as HTMLInputElement).value) || 0;
      const contribPct = (parseFloat((document.getElementById('k-contrib') as HTMLInputElement).value) || 0) / 100;
      const raisePct = (parseFloat((document.getElementById('k-raise') as HTMLInputElement).value) || 0) / 100;
      const matchPct = (parseFloat((document.getElementById('k-match') as HTMLInputElement).value) || 0) / 100;
      const matchLimit = (parseFloat((document.getElementById('k-match-limit') as HTMLInputElement).value) || 0) / 100;
      const balance = parseFloat((document.getElementById('k-balance') as HTMLInputElement).value) || 0;
      const years = parseInt((document.getElementById('k-years') as HTMLInputElement).value) || 1;
      const returnRate = (parseFloat((document.getElementById('k-return') as HTMLInputElement).value) || 0) / 100;

      let total = balance;
      let totalYours = 0, totalEmployer = 0;
      const rows: string[] = [];
      rows.push('<div class="grid grid-cols-4 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Jahr</span><span>Beitrag</span><span>Zuschuss</span><span>Guthaben</span></div>');

      for (let y = 1; y <= years; y++) {
        const yourContrib = salary * contribPct;
        const matchableContrib = Math.min(salary * contribPct, salary * matchLimit);
        const employerMatch = matchableContrib * matchPct;

        totalYours += yourContrib;
        totalEmployer += employerMatch;

        total = (total + yourContrib + employerMatch) * (1 + returnRate);
        salary *= (1 + raisePct);

        if (y <= 5 || y % 5 === 0 || y === years) {
          rows.push(`<div class="grid grid-cols-4 gap-1 text-xs ${y === years ? 'font-bold' : ''}"><span>${y}</span><span>${fmt(yourContrib)}</span><span>${fmt(employerMatch)}</span><span>${fmt(total)}</span></div>`);
        }
      }

      const growth = total - balance - totalYours - totalEmployer;

      document.getElementById('k-total')!.textContent = fmt(total);
      document.getElementById('k-yours')!.textContent = fmt(totalYours);
      document.getElementById('k-employer')!.textContent = fmt(totalEmployer);
      document.getElementById('k-growth')!.textContent = fmt(growth);
      document.getElementById('k-free')!.textContent = fmt(totalEmployer);
      document.getElementById('k-table')!.innerHTML = rows.join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['k-salary', 'k-contrib', 'k-raise', 'k-match', 'k-match-limit', 'k-balance', 'k-years', 'k-return'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calc401k);
      });
      calc401k();
    }, 50);
  </script>
</CalculatorLayout>
