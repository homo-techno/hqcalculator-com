---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Pausenplan-Rechner - Pomodoro, 52-17 & mehr";
const description = "Planen Sie Ihren optimalen Pausenplan mit Pomodoro, 52-17 oder 90-Minuten-Zyklen. Sehen Sie Pausenzeiten, Gesamtpausenzeit und Produktivit&auml;tssch&auml;tzungen.";
const relatedCalcs = [
  { name: "Produktivit&auml;t", url: "/de/produktivitaetsrechner", description: "Produktivit&auml;t." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeitberechnung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Arbeitstage-Rechner", url: "/de/arbeitstage-rechner", description: "Arbeitstage berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Pausenplan-Rechner" lang="de" enSlug="break-schedule-calculator" keywords="pausenplan, pomodoro technik, 52-17 methode, arbeitspausen, produktivit&auml;t" breadcrumbs={[{ name: "Pausenplan-Rechner", url: "/de/pausenplan-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Pausenplan-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Optimieren Sie Ihren Arbeitstag mit wissenschaftlich fundierten Pausenintervallen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schichtl&auml;nge (Stunden)</label><input type="number" id="bs2-shift" class="bs2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" max="16" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Startzeit</label><input type="time" id="bs2-start" class="bs2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Pausenmethode</label>
          <select id="bs2-method" class="bs2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="pomodoro">Pomodoro (25 Min Arbeit / 5 Min Pause)</option>
            <option value="5217">52-17 Methode (52 Min Arbeit / 17 Min Pause)</option>
            <option value="90min">90-Minuten-Zyklus (90 Min Arbeit / 20 Min Pause)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3" id="bs2-custom-row" style="display:none">
          <div><label class="block text-xs font-medium text-text mb-1">Arbeitsblock (Min)</label><input type="number" id="bs2-workmin" class="bs2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="10" max="120" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Pausenl&auml;nge (Min)</label><input type="number" id="bs2-breakmin" class="bs2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="3" max="30" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Arbeitsbl&ouml;cke</div>
          <div class="text-5xl font-extrabold font-mono" id="bs2-blocks">0</div>
          <div class="text-sm text-blue-200 mt-1">fokussierte Sitzungen</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtarbeitszeit</div><div class="text-xl font-bold" id="bs2-work">0 Std</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtpausenzeit</div><div class="text-xl font-bold" id="bs2-break">0 Min</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Arbeitsanteil</div><div class="text-xl font-bold" id="bs2-ratio">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Produktivit&auml;tssch&auml;tzung</div><div class="text-xl font-bold" id="bs2-prod">0%</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Pausenplan</h3>
          <div class="space-y-1 text-sm" id="bs2-schedule"></div>
        </div>
      </div>
      <ShareButton calculatorId="break-schedule" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Die Wissenschaft der Pausen</h2>
      <p>Forschungen zeigen, dass regelm&auml;&szlig;ige Pausen den Fokus verbessern und Burnout vorbeugen. Die Pomodoro-Technik nutzt 25-Minuten-Sprints, w&auml;hrend die 52-17-Methode von DeskTime als Muster der produktivsten Arbeitnehmer identifiziert wurde. Ultradiane Rhythmen deuten darauf hin, dass 90-Minuten-Zyklen nat&uuml;rlichen Energiemustern entsprechen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBreaks() {
      const shift = parseFloat((document.getElementById('bs2-shift') as HTMLInputElement).value) || 8;
      const startTime = (document.getElementById('bs2-start') as HTMLInputElement).value || '09:00';
      const method = (document.getElementById('bs2-method') as HTMLSelectElement).value;
      const customRow = document.getElementById('bs2-custom-row') as HTMLElement;
      customRow.style.display = method === 'custom' ? '' : 'none';
      let workMin: number, breakMin: number;
      if (method === 'pomodoro') { workMin = 25; breakMin = 5; }
      else if (method === '5217') { workMin = 52; breakMin = 17; }
      else if (method === '90min') { workMin = 90; breakMin = 20; }
      else {
        workMin = parseFloat((document.getElementById('bs2-workmin') as HTMLInputElement).value) || 45;
        breakMin = parseFloat((document.getElementById('bs2-breakmin') as HTMLInputElement).value) || 10;
      }
      const totalMin = shift * 60;
      const cycleMin = workMin + breakMin;
      const cycles = Math.floor(totalMin / cycleMin);
      const remainMin = totalMin - cycles * cycleMin;
      const extraWork = Math.min(remainMin, workMin);
      const totalWork = cycles * workMin + extraWork;
      const totalBreak = cycles * breakMin;
      const workRatio = Math.round(totalWork / totalMin * 100);
      const noBreakProd = 60;
      const withBreakProd = Math.min(95, noBreakProd + (totalBreak / totalMin * 100) * 0.8);
      const [startH, startM] = startTime.split(':').map(Number);
      let currentMin = startH * 60 + startM;
      const schedule: string[] = [];
      for (let i = 0; i < cycles; i++) {
        const wStart = formatTime(currentMin);
        currentMin += workMin;
        const wEnd = formatTime(currentMin);
        schedule.push(`<div class="flex justify-between py-1 border-b border-border"><span class="text-green-700">Arbeit ${i + 1}: ${wStart} - ${wEnd}</span><span>${workMin} Min</span></div>`);
        const bStart = formatTime(currentMin);
        currentMin += breakMin;
        const bEnd = formatTime(currentMin);
        schedule.push(`<div class="flex justify-between py-1 border-b border-border"><span class="text-blue-600">Pause: ${bStart} - ${bEnd}</span><span>${breakMin} Min</span></div>`);
      }
      if (extraWork > 0) {
        const wStart = formatTime(currentMin);
        currentMin += extraWork;
        const wEnd = formatTime(currentMin);
        schedule.push(`<div class="flex justify-between py-1"><span class="text-green-700">Arbeit ${cycles + 1}: ${wStart} - ${wEnd}</span><span>${extraWork} Min</span></div>`);
      }
      document.getElementById('bs2-blocks')!.textContent = (cycles + (extraWork > 0 ? 1 : 0)).toString();
      document.getElementById('bs2-work')!.textContent = (totalWork / 60).toFixed(1).replace('.', ',') + ' Std';
      document.getElementById('bs2-break')!.textContent = totalBreak + ' Min';
      document.getElementById('bs2-ratio')!.textContent = workRatio + '%';
      document.getElementById('bs2-prod')!.textContent = Math.round(withBreakProd) + '%';
      document.getElementById('bs2-schedule')!.innerHTML = schedule.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    function formatTime(mins: number): string {
      const h = Math.floor(mins / 60) % 24;
      const m = mins % 60;
      return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
    }
    setTimeout(() => {
      (document.getElementById('bs2-shift') as HTMLInputElement).value = '8';
      (document.getElementById('bs2-start') as HTMLInputElement).value = '09:00';
      (document.getElementById('bs2-workmin') as HTMLInputElement).value = '45';
      (document.getElementById('bs2-breakmin') as HTMLInputElement).value = '10';
      document.querySelectorAll('.bs2-in').forEach(el => { el.addEventListener('input', calcBreaks); el.addEventListener('change', calcBreaks); });
      calcBreaks();
    }, 50);
  </script>
</CalculatorLayout>
