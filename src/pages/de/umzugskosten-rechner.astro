---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Umzugskosten Rechner - Gesamtkosten inkl. Umzugsunternehmen";
const description = "Berechnen Sie die Gesamtkosten Ihres Umzugs inklusive Umzugsunternehmen, Transport und Arbeitszeit.";
const relatedCalcs = [
  { name: "Umzugsbudget Rechner", url: "/de/umzugsbudget-rechner", description: "Gesamtbudget planen." },
  { name: "Abschlusskosten Rechner", url: "/de/abschlusskosten-rechner", description: "Kaufnebenkosten." },
  { name: "Nettovermögen Rechner", url: "/de/nettovermoegen-rechner", description: "Vermögen berechnen." },
  { name: "Kapitalwert Rechner", url: "/de/kapitalwert-rechner", description: "Investitionen bewerten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Umzugskosten Rechner" enSlug="moving-cost-calculator" keywords="Umzugskosten, Umzugsunternehmen, Transportkosten, Möbeltransport, Umzug berechnen" breadcrumbs={[{ name: "Umzugskosten Rechner", url: "/de/umzugskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Umzugskosten Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Kosten Ihres Umzugs auf Basis von Stundensatz, Helferzahl, Entfernung und Fahrzeugkosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Helfer</label><input type="number" id="uk-helpers" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stundensatz je Helfer (€/h)</label><input type="number" id="uk-rate" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="0" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Umzugsdauer (Stunden)</label><input type="number" id="uk-hours" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Entfernung (km)</label><input type="number" id="uk-distance" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fahrzeugkosten (€/Tag)</label><input type="number" id="uk-truck" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kraftstoffkosten (€/km)</label><input type="number" id="uk-fuel" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.35" min="0" step="0.05"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verpackungsmaterial (€)</label><input type="number" id="uk-packing" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Trinkgeld & Sonstiges (€)</label><input type="number" id="uk-tips" class="uk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten Umzug</div>
          <div class="text-5xl font-extrabold font-mono" id="uk-result">0,00 €</div>
          <div class="text-sm text-blue-200 mt-1" id="uk-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Personalkosten</div><div class="text-xl font-bold" id="uk-labor">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Transportkosten</div><div class="text-xl font-bold" id="uk-transport">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Material & Sonstiges</div><div class="text-xl font-bold" id="uk-other">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Stunde</div><div class="text-xl font-bold" id="uk-perhour">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="umzugskosten" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Umzugskosten richtig kalkulieren</h2>
      <p>Die Kosten eines Umzugs setzen sich hauptsächlich aus Personalkosten, Fahrzeugmiete und Treibstoff zusammen. Professionelle Umzugsunternehmen berechnen in der Regel einen Pauschalpreis oder einen Stundensatz. Beim Vergleich von Angeboten sollten alle Leistungen wie Demontage, Verpackung und Einlagerung berücksichtigt werden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was kostet ein Umzugshelfer pro Stunde?</strong></p><p>Professionelle Umzugshelfer kosten 25–50 € pro Stunde. Private Helfer über Plattformen können günstiger sein, bieten aber keine Versicherung.</p></div>
        <div><p><strong>Wie berechnet man die Transportkosten?</strong></p><p>Transportkosten bestehen aus der Fahrzeugmiete (80–200 €/Tag) und dem Kraftstoffverbrauch. Bei 100 km Strecke und 0,35 €/km kommen 35 € Treibstoffkosten hinzu.</p></div>
        <div><p><strong>Gibt es eine Umzugsversicherung?</strong></p><p>Ja, Umzugsunternehmen haften für Schäden, die ihre Mitarbeiter verursachen. Der gesetzliche Haftungsrahmen liegt bei 620 € pro Kubikmeter Ladung.</p></div>
        <div><p><strong>Wie viel Trinkgeld ist üblich?</strong></p><p>Bei zufriedenstellender Leistung sind 5–10 € pro Helfer üblich. Bei besonders gutem Service können auch 15–20 € pro Person angemessen sein.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcUK() {
      const helpers = parseFloat((document.getElementById('uk-helpers') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('uk-rate') as HTMLInputElement).value) || 0;
      const hours = parseFloat((document.getElementById('uk-hours') as HTMLInputElement).value) || 0;
      const distance = parseFloat((document.getElementById('uk-distance') as HTMLInputElement).value) || 0;
      const truck = parseFloat((document.getElementById('uk-truck') as HTMLInputElement).value) || 0;
      const fuel = parseFloat((document.getElementById('uk-fuel') as HTMLInputElement).value) || 0;
      const packing = parseFloat((document.getElementById('uk-packing') as HTMLInputElement).value) || 0;
      const tips = parseFloat((document.getElementById('uk-tips') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      const labor = helpers * rate * hours;
      const transport = truck + distance * fuel * 2;
      const other = packing + tips;
      const total = labor + transport + other;
      const perHour = hours > 0 ? total / hours : 0;
      document.getElementById('uk-result')!.textContent = fmt(total);
      document.getElementById('uk-sub')!.textContent = helpers + ' Helfer × ' + hours + ' h × ' + fmt(rate).replace(' €','') + ' €/h + Transport';
      document.getElementById('uk-labor')!.textContent = fmt(labor);
      document.getElementById('uk-transport')!.textContent = fmt(transport);
      document.getElementById('uk-other')!.textContent = fmt(other);
      document.getElementById('uk-perhour')!.textContent = fmt(perHour);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.uk-in').forEach(el => { el.addEventListener('input', calcUK); el.addEventListener('change', calcUK); });
      calcUK();
    }, 50);
  </script>
</CalculatorLayout>
