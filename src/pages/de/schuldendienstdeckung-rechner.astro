---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schuldendienstdeckung-Rechner - DSCR berechnen";
const description = "Berechnen Sie die Schuldendienstdeckungsquote (DSCR), den ueberschuessigen Cashflow und den Kreditqualifikationsstatus aus NOI und Schuldendienst.";

const relatedCalcs = [
  { name: "Rendite-Rechner", url: "/de/rendite-rechner", description: "Kapitalisierungsrate." },
  { name: "Mietrendite-Rechner", url: "/de/mietrendite-rechner", description: "Mietobjekt-ROI." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Cash-Flow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="debt-service-coverage-calculator" calculatorName="Schuldendienstdeckung-Rechner" keywords="DSCR, schuldendienstdeckungsquote, kreditqualifikation, NOI, schuldendienst, gewerbekredit" breadcrumbs={[{ name: "Schuldendienstdeckung-Rechner", url: "/de/schuldendienstdeckung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schuldendienstdeckung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie Ihre DSCR und ob Sie sich f&uuml;r eine gewerbliche Finanzierung qualifizieren.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Netto-Betriebsergebnis (j&auml;hrlich) (&euro;)</label><input type="number" id="sd-noi" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="180000" min="0" step="1000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrlicher Schuldendienst (&euro;) (Tilgung + Zinsen)</label><input type="number" id="sd-debt" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="140000" min="0" step="1000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Mindest-DSCR des Kreditgebers</label><input type="number" id="sd-min" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.25" min="0" max="3" step="0.05"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Kreditbetrag (&euro;)</label><input type="number" id="sd-loan" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500000" min="0" step="10000"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">DSCR-Quote</div>
          <div class="text-5xl font-extrabold font-mono" id="sd-result">0,00x</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kreditqualifikation</div><div class="text-xl font-bold font-mono" id="sd-qualify">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Uuml;berschuss-Cashflow</div><div class="text-xl font-bold font-mono" id="sd-excess">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. NOI</div><div class="text-xl font-bold font-mono" id="sd-monthlynoi">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatl. Schuldendienst</div><div class="text-xl font-bold font-mono" id="sd-monthlydebt">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schuldenrendite</div><div class="text-xl font-bold font-mono" id="sd-yield">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Schuldendienst</div><div class="text-xl font-bold font-mono" id="sd-maxdebt">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="debt-service-coverage" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Schuldendienstdeckungsquote (DSCR) erkl&auml;rt</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p><strong>DSCR</strong> = Netto-Betriebsergebnis / J&auml;hrlicher Schuldendienst</p>
      </div>
      <p>Die DSCR zeigt, ob ein Objekt genug Einkommen generiert, um den Schuldendienst zu decken. Ein DSCR von 1,25x bedeutet, dass das Einkommen den Schuldendienst um 25% &uuml;bersteigt.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche DSCR fordern Banken in Deutschland?</strong> Typischerweise mindestens 1,20x bis 1,30x f&uuml;r gewerbliche Immobilienkredite.</p>
      <p><strong>Was passiert bei einer DSCR unter 1,0?</strong> Das Einkommen reicht nicht zur Schuldendeckung. Der Kredit wird in der Regel nicht genehmigt.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSD() {
      const noi = parseFloat((document.getElementById('sd-noi') as HTMLInputElement).value) || 0;
      const debtService = parseFloat((document.getElementById('sd-debt') as HTMLInputElement).value) || 0;
      const minDSCR = parseFloat((document.getElementById('sd-min') as HTMLInputElement).value) || 1.25;
      const loanAmount = parseFloat((document.getElementById('sd-loan') as HTMLInputElement).value) || 0;

      const dscr = debtService > 0 ? noi / debtService : 0;
      const excessCashFlow = noi - debtService;
      const qualified = dscr >= minDSCR;
      const monthlyNOI = noi / 12;
      const monthlyDebt = debtService / 12;
      const debtYield = loanAmount > 0 ? (noi / loanAmount) * 100 : 0;
      const maxDebtService = minDSCR > 0 ? noi / minDSCR : 0;

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('sd-result')!.textContent = dscr.toFixed(2).replace('.', ',') + 'x';
      document.getElementById('sd-qualify')!.textContent = qualified ? 'QUALIFIZIERT' : 'NICHT QUALIFIZIERT';
      (document.getElementById('sd-qualify') as HTMLElement).style.color = qualified ? '#16a34a' : '#dc2626';
      document.getElementById('sd-excess')!.textContent = fmt(excessCashFlow);
      document.getElementById('sd-monthlynoi')!.textContent = fmt(monthlyNOI);
      document.getElementById('sd-monthlydebt')!.textContent = fmt(monthlyDebt);
      document.getElementById('sd-yield')!.textContent = debtYield.toFixed(2).replace('.', ',') + '%';
      document.getElementById('sd-maxdebt')!.textContent = fmt(maxDebtService);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sd-in').forEach(el => { el.addEventListener('input', calcSD); el.addEventListener('change', calcSD); });
      calcSD();
    }, 50);
  </script>
</CalculatorLayout>
