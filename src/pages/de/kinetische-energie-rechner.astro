---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kinetische Energie Rechner – E = ½mv² berechnen";
const description = "Berechnen Sie kinetische Energie mit Masse und Geschwindigkeit (E = ½mv²).";
const relatedCalcs = [
  { name: "Interpolationsrechner", url: "/de/interpolations-rechner", description: "Lineare Interpolation." },
  { name: "Kerosin Rechner", url: "/de/kerosin-rechner", description: "Treibstoffverbrauch Flugzeug." },
  { name: "Infusionsraten Rechner", url: "/de/infusionsrate-rechner", description: "IV Tropfraten." },
  { name: "Intervalltraining Rechner", url: "/de/intervalltraining-rechner", description: "HIIT planen." },
];
---
<CalculatorLayout lang="de" enSlug="kinetic-energy-calculator" title={title} description={description} calculatorName="Kinetische Energie Rechner" keywords="Kinetische Energie, E=½mv², Energie berechnen, Bewegungsenergie, Physik Rechner, Joule Newton" breadcrumbs={[{ name: "Kinetische Energie Rechner", url: "/de/kinetische-energie-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kinetische Energie Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die kinetische Energie (Bewegungsenergie) eines Körpers mit der Formel E = ½ × m × v² – inklusive Einheitenumrechnung und Vergleichswerten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Masse</label>
            <input type="number" id="ke-mass" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1000" min="0" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Masse-Einheit</label>
            <select id="ke-mass-unit" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1" selected>kg</option>
              <option value="0.001">g (Gramm)</option>
              <option value="1000">t (Tonnen)</option>
              <option value="0.453592">lb (Pfund)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Geschwindigkeit</label>
            <input type="number" id="ke-vel" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="100" min="0" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Geschwindigkeit-Einheit</label>
            <select id="ke-vel-unit" class="ke-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1" selected>km/h</option>
              <option value="3.6">m/s</option>
              <option value="1.60934">mph</option>
              <option value="0.514444">kn (Knoten)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kinetische Energie</div>
          <div class="text-5xl font-extrabold font-mono" id="ke-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="ke-result-unit">Joule</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kilojoule (kJ)</div><div class="text-xl font-bold" id="ke-kj">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wh</div><div class="text-xl font-bold" id="ke-wh">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien (kcal)</div><div class="text-xl font-bold" id="ke-kcal">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Vergleichswerte bekannter Objekte</h3>
          <div class="text-xs space-y-1" id="ke-compare"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Rechenweg</h3>
          <div class="font-mono text-sm space-y-1" id="ke-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kinetic-energy" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Kinetische Energie – Grundlagen der Physik</h2>
      <p class="text-text-secondary">Die kinetische Energie (Bewegungsenergie) ist die Energie, die ein Körper aufgrund seiner Bewegung besitzt. Sie hängt von Masse und Quadrat der Geschwindigkeit ab: E = ½ × m × v². Das bedeutet: Verdoppelt man die Geschwindigkeit, vervierfacht sich die kinetische Energie. Dies erklärt, warum Bremsweg und Aufprallkraft bei höheren Geschwindigkeiten so viel dramatischer zunehmen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>E = ½ × m × v²</p>
        <p>E in Joule (J) = kg × (m/s)²</p>
        <p>1 kWh = 3.600.000 J</p>
        <p>1 kcal = 4.184 J</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zwischen kinetischer und potentieller Energie?</h4>
          <p class="text-text-secondary mt-1">Kinetische Energie (Bewegungsenergie) besitzt ein Körper durch seine Bewegung. Potentielle Energie (Lageenergie) besitzt ein Körper durch seine Höhe im Schwerefeld: E_pot = m × g × h. Zusammen bilden sie die mechanische Gesamtenergie, die beim freien Fall konstant bleibt (Energieerhaltungssatz).</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Warum ist der Bremsweg proportional zum Quadrat der Geschwindigkeit?</h4>
          <p class="text-text-secondary mt-1">Weil die kinetische Energie mit v² wächst: Bei doppelter Geschwindigkeit muss die viermal so große Energie durch Reibungskräfte abgebaut werden. Da die Bremskraft konstant bleibt (F = konst.), verlängert sich der Bremsweg auf das Vierfache. Bei 100 km/h ist der Bremsweg ca. 4× länger als bei 50 km/h.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel kinetische Energie hat ein fahrendes Auto?</h4>
          <p class="text-text-secondary mt-1">Ein 1.000-kg-Auto bei 100 km/h (27,8 m/s) hat eine kinetische Energie von ½ × 1000 × 27,8² ≈ 385.000 J ≈ 385 kJ. Das entspricht etwa der Energie von 92 kcal oder 0,107 kWh – genug, um ca. 385 Liter Wasser um 1 °C zu erwärmen.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie wird kinetische Energie beim Bremsen umgewandelt?</h4>
          <p class="text-text-secondary mt-1">Beim konventionellen Bremsen wird kinetische Energie in Wärme umgewandelt (Reibungswärme in den Bremsscheiben). Bei Elektro- und Hybridfahrzeugen wird ein Teil durch Rekuperation (Nutzbremsung) in elektrische Energie zurückgewandelt und im Akku gespeichert – typisch 15–30 % der Bremsenergie.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Gilt E = ½mv² auch für rotierende Körper?</h4>
          <p class="text-text-secondary mt-1">Für rotierende starre Körper gilt die analoge Formel: E_rot = ½ × I × ω², wobei I das Trägheitsmoment und ω die Winkelgeschwindigkeit ist. Bei einem rollenden Ball kombinieren sich Translations- und Rotationsenergie: E_ges = ½mv² + ½Iω².</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKE() {
      const massVal = parseFloat((document.getElementById('ke-mass') as HTMLInputElement).value) || 0;
      const massUnit = parseFloat((document.getElementById('ke-mass-unit') as HTMLSelectElement).value) || 1;
      const velVal = parseFloat((document.getElementById('ke-vel') as HTMLInputElement).value) || 0;
      const velUnit = parseFloat((document.getElementById('ke-vel-unit') as HTMLSelectElement).value) || 1;
      const massKg = massVal * massUnit;
      const velMs = velUnit === 1 ? velVal / 3.6 : velVal / velUnit;
      const eJ = 0.5 * massKg * velMs * velMs;
      const eKj = eJ / 1000;
      const eWh = eJ / 3600;
      const eKcal = eJ / 4184;
      const fmtE = (v: number): string => {
        if (v >= 1e12) return (v / 1e12).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' TJ';
        if (v >= 1e9) return (v / 1e9).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' GJ';
        if (v >= 1e6) return (v / 1e6).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' MJ';
        if (v >= 1e3) return (v / 1e3).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' kJ';
        return v.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' J';
      };
      document.getElementById('ke-result')!.textContent = fmtE(eJ);
      document.getElementById('ke-kj')!.textContent = eKj.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' kJ';
      document.getElementById('ke-wh')!.textContent = eWh.toLocaleString('de-DE', { maximumFractionDigits: 4 }) + ' Wh';
      document.getElementById('ke-kcal')!.textContent = eKcal.toLocaleString('de-DE', { maximumFractionDigits: 4 }) + ' kcal';
      const velKmh = velUnit === 1 ? velVal : velMs * 3.6;
      const steps = [
        'm = ' + massVal.toLocaleString('de-DE') + ' × ' + massUnit + ' = ' + massKg.toLocaleString('de-DE') + ' kg',
        'v = ' + velVal.toLocaleString('de-DE') + (velUnit === 1 ? ' km/h = ' + velMs.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' m/s' : ' → ' + velMs.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' m/s'),
        'E = ½ × ' + massKg.toLocaleString('de-DE') + ' × ' + velMs.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + '²',
        'E = ½ × ' + massKg.toLocaleString('de-DE') + ' × ' + (velMs * velMs).toLocaleString('de-DE', { maximumFractionDigits: 2 }),
        'E = ' + eJ.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' J = ' + eKj.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' kJ',
      ];
      document.getElementById('ke-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      const comparisons = [
        { label: 'Baseball (0,145 kg, 150 km/h)', eJ: 0.5 * 0.145 * (150/3.6) * (150/3.6) },
        { label: 'Fahrrad + Fahrer (90 kg, 20 km/h)', eJ: 0.5 * 90 * (20/3.6) * (20/3.6) },
        { label: 'Auto (1.400 kg, 50 km/h)', eJ: 0.5 * 1400 * (50/3.6) * (50/3.6) },
        { label: 'Auto (1.400 kg, 100 km/h)', eJ: 0.5 * 1400 * (100/3.6) * (100/3.6) },
        { label: 'Jumbo Jet (400 t, 900 km/h)', eJ: 0.5 * 400000 * (900/3.6) * (900/3.6) },
      ];
      document.getElementById('ke-compare')!.innerHTML = comparisons.map(c => {
        const isClose = eJ > 0 && Math.abs(Math.log10(eJ) - Math.log10(c.eJ)) < 0.5;
        return '<div class="flex justify-between' + (isClose ? ' text-blue-700 font-bold' : '') + '"><span>' + c.label + '</span><span>' + fmtE(c.eJ) + (isClose ? ' ≈ Ihr Wert' : '') + '</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ke-in').forEach(el => { el.addEventListener('input', calcKE); el.addEventListener('change', calcKE); });
      calcKE();
    }, 50);
  </script>
</CalculatorLayout>
