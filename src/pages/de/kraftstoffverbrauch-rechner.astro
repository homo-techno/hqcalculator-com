---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kraftstoffverbrauch-Rechner - Flugzeug Treibstoffplanung";
const description = "Berechnen Sie den Kraftstoffverbrauch aus Entfernung, Geschwindigkeit und Durchflussrate. Ermitteln Sie Reichweite, Reserven und maximale Flugdauer.";
const relatedCalcs = [
  { name: "Kraftstoffeffizienz-Umrechner", url: "/de/kraftstoffeffizienz-umrechner", description: "Kraftstoffumrechnung." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Kraftstoffzuschlag-Rechner", url: "/de/kraftstoffzuschlag-rechner", description: "Kraftstoffzuschlag." },
  { name: "Kraft-Rechner", url: "/de/kraft-rechner", description: "Kraftberechnungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kraftstoffverbrauch-Rechner" lang="de" enSlug="fuel-burn-calculator" keywords="kraftstoffverbrauch, treibstoffplanung, flugzeug reichweite, reservekraftstoff, luftfahrt treibstoff" breadcrumbs={[{ name: "Kraftstoffverbrauch", url: "/de/kraftstoffverbrauch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kraftstoffverbrauch-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kraftstoffverbrauch, Flugdauer und Reserveanforderungen f&uuml;r die Flugplanung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Entfernung (NM)</label>
          <input type="number" id="kvr-dist" class="kvr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="10">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Wahre Fluggeschwindigkeit (kts)</label>
          <input type="number" id="kvr-tas" class="kvr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gegenwind (-) / R&uuml;ckenwind (+) (kts)</label>
          <input type="number" id="kvr-wind" class="kvr-in w-full border border-border rounded-lg px-3 py-2" step="5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Durchflussrate (L/h)</label>
          <input type="number" id="kvr-ff" class="kvr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Nutzbarer Kraftstoff (Liter)</label>
          <input type="number" id="kvr-cap" class="kvr-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Reserveanforderung</label>
          <select id="kvr-res" class="kvr-in w-full border border-border rounded-lg px-3 py-2">
            <option value="30">VFR Tag - 30 min</option>
            <option value="45" selected>VFR Nacht - 45 min</option>
            <option value="45">IFR - 45 min</option>
            <option value="60">60 min Reserve</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kraftstoff f&uuml;r Flug ben&ouml;tigt</div>
          <div class="text-5xl font-extrabold font-mono" id="kvr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Grundgeschwindigkeit</div>
            <div class="text-xl font-bold font-mono" id="kvr-gs">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Flugzeit</div>
            <div class="text-xl font-bold font-mono" id="kvr-time">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Streckenkraftstoff</div>
            <div class="text-xl font-bold font-mono" id="kvr-trip">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Reservekraftstoff</div>
            <div class="text-xl font-bold font-mono" id="kvr-rfuel">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamte Flugdauer</div>
            <div class="text-xl font-bold font-mono" id="kvr-endur">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Max. Reichweite (ohne Reserve)</div>
            <div class="text-xl font-bold font-mono" id="kvr-range">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Kraftstoffstatus</div>
          <div class="text-lg font-bold font-mono" id="kvr-status">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fuel-burn-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kraftstoffplanung in der Luftfahrt</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Streckenkraftstoff = Flugzeit &times; Durchflussrate</p>
        <p>Reservekraftstoff = Reservezeit &times; Durchflussrate</p>
        <p>Gesamt = Streckenkraftstoff + Reservekraftstoff</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum brauche ich Reservekraftstoff?</strong> Reservekraftstoff ist gesetzlich vorgeschrieben und erm&ouml;glicht Ausweichman&ouml;ver, Umleitungen oder Wartezeiten bei der Landung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKVR() {
      const dist = parseFloat((document.getElementById('kvr-dist') as HTMLInputElement).value) || 0;
      const tas = parseFloat((document.getElementById('kvr-tas') as HTMLInputElement).value) || 120;
      const wind = parseFloat((document.getElementById('kvr-wind') as HTMLInputElement).value) || 0;
      const ff = parseFloat((document.getElementById('kvr-ff') as HTMLInputElement).value) || 38;
      const cap = parseFloat((document.getElementById('kvr-cap') as HTMLInputElement).value) || 210;
      const resMins = parseFloat((document.getElementById('kvr-res') as HTMLSelectElement).value) || 45;
      const gs = tas + wind;
      const flightTimeHrs = gs > 0 ? dist / gs : 0;
      const tripFuel = flightTimeHrs * ff;
      const reserveFuel = (resMins / 60) * ff;
      const totalRequired = tripFuel + reserveFuel;
      const enduranceHrs = ff > 0 ? cap / ff : 0;
      const maxRange = gs > 0 ? (cap / ff) * gs : 0;
      const hrs = Math.floor(flightTimeHrs);
      const mins = Math.round((flightTimeHrs - hrs) * 60);
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('kvr-result')!.textContent = fmt(totalRequired) + ' L';
      document.getElementById('kvr-gs')!.textContent = gs.toFixed(0) + ' kts';
      document.getElementById('kvr-time')!.textContent = hrs + 'h ' + mins + 'min';
      document.getElementById('kvr-trip')!.textContent = fmt(tripFuel) + ' L';
      document.getElementById('kvr-rfuel')!.textContent = fmt(reserveFuel) + ' L';
      const eHrs = Math.floor(enduranceHrs);
      const eMins = Math.round((enduranceHrs - eHrs) * 60);
      document.getElementById('kvr-endur')!.textContent = eHrs + 'h ' + eMins + 'min';
      document.getElementById('kvr-range')!.textContent = maxRange.toFixed(0) + ' NM';
      let status = '';
      let color = '#16a34a';
      if (totalRequired > cap) { status = 'KRAFTSTOFF UNZUREICHEND - ' + fmt(totalRequired - cap) + ' L mehr ben\u00F6tigt'; color = '#dc2626'; }
      else { const extra = cap - totalRequired; status = 'OK - ' + fmt(extra) + ' L \u00FCber Reserve'; }
      document.getElementById('kvr-status')!.textContent = status;
      (document.getElementById('kvr-status')! as HTMLElement).style.color = color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('kvr-dist') as HTMLInputElement).value = '250';
      (document.getElementById('kvr-tas') as HTMLInputElement).value = '120';
      (document.getElementById('kvr-wind') as HTMLInputElement).value = '-10';
      (document.getElementById('kvr-ff') as HTMLInputElement).value = '38';
      (document.getElementById('kvr-cap') as HTMLInputElement).value = '210';
      document.querySelectorAll('.kvr-in').forEach(el => { el.addEventListener('input', calcKVR); el.addEventListener('change', calcKVR); });
      calcKVR();
    }, 50);
  </script>
</CalculatorLayout>
