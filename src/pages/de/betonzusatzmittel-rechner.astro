---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Betonzusatzmittel-Rechner - Beschleuniger, Verzögerer & Fließmittel";
const description = "Berechnen Sie die Dosierung von Betonzusatzmitteln wie Beschleunigern, Verzögerern, Fließmitteln und Luftporenbildnern pro Kubikmeter Beton.";
const relatedCalcs = [
  { name: "Betonmischungsrechner", url: "/de/betonmischung-rechner", description: "Mischungsentwurf." },
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Betonh\u00e4rtungsrechner", url: "/de/betonhaertung-rechner", description: "Aush\u00e4rtungszeit." },
  { name: "Betonfestigkeitsrechner", url: "/de/betonfestigkeit-rechner", description: "Festigkeitspr\u00fcfung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Betonzusatzmittel-Rechner" lang="de" enSlug="concrete-admixture-calculator" keywords="betonzusatzmittel, beschleuniger, verz\u00f6gerer, flie\u00dfmittel, luftporenbildner, zusatzmittel dosierung" breadcrumbs={[{ name: "Betonzusatzmittel", url: "/de/betonzusatzmittel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Betonzusatzmittel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Dosierung von Beschleunigern, Verz&ouml;gerern und Flie&szlig;mitteln pro Charge.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Zusatzmitteltyp</label>
          <select id="bz-type" class="bz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="accelerator" selected>Beschleuniger (Calciumchlorid)</option>
            <option value="nonchloride">Chloridfreier Beschleuniger</option>
            <option value="retarder">Verz&ouml;gerer (Abbindeverz&ouml;gerung)</option>
            <option value="wr">Betonverfl&uuml;ssiger (Typ A)</option>
            <option value="mrwr">Mittelverfl&uuml;ssiger</option>
            <option value="hrwr">Flie&szlig;mittel (Superplastifizierer)</option>
            <option value="aea">Luftporenbildner</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Betonvolumen (m&sup3;)</label>
          <input type="number" id="bz-volume" class="bz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.5" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Zementgehalt (kg/m&sup3;)</label>
          <input type="number" id="bz-cement" class="bz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="350" min="200" max="500" step="10">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Dosierungsstufe</label>
          <select id="bz-dose" class="bz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="low">Niedrig (Mindestempfehlung)</option>
            <option value="mid" selected>Standard (Mittelwert)</option>
            <option value="high">Hoch (Maximalempfehlung)</option>
          </select>
        </div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtmenge Zusatzmittel</div>
          <div class="text-4xl font-extrabold" id="bz-total">0 ml</div>
          <div class="text-sm text-blue-200 mt-1"><span id="bz-liters">0</span> Liter</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Dosierrate</div>
            <div class="text-xl font-bold" id="bz-rate">0 ml/kg</div>
            <div class="text-xs text-text-muted">ml pro kg Zement</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Pro Kubikmeter</div>
            <div class="text-xl font-bold" id="bz-perm3">0 ml</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wirkung auf Abbindezeit</div>
            <div class="text-xl font-bold" id="bz-settime">-</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wasserreduktion</div>
            <div class="text-xl font-bold" id="bz-water">-</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gesamte Zementmenge</div>
          <div class="text-xl font-bold" id="bz-cwt">0 kg</div>
        </div>
      </div>
      <ShareButton calculatorId="concrete-admixture" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Betonzusatzmittel-Dosierungsanleitung</h2>
      <ul>
        <li><strong>Beschleuniger:</strong> 1-2% CaCl2 bezogen auf Zementgewicht; beschleunigt Abbinden um 30-50%</li>
        <li><strong>Verz&ouml;gerer:</strong> 2-5 ml/kg Zement; verz&ouml;gert Abbinden um 1-4 Stunden</li>
        <li><strong>Betonverfl&uuml;ssiger:</strong> 3-5 ml/kg; reduziert Wasser um 5-10%</li>
        <li><strong>Flie&szlig;mittel:</strong> 6-20 ml/kg; reduziert Wasser um 12-30%</li>
        <li><strong>Luftporenbildner:</strong> 0,5-3 ml/kg; Zielluftgehalt 4-7%</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    interface BzSpec {
      low: number; mid: number; high: number;
      setEffect: string;
      waterReduction: string;
    }
    const bzSpecs: Record<string, BzSpec> = {
      accelerator:  { low: 5, mid: 8, high: 12, setEffect: '30-50% schneller', waterReduction: 'Keine' },
      nonchloride:  { low: 5, mid: 10, high: 15, setEffect: '25-40% schneller', waterReduction: 'Keine' },
      retarder:     { low: 2, mid: 4, high: 6, setEffect: '1-4 Std. langsamer', waterReduction: '3-5%' },
      wr:           { low: 3, mid: 5, high: 7, setEffect: 'Leichte Verz\u00f6gerung', waterReduction: '5-10%' },
      mrwr:         { low: 4, mid: 8, high: 12, setEffect: 'Leichte Verz\u00f6gerung', waterReduction: '8-15%' },
      hrwr:         { low: 6, mid: 12, high: 20, setEffect: 'Variabel', waterReduction: '12-30%' },
      aea:          { low: 0.5, mid: 1.5, high: 3, setEffect: 'Leichte Verz\u00f6gerung', waterReduction: '3-5%' },
    };
    function calcBZ() {
      const type = (document.getElementById('bz-type') as HTMLSelectElement).value;
      const volume = parseFloat((document.getElementById('bz-volume') as HTMLInputElement).value) || 0;
      const cementPerM3 = parseFloat((document.getElementById('bz-cement') as HTMLInputElement).value) || 350;
      const dose = (document.getElementById('bz-dose') as HTMLSelectElement).value;
      const spec = bzSpecs[type] || bzSpecs.accelerator;
      const dosageRate = spec[dose as keyof Pick<BzSpec, 'low' | 'mid' | 'high'>] || spec.mid;
      const totalCementKg = cementPerM3 * volume;
      const totalMl = dosageRate * totalCementKg;
      const totalLiters = totalMl / 1000;
      const perM3 = totalMl / (volume || 1);
      document.getElementById('bz-total')!.textContent = Math.round(totalMl).toLocaleString('de-DE') + ' ml';
      document.getElementById('bz-liters')!.textContent = totalLiters.toFixed(1).replace('.', ',');
      document.getElementById('bz-rate')!.textContent = dosageRate + ' ml/kg';
      document.getElementById('bz-perm3')!.textContent = perM3.toFixed(0) + ' ml';
      document.getElementById('bz-settime')!.textContent = spec.setEffect;
      document.getElementById('bz-water')!.textContent = spec.waterReduction;
      document.getElementById('bz-cwt')!.textContent = Math.round(totalCementKg).toLocaleString('de-DE') + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bz-in').forEach(el => { el.addEventListener('input', calcBZ); el.addEventListener('change', calcBZ); });
      calcBZ();
    }, 50);
  </script>
</CalculatorLayout>
