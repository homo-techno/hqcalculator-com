---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Betonh\u00e4rtungs-Rechner - Festigkeitsentwicklung nach Temperatur & Zeit";
const description = "Berechnen Sie die Betonaush\u00e4rtungszeit und den Druckfestigkeitszuwachs basierend auf Temperatur, Mischungsentwurf und Nachbehandlungsmethode.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Betonmischungsrechner", url: "/de/betonmischung-rechner", description: "Mischungsentwurf." },
  { name: "Betonfestigkeitsrechner", url: "/de/betonfestigkeit-rechner", description: "Zylindertest." },
  { name: "Betonplattenrechner", url: "/de/betonplatte-rechner", description: "Plattenvolumen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Betonh\u00e4rtungs-Rechner" lang="de" enSlug="concrete-curing-calculator" keywords="beton aush\u00e4rtung, festigkeitsentwicklung, reifemethode, nachbehandlung temperatur, ausschalzeit, 28 tage festigkeit" breadcrumbs={[{ name: "Betonh\u00e4rtung", url: "/de/betonhaertung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Betonh&auml;rtungs-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie den Festigkeitszuwachs des Betons &uuml;ber die Zeit basierend auf Umgebungstemperatur und Nachbehandlung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div><label class="block text-sm font-medium text-text mb-2">Nennfestigkeit nach 28 Tagen (MPa)</label><input type="number" id="bh-strength" class="bh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="10" step="5"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Mittlere Nachbehandlungstemperatur (&deg;C)</label>
          <input type="number" id="bh-temp" class="bh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="-5" max="50" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Zementtyp</label>
          <select id="bh-type" class="bh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="I" selected>CEM I - Normalzement</option>
            <option value="III">CEM III - Hochofenzement (langsam)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Nachbehandlungsmethode</label>
          <select id="bh-method" class="bh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="moist" selected>Feucht (Wasser/Nasse Jute)</option>
            <option value="membrane">Nachbehandlungsmittel / Folie</option>
            <option value="air">Lufttrocknung (keine Behandlung)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-2">Tage seit Betonage</label><input type="number" id="bh-days" class="bh-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7" min="1" max="365" step="1"></div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Festigkeit an Tag <span id="bh-day-label">7</span></div>
          <div class="text-4xl font-extrabold" id="bh-current">0 MPa</div>
          <div class="text-sm text-blue-200 mt-1"><span id="bh-pct">0</span>% der 28-Tage-Nennfestigkeit</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">1-Tag Festigkeit</div><div class="text-xl font-bold" id="bh-day1">0 MPa</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">3-Tage Festigkeit</div><div class="text-xl font-bold" id="bh-day3">0 MPa</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">7-Tage Festigkeit</div><div class="text-xl font-bold" id="bh-day7">0 MPa</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">28-Tage Festigkeit</div><div class="text-xl font-bold" id="bh-day28">0 MPa</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reifeindex</div><div class="text-xl font-bold" id="bh-maturity">0</div><div class="text-xs text-text-muted">Grad-Stunden</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ausschalung</div><div class="text-xl font-bold" id="bh-strip">- Tage</div></div>
        </div>
      </div>
      <ShareButton calculatorId="concrete-curing" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Festigkeitsentwicklung von Beton</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Reifeindex:</strong> Summe von (Temperatur - Bezugstemperatur) &times; Zeitintervalle</p>
        <p><strong>Festigkeit bei Tag t:</strong> f28 &times; t / (a + b &times; t) (ACI hyperbolisches Modell)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Typische Festigkeitsentwicklung</h3>
      <ul>
        <li><strong>Tag 1:</strong> 15-20% der 28-Tage-Festigkeit</li>
        <li><strong>Tag 3:</strong> 40-50% der 28-Tage-Festigkeit</li>
        <li><strong>Tag 7:</strong> 65-75% der 28-Tage-Festigkeit</li>
        <li><strong>Tag 14:</strong> 85-90% der 28-Tage-Festigkeit</li>
        <li><strong>Tag 28:</strong> 100% der Nennfestigkeit</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBH() {
      const f28 = parseFloat((document.getElementById('bh-strength') as HTMLInputElement).value) || 30;
      const tempC = parseFloat((document.getElementById('bh-temp') as HTMLInputElement).value) || 20;
      const cementType = (document.getElementById('bh-type') as HTMLSelectElement).value;
      const method = (document.getElementById('bh-method') as HTMLSelectElement).value;
      const days = parseFloat((document.getElementById('bh-days') as HTMLInputElement).value) || 7;
      const datum = -10;
      let a = cementType === 'III' ? 5.0 : 4.0;
      let b = cementType === 'III' ? 0.90 : 0.85;
      const tempFactor = Math.max(0.3, (tempC - datum) / (20 - datum));
      const methodFactor = method === 'moist' ? 1.0 : method === 'membrane' ? 0.92 : 0.80;
      function strengthAtDay(t: number): number {
        const effectiveAge = t * tempFactor;
        const ratio = effectiveAge / (a + b * effectiveAge);
        return f28 * ratio * methodFactor;
      }
      const currentStrength = strengthAtDay(days);
      const pct = (currentStrength / f28) * 100;
      const maturity = (tempC - datum) * days * 24;
      let stripDays = 1;
      while (stripDays < 365 && strengthAtDay(stripDays) < f28 * 0.5) { stripDays++; }
      const fmtMPa = (v: number) => v.toFixed(1).replace('.', ',') + ' MPa';
      document.getElementById('bh-day-label')!.textContent = String(Math.round(days));
      document.getElementById('bh-current')!.textContent = fmtMPa(currentStrength);
      document.getElementById('bh-pct')!.textContent = Math.min(pct, 130).toFixed(1).replace('.', ',');
      document.getElementById('bh-day1')!.textContent = fmtMPa(strengthAtDay(1));
      document.getElementById('bh-day3')!.textContent = fmtMPa(strengthAtDay(3));
      document.getElementById('bh-day7')!.textContent = fmtMPa(strengthAtDay(7));
      document.getElementById('bh-day28')!.textContent = fmtMPa(strengthAtDay(28));
      document.getElementById('bh-maturity')!.textContent = Math.round(maturity).toLocaleString('de-DE');
      document.getElementById('bh-strip')!.textContent = stripDays + ' Tage';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bh-in').forEach(el => { el.addEventListener('input', calcBH); el.addEventListener('change', calcBH); });
      calcBH();
    }, 50);
  </script>
</CalculatorLayout>
