---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Mach-Zahl Rechner – Schallgeschwindigkeit und Mach-Zahl berechnen";
const description = "Berechnen Sie Mach-Zahlen und Schallgeschwindigkeit in verschiedenen Medien bei beliebigen Temperaturen.";

const relatedCalcs = [
  { name: "Lautstärke Rechner", url: "/de/lautstaerke-rechner", description: "Schallpegel." },
  { name: "Magnetfeld Rechner", url: "/de/magnetfeld-rechner", description: "Magnetfeldstärken." },
  { name: "Lumineszenz-Datierung", url: "/de/lumineszenz-datierung-rechner", description: "Physikalische Datierung." },
];
---
<CalculatorLayout lang="de" enSlug="mach-number-calculator" title={title} description={description} calculatorName="Mach-Zahl Rechner" keywords="Mach-Zahl, Schallgeschwindigkeit, Überschall, Ma Rechner, Temperatur Schall" breadcrumbs={[{ name: "Mach-Zahl Rechner", url: "/de/mach-zahl-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mach-Zahl Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Mach-Zahl, Schallgeschwindigkeit und Flugregime für verschiedene Medien und Temperaturen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button id="mz-m1" class="mz-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="speed">Geschwindigkeit → Mach</button>
          <button id="mz-m2" class="mz-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="mach">Mach → Geschwindigkeit</button>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Medium</label>
          <select id="mz-medium" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="air" selected>Luft (trocken)</option>
            <option value="water">Wasser</option>
            <option value="steel">Stahl</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Temperatur (°C)</label>
          <input type="number" id="mz-temp" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="20" step="1" min="-100" max="1000">
        </div>
        <div id="mz-panel-speed">
          <label class="block text-xs font-medium text-text mb-1">Geschwindigkeit (km/h)</label>
          <input type="number" id="mz-kmh" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="1234" step="1" min="0">
        </div>
        <div id="mz-panel-mach" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Mach-Zahl</label>
          <input type="number" id="mz-mach" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="1" step="0.01" min="0">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="mz-label">Mach-Zahl</div>
          <div class="text-5xl font-extrabold font-mono" id="mz-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="mz-regime">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Schallgeschw. (m/s)</div>
            <div class="text-xl font-bold font-mono" id="mz-vs">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Schallgeschw. (km/h)</div>
            <div class="text-xl font-bold font-mono" id="mz-vs-kmh">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Geschwindigkeit (m/s)</div>
            <div class="text-xl font-bold font-mono" id="mz-v-ms">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Geschwindigkeit (km/h)</div>
            <div class="text-xl font-bold font-mono" id="mz-v-kmh">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mach-number" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist die Mach-Zahl?</h2>
      <p>Die Mach-Zahl (Ma) ist eine dimensionslose Kennzahl, die das Verhältnis der Strömungsgeschwindigkeit zur lokalen Schallgeschwindigkeit beschreibt. Sie wurde nach dem österreichischen Physiker Ernst Mach benannt. In Luft bei 20°C beträgt die Schallgeschwindigkeit ca. 343 m/s (ca. 1.235 km/h). Mach 1 bedeutet Schallgeschwindigkeit, Mach 2 doppelte Schallgeschwindigkeit.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Warum ändert sich die Schallgeschwindigkeit mit der Temperatur?</h3>
      <p>In Gasen hängt die Schallgeschwindigkeit von der Temperatur ab: höhere Temperatur bedeutet mehr kinetische Energie der Moleküle und damit schnellere Schallausbreitung. Die Formel lautet: v = 331,3 × √(1 + T/273,15) m/s.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Welche Flugregimes gibt es?</h3>
      <p>Unterschall (Ma &lt; 0,8), transsonisch (0,8–1,2 Ma), Überschall (1,2–5 Ma), Hyperschall (&gt; 5 Ma). Der Schallknall entsteht beim Durchbrechen der Schallmauer.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie schnell fliegt ein Passagierflugzeug in Mach?</h3>
      <p>Typische Langstreckenflugzeuge wie die Boeing 787 oder Airbus A350 fliegen mit ca. Mach 0,85. Die Concorde flog mit Mach 2, Militärjets erreichen Mach 2–3.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let mzMode = 'speed';
    const mediumSpeed: Record<string, (t: number) => number> = {
      air: (t) => 331.3 * Math.sqrt(1 + t / 273.15),
      water: (_t) => 1480,
      steel: (_t) => 5100,
      custom: (t) => 331.3 * Math.sqrt(1 + t / 273.15),
    };
    const regimes = [
      { max: 0.8, label: 'Unterschall (Subsonic)' },
      { max: 1.0, label: 'Transsonisch' },
      { max: 1.2, label: 'Transsonisch (überkritisch)' },
      { max: 5.0, label: 'Überschall (Supersonic)' },
      { max: Infinity, label: 'Hyperschall' },
    ];
    function setMzMode(m: string) {
      mzMode = m;
      document.getElementById('mz-panel-speed')!.classList.toggle('hidden', m !== 'speed');
      document.getElementById('mz-panel-mach')!.classList.toggle('hidden', m !== 'mach');
      document.querySelectorAll('.mz-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'mz-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcMz();
    }
    function calcMz() {
      const medium = (document.getElementById('mz-medium') as HTMLSelectElement).value;
      const temp = parseFloat((document.getElementById('mz-temp') as HTMLInputElement).value) || 20;
      const vs = mediumSpeed[medium](temp);
      let vms: number, mach: number;
      if (mzMode === 'speed') {
        const kmh = parseFloat((document.getElementById('mz-kmh') as HTMLInputElement).value) || 0;
        vms = kmh / 3.6;
        mach = vms / vs;
        document.getElementById('mz-label')!.textContent = 'Mach-Zahl';
        document.getElementById('mz-result')!.textContent = 'Ma ' + mach.toLocaleString('de-DE', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      } else {
        mach = parseFloat((document.getElementById('mz-mach') as HTMLInputElement).value) || 0;
        vms = mach * vs;
        document.getElementById('mz-label')!.textContent = 'Geschwindigkeit';
        document.getElementById('mz-result')!.textContent = (vms * 3.6).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' km/h';
      }
      const regime = regimes.find(r => mach <= r.max)?.label || 'Hyperschall';
      document.getElementById('mz-regime')!.textContent = regime;
      document.getElementById('mz-vs')!.textContent = vs.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m/s';
      document.getElementById('mz-vs-kmh')!.textContent = (vs * 3.6).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' km/h';
      document.getElementById('mz-v-ms')!.textContent = vms.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m/s';
      document.getElementById('mz-v-kmh')!.textContent = (vms * 3.6).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' km/h';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mz-mode').forEach(b => b.addEventListener('click', () => setMzMode((b as HTMLButtonElement).dataset.mode!)));
      ['mz-medium', 'mz-temp', 'mz-kmh', 'mz-mach'].forEach(id => {
        const el = document.getElementById(id)!;
        el.addEventListener('input', calcMz);
        el.addEventListener('change', calcMz);
      });
      calcMz();
    }, 50);
  </script>
</CalculatorLayout>
