---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Depressions-Screening-Rechner - PHQ-9 Fragebogen";
const description = "Screening auf Depression mit dem PHQ-9 (Gesundheitsfragebogen f\u00fcr Patienten). Erhalten Sie Schweregradeinsch\u00e4tzung und Handlungsempfehlungen.";

const relatedCalcs = [
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen optimieren." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "T\u00e4glicher Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Angst-Score-Rechner", url: "/de/angst-score-rechner", description: "Angstscreening." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Depressions-Screening-Rechner" lang="de" enSlug="depression-screening-calculator" keywords="depression screening, phq-9, gesundheitsfragebogen patienten, depression schweregrad, depression test" breadcrumbs={[{ name: "Depressions-Screening", url: "/de/depressions-screening-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Depressions-Screening-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Wie oft waren Sie in den letzten 2 Wochen von den folgenden Beschwerden beeintr&auml;chtigt? (PHQ-9)</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <p class="text-xs text-text-secondary mb-1 italic">Dies ist ein Screening-Instrument, keine Diagnose. Konsultieren Sie immer einen Arzt.</p>
      <p class="text-sm text-text-secondary mb-4">0 = &Uuml;berhaupt nicht, 1 = An einzelnen Tagen, 2 = An mehr als der H&auml;lfte der Tage, 3 = Beinahe jeden Tag</p>

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">1. Wenig Interesse oder Freude an T&auml;tigkeiten</label>
          <input type="range" id="dsr-q1" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">2. Niedergeschlagenheit, Schwerm&uuml;tigkeit oder Hoffnungslosigkeit</label>
          <input type="range" id="dsr-q2" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">3. Ein- oder Durchschlafst&ouml;rungen oder vermehrter Schlaf</label>
          <input type="range" id="dsr-q3" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">4. M&uuml;digkeit oder Energielosigkeit</label>
          <input type="range" id="dsr-q4" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">5. Verminderter Appetit oder &uuml;berm&auml;&szlig;iges Essen</label>
          <input type="range" id="dsr-q5" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">6. Schlechte Meinung von sich selbst oder Versagensgef&uuml;hle</label>
          <input type="range" id="dsr-q6" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">7. Schwierigkeiten, sich zu konzentrieren (z.B. beim Lesen)</label>
          <input type="range" id="dsr-q7" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">8. Verlangsamte Bewegung/Sprache oder Unruhe/Rastlosigkeit</label>
          <input type="range" id="dsr-q8" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">9. Gedanken, sich selbst zu verletzen oder dass Sie besser tot w&auml;ren</label>
          <input type="range" id="dsr-q9" class="dsr-in w-full" min="0" max="3" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>&Uuml;berhaupt nicht (0)</span><span>Beinahe jeden Tag (3)</span></div>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Schweregrad der Depression</div>
          <div class="text-2xl font-extrabold mt-1" id="dsr-sev">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">PHQ-9 Punktzahl</div>
            <div class="text-xl font-bold text-text mt-1" id="dsr-score">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Funktionelle Beeintr&auml;chtigung</div>
            <div class="text-xl font-bold text-text mt-1" id="dsr-impact">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Empfohlene Ma&szlig;nahme</div>
          <div class="text-sm text-text" id="dsr-action">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Verlaufskontrolle</div>
          <div class="text-sm text-text" id="dsr-monitor">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">PHQ-9 Schweregradskala</div>
          <div class="space-y-1 text-sm">
            <div class="flex justify-between"><span>0 - 4</span><span>Minimal / Keine</span></div>
            <div class="flex justify-between"><span>5 - 9</span><span>Leichte Depression</span></div>
            <div class="flex justify-between"><span>10 - 14</span><span>Mittelgradige Depression</span></div>
            <div class="flex justify-between"><span>15 - 19</span><span>Mittelschwere Depression</span></div>
            <div class="flex justify-between"><span>20 - 27</span><span>Schwere Depression</span></div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="depression-screening-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">PHQ-9 Fragebogen</h2>
      <p>Der PHQ-9 ist ein validiertes Screening-Instrument zur Erfassung des Schweregrades einer Depression. Er wird weltweit in der Prim&auml;rversorgung eingesetzt.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Ersetzt der PHQ-9 eine &auml;rztliche Diagnose?</strong> Nein. Der PHQ-9 ist ein Screening-Werkzeug. Eine Depression kann nur von einem Arzt oder Psychotherapeuten diagnostiziert werden.</p>
      <p><strong>Wo finde ich Hilfe?</strong> Telefonseelsorge: 0800 111 0 111 (kostenlos, 24/7). Hausarzt oder psychiatrische Notaufnahme bei akuter Krise.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDSR() {
      let total = 0;
      for (let i = 1; i <= 9; i++) {
        total += parseInt((document.getElementById('dsr-q' + i) as HTMLInputElement).value) || 0;
      }
      const q9 = parseInt((document.getElementById('dsr-q9') as HTMLInputElement).value) || 0;

      let severity = 'Minimal';
      let impact = 'Keine bis minimal';
      let action = '';
      let monitor = '';

      if (total <= 4) {
        severity = 'Minimal / Keine';
        impact = 'Keine bis minimal';
        action = 'Keine Behandlung n\u00f6tig. Weiterhin gesunde Lebensgewohnheiten pflegen: regelm\u00e4\u00dfige Bewegung, soziale Kontakte, guter Schlaf.';
        monitor = 'Erneutes Screening bei Auftreten von Symptomen oder bei Routineuntersuchungen.';
      } else if (total <= 9) {
        severity = 'Leichte Depression';
        impact = 'Leichte Beeintr\u00e4chtigung im Alltag';
        action = 'Beobachtendes Abwarten empfohlen. Lebensstil\u00e4nderungen: Bewegung (30 Min/Tag), soziale Aktivit\u00e4ten, Schlafhygiene. PHQ-9 in 2-4 Wochen wiederholen.';
        monitor = 'W\u00f6chentlich beobachten. Bei anhaltender Punktzahl \u00fcber 5 f\u00fcr 4+ Wochen Arzt aufsuchen.';
      } else if (total <= 14) {
        severity = 'Mittelgradige Depression';
        impact = 'M\u00e4\u00dfige Beeintr\u00e4chtigung in Beruf, Haushalt und Sozialleben';
        action = 'Fachliche Beratung empfohlen. Behandlungsm\u00f6glichkeiten: Psychotherapie (KVT, Interpersonelle Therapie), ggf. Antidepressiva.';
        monitor = 'W\u00f6chentliche Kontrolle w\u00e4hrend der Behandlung. R\u00fcckgang um 5 Punkte = bedeutsame Besserung. Zielwert unter 5.';
      } else if (total <= 19) {
        severity = 'Mittelschwere Depression';
        impact = 'Erhebliche Beeintr\u00e4chtigung im Alltag';
        action = 'Aktive Behandlung dringend empfohlen. Kombination aus Antidepressiva und Psychotherapie ist auf diesem Schweregrad am wirksamsten.';
        monitor = 'W\u00f6chentliche Kontrolle. Bei fehlender Besserung nach 4-6 Wochen Therapieanpassung besprechen.';
      } else {
        severity = 'Schwere Depression';
        impact = 'Schwere funktionelle Beeintr\u00e4chtigung';
        action = 'Dringende fach\u00e4rztliche Behandlung empfohlen. Sofortige Kombinationsbehandlung. Bei akuter Krise: Telefonseelsorge 0800 111 0 111 oder N\u00e4chste Notaufnahme.';
        monitor = 'H\u00e4ufige Kontrollen erforderlich. Enge Betreuung durch Facharzt/Psychotherapeut.';
      }

      if (q9 > 0) {
        action += ' WICHTIG: Sie haben Gedanken an Selbstverletzung angegeben. Bitte wenden Sie sich an: Telefonseelsorge 0800 111 0 111 (kostenlos, 24/7) oder gehen Sie in die n\u00e4chste Notaufnahme.';
      }

      document.getElementById('dsr-score')!.textContent = total + ' / 27';
      document.getElementById('dsr-sev')!.textContent = severity;
      document.getElementById('dsr-impact')!.textContent = impact;
      document.getElementById('dsr-action')!.textContent = action;
      document.getElementById('dsr-monitor')!.textContent = monitor;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      for (let i = 1; i <= 9; i++) {
        (document.getElementById('dsr-q' + i) as HTMLInputElement).value = '0';
      }
      document.querySelectorAll('.dsr-in').forEach(el => {
        el.addEventListener('input', calcDSR);
        el.addEventListener('change', calcDSR);
      });
      calcDSR();
    }, 50);
  </script>
</CalculatorLayout>
