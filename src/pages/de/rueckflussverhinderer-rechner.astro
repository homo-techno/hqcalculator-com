---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Rückflussverhinderer-Rechner - Typauswahl & Dimensionierung";
const description = "Wählen Sie den richtigen Rückflussverhinderer-Typ, berechnen Sie den Druckverlust, dimensionieren Sie nach Durchflussrate und bestimmen Sie die Prüfhäufigkeit.";
const relatedCalcs = [
  { name: "Rohrdurchfluss", url: "/de/rohrdurchfluss-rechner", description: "Durchflussrate in Rohren." },
  { name: "Sanitärrohr", url: "/de/sanitaerrohr-rechner", description: "Rohrdimensionierung." },
  { name: "Wasserqualität", url: "/de/wasserqualitaet-rechner", description: "Wasserqualitätsanalyse." },
  { name: "Druckumrechner", url: "/de/druck-umrechner", description: "Druckeinheiten umrechnen." },
  { name: "Strömungsdynamik", url: "/de/stroemungsdynamik-rechner", description: "Fluiddynamik." },
  { name: "Bewässerung", url: "/de/bewaesserung-rechner", description: "Bewässerungsplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Rückflussverhinderer-Rechner" keywords="Rückflussverhinderer, RPZ, DCVA, Druckverlust, Rückflussdimensionierung, Querschnittsverbindung" breadcrumbs={[{ name: "Rückflussverhinderer", url: "/de/rueckflussverhinderer-rechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Rückflussverhinderer-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie den korrekten Rückflussverhinderer-Typ und die Größe basierend auf Gefahrenstufe, Durchflussanforderungen und Druckverhältnissen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gefahrenstufe</label>
          <select id="bf3-hazard" class="bf3-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="low">Niedrig - Hausbewässerung</option>
            <option value="medium" selected>Mittel - Gewerbe, Sprinkleranlage</option>
            <option value="high">Hoch - Chemie, Medizin, Industrie</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Anwendungstyp</label>
          <select id="bf3-app" class="bf3-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="irrigation">Bewässerungsanlage</option>
            <option value="fire" selected>Sprinkleranlage</option>
            <option value="boiler">Heizkessel/HLK</option>
            <option value="process">Prozess/Industrie</option>
            <option value="domestic">Hauswasseranschluss</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Durchflussrate (l/min)</label>
            <input type="number" id="bf3-flow" class="bf3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="190" min="1" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Versorgungsdruck (bar)</label>
            <input type="number" id="bf3-press" class="bf3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.5" min="1" step="0.1">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Min. erforderlicher Nachstromdruck (bar)</label>
          <input type="number" id="bf3-minp" class="bf3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.8" min="0.5" step="0.1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlener Verhinderer-Typ</div>
          <div class="text-4xl font-extrabold" id="bf3-type">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfohlene Größe</div><div class="text-xl font-bold" id="bf3-size">0"</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Druckverlust</div><div class="text-xl font-bold" id="bf3-ploss">0 bar</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nachstromdruck</div><div class="text-xl font-bold" id="bf3-down">0 bar</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Prüfhäufigkeit</div><div class="text-xl font-bold" id="bf3-test">Jährlich</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Gerätedetails</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between"><span>Vollständiger Name</span><span class="font-bold" id="bf3-fullname">--</span></div>
            <div class="flex justify-between"><span>Fließgeschwindigkeit</span><span class="font-bold" id="bf3-vel">0 m/s</span></div>
            <div class="flex justify-between"><span>Max. Durchfluss</span><span class="font-bold" id="bf3-maxflow">0 l/min</span></div>
            <div class="flex justify-between"><span>Geschätzte Kosten</span><span class="font-bold" id="bf3-cost">0 &euro;</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="backflow-preventer" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBF3() {
      const hazard = (document.getElementById('bf3-hazard') as HTMLSelectElement).value;
      const app = (document.getElementById('bf3-app') as HTMLSelectElement).value;
      const flow = parseFloat((document.getElementById('bf3-flow') as HTMLInputElement).value) || 190;
      const supply = parseFloat((document.getElementById('bf3-press') as HTMLInputElement).value) || 4.5;
      const minP = parseFloat((document.getElementById('bf3-minp') as HTMLInputElement).value) || 2.8;

      let typeCode = 'DCVA';
      let fullName = 'Doppelrückschlagventil-Baugruppe';
      if (hazard === 'high' || app === 'process' || app === 'boiler') {
        typeCode = 'RPZ';
        fullName = 'Druckreduzierzone-Baugruppe';
      } else if (hazard === 'low' && app === 'irrigation') {
        typeCode = 'PVB';
        fullName = 'Druckvakuumbrecher';
      } else if (hazard === 'low' && app === 'domestic') {
        typeCode = 'DCVA';
        fullName = 'Doppelrückschlagventil-Baugruppe';
      } else if (app === 'fire') {
        typeCode = 'DCDA';
        fullName = 'Doppelrückschlag-Prüfbaugruppe';
      }

      const sizeData = [
        { nom: 20, label: 'DN20 (3/4")', maxLPM: 75, id: 20 },
        { nom: 25, label: 'DN25 (1")', maxLPM: 130, id: 26.6 },
        { nom: 40, label: 'DN40 (1-1/2")', maxLPM: 280, id: 40.9 },
        { nom: 50, label: 'DN50 (2")', maxLPM: 600, id: 52.5 },
        { nom: 65, label: 'DN65 (2-1/2")', maxLPM: 950, id: 62.7 },
        { nom: 80, label: 'DN80 (3")', maxLPM: 1500, id: 77.9 },
        { nom: 100, label: 'DN100 (4")', maxLPM: 2800, id: 102.3 },
        { nom: 150, label: 'DN150 (6")', maxLPM: 6000, id: 154.1 },
      ];

      let selected = sizeData[sizeData.length - 1];
      for (const s of sizeData) {
        if (s.maxLPM >= flow) { selected = s; break; }
      }

      const baseLoss: Record<string, number> = { RPZ: 0.8, DCVA: 0.4, PVB: 0.5, DCDA: 0.5 };
      const flowRatio = flow / selected.maxLPM;
      const pressLoss = (baseLoss[typeCode] || 0.5) * (0.5 + 0.5 * flowRatio * flowRatio);
      const downstream = supply - pressLoss;

      const areaM2 = Math.PI * Math.pow(selected.id / 2000, 2);
      const vel = areaM2 > 0 ? (flow / 60000) / areaM2 : 0;

      let testFreq = 'Jährlich';
      if (typeCode === 'RPZ') testFreq = 'Jährlich (Pflicht)';
      else if (typeCode === 'DCDA') testFreq = 'Jährlich (Brandschutz)';
      else testFreq = 'Jährlich (empfohlen)';

      const baseCosts: Record<string, number> = { RPZ: 350, DCVA: 200, PVB: 120, DCDA: 300 };
      const sizeFactor = selected.nom <= 25 ? 1 : selected.nom <= 50 ? 2.5 : selected.nom <= 100 ? 5 : 10;
      const estCost = (baseCosts[typeCode] || 250) * sizeFactor;

      document.getElementById('bf3-type')!.textContent = typeCode;
      document.getElementById('bf3-fullname')!.textContent = fullName;
      document.getElementById('bf3-size')!.textContent = selected.label;
      document.getElementById('bf3-ploss')!.textContent = pressLoss.toFixed(2) + ' bar';
      document.getElementById('bf3-down')!.textContent = downstream.toFixed(2) + ' bar';
      document.getElementById('bf3-test')!.textContent = testFreq;
      document.getElementById('bf3-vel')!.textContent = vel.toFixed(1) + ' m/s';
      document.getElementById('bf3-maxflow')!.textContent = selected.maxLPM.toLocaleString('de-DE') + ' l/min';
      document.getElementById('bf3-cost')!.textContent = Math.round(estCost).toLocaleString('de-DE') + ' \u20AC';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bf3-in').forEach(el => { el.addEventListener('input', calcBF3); el.addEventListener('change', calcBF3); });
      calcBF3();
    }, 50);
  </script>
</CalculatorLayout>
