---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Spiel-FPS-Rechner - Bildrate sch\u00E4tzen";
const description = "Sch\u00E4tzen Sie die erwartete FPS aus GPU/CPU-Benchmark-Ergebnissen, analysieren Sie Engp\u00E4sse und berechnen Sie die Aufl\u00F6sungsskalierung auf Bildraten.";
const relatedCalcs = [
  { name: "Bildschirmgr\u00F6\u00DFen-Rechner", url: "/de/bildschirmgroessen-rechner", description: "Display-Berechnungen." },
  { name: "Seitenverh\u00E4ltnis-Rechner", url: "/de/seitenverhaeltnis-rechner", description: "Seitenverh\u00E4ltnis." },
  { name: "Video-Bitrate-Rechner", url: "/de/video-bitrate-rechner", description: "Bitrate-Sch\u00E4tzung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Spiel-FPS-Rechner" lang="de" enSlug="game-fps-calculator" keywords="fps rechner, spieleleistung, gpu benchmark, cpu engpass, aufl\u00F6sungsskalierung, bildrate sch\u00E4tzen" breadcrumbs={[{ name: "Spiel-FPS", url: "/de/spiel-fps-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Spiel-FPS-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die erwartete FPS basierend auf Hardware-Benchmarks und Aufl&ouml;sungseinstellungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">GPU-Benchmark-Punktzahl (z.B. 3DMark)</label>
          <input type="number" class="sfr-in w-full px-4 py-2 border border-border rounded-lg" id="sfr-gpu" min="100" value="12000">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">CPU-Benchmark-Punktzahl (Single-Thread)</label>
          <input type="number" class="sfr-in w-full px-4 py-2 border border-border rounded-lg" id="sfr-cpu" min="100" value="1800">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Zielaufl&ouml;sung</label>
          <select class="sfr-in w-full px-4 py-2 border border-border rounded-lg" id="sfr-res">
            <option value="720">720p (1280x720)</option>
            <option value="1080" selected>1080p (1920x1080)</option>
            <option value="1440">1440p (2560x1440)</option>
            <option value="2160">4K (3840x2160)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Spieloptimierung</label>
          <select class="sfr-in w-full px-4 py-2 border border-border rounded-lg" id="sfr-opt">
            <option value="1.3">Gut optimiert (z.B. Valorant)</option>
            <option value="1.0" selected>Durchschnittliche Optimierung</option>
            <option value="0.7">Schlecht optimiert (z.B. neues AAA)</option>
            <option value="0.5">Sehr anspruchsvoll (z.B. Cyberpunk Ultra)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Grafikqualit&auml;t</label>
          <select class="sfr-in w-full px-4 py-2 border border-border rounded-lg" id="sfr-quality">
            <option value="1.6">Niedrig</option>
            <option value="1.2">Mittel</option>
            <option value="1.0" selected>Hoch</option>
            <option value="0.75">Ultra</option>
            <option value="0.55">Ultra + Raytracing</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte FPS</div>
          <div class="text-5xl font-extrabold font-mono" id="sfr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">GPU-limitierte FPS</div>
            <div class="text-xl font-bold font-mono" id="sfr-gpufps">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">CPU-limitierte FPS</div>
            <div class="text-xl font-bold font-mono" id="sfr-cpufps">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Engpass</div>
            <div class="text-lg font-bold font-mono" id="sfr-bottleneck">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bildzeit</div>
            <div class="text-lg font-bold font-mono" id="sfr-frametime">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Aufl&ouml;sungsvergleich</h3>
          <div class="text-xs font-mono space-y-1" id="sfr-compare"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="game-fps-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Spieleleistung verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>FPS = min(GPU-FPS, CPU-FPS)</p>
        <p>Bildzeit = 1000 / FPS (in ms)</p>
        <p>H&ouml;here Aufl&ouml;sung = weniger GPU-FPS</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein GPU-Engpass?</strong> Wenn die GPU-limitierte FPS niedriger ist als die CPU-limitierte FPS, ist die Grafikkarte der begrenzende Faktor. Eine h&ouml;here Aufl&ouml;sung verst&auml;rkt diesen Effekt.</p>
      <p><strong>Wie viele FPS brauche ich?</strong> F&uuml;r fl&uuml;ssiges Spielen sind 60 FPS ausreichend. F&uuml;r kompetitive Spiele sind 144+ FPS ideal.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSFR() {
      const gpu = parseFloat((document.getElementById('sfr-gpu') as HTMLInputElement).value) || 12000;
      const cpu = parseFloat((document.getElementById('sfr-cpu') as HTMLInputElement).value) || 1800;
      const res = parseInt((document.getElementById('sfr-res') as HTMLSelectElement).value);
      const opt = parseFloat((document.getElementById('sfr-opt') as HTMLSelectElement).value);
      const quality = parseFloat((document.getElementById('sfr-quality') as HTMLSelectElement).value);
      const pixelCounts: Record<number, number> = { 720: 921600, 1080: 2073600, 1440: 3686400, 2160: 8294400 };
      const basePixels = pixelCounts[1080];
      const resScale = basePixels / pixelCounts[res];
      const gpuFps = Math.round((gpu / 100) * opt * quality * resScale);
      const cpuFps = Math.round((cpu / 10) * opt * 1.1);
      const estimatedFps = Math.min(gpuFps, cpuFps);
      const bottleneck = gpuFps < cpuFps ? 'GPU' : (cpuFps < gpuFps ? 'CPU' : 'Ausgeglichen');
      const frameTime = (1000 / estimatedFps).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      document.getElementById('sfr-result')!.textContent = estimatedFps.toString();
      document.getElementById('sfr-gpufps')!.textContent = gpuFps + ' FPS';
      document.getElementById('sfr-cpufps')!.textContent = cpuFps + ' FPS';
      document.getElementById('sfr-bottleneck')!.textContent = bottleneck;
      document.getElementById('sfr-frametime')!.textContent = frameTime + ' ms';
      let compare = '';
      const resLabels: Record<number, string> = { 720: '720p', 1080: '1080p', 1440: '1440p', 2160: '4K' };
      for (const [r, px] of Object.entries(pixelCounts)) {
        const rScale = basePixels / px;
        const rFps = Math.min(Math.round((gpu / 100) * opt * quality * rScale), cpuFps);
        const marker = parseInt(r) === res ? ' <-' : '';
        compare += '<div class="flex justify-between"><span>' + resLabels[parseInt(r)] + '</span><span>' + rFps + ' FPS' + marker + '</span></div>';
      }
      document.getElementById('sfr-compare')!.innerHTML = compare;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sfr-in').forEach(el => { el.addEventListener('input', calcSFR); el.addEventListener('change', calcSFR); });
      calcSFR();
    }, 50);
  </script>
</CalculatorLayout>
