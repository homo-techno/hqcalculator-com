---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Keto Rechner – Makronährstoffe für ketogene Diät berechnen";
const description = "Berechnen Sie Ihren täglichen Makronährstoffbedarf für eine ketogene Diät.";
const relatedCalcs = [
  { name: "Intervalltraining Rechner", url: "/de/intervalltraining-rechner", description: "HIIT-Einheiten planen." },
  { name: "BMI Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index berechnen." },
  { name: "IQ-Wert Rechner", url: "/de/iq-wert-rechner", description: "IQ-Wert & Perzentil." },
  { name: "Kajak-Paddel Rechner", url: "/de/kajak-paddel-rechner", description: "Optimale Paddellänge." },
];
---
<CalculatorLayout lang="de" enSlug="keto-calculator" title={title} description={description} calculatorName="Keto Rechner" keywords="Keto Rechner, ketogene Diät, Makronährstoffe, Low Carb, Fett Protein Kohlenhydrate Bedarf" breadcrumbs={[{ name: "Keto Rechner", url: "/de/keto-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Keto Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren täglichen Kalorienbedarf und die optimale Makronährstoffverteilung (Fett, Protein, Kohlenhydrate) für eine ketogene Ernährung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Körpergewicht (kg)</label><input type="number" id="kt-weight" class="kt-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="80" min="30" max="300" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Körpergröße (cm)</label><input type="number" id="kt-height" class="kt-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="175" min="140" max="220" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Alter (Jahre)</label><input type="number" id="kt-age" class="kt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="15" max="100" step="1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
            <select id="kt-sex" class="kt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="male" selected>Männlich</option>
              <option value="female">Weiblich</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Aktivitätslevel</label>
          <select id="kt-activity" class="kt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="1.2">Sehr wenig aktiv (Bürojob, kein Sport)</option>
            <option value="1.375">Leicht aktiv (1–3 Trainings/Woche)</option>
            <option value="1.55" selected>Mäßig aktiv (3–5 Trainings/Woche)</option>
            <option value="1.725">Sehr aktiv (6–7 Trainings/Woche)</option>
            <option value="1.9">Extrem aktiv (Schwerarbeit + Training)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Ziel</label>
          <select id="kt-goal" class="kt-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="-500">Gewichtsabnahme (−500 kcal)</option>
            <option value="-250">Moderate Abnahme (−250 kcal)</option>
            <option value="0" selected>Gewicht halten</option>
            <option value="250">Moderat zunehmen (+250 kcal)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Kalorienbedarf (Keto)</div>
          <div class="text-5xl font-extrabold font-mono" id="kt-result">— kcal</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-xl text-center">
            <div class="text-xs font-semibold text-yellow-700 uppercase">Fett (70 %)</div>
            <div class="text-2xl font-bold text-yellow-700" id="kt-fat">— g</div>
            <div class="text-xs text-yellow-600" id="kt-fat-kcal">— kcal</div>
          </div>
          <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-center">
            <div class="text-xs font-semibold text-red-700 uppercase">Protein (25 %)</div>
            <div class="text-2xl font-bold text-red-700" id="kt-prot">— g</div>
            <div class="text-xs text-red-600" id="kt-prot-kcal">— kcal</div>
          </div>
          <div class="p-4 bg-green-50 border border-green-200 rounded-xl text-center">
            <div class="text-xs font-semibold text-green-700 uppercase">Kohlenhydrate (5 %)</div>
            <div class="text-2xl font-bold text-green-700" id="kt-carb">— g</div>
            <div class="text-xs text-green-600" id="kt-carb-kcal">— kcal</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsweg (Harris-Benedict)</h3>
          <div class="font-mono text-xs space-y-1" id="kt-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="keto" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Ketogene Ernährung – Grundlagen</h2>
      <p class="text-text-secondary">Die ketogene Diät ist eine sehr kohlenhydratarme, fettreiche Ernährungsform, bei der typischerweise 70–75 % der Kalorien aus Fett, 20–25 % aus Protein und nur 5 % aus Kohlenhydraten stammen. Durch die drastische Reduzierung der Kohlenhydratzufuhr (unter 50 g/Tag) wechselt der Körper in den Zustand der Ketose, bei dem er Ketonkörper aus Fett als primäre Energiequelle nutzt.</p>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie lange dauert es, in Ketose zu kommen?</h4>
          <p class="text-text-secondary mt-1">Die meisten Menschen erreichen nach 2–7 Tagen strikter Keto-Ernährung (unter 20–50 g Kohlenhydrate täglich) die Ketose. Sport und Fasten können den Prozess beschleunigen. Ketose lässt sich mit Urin-Teststreifen, Blutmessgeräten oder Atemtests nachweisen.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was sind typische Keto-Lebensmittel?</h4>
          <p class="text-text-secondary mt-1">Erlaubt: Fleisch, Fisch, Eier, Käse, Butter, Avocados, Nüsse, Samen, grünes Gemüse und Öle. Zu meiden: Brot, Pasta, Reis, Kartoffeln, Zucker, Obst (außer Beeren in Maßen), Hülsenfrüchte und die meisten Milchprodukte mit hohem Laktosegehalt.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist die Keto-Grippe?</h4>
          <p class="text-text-secondary mt-1">In den ersten 1–2 Wochen können Symptome wie Kopfschmerzen, Müdigkeit, Schwindel und Reizbarkeit auftreten – bekannt als „Keto-Grippe". Diese entstehen durch Flüssigkeitsverlust und Elektrolytmangel. Gegenmittel: viel Wasser trinken und Natrium, Kalium und Magnesium supplementieren.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Ist ketogene Ernährung langfristig sicher?</h4>
          <p class="text-text-secondary mt-1">Für die meisten gesunden Erwachsenen gilt Keto als sicher. Langzeitstudien zeigen Verbesserungen bei Insulinsensitivität und Lipidprofil. Menschen mit Nierenerkrankungen, Lebererkrankungen oder Diabetes sollten vor Beginn einen Arzt konsultieren. Regelmäßige Blutbildkontrollen werden empfohlen.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKT() {
      const weight = parseFloat((document.getElementById('kt-weight') as HTMLInputElement).value) || 80;
      const height = parseFloat((document.getElementById('kt-height') as HTMLInputElement).value) || 175;
      const age = parseFloat((document.getElementById('kt-age') as HTMLInputElement).value) || 35;
      const sex = (document.getElementById('kt-sex') as HTMLSelectElement).value;
      const activity = parseFloat((document.getElementById('kt-activity') as HTMLSelectElement).value) || 1.55;
      const goal = parseInt((document.getElementById('kt-goal') as HTMLSelectElement).value) || 0;
      let bmr = 0;
      let bmrFormula = '';
      if (sex === 'male') {
        bmr = 88.362 + 13.397 * weight + 4.799 * height - 5.677 * age;
        bmrFormula = '88,36 + 13,40×' + weight + ' + 4,80×' + height + ' − 5,68×' + age;
      } else {
        bmr = 447.593 + 9.247 * weight + 3.098 * height - 4.330 * age;
        bmrFormula = '447,59 + 9,25×' + weight + ' + 3,10×' + height + ' − 4,33×' + age;
      }
      const tdee = bmr * activity;
      const target = tdee + goal;
      const fatKcal = target * 0.70;
      const protKcal = target * 0.25;
      const carbKcal = target * 0.05;
      const fatG = fatKcal / 9;
      const protG = protKcal / 4;
      const carbG = carbKcal / 4;
      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE');
      const fmtD = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('kt-result')!.textContent = fmt(target) + ' kcal';
      document.getElementById('kt-fat')!.textContent = fmtD(fatG) + ' g';
      document.getElementById('kt-fat-kcal')!.textContent = fmt(fatKcal) + ' kcal';
      document.getElementById('kt-prot')!.textContent = fmtD(protG) + ' g';
      document.getElementById('kt-prot-kcal')!.textContent = fmt(protKcal) + ' kcal';
      document.getElementById('kt-carb')!.textContent = fmtD(carbG) + ' g';
      document.getElementById('kt-carb-kcal')!.textContent = fmt(carbKcal) + ' kcal';
      const steps = [
        'BMR = ' + bmrFormula,
        'BMR = ' + fmt(bmr) + ' kcal',
        'TDEE = BMR × ' + activity + ' = ' + fmt(tdee) + ' kcal',
        'Zielkalorien = ' + fmt(tdee) + (goal !== 0 ? (goal > 0 ? ' + ' : ' − ') + Math.abs(goal) : '') + ' = ' + fmt(target) + ' kcal',
        'Fett: 70 % × ' + fmt(target) + ' / 9 = ' + fmtD(fatG) + ' g',
        'Protein: 25 % × ' + fmt(target) + ' / 4 = ' + fmtD(protG) + ' g',
        'Kohlenhydrate: 5 % × ' + fmt(target) + ' / 4 = ' + fmtD(carbG) + ' g',
      ];
      document.getElementById('kt-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kt-in').forEach(el => { el.addEventListener('input', calcKT); el.addEventListener('change', calcKT); });
      calcKT();
    }, 50);
  </script>
</CalculatorLayout>
