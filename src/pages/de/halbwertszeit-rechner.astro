---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Halbwertszeit-Rechner - Radioaktiver &amp; Exponentieller Zerfall";
const description = "Berechnen Sie Halbwertszeit, verbleibende Menge oder verstrichene Zeit f&uuml;r radioaktiven und exponentiellen Zerfall.";
const relatedCalcs = [
  { name: "Halbwertszeit-Zerfall-Rechner", url: "/de/halbwertszeit-zerfall-rechner", description: "Zerfallsketten &amp; Aktivit&auml;t." },
  { name: "Exponential-Rechner", url: "/de/exponentialrechner", description: "Exponentielle Mathematik." },
  { name: "Logarithmus-Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen berechnen." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Wissenschaftliche Berechnungen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Halbwertszeit-Rechner" lang="de" enSlug="half-life-calculator" keywords="halbwertszeit rechner, radioaktiver zerfall, exponentieller zerfall, halbwertszeit formel, zerfallskonstante" breadcrumbs={[{ name: "Halbwertszeit-Rechner", url: "/de/halbwertszeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Halbwertszeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die verbleibende Menge nach radioaktivem oder exponentiellem Zerfall.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anfangsmenge</label><input type="number" id="hl-init" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Halbwertszeit</label><input type="number" id="hl-half" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.01" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verstrichene Zeit</label><input type="number" id="hl-time" class="hlde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Verbleibende Menge</div>
          <div class="text-5xl font-extrabold" id="hl-remaining">0</div>
          <div class="text-sm text-blue-200 mt-1" id="hl-pct">0 % verbleibend</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zerfallen</div><div class="text-xl font-bold text-secondary" id="hl-decayed">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Halbwertszeiten abgelaufen</div><div class="text-xl font-bold" id="hl-count">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zerfallskonstante (&lambda;)</div><div class="text-xl font-bold font-mono" id="hl-lambda">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mittlere Lebensdauer (&tau;)</div><div class="text-xl font-bold" id="hl-tau">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Zerfallstabelle</h3>
          <div class="space-y-1 text-sm" id="hl-table"></div>
        </div>
      </div>
      <ShareButton calculatorId="half-life-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Halbwertszeit-Formel</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>N(t) = N&#8320; &times; (1/2)^(t/t&#189;)</p>
        <p>&lambda; = ln(2) / t&#189; &asymp; 0,693 / t&#189;</p>
        <p>&tau; = 1 / &lambda; (mittlere Lebensdauer)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die Halbwertszeit?</strong> Die Halbwertszeit ist die Zeit, nach der die H&auml;lfte einer radioaktiven Substanz zerfallen ist. Sie ist unabh&auml;ngig von der Anfangsmenge.</p>
      <p><strong>Was ist die Zerfallskonstante?</strong> Die Zerfallskonstante &lambda; = ln(2) / t&#189; gibt die Wahrscheinlichkeit an, mit der ein Atom pro Zeiteinheit zerf&auml;llt.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHL() {
      const init = parseFloat((document.getElementById('hl-init') as HTMLInputElement).value) || 0;
      const half = parseFloat((document.getElementById('hl-half') as HTMLInputElement).value) || 1;
      const time = parseFloat((document.getElementById('hl-time') as HTMLInputElement).value) || 0;
      const remaining = init * Math.pow(0.5, time / half);
      const decayed = init - remaining;
      const halfLives = time / half;
      const lambda = Math.LN2 / half;
      const tau = 1 / lambda;

      document.getElementById('hl-remaining')!.textContent = remaining.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('hl-pct')!.textContent = (init > 0 ? (remaining / init * 100) : 0).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' % verbleibend';
      document.getElementById('hl-decayed')!.textContent = decayed.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('hl-count')!.textContent = halfLives.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('hl-lambda')!.textContent = lambda.toLocaleString('de-DE', { minimumFractionDigits: 6, maximumFractionDigits: 6 });
      document.getElementById('hl-tau')!.textContent = tau.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });

      const rows: string[] = [];
      rows.push('<div class="grid grid-cols-3 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Halbwertszeiten</span><span>Verbleibend</span><span>% Rest</span></div>');
      for (let h = 0; h <= 10; h++) {
        const rem = init * Math.pow(0.5, h);
        const isCurrent = Math.abs(h - halfLives) < 0.5;
        const pct = init > 0 ? (rem / init * 100) : 0;
        rows.push('<div class="grid grid-cols-3 gap-1 text-xs ' + (isCurrent ? 'font-bold text-primary bg-blue-50 rounded p-1' : '') + '"><span>' + h + '</span><span>' + rem.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + '</span><span>' + pct.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' %</span></div>');
      }
      document.getElementById('hl-table')!.innerHTML = rows.join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['hl-init', 'hl-half', 'hl-time'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcHL);
      });
      calcHL();
    }, 50);
  </script>
</CalculatorLayout>
