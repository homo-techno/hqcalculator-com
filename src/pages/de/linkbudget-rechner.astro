---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Linkbudget Rechner – Funk & Kommunikationsstrecken";
const description = "Berechnen Sie das Linkbudget für Funk- und Kommunikationsstrecken. Sendeleistung, Antennengewinn, Pfadverlust und Empfängerempfindlichkeit.";
const relatedCalcs = [
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
  { name: "Lichtintensität Rechner", url: "/de/lichtintensitaet-rechner", description: "Lux & Lumen." },
  { name: "Linearantrieb Rechner", url: "/de/linearantrieb-rechner", description: "Kraft & Leistung." },
  { name: "Lineare Gleichung Rechner", url: "/de/lineare-gleichung-rechner", description: "Gleichungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="link-budget-calculator" calculatorName="Linkbudget Rechner" keywords="Linkbudget Rechner, Funkstrecke, FSPL, dBm, Antennengewinn, Empfängerempfindlichkeit" breadcrumbs={[{ name: "Linkbudget Rechner", url: "/de/linkbudget-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Linkbudget Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Linkbudget für drahtlose Kommunikationsstrecken: Reichweite, Empfangspegel und Linkmargin.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Sendeleistung (dBm)</label>
            <input type="number" id="lbg-ptx" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Sendeantenne Gewinn (dBi)</label>
            <input type="number" id="lbg-gtx" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" step="0.5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Empfangsantenne Gewinn (dBi)</label>
            <input type="number" id="lbg-grx" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" step="0.5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Empfängerempfindlichkeit (dBm)</label>
            <input type="number" id="lbg-sens" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="-90" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Frequenz (MHz)</label>
            <input type="number" id="lbg-freq" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="433" step="1" min="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Leitungsverluste (dB)</label>
            <input type="number" id="lbg-loss" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" step="0.5" min="0">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Distanz (km)</label>
          <input type="number" id="lbg-dist" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" step="0.1" min="0.001">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Link Margin</div>
          <div class="text-5xl font-extrabold font-mono" id="lbg-result">0 dB</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="lbg-details"></div>
        <div id="lbg-status" class="p-4 rounded-xl text-sm font-semibold text-center"></div>
      </div>
      <ShareButton lang="de" calculatorId="linkbudget" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Linkbudget-Analyse für Funkstrecken</h2>
      <p>Das Linkbudget beschreibt alle Gewinne und Verluste einer Funkverbindung. Der Freiraumdämpfung (FSPL = Free Space Path Loss) ist der wichtigste Verlustfaktor: FSPL (dB) = 20·log₁₀(d) + 20·log₁₀(f) + 20·log₁₀(4π/c). Der Link Margin (Systemreserve) gibt an, um wie viele dB die Verbindung stärker als das Minimum ist. Positiver Margin bedeutet stabile Verbindung.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Link Margin?</summary>
          <p class="mt-2 text-sm text-text-secondary">Der Link Margin (Systemreserve) gibt an, um wie viele dB der empfangene Pegel über dem Empfindlichkeitspegel des Empfängers liegt. Ein positiver Margin bedeutet, die Verbindung funktioniert. Typisch sind 10–20 dB Reserve eingeplant.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was bedeutet EIRP?</summary>
          <p class="mt-2 text-sm text-text-secondary">EIRP (Effective Isotropic Radiated Power) ist die effektive isotrope Strahlungsleistung: EIRP = P_Tx + G_Tx - Leitungsverluste (in dBm/dBi). Es beschreibt, wie viel Leistung ein idealer isotroper Strahler abstrahlen müsste, um denselben Pegel in Hauptstrahlrichtung zu erzielen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie nimmt die Freiraumdämpfung mit der Distanz zu?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die FSPL verdoppelt sich (um 6 dB) mit jeder Verdopplung der Distanz und steigt proportional zum Quadrat der Frequenz. Bei doppelter Frequenz steigt die FSPL um 6 dB.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viel Linkmargin brauche ich?</summary>
          <p class="mt-2 text-sm text-text-secondary">Für feste, gut sichtbare Verbindungen: 10 dB. Für mobile/variable Umgebungen: 15–20 dB. In städtischen Gebieten mit Multipath-Fading: 20–30 dB. Für zuverlässige IoT-Anwendungen: mindestens 15 dB.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLbg() {
      const Ptx = parseFloat((document.getElementById('lbg-ptx') as HTMLInputElement).value) || 0;
      const Gtx = parseFloat((document.getElementById('lbg-gtx') as HTMLInputElement).value) || 0;
      const Grx = parseFloat((document.getElementById('lbg-grx') as HTMLInputElement).value) || 0;
      const sens = parseFloat((document.getElementById('lbg-sens') as HTMLInputElement).value) || -90;
      const freq = parseFloat((document.getElementById('lbg-freq') as HTMLInputElement).value) || 433;
      const loss = parseFloat((document.getElementById('lbg-loss') as HTMLInputElement).value) || 0;
      const dist = parseFloat((document.getElementById('lbg-dist') as HTMLInputElement).value) || 1;

      // FSPL = 20*log10(d_m) + 20*log10(f_hz) - 147.55
      const distM = dist * 1000;
      const freqHz = freq * 1e6;
      const fspl = 20 * Math.log10(distM) + 20 * Math.log10(freqHz) - 147.55;
      const eirp = Ptx + Gtx - loss;
      const Prx = eirp - fspl + Grx;
      const margin = Prx - sens;

      const fmt = (v: number, u: string) => v.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' ' + u;
      document.getElementById('lbg-result')!.textContent = fmt(margin, 'dB');
      document.getElementById('lbg-details')!.innerHTML = `
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">EIRP</div><div class="text-lg font-bold font-mono">${fmt(eirp, 'dBm')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Freiraumdämpfung</div><div class="text-lg font-bold font-mono">${fmt(fspl, 'dB')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfangspegel</div><div class="text-lg font-bold font-mono">${fmt(Prx, 'dBm')}</div></div>
        <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfindlichkeit</div><div class="text-lg font-bold font-mono">${fmt(sens, 'dBm')}</div></div>`;

      const statusEl = document.getElementById('lbg-status')!;
      if (margin >= 20) {
        statusEl.className = 'p-4 rounded-xl text-sm font-semibold text-center bg-green-100 text-green-800 border border-green-300';
        statusEl.textContent = 'Ausgezeichnete Verbindungsqualität – Verbindung sehr stabil.';
      } else if (margin >= 10) {
        statusEl.className = 'p-4 rounded-xl text-sm font-semibold text-center bg-blue-100 text-blue-800 border border-blue-300';
        statusEl.textContent = 'Gute Verbindungsqualität – Verbindung sollte zuverlässig sein.';
      } else if (margin > 0) {
        statusEl.className = 'p-4 rounded-xl text-sm font-semibold text-center bg-yellow-100 text-yellow-800 border border-yellow-300';
        statusEl.textContent = 'Knappe Verbindung – unter ungünstigen Bedingungen möglicherweise instabil.';
      } else {
        statusEl.className = 'p-4 rounded-xl text-sm font-semibold text-center bg-red-100 text-red-800 border border-red-300';
        statusEl.textContent = 'Keine Verbindung möglich – Distanz reduzieren oder Antennen verbessern.';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      ['lbg-ptx','lbg-gtx','lbg-grx','lbg-sens','lbg-freq','lbg-loss','lbg-dist'].forEach(id => document.getElementById(id)!.addEventListener('input', calcLbg));
      calcLbg();
    }, 50);
  </script>
</CalculatorLayout>
