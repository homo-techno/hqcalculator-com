---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Asteroideneinschlag-Rechner";
const description = "Berechnen Sie die Einschlagenergie, Kratergröße, TNT-Äquivalent und Torino-Skala eines Asteroiden basierend auf Größe, Geschwindigkeit und Dichte.";
const relatedCalcs = [
  { name: "Kinetische Energie", url: "/kinetic-energy-calculator", description: "Energie." },
  { name: "Kraftrechner", url: "/force-calculator", description: "Kraft." },
  { name: "Impuls", url: "/momentum-calculator", description: "Impuls." },
  { name: "Fluchtgeschwindigkeit", url: "/escape-velocity-calculator", description: "Fluchtgeschwindigkeit." },
  { name: "Umlaufzeit", url: "/orbital-period-calculator", description: "Umlaufbahnen." },
  { name: "Geschwindigkeitsrechner", url: "/speed-calculator", description: "Geschwindigkeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Asteroideneinschlag-Rechner" keywords="Asteroideneinschlag, Kratergröße, Einschlagenergie, TNT-Äquivalent, Torino-Skala, kinetische Energie" lang="de" breadcrumbs={[{ name: "Asteroideneinschlag", url: "/de/asteroideneinschlag-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Asteroideneinschlag-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Zerstörungskraft eines Asteroideneinschlags basierend auf Größe, Geschwindigkeit und Zusammensetzung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Asteroiden-Durchmesser (m)</label><input type="number" id="ai-dia" class="ai-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="100" step="1" min="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einschlaggeschwindigkeit (km/s)</label><input type="number" id="ai-vel" class="ai-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="1" min="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Asteroiden-Dichte (kg/m\u00B3)</label>
            <select id="ai-dens" class="ai-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1500">Eis/Komet (1.500)</option>
              <option value="2600">Kohlenstoffhaltig (2.600)</option>
              <option value="3500" selected>Steinig (3.500)</option>
              <option value="5500">Stein-Eisen (5.500)</option>
              <option value="7900">Eisen (7.900)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Einschlagwinkel (Grad)</label><input type="number" id="ai-angle" class="ai-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" step="1" min="5" max="90"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Einschlagenergie</div>
          <div class="text-4xl font-extrabold font-mono" id="ai-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">TNT-Äquivalent</div><div class="text-xl font-bold font-mono" id="ai-tnt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hiroshima-Bomben</div><div class="text-xl font-bold font-mono" id="ai-hiro">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Krater-Durchmesser</div><div class="text-xl font-bold font-mono" id="ai-crater">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kratertiefe</div><div class="text-xl font-bold font-mono" id="ai-depth">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Asteroidenmasse</div><div class="text-xl font-bold font-mono" id="ai-mass">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Torino-Skala</div><div class="text-xl font-bold font-mono" id="ai-torino">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einschlagbeschreibung</div><div class="text-lg font-bold font-mono" id="ai-desc">--</div></div>
      </div>
      <ShareButton calculatorId="asteroid-impact" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcAI() {
      const dia = parseFloat((document.getElementById('ai-dia') as HTMLInputElement).value) || 100;
      const vel = parseFloat((document.getElementById('ai-vel') as HTMLInputElement).value) * 1000 || 20000;
      const density = parseFloat((document.getElementById('ai-dens') as HTMLSelectElement).value) || 3500;
      const angle = parseFloat((document.getElementById('ai-angle') as HTMLInputElement).value) || 45;
      const angleRad = angle * Math.PI / 180;
      const radius = dia / 2;
      const volume = (4 / 3) * Math.PI * radius * radius * radius;
      const mass = density * volume;
      const vSin = vel * Math.sin(angleRad);
      const KE = 0.5 * mass * vSin * vSin;
      const tntKg = KE / 4.184e6;
      const tntMT = tntKg / 1e9;
      const hiroshima = tntKg / 15e6;
      const craterDia = 1.161 * Math.pow(density / 2500, 1/3) * Math.pow(dia, 0.78) * Math.pow(vel / 20000, 0.44) * Math.pow(Math.sin(angleRad), 1/3) * 10;
      const craterDepth = craterDia / 5;
      let desc = '';
      let torino = 0;
      if (tntMT < 0.001) { desc = 'Luftdetonation - geringfügige lokale Schäden'; torino = 0; }
      else if (tntMT < 1) { desc = 'Zerstörung auf Stadtebene möglich'; torino = 3; }
      else if (tntMT < 100) { desc = 'Regionale Verwüstung'; torino = 5; }
      else if (tntMT < 100000) { desc = 'Kontinentale Katastrophe'; torino = 7; }
      else if (tntMT < 1e8) { desc = 'Globales Massenaussterben'; torino = 9; }
      else { desc = 'Planetensterilisierender Einschlag'; torino = 10; }

      let energyStr = '';
      if (KE < 1e15) { energyStr = (KE / 1e12).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' TJ'; }
      else if (KE < 1e18) { energyStr = (KE / 1e15).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' PJ'; }
      else { energyStr = (KE / 1e18).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' EJ'; }

      let tntStr = '';
      if (tntMT < 0.001) { tntStr = (tntMT * 1e6).toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' Tonnen'; }
      else if (tntMT < 1) { tntStr = (tntMT * 1000).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' Kilotonnen'; }
      else { tntStr = tntMT.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Megatonnen'; }

      document.getElementById('ai-result')!.textContent = energyStr;
      document.getElementById('ai-tnt')!.textContent = tntStr;
      document.getElementById('ai-hiro')!.textContent = hiroshima < 1 ? hiroshima.toLocaleString('de-DE', { maximumFractionDigits: 3 }) : Math.round(hiroshima).toLocaleString('de-DE');
      document.getElementById('ai-crater')!.textContent = craterDia < 1000 ? craterDia.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' m' : (craterDia / 1000).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' km';
      document.getElementById('ai-depth')!.textContent = craterDepth < 1000 ? craterDepth.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' m' : (craterDepth / 1000).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' km';
      document.getElementById('ai-mass')!.textContent = mass < 1e9 ? mass.toExponential(2) + ' kg' : (mass / 1e9).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Gt';
      document.getElementById('ai-torino')!.textContent = torino + ' / 10';
      document.getElementById('ai-desc')!.textContent = desc;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ai-in').forEach(el => { el.addEventListener('input', calcAI); el.addEventListener('change', calcAI); });
      calcAI();
    }, 50);
  </script>
</CalculatorLayout>
