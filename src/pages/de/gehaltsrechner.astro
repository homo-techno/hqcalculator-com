---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Gehaltsrechner - Stundenlohn, Monatsgehalt & Jahresgehalt 2026";
const description = "Rechne dein Gehalt zwischen Stundenlohn, Wochengehalt, Monatsgehalt und Jahresgehalt um. Berücksichtigt Urlaub und Feiertage.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Trinkgeldrechner", url: "/de/trinkgeldrechner", description: "Trinkgeld berechnen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten berechnen." },
  { name: "Zinseszinsrechner", url: "/de/zinseszinsrechner", description: "Zinseszins berechnen." },
  { name: "Mehrwertsteuerrechner", url: "/de/mehrwertsteuerrechner", description: "MwSt. berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziele planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Gehaltsrechner" keywords="Gehaltsrechner, Stundenlohn berechnen, Jahresgehalt, Monatsgehalt, Gehalt umrechnen" breadcrumbs={[{ name: "Gehaltsrechner", url: "/de/gehaltsrechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gehaltsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechne dein Gehalt zwischen verschiedenen Zeiträumen um.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-1">Gehaltsbetrag</label>
            <div class="relative">
              <input type="number" id="sal-amount" class="w-full pl-4 pr-8 py-3 border border-border rounded-xl text-2xl font-bold" value="55000" min="0" step="100">
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
            </div>
          </div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-text mb-2">Gehaltsperiode</label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <button class="sal-period-btn px-3 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-period="hourly">Stundenlohn</button>
              <button class="sal-period-btn px-3 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-period="weekly">Wöchentlich</button>
              <button class="sal-period-btn px-3 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-period="biweekly">Zweiwöchentl.</button>
              <button class="sal-period-btn px-3 py-2 rounded-lg text-sm font-semibold bg-surface-alt text-text-secondary border border-border cursor-pointer" data-period="monthly">Monatlich</button>
              <button class="sal-period-btn px-3 py-2 rounded-lg text-sm font-semibold bg-primary text-white border border-primary cursor-pointer" data-period="annual">Jährlich</button>
            </div>
          </div>
          <div class="mb-5"><label class="block text-sm font-medium text-text mb-1">Stunden pro Woche</label><input type="number" id="sal-hours" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="40" min="1" max="168"></div>
          <div class="mb-5"><label class="block text-sm font-medium text-text mb-1">Urlaubstage pro Jahr</label><input type="number" id="sal-vacation" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="30" min="0" max="365"></div>
          <div class="mb-5"><label class="block text-sm font-medium text-text mb-1">Feiertage pro Jahr</label><input type="number" id="sal-holidays" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="0" max="30"></div>
        </div>
        <div class="space-y-3">
          <div class="p-5 bg-primary rounded-2xl text-white">
            <div class="flex justify-between items-center"><div><div class="text-sm text-blue-200 uppercase">Jahresgehalt</div></div><div class="text-3xl font-extrabold" id="sal-annual">0 €</div></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl flex justify-between items-center"><div><div class="font-semibold text-sm">Monatlich</div><div class="text-xs text-text-muted">12 Gehälter/Jahr</div></div><div class="text-xl font-bold" id="sal-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl flex justify-between items-center"><div><div class="font-semibold text-sm">Zweiwöchentlich</div><div class="text-xs text-text-muted">26 Gehälter/Jahr</div></div><div class="text-xl font-bold" id="sal-biweekly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl flex justify-between items-center"><div><div class="font-semibold text-sm">Wöchentlich</div><div class="text-xs text-text-muted">52 Gehälter/Jahr</div></div><div class="text-xl font-bold" id="sal-weekly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl flex justify-between items-center"><div><div class="font-semibold text-sm">Täglich</div><div class="text-xs text-text-muted">Basierend auf Arbeitstagen</div></div><div class="text-xl font-bold" id="sal-daily">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl flex justify-between items-center"><div><div class="font-semibold text-sm">Stundenlohn</div><div class="text-xs text-text-muted">Basierend auf Wochenstunden</div></div><div class="text-xl font-bold text-primary" id="sal-hourly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <div class="flex justify-between text-sm"><span class="text-text-muted">Arbeitstage/Jahr</span><span class="font-semibold" id="sal-workdays">0</span></div>
            <div class="flex justify-between text-sm mt-1"><span class="text-text-muted">Arbeitsstunden/Jahr</span><span class="font-semibold" id="sal-workhours">0</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="salary" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie die Gehaltsumrechnung funktioniert</h2>
      <p>Dieser Rechner wandelt dein Gehalt zwischen verschiedenen Zeiträumen um. Das Jahresgehalt bildet die Basis für alle Umrechnungen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p>Jahresgehalt = Stundenlohn &times; Stunden/Woche &times; 52</p>
        <p>Monatlich = Jahresgehalt / 12</p>
        <p>Wöchentlich = Jahresgehalt / 52</p>
      </div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let salPeriod = 'annual';
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' €';

    function calcSalary() {
      const amount = parseFloat((document.getElementById('sal-amount') as HTMLInputElement).value) || 0;
      const hoursPerWeek = parseFloat((document.getElementById('sal-hours') as HTMLInputElement).value) || 40;
      const vacationDays = parseFloat((document.getElementById('sal-vacation') as HTMLInputElement).value) || 0;
      const holidays = parseFloat((document.getElementById('sal-holidays') as HTMLInputElement).value) || 0;
      const offDays = vacationDays + holidays;
      const workDays = 260 - offDays;
      const workHours = workDays * (hoursPerWeek / 5);

      let annual: number;
      switch (salPeriod) {
        case 'hourly': annual = amount * hoursPerWeek * 52; break;
        case 'weekly': annual = amount * 52; break;
        case 'biweekly': annual = amount * 26; break;
        case 'monthly': annual = amount * 12; break;
        case 'annual': default: annual = amount; break;
      }

      const hourly = workHours > 0 ? annual / workHours : 0;
      const daily = workDays > 0 ? annual / workDays : 0;

      document.getElementById('sal-annual')!.textContent = fmt(annual);
      document.getElementById('sal-monthly')!.textContent = fmt(annual / 12);
      document.getElementById('sal-biweekly')!.textContent = fmt(annual / 26);
      document.getElementById('sal-weekly')!.textContent = fmt(annual / 52);
      document.getElementById('sal-daily')!.textContent = fmt(daily);
      document.getElementById('sal-hourly')!.textContent = fmt(hourly);
      document.getElementById('sal-workdays')!.textContent = String(workDays);
      document.getElementById('sal-workhours')!.textContent = workHours.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.sal-period-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.sal-period-btn').forEach(b => { b.classList.remove('bg-primary', 'text-white', 'border-primary'); b.classList.add('bg-surface-alt', 'text-text-secondary', 'border-border'); });
          btn.classList.remove('bg-surface-alt', 'text-text-secondary', 'border-border'); btn.classList.add('bg-primary', 'text-white', 'border-primary');
          salPeriod = (btn as HTMLElement).dataset.period || 'annual';
          calcSalary();
        });
      });
      ['sal-amount', 'sal-hours', 'sal-vacation', 'sal-holidays'].forEach(id => document.getElementById(id)!.addEventListener('input', calcSalary));
      calcSalary();
    }, 50);
  </script>
</CalculatorLayout>
