---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Pilzzucht Rechner - Substrat, Ertrag und Kosten berechnen";
const description = "Berechnen Sie Substratmenge, Ertragserwartung und Kosten für die Pilzzucht zu Hause oder im Betrieb.";
const relatedCalcs = [
  { name: "Mulchrechner", url: "/de/mulch-rechner", description: "Mulchmenge berechnen." },
  { name: "Ahornsirup Rechner", url: "/de/ahornsirup-rechner", description: "Ahornsirup berechnen." },
  { name: "Nagelstudio Preisrechner", url: "/de/nagelstudio-preise-rechner", description: "Preise kalkulieren." },
  { name: "Umzugsbudget Rechner", url: "/de/umzugsbudget-rechner", description: "Budget planen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Pilzzucht Rechner" enSlug="mushroom-growing-calculator" keywords="Pilzzucht, Substratmenge, Pilzertrag, Shiitake, Austernpilze, Pilze anbauen" breadcrumbs={[{ name: "Pilzzucht Rechner", url: "/de/pilzzucht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Pilzzucht Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Pilzzucht: Berechnen Sie Substratmenge, erwarteten Ertrag, Kosten und potenziellen Erlös.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Pilzart</label>
          <select id="pz-type" class="pz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0.25">Austernpilze (25% BE)</option>
            <option value="0.15">Shiitake (15% BE)</option>
            <option value="0.20">Kräuterseitlinge (20% BE)</option>
            <option value="0.10">Champignons (10% BE)</option>
            <option value="0.30">Samtfußrüblinge (30% BE)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Substratmenge (kg)</label><input type="number" id="pz-substrate" class="pz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Erntedurchgänge</label><input type="number" id="pz-flushes" class="pz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="1" max="10" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Substratpreis (€/kg)</label><input type="number" id="pz-subprice" class="pz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.50" min="0" step="0.10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Brut/Myzel (€)</label><input type="number" id="pz-spawn" class="pz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verkaufspreis (€/kg)</label><input type="number" id="pz-sellprice" class="pz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sonstige Kosten (€)</label><input type="number" id="pz-misc" class="pz-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Erwarteter Gesamtertrag</div>
          <div class="text-5xl font-extrabold font-mono" id="pz-result">0,00 kg</div>
          <div class="text-sm text-blue-200 mt-1" id="pz-sub"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="pz-cost">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erlös</div><div class="text-xl font-bold" id="pz-revenue">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinn/Verlust</div><div class="text-xl font-bold" id="pz-profit">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro kg</div><div class="text-xl font-bold" id="pz-costperkg">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="pilzzucht" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Pilzzucht – Rentabilität berechnen</h2>
      <p>Die biologische Effizienz (BE) gibt an, wie viel Frischpilze im Verhältnis zum eingesetzten Substrat geerntet werden. Austernpilze erreichen häufig 20–30% BE, Shiitake meist 10–20%. Mit mehreren Erntedurchgängen lässt sich die Gesamtausbeute steigern.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was ist die biologische Effizienz?</strong></p><p>Die BE beschreibt das Verhältnis von geernteten Frischpilzen zu trockenem Substrat. 25% BE bedeutet: aus 10 kg Substrat werden 2,5 kg Frischpilze geerntet.</p></div>
        <div><p><strong>Welche Pilze eignen sich für Anfänger?</strong></p><p>Austernpilze und Kräuterseitlinge sind am einfachsten zu kultivieren. Sie wachsen schnell, sind robust und benötigen wenig Spezialausrüstung.</p></div>
        <div><p><strong>Wie viele Erntedurchgänge sind möglich?</strong></p><p>Je nach Pilzart und Substrat sind 2–5 Erntedurchgänge möglich. Mit jedem Flush nimmt der Ertrag typischerweise ab.</p></div>
        <div><p><strong>Lohnt sich Pilzzucht wirtschaftlich?</strong></p><p>Im Hobbybereich kaum, da Sonderpilze 8–20 €/kg erzielen. Im kommerziellen Maßstab ab ca. 500 kg/Monat kann es profitabel sein.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcPZ() {
      const be = parseFloat((document.getElementById('pz-type') as HTMLSelectElement).value) || 0.25;
      const substrate = parseFloat((document.getElementById('pz-substrate') as HTMLInputElement).value) || 0;
      const flushes = parseFloat((document.getElementById('pz-flushes') as HTMLInputElement).value) || 1;
      const subPrice = parseFloat((document.getElementById('pz-subprice') as HTMLInputElement).value) || 0;
      const spawn = parseFloat((document.getElementById('pz-spawn') as HTMLInputElement).value) || 0;
      const sellPrice = parseFloat((document.getElementById('pz-sellprice') as HTMLInputElement).value) || 0;
      const misc = parseFloat((document.getElementById('pz-misc') as HTMLInputElement).value) || 0;
      const fmt = (v: number, d = 2) => v.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
      const yieldPerFlush = substrate * be;
      const totalYield = yieldPerFlush * flushes * 0.7;
      const totalCost = substrate * subPrice + spawn + misc;
      const revenue = totalYield * sellPrice;
      const profit = revenue - totalCost;
      const costPerKg = totalYield > 0 ? totalCost / totalYield : 0;
      document.getElementById('pz-result')!.textContent = fmt(totalYield) + ' kg';
      document.getElementById('pz-sub')!.textContent = 'Erlös: ' + fmt(revenue) + ' € | ' + flushes + ' Erntedurchgänge';
      document.getElementById('pz-cost')!.textContent = fmt(totalCost) + ' €';
      document.getElementById('pz-revenue')!.textContent = fmt(revenue) + ' €';
      const profitEl = document.getElementById('pz-profit')!;
      profitEl.textContent = (profit >= 0 ? '+' : '') + fmt(profit) + ' €';
      profitEl.style.color = profit >= 0 ? '#16a34a' : '#dc2626';
      document.getElementById('pz-costperkg')!.textContent = fmt(costPerKg) + ' €/kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pz-in').forEach(el => { el.addEventListener('input', calcPZ); el.addEventListener('change', calcPZ); });
      calcPZ();
    }, 50);
  </script>
</CalculatorLayout>
