---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Blutdruckrechner - Ihre Blutdruck-Kategorie prüfen";
const description = "Prüfen Sie Ihre Blutdruck-Kategorie nach AHA-Richtlinien. Verfolgen Sie Messwerte, verstehen Sie systolische und diastolische Werte und erhalten Sie Gesundheitsempfehlungen.";

const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Tägliche Kalorien." },
  { name: "Körperfettrechner", url: "/de/koerperfett-rechner", description: "Körperfettanteil." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Blutdruckrechner"
  lang="de"
  keywords="blutdruck rechner, blutdruck tabelle, blutdruck kategorien, hypertonie, systolisch diastolisch, blutdruck bereich"
  breadcrumbs={[{ name: "Blutdruck", url: "/de/blutdruck-rechner" }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blutdruckrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Ihre Messwerte ein, um Ihre Blutdruck-Kategorie und Gesundheitshinweise zu sehen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <h3 class="font-semibold text-text mb-3">Ihr Blutdruck-Messwert</h3>
      <div class="flex items-center gap-3 mb-6">
        <div class="flex-1">
          <label class="block text-xs font-medium text-text mb-1">Systolisch (oberer Wert)</label>
          <input type="number" id="bp-sys" class="w-full px-4 py-3 border border-border rounded-xl text-3xl font-bold text-center" value="120" min="60" max="250" step="1">
        </div>
        <span class="text-3xl font-bold text-text-muted mt-5">/</span>
        <div class="flex-1">
          <label class="block text-xs font-medium text-text mb-1">Diastolisch (unterer Wert)</label>
          <input type="number" id="bp-dia" class="w-full px-4 py-3 border border-border rounded-xl text-3xl font-bold text-center" value="80" min="30" max="150" step="1">
        </div>
        <span class="text-lg text-text-muted mt-5 font-semibold">mmHg</span>
      </div>

      <div class="p-6 rounded-2xl text-white text-center mb-4" id="bp-result-box" style="background: #22c55e;">
        <div class="text-sm uppercase tracking-wide mb-1 opacity-80">Blutdruck-Kategorie</div>
        <div class="text-3xl font-extrabold" id="bp-category">Normal</div>
        <div class="text-sm mt-1 opacity-80" id="bp-range">Systolisch &lt; 120 UND Diastolisch &lt; 80</div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-2">Empfehlung</h3>
        <p class="text-sm text-text-secondary" id="bp-advice">Ihr Blutdruck liegt im Normalbereich. Führen Sie einen gesunden Lebensstil mit regelmäßiger Bewegung und ausgewogener Ernährung.</p>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Blutdruck-Kategorien (AHA)</h3>
        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-3 p-2 rounded-lg bg-green-50">
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <div class="flex-1"><strong>Normal</strong></div>
            <div class="text-text-muted">&lt; 120 / &lt; 80</div>
          </div>
          <div class="flex items-center gap-3 p-2 rounded-lg bg-yellow-50">
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="flex-1"><strong>Erhöht</strong></div>
            <div class="text-text-muted">120-129 / &lt; 80</div>
          </div>
          <div class="flex items-center gap-3 p-2 rounded-lg bg-orange-50">
            <div class="w-3 h-3 rounded-full bg-orange-500"></div>
            <div class="flex-1"><strong>Bluthochdruck Stufe 1</strong></div>
            <div class="text-text-muted">130-139 / 80-89</div>
          </div>
          <div class="flex items-center gap-3 p-2 rounded-lg bg-red-50">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="flex-1"><strong>Bluthochdruck Stufe 2</strong></div>
            <div class="text-text-muted">&ge; 140 / &ge; 90</div>
          </div>
          <div class="flex items-center gap-3 p-2 rounded-lg bg-red-100">
            <div class="w-3 h-3 rounded-full bg-red-700"></div>
            <div class="flex-1"><strong>Hypertensive Krise</strong></div>
            <div class="text-text-muted">&gt; 180 / &gt; 120</div>
          </div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <div class="flex justify-between items-center mb-3">
          <h3 class="font-semibold text-sm text-text">Messprotokoll</h3>
          <button id="bp-log" class="px-3 py-1 text-xs rounded-lg bg-primary text-white font-semibold hover:bg-blue-700">Aktuelle Messung speichern</button>
        </div>
        <div class="space-y-1 text-sm" id="bp-log-list">
          <div class="text-text-muted text-xs">Noch keine Messungen gespeichert</div>
        </div>
      </div>

      <ShareButton calculatorId="blood-pressure" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Blutdruck verstehen</h2>
      <p>Der Blutdruck wird in Millimeter Quecksilbersäule (mmHg) mit zwei Zahlen gemessen: <strong>systolisch</strong> (Druck beim Herzschlag) über <strong>diastolisch</strong> (Druck zwischen den Schlägen). Ein Wert von 120/80 mmHg wird als "120 zu 80" ausgesprochen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">So erhalten Sie genaue Messwerte</h3>
      <ul>
        <li>Sitzen Sie 5 Minuten ruhig vor der Messung</li>
        <li>Rauchen, Koffein oder Sport innerhalb von 30 Minuten vermeiden</li>
        <li>Sitzen Sie mit gestütztem Rücken, Füße flach, Arm auf Herzhöhe</li>
        <li>2-3 Messungen im Abstand von einer Minute nehmen und den Durchschnitt bilden</li>
        <li>Messen Sie jeden Tag zur gleichen Zeit</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was verursacht hohen Blutdruck?</strong> Risikofaktoren sind übermäßiger Salzkonsum, Bewegungsmangel, Übergewicht, Stress, Alter, familiäre Vorbelastung und bestimmte Erkrankungen.</p>
      <p><strong>Kann ich den Blutdruck natürlich senken?</strong> Ja — reduzieren Sie Salz, treiben Sie regelmäßig Sport, halten Sie ein gesundes Gewicht, begrenzen Sie Alkohol, managen Sie Stress und ernähren Sie sich obst-, gemüse- und vollkornreich.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    interface LogEntry { sys: number; dia: number; time: string; category: string; }
    const logEntries: LogEntry[] = [];

    function getCategory(sys: number, dia: number): { name: string; color: string; range: string; advice: string } {
      if (sys > 180 || dia > 120) return {
        name: 'Hypertensive Krise',
        color: '#b91c1c',
        range: 'Systolisch > 180 und/oder Diastolisch > 120',
        advice: 'SUCHEN SIE SOFORT NOTÄRZTLICHE HILFE. Dies ist ein medizinischer Notfall. Rufen Sie den Rettungsdienst (112) oder gehen Sie zur nächsten Notaufnahme.'
      };
      if (sys >= 140 || dia >= 90) return {
        name: 'Bluthochdruck (Stufe 2)',
        color: '#ef4444',
        range: 'Systolisch \u2265 140 oder Diastolisch \u2265 90',
        advice: 'Konsultieren Sie zeitnah Ihren Arzt. Sie werden wahrscheinlich Medikamente zusätzlich zu Lebensstiländerungen benötigen. Regelmäßige Kontrolle ist wichtig.'
      };
      if (sys >= 130 || dia >= 80) return {
        name: 'Bluthochdruck (Stufe 1)',
        color: '#f97316',
        range: 'Systolisch 130-139 oder Diastolisch 80-89',
        advice: 'Sprechen Sie mit Ihrem Arzt über Lebensstiländerungen und eventuell Medikamente. Reduzieren Sie Salz, bewegen Sie sich regelmäßig und managen Sie Stress.'
      };
      if (sys >= 120 && dia < 80) return {
        name: 'Erhöht',
        color: '#eab308',
        range: 'Systolisch 120-129 und Diastolisch < 80',
        advice: 'Ihr Blutdruck ist höher als normal, aber noch nicht hoch. Beginnen Sie jetzt mit gesunden Lebensstiländerungen, um eine Verschlechterung zu verhindern.'
      };
      if (sys < 90 || dia < 60) return {
        name: 'Niedriger Blutdruck',
        color: '#6366f1',
        range: 'Systolisch < 90 oder Diastolisch < 60',
        advice: 'Niedriger Blutdruck kann Schwindel und Ohnmacht verursachen. Bei Symptomen konsultieren Sie Ihren Arzt. Manche Menschen haben natürlich niedrigeren Blutdruck.'
      };
      return {
        name: 'Normal',
        color: '#22c55e',
        range: 'Systolisch < 120 UND Diastolisch < 80',
        advice: 'Ihr Blutdruck liegt im Normalbereich. Führen Sie einen gesunden Lebensstil mit regelmäßiger Bewegung und ausgewogener Ernährung.'
      };
    }

    function calcBP() {
      const sys = parseInt((document.getElementById('bp-sys') as HTMLInputElement).value) || 0;
      const dia = parseInt((document.getElementById('bp-dia') as HTMLInputElement).value) || 0;

      const cat = getCategory(sys, dia);
      document.getElementById('bp-result-box')!.style.backgroundColor = cat.color;
      document.getElementById('bp-category')!.textContent = cat.name;
      document.getElementById('bp-range')!.textContent = cat.range;
      document.getElementById('bp-advice')!.textContent = cat.advice;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function renderLog() {
      if (logEntries.length === 0) {
        document.getElementById('bp-log-list')!.innerHTML = '<div class="text-text-muted text-xs">Noch keine Messungen gespeichert</div>';
        return;
      }
      document.getElementById('bp-log-list')!.innerHTML = logEntries.map((e, i) =>
        `<div class="flex justify-between items-center py-1 border-b border-border/30 last:border-0">
          <span class="font-mono font-bold">${e.sys}/${e.dia}</span>
          <span class="text-xs text-text-muted">${e.category}</span>
          <span class="text-xs text-text-muted">${e.time}</span>
        </div>`
      ).join('');
    }

    setTimeout(() => {
      ['bp-sys', 'bp-dia'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcBP);
      });

      document.getElementById('bp-log')!.addEventListener('click', () => {
        const sys = parseInt((document.getElementById('bp-sys') as HTMLInputElement).value) || 0;
        const dia = parseInt((document.getElementById('bp-dia') as HTMLInputElement).value) || 0;
        const cat = getCategory(sys, dia);
        logEntries.unshift({
          sys, dia,
          category: cat.name,
          time: new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' })
        });
        renderLog();
      });

      calcBP();
    }, 50);
  </script>
</CalculatorLayout>
