---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gitarren-Mensur-Rechner - Bundpositionen & Abst&auml;nde";
const description = "Berechnen Sie Bundpositionen aus der Mensurl&auml;nge, Bundabst&auml;nde, Sattelkompensation und Sattel-zu-Bund-Abst&auml;nde f&uuml;r den Gitarrenbau.";
const relatedCalcs = [
  { name: "Gitarren-Stimmung-Rechner", url: "/de/gitarren-stimmung-rechner", description: "Stimmfrequenzen." },
  { name: "L&auml;ngenumrechner", url: "/de/laengenumrechner", description: "L&auml;ngen umrechnen." },
  { name: "Frequenz-Rechner", url: "/de/frequenz-rechner", description: "Frequenzeinheiten." },
  { name: "Resonanz-Rechner", url: "/de/resonanz-rechner", description: "Resonanzfrequenz." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gitarren-Mensur-Rechner" lang="de" enSlug="guitar-scale-length-calculator" keywords="gitarren mensur, bundposition, bundabstand, bund rechner, gitarrenbau, gitarrenbauer, kompensation" breadcrumbs={[{ name: "Gitarren-Mensur", url: "/de/gitarren-mensur-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gitarren-Mensur-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie pr&auml;zise Bundpositionen und -abst&auml;nde f&uuml;r jede Gitarren-Mensurl&auml;nge.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Mensurl&auml;nge (mm)</label><input type="number" id="gmde2-scale" class="gmde2-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="250" max="1000" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl B&uuml;nde</label><input type="number" id="gmde2-frets" class="gmde2-in w-full px-4 py-3 border border-border rounded-xl text-lg" min="12" max="36" step="1"></div>
        </div>
        <div class="flex gap-2 flex-wrap">
          <button class="gmde2-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-v="648">Fender 648 mm</button>
          <button class="gmde2-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-v="629">Gibson 629 mm</button>
          <button class="gmde2-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-v="635">PRS 635 mm</button>
          <button class="gmde2-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-v="864">Bass 864 mm</button>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Sattelkompensation (mm)</label><input type="number" id="gmde2-comp" class="gmde2-in w-full px-4 py-3 border border-border rounded-xl text-lg" min="0" max="10" step="0.1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mensurl&auml;nge</div>
          <div class="text-4xl font-extrabold font-mono" id="gmde2-result">0 mm</div>
          <div class="text-sm text-blue-200 mt-1" id="gmde2-inch">0 Zoll</div>
        </div>
        <div class="overflow-x-auto max-h-96">
          <table class="w-full text-sm">
            <thead class="sticky top-0 bg-white">
              <tr class="bg-surface-alt">
                <th class="p-2 text-left rounded-tl-xl">Bund</th>
                <th class="p-2 text-right">Vom Sattel (mm)</th>
                <th class="p-2 text-right">Vom Sattel (Zoll)</th>
                <th class="p-2 text-right">Bundabstand (mm)</th>
                <th class="p-2 text-right rounded-tr-xl">Zum Steg (mm)</th>
              </tr>
            </thead>
            <tbody id="gmde2-table"></tbody>
          </table>
        </div>
      </div>
      <ShareButton calculatorId="guitar-scale-length-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mensurl&auml;nge und Bundberechnung</h2>
      <p>Die Mensurl&auml;nge ist der schwingende Anteil der Saite zwischen Sattel und Steg. Jede Bundposition wird nach der 12. Wurzel aus 2 berechnet, was die gleichstufige Stimmung ergibt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die Standard-Mensurl&auml;nge?</strong> Fender verwendet 648 mm (25,5"), Gibson 629 mm (24,75").</p>
      <p><strong>Was ist Sattelkompensation?</strong> Eine kleine Verl&auml;ngerung am Steg, um Intonationsfehler durch Saitensteifigkeit auszugleichen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGMDE2() {
      const scale = parseFloat((document.getElementById('gmde2-scale') as HTMLInputElement).value) || 0;
      const numFrets = parseInt((document.getElementById('gmde2-frets') as HTMLInputElement).value) || 22;
      const comp = parseFloat((document.getElementById('gmde2-comp') as HTMLInputElement).value) || 0;

      if (scale <= 0) return;

      const effectiveScale = scale + comp;
      document.getElementById('gmde2-result')!.textContent = scale.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' mm';
      document.getElementById('gmde2-inch')!.textContent = (scale / 25.4).toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' Zoll';

      const table = document.getElementById('gmde2-table')!;
      let html = '';
      let prevDist = 0;

      for (let i = 1; i <= numFrets; i++) {
        const distFromNut = effectiveScale - effectiveScale / Math.pow(2, i / 12);
        const spacing = distFromNut - prevDist;
        const toBridge = effectiveScale - distFromNut;

        const highlight = (i === 12) ? ' class="bg-blue-50 font-bold"' : '';
        html += '<tr' + highlight + ' class="border-t border-border">' +
          '<td class="p-2 font-medium">' + i + '</td>' +
          '<td class="p-2 text-right font-mono">' + distFromNut.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '</td>' +
          '<td class="p-2 text-right font-mono">' + (distFromNut / 25.4).toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) + '</td>' +
          '<td class="p-2 text-right font-mono">' + spacing.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '</td>' +
          '<td class="p-2 text-right font-mono">' + toBridge.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '</td>' +
          '</tr>';
        prevDist = distFromNut;
      }
      table.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('gmde2-scale') as HTMLInputElement).value = '648';
      (document.getElementById('gmde2-frets') as HTMLInputElement).value = '22';
      (document.getElementById('gmde2-comp') as HTMLInputElement).value = '2';
      document.querySelectorAll('.gmde2-in').forEach(el => { el.addEventListener('input', calcGMDE2); el.addEventListener('change', calcGMDE2); });
      document.querySelectorAll('.gmde2-preset').forEach(btn => btn.addEventListener('click', () => {
        (document.getElementById('gmde2-scale') as HTMLInputElement).value = (btn as HTMLElement).dataset.v!;
        calcGMDE2();
      }));
      calcGMDE2();
    }, 50);
  </script>
</CalculatorLayout>
