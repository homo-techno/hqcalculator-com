---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gewohnheitsbildung-Rechner - Tage bis zur Automatisierung (Lally-Modell)";
const description = "Berechnen Sie, wie lange es dauert, eine Gewohnheit zu bilden, basierend auf Phillippa Lallys Forschungsmodell. Verfolgen Sie Konsistenz, Serie und Automatisierungsgrad.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "T&auml;glicher Kalorienbedarf." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen optimieren." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Genaues Alter berechnen." },
  { name: "Wasseraufnahme-Rechner", url: "/de/wasseraufnahme-rechner", description: "T&auml;gliche Fl&uuml;ssigkeit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gewohnheitsbildung-Rechner" lang="de" enSlug="habit-formation-calculator" keywords="gewohnheitsbildung, tage gewohnheit, lally modell, automatisierung, gewohnheitsserie, konsistenz, verhaltens&auml;nderung" breadcrumbs={[{ name: "Gewohnheitsbildung", url: "/de/gewohnheitsbildung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gewohnheitsbildung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie, wie viele Tage es dauert, ein Verhalten automatisch zu machen, basierend auf Lally et al. (2010).</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Komplexit&auml;t der Gewohnheit</label>
          <select id="gbde-complex" class="gbde-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="simple">Einfach (z.B. ein Glas Wasser trinken)</option>
            <option value="moderate">Mittel (z.B. 10-Min.-Spaziergang, Tagebuch)</option>
            <option value="complex">Komplex (z.B. 30-Min.-&Uuml;bung, Meditation)</option>
            <option value="very_complex">Sehr komplex (z.B. 1-Std.-Training, neue Di&auml;t)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Aktuelle Konsistenz (% der Tage diese Woche)</label>
          <input type="number" id="gbde-consist" class="gbde-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="100" step="5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Aktuelle Serie (aufeinanderfolgende Tage)</label>
          <input type="number" id="gbde-streak" class="gbde-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="365" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tage seit Beginn</label>
          <input type="number" id="gbde-days" class="gbde-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="365" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">St&auml;rke des Umgebungsreizes (1-10)</label>
          <input type="range" id="gbde-cue" class="gbde-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Schwach/zuf&auml;llig (1)</span><span>Stark/konsistent (10)</span></div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Gesch&auml;tzte Tage bis zur Automatisierung</div>
          <div class="text-2xl font-extrabold mt-1" id="gbde-target">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Automatisierungsgrad</div>
            <div class="text-xl font-bold text-text mt-1" id="gbde-auto">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Verbleibende Tage</div>
            <div class="text-xl font-bold text-text mt-1" id="gbde-remain">--</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Konsistenz-Bewertung</div>
            <div class="text-xl font-bold text-text mt-1" id="gbde-cscore">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Serien-Bonus</div>
            <div class="text-xl font-bold text-text mt-1" id="gbde-sbonus">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Tipps zum Aufbau dieser Gewohnheit</div>
          <div class="text-sm text-text" id="gbde-tips">--</div>
        </div>
      </div>

      <ShareButton calculatorId="habit-formation-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Gewohnheitsbildung verstehen</h2>
      <p>Laut Phillippa Lallys Forschung dauert es im Durchschnitt 66 Tage (Spanne 18&ndash;254 Tage), bis ein Verhalten automatisch wird. Die Dauer h&auml;ngt von der Komplexit&auml;t, Konsistenz und Umgebungsreizen ab.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Stimmt die 21-Tage-Regel?</strong> Nein, 21 Tage reichen nur f&uuml;r sehr einfache Gewohnheiten. Die Forschung zeigt 18&ndash;254 Tage.</p>
      <p><strong>Was passiert, wenn ich einen Tag auslasse?</strong> Ein einzelner Aussetzer verz&ouml;gert die Gewohnheitsbildung kaum. Vermeiden Sie nur, zweimal hintereinander auszusetzen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcGBDE() {
      const complexity = (document.getElementById('gbde-complex') as HTMLSelectElement).value;
      const consistency = parseFloat((document.getElementById('gbde-consist') as HTMLInputElement).value) || 70;
      const streak = parseInt((document.getElementById('gbde-streak') as HTMLInputElement).value) || 0;
      const daysIn = parseInt((document.getElementById('gbde-days') as HTMLInputElement).value) || 0;
      const cue = parseInt((document.getElementById('gbde-cue') as HTMLInputElement).value) || 5;

      const baseMap: Record<string, number> = {
        simple: 30, moderate: 66, complex: 120, very_complex: 200,
      };
      let baseDays = baseMap[complexity] || 66;

      const consistFactor = 1 + (100 - consistency) / 100 * 0.5;
      const cueFactor = 1 - (cue - 5) * 0.03;

      const targetDays = Math.round(baseDays * consistFactor * cueFactor);
      const remaining = Math.max(0, targetDays - daysIn);

      const autoRaw = daysIn > 0 ? Math.min(100, (daysIn / targetDays) * 100 * (consistency / 100)) : 0;
      const automaticity = autoRaw.toLocaleString('de-DE', { maximumFractionDigits: 1 });

      let streakBonus = 'Keiner';
      if (streak >= 21) streakBonus = 'Stark (+15 % Geschwindigkeit)';
      else if (streak >= 14) streakBonus = 'Gut (+10 % Geschwindigkeit)';
      else if (streak >= 7) streakBonus = 'Mittel (+5 % Geschwindigkeit)';
      else if (streak >= 3) streakBonus = 'Im Aufbau';

      let cLabel = '';
      if (consistency >= 90) cLabel = 'Ausgezeichnet';
      else if (consistency >= 70) cLabel = 'Gut';
      else if (consistency >= 50) cLabel = 'Befriedigend';
      else cLabel = 'Verbesserungsf\u00E4hig';

      document.getElementById('gbde-target')!.textContent = targetDays + ' Tage (Spanne: ' + Math.round(targetDays * 0.5) + '\u2013' + Math.round(targetDays * 1.5) + ')';
      document.getElementById('gbde-auto')!.textContent = automaticity + ' %';
      document.getElementById('gbde-remain')!.textContent = remaining > 0 ? remaining + ' Tage' : 'Wahrscheinlich gebildet!';
      document.getElementById('gbde-cscore')!.textContent = consistency + ' % \u2013 ' + cLabel;
      document.getElementById('gbde-sbonus')!.textContent = streakBonus;

      let tips: string[] = [];
      if (consistency < 70) tips.push('Konzentrieren Sie sich darauf, nie zweimal hintereinander auszusetzen. Einmal Aussetzen verz\u00F6gert die Gewohnheitsbildung kaum.');
      if (cue < 5) tips.push('Kn\u00FCpfen Sie Ihre Gewohnheit an eine bestehende Routine (Gewohnheits-Stapelung). Beispiel: "Nachdem ich meinen Kaffee eingie\u00DFe, werde ich..."');
      if (streak < 7) tips.push('Bauen Sie Ihre Serie auf. Schon 7 aufeinanderfolgende Tage erzeugen Schwung und neuronale Verst\u00E4rkung.');
      if (complexity === 'very_complex') tips.push('Bei komplexen Gewohnheiten beginnen Sie mit einer 2-Minuten-Version und steigern Sie langsam. Konsistenz ist wichtiger als Dauer.');
      if (autoRaw > 50) tips.push('Sie sind \u00FCber die H\u00E4lfte hinaus. Die Gewohnheit wird zunehmend automatisch. Weitermachen!');
      if (tips.length === 0) tips.push('Ausgezeichnete Bedingungen! Sie haben starke Reize, gute Konsistenz und machen soliden Fortschritt zur Automatisierung.');

      document.getElementById('gbde-tips')!.textContent = tips.join(' ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('gbde-consist') as HTMLInputElement).value = '70';
      (document.getElementById('gbde-streak') as HTMLInputElement).value = '5';
      (document.getElementById('gbde-days') as HTMLInputElement).value = '14';
      (document.getElementById('gbde-cue') as HTMLInputElement).value = '5';
      document.querySelectorAll('.gbde-in').forEach(el => {
        el.addEventListener('input', calcGBDE);
        el.addEventListener('change', calcGBDE);
      });
      calcGBDE();
    }, 50);
  </script>
</CalculatorLayout>
