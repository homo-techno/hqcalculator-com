---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Erdbebenstärke-Rechner - Magnitude, Energie & Intensität";
const description = "Berechnen Sie die Erdbebenstärke auf der Richterskala, die freigesetzte Energie in Joule und vergleichen Sie Magnituden miteinander.";

const relatedCalcs = [
  { name: "Energierechner", url: "/de/energierechner", description: "Energie berechnen." },
  { name: "Dezibel-Rechner", url: "/de/dezibel-rechner", description: "Lautstärke berechnen." },
  { name: "Kraftrechner", url: "/de/kraftrechner", description: "Kräfte berechnen." },
  { name: "Logarithmus-Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Erdbebenstärke-Rechner" lang="de" enSlug="earthquake-magnitude-calculator" keywords="erdbeben rechner, richterskala, magnitude, seismische energie, erdbebenstärke" breadcrumbs={[{ name: "Erdbebenstärke-Rechner", url: "/de/erdbebenstaerke-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Erdbebenst&auml;rke-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die freigesetzte Energie eines Erdbebens und vergleichen Sie verschiedene Magnituden miteinander.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Magnitude 1</label><input type="number" id="eqk-mag1" class="eqk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" max="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Magnitude 2 (Vergleich)</label><input type="number" id="eqk-mag2" class="eqk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0" max="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Freigesetzte Energie (Mag. 1)</div>
          <div class="text-4xl font-extrabold font-mono" id="eqk-result">0 J</div>
          <div class="text-sm text-blue-200 mt-1" id="eqk-class"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Energiefaktor</div><div class="text-xl font-bold" id="eqk-factor">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">TNT-&Auml;quivalent</div><div class="text-xl font-bold" id="eqk-tnt">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Intensit&auml;t (ca.)</div><div class="text-xl font-bold" id="eqk-intensity">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Amplitudenverh.</div><div class="text-xl font-bold" id="eqk-amp">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="eqk-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="earthquake-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Erdbebenst&auml;rke verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Energie (J) = 10^(1,5 &times; M + 4,8)</p>
        <p>Energiefaktor = 10^(1,5 &times; (M1 &minus; M2))</p>
        <p>Amplitudenverh. = 10^(M1 &minus; M2)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet eine Stufe mehr auf der Richterskala?</strong> Jede volle Stufe entspricht etwa der 31,6-fachen Energie und der 10-fachen Amplitude.</p>
      <p><strong>Ab welcher Magnitude wird ein Erdbeben gef&auml;hrlich?</strong> Ab ca. 5,0 k&ouml;nnen Sch&auml;den an Geb&auml;uden auftreten, ab 7,0 sind schwere Zerst&ouml;rungen m&ouml;glich.</p>
      <p><strong>Was ist der Unterschied zwischen Magnitude und Intensit&auml;t?</strong> Die Magnitude misst die freigesetzte Energie, die Intensit&auml;t beschreibt die sp&uuml;rbaren Auswirkungen vor Ort.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEqk() {
      const mag1 = parseFloat((document.getElementById('eqk-mag1') as HTMLInputElement).value) || 0;
      const mag2 = parseFloat((document.getElementById('eqk-mag2') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const energy1 = Math.pow(10, 1.5 * mag1 + 4.8);
      steps.push('Energie(M' + mag1 + ') = 10^(1,5 x ' + mag1 + ' + 4,8) = ' + energy1.toExponential(2) + ' J');
      const energy2 = Math.pow(10, 1.5 * mag2 + 4.8);
      steps.push('Energie(M' + mag2 + ') = ' + energy2.toExponential(2) + ' J');
      const factor = Math.pow(10, 1.5 * (mag1 - mag2));
      steps.push('Energiefaktor = 10^(1,5 x (' + mag1 + ' - ' + mag2 + ')) = ' + fmt(factor) + 'x');
      const ampRatio = Math.pow(10, mag1 - mag2);
      steps.push('Amplitudenverh. = 10^(' + mag1 + ' - ' + mag2 + ') = ' + fmt(ampRatio) + 'x');
      const tntKg = energy1 / 4.184e6;
      let tntStr = '';
      if (tntKg < 1000) tntStr = fmt(tntKg) + ' kg TNT';
      else if (tntKg < 1e6) tntStr = fmt(tntKg / 1000) + ' t TNT';
      else if (tntKg < 1e9) tntStr = fmt(tntKg / 1e6) + ' kt TNT';
      else tntStr = fmt(tntKg / 1e9) + ' Mt TNT';
      steps.push('TNT-Aequivalent = ' + tntStr);
      let classification = '';
      if (mag1 < 2) classification = 'Mikro';
      else if (mag1 < 4) classification = 'Leicht';
      else if (mag1 < 5) classification = 'Leicht spuerbar';
      else if (mag1 < 6) classification = 'Maessig';
      else if (mag1 < 7) classification = 'Stark';
      else if (mag1 < 8) classification = 'Schwer';
      else classification = 'Katastrophal';
      let intensity = '';
      if (mag1 < 2) intensity = 'I';
      else if (mag1 < 3) intensity = 'II-III';
      else if (mag1 < 4) intensity = 'IV-V';
      else if (mag1 < 5) intensity = 'VI-VII';
      else if (mag1 < 6) intensity = 'VII-VIII';
      else if (mag1 < 7) intensity = 'IX-X';
      else intensity = 'X-XII';
      document.getElementById('eqk-result')!.textContent = energy1.toExponential(2) + ' J';
      document.getElementById('eqk-class')!.textContent = classification;
      document.getElementById('eqk-factor')!.textContent = fmt(factor) + 'x';
      document.getElementById('eqk-tnt')!.textContent = tntStr;
      document.getElementById('eqk-intensity')!.textContent = intensity + ' (MMI)';
      document.getElementById('eqk-amp')!.textContent = fmt(ampRatio) + 'x';
      document.getElementById('eqk-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('eqk-mag1') as HTMLInputElement).value = '6.0';
      (document.getElementById('eqk-mag2') as HTMLInputElement).value = '5.0';
      document.querySelectorAll('.eqk-in').forEach(el => { el.addEventListener('input', calcEqk); el.addEventListener('change', calcEqk); });
      calcEqk();
    }, 50);
  </script>
</CalculatorLayout>
