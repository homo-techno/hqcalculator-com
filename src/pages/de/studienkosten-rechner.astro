---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Studienkosten-Rechner - Kosten für Studium planen";
const description = "Schätzen Sie die Gesamtkosten eines Studiums inkl. Semesterbeitrag, Lebenshaltung und Inflation. Erfahren Sie, wie viel Sie monatlich sparen sollten.";
const relatedCalcs = [
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "Zinseszins-Rechner", url: "/de/zinseszins-rechner", description: "Zinseszins." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Bildungssparen-Rechner", url: "/de/bildungssparen-rechner", description: "Bildungssparen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Studienkosten-Rechner" enSlug="college-cost-calculator" keywords="Studienkosten, Studium Kosten, Semesterbeitrag, Lebenshaltungskosten Student, Bildungskosten" breadcrumbs={[{ name: "Studienkosten-Rechner", url: "/de/studienkosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Studienkosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Gesamtkosten eines Studiums und erfahren Sie, wie viel Sie monatlich sparen müssen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jährliche Studiengebühren / Semesterbeitrag</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
              <input type="number" id="sk-tuition" class="w-full pl-12 pr-3 py-3 border border-border rounded-xl text-lg" value="600" min="0" step="100">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jährliche Lebenshaltungskosten (Miete, Essen etc.)</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
              <input type="number" id="sk-living" class="w-full pl-12 pr-3 py-3 border border-border rounded-xl text-lg" value="10800" min="0" step="500">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Jährl. Bücher & Material</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
              <input type="number" id="sk-books" class="w-full pl-12 pr-3 py-3 border border-border rounded-xl text-lg" value="500" min="0" step="50">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Studienjahre</label>
              <select id="sk-years" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
                <option value="3">3 Jahre (Bachelor)</option>
                <option value="5" selected>5 Jahre (Bachelor + Master)</option>
                <option value="6">6 Jahre</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Jahre bis Studienbeginn</label>
              <input type="number" id="sk-until" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="10" min="0" max="25" step="1">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Kosteninflation (%/Jahr)</label>
              <input type="number" id="sk-inflation" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="3" min="0" max="15" step="0.5">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Anlagerendite (%/Jahr)</label>
              <input type="number" id="sk-return" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="5" min="0" max="15" step="0.5">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktuelle Ersparnisse</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
              <input type="number" id="sk-savings" class="w-full pl-12 pr-3 py-3 border border-border rounded-xl text-lg" value="5000" min="0" step="500">
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Zukünftige Gesamtkosten</div>
            <div class="text-4xl sm:text-5xl font-extrabold" id="sk-total">0 EUR</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Kosten in heutigem EUR</div>
              <div class="text-xl font-bold" id="sk-today">0 EUR</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Ersparnisse wachsen auf</div>
              <div class="text-xl font-bold" id="sk-grown">0 EUR</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Finanzierungslücke</div>
              <div class="text-xl font-bold text-secondary" id="sk-gap">0 EUR</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Monatl. Sparrate</div>
              <div class="text-xl font-bold" id="sk-monthly">0 EUR</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">Kosten pro Studienjahr</h3>
            <div class="space-y-1 text-sm" id="sk-breakdown"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="studienkosten" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Studienkosten in Deutschland planen</h2>
      <p>Obwohl die meisten deutschen Hochschulen keine Studiengebühren erheben, fallen Semesterbeiträge (200-400 EUR) an. Die größten Kosten sind Miete, Lebenshaltung und Lernmaterial. Frühzeitiges Sparen mit einem ETF-Sparplan kann die finanzielle Belastung deutlich reduzieren.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const fmtEUR = (n: number) => Math.round(n).toLocaleString('de-DE') + ' EUR';

    function calcSK() {
      const tuition = parseFloat((document.getElementById('sk-tuition') as HTMLInputElement).value) || 0;
      const living = parseFloat((document.getElementById('sk-living') as HTMLInputElement).value) || 0;
      const books = parseFloat((document.getElementById('sk-books') as HTMLInputElement).value) || 0;
      const years = parseInt((document.getElementById('sk-years') as HTMLSelectElement).value) || 5;
      const until = parseInt((document.getElementById('sk-until') as HTMLInputElement).value) || 0;
      const inflation = (parseFloat((document.getElementById('sk-inflation') as HTMLInputElement).value) || 0) / 100;
      const returnRate = (parseFloat((document.getElementById('sk-return') as HTMLInputElement).value) || 0) / 100;
      const savings = parseFloat((document.getElementById('sk-savings') as HTMLInputElement).value) || 0;

      const annualCostToday = tuition + living + books;
      const totalToday = annualCostToday * years;

      let totalFuture = 0;
      const rows: string[] = [];
      rows.push('<div class="grid grid-cols-3 gap-1 font-semibold text-xs text-text-muted mb-1"><span>Jahr</span><span>Jahreskosten</span><span>Kumulativ</span></div>');

      for (let y = 0; y < years; y++) {
        const yearNum = until + y + 1;
        const cost = annualCostToday * Math.pow(1 + inflation, until + y);
        totalFuture += cost;
        rows.push('<div class="grid grid-cols-3 gap-1 text-xs"><span>Jahr ' + (y + 1) + ' (in ' + yearNum + ' J.)</span><span>' + fmtEUR(cost) + '</span><span>' + fmtEUR(totalFuture) + '</span></div>');
      }

      const savingsGrown = savings * Math.pow(1 + returnRate, until);
      const gap = Math.max(0, totalFuture - savingsGrown);

      const monthlyRate = returnRate / 12;
      const totalMonths = until * 12;
      let monthlySave = 0;
      if (totalMonths > 0 && monthlyRate > 0) {
        const fvFactor = (Math.pow(1 + monthlyRate, totalMonths) - 1) / monthlyRate;
        monthlySave = gap / fvFactor;
      } else if (totalMonths > 0) {
        monthlySave = gap / totalMonths;
      }

      document.getElementById('sk-total')!.textContent = fmtEUR(totalFuture);
      document.getElementById('sk-today')!.textContent = fmtEUR(totalToday);
      document.getElementById('sk-grown')!.textContent = fmtEUR(savingsGrown);
      document.getElementById('sk-gap')!.textContent = fmtEUR(gap);
      document.getElementById('sk-monthly')!.textContent = fmtEUR(monthlySave);
      document.getElementById('sk-breakdown')!.innerHTML = rows.join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['sk-tuition', 'sk-living', 'sk-books', 'sk-until', 'sk-inflation', 'sk-return', 'sk-savings'].forEach(id => {
        document.getElementById(id)!.addEventListener('input', calcSK);
      });
      document.getElementById('sk-years')!.addEventListener('change', calcSK);
      calcSK();
    }, 50);
  </script>
</CalculatorLayout>
