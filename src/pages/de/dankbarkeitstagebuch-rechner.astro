---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Dankbarkeitstagebuch-Rechner - Praxis-Impact & Konsistenz";
const description = "Verfolgen Sie Ihre Dankbarkeitstagebuch-Praxis. Berechnen Sie Impact-Score, Konsistenzbeurteilung, Wohlbefinden-Korrelation und empfohlene Häufigkeit.";
const relatedCalcs = [
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Noten berechnen." },
  { name: "Notendurchschnitt-Rechner", url: "/de/notendurchschnitt-rechner", description: "GPA berechnen." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies berechnen." },
  { name: "Glasfusing-Rechner", url: "/de/glasfusing-rechner", description: "Glasfusing-Brennpläne." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "GPS-Genauigkeit-Rechner", url: "/de/gps-genauigkeit-rechner", description: "GPS-Genauigkeit." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Dankbarkeitstagebuch-Rechner" enSlug="gratitude-journal-calculator" keywords="Dankbarkeitstagebuch, Dankbarkeitspraxis, Wohlbefinden, positive Psychologie, Dankbarkeits-Impact, Journaling" breadcrumbs={[{ name: "Dankbarkeitstagebuch-Rechner", url: "/de/dankbarkeitstagebuch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dankbarkeitstagebuch-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie den Einfluss Ihrer Dankbarkeitspraxis basierend auf Forschungsergebnissen der positiven Psychologie.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Wie oft pro Woche führen Sie ein Dankbarkeitstagebuch?</label>
          <input type="number" id="dtb-freq" class="dtb-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="14" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Einträge pro Sitzung (Dinge, die Sie notieren)</label>
          <input type="number" id="dtb-items" class="dtb-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="20" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Wochen der Praxis</label>
          <input type="number" id="dtb-weeks" class="dtb-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="520" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tiefe der Reflexion (1-10)</label>
          <input type="range" id="dtb-depth" class="dtb-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Schnelle Liste (1)</span><span>Tiefe Reflexion (10)</span></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Aktuelle Lebenszufriedenheit (1-10)</label>
          <input type="range" id="dtb-satis" class="dtb-in w-full" min="1" max="10" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Sehr gering (1)</span><span>Sehr hoch (10)</span></div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Dankbarkeitspraxis Impact-Score</div>
          <div class="text-2xl font-extrabold mt-1" id="dtb-impact">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Konsistenzbewertung</div>
            <div class="text-xl font-bold text-text mt-1" id="dtb-consist">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Wohlbefinden-Korrelation</div>
            <div class="text-xl font-bold text-text mt-1" id="dtb-wellbeing">--</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Gesamt notierte Einträge</div>
            <div class="text-xl font-bold text-text mt-1" id="dtb-total">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Empfohlene Häufigkeit</div>
            <div class="text-xl font-bold text-text mt-1" id="dtb-rec">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Forschungsbasierte Erkenntnisse</div>
          <div class="text-sm text-text" id="dtb-insights">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="gratitude-journal" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dankbarkeitstagebuch und Wohlbefinden</h2>
      <p>Forschungen von Emmons und McCullough (2003) zeigen, dass regelmäßiges Dankbarkeits-Journaling das subjektive Wohlbefinden um 10-25% verbessern kann. Die optimale Häufigkeit liegt bei 3 Mal pro Woche. Tägliches Schreiben kann den Effekt durch Gewöhnung abschwächen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viele Einträge pro Sitzung?</strong> Studien empfehlen 3-5 spezifische Einträge. Qualität schlägt Quantität - erklären Sie, warum Sie dankbar sind.</p>
      <p><strong>Ab wann spüre ich Verbesserungen?</strong> Erste Effekte sind nach 3-4 Wochen messbar. Nach 8 Wochen zeigen sich signifikante Verbesserungen bei Schlafqualität und Stimmung.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcDTB() {
      const freq = parseInt((document.getElementById('dtb-freq') as HTMLInputElement).value) || 3;
      const items = parseInt((document.getElementById('dtb-items') as HTMLInputElement).value) || 3;
      const weeks = parseInt((document.getElementById('dtb-weeks') as HTMLInputElement).value) || 4;
      const depth = parseInt((document.getElementById('dtb-depth') as HTMLInputElement).value) || 5;
      const satis = parseInt((document.getElementById('dtb-satis') as HTMLInputElement).value) || 5;

      const totalItems = freq * items * weeks;

      let consistLabel = '';
      if (freq >= 5) consistLabel = 'Ausgezeichnet (täglich+)';
      else if (freq >= 3) consistLabel = 'Gut (3+/Woche)';
      else if (freq >= 1) consistLabel = 'Ausreichend (1-2/Woche)';
      else consistLabel = 'Nicht praktiziert';

      const freqScore = freq === 0 ? 0 : Math.min(30, freq * 8);
      const itemScore = Math.min(20, items * 5);
      const weekScore = Math.min(25, weeks * 1.5);
      const depthScore = depth * 2.5;
      const impactScore = Math.round(Math.min(100, freqScore + itemScore + weekScore + depthScore));

      const correlation = freq > 0 ? Math.min(0.5, 0.1 + (impactScore / 100) * 0.4) : 0;
      let wbLabel = '';
      if (correlation >= 0.4) wbLabel = 'Starke positive Korrelation';
      else if (correlation >= 0.25) wbLabel = 'Mäßige positive Korrelation';
      else if (correlation >= 0.1) wbLabel = 'Leichte positive Korrelation';
      else wbLabel = 'Keine Korrelation (nicht praktiziert)';

      let recFreq = '3 Mal pro Woche';
      if (freq >= 7) recFreq = '3-5x/Woche erwägen (täglich kann Neuheit mindern)';
      else if (freq >= 3) recFreq = 'Ihre Häufigkeit liegt im optimalen Bereich';
      else recFreq = '3 Mal pro Woche (forschungsoptimal)';

      document.getElementById('dtb-impact')!.textContent = impactScore + ' / 100';
      document.getElementById('dtb-consist')!.textContent = consistLabel;
      document.getElementById('dtb-wellbeing')!.textContent = wbLabel;
      document.getElementById('dtb-total')!.textContent = totalItems.toLocaleString('de-DE') + ' Einträge';
      document.getElementById('dtb-rec')!.textContent = recFreq;

      const insights: string[] = [];
      if (freq > 5) insights.push('Lyubomirsky (2005) fand, dass 1-3x/Woche effektiver sein kann als täglich, da die Praxis nicht zur Routine wird.');
      if (items < 3) insights.push('Streben Sie 3-5 Einträge pro Sitzung an. Spezifität ist wichtiger als Quantität.');
      if (depth < 5) insights.push('Tiefere Reflexion erhöht die Wirkung. Erklären Sie, warum Sie dankbar sind und wie es Ihr Leben beeinflusst.');
      if (weeks < 4) insights.push('Vorteile werden nach 3-4 Wochen konsistenter Praxis messbar. Weiter so!');
      if (weeks >= 8) insights.push('Nach 8+ Wochen verbessert Dankbarkeits-Journaling nachweislich Schlafqualität und soziales Verhalten.');
      if (satis < 5) insights.push('Menschen mit niedrigerer Ausgangszufriedenheit profitieren oft am stärksten (Emmons & McCullough, 2003).');
      if (insights.length === 0) insights.push('Ihre Dankbarkeitspraxis ist gut strukturiert. Forschungen zeigen 10-25% Verbesserung der Lebenszufriedenheit.');

      document.getElementById('dtb-insights')!.textContent = insights.join(' ');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('dtb-freq') as HTMLInputElement).value = '3';
      (document.getElementById('dtb-items') as HTMLInputElement).value = '3';
      (document.getElementById('dtb-weeks') as HTMLInputElement).value = '4';
      (document.getElementById('dtb-depth') as HTMLInputElement).value = '5';
      (document.getElementById('dtb-satis') as HTMLInputElement).value = '5';
      document.querySelectorAll('.dtb-in').forEach(el => {
        el.addEventListener('input', calcDTB);
        el.addEventListener('change', calcDTB);
      });
      calcDTB();
    }, 50);
  </script>
</CalculatorLayout>
