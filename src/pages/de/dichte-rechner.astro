---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Dichte-Rechner - Masse, Volumen & Dichte";
const description = "Berechnen Sie Dichte, Masse oder Volumen mit der Dichteformel. Inklusive Tabelle mit g\u00e4ngigen Materialdichten.";

const relatedCalcs = [
  { name: "Volumenrechner", url: "/de/volumen-rechner", description: "3D-Volumen." },
  { name: "Gewichtsumrechner", url: "/de/gewichts-umrechner", description: "Gewichtseinheiten." },
  { name: "Kraftrechner", url: "/de/kraft-rechner", description: "Kraft." },
  { name: "Druckumrechner", url: "/de/druck-umrechner", description: "Druckeinheiten." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="density-calculator" calculatorName="Dichte-Rechner" keywords="dichte rechner, masse volumen dichte, dichteformel, spezifisches gewicht, materialdichte" breadcrumbs={[{ name: "Dichte-Rechner", url: "/de/dichte-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dichte-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Dichte, Masse oder Volumen &mdash; geben Sie zwei Werte ein, um den dritten zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Berechnen</label><select id="dic-solve" class="w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="density" selected>Dichte</option><option value="mass">Masse</option><option value="volume">Volumen</option></select></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Masse (kg)</label><input type="number" id="dic-m" class="dic-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Volumen (m&sup3;)</label><input type="number" id="dic-v" class="dic-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.5" min="0" step="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="dic-label">Dichte</div>
          <div class="text-4xl font-extrabold font-mono" id="dic-result">0</div>
          <div class="text-sm text-blue-200 mt-1" id="dic-unit">kg/m&sup3;</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">G&auml;ngige Materialdichten (kg/m&sup3;)</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Wasser</span><span class="font-bold">1.000</span></div>
            <div class="flex justify-between"><span>Stahl</span><span class="font-bold">7.850</span></div>
            <div class="flex justify-between"><span>Aluminium</span><span class="font-bold">2.700</span></div>
            <div class="flex justify-between"><span>Gold</span><span class="font-bold">19.300</span></div>
            <div class="flex justify-between"><span>Beton</span><span class="font-bold">2.400</span></div>
            <div class="flex justify-between"><span>Holz (Eiche)</span><span class="font-bold">750</span></div>
            <div class="flex justify-between"><span>Luft (Meeresniveau)</span><span class="font-bold">1,225</span></div>
            <div class="flex justify-between"><span>Eis</span><span class="font-bold">917</span></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="density" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dichteformel</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Dichte</strong> = Masse / Volumen</p>
        <p><strong>Masse</strong> = Dichte &times; Volumen</p>
        <p><strong>Volumen</strong> = Masse / Dichte</p>
      </div>
      <p>Die Dichte beschreibt, wie viel Masse pro Volumeneinheit ein Material hat. Sie wird in kg/m&sup3; oder g/cm&sup3; angegeben. Die Dichte ist eine wichtige physikalische Eigenschaft, die bestimmt, ob ein Stoff in einem anderen schwimmt oder sinkt.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Dichte und spezifischem Gewicht?</strong> Das spezifische Gewicht ist das Verh&auml;ltnis der Dichte eines Stoffes zur Dichte von Wasser (1.000 kg/m&sup3;). Es ist dimensionslos.</p>
      <p><strong>Wie &auml;ndert sich die Dichte mit der Temperatur?</strong> Die meisten Stoffe dehnen sich bei Erw&auml;rmung aus, wodurch ihre Dichte sinkt. Wasser hat seine h&ouml;chste Dichte bei 4 &deg;C (Dichteanomalie).</p>
      <p><strong>Warum schwimmt Eis auf Wasser?</strong> Eis hat eine geringere Dichte (917 kg/m&sup3;) als fl&uuml;ssiges Wasser (1.000 kg/m&sup3;), da sich Wasser beim Gefrieren ausdehnt.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcDIC() {
      const solve = (document.getElementById('dic-solve') as HTMLSelectElement).value;
      const m = parseFloat((document.getElementById('dic-m') as HTMLInputElement).value) || 0;
      const v = parseFloat((document.getElementById('dic-v') as HTMLInputElement).value) || 0;
      let result: number;
      if (solve === 'density') {
        result = v > 0 ? m / v : 0;
        document.getElementById('dic-label')!.textContent = 'Dichte';
        document.getElementById('dic-unit')!.textContent = 'kg/m\u00b3';
      } else if (solve === 'mass') {
        const d = m;
        result = d * v;
        document.getElementById('dic-label')!.textContent = 'Masse';
        document.getElementById('dic-unit')!.textContent = 'kg';
      } else {
        const d = m;
        result = d > 0 ? v / d : 0;
        document.getElementById('dic-label')!.textContent = 'Volumen';
        document.getElementById('dic-unit')!.textContent = 'm\u00b3';
      }
      document.getElementById('dic-result')!.textContent = result.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dic-in').forEach(el => el.addEventListener('input', calcDIC));
      document.getElementById('dic-solve')!.addEventListener('change', calcDIC);
      calcDIC();
    }, 50);
  </script>
</CalculatorLayout>
