---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Frequenz-Rechner - Hz, kHz, MHz, GHz & Periode";
const description = "Rechnen Sie zwischen Frequenzeinheiten um und berechnen Sie Periode, Wellenl\u00E4nge und Kreisfrequenz.";
const relatedCalcs = [
  { name: "Wellenl\u00E4ngen-Rechner", url: "/de/wellenlaengen-rechner", description: "Wellenl\u00E4nge." },
  { name: "Ohmsches Gesetz", url: "/de/ohmsches-gesetz-rechner", description: "Elektrotechnik." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Wissenschaftlich." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Frequenz-Rechner" lang="de" enSlug="frequency-calculator" keywords="frequenz rechner, hertz, kHz, MHz, GHz, periode, kreisfrequenz, frequenz zu wellenl\u00E4nge" breadcrumbs={[{ name: "Frequenz", url: "/de/frequenz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Frequenz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Frequenzeinheiten umrechnen und Periode sowie Wellenl&auml;nge berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Frequenzwert</label><input type="number" id="frq-val" class="frq-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="440" step="any" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einheit</label><select id="frq-unit" class="frq-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="Hz" selected>Hertz (Hz)</option>
            <option value="kHz">Kilohertz (kHz)</option>
            <option value="MHz">Megahertz (MHz)</option>
            <option value="GHz">Gigahertz (GHz)</option>
            <option value="rpm">U/min</option>
            <option value="rads">rad/s</option>
          </select></div>
        </div>
        <div class="flex gap-2 flex-wrap">
          <button class="frq-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-f="440" data-u="Hz">Kammerton A4 (440 Hz)</button>
          <button class="frq-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-f="2.4" data-u="GHz">WLAN 2,4 GHz</button>
          <button class="frq-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-f="50" data-u="Hz">Netzfrequenz 50 Hz</button>
          <button class="frq-preset px-3 py-1 rounded-full text-xs border border-border font-bold hover:bg-blue-50" data-f="98.5" data-u="MHz">UKW-Radio</button>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Frequenz</div>
          <div class="text-4xl font-extrabold font-mono" id="frq-hz">0</div>
          <div class="text-sm text-blue-200 mt-1">Hz</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Periode</div><div class="text-xl font-bold font-mono" id="frq-period">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kreisfrequenz (&omega;)</div><div class="text-xl font-bold font-mono" id="frq-omega">0 rad/s</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wellenl&auml;nge (Licht)</div><div class="text-xl font-bold font-mono" id="frq-wl">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wellenl&auml;nge (Schall)</div><div class="text-xl font-bold font-mono" id="frq-ws">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="frq-units"></div>
      </div>
      <ShareButton lang="de" calculatorId="frequency-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Frequenz und Wellenl&auml;nge</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Periode T = 1 / f</p>
        <p>Kreisfrequenz &omega; = 2&pi; &times; f</p>
        <p>Wellenl&auml;nge &lambda; = c / f</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die Frequenz?</strong> Die Frequenz gibt an, wie oft ein periodisches Ereignis pro Sekunde stattfindet. Die Einheit ist Hertz (Hz).</p>
      <p><strong>Warum hat Europa 50 Hz Netzfrequenz?</strong> In Europa wurde 50 Hz als Standard gew&auml;hlt, da dies einen guten Kompromiss zwischen Effizienz und Sicherheit darstellt.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const frqFactors: Record<string, number> = { Hz: 1, kHz: 1e3, MHz: 1e6, GHz: 1e9, rpm: 1/60, rads: 1/(2*Math.PI) };
    function frqFmtSI(val: number, unit: string): string {
      if (val === 0) return '0 ' + unit;
      const prefixes = [['T',1e12],['G',1e9],['M',1e6],['k',1e3],['',1],['m',1e-3],['\u00B5',1e-6],['n',1e-9],['p',1e-12]] as [string,number][];
      for (const [p, f] of prefixes) {
        if (Math.abs(val) >= f * 0.999) return (val / f).toLocaleString('de-DE', {minimumFractionDigits:4, maximumFractionDigits:4}) + ' ' + p + unit;
      }
      return val.toExponential(4) + ' ' + unit;
    }
    function calcFRQ() {
      const val = parseFloat((document.getElementById('frq-val') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('frq-unit') as HTMLSelectElement).value;
      const hz = val * frqFactors[unit];
      document.getElementById('frq-hz')!.textContent = hz >= 1e6 ? hz.toExponential(6) : hz.toLocaleString('de-DE', { maximumFractionDigits: 4 });
      const period = hz > 0 ? 1 / hz : 0;
      document.getElementById('frq-period')!.textContent = frqFmtSI(period, 's');
      document.getElementById('frq-omega')!.textContent = (2 * Math.PI * hz).toLocaleString('de-DE', {minimumFractionDigits:4, maximumFractionDigits:4}) + ' rad/s';
      const c = 299792458;
      const wl = hz > 0 ? c / hz : 0;
      document.getElementById('frq-wl')!.textContent = frqFmtSI(wl, 'm');
      const vsound = 343;
      const ws = hz > 0 ? vsound / hz : 0;
      document.getElementById('frq-ws')!.textContent = frqFmtSI(ws, 'm');
      const units = document.getElementById('frq-units')!;
      const conversions: [string, string, number][] = [
        ['kHz', 'kHz', hz / 1e3], ['MHz', 'MHz', hz / 1e6], ['GHz', 'GHz', hz / 1e9],
        ['U/min', 'RPM', hz * 60], ['rad/s', 'rad/s', hz * 2 * Math.PI], ['BPM', 'BPM', hz * 60],
      ];
      units.innerHTML = conversions.map(([label, , v]) =>
        '<div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">' + label + '</div><div class="text-lg font-bold font-mono">' + (Math.abs(v) < 0.001 || Math.abs(v) >= 1e9 ? v.toExponential(4) : v.toLocaleString('de-DE', {minimumFractionDigits:4, maximumFractionDigits:4})) + '</div></div>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.frq-in').forEach(el => { el.addEventListener('input', calcFRQ); el.addEventListener('change', calcFRQ); });
      document.querySelectorAll('.frq-preset').forEach(btn => btn.addEventListener('click', () => {
        (document.getElementById('frq-val') as HTMLInputElement).value = (btn as HTMLElement).dataset.f!;
        (document.getElementById('frq-unit') as HTMLSelectElement).value = (btn as HTMLElement).dataset.u!;
        calcFRQ();
      }));
      calcFRQ();
    }, 50);
  </script>
</CalculatorLayout>
