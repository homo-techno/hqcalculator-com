---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Backumrechnungsrechner - Tassen, Gramm, ml & mehr";
const description = "Rechnen Sie zwischen Tassen, Esslöffel, Teelöffel, Milliliter und Gramm für gängige Backzutaten wie Mehl, Zucker und Butter um.";
const relatedCalcs = [
  { name: "Sauerteigrechner", url: "/de/sauerteig-rechner", description: "Sauerteig-Zutatenmengen." },
  { name: "Heferechner", url: "/de/hefe-rechner", description: "Zwischen Hefearten umrechnen." },
  { name: "Kaffee-Verhältnisrechner", url: "/de/kaffee-verhaeltnis-rechner", description: "Perfekte Kaffee-Wasser-Verhältnisse." },
  { name: "Meal-Prep-Rechner", url: "/de/meal-prep-rechner", description: "Wöchentliche Mengenplanung." },
  { name: "Lebensmittelkosten-Rechner", url: "/de/lebensmittelkosten-rechner", description: "Restaurantkosten berechnen." },
  { name: "Einmach-Rechner", url: "/de/einmach-rechner", description: "Einmachgläserbedarf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Backumrechnungsrechner" keywords="Backumrechnung, Tassen in Gramm, Esslöffel in ml, Backmaße, Mehl Gramm, Zuckerumrechnung" breadcrumbs={[{ name: "Backumrechnung", url: "/de/backumrechnung-rechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Backumrechnungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen Tassen, Esslöffeln, Teelöffeln, Millilitern und Gramm für gängige Backzutaten um.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Zutat</label>
          <select id="bk2-ingredient" class="bk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="allpurpose">Weizenmehl (Type 405)</option>
            <option value="bread">Brotmehl (Type 550)</option>
            <option value="cake">Kuchenmehl</option>
            <option value="sugar">Kristallzucker</option>
            <option value="brown">Brauner Zucker</option>
            <option value="powdered">Puderzucker</option>
            <option value="butter">Butter</option>
            <option value="milk">Milch</option>
            <option value="honey">Honig</option>
            <option value="cocoa">Kakaopulver</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Menge</label>
            <input type="number" id="bk2-amount" class="bk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="bk2-unit" class="bk2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="grams" selected>Gramm</option>
              <option value="cups">Tassen (US)</option>
              <option value="tbsp">Esslöffel</option>
              <option value="tsp">Teelöffel</option>
              <option value="ml">Milliliter</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gramm</div>
          <div class="text-5xl font-extrabold font-mono" id="bk2-result">0 g</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tassen (US)</div><div class="text-xl font-bold font-mono" id="bk2-cups">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Esslöffel</div><div class="text-xl font-bold font-mono" id="bk2-tbsp">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Teelöffel</div><div class="text-xl font-bold font-mono" id="bk2-tsp">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Milliliter</div><div class="text-xl font-bold font-mono" id="bk2-ml">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Unzen</div><div class="text-xl font-bold font-mono" id="bk2-oz">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="baking-conversion" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBK2() {
      const gpCup: Record<string, number> = {
        allpurpose: 125, bread: 130, cake: 114, sugar: 200,
        brown: 220, powdered: 120, butter: 227, milk: 244,
        honey: 340, cocoa: 86
      };
      const ingredient = (document.getElementById('bk2-ingredient') as HTMLSelectElement).value;
      const amount = parseFloat((document.getElementById('bk2-amount') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('bk2-unit') as HTMLSelectElement).value;
      const gpc = gpCup[ingredient] || 125;
      let grams = 0;
      if (unit === 'cups') grams = amount * gpc;
      else if (unit === 'tbsp') grams = amount * (gpc / 16);
      else if (unit === 'tsp') grams = amount * (gpc / 48);
      else if (unit === 'ml') grams = amount * (gpc / 236.588);
      else if (unit === 'grams') grams = amount;
      const cups = grams / gpc;
      const tbsp = cups * 16;
      const tsp = cups * 48;
      const ml = cups * 236.588;
      const oz = grams / 28.3495;
      document.getElementById('bk2-result')!.textContent = grams.toFixed(1).replace('.', ',') + ' g';
      document.getElementById('bk2-cups')!.textContent = cups.toFixed(2).replace('.', ',');
      document.getElementById('bk2-tbsp')!.textContent = tbsp.toFixed(1).replace('.', ',');
      document.getElementById('bk2-tsp')!.textContent = tsp.toFixed(1).replace('.', ',');
      document.getElementById('bk2-ml')!.textContent = ml.toFixed(1).replace('.', ',');
      document.getElementById('bk2-oz')!.textContent = oz.toFixed(2).replace('.', ',');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bk2-in').forEach(el => { el.addEventListener('input', calcBK2); el.addEventListener('change', calcBK2); });
      calcBK2();
    }, 50);
  </script>
</CalculatorLayout>
