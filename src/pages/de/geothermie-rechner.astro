---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Geothermie-Rechner - Systemgr\u00F6\u00DFe, Kosten & Amortisation";
const description = "Geothermische W\u00E4rmepumpe dimensionieren: Systemgr\u00F6\u00DFe, Rohrl\u00E4nge, Installationskosten, j\u00E4hrliche Einsparungen und Amortisationszeit f\u00FCr Ihr Zuhause berechnen.";
const relatedCalcs = [
  { name: "W\u00E4rmepumpen-Rechner", url: "/de/waermepumpen-rechner", description: "Luft-Wasser-W\u00E4rmepumpen." },
  { name: "Solarpanel-Rechner", url: "/de/solarpanel-rechner", description: "Solarenergie." },
  { name: "Stromkosten-Rechner", url: "/de/stromkostenrechner", description: "Stromkosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Geothermie-Rechner" lang="de" enSlug="geothermal-calculator" keywords="geothermie rechner, erdw\u00E4rmepumpe, sole erdkollektor, erdw\u00E4rme kosten, geothermische heizung, erdw\u00E4rme einsparungen" breadcrumbs={[{ name: "Geothermie", url: "/de/geothermie-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Geothermie-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geothermisches System dimensionieren, Kosten und Return on Investment sch&auml;tzen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wohnfl&auml;che (m&sup2;)</label><input type="number" id="geo-sqm" class="geo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="50" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Heizlast (W)</label><input type="number" id="geo-heat" class="geo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15000" min="3000" step="1000"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">K&uuml;hllast (W)</label><input type="number" id="geo-cool" class="geo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12000" min="3000" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bodentemperatur (&deg;C)</label><input type="number" id="geo-temp" class="geo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="5" max="20" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Kollektortyp</label>
            <select id="geo-loop" class="geo-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="horizontal">Horizontalkollektor (Fl&auml;chenkollektor)</option>
              <option value="vertical" selected>Vertikalkollektor (Erdsonde)</option>
              <option value="pond">Teich-/Seesole</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelle Heiz-+K&uuml;hlkosten (&euro;/Jahr)</label><input type="number" id="geo-current" class="geo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="0" step="100"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Strompreis (&euro;/kWh)</label><input type="number" id="geo-elec" class="geo-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.35" min="0.01" step="0.01"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Systemgr&ouml;&szlig;e</div>
          <div class="text-5xl font-extrabold font-mono" id="geo-tons">0</div>
          <div class="text-sm text-blue-200 mt-1">kW Leistung</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rohrl&auml;nge</div><div class="text-xl font-bold" id="geo-length">0 m</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Installationskosten</div><div class="text-xl font-bold" id="geo-install">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Einsparung</div><div class="text-xl font-bold" id="geo-savings">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Amortisation</div><div class="text-xl font-bold" id="geo-payback">0 Jahre</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nach 35% F&ouml;rderung (BEG)</div><div class="text-xl font-bold" id="geo-credit">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrl. Betriebskosten</div><div class="text-xl font-bold" id="geo-opcost">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="geothermal" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Geothermische Energiesysteme</h2>
      <p>Erdw&auml;rmepumpen nutzen die konstante Bodentemperatur (8-12&deg;C in Deutschland) zum Heizen und K&uuml;hlen bei 300-500% Effizienz. Vertikalsonden ben&ouml;tigen etwa 50-60 m Bohrtiefe pro kW. Die BEG-F&ouml;rderung (35%) reduziert die Installationskosten erheblich. Systeme halten 25-50 Jahre.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel spart eine Erdw&auml;rmepumpe?</strong> Im Vergleich zu Gasheizung bis zu 50-60% der Heizkosten, abh&auml;ngig von Strompreis und COP-Wert der W&auml;rmepumpe.</p>
      <p><strong>Welche F&ouml;rderungen gibt es?</strong> Das Bundesamt f&uuml;r Wirtschaft und Ausfuhrkontrolle (BAFA) gew&auml;hrt &uuml;ber die BEG bis zu 35% F&ouml;rderung f&uuml;r Erdw&auml;rmepumpen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGEO() {
      const sqm = parseFloat((document.getElementById('geo-sqm') as HTMLInputElement).value) || 200;
      const heatLoad = parseFloat((document.getElementById('geo-heat') as HTMLInputElement).value) || 15000;
      const coolLoad = parseFloat((document.getElementById('geo-cool') as HTMLInputElement).value) || 12000;
      const groundTemp = parseFloat((document.getElementById('geo-temp') as HTMLInputElement).value) || 10;
      const loopType = (document.getElementById('geo-loop') as HTMLSelectElement).value;
      const currentCost = parseFloat((document.getElementById('geo-current') as HTMLInputElement).value) || 3000;
      const elecRate = parseFloat((document.getElementById('geo-elec') as HTMLInputElement).value) || 0.35;
      const maxLoad = Math.max(heatLoad, coolLoad);
      const kw = maxLoad / 1000;
      const loopPerKw: Record<string, number> = { horizontal: 50, vertical: 18, pond: 30 };
      const loopLength = Math.round(kw * (loopPerKw[loopType] || 18));
      const costPerKw: Record<string, number> = { horizontal: 1200, vertical: 1800, pond: 1400 };
      const installCost = Math.round(kw * (costPerKw[loopType] || 1800));
      const afterCredit = Math.round(installCost * 0.65);
      const cop = 4.0;
      const annualBTU = (heatLoad * 1500 + coolLoad * 800);
      const annualKWh = annualBTU / cop / 3412;
      const annualOpCost = Math.round(annualKWh * elecRate);
      const annualSavings = Math.max(0, currentCost - annualOpCost);
      const payback = annualSavings > 0 ? (afterCredit / annualSavings) : 99;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      document.getElementById('geo-tons')!.textContent = kw.toFixed(1);
      document.getElementById('geo-length')!.textContent = loopLength.toLocaleString('de-DE') + ' m';
      document.getElementById('geo-install')!.textContent = fmt(installCost) + ' \u20AC';
      document.getElementById('geo-savings')!.textContent = fmt(annualSavings) + ' \u20AC';
      document.getElementById('geo-payback')!.textContent = payback.toFixed(1) + ' Jahre';
      document.getElementById('geo-credit')!.textContent = fmt(afterCredit) + ' \u20AC';
      document.getElementById('geo-opcost')!.textContent = fmt(annualOpCost) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.geo-in').forEach(el => { el.addEventListener('input', calcGEO); el.addEventListener('change', calcGEO); }); calcGEO(); }, 50);
  </script>
</CalculatorLayout>
