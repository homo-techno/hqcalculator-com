---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ernteertrag-Rechner - Umsatz & Gewinnmarge berechnen";
const description = "Schaetzen Sie den erwarteten Ernteertrag, Umsatz, Produktionskosten und die Gewinnmarge fuer Ihre landwirtschaftlichen Betriebe.";
const relatedCalcs = [
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Gewinnmargenrechner", url: "/de/gewinnmargenrechner", description: "Gewinnmargen." },
  { name: "Flaechenrechner", url: "/de/flaechenrechner", description: "Flaechen berechnen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitte." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Ernteertrag-Rechner" keywords="Ernteertrag Rechner, Landwirtschaft Umsatz, Gewinnmarge, Ertrag pro Hektar, Produktionskosten" breadcrumbs={[{ name: "Ernteertrag-Rechner", url: "/de/ernteertrag-rechner" }]} lang="de" enSlug="crop-yield-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ernteertrag-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie Ertrag, Umsatz, Kosten und Gewinnmarge fuer Ihre Kulturen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kulturart</label>
          <select id="eer-crop" class="eer-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="8.5|180|600">Weizen (8,5 t/ha, 180 EUR/t)</option>
            <option value="10|170|650">Mais (10 t/ha, 170 EUR/t)</option>
            <option value="3.5|450|550">Raps (3,5 t/ha, 450 EUR/t)</option>
            <option value="7|200|580">Gerste (7 t/ha, 200 EUR/t)</option>
            <option value="45|90|700">Kartoffeln (45 t/ha, 90 EUR/t)</option>
            <option value="70|35|800">Zuckerrueben (70 t/ha, 35 EUR/t)</option>
            <option value="3|380|500">Sonnenblumen (3 t/ha, 380 EUR/t)</option>
            <option value="2.5|500|520">Sojabohnen (2,5 t/ha, 500 EUR/t)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anbauflaeche (ha)</label>
            <input type="number" id="eer-acres" class="eer-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="50" min="1" max="10000" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ertragsanpassung (%)</label>
            <input type="number" id="eer-adj" class="eer-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="10" max="150" step="5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Saatgutkosten (EUR/ha)</label>
            <input type="number" id="eer-seed" class="eer-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="0" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Duengerkosten (EUR/ha)</label>
            <input type="number" id="eer-fert" class="eer-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="180" min="0" step="5">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Pflanzenschutz (EUR/ha)</label>
            <input type="number" id="eer-chem" class="eer-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="0" step="5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Sonstige Kosten (EUR/ha)</label>
            <input type="number" id="eer-other" class="eer-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" step="5">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nettogewinn</div>
          <div class="text-5xl font-extrabold font-mono" id="eer-profit">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtertrag</div>
            <div class="text-xl font-bold font-mono" id="eer-yield">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bruttoumsatz</div>
            <div class="text-xl font-bold font-mono" id="eer-revenue">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewinnmarge</div>
            <div class="text-xl font-bold font-mono" id="eer-margin">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtkosten</div>
            <div class="text-xl font-bold font-mono" id="eer-costs">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewinn pro ha</div>
            <div class="text-xl font-bold font-mono" id="eer-peracre">--</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="crop-yield" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Ernteertrag berechnen</h2>
      <p>Die Rentabilitaet Ihres landwirtschaftlichen Betriebs haengt von vielen Faktoren ab: Kulturart, Bodenqualitaet, Wetter und Betriebsmittelkosten. Dieser Rechner hilft Ihnen bei der Planung und Bewertung verschiedener Szenarien.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcEER() {
      const cropData = (document.getElementById('eer-crop') as HTMLSelectElement).value.split('|');
      const baseYield = parseFloat(cropData[0]);
      const pricePerUnit = parseFloat(cropData[1]);
      const defaultOps = parseFloat(cropData[2]);
      const hectares = parseFloat((document.getElementById('eer-acres') as HTMLInputElement).value) || 50;
      const adj = parseFloat((document.getElementById('eer-adj') as HTMLInputElement).value) || 100;
      const seedCost = parseFloat((document.getElementById('eer-seed') as HTMLInputElement).value) || 0;
      const fertCost = parseFloat((document.getElementById('eer-fert') as HTMLInputElement).value) || 0;
      const chemCost = parseFloat((document.getElementById('eer-chem') as HTMLInputElement).value) || 0;
      const otherCost = parseFloat((document.getElementById('eer-other') as HTMLInputElement).value) || 0;
      const actualYield = baseYield * (adj / 100);
      const totalYield = actualYield * hectares;
      const revenue = totalYield * pricePerUnit;
      const costPerHa = seedCost + fertCost + chemCost + otherCost;
      const totalCosts = costPerHa * hectares;
      const profit = revenue - totalCosts;
      const margin = revenue > 0 ? (profit / revenue) * 100 : 0;
      const profitPerHa = profit / hectares;
      const fmtEUR = (v: number) => (v >= 0 ? '' : '-') + Math.abs(Math.round(v)).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('eer-profit')!.textContent = fmtEUR(profit);
      document.getElementById('eer-yield')!.textContent = totalYield.toFixed(1).replace('.', ',') + ' t';
      document.getElementById('eer-revenue')!.textContent = fmtEUR(revenue);
      document.getElementById('eer-margin')!.textContent = margin.toFixed(1).replace('.', ',') + ' %';
      document.getElementById('eer-costs')!.textContent = fmtEUR(totalCosts);
      document.getElementById('eer-peracre')!.textContent = fmtEUR(profitPerHa);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.eer-in').forEach(el => { el.addEventListener('input', calcEER); el.addEventListener('change', calcEER); });
      calcEER();
    }, 50);
  </script>
</CalculatorLayout>
