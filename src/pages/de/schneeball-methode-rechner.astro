---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schneeball-Methode-Rechner - Schneeball vs. Lawine";
const description = "Vergleichen Sie die Schneeball- mit der Lawinen-Methode, um den schnellsten Weg zur Schuldenfreiheit zu finden.";

const relatedCalcs = [
  { name: "Schuldenabbau-Rechner", url: "/de/schuldenabbau-rechner", description: "Schulden tilgen." },
  { name: "Schulden-Einkommens-Rechner", url: "/de/schulden-einkommens-rechner", description: "DTI-Quote." },
  { name: "Kreditrechner", url: "/de/kredit-rechner", description: "Kreditraten." },
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Budget." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="debt-snowball-calculator" calculatorName="Schneeball-Methode-Rechner" keywords="schneeball methode, lawinen methode, schuldenabbau strategie, schuldenfrei, tilgungsreihenfolge" breadcrumbs={[{ name: "Schneeball-Methode-Rechner", url: "/de/schneeball-methode-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schneeball-Methode-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Schneeball (kleinstes Saldo zuerst) vs. Lawine (h&ouml;chster Zinssatz zuerst).</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Ihre Schulden</h3>
          <div class="space-y-2" id="sm-debts">
            <div class="grid grid-cols-4 gap-2 text-xs font-medium text-text-muted"><span>Name</span><span>Saldo</span><span>Zins %</span><span>Mindestrate</span></div>
          </div>
          <button id="sm-add" class="mt-2 text-sm text-primary font-bold">+ Schuld hinzuf&uuml;gen</button>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Monatliche Zusatzzahlung (&euro;)</label><input type="number" id="sm-extra" class="sm-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="200" min="0" step="50"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Schneeball vs. Lawine</div>
          <div class="text-3xl font-extrabold font-mono" id="sm-result">-</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-blue-50 rounded-xl text-center border-2 border-primary">
            <div class="text-xs text-text-muted uppercase">Schneeball</div>
            <div class="text-lg font-bold font-mono" id="sm-snow-time">-</div>
            <div class="text-xs text-text-muted" id="sm-snow-int">-</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center border-2 border-border">
            <div class="text-xs text-text-muted uppercase">Lawine</div>
            <div class="text-lg font-bold font-mono" id="sm-aval-time">-</div>
            <div class="text-xs text-text-muted" id="sm-aval-int">-</div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtschulden</div><div class="text-xl font-bold font-mono" id="sm-total">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zinsersparnis</div><div class="text-xl font-bold font-mono" id="sm-saved">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchschn. Zins</div><div class="text-xl font-bold font-mono" id="sm-avg">0%</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="debt-snowball" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Schneeball- vs. Lawinen-Methode</h2>
      <p>Bei der <strong>Schneeball-Methode</strong> tilgen Sie zuerst die kleinste Schuld. Die <strong>Lawinen-Methode</strong> priorisiert den h&ouml;chsten Zinssatz. Mathematisch spart die Lawine mehr Zinsen, aber der Schneeball motiviert durch schnelle Erfolgserlebnisse.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Kann ich beide Methoden kombinieren?</strong> Ja! Manche starten mit dem Schneeball f&uuml;r die Motivation und wechseln dann zur Lawine.</p>
      <p><strong>Was ist mit Umschuldung?</strong> Eine Umschuldung auf einen niedrigeren Zinssatz kann zus&auml;tzlich Geld sparen, unabh&auml;ngig von der gew&auml;hlten Methode.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    interface SMDebt { name: string; balance: number; rate: number; minPay: number; }
    let smDebts: SMDebt[] = [
      { name: 'Kreditkarte', balance: 5000, rate: 18, minPay: 100 },
      { name: 'Autokredit', balance: 12000, rate: 5, minPay: 250 },
      { name: 'Studienkredit', balance: 8000, rate: 4, minPay: 150 },
    ];
    function renderSMDebts() {
      const container = document.getElementById('sm-debts')!;
      const header = '<div class="grid grid-cols-4 gap-2 text-xs font-medium text-text-muted"><span>Name</span><span>Saldo</span><span>Zins %</span><span>Mindestrate</span></div>';
      const rows = smDebts.map((d, i) =>
        '<div class="grid grid-cols-4 gap-2"><input class="sm-d px-2 py-1 border border-border rounded text-xs" data-i="' + i + '" data-f="name" value="' + d.name + '"><input type="number" class="sm-d px-2 py-1 border border-border rounded text-xs" data-i="' + i + '" data-f="balance" value="' + d.balance + '" min="0"><input type="number" class="sm-d px-2 py-1 border border-border rounded text-xs" data-i="' + i + '" data-f="rate" value="' + d.rate + '" min="0" step="0.1"><input type="number" class="sm-d px-2 py-1 border border-border rounded text-xs" data-i="' + i + '" data-f="minPay" value="' + d.minPay + '" min="0"></div>'
      ).join('');
      container.innerHTML = header + rows;
      container.querySelectorAll('.sm-d').forEach(el => el.addEventListener('input', () => {
        const inp = el as HTMLInputElement;
        const i = parseInt(inp.dataset.i!);
        const f = inp.dataset.f! as keyof SMDebt;
        if (f === 'name') smDebts[i].name = inp.value;
        else (smDebts[i] as any)[f] = parseFloat(inp.value) || 0;
        calcSM();
      }));
    }
    function simulateSM(sorted: SMDebt[], extra: number): { months: number; totalInterest: number } {
      const balances = sorted.map(d => d.balance);
      const rates = sorted.map(d => d.rate / 100 / 12);
      const mins = sorted.map(d => d.minPay);
      let months = 0; let totalInterest = 0;
      while (balances.some(b => b > 0) && months < 600) {
        months++;
        let extraLeft = extra;
        for (let i = 0; i < balances.length; i++) {
          if (balances[i] <= 0) continue;
          const interest = balances[i] * rates[i];
          totalInterest += interest;
          balances[i] += interest;
          const pay = Math.min(balances[i], mins[i]);
          balances[i] -= pay;
        }
        for (let i = 0; i < balances.length; i++) {
          if (balances[i] <= 0) continue;
          const extraPay = Math.min(balances[i], extraLeft);
          balances[i] -= extraPay;
          extraLeft -= extraPay;
          if (extraLeft <= 0) break;
        }
      }
      return { months, totalInterest };
    }
    function calcSM() {
      const extra = parseFloat((document.getElementById('sm-extra') as HTMLInputElement).value) || 0;
      const totalDebt = smDebts.reduce((s, d) => s + d.balance, 0);
      const avgRate = smDebts.length > 0 ? smDebts.reduce((s, d) => s + d.rate, 0) / smDebts.length : 0;
      const snowball = [...smDebts].sort((a, b) => a.balance - b.balance);
      const avalanche = [...smDebts].sort((a, b) => b.rate - a.rate);
      const snowRes = simulateSM(snowball, extra);
      const avalRes = simulateSM(avalanche, extra);
      const fmtTime = (m: number) => { const y = Math.floor(m / 12); const mo = m % 12; return y > 0 ? y + ' J ' + mo + ' M' : mo + ' M'; };
      document.getElementById('sm-snow-time')!.textContent = fmtTime(snowRes.months);
      document.getElementById('sm-snow-int')!.textContent = 'Zinsen: ' + Math.round(snowRes.totalInterest).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('sm-aval-time')!.textContent = fmtTime(avalRes.months);
      document.getElementById('sm-aval-int')!.textContent = 'Zinsen: ' + Math.round(avalRes.totalInterest).toLocaleString('de-DE') + ' \u20AC';
      const saved = Math.abs(snowRes.totalInterest - avalRes.totalInterest);
      const winner = avalRes.totalInterest <= snowRes.totalInterest ? 'Lawine' : 'Schneeball';
      document.getElementById('sm-result')!.textContent = winner + ' spart ' + Math.round(saved).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('sm-total')!.textContent = totalDebt.toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('sm-saved')!.textContent = Math.round(saved).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('sm-avg')!.textContent = avgRate.toFixed(1).replace('.', ',') + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      renderSMDebts();
      document.getElementById('sm-add')!.addEventListener('click', () => {
        smDebts.push({ name: 'Schuld ' + (smDebts.length + 1), balance: 1000, rate: 10, minPay: 50 });
        renderSMDebts();
        calcSM();
      });
      document.querySelectorAll('.sm-in').forEach(el => { el.addEventListener('input', calcSM); el.addEventListener('change', calcSM); });
      calcSM();
    }, 50);
  </script>
</CalculatorLayout>
