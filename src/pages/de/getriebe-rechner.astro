---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Getriebe-Rechner - \u00DCbersetzung, Teilkreis & Drehzahl";
const description = "Berechnen Sie \u00DCbersetzungsverh\u00E4ltnis, Teilkreisdurchmesser, Achsabstand und Abtriebsdrehzahl aus Z\u00E4hnezahl, Modul und Eingangsdrehzahl.";
const relatedCalcs = [
  { name: "Riemenl\u00E4ngen-Rechner", url: "/de/riemenlaengen-rechner", description: "Riemen/Umlenkung." },
  { name: "Drehmoment-Rechner", url: "/de/drehmoment-rechner", description: "Drehmoment." },
  { name: "Drehzahl-Rechner", url: "/de/drehzahl-rechner", description: "Drehzahl." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Getriebe-Rechner" lang="de" enSlug="gear-calculator" keywords="getriebe rechner, \u00FCbersetzung, teilkreisdurchmesser, achsabstand, z\u00E4hnezahl, modul, zahnrad" breadcrumbs={[{ name: "Getriebe-Rechner", url: "/de/getriebe-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Getriebe-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie die Z&auml;hnezahl zweier Zahnr&auml;der und den Modul ein, um &Uuml;bersetzung, Teilkreisdurchmesser, Achsabstand und Abtriebsdrehzahl zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zahnrad A Z&auml;hne (Z1 &mdash; Antrieb)</label><input type="number" id="gtr-n1" class="gtr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="6"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zahnrad B Z&auml;hne (Z2 &mdash; Abtrieb)</label><input type="number" id="gtr-n2" class="gtr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="6"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Modul m (mm)</label><input type="number" id="gtr-mod" class="gtr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.25" min="0.25"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Eingangsdrehzahl (U/min)</label><input type="number" id="gtr-rpm" class="gtr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">&Uuml;bersetzungsverh&auml;ltnis (Z2/Z1)</div>
          <div class="text-5xl font-extrabold font-mono" id="gtr-result">0</div>
          <div class="text-sm text-blue-200 mt-1" id="gtr-ratio-label">: 1</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Teilkreis-&oslash; A</div><div class="text-xl font-bold" id="gtr-d1">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Teilkreis-&oslash; B</div><div class="text-xl font-bold" id="gtr-d2">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Achsabstand</div><div class="text-xl font-bold" id="gtr-cd">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abtriebsdrehzahl</div><div class="text-xl font-bold" id="gtr-orpm">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schritt f&uuml;r Schritt</h3>
          <div class="font-mono text-sm space-y-1" id="gtr-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gear" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zahnrad-Formeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>&Uuml;bersetzung = Z2 / Z1</p>
        <p>Teilkreisdurchmesser = m &times; Z</p>
        <p>Achsabstand = m &times; (Z1 + Z2) / 2</p>
        <p>Abtriebsdrehzahl = Eingangsdrehzahl &times; Z1 / Z2</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Modul?</strong> Der Modul beschreibt die Zahngr&ouml;&szlig;e und muss bei k&auml;mmenden Zahnr&auml;dern identisch sein.</p>
      <p><strong>Was bedeutet &Uuml;bersetzung &gt; 1?</strong> Eine &Uuml;bersetzung gr&ouml;&szlig;er 1 bedeutet Drehzahluntersetzung und Drehmomentverst&auml;rkung.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGTR() {
      const N1 = parseFloat((document.getElementById('gtr-n1') as HTMLInputElement).value) || 0;
      const N2 = parseFloat((document.getElementById('gtr-n2') as HTMLInputElement).value) || 0;
      const m = parseFloat((document.getElementById('gtr-mod') as HTMLInputElement).value) || 0;
      const rpm = parseFloat((document.getElementById('gtr-rpm') as HTMLInputElement).value) || 0;
      const steps: string[] = [];
      let ratio = 0;
      if (N1 > 0) {
        ratio = N2 / N1;
        steps.push('\u00DCbersetzung = Z2/Z1 = ' + N2 + '/' + N1 + ' = ' + ratio.toFixed(4));
      }
      const d1 = m * N1;
      const d2 = m * N2;
      const cd = m * (N1 + N2) / 2;
      steps.push('Teilkreis-\u00D8 A = m \u00D7 Z1 = ' + m + ' \u00D7 ' + N1 + ' = ' + d1.toFixed(2) + ' mm');
      steps.push('Teilkreis-\u00D8 B = m \u00D7 Z2 = ' + m + ' \u00D7 ' + N2 + ' = ' + d2.toFixed(2) + ' mm');
      steps.push('Achsabstand = m(Z1+Z2)/2 = ' + m + '\u00D7(' + N1 + '+' + N2 + ')/2 = ' + cd.toFixed(2) + ' mm');
      let outRpm = 0;
      if (N2 > 0) {
        outRpm = rpm * N1 / N2;
        steps.push('Abtrieb = ' + rpm + ' \u00D7 ' + N1 + '/' + N2 + ' = ' + outRpm.toFixed(2) + ' U/min');
      }
      document.getElementById('gtr-result')!.textContent = ratio.toFixed(4);
      document.getElementById('gtr-ratio-label')!.textContent = ': 1 (' + N2 + ':' + N1 + ')';
      document.getElementById('gtr-d1')!.textContent = d1.toFixed(2) + ' mm';
      document.getElementById('gtr-d2')!.textContent = d2.toFixed(2) + ' mm';
      document.getElementById('gtr-cd')!.textContent = cd.toFixed(2) + ' mm';
      document.getElementById('gtr-orpm')!.textContent = outRpm.toFixed(2) + ' U/min';
      document.getElementById('gtr-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('gtr-n1') as HTMLInputElement).value = '20';
      (document.getElementById('gtr-n2') as HTMLInputElement).value = '40';
      (document.getElementById('gtr-mod') as HTMLInputElement).value = '2';
      (document.getElementById('gtr-rpm') as HTMLInputElement).value = '1500';
      document.querySelectorAll('.gtr-in').forEach(el => { el.addEventListener('input', calcGTR); el.addEventListener('change', calcGTR); });
      calcGTR();
    }, 50);
  </script>
</CalculatorLayout>
