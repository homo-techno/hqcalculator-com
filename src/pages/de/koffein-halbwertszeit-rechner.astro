---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Koffein-Halbwertszeit-Rechner - Restkoffein & Schlafqualit\u00e4t";
const description = "Berechnen Sie, wie viel Koffein zu Ihrer Schlafenszeit noch in Ihrem System ist. Finden Sie die optimale Koffein-Stopp-Zeit.";
const relatedCalcs = [
  { name: "Koffein-Rechner", url: "/de/koffein-rechner", description: "Koffeinaufnahme." },
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Verbrauch." },
  { name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner", description: "Defizit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Koffein-Halbwertszeit-Rechner" lang="de" enSlug="caffeine-half-life-calculator" keywords="koffein halbwertszeit, koffein stoffwechsel, koffein restwirkung, schlaf koffein, koffein stopp zeit" breadcrumbs={[{ name: "Koffein-Halbwertszeit", url: "/de/koffein-halbwertszeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Koffein-Halbwertszeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sehen Sie, wie der Koffeinspiegel in Ihrem K&ouml;rper sinkt und finden Sie die beste Stopp-Zeit f&uuml;r guten Schlaf.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Koffeinquelle</label>
          <select id="kh-source" class="kh-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="95">Kaffee (240ml) - 95 mg</option>
            <option value="63">Espresso (1 Shot) - 63 mg</option>
            <option value="47">Schwarztee (240ml) - 47 mg</option>
            <option value="28">Gr&uuml;ntee (240ml) - 28 mg</option>
            <option value="34">Cola (330ml) - 34 mg</option>
            <option value="80">Energy Drink (250ml) - 80 mg</option>
            <option value="160">Gro&szlig;er Energy Drink (500ml) - 160 mg</option>
            <option value="200">Koffeintablette - 200 mg</option>
            <option value="0">Eigene Menge</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Koffeinmenge (mg) - bei eigener Menge anpassen</label>
          <input type="number" id="kh-mg" class="kh-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="0" max="1000" step="5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Einnahmezeit</label>
          <input type="time" id="kh-time" class="kh-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Geplante Schlafenszeit</label>
          <input type="time" id="kh-bed" class="kh-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Koffeinempfindlichkeit</label>
          <select id="kh-sens" class="kh-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="fast">Schneller Stoffwechsel (HWZ ~3-4 Std.)</option>
            <option value="normal">Normal (HWZ ~5,7 Std.)</option>
            <option value="slow">Langsamer Stoffwechsel (HWZ ~7-9 Std.)</option>
          </select>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Koffein zur Schlafenszeit</div>
          <div class="text-2xl font-extrabold mt-1" id="kh-atbed">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Schlafeinfluss</div>
            <div class="text-xl font-bold text-text mt-1" id="kh-impact">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Optimale Stopp-Zeit</div>
            <div class="text-xl font-bold text-text mt-1" id="kh-cutoff">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Koffein-Abbau-Zeitverlauf</div>
          <div class="text-sm text-text space-y-1" id="kh-timeline">--</div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Wichtige Fakten</div>
          <div class="text-sm text-text" id="kh-facts">--</div>
        </div>
      </div>

      <ShareButton calculatorId="caffeine-half-life" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Was ist die Halbwertszeit von Koffein?</h3>
      <p>Die durchschnittliche Halbwertszeit betr&auml;gt 5,7 Stunden, variiert aber zwischen 1,5 und 9,5 Stunden je nach Genetik, Alter und Medikamenten.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Wann sollte ich aufh&ouml;ren Kaffee zu trinken?</h3>
      <p>Als Faustregel gilt: Mindestens 8-10 Stunden vor der Schlafenszeit kein Koffein mehr. Bei langsamer Verstoffwechselung sogar fr&uuml;her.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function minToTimeStr24(m: number): string {
      const mins = ((m % 1440) + 1440) % 1440;
      const h = Math.floor(mins / 60);
      const mm = mins % 60;
      return String(h).padStart(2, '0') + ':' + String(mm).padStart(2, '0');
    }

    function calcKH() {
      const sourceVal = parseInt((document.getElementById('kh-source') as HTMLSelectElement).value);
      let mg = parseFloat((document.getElementById('kh-mg') as HTMLInputElement).value) || sourceVal;
      const timeStr = (document.getElementById('kh-time') as HTMLInputElement).value || '08:00';
      const bedStr = (document.getElementById('kh-bed') as HTMLInputElement).value || '23:00';
      const sens = (document.getElementById('kh-sens') as HTMLSelectElement).value;

      if (sourceVal > 0) mg = sourceVal;

      const halfLife = sens === 'fast' ? 3.5 : sens === 'slow' ? 8 : 5.7;

      const [tH, tM] = timeStr.split(':').map(Number);
      const [bH, bM] = bedStr.split(':').map(Number);
      let consumedMin = tH * 60 + tM;
      let bedMin = bH * 60 + bM;
      if (bedMin <= consumedMin) bedMin += 1440;

      const hoursUntilBed = (bedMin - consumedMin) / 60;
      const atBedtime = mg * Math.pow(0.5, hoursUntilBed / halfLife);

      let impact = 'Keine';
      if (atBedtime > 100) impact = 'Schwer \u2014 wahrscheinlich Schlaflosigkeit';
      else if (atBedtime > 50) impact = 'Erheblich \u2014 verz\u00f6gertes Einschlafen';
      else if (atBedtime > 25) impact = 'Leicht \u2014 kann Schlafqualit\u00e4t beeinflussen';
      else impact = 'Minimal \u2014 Schlaf sollte in Ordnung sein';

      let cutoffHours = mg > 25 ? halfLife * Math.log2(mg / 25) : 0;
      const cutoffMin = (bedMin - cutoffHours * 60);

      document.getElementById('kh-atbed')!.textContent = atBedtime.toFixed(1).replace('.', ',') + ' mg verbleibend (' + (atBedtime / mg * 100).toFixed(0) + '% des Originals)';
      document.getElementById('kh-impact')!.textContent = impact;
      document.getElementById('kh-cutoff')!.textContent = cutoffHours > 0 ? 'Vor ' + minToTimeStr24(cutoffMin) + ' Uhr' : 'Jederzeit m\u00f6glich';

      const hours = [1, 2, 3, 4, 6, 8, 10, 12];
      const timeline = hours.map(h => {
        const remaining = mg * Math.pow(0.5, h / halfLife);
        const timeAt = consumedMin + h * 60;
        return '<div class="flex justify-between"><span>' + minToTimeStr24(timeAt) + ' (+' + h + 'h)</span><span>' + remaining.toFixed(1).replace('.', ',') + ' mg (' + (remaining / mg * 100).toFixed(0) + '%)</span></div>';
      }).join('');
      document.getElementById('kh-timeline')!.innerHTML = timeline;

      let facts: string[] = [];
      facts.push('Die durchschnittliche Koffein-Halbwertszeit betr\u00e4gt 5,7 Stunden, variiert aber zwischen 1,5 und 9,5 Stunden je nach Genetik (CYP1A2-Gen), Alter, Leberfunktion und Medikamenten.');
      if (sens === 'slow') facts.push('Langsame Verstoffwechsler sollten besonders vorsichtig sein. Hormonelle Verh\u00fctung, Schwangerschaft und bestimmte Medikamente k\u00f6nnen die Halbwertszeit verdoppeln.');
      if (mg > 400) facts.push('Warnung: Die EFSA empfiehlt nicht mehr als 400mg Koffein pro Tag f\u00fcr gesunde Erwachsene.');
      facts.push('Koffein blockiert Adenosin-Rezeptoren. Das Adenosin baut sich weiter auf, weshalb ein Crash auftreten kann, wenn die Wirkung nachl\u00e4sst.');

      document.getElementById('kh-facts')!.textContent = facts.join(' ');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('kh-mg') as HTMLInputElement).value = '95';
      (document.getElementById('kh-time') as HTMLInputElement).value = '08:00';
      (document.getElementById('kh-bed') as HTMLInputElement).value = '23:00';
      document.querySelectorAll('.kh-in').forEach(el => {
        el.addEventListener('input', calcKH);
        el.addEventListener('change', calcKH);
      });

      document.getElementById('kh-source')!.addEventListener('change', () => {
        const v = parseInt((document.getElementById('kh-source') as HTMLSelectElement).value);
        if (v > 0) (document.getElementById('kh-mg') as HTMLInputElement).value = String(v);
        calcKH();
      });

      calcKH();
    }, 50);
  </script>
</CalculatorLayout>
