---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Pferdegewicht Rechner - Gewicht aus Brustumfang schaetzen 2026";
const description = "Schaetze das Gewicht deines Pferdes aus Brustumfang und Koerperlaenge. Inklusive Koerperkonditionsbeurteilung und Idealgewichtsbereichen.";

const relatedCalcs = [
  { name: "Pferdefutter-Rechner", url: "/de/pferdefutter-rechner", description: "Taegliche Futterration." },
  { name: "Hundefutter-Rechner", url: "/de/hundefutter-rechner", description: "Hundefutter berechnen." },
  { name: "Hunde-BMI-Rechner", url: "/de/hunde-bmi-rechner", description: "Hunde-Koerperkondition." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Pferdegewicht-Rechner" keywords="Pferdegewicht Rechner, Brustumfang Pferd, Equines Gewicht, Koerperkonditionsscore Pferd, Idealgewicht Pferd" breadcrumbs={[{ name: "Pferdegewicht-Rechner", url: "/de/pferdegewicht-rechner" }]} lang="de" enSlug="horse-weight-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Pferdegewicht-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetze das Gewicht deines Pferdes aus Brustumfang und Koerperlaenge mit Koerperkonditionsbeurteilung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Brustumfang (cm)</label>
            <input type="number" id="pgr-girth" class="pgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="180" min="80" max="260" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Koerperlaenge (cm)</label>
            <input type="number" id="pgr-length" class="pgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="165" min="50" max="260" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Pferderasse</label>
            <select id="pgr-type" class="pgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="light" selected>Leichtpferd (Vollblut, Araber)</option>
              <option value="stock">Westernpferd (Quarterhorse)</option>
              <option value="draft">Kaltblut (Clydesdale, Haflinger)</option>
              <option value="pony">Pony</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Koerperkonditionsscore (1-9)</label>
            <input type="number" id="pgr-bcs" class="pgr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="9" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetztes Gewicht</div>
          <div class="text-5xl font-extrabold font-mono" id="pgr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewicht (lbs)</div><div class="text-xl font-bold font-mono" id="pgr-lbs">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">KKS Bewertung</div><div class="text-xl font-bold font-mono" id="pgr-bcsrating">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Idealbereich</div><div class="text-xl font-bold font-mono" id="pgr-ideal">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Idealgewicht</div><div class="text-xl font-bold font-mono" id="pgr-idealwt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abweichung</div><div class="text-xl font-bold font-mono" id="pgr-diff">--</div></div>
        </div>
      </div>

      <ShareButton calculatorId="horse-weight" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Pferdegewicht korrekt schaetzen</h2>
      <p>Da Pferdewaagen selten verfuegbar sind, bietet die Brustumfangsmethode nach Carroll und Huntington eine genaue Schaeztung. Die Formel lautet: Gewicht (kg) = (Brustumfang² x Koerperlaenge) / 11.880.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist der Koerperkonditionsscore (KKS)?</strong> Der KKS bewertet den Ernaehrungs- und Fettansatzstand des Pferdes auf einer Skala von 1 (abgemagert) bis 9 (adipoees). Ein KKS von 5 gilt als ideal.</p>
      <p><strong>Wie messe ich den Brustumfang?</strong> Das Massband direkt hinter dem Ellbogen anlegen, senkrecht zum Boden und eng anliegend, aber nicht einschnuerend. Am besten morgens vor dem Fressen.</p>
      <p><strong>Wie oft sollte ich das Gewicht kontrollieren?</strong> Fuer Gesundheitsmonitoring empfehlen Experten monatliche Wiegekontrollen, besonders bei intensiver Nutzung oder jahreszeitlichen Futterwechseln.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcPGR() {
      const girth = parseFloat((document.getElementById('pgr-girth') as HTMLInputElement).value) || 0;
      const length = parseFloat((document.getElementById('pgr-length') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('pgr-type') as HTMLSelectElement).value;
      const bcs = parseInt((document.getElementById('pgr-bcs') as HTMLInputElement).value) || 5;

      let weightKg = (girth * girth * length) / 11880;
      const typeAdj: Record<string, number> = { light: 0.95, stock: 1.0, draft: 1.1, pony: 0.85 };
      weightKg *= typeAdj[type] || 1.0;
      const weightLbs = weightKg * 2.2046;

      const bcsLabels: Record<number, string> = {
        1: 'Abgemagert', 2: 'Sehr duenn', 3: 'Duenn', 4: 'Maessig duenn',
        5: 'Ideal', 6: 'Maessig beleibt', 7: 'Beleibt', 8: 'Fett', 9: 'Uebergewichtig'
      };

      const bcsDeviation = (bcs - 5) * 0.05;
      const idealWeight = weightKg / (1 + bcsDeviation);
      const difference = weightKg - idealWeight;

      const ranges: Record<string, string> = {
        light: '400-550', stock: '450-600', draft: '700-1.000', pony: '180-400'
      };

      document.getElementById('pgr-result')!.textContent = Math.round(weightKg) + ' kg';
      document.getElementById('pgr-lbs')!.textContent = Math.round(weightLbs) + ' lbs';
      document.getElementById('pgr-bcsrating')!.textContent = bcsLabels[bcs] || 'Ideal';
      document.getElementById('pgr-ideal')!.textContent = (ranges[type] || '400-600') + ' kg';
      document.getElementById('pgr-idealwt')!.textContent = Math.round(idealWeight) + ' kg';
      document.getElementById('pgr-diff')!.textContent = (difference >= 0 ? '+' : '') + Math.round(difference) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.pgr-in').forEach(el => {
        el.addEventListener('input', calcPGR);
        el.addEventListener('change', calcPGR);
      });
      calcPGR();
    }, 50);
  </script>
</CalculatorLayout>
