---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Botox-Einheiten-Rechner - Einheiten nach Behandlungsbereich";
const description = "Berechnen Sie die geschätzten Botox-Einheiten für jeden Behandlungsbereich inkl. Stirn, Krähenfüße, Zornesfalte und mehr.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Körperoberfläche-Rechner", url: "/de/koerperoberflaeche-rechner", description: "Körperoberfläche." },
  { name: "Zahnspange-Kosten-Rechner", url: "/de/zahnspange-kosten-rechner", description: "Kieferorthopädie-Kosten." },
  { name: "BH-Größe-Rechner", url: "/de/bh-groesse-rechner", description: "BH-Größe berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "A1c-Rechner", url: "/de/a1c-rechner", description: "HbA1c-Werte." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Botox-Einheiten-Rechner" enSlug="botox-unit-calculator" keywords="Botox Einheiten, Botox Rechner, Stirn Botox, Krähenfüße Einheiten, Botox Kosten, Botox Behandlungsbereiche" breadcrumbs={[{ name: "Botox-Einheiten-Rechner", url: "/de/botox-einheiten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Botox-Einheiten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die benötigten Botox-Einheiten nach Behandlungsbereich und berechnen Sie Ihre Gesamtkosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kosten pro Einheit (€)</label>
          <input type="number" id="be-cost" class="be-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="5" max="30" step="1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Muskelstärke</label>
          <select id="be-strength" class="be-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.8">Mild (feine Linien, schwache Muskeln)</option>
            <option value="1.0" selected>Durchschnittlich</option>
            <option value="1.2">Stark (tiefe Falten, starke Muskeln)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-2">Behandlungsbereiche wählen</label>
          <div class="space-y-2">
            <label class="flex items-center gap-2"><input type="checkbox" id="be-forehead" class="be-in" checked><span class="text-sm">Stirnfalten (10-30 Einheiten)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-glabellar" class="be-in" checked><span class="text-sm">Zornesfalte / Glabella (20-25 Einheiten)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-crows" class="be-in" checked><span class="text-sm">Krähenfüße (12-24 Einheiten, beide Seiten)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-bunny" class="be-in"><span class="text-sm">Bunny Lines / Nase (5-10 Einheiten)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-lip" class="be-in"><span class="text-sm">Lip Flip (4-8 Einheiten)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-chin" class="be-in"><span class="text-sm">Kinn-Dellen (6-10 Einheiten)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-masseter" class="be-in"><span class="text-sm">Masseter / Kieferverschlankung (25-50 Einh./Seite)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-neck" class="be-in"><span class="text-sm">Halsbänder / Platysma (20-40 Einheiten)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="be-brow" class="be-in"><span class="text-sm">Brauenlift (4-8 Einheiten)</span></label>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamteinheiten</div>
          <div class="text-5xl font-extrabold font-mono" id="be-units">0</div>
          <div class="text-sm text-blue-200 mt-1">Einheiten Botox</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Geschätzte Kosten</div><div class="text-xl font-bold" id="be-total">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Behandelte Bereiche</div><div class="text-xl font-bold" id="be-areas">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Hält ca.</div><div class="text-xl font-bold" id="be-duration">3-4 Mo.</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jährliche Kosten (3x/Jahr)</div><div class="text-xl font-bold" id="be-annual">0 €</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Einheiten-Aufschlüsselung</h3>
          <div class="text-sm space-y-1" id="be-breakdown"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="botox-einheiten" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Botox-Einheiten-Leitfaden</h2>
      <p>Die Botox-Dosierung (Botulinumtoxin) variiert je nach Behandlungsbereich, Muskelstärke und gewünschtem Ergebnis. Die Stirn benötigt typischerweise 10-30 Einheiten, während die Zornesfalte 20-25 Einheiten erfordert. Ergebnisse halten durchschnittlich 3-4 Monate. In Deutschland liegen die Kosten typischerweise bei 8-15 € pro Einheit. Konsultieren Sie immer einen qualifizierten Arzt für individuelle Behandlungspläne.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie oft muss Botox aufgefrischt werden?</strong> Die Wirkung hält 3-4 Monate an. Die meisten Patienten lassen 3-4 Behandlungen pro Jahr durchführen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBE() {
      const costPerUnit = parseFloat((document.getElementById('be-cost') as HTMLInputElement).value) || 12;
      const strength = parseFloat((document.getElementById('be-strength') as HTMLSelectElement).value);
      const areas: {id:string, name:string, min:number, max:number}[] = [
        {id:'be-forehead', name:'Stirnfalten', min:10, max:30},
        {id:'be-glabellar', name:'Zornesfalte', min:20, max:25},
        {id:'be-crows', name:'Kr\u00e4henf\u00fc\u00dfe (beide)', min:12, max:24},
        {id:'be-bunny', name:'Bunny Lines', min:5, max:10},
        {id:'be-lip', name:'Lip Flip', min:4, max:8},
        {id:'be-chin', name:'Kinn-Dellen', min:6, max:10},
        {id:'be-masseter', name:'Masseter (beide)', min:50, max:100},
        {id:'be-neck', name:'Halsb\u00e4nder', min:20, max:40},
        {id:'be-brow', name:'Brauenlift', min:4, max:8},
      ];
      let totalUnits = 0;
      let areaCount = 0;
      const breakdown: string[] = [];
      areas.forEach(a => {
        if ((document.getElementById(a.id) as HTMLInputElement).checked) {
          const avg = Math.round(((a.min + a.max) / 2) * strength);
          totalUnits += avg;
          areaCount++;
          breakdown.push('<div class="flex justify-between"><span>' + a.name + '</span><span class="font-bold">' + avg + ' Einh. (' + (avg * costPerUnit).toFixed(0) + ' \u20AC)</span></div>');
        }
      });
      const totalCost = totalUnits * costPerUnit;
      const annualCost = totalCost * 3;
      document.getElementById('be-units')!.textContent = totalUnits.toString();
      document.getElementById('be-total')!.textContent = totalCost.toFixed(0) + ' \u20AC';
      document.getElementById('be-areas')!.textContent = areaCount.toString();
      document.getElementById('be-duration')!.textContent = '3-4 Mo.';
      document.getElementById('be-annual')!.textContent = annualCost.toFixed(0) + ' \u20AC';
      document.getElementById('be-breakdown')!.innerHTML = breakdown.length > 0 ? breakdown.join('') : '<p class="text-text-muted">W\u00e4hlen Sie Behandlungsbereiche oben aus.</p>';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.be-in').forEach(el => { el.addEventListener('input', calcBE); el.addEventListener('change', calcBE); });
      calcBE();
    }, 50);
  </script>
</CalculatorLayout>
