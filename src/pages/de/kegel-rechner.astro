---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kegel-Rechner - Volumen, Oberfläche & Mantelhöhe";
const description = "Berechnen Sie Volumen, Oberfläche, Mantelhöhe und Grundfläche eines Kegels aus Radius und Höhe.";
const relatedCalcs = [
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "3D-Volumen." },
  { name: "Kreisrechner", url: "/de/kreisrechner", description: "Kreise." },
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "2D-Flächen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kegel-Rechner" enSlug="cone-calculator" keywords="Kegel Rechner, Kegelvolumen, Kegeloberfläche, Mantelhöhe, Kegelformel" breadcrumbs={[{ name: "Kegel-Rechner", url: "/de/kegel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kegel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie alle Eigenschaften eines Kegels aus Radius und Höhe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Radius</label><input type="number" id="cn-r" class="cn-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Höhe</label><input type="number" id="cn-h" class="cn-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="12" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-5 bg-primary rounded-2xl text-white text-center"><div class="text-xs uppercase tracking-wide mb-1 opacity-80">Volumen</div><div class="text-2xl font-extrabold font-mono" id="cn-vol">0</div></div>
          <div class="p-5 bg-secondary rounded-2xl text-white text-center"><div class="text-xs uppercase tracking-wide mb-1 opacity-80">Gesamtoberfläche</div><div class="text-2xl font-extrabold font-mono" id="cn-tsa">0</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mantelhöhe</div><div class="text-xl font-bold" id="cn-sl">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mantelfläche</div><div class="text-xl font-bold" id="cn-la">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundfläche</div><div class="text-xl font-bold" id="cn-ba">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formeln</h3>
          <div class="font-mono text-sm space-y-1">
            <div>V = (1/3) x pi x r² x h</div>
            <div>Mantelhöhe = Wurzel(r² + h²)</div>
            <div>Mantelfläche = pi x r x Mantelhöhe</div>
            <div>Gesamtoberfläche = pi x r x (r + Mantelhöhe)</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="cone" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kegel-Berechnungen verstehen</h2>
      <p>Ein Kegel ist ein dreidimensionaler Körper mit einer kreisförmigen Grundfläche und einer Spitze. Das Volumen beträgt ein Drittel des Zylindervolumens mit gleicher Grundfläche und Höhe. Die Mantelhöhe (Seitenlänge) wird mit dem Satz des Pythagoras berechnet.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was ist die Mantelhöhe?</strong> Die Mantelhöhe ist die Strecke von der Spitze des Kegels zu einem Punkt auf dem Grundkreisrand.</p>
      <p><strong>Wie berechnet man das Volumen?</strong> Volumen = (1/3) x Pi x Radius² x Höhe.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCone() {
      const r = parseFloat((document.getElementById('cn-r') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('cn-h') as HTMLInputElement).value) || 0;
      const slant = Math.sqrt(r*r + h*h);
      const vol = (1/3) * Math.PI * r*r * h;
      const baseArea = Math.PI * r*r;
      const lateralArea = Math.PI * r * slant;
      const totalSA = baseArea + lateralArea;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      document.getElementById('cn-vol')!.textContent = fmt(vol);
      document.getElementById('cn-tsa')!.textContent = fmt(totalSA);
      document.getElementById('cn-sl')!.textContent = fmt(slant);
      document.getElementById('cn-la')!.textContent = fmt(lateralArea);
      document.getElementById('cn-ba')!.textContent = fmt(baseArea);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.cn-in').forEach(el => el.addEventListener('input', calcCone)); calcCone(); }, 50);
  </script>
</CalculatorLayout>
