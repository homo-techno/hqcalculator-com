---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "H&auml;rteumrechner - Rockwell, Brinell, Vickers";
const description = "Rechnen Sie zwischen H&auml;rteskalen um: Rockwell (HRC, HRB), Brinell (HB), Vickers (HV) und N&auml;herungszugfestigkeit.";

const relatedCalcs = [
  { name: "Gl&uuml;htemperatur-Rechner", url: "/de/gluehtemperatur-rechner", description: "W&auml;rmebehandlungstemperaturen." },
  { name: "Metallgewicht-Rechner", url: "/de/metallgewicht-rechner", description: "Metallgewicht berechnen." },
  { name: "Schraubenanzug-Rechner", url: "/de/schraubenanzug-rechner", description: "Anzugsmomente." },
  { name: "Schnittgeschwindigkeit-Rechner", url: "/de/schnittgeschwindigkeit-rechner", description: "Zerspanungsgeschwindigkeit." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="H&auml;rteumrechner"
  keywords="h&auml;rteumrechner, Rockwell HRC, Brinell, Vickers HV, Shore H&auml;rte, H&auml;rteumrechnung, HRC zu HB, H&auml;rteskala"
  breadcrumbs={[{ name: "H&auml;rteumrechner", url: "/de/haerteumrechner" }]}
  lang="de"
  enSlug="hardness-converter-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">H&auml;rteumrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen Rockwell, Brinell, Vickers und Shore H&auml;rteskalen mit N&auml;herungszugfestigkeit um.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Eingabeskala</label>
        <select id="hcu-scale" class="hcu-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="hrc">Rockwell C (HRC)</option>
          <option value="hrb">Rockwell B (HRB)</option>
          <option value="hv">Vickers (HV)</option>
          <option value="hb">Brinell (HB)</option>
        </select>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">H&auml;rtewert</label>
        <input type="number" id="hcu-value" class="hcu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="1">
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">N&auml;herungszugfestigkeit</div>
        <div class="text-4xl font-extrabold" id="hcu-tensile">--</div>
        <div class="text-sm text-blue-200 mt-1">MPa (ksi)</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Rockwell C (HRC)</div>
          <div class="text-xl font-bold" id="hcu-hrc">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Rockwell B (HRB)</div>
          <div class="text-xl font-bold" id="hcu-hrb">--</div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Vickers (HV)</div>
          <div class="text-xl font-bold" id="hcu-hv">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Brinell (HB)</div>
          <div class="text-xl font-bold" id="hcu-hb">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl text-center mb-6">
        <div class="text-xs text-text-muted uppercase">Typische Anwendung</div>
        <div class="text-sm font-semibold" id="hcu-app">--</div>
      </div>

      <ShareButton calculatorId="haerte-umrechner" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;rteskalen erkl&auml;rt</h2>
      <ul>
        <li><strong>Rockwell C (HRC):</strong> Bereich 20-70. F&uuml;r geh&auml;rtete St&auml;hle, Werkzeugst&auml;hle. Diamantkegel-Eindringk&ouml;rper, 150 kg Last.</li>
        <li><strong>Rockwell B (HRB):</strong> Bereich 0-100. F&uuml;r weichere Metalle, gegl&uuml;hter Stahl, Aluminium. Stahlkugel 1/16", 100 kg Last.</li>
        <li><strong>Vickers (HV):</strong> Breiter Bereich (50-3000+). Diamantpyramide. Pr&auml;zise f&uuml;r d&uuml;nne Querschnitte und Einsatztiefe.</li>
        <li><strong>Brinell (HB):</strong> H&auml;ufig f&uuml;r Guss- und Schmiedeteile. 10 mm Hartmetallkugel, 3000 kg Last f&uuml;r Stahl.</li>
      </ul>
      <p class="mt-4"><strong>Hinweis:</strong> Umrechnungen sind N&auml;herungswerte. Eine genaue &Auml;quivalenz zwischen Skalen ist nicht m&ouml;glich, da sie unterschiedliche Eigenschaften messen. ASTM E140 stellt Norm-Umrechnungstabellen bereit.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen HRC und HV?</strong> Rockwell C verwendet einen Diamantkegel und misst die Eindringtiefe, w&auml;hrend Vickers eine Pyramide verwendet und die Diagonale des Eindrucks misst. Vickers ist pr&auml;ziser f&uuml;r d&uuml;nne Materialien.</p>
      <p><strong>Wann verwende ich die Brinell-H&auml;rte?</strong> Brinell eignet sich am besten f&uuml;r Guss- und Schmiedeteile mit groben Strukturen, bei denen kleinere Eindringk&ouml;rper keine repr&auml;sentative Messung liefern.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHCU() {
      const scale = (document.getElementById('hcu-scale') as HTMLSelectElement).value;
      const value = parseFloat((document.getElementById('hcu-value') as HTMLInputElement).value) || 0;

      let hv = 0;
      if (scale === 'hv') {
        hv = value;
      } else if (scale === 'hrc') {
        hv = 1.420 * value * value - 18.38 * value + 756.4;
        if (value < 20) hv = value * 10 + 200;
      } else if (scale === 'hrb') {
        hv = 0.0344 * value * value - 1.483 * value + 127.7;
        if (value > 100) hv = value * 3.5;
      } else if (scale === 'hb') {
        hv = value * 1.05;
      }

      hv = Math.max(0, hv);

      let hrc = 0;
      if (hv > 200) {
        hrc = (-0.0002 * hv * hv + 0.3464 * hv - 72.69);
      }
      hrc = Math.max(0, Math.min(70, hrc));

      let hrb = 0;
      if (hv < 400) {
        hrb = (0.0009 * hv * hv + 0.1943 * hv + 47.65);
        hrb = Math.min(100, hrb);
      }

      const hb = hv / 1.05;
      const uts_mpa = hv * 3.45;
      const uts_ksi = uts_mpa * 0.145038;

      let app = '';
      if (hrc >= 58) app = 'Schneidwerkzeuge, Schnellstahl, Hartmetall';
      else if (hrc >= 50) app = 'Geh&auml;rteter Werkzeugstahl, Gesenke, Stempel, Klingen';
      else if (hrc >= 40) app = 'Federn, hochfeste Wellen, Zahnr&auml;der';
      else if (hrc >= 30) app = 'Mittelh&auml;rter Stahl, Bolzen, Kfz-Teile';
      else if (hrc >= 20) app = 'Geringfester Stahl, Bauteile';
      else if (hv >= 100) app = 'Baustahl, Aluminium, Weichmetalle';
      else app = 'Sehr weiche Metalle, gegl&uuml;hter Zustand';

      document.getElementById('hcu-hrc')!.textContent = hrc > 0 ? hrc.toFixed(1) : 'N/A (unter 20)';
      document.getElementById('hcu-hrb')!.textContent = hv < 400 ? hrb.toFixed(1) : 'N/A (&uuml;ber 100)';
      document.getElementById('hcu-hv')!.textContent = hv.toFixed(0);
      document.getElementById('hcu-hb')!.textContent = hb.toFixed(0);
      document.getElementById('hcu-tensile')!.textContent = Math.round(uts_mpa).toLocaleString('de-DE') + ' MPa (' + uts_ksi.toFixed(0) + ' ksi)';
      document.getElementById('hcu-app')!.textContent = app;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hcu-in').forEach(el => {
        el.addEventListener('input', calcHCU);
        el.addEventListener('change', calcHCU);
      });
      calcHCU();
    }, 50);
  </script>
</CalculatorLayout>
