---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Erbschaftssteuer-Rechner - Steuer auf Erbschaften berechnen";
const description = "Berechnen Sie die Erbschaftssteuer basierend auf Nachlasswert, Steuerklasse, Freibetr\u00e4gen und Abz\u00fcgen nach deutschem Erbschaftsteuergesetz.";

const relatedCalcs = [
  { name: "Nachlassplanung-Rechner", url: "/de/nachlassplanung-rechner", description: "Nachlassplanung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlagerenditen." },
  { name: "401k-Rechner", url: "/de/401k-rechner", description: "Altersvorsorge." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Erbschaftssteuer-Rechner" lang="de" enSlug="estate-tax-calculator" keywords="erbschaftssteuer rechner, erbschaftsteuer, freibetrag, steuerklasse, nachlass steuer" breadcrumbs={[{ name: "Erbschaftssteuer-Rechner", url: "/de/erbschaftssteuer-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Erbschaftssteuer-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Erbschaftssteuer basierend auf Nachlasswert, Steuerklasse und Freibetr&auml;gen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Brutto-Nachlasswert (&euro;)</label><input type="number" id="est-gross" class="est-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="1000000" min="0" step="10000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Schulden &amp; Verwaltungskosten (&euro;)</label><input type="number" id="est-debts" class="est-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000" min="0" step="5000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Bestattungskosten (&euro;)</label><input type="number" id="est-funeral" class="est-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="0" step="1000"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Steuerklasse</label>
          <select id="est-class" class="est-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="I-spouse" selected>Klasse I - Ehepartner (500.000 &euro; Freibetrag)</option>
            <option value="I-child">Klasse I - Kind (400.000 &euro; Freibetrag)</option>
            <option value="I-grandchild">Klasse I - Enkel (200.000 &euro; Freibetrag)</option>
            <option value="II">Klasse II - Geschwister/Neffen (20.000 &euro; Freibetrag)</option>
            <option value="III">Klasse III - Sonstige (20.000 &euro; Freibetrag)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Erbschaftssteuer</div>
          <div class="text-5xl font-extrabold font-mono" id="est-result">0 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Steuerpflichtiger Erwerb</div><div class="text-xl font-bold font-mono" id="est-taxable">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Effektiver Steuersatz</div><div class="text-xl font-bold font-mono" id="est-effective">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Freibetrag</div><div class="text-xl font-bold font-mono" id="est-exemption">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Netto an Erben</div><div class="text-xl font-bold font-mono" id="est-net">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="estate-tax-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Erbschaftssteuer in Deutschland</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Steuerpflichtiger Erwerb:</strong> Nachlasswert &minus; Schulden &minus; Kosten &minus; Freibetrag</p>
        <p><strong>Steuer:</strong> Steuerpflichtiger Erwerb &times; Steuersatz (je nach Klasse)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Steuerklassen gibt es?</strong> Klasse I (Ehepartner, Kinder, Enkel), Klasse II (Geschwister, Neffen), Klasse III (alle &uuml;brigen Personen). Die Steuers&auml;tze steigen mit der Klasse.</p>
      <p><strong>Wie hoch ist der Steuersatz?</strong> Klasse I: 7-30%, Klasse II: 15-43%, Klasse III: 30-50%, je nach H&ouml;he des steuerpflichtigen Erwerbs.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEST() {
      const gross = parseFloat((document.getElementById('est-gross') as HTMLInputElement).value) || 0;
      const debts = parseFloat((document.getElementById('est-debts') as HTMLInputElement).value) || 0;
      const funeral = parseFloat((document.getElementById('est-funeral') as HTMLInputElement).value) || 0;
      const taxClass = (document.getElementById('est-class') as HTMLSelectElement).value;

      const exemptions: Record<string, number> = {
        'I-spouse': 500000, 'I-child': 400000, 'I-grandchild': 200000, 'II': 20000, 'III': 20000
      };
      const exemption = exemptions[taxClass] || 400000;
      const adjustedGross = gross - debts - funeral;
      const taxableEstate = Math.max(0, adjustedGross - exemption);

      // German brackets by class
      function getTax(taxable: number, cls: string): number {
        if (cls.startsWith('I')) {
          if (taxable <= 75000) return taxable * 0.07;
          if (taxable <= 300000) return taxable * 0.11;
          if (taxable <= 600000) return taxable * 0.15;
          if (taxable <= 6000000) return taxable * 0.19;
          if (taxable <= 13000000) return taxable * 0.23;
          if (taxable <= 26000000) return taxable * 0.27;
          return taxable * 0.30;
        } else if (cls === 'II') {
          if (taxable <= 75000) return taxable * 0.15;
          if (taxable <= 300000) return taxable * 0.20;
          if (taxable <= 600000) return taxable * 0.25;
          if (taxable <= 6000000) return taxable * 0.30;
          if (taxable <= 13000000) return taxable * 0.35;
          if (taxable <= 26000000) return taxable * 0.40;
          return taxable * 0.43;
        } else {
          if (taxable <= 75000) return taxable * 0.30;
          if (taxable <= 300000) return taxable * 0.30;
          if (taxable <= 600000) return taxable * 0.30;
          if (taxable <= 6000000) return taxable * 0.30;
          if (taxable <= 13000000) return taxable * 0.50;
          if (taxable <= 26000000) return taxable * 0.50;
          return taxable * 0.50;
        }
      }

      const tax = getTax(taxableEstate, taxClass);
      const effectiveRate = adjustedGross > 0 ? (tax / adjustedGross) * 100 : 0;
      const netToHeirs = adjustedGross - tax;

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('est-result')!.textContent = fmt(tax);
      document.getElementById('est-taxable')!.textContent = fmt(taxableEstate);
      document.getElementById('est-effective')!.textContent = effectiveRate.toFixed(2).replace('.', ',') + '%';
      document.getElementById('est-exemption')!.textContent = fmt(exemption);
      document.getElementById('est-net')!.textContent = fmt(netToHeirs);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.est-in').forEach(el => { el.addEventListener('input', calcEST); el.addEventListener('change', calcEST); });
      calcEST();
    }, 50);
  </script>
</CalculatorLayout>
