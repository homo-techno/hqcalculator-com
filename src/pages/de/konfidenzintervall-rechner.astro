---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Konfidenzintervall-Rechner - KI für den Mittelwert";
const description = "Berechnen Sie das Konfidenzintervall für einen Populationsmittelwert. Wählen Sie 90%, 95% oder 99% Konfidenzniveau.";
const relatedCalcs = [
  { name: "Z-Wert-Rechner", url: "/de/z-wert-rechner", description: "Z-Werte." },
  { name: "Standardabweichung", url: "/de/standardabweichung-rechner", description: "Statistik." },
  { name: "Stichprobengröße", url: "/de/stichprobengroesse-rechner", description: "Stichprobe." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Konfidenzintervall-Rechner" enSlug="confidence-interval-calculator" keywords="Konfidenzintervall, Vertrauensintervall, Fehlerspanne, Konfidenzniveau, Statistik" breadcrumbs={[{ name: "Konfidenzintervall-Rechner", url: "/de/konfidenzintervall-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Konfidenzintervall-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie das Konfidenzintervall für einen Populationsmittelwert.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stichprobenmittel (x&#772;)</label><input type="number" id="ci-mean" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Std.-Abw. (&#963; oder s)</label><input type="number" id="ci-std" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0.01" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stichprobengr. (n)</label><input type="number" id="ci-n" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="2" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Konfidenzniveau</label>
          <select id="ci-level" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.645">90%</option>
            <option value="1.96" selected>95%</option>
            <option value="2.576">99%</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Konfidenzintervall</div>
          <div class="text-3xl font-extrabold font-mono" id="ci-result">(0, 0)</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fehlerspanne</div><div class="text-xl font-bold text-secondary" id="ci-moe">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Standardfehler</div><div class="text-xl font-bold" id="ci-se">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Untere Grenze</div><div class="text-xl font-bold" id="ci-lower">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Obere Grenze</div><div class="text-xl font-bold" id="ci-upper">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formel</h3>
          <div class="font-mono text-sm" id="ci-formula">KI = x&#772; &#177; z &#215; (&#963;/&#8730;n)</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="confidence-interval" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Konfidenzintervalle verstehen</h2>
      <p>Ein 95%-Konfidenzintervall bedeutet: Wenn Sie die Stichprobenerhebung 100-mal wiederholen würden, würden etwa 95 dieser Intervalle den wahren Populationsmittelwert enthalten.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was ist eine Fehlerspanne?</strong> Die Fehlerspanne gibt an, wie weit der geschätzte Wert maximal vom wahren Wert abweichen kann.</p>
      <p><strong>Wann verwendet man welches Konfidenzniveau?</strong> 95% ist der Standard in den meisten Forschungsbereichen. 99% wird bei hohen Anforderungen an die Sicherheit verwendet.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCI() {
      const mean = parseFloat((document.getElementById('ci-mean') as HTMLInputElement).value) || 0;
      const std = parseFloat((document.getElementById('ci-std') as HTMLInputElement).value) || 1;
      const n = parseInt((document.getElementById('ci-n') as HTMLInputElement).value) || 2;
      const z = parseFloat((document.getElementById('ci-level') as HTMLSelectElement).value) || 1.96;
      const se = std / Math.sqrt(n);
      const moe = z * se;
      const lower = mean - moe;
      const upper = mean + moe;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      document.getElementById('ci-result')!.textContent = '(' + fmt(lower) + ', ' + fmt(upper) + ')';
      document.getElementById('ci-moe')!.textContent = '\u00B1' + fmt(moe);
      document.getElementById('ci-se')!.textContent = fmt(se);
      document.getElementById('ci-lower')!.textContent = fmt(lower);
      document.getElementById('ci-upper')!.textContent = fmt(upper);
      document.getElementById('ci-formula')!.innerHTML = 'KI = ' + mean + ' \u00B1 ' + z + ' \u00D7 (' + std + '/\u221A' + n + ') = ' + mean + ' \u00B1 <strong>' + fmt(moe) + '</strong>';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { ['ci-mean','ci-std','ci-n'].forEach(id => document.getElementById(id)!.addEventListener('input', calcCI)); document.getElementById('ci-level')!.addEventListener('change', calcCI); calcCI(); }, 50);
  </script>
</CalculatorLayout>
