---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Palettenrechner - Belegung, Stapelhöhe & Ladegewicht";
const description = "Berechnen Sie Palettenbelegung, Stapelhöhe und Ladegewicht für Logistik und Transport. Optimieren Sie Ihre Lagerung und Lieferung.";

const relatedCalcs = [
  { name: "Versandkosten-Rechner", url: "/de/versandkosten-rechner", description: "Versandkosten." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen berechnen." },
  { name: "Gewichtsrechner", url: "/de/gewichtsrechner", description: "Gewichte umrechnen." },
  { name: "Lagerkosten-Rechner", url: "/de/lagerkosten-rechner", description: "Lagerkosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Palettenrechner" lang="de" enSlug="pallet-calculator" keywords="palettenrechner, palettenbelegung, stapelhöhe berechnen, ladegewicht palette, europalette" breadcrumbs={[{ name: "Palettenrechner", url: "/de/palette-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Palettenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Palettenbelegung, Stapelhöhe und Ladegewicht für Logistik und Transport.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Palettentyp</label>
          <select id="pal-type" class="pal-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="euro">Europalette (120 × 80 cm)</option>
            <option value="iso">ISO-Palette (120 × 100 cm)</option>
            <option value="half">Halbpalette (80 × 60 cm)</option>
            <option value="us">US-Palette (121,9 × 101,6 cm)</option>
          </select>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Karton Länge (cm)</label><input type="number" id="pal-bl" class="pal-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Karton Breite (cm)</label><input type="number" id="pal-bb" class="pal-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Karton Höhe (cm)</label><input type="number" id="pal-bh" class="pal-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht pro Karton (kg)</label><input type="number" id="pal-bw" class="pal-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0.1" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Max. Stapelhöhe (cm)</label><input type="number" id="pal-maxh" class="pal-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="10" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kartons pro Palette</div>
          <div class="text-4xl font-extrabold font-mono" id="pal-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kartons je Lage</div><div class="text-xl font-bold" id="pal-perlayer">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahl Lagen</div><div class="text-xl font-bold" id="pal-layers">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-xl font-bold" id="pal-weight">0 kg</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nutzlast-Auslastung</div><div class="text-xl font-bold" id="pal-util">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stapelhöhe gesamt</div><div class="text-xl font-bold" id="pal-height">0 cm</div></div>
        </div>
      </div>
      <ShareButton calculatorId="palette-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Palettenbelegung optimal berechnen</h2>
      <p class="text-text-secondary mt-2">Eine optimale Palettenbelegung senkt Transportkosten und maximiert die Raumnutzung im Lager. Die Europalette (120 × 80 cm) ist der europäische Standard mit einer maximalen Traglast von 1.500 kg dynamisch und 4.000 kg statisch. Bei der Berechnung werden die Kartondimensionen auf die Palettenabmessungen aufgeteilt, um die optimale Anzahl pro Lage zu ermitteln.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Kartons/Lage:</strong> floor(PaletteL / KartonL) × floor(PaletteB / KartonB)</p>
        <p><strong>Lagen:</strong> floor(MaxHöhe / KartonHöhe)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist die maximale Traglast einer Europalette?</strong> Europaletten tragen dynamisch bis zu 1.500 kg (beim Transport) und statisch bis zu 4.000 kg (im Regal). Die Traglast hängt vom Zustand der Palette ab.</p>
      <p><strong>Wie hoch darf eine Palette gestapelt werden?</strong> Im Straßentransport gilt üblicherweise eine Gesamthöhe von 220–240 cm inklusive Palette (15 cm). Im Lager können Regale je nach Bauart bis 180 cm Stapelhöhe erlauben.</p>
      <p><strong>Was ist der Unterschied zwischen Europalette und ISO-Palette?</strong> Europaletten (120 × 80 cm) sind in Europa der Standard. ISO-Paletten (120 × 100 cm) bieten etwas mehr Fläche und werden häufig international eingesetzt.</p>
      <p><strong>Wie berechne ich den Platzbedarf im LKW?</strong> Ein Standard-LKW (Eurotrailer) fasst 33 Europaletten einlagig. Bei zwei Lagen verdoppelt sich die Kapazität, sofern Traglast und Höhe es erlauben.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcPAL() {
      const type = (document.getElementById('pal-type') as HTMLSelectElement).value;
      const bl = parseFloat((document.getElementById('pal-bl') as HTMLInputElement).value) || 40;
      const bb = parseFloat((document.getElementById('pal-bb') as HTMLInputElement).value) || 30;
      const bh = parseFloat((document.getElementById('pal-bh') as HTMLInputElement).value) || 25;
      const bw = parseFloat((document.getElementById('pal-bw') as HTMLInputElement).value) || 15;
      const maxh = parseFloat((document.getElementById('pal-maxh') as HTMLInputElement).value) || 200;

      const palDims: Record<string, [number, number, number]> = {
        euro: [120, 80, 1500],
        iso: [120, 100, 2000],
        half: [80, 60, 750],
        us: [121.9, 101.6, 1800],
      };
      const [pl, pb, maxLoad] = palDims[type] || [120, 80, 1500];

      const perLayerA = Math.floor(pl / bl) * Math.floor(pb / bb);
      const perLayerB = Math.floor(pl / bb) * Math.floor(pb / bl);
      const perLayer = Math.max(perLayerA, perLayerB);
      const layers = Math.floor(maxh / bh);
      const total = perLayer * layers;
      const totalWeight = total * bw;
      const util = Math.min((totalWeight / maxLoad) * 100, 100);
      const stackHeight = layers * bh;

      document.getElementById('pal-result')!.textContent = total.toLocaleString('de-DE');
      document.getElementById('pal-perlayer')!.textContent = perLayer.toLocaleString('de-DE');
      document.getElementById('pal-layers')!.textContent = layers.toLocaleString('de-DE');
      document.getElementById('pal-weight')!.textContent = totalWeight.toLocaleString('de-DE') + ' kg';
      document.getElementById('pal-util')!.textContent = util.toFixed(1).replace('.', ',') + '%';
      document.getElementById('pal-height')!.textContent = stackHeight.toLocaleString('de-DE') + ' cm';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pal-in').forEach(el => { el.addEventListener('input', calcPAL); el.addEventListener('change', calcPAL); });
      calcPAL();
    }, 50);
  </script>
</CalculatorLayout>
