---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Schulden-Einkommens-Rechner - DTI-Quote berechnen";
const description = "Berechnen Sie Ihre Schulden-Einkommens-Quote (DTI), um zu sehen, ob Sie sich fuer einen Kredit oder eine Hypothek qualifizieren.";

const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Immobilienkredite." },
  { name: "Kreditrechner", url: "/de/kredit-rechner", description: "Kreditraten." },
  { name: "Schuldenabbau-Rechner", url: "/de/schuldenabbau-rechner", description: "Schulden tilgen." },
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Budgetplanung." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="debt-to-income-calculator" calculatorName="Schulden-Einkommens-Rechner" keywords="schulden einkommens quote, DTI rechner, kreditqualifikation, hypothekenqualifikation, schuldenquote" breadcrumbs={[{ name: "Schulden-Einkommens-Rechner", url: "/de/schulden-einkommens-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schulden-Einkommens-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie Ihre DTI-Quote &mdash; ein wichtiger Faktor f&uuml;r die Kreditvergabe.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Monatliches Bruttoeinkommen</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="sei-income" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" value="4000" min="0" step="100">
            </div>
          </div>
          <h3 class="font-semibold text-text">Monatliche Schuldenraten</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <label class="text-xs text-text-secondary w-36">Miete / Hypothek</label>
              <div class="relative flex-1"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span>
                <input type="number" class="sei-debt w-full pl-6 pr-2 py-2 border border-border rounded-lg text-sm" value="900" min="0" step="50">
              </div>
            </div>
            <div class="flex items-center gap-2">
              <label class="text-xs text-text-secondary w-36">Autokredit</label>
              <div class="relative flex-1"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span>
                <input type="number" class="sei-debt w-full pl-6 pr-2 py-2 border border-border rounded-lg text-sm" value="300" min="0" step="25">
              </div>
            </div>
            <div class="flex items-center gap-2">
              <label class="text-xs text-text-secondary w-36">Studienkredit</label>
              <div class="relative flex-1"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span>
                <input type="number" class="sei-debt w-full pl-6 pr-2 py-2 border border-border rounded-lg text-sm" value="150" min="0" step="25">
              </div>
            </div>
            <div class="flex items-center gap-2">
              <label class="text-xs text-text-secondary w-36">Kreditkarten-Min.</label>
              <div class="relative flex-1"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span>
                <input type="number" class="sei-debt w-full pl-6 pr-2 py-2 border border-border rounded-lg text-sm" value="50" min="0" step="25">
              </div>
            </div>
            <div class="flex items-center gap-2">
              <label class="text-xs text-text-secondary w-36">Pers&ouml;nliche Kredite</label>
              <div class="relative flex-1"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span>
                <input type="number" class="sei-debt w-full pl-6 pr-2 py-2 border border-border rounded-lg text-sm" value="0" min="0" step="25">
              </div>
            </div>
            <div class="flex items-center gap-2">
              <label class="text-xs text-text-secondary w-36">Sonstige Schulden</label>
              <div class="relative flex-1"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span>
                <input type="number" class="sei-debt w-full pl-6 pr-2 py-2 border border-border rounded-lg text-sm" value="0" min="0" step="25">
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 rounded-2xl text-white text-center" id="sei-box" style="background:#22c55e;">
            <div class="text-sm uppercase tracking-wide mb-1 opacity-80">Schulden-Einkommens-Quote</div>
            <div class="text-6xl font-extrabold" id="sei-ratio">0%</div>
            <div class="text-lg mt-1 font-semibold" id="sei-verdict">Hervorragend</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Schulden/Monat</div>
              <div class="text-xl font-bold text-secondary" id="sei-total-debt">0 &euro;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Verbleibendes Einkommen</div>
              <div class="text-xl font-bold" id="sei-remaining">0 &euro;</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-3">DTI-Richtwerte</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-green-600 font-semibold">Unter 36%</span><span class="text-text-secondary">Hervorragend &mdash; leicht genehmigt</span></div>
              <div class="flex justify-between"><span class="text-yellow-600 font-semibold">36% - 43%</span><span class="text-text-secondary">Akzeptabel f&uuml;r die meisten Kredite</span></div>
              <div class="flex justify-between"><span class="text-orange-600 font-semibold">43% - 50%</span><span class="text-text-secondary">Schwierigkeiten m&ouml;glich</span></div>
              <div class="flex justify-between"><span class="text-red-600 font-semibold">&Uuml;ber 50%</span><span class="text-text-secondary">Genehmigung unwahrscheinlich</span></div>
            </div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="dti" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Die Schulden-Einkommens-Quote verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm">
        <p><strong>DTI</strong> = (Monatliche Schuldenraten &divide; Monatliches Bruttoeinkommen) &times; 100</p>
      </div>
      <p>Banken in Deutschland achten besonders auf die Belastungsquote. Eine DTI unter 35-40% gilt als solide Basis f&uuml;r eine Kreditvergabe.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche DTI fordern deutsche Banken?</strong> In der Regel nicht mehr als 35-40% des Nettoeinkommens f&uuml;r die Gesamtbelastung.</p>
      <p><strong>Was z&auml;hlt als Schuld?</strong> Alle regelm&auml;&szlig;igen Verpflichtungen: Miete, Kreditraten, Unterhalt, Leasingraten und Kreditkarten-Mindestbetr&auml;ge.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const seiFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcSEI() {
      const income = parseFloat((document.getElementById('sei-income') as HTMLInputElement).value) || 0;
      let totalDebt = 0;
      document.querySelectorAll('.sei-debt').forEach(el => {
        totalDebt += parseFloat((el as HTMLInputElement).value) || 0;
      });

      const ratio = income > 0 ? (totalDebt / income) * 100 : 0;
      const remaining = income - totalDebt;

      document.getElementById('sei-ratio')!.textContent = ratio.toFixed(1).replace('.', ',') + '%';
      document.getElementById('sei-total-debt')!.textContent = seiFmt(totalDebt);
      document.getElementById('sei-remaining')!.textContent = seiFmt(remaining);

      let color: string, verdict: string;
      if (ratio < 36) { color = '#22c55e'; verdict = 'Hervorragend \u2014 Starke Position'; }
      else if (ratio < 43) { color = '#eab308'; verdict = 'Akzeptabel \u2014 Qualifiziert f\u00fcr die meisten Kredite'; }
      else if (ratio < 50) { color = '#f97316'; verdict = 'Hoch \u2014 Schwierigkeiten m\u00f6glich'; }
      else { color = '#ef4444'; verdict = 'Sehr hoch \u2014 Genehmigung unwahrscheinlich'; }

      document.getElementById('sei-box')!.style.backgroundColor = color;
      document.getElementById('sei-verdict')!.textContent = verdict;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('sei-income')!.addEventListener('input', calcSEI);
      document.querySelectorAll('.sei-debt').forEach(el => el.addEventListener('input', calcSEI));
      calcSEI();
    }, 50);
  </script>
</CalculatorLayout>
