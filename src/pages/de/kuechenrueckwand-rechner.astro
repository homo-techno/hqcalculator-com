---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Küchenrückwand-Rechner";
const description = "Berechnen Sie Fliesen, Kleber und Fugenmasse für Ihre Küchen- oder Badezimmer-Rückwand.";
const relatedCalcs = [
  { name: "Fliesenrechner", url: "/de/fliesen-rechner", description: "Fliesen." },
  { name: "Arbeitsplatte", url: "/de/arbeitsplatte-rechner", description: "Arbeitsplatte." },
  { name: "Schrankrerechner", url: "/de/schrank-rechner", description: "Schränke." },
  { name: "Quadratmeter", url: "/de/quadratmeter-rechner", description: "Quadratmeter." },
  { name: "Ziegel", url: "/de/ziegel-rechner", description: "Ziegel." },
  { name: "Stuckleiste", url: "/de/stuckleiste-rechner", description: "Stuckleisten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Küchenrückwand-Rechner" keywords="Küchenrückwand Rechner, Fliesenspiegel, Rückwand Fliesen, Rückwand Kosten, U-Bahn-Fliesen" breadcrumbs={[{ name: "Küchenrückwand", url: "/de/kuechenrueckwand-rechner" }]} lang="de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Küchenrückwand-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie Fliesen und Materialien für Ihre Küchenrückwand.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wandlänge (cm)</label><input type="number" id="bs-len" class="bs-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="300" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rückwandhöhe (cm)</label><input type="number" id="bs-ht" class="bs-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="45" min="0" step="5"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Fliesengröße</h3>
          <div class="flex gap-2">
            <button class="bs-sz flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-w="7.5" data-h="15">7,5x15 Metro</button>
            <button class="bs-sz flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-w="10" data-h="10">10x10</button>
            <button class="bs-sz flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-w="10" data-h="30">10x30</button>
            <button class="bs-sz flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-w="15" data-h="15">15x15</button>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label><input type="number" id="bs-waste" class="bs-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="25" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fliesenpreis (&euro;/m&sup2;)</label><input type="number" id="bs-price" class="bs-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Fliesen</div>
          <div class="text-5xl font-extrabold font-mono" id="bs-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fläche</div><div class="text-lg font-bold font-mono" id="bs-area">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fliesenkosten</div><div class="text-lg font-bold font-mono" id="bs-cost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fugenmasse (kg)</div><div class="text-lg font-bold font-mono" id="bs-grout">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kleber (Säcke)</div><div class="text-xl font-bold font-mono" id="bs-adhesive">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtschätzung</div><div class="text-xl font-bold font-mono" id="bs-total">0 &euro;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="backsplash" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let bsTileW = 7.5, bsTileH = 15;
    function calcBS() {
      const len = parseFloat((document.getElementById('bs-len') as HTMLInputElement).value) || 0;
      const ht = parseFloat((document.getElementById('bs-ht') as HTMLInputElement).value) || 0;
      const waste = parseFloat((document.getElementById('bs-waste') as HTMLInputElement).value) || 0;
      const pricePerSqm = parseFloat((document.getElementById('bs-price') as HTMLInputElement).value) || 0;
      const areaSqCm = len * ht;
      const areaSqM = areaSqCm / 10000;
      const tileSqCm = bsTileW * bsTileH;
      const baseTiles = tileSqCm > 0 ? Math.ceil(areaSqCm / tileSqCm) : 0;
      const totalTiles = Math.ceil(baseTiles * (1 + waste / 100));
      const tileCost = areaSqM * pricePerSqm * (1 + waste / 100);
      const groutKg = areaSqM * 0.5;
      const adhesiveBags = Math.ceil(areaSqM / 5);
      const installCost = areaSqM * 35;
      document.getElementById('bs-result')!.textContent = totalTiles.toLocaleString('de-DE');
      document.getElementById('bs-area')!.textContent = areaSqM.toFixed(2).replace('.', ',') + ' m\u00B2';
      document.getElementById('bs-cost')!.textContent = tileCost.toFixed(0) + ' \u20AC';
      document.getElementById('bs-grout')!.textContent = groutKg.toFixed(1).replace('.', ',');
      document.getElementById('bs-adhesive')!.textContent = adhesiveBags.toString();
      document.getElementById('bs-total')!.textContent = (tileCost + installCost + groutKg * 3 + adhesiveBags * 12).toFixed(0) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bs-sz').forEach(b => b.addEventListener('click', () => {
        bsTileW = parseFloat((b as HTMLButtonElement).dataset.w!);
        bsTileH = parseFloat((b as HTMLButtonElement).dataset.h!);
        document.querySelectorAll('.bs-sz').forEach(btn => {
          const active = parseFloat((btn as HTMLButtonElement).dataset.w!) === bsTileW && parseFloat((btn as HTMLButtonElement).dataset.h!) === bsTileH;
          (btn as HTMLButtonElement).className = 'bs-sz flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        calcBS();
      }));
      document.querySelectorAll('.bs-in').forEach(el => { el.addEventListener('input', calcBS); el.addEventListener('change', calcBS); });
      calcBS();
    }, 50);
  </script>
</CalculatorLayout>
