---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Einmach-Rechner - Gl\u00e4ser & Verarbeitungszeit";
const description = "Berechnen Sie, wie viele Einmachgl\u00e4ser Sie brauchen, Verarbeitungszeiten und Zucker- oder Essigmengen f\u00fcr g\u00e4ngige Einmachrezepte.";
const relatedCalcs = [
  { name: "Kuchenform-Umrechner", url: "/de/kuchenform-umrechner", description: "Backformen umrechnen." },
  { name: "Karamell-Rechner", url: "/de/karamell-rechner", description: "Karamell." },
  { name: "Kerzenherstellung", url: "/de/kerzenherstellung-rechner", description: "Kerzen." },
  { name: "Kuchen-Portionen", url: "/de/kuchen-portionen-rechner", description: "Kuchengr\u00f6\u00dfe." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorien." },
  { name: "Kaloriendefizit", url: "/de/kaloriendefizit-rechner", description: "Defizit." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Einmach-Rechner" lang="de" enSlug="canning-calculator" keywords="einmach rechner, einmachgl\u00e4ser, verarbeitungszeit, einmachrezept, konservieren, einmach anleitung" breadcrumbs={[{ name: "Einmach-Rechner", url: "/de/einmach-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Einmach-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die ben&ouml;tigten Gl&auml;ser, Verarbeitungszeiten und Zutatenmengen f&uuml;rs Einmachen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Obst-/Gem&uuml;seart</label>
          <select id="em-produce" class="em-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="tomato">Tomaten (Salsa/So&szlig;e)</option>
            <option value="peach">Pfirsiche</option>
            <option value="apple">Apfelmus</option>
            <option value="cucumber">Gurken (Essigeinlagen)</option>
            <option value="berry">Beeren (Marmelade)</option>
            <option value="pepper">Paprika (Scharfe So&szlig;e)</option>
            <option value="green_bean">Gr&uuml;ne Bohnen</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Menge (kg)</label>
            <input type="number" id="em-amount" class="em-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" min="0" step="0.5">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Glasgr&ouml;&szlig;e</label>
            <select id="em-jar" class="em-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="250">Kleines Glas (250ml)</option>
              <option value="500" selected>Mittleres Glas (500ml)</option>
              <option value="1000">Gro&szlig;es Glas (1L)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ben&ouml;tigte Gl&auml;ser</div>
          <div class="text-5xl font-extrabold font-mono" id="em-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verarbeitungszeit</div><div class="text-xl font-bold font-mono" id="em-time">0 Min.</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zucker</div><div class="text-xl font-bold font-mono" id="em-sugar">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Essig</div><div class="text-xl font-bold font-mono" id="em-vinegar">0 ml</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Methode</div><div class="text-xl font-bold font-mono" id="em-method">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ertrag</div><div class="text-xl font-bold font-mono" id="em-yield">-</div></div>
        </div>
      </div>
      <ShareButton calculatorId="canning" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Welche Methode ist die richtige?</h3>
      <p>S&auml;urehaltige Lebensmittel (Tomaten, Obst, Gurken) k&ouml;nnen im Wasserbad eingekocht werden. S&auml;urearme Lebensmittel (gr&uuml;ne Bohnen, Fleisch) ben&ouml;tigen einen Druckeinkochkessel.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcEM() {
      const produce = (document.getElementById('em-produce') as HTMLSelectElement).value;
      const amount = parseFloat((document.getElementById('em-amount') as HTMLInputElement).value) || 0;
      const jarMl = parseFloat((document.getElementById('em-jar') as HTMLSelectElement).value) || 500;
      // Yield: approximate liters per kg of raw produce
      const yieldPerKg: Record<string, number> = {
        tomato: 1.1, peach: 1.2, apple: 1.1, cucumber: 1.1,
        berry: 1.0, pepper: 1.3, green_bean: 1.1
      };
      const procTime: Record<string, Record<number, number>> = {
        tomato:     { 250: 35, 500: 40, 1000: 45 },
        peach:      { 250: 20, 500: 25, 1000: 30 },
        apple:      { 250: 15, 500: 20, 1000: 20 },
        cucumber:   { 250: 10, 500: 15, 1000: 15 },
        berry:      { 250: 10, 500: 15, 1000: 15 },
        pepper:     { 250: 10, 500: 15, 1000: 15 },
        green_bean: { 250: 20, 500: 25, 1000: 25 }
      };
      const sugarPerKg: Record<string, number> = {
        tomato: 0, peach: 150, apple: 100, cucumber: 0,
        berry: 375, pepper: 0, green_bean: 0
      };
      const vinegarPerKg: Record<string, number> = {
        tomato: 50, peach: 0, apple: 0, cucumber: 250,
        berry: 0, pepper: 200, green_bean: 50
      };
      const method: Record<string, string> = {
        tomato: 'Wasserbad', peach: 'Wasserbad', apple: 'Wasserbad',
        cucumber: 'Wasserbad', berry: 'Wasserbad', pepper: 'Wasserbad',
        green_bean: 'Druckeinkochkessel'
      };
      const litersYield = amount * (yieldPerKg[produce] || 1.1);
      const mlYield = litersYield * 1000;
      const jarsNeeded = Math.ceil(mlYield / jarMl);
      const time = procTime[produce]?.[jarMl] || 20;
      const sugar = amount * (sugarPerKg[produce] || 0);
      const vinegar = amount * (vinegarPerKg[produce] || 0);
      const jarName = jarMl === 250 ? 'kleine Gl\u00e4ser' : jarMl === 500 ? 'mittlere Gl\u00e4ser' : 'gro\u00dfe Gl\u00e4ser';
      document.getElementById('em-result')!.textContent = jarsNeeded + ' ' + jarName;
      document.getElementById('em-time')!.textContent = time + ' Min.';
      document.getElementById('em-sugar')!.textContent = sugar > 0 ? Math.round(sugar) + ' g' : 'Entf.';
      document.getElementById('em-vinegar')!.textContent = vinegar > 0 ? Math.round(vinegar) + ' ml' : 'Entf.';
      document.getElementById('em-method')!.textContent = method[produce] || 'Wasserbad';
      document.getElementById('em-yield')!.textContent = litersYield.toFixed(1).replace('.', ',') + ' Liter';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.em-in').forEach(el => { el.addEventListener('input', calcEM); el.addEventListener('change', calcEM); });
      calcEM();
    }, 50);
  </script>
</CalculatorLayout>
