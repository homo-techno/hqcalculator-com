---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Blutvolumenrechner - Nadler-Gleichung";
const description = "Schätzen Sie das Gesamtblutvolumen mit der Nadler-Gleichung basierend auf Größe, Gewicht und Geschlecht. Zeigt Plasma- und Erythrozytenvolumen.";
const relatedCalcs = [
  { name: "Körperwasserrechner", url: "/de/koerperwasser-rechner", description: "Gesamtkörperwasser." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Blutspenderechner", url: "/de/blutspende-rechner", description: "Spendeberechtigung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Blutvolumenrechner" lang="de" keywords="blutvolumen, nadler gleichung, plasmavolumen, erythrozytenvolumen, hämatokrit" breadcrumbs={[{ name: "Blutvolumen", url: "/de/blutvolumen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Blutvolumenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie das Gesamtblutvolumen mit der Nadler-Gleichung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
          <select id="bv-sex" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="male" selected>Männlich</option>
            <option value="female">Weiblich</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Größe (cm)</label><input type="number" id="bv-ht" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="175" min="50" max="250" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="bv-wt" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="10" max="300" step="0.1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hämatokrit (%)</label>
          <input type="number" id="bv-hct" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="10" max="70" step="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätztes Blutvolumen</div>
          <div class="text-5xl font-extrabold font-mono" id="bv-total">0</div>
          <div class="text-sm text-blue-200 mt-1">Liter</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Plasmavolumen</div><div class="text-xl font-bold" id="bv-plasma">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erythrozytenvolumen</div><div class="text-xl font-bold" id="bv-rbc">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ml pro kg</div><div class="text-xl font-bold" id="bv-mlkg">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Normales Blutvolumen</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Erwachsener Mann</span><span class="font-bold">ca. 5,0 L (70 ml/kg)</span></div>
            <div class="flex justify-between"><span>Erwachsene Frau</span><span class="font-bold">ca. 4,0 L (65 ml/kg)</span></div>
            <div class="flex justify-between"><span>Neugeborenes</span><span class="font-bold">ca. 80 ml/kg</span></div>
            <div class="flex justify-between"><span>Schwangere</span><span class="font-bold">ca. 100 ml/kg</span></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="blood-volume" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Nadler-Gleichung</h2>
      <p>Die Nadler-Gleichung schätzt das Gesamtblutvolumen. Für Männer: BV = 0,3669 x H³ + 0,03219 x W + 0,6041. Für Frauen: BV = 0,3561 x H³ + 0,03308 x W + 0,1833. Größe in Metern, Gewicht in kg, Ergebnis in Litern.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBV() {
      const sex = (document.getElementById('bv-sex') as HTMLSelectElement).value;
      const ht = parseFloat((document.getElementById('bv-ht') as HTMLInputElement).value) || 0;
      const wt = parseFloat((document.getElementById('bv-wt') as HTMLInputElement).value) || 0;
      const hct = parseFloat((document.getElementById('bv-hct') as HTMLInputElement).value) || 45;
      const hm = ht / 100;
      let bv: number;
      if (sex === 'male') {
        bv = 0.3669 * Math.pow(hm, 3) + 0.03219 * wt + 0.6041;
      } else {
        bv = 0.3561 * Math.pow(hm, 3) + 0.03308 * wt + 0.1833;
      }
      const plasma = bv * (1 - hct / 100);
      const rbc = bv * (hct / 100);
      const mlkg = wt > 0 ? (bv * 1000) / wt : 0;
      document.getElementById('bv-total')!.textContent = bv.toFixed(2).replace('.', ',');
      document.getElementById('bv-plasma')!.textContent = plasma.toFixed(2).replace('.', ',') + ' L';
      document.getElementById('bv-rbc')!.textContent = rbc.toFixed(2).replace('.', ',') + ' L';
      document.getElementById('bv-mlkg')!.textContent = mlkg.toFixed(0);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bv-in').forEach(el => { el.addEventListener('input', calcBV); el.addEventListener('change', calcBV); });
      calcBV();
    }, 50);
  </script>
</CalculatorLayout>
