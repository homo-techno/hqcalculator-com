---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Stoffbreite-Rechner - Schnittmuster-Layout & Meterbedarf";
const description = "Optimieren Sie das Schnittmuster-Layout für verschiedene Stoffbreiten (90, 140, 150 cm). Vergleichen Sie Meterbedarf und finden Sie das effizienteste Layout.";
const relatedCalcs = [
  { name: "Stoff-Rechner", url: "/de/stoff-rechner", description: "Stoffbedarf berechnen." },
  { name: "Stoffschrumpfung", url: "/de/stoffschrumpfung-rechner", description: "Einlaufberechnung." },
  { name: "Mode-Aufschlag-Rechner", url: "/de/mode-aufschlag-rechner", description: "Mode-Preiskalkulation." },
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Stoffbreite-Rechner" lang="de" enSlug="fabric-width-calculator" keywords="stoffbreite rechner, schnittmuster layout, metervergleich, 90 140 150 cm stoff, stoffoptimierung" breadcrumbs={[{ name: "Stoffbreite-Rechner", url: "/de/stoffbreite-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stoffbreite-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Schnittmuster-Layouts über verschiedene Stoffbreiten, um den effizientesten Meterbedarf zu finden.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Schnitteil-Breite (cm)</label><input type="number" id="sbde-pw" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="1" max="150" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Schnitteil-L&auml;nge (cm)</label><input type="number" id="sbde-pl" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="1" max="200" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Schnitteile</label><input type="number" id="sbde-pieces" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nahtzugabe (cm)</label><input type="number" id="sbde-seam" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.5" min="0" max="5" step="0.5"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Breite 1 (cm)</label><input type="number" id="sbde-w1" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="110" min="50" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite 2 (cm)</label><input type="number" id="sbde-w2" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="140" min="50" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite 3 (cm)</label><input type="number" id="sbde-w3" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="50" step="1"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Preis/m (Breite 1)</label><input type="number" id="sbde-p1" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis/m (Breite 2)</label><input type="number" id="sbde-p2" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="14" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis/m (Breite 3)</label><input type="number" id="sbde-p3" class="sbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="16" min="0" step="0.5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Bester Preis</div>
          <div class="text-4xl font-extrabold font-mono" id="sbde-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="sbde-l1">110 cm Breite</div>
            <div class="text-xl font-bold font-mono" id="sbde-y1">--</div>
            <div class="text-xs text-text-muted" id="sbde-c1">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="sbde-l2">140 cm Breite</div>
            <div class="text-xl font-bold font-mono" id="sbde-y2">--</div>
            <div class="text-xs text-text-muted" id="sbde-c2">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase" id="sbde-l3">150 cm Breite</div>
            <div class="text-xl font-bold font-mono" id="sbde-y3">--</div>
            <div class="text-xs text-text-muted" id="sbde-c3">--</div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschnitt (B1)</div><div class="text-xl font-bold font-mono" id="sbde-waste1">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschnitt (B2)</div><div class="text-xl font-bold font-mono" id="sbde-waste2">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschnitt (B3)</div><div class="text-xl font-bold font-mono" id="sbde-waste3">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fabric-width-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Stoffbreite optimal nutzen</h2>
      <p>Verschiedene Stoffbreiten beeinflussen den Meterbedarf erheblich. Breitere Stoffe sind pro Meter teurer, aber man benötigt weniger davon.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Stoffbreite ist am günstigsten?</strong> Das hängt vom Schnittmuster ab. Nutzen Sie diesen Rechner, um alle Optionen zu vergleichen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcSBDE() {
      const pw = parseFloat((document.getElementById('sbde-pw') as HTMLInputElement).value) || 45;
      const pl = parseFloat((document.getElementById('sbde-pl') as HTMLInputElement).value) || 75;
      const pieces = parseInt((document.getElementById('sbde-pieces') as HTMLInputElement).value) || 6;
      const seam = parseFloat((document.getElementById('sbde-seam') as HTMLInputElement).value) || 1.5;
      const widths = [
        parseFloat((document.getElementById('sbde-w1') as HTMLInputElement).value) || 110,
        parseFloat((document.getElementById('sbde-w2') as HTMLInputElement).value) || 140,
        parseFloat((document.getElementById('sbde-w3') as HTMLInputElement).value) || 150
      ];
      const prices = [
        parseFloat((document.getElementById('sbde-p1') as HTMLInputElement).value) || 0,
        parseFloat((document.getElementById('sbde-p2') as HTMLInputElement).value) || 0,
        parseFloat((document.getElementById('sbde-p3') as HTMLInputElement).value) || 0
      ];
      const cutW = pw + seam * 2;
      const cutL = pl + seam * 2;
      const results: Array<{ meters: number; cost: number; waste: number }> = [];
      for (let i = 0; i < 3; i++) {
        const fabW = widths[i];
        const usableWidth = fabW - 2;
        const piecesAcross = Math.max(1, Math.floor(usableWidth / cutW));
        const rows = Math.ceil(pieces / piecesAcross);
        const totalLengthCm = rows * cutL;
        const meters = totalLengthCm / 100;
        const fabricArea = meters * 100 * fabW;
        const usedArea = pieces * cutW * cutL;
        const wastePct = ((fabricArea - usedArea) / fabricArea * 100);
        const cost = meters * prices[i];
        results.push({ meters, cost, waste: wastePct });
      }
      let bestIdx = 0;
      let bestCost = Infinity;
      for (let i = 0; i < 3; i++) {
        if (prices[i] > 0 && results[i].cost < bestCost) {
          bestCost = results[i].cost;
          bestIdx = i;
        }
      }
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('sbde-result')!.textContent = widths[bestIdx] + ' cm (' + fmtEur(results[bestIdx].cost) + ')';
      for (let i = 0; i < 3; i++) {
        document.getElementById('sbde-l' + (i + 1))!.textContent = widths[i] + ' CM BREITE';
        document.getElementById('sbde-y' + (i + 1))!.textContent = results[i].meters.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m';
        document.getElementById('sbde-c' + (i + 1))!.textContent = fmtEur(results[i].cost);
        document.getElementById('sbde-waste' + (i + 1))!.textContent = results[i].waste.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sbde-in').forEach(el => { el.addEventListener('input', calcSBDE); el.addEventListener('change', calcSBDE); });
      calcSBDE();
    }, 50);
  </script>
</CalculatorLayout>
