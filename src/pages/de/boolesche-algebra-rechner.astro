---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Boolesche Algebra Rechner - Logikgatter Wahrheitstabelle";
const description = "Boolesche Logikoperationen mit zwei Eingängen auswerten. Zeigt AND, OR, XOR, NOT, NAND, NOR Ergebnisse in einer vollständigen Wahrheitstabelle.";
const relatedCalcs = [
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwerte." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Booklet-Ausschießung-Rechner", url: "/de/booklet-ausschiessung-rechner", description: "Ausschießung." },
  { name: "Bäckerprozent-Rechner", url: "/de/baeckerprozent-rechner", description: "Bäckerprozente." },
  { name: "BPM-Rechner", url: "/de/bpm-rechner", description: "Beats pro Minute." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Boolesche Algebra Rechner" enSlug="boolean-algebra-calculator" keywords="Boolesche Algebra Rechner, Logikgatter, Wahrheitstabelle, AND OR XOR NOT NAND NOR, Boolesche Logik" breadcrumbs={[{ name: "Boolesche-Algebra-Rechner", url: "/de/boolesche-algebra-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Boolesche Algebra Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Boolesche Logikoperationen (AND, OR, XOR, NOT, NAND, NOR) mit interaktiver Wahrheitstabelle auswerten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Eingang A</label>
            <select id="bl-a" class="bl-in w-full px-4 py-2 border border-border rounded-xl text-lg">
              <option value="1" selected>Wahr (1)</option>
              <option value="0">Falsch (0)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Eingang B</label>
            <select id="bl-b" class="bl-in w-full px-4 py-2 border border-border rounded-xl text-lg">
              <option value="1">Wahr (1)</option>
              <option value="0" selected>Falsch (0)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">A UND B</div>
          <div class="text-5xl font-extrabold font-mono" id="bl-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A UND B</div><div class="text-xl font-bold" id="bl-and">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A ODER B</div><div class="text-xl font-bold" id="bl-or">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A XOR B</div><div class="text-xl font-bold" id="bl-xor">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">NICHT A</div><div class="text-xl font-bold" id="bl-nota">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">NICHT B</div><div class="text-xl font-bold" id="bl-notb">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A NAND B</div><div class="text-xl font-bold" id="bl-nand">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A NOR B</div><div class="text-xl font-bold" id="bl-nor">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A XNOR B</div><div class="text-xl font-bold" id="bl-xnor">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">A &rarr; B (Implikation)</div><div class="text-xl font-bold" id="bl-impl">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Vollständige Wahrheitstabelle</h3>
          <div class="text-sm text-text-secondary font-mono whitespace-pre-wrap" id="bl-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="boolesche-algebra" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Boolesche Logikoperationen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>UND (AND):</strong> Wahr nur wenn beide Eingänge wahr sind</p>
        <p><strong>ODER (OR):</strong> Wahr wenn mindestens ein Eingang wahr ist</p>
        <p><strong>XOR:</strong> Wahr wenn genau ein Eingang wahr ist</p>
        <p><strong>NAND:</strong> NICHT UND &mdash; falsch nur wenn beide Eingänge wahr sind</p>
        <p><strong>NOR:</strong> NICHT ODER &mdash; wahr nur wenn beide Eingänge falsch sind</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist Boolesche Algebra?</strong> Die Boolesche Algebra ist die Grundlage der digitalen Logik und Computertechnik. Sie arbeitet mit den Werten Wahr (1) und Falsch (0).</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBL() {
      const a = parseInt((document.getElementById('bl-a') as HTMLSelectElement).value);
      const b = parseInt((document.getElementById('bl-b') as HTMLSelectElement).value);
      const andR = a & b;
      const orR = a | b;
      const xorR = a ^ b;
      const notA = a ? 0 : 1;
      const notB = b ? 0 : 1;
      const nandR = andR ? 0 : 1;
      const norR = orR ? 0 : 1;
      const xnorR = xorR ? 0 : 1;
      const implR = (!a || b) ? 1 : 0;
      const tf = (v: number) => v ? 'Wahr (1)' : 'Falsch (0)';
      document.getElementById('bl-result')!.textContent = tf(andR);
      document.getElementById('bl-and')!.textContent = tf(andR);
      document.getElementById('bl-or')!.textContent = tf(orR);
      document.getElementById('bl-xor')!.textContent = tf(xorR);
      document.getElementById('bl-nota')!.textContent = tf(notA);
      document.getElementById('bl-notb')!.textContent = tf(notB);
      document.getElementById('bl-nand')!.textContent = tf(nandR);
      document.getElementById('bl-nor')!.textContent = tf(norR);
      document.getElementById('bl-xnor')!.textContent = tf(xnorR);
      document.getElementById('bl-impl')!.textContent = tf(implR);
      let table = ' A | B | UND | ODER | XOR | NAND | NOR | XNOR\n';
      table += '-'.repeat(52) + '\n';
      for (let i = 0; i <= 1; i++) {
        for (let j = 0; j <= 1; j++) {
          const marker = (i === a && j === b) ? ' \u25C4' : '';
          table += ' ' + i + ' | ' + j + ' |  ' + (i & j) + '  |   ' + (i | j) + '  |  ' + (i ^ j) + '  |   ' + ((i & j) ? 0 : 1) + '  |  ' + ((i | j) ? 0 : 1) + '  |   ' + ((i ^ j) ? 0 : 1) + marker + '\n';
        }
      }
      document.getElementById('bl-table')!.textContent = table;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bl-in').forEach(el => { el.addEventListener('input', calcBL); el.addEventListener('change', calcBL); });
      calcBL();
    }, 50);
  </script>
</CalculatorLayout>
