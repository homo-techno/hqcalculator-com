---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Geländegradierung Rechner";
const description = "Berechnen Sie Aushub-, Aufschüttungs- und Planiermengen für Grundstücke.";

const relatedCalcs = [
  { name: "Grundstücksfläche Rechner", url: "/de/grundstuecksflaeche-rechner", description: "Fläche berechnen." },
  { name: "Grundstückswert Rechner", url: "/de/grundstueckswert-rechner", description: "Grundstückswert schätzen." },
  { name: "Koi-Teich Rechner", url: "/de/koi-teich-rechner", description: "Teich planen." },
  { name: "Küchen-Renovierung Rechner", url: "/de/kuechen-renovierung-rechner", description: "Renovierungskosten schätzen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Geländegradierung Rechner" lang="de" enSlug="land-grading-calculator" keywords="geländegradierung rechner, aushub berechnen, planierung kosten, erdarbeiten berechnen" breadcrumbs={[{ name: "Geländegradierung Rechner", url: "/de/gelaendegradierung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Geländegradierung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Aushub-, Aufschüttungs- und Planiermengen sowie die Kosten für Erdarbeiten auf Ihrem Grundstück.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fläche (m²)</label><input type="number" id="ggr-area" class="ggr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Höhenunterschied (m)</label><input type="number" id="ggr-height" class="ggr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.5" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bodenart</label><select id="ggr-soil" class="ggr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.4">Sand / Kies (1,4 t/m³)</option>
            <option value="1.6" selected>Lehm / Ton (1,6 t/m³)</option>
            <option value="1.8">Schotter (1,8 t/m³)</option>
            <option value="2.0">Fels (2,0 t/m³)</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Schwellfaktor (%)</label><input type="number" id="ggr-swell" class="ggr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="50" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kosten Aushub (€/m³)</label><input type="number" id="ggr-excav-cost" class="ggr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kosten Verfüllung (€/m³)</label><input type="number" id="ggr-fill-cost" class="ggr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten</div>
          <div class="text-4xl font-extrabold font-mono" id="ggr-total">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aushub (m³)</div><div class="text-xl font-bold" id="ggr-vol">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Masse (t)</div><div class="text-xl font-bold" id="ggr-mass">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">LKW-Ladungen</div><div class="text-xl font-bold" id="ggr-trucks">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="land-grading-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Geländegradierung – Erdarbeiten planen</h2>
      <p>Geländegradierung bezeichnet das Planieren und Egalisieren von Grundstücken. Dabei wird Erdmaterial abgetragen (Aushub) oder aufgefüllt (Aufschüttung). Für Bauvorhaben ist ein gleichmäßiges Gelände Voraussetzung. Der Schwellfaktor berücksichtigt, dass gelockertes Erdmaterial ein größeres Volumen einnimmt als gewachsener Boden – typischerweise 15–25 % mehr.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Schwellfaktor?</strong> Wenn Boden ausgegraben wird, lockert er sich auf und nimmt mehr Volumen ein. Der Schwellfaktor gibt diesen Volumenzuwachs in Prozent an (z. B. 20 % = 1 m³ gewachsener Boden ergibt 1,2 m³ Schüttvolumen).</p>
      <p><strong>Wie viel Erde passt auf einen LKW?</strong> Ein Standard-Kipper (10-Tonner) fasst ca. 6–8 m³ Erdmaterial oder 8–12 Tonnen, je nach Bodenart.</p>
      <p><strong>Brauche ich eine Genehmigung für Erdarbeiten?</strong> Bei Abgrabungen über 1 m Tiefe oder großen Mengen ist in vielen Bundesländern eine Genehmigung erforderlich. Prüfen Sie die lokale Bauordnung.</p>
      <p><strong>Was kostet Aushub und Abtransport?</strong> Je nach Region und Bodenart kostet Aushub inklusive Abtransport 20–50 € pro Kubikmeter. Kontaminierter Boden kann deutlich teurer sein.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const ggrFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcGGR() {
      const area = parseFloat((document.getElementById('ggr-area') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('ggr-height') as HTMLInputElement).value) || 0;
      const density = parseFloat((document.getElementById('ggr-soil') as HTMLSelectElement).value) || 1.6;
      const swell = parseFloat((document.getElementById('ggr-swell') as HTMLInputElement).value) || 0;
      const excavCost = parseFloat((document.getElementById('ggr-excav-cost') as HTMLInputElement).value) || 0;
      const fillCost = parseFloat((document.getElementById('ggr-fill-cost') as HTMLInputElement).value) || 0;
      const vol = (area * height) / 2;
      const swellVol = vol * (1 + swell / 100);
      const mass = vol * density;
      const trucks = Math.ceil(mass / 10);
      const total = swellVol * excavCost + vol * fillCost;
      document.getElementById('ggr-total')!.textContent = ggrFmt(total);
      document.getElementById('ggr-vol')!.textContent = vol.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('ggr-mass')!.textContent = mass.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('ggr-trucks')!.textContent = trucks.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.ggr-in').forEach(el => { el.addEventListener('input', calcGGR); el.addEventListener('change', calcGGR); }); calcGGR(); }, 50);
  </script>
</CalculatorLayout>
