---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Babynahrungsrechner - Wie viel Säuglingsnahrung braucht Ihr Baby?";
const description = "Berechnen Sie die richtige Menge Säuglingsnahrung nach Alter, Gewicht und Fütterungshäufigkeit. Erhalten Sie Tagesmengen, Kostenschätzungen und Fütterungspläne.";

const relatedCalcs = [
  { name: "Windelkosten-Rechner", url: "/de/windelkosten-rechner", description: "Windelausgaben." },
  { name: "Muttermilch-Aufbewahrung", url: "/de/muttermilch-aufbewahrung-rechner", description: "Aufbewahrungsrichtlinien." },
  { name: "Kinderernährungsrechner", url: "/de/kinderernaehrung-rechner", description: "Täglicher Nährstoffbedarf." },
  { name: "Baby-Meilensteinrechner", url: "/de/baby-meilenstein-rechner", description: "Entwicklungsverfolgung." },
  { name: "Kinderdosierungsrechner", url: "/de/kinderdosierung-rechner", description: "Medikamentendosierung." },
  { name: "Kitakosten-Rechner", url: "/de/kitakosten-rechner", description: "Betreuungskosten." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Babynahrungsrechner"
  keywords="Babynahrung Rechner, Säuglingsnahrung Menge nach Alter, wie viel Säuglingsnahrung, Fütterungsplan, Babynahrung Kosten, Säuglingsnahrung Rechner"
  breadcrumbs={[{ name: "Babynahrungsrechner", url: "/de/babynahrung-rechner" }]}
  lang="de"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Babynahrungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Säuglingsnahrungsmengen, Fütterungshäufigkeit und monatliche Kosten basierend auf Alter und Gewicht Ihres Babys.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Alter des Babys (Monate)</label>
          <input type="number" id="bfm-age" class="bfm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="12" step="1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Gewicht des Babys (kg)</label>
          <input type="number" id="bfm-weight" class="bfm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.5" min="2" max="14" step="0.1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Nahrungstyp</label>
          <select id="bfm-type" class="bfm-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="powder" selected>Pulvernahrung (~0,08 &euro;/30ml zubereitet)</option>
            <option value="concentrate">Flüssigkonzentrat (~0,12 &euro;/30ml)</option>
            <option value="ready">Trinkfertig (~0,20 &euro;/30ml)</option>
            <option value="specialty">Spezial/Hypoallergen (~0,30 &euro;/30ml)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Fütterungsmethode</label>
          <select id="bfm-method" class="bfm-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="exclusive" selected>Ausschließlich Säuglingsnahrung</option>
            <option value="combo">Kombination (Stillen + Säuglingsnahrung)</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Täglicher Nahrungsbedarf</div>
        <div class="text-5xl font-extrabold" id="bfm-daily">--</div>
        <div class="text-sm text-blue-200 mt-1">ml pro Tag</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Pro Mahlzeit</div>
          <div class="text-lg font-bold" id="bfm-perfeed">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Mahlzeiten/Tag</div>
          <div class="text-lg font-bold" id="bfm-feeds">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Monatliche Kosten</div>
          <div class="text-lg font-bold" id="bfm-monthly">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Jährliche Kosten</div>
          <div class="text-lg font-bold" id="bfm-yearly">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Fütterungsplan-Leitfaden</h3>
        <div class="text-xs" id="bfm-schedule"></div>
      </div>

      <ShareButton calculatorId="baby-formula" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie viel Säuglingsnahrung braucht ein Baby?</h2>
      <p>Die allgemeine Regel ist etwa 150-200 ml Säuglingsnahrung pro Kilogramm Körpergewicht pro Tag, bis maximal ca. 1.000 ml. Jedes Baby ist jedoch unterschiedlich, daher konsultieren Sie immer Ihren Kinderarzt.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Richtwerte nach Alter</h3>
      <ul>
        <li><strong>Neugeboren (0-2 Wochen):</strong> 30-60 ml pro Mahlzeit, 8-12 Mal/Tag</li>
        <li><strong>1-2 Monate:</strong> 90-120 ml pro Mahlzeit, 6-8 Mal/Tag</li>
        <li><strong>3-4 Monate:</strong> 120-180 ml pro Mahlzeit, 5-6 Mal/Tag</li>
        <li><strong>5-6 Monate:</strong> 180-240 ml pro Mahlzeit, 4-5 Mal/Tag</li>
        <li><strong>7-12 Monate:</strong> 180-240 ml pro Mahlzeit, 3-4 Mal/Tag (mit Beikost)</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Sicherheitstipps für Säuglingsnahrung</h3>
      <ul>
        <li>Zubereitete Nahrung ist 1 Stunde bei Raumtemperatur haltbar</li>
        <li>Im Kühlschrank aufbewahrte zubereitete Nahrung hält 24 Stunden</li>
        <li>Geöffnete Pulverdosen sollten innerhalb von 30 Tagen verbraucht werden</li>
        <li>Nahrung nie in der Mikrowelle erwärmen -- stattdessen warmes Wasserbad verwenden</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcBFM() {
      const age = parseFloat((document.getElementById('bfm-age') as HTMLInputElement).value) || 0;
      const weightKg = parseFloat((document.getElementById('bfm-weight') as HTMLInputElement).value) || 5.5;
      const type = (document.getElementById('bfm-type') as HTMLSelectElement).value;
      const method = (document.getElementById('bfm-method') as HTMLSelectElement).value;

      const costPerMl: Record<string, number> = { powder: 0.0027, concentrate: 0.004, ready: 0.0067, specialty: 0.01 };

      function feedingsPerDay(m: number): number {
        if (m < 1) return 10;
        if (m < 3) return 7;
        if (m < 5) return 6;
        if (m < 7) return 5;
        return 4;
      }

      function mlPerFeeding(m: number): number {
        if (m < 0.5) return 45;
        if (m < 1) return 75;
        if (m < 3) return 120;
        if (m < 5) return 150;
        if (m < 7) return 210;
        return 210;
      }

      let dailyMl = Math.min(weightKg * 150, 1000);
      const feeds = feedingsPerDay(age);
      let perFeed = mlPerFeeding(age);

      if (dailyMl < perFeed * feeds) {
        dailyMl = perFeed * feeds;
      }
      dailyMl = Math.min(dailyMl, 1000);
      perFeed = Math.round(dailyMl / feeds);

      const comboFactor = method === 'combo' ? 0.5 : 1;
      dailyMl = Math.round(dailyMl * comboFactor);

      const monthlyCost = dailyMl * 30.44 * costPerMl[type];
      const yearlyCost = monthlyCost * 12;

      document.getElementById('bfm-daily')!.textContent = dailyMl.toLocaleString('de-DE');
      document.getElementById('bfm-perfeed')!.textContent = Math.round(perFeed * comboFactor).toLocaleString('de-DE') + ' ml';
      document.getElementById('bfm-feeds')!.textContent = String(feeds);
      document.getElementById('bfm-monthly')!.textContent = monthlyCost.toFixed(0) + ' \u20AC';
      document.getElementById('bfm-yearly')!.textContent = yearlyCost.toFixed(0) + ' \u20AC';

      const scheduleData = [
        { ageRange: '0-1 Mo.', ml: '60-90 ml', times: '8-10x', daily: '600-720 ml' },
        { ageRange: '1-3 Mo.', ml: '90-120 ml', times: '6-8x', daily: '600-840 ml' },
        { ageRange: '3-5 Mo.', ml: '120-180 ml', times: '5-6x', daily: '720-960 ml' },
        { ageRange: '5-7 Mo.', ml: '180-240 ml', times: '4-5x', daily: '720-960 ml' },
        { ageRange: '7-12 Mo.', ml: '180-240 ml', times: '3-4x', daily: '720-960 ml' },
      ];

      document.getElementById('bfm-schedule')!.innerHTML =
        '<div class="grid grid-cols-4 gap-2 font-semibold text-text-muted mb-1"><span>Alter</span><span>Pro Mahlzeit</span><span>Häufigkeit</span><span>Täglich</span></div>' +
        scheduleData.map((r, i) => {
          const highlight = (age < 1 && i === 0) || (age >= 1 && age < 3 && i === 1) || (age >= 3 && age < 5 && i === 2) || (age >= 5 && age < 7 && i === 3) || (age >= 7 && i === 4);
          return '<div class="grid grid-cols-4 gap-2 py-1 ' + (highlight ? 'bg-blue-50 rounded font-bold' : '') + '"><span>' + r.ageRange + '</span><span>' + r.ml + '</span><span>' + r.times + '</span><span>' + r.daily + '</span></div>';
        }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bfm-in').forEach(el => {
        el.addEventListener('input', calcBFM);
        el.addEventListener('change', calcBFM);
      });
      calcBFM();
    }, 50);
  </script>
</CalculatorLayout>
