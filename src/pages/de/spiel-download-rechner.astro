---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Spiel-Download-Rechner - Download-Zeit berechnen";
const description = "Berechnen Sie die Download-Zeit f\u00FCr Spiele aus Dateigr\u00F6\u00DFe und Verbindungsgeschwindigkeit, Bandbreitenverbrauch und Datenvolumen-Auswirkung.";
const relatedCalcs = [
  { name: "Internet-Geschwindigkeitsrechner", url: "/de/internet-geschwindigkeitsrechner", description: "Geschwindigkeitstest." },
  { name: "Video-Bitrate-Rechner", url: "/de/video-bitrate-rechner", description: "Bitrate-Berechnung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Stundenrechner", url: "/de/stundenrechner", description: "Zeitberechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Spiel-Download-Rechner" lang="de" enSlug="game-download-calculator" keywords="spiel download zeit, download geschwindigkeit rechner, bandbreitenverbrauch, datenvolumen, dateigr\u00F6\u00DFe download" breadcrumbs={[{ name: "Spiel-Download", url: "/de/spiel-download-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Spiel-Download-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie, wie lange ein Spiel-Download bei Ihrer Verbindungsgeschwindigkeit dauert.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Spiel-Dateigr&ouml;&szlig;e</label>
          <div class="flex gap-2">
            <input type="number" class="sdr-in flex-1 px-4 py-2 border border-border rounded-lg" id="sdr-size" min="0.1" step="0.1" value="80">
            <select class="sdr-in px-3 py-2 border border-border rounded-lg" id="sdr-unit">
              <option value="GB" selected>GB</option>
              <option value="MB">MB</option>
              <option value="TB">TB</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Download-Geschwindigkeit</label>
          <div class="flex gap-2">
            <input type="number" class="sdr-in flex-1 px-4 py-2 border border-border rounded-lg" id="sdr-speed" min="0.1" step="0.1" value="100">
            <select class="sdr-in px-3 py-2 border border-border rounded-lg" id="sdr-speedunit">
              <option value="Mbps" selected>Mbit/s</option>
              <option value="MBps">MB/s</option>
              <option value="Gbps">Gbit/s</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Overhead/Effizienz (%)</label>
          <input type="number" class="sdr-in w-full px-4 py-2 border border-border rounded-lg" id="sdr-eff" min="50" max="100" value="90">
          <p class="text-xs text-text-muted mt-1">Realer Durchsatz (TCP-Overhead, Auslastung usw.)</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Monatliches Datenvolumen (GB, 0=unbegrenzt)</label>
          <input type="number" class="sdr-in w-full px-4 py-2 border border-border rounded-lg" id="sdr-cap" min="0" value="0">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Download-Zeit</div>
          <div class="text-5xl font-extrabold font-mono" id="sdr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Effektive Geschwindigkeit</div>
            <div class="text-xl font-bold font-mono" id="sdr-effective">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Datenvolumen-Verbrauch</div>
            <div class="text-xl font-bold font-mono" id="sdr-capuse">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Geschwindigkeitsvergleich</h3>
          <div class="text-xs font-mono space-y-1" id="sdr-compare"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="game-download-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Download-Zeit berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Download-Zeit = Dateigr&ouml;&szlig;e / (Geschwindigkeit &times; Effizienz)</p>
        <p>Hinweis: Mbit/s &divide; 8 = MB/s</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum ist mein Download langsamer als angegeben?</strong> Die tats&auml;chliche Download-Geschwindigkeit liegt typischerweise bei 85-95% der Nenngeschwindigkeit durch TCP-Overhead, Netzauslastung und WLAN-Verluste.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSDR() {
      const size = parseFloat((document.getElementById('sdr-size') as HTMLInputElement).value) || 80;
      const sizeUnit = (document.getElementById('sdr-unit') as HTMLSelectElement).value;
      const speed = parseFloat((document.getElementById('sdr-speed') as HTMLInputElement).value) || 100;
      const speedUnit = (document.getElementById('sdr-speedunit') as HTMLSelectElement).value;
      const eff = parseFloat((document.getElementById('sdr-eff') as HTMLInputElement).value) || 90;
      const cap = parseFloat((document.getElementById('sdr-cap') as HTMLInputElement).value) || 0;
      let sizeMB = size;
      if (sizeUnit === 'GB') sizeMB = size * 1024;
      else if (sizeUnit === 'TB') sizeMB = size * 1024 * 1024;
      let speedMBps = speed;
      if (speedUnit === 'Mbps') speedMBps = speed / 8;
      else if (speedUnit === 'Gbps') speedMBps = speed * 1000 / 8;
      const effectiveMBps = speedMBps * (eff / 100);
      const totalSeconds = sizeMB / effectiveMBps;
      const hours = Math.floor(totalSeconds / 3600);
      const mins = Math.floor((totalSeconds % 3600) / 60);
      const secs = Math.floor(totalSeconds % 60);
      let timeStr = '';
      if (hours > 0) timeStr += hours + 'h ';
      if (mins > 0 || hours > 0) timeStr += mins + 'min ';
      timeStr += secs + 's';
      const sizeGB = sizeMB / 1024;
      const capUsePct = cap > 0 ? (sizeGB / cap * 100) : 0;
      document.getElementById('sdr-result')!.textContent = timeStr.trim();
      document.getElementById('sdr-effective')!.textContent = effectiveMBps.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' MB/s';
      document.getElementById('sdr-capuse')!.textContent = cap > 0 ? capUsePct.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + '% vom Volumen' : 'Unbegrenzt';
      const speeds = [
        { name: '16 Mbit/s', mbps: 16 / 8 },
        { name: '50 Mbit/s', mbps: 50 / 8 },
        { name: '100 Mbit/s', mbps: 100 / 8 },
        { name: '250 Mbit/s', mbps: 250 / 8 },
        { name: '500 Mbit/s', mbps: 500 / 8 },
        { name: '1 Gbit/s', mbps: 1000 / 8 },
      ];
      let html = '';
      for (const s of speeds) {
        const effS = s.mbps * (eff / 100);
        const sec = sizeMB / effS;
        const h = Math.floor(sec / 3600);
        const m = Math.floor((sec % 3600) / 60);
        let t = '';
        if (h > 0) t += h + 'h ';
        t += m + 'min';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + s.name + '</span><span>' + t.trim() + '</span></div>';
      }
      document.getElementById('sdr-compare')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sdr-in').forEach(el => { el.addEventListener('input', calcSDR); el.addEventListener('change', calcSDR); });
      calcSDR();
    }, 50);
  </script>
</CalculatorLayout>
