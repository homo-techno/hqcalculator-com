---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Mauermörtel Rechner - Mörtelmengen für Mauerwerksarbeiten";
const description = "Berechnen Sie Mörtelmengen für Mauerwerksarbeiten nach DIN-Norm. Zement, Sand und Wasser für Mauerziegel, Kalksandstein und Betonblöcke korrekt ermitteln.";
const relatedCalcs = [
  { name: "Mauerwerksanker Rechner", url: "/de/mauerwerksanker-rechner", description: "Ankertragfähigkeiten." },
  { name: "Betonrechner", url: "/de/betonrechner", description: "Betonmenge berechnen." },
  { name: "Fliesenrechner", url: "/de/fliesenrechner", description: "Fliesenmenge ermitteln." },
  { name: "Putzrechner", url: "/de/putzrechner", description: "Putzmengen berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="masonry-mortar-calculator" calculatorName="Mauermörtel Rechner" keywords="Mauermörtel Rechner, Mörtelverbrauch, Mörtelmengen Mauerwerk, Zementmörtel, DIN Mörtel berechnen" breadcrumbs={[{ name: "Mauermörtel Rechner", url: "/de/mauermoertel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Mauermörtel Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Mörtelverbrauch für Ihre Mauerwerksarbeiten – inkl. Zement-, Sand- und Wassermengen nach DIN EN 998.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wandfläche (m²)</label><input type="number" id="mm-area" class="mm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0.1" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wanddicke (cm)</label><input type="number" id="mm-thick" class="mm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="24" min="5" max="100" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Steinformat</label>
            <select id="mm-brick" class="mm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="NF" selected>NF – Normalformat (240×115×71mm)</option>
              <option value="DF">DF – Dünnformat (240×115×52mm)</option>
              <option value="2DF">2DF – Doppelformat (240×115×113mm)</option>
              <option value="KS">KS-Modul (250×120×250mm)</option>
              <option value="PP">Porenbetonstein (600×200×300mm)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Mörtelgruppe</label>
            <select id="mm-group" class="mm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="M2.5">M 2,5 (Leichtmörtel)</option>
              <option value="M5" selected>M 5 (Normalmörtel)</option>
              <option value="M10">M 10 (Normalmörtel)</option>
              <option value="M20">M 20 (Schwermörtel)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Mörtelverbrauch</div>
          <div class="text-5xl font-extrabold font-mono" id="mm-total">--</div>
          <div class="text-sm text-blue-200 mt-1">Liter Frischmörtel</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zement (kg)</div><div class="text-xl font-bold" id="mm-cement">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sand (kg)</div><div class="text-xl font-bold" id="mm-sand">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser (L)</div><div class="text-xl font-bold" id="mm-water">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Steinanzahl</div><div class="text-xl font-bold" id="mm-bricks">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Säcke Trockenmörtel (25 kg)</div><div class="text-xl font-bold" id="mm-bags">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="mauermoertel" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Mörtelverbrauch bei Mauerwerksarbeiten</h2>
      <p>Der Mörtelverbrauch beim Mauern beträgt je nach Steinformat zwischen 25 und 50 Liter pro Quadratmeter Wandfläche. Bei NF-Steinen (Normalformat) werden ca. 50–55 Steine pro m² benötigt, bei Großformaten deutlich weniger. Mörtelgruppe M 5 eignet sich für normale Hochbauarbeiten; M 10 oder M 20 sind für tragende Wände und höhere Belastungen erforderlich. Planen Sie 10 % Verschnitt und Verluste ein.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Mörtel brauche ich für 1 m² Mauerwerk?</strong> Der Verbrauch liegt je nach Steinformat und Fugendicke bei 25–50 Litern Frischmörtel pro m² Wandfläche.</p>
      <p><strong>Was ist Mörtelgruppe M 5?</strong> M 5 bezeichnet Normalmörtel mit einer Druckfestigkeit von 5 N/mm². Er eignet sich für Wohnhausbau, nicht tragende Wände und Füllmauerwerk.</p>
      <p><strong>Wie mische ich Zementmörtel für Mauerwerk?</strong> Typisches Mischverhältnis für M 5: 1 Teil Zement zu 4 Teilen Sand (gewichtsbezogen). Der Wassergehalt liegt bei 0,6–0,8 Litern pro kg Zement.</p>
      <p><strong>Kann ich Fertigmörtel aus dem Sack verwenden?</strong> Ja. Trockenmörtel in 25-kg-Säcken ist praktisch für kleinere Arbeiten. Ein 25-kg-Sack ergibt ca. 16 Liter Frischmörtel.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const mmBrickData: Record<string, { stueck: number; fugePct: number }> = {
      NF: { stueck: 52, fugePct: 0.22 }, DF: { stueck: 64, fugePct: 0.18 },
      '2DF': { stueck: 32, fugePct: 0.20 }, KS: { stueck: 8, fugePct: 0.16 }, PP: { stueck: 6, fugePct: 0.10 }
    };
    const mmGroupMix: Record<string, { cement: number; sand: number }> = {
      M2_5: { cement: 1, sand: 6 }, M5: { cement: 1, sand: 4 }, M10: { cement: 1, sand: 3 }, M20: { cement: 1, sand: 2 }
    };
    function calcMM() {
      const area = parseFloat((document.getElementById('mm-area') as HTMLInputElement).value) || 0;
      const thick = parseFloat((document.getElementById('mm-thick') as HTMLInputElement).value) || 24;
      const brick = (document.getElementById('mm-brick') as HTMLSelectElement).value;
      const group = (document.getElementById('mm-group') as HTMLSelectElement).value;
      const bdata = mmBrickData[brick] || { stueck: 52, fugePct: 0.22 };
      const mix = mmGroupMix[group] || { cement: 1, sand: 4 };
      const bricks = Math.ceil(area * bdata.stueck * (thick / 24) * 1.05);
      const mortarL = area * thick / 100 * 1000 * bdata.fugePct;
      const densityMix = 1.8;
      const mortarKg = mortarL * densityMix / 1000;
      const totalParts = mix.cement + mix.sand;
      const cementKg = (mortarKg / totalParts) * mix.cement;
      const sandKg = (mortarKg / totalParts) * mix.sand;
      const waterL = cementKg * 0.7;
      const bags = Math.ceil(mortarKg * 1.1 / 25);
      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE');
      document.getElementById('mm-total')!.textContent = mortarL > 0 ? fmt(mortarL) : '--';
      document.getElementById('mm-cement')!.textContent = cementKg > 0 ? fmt(cementKg) : '--';
      document.getElementById('mm-sand')!.textContent = sandKg > 0 ? fmt(sandKg) : '--';
      document.getElementById('mm-water')!.textContent = waterL > 0 ? fmt(waterL) : '--';
      document.getElementById('mm-bricks')!.textContent = bricks > 0 ? fmt(bricks) : '--';
      document.getElementById('mm-bags')!.textContent = bags > 0 ? bags.toString() : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mm-in').forEach(el => { el.addEventListener('input', calcMM); el.addEventListener('change', calcMM); });
      calcMM();
    }, 50);
  </script>
</CalculatorLayout>
