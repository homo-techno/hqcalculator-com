---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Getriebe\u00FCbersetzung-Rechner - Motor-Last-Anpassung";
const description = "Optimale Getriebe\u00FCbersetzung f\u00FCr Motor-Drehzahl und Drehmoment-Anpassung berechnen. Inkl. Wirkungsgrad, reflektiertes Massentr\u00E4gkeitsmoment und Ausgangsberechnungen.";
const relatedCalcs = [
  { name: "Getriebe-Rechner", url: "/de/getriebe-rechner", description: "Zahnradberechnungen." },
  { name: "\u00DCbersetzungsverh\u00E4ltnis-Rechner", url: "/de/uebersetzungsverhaeltnis-rechner", description: "Getriebe\u00FCbersetzung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Getriebe\u00FCbersetzung-Rechner" lang="de" enSlug="gearbox-ratio-calculator" keywords="getriebe\u00FCbersetzung rechner, drehzahlreduktion, motor-last anpassung, drehmoment multiplikation, getriebe\u00FCbersetzung berechnen" breadcrumbs={[{ name: "Getriebe\u00FCbersetzung", url: "/de/getriebeubersetzung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Getriebe&uuml;bersetzung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Optimale Getriebe&uuml;bersetzung zur Anpassung des Motors an die Lastanforderungen berechnen. Ausgangsdrehmoment, Drehzahl und reflektiertes Massentr&auml;gheitsmoment ermitteln.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Motor-Nenndrehzahl (U/min)</label>
          <input type="number" id="gbu-motor-rpm" class="gbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3000" min="1" step="100">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Motor-Nenndrehmoment (N&middot;m)</label>
          <input type="number" id="gbu-motor-torque" class="gbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0.01" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Motor-Rotor-Massentr&auml;gheit (kg&middot;cm&sup2;)</label>
          <input type="number" id="gbu-motor-inertia" class="gbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.2" min="0.01" step="0.1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Erforderliche Last-Drehzahl (U/min)</label>
          <input type="number" id="gbu-load-rpm" class="gbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="10">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Erforderliches Last-Drehmoment (N&middot;m)</label>
          <input type="number" id="gbu-load-torque" class="gbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0.1" step="1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Last-Massentr&auml;gheit (kg&middot;cm&sup2;)</label>
          <input type="number" id="gbu-load-inertia" class="gbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0.01" step="1">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-2">Getriebewirkungsgrad (%)</label>
          <input type="number" id="gbu-eff" class="gbu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="95" min="50" max="100" step="1">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm font-medium opacity-80 mb-1">Erforderliche &Uuml;bersetzung</div>
          <div id="gbu-result-ratio" class="text-3xl sm:text-4xl font-extrabold">--</div>
          <div class="text-sm opacity-80 mt-1">:1 Reduktion</div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Ausgangsdrehmoment</div>
            <div id="gbu-output-torque" class="text-lg font-bold text-text">--</div>
            <div class="text-xs text-text-secondary">N&middot;m</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Ausgangsdrehzahl</div>
            <div id="gbu-output-speed" class="text-lg font-bold text-text">--</div>
            <div class="text-xs text-text-secondary">U/min</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Reflektierte Tr&auml;gheit</div>
            <div id="gbu-reflected" class="text-lg font-bold text-text">--</div>
            <div class="text-xs text-text-secondary">kg&middot;cm&sup2;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary mb-1">Tr&auml;gheitsverh&auml;ltnis</div>
            <div id="gbu-inertia-match" class="text-lg font-bold text-text">--</div>
            <div class="text-xs text-text-secondary">reflektiert/Motor</div>
          </div>
        </div>

        <ShareButton lang="de" calculatorId="gearbox-ratio" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Getriebe&uuml;bersetzung berechnen</h2>
      <p>Die optimale &Uuml;bersetzung ergibt sich aus dem Verh&auml;ltnis von Motordrehzahl zu gew&uuml;nschter Lastdrehzahl (Drehzahl-Methode) und dem Verh&auml;ltnis von Last-Drehmoment zu Motordrehmoment (Drehmoment-Methode). Der h&ouml;here Wert bestimmt die notwendige &Uuml;bersetzung.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>&Uuml;bersetzung (Drehzahl) = Motor-U/min / Last-U/min</p>
        <p>&Uuml;bersetzung (Drehmoment) = Last-Drehmoment / (Motor-Drehmoment &times; &eta;)</p>
        <p>Reflektierte Tr&auml;gheit = Last-Tr&auml;gheit / &Uuml;bersetzung&sup2;</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist das Tr&auml;gheitsverh&auml;ltnis?</strong> Das Verh&auml;ltnis zwischen reflektierter Lasttr&auml;gheit und Motortr&auml;gheit. Ein Wert nahe 1:1 ist f&uuml;r dynamische Anwendungen ideal.</p>
      <p><strong>Wie beeinflusst der Wirkungsgrad die &Uuml;bersetzung?</strong> Ein niedrigerer Wirkungsgrad erh&ouml;ht den Drehmomentbedarf und damit m&ouml;glicherweise die erforderliche &Uuml;bersetzung.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcGBU() {
      const motorRPM = parseFloat((document.getElementById('gbu-motor-rpm') as HTMLInputElement).value) || 3000;
      const motorTorque = parseFloat((document.getElementById('gbu-motor-torque') as HTMLInputElement).value) || 2.5;
      const motorInertia = parseFloat((document.getElementById('gbu-motor-inertia') as HTMLInputElement).value) || 1.2;
      const loadRPM = parseFloat((document.getElementById('gbu-load-rpm') as HTMLInputElement).value) || 100;
      const loadTorque = parseFloat((document.getElementById('gbu-load-torque') as HTMLInputElement).value) || 50;
      const loadInertia = parseFloat((document.getElementById('gbu-load-inertia') as HTMLInputElement).value) || 100;
      const eff = parseFloat((document.getElementById('gbu-eff') as HTMLInputElement).value) / 100 || 0.95;
      const ratioBySpeed = motorRPM / loadRPM;
      const ratioByTorque = loadTorque / (motorTorque * eff);
      const requiredRatio = Math.max(ratioBySpeed, ratioByTorque);
      const outputTorque = motorTorque * requiredRatio * eff;
      const outputSpeed = motorRPM / requiredRatio;
      const reflectedInertia = loadInertia / (requiredRatio * requiredRatio);
      const inertiaMatch = reflectedInertia / motorInertia;
      document.getElementById('gbu-result-ratio')!.textContent = requiredRatio.toFixed(2);
      document.getElementById('gbu-output-torque')!.textContent = outputTorque.toFixed(2);
      document.getElementById('gbu-output-speed')!.textContent = outputSpeed.toFixed(1);
      document.getElementById('gbu-reflected')!.textContent = reflectedInertia.toFixed(3);
      document.getElementById('gbu-inertia-match')!.textContent = inertiaMatch.toFixed(2) + ':1';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gbu-in').forEach(el => { el.addEventListener('input', calcGBU); el.addEventListener('change', calcGBU); });
      calcGBU();
    }, 50);
  </script>
</CalculatorLayout>
