---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Medikamentenrechner - Fischbehandlungsdosierung";
const description = "Berechnen Sie genaue Fischmedikamenten-Dosierungen nach Beckenvolumen und Behandlungstyp für häufige Aquariumkrankheiten und Parasiten.";
const relatedCalcs = [
  { name: "Aquarium-Salz", url: "/de/aquarium-salz-rechner", description: "Salzdosierung für Süßwasserbehandlungen." },
  { name: "Aquarium-Wasserwechsel", url: "/de/aquarium-wasserwechsel-rechner", description: "Wasserwechselvolumen und -plan." },
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Gewicht." },
  { name: "Fischbesatz", url: "/de/fischbesatz-rechner", description: "Fischbesatzkapazitätsrechner." },
  { name: "Fischfütterung", url: "/de/fischfuetterung-rechner", description: "Fischfütterungsmengenrechner." },
  { name: "Aquarium-Stickstoffkreislauf", url: "/de/aquarium-stickstoffkreislauf-rechner", description: "Stickstoffkreislauf verfolgen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquarium-Medikamentenrechner" keywords="Aquarium-Medikamentenrechner, Fischmedikament-Dosierung, Weißpünktchenkrankheit-Behandlung, Fischkrankheit-Behandlung, Aquarium-Medizin-Dosierung" breadcrumbs={[{ name: "Aquarium-Medikamente", url: "/de/aquarium-medikamente-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Medikamentenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie präzise Medikamentendosierungen für Ihr Aquarium basierend auf dem tatsächlichen Wasservolumen und Behandlungstyp.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Netto-Wasservolumen (Liter)</label>
          <input type="number" id="amd-vol" class="amd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="1" step="1">
          <p class="text-xs text-text-muted mt-1">Ziehen Sie ca. 15% vom Gesamtvolumen für Substrat, Deko etc. ab.</p>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Medikament / Behandlung</label>
          <select id="amd-med" class="amd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="ich">Weißpünktchen (Malachitgrün) - 1 Tropfen/4L</option>
            <option value="melafix">Melafix (Teebaumöl) - 5 ml pro 40 L</option>
            <option value="pimafix">Pimafix (Antipilz) - 5 ml pro 40 L</option>
            <option value="erythromycin">Erythromycin (200 mg/40 L)</option>
            <option value="metronidazole">Metronidazol (250 mg/40 L)</option>
            <option value="praziquantel">Praziquantel (Entwurmung) - 2,5 mg/L</option>
            <option value="methylene_blue">Methylenblau - 1 TL/40 L</option>
            <option value="aquarium_salt">Aquariumsalz - 1 EL/20 L</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Dosisanpassung</label>
          <select id="amd-adj" class="amd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1">Volle Dosis (Standard)</option>
            <option value="0.5">Halbe Dosis (empfindliche Fische / schuppenlose)</option>
            <option value="0.75">3/4 Dosis (vorsichtig)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Medikamentendosis</div>
          <div class="text-5xl font-extrabold font-mono" id="amd-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Metrische Menge</div>
            <div class="text-xl font-bold font-mono" id="amd-metric">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Behandlungsdauer</div>
            <div class="text-xl font-bold font-mono" id="amd-dur">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Nachdosierungs-Intervall</div>
            <div class="text-xl font-bold font-mono" id="amd-interval">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Wasserwechsel vor Nachdosierung</div>
            <div class="text-xl font-bold font-mono" id="amd-wc">25%</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquarium-medication" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAMD() {
      const vol = parseFloat((document.getElementById('amd-vol') as HTMLInputElement).value) || 0;
      const med = (document.getElementById('amd-med') as HTMLSelectElement).value;
      const adj = parseFloat((document.getElementById('amd-adj') as HTMLSelectElement).value) || 1;
      const volGal = vol / 3.785;
      interface MedInfo { dose: string; metric: string; duration: string; interval: string; wc: string; }
      const meds: Record<string, MedInfo> = {
        ich: { dose: (vol / 4 * 1 * adj).toFixed(0) + ' Tropfen', metric: (vol * 0.013 * adj).toFixed(1) + ' ml', duration: '14 Tage', interval: 'Alle 24 Std.', wc: '25%' },
        melafix: { dose: (vol / 40 * 5 * adj).toFixed(1) + ' ml', metric: (vol / 40 * 5 * adj).toFixed(1) + ' ml', duration: '7 Tage', interval: 'Täglich', wc: '25%' },
        pimafix: { dose: (vol / 40 * 5 * adj).toFixed(1) + ' ml', metric: (vol / 40 * 5 * adj).toFixed(1) + ' ml', duration: '7 Tage', interval: 'Täglich', wc: '25%' },
        erythromycin: { dose: (vol / 40 * 200 * adj).toFixed(0) + ' mg', metric: (vol / 40 * 200 * adj / 1000).toFixed(2) + ' g', duration: '5 Tage', interval: 'Alle 24 Std.', wc: '25%' },
        metronidazole: { dose: (vol / 40 * 250 * adj).toFixed(0) + ' mg', metric: (vol / 40 * 250 * adj / 1000).toFixed(2) + ' g', duration: '3 Tage', interval: 'Alle 48 Std.', wc: '25%' },
        praziquantel: { dose: (vol * 2.5 * adj).toFixed(0) + ' mg', metric: (vol * 2.5 * adj / 1000).toFixed(2) + ' g', duration: '5-7 Tage', interval: 'Einzeldosis', wc: '100% danach' },
        methylene_blue: { dose: (vol / 40 * adj).toFixed(1) + ' TL', metric: (vol / 40 * 5 * adj).toFixed(1) + ' ml', duration: '3-5 Tage', interval: 'Einzeldosis', wc: '25%' },
        aquarium_salt: { dose: (vol / 20 * adj).toFixed(1) + ' EL', metric: (vol / 20 * 15 * adj).toFixed(0) + ' g', duration: '7-10 Tage', interval: 'Nur nach WW', wc: '25%' },
      };
      const info = meds[med] || meds['ich'];
      document.getElementById('amd-result')!.textContent = info.dose;
      document.getElementById('amd-metric')!.textContent = info.metric;
      document.getElementById('amd-dur')!.textContent = info.duration;
      document.getElementById('amd-interval')!.textContent = info.interval;
      document.getElementById('amd-wc')!.textContent = info.wc;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.amd-in').forEach(el => { el.addEventListener('input', calcAMD); el.addEventListener('change', calcAMD); });
      calcAMD();
    }, 50);
  </script>
</CalculatorLayout>
