---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Burnout-Rechner - Maslach Burnout Inventar Sch&auml;tzung";
const description = "Sch&auml;tzen Sie Ihr Burnout-Risiko mit einem vereinfachten Maslach Burnout Inventar. Erhalten Sie Werte f&uuml;r emotionale Ersch&ouml;pfung, Zynismus und berufliche Wirksamkeit.";
const relatedCalcs = [
  { name: "Schlafrechner", url: "/de/schlafrechner", description: "Schlafzyklen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Pausenplan-Rechner", url: "/de/pausenplan-rechner", description: "Pausen planen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Burnout-Rechner" lang="de" enSlug="burnout-calculator" keywords="burnout, maslach burnout inventar, emotionale ersch&ouml;pfung, zynismus, berufliche wirksamkeit, burnout risiko" breadcrumbs={[{ name: "Burnout-Rechner", url: "/de/burnout-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Burnout-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerten Sie, wie oft Sie jede Aussage erleben (0 = Nie, 6 = T&auml;glich), um Ihr Burnout-Risiko einzusch&auml;tzen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <p class="text-sm text-text-secondary mb-4">0 = Nie, 1 = Einige Male im Jahr, 2 = Monatlich, 3 = Einige Male im Monat, 4 = W&ouml;chentlich, 5 = Einige Male pro Woche, 6 = T&auml;glich</p>
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Emotionale Ersch&ouml;pfung</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich f&uuml;hle mich durch meine Arbeit emotional ausgelaugt.</label>
          <input type="range" id="bo-ee1" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Am Ende des Arbeitstages f&uuml;hle ich mich verbraucht.</label>
          <input type="range" id="bo-ee2" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich f&uuml;hle mich ersch&ouml;pft, wenn ich aufstehe und einem weiteren Arbeitstag entgegensehe.</label>
          <input type="range" id="bo-ee3" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <h3 class="font-semibold text-text mt-2">Zynismus / Depersonalisation</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich habe das Gef&uuml;hl, manche Menschen wie unpersönliche Objekte zu behandeln.</label>
          <input type="range" id="bo-cy1" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Seit ich diesen Job habe, bin ich Menschen gegen&uuml;ber gleichg&uuml;ltiger geworden.</label>
          <input type="range" id="bo-cy2" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich mache mir Sorgen, dass mich dieser Job emotional verh&auml;rtet.</label>
          <input type="range" id="bo-cy3" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <h3 class="font-semibold text-text mt-2">Berufliche Wirksamkeit (umgekehrt bewertet)</h3>
        <div>
          <label class="block text-sm text-text mb-1">Ich gehe effektiv mit den Problemen meiner Arbeit um.</label>
          <input type="range" id="bo-pe1" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Ich habe das Gef&uuml;hl, durch meine Arbeit einen sinnvollen Beitrag zu leisten.</label>
          <input type="range" id="bo-pe2" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
        <div>
          <label class="block text-sm text-text mb-1">Nach einem guten Arbeitstag f&uuml;hle ich mich energiegeladen und erf&uuml;llt.</label>
          <input type="range" id="bo-pe3" class="bo-in w-full" min="0" max="6" step="1">
          <div class="flex justify-between text-xs text-text-secondary"><span>Nie (0)</span><span>T&auml;glich (6)</span></div>
        </div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Burnout-Risikoniveau</div>
          <div class="text-2xl font-extrabold mt-1" id="bo-risk">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary">Ersch&ouml;pfung</div><div class="text-xl font-bold text-text mt-1" id="bo-escore">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary">Zynismus</div><div class="text-xl font-bold text-text mt-1" id="bo-cscore">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-secondary">Wirksamkeit</div><div class="text-xl font-bold text-text mt-1" id="bo-pscore">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Interpretation & Empfehlungen</div>
          <div class="text-sm text-text" id="bo-recs">--</div>
        </div>
      </div>
      <ShareButton calculatorId="burnout" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBO() {
      const ee1 = parseInt((document.getElementById('bo-ee1') as HTMLInputElement).value) || 0;
      const ee2 = parseInt((document.getElementById('bo-ee2') as HTMLInputElement).value) || 0;
      const ee3 = parseInt((document.getElementById('bo-ee3') as HTMLInputElement).value) || 0;
      const cy1 = parseInt((document.getElementById('bo-cy1') as HTMLInputElement).value) || 0;
      const cy2 = parseInt((document.getElementById('bo-cy2') as HTMLInputElement).value) || 0;
      const cy3 = parseInt((document.getElementById('bo-cy3') as HTMLInputElement).value) || 0;
      const pe1 = parseInt((document.getElementById('bo-pe1') as HTMLInputElement).value) || 0;
      const pe2 = parseInt((document.getElementById('bo-pe2') as HTMLInputElement).value) || 0;
      const pe3 = parseInt((document.getElementById('bo-pe3') as HTMLInputElement).value) || 0;
      const eeTotal = ee1 + ee2 + ee3;
      const cyTotal = cy1 + cy2 + cy3;
      const peTotal = pe1 + pe2 + pe3;
      let eeLabel = 'Niedrig';
      if (eeTotal >= 11) eeLabel = 'Hoch';
      else if (eeTotal >= 6) eeLabel = 'Mittel';
      let cyLabel = 'Niedrig';
      if (cyTotal >= 10) cyLabel = 'Hoch';
      else if (cyTotal >= 5) cyLabel = 'Mittel';
      let peLabel = 'Hoch';
      if (peTotal <= 7) peLabel = 'Niedrig (Burnout-Risiko)';
      else if (peTotal <= 13) peLabel = 'Mittel';
      let risk = 'Niedrig';
      let recs = '';
      const burnoutScore = eeTotal + cyTotal + (18 - peTotal);
      if (burnoutScore >= 36) {
        risk = 'Schweres Burnout';
        recs = 'Ihre Werte deuten auf schweres Burnout in mehreren Dimensionen hin. Sofortiges Handeln wird empfohlen: Sprechen Sie mit einem Psychologen, besprechen Sie die Arbeitslast mit Ihrem Vorgesetzten, erw\u00e4gen Sie eine Auszeit. Burnout ist ein anerkanntes Berufssyndrom (WHO ICD-11) und behandelbar.';
      } else if (burnoutScore >= 24) {
        risk = 'Hohes Burnout-Risiko';
        recs = 'Sie zeigen deutliche Burnout-Anzeichen. Handeln Sie jetzt: Setzen Sie klare Grenzen bei der Arbeitszeit, priorisieren Sie Erholung (Sport, Schlaf, soziale Kontakte), und erw\u00e4gen Sie professionelle Unterst\u00fctzung.';
      } else if (burnoutScore >= 14) {
        risk = 'Mittleres Risiko';
        recs = 'Sie zeigen einige Burnout-Symptome. Pr\u00e4ventive Ma\u00dfnahmen empfohlen: Ausreichend Ruhe, Stressmanagement, Work-Life-Balance und soziale Unterst\u00fctzung. \u00dcberwachen Sie diese Werte monatlich.';
      } else {
        risk = 'Niedriges Risiko';
        recs = 'Ihr Burnout-Risiko ist derzeit niedrig. Bewahren Sie Ihre gesunden Gewohnheiten: Angemessene Arbeitslast, regelm\u00e4\u00dfige Pausen, sinnvolle Arbeit und Selbstf\u00fcrsorge.';
      }
      document.getElementById('bo-risk')!.textContent = risk;
      document.getElementById('bo-escore')!.textContent = eeTotal + '/18 (' + eeLabel + ')';
      document.getElementById('bo-cscore')!.textContent = cyTotal + '/18 (' + cyLabel + ')';
      document.getElementById('bo-pscore')!.textContent = peTotal + '/18 (' + peLabel + ')';
      document.getElementById('bo-recs')!.textContent = recs;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      const ids = ['bo-ee1','bo-ee2','bo-ee3','bo-cy1','bo-cy2','bo-cy3','bo-pe1','bo-pe2','bo-pe3'];
      ids.forEach((id, i) => {
        (document.getElementById(id) as HTMLInputElement).value = i < 6 ? '2' : '4';
      });
      document.querySelectorAll('.bo-in').forEach(el => {
        el.addEventListener('input', calcBO);
        el.addEventListener('change', calcBO);
      });
      calcBO();
    }, 50);
  </script>
</CalculatorLayout>
