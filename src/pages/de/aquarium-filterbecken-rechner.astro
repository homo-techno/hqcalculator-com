---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Filterbeckenrechner - Dimensionierung, Trennwände & Rückförderpumpe";
const description = "Berechnen Sie Filterbecken-Maße, Trennwand-Platzierung, Kammervolumen und Rückförderpumpen-Dimensionierung für Ihre Aquarium-Filteranlage.";
const relatedCalcs = [
  { name: "Aquarium-Durchfluss", url: "/aquarium-flow-rate-calculator", description: "Durchflussrate und Pumpenleistung." },
  { name: "Riffbecken", url: "/de/riffbecken-rechner", description: "Riffbecken-Parameter." },
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen berechnen." },
  { name: "Aquarium-Unterschrank", url: "/de/aquarium-unterschrank-rechner", description: "Tragfähigkeit des Unterschranks." },
  { name: "Lebendgestein", url: "/live-rock-calculator", description: "Lebendgestein-Mengenrechner." },
  { name: "Aquarium-Verdunstung", url: "/aquarium-evaporation-calculator", description: "Wasserverdunstungsrate." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Aquarium-Filterbeckenrechner" keywords="Aquarium Filterbecken Rechner, Sump Dimensionierung, Trennwand, Rückförderpumpe, Filterkammer, Riff-Filterbecken" lang="de" breadcrumbs={[{ name: "Aquarium-Filterbecken", url: "/de/aquarium-filterbecken-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Filterbeckenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihr Filterbecken mit passender Kammerdimensionierung, Trennwand-Platzierung und Rückförderpumpen-Auswahl.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Hauptbecken-Volumen (Liter)</label>
          <input type="number" id="asm-tank" class="asm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="40" step="10">
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Filterbecken Länge (cm)</label>
            <input type="number" id="asm-len" class="asm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="90" min="30" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Filterbecken Breite (cm)</label>
            <input type="number" id="asm-wid" class="asm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="20" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Filterbecken Höhe (cm)</label>
            <input type="number" id="asm-hgt" class="asm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="20" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Betriebswasserstand (cm)</label>
            <input type="number" id="asm-level" class="asm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="10" max="38" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Förderhöhe zum Becken (m)</label>
            <input type="number" id="asm-head" class="asm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.2" min="0.3" max="3" step="0.1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Filterbecken-Volumen (Betrieb)</div>
          <div class="text-5xl font-extrabold font-mono" id="asm-result">0 L</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ablaufkammer</div>
            <div class="text-xl font-bold font-mono" id="asm-drain">0 L</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Refugium/Medien</div>
            <div class="text-xl font-bold font-mono" id="asm-fuge">0 L</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Rückförderkammer</div>
            <div class="text-xl font-bold font-mono" id="asm-return">0 L</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Rückförderpumpe (Nennleistung)</div>
            <div class="text-xl font-bold font-mono" id="asm-pump">0 L/h</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="aquarium-sump" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcASM() {
      const tankVol = parseFloat((document.getElementById('asm-tank') as HTMLInputElement).value) || 0;
      const len = parseFloat((document.getElementById('asm-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('asm-wid') as HTMLInputElement).value) || 0;
      const hgt = parseFloat((document.getElementById('asm-hgt') as HTMLInputElement).value) || 0;
      const level = parseFloat((document.getElementById('asm-level') as HTMLInputElement).value) || 0;
      const head = parseFloat((document.getElementById('asm-head') as HTMLInputElement).value) || 0;
      const operatingLiters = (len * wid * level) / 1000;
      const drainL = operatingLiters * 0.30;
      const fugeL = operatingLiters * 0.40;
      const returnL = operatingLiters * 0.30;
      const targetFlow = tankVol * 5;
      const headLoss = 1 + head * 0.10 / 0.3048;
      const ratedPump = Math.ceil(targetFlow * headLoss);
      const fmt = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 1 });
      document.getElementById('asm-result')!.textContent = fmt(operatingLiters) + ' L';
      document.getElementById('asm-drain')!.textContent = fmt(drainL) + ' L';
      document.getElementById('asm-fuge')!.textContent = fmt(fugeL) + ' L';
      document.getElementById('asm-return')!.textContent = fmt(returnL) + ' L';
      document.getElementById('asm-pump')!.textContent = ratedPump.toLocaleString('de-DE') + ' L/h';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.asm-in').forEach(el => { el.addEventListener('input', calcASM); el.addEventListener('change', calcASM); });
      calcASM();
    }, 50);
  </script>
</CalculatorLayout>
