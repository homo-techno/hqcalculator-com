---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lagerbestand-Rechner - Lagerhaltungskosten & Abschreibung";
const description = "Berechnen Sie die Lagerhaltungskosten fuer totes Inventar, Umschlagsrate, Opportunitaetskosten und Abschreibungsanalyse zur Optimierung von Lagerflaeche und Kapitalbindung.";

const relatedCalcs = [
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Budgetplanung." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="dead-stock-calculator" calculatorName="Lagerbestand-Rechner" keywords="lagerbestand rechner, lagerhaltungskosten, totes inventar, abschreibung, opportunitaetskosten, obsoleter bestand" breadcrumbs={[{ name: "Lagerbestand-Rechner", url: "/de/lagerbestand-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lagerbestand-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie die wahren Kosten von totem Lagerbestand inkl. Lagerhaltungskosten, Opportunit&auml;tskosten und Abschreibung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Wert des toten Bestands (&euro;)</label><input type="number" id="lb-value" class="lb-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="100"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesamter Lagerwert (&euro;)</label><input type="number" id="lb-total" class="lb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="100"></div>
        <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Lagerhaltungskosten (%)</label><input type="number" id="lb-carry" class="lb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="0.5"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Monate als toter Bestand</label><input type="number" id="lb-months" class="lb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Erwartete Liquidationsquote (%)</label><input type="number" id="lb-liquidate" class="lb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Opportunit&auml;tskosten (j&auml;hrlich %)</label><input type="number" id="lb-opportunity" class="lb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten toter Bestand</div>
          <div class="text-5xl font-extrabold font-mono" id="lb-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lagerhaltungskosten</div><div class="text-xl font-bold font-mono" id="lb-carrycost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Opportunit&auml;tskosten</div><div class="text-xl font-bold font-mono" id="lb-oppcost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abschreibungsverlust</div><div class="text-xl font-bold font-mono" id="lb-writeoff">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anteil toter Bestand</div><div class="text-xl font-bold font-mono" id="lb-pct">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="dead-stock" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Toter Lagerbestand verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Lagerhaltungskosten</strong> = Bestandswert &times; Lagerkostenrate &times; Monate / 12</p>
        <p><strong>Opportunit&auml;tskosten</strong> = Bestandswert &times; Opportunit&auml;tsrate &times; Monate / 12</p>
        <p><strong>Abschreibung</strong> = Bestandswert &minus; Liquidationserl&ouml;s</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Ab wann gilt Bestand als tot?</strong> In der Regel nach 6-12 Monaten ohne Verkauf, abh&auml;ngig von der Branche.</p>
      <p><strong>Wie reduziere ich toten Bestand?</strong> Rabattaktionen, B&uuml;ndelangebote, Spenden (steuerlich absetzbar) oder Verschrottung sind g&auml;ngige Strategien.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLB() {
      const value = parseFloat((document.getElementById('lb-value') as HTMLInputElement).value) || 0;
      const totalInv = parseFloat((document.getElementById('lb-total') as HTMLInputElement).value) || 0;
      const carryRate = parseFloat((document.getElementById('lb-carry') as HTMLInputElement).value) || 0;
      const months = parseFloat((document.getElementById('lb-months') as HTMLInputElement).value) || 0;
      const liquidateRate = parseFloat((document.getElementById('lb-liquidate') as HTMLInputElement).value) || 0;
      const oppRate = parseFloat((document.getElementById('lb-opportunity') as HTMLInputElement).value) || 0;

      const carryingCost = value * (carryRate / 100) * (months / 12);
      const opportunityCost = value * (oppRate / 100) * (months / 12);
      const recoveryValue = value * (liquidateRate / 100);
      const writeoffLoss = value - recoveryValue;
      const totalDeadCost = carryingCost + opportunityCost + writeoffLoss;
      const deadStockPct = totalInv > 0 ? (value / totalInv) * 100 : 0;

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

      document.getElementById('lb-result')!.textContent = fmt(totalDeadCost);
      document.getElementById('lb-carrycost')!.textContent = fmt(carryingCost);
      document.getElementById('lb-oppcost')!.textContent = fmt(opportunityCost);
      document.getElementById('lb-writeoff')!.textContent = fmt(writeoffLoss);
      document.getElementById('lb-pct')!.textContent = deadStockPct.toFixed(1) + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('lb-value') as HTMLInputElement).value = '25000';
      (document.getElementById('lb-total') as HTMLInputElement).value = '200000';
      (document.getElementById('lb-carry') as HTMLInputElement).value = '25';
      (document.getElementById('lb-months') as HTMLInputElement).value = '6';
      (document.getElementById('lb-liquidate') as HTMLInputElement).value = '30';
      (document.getElementById('lb-opportunity') as HTMLInputElement).value = '12';
      document.querySelectorAll('.lb-in').forEach(el => { el.addEventListener('input', calcLB); el.addEventListener('change', calcLB); });
      calcLB();
    }, 50);
  </script>
</CalculatorLayout>
