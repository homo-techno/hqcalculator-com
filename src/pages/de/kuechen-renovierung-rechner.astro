---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Küchen-Renovierung Rechner";
const description = "Schätzen Sie die Kosten einer Küchenrenovierung nach Größe und Ausstattung.";

const relatedCalcs = [
  { name: "Bodenbelag-Rechner", url: "/de/bodenbelag-rechner", description: "Bodenbelag berechnen." },
  { name: "Grundstückswert Rechner", url: "/de/grundstueckswert-rechner", description: "Immobilienwert." },
  { name: "Farbbedarf-Rechner", url: "/de/farbbedarf-rechner", description: "Farbmenge berechnen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "AfA berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Küchen-Renovierung Rechner" lang="de" enSlug="kitchen-remodel-calculator" keywords="küchen renovierung kosten, küchenrenovierung rechner, küche sanieren kosten, küchenmontage kosten" breadcrumbs={[{ name: "Küchen-Renovierung Rechner", url: "/de/kuechen-renovierung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Küchen-Renovierung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Gesamtkosten Ihrer Küchenrenovierung anhand von Größe, Ausstattungsklasse und gewünschten Arbeiten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Küchenfläche (m²)</label><input type="number" id="krr-area" class="krr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="1" max="100" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ausstattungsklasse</label><select id="krr-class" class="krr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="800">Einfach (800 €/m²)</option>
            <option value="1500" selected>Mittel (1.500 €/m²)</option>
            <option value="3000">Gehoben (3.000 €/m²)</option>
            <option value="5000">Luxus (5.000 €/m²)</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Neue Elektrogeräte</label><select id="krr-appliances" class="krr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Keine</option>
            <option value="1500">Basis (1.500 €)</option>
            <option value="3500" selected>Standard (3.500 €)</option>
            <option value="7000">Premium (7.000 €)</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Neue Arbeitsplatte</label><select id="krr-worktop" class="krr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Keine</option>
            <option value="500">Laminat (500 €)</option>
            <option value="1200" selected>Granit (1.200 €)</option>
            <option value="2500">Naturstein (2.500 €)</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fliesenarbeiten</label><select id="krr-tiles" class="krr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Keine</option>
            <option value="800" selected>Spritzschutz (800 €)</option>
            <option value="2000">Vollflächig (2.000 €)</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Sanitär / Umbau</label><select id="krr-plumbing" class="krr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0">Keine</option>
            <option value="500" selected>Einfach (500 €)</option>
            <option value="2000">Komplett (2.000 €)</option>
          </select></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Planungsaufschlag (%)</label><input type="number" id="krr-buffer" class="krr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" max="50" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten</div>
          <div class="text-4xl font-extrabold font-mono" id="krr-total">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundkosten</div><div class="text-xl font-bold" id="krr-base">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Extras</div><div class="text-xl font-bold" id="krr-extras">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Puffer</div><div class="text-xl font-bold" id="krr-buf">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="kitchen-remodel-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Küchenrenovierung – Kosten realistisch planen</h2>
      <p>Eine Küchenrenovierung gehört zu den kostspieligsten Heimwerkerprojekten. In Deutschland bewegen sich die Kosten je nach Ausstattungsgrad zwischen 800 € und über 5.000 € pro Quadratmeter Küchenfläche. Für eine durchschnittliche 15 m² große Küche in mittlerer Ausstattung sind Gesamtkosten von 20.000 bis 30.000 € realistisch. Planen Sie stets einen Puffer von 10–20 % für unvorhergesehene Ausgaben ein.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange dauert eine Küchenrenovierung?</strong> Eine komplette Küchenrenovierung dauert in der Regel 1–3 Wochen, abhängig vom Umfang der Arbeiten und der Verfügbarkeit von Handwerkern.</p>
      <p><strong>Welche Kosten sind in der Renovierung enthalten?</strong> Typischerweise umfasst eine Renovierung Küchenmöbel, Elektrogeräte, Arbeitsplatten, Fliesenarbeiten, Malerarbeiten und Montagekosten.</p>
      <p><strong>Kann ich Steuern absetzen?</strong> Handwerkerleistungen bei einer selbstgenutzten Immobilie können bis zu 1.200 € pro Jahr steuerlich abgesetzt werden (20 % von max. 6.000 €).</p>
      <p><strong>Wie spare ich bei der Küchenrenovierung?</strong> Küchenfronten erneuern statt neue Küche kaufen, regionale Handwerker beauftragen und Eigenleistungen wie Demontage erbringen sind effektive Sparmöglichkeiten.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const krrFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcKRR() {
      const area = parseFloat((document.getElementById('krr-area') as HTMLInputElement).value) || 0;
      const cls = parseFloat((document.getElementById('krr-class') as HTMLSelectElement).value) || 0;
      const appliances = parseFloat((document.getElementById('krr-appliances') as HTMLSelectElement).value) || 0;
      const worktop = parseFloat((document.getElementById('krr-worktop') as HTMLSelectElement).value) || 0;
      const tiles = parseFloat((document.getElementById('krr-tiles') as HTMLSelectElement).value) || 0;
      const plumbing = parseFloat((document.getElementById('krr-plumbing') as HTMLSelectElement).value) || 0;
      const bufferPct = parseFloat((document.getElementById('krr-buffer') as HTMLInputElement).value) || 0;
      const base = area * cls;
      const extras = appliances + worktop + tiles + plumbing;
      const subtotal = base + extras;
      const buf = subtotal * bufferPct / 100;
      const total = subtotal + buf;
      document.getElementById('krr-total')!.textContent = krrFmt(total);
      document.getElementById('krr-base')!.textContent = krrFmt(base);
      document.getElementById('krr-extras')!.textContent = krrFmt(extras);
      document.getElementById('krr-buf')!.textContent = krrFmt(buf);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.krr-in').forEach(el => { el.addEventListener('input', calcKRR); el.addEventListener('change', calcKRR); }); calcKRR(); }, 50);
  </script>
</CalculatorLayout>
