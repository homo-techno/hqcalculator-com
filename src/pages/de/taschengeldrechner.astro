---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Taschengeldrechner - Altersgerechtes Taschengeld mit Sparaufteilung";
const description = "Berechnen Sie altersgerechte Taschengeldbeträge für Kinder mit empfohlener Aufteilung in Sparen, Ausgeben und Spenden.";

const relatedCalcs = [
  { name: "Budgetrechner", url: "/budget-calculator", description: "Familienbudget." },
  { name: "Sparrechner", url: "/savings-calculator", description: "Sparwachstum." },
  { name: "Zinseszinsrechner", url: "/compound-interest-calculator", description: "Zinseszins." },
  { name: "Studienfondsrechner", url: "/college-fund-calculator", description: "Bildungssparen." },
  { name: "Schulbedarfrechner", url: "/school-supply-calculator", description: "Schulkosten." },
  { name: "Tilgungsrechner", url: "/de/tilgungsrechner", description: "Tilgungsplan." },
];
---

<CalculatorLayout lang="de" title={title} description={description} calculatorName="Taschengeldrechner" keywords="Taschengeldrechner, Taschengeld Kinder, wie viel Taschengeld, altersgerechtes Taschengeld, Taschengeldtabelle" breadcrumbs={[{ name: "Taschengeldrechner", url: "/de/taschengeldrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Taschengeldrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie den richtigen Taschengeldbetrag für Ihr Kind mit empfohlener Aufteilung in Sparen, Ausgeben und Spenden.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Alter des Kindes</label>
          <input type="number" id="alw-age" class="alw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="4" max="18" step="1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Taschengeld-Methode</label>
          <select id="alw-method" class="alw-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="jugendamt" selected>Jugendamt-Empfehlung</option>
            <option value="half">0,50 € pro Lebensjahr</option>
            <option value="chore">Aufgabenbasiert (1-3 € pro Aufgabe)</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>

        <div id="alw-custom-wrap" class="hidden">
          <label class="block text-sm font-medium text-text mb-1">Benutzerdefinierter Wochenbetrag (€)</label>
          <input type="number" id="alw-custom" class="alw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="200" step="0.5">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Sparprozentsatz (%)</label>
          <input type="number" id="alw-save" class="alw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="100" step="5">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Spenden/Wohltätigkeit (%)</label>
          <input type="number" id="alw-give" class="alw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="50" step="5">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Wöchentliches Taschengeld</div>
        <div class="text-5xl font-extrabold" id="alw-weekly">--</div>
        <div class="text-sm text-blue-200 mt-1">empfohlener Betrag</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Monatlich gesamt</div>
          <div class="text-lg font-bold" id="alw-monthly">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Jährlich gesamt</div>
          <div class="text-lg font-bold" id="alw-yearly">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Wöchentlich sparen</div>
          <div class="text-lg font-bold" id="alw-weeksave">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Wöchentlich ausgeben</div>
          <div class="text-lg font-bold" id="alw-weekspend">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Sparprognose</h3>
        <div class="text-xs" id="alw-projection"></div>
      </div>

      <ShareButton lang="de" calculatorId="allowance" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie viel Taschengeld sollten Kinder bekommen?</h2>
      <p>Das Jugendamt empfiehlt für 6-Jährige etwa 1-1,50 € pro Woche, für 10-Jährige etwa 13-16 € pro Monat und für Teenager ab 14 Jahren etwa 25-30 € pro Monat. Der richtige Betrag hängt vom Familienbudget und davon ab, was das Taschengeld abdecken soll.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Das Drei-Spardosen-Prinzip</h3>
      <ul>
        <li><strong>Ausgeben (50-60%):</strong> Geld für alltägliche Wünsche und kleine Einkäufe</li>
        <li><strong>Sparen (30-40%):</strong> Für größere Ziele und zukünftige Bedürfnisse zurücklegen</li>
        <li><strong>Spenden (10%):</strong> Wohltätige Zwecke und Geschenke für andere</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Wann anfangen?</h3>
      <p>Die meisten Experten empfehlen, mit dem Taschengeld zwischen 5 und 7 Jahren zu beginnen, wenn Kinder anfangen, Geldkonzepte zu verstehen. Beginnen Sie einfach und steigern Sie die Verantwortung mit dem Alter.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcALW() {
      const age = parseFloat((document.getElementById('alw-age') as HTMLInputElement).value) || 8;
      const method = (document.getElementById('alw-method') as HTMLSelectElement).value;
      const customAmt = parseFloat((document.getElementById('alw-custom') as HTMLInputElement).value) || 10;
      const savePct = parseFloat((document.getElementById('alw-save') as HTMLInputElement).value) || 0;
      const givePct = parseFloat((document.getElementById('alw-give') as HTMLInputElement).value) || 0;

      const customWrap = document.getElementById('alw-custom-wrap')!;
      customWrap.classList.toggle('hidden', method !== 'custom');

      let weekly: number;
      if (method === 'jugendamt') {
        // Jugendamt recommendations (weekly approximation)
        if (age <= 5) weekly = 1;
        else if (age <= 7) weekly = 2;
        else if (age <= 9) weekly = 3;
        else if (age <= 11) weekly = 4;
        else if (age <= 13) weekly = 5;
        else if (age <= 15) weekly = 7.50;
        else if (age <= 17) weekly = 10;
        else weekly = 12.50;
      } else if (method === 'half') {
        weekly = age * 0.5;
      } else if (method === 'chore') {
        const choresPerWeek = Math.min(age - 2, 7);
        const chorePay = age < 8 ? 1 : age < 13 ? 2 : 3;
        weekly = choresPerWeek * chorePay;
      } else {
        weekly = customAmt;
      }

      weekly = Math.round(weekly * 100) / 100;
      const monthly = weekly * 4.33;
      const yearly = weekly * 52;
      const spendPct = Math.max(0, 100 - savePct - givePct);
      const weeklySave = weekly * savePct / 100;
      const weeklySpend = weekly * spendPct / 100;

      const fmtDE = (v: number) => v.toLocaleString('de-DE', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' €';

      document.getElementById('alw-weekly')!.textContent = fmtDE(weekly);
      document.getElementById('alw-monthly')!.textContent = Math.round(monthly).toLocaleString('de-DE') + ' €';
      document.getElementById('alw-yearly')!.textContent = Math.round(yearly).toLocaleString('de-DE') + ' €';
      document.getElementById('alw-weeksave')!.textContent = fmtDE(weeklySave);
      document.getElementById('alw-weekspend')!.textContent = fmtDE(weeklySpend);

      const yearlySaved = weeklySave * 52;
      const rows: string[] = [];
      let cumulative = 0;
      for (let y = 1; y <= 5; y++) {
        cumulative += yearlySaved;
        const withInterest = cumulative * Math.pow(1.04, y);
        rows.push(`<div class="grid grid-cols-3 gap-2 py-1"><span>Jahr ${y}</span><span>${Math.round(cumulative).toLocaleString('de-DE')} €</span><span>${Math.round(withInterest).toLocaleString('de-DE')} € (4% Zinsen)</span></div>`);
      }

      document.getElementById('alw-projection')!.innerHTML =
        '<div class="grid grid-cols-3 gap-2 font-semibold text-text-muted mb-1"><span>Zeitraum</span><span>Gespart</span><span>Mit Zinsen</span></div>' +
        rows.join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.alw-in').forEach(el => {
        el.addEventListener('input', calcALW);
        el.addEventListener('change', calcALW);
      });
      calcALW();
    }, 50);
  </script>
</CalculatorLayout>
