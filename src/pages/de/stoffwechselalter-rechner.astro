---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Stoffwechselalter Rechner - Metabolisches Alter berechnen";
const description = "Berechnen Sie Ihr metabolisches Alter basierend auf BMR und Referenzwerten. Finden Sie heraus, ob Ihr Stoffwechsel jünger oder älter als Ihr chronologisches Alter ist.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Makro-Rechner", url: "/de/makro-rechner", description: "Makronährstoffe." },
  { name: "Zyklusrechner", url: "/de/zyklus-rechner", description: "Menstruationszyklus." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="metabolic-age-calculator" calculatorName="Stoffwechselalter Rechner" keywords="Stoffwechselalter Rechner, Metabolisches Alter, BMR Rechner, Grundumsatz, biologisches Alter Stoffwechsel" breadcrumbs={[{ name: "Stoffwechselalter Rechner", url: "/de/stoffwechselalter-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stoffwechselalter Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihren Grundumsatz (BMR) und vergleichen Sie ihn mit Referenzwerten, um Ihr metabolisches Alter zu schätzen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Geschlecht</label>
            <select id="sa-sex" class="sa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="male" selected>Männlich</option>
              <option value="female">Weiblich</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Alter (Jahre)</label><input type="number" id="sa-age" class="sa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="35" min="15" max="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="sa-weight" class="sa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="75" min="30" max="300" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Körpergröße (cm)</label><input type="number" id="sa-height" class="sa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="175" min="100" max="250"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Aktivitätsniveau</label>
          <select id="sa-act" class="sa-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="1.2">Sitzend (kaum Bewegung)</option>
            <option value="1.375" selected>Leicht aktiv (1–3x Sport/Woche)</option>
            <option value="1.55">Moderat aktiv (3–5x Sport/Woche)</option>
            <option value="1.725">Sehr aktiv (6–7x Sport/Woche)</option>
            <option value="1.9">Extrem aktiv (2x tägl. Training)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Metabolisches Alter</div>
          <div class="text-5xl font-extrabold font-mono" id="sa-meta-age">--</div>
          <div class="text-sm text-blue-200 mt-1" id="sa-diff">Jahre</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Grundumsatz (BMR)</div><div class="text-xl font-bold" id="sa-bmr">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tagesbedarf (TDEE)</div><div class="text-xl font-bold" id="sa-tdee">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Referenz-BMR (Alter)</div><div class="text-xl font-bold" id="sa-ref-bmr">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bewertung</div><div class="text-xl font-bold" id="sa-rating">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="stoffwechselalter" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was ist das metabolische Alter?</h2>
      <p>Das metabolische Alter vergleicht Ihren Grundumsatz (BMR – Basal Metabolic Rate) mit dem Durchschnittswert für verschiedene Altersgruppen. Ein niedrigeres metabolisches Alter als das chronologische Alter deutet auf einen effizienten, jugendlichen Stoffwechsel hin. Der BMR wird mit der Mifflin-St. Jeor-Formel berechnet: Männer: 10 × Gewicht + 6,25 × Größe − 5 × Alter + 5. Frauen: 10 × Gewicht + 6,25 × Größe − 5 × Alter − 161.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was bedeutet metabolisches Alter?</strong> Das metabolische Alter gibt an, ob Ihr Stoffwechsel dem Durchschnitt einer bestimmten Altersgruppe entspricht. Ein metabolisches Alter unter Ihrem tatsächlichen Alter ist ein gutes Zeichen.</p>
      <p><strong>Wie kann ich mein metabolisches Alter verbessern?</strong> Krafttraining erhöht den Grundumsatz dauerhaft. Ausreichend Schlaf, gesunde Ernährung und regelmäßige Bewegung helfen, das metabolische Alter zu senken.</p>
      <p><strong>Was ist der Unterschied zwischen Grundumsatz und Gesamtumsatz?</strong> Der Grundumsatz (BMR) ist die Energie, die der Körper in völliger Ruhe benötigt. Der Gesamtumsatz (TDEE) berücksichtigt zusätzlich die körperliche Aktivität.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const saRefBMR: Record<string, number[]> = {
      male:   [1900, 1850, 1800, 1750, 1700, 1650, 1600, 1550, 1500, 1450],
      female: [1550, 1520, 1490, 1460, 1430, 1400, 1370, 1340, 1310, 1280]
    };
    function calcSA() {
      const sex = (document.getElementById('sa-sex') as HTMLSelectElement).value;
      const age = parseFloat((document.getElementById('sa-age') as HTMLInputElement).value) || 30;
      const weight = parseFloat((document.getElementById('sa-weight') as HTMLInputElement).value) || 0;
      const height = parseFloat((document.getElementById('sa-height') as HTMLInputElement).value) || 0;
      const act = parseFloat((document.getElementById('sa-act') as HTMLSelectElement).value) || 1.375;
      if (!weight || !height) return;
      const bmr = sex === 'male'
        ? 10 * weight + 6.25 * height - 5 * age + 5
        : 10 * weight + 6.25 * height - 5 * age - 161;
      const tdee = bmr * act;
      const refs = saRefBMR[sex];
      let metaAge = 20;
      for (let i = 0; i < refs.length; i++) {
        if (bmr >= refs[i]) { metaAge = 20 + i * 5; break; }
        metaAge = 65;
      }
      const diff = metaAge - age;
      let rating = 'Normal';
      if (diff <= -5) rating = 'Ausgezeichnet';
      else if (diff < 0) rating = 'Sehr gut';
      else if (diff <= 5) rating = 'Gut';
      else rating = 'Verbesserungspotenzial';
      const refIdx = Math.min(Math.max(Math.floor((age - 20) / 5), 0), refs.length - 1);
      const refBMR = refs[refIdx];
      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' kcal';
      document.getElementById('sa-meta-age')!.textContent = metaAge.toString();
      document.getElementById('sa-diff')!.textContent = diff > 0 ? '+ ' + diff + ' Jahre über chronologischem Alter' : diff < 0 ? Math.abs(diff) + ' Jahre unter chronologischem Alter' : 'Entspricht chronologischem Alter';
      document.getElementById('sa-bmr')!.textContent = fmt(bmr);
      document.getElementById('sa-tdee')!.textContent = fmt(tdee);
      document.getElementById('sa-ref-bmr')!.textContent = fmt(refBMR);
      document.getElementById('sa-rating')!.textContent = rating;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sa-in').forEach(el => { el.addEventListener('input', calcSA); el.addEventListener('change', calcSA); });
      calcSA();
    }, 50);
  </script>
</CalculatorLayout>
