---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Visitenkarten-Rechner - Druckkosten & Mengensch&auml;tzung";
const description = "Berechnen Sie Visitenkarten-Druckkosten basierend auf Menge, Papierst&auml;rke, Veredelung und ein- oder beidseitigem Druck.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
  { name: "MwSt-Rechner", url: "/de/mwst-rechner", description: "Mehrwertsteuer." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Visitenkarten-Rechner" lang="de" enSlug="business-card-calculator" keywords="visitenkarten kosten, visitenkarten druck, kartenst&auml;rke, druckveredelung, druckkosten" breadcrumbs={[{ name: "Visitenkarten-Rechner", url: "/de/visitenkarten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Visitenkarten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Kosten f&uuml;r Visitenkartendruck basierend auf Menge, Papier, Veredelung und Druckoptionen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Menge</label>
            <select id="bc2-qty" class="bc2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="100">100</option>
              <option value="250">250</option>
              <option value="500">500</option>
              <option value="1000">1.000</option>
              <option value="2500">2.500</option>
              <option value="5000">5.000</option>
              <option value="10000">10.000</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Kartengr&ouml;&szlig;e</label>
            <select id="bc2-size" class="bc2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="3.346x2.165" selected>Standard EU (85 x 55 mm)</option>
              <option value="3.5x2">US-Format (3,5 x 2 Zoll)</option>
              <option value="3.582x2.165">Japanisch (91 x 55 mm)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Papierst&auml;rke</label>
            <select id="bc2-stock" class="bc2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="standard">300 g/m&sup2; (Standard)</option>
              <option value="thick">350 g/m&sup2; (Dick)</option>
              <option value="premium">400 g/m&sup2; (Premium)</option>
              <option value="ultra">600 g/m&sup2; (Ultra Dick)</option>
              <option value="cotton">Baumwollpapier</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Veredelung</label>
            <select id="bc2-finish" class="bc2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="matte">Matt</option>
              <option value="gloss">Gl&auml;nzend UV</option>
              <option value="silk">Seiden / Satin</option>
              <option value="uncoated">Ungestrichen</option>
              <option value="spotUV">Spot-UV</option>
              <option value="foil">Folienpr&auml;gung</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Seiten</label>
            <select id="bc2-sides" class="bc2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="1">Einseitig</option>
              <option value="2">Beidseitig</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Farbe</label>
            <select id="bc2-color" class="bc2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="full">Vollfarbe (CMYK)</option>
              <option value="bw">Schwarzwei&szlig;</option>
              <option value="spot2">2 Sonderfarben</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="bc2-result">0,00 &euro;</div>
          <div class="text-sm text-blue-200 mt-1" id="bc2-percard"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Karte</div><div class="text-xl font-bold" id="bc2-unit">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Karten/Bogen</div><div class="text-xl font-bold" id="bc2-persheet">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ben&ouml;tigte B&ouml;gen</div><div class="text-xl font-bold" id="bc2-sheets">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Druckaufl&ouml;sung</div><div class="text-xl font-bold" id="bc2-res">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Preisvergleich nach Menge</h3>
          <div class="font-mono text-sm space-y-1" id="bc2-steps"></div>
        </div>
      </div>
      <ShareButton calculatorId="business-card" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Visitenkarten-Druckleitfaden</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>EU-Standard: 85 x 55 mm mit 3 mm Beschnitt</p>
        <p>Dokumentgr&ouml;&szlig;e mit Beschnitt: 91 x 61 mm</p>
        <p>Sicherer Bereich (Text innerhalb): 79 x 49 mm</p>
        <p>Aufl&ouml;sung: Mindestens 300 DPI</p>
      </div>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBc2() {
      const qty = parseFloat((document.getElementById('bc2-qty') as HTMLSelectElement).value) || 0;
      const sizeStr = (document.getElementById('bc2-size') as HTMLSelectElement).value;
      const stock = (document.getElementById('bc2-stock') as HTMLSelectElement).value;
      const finish = (document.getElementById('bc2-finish') as HTMLSelectElement).value;
      const sides = parseFloat((document.getElementById('bc2-sides') as HTMLSelectElement).value) || 1;
      const color = (document.getElementById('bc2-color') as HTMLSelectElement).value;
      const dims = sizeStr.split('x').map(Number);
      const cardW = dims[0] || 3.346;
      const cardH = dims[1] || 2.165;
      const stockCost: Record<string, number> = { standard: 0.02, thick: 0.03, premium: 0.04, ultra: 0.07, cotton: 0.06 };
      const finishCost: Record<string, number> = { matte: 0.005, gloss: 0.008, silk: 0.007, uncoated: 0.003, spotUV: 0.025, foil: 0.05 };
      const colorMult: Record<string, number> = { full: 1, bw: 0.4, spot2: 0.7 };
      const sideMult = sides === 2 ? 1.6 : 1;
      const baseCost = (stockCost[stock] || 0.02) + (finishCost[finish] || 0.005);
      const perCard = baseCost * (colorMult[color] || 1) * sideMult;
      let discount = 1;
      if (qty >= 5000) discount = 0.6;
      else if (qty >= 2500) discount = 0.7;
      else if (qty >= 1000) discount = 0.8;
      else if (qty >= 500) discount = 0.9;
      const finalPerCard = perCard * discount;
      const setupFee = 12;
      const total = setupFee + finalPerCard * qty;
      const cardsPerSheet = Math.floor(8.5 / (cardW + 0.125)) * Math.floor(11 / (cardH + 0.125));
      const sheetsNeeded = cardsPerSheet > 0 ? Math.ceil(qty / cardsPerSheet) : 0;
      const resW = Math.ceil((cardW * 25.4 + 6) / 25.4 * 300);
      const resH = Math.ceil((cardH * 25.4 + 6) / 25.4 * 300);
      const fmtEur = (v: number) => v.toFixed(2).replace('.', ',') + ' \u20AC';
      const steps: string[] = [];
      const qtys = [100, 250, 500, 1000, 2500, 5000, 10000];
      for (const q of qtys) {
        let d = 1;
        if (q >= 5000) d = 0.6;
        else if (q >= 2500) d = 0.7;
        else if (q >= 1000) d = 0.8;
        else if (q >= 500) d = 0.9;
        const t = setupFee + perCard * d * q;
        const pc = t / q;
        const mark = q === qty ? ' <-- gew\u00e4hlt' : '';
        steps.push(q.toLocaleString('de-DE') + ' Karten: ' + fmtEur(t) + ' (' + fmtEur(pc) + '/Karte)' + mark);
      }
      document.getElementById('bc2-result')!.textContent = fmtEur(total);
      document.getElementById('bc2-percard')!.textContent = fmtEur(total / qty) + ' pro Karte';
      document.getElementById('bc2-unit')!.textContent = fmtEur(total / qty);
      document.getElementById('bc2-persheet')!.textContent = cardsPerSheet.toString();
      document.getElementById('bc2-sheets')!.textContent = sheetsNeeded.toString();
      document.getElementById('bc2-res')!.textContent = resW + ' x ' + resH + ' px';
      document.getElementById('bc2-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bc2-in').forEach(el => { el.addEventListener('input', calcBc2); el.addEventListener('change', calcBc2); });
      calcBc2();
    }, 50);
  </script>
</CalculatorLayout>
