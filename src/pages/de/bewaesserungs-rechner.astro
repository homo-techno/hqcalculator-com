---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bewässerungsrechner – Wasserbedarf für Garten & Rasen";
const description = "Berechnen Sie den Wasserbedarf für Garten, Rasen und Landwirtschaft.";
const relatedCalcs = [
  { name: "Brennofen Energierechner", url: "/de/brennofen-energie-rechner", description: "Energiebedarf Brennofen." },
  { name: "Kerosin Rechner", url: "/de/kerosin-rechner", description: "Treibstoffverbrauch Flugzeug." },
  { name: "Infusionsraten Rechner", url: "/de/infusionsrate-rechner", description: "IV-Tropfraten berechnen." },
  { name: "Kinetische Energie Rechner", url: "/de/kinetische-energie-rechner", description: "Kinetische Energie (E=½mv²)." },
];
---
<CalculatorLayout lang="de" enSlug="irrigation-calculator" title={title} description={description} calculatorName="Bewässerungsrechner" keywords="Bewässerungsrechner, Wasserbedarf Garten, Rasen bewässern, Wasserverbrauch Pflanzen, Tropfbewässerung" breadcrumbs={[{ name: "Bewässerungsrechner", url: "/de/bewaesserungs-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bewässerungsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie den wöchentlichen Wasserbedarf für Ihren Rasen oder Garten basierend auf Fläche, Pflanzentyp und Niederschlag.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fläche (m²)</label><input type="number" id="bw-area" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="100" min="1" step="10"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Pflanzentyp</label>
            <select id="bw-type" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="25">Rasen (25 mm/Woche)</option>
              <option value="20">Blumenbeet (20 mm/Woche)</option>
              <option value="15">Gemüsegarten (15 mm/Woche)</option>
              <option value="10">Sträucher (10 mm/Woche)</option>
              <option value="8">Bäume (8 mm/Woche)</option>
              <option value="5">Kakteen/Sukkulenten (5 mm/Woche)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wöchentlicher Niederschlag (mm)</label><input type="number" id="bw-rain" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wasserpreis (€/m³)</label><input type="number" id="bw-price" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.50" min="0" step="0.10"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Bewässerungssystem</label>
          <select id="bw-system" class="bw-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0.75">Tropfbewässerung (75 % Effizienz)</option>
            <option value="0.85">Tröpfchenbewässerung (85 % Effizienz)</option>
            <option value="0.60" selected>Sprinkleranlage (60 % Effizienz)</option>
            <option value="0.50">Schlauch (50 % Effizienz)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Wassermenge (pro Woche)</div>
          <div class="text-5xl font-extrabold font-mono" id="bw-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="bw-cost">—</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pflanzenbedarf</div><div class="text-xl font-bold" id="bw-need">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durch Regen gedeckt</div><div class="text-xl font-bold" id="bw-rain-cover">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Jahreskosten (ca.)</div><div class="text-xl font-bold" id="bw-annual">—</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="irrigation" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Wasserbedarf im Garten berechnen</h2>
      <p class="text-text-secondary">Der Wasserbedarf von Pflanzen wird in Millimetern pro Woche gemessen – 1 mm Niederschlag entspricht 1 Liter Wasser pro m². Ein Rasen benötigt in der Wachstumsphase etwa 20–30 mm/Woche, was bei 100 m² Rasenfläche 2.000–3.000 Liter pro Woche entspricht. Tropfbewässerungssysteme sind dabei deutlich effizienter als Sprinkleranlagen, da kaum Verdunstungsverluste entstehen.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Bruttobedarf (L) = (Bedarf − Regen) × Fläche / Effizienz</p>
        <p>Kosten (€) = Bruttobedarf / 1000 × Preis (€/m³)</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wann ist die beste Zeit zum Gießen?</h4>
          <p class="text-text-secondary mt-1">Am frühen Morgen (6–10 Uhr) ist die optimale Gießzeit: Die Pflanzen können das Wasser aufnehmen, bevor die Mittagshitze die Verdunstung erhöht, und die Blätter trocknen vor dem Abend, was Pilzkrankheiten vorbeugt. Abends gießen fördert Schimmelbildung. Mittags gießen führt zu hohen Verdunstungsverlusten.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel Wasser benötigt ein Rasen im Sommer?</h4>
          <p class="text-text-secondary mt-1">Ein Rasens benötigt bei Trockenheit 20–30 Liter pro m² pro Woche (entspricht 20–30 mm Niederschlag). Bei 100 m² Rasenfläche sind das 2.000–3.000 Liter wöchentlich. Besser seltener (1–2 x/Woche) tief gießen als täglich oberflächlich – tiefe Wurzeln sind trockenstressresistenter.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welches Bewässerungssystem ist am effizientesten?</h4>
          <p class="text-text-secondary mt-1">Tropf- und Tröpfchenbewässerung erreichen 85–95 % Effizienz, da Wasser direkt an der Wurzel abgegeben wird. Sprinkleranlagen erreichen 60–75 %, Handschlauch etwa 50–60 %. Regenwassertanks und Zisternen können die Kosten erheblich reduzieren.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie viel kostet Gartenwasser in Deutschland?</h4>
          <p class="text-text-secondary mt-1">Der Wasserpreis variiert je nach Gemeinde zwischen 1,50 und 5,00 €/m³. In Deutschland zahlen Haushalte im Schnitt etwa 2,50 €/m³. Bei einem großen Garten mit 500 m² summieren sich die Bewässerungskosten im Sommer schnell auf 100–300 € pro Saison.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBW() {
      const area = parseFloat((document.getElementById('bw-area') as HTMLInputElement).value) || 0;
      const needMM = parseFloat((document.getElementById('bw-type') as HTMLSelectElement).value) || 25;
      const rain = parseFloat((document.getElementById('bw-rain') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('bw-price') as HTMLInputElement).value) || 2.5;
      const efficiency = parseFloat((document.getElementById('bw-system') as HTMLSelectElement).value) || 0.6;
      const deficitMM = Math.max(0, needMM - rain);
      const plantNeedL = needMM * area;
      const rainCoverL = Math.min(rain * area, plantNeedL);
      const grossL = deficitMM > 0 ? (deficitMM * area) / efficiency : 0;
      const weeklyCostEur = (grossL / 1000) * price;
      const annualCost = weeklyCostEur * 20;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      document.getElementById('bw-result')!.textContent = fmt(grossL) + ' Liter';
      document.getElementById('bw-cost')!.textContent = 'Kosten: ca. ' + fmtEur(weeklyCostEur) + '/Woche';
      document.getElementById('bw-need')!.textContent = fmt(plantNeedL) + ' L';
      document.getElementById('bw-rain-cover')!.textContent = fmt(rainCoverL) + ' L';
      document.getElementById('bw-annual')!.textContent = fmtEur(annualCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bw-in').forEach(el => { el.addEventListener('input', calcBW); el.addEventListener('change', calcBW); });
      calcBW();
    }, 50);
  </script>
</CalculatorLayout>
