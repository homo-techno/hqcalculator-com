---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Geologische Zeit-Rechner - \u00C4ra, Periode & Epoche bestimmen";
const description = "Geologische \u00C4ra, Periode und Epoche anhand eines Alters in Millionen Jahren bestimmen. Wichtige Ereignisse und Anteil der Erdgeschichte anzeigen.";
const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "Halbwertszeit-Rechner", url: "/de/halbwertszeit-rechner", description: "Zerf\u00E4lle." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Geologische Zeit-Rechner" lang="de" enSlug="geological-time-calculator" keywords="geologische zeitskala, \u00E4ra, periode, epoche, Ma, millionen jahre, erdgeschichte, geologie" breadcrumbs={[{ name: "Geologische Zeit", url: "/de/geologische-zeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Geologische Zeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie ein Alter in Millionen Jahren (Ma) ein, um die geologische &Auml;ra, Periode, Epoche und wichtige Ereignisse aus dieser Zeit zu bestimmen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Alter (Millionen Jahre vor heute - Ma)</label>
          <input type="number" id="gzt-age" class="gzt-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="66" min="0" max="4600" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Schnellauswahl</label>
          <div class="flex flex-wrap gap-2">
            <button class="gzt-btn px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt" data-age="0.01">Eiszeit (0,01)</button>
            <button class="gzt-btn px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt" data-age="66">Dino-Aussterben (66)</button>
            <button class="gzt-btn px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt" data-age="252">Gro&szlig;es Sterben (252)</button>
            <button class="gzt-btn px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt" data-age="541">Kambrische Explosion (541)</button>
            <button class="gzt-btn px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt" data-age="2500">Gro&szlig;e Oxidation (2500)</button>
            <button class="gzt-btn px-3 py-1.5 text-xs rounded-lg border border-border hover:bg-surface-alt" data-age="4600">Erdbildung (4600)</button>
          </div>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geologische Periode</div>
          <div class="text-4xl font-extrabold" id="gzt-period">--</div>
          <div class="text-sm text-blue-200 mt-1" id="gzt-era">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Äon</div>
            <div class="text-xl font-bold" id="gzt-eon">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Epoche</div>
            <div class="text-xl font-bold" id="gzt-epoch">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">% der Erdgeschichte</div>
            <div class="text-xl font-bold" id="gzt-pct">0%</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Jahre vor heute</div>
            <div class="text-xl font-bold" id="gzt-years">0</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Wichtiges Ereignis</div>
          <div class="text-sm font-bold" id="gzt-event">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Leben auf der Erde</div>
          <div class="text-sm" id="gzt-life">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="geological-time" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Geologische Zeitskala</h2>
      <p>Die Erde ist etwa 4.600 Millionen Jahre (4,6 Milliarden Jahre) alt. Die geologische Zeitskala unterteilt diesen riesigen Zeitraum in &Auml;onen, &Auml;ras, Perioden und Epochen, basierend auf bedeutenden geologischen und biologischen Ereignissen im Gesteinsarchiv.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist Ma?</strong> Ma steht f&uuml;r Mega annum &ndash; Millionen Jahre vor heute. Es ist die Standardeinheit f&uuml;r geologische Zeitangaben.</p>
      <p><strong>Welche Periode haben wir heute?</strong> Wir leben im Holoz&auml;n, einer Epoche des Quart&auml;r im Ph&auml;nerozoikum. Das Holoz&auml;n begann vor etwa 11.700 Jahren.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcGZT() {
      const age = parseFloat((document.getElementById('gzt-age') as HTMLInputElement).value) || 0;
      const timescale = [
        { maxAge: 0.0117, eon: 'Phan\u00E4rozoikum', era: 'K\u00E4nozoikum', period: 'Quart\u00E4r', epoch: 'Holoz\u00E4n', event: 'Menschliche Zivilisation', life: 'Moderne Menschen dominieren, Ackerbau beginnt' },
        { maxAge: 2.58, eon: 'Phan\u00E4rozoikum', era: 'K\u00E4nozoikum', period: 'Quart\u00E4r', epoch: 'Pleistoz\u00E4n', event: 'Eiszeiten, Mammuts', life: 'Fr\u00FChe Menschen, Megafauna' },
        { maxAge: 5.33, eon: 'Phan\u00E4rozoikum', era: 'K\u00E4nozoikum', period: 'Neogen', epoch: 'Plioz\u00E4n', event: 'Bildung des Isthmus von Panama', life: 'Fr\u00FChe Hominiden erscheinen' },
        { maxAge: 23.03, eon: 'Phan\u00E4rozoikum', era: 'K\u00E4nozoikum', period: 'Neogen', epoch: 'Mioz\u00E4n', event: 'Himalaya entsteht, Grasfl\u00E4chen', life: 'Menschenaffen diversifizieren' },
        { maxAge: 33.9, eon: 'Phan\u00E4rozoikum', era: 'K\u00E4nozoikum', period: 'Paleogen', epoch: 'Oligoz\u00E4n', event: 'Antarktisches Eis entsteht', life: 'Fr\u00FChe Affen, Katzen und Hunde' },
        { maxAge: 56, eon: 'Phan\u00E4rozoikum', era: 'K\u00E4nozoikum', period: 'Paleogen', epoch: 'Eoz\u00E4n', event: 'Thermisches Maximum, Indien kollidiert mit Asien', life: 'Fr\u00FChe Wale, Pferde, Flederm\u00E4use' },
        { maxAge: 66, eon: 'Phan\u00E4rozoikum', era: 'K\u00E4nozoikum', period: 'Paleogen', epoch: 'Paleoz\u00E4n', event: 'Erholung nach Massenaussterben', life: 'S\u00E4ugetiere diversifizieren nach Dinosaurier-Aussterben' },
        { maxAge: 145, eon: 'Phan\u00E4rozoikum', era: 'Mesozoikum', period: 'Kreide', epoch: 'Sp\u00E4te Kreide', event: 'Asteroideneinschlag, Massenaussterben', life: 'T-Rex, Bl\u00FCtenpflanzen, H\u00F6hepunkt der Dinosaurier' },
        { maxAge: 201.3, eon: 'Phan\u00E4rozoikum', era: 'Mesozoikum', period: 'Jura', epoch: 'Jura', event: 'Pangaea bricht auseinander', life: 'Gro\u00DFe Dinosaurier, Archaeopteryx, fr\u00FCheste V\u00F6gel' },
        { maxAge: 252, eon: 'Phan\u00E4rozoikum', era: 'Mesozoikum', period: 'Trias', epoch: 'Trias', event: 'Erholung nach Perm-Aussterben', life: 'Erste Dinosaurier, S\u00E4ugetiere, Pterosauria' },
        { maxAge: 299, eon: 'Phan\u00E4rozoikum', era: 'Palaeozoikum', period: 'Perm', epoch: 'Perm', event: 'Gr\u00F6\u00DFtes Massenaussterben (Gro\u00DFes Sterben)', life: 'S\u00E4ugetier\u00E4hnliche Reptilien, 96% der Arten sterben aus' },
        { maxAge: 359, eon: 'Phan\u00E4rozoikum', era: 'Palaeozoikum', period: 'Karbon', epoch: 'Karbon', event: 'Riesige Kohles\u00FCmpfe', life: 'Rieseninsekten, erste Reptilien, Kohlelagerst\u00E4tten' },
        { maxAge: 419, eon: 'Phan\u00E4rozoikum', era: 'Palaeozoikum', period: 'Devon', epoch: 'Devon', event: 'Zeitalter der Fische', life: 'Erste W\u00E4lder, Amphibien gehen an Land' },
        { maxAge: 444, eon: 'Phan\u00E4rozoikum', era: 'Palaeozoikum', period: 'Silur', epoch: 'Silur', event: 'Erste Landpflanzen', life: 'Gef\u00E4\u00DFpflanzen, kiefertragende Fische' },
        { maxAge: 485, eon: 'Phan\u00E4rozoikum', era: 'Palaeozoikum', period: 'Ordovizium', epoch: 'Ordovizium', event: 'Massenaussterben am Ende', life: 'Marine Wirbellose, erste Fische' },
        { maxAge: 541, eon: 'Phan\u00E4rozoikum', era: 'Palaeozoikum', period: 'Kambrium', epoch: 'Kambrium', event: 'Kambrische Explosion', life: 'Rasches Erscheinen der meisten Tierst\u00E4mme' },
        { maxAge: 1000, eon: 'Proterozoikum', era: 'Neoproterozoikum', period: 'Neoproterozoikum', epoch: 'K/A', event: 'Schneeball-Erde-Vergletscherungen', life: 'Erste vielzellige Organismen' },
        { maxAge: 1600, eon: 'Proterozoikum', era: 'Mesoproterozoikum', period: 'Mesoproterozoikum', epoch: 'K/A', event: 'Superkontinent Rodinia entsteht', life: 'Eukaryotische Zellen diversifizieren' },
        { maxAge: 2500, eon: 'Proterozoikum', era: 'Palaeoproterozoikum', period: 'Palaeoproterozoikum', epoch: 'K/A', event: 'Gro\u00DFes Oxidationsereignis', life: 'Sauerstoff h\u00E4uft sich an, Cyanobakterien' },
        { maxAge: 4000, eon: 'Arch\u00E4ikum', era: 'Arch\u00E4ikum', period: 'Arch\u00E4ikum', epoch: 'K/A', event: '\u00C4lteste bekannte Gesteine', life: 'Erstes einzelliges Leben (Prokaryoten)' },
        { maxAge: 4600, eon: 'Hadaikum', era: 'Hadaikum', period: 'Hadaikum', epoch: 'K/A', event: 'Erde bildet sich aus Sonnennebel', life: 'Kein Leben, geschmolzene Oberfl\u00E4che' },
      ];
      let match = timescale[timescale.length - 1];
      for (const t of timescale) {
        if (age <= t.maxAge) { match = t; break; }
      }
      const pctHistory = (age / 4600 * 100).toFixed(2);
      const yearsAgo = age * 1e6;
      const yearsStr = yearsAgo >= 1e9 ? (yearsAgo / 1e9).toFixed(2) + ' Milliarden' : yearsAgo >= 1e6 ? (yearsAgo / 1e6).toFixed(1) + ' Millionen' : yearsAgo.toLocaleString('de-DE');
      document.getElementById('gzt-period')!.textContent = match.period;
      document.getElementById('gzt-era')!.textContent = match.era + ' \u00C4ra';
      document.getElementById('gzt-eon')!.textContent = match.eon;
      document.getElementById('gzt-epoch')!.textContent = match.epoch;
      document.getElementById('gzt-pct')!.textContent = pctHistory + '%';
      document.getElementById('gzt-years')!.textContent = yearsStr + ' Jahre';
      document.getElementById('gzt-event')!.textContent = match.event;
      document.getElementById('gzt-life')!.textContent = match.life;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gzt-in').forEach(el => { el.addEventListener('input', calcGZT); el.addEventListener('change', calcGZT); });
      document.querySelectorAll('.gzt-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const age = (btn as HTMLElement).dataset.age || '66';
          (document.getElementById('gzt-age') as HTMLInputElement).value = age;
          calcGZT();
        });
      });
      calcGZT();
    }, 50);
  </script>
</CalculatorLayout>
