---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Wäschereikosten Rechner";
const description = "Berechnen Sie die monatlichen Kosten für Waschmaschine und Trockner.";

const relatedCalcs = [
  { name: "LED-Einsparrechner", url: "/de/led-ersparnis-rechner", description: "Stromkosten sparen." },
  { name: "Gartenbeleuchtung Rechner", url: "/de/gartenbeleuchtung-rechner", description: "Außenbeleuchtung planen." },
  { name: "Küchen-Renovierung Rechner", url: "/de/kuechen-renovierung-rechner", description: "Renovierungskosten." },
  { name: "Akkulaufzeit-Rechner", url: "/de/akkulaufzeit-rechner", description: "Akkulaufzeit berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Wäschereikosten Rechner" lang="de" enSlug="laundry-cost-calculator" keywords="wäschereikosten rechner, waschmaschine stromkosten, wäsche kosten berechnen, waschen kosten" breadcrumbs={[{ name: "Wäschereikosten Rechner", url: "/de/waescherei-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Wäschereikosten Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die monatlichen und jährlichen Kosten für das Waschen und Trocknen Ihrer Wäsche.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wäschen pro Woche</label><input type="number" id="wkr-cycles" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch Waschmaschine (kWh)</label><input type="number" id="wkr-wash-kwh" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.85" min="0.1" step="0.05"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Trocknernutzung (%)</label><input type="number" id="wkr-dryer-pct" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch Trockner (kWh)</label><input type="number" id="wkr-dry-kwh" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0.5" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wasserverbrauch (Liter/Wäsche)</label><input type="number" id="wkr-water" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="55" min="20" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wasserpreis (€/m³)</label><input type="number" id="wkr-water-price" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4.50" min="1" step="0.10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (€/kWh)</label><input type="number" id="wkr-elec" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.32" min="0.01" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Waschmittel (€/Wäsche)</label><input type="number" id="wkr-detergent" class="wkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.40" min="0" step="0.05"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kosten pro Monat</div>
          <div class="text-4xl font-extrabold font-mono" id="wkr-monthly">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Strom/Monat</div><div class="text-xl font-bold" id="wkr-elec-cost">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser/Monat</div><div class="text-xl font-bold" id="wkr-water-cost">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Jahr</div><div class="text-xl font-bold" id="wkr-annual">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="laundry-cost-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wäschekosten – was kostet eine Wäsche wirklich?</h2>
      <p>Die wahren Kosten einer Wäsche setzen sich aus Strom, Wasser, Waschmittel und dem Anteil an den Gerätekosten zusammen. Eine durchschnittliche Haushaltswaschmaschine der Energieklasse A verbraucht ca. 0,7–1,2 kWh pro Waschgang. Bei einem deutschen Strompreis von ca. 30–35 Ct/kWh kostet ein Waschgang also nur wenige Cent an Strom. Der Trockner ist deutlich energieintensiver: Wärmepumpentrockner verbrauchen 1,5–2 kWh, herkömmliche Kondenstrockner 4–6 kWh pro Durchgang.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was verbraucht eine Waschmaschine an Strom?</strong> Moderne A-Klasse-Waschmaschinen verbrauchen 0,5–1,0 kWh pro Wäsche bei 40°C. Bei 60°C steigt der Verbrauch auf 1,0–1,5 kWh.</p>
      <p><strong>Wie spare ich beim Waschen Strom?</strong> Waschen bei 30°C statt 60°C spart bis zu 50 % Energie. Volle Trommel nutzen, Eco-Programm wählen und nachts waschen (falls Nachttarif vorhanden).</p>
      <p><strong>Lohnt sich ein Wärmepumpentrockner?</strong> Wärmepumpentrockner kosten in der Anschaffung mehr, verbrauchen aber 30–50 % weniger Strom als herkömmliche Trockner. Bei hoher Nutzungsfrequenz amortisiert sich der Mehrpreis in 3–5 Jahren.</p>
      <p><strong>Wie viel Wasser verbraucht eine Waschmaschine?</strong> Moderne Maschinen verbrauchen 40–65 Liter pro Waschgang, ältere Geräte teils über 100 Liter.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const wkrFmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
    function calcWKR() {
      const cycles = parseFloat((document.getElementById('wkr-cycles') as HTMLInputElement).value) || 0;
      const washKwh = parseFloat((document.getElementById('wkr-wash-kwh') as HTMLInputElement).value) || 0;
      const dryerPct = parseFloat((document.getElementById('wkr-dryer-pct') as HTMLInputElement).value) / 100 || 0;
      const dryKwh = parseFloat((document.getElementById('wkr-dry-kwh') as HTMLInputElement).value) || 0;
      const water = parseFloat((document.getElementById('wkr-water') as HTMLInputElement).value) || 0;
      const waterPrice = parseFloat((document.getElementById('wkr-water-price') as HTMLInputElement).value) || 0;
      const elec = parseFloat((document.getElementById('wkr-elec') as HTMLInputElement).value) || 0;
      const detergent = parseFloat((document.getElementById('wkr-detergent') as HTMLInputElement).value) || 0;
      const cyclesPerMonth = cycles * 4.33;
      const kwhPerMonth = cyclesPerMonth * (washKwh + dryerPct * dryKwh);
      const elecCost = kwhPerMonth * elec;
      const waterCost = cyclesPerMonth * water / 1000 * waterPrice;
      const detergentCost = cyclesPerMonth * detergent;
      const monthly = elecCost + waterCost + detergentCost;
      const annual = monthly * 12;
      document.getElementById('wkr-monthly')!.textContent = wkrFmt(monthly);
      document.getElementById('wkr-elec-cost')!.textContent = wkrFmt(elecCost);
      document.getElementById('wkr-water-cost')!.textContent = wkrFmt(waterCost);
      document.getElementById('wkr-annual')!.textContent = wkrFmt(annual);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.wkr-in').forEach(el => { el.addEventListener('input', calcWKR); el.addEventListener('change', calcWKR); }); calcWKR(); }, 50);
  </script>
</CalculatorLayout>
