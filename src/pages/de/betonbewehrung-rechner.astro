---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Betonbewehrungs-Rechner - Bewehrungsabstand, Durchmesser & Menge";
const description = "Berechnen Sie Bewehrungsabstand, Stabdurchmesser und Menge f\u00fcr Betonplatten und W\u00e4nde. Ermitteln Sie Laufmeter, Gewicht und Bewehrungsgrad.";
const relatedCalcs = [
  { name: "Betonplattenrechner", url: "/de/betonplatte-rechner", description: "Plattenvolumen." },
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Betonschalungsrechner", url: "/de/betonschalung-rechner", description: "Schalung." },
  { name: "Betonmischungsrechner", url: "/de/betonmischung-rechner", description: "Mischungsentwurf." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Betonbewehrungs-Rechner" lang="de" enSlug="concrete-reinforcement-calculator" keywords="bewehrung rechner, bewehrungsabstand, stabdurchmesser, bewehrungsgrad, betonplatte bewehrung, bewehrungsmenge" breadcrumbs={[{ name: "Betonbewehrung", url: "/de/betonbewehrung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Betonbewehrungs-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Bewehrungsabstand, Durchmesser und Menge f&uuml;r Betonplatten und W&auml;nde.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Anwendung</label>
          <select id="bb-app" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="slab" selected>Betonplatte</option>
            <option value="wall">Betonwand</option>
            <option value="footing">Streifenfundament</option>
          </select>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-sm font-medium text-text mb-2">L&auml;nge (m)</label><input type="number" id="bb-length" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0.5" step="0.1"></div>
          <div><label class="block text-sm font-medium text-text mb-2">Breite (m)</label><input type="number" id="bb-width" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0.5" step="0.1"></div>
          <div><label class="block text-sm font-medium text-text mb-2">Dicke (cm)</label><input type="number" id="bb-thick" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="10" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-2">Stabdurchmesser</label>
            <select id="bb-bar" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="6">&oslash;6 (0,222 kg/m)</option>
              <option value="8">&oslash;8 (0,395 kg/m)</option>
              <option value="10" selected>&oslash;10 (0,617 kg/m)</option>
              <option value="12">&oslash;12 (0,888 kg/m)</option>
              <option value="14">&oslash;14 (1,208 kg/m)</option>
              <option value="16">&oslash;16 (1,578 kg/m)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-2">Abstand (cm)</label>
            <select id="bb-spacing" class="bb-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="10">10 cm</option>
              <option value="15" selected>15 cm</option>
              <option value="20">20 cm</option>
              <option value="25">25 cm</option>
              <option value="30">30 cm</option>
            </select>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <label class="flex items-center gap-2">
            <input type="checkbox" id="bb-both" class="bb-in rounded" checked>
            <span class="text-sm font-medium text-text">Beide Richtungen (Gitter)</span>
          </label>
        </div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtbewehrung ben&ouml;tigt</div>
          <div class="text-4xl font-extrabold" id="bb-total">0 St&uuml;ck</div>
          <div class="text-sm text-blue-200 mt-1"><span id="bb-linm">0</span> Laufmeter</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-xl font-bold" id="bb-weight">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">6-m-St&auml;be ben&ouml;tigt</div><div class="text-xl font-bold" id="bb-bars6">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bewehrungsgrad</div><div class="text-xl font-bold" id="bb-ratio">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stahlfläche (pro m)</div><div class="text-xl font-bold" id="bb-area">0 cm&sup2;/m</div></div>
        </div>
      </div>
      <ShareButton calculatorId="concrete-reinforcement" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Bewehrungsrichtlinien</h2>
      <ul>
        <li><strong>10 cm Platte:</strong> &oslash;6 bei 20 cm oder Baustahlmatte Q188</li>
        <li><strong>15 cm Platte:</strong> &oslash;10 bei 15 cm beidseitig</li>
        <li><strong>20 cm Wand:</strong> &oslash;10 bei 15 cm vertikal, &oslash;10 bei 20 cm horizontal</li>
        <li><strong>Betondeckung:</strong> 3,5 cm bei Erdber&uuml;hrung, 2,5 cm frei bewittert, 2 cm innen</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const bbBarData: Record<string, { diam: number; weight: number; area: number }> = {
      '6': { diam: 6, weight: 0.222, area: 0.283 },
      '8': { diam: 8, weight: 0.395, area: 0.503 },
      '10': { diam: 10, weight: 0.617, area: 0.785 },
      '12': { diam: 12, weight: 0.888, area: 1.131 },
      '14': { diam: 14, weight: 1.208, area: 1.539 },
      '16': { diam: 16, weight: 1.578, area: 2.011 },
    };
    function calcBB() {
      const length = parseFloat((document.getElementById('bb-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('bb-width') as HTMLInputElement).value) || 0;
      const thick = parseFloat((document.getElementById('bb-thick') as HTMLInputElement).value) || 15;
      const barSize = (document.getElementById('bb-bar') as HTMLSelectElement).value;
      const spacing = parseFloat((document.getElementById('bb-spacing') as HTMLSelectElement).value) || 15;
      const bothDirs = (document.getElementById('bb-both') as HTMLInputElement).checked;
      const bar = bbBarData[barSize] || bbBarData['10'];
      const spacingM = spacing / 100;
      const barsLength = Math.ceil(width / spacingM) + 1;
      const barsWidth = Math.ceil(length / spacingM) + 1;
      let totalPieces = barsLength;
      let totalLinM = barsLength * length;
      if (bothDirs) { totalPieces += barsWidth; totalLinM += barsWidth * width; }
      const totalWeight = totalLinM * bar.weight;
      const bars6 = Math.ceil(totalLinM / 6);
      const effectiveD = thick - 3.5; // cm, with cover
      const asPerM = bar.area * (100 / spacing); // cm2 per m
      const reinfRatio = (asPerM / (100 * effectiveD)) * 100;
      document.getElementById('bb-total')!.textContent = totalPieces + ' St\u00fcck';
      document.getElementById('bb-linm')!.textContent = Math.round(totalLinM).toLocaleString('de-DE');
      document.getElementById('bb-weight')!.textContent = Math.round(totalWeight).toLocaleString('de-DE') + ' kg';
      document.getElementById('bb-bars6')!.textContent = String(bars6);
      document.getElementById('bb-ratio')!.textContent = reinfRatio.toFixed(3).replace('.', ',') + '%';
      document.getElementById('bb-area')!.textContent = asPerM.toFixed(2).replace('.', ',') + ' cm\u00B2/m';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bb-in').forEach(el => { el.addEventListener('input', calcBB); el.addEventListener('change', calcBB); });
      calcBB();
    }, 50);
  </script>
</CalculatorLayout>
