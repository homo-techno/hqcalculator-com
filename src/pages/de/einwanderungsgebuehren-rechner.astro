---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Einwanderungsgebühren-Rechner - Visa & Aufenthaltskosten";
const description = "Berechnen Sie Einwanderungsgebühren nach Visa-Typ, Petitionskategorie und zusätzlichen Dienstleistungen einschließlich biometrischer Daten, Expressbearbeitung und Anwaltskosten.";
const relatedCalcs = [
  { name: "Rechtskosten-Rechner", url: "/legal-fee-calculator", description: "Einwanderungsanwaltsgebühren." },
  { name: "Gerichtsgebühren-Rechner", url: "/court-fee-calculator", description: "Gerichtsgebühren." },
  { name: "Compliance-Kosten-Rechner", url: "/compliance-cost-calculator", description: "Arbeitgeberkonformität." },
  { name: "Unternehmensregistrierungs-Rechner", url: "/de/unternehmensgruendung-rechner", description: "Unternehmensbildung." },
  { name: "Steuerstrafe-Rechner", url: "/tax-penalty-calculator", description: "Steuerpflichten." },
  { name: "Notargebühren-Rechner", url: "/notary-fee-calculator", description: "Dokumentenbeglaubigung." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie viel kostet ein deutsches Visum?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ein Schengen-Visum kostet 80 €, ein nationales Visum für Deutschland etwa 75 €. Arbeitserlaubnisse und Niederlassungserlaubnisse kosten 100–250 €. Hinzu kommen Übersetzungs- und Beglaubigungskosten sowie mögliche Anwaltsgebühren." }
    },
    {
      "@type": "Question",
      "name": "Welche Dokumente brauche ich für eine Aufenthaltserlaubnis in Deutschland?",
      "acceptedAnswer": { "@type": "Answer", "text": "Für eine Aufenthaltserlaubnis benötigen Sie in der Regel: gültigen Reisepass, biometrisches Foto, Nachweis der Wohnung, Krankenversicherungsnachweis, Einkommensnachweis, Arbeitsvertrag (bei Arbeitserlaubnis) und ausgefüllte Antragsformulare." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Einwanderungsgebühren-Rechner" lang="de" keywords="einwanderungsgebühren rechner, visum kosten, aufenthaltserlaubnis, arbeitserlaubnis, einbürgerung, einwanderung deutschland" breadcrumbs={[{ name: "Einwanderungsgebühren-Rechner", url: "/de/einwanderungsgebuehren-rechner" }]} enSlug="immigration-fee-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Einwanderungsgebühren-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geschätzte Einwanderungsgebühren nach Visum- oder Aufenthaltserlaubnistyp berechnen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Antragstyp</label>
          <select id="ew-type" class="ew-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="schengen" selected>Schengen-Visum (Kurzaufenthalt)</option>
            <option value="national">Nationales Visum (D-Visum)</option>
            <option value="work">Arbeitserlaubnis / Blaue Karte EU</option>
            <option value="family">Familiennachzug</option>
            <option value="student">Studentenvisum</option>
            <option value="permanent">Niederlassungserlaubnis</option>
            <option value="citizenship">Einbürgerung</option>
            <option value="asylum">Asylantrag</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Expressbearbeitung?</label>
          <select id="ew-express" class="ew-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="no" selected>Nein – Standardbearbeitung</option>
            <option value="yes">Ja – Expressbearbeitung (+75 €)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl Antragsteller / Familienangehörige</label>
          <input type="number" id="ew-dependents" class="ew-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="10" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anwaltliche Begleitung</label>
          <select id="ew-attorney" class="ew-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Kein Anwalt (Selbstantrag)</option>
            <option value="basic" selected>Basisberatung (500–1.500 €)</option>
            <option value="full">Vollvertretung (1.500–4.000 €)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Übersetzungen / Beglaubigungen benötigt?</label>
          <select id="ew-translation" class="ew-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="no" selected>Nein</option>
            <option value="few">Wenige Dokumente (ca. 150 €)</option>
            <option value="many">Viele Dokumente (ca. 400 €)</option>
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="ew-total"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Behördengebühren</div>
            <div class="text-xl font-bold text-secondary" id="ew-official"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Expressgebühr</div>
            <div class="text-xl font-bold" id="ew-express-cost"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Anwaltsgebühren</div>
            <div class="text-xl font-bold text-orange-600" id="ew-atty"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sonstige Kosten</div>
            <div class="text-xl font-bold" id="ew-other"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="einwanderungsgebuehren" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Einwanderungsgebühren in Deutschland verstehen</h2>
      <p>Die deutschen Einwanderungsgebühren variieren je nach Visumtyp erheblich. Ein Schengen-Visum kostet 80 €, nationale Visa etwa 75 €. Arbeitserlaubnisse und die Blaue Karte EU kosten 100–140 €. Hinzu kommen Anwaltsgebühren, Übersetzungskosten und möglicherweise Reisekosten zur Botschaft oder Ausländerbehörde.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie viel kostet ein deutsches Visum?</h4>
      <p>Ein Schengen-Visum kostet 80 €, ein nationales Visum für Deutschland etwa 75 €. Arbeitserlaubnisse kosten 100–250 € zzgl. Nebenkosten.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Welche Dokumente brauche ich für eine Aufenthaltserlaubnis?</h4>
      <p>Typischerweise: gültiger Reisepass, biometrisches Foto, Wohnungsnachweis, Krankenversicherung, Einkommensnachweis und ausgefüllte Antragsformulare.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20ac';

    function calcEW() {
      const appType = (document.getElementById('ew-type') as HTMLSelectElement).value;
      const express = (document.getElementById('ew-express') as HTMLSelectElement).value;
      const dependents = parseInt((document.getElementById('ew-dependents') as HTMLInputElement).value) || 0;
      const attorney = (document.getElementById('ew-attorney') as HTMLSelectElement).value;
      const translation = (document.getElementById('ew-translation') as HTMLSelectElement).value;

      const baseFees: Record<string, number> = {
        schengen: 80, national: 75, work: 140, family: 80,
        student: 75, permanent: 250, citizenship: 255, asylum: 0
      };
      let officialFee = baseFees[appType] || 80;
      if (dependents > 0) {
        officialFee += dependents * (appType === 'family' ? 80 : 50);
      }

      const expressFee = express === 'yes' ? 75 : 0;

      const attyFees: Record<string, Record<string, number>> = {
        schengen: { none: 0, basic: 300, full: 800 },
        national: { none: 0, basic: 600, full: 1500 },
        work: { none: 0, basic: 1000, full: 2500 },
        family: { none: 0, basic: 800, full: 2000 },
        student: { none: 0, basic: 400, full: 1000 },
        permanent: { none: 0, basic: 1200, full: 3000 },
        citizenship: { none: 0, basic: 1500, full: 4000 },
        asylum: { none: 0, basic: 2000, full: 5000 }
      };
      const attyFee = (attyFees[appType] && attyFees[appType][attorney]) || 0;

      const translationCost = translation === 'few' ? 150 : translation === 'many' ? 400 : 0;
      const otherCost = 30 + translationCost;

      const total = officialFee + expressFee + attyFee + otherCost;

      document.getElementById('ew-total')!.textContent = fmtEur(total);
      document.getElementById('ew-official')!.textContent = fmtEur(officialFee);
      document.getElementById('ew-express-cost')!.textContent = fmtEur(expressFee);
      document.getElementById('ew-atty')!.textContent = fmtEur(attyFee);
      document.getElementById('ew-other')!.textContent = fmtEur(otherCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ew-in').forEach(el => {
        el.addEventListener('input', calcEW);
        el.addEventListener('change', calcEW);
      });
      calcEW();
    }, 50);
  </script>
</CalculatorLayout>
