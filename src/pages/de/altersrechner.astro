---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Altersrechner - Wie alt bin ich? Kostenloser Altersrechner 2026";
const description = "Berechne dein genaues Alter in Jahren, Monaten, Tagen, Stunden und Minuten. Finde heraus, wie alt du heute oder an einem beliebigen Datum bist.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Wie berechne ich mein genaues Alter?", "acceptedAnswer": { "@type": "Answer", "text": "Gib dein Geburtsdatum im Altersrechner oben ein. Er zeigt sofort dein genaues Alter in Jahren, Monaten und Tagen an, unter Berücksichtigung von Schaltjahren und unterschiedlichen Monatslängen." } },
    { "@type": "Question", "name": "Wie viele Tage alt bin ich?", "acceptedAnswer": { "@type": "Answer", "text": "Der Altersrechner zeigt dein Alter in Gesamttagen an. Beispiel: Eine 30-jährige Person ist ungefähr 10.950 Tage alt." } }
  ]
};

const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Berechne deinen Body-Mass-Index." },
  { name: "Schwangerschaftsrechner", url: "/de/schwangerschaftsrechner", description: "Berechne deinen Geburtstermin." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Berechne deinen täglichen Kalorienbedarf." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente einfach berechnen." },
  { name: "Gehaltsrechner", url: "/de/gehaltsrechner", description: "Gehalt umrechnen." },
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Monatliche Rate berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Altersrechner" keywords="Altersrechner, wie alt bin ich, Alter berechnen, Alter in Tagen, Geburtsdatum Rechner" breadcrumbs={[{ name: "Altersrechner", url: "/de/altersrechner" }]} lang="de">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Altersrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finde dein genaues Alter in Jahren, Monaten, Tagen, Stunden und Minuten. Gib einfach dein Geburtsdatum ein.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm overflow-hidden">
      <div class="p-6 sm:p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <div class="space-y-5">
              <div>
                <label for="birth-date" class="block text-sm font-medium text-text mb-2">Geburtsdatum</label>
                <input type="date" id="birth-date" value="1990-06-15" class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
              </div>
              <div>
                <label for="target-date" class="block text-sm font-medium text-text mb-2">Alter am Datum</label>
                <input type="date" id="target-date" class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
                <p class="text-xs text-text-muted mt-1">Standard: heute. Ändern, um dein Alter an einem anderen Datum zu berechnen.</p>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="p-5 bg-primary rounded-2xl text-white text-center">
              <div class="text-sm font-medium text-blue-200 uppercase tracking-wide mb-1">Dein Alter</div>
              <div class="text-4xl sm:text-5xl font-extrabold" id="age-years">--</div>
              <div class="text-blue-200 font-medium mt-1" id="age-full">--</div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase tracking-wide">Monate</div><div class="text-2xl font-bold text-text" id="age-months">--</div></div>
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase tracking-wide">Wochen</div><div class="text-2xl font-bold text-text" id="age-weeks">--</div></div>
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase tracking-wide">Tage</div><div class="text-2xl font-bold text-text" id="age-days">--</div></div>
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase tracking-wide">Stunden</div><div class="text-2xl font-bold text-text" id="age-hours">--</div></div>
            </div>
            <div class="p-4 bg-accent/10 rounded-xl">
              <div class="text-xs text-accent uppercase tracking-wide font-medium">Nächster Geburtstag</div>
              <div class="text-lg font-bold text-text" id="next-birthday">--</div>
              <div class="text-sm text-text-secondary" id="next-birthday-days">--</div>
            </div>
          </div>
        </div>
        <ShareButton calculatorId="age" lang="de" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">Lebensmeilensteine</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border"><th class="text-left py-2 pr-4 font-semibold text-text">Meilenstein</th><th class="text-left py-2 pr-4 font-semibold text-text">Datum</th><th class="text-right py-2 font-semibold text-text">Status</th></tr></thead>
          <tbody id="milestones-tbody" class="text-text-secondary"></tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie berechnet man sein genaues Alter?</h2>
      <p>Die Berechnung des genauen Alters ist komplexer als einfach das Geburtsjahr vom aktuellen Jahr abzuziehen. Die präzise Berechnung muss den spezifischen Monat und Tag, Schaltjahre und unterschiedliche Monatslängen berücksichtigen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Alter in verschiedenen Einheiten</h3>
      <ul>
        <li><strong>Jahre:</strong> Die gebräuchlichste Art, das Alter auszudrücken</li>
        <li><strong>Monate:</strong> Oft für Babys und Kleinkinder verwendet (z.B. "18 Monate alt")</li>
        <li><strong>Wochen:</strong> Wird während der Schwangerschaft und frühen Kindheit verwendet</li>
        <li><strong>Tage:</strong> Für präzise Berechnungen, z.B. gesetzliche Altersanforderungen</li>
        <li><strong>Stunden:</strong> Zeigt den enormen Zeitumfang eines Menschenlebens</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Warum das genaue Alter berechnen?</h3>
      <ul>
        <li><strong>Rechtliche Anforderungen:</strong> Wahlalter, Volljährigkeit, Rentenalter, Führerscheinalter</li>
        <li><strong>Versicherung:</strong> Lebens- und Krankenversicherungsbeiträge basieren auf dem genauen Alter</li>
        <li><strong>Rentenplanung:</strong> Rentenansprüche hängen vom genauen Alter ab</li>
        <li><strong>Medizinische Zwecke:</strong> Wachstumskurven, Entwicklungsmeilensteine, Vorsorgeuntersuchungen</li>
      </ul>

      <h2 class="text-2xl font-bold text-text mt-12">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Berücksichtigt der Rechner Schaltjahre?</h3>
      <p>Ja, unser Altersrechner berücksichtigt Schaltjahre vollständig bei der Berechnung deines genauen Alters.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Kann ich mein Alter an einem zukünftigen Datum berechnen?</h3>
      <p>Ja! Ändere das Feld "Alter am Datum" auf ein beliebiges zukünftiges (oder vergangenes) Datum.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const birthInput = document.getElementById('birth-date') as HTMLInputElement;
    const targetInput = document.getElementById('target-date') as HTMLInputElement;
    const today = new Date();
    targetInput.value = today.toISOString().split('T')[0];

    function calculateAge() {
      const birth = new Date(birthInput.value + 'T00:00:00');
      const target = new Date(targetInput.value + 'T00:00:00');
      if (isNaN(birth.getTime()) || isNaN(target.getTime())) return;
      if (target < birth) return;

      let years = target.getFullYear() - birth.getFullYear();
      let months = target.getMonth() - birth.getMonth();
      let days = target.getDate() - birth.getDate();
      if (days < 0) { months--; const prevMonth = new Date(target.getFullYear(), target.getMonth(), 0); days += prevMonth.getDate(); }
      if (months < 0) { years--; months += 12; }

      const diffMs = target.getTime() - birth.getTime();
      const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const totalWeeks = Math.floor(totalDays / 7);
      const totalMonths = years * 12 + months;
      const totalHours = totalDays * 24;

      const fmt = (n: number) => n.toLocaleString('de-DE');

      document.getElementById('age-years')!.textContent = `${years} Jahre alt`;
      document.getElementById('age-full')!.textContent = `${years} Jahre, ${months} Monate, ${days} Tage`;
      document.getElementById('age-months')!.textContent = fmt(totalMonths);
      document.getElementById('age-weeks')!.textContent = fmt(totalWeeks);
      document.getElementById('age-days')!.textContent = fmt(totalDays);
      document.getElementById('age-hours')!.textContent = fmt(totalHours);

      const nextBirthday = new Date(target.getFullYear(), birth.getMonth(), birth.getDate());
      if (nextBirthday <= target) nextBirthday.setFullYear(nextBirthday.getFullYear() + 1);
      const daysUntil = Math.ceil((nextBirthday.getTime() - target.getTime()) / (1000 * 60 * 60 * 24));
      const nextAge = nextBirthday.getFullYear() - birth.getFullYear();

      document.getElementById('next-birthday')!.textContent = nextBirthday.toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
      document.getElementById('next-birthday-days')!.textContent = `${fmt(daysUntil)} Tage bis zu deinem ${nextAge}. Geburtstag`;

      updateMilestones(birth, target);

      const url = new URL(window.location.href);
      url.searchParams.set('dob', birthInput.value);
      url.searchParams.set('date', targetInput.value);
      history.replaceState(null, '', url.toString());
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    function updateMilestones(birth: Date, target: Date) {
      const milestones = [
        { label: '1.000 Tage alt', days: 1000 },
        { label: '5.000 Tage alt', days: 5000 },
        { label: '10.000 Tage alt', days: 10000 },
        { label: '20.000 Tage alt', days: 20000 },
        { label: '18. Geburtstag (Volljährig)', days: null, years: 18 },
        { label: '21. Geburtstag', days: null, years: 21 },
        { label: '30. Geburtstag', days: null, years: 30 },
        { label: '40. Geburtstag', days: null, years: 40 },
        { label: '50. Geburtstag', days: null, years: 50 },
        { label: '65. Geburtstag (Rente)', days: null, years: 65 },
        { label: '67. Geburtstag (Rente DE)', days: null, years: 67 },
      ];
      const tbody = document.getElementById('milestones-tbody')!;
      tbody.innerHTML = milestones.map(m => {
        let date: Date;
        if (m.days) { date = new Date(birth.getTime() + m.days * 24 * 60 * 60 * 1000); }
        else { date = new Date(birth.getFullYear() + (m.years || 0), birth.getMonth(), birth.getDate()); }
        const isPast = date <= target;
        const dateStr = date.toLocaleDateString('de-DE', { year: 'numeric', month: 'short', day: 'numeric' });
        return `<tr class="border-b border-border/50"><td class="py-2 pr-4">${m.label}</td><td class="py-2 pr-4">${dateStr}</td><td class="py-2 text-right font-medium ${isPast ? 'text-secondary' : 'text-text-muted'}">${isPast ? 'Erreicht' : 'Bevorstehend'}</td></tr>`;
      }).join('');
    }

    birthInput.addEventListener('change', calculateAge);
    targetInput.addEventListener('change', calculateAge);

    const params = new URL(window.location.href).searchParams;
    if (params.get('dob')) birthInput.value = params.get('dob')!;
    if (params.get('date')) targetInput.value = params.get('date')!;
    calculateAge();
  </script>
</CalculatorLayout>
