---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lineare Gleichung Rechner – Gleichungen & Systeme lösen";
const description = "Lösen Sie lineare Gleichungen und 2×2-Gleichungssysteme Schritt für Schritt mit ausführlicher Erklärung.";
const relatedCalcs = [
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
  { name: "Linsengleichung Rechner", url: "/de/linsen-gleichung-rechner", description: "Optik." },
  { name: "Absolutwert-Rechner", url: "/de/absolutwert-rechner", description: "Absolutwert." },
  { name: "Längeneinheit Umrechner", url: "/de/laengeneinheit-umrechner", description: "Einheiten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="linear-equation-calculator" calculatorName="Lineare Gleichung Rechner" keywords="lineare Gleichung lösen, Gleichungssystem, ax+b=c, 2x2 System, Schritt für Schritt" breadcrumbs={[{ name: "Lineare Gleichung Rechner", url: "/de/lineare-gleichung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lineare Gleichung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Lineare Gleichungen und 2×2-Gleichungssysteme mit Lösungsweg berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="leq-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="single">Einzelgleichung ax+b=c</button>
          <button class="leq-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="system">2×2 Gleichungssystem</button>
        </div>
        <div id="leq-panel-single" class="space-y-3">
          <p class="text-xs text-text-muted">Löse: ax + b = c</p>
          <div class="grid grid-cols-3 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">a</label><input type="number" id="leq-a" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="3" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">b</label><input type="number" id="leq-b" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="-6" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">c</label><input type="number" id="leq-c" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold text-center" value="9" step="any"></div>
          </div>
        </div>
        <div id="leq-panel-system" class="hidden space-y-3">
          <p class="text-xs text-text-muted">Löse: a₁x + b₁y = c₁ und a₂x + b₂y = c₂</p>
          <div class="grid grid-cols-3 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">a₁</label><input type="number" id="leq-a1" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="2" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">b₁</label><input type="number" id="leq-b1" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="3" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">c₁</label><input type="number" id="leq-c1" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="7" step="any"></div>
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">a₂</label><input type="number" id="leq-a2" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="5" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">b₂</label><input type="number" id="leq-b2" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="-2" step="any"></div>
            <div><label class="block text-xs font-medium text-text mb-1">c₂</label><input type="number" id="leq-c2" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="-1" step="any"></div>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="leq-label">Lösung</div>
          <div class="text-4xl font-extrabold font-mono" id="leq-result">x = 0</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Lösungsweg</h3>
          <div class="text-sm font-mono space-y-1" id="leq-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="lineare-gleichung" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Lineare Gleichungen lösen</h2>
      <p>Eine lineare Gleichung der Form ax + b = c wird gelöst, indem man beide Seiten umformt: x = (c - b) / a. Für Gleichungssysteme mit zwei Unbekannten nutzt man das Gaußsche Eliminationsverfahren oder die Cramersche Regel. Lineare Gleichungen sind die Grundlage der Algebra und finden Anwendung in Physik, Wirtschaft und Informatik.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist eine lineare Gleichung?</summary>
          <p class="mt-2 text-sm text-text-secondary">Eine lineare Gleichung enthält die Unbekannte nur in der ersten Potenz (keine x², x³ etc.). Sie hat die Form ax + b = c und hat genau eine Lösung, wenn a ≠ 0.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was sind Gleichungssysteme?</summary>
          <p class="mt-2 text-sm text-text-secondary">Ein lineares Gleichungssystem besteht aus mehreren Gleichungen mit mehreren Unbekannten. Ein 2×2-System hat 2 Gleichungen mit 2 Unbekannten (x und y) und kann eindeutig, mehrdeutig oder unlösbar sein.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was bedeutet "keine Lösung" oder "unendlich viele Lösungen"?</summary>
          <p class="mt-2 text-sm text-text-secondary">Keine Lösung: Die Gleichungen widersprechen sich (z.B. 0 = 5). Dies passiert bei parallelen Geraden. Unendlich viele Lösungen: Die Gleichungen beschreiben dieselbe Gerade (z.B. 0 = 0).</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist die Cramersche Regel?</summary>
          <p class="mt-2 text-sm text-text-secondary">Die Cramersche Regel löst Gleichungssysteme über Determinanten: x = D_x/D und y = D_y/D, wobei D die Systemdeterminante und D_x, D_y die entsprechenden Unterdeterminanten sind.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let leqMode = 'single';
    function setLeqMode(m: string) {
      leqMode = m;
      document.querySelectorAll('.leq-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = `leq-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ${active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted'}`;
      });
      document.getElementById('leq-panel-single')!.classList.toggle('hidden', m !== 'single');
      document.getElementById('leq-panel-system')!.classList.toggle('hidden', m !== 'system');
      calcLeq();
    }
    function fmt(v: number) { return v.toLocaleString('de-DE', { maximumFractionDigits: 6 }); }
    function calcLeq() {
      const stepsEl = document.getElementById('leq-steps')!;
      if (leqMode === 'single') {
        const a = parseFloat((document.getElementById('leq-a') as HTMLInputElement).value) || 0;
        const b = parseFloat((document.getElementById('leq-b') as HTMLInputElement).value) || 0;
        const c = parseFloat((document.getElementById('leq-c') as HTMLInputElement).value) || 0;
        document.getElementById('leq-label')!.textContent = `Lösung für ${a}x + ${b} = ${c}`;
        if (a === 0) {
          if (b === c) {
            document.getElementById('leq-result')!.textContent = 'Alle x (∞ Lösungen)';
            stepsEl.innerHTML = `<div>0·x + ${b} = ${c}</div><div>${b} = ${c} → Wahre Aussage: Alle x sind Lösungen</div>`;
          } else {
            document.getElementById('leq-result')!.textContent = 'Keine Lösung';
            stepsEl.innerHTML = `<div>0·x + ${b} = ${c}</div><div>${b} ≠ ${c} → Widerspruch: Keine Lösung</div>`;
          }
        } else {
          const x = (c - b) / a;
          document.getElementById('leq-result')!.textContent = `x = ${fmt(x)}`;
          stepsEl.innerHTML = `<div>${a}x + ${b} = ${c}</div><div>${a}x = ${c} - ${b} = ${c - b}</div><div>x = ${c - b} ÷ ${a} = ${fmt(x)}</div>`;
        }
      } else {
        const a1 = parseFloat((document.getElementById('leq-a1') as HTMLInputElement).value) || 0;
        const b1 = parseFloat((document.getElementById('leq-b1') as HTMLInputElement).value) || 0;
        const c1 = parseFloat((document.getElementById('leq-c1') as HTMLInputElement).value) || 0;
        const a2 = parseFloat((document.getElementById('leq-a2') as HTMLInputElement).value) || 0;
        const b2 = parseFloat((document.getElementById('leq-b2') as HTMLInputElement).value) || 0;
        const c2 = parseFloat((document.getElementById('leq-c2') as HTMLInputElement).value) || 0;
        const D = a1 * b2 - a2 * b1;
        document.getElementById('leq-label')!.textContent = 'Gleichungssystem';
        if (Math.abs(D) < 1e-12) {
          document.getElementById('leq-result')!.textContent = D === 0 ? 'Keine/unendl. Lösungen' : 'Keine Lösung';
          stepsEl.innerHTML = `<div>Determinante D = ${a1}·${b2} - ${a2}·${b1} = ${fmt(D)}</div><div>D = 0: System nicht eindeutig lösbar</div>`;
        } else {
          const Dx = c1 * b2 - c2 * b1;
          const Dy = a1 * c2 - a2 * c1;
          const x = Dx / D;
          const y = Dy / D;
          document.getElementById('leq-result')!.textContent = `x = ${fmt(x)}, y = ${fmt(y)}`;
          stepsEl.innerHTML = `
            <div>D = ${a1}·${b2} - ${a2}·${b1} = ${fmt(D)}</div>
            <div>Dx = ${c1}·${b2} - ${c2}·${b1} = ${fmt(Dx)}</div>
            <div>Dy = ${a1}·${c2} - ${a2}·${c1} = ${fmt(Dy)}</div>
            <div>x = Dx/D = ${fmt(Dx)}/${fmt(D)} = ${fmt(x)}</div>
            <div>y = Dy/D = ${fmt(Dy)}/${fmt(D)} = ${fmt(y)}</div>`;
        }
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.leq-mode').forEach(b => b.addEventListener('click', () => setLeqMode((b as HTMLButtonElement).dataset.mode!)));
      ['leq-a','leq-b','leq-c','leq-a1','leq-b1','leq-c1','leq-a2','leq-b2','leq-c2'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcLeq); el.addEventListener('change', calcLeq); }
      });
      calcLeq();
    }, 50);
  </script>
</CalculatorLayout>
