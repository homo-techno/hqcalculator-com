---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Biorhythmus-Rechner - Chronotyp & Leistungszeitfenster";
const description = "Bestimmen Sie Ihren Chronotyp, optimale Schlaf- und Wachzeiten, Leistungshochs und ideale Lichtexposition fuer Ihren zirkadianen Rhythmus.";
const relatedCalcs = [
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrung." },
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI-Perzentil." },
  { name: "Chi-Quadrat-Rechner", url: "/de/chi-quadrat-rechner", description: "Statistik." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Chemisches Peeling", url: "/de/chemisches-peeling-rechner", description: "Hautpflege." },
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Biorhythmus-Rechner" enSlug="circadian-rhythm-calculator" keywords="zirkadianer Rhythmus, Chronotyp, Schlaf-Wach-Zyklus, Leistungshoch, Morgenmensch, Nachteule, Lichtexposition, Melatonin" breadcrumbs={[{ name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Biorhythmus-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Entdecken Sie Ihren Chronotyp und optimieren Sie Ihren Tagesablauf fuer Hoechstleistung und besseren Schlaf.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Natuerliche Aufwachzeit (ohne Wecker, an freien Tagen)</label>
          <input type="time" id="br-wake" class="br-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Natuerliche Schlafenszeit (wenn Sie muede werden)</label>
          <input type="time" id="br-bed" class="br-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Wann fuehlen Sie sich am wachsten?</label>
          <select id="br-alert" class="br-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center">
            <option value="early">Fruehmorgens (6-9 Uhr)</option>
            <option value="mid">Vormittags (9-12 Uhr)</option>
            <option value="afternoon">Nachmittags (12-16 Uhr)</option>
            <option value="evening">Abends (16-20 Uhr)</option>
            <option value="late">Spaetabends (20-24 Uhr)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ihr Alter</label>
          <input type="number" id="br-age" class="br-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" min="10" max="100" step="1">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm opacity-80">Ihr Chronotyp</div>
          <div class="text-2xl font-extrabold mt-1" id="br-type">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Optimale Aufwachzeit</div>
            <div class="text-xl font-bold text-text mt-1" id="br-owake">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Optimale Schlafenszeit</div>
            <div class="text-xl font-bold text-text mt-1" id="br-obed">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Leistungszeitfenster</div>
          <div class="text-sm text-text space-y-1" id="br-peaks">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Morgendliche Lichtexposition</div>
            <div class="text-xl font-bold text-text mt-1" id="br-light">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary">Koffein-Grenze</div>
            <div class="text-xl font-bold text-text mt-1" id="br-caffcut">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-secondary mb-2">Melatonin & Lichttiming</div>
          <div class="text-sm text-text" id="br-melatonin">--</div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="biorhythmus" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zirkadianer Rhythmus und Chronotyp</h2>
      <p>Der zirkadiane Rhythmus ist Ihre innere Uhr, die den Schlaf-Wach-Zyklus, die Hormonausschuettung und die koerperliche Leistungsfaehigkeit steuert. Ihr Chronotyp bestimmt, ob Sie eher ein Morgenmensch (Lerche) oder eine Nachteule sind.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Tipps fuer einen gesunden Rhythmus</h3>
      <ul>
        <li>Helle Lichtexposition morgens (moeglichst Tageslicht) hilft, die innere Uhr zu synchronisieren</li>
        <li>Koffein mindestens 8 Stunden vor dem Schlafengehen vermeiden</li>
        <li>Regelmaessige Schlaf- und Aufwachzeiten einhalten -- auch am Wochenende</li>
        <li>Abends blaues Licht (Bildschirme) reduzieren</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function minToTimeStr24(m: number): string {
      const mins = ((m % 1440) + 1440) % 1440;
      const h = Math.floor(mins / 60);
      const mm = mins % 60;
      return String(h).padStart(2, '0') + ':' + String(mm).padStart(2, '0') + ' Uhr';
    }

    function calcBR() {
      const wakeStr = (document.getElementById('br-wake') as HTMLInputElement).value || '07:30';
      const bedStr = (document.getElementById('br-bed') as HTMLInputElement).value || '23:00';
      const alertPref = (document.getElementById('br-alert') as HTMLSelectElement).value;
      const age = parseInt((document.getElementById('br-age') as HTMLInputElement).value) || 30;

      const [wH, wM] = wakeStr.split(':').map(Number);
      const [bH, bM] = bedStr.split(':').map(Number);
      const wakeMins = wH * 60 + wM;
      let bedMins = bH * 60 + bM;
      if (bedMins < wakeMins) bedMins += 1440;

      // Chronotype determination
      let type = 'Normaltyp (Baer)';
      let typeDesc = '';
      const alertScore: Record<string, number> = { early: -2, mid: -1, afternoon: 0, evening: 1, late: 2 };
      const aScore = alertScore[alertPref] || 0;
      const wakeScore = wakeMins < 360 ? -2 : wakeMins < 420 ? -1 : wakeMins < 510 ? 0 : wakeMins < 600 ? 1 : 2;
      const totalScore = aScore + wakeScore;

      if (totalScore <= -2) {
        type = 'Fruehaufsteher (Loewe/Lerche)';
        typeDesc = 'Sie sind ein ausgepraegtert Morgentyp. Ihr Biorhythmus beguenstigt fruehe Tagesablaeufe.';
      } else if (totalScore <= 0) {
        type = 'Normaltyp (Baer)';
        typeDesc = 'Sie folgen einem sonnenlichtbasierten Rhythmus. Etwa 55% der Menschen teilen diesen Chronotyp.';
      } else if (totalScore <= 2) {
        type = 'Abendtyp (Wolf)';
        typeDesc = 'Sie sind ein Abendchronotyp. Kreativitaet und Energie kommen spaeter am Tag.';
      } else {
        type = 'Nachteule (Wolf+)';
        typeDesc = 'Sie sind eine ausgepraegt Nachteule. Ihr natuerlicher Rhythmus laeuft 2-3 Stunden spaeter als der Durchschnitt.';
      }

      if (age < 20) typeDesc += ' Hinweis: Jugendliche neigen naturgemaess zu spaeteren Chronotypen.';
      else if (age > 55) typeDesc += ' Hinweis: Der Chronotyp verschiebt sich im Alter oft nach vorne.';

      const optWake = wakeMins;
      const optBed = bedMins % 1440;

      // Peak performance windows relative to wake time
      const peak1Start = wakeMins + 90;
      const peak1End = wakeMins + 240;
      const peak2Start = wakeMins + 480;
      const peak2End = wakeMins + 600;

      // Light exposure: within first 60 min of waking
      const lightStart = wakeMins;
      const lightEnd = wakeMins + 60;

      // Caffeine cutoff: 8+ hours before bed
      const caffCutoff = (bedMins - 480) % 1440;

      // Melatonin onset: ~2 hrs before natural bedtime
      const melOnset = (bedMins - 120) % 1440;

      document.getElementById('br-type')!.textContent = type;
      document.getElementById('br-owake')!.textContent = minToTimeStr24(optWake);
      document.getElementById('br-obed')!.textContent = minToTimeStr24(optBed);
      document.getElementById('br-light')!.textContent = minToTimeStr24(lightStart) + ' - ' + minToTimeStr24(lightEnd);
      document.getElementById('br-caffcut')!.textContent = 'Vor ' + minToTimeStr24(caffCutoff);

      const peaksHtml = '<div class="flex justify-between"><span>Leistungshoch #1 (analytisch)</span><span>' + minToTimeStr24(peak1Start) + ' - ' + minToTimeStr24(peak1End) + '</span></div>' +
        '<div class="flex justify-between"><span>Nachmittagstief (Routine/Erholung)</span><span>' + minToTimeStr24(peak1End) + ' - ' + minToTimeStr24(peak2Start) + '</span></div>' +
        '<div class="flex justify-between"><span>Leistungshoch #2 (kreativ)</span><span>' + minToTimeStr24(peak2Start) + ' - ' + minToTimeStr24(peak2End) + '</span></div>';
      document.getElementById('br-peaks')!.innerHTML = peaksHtml;

      document.getElementById('br-melatonin')!.textContent = typeDesc + ' Geschaetzter Melatonin-Anstieg um ca. ' + minToTimeStr24(melOnset) + '. Danach Licht dimmen und Bildschirme meiden. Setzen Sie sich zwischen ' + minToTimeStr24(lightStart) + ' und ' + minToTimeStr24(lightEnd) + ' hellem Licht aus, um Ihre innere Uhr zu synchronisieren.';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('br-wake') as HTMLInputElement).value = '07:30';
      (document.getElementById('br-bed') as HTMLInputElement).value = '23:00';
      (document.getElementById('br-age') as HTMLInputElement).value = '30';
      document.querySelectorAll('.br-in').forEach(el => {
        el.addEventListener('input', calcBR);
        el.addEventListener('change', calcBR);
      });
      calcBR();
    }, 50);
  </script>
</CalculatorLayout>
