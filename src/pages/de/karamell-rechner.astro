---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Karamell-Rechner - Temperaturstufen & Rezept-Skalierung";
const description = "Berechnen Sie Karamell-Rezeptmengen und lernen Sie die genauen Temperaturstufen von hellem bis dunklem Karamell. Skalieren Sie Karamellso\u00dfen- und Bonbon-Rezepte.";
const relatedCalcs = [
  { name: "Einmach-Rechner", url: "/de/einmach-rechner", description: "Einmachen." },
  { name: "Kerzenherstellung", url: "/de/kerzenherstellung-rechner", description: "Kerzen." },
  { name: "Kuchenform-Umrechner", url: "/de/kuchenform-umrechner", description: "Backformen." },
  { name: "Kuchen-Portionen", url: "/de/kuchen-portionen-rechner", description: "Kuchen." },
  { name: "Kerzen-Brenndauer", url: "/de/kerzen-brenndauer-rechner", description: "Kerzen." },
  { name: "Kalorienverbrauch", url: "/de/kalorienverbrauch-rechner", description: "Kalorien." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Karamell-Rechner" lang="de" enSlug="caramel-calculator" keywords="karamell temperatur, karamellso\u00dfe rezept, karamellstufen, bonbon machen, gesalzenes karamell, karamell skalierung" breadcrumbs={[{ name: "Karamell", url: "/de/karamell-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Karamell-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Skalieren Sie Karamellso&szlig;en- und Bonbon-Rezepte mit pr&auml;zisen Temperaturstufen. Von hellem Karamell bis dunklem Bernstein.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Karamellart</label>
          <select id="km-type" class="km-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="sauce">Karamellso&szlig;e (gie&szlig;bar)</option>
            <option value="soft">Weiche Karamellen (Bonbons)</option>
            <option value="hard">Harte Karamellen / Toffee</option>
            <option value="dry">Trockenkaramell (nur Zucker)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschte Farbe / Stufe</label>
          <select id="km-stage" class="km-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="light">Helles Karamell (160-166&deg;C)</option>
            <option value="medium" selected>Mittlerer Bernstein (166-171&deg;C)</option>
            <option value="dark">Dunkler Bernstein (171-177&deg;C)</option>
            <option value="vdark">Sehr dunkel (177-182&deg;C)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschte Menge (Tassen, ca. 240ml)</label>
          <input type="number" id="km-yield" class="km-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0.25" step="0.25">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Zieltemperatur</div>
          <div class="text-5xl font-extrabold font-mono" id="km-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zucker</div>
            <div class="text-xl font-bold font-mono" id="km-sugar">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Sahne</div>
            <div class="text-xl font-bold font-mono" id="km-cream">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Butter</div>
            <div class="text-xl font-bold font-mono" id="km-butter">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Salz</div>
            <div class="text-xl font-bold font-mono" id="km-salt">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Geschmacksprofil</div>
          <div class="text-sm text-text-secondary" id="km-profile">--</div>
        </div>
      </div>
      <ShareButton calculatorId="caramel" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <h3 class="text-xl font-semibold text-text mt-6">Welche Temperatur f&uuml;r Karamell?</h3>
      <p>Helles Karamell entsteht bei 160-166&deg;C, mittleres bei 166-171&deg;C, dunkles bei 171-177&deg;C. Ab 182&deg;C verbrennt der Zucker. Verwenden Sie immer ein Zuckerthermometer.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKM() {
      const type = (document.getElementById('km-type') as HTMLSelectElement).value;
      const stage = (document.getElementById('km-stage') as HTMLSelectElement).value;
      const yield_ = parseFloat((document.getElementById('km-yield') as HTMLInputElement).value) || 1;

      const temps: Record<string, {c: string}> = {
        light: { c: '160-166' },
        medium: { c: '166-171' },
        dark: { c: '171-177' },
        vdark: { c: '177-182' },
      };

      const profiles: Record<string, string> = {
        light: 'S\u00fc\u00df, buttrig, milder Karamellgeschmack. Am besten f\u00fcr Karamellso\u00dfen und leichte Anwendungen.',
        medium: 'Ausgewogen s\u00fc\u00df und leicht bitter. Klassischer Karamellgeschmack. Am vielseitigsten f\u00fcr So\u00dfen und Bonbons.',
        dark: 'Komplex, leicht bitter, tiefer Geschmack. Hervorragend f\u00fcr Karamell-Desserts und anspruchsvolle Konfektionen.',
        vdark: 'Intensiv bitterns\u00fc\u00df. F\u00fcr Dekoration, Karamellk\u00e4fige und kr\u00e4ftige Geschmackskontraste. Sekunden vom Verbrennen entfernt.',
      };

      let sugarG = 0, creamMl = 0, butterG = 0, saltG = 0;

      if (type === 'sauce') {
        sugarG = 200 * yield_;
        creamMl = 240 * yield_;
        butterG = 60 * yield_;
        saltG = 3 * yield_;
      } else if (type === 'soft') {
        sugarG = 250 * yield_;
        creamMl = 180 * yield_;
        butterG = 85 * yield_;
        saltG = 4 * yield_;
      } else if (type === 'hard') {
        sugarG = 300 * yield_;
        creamMl = 120 * yield_;
        butterG = 115 * yield_;
        saltG = 3 * yield_;
      } else {
        sugarG = 200 * yield_;
        creamMl = 0;
        butterG = 0;
        saltG = 0;
      }

      const t = temps[stage];
      document.getElementById('km-result')!.textContent = t.c + '\u00b0C';
      document.getElementById('km-sugar')!.textContent = sugarG.toFixed(0) + ' g';
      document.getElementById('km-cream')!.textContent = creamMl > 0 ? creamMl.toFixed(0) + ' ml' : 'Keine';
      document.getElementById('km-butter')!.textContent = butterG > 0 ? butterG.toFixed(0) + ' g' : 'Keine';
      document.getElementById('km-salt')!.textContent = saltG > 0 ? saltG.toFixed(1).replace('.', ',') + ' g' : 'Keines';
      document.getElementById('km-profile')!.textContent = profiles[stage];

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.km-in').forEach(el => { el.addEventListener('input', calcKM); el.addEventListener('change', calcKM); });
      calcKM();
    }, 50);
  </script>
</CalculatorLayout>
