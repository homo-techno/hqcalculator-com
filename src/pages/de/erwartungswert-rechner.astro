---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Erwartungswert-Rechner - EV, Varianz & Risiko";
const description = "Berechnen Sie den Erwartungswert aus Ergebnissen und Wahrscheinlichkeiten. Inkl. Varianz, Standardabweichung und Risikobewertung.";

const relatedCalcs = [
  { name: "Wahrscheinlichkeit-Rechner", url: "/de/wahrscheinlichkeit-rechner", description: "Wahrscheinlichkeiten." },
  { name: "Standardabweichung-Rechner", url: "/de/standardabweichung-rechner", description: "Streuungsanalyse." },
  { name: "Durchschnitts-Rechner", url: "/de/durchschnitt-rechner", description: "Mittelwertberechnung." },
  { name: "Prozent-Rechner", url: "/de/prozent-rechner", description: "Prozentrechnungen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Erwartungswert-Rechner" lang="de" enSlug="expected-value-calculator" keywords="erwartungswert rechner, ev berechnen, varianz, standardabweichung, risikobewertung, wahrscheinlichkeit" breadcrumbs={[{ name: "Erwartungswert-Rechner", url: "/de/erwartungswert-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Erwartungswert-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie Ergebnisse und deren Wahrscheinlichkeiten ein, um Erwartungswert, Varianz und Risikokennzahlen zu berechnen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex justify-between items-center mb-2">
          <h3 class="font-semibold text-text">Ergebnisse</h3>
          <button id="ewr-add" class="px-3 py-1 bg-primary text-white text-sm rounded-lg hover:bg-blue-700">+ Ergebnis hinzuf&uuml;gen</button>
        </div>
        <div id="ewr-rows" class="space-y-3"></div>

        <div class="text-sm text-text-secondary text-right" id="ewr-probsum"></div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Erwartungswert (EV)</div>
          <div class="text-5xl font-extrabold font-mono" id="ewr-ev">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Varianz</div><div class="text-xl font-bold font-mono" id="ewr-var">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Standardabw.</div><div class="text-xl font-bold font-mono" id="ewr-sd">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bestes Ergebnis</div><div class="text-xl font-bold font-mono" id="ewr-best">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schlechtestes Ergebnis</div><div class="text-xl font-bold font-mono" id="ewr-worst">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Risikobewertung</div>
          <div class="text-lg font-bold" id="ewr-risk">--</div>
        </div>
      </div>
      <ShareButton calculatorId="expected-value-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Erwartungswert-Formeln</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>EV:</strong> Summe von (Wert &times; Wahrscheinlichkeit) aller Ergebnisse</p>
        <p><strong>Varianz:</strong> Summe von (Wahrscheinlichkeit &times; (Wert &minus; EV)&sup2;)</p>
        <p><strong>Std.Abw.:</strong> Quadratwurzel der Varianz</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was bedeutet ein positiver Erwartungswert?</strong> Ein positiver EV bedeutet, dass das Ergebnis langfristig profitabel ist.</p>
      <p><strong>Was sagt die Varianz aus?</strong> Eine hohe Varianz bedeutet eine gro&szlig;e Streuung der m&ouml;glichen Ergebnisse, also h&ouml;heres Risiko.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let ewrRows = [
      { value: 100, prob: 0.3 },
      { value: -50, prob: 0.7 }
    ];

    function renderEWRRows() {
      const container = document.getElementById('ewr-rows')!;
      let html = '';
      for (let i = 0; i < ewrRows.length; i++) {
        html += '<div class="grid grid-cols-[1fr_1fr_auto] gap-2 items-end">' +
          '<div><label class="block text-xs font-medium text-text mb-1">Wert (\u20AC)</label>' +
          '<input type="number" class="ewr-in w-full px-3 py-2 border border-border rounded-lg text-center" data-idx="' + i + '" data-field="value" value="' + ewrRows[i].value + '" step="any"></div>' +
          '<div><label class="block text-xs font-medium text-text mb-1">Wahrscheinlichkeit</label>' +
          '<input type="number" class="ewr-in w-full px-3 py-2 border border-border rounded-lg text-center" data-idx="' + i + '" data-field="prob" value="' + ewrRows[i].prob + '" min="0" max="1" step="0.01"></div>' +
          '<button class="ewr-del px-2 py-2 text-red-500 hover:bg-red-50 rounded-lg text-sm" data-idx="' + i + '">X</button></div>';
      }
      container.innerHTML = html;
      container.querySelectorAll('.ewr-in').forEach(el => {
        el.addEventListener('input', (e) => {
          const t = e.target as HTMLInputElement;
          const idx = parseInt(t.dataset.idx || '0');
          const field = t.dataset.field as 'value' | 'prob';
          ewrRows[idx][field] = parseFloat(t.value) || 0;
          calcEWR();
        });
      });
      container.querySelectorAll('.ewr-del').forEach(el => {
        el.addEventListener('click', (e) => {
          const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
          if (ewrRows.length > 1) { ewrRows.splice(idx, 1); renderEWRRows(); calcEWR(); }
        });
      });
    }

    function calcEWR() {
      const probSum = ewrRows.reduce((s, r) => s + r.prob, 0);
      document.getElementById('ewr-probsum')!.textContent = 'Gesamtwahrscheinlichkeit: ' + probSum.toFixed(4).replace('.', ',') + (Math.abs(probSum - 1) > 0.001 ? ' (sollte 1,0 sein)' : ' OK');

      const ev = ewrRows.reduce((s, r) => s + r.value * r.prob, 0);
      const variance = ewrRows.reduce((s, r) => s + r.prob * Math.pow(r.value - ev, 2), 0);
      const sd = Math.sqrt(variance);
      const values = ewrRows.map(r => r.value);
      const best = Math.max(...values);
      const worst = Math.min(...values);

      document.getElementById('ewr-ev')!.textContent = (ev >= 0 ? '+' : '') + ev.toFixed(2).replace('.', ',');
      document.getElementById('ewr-var')!.textContent = variance.toFixed(2).replace('.', ',');
      document.getElementById('ewr-sd')!.textContent = sd.toFixed(2).replace('.', ',');
      document.getElementById('ewr-best')!.textContent = best.toFixed(2).replace('.', ',') + ' \u20AC';
      document.getElementById('ewr-worst')!.textContent = worst.toFixed(2).replace('.', ',') + ' \u20AC';

      let risk = 'Neutral';
      if (ev > 0 && sd < ev) risk = 'G\u00FCnstig - Niedriges Risiko';
      else if (ev > 0 && sd >= ev) risk = 'G\u00FCnstig - Hohe Varianz';
      else if (ev < 0 && Math.abs(ev) > sd) risk = 'Ung\u00FCnstig - Hohes Risiko';
      else if (ev < 0) risk = 'Ung\u00FCnstig - Moderates Risiko';
      document.getElementById('ewr-risk')!.textContent = risk;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('ewr-add')!.addEventListener('click', () => {
        ewrRows.push({ value: 0, prob: 0 });
        renderEWRRows();
        calcEWR();
      });
      renderEWRRows();
      calcEWR();
    }, 50);
  </script>
</CalculatorLayout>
