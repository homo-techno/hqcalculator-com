---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Warteschleife Rechner - Einflugverfahren & Treibstoff 2026";
const description = "Berechne Einflugverfahren, Treibstoffverbrauch und Beintiming fuer Flugzeug-Warteschleifen. Fuer Piloten und Flugschueler.";

const relatedCalcs = [
  { name: "Hypothekenrechner", url: "/de/hypothekenrechner", description: "Hypothekenrate." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeitberechnungen." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Warteschleife-Rechner" keywords="Warteschleife Rechner, Einflugverfahren, Treibstoff Warteschleife, Direkteinflug, Gegenkurseinflug, Teardrop, Flugnavigation" breadcrumbs={[{ name: "Warteschleife-Rechner", url: "/de/warteschleife-rechner" }]} lang="de" enSlug="holding-pattern-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Warteschleife-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimme das Einflugverfahren, den Treibstoffverbrauch und das Bein-Timing fuer Standard- und Nichtstandard-Warteschleifen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label for="wsl-inbound" class="block text-sm font-medium text-text mb-1">Einflugkurs zum Fix (Grad)</label>
          <input type="number" id="wsl-inbound" class="wsl-in w-full border border-border rounded-lg px-3 py-2" min="1" max="360" step="1" />
        </div>
        <div>
          <label for="wsl-heading" class="block text-sm font-medium text-text mb-1">Aktueller Kurs des Flugzeugs (Grad)</label>
          <input type="number" id="wsl-heading" class="wsl-in w-full border border-border rounded-lg px-3 py-2" min="1" max="360" step="1" />
        </div>
        <div>
          <label for="wsl-turns" class="block text-sm font-medium text-text mb-1">Drehrichtung</label>
          <select id="wsl-turns" class="wsl-in w-full border border-border rounded-lg px-3 py-2">
            <option value="right" selected>Standard (Rechtskurven)</option>
            <option value="left">Nichtstandard (Linkskurven)</option>
          </select>
        </div>
        <div>
          <label for="wsl-alt" class="block text-sm font-medium text-text mb-1">Wartehoehe (ft MSL)</label>
          <input type="number" id="wsl-alt" class="wsl-in w-full border border-border rounded-lg px-3 py-2" min="0" step="1000" />
        </div>
        <div>
          <label for="wsl-tas" class="block text-sm font-medium text-text mb-1">Wartegeschwindigkeit (kts IAS)</label>
          <input type="number" id="wsl-tas" class="wsl-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5" />
        </div>
        <div>
          <label for="wsl-ff" class="block text-sm font-medium text-text mb-1">Treibstoffverbrauch (l/h)</label>
          <input type="number" id="wsl-ff" class="wsl-in w-full border border-border rounded-lg px-3 py-2" min="0" step="0.5" />
        </div>
        <div>
          <label for="wsl-time" class="block text-sm font-medium text-text mb-1">Erwartete Wartezeit (min)</label>
          <input type="number" id="wsl-time" class="wsl-in w-full border border-border rounded-lg px-3 py-2" min="0" step="5" />
        </div>
        <div>
          <label for="wsl-fuel" class="block text-sm font-medium text-text mb-1">Verbleibender Treibstoff (l)</label>
          <input type="number" id="wsl-fuel" class="wsl-in w-full border border-border rounded-lg px-3 py-2" min="0" step="1" />
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Einflugverfahren</div>
          <div class="text-4xl font-extrabold font-mono" id="wsl-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Treibstoff in Warteschleife</div>
            <div class="text-xl font-bold font-mono" id="wsl-fuelused">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Treibstoff danach</div>
            <div class="text-xl font-bold font-mono" id="wsl-fuelafter">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Einflugbein-Zeit</div>
            <div class="text-xl font-bold font-mono" id="wsl-legtime">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Max. Wartegeschw.</div>
            <div class="text-xl font-bold font-mono" id="wsl-maxspd">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Max. Wartezeit (mit Treibstoff)</div>
          <div class="text-lg font-bold font-mono" id="wsl-maxhold">--</div>
        </div>
      </div>

      <ShareButton calculatorId="holding-pattern" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Warteschleifen in der Fliegerei</h2>
      <p>Eine Warteschleife ist ein genormtes Flugmanoever, das Piloten nutzen, wenn sie auf eine Freigabe warten. Es gibt drei Einflugverfahren: Direkteinflug, Gegenkurseinflug und Teardrop-Einflug.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Was ist ein Direkteinflug?</strong> Der Direkteinflug wird gewaehlt, wenn der aktuelle Kurs des Flugzeugs innerhalb von 70 Grad des Ausgangskurses der Warteschleife liegt.</p>
      <p><strong>Wie lange ist ein Standard-Warteschleifen-Bein?</strong> Unterhalb von 14.000 ft MSL betraegt die Einflugbein-Zeit 1 Minute. Darueber sind es 1,5 Minuten.</p>
      <p><strong>Was sind die Geschwindigkeitsgrenzen?</strong> Bis 6.000 ft: 200 KIAS, 6.001-14.000 ft: 230 KIAS, ueber 14.000 ft: 265 KIAS.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcWSL() {
      const inbound = parseFloat((document.getElementById('wsl-inbound') as HTMLInputElement).value) || 360;
      const heading = parseFloat((document.getElementById('wsl-heading') as HTMLInputElement).value) || 180;
      const turns = (document.getElementById('wsl-turns') as HTMLSelectElement).value;
      const alt = parseFloat((document.getElementById('wsl-alt') as HTMLInputElement).value) || 5000;
      const ff = parseFloat((document.getElementById('wsl-ff') as HTMLInputElement).value) || 40;
      const holdTime = parseFloat((document.getElementById('wsl-time') as HTMLInputElement).value) || 30;
      const fuelRem = parseFloat((document.getElementById('wsl-fuel') as HTMLInputElement).value) || 150;

      const outbound = (inbound + 180) % 360 || 360;
      let relBearing = heading - outbound;
      if (relBearing < 0) relBearing += 360;
      if (relBearing >= 360) relBearing -= 360;

      let entry = '';
      if (turns === 'right') {
        if (relBearing >= 0 && relBearing <= 110) entry = 'Direkteinflug';
        else if (relBearing > 110 && relBearing <= 250) entry = 'Teardrop-Einflug';
        else entry = 'Gegenkurseinflug';
      } else {
        if (relBearing >= 250 || relBearing <= 0) entry = 'Direkteinflug';
        else if (relBearing >= 110 && relBearing < 250) entry = 'Teardrop-Einflug';
        else entry = 'Gegenkurseinflug';
      }

      const fuelUsed = (holdTime / 60) * ff;
      const fuelAfter = fuelRem - fuelUsed;
      const maxHoldMins = ff > 0 ? (fuelRem / ff) * 60 : 0;
      const legTime = alt <= 14000 ? '1 min' : '1,5 min';

      let maxSpd = 200;
      if (alt <= 6000) maxSpd = 200;
      else if (alt <= 14000) maxSpd = 230;
      else maxSpd = 265;

      document.getElementById('wsl-result')!.textContent = entry;
      document.getElementById('wsl-fuelused')!.textContent = fuelUsed.toFixed(1) + ' l';
      document.getElementById('wsl-fuelafter')!.textContent = fuelAfter.toFixed(1) + ' l';
      (document.getElementById('wsl-fuelafter')! as HTMLElement).style.color = fuelAfter < 0 ? '#dc2626' : '';
      document.getElementById('wsl-legtime')!.textContent = legTime;
      document.getElementById('wsl-maxspd')!.textContent = maxSpd + ' KIAS';

      const maxH = Math.floor(maxHoldMins / 60);
      const maxM = Math.round(maxHoldMins % 60);
      document.getElementById('wsl-maxhold')!.textContent = maxH + 'h ' + maxM + 'm (Bingo-Treibstoff)';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('wsl-inbound') as HTMLInputElement).value = '090';
      (document.getElementById('wsl-heading') as HTMLInputElement).value = '270';
      (document.getElementById('wsl-alt') as HTMLInputElement).value = '5000';
      (document.getElementById('wsl-tas') as HTMLInputElement).value = '100';
      (document.getElementById('wsl-ff') as HTMLInputElement).value = '40';
      (document.getElementById('wsl-time') as HTMLInputElement).value = '30';
      (document.getElementById('wsl-fuel') as HTMLInputElement).value = '150';
      document.querySelectorAll('.wsl-in').forEach(el => {
        el.addEventListener('input', calcWSL);
        el.addEventListener('change', calcWSL);
      });
      calcWSL();
    }, 50);
  </script>
</CalculatorLayout>
