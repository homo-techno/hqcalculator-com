---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Grauwasser-Wiederverwendung-Rechner - Systemdimensionierung & Wassereinsparung";
const description = "Berechnen Sie die Grauwasser-Systemdimensionierung und j&auml;hrliche Wassereinsparungen durch Wiederverwendung von Dusch-, Waschbecken- und Waschmaschinenwasser.";
const relatedCalcs = [
  { name: "Grauwasser-Rechner", url: "/de/grauwasser-rechner", description: "Grauwasservolumen." },
  { name: "Wasserverbrauch-Rechner", url: "/de/wasserverbrauch-rechner", description: "T&auml;glicher Verbrauch." },
  { name: "CO2-Fu&szlig;abdruck-Rechner", url: "/de/co2-fussabdruck-rechner", description: "CO2-Emissionen." },
  { name: "Bew&auml;sserungsrechner", url: "/de/bewaesserungsrechner", description: "Bew&auml;sserungsplanung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Grauwasser-Wiederverwendung-Rechner" lang="de" enSlug="greywater-reuse-calculator" keywords="grauwasser wiederverwendung, grauwassersystem, wasserrecycling, wassereinsparung" breadcrumbs={[{ name: "Grauwasser-Wiederverwendung", url: "/de/grauwasser-wiederverwendung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Grauwasser-Wiederverwendung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Dimensionieren Sie ein Grauwassersystem und sch&auml;tzen Sie die j&auml;hrlichen Wasser- und Kosteneinsparungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Haushalt-Wasserquellen</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Personen im Haushalt</label><input type="number" id="gwrde-people" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="12" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Duschen/Tag (gesamt)</label><input type="number" id="gwrde-showers" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" max="20" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Durchschn. Duschzeit (Min.)</label><input type="number" id="gwrde-showmin" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="3" max="30" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Durchfluss (L/Min.)</label><input type="number" id="gwrde-flow" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" min="4" max="20" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Waschladungen/Woche</label><input type="number" id="gwrde-laundry" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Liter pro Ladung</label><input type="number" id="gwrde-loadl" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="20" max="100" step="5"></div>
        </div>
        <h3 class="font-semibold text-text">Kosten</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wasserpreis (&euro;/m&sup3;)</label><input type="number" id="gwrde-watercost" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.00" min="0.5" max="10" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Abwasserpreis (&euro;/m&sup3;)</label><input type="number" id="gwrde-sewercost" class="gwrde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.50" min="0" max="10" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">T&auml;gliches Grauwasser verf&uuml;gbar</div>
          <div class="text-4xl font-extrabold" id="gwrde-daily">0</div>
          <div class="text-sm text-blue-200 mt-1">Liter/Tag</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliches Volumen</div><div class="text-xl font-bold" id="gwrde-annual">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Puffertank-Gr&ouml;&szlig;e</div><div class="text-xl font-bold" id="gwrde-tank">0 L</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Ersparnis</div><div class="text-xl font-bold" id="gwrde-savings">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bew&auml;sserungsfl&auml;che</div><div class="text-xl font-bold" id="gwrde-irrig">0 m&sup2;</div></div>
        </div>
      </div>
      <ShareButton calculatorId="greywater-reuse-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Grauwasser-Wiederverwendung verstehen</h2>
      <p>Grauwasser umfasst Wasser aus Duschen, Waschbecken und Waschmaschinen (nicht K&uuml;che oder Toilette). Es kann f&uuml;r Untergrundbe&auml;sserung und teilweise f&uuml;r Toilettensp&uuml;lung wiederverwendet werden. Ein typischer Haushalt erzeugt 80&ndash;120 Liter Grauwasser pro Person und Tag.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie gro&szlig; sollte der Puffertank sein?</strong> Mindestens das 1,5-fache des t&auml;glichen Spitzenvolumens.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcGWRDE() {
      const people = parseFloat((document.getElementById('gwrde-people') as HTMLInputElement).value) || 4;
      const showers = parseFloat((document.getElementById('gwrde-showers') as HTMLInputElement).value) || 4;
      const showMin = parseFloat((document.getElementById('gwrde-showmin') as HTMLInputElement).value) || 8;
      const flow = parseFloat((document.getElementById('gwrde-flow') as HTMLInputElement).value) || 9;
      const laundry = parseFloat((document.getElementById('gwrde-laundry') as HTMLInputElement).value) || 5;
      const loadL = parseFloat((document.getElementById('gwrde-loadl') as HTMLInputElement).value) || 50;
      const waterCost = parseFloat((document.getElementById('gwrde-watercost') as HTMLInputElement).value) || 2.0;
      const sewerCost = parseFloat((document.getElementById('gwrde-sewercost') as HTMLInputElement).value) || 2.5;

      const showerL = showers * showMin * flow;
      const sinkL = people * 12;
      const laundryDaily = laundry * loadL / 7;
      const dailyGW = showerL + sinkL + laundryDaily;
      const annualL = dailyGW * 365;
      const tankSize = Math.ceil(dailyGW * 1.5 / 50) * 50;
      const totalSavedCost = (annualL / 1000) * (waterCost + sewerCost);
      const irrigArea = Math.round(dailyGW / 3);

      document.getElementById('gwrde-daily')!.textContent = Math.round(dailyGW).toLocaleString('de-DE');
      document.getElementById('gwrde-annual')!.textContent = Math.round(annualL).toLocaleString('de-DE') + ' L';
      document.getElementById('gwrde-tank')!.textContent = tankSize.toLocaleString('de-DE') + ' L';
      document.getElementById('gwrde-savings')!.textContent = Math.round(totalSavedCost).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('gwrde-irrig')!.textContent = irrigArea.toLocaleString('de-DE') + ' m\u00B2';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.gwrde-in').forEach(el => { el.addEventListener('input', calcGWRDE); el.addEventListener('change', calcGWRDE); }); calcGWRDE(); }, 50);
  </script>
</CalculatorLayout>
