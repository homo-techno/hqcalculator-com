---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Etikettenrechner";
const description = "Berechnen Sie Druckkosten, Stückzahlen und Materialverbrauch für Etiketten.";

const relatedCalcs = [
  { name: "Laminierungsrechner", url: "/de/laminierungs-rechner", description: "Folienkosten berechnen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Maschinen abschreiben." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen berechnen." },
  { name: "Lederrechner", url: "/de/leder-rechner", description: "Lederbedarf berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Etikettenrechner" lang="de" enSlug="label-calculator" keywords="etikettenrechner, etikett druckkosten, etiketten berechnen, etikett materialverbrauch" breadcrumbs={[{ name: "Etikettenrechner", url: "/de/etiketten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Etikettenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Materialverbrauch, Druckkosten und Stückpreise für Ihre Etikettenproduktion.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Etikettbreite (mm)</label><input type="number" id="etr-w" class="etr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Etikettthöhe (mm)</label><input type="number" id="etr-h" class="etr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Druckrollenbreite (mm)</label><input type="number" id="etr-roll" class="etr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="220" min="50" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stanzabstand (mm)</label><input type="number" id="etr-gap" class="etr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gesamtauflage (Stück)</label><input type="number" id="etr-qty" class="etr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="1" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Materialkosten (€/m²)</label><input type="number" id="etr-mat" class="etr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.50" min="0" step="0.10"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Druckkosten (€ pro 1.000 Stück)</label><input type="number" id="etr-print" class="etr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.50"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten</div>
          <div class="text-4xl font-extrabold font-mono" id="etr-total">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stückpreis</div><div class="text-xl font-bold" id="etr-unit">0,00 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Etiketten/Reihe</div><div class="text-xl font-bold" id="etr-cols">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Material (m²)</div><div class="text-xl font-bold" id="etr-area">0 m²</div></div>
        </div>
      </div>
      <ShareButton calculatorId="label-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Etikettenproduktion – Kosten im Überblick</h2>
      <p>Die Kosten für Etiketten hängen von Größe, Material, Auflage und Druckverfahren ab. Bei größeren Auflagen sinkt der Stückpreis erheblich, da Rüstkosten auf mehr Stück verteilt werden. Für kleine Auflagen unter 1.000 Stück empfiehlt sich Digitaldruck, für Großauflagen ab 10.000 Stück ist Flexodruck wirtschaftlicher.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Materialien werden für Etiketten verwendet?</strong> Gängige Materialien sind Papier, PE-Folie, PP-Folie und Polyester. Jedes Material hat andere Eigenschaften bezüglich Feuchtigkeitsresistenz, Temperaturbeständigkeit und Bedruckbarkeit.</p>
      <p><strong>Ab welcher Auflage lohnt sich Offsetdruck?</strong> Offsetdruck ist ab ca. 5.000–10.000 Stück wirtschaftlich. Darunter ist Digitaldruck meist günstiger, da keine Druckplatten benötigt werden.</p>
      <p><strong>Was bedeutet Stanzabstand?</strong> Der Stanzabstand (auch Matrizenschnittabstand) ist der Abstand zwischen zwei benachbarten Etiketten auf dem Trägermaterial. Er beeinflusst den Materialverbrauch.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const etrFmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
    function calcETR() {
      const w = parseFloat((document.getElementById('etr-w') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('etr-h') as HTMLInputElement).value) || 0;
      const roll = parseFloat((document.getElementById('etr-roll') as HTMLInputElement).value) || 220;
      const gap = parseFloat((document.getElementById('etr-gap') as HTMLInputElement).value) || 0;
      const qty = parseFloat((document.getElementById('etr-qty') as HTMLInputElement).value) || 0;
      const matCost = parseFloat((document.getElementById('etr-mat') as HTMLInputElement).value) || 0;
      const printPer1k = parseFloat((document.getElementById('etr-print') as HTMLInputElement).value) || 0;
      const cols = Math.max(1, Math.floor(roll / (w + gap)));
      const totalRows = Math.ceil(qty / cols);
      const totalLenMm = totalRows * (h + gap);
      const totalAreaM2 = (roll / 1000) * (totalLenMm / 1000);
      const materialCost = totalAreaM2 * matCost;
      const printCost = (qty / 1000) * printPer1k;
      const total = materialCost + printCost;
      const unitPrice = qty > 0 ? total / qty : 0;
      document.getElementById('etr-total')!.textContent = etrFmt(total);
      document.getElementById('etr-unit')!.textContent = unitPrice.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) + ' \u20AC';
      document.getElementById('etr-cols')!.textContent = cols.toLocaleString('de-DE');
      document.getElementById('etr-area')!.textContent = totalAreaM2.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m\u00B2';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.etr-in').forEach(el => { el.addEventListener('input', calcETR); el.addEventListener('change', calcETR); }); calcETR(); }, 50);
  </script>
</CalculatorLayout>
