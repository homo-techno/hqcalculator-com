---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Artefaktdichte-Rechner - Funde pro Quadratmeter";
const description = "Berechnen Sie die Artefaktdichte pro Quadratmeter in Grabungseinheiten. Analysieren Sie die räumliche Verteilung und schätzen Sie die Gesamtanzahl der Funde.";
const relatedCalcs = [
  { name: "Grabungsvolumen", url: "/excavation-volume-calculator", description: "Volumen der Grabungseinheit." },
  { name: "Grabungsgitter", url: "/site-grid-calculator", description: "Rasterplanung." },
  { name: "Surveyabdeckung", url: "/survey-coverage-calculator", description: "Survey-Stichproben." },
  { name: "Keramikanalyse", url: "/ceramic-analysis-calculator", description: "Scherbenanalyse." },
  { name: "Lithische Analyse", url: "/lithic-analysis-calculator", description: "Steinwerkzeuganalyse." },
  { name: "Bevölkerungsschätzung", url: "/population-estimate-calculator", description: "Antike Bevölkerung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Artefaktdichte-Rechner" keywords="Artefaktdichte, Funde pro Quadratmeter, Grabungseinheit, Raumanalyse, archäologische Dichte, Fundverteilung" lang="de" breadcrumbs={[{ name: "Artefaktdichte", url: "/de/artefaktdichte-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Artefaktdichte-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Funddichte in Grabungseinheiten. Vergleichen Sie Dichten verschiedener Einheiten und schätzen Sie die Gesamtfundmenge.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl gefundener Artefakte</label>
          <input type="number" id="afd-count" class="afd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="47" min="0" step="1">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Einheitslänge (m)</label>
            <input type="number" id="afd-len" class="afd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0.1" step="0.1">
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1">Einheitsbreite (m)</label>
            <input type="number" id="afd-wid" class="afd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0.1" step="0.1">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Schicht-/Abtragtiefe (cm)</label>
          <input type="number" id="afd-depth" class="afd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gesamtfläche der Fundstelle (m²)</label>
          <input type="number" id="afd-sitearea" class="afd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="1" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gesamtgewicht der Artefakte (g)</label>
          <input type="number" id="afd-weight" class="afd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="320" min="0" step="1">
        </div>
      </div>

      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Artefaktdichte</div>
          <div class="text-4xl font-extrabold" id="afd-density">0</div>
          <div class="text-sm text-blue-200 mt-1">Artefakte pro m²</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Dichte pro Kubikmeter</div>
            <div class="text-xl font-bold" id="afd-volcdens">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Einheitsfläche (m²)</div>
            <div class="text-xl font-bold" id="afd-area">0</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesch. Gesamtfunde</div>
            <div class="text-xl font-bold" id="afd-total">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">\u00D8 Gewicht pro Artefakt</div>
            <div class="text-xl font-bold" id="afd-avgwt">0</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gewichtsdichte (g/m²)</div>
            <div class="text-xl font-bold" id="afd-wtdens">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Einheitsvolumen (m³)</div>
            <div class="text-xl font-bold" id="afd-vol">0</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="artifact-density" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Artefaktdichte-Analyse</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Dichte (2D)</strong> = Artefaktanzahl / Einheitsfläche</p>
        <p><strong>Dichte (3D)</strong> = Artefaktanzahl / Einheitsvolumen</p>
        <p><strong>Fundstellenschätzung</strong> = Dichte * Gesamtfläche</p>
      </div>
      <p>Die Artefaktdichte ist ein grundlegendes Maß in der archäologischen Analyse. Bereiche mit hoher Dichte können auf Aktivitätszonen, Abfallhaufen oder Siedlungsschichten hinweisen. Der Vergleich der Dichten verschiedener Einheiten hilft Archäologen, die Fundstellenstruktur zu identifizieren.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcAFD() {
      const count = parseFloat((document.getElementById('afd-count') as HTMLInputElement).value) || 0;
      const len = parseFloat((document.getElementById('afd-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('afd-wid') as HTMLInputElement).value) || 0;
      const depth = parseFloat((document.getElementById('afd-depth') as HTMLInputElement).value) || 0;
      const siteArea = parseFloat((document.getElementById('afd-sitearea') as HTMLInputElement).value) || 0;
      const weight = parseFloat((document.getElementById('afd-weight') as HTMLInputElement).value) || 0;

      const area = len * wid;
      const volume = area * (depth / 100);
      const density2d = area > 0 ? count / area : 0;
      const density3d = volume > 0 ? count / volume : 0;
      const totalEst = density2d * siteArea;
      const avgWt = count > 0 ? weight / count : 0;
      const wtDensity = area > 0 ? weight / area : 0;
      const fmt = (n: number, d: number) => n.toLocaleString('de-DE', { maximumFractionDigits: d });

      document.getElementById('afd-density')!.textContent = fmt(density2d, 1);
      document.getElementById('afd-volcdens')!.textContent = fmt(density3d, 1) + ' /m\u00B3';
      document.getElementById('afd-area')!.textContent = fmt(area, 2);
      document.getElementById('afd-total')!.textContent = Math.round(totalEst).toLocaleString('de-DE');
      document.getElementById('afd-avgwt')!.textContent = fmt(avgWt, 1) + ' g';
      document.getElementById('afd-wtdens')!.textContent = fmt(wtDensity, 1) + ' g/m\u00B2';
      document.getElementById('afd-vol')!.textContent = fmt(volume, 3);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.afd-in').forEach(el => { el.addEventListener('input', calcAFD); el.addEventListener('change', calcAFD); });
      calcAFD();
    }, 50);
  </script>
</CalculatorLayout>
