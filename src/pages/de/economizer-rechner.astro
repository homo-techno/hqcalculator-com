---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Economizer-Rechner - Wärmerückgewinnung & Energieeinsparung";
const description = "Berechnen Sie die Energieeinsparung durch einen Economizer (Wärmerückgewinner). Ermitteln Sie Stunden im Freikühlung-Modus und die jährliche Kostenersparnis.";

const relatedCalcs = [
  { name: "HVAC-Rechner", url: "/de/hvac-rechner", description: "Heizlast berechnen." },
  { name: "Energieeffizienz-Rechner", url: "/de/energieeffizienz-rechner", description: "Effizienz berechnen." },
  { name: "Stromkosten-Rechner", url: "/de/stromkosten-rechner", description: "Stromkosten." },
  { name: "Luftkanal-Rechner", url: "/de/luftkanal-rechner", description: "Kanaldimensionierung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Economizer-Rechner" lang="de" enSlug="economizer-calculator" keywords="economizer rechner, wärmerückgewinnung, freikühlung, energieeinsparung hvac, economizer stunden" breadcrumbs={[{ name: "Economizer-Rechner", url: "/de/economizer-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Economizer-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Energieeinsparung durch einen Economizer (Freik&uuml;hlung) basierend auf Temperatur- und Betriebsdaten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">K&uuml;hlleistung (kW)</label><input type="number" id="ecn-cool" class="ecn-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">K&auml;ltemaschine COP</label><input type="number" id="ecn-cop" class="ecn-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eco-Stunden (h/Jahr)</label><input type="number" id="ecn-hours" class="ecn-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gesamt-K&uuml;hlstunden (h/Jahr)</label><input type="number" id="ecn-total" class="ecn-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (&euro;/kWh)</label><input type="number" id="ecn-rate" class="ecn-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.01" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Eco-Ventilatorzuschlag (%)</label><input type="number" id="ecn-fan" class="ecn-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0" max="50"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">J&auml;hrliche Ersparnis</div>
          <div class="text-5xl font-extrabold font-mono" id="ecn-result">0 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eingesparte kWh</div><div class="text-xl font-bold" id="ecn-kwh">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eco-Anteil</div><div class="text-xl font-bold" id="ecn-pct">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ohne Eco (kWh)</div><div class="text-xl font-bold" id="ecn-without">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mit Eco (kWh)</div><div class="text-xl font-bold" id="ecn-with">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="ecn-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="economizer-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Economizer-Einsparung berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Kompressorleistung = K&uuml;hlleistung / COP</p>
        <p>Einsparung (kWh) = Kompressorleistung &times; Eco-Stunden &times; (1 &minus; Ventilatorzuschlag)</p>
        <p>Kostenersparnis = Einsparung (kWh) &times; Strompreis</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie funktioniert ein Economizer?</strong> Ein Economizer nutzt k&uuml;hle Au&szlig;enluft zur K&uuml;hlung anstelle der K&auml;ltemaschine, wenn die Au&szlig;entemperatur niedrig genug ist.</p>
      <p><strong>Wann lohnt sich ein Economizer?</strong> Besonders in gem&auml;&szlig;igten Klimazonen wie Deutschland, wo viele Stunden im Jahr Freik&uuml;hlung m&ouml;glich ist.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEcn() {
      const cool = parseFloat((document.getElementById('ecn-cool') as HTMLInputElement).value) || 0;
      const cop = parseFloat((document.getElementById('ecn-cop') as HTMLInputElement).value) || 3;
      const ecoHrs = parseFloat((document.getElementById('ecn-hours') as HTMLInputElement).value) || 0;
      const totalHrs = parseFloat((document.getElementById('ecn-total') as HTMLInputElement).value) || 1;
      const rate = parseFloat((document.getElementById('ecn-rate') as HTMLInputElement).value) || 0;
      const fanPct = parseFloat((document.getElementById('ecn-fan') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const compPower = cool / cop;
      steps.push('Kompressorleistung = ' + fmt(cool) + ' kW / ' + fmt(cop) + ' = ' + fmt(compPower) + ' kW');
      const withoutEco = compPower * totalHrs;
      steps.push('Ohne Eco = ' + fmt(compPower) + ' kW x ' + totalHrs + ' h = ' + fmt(withoutEco) + ' kWh');
      const fanExtra = compPower * ecoHrs * (fanPct / 100);
      const savedKwh = compPower * ecoHrs - fanExtra;
      steps.push('Eingesparte kWh = ' + fmt(compPower) + ' x ' + ecoHrs + ' - ' + fmt(fanExtra) + ' (Ventilator) = ' + fmt(savedKwh) + ' kWh');
      const withEco = withoutEco - savedKwh;
      steps.push('Mit Eco = ' + fmt(withoutEco) + ' - ' + fmt(savedKwh) + ' = ' + fmt(withEco) + ' kWh');
      const savings = savedKwh * rate;
      steps.push('Ersparnis = ' + fmt(savedKwh) + ' kWh x ' + fmt(rate) + ' EUR/kWh = ' + fmt(savings) + ' EUR');
      const ecoPct = totalHrs > 0 ? (ecoHrs / totalHrs * 100) : 0;
      document.getElementById('ecn-result')!.textContent = fmt(savings) + ' \u20AC';
      document.getElementById('ecn-kwh')!.textContent = fmt(savedKwh);
      document.getElementById('ecn-pct')!.textContent = fmt(ecoPct) + '%';
      document.getElementById('ecn-without')!.textContent = fmt(withoutEco);
      document.getElementById('ecn-with')!.textContent = fmt(withEco);
      document.getElementById('ecn-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('ecn-cool') as HTMLInputElement).value = '50';
      (document.getElementById('ecn-cop') as HTMLInputElement).value = '3.5';
      (document.getElementById('ecn-hours') as HTMLInputElement).value = '3000';
      (document.getElementById('ecn-total') as HTMLInputElement).value = '5000';
      (document.getElementById('ecn-rate') as HTMLInputElement).value = '0.30';
      (document.getElementById('ecn-fan') as HTMLInputElement).value = '10';
      document.querySelectorAll('.ecn-in').forEach(el => { el.addEventListener('input', calcEcn); el.addEventListener('change', calcEcn); });
      calcEcn();
    }, 50);
  </script>
</CalculatorLayout>
