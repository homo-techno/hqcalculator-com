---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Schiffsdiesel Rechner - Kraftstoffverbrauch und Reichweite";
const description = "Berechnen Sie Kraftstoffverbrauch und Reichweite für Motorboote und Schiffe. Dieselkosten, Tankplanung und Verbrauch pro Seemeile einfach ermitteln.";
const relatedCalcs = [
  { name: "Schiffsbatterie Rechner", url: "/de/schiffsbatterie-rechner", description: "Batteriekapazität Schiff." },
  { name: "Liegeplatz Rechner", url: "/de/liegeplatz-rechner", description: "Marinakosten berechnen." },
  { name: "Ankerketten Rechner", url: "/de/ankerketten-rechner", description: "Ankerkettenlänge." },
  { name: "Schiffsfarbe Rechner", url: "/de/schiffsfarbe-rechner", description: "Farbverbrauch Schiff." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="marine-diesel-calculator" calculatorName="Schiffsdiesel Rechner" keywords="Schiffsdiesel Rechner, Kraftstoffverbrauch Boot, Reichweite Motorboot, Dieselkosten Schiff, l/h Verbrauch" breadcrumbs={[{ name: "Schiffsdiesel Rechner", url: "/de/schiffsdiesel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Schiffsdiesel Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Kraftstoffverbrauch, Reichweite und Kosten für Ihre Bootsfahrt – ideal für die Reiseplanung auf See.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (L/h)</label><input type="number" id="sd-rate" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0.5" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Reisegeschwindigkeit (kn)</label><input type="number" id="sd-speed" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="1" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Tankvolumen (L)</label><input type="number" id="sd-tank" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="10" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Tankfüllung (%)</label><input type="number" id="sd-fill" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="1" max="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Dieselpreis (€/L)</label><input type="number" id="sd-price" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.85" min="0.5" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Geplante Strecke (sm)</label><input type="number" id="sd-dist" class="sd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80" min="1" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Maximale Reichweite</div>
          <div class="text-5xl font-extrabold font-mono" id="sd-range">--</div>
          <div class="text-sm text-blue-200 mt-1">Seemeilen</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbrauch/sm</div><div class="text-xl font-bold" id="sd-per-nm">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraftstoff für Strecke</div><div class="text-xl font-bold" id="sd-trip-fuel">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten für Strecke</div><div class="text-xl font-bold" id="sd-trip-cost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fahrzeit</div><div class="text-xl font-bold" id="sd-time">--</div></div>
        </div>
        <div class="p-4 rounded-xl text-center font-semibold" id="sd-status-box">
          <span id="sd-status">--</span>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="schiffsdiesel" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dieselverbrauch von Motorschiffen</h2>
      <p>Der Kraftstoffverbrauch eines Motorboots hängt von Motorleistung, Rumpfform, Beladung und Fahrgeschwindigkeit ab. Als Faustregel gilt: Ein Dieselmotor verbraucht etwa 0,25–0,30 Liter Diesel pro PS und Stunde bei Volllast. Im Reisebetrieb liegt der Verbrauch typischerweise bei 50–75 % des Maximalwertes. Planen Sie immer eine Reserve von mindestens 20–30 % des Tankvolumens ein.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Diesel verbraucht ein Motorboot?</strong> Ein typisches Motorboot mit 100 PS verbraucht im Reisebetrieb 15–25 Liter pro Stunde. Kleinere Dieselmotoren (20–40 PS) kommen mit 3–8 Litern pro Stunde aus.</p>
      <p><strong>Wie berechne ich die Reichweite meines Bootes?</strong> Reichweite = (Tankinhalt × Füllgrad) ÷ Verbrauch (L/h) × Geschwindigkeit (kn). Berücksichtigen Sie dabei Wind, Strom und Reserve.</p>
      <p><strong>Was kostet eine Bootsreise?</strong> Die Kraftstoffkosten sind nur ein Teil der Gesamtkosten. Hinzu kommen Liegegebühren, Schmierstoffe und mögliche Hafengebühren.</p>
      <p><strong>Wie spare ich Kraftstoff auf dem Boot?</strong> Fahren Sie im wirtschaftlichen Drehzahlbereich (meist 60–70 % der Nenndrehzahl), halten Sie den Rumpf sauber und vermeiden Sie unnötige Beschleunigungen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSD() {
      const rate = parseFloat((document.getElementById('sd-rate') as HTMLInputElement).value) || 0;
      const speed = parseFloat((document.getElementById('sd-speed') as HTMLInputElement).value) || 0;
      const tank = parseFloat((document.getElementById('sd-tank') as HTMLInputElement).value) || 0;
      const fill = parseFloat((document.getElementById('sd-fill') as HTMLInputElement).value) || 80;
      const price = parseFloat((document.getElementById('sd-price') as HTMLInputElement).value) || 1.85;
      const dist = parseFloat((document.getElementById('sd-dist') as HTMLInputElement).value) || 0;
      const usable = tank * (fill / 100) * 0.8;
      const perNm = speed > 0 ? rate / speed : 0;
      const range = perNm > 0 ? usable / perNm : 0;
      const tripFuel = perNm * dist;
      const tripCost = tripFuel * price;
      const tripTime = speed > 0 ? dist / speed : 0;
      const fmtL = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' L';
      const fmtNm = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' sm';
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
      const statusBox = document.getElementById('sd-status-box')!;
      const statusEl = document.getElementById('sd-status')!;
      document.getElementById('sd-range')!.textContent = range > 0 ? Math.floor(range).toString() : '--';
      document.getElementById('sd-per-nm')!.textContent = perNm > 0 ? perNm.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' L/sm' : '--';
      document.getElementById('sd-trip-fuel')!.textContent = tripFuel > 0 ? fmtL(tripFuel) : '--';
      document.getElementById('sd-trip-cost')!.textContent = tripCost > 0 ? fmtEur(tripCost) : '--';
      const h = Math.floor(tripTime);
      const m = Math.round((tripTime - h) * 60);
      document.getElementById('sd-time')!.textContent = tripTime > 0 ? h + ' h ' + m + ' min' : '--';
      if (dist > 0 && range > 0) {
        if (tripFuel > usable) {
          statusBox.className = 'p-4 rounded-xl text-center font-semibold bg-red-100 text-red-700';
          statusEl.textContent = 'Kraftstoff reicht nicht – Tankstop erforderlich!';
        } else if (tripFuel > usable * 0.8) {
          statusBox.className = 'p-4 rounded-xl text-center font-semibold bg-yellow-100 text-yellow-700';
          statusEl.textContent = 'Vorsicht: Geringe Kraftstoffreserve';
        } else {
          statusBox.className = 'p-4 rounded-xl text-center font-semibold bg-green-100 text-green-700';
          statusEl.textContent = 'Kraftstoff ausreichend für geplante Strecke';
        }
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sd-in').forEach(el => { el.addEventListener('input', calcSD); el.addEventListener('change', calcSD); });
      calcSD();
    }, 50);
  </script>
</CalculatorLayout>
