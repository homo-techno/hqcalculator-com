---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zahnspange-Kosten-Rechner - Kieferorthopädie Kostenvergleich";
const description = "Schätzen Sie die Kosten einer Zahnspange nach Typ (Metall, Keramik, Lingual, Aligner), Behandlungsdauer, monatlichen Raten und Versicherungsdeckung.";
const relatedCalcs = [
  { name: "Botox-Einheiten-Rechner", url: "/de/botox-einheiten-rechner", description: "Botox-Kosten." },
  { name: "Bootskredit-Rechner", url: "/de/bootskredit-rechner", description: "Kreditberechnung." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Zahnspange-Kosten-Rechner" enSlug="braces-cost-calculator" keywords="Zahnspange Kosten, Kieferorthopädie Rechner, Invisalign Kosten, Keramik Zahnspange, linguale Zahnspange, monatliche Raten" breadcrumbs={[{ name: "Zahnspange-Kosten-Rechner", url: "/de/zahnspange-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zahnspange-Kosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie kieferorthopädische Behandlungskosten inkl. Typ, Dauer und Zahlungspläne.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Zahnspangentyp</label>
          <select id="zk-type" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="metal" selected>Metallspange (festsitzend)</option>
            <option value="ceramic">Keramikspange</option>
            <option value="lingual">Lingualspange (innen)</option>
            <option value="invisalign">Aligner (Invisalign o.ä.)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Schweregrad</label>
            <select id="zk-complex" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="mild">Leicht</option>
              <option value="moderate" selected>Mittel</option>
              <option value="severe">Schwer</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Altersgruppe</label>
            <select id="zk-age" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="child">Kind (7-12)</option>
              <option value="teen" selected>Jugendlicher (13-17)</option>
              <option value="adult">Erwachsener (18+)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kassenleistung (€)</label><input type="number" id="zk-ins" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="0" max="5000" step="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahlung (€)</label><input type="number" id="zk-down" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" max="10000" step="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="zk-total">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Behandlungsdauer</div><div class="text-xl font-bold font-mono" id="zk-dur">0 Mo.</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Rate</div><div class="text-xl font-bold font-mono" id="zk-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="zk-oop">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Retainer-Kosten (gesch.)</div><div class="text-xl font-bold font-mono" id="zk-ret">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt + Retainer</div><div class="text-xl font-bold font-mono" id="zk-grand">0 €</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="zahnspange-kosten" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zahnspange-Kosten in Deutschland</h2>
      <p>In Deutschland übernimmt die gesetzliche Krankenkasse bei Kindern und Jugendlichen unter 18 Jahren einen Teil der Kosten, sofern eine medizinische Indikation vorliegt (KIG 3-5). Erwachsene müssen die Kosten in der Regel selbst tragen. Die Preise variieren je nach Praxis, Region und Behandlungstyp erheblich.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Zahlt die Krankenkasse?</strong> Bei Kindern unter 18 mit KIG 3-5 ja, mit 20% Eigenanteil, der nach erfolgreicher Behandlung erstattet wird. Bei Erwachsenen nur in Ausnahmefällen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcZK() {
      const type = (document.getElementById('zk-type') as HTMLSelectElement).value;
      const complexity = (document.getElementById('zk-complex') as HTMLSelectElement).value;
      const age = (document.getElementById('zk-age') as HTMLSelectElement).value;
      const ins = parseFloat((document.getElementById('zk-ins') as HTMLInputElement).value) || 0;
      const down = parseFloat((document.getElementById('zk-down') as HTMLInputElement).value) || 0;
      // German market prices (EUR)
      const baseCosts: Record<string, number> = { metal: 4000, ceramic: 5500, lingual: 8000, invisalign: 5000 };
      const complexMult: Record<string, number> = { mild: 0.8, moderate: 1.0, severe: 1.3 };
      const ageMult: Record<string, number> = { child: 0.9, teen: 1.0, adult: 1.1 };
      const baseDuration: Record<string, number> = { mild: 12, moderate: 18, severe: 28 };
      const typeDurMult: Record<string, number> = { metal: 1.0, ceramic: 1.0, lingual: 1.1, invisalign: 0.9 };
      const total = Math.round(baseCosts[type] * complexMult[complexity] * ageMult[age]);
      const duration = Math.round(baseDuration[complexity] * typeDurMult[type]);
      const oop = Math.max(0, total - ins);
      const financed = Math.max(0, oop - down);
      const monthly = duration > 0 ? Math.round(financed / duration) : 0;
      const retainer = type === 'invisalign' ? 350 : 250;
      const fmt = (n: number) => n.toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('zk-total')!.textContent = fmt(total);
      document.getElementById('zk-dur')!.textContent = duration + ' Mo.';
      document.getElementById('zk-monthly')!.textContent = fmt(monthly);
      document.getElementById('zk-oop')!.textContent = fmt(oop);
      document.getElementById('zk-ret')!.textContent = fmt(retainer);
      document.getElementById('zk-grand')!.textContent = fmt(oop + retainer);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zk-in').forEach(el => { el.addEventListener('input', calcZK); el.addEventListener('change', calcZK); });
      calcZK();
    }, 50);
  </script>
</CalculatorLayout>
