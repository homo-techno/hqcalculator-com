---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Veranstaltungsversicherung-Rechner - Haftpflichtversicherung";
const description = "Sch\u00e4tzen Sie die Kosten einer Veranstaltungshaftpflichtversicherung basierend auf Eventtyp, Gr\u00f6\u00dfe, Alkoholausschank und Deckungssumme.";

const relatedCalcs = [
  { name: "Veranstaltungsbudget-Rechner", url: "/de/veranstaltungsbudget-rechner", description: "Eventbudget." },
  { name: "Veranstaltungspersonal-Rechner", url: "/de/veranstaltungspersonal-rechner", description: "Personalbedarf." },
  { name: "Veranstaltungsparkplatz-Rechner", url: "/de/veranstaltungsparkplatz-rechner", description: "Parkplatzplanung." },
  { name: "Veranstaltungszeitplan-Rechner", url: "/de/veranstaltungszeitplan-rechner", description: "Zeitplanung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Veranstaltungsversicherung-Rechner" lang="de" enSlug="event-insurance-calculator" keywords="veranstaltungsversicherung, event haftpflicht, hochzeitsversicherung, eventversicherung, veranstaltungshaftpflicht" breadcrumbs={[{ name: "Veranstaltungsversicherung-Rechner", url: "/de/veranstaltungsversicherung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Veranstaltungsversicherung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie die Kosten einer Haftpflichtversicherung f&uuml;r Ihre Veranstaltung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Veranstaltungsart</label>
          <select id="vvr-type" class="vvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="wedding">Hochzeit / Empfang</option>
            <option value="corporate">Firmenveranstaltung</option>
            <option value="birthday">Geburtstag / Jubil&auml;um</option>
            <option value="gala">Gala / Benefiz</option>
            <option value="festival">Festival / Gro&szlig;event</option>
            <option value="conference">Konferenz / Messe</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl G&auml;ste</label><input type="number" id="vvr-guests" class="vvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="10" step="10"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Alkoholausschank?</label>
          <select id="vvr-alcohol" class="vvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Kein Alkohol</option>
            <option value="beerWine">Nur Bier &amp; Wein</option>
            <option value="full" selected>Volle Bar (Spirituosen)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Veranstaltungsort</label>
          <select id="vvr-venue" class="vvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="indoor">Innenraum</option>
            <option value="outdoor">Au&szlig;enbereich / Park</option>
            <option value="private">Privatgel&auml;nde</option>
            <option value="public">&Ouml;ffentlicher Raum</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Deckungssumme</label>
          <select id="vvr-coverage" class="vvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="basic">Basis (1 Mio. &euro; Haftpflicht)</option>
            <option value="standard" selected>Standard (1 Mio. &euro; + Alkoholhaftung)</option>
            <option value="premium">Premium (2 Mio. &euro; + Ausfallversicherung)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Gesamtinvestition Veranstaltung (&euro;)</label><input type="number" id="vvr-investment" class="vvr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25000" min="0" step="1000"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ausfallversicherung einschlie&szlig;en?</label>
          <select id="vvr-cancel" class="vvr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="no">Nein</option>
            <option value="yes" selected>Ja</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesch&auml;tzte Versicherungskosten</div>
        <div class="text-5xl font-extrabold" id="vvr-cost">--</div>
        <div class="text-sm mt-1" id="vvr-note">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Haftpflichtdeckung</div><div class="text-xl font-bold" id="vvr-liability">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Alkoholhaftung</div><div class="text-xl font-bold" id="vvr-liquor">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ausfalldeckung</div><div class="text-xl font-bold" id="vvr-cancelcov">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Gast</div><div class="text-xl font-bold" id="vvr-perguest">--</div></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="vvr-details"></div>

      <ShareButton calculatorId="event-insurance-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Veranstaltungsversicherung - Ratgeber</h2>
      <p>Die meisten Locations verlangen eine Haftpflichtversicherung mit mindestens 1 Mio. &euro; Deckung. Bei Alkoholausschank ist eine Alkoholhaftpflicht unbedingt empfehlenswert. Ausfallversicherungen decken typischerweise 80-90% der nicht erstattbaren Kosten ab.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Brauche ich eine Veranstaltungsversicherung?</strong> Ja, besonders bei gr&ouml;&szlig;eren Events mit Alkohol und externen G&auml;sten ist eine Haftpflichtversicherung dringend empfohlen.</p>
      <p><strong>Was deckt die Ausfallversicherung?</strong> Ausfall durch Wetter, Krankheit, Location-Probleme oder Dienstleister-Ausfall.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcVVR() {
      const eventType = (document.getElementById('vvr-type') as HTMLSelectElement).value;
      const guests = parseInt((document.getElementById('vvr-guests') as HTMLInputElement).value) || 100;
      const alcohol = (document.getElementById('vvr-alcohol') as HTMLSelectElement).value;
      const venue = (document.getElementById('vvr-venue') as HTMLSelectElement).value;
      const coverage = (document.getElementById('vvr-coverage') as HTMLSelectElement).value;
      const investment = parseFloat((document.getElementById('vvr-investment') as HTMLInputElement).value) || 0;
      const includeCancel = (document.getElementById('vvr-cancel') as HTMLSelectElement).value;

      let baseCost = 95;
      if (eventType === 'wedding') baseCost = 120;
      else if (eventType === 'corporate') baseCost = 100;
      else if (eventType === 'gala') baseCost = 150;
      else if (eventType === 'festival') baseCost = 250;
      else if (eventType === 'conference') baseCost = 110;
      else baseCost = 85;

      if (guests > 300) baseCost *= 1.8;
      else if (guests > 200) baseCost *= 1.4;
      else if (guests > 100) baseCost *= 1.15;

      let liquorCost = 0;
      if (alcohol === 'beerWine') liquorCost = 45;
      else if (alcohol === 'full') liquorCost = 85;

      if (venue === 'outdoor') baseCost *= 1.15;
      else if (venue === 'public') baseCost *= 1.1;

      if (coverage === 'premium') baseCost *= 1.6;

      let cancelCost = 0;
      if (includeCancel === 'yes' && investment > 0) {
        cancelCost = Math.max(50, investment * 0.02);
      }

      const totalCost = Math.round(baseCost + liquorCost + cancelCost);
      let liabilityAmt = '1.000.000 \u20AC';
      if (coverage === 'premium') liabilityAmt = '2.000.000 \u20AC';

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('vvr-cost')!.textContent = fmt(totalCost);
      document.getElementById('vvr-note')!.textContent = 'Einmalpr\u00E4mie f\u00FCr den Veranstaltungstag';
      document.getElementById('vvr-liability')!.textContent = liabilityAmt;
      document.getElementById('vvr-liquor')!.textContent = alcohol !== 'none' ? 'Eingeschlossen' : 'Nicht erforderlich';
      document.getElementById('vvr-cancelcov')!.textContent = includeCancel === 'yes' ? fmt(investment * 0.8) + ' max.' : 'Nicht eingeschlossen';
      document.getElementById('vvr-perguest')!.textContent = fmt(totalCost / guests);

      let details = '<h3 class="font-semibold text-sm text-text mb-2">Deckungs\u00FCbersicht</h3><ul class="text-sm text-text-secondary space-y-1">';
      details += '<li>Allgemeine Haftpflicht: ' + liabilityAmt + ' Deckung - ' + fmt(baseCost) + '</li>';
      if (liquorCost > 0) details += '<li>Alkoholhaftpflicht: ' + fmt(liquorCost) + '</li>';
      if (cancelCost > 0) details += '<li>Ausfallversicherung (bis ' + fmt(investment * 0.8) + '): ' + fmt(cancelCost) + '</li>';
      details += '<li>G\u00E4steanzahl: ' + guests + '</li>';
      details += '</ul>';
      document.getElementById('vvr-details')!.innerHTML = details;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vvr-in').forEach(el => { el.addEventListener('input', calcVVR); el.addEventListener('change', calcVVR); });
      calcVVR();
    }, 50);
  </script>
</CalculatorLayout>
