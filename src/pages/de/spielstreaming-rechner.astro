---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Spielstreaming-Rechner - Bitrate, Upload & Encoding";
const description = "Berechnen Sie die optimale Bitrate f\u00FCr Aufl\u00F6sung und FPS, Upload-Geschwindigkeit, Encoding-Einstellungen und Bandbreitenverbrauch f\u00FCr Spiel-Streaming.";
const relatedCalcs = [
  { name: "Video-Bitrate-Rechner", url: "/de/video-bitrate-rechner", description: "Bitrate-Berechnung." },
  { name: "Bildschirmgr\u00F6\u00DFen-Rechner", url: "/de/bildschirmgroessen-rechner", description: "Display-Gr\u00F6\u00DFe." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Spielstreaming-Rechner" lang="de" enSlug="game-streaming-calculator" keywords="streaming bitrate, obs einstellungen, twitch bitrate, upload geschwindigkeit streaming, spielstreaming qualit\u00E4t, encoding" breadcrumbs={[{ name: "Spielstreaming", url: "/de/spielstreaming-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Spielstreaming-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die optimalen Streaming-Einstellungen f&uuml;r Ihr Setup und Ihre Internetverbindung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Stream-Aufl&ouml;sung</label>
          <select class="sst-in w-full px-4 py-2 border border-border rounded-lg" id="sst-res">
            <option value="480">480p (854x480)</option>
            <option value="720">720p (1280x720)</option>
            <option value="1080" selected>1080p (1920x1080)</option>
            <option value="1440">1440p (2560x1440)</option>
            <option value="2160">4K (3840x2160)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Bildrate (FPS)</label>
          <select class="sst-in w-full px-4 py-2 border border-border rounded-lg" id="sst-fps">
            <option value="30">30 FPS</option>
            <option value="60" selected>60 FPS</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Inhaltstyp</label>
          <select class="sst-in w-full px-4 py-2 border border-border rounded-lg" id="sst-type">
            <option value="0.8">Wenig Bewegung (Kartenspiele, Strategie)</option>
            <option value="1.0" selected>Mittlere Bewegung (RPG, MOBA)</option>
            <option value="1.2">Viel Bewegung (FPS, Rennen)</option>
            <option value="1.4">Sehr viel Bewegung (schnelle FPS)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Encoder</label>
          <select class="sst-in w-full px-4 py-2 border border-border rounded-lg" id="sst-enc">
            <option value="1.0" selected>NVENC (GPU - NVIDIA)</option>
            <option value="0.95">AMF (GPU - AMD)</option>
            <option value="0.85">x264 Medium (CPU)</option>
            <option value="0.75">x264 Slow (CPU - Beste Qualit&auml;t)</option>
            <option value="1.1">QuickSync (Intel)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Plattform</label>
          <select class="sst-in w-full px-4 py-2 border border-border rounded-lg" id="sst-platform">
            <option value="6000" selected>Twitch (max 6000 kbps)</option>
            <option value="51000">YouTube (max 51000 kbps)</option>
            <option value="6000">Kick (max 6000 kbps)</option>
            <option value="99999">Benutzerdefiniert / Kein Limit</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Upload-Geschwindigkeit (Mbps)</label>
          <input type="number" class="sst-in w-full px-4 py-2 border border-border rounded-lg" id="sst-upload" min="0.5" step="0.5" value="20">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Audio-Bitrate (kbps)</label>
          <select class="sst-in w-full px-4 py-2 border border-border rounded-lg" id="sst-audio">
            <option value="96">96 kbps (Basis)</option>
            <option value="128">128 kbps (Standard)</option>
            <option value="160" selected>160 kbps (Gut)</option>
            <option value="320">320 kbps (Hohe Qualit&auml;t)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Video-Bitrate</div>
          <div class="text-5xl font-extrabold font-mono" id="sst-result">--</div>
          <div class="text-sm text-blue-200 mt-1">kbps</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ben&ouml;tigte Upload-Geschw.</div>
            <div class="text-xl font-bold font-mono" id="sst-uploadneed">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamt-Bitrate</div>
            <div class="text-xl font-bold font-mono" id="sst-totalbr">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Daten pro Stunde</div>
            <div class="text-xl font-bold font-mono" id="sst-datahr">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Upload-Reserve</div>
            <div class="text-xl font-bold font-mono" id="sst-headroom">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Qualit&auml;ts-Voreinstellungen</h3>
          <div class="text-xs font-mono space-y-1" id="sst-presets"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="game-streaming" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Streaming-Bitrate erkl&auml;rt</h2>
      <p>Die optimale Bitrate h&auml;ngt von Aufl&ouml;sung, Bildrate, Bewegungsintensit&auml;t und Encoder ab. Eine h&ouml;here Bitrate bedeutet bessere Qualit&auml;t, erfordert aber mehr Upload-Bandbreite.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Bitrate f&uuml;r Twitch?</strong> Twitch begrenzt auf 6000 kbps. F&uuml;r 1080p60 empfehlen wir 4500-6000 kbps.</p>
      <p><strong>Brauche ich einen schnellen Upload?</strong> Mindestens das 1,5-fache Ihrer Gesamt-Bitrate. F&uuml;r 6000 kbps ben&ouml;tigen Sie ca. 10 Mbps Upload.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcSST() {
      const res = parseInt((document.getElementById('sst-res') as HTMLSelectElement).value);
      const fps = parseInt((document.getElementById('sst-fps') as HTMLSelectElement).value);
      const motionFactor = parseFloat((document.getElementById('sst-type') as HTMLSelectElement).value);
      const encoderFactor = parseFloat((document.getElementById('sst-enc') as HTMLSelectElement).value);
      const platformMax = parseInt((document.getElementById('sst-platform') as HTMLSelectElement).value);
      const upload = parseFloat((document.getElementById('sst-upload') as HTMLInputElement).value) || 20;
      const audio = parseInt((document.getElementById('sst-audio') as HTMLSelectElement).value);
      const baseBitrates: Record<number, number> = { 480: 1500, 720: 3000, 1080: 4500, 1440: 9000, 2160: 20000 };
      let recBitrate = (baseBitrates[res] || 4500);
      recBitrate *= (fps / 30) * 0.7 + 0.3;
      recBitrate *= motionFactor;
      recBitrate *= encoderFactor;
      recBitrate = Math.round(recBitrate);
      const cappedBitrate = Math.min(recBitrate, platformMax);
      const uploadKbps = upload * 1000;
      const maxFromUpload = Math.floor(uploadKbps * 0.75) - audio;
      const finalBitrate = Math.min(cappedBitrate, Math.max(maxFromUpload, 500));
      const totalBitrate = finalBitrate + audio;
      const uploadNeeded = (totalBitrate / 1000) / 0.75;
      const dataPerHourGB = (totalBitrate / 8 * 3600) / (1024 * 1024);
      const headroom = ((uploadKbps - totalBitrate) / uploadKbps * 100);
      document.getElementById('sst-result')!.textContent = finalBitrate.toLocaleString('de-DE');
      document.getElementById('sst-uploadneed')!.textContent = uploadNeeded.toFixed(1) + ' Mbps';
      document.getElementById('sst-totalbr')!.textContent = totalBitrate.toLocaleString('de-DE') + ' kbps';
      document.getElementById('sst-datahr')!.textContent = dataPerHourGB.toFixed(2) + ' GB';
      document.getElementById('sst-headroom')!.textContent = headroom.toFixed(0) + '%';
      const presets = [
        { name: '720p30 (Basis)', res: 720, fps: 30 },
        { name: '720p60 (Standard)', res: 720, fps: 60 },
        { name: '1080p30 (Gut)', res: 1080, fps: 30 },
        { name: '1080p60 (Sehr gut)', res: 1080, fps: 60 },
        { name: '1440p60 (Premium)', res: 1440, fps: 60 },
        { name: '4K60 (Ultra)', res: 2160, fps: 60 }
      ];
      let html = '';
      for (const p of presets) {
        let br = (baseBitrates[p.res] || 4500) * ((p.fps / 30) * 0.7 + 0.3) * motionFactor * encoderFactor;
        br = Math.round(Math.min(br, platformMax));
        const uploadNeed = ((br + audio) / 1000) / 0.75;
        const feasible = uploadNeed <= upload ? 'OK' : 'Ben\u00F6tigt ' + uploadNeed.toFixed(0) + ' Mbps';
        const marker = p.res === res && p.fps === fps ? ' <-' : '';
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + p.name + '</span><span>' + br.toLocaleString('de-DE') + ' kbps (' + feasible + ')' + marker + '</span></div>';
      }
      document.getElementById('sst-presets')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.sst-in').forEach(el => { el.addEventListener('input', calcSST); el.addEventListener('change', calcSST); });
      calcSST();
    }, 50);
  </script>
</CalculatorLayout>
