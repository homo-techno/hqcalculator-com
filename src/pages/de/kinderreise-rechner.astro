---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kinderreise-Rechner - Reisekosten mit Kindern & Packliste";
const description = "Schaetzen Sie zusaetzliche Reisekosten mit Kindern. Packlisten, Kostenvergleiche und Tipps fuer stressfreie Familienreisen.";
const relatedCalcs = [
  { name: "Kindesunterhalt-Rechner", url: "/de/kindesunterhalt-rechner", description: "Unterhalt." },
  { name: "Kinderdosierung-Rechner", url: "/de/kinderdosierung-rechner", description: "Medikamente." },
  { name: "Spendenabzug-Rechner", url: "/de/spendenabzug-rechner", description: "Steuerersparnis." },
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI-Perzentile." },
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrung." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kinderreise-Rechner" enSlug="child-travel-calculator" keywords="Reisen mit Kindern, Familienreise Kosten, Familienurlaub Budget, Reisen mit Kindern Rechner, Packliste Kinder" breadcrumbs={[{ name: "Kinderreise-Rechner", url: "/de/kinderreise-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kinderreise-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie die Zusatzkosten beim Reisen mit Kindern und erhalten Sie altersgerechte Packlisten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Anzahl Kinder</label><input type="number" id="kr-kids" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="6" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Alter des juengsten Kindes</label>
          <select id="kr-age" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="infant">Saeugling (unter 2)</option>
            <option value="toddler" selected>Kleinkind (2-4)</option>
            <option value="child">Kind (5-11)</option>
            <option value="teen">Teenager (12+)</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Reisedauer (Naechte)</label><input type="number" id="kr-nights" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="30" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Reiseart</label>
          <select id="kr-method" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="car" selected>Auto</option>
            <option value="flight">Flugzeug</option>
            <option value="train">Zug</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Unterkunftsart</label>
          <select id="kr-hotel" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="budget">Budget-Hotel (70-100 &euro;/Nacht)</option>
            <option value="mid" selected>Mittelklasse-Hotel (120-200 &euro;/Nacht)</option>
            <option value="resort">Familienresort (200-350 &euro;/Nacht)</option>
            <option value="rental">Ferienwohnung / Airbnb</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Aktivitaetsniveau</label>
          <select id="kr-activities" class="kr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="low">Niedrig (kostenlose Aktivitaeten)</option>
            <option value="medium" selected>Mittel (einige kostenpflichtige Attraktionen)</option>
            <option value="high">Hoch (Freizeitparks, Touren)</option>
          </select>
        </div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzte Zusatzkosten fuer Kinder</div>
        <div class="text-5xl font-extrabold" id="kr-total">--</div>
        <div class="text-sm text-blue-200 mt-1" id="kr-desc">zusaetzliche Reisekosten fuer Kinder</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Kind/Tag</div><div class="text-lg font-bold" id="kr-perday">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Transport extra</div><div class="text-lg font-bold" id="kr-transport">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Essen extra</div><div class="text-lg font-bold" id="kr-food">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktivitaeten extra</div><div class="text-lg font-bold" id="kr-actcost">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <h3 class="font-semibold text-sm text-text mb-3">Kostenaufschluesselung</h3>
        <div class="text-xs" id="kr-breakdown"></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Packliste fuer Kinder</h3>
        <div class="text-sm" id="kr-checklist"></div>
      </div>
      <ShareButton lang="de" calculatorId="kinderreise" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Reisen mit Kindern</h2>
      <p>Familienreisen erfordern zusaetzliche Planung und Budget. Kinder verursachen Extrakosten fuer Verpflegung, Aktivitaeten und manchmal Transport.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Tipps fuer stressfreies Reisen</h3>
      <ul>
        <li>Snacks und Unterhaltung fuer die Reisezeit einpacken</li>
        <li>Ruhetage zwischen Aktivitaeten einplanen</li>
        <li>Routinen (Mittagsschlaf, Mahlzeiten) moeglichst beibehalten</li>
        <li>Reiseapotheke mit Kindermedikamenten mitnehmen</li>
        <li>Unterkuenfte mit Kuechenzeile buchen, um bei Mahlzeiten zu sparen</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKR() {
      const kids = parseFloat((document.getElementById('kr-kids') as HTMLInputElement).value) || 2;
      const ageGroup = (document.getElementById('kr-age') as HTMLSelectElement).value;
      const nights = parseFloat((document.getElementById('kr-nights') as HTMLInputElement).value) || 5;
      const method = (document.getElementById('kr-method') as HTMLSelectElement).value;
      const hotel = (document.getElementById('kr-hotel') as HTMLSelectElement).value;
      const activities = (document.getElementById('kr-activities') as HTMLSelectElement).value;
      const days = nights + 1;
      const transportPerKid: Record<string, Record<string, number>> = {
        car: { infant: 0, toddler: 0, child: 0, teen: 0 },
        flight: { infant: 0, toddler: 200, child: 250, teen: 300 },
        train: { infant: 0, toddler: 0, child: 50, teen: 100 },
      };
      const foodPerDay: Record<string, number> = { infant: 5, toddler: 12, child: 20, teen: 30 };
      const actPerDay: Record<string, Record<string, number>> = {
        low: { infant: 0, toddler: 5, child: 8, teen: 8 },
        medium: { infant: 0, toddler: 8, child: 20, teen: 25 },
        high: { infant: 0, toddler: 12, child: 40, teen: 50 },
      };
      const hotelExtra: Record<string, number> = { budget: 8, mid: 12, resort: 18, rental: 20 };
      const gearCost: Record<string, number> = { infant: 40, toddler: 25, child: 8, teen: 0 };
      const transport = transportPerKid[method][ageGroup] * kids;
      const food = foodPerDay[ageGroup] * days * kids;
      const act = actPerDay[activities][ageGroup] * days * kids;
      const hotelExtraCost = hotelExtra[hotel] * nights * Math.max(0, kids - 1);
      const gear = gearCost[ageGroup] * kids;
      interface CostItem { name: string; amount: number; }
      const items: CostItem[] = [
        { name: 'Transport', amount: transport },
        { name: 'Essen & Snacks', amount: food },
        { name: 'Aktivitaeten & Attraktionen', amount: act },
        { name: 'Hotel-Extras', amount: hotelExtraCost },
        { name: 'Ausruestung & Zubehoer', amount: gear },
      ];
      const total = items.reduce((s, i) => s + i.amount, 0);
      const perDay = total / days / kids;
      document.getElementById('kr-total')!.textContent = Math.round(total).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('kr-desc')!.textContent = kids + ' Kind' + (kids > 1 ? 'er' : '') + ', ' + nights + ' Naechte';
      document.getElementById('kr-perday')!.textContent = Math.round(perDay) + ' \u20AC';
      document.getElementById('kr-transport')!.textContent = Math.round(transport) + ' \u20AC';
      document.getElementById('kr-food')!.textContent = Math.round(food) + ' \u20AC';
      document.getElementById('kr-actcost')!.textContent = Math.round(act) + ' \u20AC';
      document.getElementById('kr-breakdown')!.innerHTML =
        '<div class="grid grid-cols-2 gap-2 font-semibold text-text-muted mb-1"><span>Kategorie</span><span class="text-right">Kosten</span></div>' +
        items.map(i => '<div class="grid grid-cols-2 gap-2 py-1"><span>' + i.name + '</span><span class="text-right font-semibold">' + Math.round(i.amount) + ' \u20AC</span></div>').join('') +
        '<div class="grid grid-cols-2 gap-2 py-1 mt-1 border-t border-border font-bold"><span>Gesamt</span><span class="text-right">' + Math.round(total) + ' \u20AC</span></div>';
      const generalItems = ['Wechselkleidung (1 pro Tag + Reserve)', 'Schlafanzuege', 'Bequeme Schuhe', 'Sonnencreme', 'Snacks fuer die Reise', 'Trinkflaschen', 'Unterhaltung (Buecher, Tablet, Spiele)', 'Reiseapotheke mit Kindermedikamenten', 'Krankenversicherungskarten'];
      const infantItems = ['Windeln (10+ pro Tag)', 'Feuchttuecher', 'Flaeschchen/Stillzubehoer', 'Babytrage oder Kinderwagen', 'Kindersitz', 'Reisebett', 'Babyfon', 'Spucktuecher & Laetzchen'];
      const toddlerItems = ['Windeln oder Pull-ups', 'Feuchttuecher', 'Trinklernbecher', 'Lieblingskuscheltier/Schmusedecke', 'Buggy', 'Kindersitz', 'Reise-Toepfchen'];
      const childItems = ['Rucksack mit Beschaeftigung', 'Lieblingsspielzeug', 'Kindersitzerhoehung bei Bedarf'];
      let checklistItems = [...generalItems];
      if (ageGroup === 'infant') checklistItems = [...infantItems, ...generalItems];
      else if (ageGroup === 'toddler') checklistItems = [...toddlerItems, ...generalItems];
      else if (ageGroup === 'child') checklistItems = [...childItems, ...generalItems];
      document.getElementById('kr-checklist')!.innerHTML = checklistItems.map(item =>
        '<div class="flex items-start gap-2 py-0.5"><span class="text-text-muted">&#9744;</span><span>' + item + '</span></div>'
      ).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kr-in').forEach(el => { el.addEventListener('input', calcKR); el.addEventListener('change', calcKR); });
      calcKR();
    }, 50);
  </script>
</CalculatorLayout>
