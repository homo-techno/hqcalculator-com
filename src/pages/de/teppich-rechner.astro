---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Teppich-Rechner – Fläche, Kosten & Material";
const description = "Berechnen Sie die benötigte Teppichfläche, Kosten für Material, Unterlag und Verlegung für Ihr Bodenbelagsprojekt.";
const relatedCalcs = [
  { name: "Kubikmeter-Rechner", url: "/de/kubikmeter-rechner", description: "Volumen." },
  { name: "Deckenventilator-Rechner", url: "/de/deckenventilator-rechner", description: "Ventilator-Größe." },
  { name: "Catering-Mengen-Rechner", url: "/de/catering-mengen-rechner", description: "Catering." },
  { name: "Cashflow-Rechner", url: "/de/cashflow-rechner", description: "Cashflow." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Teppich-Rechner" enSlug="carpet-calculator" keywords="Teppich Rechner, Teppich Kosten, Teppich Fläche, Unterlag, Bodenbelag, Verlegung" breadcrumbs={[{ name: "Teppich-Rechner", url: "/de/teppich-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Teppich-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Teppichfläche, Kosten und benötigte Materialien.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Raumlänge (m)</label><input type="number" id="tpr-l" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="tpr-w" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Teppichpreis (€/m²)</label><input type="number" id="tpr-price" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Unterlage (€/m²)</label><input type="number" id="tpr-pad" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Verlegung (€/m²)</label><input type="number" id="tpr-inst" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label><input type="number" id="tpr-waste" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="30" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="tpr-result">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fläche (m²)</div><div class="text-xl font-bold font-mono" id="tpr-sqm">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mit Verschnitt</div><div class="text-xl font-bold font-mono" id="tpr-with-waste">0 m²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Teppich</div><div class="text-xl font-bold font-mono" id="tpr-cc">0 €</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Unterlage</div><div class="text-xl font-bold font-mono" id="tpr-pc">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verlegung</div><div class="text-xl font-bold font-mono" id="tpr-ic">0 €</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="carpet" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Teppichberechnung</h2>
      <p>Planen Sie 10-15% Verschnitt ein, besonders bei gemusterten Teppichen oder unregelmäßigen Raumformen. Eine gute Unterlage verlängert die Lebensdauer des Teppichs erheblich.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcTPR() {
      const l = parseFloat((document.getElementById('tpr-l') as HTMLInputElement).value) || 0;
      const w = parseFloat((document.getElementById('tpr-w') as HTMLInputElement).value) || 0;
      const price = parseFloat((document.getElementById('tpr-price') as HTMLInputElement).value) || 0;
      const pad = parseFloat((document.getElementById('tpr-pad') as HTMLInputElement).value) || 0;
      const inst = parseFloat((document.getElementById('tpr-inst') as HTMLInputElement).value) || 0;
      const waste = parseFloat((document.getElementById('tpr-waste') as HTMLInputElement).value) || 0;
      const sqm = l * w;
      const sqmWaste = sqm * (1 + waste / 100);
      const carpetCost = sqmWaste * price;
      const padCost = sqmWaste * pad;
      const instCost = sqmWaste * inst;
      const total = carpetCost + padCost + instCost;
      const fmt = (v: number) => v.toLocaleString('de-DE', {minimumFractionDigits:0, maximumFractionDigits:0});
      document.getElementById('tpr-result')!.textContent = fmt(total) + ' €';
      document.getElementById('tpr-sqm')!.textContent = sqm.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      document.getElementById('tpr-with-waste')!.textContent = sqmWaste.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' m²';
      document.getElementById('tpr-cc')!.textContent = fmt(carpetCost) + ' €';
      document.getElementById('tpr-pc')!.textContent = fmt(padCost) + ' €';
      document.getElementById('tpr-ic')!.textContent = fmt(instCost) + ' €';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('tpr-l') as HTMLInputElement).value = '5';
      (document.getElementById('tpr-w') as HTMLInputElement).value = '4';
      (document.getElementById('tpr-price') as HTMLInputElement).value = '30';
      (document.getElementById('tpr-pad') as HTMLInputElement).value = '5';
      (document.getElementById('tpr-inst') as HTMLInputElement).value = '10';
      (document.getElementById('tpr-waste') as HTMLInputElement).value = '10';
      document.querySelectorAll('.tpr-in').forEach(el => { el.addEventListener('input', calcTPR); el.addEventListener('change', calcTPR); });
      calcTPR();
    }, 50);
  </script>
</CalculatorLayout>
