---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Papier-Falz Rechner - Schichtdicke & maximale Faltanzahl";
const description = "Berechnen Sie die Papierschichtdicke beim Falten und ermitteln Sie die theoretisch maximale Faltanzahl sowie die Gesamthöhe des gefalteten Papiers.";

const relatedCalcs = [
  { name: "Papierrechner", url: "/de/papier-rechner", description: "Papiermenge." },
  { name: "Papiergewicht-Rechner", url: "/de/papiergewicht-rechner", description: "Papiergewicht." },
  { name: "Exponentenrechner", url: "/de/exponentenrechner", description: "Potenzen." },
  { name: "Geometrie-Rechner", url: "/de/geometrie-rechner", description: "Geometrie." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Papier-Falz Rechner" lang="de" enSlug="paper-fold-calculator" keywords="papier falten rechner, papier falten dicke, maximale faltungen papier, exponentielles wachstum papier" breadcrumbs={[{ name: "Papier-Falz Rechner", url: "/de/papier-falz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Papier-Falz Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Gesamtdicke gefalteten Papiers und die theoretisch maximale Faltanzahl.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Papierdicke (mm)</label><input type="number" id="pf-thick" class="pf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.1" min="0.01" max="5" step="0.01"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Faltungen</label><input type="number" id="pf-folds" class="pf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7" min="1" max="50" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Papierlänge (cm)</label><input type="number" id="pf-length" class="pf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="29.7" min="1" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einheit Ausgabe</label><select id="pf-unit" class="pf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"><option value="mm">mm</option><option value="cm">cm</option><option value="m">m</option><option value="km">km</option></select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtdicke nach Falten</div>
          <div class="text-4xl font-extrabold font-mono" id="pf-result">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lagen</div><div class="text-xl font-bold font-mono" id="pf-layers">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. mögl. Faltungen</div><div class="text-xl font-bold font-mono" id="pf-maxfold">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Restlänge (cm)</div><div class="text-xl font-bold font-mono" id="pf-remain">0 cm</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl overflow-x-auto">
          <h3 class="font-semibold text-sm text-text mb-3">Faltungsschritte</h3>
          <table class="w-full text-sm"><thead><tr class="text-xs text-text-muted uppercase"><th class="text-left pb-2">Faltung</th><th class="text-right pb-2">Lagen</th><th class="text-right pb-2">Dicke</th></tr></thead><tbody id="pf-table"></tbody></table>
        </div>
      </div>
      <ShareButton calculatorId="papier-falz-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Das Geheimnis des Papierfaltens</h2>
      <p class="text-text-secondary mt-2">Beim Falten von Papier verdoppelt sich die Anzahl der Lagen mit jeder Faltung. Nach 7 Faltungen entstehen 128 Lagen. Theoretisch würden 42 Faltungen reichen, um die Erde mit dem Mond zu verbinden – das exponenzielle Wachstum macht dies zur berühmten Gedankenaufgabe in der Mathematik. In der Praxis ist das Falten eines Blattes auf mehr als 7–8 Mal kaum möglich.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Lagen:</strong> 2^n (n = Anzahl Faltungen)</p>
        <p><strong>Gesamtdicke:</strong> Papierdicke × 2^n</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie oft kann man ein Blatt Papier falten?</strong> In der Praxis lässt sich ein normales Blatt Papier nur 7–8 Mal falten. Britney Gallivan konnte 2002 ein lges Toilettenpapier 12 Mal falten und entwickelte dafür die mathematische Formel.</p>
      <p><strong>Warum verdoppelt sich die Dicke?</strong> Jede Faltung legt die bestehenden Lagen übereinander, sodass die Schichtanzahl mit jeder Faltung auf das Doppelte ansteigt. Dies entspricht dem exponenziellen Wachstum 2^n.</p>
      <p><strong>Wie viele Faltungen würden bis zum Mond reichen?</strong> Bei einer Papierdicke von 0,1 mm und 42 Faltungen erreicht die Stapelhöhe rund 439.805 km – das ist die durchschnittliche Entfernung zum Mond.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcPF() {
      const thickMM = parseFloat((document.getElementById('pf-thick') as HTMLInputElement).value) || 0.1;
      const folds = parseInt((document.getElementById('pf-folds') as HTMLInputElement).value) || 7;
      const lengthCM = parseFloat((document.getElementById('pf-length') as HTMLInputElement).value) || 29.7;
      const unit = (document.getElementById('pf-unit') as HTMLSelectElement).value;

      const layers = Math.pow(2, folds);
      const totalThickMM = thickMM * layers;
      const divisors: Record<string, number> = { mm: 1, cm: 10, m: 1000, km: 1000000 };
      const div = divisors[unit] || 1;
      const displayThick = totalThickMM / div;

      let maxFolds = 0;
      let remLen = lengthCM * 10;
      for (let i = 1; i <= 50; i++) {
        const minLen = Math.PI * thickMM * (Math.pow(2, i) + 4) * (Math.pow(2, i) - 1) / 6;
        if (minLen <= remLen) maxFolds = i; else break;
      }

      const unitLabels: Record<string, string> = { mm: 'mm', cm: 'cm', m: 'm', km: 'km' };
      const label = unitLabels[unit] || 'mm';
      document.getElementById('pf-result')!.textContent = displayThick.toLocaleString('de-DE', { maximumSignificantDigits: 4 }) + ' ' + label;
      document.getElementById('pf-layers')!.textContent = layers.toLocaleString('de-DE');
      document.getElementById('pf-maxfold')!.textContent = maxFolds.toString();
      document.getElementById('pf-remain')!.textContent = (lengthCM / Math.pow(2, folds)).toFixed(3).replace('.', ',') + ' cm';

      const tableRows = [];
      for (let i = 1; i <= Math.min(folds, 15); i++) {
        const l = Math.pow(2, i);
        const d = thickMM * l / div;
        tableRows.push('<tr class="border-t border-border/30"><td class="py-1">' + i + '</td><td class="text-right">' + l.toLocaleString('de-DE') + '</td><td class="text-right">' + d.toLocaleString('de-DE', { maximumSignificantDigits: 4 }) + ' ' + label + '</td></tr>');
      }
      document.getElementById('pf-table')!.innerHTML = tableRows.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pf-in').forEach(el => { el.addEventListener('input', calcPF); el.addEventListener('change', calcPF); });
      calcPF();
    }, 50);
  </script>
</CalculatorLayout>
