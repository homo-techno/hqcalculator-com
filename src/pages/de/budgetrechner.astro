---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Budgetrechner - 50/30/20-Budgetplaner";
const description = "Erstellen Sie ein pers&ouml;nliches Budget nach der 50/30/20-Regel. Teilen Sie Ihr Einkommen in Bed&uuml;rfnisse, W&uuml;nsche und Sparen auf.";
const relatedCalcs = [
  { name: "Gehaltsrechner", url: "/de/gehaltsrechner", description: "Gehalt berechnen." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziele." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Geldanlage." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Budgetrechner" lang="de" enSlug="budget-calculator" keywords="budgetrechner, 50 30 20 regel, budgetplaner, haushaltsplan, monatsbudget" breadcrumbs={[{ name: "Budgetrechner", url: "/de/budgetrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Budgetrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihr Monatsbudget nach der 50/30/20-Regel.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Monatliches Nettoeinkommen</label>
            <div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted font-bold">&euro;</span>
              <input type="number" id="bg-income" class="w-full pl-8 pr-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="100">
            </div>
          </div>
          <div class="bg-blue-50 rounded-xl p-4 space-y-2">
            <h4 class="text-xs font-semibold text-blue-700 uppercase">Bed&uuml;rfnisse (50%) &mdash; Fixkosten</h4>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="block text-xs text-text-muted mb-1">Wohnen</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-need w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="50"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Nebenkosten</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-need w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Lebensmittel</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-need w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Mobilit&auml;t</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-need w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Versicherungen</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-need w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Min. Schuldentilgung</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-need w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
            </div>
          </div>
          <div class="bg-yellow-50 rounded-xl p-4 space-y-2">
            <h4 class="text-xs font-semibold text-yellow-700 uppercase">W&uuml;nsche (30%) &mdash; Lifestyle</h4>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="block text-xs text-text-muted mb-1">Essen gehen</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-want w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Unterhaltung</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-want w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Shopping</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-want w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Abonnements</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-want w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="10"></div></div>
            </div>
          </div>
          <div class="bg-green-50 rounded-xl p-4 space-y-2">
            <h4 class="text-xs font-semibold text-green-700 uppercase">Sparen & Schulden (20%)</h4>
            <div class="grid grid-cols-2 gap-2">
              <div><label class="block text-xs text-text-muted mb-1">Notgroschen</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-save w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Altersvorsorge</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-save w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Extra Schuldentilgung</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-save w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
              <div><label class="block text-xs text-text-muted mb-1">Sonstiges Sparen</label><div class="relative"><span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">&euro;</span><input type="number" class="bg-save w-full pl-5 pr-2 py-2 border border-border rounded-lg text-sm" min="0" step="25"></div></div>
            </div>
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nicht zugewiesen</div>
            <div class="text-5xl font-extrabold" id="bg-unalloc">0 &euro;</div>
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div class="p-4 bg-blue-50 rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Bed&uuml;rfnisse</div>
              <div class="text-lg font-bold" id="bg-needs-total">0 &euro;</div>
              <div class="text-xs" id="bg-needs-pct">0%</div>
            </div>
            <div class="p-4 bg-yellow-50 rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">W&uuml;nsche</div>
              <div class="text-lg font-bold" id="bg-wants-total">0 &euro;</div>
              <div class="text-xs" id="bg-wants-pct">0%</div>
            </div>
            <div class="p-4 bg-green-50 rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Sparen</div>
              <div class="text-lg font-bold" id="bg-save-total">0 &euro;</div>
              <div class="text-xs" id="bg-save-pct">0%</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-2">50/30/20 Vergleich</h3>
            <div class="space-y-2" id="bg-bars"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="budget" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Die 50/30/20-Budgetregel</h2>
      <p>Verteilen Sie Ihr Nettoeinkommen: <strong>50%</strong> f&uuml;r Bed&uuml;rfnisse (Miete, Lebensmittel, Rechnungen), <strong>30%</strong> f&uuml;r W&uuml;nsche (Unterhaltung, Essen gehen) und <strong>20%</strong> f&uuml;r Sparen & Schuldentilgung.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const fmtEur = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function sumClass(cls: string): number {
      let total = 0;
      document.querySelectorAll('.' + cls).forEach(el => { total += parseFloat((el as HTMLInputElement).value) || 0; });
      return total;
    }

    function calcBudget() {
      const income = parseFloat((document.getElementById('bg-income') as HTMLInputElement).value) || 0;
      const needs = sumClass('bg-need');
      const wants = sumClass('bg-want');
      const saves = sumClass('bg-save');
      const total = needs + wants + saves;
      const unalloc = income - total;

      const np = income > 0 ? (needs / income * 100) : 0;
      const wp = income > 0 ? (wants / income * 100) : 0;
      const sp = income > 0 ? (saves / income * 100) : 0;

      document.getElementById('bg-unalloc')!.textContent = fmtEur(unalloc);
      document.getElementById('bg-unalloc')!.parentElement!.style.backgroundColor = unalloc >= 0 ? '#3b82f6' : '#ef4444';
      document.getElementById('bg-needs-total')!.textContent = fmtEur(needs);
      document.getElementById('bg-needs-pct')!.textContent = np.toFixed(0) + '% des Einkommens';
      document.getElementById('bg-wants-total')!.textContent = fmtEur(wants);
      document.getElementById('bg-wants-pct')!.textContent = wp.toFixed(0) + '% des Einkommens';
      document.getElementById('bg-save-total')!.textContent = fmtEur(saves);
      document.getElementById('bg-save-pct')!.textContent = sp.toFixed(0) + '% des Einkommens';

      const bar = (label: string, actual: number, target: number, color: string) => {
        const over = actual > target;
        return `<div class="text-xs"><div class="flex justify-between mb-0.5"><span>${label}</span><span class="font-semibold ${over ? 'text-red-600' : ''}">${actual.toFixed(0)}% / ${target}%</span></div><div class="w-full h-3 bg-gray-200 rounded-full overflow-hidden"><div class="h-full rounded-full ${color}" style="width:${Math.min(100, actual / target * 100)}%"></div></div></div>`;
      };

      document.getElementById('bg-bars')!.innerHTML =
        bar('Bed\u00fcrf. (Ziel 50%)', np, 50, 'bg-blue-500') +
        bar('W\u00fcnsche (Ziel 30%)', wp, 30, 'bg-yellow-500') +
        bar('Sparen (Ziel 20%)', sp, 20, 'bg-green-500');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('bg-income') as HTMLInputElement).value = '3500';
      const needValues = [1000, 200, 350, 200, 200, 0];
      const wantValues = [200, 150, 100, 50];
      const saveValues = [200, 300, 100, 0];
      document.querySelectorAll('.bg-need').forEach((el, i) => { (el as HTMLInputElement).value = String(needValues[i] || 0); });
      document.querySelectorAll('.bg-want').forEach((el, i) => { (el as HTMLInputElement).value = String(wantValues[i] || 0); });
      document.querySelectorAll('.bg-save').forEach((el, i) => { (el as HTMLInputElement).value = String(saveValues[i] || 0); });
      document.getElementById('bg-income')!.addEventListener('input', calcBudget);
      document.querySelectorAll('.bg-need, .bg-want, .bg-save').forEach(el => el.addEventListener('input', calcBudget));
      calcBudget();
    }, 50);
  </script>
</CalculatorLayout>
