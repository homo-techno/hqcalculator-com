---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gleichungsl\u00f6ser - Linear, Quadratisch & Kubisch";
const description = "L\u00f6sen Sie lineare, quadratische und kubische Gleichungen Schritt f\u00fcr Schritt. Finden Sie reelle und komplexe L\u00f6sungen.";
const relatedCalcs = [
  { name: "Gleichstufige Stimmung", url: "/de/gleichstufige-stimmung-rechner", description: "Notenfrequenzen." },
  { name: "Enzymkinetik-Rechner", url: "/de/enzymkinetik-rechner", description: "Michaelis-Menten." },
  { name: "Elektrochemie-Rechner", url: "/de/elektrochemie-rechner", description: "Nernst-Gleichung." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gleichungsl\u00f6ser" lang="de" enSlug="equation-solver" keywords="gleichungsl\u00f6ser, gleichungen l\u00f6sen, x berechnen, lineare gleichung, quadratische gleichung, kubische gleichung" breadcrumbs={[{ name: "Gleichungsl\u00f6ser", url: "/de/gleichungsloeser" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gleichungsl&ouml;ser</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">L&ouml;sen Sie lineare, quadratische und kubische Gleichungen mit L&ouml;sungsweg.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="glde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-mode="linear">Linear</button>
          <button class="glde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="quadratic">Quadratisch</button>
          <button class="glde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="cubic">Kubisch</button>
        </div>
        <div id="glde-linear" class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">ax + b = 0</h3>
          <div class="flex gap-2 items-center">
            <input type="number" id="glde-la" class="glde-in w-24 px-3 py-2 border border-border rounded-xl text-lg font-bold text-center" value="5" step="1">
            <span class="font-bold">x +</span>
            <input type="number" id="glde-lb" class="glde-in w-24 px-3 py-2 border border-border rounded-xl text-lg font-bold text-center" value="-15" step="1">
            <span class="font-bold">= 0</span>
          </div>
        </div>
        <div id="glde-quadratic" class="p-4 bg-surface-alt rounded-xl hidden">
          <h3 class="font-semibold text-sm text-text mb-2">ax&sup2; + bx + c = 0</h3>
          <div class="flex gap-2 items-center">
            <input type="number" id="glde-qa" class="glde-in w-20 px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" step="1">
            <span class="font-bold text-sm">x&sup2; +</span>
            <input type="number" id="glde-qb" class="glde-in w-20 px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="-5" step="1">
            <span class="font-bold text-sm">x +</span>
            <input type="number" id="glde-qc" class="glde-in w-20 px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="6" step="1">
            <span class="font-bold text-sm">= 0</span>
          </div>
        </div>
        <div id="glde-cubic" class="p-4 bg-surface-alt rounded-xl hidden">
          <h3 class="font-semibold text-sm text-text mb-2">ax&sup3; + bx&sup2; + cx + d = 0</h3>
          <div class="flex gap-2 items-center flex-wrap">
            <input type="number" id="glde-ca" class="glde-in w-16 px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="1" step="1">
            <span class="font-bold text-sm">x&sup3; +</span>
            <input type="number" id="glde-cb" class="glde-in w-16 px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="-6" step="1">
            <span class="font-bold text-sm">x&sup2; +</span>
            <input type="number" id="glde-cc" class="glde-in w-16 px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="11" step="1">
            <span class="font-bold text-sm">x +</span>
            <input type="number" id="glde-cd" class="glde-in w-16 px-2 py-2 border border-border rounded-xl text-lg font-bold text-center" value="-6" step="1">
            <span class="font-bold text-sm">= 0</span>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">L&ouml;sung</div>
          <div class="text-4xl font-extrabold font-mono" id="glde-result">x = 3</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="glde-extra">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="glde-e1-label">Typ</div><div class="text-xl font-bold font-mono" id="glde-e1">Linear</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase" id="glde-e2-label">Nullstellen</div><div class="text-xl font-bold font-mono" id="glde-e2">1</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Schritt f&uuml;r Schritt</h3>
          <div class="text-xs space-y-1" id="glde-steps"></div>
        </div>
      </div>
      <ShareButton calculatorId="equation-solver-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gleichungen l&ouml;sen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Linear:</strong> x = &minus;b / a</p>
        <p><strong>Quadratisch:</strong> x = (&minus;b &plusmn; &radic;(b&sup2;&minus;4ac)) / 2a</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die Diskriminante?</strong> D = b&sup2; &minus; 4ac bestimmt die Art der L&ouml;sungen: D &gt; 0 ergibt zwei reelle, D = 0 eine doppelte, D &lt; 0 zwei komplexe L&ouml;sungen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let gldeMode = 'linear';
    function calcGLDE() {
      const steps: string[] = [];
      if (gldeMode === 'linear') {
        const a = parseFloat((document.getElementById('glde-la') as HTMLInputElement).value) || 0;
        const b = parseFloat((document.getElementById('glde-lb') as HTMLInputElement).value) || 0;
        if (a === 0) {
          document.getElementById('glde-result')!.textContent = b === 0 ? 'Alle x' : 'Keine L\u00F6sung';
          document.getElementById('glde-e1')!.textContent = 'Linear';
          document.getElementById('glde-e2')!.textContent = a === 0 && b === 0 ? '\u221E' : '0';
          steps.push('<div>' + a + 'x + (' + b + ') = 0</div>');
        } else {
          const x = -b / a;
          document.getElementById('glde-result')!.textContent = 'x = ' + x.toFixed(4);
          document.getElementById('glde-e1')!.textContent = 'Linear';
          document.getElementById('glde-e2')!.textContent = '1 Nullstelle';
          steps.push('<div>' + a + 'x + (' + b + ') = 0</div>');
          steps.push('<div>' + a + 'x = ' + (-b) + '</div>');
          steps.push('<div>x = ' + (-b) + ' / ' + a + ' = ' + x.toFixed(4) + '</div>');
        }
        document.getElementById('glde-e1-label')!.textContent = 'Typ';
        document.getElementById('glde-e2-label')!.textContent = 'Nullstellen';
      } else if (gldeMode === 'quadratic') {
        const a = parseFloat((document.getElementById('glde-qa') as HTMLInputElement).value) || 0;
        const b = parseFloat((document.getElementById('glde-qb') as HTMLInputElement).value) || 0;
        const c = parseFloat((document.getElementById('glde-qc') as HTMLInputElement).value) || 0;
        const disc = b * b - 4 * a * c;
        steps.push('<div>' + a + 'x\u00B2 + (' + b + ')x + (' + c + ') = 0</div>');
        steps.push('<div>Diskriminante: b\u00B2 - 4ac = ' + disc.toFixed(2) + '</div>');
        document.getElementById('glde-e1-label')!.textContent = 'Diskriminante';
        document.getElementById('glde-e1')!.textContent = disc.toFixed(2);
        if (a === 0) {
          const x = b !== 0 ? -c / b : 0;
          document.getElementById('glde-result')!.textContent = b !== 0 ? 'x = ' + x.toFixed(4) : 'Nicht quadratisch';
          document.getElementById('glde-e2')!.textContent = '1 Nullstelle';
        } else if (disc > 0) {
          const x1 = (-b + Math.sqrt(disc)) / (2 * a);
          const x2 = (-b - Math.sqrt(disc)) / (2 * a);
          document.getElementById('glde-result')!.textContent = 'x = ' + x1.toFixed(4) + ', ' + x2.toFixed(4);
          document.getElementById('glde-e2')!.textContent = '2 reelle';
          steps.push('<div>x = (-b \u00B1 \u221AD) / 2a</div>');
          steps.push('<div>x\u2081 = ' + x1.toFixed(4) + '</div>');
          steps.push('<div>x\u2082 = ' + x2.toFixed(4) + '</div>');
        } else if (disc === 0) {
          const x1 = -b / (2 * a);
          document.getElementById('glde-result')!.textContent = 'x = ' + x1.toFixed(4) + ' (doppelt)';
          document.getElementById('glde-e2')!.textContent = '1 (doppelt)';
        } else {
          const real = -b / (2 * a);
          const imag = Math.sqrt(-disc) / (2 * a);
          document.getElementById('glde-result')!.textContent = real.toFixed(3) + ' \u00B1 ' + Math.abs(imag).toFixed(3) + 'i';
          document.getElementById('glde-e2')!.textContent = '2 komplexe';
        }
        document.getElementById('glde-e2-label')!.textContent = 'Nullstellen';
      } else {
        const a = parseFloat((document.getElementById('glde-ca') as HTMLInputElement).value) || 0;
        const b = parseFloat((document.getElementById('glde-cb') as HTMLInputElement).value) || 0;
        const c = parseFloat((document.getElementById('glde-cc') as HTMLInputElement).value) || 0;
        const d = parseFloat((document.getElementById('glde-cd') as HTMLInputElement).value) || 0;
        steps.push('<div>' + a + 'x\u00B3 + (' + b + ')x\u00B2 + (' + c + ')x + (' + d + ') = 0</div>');
        const roots: number[] = [];
        for (let x = -50; x <= 50; x += 0.05) {
          const y1 = a * x * x * x + b * x * x + c * x + d;
          const x2 = x + 0.05;
          const y2 = a * x2 * x2 * x2 + b * x2 * x2 + c * x2 + d;
          if (y1 * y2 <= 0) {
            let lo = x, hi = x2;
            for (let i = 0; i < 50; i++) {
              const mid = (lo + hi) / 2;
              const ym = a * mid * mid * mid + b * mid * mid + c * mid + d;
              if (ym * (a * lo * lo * lo + b * lo * lo + c * lo + d) <= 0) hi = mid;
              else lo = mid;
            }
            const root = parseFloat(((lo + hi) / 2).toFixed(4));
            if (roots.every(r => Math.abs(r - root) > 0.01)) roots.push(root);
          }
        }
        if (roots.length > 0) {
          document.getElementById('glde-result')!.textContent = roots.map(r => 'x = ' + r).join(', ');
          roots.forEach((r, i) => steps.push('<div>x' + (i + 1) + ' = ' + r + '</div>'));
        } else {
          document.getElementById('glde-result')!.textContent = 'Keine reellen Nullstellen in [-50, 50]';
        }
        document.getElementById('glde-e1-label')!.textContent = 'Typ';
        document.getElementById('glde-e1')!.textContent = 'Kubisch';
        document.getElementById('glde-e2-label')!.textContent = 'Reelle Nullstellen';
        document.getElementById('glde-e2')!.textContent = roots.length.toString();
        steps.push('<div class="text-text-muted">Nullstellen numerisch per Bisektion gefunden</div>');
      }
      document.getElementById('glde-steps')!.innerHTML = steps.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.glde-mode').forEach(b => b.addEventListener('click', () => {
        gldeMode = (b as HTMLButtonElement).dataset.mode!;
        document.querySelectorAll('.glde-mode').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.mode === gldeMode;
          (btn as HTMLButtonElement).className = 'glde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        document.getElementById('glde-linear')!.classList.toggle('hidden', gldeMode !== 'linear');
        document.getElementById('glde-quadratic')!.classList.toggle('hidden', gldeMode !== 'quadratic');
        document.getElementById('glde-cubic')!.classList.toggle('hidden', gldeMode !== 'cubic');
        calcGLDE();
      }));
      document.querySelectorAll('.glde-in').forEach(el => { el.addEventListener('input', calcGLDE); el.addEventListener('change', calcGLDE); });
      calcGLDE();
    }, 50);
  </script>
</CalculatorLayout>
