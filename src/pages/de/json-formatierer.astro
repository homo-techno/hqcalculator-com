---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "JSON Formatierer – JSON formatieren & validieren online";
const description = "Formatieren, validieren und verschönern Sie JSON-Daten online.";
const relatedCalcs = [
  { name: "IP-Subnetz Rechner", url: "/de/ip-subnetz-rechner", description: "Subnetzmasken berechnen." },
  { name: "ISBN Rechner", url: "/de/isbn-rechner", description: "ISBN-10 & ISBN-13 validieren." },
  { name: "Internetgeschwindigkeit Rechner", url: "/de/internetgeschwindigkeit-rechner", description: "Download/Upload-Zeiten." },
  { name: "Interpolationsrechner", url: "/de/interpolations-rechner", description: "Lineare Interpolation." },
];
---
<CalculatorLayout lang="de" enSlug="json-formatter-calculator" title={title} description={description} calculatorName="JSON Formatierer" keywords="JSON formatieren, JSON validieren, JSON beautify, JSON minify, JSON online, JSON Werkzeug" breadcrumbs={[{ name: "JSON Formatierer", url: "/de/json-formatierer" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">JSON Formatierer</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Formatieren, validieren, minifizieren und analysieren Sie JSON-Daten direkt im Browser – ohne Serververbindung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-4xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 flex-wrap">
          <button id="jf-format" class="px-4 py-2 bg-primary text-white rounded-xl text-sm font-semibold hover:bg-primary-dark">Formatieren</button>
          <button id="jf-minify" class="px-4 py-2 bg-surface-alt border border-border rounded-xl text-sm font-semibold hover:bg-border">Minifizieren</button>
          <button id="jf-clear" class="px-4 py-2 bg-surface-alt border border-border rounded-xl text-sm font-semibold hover:bg-border">Löschen</button>
          <button id="jf-sample" class="px-4 py-2 bg-surface-alt border border-border rounded-xl text-sm font-semibold hover:bg-border">Beispiel laden</button>
          <div class="ml-auto flex items-center gap-2">
            <label class="text-xs font-medium text-text">Einrückung:</label>
            <select id="jf-indent" class="px-2 py-1 border border-border rounded-lg text-sm">
              <option value="2" selected>2 Leerzeichen</option>
              <option value="4">4 Leerzeichen</option>
              <option value="tab">Tab</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Eingabe (JSON)</label>
            <textarea id="jf-input" class="w-full h-64 px-3 py-2 border border-border rounded-xl font-mono text-sm resize-none" placeholder='{"name": "Test", "wert": 42}'></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ausgabe</label>
            <textarea id="jf-output" class="w-full h-64 px-3 py-2 border border-border rounded-xl font-mono text-sm resize-none bg-surface-alt" readonly></textarea>
          </div>
        </div>
        <div id="jf-status" class="p-3 rounded-xl text-sm font-semibold text-center"></div>
        <div class="grid grid-cols-4 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeichen</div><div class="text-xl font-bold" id="jf-chars">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeilen</div><div class="text-xl font-bold" id="jf-lines">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Schlüssel</div><div class="text-xl font-bold" id="jf-keys">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tiefe</div><div class="text-xl font-bold" id="jf-depth">—</div></div>
        </div>
        <button id="jf-copy" class="w-full py-2 bg-surface-alt border border-border rounded-xl text-sm font-semibold hover:bg-border">Ausgabe kopieren</button>
      </div>
      <ShareButton lang="de" calculatorId="json-formatter" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">JSON – JavaScript Object Notation</h2>
      <p class="text-text-secondary">JSON (JavaScript Object Notation) ist ein leichtgewichtiges, textbasiertes Datenaustauschformat, das für Menschen lesbar und für Maschinen leicht verarbeitbar ist. Es basiert auf einer Untermenge der JavaScript-Sprache, ist aber sprachunabhängig. JSON unterstützt Objekte, Arrays, Strings, Zahlen, Boolesche Werte und null.</p>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zwischen JSON und XML?</h4>
          <p class="text-text-secondary mt-1">JSON ist kompakter, leichter zu lesen und in modernen Web-APIs weit verbreitet. XML ist ausdrucksstärker (Attribute, Namespaces, Schemas) und in Enterprise-Umgebungen und SOAP-Webservices häufig. JSON hat in der Webentwicklung XML weitgehend abgelöst.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was bedeutet JSON minifizieren?</h4>
          <p class="text-text-secondary mt-1">Minifizierung entfernt alle überflüssigen Leerzeichen, Zeilenumbrüche und Einrückungen aus einem JSON-Dokument. Dies reduziert die Dateigröße und damit die Übertragungszeit, macht den Code aber für Menschen schwerer lesbar. Für APIs und Produktionsumgebungen ist Minifizierung empfehlenswert.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welche Datentypen unterstützt JSON?</h4>
          <p class="text-text-secondary mt-1">JSON unterstützt: String (in Anführungszeichen), Number (Integer und Float), Boolean (true/false), null, Array (geordnete Liste in eckigen Klammern) und Object (Schlüssel-Wert-Paare in geschweiften Klammern). Datum/Zeit-Werte müssen als String kodiert werden.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Warum sind Kommentare in JSON nicht erlaubt?</h4>
          <p class="text-text-secondary mt-1">JSON wurde bewusst ohne Kommentar-Syntax entworfen, um die Parser-Komplexität zu minimieren und Interoperabilität zu maximieren. Douglas Crockford, der JSON-Erfinder, entfernte Kommentare, weil er sah, dass sie für Anweisungen missbraucht wurden. JSONC (JSON with Comments) ist eine inoffizielle Erweiterung.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const SAMPLE = '{"name":"Max Mustermann","alter":35,"adresse":{"strasse":"Musterstraße 1","plz":"10115","stadt":"Berlin"},"hobbys":["Lesen","Radfahren","Kochen"],"aktiv":true,"kinder":null}';
    function countKeys(obj: unknown, depth: number = 0): [number, number] {
      if (typeof obj !== 'object' || obj === null) return [0, depth];
      let keys = 0, maxDepth = depth;
      for (const val of Object.values(obj as Record<string, unknown>)) {
        keys++;
        if (typeof val === 'object' && val !== null) {
          const [k, d] = countKeys(val, depth + 1);
          keys += k;
          maxDepth = Math.max(maxDepth, d);
        }
      }
      return [keys, maxDepth];
    }
    function processJSON(mode: 'format' | 'minify') {
      const input = (document.getElementById('jf-input') as HTMLTextAreaElement).value.trim();
      const statusEl = document.getElementById('jf-status')!;
      const outputEl = document.getElementById('jf-output') as HTMLTextAreaElement;
      if (!input) { outputEl.value = ''; statusEl.textContent = 'Bitte JSON eingeben.'; statusEl.className = 'p-3 rounded-xl text-sm font-semibold text-center bg-surface-alt'; return; }
      try {
        const parsed = JSON.parse(input);
        const indentSel = (document.getElementById('jf-indent') as HTMLSelectElement).value;
        const indent = indentSel === 'tab' ? '\t' : parseInt(indentSel);
        const output = mode === 'format' ? JSON.stringify(parsed, null, indent) : JSON.stringify(parsed);
        outputEl.value = output;
        statusEl.textContent = 'Gültiges JSON';
        statusEl.className = 'p-3 rounded-xl text-sm font-semibold text-center bg-green-50 text-green-700';
        const [keys, depth] = countKeys(parsed);
        document.getElementById('jf-chars')!.textContent = output.length.toLocaleString('de-DE');
        document.getElementById('jf-lines')!.textContent = output.split('\n').length.toLocaleString('de-DE');
        document.getElementById('jf-keys')!.textContent = keys.toLocaleString('de-DE');
        document.getElementById('jf-depth')!.textContent = depth.toLocaleString('de-DE');
      } catch (e: unknown) {
        const msg = e instanceof Error ? e.message : String(e);
        statusEl.textContent = 'Fehler: ' + msg;
        statusEl.className = 'p-3 rounded-xl text-sm font-semibold text-center bg-red-50 text-red-700';
        outputEl.value = '';
        document.getElementById('jf-chars')!.textContent = '—';
        document.getElementById('jf-lines')!.textContent = '—';
        document.getElementById('jf-keys')!.textContent = '—';
        document.getElementById('jf-depth')!.textContent = '—';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('jf-input') as HTMLTextAreaElement).value = SAMPLE;
      document.getElementById('jf-format')!.addEventListener('click', () => processJSON('format'));
      document.getElementById('jf-minify')!.addEventListener('click', () => processJSON('minify'));
      document.getElementById('jf-clear')!.addEventListener('click', () => {
        (document.getElementById('jf-input') as HTMLTextAreaElement).value = '';
        (document.getElementById('jf-output') as HTMLTextAreaElement).value = '';
        document.getElementById('jf-status')!.textContent = '';
      });
      document.getElementById('jf-sample')!.addEventListener('click', () => {
        (document.getElementById('jf-input') as HTMLTextAreaElement).value = SAMPLE;
        processJSON('format');
      });
      document.getElementById('jf-copy')!.addEventListener('click', () => {
        const out = (document.getElementById('jf-output') as HTMLTextAreaElement).value;
        if (out) navigator.clipboard.writeText(out).then(() => { document.getElementById('jf-copy')!.textContent = 'Kopiert!'; setTimeout(() => { document.getElementById('jf-copy')!.textContent = 'Ausgabe kopieren'; }, 2000); });
      });
      processJSON('format');
    }, 50);
  </script>
</CalculatorLayout>
