---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Intervalltraining Rechner – HIIT Work/Rest Planung";
const description = "Planen Sie Ihre HIIT-Einheiten mit optimalen Work/Rest-Intervallen.";
const relatedCalcs = [
  { name: "Keto Rechner", url: "/de/keto-rechner", description: "Makronährstoffe für Keto." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglichen Kalorienbedarf berechnen." },
  { name: "BMI Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index berechnen." },
  { name: "Kajak-Paddel Rechner", url: "/de/kajak-paddel-rechner", description: "Optimale Paddellänge." },
];
---
<CalculatorLayout lang="de" enSlug="interval-training-calculator" title={title} description={description} calculatorName="Intervalltraining Rechner" keywords="Intervalltraining, HIIT Rechner, Work Rest Verhältnis, Hochintensitätstraining, Trainingsplan" breadcrumbs={[{ name: "Intervalltraining Rechner", url: "/de/intervalltraining-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Intervalltraining Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie HIIT-Trainingseinheiten mit individuellen Belastungs- und Erholungsintervallen sowie Aufwärm- und Abkühlphasen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Belastungszeit (Sek.)</label><input type="number" id="it-work" class="it-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="40" min="5" max="300"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Erholungszeit (Sek.)</label><input type="number" id="it-rest" class="it-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="20" min="5" max="300"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Runden</label><input type="number" id="it-rounds" class="it-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="8" min="1" max="100"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Sätze</label><input type="number" id="it-sets" class="it-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="3" min="1" max="20"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Pause zwischen Sätzen (Sek.)</label><input type="number" id="it-setrest" class="it-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="0" max="600"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Aufwärmen (Min.)</label><input type="number" id="it-warmup" class="it-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" max="30"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamttrainingszeit</div>
          <div class="text-5xl font-extrabold font-mono" id="it-result">—</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aktive Belastungszeit</div><div class="text-xl font-bold" id="it-worktime">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erholungszeit gesamt</div><div class="text-xl font-bold" id="it-resttime">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Work:Rest Verhältnis</div><div class="text-xl font-bold" id="it-ratio">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamte Intervalle</div><div class="text-xl font-bold" id="it-total-rounds">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Trainingsplan Übersicht</h3>
          <div class="text-xs space-y-1" id="it-plan"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="interval-training" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">HIIT – Hochintensitäts-Intervalltraining</h2>
      <p class="text-text-secondary">HIIT (High-Intensity Interval Training) wechselt kurze maximale Belastungsphasen mit definierten Erholungspausen ab. Studien zeigen, dass HIIT in kürzerer Zeit ähnliche oder bessere Ausdauerverbesserungen erzielt als moderates Dauertraining. Das klassische Tabata-Protokoll sieht 20 Sekunden Belastung und 10 Sekunden Pause über 8 Runden vor.</p>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie oft pro Woche sollte ich HIIT machen?</h4>
          <p class="text-text-secondary mt-1">Für die meisten Sportler sind 2–3 HIIT-Einheiten pro Woche optimal. Das intensive Training belastet das zentrale Nervensystem stark. Zwischen den Einheiten benötigt der Körper mindestens 48 Stunden Erholung. Anfänger sollten mit einer Einheit pro Woche starten.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist ein gutes Work:Rest-Verhältnis?</h4>
          <p class="text-text-secondary mt-1">Für Einsteiger: 1:2 (z.B. 20 Sek. Belastung / 40 Sek. Pause). Für Fortgeschrittene: 1:1 (klassisches Tabata) oder 2:1 für maximale Intensität. Das optimale Verhältnis hängt von Ihrer Fitness, den Übungen und dem Trainingsziel ab.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Verbrennt HIIT mehr Kalorien als normales Cardio?</h4>
          <p class="text-text-secondary mt-1">HIIT verbrennt in derselben Zeit mehr Kalorien als moderates Cardio und erhöht den Nachbrenneffekt (EPOC), wodurch der Körper noch Stunden nach dem Training erhöhten Kalorienverbrauch zeigt. In 20 Minuten HIIT kann man ähnlich viel wie in 40 Minuten Dauerlauf verbrennen.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist das Tabata-Protokoll?</h4>
          <p class="text-text-secondary mt-1">Das Tabata-Protokoll wurde 1996 von Dr. Izumi Tabata entwickelt: 8 Runden à 20 Sekunden maximale Belastung gefolgt von 10 Sekunden Pause – insgesamt 4 Minuten. Es ist besonders effektiv für die Verbesserung der maximalen Sauerstoffaufnahme (VO₂max).</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function fmtSek(s: number): string {
      const m = Math.floor(s / 60);
      const sec = Math.round(s % 60);
      if (m === 0) return sec + ' Sek.';
      return m + ' Min. ' + (sec > 0 ? sec + ' Sek.' : '');
    }
    function calcIT() {
      const work = parseInt((document.getElementById('it-work') as HTMLInputElement).value) || 0;
      const rest = parseInt((document.getElementById('it-rest') as HTMLInputElement).value) || 0;
      const rounds = parseInt((document.getElementById('it-rounds') as HTMLInputElement).value) || 0;
      const sets = parseInt((document.getElementById('it-sets') as HTMLInputElement).value) || 1;
      const setRest = parseInt((document.getElementById('it-setrest') as HTMLInputElement).value) || 0;
      const warmup = parseInt((document.getElementById('it-warmup') as HTMLInputElement).value) || 0;
      const perSet = rounds * (work + rest);
      const totalWork = rounds * sets * work;
      const totalRest = rounds * sets * rest;
      const setRestTotal = (sets - 1) * setRest;
      const warmupSec = warmup * 60;
      const total = warmupSec + sets * perSet + setRestTotal;
      const ratio = rest > 0 ? (work / rest).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ':1' : work + ':0';
      document.getElementById('it-result')!.textContent = fmtSek(total);
      document.getElementById('it-worktime')!.textContent = fmtSek(totalWork);
      document.getElementById('it-resttime')!.textContent = fmtSek(totalRest);
      document.getElementById('it-ratio')!.textContent = ratio;
      document.getElementById('it-total-rounds')!.textContent = (rounds * sets).toLocaleString('de-DE');
      const planLines = [];
      if (warmup > 0) planLines.push('Aufwärmen: ' + warmup + ' Min.');
      for (let i = 1; i <= sets; i++) {
        planLines.push('Satz ' + i + ': ' + rounds + ' × (' + work + ' Sek. Belastung / ' + rest + ' Sek. Pause) = ' + fmtSek(perSet));
        if (i < sets && setRest > 0) planLines.push('Satzpause: ' + fmtSek(setRest));
      }
      planLines.push('Gesamtdauer: ' + fmtSek(total));
      document.getElementById('it-plan')!.innerHTML = planLines.map(l => '<div>' + l + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.it-in').forEach(el => { el.addEventListener('input', calcIT); el.addEventListener('change', calcIT); });
      calcIT();
    }, 50);
  </script>
</CalculatorLayout>
