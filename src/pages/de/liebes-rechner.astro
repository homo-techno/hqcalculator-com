---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Liebesrechner – Liebeskompatibilität nach FLAMES berechnen";
const description = "Berechnen Sie die Liebeskompatibilität zwischen zwei Namen nach dem FLAMES-Prinzip. Nur zum Spaß!";

const relatedCalcs = [
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
  { name: "Makronährstoff Rechner", url: "/de/makro-rechner", description: "Nährstoffe berechnen." },
  { name: "Marathon Pace Rechner", url: "/de/marathon-pace-rechner", description: "Laufpace berechnen." },
];
---
<CalculatorLayout lang="de" enSlug="love-calculator" title={title} description={description} calculatorName="Liebesrechner" keywords="Liebesrechner, Liebeskompatibilität, FLAMES, Namensrechner, Partnerschaft" breadcrumbs={[{ name: "Liebesrechner", url: "/de/liebes-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Liebesrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Geben Sie zwei Namen ein und entdecken Sie Ihre Liebeskompatibilität – nur zum Spaß!</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Dein Name</label>
          <input type="text" id="lv-name1" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="Anna" maxlength="50">
        </div>
        <div class="text-center text-3xl">❤️</div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Partner / Partnerin</label>
          <input type="text" id="lv-name2" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="Max" maxlength="50">
        </div>
        <button id="lv-btn" class="w-full py-3 bg-primary text-white font-bold rounded-xl text-lg hover:bg-primary/90 transition-colors">Kompatibilität berechnen</button>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Kompatibilität</div>
          <div class="text-6xl font-extrabold font-mono" id="lv-result">–</div>
          <div class="text-blue-200 text-lg font-semibold mt-1" id="lv-label"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="font-semibold text-sm text-text mb-1">FLAMES Ergebnis</div>
          <div class="text-lg font-bold" id="lv-flames">–</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-xs text-text mb-2 uppercase">Berechnung</h3>
          <div class="text-xs text-text-muted" id="lv-explain">–</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="love" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wie funktioniert der FLAMES-Liebesrechner?</h2>
      <p>FLAMES steht für Friends (Freunde), Love (Liebe), Affection (Zuneigung), Marriage (Heirat), Enemies (Feinde) und Siblings (Geschwister). Die Methode: Gemeinsame Buchstaben werden aus beiden Namen gestrichen. Die verbleibende Buchstanzahl wird genutzt, um im FLAMES-Kreis Buchstaben zu eliminieren, bis nur einer übrig bleibt. Dieser Buchstabe gibt die Beziehungsart an. Alles natürlich rein zum Spaß und ohne wissenschaftliche Grundlage!</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Ist der Liebesrechner wissenschaftlich?</h3>
      <p>Nein, dieser Rechner dient ausschließlich der Unterhaltung. Die Liebeskompatibilität basiert auf zufälligen Buchstabenberechnungen und hat keine wissenschaftliche Grundlage.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Kann ich Vornamen und Nachnamen eingeben?</h3>
      <p>Ja, Sie können beliebige Namen eingeben. Das Ergebnis ändert sich je nachdem, ob Sie Vornamen, vollständige Namen oder Spitznamen verwenden.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Warum unterscheidet sich das Ergebnis von anderen Liebesrechnern?</h3>
      <p>Es gibt verschiedene Algorithmen für Liebesrechner. Unser Rechner verwendet die klassische FLAMES-Methode mit Groß-/Kleinschreibungsignorierung.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const flamesLabels: Record<string, string> = {
      F: 'Freunde', L: 'Liebe', A: 'Zuneigung', M: 'Heirat', E: 'Feinde', S: 'Geschwister'
    };
    const flamesEmoji: Record<string, string> = {
      F: '🤝', L: '💑', A: '🥰', M: '💍', E: '😤', S: '👫'
    };
    function loveScore(n1: string, n2: string): number {
      const combined = (n1 + n2).toLowerCase().replace(/[^a-z]/g, '');
      let hash = 0;
      for (let i = 0; i < combined.length; i++) { hash = (hash * 31 + combined.charCodeAt(i)) % 100; }
      return Math.abs(hash) % 40 + 60;
    }
    function calcLove() {
      const n1 = (document.getElementById('lv-name1') as HTMLInputElement).value.trim();
      const n2 = (document.getElementById('lv-name2') as HTMLInputElement).value.trim();
      if (!n1 || !n2) return;
      const score = loveScore(n1, n2);
      const a1 = n1.toLowerCase().replace(/[^a-z]/g, '');
      const a2 = n2.toLowerCase().replace(/[^a-z]/g, '');
      let arr1 = a1.split('');
      let arr2 = a2.split('');
      let removed = 0;
      for (const ch of arr1) {
        const idx = arr2.indexOf(ch);
        if (idx !== -1) { arr2.splice(idx, 1); removed++; }
      }
      for (const ch of arr2) {
        const idx2 = arr1.indexOf(ch);
        if (idx2 !== -1) { arr1.splice(idx2, 1); removed++; }
      }
      const remaining = a1.length + a2.length - removed * 2;
      const flames = ['F', 'L', 'A', 'M', 'E', 'S'];
      let flamesArr = [...flames];
      let idx = 0;
      while (flamesArr.length > 1) {
        idx = (idx + remaining - 1) % flamesArr.length;
        flamesArr.splice(idx, 1);
        if (idx >= flamesArr.length) idx = 0;
      }
      const flamesResult = flamesArr[0];
      document.getElementById('lv-result')!.textContent = score + ' %';
      document.getElementById('lv-label')!.textContent = score >= 90 ? 'Perfektes Match!' : score >= 75 ? 'Sehr gut!' : score >= 60 ? 'Gute Chancen' : 'Ausbaufähig';
      document.getElementById('lv-flames')!.textContent = flamesEmoji[flamesResult] + ' ' + flamesLabels[flamesResult];
      document.getElementById('lv-explain')!.textContent = 'Gemeinsame Buchstaben: ' + removed + ' | Verbleibend: ' + remaining + ' | FLAMES-Index: ' + remaining;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('lv-btn')!.addEventListener('click', calcLove);
      document.getElementById('lv-name1')!.addEventListener('keyup', (e) => { if (e.key === 'Enter') calcLove(); });
      document.getElementById('lv-name2')!.addEventListener('keyup', (e) => { if (e.key === 'Enter') calcLove(); });
      calcLove();
    }, 50);
  </script>
</CalculatorLayout>
