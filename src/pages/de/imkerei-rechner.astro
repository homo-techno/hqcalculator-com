---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Imkereirechner - Bienenst\u00f6cke, Honigertrag & Einnahmen";
const description = "Berechnen Sie Bienenstockanzahl, Honigertrag pro Stock, Ausstattungskosten, Einnahmen und Koloniemanagement-Zeitplan f\u00fcr Imkereibetriebe.";
const relatedCalcs = [
  { name: "Eierproduktions-Rechner", url: "/egg-production-calculator", description: "Eierproduktionssch\u00e4tzung." },
  { name: "Gew\u00e4chshaus-Rechner", url: "/greenhouse-calculator", description: "Gew\u00e4chshausgr\u00f6\u00dfe und -kosten." },
  { name: "Pflanzabstand-Rechner", url: "/garden-spacing-calculator", description: "Pflanzabst\u00e4nde." },
  { name: "Budget-Rechner", url: "/budget-calculator", description: "Budgetplanung." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozentberechnungen." },
  { name: "Lebensmittelkosten-Rechner", url: "/food-cost-calculator", description: "Lebensmittelkosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Imkereirechner" lang="de" keywords="imkerei rechner, honigertrag, bienenstockanzahl, imkerei kosten, koloniemanagement, imkerei einnahmen" breadcrumbs={[{ name: "Imkereirechner", url: "/de/imkerei-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Imkereirechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Imkerei mit Bienenstockanzahl, Honigertragsch&auml;tzungen und Rentabilit&auml;tsanalyse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Bienenst&ouml;cke</label><input type="number" id="bk-hives" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" min="1" max="500" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Region/Trachtqualit&auml;t</label>
            <select id="bk-region" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="35">Ausgezeichnete Tracht (35 kg/Stock)</option>
              <option value="25" selected>Gute Tracht (25 kg/Stock)</option>
              <option value="18">Durchschnittliche Tracht (18 kg/Stock)</option>
              <option value="10">Schwache Tracht (10 kg/Stock)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Beute-Einrichtungskosten (&euro;)</label><input type="number" id="bk-setup" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="0" step="25"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Bienenvolk-Kosten (&euro;)</label><input type="number" id="bk-bees" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="0" step="10"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Wartung/Stock (&euro;)</label><input type="number" id="bk-maint" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="0" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Winterverlustrate (%)</label><input type="number" id="bk-loss" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="80" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Honigpreis (&euro;/kg)</label><input type="number" id="bk-price" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Wachs/Produkte-Einnahmen/Stock (&euro;)</label><input type="number" id="bk-wax" class="bk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="0" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">J&auml;hrlicher Nettogewinn</div>
          <div class="text-5xl font-extrabold font-mono" id="bk-profit">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Honig gesamt (kg)</div><div class="text-xl font-bold font-mono" id="bk-honey">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bruttoerl&ouml;s</div><div class="text-xl font-bold font-mono" id="bk-revenue">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Startkosten</div><div class="text-xl font-bold font-mono" id="bk-startup">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Kosten</div><div class="text-xl font-bold font-mono" id="bk-annual">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erl&ouml;s/Stock</div><div class="text-xl font-bold font-mono" id="bk-perhive">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">St&ouml;cke nach Winter</div><div class="text-xl font-bold font-mono" id="bk-surviving">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="beekeeping" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBK() {
      const hives = parseInt((document.getElementById('bk-hives') as HTMLInputElement).value) || 5;
      const yieldPerHive = parseFloat((document.getElementById('bk-region') as HTMLSelectElement).value) || 25;
      const setupCost = parseFloat((document.getElementById('bk-setup') as HTMLInputElement).value) || 0;
      const beeCost = parseFloat((document.getElementById('bk-bees') as HTMLInputElement).value) || 0;
      const maintCost = parseFloat((document.getElementById('bk-maint') as HTMLInputElement).value) || 0;
      const lossRate = parseFloat((document.getElementById('bk-loss') as HTMLInputElement).value) || 0;
      const honeyPrice = parseFloat((document.getElementById('bk-price') as HTMLInputElement).value) || 0;
      const waxRevenue = parseFloat((document.getElementById('bk-wax') as HTMLInputElement).value) || 0;
      const totalHoney = hives * yieldPerHive;
      const honeyRevenue = totalHoney * honeyPrice;
      const waxTotal = hives * waxRevenue;
      const grossRevenue = honeyRevenue + waxTotal;
      const startupTotal = hives * (setupCost + beeCost);
      const annualMaint = hives * maintCost;
      const replacementHives = Math.ceil(hives * (lossRate / 100));
      const replacementCost = replacementHives * beeCost;
      const totalAnnualCost = annualMaint + replacementCost;
      const netProfit = grossRevenue - totalAnnualCost;
      const revenuePerHive = grossRevenue / hives;
      const survivingHives = hives - replacementHives;
      const fmtEur = (v: number) => Math.abs(Math.round(v)).toLocaleString('de-DE') + ' \u20ac';
      document.getElementById('bk-profit')!.textContent = (netProfit >= 0 ? '' : '-') + fmtEur(netProfit);
      document.getElementById('bk-honey')!.textContent = Math.round(totalHoney).toLocaleString('de-DE');
      document.getElementById('bk-revenue')!.textContent = fmtEur(grossRevenue);
      document.getElementById('bk-startup')!.textContent = fmtEur(startupTotal);
      document.getElementById('bk-annual')!.textContent = fmtEur(totalAnnualCost);
      document.getElementById('bk-perhive')!.textContent = fmtEur(revenuePerHive);
      document.getElementById('bk-surviving')!.textContent = survivingHives.toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bk-in').forEach(el => { el.addEventListener('input', calcBK); el.addEventListener('change', calcBK); });
      calcBK();
    }, 50);
  </script>
</CalculatorLayout>
