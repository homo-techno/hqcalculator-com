---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Stromverbrauch-Rechner - Energiekosten pro Ger\u00e4t berechnen";
const description = "Berechnen Sie die Stromkosten f\u00fcr jedes Ger\u00e4t. Geben Sie Leistung, t\u00e4gliche Nutzungsstunden und Ihren Strompreis ein, um t\u00e4gliche, monatliche und j\u00e4hrliche Kosten zu sehen.";

const relatedCalcs = [
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten umrechnen." },
  { name: "Energieaudit-Rechner", url: "/de/energieaudit-rechner", description: "Energieeffizienz bewerten." },
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notgroschen planen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "Abschreibung berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Stromverbrauch-Rechner" lang="de" enSlug="electricity-usage-calculator" keywords="stromverbrauch rechner, energiekosten, watt kosten, kwh rechner, stromkosten berechnen" breadcrumbs={[{ name: "Stromverbrauch-Rechner", url: "/de/stromverbrauch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stromverbrauch-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Kosten f&uuml;r den Betrieb eines Ger&auml;ts basierend auf Leistung, Nutzungsstunden und Ihrem Strompreis.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label for="svr-preset" class="block text-sm font-medium text-text mb-1">Typische Ger&auml;te (oder unten eigene Werte eingeben)</label>
          <select id="svr-preset" class="svr-in w-full border border-border rounded-lg px-3 py-2">
            <option value="">Eigene Eingabe</option>
            <option value="10">LED-Gl&uuml;hbirne (10W, ersetzt 60W)</option>
            <option value="1500">Heizl&uuml;fter (1.500W)</option>
            <option value="1200">F&ouml;hn (1.200W)</option>
            <option value="150">K&uuml;hlschrank (150W Durchschnitt)</option>
            <option value="2000">Backofen (2.000W)</option>
            <option value="500">Waschmaschine (500W)</option>
            <option value="3000">W&auml;schetrockner (3.000W)</option>
            <option value="100">Desktop-PC (100W)</option>
            <option value="50">Laptop (50W)</option>
            <option value="200">Fernseher 55 Zoll (200W)</option>
            <option value="1000">Geschirrsp&uuml;ler (1.000W)</option>
            <option value="3500">Klimaanlage zentral (3.500W)</option>
          </select>
        </div>
        <div>
          <label for="svr-watts" class="block text-sm font-medium text-text mb-1">Leistung (W)</label>
          <input type="number" id="svr-watts" class="svr-in w-full border border-border rounded-lg px-3 py-2" value="1500" min="0" step="10" />
        </div>
        <div>
          <label for="svr-hours" class="block text-sm font-medium text-text mb-1">Nutzungsstunden pro Tag</label>
          <input type="number" id="svr-hours" class="svr-in w-full border border-border rounded-lg px-3 py-2" value="4" min="0" max="24" step="0.5" />
        </div>
        <div>
          <label for="svr-rate" class="block text-sm font-medium text-text mb-1">Strompreis (&euro;/kWh)</label>
          <input type="number" id="svr-rate" class="svr-in w-full border border-border rounded-lg px-3 py-2" value="0.35" min="0" step="0.01" />
          <p class="text-xs text-text-muted mt-1">Deutscher Durchschnitt: ca. 0,35 &euro;/kWh. Pr&uuml;fen Sie Ihre Stromrechnung.</p>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Monatliche Kosten</div>
          <div class="text-5xl font-extrabold font-mono" id="svr-result">0,00 &euro;</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">T&auml;gliche Kosten</div>
            <div class="text-xl font-bold" id="svr-daily">0,00 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">J&auml;hrliche Kosten</div>
            <div class="text-xl font-bold" id="svr-annual">0,00 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">T&auml;gliche kWh</div>
            <div class="text-xl font-bold" id="svr-kwh-daily">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Monatliche kWh</div>
            <div class="text-xl font-bold" id="svr-kwh-monthly">0</div>
          </div>
        </div>
      </div>

      <ShareButton calculatorId="electricity-usage-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Stromverbrauch verstehen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>T&auml;gliche kWh:</strong> Leistung (W) &times; Stunden / 1.000</p>
        <p><strong>Monatliche Kosten:</strong> kWh/Tag &times; 30,44 &times; Strompreis</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie finde ich den Strompreis?</strong> Der aktuelle Strompreis steht auf Ihrer letzten Stromrechnung oder auf der Website Ihres Energieversorgers. Der deutsche Durchschnitt liegt bei ca. 0,35 &euro;/kWh.</p>
      <p><strong>Wie kann ich Strom sparen?</strong> Verwenden Sie LED-Beleuchtung, EnergieeffizienzklasseA-Ger&auml;te und schalten Sie Ger&auml;te bei Nichtgebrauch vollst&auml;ndig aus (kein Standby).</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSVR() {
      const watts = parseFloat((document.getElementById('svr-watts') as HTMLInputElement).value) || 0;
      const hours = parseFloat((document.getElementById('svr-hours') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('svr-rate') as HTMLInputElement).value) || 0;

      const dailyKwh = (watts * hours) / 1000;
      const monthlyKwh = dailyKwh * 30.44;
      const annualKwh = dailyKwh * 365;

      const dailyCost = dailyKwh * rate;
      const monthlyCost = monthlyKwh * rate;
      const annualCost = annualKwh * rate;

      const fmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

      (document.getElementById('svr-result') as HTMLElement).textContent = fmt(monthlyCost);
      (document.getElementById('svr-daily') as HTMLElement).textContent = fmt(dailyCost);
      (document.getElementById('svr-annual') as HTMLElement).textContent = fmt(annualCost);
      (document.getElementById('svr-kwh-daily') as HTMLElement).textContent = dailyKwh.toLocaleString('de-DE', { maximumFractionDigits: 2 });
      (document.getElementById('svr-kwh-monthly') as HTMLElement).textContent = monthlyKwh.toLocaleString('de-DE', { maximumFractionDigits: 1 });

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('svr-preset') as HTMLSelectElement).addEventListener('change', function() {
        const val = this.value;
        if (val) {
          (document.getElementById('svr-watts') as HTMLInputElement).value = val;
          calcSVR();
        }
      });

      document.querySelectorAll('.svr-in').forEach(el => {
        el.addEventListener('input', calcSVR);
        el.addEventListener('change', calcSVR);
      });
      calcSVR();
    }, 50);
  </script>
</CalculatorLayout>
