---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Auslastungsgrad Rechner – Kapazitätsnutzung berechnen";
const description = "Berechnen Sie den Auslastungsgrad und die Kapazitätsnutzung für Maschinen, Systeme und Produktionsanlagen. Mit OEE-Analyse.";
const relatedCalcs = [
  { name: "Tragwand Rechner", url: "/de/tragwand-rechner", description: "Strukturbelastung." },
  { name: "Linearantrieb Rechner", url: "/de/linearantrieb-rechner", description: "Maschinen." },
  { name: "Linkbudget Rechner", url: "/de/linkbudget-rechner", description: "Systemanalyse." },
  { name: "Logarithmus Rechner", url: "/de/logarithmus-rechner", description: "Logarithmen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="load-factor-calculator" calculatorName="Auslastungsgrad Rechner" keywords="Auslastungsgrad, Kapazitätsnutzung, OEE, Maschinenauslastung, Produktionseffizienz" breadcrumbs={[{ name: "Auslastungsgrad Rechner", url: "/de/auslastungsgrad-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Auslastungsgrad Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Auslastungsgrad, Kapazitätsreserve und OEE (Overall Equipment Effectiveness) für Maschinen und Systeme.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="aul-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="basic">Grundauslastung</button>
          <button class="aul-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="oee">OEE Analyse</button>
        </div>
        <div id="aul-panel-basic" class="space-y-3">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Tatsächliche Leistung</label>
              <input type="number" id="aul-ist" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="750" step="10" min="0">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Maximale Kapazität</label>
              <input type="number" id="aul-max" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" step="10" min="1">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="aul-unit" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="Stück/h">Stück/h</option>
              <option value="kW" selected>kW (Leistung)</option>
              <option value="m³/h">m³/h (Durchsatz)</option>
              <option value="Aufträge/Tag">Aufträge/Tag</option>
            </select>
          </div>
        </div>
        <div id="aul-panel-oee" class="space-y-3 hidden">
          <p class="text-xs text-text-muted">OEE = Verfügbarkeit × Leistungsgrad × Qualitätsrate</p>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Verfügbarkeit (%)</label>
              <input type="number" id="aul-verf" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="90" step="1" min="0" max="100">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Leistungsgrad (%)</label>
              <input type="number" id="aul-leist" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="85" step="1" min="0" max="100">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Qualitätsrate (%)</label>
              <input type="number" id="aul-qual" class="w-full px-3 py-2 border border-border rounded-xl text-base font-bold text-center" value="95" step="1" min="0" max="100">
            </div>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="aul-label">Auslastungsgrad</div>
          <div class="text-5xl font-extrabold font-mono" id="aul-result">0 %</div>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-4">
          <div id="aul-bar" class="h-4 rounded-full bg-primary transition-all duration-500" style="width: 0%"></div>
        </div>
        <div class="grid grid-cols-3 gap-3" id="aul-details"></div>
        <div id="aul-bewertung" class="p-3 rounded-xl text-sm font-semibold text-center"></div>
      </div>
      <ShareButton lang="de" calculatorId="auslastungsgrad" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Auslastungsgrad und OEE in der Produktion</h2>
      <p>Der Auslastungsgrad (Kapazitätsnutzungsgrad) beschreibt das Verhältnis von tatsächlicher Leistung zur maximal möglichen Kapazität. Die OEE (Overall Equipment Effectiveness) ist eine Kennzahl der Produktionswirtschaft, die Verfügbarkeit, Leistungsgrad und Qualitätsrate kombiniert. Ein OEE von 85 % gilt als Weltklasse-Niveau, 65–85 % als typisch für die Industrie.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist ein guter Auslastungsgrad?</summary>
          <p class="mt-2 text-sm text-text-secondary">Optimal sind 70–90 % Auslastung. Unter 70 % deutet auf Unterauslastung hin (hohe Fixkosten pro Einheit). Über 90 % erhöht das Risiko von Engpässen und Stillständen durch fehlende Wartungszeit.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was bedeutet OEE?</summary>
          <p class="mt-2 text-sm text-text-secondary">OEE (Overall Equipment Effectiveness / Gesamtanlageneffektivität) misst die Produktivität einer Anlage: OEE = Verfügbarkeit × Leistungsgrad × Qualitätsrate. Ein OEE von 100 % bedeutet, die Anlage läuft immer, mit voller Geschwindigkeit und ohne Ausschuss.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie steigere ich den Auslastungsgrad?</summary>
          <p class="mt-2 text-sm text-text-secondary">Durch Auftragsplanung, Engpassanalyse und Lean-Methoden (z.B. SMED für kurze Rüstzeiten). Präventive Wartung erhöht die Verfügbarkeit. Qualitätssicherung reduziert Ausschuss und damit Nacharbeit.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen Auslastung und Utilization?</summary>
          <p class="mt-2 text-sm text-text-secondary">Auslastungsgrad = Ist-Leistung / Kapazität × 100. Utilization (Nutzungsgrad) bezieht sich oft speziell auf die Betriebszeit im Verhältnis zur verfügbaren Zeit, ohne Qualitätsverluste zu berücksichtigen.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let aulMode = 'basic';
    function setAulMode(m: string) {
      aulMode = m;
      document.querySelectorAll('.aul-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = `aul-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ${active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted'}`;
      });
      document.getElementById('aul-panel-basic')!.classList.toggle('hidden', m !== 'basic');
      document.getElementById('aul-panel-oee')!.classList.toggle('hidden', m !== 'oee');
      calcAul();
    }
    function calcAul() {
      let prozent = 0;
      const fmt = (v: number, u: string, d = 1) => v.toLocaleString('de-DE', { maximumFractionDigits: d }) + ' ' + u;
      if (aulMode === 'basic') {
        const ist = parseFloat((document.getElementById('aul-ist') as HTMLInputElement).value) || 0;
        const max = parseFloat((document.getElementById('aul-max') as HTMLInputElement).value) || 1;
        const unit = (document.getElementById('aul-unit') as HTMLSelectElement).value;
        prozent = Math.min((ist / max) * 100, 200);
        document.getElementById('aul-label')!.textContent = 'Auslastungsgrad';
        document.getElementById('aul-result')!.textContent = fmt(prozent, '%');
        document.getElementById('aul-details')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ist-Leistung</div><div class="text-lg font-bold font-mono">${fmt(ist, unit, 0)}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kapazität</div><div class="text-lg font-bold font-mono">${fmt(max, unit, 0)}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reserve</div><div class="text-lg font-bold font-mono">${fmt(Math.max(0, max - ist), unit, 0)}</div></div>`;
      } else {
        const v = parseFloat((document.getElementById('aul-verf') as HTMLInputElement).value) / 100 || 0;
        const l = parseFloat((document.getElementById('aul-leist') as HTMLInputElement).value) / 100 || 0;
        const q = parseFloat((document.getElementById('aul-qual') as HTMLInputElement).value) / 100 || 0;
        const oee = v * l * q * 100;
        prozent = oee;
        document.getElementById('aul-label')!.textContent = 'OEE';
        document.getElementById('aul-result')!.textContent = fmt(oee, '%');
        document.getElementById('aul-details')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verfügbarkeit</div><div class="text-lg font-bold font-mono">${fmt(v * 100, '%')}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leistungsgrad</div><div class="text-lg font-bold font-mono">${fmt(l * 100, '%')}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Qualitätsrate</div><div class="text-lg font-bold font-mono">${fmt(q * 100, '%')}</div></div>`;
      }

      const clampedPct = Math.min(prozent, 100);
      document.getElementById('aul-bar')!.style.width = clampedPct + '%';
      const bew = document.getElementById('aul-bewertung')!;
      if (prozent >= 85) {
        bew.className = 'p-3 rounded-xl text-sm font-semibold text-center bg-green-100 text-green-800 border border-green-300';
        bew.textContent = 'Weltklasse-Niveau – sehr gute Kapazitätsnutzung.';
      } else if (prozent >= 65) {
        bew.className = 'p-3 rounded-xl text-sm font-semibold text-center bg-blue-100 text-blue-800 border border-blue-300';
        bew.textContent = 'Typisch für die Industrie – Verbesserungspotenzial vorhanden.';
      } else if (prozent >= 40) {
        bew.className = 'p-3 rounded-xl text-sm font-semibold text-center bg-yellow-100 text-yellow-800 border border-yellow-300';
        bew.textContent = 'Unterauslastung – erhebliches Optimierungspotenzial.';
      } else {
        bew.className = 'p-3 rounded-xl text-sm font-semibold text-center bg-red-100 text-red-800 border border-red-300';
        bew.textContent = 'Kritisch niedrige Auslastung – sofortige Maßnahmen empfohlen.';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.aul-mode').forEach(b => b.addEventListener('click', () => setAulMode((b as HTMLButtonElement).dataset.mode!)));
      ['aul-ist','aul-max','aul-verf','aul-leist','aul-qual'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', calcAul);
      });
      document.getElementById('aul-unit')!.addEventListener('change', calcAul);
      calcAul();
    }, 50);
  </script>
</CalculatorLayout>
