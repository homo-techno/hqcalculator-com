---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Doppler-Effekt-Rechner - Beobachtete Frequenz berechnen 2026";
const description = "Berechne die beobachtete Frequenz durch den Doppler-Effekt fuer Schall- oder Lichtquellen in relativer Bewegung.";

const relatedCalcs = [
  { name: "Wellenlaengen-Rechner", url: "/de/wellenlaengen-rechner", description: "Wellenlaenge berechnen." },
  { name: "Frequenz-Rechner", url: "/de/frequenz-rechner", description: "Frequenzberechnung." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Dezibel-Rechner", url: "/de/dezibel-rechner", description: "Lautstaerke." },
  { name: "Wissenschaftliche Notation", url: "/de/wissenschaftliche-notation-rechner", description: "Notation." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Doppler-Effekt-Rechner" keywords="Doppler-Effekt, Frequenzverschiebung, Doppler-Verschiebung, Schall Doppler, beobachtete Frequenz" breadcrumbs={[{ name: "Doppler-Effekt", url: "/de/doppler-effekt-rechner" }]} lang="de" enSlug="doppler-effect-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Doppler-Effekt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne, wie Bewegung die beobachtete Frequenz veraendert.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Quellfrequenz (Hz)</label><input type="number" id="dpde-fs" class="dpde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="440" min="1" step="1"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Quellgeschwindigkeit (m/s)</label><input type="number" id="dpde-vs" class="dpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Beobachtergeschw. (m/s)</label><input type="number" id="dpde-vo" class="dpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Richtung der Quelle</label>
            <select id="dpde-sd" class="dpde-in w-full px-4 py-3 border border-border rounded-xl text-sm font-bold">
              <option value="toward">Naehert sich</option>
              <option value="away">Entfernt sich</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Schallgeschwindigkeit (m/s)</label><input type="number" id="dpde-c" class="dpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="343" min="1" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Beobachtete Frequenz</div>
          <div class="text-5xl font-extrabold font-mono" id="dpde-result">0 Hz</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschiebung</div><div class="text-xl font-bold font-mono" id="dpde-shift">0 Hz</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">% Aenderung</div><div class="text-xl font-bold font-mono" id="dpde-pct">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wellenlaenge</div><div class="text-xl font-bold font-mono" id="dpde-wl">0 m</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Formel</h3>
          <div class="text-xs font-mono" id="dpde-formula">f' = f &times; (v &plusmn; v&#x2092;) / (v &mp; v&#x209B;)</div>
        </div>
      </div>
      <ShareButton calculatorId="doppler-effect" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Der Doppler-Effekt erklaert</h2>
      <p>Der Doppler-Effekt beschreibt die Aenderung der wahrgenommenen Frequenz einer Welle, wenn sich Quelle und Beobachter relativ zueinander bewegen. Bei Annaeherung wird die Frequenz hoeher (Ton wird hoeher), bei Entfernung wird sie niedriger.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wo begegnet uns der Doppler-Effekt im Alltag?</strong> Der haeufigste Fall ist das sich aendernde Geraeusch eines vorbeifahrenden Krankenwagens. Auch Radarmessungen der Polizei und medizinischer Ultraschall nutzen den Doppler-Effekt.</p>
      <p><strong>Gilt der Doppler-Effekt auch fuer Licht?</strong> Ja, bei Licht spricht man von Rot- und Blauverschiebung. Sich entfernende Galaxien zeigen eine Rotverschiebung.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDPDE() {
      const fs = parseFloat((document.getElementById('dpde-fs') as HTMLInputElement).value) || 440;
      const vs = parseFloat((document.getElementById('dpde-vs') as HTMLInputElement).value) || 0;
      const vo = parseFloat((document.getElementById('dpde-vo') as HTMLInputElement).value) || 0;
      const c = parseFloat((document.getElementById('dpde-c') as HTMLInputElement).value) || 343;
      const dir = (document.getElementById('dpde-sd') as HTMLSelectElement).value;
      let fo: number;
      if (dir === 'toward') {
        fo = fs * (c + vo) / (c - vs);
      } else {
        fo = fs * (c - vo) / (c + vs);
      }
      if (!isFinite(fo) || fo < 0) fo = 0;
      const shift = fo - fs;
      const pct = fs > 0 ? (shift / fs) * 100 : 0;
      const wl = fo > 0 ? c / fo : 0;
      document.getElementById('dpde-result')!.textContent = fo.toFixed(1).replace('.', ',') + ' Hz';
      document.getElementById('dpde-shift')!.textContent = (shift >= 0 ? '+' : '') + shift.toFixed(1).replace('.', ',') + ' Hz';
      document.getElementById('dpde-pct')!.textContent = (pct >= 0 ? '+' : '') + pct.toFixed(1).replace('.', ',') + '%';
      document.getElementById('dpde-wl')!.textContent = wl.toFixed(3).replace('.', ',') + ' m';
      document.getElementById('dpde-formula')!.textContent = "f' = " + fs + ' \u00D7 (' + c + ' ' + (dir === 'toward' ? '+' : '\u2212') + ' ' + vo + ') / (' + c + ' ' + (dir === 'toward' ? '\u2212' : '+') + ' ' + vs + ') = ' + fo.toFixed(1).replace('.', ',') + ' Hz';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dpde-in').forEach(el => { el.addEventListener('input', calcDPDE); el.addEventListener('change', calcDPDE); });
      calcDPDE();
    }, 50);
  </script>
</CalculatorLayout>
