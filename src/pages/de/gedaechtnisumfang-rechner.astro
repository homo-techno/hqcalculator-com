---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gedächtnisumfang Rechner - Arbeitsgedächtnis testen und auswerten";
const description = "Testen und berechnen Sie Ihren Arbeitsgedächtnis-Umfang. Erfahren Sie, wie viele Informationseinheiten Ihr Kurzzeitgedächtnis speichern kann – mit Interpretation.";
const relatedCalcs = [
  { name: "Mittelwert Rechner", url: "/de/mittelwert-rechner", description: "Statistische Auswertung." },
  { name: "Stoffwechselalter Rechner", url: "/de/stoffwechselalter-rechner", description: "Metabolisches Alter." },
  { name: "Zyklusrechner", url: "/de/zyklus-rechner", description: "Menstruationszyklus." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="memory-span-calculator" calculatorName="Gedächtnisumfang Rechner" keywords="Gedächtnisumfang Rechner, Arbeitsgedächtnis testen, Kurzzeitgedächtnis, Memory Span, Gedächtniskapazität" breadcrumbs={[{ name: "Gedächtnisumfang Rechner", url: "/de/gedaechtnisumfang-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gedächtnisumfang Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen und interpretieren Sie Ihren Gedächtnisumfang (Memory Span) – die Anzahl der Einheiten, die Ihr Arbeitsgedächtnis gleichzeitig halten kann.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Testart</label>
            <select id="gu-type" class="gu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="digits" selected>Zahlenspanne (Digits Forward)</option>
              <option value="letters">Buchstabenspanne</option>
              <option value="words">Wortspanne</option>
              <option value="backward">Rückwärtsspanne (Digits Backward)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Erreichte Spanne (Elemente)</label><input type="number" id="gu-span" class="gu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7" min="1" max="20"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Alter (Jahre)</label><input type="number" id="gu-age" class="gu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="5" max="100"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Korrekte Durchgänge</label>
            <input type="number" id="gu-correct" class="gu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" max="20">
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Gesamte Durchgänge</label><input type="number" id="gu-total" class="gu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="20"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gedächtnisumfang</div>
          <div class="text-5xl font-extrabold font-mono" id="gu-result">--</div>
          <div class="text-sm text-blue-200 mt-1" id="gu-rating">Elemente</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Trefferquote</div><div class="text-xl font-bold" id="gu-accuracy">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bewertung</div><div class="text-xl font-bold" id="gu-level">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-1">Interpretation</div>
          <div id="gu-interpret" class="text-sm text-text">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gedaechtnisumfang" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Das Arbeitsgedächtnis – Kapazität und Grenzen</h2>
      <p>Der Psychologe George Miller beschrieb 1956 die magische Zahl 7 ± 2 als Kapazitätsgrenze des Kurzzeitgedächtnisses. Neuere Forschungen von Nelson Cowan (2001) gehen von 4 ± 1 Chunks (Informationseinheiten) aus. Die Gedächtnisspanne variiert je nach Testart, Alter, Übung und Material. Vorwärts-Zahlenspannen von 7–8 gelten als durchschnittlich, Rückwärtsspannen sind typischerweise 1–2 Punkte niedriger.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist eine normale Zahlenspanne?</strong> Erwachsene haben im Durchschnitt eine Vorwärts-Zahlenspanne von 6–8 Ziffern. Rückwärts sind es meist 4–6.</p>
      <p><strong>Kann man den Gedächtnisumfang trainieren?</strong> Ja, durch regelmäßiges Training (z. B. N-Back-Aufgaben) kann das Arbeitsgedächtnis verbessert werden. Schlaf, Sport und mentale Aktivität helfen langfristig.</p>
      <p><strong>Was ist der Unterschied zwischen Kurz- und Langzeitgedächtnis?</strong> Das Kurzzeitgedächtnis (Arbeitsgedächtnis) hält Informationen für Sekunden bis Minuten, das Langzeitgedächtnis für Jahre oder ein Leben lang.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGU() {
      const type = (document.getElementById('gu-type') as HTMLSelectElement).value;
      const span = parseInt((document.getElementById('gu-span') as HTMLInputElement).value) || 0;
      const age = parseInt((document.getElementById('gu-age') as HTMLInputElement).value) || 30;
      const correct = parseInt((document.getElementById('gu-correct') as HTMLInputElement).value) || 0;
      const total = parseInt((document.getElementById('gu-total') as HTMLInputElement).value) || 1;
      const accuracy = Math.round((correct / total) * 100);
      let norm = { low: 5, avg: 7, high: 9 };
      if (type === 'backward') norm = { low: 3, avg: 5, high: 7 };
      else if (type === 'words') norm = { low: 4, avg: 6, high: 8 };
      else if (type === 'letters') norm = { low: 5, avg: 7, high: 9 };
      const ageAdj = age < 10 ? span - 1 : age > 60 ? span + 0.5 : 0;
      let level = 'Durchschnittlich';
      let color = 'text-blue-600';
      if (span >= norm.high) { level = 'Überdurchschnittlich'; color = 'text-green-600'; }
      else if (span < norm.low) { level = 'Unterdurchschnittlich'; color = 'text-red-600'; }
      const interpMap: Record<string, string> = {
        low: 'Ihre Gedächtnisspanne liegt unter dem Durchschnitt. Regelmäßiges Training und guter Schlaf können helfen, die Kapazität zu verbessern.',
        avg: 'Ihre Gedächtnisspanne liegt im normalen Bereich (Miller\'s Magische 7 ± 2). Dies ist typisch für gesunde Erwachsene.',
        high: 'Ausgezeichnet! Ihre Gedächtnisspanne liegt deutlich über dem Durchschnitt. Sie haben ein überdurchschnittlich leistungsfähiges Arbeitsgedächtnis.'
      };
      const interp = span >= norm.high ? interpMap.high : span < norm.low ? interpMap.low : interpMap.avg;
      const typeName: Record<string, string> = { digits: 'Zahlenspanne', letters: 'Buchstabenspanne', words: 'Wortspanne', backward: 'Rückwärtsspanne' };
      document.getElementById('gu-result')!.textContent = span.toString();
      document.getElementById('gu-rating')!.textContent = typeName[type] + ' (Normal: ' + norm.low + '–' + norm.high + ')';
      document.getElementById('gu-accuracy')!.textContent = accuracy + ' %';
      document.getElementById('gu-level')!.textContent = level;
      document.getElementById('gu-level')!.className = 'text-xl font-bold ' + color;
      document.getElementById('gu-interpret')!.textContent = interp;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gu-in').forEach(el => { el.addEventListener('input', calcGU); el.addEventListener('change', calcGU); });
      calcGU();
    }, 50);
  </script>
</CalculatorLayout>
