---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Dünger-Rechner - NPK-Ausbringungsrate";
const description = "Berechnen Sie die benötigte Düngermenge basierend auf Fläche, NPK-Verhältnis und Ausbringungsrate.";
const relatedCalcs = [
  { name: "Feldfläche-Rechner", url: "/de/feldflaeche-rechner", description: "Flächenberechnung." },
  { name: "Gärtemperatur-Rechner", url: "/de/gaertemperatur-rechner", description: "Temperatursteuerung." },
  { name: "Zaun-Rechner", url: "/de/zaun-rechner", description: "Zaun-Material." },
  { name: "Fastenrechner", url: "/de/fastenrechner", description: "Intervallfasten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Dünger-Rechner" lang="de" enSlug="fertilizer-calculator" keywords="dünger rechner, NPK verhältnis, dünger ausbringung, rasendünger, gartendünger, stickstoff phosphor kalium" breadcrumbs={[{ name: "Dünger-Rechner", url: "/de/duenger-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dünger-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Düngermenge basierend auf Fläche, NPK-Verhältnis und gewünschter Ausbringungsrate.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fläche (m&sup2;)</label><input type="number" id="drde-area" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" min="0" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gew. N-Rate (g N / m&sup2;)</label><input type="number" id="drde-rate" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0" step="0.5"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">N (Stickstoff %)</label><input type="number" id="drde-n" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="100" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">P (Phosphor %)</label><input type="number" id="drde-p" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="100" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">K (Kalium %)</label><input type="number" id="drde-k" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" max="100" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Dünger benötigt</div>
          <div class="text-5xl font-extrabold font-mono" id="drde-result">0 kg</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stickstoff aufgebracht</div><div class="text-xl font-bold font-mono" id="drde-napplied">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Phosphor aufgebracht</div><div class="text-xl font-bold font-mono" id="drde-papplied">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalium aufgebracht</div><div class="text-xl font-bold font-mono" id="drde-kapplied">0 kg</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro 100 m&sup2;</div><div class="text-xl font-bold font-mono" id="drde-per100">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Säcke (25 kg)</div><div class="text-xl font-bold font-mono" id="drde-bags">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="fertilizer-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dünger richtig berechnen</h2>
      <p>Die benötigte Düngermenge hängt vom NPK-Verhältnis und der gewünschten Nährstoffmenge ab. NPK steht für Stickstoff (N), Phosphor (P) und Kalium (K).</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was bedeutet NPK 10-10-10?</strong> Der Dünger enthält je 10% Stickstoff, Phosphor und Kalium. Die restlichen 70% sind Füllstoffe.</p>
      <p><strong>Wann sollte ich düngen?</strong> Am besten im Frühjahr und Herbst. Vermeiden Sie Düngung bei extremer Hitze oder Frost.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcDRDE() {
      const area = parseFloat((document.getElementById('drde-area') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('drde-rate') as HTMLInputElement).value) || 0;
      const nPct = parseFloat((document.getElementById('drde-n') as HTMLInputElement).value) || 0;
      const pPct = parseFloat((document.getElementById('drde-p') as HTMLInputElement).value) || 0;
      const kPct = parseFloat((document.getElementById('drde-k') as HTMLInputElement).value) || 0;
      const totalNg = area * rate;
      const totalNkg = totalNg / 1000;
      const fertNeeded = nPct > 0 ? totalNkg / (nPct / 100) : 0;
      const nApplied = fertNeeded * (nPct / 100);
      const pApplied = fertNeeded * (pPct / 100);
      const kApplied = fertNeeded * (kPct / 100);
      const per100 = area > 0 ? (fertNeeded / (area / 100)) : 0;
      const bags = Math.ceil(fertNeeded / 25);
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('drde-result')!.textContent = fmt(fertNeeded) + ' kg';
      document.getElementById('drde-napplied')!.textContent = fmt(nApplied) + ' kg';
      document.getElementById('drde-papplied')!.textContent = fmt(pApplied) + ' kg';
      document.getElementById('drde-kapplied')!.textContent = fmt(kApplied) + ' kg';
      document.getElementById('drde-per100')!.textContent = fmt(per100) + ' kg';
      document.getElementById('drde-bags')!.textContent = bags.toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.drde-in').forEach(el => { el.addEventListener('input', calcDRDE); el.addEventListener('change', calcDRDE); });
      calcDRDE();
    }, 50);
  </script>
</CalculatorLayout>
