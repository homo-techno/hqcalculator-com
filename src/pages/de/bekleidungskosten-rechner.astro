---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bekleidungskosten-Rechner - St\u00FCckkosten & Aufschlag";
const description = "Berechnen Sie Kosten pro Kleidungsst\u00FCck inkl. Stoff, Zubeh\u00F6r, Arbeit und Gemeinkosten. Ermitteln Sie Gro\u00DF- und Einzelhandelspreis, MOQ und Gewinnmargen.";
const relatedCalcs = [
  { name: "Gewinnmargen-Rechner", url: "/de/gewinnmargen-rechner", description: "Gewinnmarge." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
  { name: "Rabatt-Rechner", url: "/de/rabattrechner", description: "Rabatte." },
  { name: "Budget-Rechner", url: "/de/budgetrechner", description: "Budget." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Bekleidungskosten-Rechner" lang="de" enSlug="garment-cost-calculator" keywords="bekleidungskosten rechner, st\u00FCckkosten, gro\u00DFhandelspreis, einzelhandel aufschlag, moq, bekleidungsproduktion kosten" breadcrumbs={[{ name: "Bekleidungskosten", url: "/de/bekleidungskosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bekleidungskosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Gesamtkosten pro Kleidungsst&uuml;ck, Gro&szlig;handelspreis, Einzelhandelspreis und Gewinn pro Einheit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stoffkosten / Meter (&euro;)</label><input type="number" id="bkr-fabcost" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Meter pro Kleidungsst&uuml;ck</label><input type="number" id="bkr-yards" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2.5" min="0.25" step="0.25"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Zubeh&ouml;r & Kurzwaren (&euro;)</label><input type="number" id="bkr-trims" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" step="0.25"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Arbeitskosten / St&uuml;ck (&euro;)</label><input type="number" id="bkr-labor" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gemeinkosten / St&uuml;ck (&euro;)</label><input type="number" id="bkr-overhead" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Versand / St&uuml;ck (&euro;)</label><input type="number" id="bkr-ship" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" step="0.25"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gro&szlig;handels-Aufschlag %</label><input type="number" id="bkr-wmark" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" max="500" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einzelhandels-Aufschlag %</label><input type="number" id="bkr-rmark" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="0" max="1000" step="5"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Mindestbestellmenge (MOQ)</label><input type="number" id="bkr-moq" class="bkr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="1" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtkosten pro St&uuml;ck</div>
          <div class="text-4xl font-extrabold font-mono" id="bkr-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gro&szlig;handelspreis</div><div class="text-xl font-bold font-mono" id="bkr-wholesale">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einzelhandelspreis</div><div class="text-xl font-bold font-mono" id="bkr-retail">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einzelhandelsmarge</div><div class="text-xl font-bold font-mono" id="bkr-margin">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MOQ-Investition</div><div class="text-xl font-bold font-mono" id="bkr-moqcost">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MOQ-Umsatz (EH)</div><div class="text-xl font-bold font-mono" id="bkr-moqrev">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="garment-cost" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Bekleidungskalkulation</h2>
      <p>Die Gesamtkosten eines Kleidungsst&uuml;cks setzen sich aus Materialkosten, Arbeitskosten, Gemeinkosten und Versand zusammen. Der Gro&szlig;handelspreis liegt typischerweise beim 2-fachen der Kosten, der Einzelhandelspreis beim 2,5-fachen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist eine typische Gewinnmarge?</strong> Im Einzelhandel sind 50-60% Marge &uuml;blich, im Gro&szlig;handel 30-50%.</p>
      <p><strong>Was bedeutet MOQ?</strong> Die Mindestbestellmenge (Minimum Order Quantity) ist die kleinste Menge, die ein Hersteller produziert.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcBKR() {
      const fabCost = parseFloat((document.getElementById('bkr-fabcost') as HTMLInputElement).value) || 0;
      const yards = parseFloat((document.getElementById('bkr-yards') as HTMLInputElement).value) || 0;
      const trims = parseFloat((document.getElementById('bkr-trims') as HTMLInputElement).value) || 0;
      const labor = parseFloat((document.getElementById('bkr-labor') as HTMLInputElement).value) || 0;
      const overhead = parseFloat((document.getElementById('bkr-overhead') as HTMLInputElement).value) || 0;
      const ship = parseFloat((document.getElementById('bkr-ship') as HTMLInputElement).value) || 0;
      const wmark = parseFloat((document.getElementById('bkr-wmark') as HTMLInputElement).value) || 0;
      const rmark = parseFloat((document.getElementById('bkr-rmark') as HTMLInputElement).value) || 0;
      const moq = parseInt((document.getElementById('bkr-moq') as HTMLInputElement).value) || 1;
      const materialCost = (fabCost * yards) + trims;
      const totalCost = materialCost + labor + overhead + ship;
      const wholesale = totalCost * (1 + wmark / 100);
      const retail = totalCost * (1 + rmark / 100);
      const retailMargin = ((retail - totalCost) / retail * 100);
      const moqInvestment = totalCost * moq;
      const moqRevenue = retail * moq;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('bkr-result')!.textContent = fmt(totalCost) + ' \u20AC';
      document.getElementById('bkr-wholesale')!.textContent = fmt(wholesale) + ' \u20AC';
      document.getElementById('bkr-retail')!.textContent = fmt(retail) + ' \u20AC';
      document.getElementById('bkr-margin')!.textContent = retailMargin.toFixed(1) + '%';
      document.getElementById('bkr-moqcost')!.textContent = moqInvestment.toLocaleString('de-DE', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' \u20AC';
      document.getElementById('bkr-moqrev')!.textContent = moqRevenue.toLocaleString('de-DE', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bkr-in').forEach(el => { el.addEventListener('input', calcBKR); el.addEventListener('change', calcBKR); });
      calcBKR();
    }, 50);
  </script>
</CalculatorLayout>
