---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Gepäckgewicht Rechner – Freigepäck & Übergepäck Kosten";
const description = "Berechnen Sie Gepäckgewicht und prüfen Sie Freigepäckgrenzen der Fluggesellschaften. Überschreitungsgebühren auf einen Blick.";

const relatedCalcs = [
  { name: "Maßstabsrechner", url: "/de/massstab-rechner", description: "Maßstäbe umrechnen." },
  { name: "Marathon Pace Rechner", url: "/de/marathon-pace-rechner", description: "Laufzeiten." },
  { name: "Ahornsirup Rechner", url: "/de/ahornsirup-rechner", description: "Rezeptmengen." },
];
---
<CalculatorLayout lang="de" enSlug="luggage-weight-calculator" title={title} description={description} calculatorName="Gepäckgewicht Rechner" keywords="Gepäckgewicht Rechner, Freigepäck, Übergepäck Kosten, Koffer Gewicht, Airline Gepäck" breadcrumbs={[{ name: "Gepäckgewicht Rechner", url: "/de/gepaeckgewicht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gepäckgewicht Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Prüfen Sie, ob Ihr Gepäck im Rahmen der Freigepäckgrenze liegt, und berechnen Sie eventuelle Mehrkosten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Fluggesellschaft / Freigepäckgrenze (kg)</label>
          <select id="gp-airline" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="20">Lufthansa Economy – 23 kg</option>
            <option value="23" selected>Standard Economy – 23 kg</option>
            <option value="30">Business Class – 30 kg</option>
            <option value="32">First Class – 32 kg</option>
            <option value="15">Ryanair – 20 kg (aufgegebenes)</option>
            <option value="20">EasyJet – 23 kg</option>
            <option value="custom">Benutzerdefiniert</option>
          </select>
        </div>
        <div id="gp-custom-limit" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Eigene Grenze (kg)</label>
          <input type="number" id="gp-limit" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="23" step="0.5" min="1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Aktuelles Gepäckgewicht (kg)</label>
          <input type="number" id="gp-gewicht" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="21.5" step="0.1" min="0">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Übergepäck-Gebühr (€ pro kg, optional)</label>
          <input type="number" id="gp-fee" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="15" step="1" min="0">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Status</div>
          <div class="text-3xl font-extrabold font-mono" id="gp-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="gp-sub">–</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ihr Gewicht</div>
            <div class="text-xl font-bold font-mono" id="gp-yours">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Freigepäck</div>
            <div class="text-xl font-bold font-mono" id="gp-free">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mehrkosten</div>
            <div class="text-xl font-bold font-mono" id="gp-cost">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="luggage-weight" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Freigepäck beim Fliegen</h2>
      <p>Das Freigepäck variiert je nach Fluggesellschaft, Buchungsklasse und Reiseroute. Bei Intercontinental-Flügen ist oft mehr Gepäck inklusive als bei Europäischen Kurzstreckenflügen. Billigfluggesellschaften wie Ryanair oder EasyJet verlangen häufig Aufpreis auch für aufzugebendes Gepäck.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Was kostet Übergepäck?</h3>
      <p>Die Kosten für Übergepäck variieren stark: Bei Ryanair können es bis zu 50 € pro Kilogramm am Flughafen sein, bei Lufthansa etwa 15–20 € pro kg. Es lohnt sich immer, Übergepäck online vorab zu buchen.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Zählt das Handgepäck zum Freigepäck?</h3>
      <p>Nein, Handgepäck (in die Kabine mitgenommenes Gepäck) hat eigene Gewichts- und Maßbeschränkungen und wird getrennt vom aufzugebenden Gepäck berechnet.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wie viel wiegt ein leerer Koffer?</h3>
      <p>Kabinentrolley: 2–4 kg, mittelgroßer Reisekoffer: 3–5 kg, großer Reisekoffer: 4–7 kg. Das Koffergewicht unbedingt beim Packen einkalkulieren!</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was passiert, wenn mein Gepäck zu schwer ist?</h3>
      <p>Am Flughafen-Schalter müssen Sie entweder Übergepäckgebühren zahlen oder Gegenstände aus dem Koffer nehmen. Tipps: Kleidung anziehen, Flüssigkeiten reduzieren oder zu Hause lassen.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const gpLimits: Record<string, number> = {
      '20': 20, '23': 23, '30': 30, '32': 32, '15': 15, 'custom': 23
    };
    function calcGP() {
      const airlineVal = (document.getElementById('gp-airline') as HTMLSelectElement).value;
      const isCustom = airlineVal === 'custom';
      document.getElementById('gp-custom-limit')!.classList.toggle('hidden', !isCustom);
      const limit = isCustom
        ? parseFloat((document.getElementById('gp-limit') as HTMLInputElement).value) || 23
        : parseFloat(airlineVal) || 23;
      const weight = parseFloat((document.getElementById('gp-gewicht') as HTMLInputElement).value) || 0;
      const fee = parseFloat((document.getElementById('gp-fee') as HTMLInputElement).value) || 15;
      const over = Math.max(0, weight - limit);
      const cost = over * fee;
      const under = Math.max(0, limit - weight);
      document.getElementById('gp-result')!.textContent = over > 0 ? 'Übergepäck: +' + over.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' kg' : 'Innerhalb Limit';
      document.getElementById('gp-sub')!.textContent = over > 0 ? 'Geschätzte Mehrkosten: ' + cost.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) : 'Noch ' + under.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' kg Spielraum';
      document.getElementById('gp-yours')!.textContent = weight.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' kg';
      document.getElementById('gp-free')!.textContent = limit.toLocaleString('de-DE') + ' kg';
      document.getElementById('gp-cost')!.textContent = over > 0 ? cost.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) : '–';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('gp-airline')!.addEventListener('change', calcGP);
      document.getElementById('gp-limit')!.addEventListener('input', calcGP);
      document.getElementById('gp-gewicht')!.addEventListener('input', calcGP);
      document.getElementById('gp-fee')!.addEventListener('input', calcGP);
      calcGP();
    }, 50);
  </script>
</CalculatorLayout>
