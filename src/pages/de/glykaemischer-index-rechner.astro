---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Glykämischer Index Rechner - Glykämische Last (GL)";
const description = "Berechnen Sie die glykämische Last aus dem glykämischen Index und Kohlenhydraten pro Portion. Klassifizieren Sie Lebensmittel als niedrig, mittel oder hoch GL.";
const relatedCalcs = [
  { name: "Glutenfreies Mehl-Rechner", url: "/de/glutenfreies-mehl-rechner", description: "GF-Mehlmischungen." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "Ziegenfutter-Rechner", url: "/de/ziegenfutter-rechner", description: "Ziegenfutter." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Notendurchschnitt-Rechner", url: "/de/notendurchschnitt-rechner", description: "GPA berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Glykämischer Index Rechner" enSlug="glycemic-index-calculator" keywords="glykämischer Index, glykämische Last, GI, GL, Blutzucker, Kohlenhydrate, Diabetes" breadcrumbs={[{ name: "Glykämischer Index Rechner", url: "/de/glykaemischer-index-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Glykämischer Index Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die glykämische Last und klassifizieren Sie Lebensmittel nach ihrer Blutzuckerwirkung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Voreingestelltes Lebensmittel</label>
          <select id="gid-preset" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="custom" selected>Eigene Werte</option>
            <option value="72,30">Weißbrot (GI 72, 30g KH)</option>
            <option value="55,40">Brauner Reis (GI 55, 40g KH)</option>
            <option value="51,26">Haferflocken (GI 51, 26g KH)</option>
            <option value="43,27">Nudeln (GI 43, 27g KH)</option>
            <option value="36,24">Apfel (GI 36, 24g KH)</option>
            <option value="103,26">Glukose (GI 103, 26g KH)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Glykämischer Index (GI)</label><input type="number" id="gid-val" class="gid-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="55" min="0" max="120" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">KH pro Portion (g)</label><input type="number" id="gid-carbs" class="gid-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="500" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Anzahl Portionen</label>
          <input type="number" id="gid-srv" class="gid-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0.5" max="10" step="0.5">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Glykämische Last</div>
          <div class="text-5xl font-extrabold font-mono" id="gid-gl">0</div>
          <div class="text-sm text-blue-200 mt-1" id="gid-class">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">GI-Kategorie</div><div class="text-xl font-bold" id="gid-gicat">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamt-KH</div><div class="text-xl font-bold" id="gid-totalcarbs">0g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">GL-Bewertung</div><div class="text-xl font-bold" id="gid-rating">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Klassifizierung</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Niedriger GI</span><span class="font-bold">55 oder weniger</span></div>
            <div class="flex justify-between"><span>Mittlerer GI</span><span class="font-bold">56 - 69</span></div>
            <div class="flex justify-between"><span>Hoher GI</span><span class="font-bold">70 oder mehr</span></div>
            <div class="flex justify-between"><span>Niedrige GL</span><span class="font-bold">10 oder weniger</span></div>
            <div class="flex justify-between"><span>Mittlere GL</span><span class="font-bold">11 - 19</span></div>
            <div class="flex justify-between"><span>Hohe GL</span><span class="font-bold">20 oder mehr</span></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="glykaemischer-index" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Glykämischer Index vs. Glykämische Last</h2>
      <p>Der Glykämische Index (GI) stuft kohlenhydrathaltige Lebensmittel danach ein, wie stark sie den Blutzucker erhöhen. Die Glykämische Last (GL) berücksichtigt die Portionsgröße: GL = GI x Kohlenhydrate (g) / 100. Die GL bietet ein praktischeres Maß für die Blutzuckerwirkung eines Lebensmittels.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Warum ist die GL besser als der GI?</strong> Der GI allein berücksichtigt nicht die Portionsgröße. Wassermelone hat einen hohen GI, aber eine niedrige GL pro Portion.</p>
      <p><strong>Was bedeutet eine GL von 20?</strong> Eine GL von 20 oder mehr gilt als hoch und kann zu einem stärkeren Blutzuckeranstieg führen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function setGidPreset() {
      const val = (document.getElementById('gid-preset') as HTMLSelectElement).value;
      if (val !== 'custom') {
        const parts = val.split(',');
        (document.getElementById('gid-val') as HTMLInputElement).value = parts[0];
        (document.getElementById('gid-carbs') as HTMLInputElement).value = parts[1];
      }
      calcGID();
    }
    function calcGID() {
      const gi = parseFloat((document.getElementById('gid-val') as HTMLInputElement).value) || 0;
      const carbs = parseFloat((document.getElementById('gid-carbs') as HTMLInputElement).value) || 0;
      const srv = parseFloat((document.getElementById('gid-srv') as HTMLInputElement).value) || 1;
      const totalCarbs = carbs * srv;
      const gl = (gi * totalCarbs) / 100;
      let giCat = 'Niedrig';
      if (gi >= 70) giCat = 'Hoch';
      else if (gi >= 56) giCat = 'Mittel';
      let glClass = 'Niedrige GL';
      let rating = 'Gut';
      if (gl >= 20) { glClass = 'Hohe GL'; rating = 'Hohe Wirkung'; }
      else if (gl >= 11) { glClass = 'Mittlere GL'; rating = 'M\u00e4\u00dfig'; }
      document.getElementById('gid-gl')!.textContent = gl.toFixed(1);
      document.getElementById('gid-class')!.textContent = glClass;
      document.getElementById('gid-gicat')!.textContent = giCat;
      document.getElementById('gid-totalcarbs')!.textContent = totalCarbs.toFixed(0) + 'g';
      document.getElementById('gid-rating')!.textContent = rating;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('gid-preset')!.addEventListener('change', setGidPreset);
      document.querySelectorAll('.gid-in').forEach(el => { el.addEventListener('input', calcGID); el.addEventListener('change', calcGID); });
      calcGID();
    }, 50);
  </script>
</CalculatorLayout>
