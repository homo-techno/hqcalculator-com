---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gleichstufige Stimmung Rechner - 12-TET Notenfrequenzen";
const description = "Berechnen Sie die Frequenz jeder Note in der gleichstufigen Stimmung (12-TET), passen Sie die A4-Referenzstimmung an und finden Sie Cent-Abweichungen.";
const relatedCalcs = [
  { name: "Encoder-Aufl\u00f6sung", url: "/de/encoder-aufloesung-rechner", description: "Encoder-Berechnung." },
  { name: "Gleichungsl\u00f6ser", url: "/de/gleichungsloeser", description: "Gleichungen l\u00f6sen." },
  { name: "Elo-Bewertung", url: "/de/elo-bewertung-rechner", description: "Elo-Rating." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gleichstufige Stimmung Rechner" lang="de" enSlug="equal-temperament-calculator" keywords="gleichstufige stimmung, 12-TET, notenfrequenz, A4 stimmung, cent, halbt\u00f6ne, tonh\u00f6he, musiktheorie" breadcrumbs={[{ name: "Gleichstufige Stimmung", url: "/de/gleichstufige-stimmung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gleichstufige Stimmung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie die Frequenz jeder Note in der 12-t&ouml;nigen gleichstufigen Stimmung mit einstellbarer A4-Referenz.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Note</label>
            <select id="gsde-note" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="0">C</option><option value="1">C#/Db</option><option value="2">D</option><option value="3">D#/Eb</option>
              <option value="4">E</option><option value="5">F</option><option value="6">F#/Gb</option><option value="7">G</option>
              <option value="8">G#/Ab</option><option value="9" selected>A</option><option value="10">A#/Bb</option><option value="11">B/H</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Oktave</label>
            <select id="gsde-oct" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
              <option value="4" selected>4</option><option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">A4 Referenz (Hz)</label>
            <input type="number" id="gsde-a4" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg" min="400" max="480" step="0.1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Cent-Versatz</label>
            <input type="number" id="gsde-cent" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg" min="-50" max="50" step="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Notenfrequenz</div>
          <div class="text-4xl font-extrabold font-mono" id="gsde-freq">0 Hz</div>
          <div class="text-sm text-blue-200 mt-1" id="gsde-note-name">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MIDI-Nummer</div><div class="text-xl font-bold font-mono" id="gsde-midi">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wellenl&auml;nge (in Luft)</div><div class="text-xl font-bold font-mono" id="gsde-wl">0 m</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Periode</div><div class="text-xl font-bold font-mono" id="gsde-per">0 ms</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Halbt&ouml;ne von A4</div><div class="text-xl font-bold font-mono" id="gsde-semi">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Volle Oktave Frequenzen</div>
          <div class="grid grid-cols-4 gap-2 text-sm" id="gsde-octave"></div>
        </div>
      </div>
      <ShareButton calculatorId="equal-temperament-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gleichstufige Stimmung erkl&auml;rt</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>f(n) = A4 &times; 2^((n &minus; 69) / 12)</p>
        <p>Halbton-Verh&auml;ltnis: 2^(1/12) &asymp; 1,05946</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Warum ist A4 = 440 Hz Standard?</strong> Die ISO 16 legte 1975 den Kammerton A4 auf 440 Hz fest. Historisch variierten Stimmungen zwischen 415 und 466 Hz.</p>
      <p><strong>Was sind Cent?</strong> Ein Cent ist 1/100 eines Halbtons. 1200 Cent ergeben eine Oktave.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const gsdeNoteNames = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];

    function calcGSDE() {
      const noteIdx = parseInt((document.getElementById('gsde-note') as HTMLSelectElement).value);
      const octave = parseInt((document.getElementById('gsde-oct') as HTMLSelectElement).value);
      const a4 = parseFloat((document.getElementById('gsde-a4') as HTMLInputElement).value) || 440;
      const centOff = parseFloat((document.getElementById('gsde-cent') as HTMLInputElement).value) || 0;

      const midi = (octave + 1) * 12 + noteIdx;
      const semiFromA4 = midi - 69;
      const totalCents = semiFromA4 * 100 + centOff;
      const freq = a4 * Math.pow(2, totalCents / 1200);

      const noteName = gsdeNoteNames[noteIdx] + octave;
      document.getElementById('gsde-freq')!.textContent = freq.toFixed(4) + ' Hz';
      document.getElementById('gsde-note-name')!.textContent = noteName + (centOff !== 0 ? ' (' + (centOff > 0 ? '+' : '') + centOff + ' Cent)' : '');
      document.getElementById('gsde-midi')!.textContent = midi.toString();
      document.getElementById('gsde-semi')!.textContent = semiFromA4.toString();

      const wavelength = 343 / freq;
      if (wavelength >= 1) {
        document.getElementById('gsde-wl')!.textContent = wavelength.toFixed(2) + ' m';
      } else {
        document.getElementById('gsde-wl')!.textContent = (wavelength * 100).toFixed(1) + ' cm';
      }

      const period = 1000 / freq;
      document.getElementById('gsde-per')!.textContent = period.toFixed(4) + ' ms';

      const octDiv = document.getElementById('gsde-octave')!;
      let html = '';
      for (let i = 0; i < 12; i++) {
        const m = (octave + 1) * 12 + i;
        const f = a4 * Math.pow(2, (m - 69) / 12);
        const highlight = i === noteIdx ? ' bg-blue-100 border-blue-300 border' : '';
        html += '<div class="p-2 rounded-lg text-center' + highlight + '"><div class="font-bold text-xs">' + gsdeNoteNames[i] + octave + '</div><div class="font-mono text-xs">' + f.toFixed(2) + '</div></div>';
      }
      octDiv.innerHTML = html;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      (document.getElementById('gsde-a4') as HTMLInputElement).value = '440';
      (document.getElementById('gsde-cent') as HTMLInputElement).value = '0';
      document.querySelectorAll('.gsde-in').forEach(el => { el.addEventListener('input', calcGSDE); el.addEventListener('change', calcGSDE); });
      calcGSDE();
    }, 50);
  </script>
</CalculatorLayout>
