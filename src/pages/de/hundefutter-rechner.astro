---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hundefutter-Rechner - Taegliche Portionen & Kalorien 2026";
const description = "Berechne den taeglichen Futterbedarf deines Hundes basierend auf Gewicht, Alter und Aktivitaetslevel. Kalorienbedarf, Portionsgroessen und Fuetterungsplan.";

const relatedCalcs = [
  { name: "Hundealter-Rechner", url: "/de/hundealter-rechner", description: "Hundejahre umrechnen." },
  { name: "Hunde-BMI-Rechner", url: "/de/hunde-bmi-rechner", description: "Koerperkondition Hund." },
  { name: "Hunde-Bewegung-Rechner", url: "/de/hunde-bewegung-rechner", description: "Bewegungsbedarf." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Menschlicher Kalorienbedarf." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hundefutter-Rechner" keywords="Hundefutter Rechner, Hund Kalorien, Futtermenge Hund, Fuetterungsplan, Hund Diaet" breadcrumbs={[{ name: "Hundefutter", url: "/de/hundefutter-rechner" }]} lang="de" enSlug="dog-food-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hundefutter-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne die taegliche Futtermenge, den Kalorienbedarf und den Fuetterungsplan fuer deinen Hund.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht des Hundes (kg)</label><input type="number" id="hfde-weight" class="hfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="1" max="120" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Altersgruppe</label>
            <select id="hfde-age" class="hfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="puppy">Welpe (0-12 Monate)</option>
              <option value="adult" selected>Erwachsen (1-7 Jahre)</option>
              <option value="senior">Senior (7+ Jahre)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktivitaetslevel</label>
            <select id="hfde-activity" class="hfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="low">Niedrig (Couchpotato)</option>
              <option value="moderate" selected>Mittel (taegliche Spaziergaenge)</option>
              <option value="high">Hoch (Arbeits-/Sporthund)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Futter-Kalorien (kcal/100g)</label><input type="number" id="hfde-kcal" class="hfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="350" min="100" max="600" step="10"></div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Mahlzeiten pro Tag</label>
          <select id="hfde-meals" class="hfde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="1">1 Mahlzeit</option>
            <option value="2" selected>2 Mahlzeiten</option>
            <option value="3">3 Mahlzeiten</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Taeglicher Kalorienbedarf</div>
          <div class="text-5xl font-extrabold font-mono" id="hfde-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gramm / Tag</div><div class="text-xl font-bold font-mono" id="hfde-grams">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Mahlzeit</div><div class="text-xl font-bold font-mono" id="hfde-permeal">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">RER (kcal)</div><div class="text-xl font-bold font-mono" id="hfde-rer">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Woechentlicher Bedarf</div><div class="text-xl font-bold font-mono" id="hfde-weekly">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Kosten ca.</div><div class="text-xl font-bold font-mono" id="hfde-cost">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dog-food" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Futterbedarfsberechnung fuer Hunde</h2>
      <p>Der Ruheenergiebedarf (RER) wird nach der Formel RER = 70 x Koerpergewicht^0,75 berechnet. Der tatsaechliche Bedarf (MER) haengt von Alter, Aktivitaet und Gesundheitszustand ab.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie oft sollte ich meinen Hund fuettern?</strong> Erwachsene Hunde: 2 Mahlzeiten pro Tag. Welpen: 3-4 Mahlzeiten. Senioren: 2 kleinere Mahlzeiten.</p>
      <p><strong>Woher weiss ich die Kalorien meines Futters?</strong> Die Kalorienangabe steht auf der Verpackung, typischerweise als kcal pro 100g oder pro kg.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHFDE() {
      const weight = parseFloat((document.getElementById('hfde-weight') as HTMLInputElement).value) || 0;
      const age = (document.getElementById('hfde-age') as HTMLSelectElement).value;
      const activity = (document.getElementById('hfde-activity') as HTMLSelectElement).value;
      const kcalPer100g = parseFloat((document.getElementById('hfde-kcal') as HTMLInputElement).value) || 350;
      const meals = parseInt((document.getElementById('hfde-meals') as HTMLSelectElement).value) || 2;

      const rer = 70 * Math.pow(weight, 0.75);
      const ageFactors: Record<string, number> = { puppy: 2.5, adult: 1.6, senior: 1.2 };
      const activityFactors: Record<string, number> = { low: 0.8, moderate: 1.0, high: 1.4 };

      const dailyCal = rer * (ageFactors[age] || 1.6) * (activityFactors[activity] || 1.0);
      const gramsPerDay = (dailyCal / kcalPer100g) * 100;
      const perMeal = gramsPerDay / meals;
      const weeklyFood = gramsPerDay * 7;
      const monthlyCost = (gramsPerDay * 30 / 1000) * 5;

      document.getElementById('hfde-result')!.textContent = Math.round(dailyCal) + ' kcal';
      document.getElementById('hfde-grams')!.textContent = Math.round(gramsPerDay) + ' g';
      document.getElementById('hfde-permeal')!.textContent = Math.round(perMeal) + ' g';
      document.getElementById('hfde-rer')!.textContent = Math.round(rer).toString();
      document.getElementById('hfde-weekly')!.textContent = (weeklyFood / 1000).toFixed(1).replace('.', ',') + ' kg';
      document.getElementById('hfde-cost')!.textContent = '~' + monthlyCost.toFixed(0) + ' \u20AC';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hfde-in').forEach(el => { el.addEventListener('input', calcHFDE); el.addEventListener('change', calcHFDE); });
      calcHFDE();
    }, 50);
  </script>
</CalculatorLayout>
