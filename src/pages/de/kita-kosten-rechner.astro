---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Kita-Kosten-Rechner - Kinderbetreuung vergleichen";
const description = "Vergleichen Sie Kita-Kosten fuer verschiedene Betreuungsarten: Kita, Tagesmutter, Au-pair und Kinderfrauen. Schaetzen Sie jaehrliche Betreuungskosten.";

const relatedCalcs = [
  { name: "Budgetrechner", url: "/de/budget-rechner", description: "Familienbudget." },
  { name: "Gehaltsrechner", url: "/de/gehaltsrechner", description: "Einkommensanalyse." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
  { name: "Schuldenabbau-Rechner", url: "/de/schuldenabbau-rechner", description: "Schulden tilgen." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="daycare-cost-calculator" calculatorName="Kita-Kosten-Rechner" keywords="kita kosten, kinderbetreuung kosten, tagesmutter kosten, krippe kosten, kindergarten kosten, betreuungskosten" breadcrumbs={[{ name: "Kita-Kosten-Rechner", url: "/de/kita-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kita-Kosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie Kinderbetreuungskosten f&uuml;r verschiedene Betreuungsarten und finden Sie die beste Option f&uuml;r Ihr Familienbudget.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl der Kinder</label>
          <input type="number" id="kk-children" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1" max="6" step="1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Altersgruppe des Kindes</label>
          <select id="kk-agegroup" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="infant">S&auml;ugling (0-12 Monate)</option>
            <option value="toddler" selected>Kleinkind (1-3 Jahre)</option>
            <option value="preschool">Kindergarten (3-6 Jahre)</option>
            <option value="school">Schulkind (6+, Hort)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Betreuungsart</label>
          <select id="kk-type" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="kita" selected>Kita / Krippe</option>
            <option value="tagesmutter">Tagesmutter</option>
            <option value="kinderfrau">Kinderfrau / Nanny</option>
            <option value="aupair">Au-pair</option>
            <option value="share">Betreuung teilen</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Tage pro Woche</label>
          <input type="number" id="kk-days" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="7" step="1">
        </div>

        <div>
          <label class="block text-sm font-medium text-text mb-1">Region</label>
          <select id="kk-area" class="kk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="low">L&auml;ndlich / Kleinstadt</option>
            <option value="medium" selected>Mittelgro&szlig;e Stadt</option>
            <option value="high">Gro&szlig;stadt</option>
            <option value="vhigh">M&uuml;nchen / Frankfurt / Hamburg</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">J&auml;hrliche Betreuungskosten</div>
        <div class="text-5xl font-extrabold" id="kk-annual">--</div>
        <div class="text-sm text-blue-200 mt-1" id="kk-type-label">gesch&auml;tzte j&auml;hrliche Kosten</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Monatliche Kosten</div>
          <div class="text-lg font-bold" id="kk-monthly">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">W&ouml;chentliche Kosten</div>
          <div class="text-lg font-bold" id="kk-weekly">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">T&auml;gliche Kosten</div>
          <div class="text-lg font-bold" id="kk-daily">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">% des Medianeinkommens</div>
          <div class="text-lg font-bold" id="kk-pctincome">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Kostenvergleich nach Betreuungsart</h3>
        <div class="text-xs" id="kk-comparison"></div>
      </div>

      <ShareButton lang="de" calculatorId="daycare-cost" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kinderbetreuungskosten in Deutschland</h2>
      <p>Kinderbetreuung geh&ouml;rt zu den gr&ouml;&szlig;ten Ausgaben f&uuml;r Familien mit kleinen Kindern. In Deutschland variieren die Kita-Geb&uuml;hren stark je nach Bundesland, Kommune und Einkommen der Eltern.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Betreuungsarten im &Uuml;berblick</h3>
      <ul>
        <li><strong>Kita/Krippe:</strong> Staatlich oder privat, strukturiertes Programm. Zuverl&auml;ssige Zeiten, einkommensabh&auml;ngige Geb&uuml;hren.</li>
        <li><strong>Tagesmutter:</strong> Betreuung im H&auml;uslichen, kleinere Gruppen. Oft flexibler und pers&ouml;nlicher.</li>
        <li><strong>Kinderfrau/Nanny:</strong> Individuelle Betreuung zu Hause. Am teuersten, aber maximale Flexibilit&auml;t.</li>
        <li><strong>Au-pair:</strong> Junge/r Erwachsene/r aus dem Ausland. Fester Jahresbetrag, unabh&auml;ngig von der Kinderzahl.</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Sind Kita-Kosten steuerlich absetzbar?</strong> Ja, bis zu 2/3 der Kosten (max. 4.000 &euro; pro Kind/Jahr) k&ouml;nnen als Sonderausgaben abgesetzt werden.</p>
      <p><strong>Gibt es kostenlose Kita-Pl&auml;tze?</strong> In einigen Bundesl&auml;ndern (z.B. Berlin, Hamburg) ist die Kita ab einem bestimmten Alter beitragsfrei.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcKK() {
      const children = parseFloat((document.getElementById('kk-children') as HTMLInputElement).value) || 1;
      const agegroup = (document.getElementById('kk-agegroup') as HTMLSelectElement).value;
      const type = (document.getElementById('kk-type') as HTMLSelectElement).value;
      const days = parseFloat((document.getElementById('kk-days') as HTMLInputElement).value) || 5;
      const area = (document.getElementById('kk-area') as HTMLSelectElement).value;

      const baseMonthly: Record<string, number> = {
        kita: 450, tagesmutter: 550, kinderfrau: 2200, aupair: 800, share: 1200
      };

      const ageMult: Record<string, number> = {
        infant: 1.3, toddler: 1.0, preschool: 0.8, school: 0.5
      };

      const areaMult: Record<string, number> = {
        low: 0.7, medium: 1.0, high: 1.35, vhigh: 1.7
      };

      const dayFactor = days / 5;

      const types = ['kita', 'tagesmutter', 'kinderfrau', 'aupair', 'share'];
      const typeNames: Record<string, string> = {
        kita: 'Kita/Krippe', tagesmutter: 'Tagesmutter', kinderfrau: 'Kinderfrau/Nanny', aupair: 'Au-pair', share: 'Betreuung teilen'
      };

      function calcCost(t: string): number {
        let monthly = baseMonthly[t] * ageMult[agegroup] * areaMult[area] * dayFactor;
        if (t === 'aupair') {
          monthly = (9600 / 12) * areaMult[area];
        }
        if (t === 'kinderfrau' || t === 'share') {
          return monthly * 12 * (children > 1 ? 1 + (children - 1) * 0.15 : 1);
        }
        return monthly * 12 * children;
      }

      const selectedCost = calcCost(type);
      const annual = Math.round(selectedCost);
      const monthly = Math.round(annual / 12);
      const weekly = Math.round(annual / 52);
      const daily = Math.round(annual / (52 * days));

      const medianIncome = 44000;
      const pctIncome = ((annual / medianIncome) * 100).toFixed(1);

      const fmt = (v: number) => v.toLocaleString('de-DE') + ' \u20AC';

      document.getElementById('kk-annual')!.textContent = fmt(annual);
      document.getElementById('kk-monthly')!.textContent = fmt(monthly);
      document.getElementById('kk-weekly')!.textContent = fmt(weekly);
      document.getElementById('kk-daily')!.textContent = fmt(daily);
      document.getElementById('kk-pctincome')!.textContent = pctIncome + '%';
      document.getElementById('kk-type-label')!.textContent = typeNames[type] + ' - ' + children + ' Kind' + (children > 1 ? 'er' : '');

      document.getElementById('kk-comparison')!.innerHTML =
        '<div class="grid grid-cols-3 gap-2 font-semibold text-text-muted mb-1"><span>Typ</span><span>Monatlich</span><span>J\u00e4hrlich</span></div>' +
        types.map(t => {
          const cost = calcCost(t);
          const isSelected = t === type;
          return '<div class="grid grid-cols-3 gap-2 py-1 ' + (isSelected ? 'bg-blue-50 rounded font-bold' : '') + '"><span>' + typeNames[t] + '</span><span>' + fmt(Math.round(cost / 12)) + '</span><span>' + fmt(Math.round(cost)) + '</span></div>';
        }).join('');

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.kk-in').forEach(el => {
        el.addEventListener('input', calcKK);
        el.addEventListener('change', calcKK);
      });
      calcKK();
    }, 50);
  </script>
</CalculatorLayout>
