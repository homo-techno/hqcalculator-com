---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Glutenfreies Mehl-Rechner - Mischungsverhältnisse & Xanthan";
const description = "Berechnen Sie glutenfreie Mehlmischungen und Xanthan-Gum-Mengen zum Backen. Erstellen Sie individuelle GF-Mehlmischungen für Brot, Kuchen und Gebäck.";
const relatedCalcs = [
  { name: "Glasurrezept-Rechner", url: "/de/glasurrezept-rechner", description: "Glasurrezepte." },
  { name: "Kies-Rechner", url: "/de/kies-rechner", description: "Kies-Menge." },
  { name: "Noten-Rechner", url: "/de/noten-rechner", description: "Notenberechnung." },
  { name: "Goldener-Schnitt-Rechner", url: "/de/goldener-schnitt-rechner", description: "Goldener Schnitt." },
  { name: "Ziegenfutter-Rechner", url: "/de/ziegenfutter-rechner", description: "Ziegenfutter." },
  { name: "Glykaemischer-Index-Rechner", url: "/de/glykaemischer-index-rechner", description: "Glykämischer Index." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Glutenfreies Mehl-Rechner" enSlug="gluten-free-flour-calculator" keywords="glutenfreies Mehl, GF Mehlmischung, Xanthan Gum, Reismehl Mischung, glutenfrei backen, Mehlersatz" breadcrumbs={[{ name: "Glutenfreies Mehl-Rechner", url: "/de/glutenfreies-mehl-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Glutenfreies Mehl-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erstellen Sie glutenfreie Mehlmischungen mit den richtigen Verhältnissen. Berechnen Sie die Xanthan-Gum-Menge für gute Bindung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Mischungstyp</label>
          <select id="gfm-blend" class="gfm-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="allpurpose">Universal GF-Mischung</option>
            <option value="bread">GF Brot-Mischung (mehr Protein)</option>
            <option value="cake">GF Kuchen/Gebäck-Mischung (leichter)</option>
            <option value="cookies">GF Keks-Mischung</option>
            <option value="pizza">GF Pizzateig-Mischung</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Benötigte Gesamtmenge Mehl (Gramm)</label>
          <input type="number" id="gfm-total" class="gfm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="480" min="50" step="10">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Backanwendung</label>
          <select id="gfm-app" class="gfm-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="bread">Brot / Brötchen</option>
            <option value="cake">Kuchen</option>
            <option value="cookies">Kekse / Riegel</option>
            <option value="muffins">Muffins / Schnellbrot</option>
            <option value="pie">Kuchenboden</option>
            <option value="pancakes">Pfannkuchen / Waffeln</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Xanthan Gum benötigt</div>
          <div class="text-5xl font-extrabold font-mono" id="gfm-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Weißes Reismehl</div><div class="text-xl font-bold font-mono" id="gfm-rice">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stärkekomponente</div><div class="text-xl font-bold font-mono" id="gfm-starch">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Proteinmehl</div><div class="text-xl font-bold font-mono" id="gfm-protein">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zusatzkomponente</div><div class="text-xl font-bold font-mono" id="gfm-extra">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-2">Mischungsdetails</div>
          <div class="text-sm text-text-secondary" id="gfm-details">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="glutenfreies-mehl" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Glutenfreies Backen</h2>
      <p>Glutenfreie Mehlmischungen kombinieren verschiedene Mehle und Stärken, um die Eigenschaften von Weizenmehl nachzuahmen. Xanthan Gum oder Flohsamenschalen dienen als Glutenersatz für Bindung und Elastizität.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Warum brauche ich Xanthan Gum?</strong> Xanthan Gum ersetzt die Bindungsfunktion von Gluten. Ohne Xanthan zerfallen Backwaren leicht.</p>
      <p><strong>Kann ich nur Reismehl verwenden?</strong> Reines Reismehl ergibt krümelige Ergebnisse. Eine Mischung aus verschiedenen Mehlen und Stärken liefert bessere Textur.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGFM() {
      const blend = (document.getElementById('gfm-blend') as HTMLSelectElement).value;
      const total = parseFloat((document.getElementById('gfm-total') as HTMLInputElement).value) || 480;
      const app = (document.getElementById('gfm-app') as HTMLSelectElement).value;

      const blends: Record<string, {rice: number, starch: number, protein: number, extra: number, starchName: string, proteinName: string, extraName: string, details: string}> = {
        allpurpose: {
          rice: 0.40, starch: 0.30, protein: 0.20, extra: 0.10,
          starchName: 'Tapiokastärke', proteinName: 'Braunes Reismehl', extraName: 'Kartoffelstärke',
          details: 'Vielseitige Mischung für die meisten Backwaren. 40% weißes Reismehl + 30% Tapiokastärke + 20% braunes Reismehl + 10% Kartoffelstärke.'
        },
        bread: {
          rice: 0.30, starch: 0.20, protein: 0.35, extra: 0.15,
          starchName: 'Tapiokastärke', proteinName: 'Sorghummehl', extraName: 'Hirsemehl',
          details: 'Mehr Protein für Brotstruktur. 30% weißes Reismehl + 20% Tapioka + 35% Sorghum + 15% Hirse. Flohsamenschalen (1 EL pro Tasse) für extra Struktur.'
        },
        cake: {
          rice: 0.45, starch: 0.35, protein: 0.10, extra: 0.10,
          starchName: 'Speisestärke', proteinName: 'Klebreismehl', extraName: 'Tapiokastärke',
          details: 'Leicht und zart für Kuchen und Gebäck. 45% weißes Reismehl + 35% Speisestärke + 10% Klebreismehl + 10% Tapioka.'
        },
        cookies: {
          rice: 0.35, starch: 0.25, protein: 0.25, extra: 0.15,
          starchName: 'Tapiokastärke', proteinName: 'Hafermehl (GF)', extraName: 'Mandelmehl',
          details: 'Ausgewogen für Kekse mit Geschmack und Textur. 35% weißes Reismehl + 25% Tapioka + 25% GF Hafermehl + 15% Mandelmehl.'
        },
        pizza: {
          rice: 0.30, starch: 0.25, protein: 0.30, extra: 0.15,
          starchName: 'Tapiokastärke', proteinName: 'Sorghummehl', extraName: 'Kartoffelstärke',
          details: 'Dehnbar und kaubar für Pizza. 30% weißes Reismehl + 25% Tapioka + 30% Sorghum + 15% Kartoffelstärke. 2 TL Flohsamenschalen pro Tasse.'
        },
      };

      const xanthanPerCup: Record<string, number> = {
        bread: 1.0, cake: 0.5, cookies: 0.5, muffins: 0.75, pie: 0.5, pancakes: 0.25,
      };

      const b = blends[blend];
      const riceG = total * b.rice;
      const starchG = total * b.starch;
      const proteinG = total * b.protein;
      const extraG = total * b.extra;

      const cups = total / 160;
      const xanthanTsp = cups * (xanthanPerCup[app] || 0.5);
      const xanthanG = xanthanTsp * 2.5;

      document.getElementById('gfm-result')!.textContent = xanthanTsp.toFixed(1) + ' TL (' + xanthanG.toFixed(1) + ' g)';
      document.getElementById('gfm-rice')!.textContent = riceG.toFixed(0) + ' g';
      document.getElementById('gfm-starch')!.textContent = starchG.toFixed(0) + 'g ' + b.starchName;
      document.getElementById('gfm-protein')!.textContent = proteinG.toFixed(0) + 'g ' + b.proteinName;
      document.getElementById('gfm-extra')!.textContent = extraG.toFixed(0) + 'g ' + b.extraName;
      document.getElementById('gfm-details')!.textContent = b.details;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gfm-in').forEach(el => { el.addEventListener('input', calcGFM); el.addEventListener('change', calcGFM); });
      calcGFM();
    }, 50);
  </script>
</CalculatorLayout>
