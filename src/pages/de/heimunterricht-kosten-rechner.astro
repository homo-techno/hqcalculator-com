---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Heimunterricht Kosten Rechner - Jahresbudget Hausunterricht 2026";
const description = "Schaetze dein jaehrliches Heimunterricht-Budget inklusive Lehrplan, Materialien, Aktivitaeten und Lerngruppen. Kostenloser Hausunterricht-Rechner.";

const relatedCalcs = [
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "Kreditrechner", url: "/de/kreditrechner", description: "Kreditraten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Heimunterricht-Kosten-Rechner" keywords="Heimunterricht Kosten, Hausunterricht Budget, Homeschooling Deutschland, Lehrplan Kosten, Privatunterricht Ausgaben" breadcrumbs={[{ name: "Heimunterricht-Kosten-Rechner", url: "/de/heimunterricht-kosten-rechner" }]} lang="de" enSlug="homeschool-cost-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Heimunterricht-Kosten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetze dein jaehrliches Heimunterricht-Budget inklusive Lehrplan, Materialien und Aktivitaeten.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl Schueler</label>
          <input type="number" id="huk-students" class="huk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="10" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Klassenstufe</label>
          <select id="huk-grade" class="huk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="elem" selected>Grundschule (1-4)</option>
            <option value="middle">Mittelschule (5-8)</option>
            <option value="high">Oberstufe (9-12/Abitur)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Lehrplan-Art</label>
          <select id="huk-curriculum" class="huk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="free">Kostenlose/Open-Source-Materialien</option>
            <option value="budget">Guenstiger Lehrplan (200-400 €)</option>
            <option value="standard" selected>Standard Paketlehrplan (500-900 €)</option>
            <option value="online">Online-Akademie (1.000-3.000 €)</option>
            <option value="premium">Premium / Individuell (2.000 €+)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ausserunterrichtliche Aktivitaeten</label>
          <select id="huk-extra" class="huk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Keine</option>
            <option value="basic" selected>Wenig (1-2 Aktivitaeten)</option>
            <option value="moderate">Mittel (3-4 Aktivitaeten)</option>
            <option value="full">Viele (5+ Aktivitaeten)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Lerngruppe</label>
          <select id="huk-coop" class="huk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="none">Keine</option>
            <option value="free">Kostenlose Lerngruppe</option>
            <option value="paid" selected>Kostenpflichtige Gruppe (50-150 €/Monat)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Ausflug-Budget (monatlich, €)</label>
          <input type="number" id="huk-trips" class="huk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" max="500" step="10">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschaetzte Jahreskosten</div>
        <div class="text-5xl font-extrabold" id="huk-total">--</div>
        <div class="text-sm text-blue-200 mt-1" id="huk-per">pro Schueler jaehrlich</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monatliche Kosten</div><div class="text-lg font-bold" id="huk-monthly">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Schueler</div><div class="text-lg font-bold" id="huk-perstudent">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lehrplankosten</div><div class="text-lg font-bold" id="huk-currcost">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Vergleich oeffentl. Schule</div><div class="text-lg font-bold" id="huk-compare">--</div></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Kostenaufschluesselung</h3>
        <div class="text-xs" id="huk-breakdown"></div>
      </div>

      <ShareButton calculatorId="homeschool-cost" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Was kostet Heimunterricht?</h2>
      <p>Die Kosten fuer Heimunterricht variieren stark: von fast kostenlos bis zu mehreren tausend Euro pro Schueler und Jahr. Im Durchschnitt rechnen Familien mit 800-2.000 € pro Schueler jaehrlich ohne den Zeitaufwand der Eltern.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Wo fliessen die Kosten hin?</h3>
      <ul>
        <li><strong>Lehrplan:</strong> 0-3.000 € je nach Ansatz</li>
        <li><strong>Materialien:</strong> 100-500 € fuer Buecher, Kunst- und Wissenschaftsbedarf</li>
        <li><strong>Aktivitaeten:</strong> 500-3.000 € fuer Sport, Musik, Kunstkurse</li>
        <li><strong>Lerngruppen:</strong> 0-1.800 € pro Jahr</li>
        <li><strong>Ausfluege:</strong> 200-1.200 € pro Jahr</li>
      </ul>

      <h3 class="text-xl font-semibold text-text mt-8">Spartipps</h3>
      <ul>
        <li>Kostenlose Online-Ressourcen nutzen (Khan Academy, Bibliotheken)</li>
        <li>Gebrauchte Lehrbucher kaufen oder tauschen</li>
        <li>Materialien mit anderen Heimunterricht-Familien teilen</li>
        <li>Kostenlose Museums- und Bildungsprogramme nutzen</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHUK() {
      const students = parseFloat((document.getElementById('huk-students') as HTMLInputElement).value) || 1;
      const grade = (document.getElementById('huk-grade') as HTMLSelectElement).value;
      const curriculum = (document.getElementById('huk-curriculum') as HTMLSelectElement).value;
      const extra = (document.getElementById('huk-extra') as HTMLSelectElement).value;
      const coop = (document.getElementById('huk-coop') as HTMLSelectElement).value;
      const trips = parseFloat((document.getElementById('huk-trips') as HTMLInputElement).value) || 0;

      const curriculumCost: Record<string, number> = { free: 50, budget: 300, standard: 700, online: 2000, premium: 3000 };
      const gradeMult: Record<string, number> = { elem: 1.0, middle: 1.15, high: 1.3 };
      const extraCost: Record<string, number> = { none: 0, basic: 1200, moderate: 2400, full: 4000 };
      const coopCost: Record<string, number> = { none: 0, free: 50, paid: 1200 };

      const supplies = grade === 'high' ? 350 : grade === 'middle' ? 250 : 150;
      const tech = grade === 'high' ? 200 : 100;
      const testing = grade === 'high' ? 100 : 30;
      const currCost = curriculumCost[curriculum] * gradeMult[grade];

      const breakdown = [
        { name: 'Lehrplan', amount: currCost },
        { name: 'Materialien', amount: supplies },
        { name: 'Technologie', amount: tech },
        { name: 'Aktivitaeten', amount: extraCost[extra] },
        { name: 'Lerngruppe', amount: coopCost[coop] },
        { name: 'Ausfluege', amount: trips * 10 },
        { name: 'Tests & Leistungspr.', amount: testing },
      ];

      const perStudent = breakdown.reduce((sum, item) => sum + item.amount, 0);
      const sibDiscount = students > 1 ? 0.7 : 1;
      const total = Math.round(perStudent + (students - 1) * perStudent * sibDiscount);
      const monthly = Math.round(total / 12);
      const publicSchoolOOP = 800;
      const diff = total - publicSchoolOOP * students;
      const compareText = diff > 0 ? Math.abs(diff).toLocaleString('de-DE') + ' € mehr' : Math.abs(diff).toLocaleString('de-DE') + ' € weniger';

      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE') + ' €';
      document.getElementById('huk-total')!.textContent = fmt(total);
      document.getElementById('huk-per')!.textContent = students + ' Schueler - Jahresschaetzung';
      document.getElementById('huk-monthly')!.textContent = fmt(monthly);
      document.getElementById('huk-perstudent')!.textContent = fmt(Math.round(total / students));
      document.getElementById('huk-compare')!.textContent = compareText;
      document.getElementById('huk-currcost')!.textContent = fmt(Math.round(currCost));

      document.getElementById('huk-breakdown')!.innerHTML =
        '<div class="grid grid-cols-3 gap-2 font-semibold text-text-muted mb-1"><span>Kategorie</span><span class="text-right">Pro Schueler</span><span class="text-right">Gesamt</span></div>' +
        breakdown.map(item => {
          const totalItem = item.name === 'Lehrplan' ? Math.round(item.amount * (1 + (students - 1) * sibDiscount)) : Math.round(item.amount * students);
          return '<div class="grid grid-cols-3 gap-2 py-1"><span>' + item.name + '</span><span class="text-right">' + fmt(Math.round(item.amount)) + '</span><span class="text-right font-semibold">' + fmt(totalItem) + '</span></div>';
        }).join('') +
        '<div class="grid grid-cols-3 gap-2 py-1 mt-1 border-t border-border font-bold"><span>Gesamt</span><span class="text-right">' + fmt(Math.round(perStudent)) + '</span><span class="text-right">' + fmt(total) + '</span></div>';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.huk-in').forEach(el => {
        el.addEventListener('input', calcHUK);
        el.addEventListener('change', calcHUK);
      });
      calcHUK();
    }, 50);
  </script>
</CalculatorLayout>
