---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fundament-Rechner - Beton, Bewehrung & Schalung";
const description = "Berechnen Sie den Betonbedarf für Fundamentwände und Streifenfundamente. Erhalten Sie Kubikmeter, Bewehrungsstahl und Schalungsbedarf.";
const relatedCalcs = [
  { name: "Beton-Rechner", url: "/de/beton-rechner", description: "Betonvolumen berechnen." },
  { name: "Bewehrungsrechner", url: "/de/bewehrungsrechner", description: "Bewehrungsbedarf." },
  { name: "Aushub-Rechner", url: "/de/aushub-rechner", description: "Aushubvolumen." },
  { name: "Tragwerksrechner", url: "/de/tragwerksrechner", description: "Lastanalyse." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fundament-Rechner" lang="de" enSlug="foundation-calculator" keywords="fundament rechner, streifenfundament, betonbedarf, bewehrung fundament, schalung, fundamentkosten" breadcrumbs={[{ name: "Fundament-Rechner", url: "/de/fundament-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fundament-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Beton-, Bewehrungs- und Schalungsbedarf f&uuml;r Fundamentw&auml;nde und Streifenfundamente.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="mb-5">
            <label class="block text-xs font-medium text-text mb-1">Fundamentumfang (m)</label>
            <input type="number" id="fnd-perim" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="42" min="0" step="0.5">
          </div>
          <h3 class="text-sm font-semibold text-text mb-3">Wandabmessungen</h3>
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Wanddicke (cm)</label>
              <input type="number" id="fnd-wallw" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="20" min="10" step="1">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Wandh&ouml;he (m)</label>
              <input type="number" id="fnd-wallh" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="2.4" min="0" step="0.1">
            </div>
          </div>
          <h3 class="text-sm font-semibold text-text mb-3">Streifenfundament</h3>
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Fundamentbreite (cm)</label>
              <input type="number" id="fnd-footw" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="40" min="20" step="5">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Fundamenttiefe (cm)</label>
              <input type="number" id="fnd-footd" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="20" min="15" step="5">
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Verschnitt (%)</label>
              <input type="number" id="fnd-waste" class="w-full px-3 py-2 border border-border rounded-lg" value="10" min="0" max="30" step="1">
            </div>
          </div>
        </div>
        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Betonbedarf</div>
            <div class="text-5xl font-extrabold font-mono" id="fnd-total">0</div>
            <div class="text-sm text-blue-200 mt-1">Kubikmeter (W&auml;nde + Fundament)</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Wandbeton</div>
              <div class="text-xl font-bold" id="fnd-wallm3">0 m&sup3;</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Fundamentbeton</div>
              <div class="text-xl font-bold" id="fnd-footm3">0 m&sup3;</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Bewehrungsstahl (lfd. m)</div>
              <div class="text-xl font-bold" id="fnd-rebar">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Schalung (m&sup2;)</div>
              <div class="text-xl font-bold" id="fnd-forms">0</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Mischfahrzeuge (7 m&sup3;)</div>
            <div class="text-xl font-bold" id="fnd-trucks">0</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="foundation-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Fundamentbeton berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Wandvolumen:</strong> Umfang &times; Dicke (m) &times; H&ouml;he (m)</p>
        <p><strong>Fundamentvolumen:</strong> Umfang &times; Breite (m) &times; Tiefe (m)</p>
        <p><strong>Gesamt:</strong> (Wand + Fundament) &times; (1 + Verschnitt)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Betonklasse f&uuml;r Fundamente?</strong> In Deutschland wird f&uuml;r Fundamente typischerweise C25/30 oder C30/37 verwendet, je nach Belastung und Expositionsklasse.</p>
      <p><strong>Wie tief muss ein Fundament sein?</strong> Mindestens 80 cm unter Gel&auml;ndeoberkante (frostfrei). Bei stark frostgef&auml;hrdeten B&ouml;den bis 120 cm.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcFND() {
      const perim = parseFloat((document.getElementById('fnd-perim') as HTMLInputElement).value) || 0;
      const wallW = (parseFloat((document.getElementById('fnd-wallw') as HTMLInputElement).value) || 20) / 100;
      const wallH = parseFloat((document.getElementById('fnd-wallh') as HTMLInputElement).value) || 0;
      const footW = (parseFloat((document.getElementById('fnd-footw') as HTMLInputElement).value) || 40) / 100;
      const footD = (parseFloat((document.getElementById('fnd-footd') as HTMLInputElement).value) || 20) / 100;
      const waste = (parseFloat((document.getElementById('fnd-waste') as HTMLInputElement).value) || 0) / 100;
      const wallM3 = perim * wallW * wallH;
      const footM3 = perim * footW * footD;
      const totalM3 = (wallM3 + footM3) * (1 + waste);
      const wallM3W = wallM3 * (1 + waste);
      const footM3W = footM3 * (1 + waste);
      const horizRuns = 2;
      const vertSpacing = 0.6;
      const vertBarsCount = Math.ceil(perim / vertSpacing);
      const horizRebarM = perim * horizRuns * Math.ceil(wallH / vertSpacing);
      const vertRebarM = vertBarsCount * wallH;
      const footingRebarM = perim * 2;
      const totalRebar = Math.ceil(horizRebarM + vertRebarM + footingRebarM);
      const formM2 = Math.ceil(perim * wallH * 2);
      const trucks = Math.ceil(totalM3 / 7);
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('fnd-total')!.textContent = fmt(totalM3);
      document.getElementById('fnd-wallm3')!.textContent = fmt(wallM3W) + ' m\u00B3';
      document.getElementById('fnd-footm3')!.textContent = fmt(footM3W) + ' m\u00B3';
      document.getElementById('fnd-rebar')!.textContent = totalRebar.toLocaleString('de-DE');
      document.getElementById('fnd-forms')!.textContent = formM2.toLocaleString('de-DE');
      document.getElementById('fnd-trucks')!.textContent = String(trucks);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('#fnd-perim, #fnd-wallw, #fnd-wallh, #fnd-footw, #fnd-footd, #fnd-waste').forEach(el => {
        el.addEventListener('input', calcFND);
        el.addEventListener('change', calcFND);
      });
      calcFND();
    }, 50);
  </script>
</CalculatorLayout>
