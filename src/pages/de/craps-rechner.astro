---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Craps-Rechner - Wettwahrscheinlichkeiten & Hausvorteil";
const description = "Berechnen Sie Craps-Wettwahrscheinlichkeiten, Hausvorteil und Erwartungswert fuer alle Wettarten inkl. Pass, Don't Pass, Come und Odds-Wetten.";
const relatedCalcs = [
  { name: "Wahrscheinlichkeitsrechner", url: "/de/wahrscheinlichkeitsrechner", description: "Wahrscheinlichkeiten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "Statistikrechner", url: "/de/statistik-rechner", description: "Statistische Auswertungen." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitte." },
  { name: "Zufallsgenerator", url: "/de/zufallsgenerator", description: "Zufallszahlen." },
  { name: "Standardabweichungsrechner", url: "/de/standardabweichung-rechner", description: "Streuung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Craps-Rechner" keywords="Craps Rechner, Craps Wahrscheinlichkeiten, Pass Line, Hausvorteil, Craps Wetten, Erwartungswert" breadcrumbs={[{ name: "Craps-Rechner", url: "/de/craps-rechner" }]} lang="de" enSlug="craps-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Craps-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Analysieren Sie jede Craps-Wettart mit exakten Wahrscheinlichkeiten, Hausvorteil und Erwartungswert.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Wettart</label>
          <select class="cps-in w-full px-4 py-2 border border-border rounded-xl" id="cps-bet">
            <option value="pass">Pass Line</option>
            <option value="dontpass">Don't Pass</option>
            <option value="come">Come</option>
            <option value="dontcome">Don't Come</option>
            <option value="field">Field</option>
            <option value="any7">Any 7</option>
            <option value="any11">Any Craps</option>
            <option value="hard6">Hard 6</option>
            <option value="hard8">Hard 8</option>
            <option value="hard4">Hard 4</option>
            <option value="hard10">Hard 10</option>
            <option value="place6">Place 6</option>
            <option value="place8">Place 8</option>
            <option value="place5">Place 5</option>
            <option value="place9">Place 9</option>
            <option value="place4">Place 4</option>
            <option value="place10">Place 10</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Einsatz (EUR)</label>
            <input type="number" class="cps-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="cps-amount" min="1" value="10">
          </div>
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Odds-Multiplikator (0 = ohne)</label>
            <input type="number" class="cps-in w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" id="cps-odds" min="0" max="100" value="2">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Wuerfe pro Stunde</label>
          <input type="number" class="cps-in w-full px-4 py-3 border border-border rounded-xl text-lg text-center" id="cps-rolls" min="1" max="200" value="100">
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gewinnwahrscheinlichkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="cps-prob">--</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Hausvorteil</div>
            <div class="text-xl font-bold font-mono" id="cps-edge">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Auszahlung</div>
            <div class="text-xl font-bold font-mono" id="cps-payout">--</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">EW pro Wette</div>
            <div class="text-xl font-bold font-mono" id="cps-ev">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Erw. Verlust / Stunde</div>
            <div class="text-xl font-bold font-mono" id="cps-hour">--</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Beste bis schlechteste Wetten (nach Hausvorteil)</h3>
          <div class="text-xs font-mono space-y-1" id="cps-table"></div>
        </div>
      </div>
      <ShareButton calculatorId="craps" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Craps verstehen</h2>
      <p>Craps ist ein Wuerfelspiel, bei dem die Wahrscheinlichkeiten mathematisch genau berechenbar sind. Die Pass Line hat einen Hausvorteil von nur 1,41 %, waehrend exotische Wetten wie Any 7 bis zu 16,67 % Hausvorteil haben.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcCPS() {
      const bet = (document.getElementById('cps-bet') as HTMLSelectElement).value;
      const amount = parseFloat((document.getElementById('cps-amount') as HTMLInputElement).value) || 10;
      const oddsMult = parseFloat((document.getElementById('cps-odds') as HTMLInputElement).value) || 0;
      const rollsHr = parseInt((document.getElementById('cps-rolls') as HTMLInputElement).value) || 100;

      interface BetInfo { winProb: number; edge: number; payout: string; name: string; }
      const bets: Record<string, BetInfo> = {
        'pass':     { winProb: 244/495, edge: 0.0141, payout: '1:1', name: 'Pass Line' },
        'dontpass': { winProb: 949/1980, edge: 0.0136, payout: '1:1', name: "Don't Pass" },
        'come':     { winProb: 244/495, edge: 0.0141, payout: '1:1', name: 'Come' },
        'dontcome': { winProb: 949/1980, edge: 0.0136, payout: '1:1', name: "Don't Come" },
        'field':    { winProb: 16/36, edge: 0.0556, payout: '1:1 (2:1 bei 2,12)', name: 'Field' },
        'any7':     { winProb: 6/36, edge: 0.1667, payout: '4:1', name: 'Any 7' },
        'any11':    { winProb: 4/36, edge: 0.1111, payout: '7:1', name: 'Any Craps' },
        'hard6':    { winProb: 1/36, edge: 0.0909, payout: '9:1', name: 'Hard 6' },
        'hard8':    { winProb: 1/36, edge: 0.0909, payout: '9:1', name: 'Hard 8' },
        'hard4':    { winProb: 1/36, edge: 0.1111, payout: '7:1', name: 'Hard 4' },
        'hard10':   { winProb: 1/36, edge: 0.1111, payout: '7:1', name: 'Hard 10' },
        'place6':   { winProb: 5/11, edge: 0.0152, payout: '7:6', name: 'Place 6' },
        'place8':   { winProb: 5/11, edge: 0.0152, payout: '7:6', name: 'Place 8' },
        'place5':   { winProb: 4/10, edge: 0.0400, payout: '7:5', name: 'Place 5' },
        'place9':   { winProb: 4/10, edge: 0.0400, payout: '7:5', name: 'Place 9' },
        'place4':   { winProb: 3/9, edge: 0.0667, payout: '9:5', name: 'Place 4' },
        'place10':  { winProb: 3/9, edge: 0.0667, payout: '9:5', name: 'Place 10' },
      };

      const info = bets[bet];
      let effectiveEdge = info.edge;

      if ((bet === 'pass' || bet === 'dontpass' || bet === 'come' || bet === 'dontcome') && oddsMult > 0) {
        const totalBet = amount + amount * oddsMult;
        const houseEdgeTotal = (info.edge * amount) / totalBet;
        effectiveEdge = houseEdgeTotal;
      }

      const evPerBet = -amount * effectiveEdge;
      const betsPerHour = rollsHr * 0.35;
      const lossHour = Math.abs(evPerBet) * betsPerHour;

      document.getElementById('cps-prob')!.textContent = (info.winProb * 100).toFixed(2).replace('.', ',') + ' %';
      document.getElementById('cps-edge')!.textContent = (effectiveEdge * 100).toFixed(2).replace('.', ',') + ' %';
      document.getElementById('cps-payout')!.textContent = info.payout;
      document.getElementById('cps-ev')!.textContent = '-' + Math.abs(evPerBet).toFixed(3).replace('.', ',') + ' \u20AC';
      document.getElementById('cps-hour')!.textContent = '-' + lossHour.toFixed(2).replace('.', ',') + ' \u20AC';

      const sorted = Object.entries(bets).sort((a, b) => a[1].edge - b[1].edge);
      let html = '';
      for (const [key, b] of sorted) {
        const marker = key === bet ? ' font-bold text-primary' : '';
        html += '<div class="flex justify-between py-0.5 border-b border-border' + marker + '"><span>' + b.name + '</span><span>Vorteil: ' + (b.edge * 100).toFixed(2).replace('.', ',') + ' % | Gewinn: ' + (b.winProb * 100).toFixed(1).replace('.', ',') + ' %</span></div>';
      }
      document.getElementById('cps-table')!.innerHTML = html;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.cps-in').forEach(el => { el.addEventListener('input', calcCPS); el.addEventListener('change', calcCPS); });
      calcCPS();
    }, 50);
  </script>
</CalculatorLayout>
