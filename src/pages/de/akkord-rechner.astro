---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Akkord Rechner - Akkordtöne, Umkehrungen & Progressionen";
const description = "Berechnen Sie Akkordtöne, Umkehrungen und Akkordprogressionen für jede Tonart und jeden Akkordtyp.";
const relatedCalcs = [
  { name: "Musik-Tonart Rechner", url: "/de/musik-tonart-rechner", description: "Tonarten ermitteln." },
  { name: "Musik-Intervall Rechner", url: "/de/musik-intervall-rechner", description: "Intervalle berechnen." },
  { name: "Namen Generator", url: "/de/namen-generator", description: "Namen generieren." },
  { name: "Newton-Verfahren Rechner", url: "/de/newton-verfahren-rechner", description: "Mathematische Berechnungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Akkord Rechner" enSlug="music-theory-chord-calculator" keywords="Akkord berechnen, Akkordtöne, Umkehrung, Akkordprogression, Musiktheorie, Dur Moll Septakkord" breadcrumbs={[{ name: "Akkord Rechner", url: "/de/akkord-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Akkord Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Ermitteln Sie die Töne eines Akkords, seine Umkehrungen und häufige Akkordprogressionen in einer Tonart.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Grundton</label>
            <select id="ak-root" class="ak-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0">C</option><option value="1">C# / Des</option><option value="2">D</option>
              <option value="3">D# / Es</option><option value="4">E</option><option value="5">F</option>
              <option value="6">F# / Ges</option><option value="7">G</option><option value="8">G# / As</option>
              <option value="9">A</option><option value="10">A# / B</option><option value="11">H</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Akkordtyp</label>
            <select id="ak-type" class="ak-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0,4,7">Dur (Major)</option>
              <option value="0,3,7">Moll (Minor)</option>
              <option value="0,4,7,11">Major7</option>
              <option value="0,3,7,10">Minor7</option>
              <option value="0,4,7,10">Dominant7</option>
              <option value="0,3,6">Vermindert (dim)</option>
              <option value="0,4,8">Übermäßig (aug)</option>
              <option value="0,5,7">Sus4</option>
              <option value="0,2,7">Sus2</option>
              <option value="0,4,7,9">Major6</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Akkord</div>
          <div class="text-4xl font-extrabold font-mono" id="ak-result">—</div>
          <div class="text-sm text-blue-200 mt-1" id="ak-sub"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Akkordtöne</h3>
          <div class="flex flex-wrap gap-2" id="ak-tones"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Umkehrungen</h3>
          <div class="space-y-1 text-sm font-mono" id="ak-inversions"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Häufige Progressionen (in dieser Tonart)</h3>
          <div class="space-y-1 text-sm" id="ak-progressions"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="akkord" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Akkorde in der Musiktheorie</h2>
      <p>Ein Akkord entsteht, wenn drei oder mehr Töne gleichzeitig gespielt werden. Die gebräuchlichsten Akkorde sind Dreiklänge (Dur, Moll, vermindert, übermäßig) und Vierklänge (Septakkorde). Umkehrungen entstehen, wenn ein anderer Ton als der Grundton im Bass liegt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div><p><strong>Was ist eine Akkordumkehrung?</strong></p><p>Bei der ersten Umkehrung liegt die Terz im Bass, bei der zweiten die Quinte. Umkehrungen klingen weicher als der Grundakkord.</p></div>
        <div><p><strong>Was ist ein Septakkord?</strong></p><p>Ein Septakkord besteht aus vier Tönen: Grundton, Terz, Quinte und Septime. Der Dominantseptakkord (z.B. G7) erzeugt starke harmonische Spannung.</p></div>
        <div><p><strong>Was ist eine Akkordprogression?</strong></p><p>Eine Abfolge von Akkorden. Die beliebteste Pop-Progression ist I–V–vi–IV, z.B. in C-Dur: C – G – Am – F.</p></div>
        <div><p><strong>Was bedeutet Sus?</strong></p><p>Sus (suspended) bedeutet, die Terz wird durch eine andere Note ersetzt. Sus4 enthält die Quarte, Sus2 die Sekunde statt der Terz.</p></div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const NOTES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','H'];
    const CHORD_NAMES: Record<string, string> = {
      '0,4,7': 'Dur', '0,3,7': 'Moll', '0,4,7,11': 'Major7',
      '0,3,7,10': 'Minor7', '0,4,7,10': 'Dom7', '0,3,6': 'dim',
      '0,4,8': 'aug', '0,5,7': 'sus4', '0,2,7': 'sus2', '0,4,7,9': 'Maj6'
    };
    const PROGRESSIONS = [
      { name: 'Pop (I–V–vi–IV)', steps: [0, 7, 9, 5] },
      { name: 'Blues (I–IV–V)', steps: [0, 5, 7] },
      { name: 'Pachelbel (I–V–vi–iii–IV–I–IV–V)', steps: [0, 7, 9, 4, 5, 0, 5, 7] },
      { name: '50er Jahre (I–vi–IV–V)', steps: [0, 9, 5, 7] },
    ];
    function calcAK() {
      const root = parseInt((document.getElementById('ak-root') as HTMLSelectElement).value) || 0;
      const typeStr = (document.getElementById('ak-type') as HTMLSelectElement).value;
      const intervals = typeStr.split(',').map(Number);
      const tones = intervals.map(i => NOTES[(root + i) % 12]);
      const chordName = NOTES[root] + ' ' + (CHORD_NAMES[typeStr] || '');
      const inversions = tones.map((_, invIdx) => {
        const inv = [...tones.slice(invIdx), ...tones.slice(0, invIdx)];
        const invName = invIdx === 0 ? 'Grundstellung' : invIdx === 1 ? '1. Umkehrung' : invIdx === 2 ? '2. Umkehrung' : '3. Umkehrung';
        return invName + ': ' + inv.join(' – ');
      });
      const durSteps = [0,4,7];
      const progs = PROGRESSIONS.map(p => {
        const chords = p.steps.map(s => NOTES[(root + s) % 12] + ' Dur');
        return p.name + ': ' + chords.join(' – ');
      });
      document.getElementById('ak-result')!.textContent = chordName;
      document.getElementById('ak-sub')!.textContent = tones.join(' – ');
      document.getElementById('ak-tones')!.innerHTML = tones.map((n, i) => {
        const labels = ['Grundton','Terz','Quinte','Septime','Sexte'];
        return '<span class="px-3 py-1 bg-primary text-white rounded-lg font-bold text-sm">' + n + ' (' + (labels[i] || (i+1)+'.') + ')</span>';
      }).join('');
      document.getElementById('ak-inversions')!.innerHTML = inversions.map(s => '<div>' + s + '</div>').join('');
      document.getElementById('ak-progressions')!.innerHTML = progs.map(p => '<div class="text-text-muted">' + p + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ak-in').forEach(el => { el.addEventListener('input', calcAK); el.addEventListener('change', calcAK); });
      calcAK();
    }, 50);
  </script>
</CalculatorLayout>
