---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Betonmischungs-Rechner - Mischungsverh\u00e4ltnisse nach Festigkeitsklasse";
const description = "Berechnen Sie Betonmischungsverh\u00e4ltnisse f\u00fcr Zement, Sand, Kies und Wasser nach Zielfestigkeit. Pr\u00e4zise Chargengewichte f\u00fcr jedes Betonvolumen.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Betonplattenrechner", url: "/de/betonplatte-rechner", description: "Plattenvolumen." },
  { name: "Betonh\u00e4rtungsrechner", url: "/de/betonhaertung-rechner", description: "Aush\u00e4rtungszeit." },
  { name: "Betonzusatzmittelrechner", url: "/de/betonzusatzmittel-rechner", description: "Zusatzmittel." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Betonmischungs-Rechner" lang="de" enSlug="concrete-mix-calculator" keywords="betonmischung, mischungsverh\u00e4ltnis, zement sand kies, betonfestigkeit, wasserzementwert, chargengewicht" breadcrumbs={[{ name: "Betonmischung", url: "/de/betonmischung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Betonmischungs-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Entwerfen Sie Betonmischungsverh&auml;ltnisse f&uuml;r Zement, Sand, Kies und Wasser nach Festigkeitsklasse.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-text mb-2">Festigkeitsklasse</label>
          <select id="bm-grade" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="C20">C20/25 - Fundamente, nicht tragend</option>
            <option value="C25" selected>C25/30 - Bodenplatten, Gehwege</option>
            <option value="C30">C30/37 - Tragwerke, Decken</option>
            <option value="C35">C35/45 - Hochbau, vorgespannt</option>
            <option value="C40">C40/50 - Hochleistungsbeton</option>
            <option value="C45">C45/55 - Spezialanwendungen</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-2">Ben&ouml;tigtes Volumen (m&sup3;)</label><input type="number" id="bm-volume" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0.1" step="0.1"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Gr&ouml;&szlig;tkorn</label>
          <select id="bm-agg" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="8">8 mm</option>
            <option value="16" selected>16 mm</option>
            <option value="22">22 mm</option>
            <option value="32">32 mm</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Zementart</label>
          <select id="bm-cement" class="bm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="I" selected>CEM I - Portlandzement</option>
            <option value="II">CEM II - Portlandkompositzement</option>
            <option value="III">CEM III - Hochofenzement</option>
          </select>
        </div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mischungsverh&auml;ltnis (Zement : Sand : Kies)</div>
          <div class="text-4xl font-extrabold" id="bm-ratio">1 : 2 : 3</div>
          <div class="text-sm text-blue-200 mt-1">Wasserzementwert: <span id="bm-wc">0,50</span></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zement (25 kg S&auml;cke)</div><div class="text-2xl font-bold" id="bm-bags">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zementgewicht</div><div class="text-2xl font-bold" id="bm-cement-wt">0 kg</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sand</div><div class="text-2xl font-bold" id="bm-sand">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kies</div><div class="text-2xl font-bold" id="bm-gravel">0 kg</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser</div><div class="text-2xl font-bold" id="bm-water">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-2xl font-bold" id="bm-total">0 kg</div></div>
        </div>
      </div>
      <ShareButton calculatorId="concrete-mix" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Betonmischungsentwurf</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Wasserzementwert:</strong> Niedriger = h&ouml;here Festigkeit, aber geringere Verarbeitbarkeit</p>
        <p><strong>Zementgehalt:</strong> Volumen (m&sup3;) &times; Zementfaktor (kg/m&sup3;)</p>
        <p><strong>Sand &amp; Kies:</strong> Basierend auf Verh&auml;ltnisanteilen zum Zementgewicht</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">G&auml;ngige Mischungsverh&auml;ltnisse</h3>
      <ul>
        <li><strong>C20/25:</strong> 1 : 2,5 : 3,5 mit w/z 0,62</li>
        <li><strong>C25/30:</strong> 1 : 2 : 3 mit w/z 0,55</li>
        <li><strong>C35/45:</strong> 1 : 1,5 : 2,5 mit w/z 0,45</li>
        <li><strong>C45/55:</strong> 1 : 1 : 2 mit w/z 0,35</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    interface MixDesign { ratio: string; wc: number; cementFactor: number; sandRatio: number; gravelRatio: number; }
    const bmDesigns: Record<string, MixDesign> = {
      'C20': { ratio: '1 : 2,5 : 3,5', wc: 0.62, cementFactor: 280, sandRatio: 2.5, gravelRatio: 3.5 },
      'C25': { ratio: '1 : 2 : 3', wc: 0.55, cementFactor: 320, sandRatio: 2.0, gravelRatio: 3.0 },
      'C30': { ratio: '1 : 1,75 : 2,75', wc: 0.50, cementFactor: 350, sandRatio: 1.75, gravelRatio: 2.75 },
      'C35': { ratio: '1 : 1,5 : 2,5', wc: 0.45, cementFactor: 380, sandRatio: 1.5, gravelRatio: 2.5 },
      'C40': { ratio: '1 : 1,25 : 2,25', wc: 0.40, cementFactor: 400, sandRatio: 1.25, gravelRatio: 2.25 },
      'C45': { ratio: '1 : 1 : 2', wc: 0.35, cementFactor: 420, sandRatio: 1.0, gravelRatio: 2.0 },
    };
    function calcBM() {
      const grade = (document.getElementById('bm-grade') as HTMLSelectElement).value;
      const volume = parseFloat((document.getElementById('bm-volume') as HTMLInputElement).value) || 0;
      const design = bmDesigns[grade] || bmDesigns['C25'];
      const cementKg = design.cementFactor * volume;
      const sandKg = cementKg * design.sandRatio;
      const gravelKg = cementKg * design.gravelRatio;
      const waterKg = cementKg * design.wc;
      const waterL = waterKg; // 1 kg water = 1 L
      const totalKg = cementKg + sandKg + gravelKg + waterKg;
      const bags = Math.ceil(cementKg / 25);
      const fmt = (v: number) => Math.round(v).toLocaleString('de-DE');
      document.getElementById('bm-ratio')!.textContent = design.ratio;
      document.getElementById('bm-wc')!.textContent = design.wc.toFixed(2).replace('.', ',');
      document.getElementById('bm-bags')!.textContent = bags.toLocaleString('de-DE');
      document.getElementById('bm-cement-wt')!.textContent = fmt(cementKg) + ' kg';
      document.getElementById('bm-sand')!.textContent = fmt(sandKg) + ' kg';
      document.getElementById('bm-gravel')!.textContent = fmt(gravelKg) + ' kg';
      document.getElementById('bm-water')!.textContent = waterL.toFixed(0) + ' L';
      document.getElementById('bm-total')!.textContent = fmt(totalKg) + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bm-in').forEach(el => { el.addEventListener('input', calcBM); el.addEventListener('change', calcBM); });
      calcBM();
    }, 50);
  </script>
</CalculatorLayout>
