---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Ergonomischer Schreibtisch-Rechner";
const description = "Berechnen Sie die ideale Schreibtischh\u00f6he, Stuhh\u00f6he, Monitorposition und Tastaturplatzierung basierend auf Ihrer K\u00f6rpergr\u00f6\u00dfe.";
const relatedCalcs = [
  { name: "Emotionale Intelligenz", url: "/de/emotionale-intelligenz-rechner", description: "EQ-Bewertung." },
  { name: "Mitarbeiterfluktuation", url: "/de/mitarbeiterfluktuation-rechner", description: "Fluktuationskosten." },
  { name: "Notgroschen-Rechner", url: "/de/notgroschen-rechner", description: "Notfallreserve." },
  { name: "Stromverbrauch-Rechner", url: "/de/stromverbrauch-rechner", description: "Stromkosten." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Ergonomischer Schreibtisch-Rechner" lang="de" enSlug="ergonomic-desk-calculator" keywords="ergonomischer schreibtisch, schreibtischh\u00f6he rechner, stuhh\u00f6he, monitorposition, stehschreibtisch, tastaturh\u00f6he" breadcrumbs={[{ name: "Ergonomischer Schreibtisch", url: "/de/ergonomischer-schreibtisch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ergonomischer Schreibtisch-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Ihre ideale Schreibtisch-, Stuhl- und Monitoreinstellung basierend auf Ihrer K&ouml;rpergr&ouml;&szlig;e.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="esde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-mode="sit">Sitzen</button>
          <button class="esde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="stand">Stehen</button>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">K&ouml;rpergr&ouml;&szlig;e (cm)</label>
          <input type="number" id="esde-cm" class="esde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="175" min="140" max="220" step="1">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Schreibtischh&ouml;he</div>
          <div class="text-5xl font-extrabold font-mono" id="esde-desk">0 cm</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stuhlh&ouml;he</div><div class="text-xl font-bold font-mono" id="esde-chair">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monitoroberkante</div><div class="text-xl font-bold font-mono" id="esde-monitor">0 cm</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tastaturh&ouml;he</div><div class="text-xl font-bold font-mono" id="esde-keyboard">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Monitorabstand</div><div class="text-xl font-bold font-mono" id="esde-distance">0 cm</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Einstellungstipps</h3>
          <div class="text-xs space-y-1" id="esde-tips"></div>
        </div>
      </div>
      <ShareButton calculatorId="ergonomic-desk-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Ergonomie am Arbeitsplatz</h2>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist die richtige Schreibtischh&ouml;he?</strong> Die optimale Schreibtischh&ouml;he h&auml;ngt von Ihrer K&ouml;rpergr&ouml;&szlig;e ab. Die Ellbogen sollten im 90&deg;-Winkel aufliegen k&ouml;nnen.</p>
      <p><strong>Wie oft zwischen Sitzen und Stehen wechseln?</strong> Experten empfehlen, alle 30-60 Minuten die Position zu wechseln.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    let esdeMode = 'sit';
    function calcESDE() {
      const heightCm = parseFloat((document.getElementById('esde-cm') as HTMLInputElement).value) || 175;
      let deskCm: number, chairCm: number, monitorTopCm: number, keyboardCm: number, monDistCm: number;
      if (esdeMode === 'sit') {
        deskCm = heightCm * 0.285;
        chairCm = heightCm * 0.25;
        keyboardCm = deskCm - 3.5;
        monitorTopCm = chairCm + heightCm * 0.27;
        monDistCm = 50 + (heightCm - 160) * 0.25;
      } else {
        deskCm = heightCm * 0.405;
        chairCm = 0;
        keyboardCm = deskCm - 3.5;
        monitorTopCm = heightCm * 0.555;
        monDistCm = 55 + (heightCm - 160) * 0.25;
      }
      document.getElementById('esde-desk')!.textContent = deskCm.toFixed(0) + ' cm';
      document.getElementById('esde-chair')!.textContent = esdeMode === 'sit' ? chairCm.toFixed(0) + ' cm' : 'Entf\u00E4llt';
      document.getElementById('esde-monitor')!.textContent = monitorTopCm.toFixed(0) + ' cm';
      document.getElementById('esde-keyboard')!.textContent = keyboardCm.toFixed(0) + ' cm';
      document.getElementById('esde-distance')!.textContent = Math.max(45, monDistCm).toFixed(0) + ' cm';
      const tips = esdeMode === 'sit' ? [
        '<div>F\u00FC\u00DFe flach auf dem Boden, Oberschenkel parallel zum Boden</div>',
        '<div>Ellbogen im 90-100\u00B0-Winkel beim Tippen</div>',
        '<div>Monitoroberkante auf oder leicht unter Augenh\u00F6he</div>',
        '<div>Bildschirmabstand: ungef\u00E4hr eine Arml\u00E4nge</div>',
        '<div>Unterr\u00FCcken durch Lordosenst\u00FCtze gest\u00FCtzt</div>',
      ] : [
        '<div>Gewicht gleichm\u00E4\u00DFig auf beide F\u00FC\u00DFe verteilen</div>',
        '<div>Ellbogen im 90\u00B0-Winkel bei seitlich h\u00E4ngenden Armen</div>',
        '<div>Monitoroberkante auf Augenh\u00F6he oder leicht darunter</div>',
        '<div>Anti-Erm\u00FCdungsmatte f\u00FCr Komfort verwenden</div>',
        '<div>Alle 30-60 Min. zwischen Sitzen und Stehen wechseln</div>',
      ];
      document.getElementById('esde-tips')!.innerHTML = tips.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.esde-mode').forEach(b => b.addEventListener('click', () => {
        esdeMode = (b as HTMLButtonElement).dataset.mode!;
        document.querySelectorAll('.esde-mode').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.mode === esdeMode;
          (btn as HTMLButtonElement).className = 'esde-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        calcESDE();
      }));
      document.querySelectorAll('.esde-in').forEach(el => { el.addEventListener('input', calcESDE); el.addEventListener('change', calcESDE); });
      calcESDE();
    }, 50);
  </script>
</CalculatorLayout>
