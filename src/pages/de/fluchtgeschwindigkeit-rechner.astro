---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Fluchtgeschwindigkeit-Rechner";
const description = "Berechnen Sie die Fluchtgeschwindigkeit, die ben\u00f6tigt wird, um das Gravitationsfeld eines Planeten oder Himmelsk\u00f6rpers zu verlassen.";
const relatedCalcs = [
  { name: "Erosion-Rechner", url: "/de/erosion-rechner", description: "Bodenerosion." },
  { name: "H\u00f6henunterschied-Rechner", url: "/de/hoehenunterschied-rechner", description: "H\u00f6henberechnung." },
  { name: "Energieumrechner", url: "/de/energieumrechner", description: "Energieeinheiten." },
  { name: "Gleichungsl\u00f6ser", url: "/de/gleichungsloeser", description: "Gleichungen l\u00f6sen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Fluchtgeschwindigkeit-Rechner" lang="de" enSlug="escape-velocity-calculator" keywords="fluchtgeschwindigkeit, gravitationsflucht, orbitalmechanik, weltraumgeschwindigkeit, gravitation" breadcrumbs={[{ name: "Fluchtgeschwindigkeit", url: "/de/fluchtgeschwindigkeit-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Fluchtgeschwindigkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">v = &radic;(2GM/r) &mdash; Fluchtgeschwindigkeit f&uuml;r jedes Gravitationsfeld berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Vorauswahl</label>
          <select id="fgde-preset" class="fgde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="custom">Eigene Werte</option>
            <option value="earth" selected>Erde</option>
            <option value="moon">Mond</option>
            <option value="mars">Mars</option>
            <option value="jupiter">Jupiter</option>
            <option value="sun">Sonne</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Masse (kg)</label><input type="text" id="fgde-mass" class="fgde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.972e24"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Radius (m)</label><input type="text" id="fgde-radius" class="fgde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6.371e6"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Fluchtgeschwindigkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="fgde-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">km/h</div><div class="text-xl font-bold font-mono" id="fgde-kmh">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mach (Meeresspiegelniveau)</div><div class="text-xl font-bold font-mono" id="fgde-mach">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Oberfl&auml;chengravitation</div><div class="text-xl font-bold font-mono" id="fgde-grav">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">% Lichtgeschwindigkeit</div><div class="text-xl font-bold font-mono" id="fgde-light">0%</div></div>
        </div>
      </div>
      <ShareButton calculatorId="escape-velocity-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist Fluchtgeschwindigkeit?</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>v_esc = &radic;(2GM/r)</p>
        <p>G = 6,674 &times; 10&sup1;&sup1; N&middot;m&sup2;/kg&sup2;</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie schnell ist die Fluchtgeschwindigkeit der Erde?</strong> Etwa 11,2 km/s oder 40.320 km/h von der Erdoberfl&auml;che.</p>
      <p><strong>H&auml;ngt sie von der Masse des Objekts ab?</strong> Nein, die Fluchtgeschwindigkeit ist unabh&auml;ngig von der Masse des fliehenden Objekts.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const fgdeG = 6.674e-11;
    const fgdePresets: Record<string, [number, number]> = {
      earth: [5.972e24, 6.371e6],
      moon: [7.342e22, 1.737e6],
      mars: [6.417e23, 3.390e6],
      jupiter: [1.898e27, 6.991e7],
      sun: [1.989e30, 6.957e8],
    };
    function calcFGDE() {
      const preset = (document.getElementById('fgde-preset') as HTMLSelectElement).value;
      if (preset !== 'custom' && fgdePresets[preset]) {
        (document.getElementById('fgde-mass') as HTMLInputElement).value = fgdePresets[preset][0].toExponential(3);
        (document.getElementById('fgde-radius') as HTMLInputElement).value = fgdePresets[preset][1].toExponential(3);
      }
      const mass = parseFloat((document.getElementById('fgde-mass') as HTMLInputElement).value) || 0;
      const radius = parseFloat((document.getElementById('fgde-radius') as HTMLInputElement).value) || 1;
      const vEsc = Math.sqrt(2 * fgdeG * mass / radius);
      const kmh = vEsc * 3.6;
      const mach = vEsc / 343;
      const gSurface = fgdeG * mass / (radius * radius);
      const pctLight = (vEsc / 3e8) * 100;
      document.getElementById('fgde-result')!.textContent = vEsc.toFixed(0) + ' m/s';
      document.getElementById('fgde-kmh')!.textContent = kmh.toLocaleString('de-DE', { maximumFractionDigits: 0 });
      document.getElementById('fgde-mach')!.textContent = mach.toFixed(1).replace('.', ',');
      document.getElementById('fgde-grav')!.textContent = gSurface.toFixed(2).replace('.', ',') + ' m/s\u00B2';
      document.getElementById('fgde-light')!.textContent = pctLight.toFixed(4).replace('.', ',') + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fgde-in').forEach(el => { el.addEventListener('input', calcFGDE); el.addEventListener('change', calcFGDE); });
      calcFGDE();
    }, 50);
  </script>
</CalculatorLayout>
