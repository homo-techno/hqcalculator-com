---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Passwort Generator - Sichere Zufallspasswörter";
const description = "Generieren Sie sichere, zufällige Passwörter nach Ihren Anforderungen. Wählen Sie Länge, Zeichentypen und Anzahl der Passwörter.";

const relatedCalcs = [
  { name: "Hash-Rechner", url: "/de/hash-rechner", description: "Hashwerte." },
  { name: "Verschlüsselungs-Rechner", url: "/de/verschluesselungs-rechner", description: "Verschlüsselung." },
  { name: "Zufallszahlengenerator", url: "/de/zufallszahlen-rechner", description: "Zufallszahlen." },
  { name: "Bit-Rechner", url: "/de/bit-rechner", description: "Bits und Bytes." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Passwort Generator" lang="de" enSlug="password-generator" keywords="passwort generator, sicheres passwort erstellen, zufallspasswort, starkes passwort, passwort stärke" breadcrumbs={[{ name: "Passwort Generator", url: "/de/passwort-generator" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Passwort Generator</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Erstellen Sie sichere, zufällige Passwörter nach Ihren Sicherheitsanforderungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Passwortlänge</label><input type="number" id="pwg-len" class="pwg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="16" min="4" max="128" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Passwörter</label><input type="number" id="pwg-count" class="pwg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="20" step="1"></div>
        </div>
        <div class="space-y-2">
          <label class="block text-xs font-medium text-text mb-1">Zeichentypen</label>
          <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="pwg-upper" class="pwg-in" checked> <span class="text-sm">Großbuchstaben (A–Z)</span></label>
          <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="pwg-lower" class="pwg-in" checked> <span class="text-sm">Kleinbuchstaben (a–z)</span></label>
          <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="pwg-digits" class="pwg-in" checked> <span class="text-sm">Ziffern (0–9)</span></label>
          <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="pwg-special" class="pwg-in" checked> <span class="text-sm">Sonderzeichen (!@#$%^&amp;*)</span></label>
          <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" id="pwg-noambig" class="pwg-in"> <span class="text-sm">Mehrdeutige Zeichen ausschließen (0, O, l, 1)</span></label>
        </div>
        <button id="pwg-btn" class="w-full px-4 py-3 bg-primary text-white font-bold rounded-xl hover:bg-primary/90 transition-colors">Passwörter generieren</button>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Passwort-Entropie</div>
          <div class="text-4xl font-extrabold font-mono" id="pwg-entropy">0 Bit</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zeichenpool</div><div class="text-xl font-bold" id="pwg-pool">0 Zeichen</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Stärke</div><div class="text-xl font-bold" id="pwg-strength">-</div></div>
        </div>
        <div class="space-y-2" id="pwg-list"></div>
      </div>
      <ShareButton calculatorId="passwort-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Sichere Passwörter erstellen</h2>
      <p class="text-text-secondary mt-2">Ein sicheres Passwort sollte mindestens 12 Zeichen lang sein und Groß- und Kleinbuchstaben, Ziffern sowie Sonderzeichen enthalten. Die Passwortstärke wird in Bit Entropie gemessen. Bei 128 Zeichen Zeichenpool und 16 Zeichen Länge ergibt sich eine Entropie von etwa 104 Bit – damit würde ein Angreifer mit einem modernen Computer Milliarden von Jahren benötigen, um das Passwort durch Brute-Force zu knacken.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Entropie (Bit):</strong> Passwortlänge × log2(Zeichenpool-Größe)</p>
        <p><strong>Sicher ab:</strong> ca. 80 Bit für persönliche Konten</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lang sollte ein sicheres Passwort sein?</strong> Das BSI (Bundesamt für Sicherheit in der Informationstechnik) empfiehlt mindestens 8 Zeichen, besser 12 oder mehr. Für hochsensible Zugänge (Banking, E-Mail) sollten es 16+ Zeichen sein.</p>
      <p><strong>Soll ich Sonderzeichen verwenden?</strong> Ja, Sonderzeichen vergrößern den Zeichenpool erheblich und erhöhen die Entropie. Viele Webseiten verlangen sie ohnehin.</p>
      <p><strong>Wie speichere ich viele verschiedene Passwörter?</strong> Verwenden Sie einen Passwort-Manager wie KeePass, Bitwarden oder 1Password. Nie dasselbe Passwort für mehrere Dienste verwenden.</p>
      <p><strong>Was ist Zwei-Faktor-Authentifizierung (2FA)?</strong> 2FA fügt einen zweiten Sicherheitsschritt hinzu (z.B. SMS-Code oder Authenticator-App). Auch bei einem geleakten Passwort ist das Konto dann noch geschützt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function generatePWG() {
      const len = parseInt((document.getElementById('pwg-len') as HTMLInputElement).value) || 16;
      const count = parseInt((document.getElementById('pwg-count') as HTMLInputElement).value) || 5;
      const useUpper = (document.getElementById('pwg-upper') as HTMLInputElement).checked;
      const useLower = (document.getElementById('pwg-lower') as HTMLInputElement).checked;
      const useDigits = (document.getElementById('pwg-digits') as HTMLInputElement).checked;
      const useSpecial = (document.getElementById('pwg-special') as HTMLInputElement).checked;
      const noAmbig = (document.getElementById('pwg-noambig') as HTMLInputElement).checked;

      let pool = '';
      if (useUpper) pool += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      if (useLower) pool += 'abcdefghijklmnopqrstuvwxyz';
      if (useDigits) pool += '0123456789';
      if (useSpecial) pool += '!@#$%^&*()-_=+[]{}|;:,.<>?';
      if (noAmbig) pool = pool.replace(/[0Ol1I]/g, '');
      if (!pool) pool = 'abcdefghijklmnopqrstuvwxyz';

      const entropy = len * Math.log2(pool.length);
      const strength = entropy < 40 ? 'Sehr schwach' : entropy < 60 ? 'Schwach' : entropy < 80 ? 'Mittel' : entropy < 100 ? 'Stark' : 'Sehr stark';
      const strengthColor = entropy < 40 ? 'text-red-700' : entropy < 60 ? 'text-orange-600' : entropy < 80 ? 'text-yellow-700' : 'text-green-700';

      const passwords: string[] = [];
      for (let p = 0; p < count; p++) {
        const arr = new Uint8Array(len * 2);
        crypto.getRandomValues(arr);
        let pw = '';
        let i = 0;
        while (pw.length < len && i < arr.length) {
          const idx = arr[i] % pool.length;
          pw += pool[idx];
          i++;
        }
        while (pw.length < len) pw += pool[0];
        passwords.push(pw);
      }

      document.getElementById('pwg-entropy')!.textContent = entropy.toFixed(1).replace('.', ',') + ' Bit';
      document.getElementById('pwg-pool')!.textContent = pool.length.toString();
      const se = document.getElementById('pwg-strength')!;
      se.textContent = strength;
      se.className = 'text-xl font-bold ' + strengthColor;
      document.getElementById('pwg-list')!.innerHTML = passwords.map((pw, i) =>
        '<div class="flex items-center gap-2 p-3 bg-surface-alt rounded-xl"><span class="text-xs text-text-muted w-4">' + (i + 1) + '</span><code class="flex-1 text-sm font-mono break-all">' + pw + '</code><button class="pwg-copy text-xs px-2 py-1 bg-primary text-white rounded" data-pw="' + pw + '">Kopieren</button></div>'
      ).join('');

      document.querySelectorAll('.pwg-copy').forEach(btn => {
        btn.addEventListener('click', () => {
          const pw = (btn as HTMLElement).dataset.pw || '';
          navigator.clipboard.writeText(pw).catch(() => {});
          btn.textContent = 'Kopiert!';
          setTimeout(() => { btn.textContent = 'Kopieren'; }, 1500);
        });
      });
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.pwg-in').forEach(el => { el.addEventListener('input', generatePWG); el.addEventListener('change', generatePWG); });
      document.getElementById('pwg-btn')!.addEventListener('click', generatePWG);
      generatePWG();
    }, 50);
  </script>
</CalculatorLayout>
