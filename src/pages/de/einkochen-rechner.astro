---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Einkochen Rechner - Glaeser, Zeit & Fuellhoehe 2026";
const description = "Berechne die Anzahl benotigter Einmachglaeser, Einweichzeit nach Hoehe und Fuellhoehe fuer Einkochen. Kostenloser Einmach-Rechner.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparziel planen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Einkochen-Rechner" keywords="Einkochen Rechner, Einmachglaeser, Einkochzeit, Fuellhoehe, Einkochen Hoehenkorrektur, Einmachen Tipp" breadcrumbs={[{ name: "Einkochen-Rechner", url: "/de/einkochen-rechner" }]} lang="de" enSlug="home-canning-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Einkochen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne Glasanzahl, Einkochzeit und Fuellhoehe fuer deine Einkochsession.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Produkt</label>
          <select id="ekr-prod" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="tomatoes" selected>Tomaten</option>
            <option value="peaches">Pfirsiche</option>
            <option value="applesauce">Apfelmus</option>
            <option value="greenbeans">Gruene Bohnen</option>
            <option value="pickles">Gurken / Essiggurken</option>
            <option value="jam">Marmelade / Gelee</option>
            <option value="salsa">Salsa</option>
            <option value="corn">Mais</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht der Fruechte/Gemuese (kg)</label><input type="number" id="ekr-wt" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.5" step="0.5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Glasgroesse</label>
            <select id="ekr-jar" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="250">250 ml (Klein)</option>
              <option value="500" selected>500 ml (Standard)</option>
              <option value="750">750 ml (Gross)</option>
              <option value="1000">1.000 ml (Liter)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Standorthoehe (m NN)</label><input type="number" id="ekr-alt" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="300" min="0" max="3000" step="100"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Methode</label>
            <select id="ekr-method" class="ekr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="waterbath" selected>Wasserbad (Einkochtopf)</option>
              <option value="pressure">Dampfdrucktopf</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benoetigte Glaeser</div>
          <div class="text-4xl font-extrabold font-mono" id="ekr-result">0 Glaeser</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einkochzeit</div><div class="text-xl font-bold font-mono" id="ekr-time">0 Min</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fuellhoehe</div><div class="text-xl font-bold font-mono" id="ekr-head">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wasser benoetigt</div><div class="text-xl font-bold font-mono" id="ekr-water">0 l</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Deckel benoetigt</div><div class="text-xl font-bold font-mono" id="ekr-lids">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtertrag</div><div class="text-xl font-bold font-mono" id="ekr-yield">0 ml</div></div>
        </div>
      </div>

      <ShareButton calculatorId="home-canning" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Tipps fuer sicheres Einkochen</h2>
      <p>Beim Einkochen werden Lebensmittel durch Hitze haltbar gemacht. Die richtige Einkochzeit und Fuellhoehe sind entscheidend fuer die Haltbarkeit und Sicherheit der eingemachten Produkte.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Warum ist die Hoehe wichtig?</strong> In groesseren Hoehen kocht Wasser bei niedrigeren Temperaturen. Deshalb muss die Einkochzeit mit zunehmender Hoehe verlaengert werden, um sichere Temperaturen zu erreichen.</p>
      <p><strong>Was ist die richtige Fuellhoehe?</strong> Fuer die meisten Produkte gilt 1-2 cm Abstand zum Glasrand. Fuer Marmeladen reichen 0,5 cm. Zu viel oder zu wenig Abstand verhindert eine gute Versiegelung.</p>
      <p><strong>Wie lange sind eingekochte Produkte haltbar?</strong> Richtig eingekochte Produkte halten 1-2 Jahre. Immer Datum und Inhalt beschriften und an einem kuhlen, dunklen Ort lagern.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEKR() {
      const prod = (document.getElementById('ekr-prod') as HTMLSelectElement).value;
      const wt = parseFloat((document.getElementById('ekr-wt') as HTMLInputElement).value) || 5;
      const jarSz = parseInt((document.getElementById('ekr-jar') as HTMLSelectElement).value) || 500;
      const alt = parseFloat((document.getElementById('ekr-alt') as HTMLInputElement).value) || 0;
      const method = (document.getElementById('ekr-method') as HTMLSelectElement).value;

      const yieldPerKg: Record<string, number> = {
        tomatoes: 750, peaches: 650, applesauce: 900, greenbeans: 500,
        pickles: 900, jam: 1000, salsa: 700, corn: 400
      };
      const baseTimePint: Record<string, number> = {
        tomatoes: 40, peaches: 25, applesauce: 20, greenbeans: 20,
        pickles: 15, jam: 10, salsa: 15, corn: 55
      };
      const headspaceCm: Record<string, number> = {
        tomatoes: 1.5, peaches: 1.5, applesauce: 1.5, greenbeans: 2.5,
        pickles: 1.5, jam: 0.5, salsa: 1.5, corn: 2.5
      };

      const yieldMlPerKg = yieldPerKg[prod] || 750;
      const totalYieldMl = wt * yieldMlPerKg;
      const jarsNeeded = Math.ceil(totalYieldMl / jarSz);

      let baseTime = baseTimePint[prod] || 20;
      if (jarSz >= 1000) baseTime += 10;
      else if (jarSz <= 250) baseTime -= 5;
      const altAdj = alt > 300 ? Math.ceil((alt - 300) / 300) * 5 : 0;
      const processTime = Math.max(baseTime + altAdj, 5);
      const finalTime = method === 'pressure' ? Math.round(processTime * 0.65) : processTime;

      const headspaceCmVal = headspaceCm[prod] || 1.5;
      const waterL = method === 'waterbath' ? 3 + (jarsNeeded > 7 ? 1 : 0) : 1;

      document.getElementById('ekr-result')!.textContent = jarsNeeded + ' Glaeser';
      document.getElementById('ekr-time')!.textContent = finalTime + ' Min';
      document.getElementById('ekr-head')!.textContent = headspaceCmVal.toFixed(1) + ' cm';
      document.getElementById('ekr-water')!.textContent = waterL.toFixed(0) + ' l';
      document.getElementById('ekr-lids')!.textContent = jarsNeeded.toString();
      document.getElementById('ekr-yield')!.textContent = totalYieldMl.toFixed(0) + ' ml';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.ekr-in').forEach(el => {
        el.addEventListener('input', calcEKR);
        el.addEventListener('change', calcEKR);
      });
      calcEKR();
    }, 50);
  </script>
</CalculatorLayout>
