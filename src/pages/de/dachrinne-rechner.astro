---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Dachrinne-Rechner";
const description = "Berechnen Sie Dachrinnenl&auml;nge, ben&ouml;tigte Fallrohre und Materialkosten f&uuml;r Ihr Dach.";
const relatedCalcs = [
  { name: "Dachdeckung-Rechner", url: "/de/dachdeckung-rechner", description: "Dachdeckung." },
  { name: "Quadratmeter-Rechner", url: "/de/quadratmeter-rechner", description: "Fl&auml;chenberechnung." },
  { name: "Installationsrohr-Rechner", url: "/de/installationsrohr-rechner", description: "Rohrberechnung." },
  { name: "Zaun-Rechner", url: "/de/zaun-rechner", description: "Zaunmaterial." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Dachrinne-Rechner" lang="de" enSlug="gutter-calculator" keywords="dachrinne rechner, dachrinnenl&auml;nge, fallrohre, dachrinne kosten, regenrinne" breadcrumbs={[{ name: "Dachrinne", url: "/de/dachrinne-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dachrinne-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Dachrinnen und Fallrohre f&uuml;r Ihr Dach.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Hausl&auml;nge (m)</label><input type="number" id="drde-len" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="12" min="0" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Hausbreite (m)</label><input type="number" id="drde-wid" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="9" min="0" step="0.5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Rinnen-Profil</label>
            <select id="drde-style" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="125" selected>125 mm (Halbrund, Standard)</option>
              <option value="150">150 mm (Halbrund, gro&szlig;)</option>
              <option value="100">100 mm (Kastenprofil)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Material</label>
            <select id="drde-mat" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="8">Kunststoff (8 &euro;/m)</option>
              <option value="15" selected>Zink (15 &euro;/m)</option>
              <option value="25">Kupfer (25 &euro;/m)</option>
              <option value="12">Aluminium (12 &euro;/m)</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-text mb-1">Traufh&ouml;he (m)</label><input type="number" id="drde-ht" class="drde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="2" max="15" step="0.5"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Dachrinnenl&auml;nge</div>
          <div class="text-5xl font-extrabold font-mono" id="drde-result">0 m</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fallrohre</div><div class="text-xl font-bold font-mono" id="drde-down">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ecken</div><div class="text-xl font-bold font-mono" id="drde-corn">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Kosten</div><div class="text-xl font-bold font-mono" id="drde-cost">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fallrohrl&auml;nge ges.</div><div class="text-xl font-bold font-mono" id="drde-dslen">0 m</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Rinnenhalter</div><div class="text-xl font-bold font-mono" id="drde-hang">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="gutter-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dachrinne planen</h2>
      <p>Dachrinnen leiten Regenwasser kontrolliert vom Dach ab und sch&uuml;tzen die Fassade. Die Rinnenl&auml;nge entspricht dem Dachperimeter, Fallrohre werden alle 10&ndash;12 m gesetzt.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welches Material ist am besten?</strong> Zink ist langlebig und wartungsarm. Kupfer entwickelt eine sch&ouml;ne Patina, ist aber teurer.</p>
      <p><strong>Wie viele Fallrohre brauche ich?</strong> Mindestens eines pro 10&ndash;12 m Rinnenl&auml;nge, mindestens 4 pro Haus.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcDRDE() {
      const len = parseFloat((document.getElementById('drde-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('drde-wid') as HTMLInputElement).value) || 0;
      const matCost = parseFloat((document.getElementById('drde-mat') as HTMLSelectElement).value);
      const roofHt = parseFloat((document.getElementById('drde-ht') as HTMLInputElement).value) || 4;
      const gutterLength = 2 * len + 2 * wid;
      const downspouts = Math.max(4, Math.ceil(gutterLength / 10));
      const corners = 4;
      const hangers = Math.ceil(gutterLength / 0.6);
      const dsLength = downspouts * (roofHt + 1);
      const gutterCost = gutterLength * matCost;
      const dsCost = dsLength * (matCost * 0.6);
      const hardwareCost = hangers * 2 + corners * 10 + downspouts * 20;

      document.getElementById('drde-result')!.textContent = gutterLength.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m';
      document.getElementById('drde-down')!.textContent = downspouts.toString();
      document.getElementById('drde-corn')!.textContent = corners.toString();
      document.getElementById('drde-cost')!.textContent = (gutterCost + dsCost + hardwareCost).toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC';
      document.getElementById('drde-dslen')!.textContent = dsLength.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m';
      document.getElementById('drde-hang')!.textContent = hangers.toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.drde-in').forEach(el => { el.addEventListener('input', calcDRDE); el.addEventListener('change', calcDRDE); });
      calcDRDE();
    }, 50);
  </script>
</CalculatorLayout>
