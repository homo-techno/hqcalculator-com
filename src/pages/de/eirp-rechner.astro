---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "EIRP-Rechner - Äquivalente isotrope Strahlungsleistung";
const description = "Berechnen Sie die EIRP (Equivalent Isotropically Radiated Power) aus Sendeleistung, Kabelverlusten und Antennengewinn für Funktechnik und Telekommunikation.";

const relatedCalcs = [
  { name: "Dezibel-Rechner", url: "/de/dezibel-rechner", description: "dB berechnen." },
  { name: "Freiraumdämpfung-Rechner", url: "/de/freiraumdaempfung-rechner", description: "Pfadverlust." },
  { name: "Wellenlaenge-Rechner", url: "/de/wellenlaenge-rechner", description: "Wellenlänge." },
  { name: "Frequenzrechner", url: "/de/frequenzrechner", description: "Frequenz berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="EIRP-Rechner" lang="de" enSlug="eirp-calculator" keywords="eirp rechner, sendeleistung, antennengewinn, äquivalente isotrope strahlungsleistung, funktechnik" breadcrumbs={[{ name: "EIRP-Rechner", url: "/de/eirp-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">EIRP-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die &auml;quivalente isotrope Strahlungsleistung (EIRP) aus Sendeleistung, Kabelverlusten und Antennengewinn.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Sendeleistung (dBm)</label><input type="number" id="erp-tx" class="erp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="-50" max="60"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kabelverluste (dB)</label><input type="number" id="erp-loss" class="erp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Antennengewinn (dBi)</label><input type="number" id="erp-gain" class="erp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.5" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Steckerverluste (dB)</label><input type="number" id="erp-conn" class="erp-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="0.1" min="0"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">EIRP</div>
          <div class="text-5xl font-extrabold font-mono" id="erp-result">0 dBm</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">EIRP (Watt)</div><div class="text-xl font-bold" id="erp-watt">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">ERP (dBm)</div><div class="text-xl font-bold" id="erp-erp">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Sendeleistung (Watt)</div><div class="text-xl font-bold" id="erp-txw">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtverluste</div><div class="text-xl font-bold" id="erp-totloss">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="erp-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="eirp-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">EIRP-Berechnung</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>EIRP (dBm) = Sendeleistung (dBm) &minus; Kabelverluste (dB) &minus; Steckerverluste (dB) + Antennengewinn (dBi)</p>
        <p>EIRP (Watt) = 10^((EIRP_dBm &minus; 30) / 10)</p>
        <p>ERP (dBm) = EIRP (dBm) &minus; 2,15</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen EIRP und ERP?</strong> EIRP bezieht sich auf einen isotropen Strahler, ERP auf einen Halbwellendipol. EIRP = ERP + 2,15 dB.</p>
      <p><strong>Warum ist EIRP wichtig?</strong> Regulierungsbeh&ouml;rden begrenzen die EIRP, um Interferenzen zu vermeiden. In Deutschland gelten Grenzen der BNetzA.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcErp() {
      const tx = parseFloat((document.getElementById('erp-tx') as HTMLInputElement).value) || 0;
      const loss = parseFloat((document.getElementById('erp-loss') as HTMLInputElement).value) || 0;
      const gain = parseFloat((document.getElementById('erp-gain') as HTMLInputElement).value) || 0;
      const conn = parseFloat((document.getElementById('erp-conn') as HTMLInputElement).value) || 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const totalLoss = loss + conn;
      steps.push('Gesamtverluste = ' + fmt(loss) + ' + ' + fmt(conn) + ' = ' + fmt(totalLoss) + ' dB');
      const eirpDbm = tx - totalLoss + gain;
      steps.push('EIRP = ' + fmt(tx) + ' dBm - ' + fmt(totalLoss) + ' dB + ' + fmt(gain) + ' dBi = ' + fmt(eirpDbm) + ' dBm');
      const eirpWatt = Math.pow(10, (eirpDbm - 30) / 10);
      steps.push('EIRP (Watt) = 10^((' + fmt(eirpDbm) + ' - 30) / 10) = ' + fmt(eirpWatt) + ' W');
      const erpDbm = eirpDbm - 2.15;
      steps.push('ERP = ' + fmt(eirpDbm) + ' - 2,15 = ' + fmt(erpDbm) + ' dBm');
      const txWatt = Math.pow(10, (tx - 30) / 10);
      steps.push('Sendeleistung = ' + fmt(txWatt) + ' W');
      document.getElementById('erp-result')!.textContent = fmt(eirpDbm) + ' dBm';
      document.getElementById('erp-watt')!.textContent = eirpWatt < 1 ? (eirpWatt * 1000).toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' mW' : fmt(eirpWatt) + ' W';
      document.getElementById('erp-erp')!.textContent = fmt(erpDbm) + ' dBm';
      document.getElementById('erp-txw')!.textContent = txWatt < 1 ? (txWatt * 1000).toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' mW' : fmt(txWatt) + ' W';
      document.getElementById('erp-totloss')!.textContent = fmt(totalLoss) + ' dB';
      document.getElementById('erp-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('erp-tx') as HTMLInputElement).value = '30';
      (document.getElementById('erp-loss') as HTMLInputElement).value = '2';
      (document.getElementById('erp-gain') as HTMLInputElement).value = '6';
      (document.getElementById('erp-conn') as HTMLInputElement).value = '0.5';
      document.querySelectorAll('.erp-in').forEach(el => { el.addEventListener('input', calcErp); el.addEventListener('change', calcErp); });
      calcErp();
    }, 50);
  </script>
</CalculatorLayout>
