---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kinderdosierung-Rechner - Paediatrische Medikamentendosierung";
const description = "Berechnen Sie sichere Medikamentendosen fuer Kinder basierend auf Gewicht. Paracetamol (Nurofen), Ibuprofen und weitere gaengige Medikamente.";
const relatedCalcs = [
  { name: "Kinder-BMI-Rechner", url: "/de/kinder-bmi-rechner", description: "BMI-Perzentile." },
  { name: "Kinderernaehrung-Rechner", url: "/de/kinderernaehrung-rechner", description: "Ernaehrung." },
  { name: "Kindergroesse-Rechner", url: "/de/kindergroesse-rechner", description: "Wachstum." },
  { name: "Kindesunterhalt-Rechner", url: "/de/kindesunterhalt-rechner", description: "Unterhalt." },
  { name: "Biorhythmus-Rechner", url: "/de/biorhythmus-rechner", description: "Biorhythmus." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kinderdosierung-Rechner" enSlug="child-dosage-calculator" keywords="Kinderdosierung, paediatrische Dosierung, Kinder Paracetamol Dosis, Ibuprofen Dosierung Kinder, Medikamentendosierung Gewicht" breadcrumbs={[{ name: "Kinderdosierung-Rechner", url: "/de/kinderdosierung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kinderdosierung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie sichere Medikamentendosen fuer Kinder basierend auf dem Koerpergewicht. Immer mit dem Kinderarzt absprechen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="p-3 bg-yellow-50 border border-yellow-200 rounded-xl mb-4">
        <p class="text-sm text-yellow-800"><strong>Hinweis:</strong> Dieser Rechner bietet allgemeine Dosierungsrichtlinien. Konsultieren Sie immer Ihren Kinderarzt oder Apotheker, bevor Sie Ihrem Kind Medikamente geben.</p>
      </div>
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Gewicht des Kindes (kg)</label><input type="number" id="kd-weight" class="kd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="3" max="100" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Alter des Kindes (Jahre)</label><input type="number" id="kd-age" class="kd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="17" step="0.5"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Medikament</label>
          <select id="kd-med" class="kd-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="paracetamol" selected>Paracetamol (z.B. Ben-u-ron)</option>
            <option value="ibuprofen">Ibuprofen (z.B. Nurofen Junior)</option>
            <option value="cetirizin">Cetirizin (Antihistamin)</option>
          </select>
        </div>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlene Dosis</div>
        <div class="text-5xl font-extrabold" id="kd-dose">--</div>
        <div class="text-sm text-blue-200 mt-1" id="kd-form">Darreichungsform</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dosis in mg</div><div class="text-lg font-bold" id="kd-mg">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Dosierungsintervall</div><div class="text-lg font-bold" id="kd-freq">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Tagesdosen</div><div class="text-lg font-bold" id="kd-maxdoses">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Max. Tagesmenge</div><div class="text-lg font-bold" id="kd-maxdaily">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-3">Dosierung nach Gewicht</h3>
        <div class="text-xs" id="kd-chart"></div>
      </div>
      <ShareButton lang="de" calculatorId="kinderdosierung" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Paediatrische Dosierungsrichtlinien</h2>
      <p>Gewichtsbasierte Dosierung ist genauer als altersbasierte Dosierung bei Kindern. Verwenden Sie immer das mitgelieferte Dosierungsmass.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Wichtige Sicherheitsregeln</h3>
      <ul>
        <li><strong>Paracetamol:</strong> 10-15 mg/kg alle 4-6 Stunden. Nicht mehr als 4 Dosen in 24 Stunden.</li>
        <li><strong>Ibuprofen:</strong> 5-10 mg/kg alle 6-8 Stunden. Nicht fuer Saeuglinge unter 6 Monaten.</li>
        <li><strong>Cetirizin:</strong> 0,25 mg/kg einmal taeglich. Ab 2 Jahren.</li>
        <li>Geben Sie Kindern niemals Aspirin (Reye-Syndrom-Risiko)</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKD() {
      const weightKg = parseFloat((document.getElementById('kd-weight') as HTMLInputElement).value) || 15;
      const age = parseFloat((document.getElementById('kd-age') as HTMLInputElement).value) || 3;
      const med = (document.getElementById('kd-med') as HTMLSelectElement).value;
      interface MedInfo { mgPerKg: number; maxMg: number; frequency: string; maxDoses: number; minAge: number; concentration: string; mgPerMl: number; }
      const meds: Record<string, MedInfo> = {
        paracetamol: { mgPerKg: 15, maxMg: 1000, frequency: 'Alle 4-6 Stunden', maxDoses: 4, minAge: 0, concentration: '40 mg/ml Saft', mgPerMl: 40 },
        ibuprofen: { mgPerKg: 10, maxMg: 400, frequency: 'Alle 6-8 Stunden', maxDoses: 3, minAge: 0.5, concentration: '20 mg/ml Saft', mgPerMl: 20 },
        cetirizin: { mgPerKg: 0.25, maxMg: 10, frequency: 'Einmal taeglich', maxDoses: 1, minAge: 2, concentration: '1 mg/ml Tropfen', mgPerMl: 1 },
      };
      const info = meds[med];
      let doseMg = Math.min(weightKg * info.mgPerKg, info.maxMg);
      doseMg = Math.round(doseMg);
      const doseMl = doseMg / info.mgPerMl;
      const maxDailyMg = doseMg * info.maxDoses;
      let warning = '';
      if (age < info.minAge) warning = 'Nicht empfohlen fuer dieses Alter. Kinderarzt konsultieren.';
      let doseDisplay = doseMl.toFixed(1) + ' ml';
      document.getElementById('kd-dose')!.textContent = warning || doseDisplay;
      document.getElementById('kd-form')!.textContent = info.concentration;
      document.getElementById('kd-mg')!.textContent = doseMg + ' mg';
      document.getElementById('kd-freq')!.textContent = info.frequency;
      document.getElementById('kd-maxdoses')!.textContent = info.maxDoses + ' pro Tag';
      document.getElementById('kd-maxdaily')!.textContent = maxDailyMg + ' mg/Tag';
      const weights = [5, 8, 10, 12, 15, 20, 25, 30, 40];
      document.getElementById('kd-chart')!.innerHTML =
        '<div class="grid grid-cols-3 gap-2 font-semibold text-text-muted mb-1"><span>Gewicht (kg)</span><span>Dosis (mg)</span><span>Saft (ml)</span></div>' +
        weights.map(w => {
          const mg = Math.min(Math.round(w * info.mgPerKg), info.maxMg);
          const ml = mg / info.mgPerMl;
          const isHighlighted = Math.abs(w - weightKg) <= 2;
          return '<div class="grid grid-cols-3 gap-2 py-1 ' + (isHighlighted ? 'bg-blue-50 rounded font-bold' : '') + '"><span>' + w + ' kg</span><span>' + mg + ' mg</span><span>' + ml.toFixed(1) + ' ml</span></div>';
        }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kd-in').forEach(el => { el.addEventListener('input', calcKD); el.addEventListener('change', calcKD); });
      calcKD();
    }, 50);
  </script>
</CalculatorLayout>
