---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lichtintensität Rechner – Beleuchtungsstärke & Lichtstrom";
const description = "Berechnen Sie Beleuchtungsstärke (Lux), Lichtstrom (Lumen) und Lichtausbeute. Ideal für Raumplanung und LED-Vergleich.";
const relatedCalcs = [
  { name: "Beleuchtungsrechner", url: "/de/beleuchtungs-rechner", description: "Leuchtenanzahl." },
  { name: "Linsengleichung Rechner", url: "/de/linsen-gleichung-rechner", description: "Optik." },
  { name: "Lichtlaufzeit Rechner", url: "/de/lichtlaufzeit-rechner", description: "Astronomie." },
  { name: "Blitzentfernung Rechner", url: "/de/blitzentfernung-rechner", description: "Blitzentfernung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="light-intensity-calculator" calculatorName="Lichtintensität Rechner" keywords="Lichtintensität Rechner, Beleuchtungsstärke, Lux, Lumen, Lichtausbeute, LED" breadcrumbs={[{ name: "Lichtintensität Rechner", url: "/de/lichtintensitaet-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lichtintensität Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Beleuchtungsstärke (Lux), Lichtstrom (Lumen) und Lichtausbeute berechnen und vergleichen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="lit-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="lux">Lux berechnen</button>
          <button class="lit-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="lumen">Lumen berechnen</button>
          <button class="lit-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="ausbeute">Lichtausbeute</button>
        </div>
        <div id="lit-panel-lux" class="space-y-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lichtstrom (Lumen)</label><input type="number" id="lit-lm" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="800" step="10" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Beleuchtete Fläche (m²)</label><input type="number" id="lit-area" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" step="0.5" min="0.1"></div>
        </div>
        <div id="lit-panel-lumen" class="space-y-3 hidden">
          <div><label class="block text-xs font-medium text-text mb-1">Beleuchtungsstärke (Lux)</label><input type="number" id="lit-lux" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="500" step="10" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Beleuchtete Fläche (m²)</label><input type="number" id="lit-area2" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="0.5" min="0.1"></div>
        </div>
        <div id="lit-panel-ausbeute" class="space-y-3 hidden">
          <div><label class="block text-xs font-medium text-text mb-1">Lichtstrom (Lumen)</label><input type="number" id="lit-lm2" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="800" step="10" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Leistungsaufnahme (Watt)</label><input type="number" id="lit-watt" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" step="0.5" min="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="lit-label">Beleuchtungsstärke</div>
          <div class="text-5xl font-extrabold font-mono" id="lit-result">0</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="lit-details"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-xs text-text mb-2 uppercase">Empfohlene Beleuchtungsstärken (EN 12464)</h3>
          <div class="text-xs text-text-secondary grid grid-cols-2 gap-1">
            <span>Wohnzimmer: 100–300 lx</span><span>Büro: 500 lx</span>
            <span>Küche: 300–500 lx</span><span>Operationssaal: 10.000 lx</span>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="lichtintensitaet" />
      <FeedbackWidget lang="de" />
    </div>

    <div class="max-w-2xl mx-auto mt-10 prose prose-sm text-text-secondary">
      <h2 class="text-xl font-bold text-text">Licht verstehen: Lux, Lumen, Candela</h2>
      <p>Lumen (lm) beschreibt den gesamten Lichtstrom einer Lichtquelle. Lux (lx) beschreibt die Beleuchtungsstärke auf einer Fläche: 1 lx = 1 lm/m². Die Lichtausbeute (lm/W) gibt an, wie effizient eine Lampe ist. Moderne LED-Lampen erreichen 100–200 lm/W, während Glühbirnen nur 10–15 lm/W erzielen.</p>
    </div>

    <div class="max-w-2xl mx-auto mt-8">
      <h2 class="text-xl font-bold text-text mb-4">Häufige Fragen</h2>
      <div class="space-y-4">
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Was ist der Unterschied zwischen Lux und Lumen?</summary>
          <p class="mt-2 text-sm text-text-secondary">Lumen (lm) ist der gesamte Lichtstrom einer Lichtquelle. Lux (lx) ist die Beleuchtungsstärke auf einer Fläche. 1 Lux = 1 Lumen pro Quadratmeter. Ein heller Raum braucht mehr Lumen bei größerer Fläche.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Wie viele Lumen brauche ich für ein Wohnzimmer?</summary>
          <p class="mt-2 text-sm text-text-secondary">Für ein Wohnzimmer (20 m²) mit 200 lx Beleuchtungsstärke benötigen Sie ca. 4.000 lm. Bei 500 lx für Arbeitsbereiche sind es 10.000 lm. Verteilen Sie das auf mehrere Lichtquellen.</p>
        </details>
        <details class="bg-white border border-border rounded-xl p-4">
          <summary class="font-semibold cursor-pointer">Welche Lichtausbeute hat eine LED-Lampe?</summary>
          <p class="mt-2 text-sm text-text-secondary">Moderne LED-Lampen haben eine Lichtausbeute von 80–150 lm/W, Hochleistungs-LEDs bis 200 lm/W. Zum Vergleich: Glühbirnen 10–15 lm/W, Leuchtstoffröhren 60–100 lm/W.</p>
        </details>
      </div>
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let litMode = 'lux';
    function setLitMode(m: string) {
      litMode = m;
      document.querySelectorAll('.lit-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = `lit-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ${active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted'}`;
      });
      document.getElementById('lit-panel-lux')!.classList.toggle('hidden', m !== 'lux');
      document.getElementById('lit-panel-lumen')!.classList.toggle('hidden', m !== 'lumen');
      document.getElementById('lit-panel-ausbeute')!.classList.toggle('hidden', m !== 'ausbeute');
      calcLit();
    }
    function calcLit() {
      const fmt = (v: number, u: string) => v.toLocaleString('de-DE', { maximumFractionDigits: 2 }) + ' ' + u;
      if (litMode === 'lux') {
        const lm = parseFloat((document.getElementById('lit-lm') as HTMLInputElement).value) || 0;
        const area = parseFloat((document.getElementById('lit-area') as HTMLInputElement).value) || 1;
        const lux = lm / area;
        document.getElementById('lit-label')!.textContent = 'Beleuchtungsstärke';
        document.getElementById('lit-result')!.textContent = fmt(lux, 'lx');
        document.getElementById('lit-details')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lichtstrom</div><div class="text-lg font-bold font-mono">${fmt(lm, 'lm')}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fläche</div><div class="text-lg font-bold font-mono">${fmt(area, 'm²')}</div></div>`;
      } else if (litMode === 'lumen') {
        const lux = parseFloat((document.getElementById('lit-lux') as HTMLInputElement).value) || 0;
        const area = parseFloat((document.getElementById('lit-area2') as HTMLInputElement).value) || 1;
        const lm = lux * area;
        document.getElementById('lit-label')!.textContent = 'Benötigter Lichtstrom';
        document.getElementById('lit-result')!.textContent = fmt(lm, 'lm');
        document.getElementById('lit-details')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beleuchtungsstärke</div><div class="text-lg font-bold font-mono">${fmt(lux, 'lx')}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fläche</div><div class="text-lg font-bold font-mono">${fmt(area, 'm²')}</div></div>`;
      } else {
        const lm = parseFloat((document.getElementById('lit-lm2') as HTMLInputElement).value) || 0;
        const watt = parseFloat((document.getElementById('lit-watt') as HTMLInputElement).value) || 1;
        const ausbeute = lm / watt;
        const glBedarf = lm / 12; // Glühbirne ~12 lm/W
        document.getElementById('lit-label')!.textContent = 'Lichtausbeute';
        document.getElementById('lit-result')!.textContent = fmt(ausbeute, 'lm/W');
        document.getElementById('lit-details')!.innerHTML = `
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Äquiv. Glühbirne</div><div class="text-lg font-bold font-mono">${fmt(glBedarf, 'W')}</div></div>
          <div class="p-3 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Energieersparnis</div><div class="text-lg font-bold font-mono">${fmt(Math.max(0, 100 - watt / glBedarf * 100), '%')}</div></div>`;
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.lit-mode').forEach(b => b.addEventListener('click', () => setLitMode((b as HTMLButtonElement).dataset.mode!)));
      ['lit-lm','lit-area','lit-lux','lit-area2','lit-lm2','lit-watt'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', calcLit);
      });
      calcLit();
    }, 50);
  </script>
</CalculatorLayout>
