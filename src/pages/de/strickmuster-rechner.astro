---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Strickmuster Rechner";
const description = "Berechnen Sie Maschenprobe, Strickweite und Garnmenge für Strickprojekte.";

const relatedCalcs = [
  { name: "Leder-Rechner", url: "/de/leder-rechner", description: "Lederbedarf berechnen." },
  { name: "Farbbedarf-Rechner", url: "/de/farbbedarf-rechner", description: "Farbmenge berechnen." },
  { name: "Stoffrechner", url: "/de/stoff-rechner", description: "Stoffbedarf berechnen." },
  { name: "Rasenrechner", url: "/de/rasen-rechner", description: "Rasenbedarf berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Strickmuster Rechner" lang="de" enSlug="knitting-gauge-calculator" keywords="strickmuster rechner, maschenprobe berechnen, garnmenge rechner, strickweite berechnen" breadcrumbs={[{ name: "Strickmuster Rechner", url: "/de/strickmuster-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Strickmuster Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die benötigte Maschenanzahl, Reihenanzahl und Garnmenge für Ihr Strickprojekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Maschenprobe: Maschen pro 10 cm</label><input type="number" id="smr-gauge-st" class="smr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="22" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Maschenprobe: Reihen pro 10 cm</label><input type="number" id="smr-gauge-row" class="smr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="28" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gewünschte Breite (cm)</label><input type="number" id="smr-width" class="smr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gewünschte Länge (cm)</label><input type="number" id="smr-length" class="smr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Knäuelgewicht (g)</label><input type="number" id="smr-skein-g" class="smr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="1" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Lauflänge pro Knäuel (m)</label><input type="number" id="smr-skein-m" class="smr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="1" step="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Maschen</div>
          <div class="text-4xl font-extrabold font-mono" id="smr-stitches">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reihen</div><div class="text-xl font-bold" id="smr-rows">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Garnlänge (m)</div><div class="text-xl font-bold" id="smr-yarn-m">0 m</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Knäuel</div><div class="text-xl font-bold" id="smr-skeins">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="knitting-gauge-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Maschenprobe – das A und O beim Stricken</h2>
      <p>Die Maschenprobe ist entscheidend für den Erfolg jedes Strickprojekts. Sie gibt an, wie viele Maschen und Reihen in einem 10×10 cm großen Muster enthalten sind. Weicht Ihre persönliche Maschenprobe von der Anleitung ab, müssen Sie die Maschen- und Reihenanzahl entsprechend anpassen. Stricken Sie immer eine Probestrickprobe von mindestens 15×15 cm und messen Sie diese nach dem Waschen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist eine Maschenprobe?</strong> Die Maschenprobe gibt an, wie viele Maschen und Reihen in einem definierten Bereich (meist 10×10 cm) entstehen. Sie ist individuell und hängt von Nadel, Garn und Strickerin ab.</p>
      <p><strong>Wie berechne ich den Garnbedarf?</strong> Multiplizieren Sie Maschen mit Reihen und teilen durch den Maschenwert Ihrer Probe. Die Lauflänge des Garns gibt an, wie viele Meter ein Knäuel hat.</p>
      <p><strong>Was tun, wenn meine Probe nicht stimmt?</strong> Wechseln Sie die Nadelstärke: Bei zu großer Probe nehmen Sie dünnere Nadeln, bei zu kleiner dickere Nadeln.</p>
      <p><strong>Wie viel Garn brauche ich für einen Pullover?</strong> Ein durchschnittlicher Damenpullover (Größe 40) benötigt je nach Garnstärke 400–800 g Wolle.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcSMR() {
      const gaugeSt = parseFloat((document.getElementById('smr-gauge-st') as HTMLInputElement).value) || 0;
      const gaugeRow = parseFloat((document.getElementById('smr-gauge-row') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('smr-width') as HTMLInputElement).value) || 0;
      const length = parseFloat((document.getElementById('smr-length') as HTMLInputElement).value) || 0;
      const skeinG = parseFloat((document.getElementById('smr-skein-g') as HTMLInputElement).value) || 100;
      const skeinM = parseFloat((document.getElementById('smr-skein-m') as HTMLInputElement).value) || 200;
      const stitches = Math.round((gaugeSt / 10) * width);
      const rows = Math.round((gaugeRow / 10) * length);
      const totalStitches = stitches * rows;
      const yarnPerStitch = skeinM / (skeinG * (gaugeSt / 10) * (gaugeRow / 10) * 10);
      const yarnM = Math.round(totalStitches * (skeinM / (gaugeSt / 10 * 10 * gaugeRow / 10 * 10)));
      const skeins = Math.ceil(yarnM / skeinM);
      document.getElementById('smr-stitches')!.textContent = stitches.toLocaleString('de-DE');
      document.getElementById('smr-rows')!.textContent = rows.toLocaleString('de-DE');
      document.getElementById('smr-yarn-m')!.textContent = yarnM.toLocaleString('de-DE') + ' m';
      document.getElementById('smr-skeins')!.textContent = skeins.toLocaleString('de-DE');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.smr-in').forEach(el => { el.addEventListener('input', calcSMR); el.addEventListener('change', calcSMR); }); calcSMR(); }, 50);
  </script>
</CalculatorLayout>
