---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "DJ-Playlist-Rechner - Songanzahl & BPM-Mix fuer Events 2026";
const description = "Berechne wie viele Songs du brauchst, Playlist-Dauer und BPM-Verlauf fuer verschiedene Event-Abschnitte. Perfekt fuer DJs und Eventplaner.";

const relatedCalcs = [
  { name: "Eventbudget-Rechner", url: "/de/eventbudget-rechner", description: "Eventkosten berechnen." },
  { name: "Hochzeitsrechner", url: "/de/hochzeitsrechner", description: "Hochzeitsplanung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente berechnen." },
  { name: "Zeitrechner", url: "/de/zeitrechner", description: "Zeitberechnungen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="DJ-Playlist-Rechner" keywords="DJ Playlist Rechner, Songanzahl, Event Musik, BPM Mix, Hochzeit Playlist, Party Musik Planer" breadcrumbs={[{ name: "DJ-Playlist-Rechner", url: "/de/dj-playlist-rechner" }]} lang="de" enSlug="dj-playlist-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">DJ-Playlist-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Plane deine Event-Musik mit der richtigen Songanzahl und BPM-Progression.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Gesamte Musikzeit (Stunden)</label>
          <input type="number" id="djpde-hours" class="djpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="12" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Cocktail- / Hintergrundmusik (Stunden)</label>
          <input type="number" id="djpde-bg" class="djpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" max="6" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Dinner-Musik (Stunden)</label>
          <input type="number" id="djpde-dinner" class="djpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="0" max="4" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Tanzmusik (Stunden)</label>
          <input type="number" id="djpde-dance" class="djpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="8" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Durchschnittliche Songlaenge (Minuten)</label>
          <input type="number" id="djpde-songlength" class="djpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.5" min="2" max="7" step="0.5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Event-Typ</label>
          <select id="djpde-vibe" class="djpde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="wedding">Hochzeit / Formell</option>
            <option value="party">Party / Feier</option>
            <option value="club">Club / High Energy</option>
            <option value="corporate">Firmenveranstaltung / Hintergrund</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Musikwuensche (Anzahl)</label>
          <input type="number" id="djpde-requests" class="djpde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="0" step="1">
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Songs insgesamt benoetigt</div>
        <div class="text-5xl font-extrabold" id="djpde-total">--</div>
        <div class="text-sm mt-1" id="djpde-duration">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Hintergrund-Songs</div>
          <div class="text-xl font-bold" id="djpde-bgsongs">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Dinner-Songs</div>
          <div class="text-xl font-bold" id="djpde-dinnersongs">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Tanz-Songs</div>
          <div class="text-xl font-bold" id="djpde-dancesongs">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">DJ-Auswahl</div>
          <div class="text-xl font-bold" id="djpde-djselected">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="djpde-details"></div>

      <ShareButton calculatorId="dj-playlist" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">DJ-Playlist-Planungsleitfaden</h2>
      <p>Bei durchschnittlich 3,5 Minuten pro Song braucht man ca. 17 Songs pro Stunde. Bereite immer 20-30 % mehr Songs vor als noetig fuer Flexibilitaet. Steigere das BPM schrittweise: Cocktailstunde bei 90-110 BPM, Dinner bei 80-100 BPM, Tanzen von 110 auf 130+ BPM.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie viele Songs brauche ich pro Stunde?</strong> Bei einer durchschnittlichen Songlaenge von 3,5 Minuten sind das ca. 17 Songs pro Stunde. Plane aber immer einen Puffer von 25 % ein.</p>
      <p><strong>Welches BPM fuer welchen Anlass?</strong> Hintergrundmusik: 80-110 BPM, Aufwaermphase: 110-120 BPM, Hoehepunkt: 120-135 BPM, Ausklang: 100-115 BPM.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcDJPDE() {
      const totalHours = parseFloat((document.getElementById('djpde-hours') as HTMLInputElement).value) || 5;
      const bgHours = parseFloat((document.getElementById('djpde-bg') as HTMLInputElement).value) || 1;
      const dinnerHours = parseFloat((document.getElementById('djpde-dinner') as HTMLInputElement).value) || 1;
      const danceHours = parseFloat((document.getElementById('djpde-dance') as HTMLInputElement).value) || 3;
      const songLen = parseFloat((document.getElementById('djpde-songlength') as HTMLInputElement).value) || 3.5;
      const vibe = (document.getElementById('djpde-vibe') as HTMLSelectElement).value;
      const requests = parseInt((document.getElementById('djpde-requests') as HTMLInputElement).value) || 0;

      const songsPerHour = Math.ceil(60 / songLen);
      const bgSongs = Math.ceil(bgHours * songsPerHour);
      const dinnerSongs = Math.ceil(dinnerHours * songsPerHour);
      const danceSongs = Math.ceil(danceHours * songsPerHour);
      const totalSongs = bgSongs + dinnerSongs + danceSongs;
      const djSelected = Math.max(0, totalSongs - requests);
      const prepSongs = Math.ceil(totalSongs * 1.25);

      const totalMinutes = totalSongs * songLen;

      let bpmGuide: Array<Record<string, string>> = [];
      if (vibe === 'wedding') {
        bpmGuide = [
          { slot: 'Cocktailstunde', bpm: '90-110 BPM (Jazz, Akustik, Lounge)' },
          { slot: 'Dinner', bpm: '80-100 BPM (Soft Pop, Instrumental)' },
          { slot: 'Ersttaenze', bpm: '70-90 BPM (langsame Songs)' },
          { slot: 'Fruehes Tanzen', bpm: '110-120 BPM (Aufwaermer)' },
          { slot: 'Hoehepunkt', bpm: '120-130 BPM (Hits, Favoriten)' },
          { slot: 'Letzte Songs', bpm: '90-110 BPM (Ausklang-Klassiker)' },
        ];
      } else if (vibe === 'club') {
        bpmGuide = [
          { slot: 'Aufwaermen', bpm: '115-120 BPM' },
          { slot: 'Aufbau', bpm: '120-128 BPM' },
          { slot: 'Hoehepunkt', bpm: '128-140 BPM' },
          { slot: 'Abkuehlen', bpm: '110-120 BPM' },
        ];
      } else if (vibe === 'party') {
        bpmGuide = [
          { slot: 'Frueher Abend', bpm: '100-115 BPM (Eisbrecher)' },
          { slot: 'Aufbau', bpm: '115-125 BPM (Mitsing-Songs)' },
          { slot: 'Hoehepunkt', bpm: '125-135 BPM (Knaller)' },
          { slot: 'Ausklang', bpm: '100-115 BPM (Klassiker)' },
        ];
      } else {
        bpmGuide = [
          { slot: 'Gesamte Veranstaltung', bpm: '80-110 BPM (Hintergrund, Ambient)' },
        ];
      }

      document.getElementById('djpde-total')!.textContent = totalSongs.toString();
      document.getElementById('djpde-duration')!.textContent = Math.floor(totalMinutes / 60) + 'h ' + Math.round(totalMinutes % 60) + 'min Gesamtmusikzeit';
      document.getElementById('djpde-bgsongs')!.textContent = bgSongs.toString();
      document.getElementById('djpde-dinnersongs')!.textContent = dinnerSongs.toString();
      document.getElementById('djpde-dancesongs')!.textContent = danceSongs.toString();
      document.getElementById('djpde-djselected')!.textContent = djSelected.toString();

      let details = '<h3 class="font-semibold text-sm text-text mb-2">BPM-Leitfaden & Details</h3>';
      details += '<div class="space-y-1 mb-3">';
      bpmGuide.forEach(g => {
        details += '<div class="flex justify-between text-sm py-1 border-b border-border last:border-0"><span class="text-text-secondary">' + g.slot + '</span><span class="font-medium">' + g.bpm + '</span></div>';
      });
      details += '</div>';
      details += '<ul class="text-sm text-text-secondary space-y-1">';
      details += '<li>Songs pro Stunde: ~' + songsPerHour + ' (bei ' + songLen.toString().replace('.', ',') + ' Min Durchschnitt)</li>';
      details += '<li>Musikwuensche: ' + requests + '</li>';
      details += '<li>Bibliothek vorbereiten: ' + prepSongs + ' Songs (25 % Puffer)</li>';
      details += '<li>Tipp: Wechsle Genres alle 3-4 Songs fuer abwechslungsreiche Energie</li>';
      details += '</ul>';
      document.getElementById('djpde-details')!.innerHTML = details;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.djpde-in').forEach(el => { el.addEventListener('input', calcDJPDE); el.addEventListener('change', calcDJPDE); });
      calcDJPDE();
    }, 50);
  </script>
</CalculatorLayout>
