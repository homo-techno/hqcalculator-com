---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Farbmisch Rechner - Mischverhältnisse & Mengen";
const description = "Berechnen Sie Mischverhältnisse und Mengen für Farben und Töne. Ermitteln Sie den genauen Farbtonanteil für perfekte Ergebnisse.";

const relatedCalcs = [
  { name: "Wandflächen-Rechner", url: "/de/wandflaechen-rechner", description: "Wandfläche berechnen." },
  { name: "Raumrechner", url: "/de/raumrechner", description: "Raummaße." },
  { name: "Tapeten-Rechner", url: "/de/tapeten-rechner", description: "Tapetenmengen." },
  { name: "Kostenrechner", url: "/de/kostenrechner", description: "Projektkosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Farbmisch Rechner" lang="de" enSlug="paint-mixing-calculator" keywords="farbmisch rechner, farbmischung berechnen, mischverhältnis farbe, farbton berechnen, farbmenge" breadcrumbs={[{ name: "Farbmisch Rechner", url: "/de/farbmisch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Farbmisch Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Mischverhältnisse, Tonanteile und Farbenmengen für Ihre Malerprojekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Farbentyp</label>
          <select id="fm-type" class="fm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="latex">Dispersionsfarbe (Wasser)</option>
            <option value="oil">Ölfarbe / Alkydharz</option>
            <option value="chalk">Kreidefarbe</option>
            <option value="epoxy">Epoxidfarbe</option>
            <option value="spray">Sprühfarbe</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Grundfarbe (ml)</label><input type="number" id="fm-base" class="fm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Farbpigment / Abtönfarbe (ml)</label><input type="number" id="fm-tint" class="fm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Fläche (m²)</label><input type="number" id="fm-area" class="fm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Anstriche</label><input type="number" id="fm-coats" class="fm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="5" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Temperatur (°C)</label><input type="number" id="fm-temp" class="fm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="5" max="40" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Luftfeuchtigkeit (%)</label><input type="number" id="fm-hum" class="fm-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="10" max="95" step="5"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Farbmenge</div>
          <div class="text-4xl font-extrabold font-mono" id="fm-result">0 Liter</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mischverhältnis</div><div class="text-xl font-bold font-mono" id="fm-ratio">0:0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pigmentanteil</div><div class="text-xl font-bold font-mono" id="fm-tpct">0%</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ergiebigkeit/L</div><div class="text-xl font-bold font-mono" id="fm-cov">0 m²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Trocknungszeit</div><div class="text-xl font-bold font-mono" id="fm-dry">0 Std</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Überstreichbar</div><div class="text-xl font-bold font-mono" id="fm-recoat">0 Std</div></div>
        </div>
      </div>
      <ShareButton calculatorId="farbmisch-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Farben richtig mischen</h2>
      <p class="text-text-secondary mt-2">Das genaue Mischen von Farben ist entscheidend für ein gleichmäßiges Ergebnis. Ob beim Renovieren von Wänden, beim Streichen von Möbeln oder bei Kunstprojekten – ein präzises Mischverhältnis sorgt dafür, dass genug Farbe der gleichen Nuance vorhanden ist. Mit dem Farbmisch Rechner ermitteln Sie schnell, wie viel Grundfarbe und Abtönfarbe Sie benötigen, und erhalten eine Empfehlung zur Trocknungszeit basierend auf Temperatur und Luftfeuchtigkeit.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Benötigte Menge:</strong> Fläche × Anstriche / Ergiebigkeit pro Liter</p>
        <p><strong>Pigmentanteil:</strong> Abtönfarbe / (Grundfarbe + Abtönfarbe) × 100</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel Abtönfarbe benötige ich?</strong> In der Regel werden 3–10 % Abtönfarbe zur Grundfarbe hinzugefügt, je nach gewünschter Farbintensität. Helle Pastelltöne benötigen weniger Pigment als kräftige Farben.</p>
      <p><strong>Kann ich Dispersions- und Ölfarbe mischen?</strong> Nein. Wasserbasierte und lösemittelbasierte Farben sind nicht mischbar. Stets gleiche Farbgrundlagen verwenden.</p>
      <p><strong>Was beeinflusst die Trocknungszeit?</strong> Höhere Temperaturen beschleunigen die Trocknung, hohe Luftfeuchtigkeit verlangsamt sie. Optimale Bedingungen sind 20 °C und 50 % relative Feuchte.</p>
      <p><strong>Wie viel Farbe reicht für meine Fläche?</strong> Dispersionsfarben decken typischerweise 8–12 m² pro Liter. Kreidefarbe nur ca. 5–8 m² pro Liter.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcFM() {
      const paintType = (document.getElementById('fm-type') as HTMLSelectElement).value;
      const base = parseFloat((document.getElementById('fm-base') as HTMLInputElement).value) || 1000;
      const tint = parseFloat((document.getElementById('fm-tint') as HTMLInputElement).value) || 0;
      const area = parseFloat((document.getElementById('fm-area') as HTMLInputElement).value) || 30;
      const coats = parseInt((document.getElementById('fm-coats') as HTMLInputElement).value) || 2;
      const temp = parseFloat((document.getElementById('fm-temp') as HTMLInputElement).value) || 20;
      const hum = parseFloat((document.getElementById('fm-hum') as HTMLInputElement).value) || 50;

      const coveragePerL: Record<string, number> = { latex: 10, oil: 8, chalk: 6, epoxy: 7, spray: 3 };
      const baseDryHrs: Record<string, number> = { latex: 1, oil: 6, chalk: 0.5, epoxy: 4, spray: 0.25 };
      const baseRecoatHrs: Record<string, number> = { latex: 4, oil: 24, chalk: 1, epoxy: 12, spray: 1 };

      const covPerL = coveragePerL[paintType] || 10;
      const totalArea = area * coats;
      const litersNeeded = totalArea / covPerL;

      const totalMix = base + tint;
      const tintPct = totalMix > 0 ? (tint / totalMix) * 100 : 0;
      function gcd(a: number, b: number): number { return b === 0 ? a : gcd(b, a % b); }
      const g = gcd(Math.round(base / 10), Math.round(tint / 10));
      const ratioBase = g > 0 ? Math.round(base / 10 / g) : Math.round(base / 10);
      const ratioTint = g > 0 ? Math.round(tint / 10 / g) : Math.round(tint / 10);

      const tempFactor = 20 / Math.max(temp, 5);
      const humFactor = 1 + (hum - 50) / 100;
      const dryTime = (baseDryHrs[paintType] || 1) * tempFactor * humFactor;
      const recoatTime = (baseRecoatHrs[paintType] || 4) * tempFactor * humFactor;

      document.getElementById('fm-result')!.textContent = litersNeeded.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Liter';
      document.getElementById('fm-ratio')!.textContent = ratioBase + ':' + ratioTint;
      document.getElementById('fm-tpct')!.textContent = tintPct.toFixed(1).replace('.', ',') + '%';
      document.getElementById('fm-cov')!.textContent = covPerL + ' m\u00B2';
      document.getElementById('fm-dry')!.textContent = dryTime.toFixed(1).replace('.', ',') + ' Std';
      document.getElementById('fm-recoat')!.textContent = recoatTime.toFixed(1).replace('.', ',') + ' Std';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.fm-in').forEach(el => { el.addEventListener('input', calcFM); el.addEventListener('change', calcFM); });
      calcFM();
    }, 50);
  </script>
</CalculatorLayout>
