---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kontaktlinsen-Rechner - Jahreskosten & Vergleich mit Brille";
const description = "Berechnen Sie die jährlichen Kontaktlinsenkosten nach Typ (Tages-, Zwei-Wochen-, Monatslinsen), Pflegemittelkosten, Austauschplan und Vergleich mit Brillen.";
const relatedCalcs = [
  { name: "Gesundheitsversicherung", url: "/de/gesundheitsversicherung-rechner", description: "Krankenversicherungskosten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kontaktlinsen-Rechner" enSlug="contact-lens-calculator" keywords="Kontaktlinsen Kosten, Tageslinsen, Monatslinsen, Kontaktlinsen Rechner, Linsen vs Brille" breadcrumbs={[{ name: "Kontaktlinsen-Rechner", url: "/de/kontaktlinsen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kontaktlinsen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die jährlichen Kontaktlinsenkosten und vergleichen Sie diese mit Brillen über die Zeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Austausch-Rhythmus</label>
            <select id="cl3-type" class="cl3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="daily" selected>Tageslinsen</option>
              <option value="biweekly">2-Wochen-Linsen</option>
              <option value="monthly">Monatslinsen</option>
              <option value="extended">Dauertragelinsen (bis 30 Tage)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Linsen-Kategorie</label>
            <select id="cl3-cat" class="cl3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="spherical" selected>Sphärisch (Standard)</option>
              <option value="toric">Torisch (Hornhautverkrümmung)</option>
              <option value="multifocal">Multifokal</option>
              <option value="color">Farbig</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Preisklasse</label>
            <select id="cl3-brand" class="cl3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="budget">Günstig / Eigenmarke</option>
              <option value="mid" selected>Mittelklasse</option>
              <option value="premium">Premium-Marke</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Tragetage pro Woche</label><input type="number" id="cl3-days" class="cl3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="7" min="1" max="7" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versicherungszuschuss (€)</label><input type="number" id="cl3-ins" class="cl3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="500" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kontaktlinsen-Untersuchung (€)</label><input type="number" id="cl3-exam" class="cl3-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="0" max="200" step="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Jährliche Kontaktlinsenkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="cl3-annual">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Linsen / Jahr</div><div class="text-xl font-bold font-mono" id="cl3-count">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pflegemittelkosten</div><div class="text-xl font-bold font-mono" id="cl3-sol">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="cl3-oop">0 €</div></div>
        </div>
        <div class="p-3 bg-blue-50 rounded-xl text-center text-xs font-semibold text-blue-900 uppercase tracking-wide mb-1">5-Jahres-Vergleich</div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">5 Jahre Kontaktlinsen</div><div class="text-xl font-bold font-mono" id="cl3-five">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">5 Jahre Brille (ca.)</div><div class="text-xl font-bold font-mono" id="cl3-glasses">0 €</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="contact-lens" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kontaktlinsen-Kosten im Überblick</h2>
      <p>Tageslinsen sind pro Linse am günstigsten, aber durch den täglichen Verbrauch über das Jahr am teuersten. Monatslinsen sind langfristig günstiger, erfordern aber Pflegemittel. In Deutschland liegen die Kosten für Kontaktlinsen typischerweise zwischen 200 € und 600 € pro Jahr.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Zahlt die Krankenkasse Kontaktlinsen?</strong> In der Regel nur bei bestimmten Sehstärken (ab +/- 6 Dioptrien) oder medizinischer Indikation.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCL3() {
      const type = (document.getElementById('cl3-type') as HTMLSelectElement).value;
      const cat = (document.getElementById('cl3-cat') as HTMLSelectElement).value;
      const brand = (document.getElementById('cl3-brand') as HTMLSelectElement).value;
      const daysPerWeek = parseFloat((document.getElementById('cl3-days') as HTMLInputElement).value) || 7;
      const insAllow = parseFloat((document.getElementById('cl3-ins') as HTMLInputElement).value) || 0;
      const examExtra = parseFloat((document.getElementById('cl3-exam') as HTMLInputElement).value) || 0;

      const basePrices: Record<string, Record<string, number>> = {
        daily:    { budget: 0.50, mid: 0.80, premium: 1.10 },
        biweekly: { budget: 3.00, mid: 5.00, premium: 7.50 },
        monthly:  { budget: 4.50, mid: 7.50, premium: 11.00 },
        extended: { budget: 5.50, mid: 9.00, premium: 14.00 }
      };

      const catMult: Record<string, number> = { spherical: 1.0, toric: 1.35, multifocal: 1.50, color: 1.20 };
      const pricePerPair = basePrices[type][brand] * (catMult[cat] || 1.0);

      let pairsPerYear = 0;
      const weeksPerYear = 52;
      if (type === 'daily') {
        pairsPerYear = Math.round(daysPerWeek * weeksPerYear);
      } else if (type === 'biweekly') {
        pairsPerYear = Math.ceil(weeksPerYear / 2);
      } else {
        pairsPerYear = 12;
      }

      let solutionCost = 0;
      if (type !== 'daily') {
        solutionCost = 12 * 8;
      }

      const lensCost = Math.round(pairsPerYear * pricePerPair * 2);
      const annualTotal = lensCost + solutionCost + examExtra;
      const oop = Math.max(0, annualTotal - insAllow);
      const fiveYearContacts = oop * 5;
      const fiveYearGlasses = Math.round(400 * 2.5);

      const fmt = (v: number) => v.toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('cl3-annual')!.textContent = fmt(annualTotal);
      document.getElementById('cl3-count')!.textContent = (pairsPerYear * 2) + ' Linsen';
      document.getElementById('cl3-sol')!.textContent = fmt(solutionCost) + '/Jahr';
      document.getElementById('cl3-oop')!.textContent = fmt(oop);
      document.getElementById('cl3-five')!.textContent = fmt(fiveYearContacts);
      document.getElementById('cl3-glasses')!.textContent = fmt(fiveYearGlasses);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.cl3-in').forEach(el => { el.addEventListener('input', calcCL3); el.addEventListener('change', calcCL3); });
      calcCL3();
    }, 50);
  </script>
</CalculatorLayout>
