---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "H&ouml;rger&auml;t-Rechner - Kosten sch&auml;tzen";
const description = "Sch&auml;tzen Sie H&ouml;rger&auml;te-Kosten nach Technologieniveau (Basis, Mittelklasse, Premium), beidseitige Versorgung, Batterie oder wiederaufladbar und Versicherungsschutz.";

const relatedCalcs = [
  { name: "H&ouml;rverlust-Rechner", url: "/de/hoerverlust-rechner", description: "H&ouml;rverlust klassifizieren." },
  { name: "Krankenversicherung-Rechner", url: "/de/krankenversicherung-rechner", description: "Krankenversicherungskosten." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Monatliches Budget planen." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="H&ouml;rger&auml;t-Rechner"
  keywords="h&ouml;rger&auml;t kosten rechner, h&ouml;rger&auml;t preis, beidseitige versorgung, wiederaufladbares h&ouml;rger&auml;t, h&ouml;rger&auml;t versicherung"
  breadcrumbs={[{ name: "H&ouml;rger&auml;t-Rechner", url: "/de/hoergeraet-rechner" }]}
  lang="de"
  enSlug="hearing-aid-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">H&ouml;rger&auml;t-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie H&ouml;rger&auml;te-Kosten einschlie&szlig;lich Technologieniveau, Batterien und Versicherung.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Technologieniveau</label>
            <select id="hgrd-tech" class="hgrd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="otc">OTC (ohne Rezept)</option>
              <option value="basic">Basis / Einstieg</option>
              <option value="mid" selected>Mittelklasse</option>
              <option value="premium">Premium</option>
              <option value="elite">Elite / Top</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bauform</label>
            <select id="hgrd-style" class="hgrd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="bte" selected>Hinter dem Ohr (BTE)</option>
              <option value="rite">Im Geh&ouml;rgang (RIC)</option>
              <option value="ite">Im Ohr (ITE)</option>
              <option value="cic">Vollst&auml;ndig im Geh&ouml;rgang (CIC)</option>
              <option value="iic">Unsichtbar im Geh&ouml;rgang (IIC)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ohren</label>
            <select id="hgrd-ears" class="hgrd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="1">Ein Ohr (einseitig)</option>
              <option value="2" selected>Beide Ohren (beidseitig)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Stromversorgung</label>
            <select id="hgrd-power" class="hgrd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="disposable">Wechselbatterien</option>
              <option value="rechargeable" selected>Wiederaufladbar</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Versicherungszuschuss (&euro;)</label><input type="number" id="hgrd-ins" class="hgrd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="5000" step="50"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Erwartete Lebensdauer (Jahre)</label><input type="number" id="hgrd-life" class="hgrd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="3" max="8" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">H&ouml;rger&auml;te Gesamtkosten</div>
          <div class="text-5xl font-extrabold font-mono" id="hgrd-total">0 &euro;</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Ger&auml;t</div><div class="text-xl font-bold font-mono" id="hgrd-each">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bilateral-Rabatt</div><div class="text-xl font-bold font-mono" id="hgrd-disc">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eigenanteil</div><div class="text-xl font-bold font-mono" id="hgrd-oop">0 &euro;</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Batterien / Jahr</div><div class="text-xl font-bold font-mono" id="hgrd-batt">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro Tag</div><div class="text-xl font-bold font-mono" id="hgrd-daily">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lebenszeit-Kosten</div><div class="text-xl font-bold font-mono" id="hgrd-lifetime">0 &euro;</div></div>
        </div>
      </div>

      <ShareButton calculatorId="hoergeraet-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&ouml;rger&auml;te Kostenguide</h2>
      <p>H&ouml;rger&auml;te-Kosten variieren stark je nach Technologieniveau, Bauform und Anbieter. In Deutschland &uuml;bernehmen die gesetzlichen Krankenkassen einen Festzuschuss von ca. 685-785 &euro; pro Ger&auml;t (Stand 2024). Privatversicherungen k&ouml;nnen h&ouml;here Zuschl&auml;ge leisten.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie viel kostet ein H&ouml;rger&auml;t in Deutschland?</strong> Einstiegsger&auml;te kosten ca. 700-1.500 &euro;, Mittelklasse 1.500-3.000 &euro; und Premium-Ger&auml;te 3.000-5.000 &euro; pro Ohr. Die Krankenkasse zahlt einen Festzuschuss.</p>
      <p><strong>Wie lange h&auml;lt ein H&ouml;rger&auml;t?</strong> Die durchschnittliche Lebensdauer betr&auml;gt 5-7 Jahre. Danach hat man wieder Anspruch auf einen Kassenzuschuss.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHGRD() {
      const tech = (document.getElementById('hgrd-tech') as HTMLSelectElement).value;
      const style = (document.getElementById('hgrd-style') as HTMLSelectElement).value;
      const ears = parseInt((document.getElementById('hgrd-ears') as HTMLSelectElement).value) || 2;
      const power = (document.getElementById('hgrd-power') as HTMLSelectElement).value;
      const ins = parseFloat((document.getElementById('hgrd-ins') as HTMLInputElement).value) || 0;
      const lifespan = parseFloat((document.getElementById('hgrd-life') as HTMLInputElement).value) || 5;

      const techCosts: Record<string, number> = { otc: 700, basic: 1200, mid: 2000, premium: 3500, elite: 5000 };
      const styleMult: Record<string, number> = { bte: 0.9, rite: 1.0, ite: 1.05, cic: 1.15, iic: 1.25 };

      const perAid = Math.round(techCosts[tech] * (styleMult[style] || 1.0));
      const bilateralDiscount = ears === 2 ? Math.round(perAid * 0.10) : 0;
      const totalDevice = ears === 2 ? (perAid * 2 - bilateralDiscount) : perAid;

      let annualBattery = 0;
      if (power === 'disposable') {
        annualBattery = Math.round((365 / 5) * ears * 0.8);
      }

      const oop = Math.max(0, totalDevice - ins);
      const lifetimeCost = oop + annualBattery * lifespan;
      const dailyCost = lifetimeCost / (lifespan * 365);

      const fmtE = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' \u20AC';

      document.getElementById('hgrd-total')!.textContent = fmtE(totalDevice);
      document.getElementById('hgrd-each')!.textContent = fmtE(perAid);
      document.getElementById('hgrd-disc')!.textContent = ears === 2 ? '-' + fmtE(bilateralDiscount) : 'N/A';
      document.getElementById('hgrd-oop')!.textContent = fmtE(oop);
      document.getElementById('hgrd-batt')!.textContent = fmtE(annualBattery) + '/J.';
      document.getElementById('hgrd-daily')!.textContent = dailyCost.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
      document.getElementById('hgrd-lifetime')!.textContent = fmtE(lifetimeCost);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hgrd-in').forEach(el => { el.addEventListener('input', calcHGRD); el.addEventListener('change', calcHGRD); });
      calcHGRD();
    }, 50);
  </script>
</CalculatorLayout>
