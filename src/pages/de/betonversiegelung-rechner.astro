---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Betonversiegelungs-Rechner - Ergiebigkeit & Anstriche";
const description = "Berechnen Sie die Betonversiegelungs-Ergiebigkeit, Anzahl der Anstriche und Gesamtmenge. Unterst\u00fctzt Imprägnierung, Acryl, Epoxid und Polyurethan.";
const relatedCalcs = [
  { name: "Betonrechner", url: "/de/beton-rechner", description: "Betonvolumen." },
  { name: "Betonplattenrechner", url: "/de/betonplatte-rechner", description: "Plattenvolumen." },
  { name: "Betonfarbe-Rechner", url: "/de/betonfarbe-rechner", description: "Farbpigment." },
  { name: "Betonh\u00e4rtungsrechner", url: "/de/betonhaertung-rechner", description: "Aush\u00e4rtung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Betonversiegelungs-Rechner" lang="de" enSlug="concrete-sealer-calculator" keywords="betonversiegelung, versiegelung ergiebigkeit, impr\u00e4gnierung, acrylversiegelung, epoxidversiegelung, betonschutz" breadcrumbs={[{ name: "Betonversiegelung", url: "/de/betonversiegelung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Betonversiegelungs-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie den Versiegelungsbedarf basierend auf Fl&auml;che, Versiegelungstyp und Betonoberfl&auml;che.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-5">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium text-text mb-2">L&auml;nge (m)</label><input type="number" id="bv-length" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0.5" step="0.5"></div>
          <div><label class="block text-sm font-medium text-text mb-2">Breite (m)</label><input type="number" id="bv-width" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0.5" step="0.5"></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Versiegelungstyp</label>
          <select id="bv-type" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="penetrating" selected>Impr&auml;gnierung (Silan/Siloxan)</option>
            <option value="acrylic">Acrylversiegelung (filmbildend)</option>
            <option value="epoxy">Epoxidbeschichtung</option>
            <option value="polyurethane">Polyurethanbeschichtung</option>
            <option value="densifier">Lithiumsilikat-Verdichter</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Betonoberfl&auml;che / Porosit&auml;t</label>
          <select id="bv-porosity" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="smooth">Glatt / Gegl&auml;ttet (geringe Porosit&auml;t)</option>
            <option value="medium" selected>Besenstrich (mittlere Porosit&auml;t)</option>
            <option value="rough">Waschbeton / Rau (hohe Porosit&auml;t)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-2">Anzahl Anstriche</label>
          <select id="bv-coats" class="bv-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="1">1 Anstrich</option>
            <option value="2" selected>2 Anstriche (empfohlen)</option>
            <option value="3">3 Anstriche</option>
          </select>
        </div>
      </div>
      <div class="mt-6 space-y-3">
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamter Versiegelungsbedarf</div>
          <div class="text-4xl font-extrabold" id="bv-liters">0 Liter</div>
          <div class="text-sm text-blue-200 mt-1">f&uuml;r <span id="bv-coat-count">2</span> Anstriche</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fl&auml;che</div><div class="text-xl font-bold" id="bv-area">0 m&sup2;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ergiebigkeit</div><div class="text-xl font-bold" id="bv-rate">0 m&sup2;/L</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Pro Anstrich</div><div class="text-xl font-bold" id="bv-percoat">0 L</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gebinde (5 L)</div><div class="text-xl font-bold" id="bv-pails">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">&Uuml;berarbeitungszeit</div><div class="text-xl font-bold" id="bv-recoat">-</div></div>
      </div>
      <ShareButton calculatorId="concrete-sealer" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Betonversiegelungstypen</h2>
      <ul>
        <li><strong>Impr&auml;gnierung:</strong> 3-5 m&sup2;/L, unsichtbares Finish, ideal f&uuml;r Einfahrten</li>
        <li><strong>Acryl:</strong> 4-6 m&sup2;/L, Nassoptik oder matt, dekorativer Beton</li>
        <li><strong>Epoxid:</strong> 4-5 m&sup2;/L, Hochglanz, Garagenb&ouml;den</li>
        <li><strong>Polyurethan:</strong> 4-5 m&sup2;/L, hohe Abriebfestigkeit</li>
        <li><strong>Verdichter:</strong> 4-6 m&sup2;/L, h&auml;rtet und entstaubt die Oberfl&auml;che</li>
      </ul>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    interface BvSpec { coverageSmooth: number; coverageMedium: number; coverageRough: number; recoatTime: string; }
    const bvSpecs: Record<string, BvSpec> = {
      penetrating:  { coverageSmooth: 5, coverageMedium: 4, coverageRough: 3, recoatTime: '1-4 Stunden' },
      acrylic:      { coverageSmooth: 6, coverageMedium: 5, coverageRough: 4, recoatTime: '2-4 Stunden' },
      epoxy:        { coverageSmooth: 5, coverageMedium: 4.5, coverageRough: 3.5, recoatTime: '12-24 Stunden' },
      polyurethane: { coverageSmooth: 5, coverageMedium: 4.5, coverageRough: 3.5, recoatTime: '8-16 Stunden' },
      densifier:    { coverageSmooth: 6, coverageMedium: 5, coverageRough: 4, recoatTime: '4-8 Stunden' },
    };
    function calcBV() {
      const length = parseFloat((document.getElementById('bv-length') as HTMLInputElement).value) || 0;
      const width = parseFloat((document.getElementById('bv-width') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('bv-type') as HTMLSelectElement).value;
      const porosity = (document.getElementById('bv-porosity') as HTMLSelectElement).value;
      const coats = parseInt((document.getElementById('bv-coats') as HTMLSelectElement).value) || 2;
      const spec = bvSpecs[type] || bvSpecs.penetrating;
      const area = length * width;
      let coverageRate = spec.coverageMedium;
      if (porosity === 'smooth') coverageRate = spec.coverageSmooth;
      else if (porosity === 'rough') coverageRate = spec.coverageRough;
      const litersPerCoat = area / coverageRate;
      const totalLiters = litersPerCoat * coats;
      const pails = Math.ceil(totalLiters / 5);
      document.getElementById('bv-liters')!.textContent = totalLiters.toFixed(1).replace('.', ',') + ' Liter';
      document.getElementById('bv-coat-count')!.textContent = String(coats);
      document.getElementById('bv-area')!.textContent = Math.round(area).toLocaleString('de-DE') + ' m\u00B2';
      document.getElementById('bv-rate')!.textContent = coverageRate.toFixed(1).replace('.', ',') + ' m\u00B2/L';
      document.getElementById('bv-percoat')!.textContent = litersPerCoat.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('bv-pails')!.textContent = String(pails);
      document.getElementById('bv-recoat')!.textContent = spec.recoatTime;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.bv-in').forEach(el => { el.addEventListener('input', calcBV); el.addEventListener('change', calcBV); });
      calcBV();
    }, 50);
  </script>
</CalculatorLayout>
