---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Lederrechner";
const description = "Berechnen Sie Lederbedarf, Verschnitt und Kosten für Lederarbeiten.";

const relatedCalcs = [
  { name: "Strickmuster Rechner", url: "/de/strickmuster-rechner", description: "Garnmenge berechnen." },
  { name: "Etikettenrechner", url: "/de/etiketten-rechner", description: "Druckkosten berechnen." },
  { name: "Laminierungsrechner", url: "/de/laminierungs-rechner", description: "Folienkosten berechnen." },
  { name: "Gewinnmarge-Rechner", url: "/de/gewinnmarge-rechner", description: "Gewinnmargen berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Lederrechner" lang="de" enSlug="leather-calculator" keywords="lederrechner, lederbedarf berechnen, leder verschnitt, leder kosten" breadcrumbs={[{ name: "Lederrechner", url: "/de/leder-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lederrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Lederbedarf, Verschnitt und Materialkosten für Ihre Lederprojekte.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stückbreite (cm)</label><input type="number" id="ldr-pw" class="ldr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stücklänge (cm)</label><input type="number" id="ldr-pl" class="ldr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="25" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Stücke</label><input type="number" id="ldr-qty" class="ldr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verschnittfaktor (%)</label><input type="number" id="ldr-waste" class="ldr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="60" step="5"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lederpreis (€/dm²)</label><input type="number" id="ldr-price" class="ldr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3.50" min="0" step="0.10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Ledersorte</label><select id="ldr-type" class="ldr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.0" selected>Rindsleder</option>
            <option value="1.1">Kalbsleder</option>
            <option value="0.9">Schweinsleder</option>
            <option value="1.2">Lammleder</option>
            <option value="1.3">Krokodilleder</option>
          </select></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigter Lederbedarf</div>
          <div class="text-4xl font-extrabold font-mono" id="ldr-area">0 dm²</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Nettofläche</div><div class="text-xl font-bold" id="ldr-net">0 dm²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtkosten</div><div class="text-xl font-bold" id="ldr-total">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Stück</div><div class="text-xl font-bold" id="ldr-unit">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="leather-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Lederbedarf berechnen – Tipps für Lederarbeiter</h2>
      <p>Bei der Planung von Lederprojekten ist der Verschnitt ein wichtiger Faktor. Je nach Form der Zuschnitte und Qualität des Leders muss ein Zuschlag von 15–30 % auf die Nettofläche einkalkuliert werden. Leder wird üblicherweise in Dezimeter (dm²) berechnet und gehandelt. Eine Rindshaut hat je nach Größe 200–300 dm², eine Schaffell etwa 60–100 dm².</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Narben- und Spaltleder?</strong> Narbenleder ist die natürliche, feste Außenseite der Haut und besonders hochwertig. Spaltleder ist die aufgetrennte Innenseite, günstiger und weniger reißfest.</p>
      <p><strong>Wie messe ich Leder richtig?</strong> Leder wird in Dezimeter (1 dm = 10 cm) gemessen. 1 dm² = 100 cm². Kaufen Sie immer etwas mehr als berechnet, um Fehler und Verschnitt auszugleichen.</p>
      <p><strong>Welches Werkzeug brauche ich für Lederarbeiten?</strong> Grundausrüstung: Ledermesser, Stahllineal, Lederstempel, Nähahle, Lederfaden und Schmirgelpapier für Schnittkanten.</p>
      <p><strong>Wie pflege ich Leder?</strong> Regelmäßige Pflege mit Lederfett oder -creme hält das Material geschmeidig und schützt vor Austrocknung und Rissen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const ldrFmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
    function calcLDR() {
      const pw = parseFloat((document.getElementById('ldr-pw') as HTMLInputElement).value) || 0;
      const pl = parseFloat((document.getElementById('ldr-pl') as HTMLInputElement).value) || 0;
      const qty = parseFloat((document.getElementById('ldr-qty') as HTMLInputElement).value) || 0;
      const waste = parseFloat((document.getElementById('ldr-waste') as HTMLInputElement).value) / 100 || 0;
      const price = parseFloat((document.getElementById('ldr-price') as HTMLInputElement).value) || 0;
      const typeFactor = parseFloat((document.getElementById('ldr-type') as HTMLSelectElement).value) || 1;
      const pieceDm2 = (pw / 10) * (pl / 10);
      const netArea = pieceDm2 * qty;
      const grossArea = netArea * (1 + waste) * typeFactor;
      const total = grossArea * price;
      const unitCost = qty > 0 ? total / qty : 0;
      document.getElementById('ldr-area')!.textContent = grossArea.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' dm\u00B2';
      document.getElementById('ldr-net')!.textContent = netArea.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' dm\u00B2';
      document.getElementById('ldr-total')!.textContent = ldrFmt(total);
      document.getElementById('ldr-unit')!.textContent = ldrFmt(unitCost);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.ldr-in').forEach(el => { el.addEventListener('input', calcLDR); el.addEventListener('change', calcLDR); }); calcLDR(); }, 50);
  </script>
</CalculatorLayout>
