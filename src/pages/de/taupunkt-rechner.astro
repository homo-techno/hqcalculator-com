---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Taupunkt-Rechner - Luftfeuchtigkeit & Kondensation";
const description = "Berechnen Sie die Taupunkttemperatur aus Lufttemperatur und relativer Luftfeuchtigkeit mit der Magnus-Formel.";

const relatedCalcs = [
  { name: "Temperaturumrechner", url: "/de/temperaturumrechner", description: "Temperatur umrechnen." },
  { name: "Wissenschaftlicher Rechner", url: "/de/wissenschaftlicher-rechner", description: "Berechnungen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Druckumrechner", url: "/de/druckumrechner", description: "Druckeinheiten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Taupunkt-Rechner" lang="de" enSlug="dew-point-calculator" keywords="taupunkt rechner, taupunkttemperatur, relative luftfeuchtigkeit, kondensationspunkt, magnus formel" breadcrumbs={[{ name: "Taupunkt-Rechner", url: "/de/taupunkt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Taupunkt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Taupunkttemperatur aus Temperatur und Luftfeuchtigkeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Lufttemperatur (&deg;C)</label><input type="number" id="tpr-temp" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="24" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Relative Luftfeuchtigkeit (%)</label><input type="number" id="tpr-hum" class="tpr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="55" min="0" max="100" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Taupunkt</div>
          <div class="text-5xl font-extrabold font-mono" id="tpr-result">0&deg;C</div>
        </div>
        <div class="p-4 rounded-xl text-center" id="tpr-comfort-box">
          <div class="font-bold text-sm" id="tpr-comfort">-</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Taupunkt (&deg;F)</div><div class="text-xl font-bold font-mono" id="tpr-f">0&deg;F</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spread</div><div class="text-xl font-bold font-mono" id="tpr-spread">0&deg;C</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abs. Feuchte</div><div class="text-xl font-bold font-mono" id="tpr-abs">0 g/m&sup3;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Behaglichkeitsskala</h3>
          <div class="text-xs space-y-1">
            <div>Unter 10&deg;C: Trocken, angenehm</div>
            <div>10-15&deg;C: Angenehm</div>
            <div>15-18&deg;C: Beginnt sich feucht anzuf&uuml;hlen</div>
            <div>18-21&deg;C: Unangenehm, schw&uuml;l</div>
            <div>&Uuml;ber 21&deg;C: Dr&uuml;ckend, gef&auml;hrlich</div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="dew-point-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist der Taupunkt?</h2>
      <p>Der Taupunkt ist die Temperatur, bei der die Luft mit Wasserdampf ges&auml;ttigt ist und Kondensation einsetzt. Er wird mit der Magnus-Formel berechnet und ist ein wichtiger Indikator f&uuml;r Behaglichkeit und Schimmelrisiko.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wann entsteht Schimmel?</strong> Wenn die Wandoberfl&auml;chentemperatur unter den Taupunkt f&auml;llt, kondensiert Feuchtigkeit &ndash; ein Risiko f&uuml;r Schimmelbildung.</p>
      <p><strong>Was ist ein guter Taupunkt im Haus?</strong> Ein Taupunkt von 10-15&deg;C gilt als angenehm. &Uuml;ber 18&deg;C wird es als schw&uuml;l empfunden.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcTPR() {
      const tC = parseFloat((document.getElementById('tpr-temp') as HTMLInputElement).value) || 24;
      const rh = parseFloat((document.getElementById('tpr-hum') as HTMLInputElement).value) || 50;
      const a = 17.27, b = 237.7;
      const alpha = (a * tC) / (b + tC) + Math.log(rh / 100);
      const dpC = (b * alpha) / (a - alpha);
      const dpF = dpC * 9 / 5 + 32;
      const absH = 216.7 * (rh / 100 * 6.112 * Math.exp(17.67 * tC / (tC + 243.5))) / (273.15 + tC);

      document.getElementById('tpr-result')!.textContent = dpC.toFixed(1).replace('.', ',') + '\u00B0C';
      document.getElementById('tpr-f')!.textContent = dpF.toFixed(1).replace('.', ',') + '\u00B0F';
      document.getElementById('tpr-spread')!.textContent = (tC - dpC).toFixed(1).replace('.', ',') + '\u00B0C';
      document.getElementById('tpr-abs')!.textContent = absH.toFixed(2).replace('.', ',') + ' g/m\u00B3';

      let comfort: string, color: string;
      if (dpC < 10) { comfort = 'Trocken & angenehm'; color = 'bg-green-50 text-green-800'; }
      else if (dpC < 15) { comfort = 'Angenehm'; color = 'bg-green-50 text-green-800'; }
      else if (dpC < 18) { comfort = 'Beginnt sich feucht anzuf\u00fchlen'; color = 'bg-yellow-50 text-yellow-800'; }
      else if (dpC < 21) { comfort = 'Unangenehm / Schw\u00fcl'; color = 'bg-orange-50 text-orange-800'; }
      else { comfort = 'Dr\u00fcckend / Unertr\u00e4glich'; color = 'bg-red-50 text-red-800'; }

      document.getElementById('tpr-comfort')!.textContent = comfort;
      document.getElementById('tpr-comfort-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.tpr-in').forEach(el => el.addEventListener('input', calcTPR)); calcTPR(); }, 50);
  </script>
</CalculatorLayout>
