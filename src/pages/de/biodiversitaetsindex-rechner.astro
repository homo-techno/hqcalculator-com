---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Biodiversit\u00e4tsindex-Rechner - Shannon- & Simpson-Diversit\u00e4t";
const description = "Berechnen Sie Shannon-Diversit\u00e4tsindex (H'), Simpson-Index (D), Artenreichtum und Gleichm\u00e4\u00dfigkeit f\u00fcr \u00f6kologische Gemeinschaftsanalysen.";
const relatedCalcs = [
  { name: "Logarithmus-Rechner", url: "/logarithm-calculator", description: "Logarithmusberechnungen." },
  { name: "Prozentrechner", url: "/percentage-calculator", description: "Prozentberechnungen." },
  { name: "Durchschnittsrechner", url: "/average-calculator", description: "Statistische Durchschnitte." },
  { name: "Wissenschaftlicher Rechner", url: "/scientific-calculator", description: "Wissenschaftliche Berechnungen." },
  { name: "Wahrscheinlichkeitsrechner", url: "/probability-calculator", description: "Wahrscheinlichkeitsberechnung." },
  { name: "Prozentuale Ver\u00e4nderung", url: "/percentage-change-calculator", description: "Prozentuale Ver\u00e4nderung." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Biodiversit\u00e4tsindex-Rechner" lang="de" keywords="biodiversit\u00e4t, shannon index, simpson index, artenreichtum, gleichm\u00e4\u00dfigkeit, diversit\u00e4t, \u00f6kologie" breadcrumbs={[{ name: "Biodiversit\u00e4tsindex-Rechner", url: "/de/biodiversitaetsindex-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Biodiversit&auml;tsindex-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Shannon (H'), Simpson (D), Artenreichtum und Gleichm&auml;&szlig;igkeit aus Artenh&auml;ufigkeitsdaten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Artenh&auml;ufigkeiten (kommagetrennte Anzahlen)</label>
          <textarea id="bi-data" class="bi-in w-full px-4 py-3 border border-border rounded-xl font-mono text-sm" rows="3" placeholder="Geben Sie Anzahlen ein, z.B.: 50, 30, 20, 15, 10, 5"></textarea>
          <p class="text-xs text-text-muted mt-1">Geben Sie die Individuenzahl pro Art ein, durch Komma getrennt.</p>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Shannon-Diversit&auml;tsindex (H')</div>
          <div class="text-5xl font-extrabold font-mono" id="bi-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Simpson D</div><div class="text-xl font-bold font-mono" id="bi-s1">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">1-D (Diversit&auml;t)</div><div class="text-xl font-bold font-mono" id="bi-s2">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">1/D (Reziprok)</div><div class="text-xl font-bold font-mono" id="bi-s3">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Artenreichtum (S)</div><div class="text-xl font-bold font-mono" id="bi-s4">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gleichm&auml;&szlig;igkeit (J')</div><div class="text-xl font-bold font-mono" id="bi-s5">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Individuen gesamt</div><div class="text-xl font-bold font-mono" id="bi-s6">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Interpretation</div><div class="text-lg font-bold" id="bi-interp">--</div></div>
      </div>
      <ShareButton calculatorId="biodiversity-index" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBI() {
      const raw = (document.getElementById('bi-data') as HTMLTextAreaElement).value;
      const counts = raw.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n) && n > 0);
      const S = counts.length;
      const N = counts.reduce((a, b) => a + b, 0);
      if (S === 0 || N === 0) {
        document.getElementById('bi-result')!.textContent = '--';
        ['bi-s1','bi-s2','bi-s3','bi-s4','bi-s5','bi-s6','bi-interp'].forEach(id => {
          document.getElementById(id)!.textContent = '--';
        });
        return;
      }
      let H = 0;
      let D = 0;
      for (const n of counts) {
        const pi = n / N;
        if (pi > 0) {
          H -= pi * Math.log(pi);
          D += pi * pi;
        }
      }
      const Hmax = Math.log(S);
      const J = Hmax > 0 ? H / Hmax : 0;
      const oneMinusD = 1 - D;
      const recipD = D > 0 ? 1 / D : 0;
      let interp: string;
      if (H < 1) interp = 'Geringe Diversit\u00e4t \u2013 Gemeinschaft von wenigen Arten dominiert';
      else if (H < 2) interp = 'M\u00e4\u00dfige Diversit\u00e4t';
      else if (H < 3) interp = 'Gute Diversit\u00e4t \u2013 relativ ausgeglichene Gemeinschaft';
      else interp = 'Hohe Diversit\u00e4t \u2013 sehr artenreich und gleichm\u00e4\u00dfig';
      document.getElementById('bi-result')!.textContent = H.toFixed(4).replace('.', ',');
      document.getElementById('bi-s1')!.textContent = D.toFixed(4).replace('.', ',');
      document.getElementById('bi-s2')!.textContent = oneMinusD.toFixed(4).replace('.', ',');
      document.getElementById('bi-s3')!.textContent = recipD.toFixed(4).replace('.', ',');
      document.getElementById('bi-s4')!.textContent = S.toString();
      document.getElementById('bi-s5')!.textContent = J.toFixed(4).replace('.', ',');
      document.getElementById('bi-s6')!.textContent = N.toLocaleString('de-DE');
      document.getElementById('bi-interp')!.textContent = interp;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('bi-data') as HTMLTextAreaElement).value = '50, 30, 20, 15, 10, 5, 3, 2';
      document.querySelectorAll('.bi-in').forEach(el => { el.addEventListener('input', calcBI); el.addEventListener('change', calcBI); });
      calcBI();
    }, 50);
  </script>
</CalculatorLayout>
