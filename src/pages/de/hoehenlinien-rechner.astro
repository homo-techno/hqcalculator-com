---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Höhenlinien-Rechner - Kartenmaßstab & Gelände";
const description = "Bestimmen Sie das empfohlene Höhenlinienintervall basierend auf Kartenmaßstab, Geländetyp und Höhenbereich für topografische Kartierung.";
const relatedCalcs = [
  { name: "Neigungsrechner", url: "/de/neigungsrechner", description: "Neigungsumrechnung." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten umrechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Höhenlinien-Rechner" enSlug="contour-interval-calculator" keywords="Höhenlinien Rechner, topografische Karte, Kartenmaßstab, Höhenlinienintervall, Geländekartierung, Isohypsen" breadcrumbs={[{ name: "Höhenlinien-Rechner", url: "/de/hoehenlinien-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Höhenlinien-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Wählen Sie Geländetyp und Kartenmaßstab, um das empfohlene Höhenlinienintervall zu finden, oder geben Sie den Höhenbereich ein, um die Anzahl der Höhenlinien zu berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Kartenmaßstab (1:N)</label>
          <select id="ci2-scale" class="ci2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1000">1:1.000</option>
            <option value="2400">1:2.400</option>
            <option value="5000">1:5.000</option>
            <option value="10000">1:10.000</option>
            <option value="24000" selected>1:24.000</option>
            <option value="50000">1:50.000</option>
            <option value="100000">1:100.000</option>
            <option value="250000">1:250.000</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Geländetyp</label>
          <select id="ci2-terrain" class="ci2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="flat">Flach (0-2% Neigung)</option>
            <option value="rolling" selected>Hügelig (2-10% Neigung)</option>
            <option value="hilly">Bergig (10-30% Neigung)</option>
            <option value="mountainous">Hochgebirge (30%+ Neigung)</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Min. Höhe (m)</label>
            <input type="number" id="ci2-min" class="ci2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150">
          </div>
          <div>
            <label class="block text-sm font-semibold text-text mb-1">Max. Höhe (m)</label>
            <input type="number" id="ci2-max" class="ci2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="400">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlenes Höhenlinienintervall</div>
          <div class="text-5xl font-extrabold font-mono" id="ci2-interval">--</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Anzahl Höhenlinien</div>
            <div class="text-xl font-bold" id="ci2-count">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zählhöhenlinie</div>
            <div class="text-xl font-bold" id="ci2-index">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Höhenbereich</div>
            <div class="text-xl font-bold" id="ci2-range">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Hilfshöhenlinie</div>
            <div class="text-xl font-bold" id="ci2-supp">--</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="contour-interval" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Richtlinien für Höhenlinienintervalle</h2>
      <p>Das Höhenlinienintervall hängt vom Kartenmaßstab und dem Geländerelief ab. Flaches Gelände erfordert kleinere Intervalle für Details, während bergiges Gelände größere Intervalle verwendet, um Überfüllung zu vermeiden. Zählhöhenlinien (typischerweise jede 5. Linie) werden dicker gezeichnet.</p>

      <h3 class="text-xl font-semibold text-text mt-6">Häufig gestellte Fragen</h3>
      <p><strong>Was sind Zählhöhenlinien?</strong> Jede fünfte Höhenlinie wird als Zählhöhenlinie dicker dargestellt und mit der Höhenangabe beschriftet.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcCI2() {
      const scale = parseFloat((document.getElementById('ci2-scale') as HTMLSelectElement).value);
      const terrain = (document.getElementById('ci2-terrain') as HTMLSelectElement).value;
      const minEl = parseFloat((document.getElementById('ci2-min') as HTMLInputElement).value) || 0;
      const maxEl = parseFloat((document.getElementById('ci2-max') as HTMLInputElement).value) || 0;
      const range = Math.abs(maxEl - minEl);
      const intervals: Record<string, Record<string, number>> = {
        '1000': { flat: 0.5, rolling: 1, hilly: 2, mountainous: 2 },
        '2400': { flat: 1, rolling: 2, hilly: 2, mountainous: 5 },
        '5000': { flat: 1, rolling: 2, hilly: 5, mountainous: 5 },
        '10000': { flat: 2, rolling: 5, hilly: 5, mountainous: 10 },
        '24000': { flat: 2, rolling: 5, hilly: 10, mountainous: 20 },
        '50000': { flat: 5, rolling: 10, hilly: 20, mountainous: 25 },
        '100000': { flat: 10, rolling: 25, hilly: 25, mountainous: 50 },
        '250000': { flat: 25, rolling: 50, hilly: 50, mountainous: 100 },
      };
      const ci = intervals[String(scale)]?.[terrain] || 5;
      const count = range > 0 ? Math.floor(range / ci) : 0;
      const indexCI = ci * 5;
      const suppCI = ci / 2;
      document.getElementById('ci2-interval')!.textContent = ci + ' m';
      document.getElementById('ci2-count')!.textContent = String(count);
      document.getElementById('ci2-index')!.textContent = indexCI + ' m';
      document.getElementById('ci2-range')!.textContent = range.toLocaleString('de-DE') + ' m';
      document.getElementById('ci2-supp')!.textContent = suppCI + ' m';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ci2-in').forEach(el => { el.addEventListener('input', calcCI2); el.addEventListener('change', calcCI2); });
      calcCI2();
    }, 50);
  </script>
</CalculatorLayout>
