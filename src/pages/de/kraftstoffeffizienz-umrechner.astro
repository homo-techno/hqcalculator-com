---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kraftstoffeffizienz-Umrechner - L/100km, km/L, MPG";
const description = "Rechnen Sie zwischen Kraftstoffverbrauchseinheiten um: L/100km, km/L, MPG (US/UK).";
const relatedCalcs = [
  { name: "Spritkosten-Rechner", url: "/de/spritkosten-rechner", description: "Spritkosten." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "CO2-Fu\u00DFabdruck-Rechner", url: "/de/co2-fussabdruck-rechner", description: "CO2-Emissionen." },
  { name: "Elektrofahrzeug-Rechner", url: "/de/elektrofahrzeug-rechner", description: "EV-Rechner." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kraftstoffeffizienz-Umrechner" lang="de" enSlug="fuel-efficiency-converter" keywords="kraftstoffeffizienz umrechner, l/100km in mpg, km/l, spritverbrauch umrechnen, verbrauchsumrechner" breadcrumbs={[{ name: "Kraftstoffeffizienz", url: "/de/kraftstoffeffizienz-umrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kraftstoffeffizienz-Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie zwischen weltweiten Kraftstoffverbrauchseinheiten um.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wert</label><input type="number" id="keu-val" class="keu-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="7" min="0" step="0.1"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Einheit</label>
            <select id="keu-unit" class="keu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="l100km" selected>L/100km</option>
              <option value="kml">km/L</option>
              <option value="mpg_us">MPG (US)</option>
              <option value="mpg_uk">MPG (UK)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Umrechnung</div>
          <div class="text-3xl font-extrabold font-mono" id="keu-result">-</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">L/100km</div><div class="text-xl font-bold font-mono" id="keu-l100">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">km/L</div><div class="text-xl font-bold font-mono" id="keu-kml">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MPG (US)</div><div class="text-xl font-bold font-mono" id="keu-mpgus">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MPG (UK)</div><div class="text-xl font-bold font-mono" id="keu-mpguk">0</div></div>
        </div>
        <div class="p-4 rounded-xl text-center" id="keu-rating-box">
          <div class="font-bold text-sm" id="keu-rating">-</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="fuel-efficiency-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Kraftstoffverbrauch umrechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>L/100km = 235,215 / MPG (US)</p>
        <p>km/L = 100 / L/100km</p>
        <p>MPG (UK) = MPG (US) &times; 1,201</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein guter Verbrauch?</strong> F&uuml;r Benziner gilt unter 6 L/100km als sparsam, 6-8 L/100km als durchschnittlich, &uuml;ber 10 L/100km als hoch.</p>
      <p><strong>Warum verwendet Europa L/100km?</strong> In Europa wird L/100km bevorzugt, da ein niedrigerer Wert einen geringeren Verbrauch anzeigt, was intuitiver ist.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKEU() {
      const val = parseFloat((document.getElementById('keu-val') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('keu-unit') as HTMLSelectElement).value;
      let kml: number;
      if (unit === 'mpg_us') kml = val * 0.425144;
      else if (unit === 'mpg_uk') kml = val * 0.354006;
      else if (unit === 'l100km') kml = val > 0 ? 100 / val : 0;
      else kml = val;
      const mpgUS = kml / 0.425144;
      const mpgUK = kml / 0.354006;
      const l100 = kml > 0 ? 100 / kml : 0;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      document.getElementById('keu-mpgus')!.textContent = fmt(mpgUS);
      document.getElementById('keu-mpguk')!.textContent = fmt(mpgUK);
      document.getElementById('keu-l100')!.textContent = fmt(l100);
      document.getElementById('keu-kml')!.textContent = fmt(kml);
      document.getElementById('keu-result')!.textContent = fmt(l100) + ' L/100km = ' + fmt(mpgUS) + ' MPG';
      let rating: string, color: string;
      if (l100 <= 5) { rating = 'Hervorragender Verbrauch'; color = 'bg-green-50 text-green-800'; }
      else if (l100 <= 7) { rating = 'Guter Verbrauch'; color = 'bg-green-50 text-green-800'; }
      else if (l100 <= 10) { rating = 'Durchschnittlicher Verbrauch'; color = 'bg-yellow-50 text-yellow-800'; }
      else if (l100 <= 13) { rating = 'Unterdurchschnittlich'; color = 'bg-orange-50 text-orange-800'; }
      else { rating = 'Hoher Verbrauch'; color = 'bg-red-50 text-red-800'; }
      document.getElementById('keu-rating')!.textContent = rating;
      document.getElementById('keu-rating-box')!.className = 'p-4 rounded-xl text-center ' + color;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.keu-in').forEach(el => { el.addEventListener('input', calcKEU); el.addEventListener('change', calcKEU); });
      calcKEU();
    }, 50);
  </script>
</CalculatorLayout>
