---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Haarverl&auml;ngerung-Rechner - Tressen, Methode & Volumen";
const description = "Berechnen Sie, wie viele Haarverl&auml;ngerung-Tressen oder -Teile Sie ben&ouml;tigen, basierend auf Methode, gew&uuml;nschter L&auml;nge und Volumenziel.";
const relatedCalcs = [
  { name: "Haarwachstum-Rechner", url: "/de/haarwachstum-rechner", description: "Wachstumsrate." },
  { name: "Haarfarbe-Mischen-Rechner", url: "/de/haarfarbe-mischen-rechner", description: "Mischverh&auml;ltnisse." },
  { name: "Haarentwickler-Rechner", url: "/de/haarentwickler-rechner", description: "Entwicklerauswahl." },
  { name: "Haarporositaet-Rechner", url: "/de/haarporositaet-rechner", description: "Porosit&auml;t." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Haarverl&auml;ngerung-Rechner" lang="de" enSlug="hair-extension-calculator" keywords="haarverl&auml;ngerung, extensions, tressen, clip-in, tape-in, bonding, haarverl&auml;ngerung l&auml;nge, haarvolumen" breadcrumbs={[{ name: "Haarverl&auml;ngerung", url: "/de/haarverlaengerung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Haarverl&auml;ngerung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie, wie viele Extension-Tressen oder -Teile Sie f&uuml;r Ihren gew&uuml;nschten Look ben&ouml;tigen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Extension-Methode</label>
          <select id="hvde-method" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="clipin">Clip-In Extensions</option>
            <option value="tapein" selected>Tape-In Extensions</option>
            <option value="sewin">Ein&auml;hen / Weave</option>
            <option value="fusion">Fusion / Keratin-Bonding</option>
            <option value="microlink">Micro-Link / I-Tip</option>
            <option value="halo">Halo-Draht</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschte L&auml;nge</label>
          <select id="hvde-length" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="30">30 cm (Schulter)</option>
            <option value="35">35 cm (unter Schulter)</option>
            <option value="40" selected>40 cm (Mitte R&uuml;cken)</option>
            <option value="45">45 cm (BH-Verschluss)</option>
            <option value="50">50 cm (Taille)</option>
            <option value="55">55 cm (unter Taille)</option>
            <option value="60">60 cm (H&uuml;fte)</option>
            <option value="65">65+ cm (extra lang)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Nat&uuml;rliche Haardichte</label>
          <select id="hvde-density" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="thin">D&uuml;nn / Fein</option>
            <option value="medium" selected>Mittel / Normal</option>
            <option value="thick">Dick / Voll</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschtes Volumen</label>
          <select id="hvde-volume" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="subtle">Dezent (nur L&auml;nge)</option>
            <option value="natural" selected>Nat&uuml;rlich (nahtlos)</option>
            <option value="full">Voll (sp&uuml;rbarer Volumen-Boost)</option>
            <option value="dramatic">Dramatisch (maximale F&uuml;lle)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Haarqualit&auml;t</label>
          <select id="hvde-quality" class="hvde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="synthetic">Synthetisch (&euro;)</option>
            <option value="remy" selected>Remy Echthaar (&euro;&euro;)</option>
            <option value="virgin">Virgin Echthaar (&euro;&euro;&euro;)</option>
            <option value="european">Europ&auml;isch / Russisch (&euro;&euro;&euro;&euro;)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Tressen / Pakete ben&ouml;tigt</div>
          <div class="text-5xl font-extrabold font-mono" id="hvde-bundles">0</div>
          <div class="text-sm text-blue-200 mt-1" id="hvde-weight">~0 Gramm gesamt</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Haarkosten</div><div class="text-xl font-bold" id="hvde-cost">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einbaukosten</div><div class="text-xl font-bold" id="hvde-install">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtinvestition</div><div class="text-xl font-bold" id="hvde-total">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Haltbarkeit</div><div class="text-xl font-bold" id="hvde-lifespan">--</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Methoden-Details</h3>
          <div class="text-sm space-y-1" id="hvde-details"></div>
        </div>
      </div>
      <ShareButton calculatorId="hair-extension-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Haarverl&auml;ngerung-Ratgeber</h2>
      <p>Der Bedarf an Haarverl&auml;ngerungen variiert je nach Methode, gew&uuml;nschter L&auml;nge, nat&uuml;rlicher Haardichte und Volumenziel. Clip-Ins ben&ouml;tigen 100&ndash;200 g f&uuml;r einen vollen Kopf. Tape-Ins brauchen typischerweise 40&ndash;80 St&uuml;ck.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Methode ist am schonendsten?</strong> Clip-Ins und Halo-Draht sind am schonendsten, da keine dauerhaften Befestigungen n&ouml;tig sind.</p>
      <p><strong>Wie lange halten Extensions?</strong> Remy-Echthaar h&auml;lt 6&ndash;12 Monate bei guter Pflege.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcHVDE() {
      const method = (document.getElementById('hvde-method') as HTMLSelectElement).value;
      const length = parseInt((document.getElementById('hvde-length') as HTMLSelectElement).value);
      const density = (document.getElementById('hvde-density') as HTMLSelectElement).value;
      const volume = (document.getElementById('hvde-volume') as HTMLSelectElement).value;
      const quality = (document.getElementById('hvde-quality') as HTMLSelectElement).value;

      let baseWeight = 120;
      if (length <= 35) baseWeight = 100;
      else if (length <= 40) baseWeight = 120;
      else if (length <= 45) baseWeight = 140;
      else if (length <= 50) baseWeight = 160;
      else if (length <= 55) baseWeight = 180;
      else if (length <= 60) baseWeight = 200;
      else baseWeight = 220;

      let densityMult = 1.0;
      if (density === 'thin') densityMult = 1.15;
      else if (density === 'thick') densityMult = 0.85;

      let volumeMult = 1.0;
      if (volume === 'subtle') volumeMult = 0.7;
      else if (volume === 'full') volumeMult = 1.3;
      else if (volume === 'dramatic') volumeMult = 1.6;

      const totalWeight = Math.round(baseWeight * densityMult * volumeMult);

      let bundles = 0;
      let installCost = 0;
      let lifespan = '3\u20136 Monate';
      const details: string[] = [];

      if (method === 'clipin') {
        bundles = Math.ceil(totalWeight / 120);
        installCost = 0;
        lifespan = '6\u201312 Monate';
        details.push('Clip-Ins sind tempor\u00E4r und k\u00F6nnen selbst eingesetzt werden.');
        details.push('Jedes Set hat 7\u201310 Tressen f\u00FCr den gesamten Kopf.');
      } else if (method === 'tapein') {
        const pieces = Math.ceil(totalWeight / 2.5);
        bundles = Math.ceil(pieces / 2);
        installCost = 200;
        lifespan = '4\u20138 Wochen (Neueinsetzen)';
        details.push('Tape-In Extensions liegen flach am Kopf an.');
        details.push('Jedes Sandwich verwendet 2 Tape-St\u00FCcke um das Eigenhaar.');
      } else if (method === 'sewin') {
        bundles = Math.ceil(totalWeight / 100);
        installCost = 250;
        lifespan = '6\u20138 Wochen';
        details.push('Das Haar wird in Cornrows geflochten und Tressen werden aufgen\u00E4ht.');
      } else if (method === 'fusion') {
        bundles = Math.ceil(totalWeight / 0.8);
        installCost = 500;
        lifespan = '3\u20136 Monate';
        details.push('Einzelne Keratin-Str\u00E4hnen werden per W\u00E4rme am Eigenhaar befestigt.');
        details.push('Ca. ' + bundles + ' einzelne Bonds ben\u00F6tigt.');
      } else if (method === 'microlink') {
        bundles = Math.ceil(totalWeight / 0.8);
        installCost = 450;
        lifespan = '3\u20134 Monate';
        details.push('Kleine Metallringe klemmen einzelne Str\u00E4hnen ans Eigenhaar.');
        details.push('Kein W\u00E4rme oder Kleber \u2013 schonend f\u00FCrs Eigenhaar.');
      } else {
        bundles = 1;
        installCost = 0;
        lifespan = '6\u201312 Monate';
        details.push('Ein einzelnes Drahtst\u00FCck sitzt auf dem Kopf.');
        details.push('Am einfachsten anzubringen \u2013 keine Clips, kein Kleber.');
      }

      let pricePerGram = 0.5;
      if (quality === 'synthetic') pricePerGram = 0.15;
      else if (quality === 'remy') pricePerGram = 0.8;
      else if (quality === 'virgin') pricePerGram = 1.5;
      else pricePerGram = 3.0;

      const hairCost = Math.round(totalWeight * pricePerGram);
      const totalCost = hairCost + installCost;

      document.getElementById('hvde-bundles')!.textContent = bundles.toString();
      document.getElementById('hvde-weight')!.textContent = '~' + totalWeight + ' Gramm gesamt';
      document.getElementById('hvde-cost')!.textContent = hairCost.toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('hvde-install')!.textContent = installCost > 0 ? installCost.toLocaleString('de-DE') + ' \u20AC' : 'Selbsteinbau';
      document.getElementById('hvde-total')!.textContent = totalCost.toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('hvde-lifespan')!.textContent = lifespan;
      document.getElementById('hvde-details')!.innerHTML = details.map(d => '<p>' + d + '</p>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hvde-in').forEach(el => { el.addEventListener('input', calcHVDE); el.addEventListener('change', calcHVDE); });
      calcHVDE();
    }, 50);
  </script>
</CalculatorLayout>
