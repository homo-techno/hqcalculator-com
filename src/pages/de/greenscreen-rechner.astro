---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Greenscreen-Rechner - Bildschirmgr&ouml;&szlig;e, Beleuchtung & Abstand";
const description = "Berechnen Sie die erforderliche Greenscreen-Gr&ouml;&szlig;e anhand von Motivabstand und Brennweite. Bestimmen Sie Beleuchtungsfl&auml;che und Mindestbildschirmma&szlig;e.";
const relatedCalcs = [
  { name: "Brennweite-Rechner", url: "/de/brennweite-rechner", description: "Bildwinkel und &Auml;quivalente." },
  { name: "Fl&auml;chenrechner", url: "/de/flaechenrechner", description: "Fl&auml;chenberechnung." },
  { name: "Seitenverh&auml;ltnis-Rechner", url: "/de/seitenverhaeltnis-rechner", description: "Bildseitenverh&auml;ltnisse." },
  { name: "Bildschirmgr&ouml;&szlig;e-Rechner", url: "/de/bildschirmgroesse-rechner", description: "Displaygr&ouml;&szlig;en." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Greenscreen-Rechner" lang="de" enSlug="green-screen-calculator" keywords="greenscreen rechner, chroma key gr&ouml;&szlig;e, greenscreen abstand, beleuchtungsfl&auml;che, hintergrund gr&ouml;&szlig;e, videoproduktion" breadcrumbs={[{ name: "Greenscreen-Rechner", url: "/de/greenscreen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Greenscreen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die ideale Greenscreen-Gr&ouml;&szlig;e und Beleuchtungseinrichtung f&uuml;r Ihre Kamera und Ihren Motivabstand.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Brennweite (mm, Kleinbild-&Auml;quivalent)</label>
          <input type="number" id="gsde-focal" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="50" min="8" max="600" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Kamera-zu-Bildschirm-Abstand</label>
          <div class="flex gap-2">
            <input type="number" id="gsde-dist" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="4" min="0.5" step="0.1">
            <select id="gsde-unit" class="gsde-in px-4 py-3 border border-border rounded-xl text-lg">
              <option value="m" selected>Meter</option>
              <option value="ft">Fu&szlig;</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Video-Seitenverh&auml;ltnis</label>
          <select id="gsde-aspect" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="1.778" selected>16:9</option>
            <option value="1.333">4:3</option>
            <option value="2.333">21:9</option>
            <option value="2.39">2,39:1 (Anamorphotisch)</option>
            <option value="1.0">1:1 (Quadrat)</option>
            <option value="0.5625">9:16 (Vertikal)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Sicherheitsrand (%)</label>
          <input type="number" id="gsde-margin" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="20" min="0" max="100" step="5">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Motiv-zu-Bildschirm-Abstand</label>
          <div class="flex gap-2">
            <input type="number" id="gsde-gap" class="gsde-in w-full px-4 py-3 border border-border rounded-xl text-lg" value="1.5" min="0.3" step="0.1">
            <span class="flex items-center text-sm text-text-secondary" id="gsde-gap-unit">m</span>
          </div>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Mindest-Bildschirmgr&ouml;&szlig;e (mit Rand)</div>
          <div class="text-4xl font-extrabold" id="gsde-size"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Bildschirmbreite</div>
            <div class="text-xl font-bold text-text" id="gsde-width"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Bildschirmh&ouml;he</div>
            <div class="text-xl font-bold text-text" id="gsde-height"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Bildschirmfl&auml;che</div>
            <div class="text-xl font-bold text-text" id="gsde-area"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Horizontaler Bildwinkel</div>
            <div class="text-xl font-bold text-text" id="gsde-fov"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Beleuchtungsfl&auml;che</div>
            <div class="text-xl font-bold text-text" id="gsde-light"></div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-secondary uppercase tracking-wide">Motiv-Bildschirm-Abstand</div>
            <div class="text-xl font-bold text-text" id="gsde-subj-dist"></div>
          </div>
        </div>
      </div>
      <ShareButton calculatorId="green-screen-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Greenscreen-Gr&ouml;&szlig;enratgeber</h2>
      <p>Der Greenscreen muss gro&szlig; genug sein, um das Kamerabild mit Spielraum f&uuml;r Motivbewegung auszuf&uuml;llen. Halten Sie Motive mindestens 1,2&ndash;1,8 Meter vom Bildschirm entfernt, um Gr&uuml;n-Spill zu vermeiden.</p>
      <p><strong>Beleuchtungstipp:</strong> Der Greenscreen ben&ouml;tigt eine separate, gleichm&auml;&szlig;ige Beleuchtung mit etwa 40 % der Intensit&auml;t Ihres Hauptlichts auf dem Motiv.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welche Greenscreen-Gr&ouml;&szlig;e brauche ich?</strong> Das h&auml;ngt von Brennweite, Abstand und Seitenverh&auml;ltnis ab. Verwenden Sie diesen Rechner f&uuml;r eine genaue Berechnung.</p>
      <p><strong>Warum ist der Abstand zum Motiv wichtig?</strong> Ein Abstand von mindestens 1,5 m verhindert Gr&uuml;n-Spill und erm&ouml;glicht eine saubere Keying-Qualit&auml;t.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcGSDE() {
      const focal = parseFloat((document.getElementById('gsde-focal') as HTMLInputElement).value) || 50;
      const unit = (document.getElementById('gsde-unit') as HTMLSelectElement).value;
      let dist = parseFloat((document.getElementById('gsde-dist') as HTMLInputElement).value) || 4;
      const aspect = parseFloat((document.getElementById('gsde-aspect') as HTMLSelectElement).value);
      const margin = parseFloat((document.getElementById('gsde-margin') as HTMLInputElement).value) || 20;
      let gap = parseFloat((document.getElementById('gsde-gap') as HTMLInputElement).value) || 1.5;

      const distM = unit === 'ft' ? dist * 0.3048 : dist;
      const gapM = unit === 'ft' ? gap * 0.3048 : gap;
      const unitLabel = unit === 'ft' ? ' ft' : ' m';
      document.getElementById('gsde-gap-unit')!.textContent = unit === 'ft' ? 'ft' : 'm';

      const hFovRad = 2 * Math.atan(36 / (2 * focal));
      const hFovDeg = hFovRad * (180 / Math.PI);

      const screenWidth = 2 * distM * Math.tan(hFovRad / 2);
      const screenHeight = screenWidth / aspect;

      const marginMult = 1 + margin / 100;
      const finalW = screenWidth * marginMult;
      const finalH = screenHeight * marginMult;

      function fmt(m: number): string {
        if (unit === 'ft') return (m / 0.3048).toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' ft';
        return m.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m';
      }

      document.getElementById('gsde-size')!.textContent = fmt(finalW) + ' x ' + fmt(finalH);
      document.getElementById('gsde-width')!.textContent = fmt(finalW);
      document.getElementById('gsde-height')!.textContent = fmt(finalH);

      const areaVal = finalW * finalH;
      document.getElementById('gsde-area')!.textContent = areaVal.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m\u00B2';

      document.getElementById('gsde-fov')!.textContent = hFovDeg.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + '\u00B0';

      const lightArea = finalW * finalH * 1.1;
      document.getElementById('gsde-light')!.textContent = lightArea.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m\u00B2';

      document.getElementById('gsde-subj-dist')!.textContent = fmt(gapM);

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.gsde-in').forEach(el => {
        el.addEventListener('input', calcGSDE);
        el.addEventListener('change', calcGSDE);
      });
      calcGSDE();
    }, 50);
  </script>
</CalculatorLayout>
