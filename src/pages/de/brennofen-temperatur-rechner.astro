---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Brennofen Temperaturrechner – Temperaturen & Kegelwerte Töpferei";
const description = "Konvertieren Sie Brennofentemperaturen und Kegelwerte für die Töpferei.";
const relatedCalcs = [
  { name: "Brennofen Energierechner", url: "/de/brennofen-energie-rechner", description: "Stromkosten Brennofen." },
  { name: "Brennofen Regalrechner", url: "/de/brennofen-regal-rechner", description: "Regalkapazität Brennofen." },
  { name: "Kinetische Energie Rechner", url: "/de/kinetische-energie-rechner", description: "Kinetische Energie (E=½mv²)." },
  { name: "Interpolationsrechner", url: "/de/interpolations-rechner", description: "Lineare Interpolation." },
];
---
<CalculatorLayout lang="de" enSlug="kiln-temperature-calculator" title={title} description={description} calculatorName="Brennofen Temperaturrechner" keywords="Brennofentemperatur, Kegelwerte Töpferei, Celsius Fahrenheit, Orton Kegel, Seger Kegel, Temperatur Töpferei" breadcrumbs={[{ name: "Brennofen Temperaturrechner", url: "/de/brennofen-temperatur-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Brennofen Temperaturrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Konvertieren Sie Celsius zu Fahrenheit, ermitteln Sie Kegelwerte (Orton/Seger) und verstehen Sie Brenntemperaturen in der Töpferei.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Temperatur (°C)</label>
            <input type="number" id="bt-celsius" class="bt-in w-full px-4 py-3 border border-border rounded-xl text-3xl font-bold" value="1200" min="0" max="1400" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Temperatur (°F)</label>
            <input type="number" id="bt-fahrenheit" class="bt-in-f w-full px-4 py-3 border border-border rounded-xl text-3xl font-bold" value="2192" min="32" max="2552" step="18">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Nächster Kegelwert (Orton)</div>
          <div class="text-5xl font-extrabold font-mono" id="bt-cone">—</div>
          <div class="text-sm text-blue-200 mt-1" id="bt-cone-temp">—</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Brennbereich</div><div class="text-xl font-bold" id="bt-range">—</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Keramiktyp</div><div class="text-xl font-bold" id="bt-clay-type">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Kegelwertetabelle (Orton Standard)</h3>
          <div class="text-xs space-y-1" id="bt-table"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="kiln-temperature" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Brenntemperaturen und Kegelwerte</h2>
      <p class="text-text-secondary">In der Töpferei werden Brenntemperaturen oft in Kegelwerten (Kegel/Cone) statt in Grad Celsius angegeben. Das Kegelsystem (entwickelt von Hermann Seger und Edward Orton) beschreibt die Wärmemenge, die auf Keramik einwirkt – abhängig von Temperatur UND Aufheizrate. Ein Orton-Kegel 6 entspricht bei einer Aufheizrate von 150 °C/h ca. 1222 °C.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>°F = °C × 9/5 + 32</p>
        <p>°C = (°F − 32) × 5/9</p>
        <p>Kegelwert: abhängig von Temperatur + Aufheizrate</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist der Unterschied zwischen Orton- und Seger-Kegel?</h4>
          <p class="text-text-secondary mt-1">Orton-Kegel sind der US-amerikanische Standard, Seger-Kegel der europäische. Sie sind ähnlich, aber nicht identisch. Seger-Kegel werden mit SK abgekürzt (z.B. SK 10 ≈ Orton Cone 10). In deutschen Töpfereien sind beide Systeme verbreitet.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Warum sind Kegelwerte wichtiger als Temperaturen allein?</h4>
          <p class="text-text-secondary mt-1">Keramische Reaktionen hängen von der Gesamtenergie ab, die auf den Ton einwirkt – also von Temperatur und Zeit. Eine langsame Aufheizung auf 1200 °C hat denselben Effekt wie eine schnellere auf 1230 °C. Messkegelchen zeigen deshalb die tatsächliche Wärmewirkung unabhängig von der Aufheizrate.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Bei welcher Temperatur brennt Steingut, Steinzeug und Porzellan?</h4>
          <p class="text-text-secondary mt-1">Steingut (Earthenware): 950–1150 °C (Kegel 010–1). Steinzeug (Stoneware): 1200–1300 °C (Kegel 6–10). Porzellan: 1260–1400 °C (Kegel 9–12). Raku: 900–1000 °C, Terrakotta: 900–1100 °C.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was passiert beim Überbranden?</h4>
          <p class="text-text-secondary mt-1">Überbrennen (zu hohe Temperatur oder zu lange Brennzeit) führt zu Verformung, Blasen, überlaufender Glasur und im Extremfall zum Kollaps der Stücke. Typische Zeichen sind stark gelaufene Glasuren, verformte Ränder und Risse durch Schwindungsspannungen.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    const CONES = [
      { cone: '022', celsius: 600, desc: 'Sehr niedrig' },
      { cone: '020', celsius: 635, desc: 'Sehr niedrig' },
      { cone: '018', celsius: 734, desc: 'Sehr niedrig' },
      { cone: '015', celsius: 796, desc: 'Niedrig' },
      { cone: '010', celsius: 905, desc: 'Steingut/Niedrigbrand' },
      { cone: '06', celsius: 999, desc: 'Steingut/Biskuit' },
      { cone: '04', celsius: 1063, desc: 'Steingut' },
      { cone: '02', celsius: 1120, desc: 'Steingut/Mittelbrand' },
      { cone: '1', celsius: 1137, desc: 'Mittelbrand' },
      { cone: '4', celsius: 1186, desc: 'Mittelbrand' },
      { cone: '6', celsius: 1222, desc: 'Mittelbrand/Steinzeug' },
      { cone: '8', celsius: 1263, desc: 'Steinzeug' },
      { cone: '10', celsius: 1305, desc: 'Steinzeug/Hochbrand' },
      { cone: '12', celsius: 1337, desc: 'Hochbrand' },
      { cone: '14', celsius: 1400, desc: 'Hochbrand/Porzellan' },
    ];
    function getClayType(c: number): string {
      if (c < 900) return 'Raku / Keramisch';
      if (c < 1100) return 'Steingut (Earthenware)';
      if (c < 1200) return 'Halbzeug / Mittelbrand';
      if (c < 1310) return 'Steinzeug (Stoneware)';
      return 'Porzellan / Hochbrand';
    }
    function getRange(c: number): string {
      if (c < 900) return 'Sehr Niedrig';
      if (c < 1100) return 'Niedriger Brand';
      if (c < 1200) return 'Mittelbrand';
      if (c < 1310) return 'Hochbrand';
      return 'Sehr hoher Brand';
    }
    let updating = false;
    function calcBT(from: 'c' | 'f') {
      if (updating) return;
      updating = true;
      const cEl = document.getElementById('bt-celsius') as HTMLInputElement;
      const fEl = document.getElementById('bt-fahrenheit') as HTMLInputElement;
      let celsius: number;
      if (from === 'c') {
        celsius = parseFloat(cEl.value) || 0;
        fEl.value = Math.round(celsius * 9 / 5 + 32).toString();
      } else {
        const f = parseFloat(fEl.value) || 32;
        celsius = Math.round((f - 32) * 5 / 9);
        cEl.value = celsius.toString();
      }
      const nearest = CONES.reduce((prev, cur) => Math.abs(cur.celsius - celsius) < Math.abs(prev.celsius - celsius) ? cur : prev);
      document.getElementById('bt-cone')!.textContent = 'Kegel ' + nearest.cone;
      document.getElementById('bt-cone-temp')!.textContent = 'Orton: ca. ' + nearest.celsius + ' °C';
      document.getElementById('bt-range')!.textContent = getRange(celsius);
      document.getElementById('bt-clay-type')!.textContent = getClayType(celsius);
      const visible = CONES.filter(c => Math.abs(c.celsius - celsius) <= 200);
      document.getElementById('bt-table')!.innerHTML = CONES.map(c => {
        const isNearest = c.cone === nearest.cone;
        return '<div class="flex justify-between' + (isNearest ? ' text-blue-700 font-bold' : '') + '"><span>Kegel ' + c.cone + '</span><span>' + c.celsius + ' °C / ' + Math.round(c.celsius * 9/5 + 32) + ' °F</span><span>' + c.desc + (isNearest ? ' ←' : '') + '</span></div>';
      }).join('');
      updating = false;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('bt-celsius')!.addEventListener('input', () => calcBT('c'));
      document.getElementById('bt-fahrenheit')!.addEventListener('input', () => calcBT('f'));
      calcBT('c');
    }, 50);
  </script>
</CalculatorLayout>
