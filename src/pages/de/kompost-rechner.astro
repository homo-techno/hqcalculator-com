---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kompostrechner - C:N-Verh\u00e4ltnis & Volumensch\u00e4tzung";
const description = "Berechnen Sie das Kohlenstoff-Stickstoff-Verh\u00e4ltnis Ihres Komposts, erhalten Sie Empfehlungen f\u00fcr die Balance und sch\u00e4tzen Sie das fertige Kompostvolumen.";
const relatedCalcs = [
  { name: "Kompostierungsrate", url: "/de/kompostierungsrate-rechner", description: "Zersetzungszeit." },
  { name: "CO2-Fu\u00dfabdruck", url: "/de/co2-fussabdruck-rechner", description: "CO2-Emissionen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Fl\u00e4chenrechner", url: "/de/flaechenrechner", description: "Fl\u00e4chen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Kompostrechner" lang="de" enSlug="compost-calculator" keywords="kompostrechner, kohlenstoff stickstoff verh\u00e4ltnis, C:N verh\u00e4ltnis, kompostierung, gr\u00fcn braun verh\u00e4ltnis, kompostvolumen" breadcrumbs={[{ name: "Kompost", url: "/de/kompost-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kompostrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ihr Kompost-C:N-Verh&auml;ltnis und erhalten Sie Empfehlungen f&uuml;r die perfekte Mischung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gr&uuml;nmaterial (kg)</label>
            <input type="number" id="ko-green" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="0" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Braunmaterial (kg)</label>
            <input type="number" id="ko-brown" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Gr&uuml;nmaterial C:N-Verh&auml;ltnis</label>
            <select id="ko-greentype" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="15">Rasenschnitt (~15:1)</option>
              <option value="20">Obst-/Gem&uuml;sereste (~20:1)</option>
              <option value="12">Kaffeesatz (~12:1)</option>
              <option value="25" selected>Gemischtes Gr&uuml;n (~25:1)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Braunmaterial C:N-Verh&auml;ltnis</label>
            <select id="ko-browntype" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="60" selected>Trockenes Laub (~60:1)</option>
              <option value="80">Stroh (~80:1)</option>
              <option value="400">Karton (~400:1)</option>
              <option value="500">S&auml;gesp&auml;ne (~500:1)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ihr C:N-Verh&auml;ltnis</div>
          <div class="text-5xl font-extrabold font-mono" id="ko-result">0:1</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Zielverh&auml;ltnis</div><div class="text-xl font-bold font-mono">30:1</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Status</div><div class="text-xl font-bold font-mono" id="ko-status">-</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfehlung</div><div class="text-xl font-bold font-mono" id="ko-rec">-</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Kompostvolumen</div><div class="text-xl font-bold font-mono" id="ko-vol">0 L</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht</div><div class="text-xl font-bold font-mono" id="ko-total">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gr&uuml;n:Braun-Verh&auml;ltnis</div><div class="text-xl font-bold font-mono" id="ko-ratio">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="compost" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Kompostierung richtig gemacht</h2>
      <p>Das ideale C:N-Verh&auml;ltnis f&uuml;r Kompost liegt bei 25-30:1. Gr&uuml;nmaterialien (Stickstoffreich) wie K&uuml;chenabf&auml;lle und Rasenschnitt sollten mit Braunmaterialien (Kohlenstoffreich) wie Laub und Stroh kombiniert werden. Ein gutes Verh&auml;ltnis beschleunigt die Zersetzung und verhindert Geruchsbildung.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcKO() {
      const greenKg = parseFloat((document.getElementById('ko-green') as HTMLInputElement).value) || 0;
      const brownKg = parseFloat((document.getElementById('ko-brown') as HTMLInputElement).value) || 0;
      const greenCN = parseFloat((document.getElementById('ko-greentype') as HTMLSelectElement).value) || 25;
      const brownCN = parseFloat((document.getElementById('ko-browntype') as HTMLSelectElement).value) || 60;
      const totalWeight = greenKg + brownKg;
      let cnRatio = 0;
      if (totalWeight > 0) {
        cnRatio = (greenKg * greenCN + brownKg * brownCN) / totalWeight;
      }
      let status = '';
      let rec = '';
      if (cnRatio < 20) { status = 'Zu niedrig'; rec = 'Braun hinzuf\u00fcgen'; }
      else if (cnRatio < 25) { status = 'Niedrig'; rec = 'Braun hinzuf\u00fcgen'; }
      else if (cnRatio <= 35) { status = 'Ideal!'; rec = 'Gute Balance'; }
      else if (cnRatio <= 50) { status = 'Hoch'; rec = 'Gr\u00fcn hinzuf\u00fcgen'; }
      else { status = 'Zu hoch'; rec = 'Gr\u00fcn hinzuf\u00fcgen'; }
      // 1 kg ~ 2 Liter Rohmaterial, schrumpft auf 40%
      const rawVolume = totalWeight * 2;
      const finishedVol = rawVolume * 0.4;
      const gbRatio = brownKg > 0 ? (greenKg / brownKg).toFixed(2).replace('.', ',') : '0';
      document.getElementById('ko-result')!.textContent = cnRatio.toFixed(0) + ':1';
      document.getElementById('ko-status')!.textContent = status;
      document.getElementById('ko-rec')!.textContent = rec;
      document.getElementById('ko-vol')!.textContent = finishedVol.toFixed(0) + ' L';
      document.getElementById('ko-total')!.textContent = totalWeight + ' kg';
      document.getElementById('ko-ratio')!.textContent = gbRatio + ':1';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ko-in').forEach(el => { el.addEventListener('input', calcKO); el.addEventListener('change', calcKO); });
      calcKO();
    }, 50);
  </script>
</CalculatorLayout>
