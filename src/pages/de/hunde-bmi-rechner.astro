---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hunde-BMI-Rechner - Koerperkondition & Idealgewicht 2026";
const description = "Berechne den Body Condition Score deines Hundes, den idealen Gewichtsbereich nach Rassengroesse und den Uebergewichts-Prozentsatz. Erhalte Gewichtsmanagement-Empfehlungen.";

const relatedCalcs = [
  { name: "Hundefutter-Rechner", url: "/de/hundefutter-rechner", description: "Taegliche Futterportionen." },
  { name: "Hundealter-Rechner", url: "/de/hundealter-rechner", description: "Hundejahre umrechnen." },
  { name: "Hunde-Bewegung-Rechner", url: "/de/hunde-bewegung-rechner", description: "Taeglicher Bewegungsbedarf." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Menschlichen BMI berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Hunde-BMI-Rechner" keywords="Hunde BMI, Body Condition Score Hund, Idealgewicht Hund, uebergewichtiger Hund, Gewichtsmanagement Hund" breadcrumbs={[{ name: "Hunde-BMI", url: "/de/hunde-bmi-rechner" }]} lang="de" enSlug="dog-bmi-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hunde-BMI-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bewerte die Koerperkondition deines Hundes, den idealen Gewichtsbereich und erhalte Gewichtsmanagement-Tipps.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Aktuelles Gewicht (kg)</label><input type="number" id="hbde-weight" class="hbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="22" min="1" max="150" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Rassengroesse</label>
            <select id="hbde-size" class="hbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="toy">Mini (unter 5 kg)</option>
              <option value="small">Klein (5-12 kg)</option>
              <option value="medium" selected>Mittel (12-25 kg)</option>
              <option value="large">Gross (25-45 kg)</option>
              <option value="giant">Riesig (45+ kg)</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Body Condition Score (1-9)</label><input type="number" id="hbde-bcs" class="hbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="9" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Alter</label>
            <select id="hbde-age" class="hbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="puppy">Welpe (&lt;1 J.)</option>
              <option value="adult" selected>Erwachsen (1-7 J.)</option>
              <option value="senior">Senior (7+ J.)</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Koerperkondition</div>
          <div class="text-5xl font-extrabold font-mono" id="hbde-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Idealgewicht</div><div class="text-xl font-bold font-mono" id="hbde-ideal">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewichtsdiff.</div><div class="text-xl font-bold font-mono" id="hbde-diff">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ueber/Unter %</div><div class="text-xl font-bold font-mono" id="hbde-pct">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Idealbereich</div><div class="text-xl font-bold font-mono" id="hbde-range">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Koerperfett gesch.</div><div class="text-xl font-bold font-mono" id="hbde-fat">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Empfehlung</div><div class="text-xl font-bold font-mono" id="hbde-rec">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dog-bmi" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Body Condition Score beim Hund</h2>
      <p>Der BCS reicht von 1 (abgemagert) bis 9 (stark uebergewichtig). Ein BCS von 4-5 ist ideal. Bei einem idealen BCS sind die Rippen leicht fuehlbar, die Taille ist von oben sichtbar und der Bauch ist von der Seite eingezogen.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <p><strong>Wie bestimme ich den BCS meines Hundes?</strong> Taste die Rippen ab: Leicht fuehlbar = ideal (5). Kaum fuehlbar unter Fettschicht = uebergewichtig (7+). Stark sichtbar = untergewichtig (3-).</p>
      <p><strong>Was tun bei Uebergewicht?</strong> Reduziere die Futtermenge um 10-20 %, erhoehe die Bewegung schrittweise und waege deinen Hund regelmaessig.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcHBDE() {
      const weight = parseFloat((document.getElementById('hbde-weight') as HTMLInputElement).value) || 0;
      const size = (document.getElementById('hbde-size') as HTMLSelectElement).value;
      const bcs = parseInt((document.getElementById('hbde-bcs') as HTMLInputElement).value) || 5;

      const idealRanges: Record<string, [number, number]> = {
        toy: [2, 5], small: [5, 12], medium: [12, 25], large: [25, 45], giant: [45, 90]
      };
      const range = idealRanges[size] || [12, 25];
      const idealWeight = weight / (1 + (bcs - 5) * 0.10);
      const diff = weight - idealWeight;
      const pctOver = ((diff / idealWeight) * 100);
      const bodyFat = 20 + (bcs - 5) * 5;

      const bcsLabels: Record<number, string> = {
        1: 'Abgemagert', 2: 'Sehr duenn', 3: 'Untergewichtig',
        4: 'Leicht unter', 5: 'Ideal', 6: 'Leicht ueber',
        7: 'Uebergewichtig', 8: 'Adipoes', 9: 'Stark adipoes'
      };

      let rec = 'Halten';
      if (bcs < 4) rec = 'Zunehmen';
      else if (bcs === 4) rec = 'Leicht zunehmen';
      else if (bcs === 5) rec = 'Halten';
      else if (bcs === 6) rec = 'Leicht abnehmen';
      else rec = 'Abnehmen';

      document.getElementById('hbde-result')!.textContent = bcsLabels[bcs] || 'Ideal';
      document.getElementById('hbde-ideal')!.textContent = Math.round(idealWeight) + ' kg';
      document.getElementById('hbde-diff')!.textContent = (diff >= 0 ? '+' : '') + diff.toFixed(1).replace('.', ',') + ' kg';
      document.getElementById('hbde-pct')!.textContent = (pctOver >= 0 ? '+' : '') + pctOver.toFixed(1).replace('.', ',') + '%';
      document.getElementById('hbde-range')!.textContent = range[0] + '-' + range[1] + ' kg';
      document.getElementById('hbde-fat')!.textContent = Math.max(5, Math.min(50, bodyFat)) + '%';
      document.getElementById('hbde-rec')!.textContent = rec;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.hbde-in').forEach(el => { el.addEventListener('input', calcHBDE); el.addEventListener('change', calcHBDE); });
      calcHBDE();
    }, 50);
  </script>
</CalculatorLayout>
