---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Matrix Rechner - Addition, Multiplikation, Determinante, Inverse";
const description = "Führen Sie Matrixoperationen durch: Addition, Multiplikation, Determinante und Inverse. Online Matrix Rechner für 2×2 und 3×3 Matrizen mit Schritt-für-Schritt-Lösung.";
const relatedCalcs = [
  { name: "Markov-Ketten Rechner", url: "/de/markov-kette-rechner", description: "Markov-Ketten berechnen." },
  { name: "Mittelwert Rechner", url: "/de/mittelwert-rechner", description: "Statistische Kennzahlen." },
  { name: "Standardabweichung Rechner", url: "/de/standardabweichung-rechner", description: "Standardabweichung." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="matrix-calculator" calculatorName="Matrix Rechner" keywords="Matrix Rechner, Matrixmultiplikation, Determinante berechnen, Inverse Matrix, Matrixaddition online" breadcrumbs={[{ name: "Matrix Rechner", url: "/de/matrix-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Matrix Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Matrixoperationen für 2×2 und 3×3 Matrizen: Determinante, Inverse, Addition und Multiplikation.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Matrixgröße</label>
            <select id="mx-size" class="mx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="2" selected>2 × 2</option>
              <option value="3">3 × 3</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Operation</label>
            <select id="mx-op" class="mx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="det" selected>Determinante</option>
              <option value="inv">Inverse</option>
              <option value="trans">Transponierte</option>
              <option value="add">A + B</option>
              <option value="mul">A × B</option>
            </select>
          </div>
        </div>
        <div>
          <p class="text-xs font-medium text-text mb-2">Matrix A</p>
          <div id="mx-A2" class="grid grid-cols-2 gap-2">
            <input type="number" id="mx-a11" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="3">
            <input type="number" id="mx-a12" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="1">
            <input type="number" id="mx-a21" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="2">
            <input type="number" id="mx-a22" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="4">
          </div>
          <div id="mx-A3" class="grid grid-cols-3 gap-2 hidden">
            <input type="number" id="mx-a11b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="1">
            <input type="number" id="mx-a12b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="2">
            <input type="number" id="mx-a13b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0">
            <input type="number" id="mx-a21b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="3">
            <input type="number" id="mx-a22b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="4">
            <input type="number" id="mx-a23b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="1">
            <input type="number" id="mx-a31b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="1">
            <input type="number" id="mx-a32b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0">
            <input type="number" id="mx-a33b" class="mx-in px-2 py-2 border border-border rounded-lg text-sm font-bold text-center" value="2">
          </div>
        </div>
        <div id="mx-B-section" class="hidden">
          <p class="text-xs font-medium text-text mb-2">Matrix B</p>
          <div id="mx-B2" class="grid grid-cols-2 gap-2">
            <input type="number" id="mx-b11" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="1">
            <input type="number" id="mx-b12" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0">
            <input type="number" id="mx-b21" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="0">
            <input type="number" id="mx-b22" class="mx-in px-3 py-2 border border-border rounded-lg text-sm font-bold text-center" value="1">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-2">Ergebnis</div>
          <div id="mx-result" class="font-mono text-xl font-extrabold whitespace-pre-wrap">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <div class="text-xs text-text-muted uppercase mb-1">Erklärung</div>
          <div id="mx-explain" class="text-sm text-text">--</div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="matrix" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Matrixrechnung – Grundlagen</h2>
      <p>Matrizen sind rechteckige Zahlenschemata, die in der linearen Algebra, Physik, Informatik und Wirtschaftswissenschaften eingesetzt werden. Die Determinante einer 2×2-Matrix A = [[a,b],[c,d]] berechnet sich als det(A) = ad − bc. Die Inverse existiert nur, wenn die Determinante ungleich null ist. Matrizenmultiplikation ist nicht kommutativ: A×B ≠ B×A im Allgemeinen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wann hat eine Matrix keine Inverse?</strong> Wenn die Determinante null ist, ist die Matrix singulär und hat keine Inverse. Dies bedeutet, dass das zugehörige Gleichungssystem keine eindeutige Lösung hat.</p>
      <p><strong>Was ist eine transponierte Matrix?</strong> Bei der Transponierten werden Zeilen und Spalten vertauscht. Aus einer m×n Matrix wird eine n×m Matrix.</p>
      <p><strong>Wofür braucht man Matrizenmultiplikation?</strong> Matrizenmultiplikation wird u. a. für lineare Transformationen, Grafikberechnungen, neuronale Netze und Lösung linearer Gleichungssysteme verwendet.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function det2(m: number[][]): number { return m[0][0]*m[1][1] - m[0][1]*m[1][0]; }
    function det3(m: number[][]): number {
      return m[0][0]*(m[1][1]*m[2][2]-m[1][2]*m[2][1]) - m[0][1]*(m[1][0]*m[2][2]-m[1][2]*m[2][0]) + m[0][2]*(m[1][0]*m[2][1]-m[1][1]*m[2][0]);
    }
    function inv2(m: number[][]): number[][] | null {
      const d = det2(m); if (Math.abs(d) < 1e-12) return null;
      return [[m[1][1]/d, -m[0][1]/d], [-m[1][0]/d, m[0][0]/d]];
    }
    function inv3(m: number[][]): number[][] | null {
      const d = det3(m); if (Math.abs(d) < 1e-12) return null;
      const r = [[0,0,0],[0,0,0],[0,0,0]] as number[][];
      r[0][0]=(m[1][1]*m[2][2]-m[1][2]*m[2][1])/d; r[0][1]=-(m[0][1]*m[2][2]-m[0][2]*m[2][1])/d; r[0][2]=(m[0][1]*m[1][2]-m[0][2]*m[1][1])/d;
      r[1][0]=-(m[1][0]*m[2][2]-m[1][2]*m[2][0])/d; r[1][1]=(m[0][0]*m[2][2]-m[0][2]*m[2][0])/d; r[1][2]=-(m[0][0]*m[1][2]-m[0][2]*m[1][0])/d;
      r[2][0]=(m[1][0]*m[2][1]-m[1][1]*m[2][0])/d; r[2][1]=-(m[0][0]*m[2][1]-m[0][1]*m[2][0])/d; r[2][2]=(m[0][0]*m[1][1]-m[0][1]*m[1][0])/d;
      return r;
    }
    function mulMat(A: number[][], B: number[][]): number[][] {
      const n = A.length;
      const C: number[][] = Array.from({length:n},()=>Array(n).fill(0));
      for(let i=0;i<n;i++) for(let j=0;j<n;j++) for(let k=0;k<n;k++) C[i][j]+=A[i][k]*B[k][j];
      return C;
    }
    function addMat(A: number[][], B: number[][]): number[][] {
      return A.map((row,i)=>row.map((v,j)=>v+B[i][j]));
    }
    function fmtNum(v: number): string { return parseFloat(v.toFixed(4)).toString().replace('.',','); }
    function matStr(m: number[][]): string { return m.map(r=>'[ '+r.map(fmtNum).join('  ')+'  ]').join('\n'); }
    function calcMX() {
      const size = parseInt((document.getElementById('mx-size') as HTMLSelectElement).value) || 2;
      const op = (document.getElementById('mx-op') as HTMLSelectElement).value;
      document.getElementById('mx-A2')!.classList.toggle('hidden', size !== 2);
      document.getElementById('mx-A3')!.classList.toggle('hidden', size !== 3);
      document.getElementById('mx-B2')!.classList.toggle('hidden', size !== 2);
      const needsB = op === 'add' || op === 'mul';
      document.getElementById('mx-B-section')!.classList.toggle('hidden', !needsB);
      const g = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0;
      let A: number[][], B: number[][] = [[1,0],[0,1]];
      if (size === 2) {
        A = [[g('mx-a11'),g('mx-a12')],[g('mx-a21'),g('mx-a22')]];
        B = [[g('mx-b11'),g('mx-b12')],[g('mx-b21'),g('mx-b22')]];
      } else {
        A = [[g('mx-a11b'),g('mx-a12b'),g('mx-a13b')],[g('mx-a21b'),g('mx-a22b'),g('mx-a23b')],[g('mx-a31b'),g('mx-a32b'),g('mx-a33b')]];
      }
      let resultStr = '--', explainStr = '--';
      if (op === 'det') {
        const d = size === 2 ? det2(A) : det3(A);
        resultStr = 'det(A) = ' + fmtNum(d);
        explainStr = size === 2 ? 'det(A) = a₁₁×a₂₂ − a₁₂×a₂₁ = ' + fmtNum(A[0][0]) + ' × ' + fmtNum(A[1][1]) + ' − ' + fmtNum(A[0][1]) + ' × ' + fmtNum(A[1][0]) + ' = ' + fmtNum(d) : 'Entwicklung nach der ersten Zeile.';
      } else if (op === 'inv') {
        const inv = size === 2 ? inv2(A) : inv3(A);
        resultStr = inv ? 'A⁻¹ =\n' + matStr(inv) : 'Keine Inverse (det = 0)';
        explainStr = inv ? 'Die Inverse existiert, da det ≠ 0.' : 'Die Matrix ist singulär.';
      } else if (op === 'trans') {
        const T = A[0].map((_, j) => A.map(row => row[j]));
        resultStr = 'Aᵀ =\n' + matStr(T);
        explainStr = 'Zeilen und Spalten werden vertauscht.';
      } else if (op === 'add') {
        resultStr = 'A + B =\n' + matStr(addMat(A, B));
        explainStr = 'Elementweise Addition der Matrizen.';
      } else if (op === 'mul') {
        resultStr = 'A × B =\n' + matStr(mulMat(A, B));
        explainStr = 'Zeile-mal-Spalte Multiplikation.';
      }
      document.getElementById('mx-result')!.textContent = resultStr;
      document.getElementById('mx-explain')!.textContent = explainStr;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.mx-in').forEach(el => { el.addEventListener('input', calcMX); el.addEventListener('change', calcMX); });
      calcMX();
    }, 50);
  </script>
</CalculatorLayout>
