---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Dermal-Filler-Rechner - Volumen (mL) nach Behandlungsbereich";
const description = "Berechnen Sie das gesch\u00e4tzte Filler-Volumen in mL f\u00fcr jeden Behandlungsbereich inkl. Lippen, Wangen, Kiefer und Augenringe mit Kostensch\u00e4tzung.";

const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentberechnungen." },
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budgetplanung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Dermal-Filler-Rechner" lang="de" enSlug="dermal-filler-calculator" keywords="dermal filler, lippenfiller, wangenfiller, kieferfiller, hyalurons\u00e4ure, filler volumen, filler kosten" breadcrumbs={[{ name: "Dermal-Filler-Rechner", url: "/de/dermal-filler-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dermal-Filler-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Filler-Volumen und Kosten nach Behandlungsbereich und gew&uuml;nschtem Ergebnis.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Kosten pro Spritze (&euro;) - 1 mL</label>
          <input type="number" id="dfr-cost" class="dfr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="400" min="100" max="1500" step="25">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gew&uuml;nschtes Ergebnis</label>
          <select id="dfr-result" class="dfr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.7">Dezent / Konservativ</option>
            <option value="1.0" selected>Moderat / Nat&uuml;rlich</option>
            <option value="1.3">Verst&auml;rkt / Sichtbar</option>
            <option value="1.6">Dramatisch / Maximum</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Altersgruppe</label>
          <select id="dfr-age" class="dfr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="0.8">Unter 30</option>
            <option value="1.0" selected>30-45</option>
            <option value="1.2">46-60</option>
            <option value="1.4">&Uuml;ber 60</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-2">Behandlungsbereiche w&auml;hlen</label>
          <div class="space-y-2">
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-lips" class="dfr-in" checked><span class="text-sm">Lippen (0,5-2 mL)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-cheeks" class="dfr-in" checked><span class="text-sm">Wangen (1-4 mL pro Seite)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-nasolabial" class="dfr-in"><span class="text-sm">Nasolabialfalten (0,5-2 mL pro Seite)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-marionette" class="dfr-in"><span class="text-sm">Marionettenfalten (0,5-1,5 mL pro Seite)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-jawline" class="dfr-in"><span class="text-sm">Kieferlinie (1-3 mL pro Seite)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-chin" class="dfr-in"><span class="text-sm">Kinn (1-3 mL)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-undereye" class="dfr-in"><span class="text-sm">Augenringe / Tr&auml;nenrinne (0,5-1 mL pro Seite)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-temples" class="dfr-in"><span class="text-sm">Schl&auml;fen (1-2 mL pro Seite)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-nose" class="dfr-in"><span class="text-sm">Nasenkorrektur ohne OP (0,5-1,5 mL)</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="dfr-hands" class="dfr-in"><span class="text-sm">H&auml;nde (1-2 mL pro Hand)</span></label>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtes Filler-Volumen</div>
          <div class="text-5xl font-extrabold font-mono" id="dfr-volume">0 mL</div>
          <div class="text-sm text-blue-200 mt-1" id="dfr-syringes">0 Spritzen</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch&auml;tzte Kosten</div><div class="text-xl font-bold" id="dfr-total">0 &euro;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bereiche behandelt</div><div class="text-xl font-bold" id="dfr-areas">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Haltbarkeit ca.</div><div class="text-xl font-bold" id="dfr-duration">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">J&auml;hrliche Pflege</div><div class="text-xl font-bold" id="dfr-annual">0 &euro;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Volumen-Aufschl&uuml;sselung</h3>
          <div class="text-sm space-y-1" id="dfr-breakdown"></div>
        </div>
      </div>
      <ShareButton calculatorId="dermal-filler-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dermal Filler Ratgeber</h2>
      <p>Dermal Filler (typischerweise auf Hyalurons&auml;ure-Basis) stellen Volumen wieder her, gl&auml;tten Falten und verbessern Gesichtskonturen. Die Ergebnisse halten 6-18 Monate je nach Filler-Typ und Behandlungsbereich. In Deutschland liegen die Kosten bei ca. 300-700 &euro; pro Spritze (1 mL).</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie lange h&auml;lt der Filler?</strong> Lippenaugmentationen halten ca. 9 Monate, Wangenfillings bis zu 15 Monate. Schl&auml;fenfiller k&ouml;nnen bis zu 18 Monate halten.</p>
      <p><strong>Ist die Behandlung schmerzhaft?</strong> Die meisten Filler enthalten Lidocain. Zus&auml;tzlich wird oft eine Bet&auml;ubungscreme aufgetragen. Die Behandlung ist gut vertr&auml;glich.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const dfrFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcDFR() {
      const costPerSyringe = parseFloat((document.getElementById('dfr-cost') as HTMLInputElement).value) || 400;
      const resultMult = parseFloat((document.getElementById('dfr-result') as HTMLSelectElement).value);
      const ageMult = parseFloat((document.getElementById('dfr-age') as HTMLSelectElement).value);

      const areas: {id:string, name:string, baseML:number, duration:number}[] = [
        {id:'dfr-lips', name:'Lippen', baseML:1.0, duration:9},
        {id:'dfr-cheeks', name:'Wangen (beidseitig)', baseML:3.0, duration:15},
        {id:'dfr-nasolabial', name:'Nasolabialfalten (beidseitig)', baseML:2.0, duration:12},
        {id:'dfr-marionette', name:'Marionettenfalten (beidseitig)', baseML:1.5, duration:12},
        {id:'dfr-jawline', name:'Kieferlinie (beidseitig)', baseML:4.0, duration:15},
        {id:'dfr-chin', name:'Kinn', baseML:2.0, duration:15},
        {id:'dfr-undereye', name:'Augenringe (beidseitig)', baseML:1.0, duration:12},
        {id:'dfr-temples', name:'Schl\u00e4fen (beidseitig)', baseML:2.5, duration:18},
        {id:'dfr-nose', name:'Nasenkorrektur ohne OP', baseML:1.0, duration:12},
        {id:'dfr-hands', name:'H\u00e4nde (beidseitig)', baseML:3.0, duration:9},
      ];

      let totalML = 0;
      let areaCount = 0;
      let avgDuration = 0;
      const breakdown: string[] = [];

      areas.forEach(a => {
        if ((document.getElementById(a.id) as HTMLInputElement).checked) {
          const ml = Math.round(a.baseML * resultMult * ageMult * 10) / 10;
          totalML += ml;
          areaCount++;
          avgDuration += a.duration;
          breakdown.push('<div class="flex justify-between"><span>' + a.name + '</span><span class="font-bold">' + ml.toFixed(1).replace('.', ',') + ' mL (' + dfrFmt(Math.round(ml * costPerSyringe)) + ')</span></div>');
        }
      });

      if (areaCount > 0) avgDuration = Math.round(avgDuration / areaCount);

      const syringes = Math.ceil(totalML);
      const totalCost = syringes * costPerSyringe;
      const annualMaint = Math.round(totalCost * (12 / (avgDuration || 12)));

      document.getElementById('dfr-volume')!.textContent = totalML.toFixed(1).replace('.', ',') + ' mL';
      document.getElementById('dfr-syringes')!.textContent = syringes + ' Spritze' + (syringes !== 1 ? 'n' : '');
      document.getElementById('dfr-total')!.textContent = dfrFmt(totalCost);
      document.getElementById('dfr-areas')!.textContent = areaCount.toString();
      document.getElementById('dfr-duration')!.textContent = areaCount > 0 ? avgDuration + ' Monate' : '--';
      document.getElementById('dfr-annual')!.textContent = dfrFmt(annualMaint);
      document.getElementById('dfr-breakdown')!.innerHTML = breakdown.length > 0 ? breakdown.join('') : '<p class="text-text-muted">Behandlungsbereiche oben ausw\u00e4hlen.</p>';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dfr-in').forEach(el => { el.addEventListener('input', calcDFR); el.addEventListener('change', calcDFR); });
      calcDFR();
    }, 50);
  </script>
</CalculatorLayout>
