---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Dezibel-Rechner - Schallpegel & Leistung";
const description = "Berechnen Sie Dezibel-Pegel, Leistungsverhaeltnisse und kombinieren Sie mehrere Schallquellen.";

const relatedCalcs = [
  { name: "Frequenzrechner", url: "/de/frequenz-rechner", description: "Frequenz." },
  { name: "Logarithmus-Rechner", url: "/de/logarithmus-rechner", description: "Logarithmus." },
  { name: "Prozentrechner", url: "/de/prozent-rechner", description: "Prozent." },
  { name: "Wissenschaftl. Notation", url: "/de/wissenschaftliche-notation-rechner", description: "Notation." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="decibel-calculator" calculatorName="Dezibel-Rechner" keywords="dezibel rechner, dB rechner, schallpegel, leistungsverhaeltnis, laermaddition, SPL" breadcrumbs={[{ name: "Dezibel-Rechner", url: "/de/dezibel-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Dezibel-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie dB-Pegel, Leistungsverh&auml;ltnisse und kombinieren Sie Schallquellen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2 mb-2">
          <button class="dbde-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="convert">Umrechnen</button>
          <button class="dbde-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="add">Quellen addieren</button>
        </div>
        <div id="dbde-convert-panel">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-xs font-medium text-text mb-1">Leistungsverh&auml;ltnis</label><input type="number" id="dbde-ratio" class="dbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="100" min="0" step="1"></div>
            <div><label class="block text-xs font-medium text-text mb-1">dB-Wert</label><input type="number" id="dbde-val" class="dbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" step="0.1"></div>
          </div>
          <p class="text-xs text-text-muted mt-1">Ein Feld bearbeiten, um das andere zu berechnen</p>
        </div>
        <div id="dbde-add-panel" class="hidden">
          <label class="block text-xs font-medium text-text mb-1">Schallpegel (dB, kommagetrennt)</label>
          <input type="text" id="dbde-sources" class="dbde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70, 75, 80" placeholder="70, 75, 80">
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="dbde-label">Ergebnis</div>
          <div class="text-5xl font-extrabold font-mono" id="dbde-result">20 dB</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="dbde-extra"></div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Typische dB-Pegel</h3>
          <div class="text-xs space-y-1">
            <div>0 dB: H&ouml;rschwelle</div>
            <div>30 dB: Fl&uuml;stern</div>
            <div>60 dB: Normales Gespr&auml;ch</div>
            <div>85 dB: Starker Verkehr (Geh&ouml;rsch&auml;den m&ouml;glich)</div>
            <div>100 dB: Motorrad</div>
            <div>120 dB: Rockkonzert / Schmerzschwelle</div>
            <div>140 dB: D&uuml;sentriebwerk auf 30 m</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="decibel" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Dezibel-Skala erkl&auml;rt</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>dB</strong> = 10 &times; log10(Leistungsverh&auml;ltnis)</p>
        <p><strong>dB (Spannung)</strong> = 20 &times; log10(Spannungsverh&auml;ltnis)</p>
      </div>
      <p>Die Dezibel-Skala ist logarithmisch. Eine Verdopplung der Leistung entspricht etwa +3 dB. Eine Verzehnfachung = +10 dB. Der Mensch empfindet +10 dB als doppelt so laut.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Ab wann wird L&auml;rm gef&auml;hrlich?</strong> Ab 85 dB bei l&auml;ngerer Einwirkung. Am Arbeitsplatz in Deutschland gelten strenge Grenzwerte (LarmVibrationsArbSchV).</p>
      <p><strong>Wie addiert man dB-Werte?</strong> Man kann dB-Werte nicht einfach addieren. Zwei identische Quellen ergeben zusammen +3 dB, nicht das Doppelte.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let dbdeMode = 'convert';
    let dbdeLastEdited = 'ratio';
    function setDbdeMode(m: string) {
      dbdeMode = m;
      document.getElementById('dbde-convert-panel')!.classList.toggle('hidden', m !== 'convert');
      document.getElementById('dbde-add-panel')!.classList.toggle('hidden', m !== 'add');
      document.querySelectorAll('.dbde-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'dbde-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcDBDE();
    }
    function calcDBDE() {
      const extra = document.getElementById('dbde-extra')!;
      if (dbdeMode === 'convert') {
        let ratio: number, db: number;
        if (dbdeLastEdited === 'ratio') {
          ratio = parseFloat((document.getElementById('dbde-ratio') as HTMLInputElement).value) || 1;
          db = 10 * Math.log10(ratio);
          (document.getElementById('dbde-val') as HTMLInputElement).value = db.toFixed(2);
        } else {
          db = parseFloat((document.getElementById('dbde-val') as HTMLInputElement).value) || 0;
          ratio = Math.pow(10, db / 10);
          (document.getElementById('dbde-ratio') as HTMLInputElement).value = ratio < 100 ? ratio.toFixed(4) : ratio.toFixed(0);
        }
        const voltRatio = Math.pow(10, db / 20);
        document.getElementById('dbde-label')!.textContent = 'Leistungsverh\u00e4ltnis \u2194 dB';
        document.getElementById('dbde-result')!.textContent = db.toFixed(2) + ' dB';
        extra.innerHTML = '<div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leistungsverh\u00e4ltnis</div><div class="text-xl font-bold">' + (ratio < 1000 ? ratio.toFixed(4) : ratio.toExponential(3)) + '\u00d7</div></div><div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spannungsverh\u00e4ltnis</div><div class="text-xl font-bold">' + voltRatio.toFixed(4) + '\u00d7</div></div>';
      } else {
        const vals = (document.getElementById('dbde-sources') as HTMLInputElement).value.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n));
        if (vals.length === 0) { document.getElementById('dbde-result')!.textContent = '0 dB'; return; }
        const sumIntensity = vals.reduce((sum, db) => sum + Math.pow(10, db / 10), 0);
        const combined = 10 * Math.log10(sumIntensity);
        const highest = Math.max(...vals);
        document.getElementById('dbde-label')!.textContent = 'Kombiniert (' + vals.length + ' Quellen)';
        document.getElementById('dbde-result')!.textContent = combined.toFixed(1) + ' dB';
        extra.innerHTML = '<div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lauteste Quelle</div><div class="text-xl font-bold">' + highest.toFixed(1) + ' dB</div></div><div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Erh\u00f6hung</div><div class="text-xl font-bold">+' + (combined - highest).toFixed(1) + ' dB</div></div>';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.dbde-mode').forEach(b => b.addEventListener('click', () => setDbdeMode((b as HTMLButtonElement).dataset.mode!)));
      document.getElementById('dbde-ratio')!.addEventListener('input', () => { dbdeLastEdited = 'ratio'; calcDBDE(); });
      document.getElementById('dbde-val')!.addEventListener('input', () => { dbdeLastEdited = 'db'; calcDBDE(); });
      document.getElementById('dbde-sources')!.addEventListener('input', calcDBDE);
      calcDBDE();
    }, 50);
  </script>
</CalculatorLayout>
