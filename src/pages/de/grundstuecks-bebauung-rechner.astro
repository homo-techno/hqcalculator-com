---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Grundstücks-Bebauungsrechner – GRZ berechnen";
const description = "Berechnen Sie die Bebauungsdichte (GRZ) Ihres Grundstücks nach BauNVO und prüfen Sie die zulässige Grundfläche.";

const relatedCalcs = [
  { name: "Flächenrechner", url: "/de/flaechenrechner", description: "Flächen berechnen." },
  { name: "Holzrechner", url: "/de/holz-rechner", description: "Holzmengen berechnen." },
  { name: "Maßstabsrechner", url: "/de/massstab-rechner", description: "Kartenmaßstäbe." },
  { name: "Instandhaltungsrücklage", url: "/de/instandhaltungsruecklage-rechner", description: "Rücklage berechnen." },
];
---
<CalculatorLayout lang="de" enSlug="lot-coverage-calculator" title={title} description={description} calculatorName="Grundstücks-Bebauungsrechner" keywords="GRZ Rechner, Grundflächenzahl, Bebauungsdichte, BauNVO, Grundstück bebauen" breadcrumbs={[{ name: "Bebauungsrechner", url: "/de/grundstuecks-bebauung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Grundstücks-Bebauungsrechner (GRZ)</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Grundflächenzahl (GRZ) und prüfen Sie, ob Ihre Bebauung dem Bebauungsplan entspricht.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Grundstücksfläche (m²)</label>
          <input type="number" id="grz-flaeche" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="600" step="1" min="1">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Überbaute Grundfläche (m²)</label>
          <input type="number" id="grz-bebaut" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="150" step="1" min="0">
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Zulässige GRZ laut Bebauungsplan</label>
          <select id="grz-zul" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="0.2">0,2 – Kleinsiedlungsgebiet (WS)</option>
            <option value="0.3">0,3 – Reines Wohngebiet (WR)</option>
            <option value="0.4" selected>0,4 – Allgemeines Wohngebiet (WA)</option>
            <option value="0.5">0,5 – Besonderes Wohngebiet (WB)</option>
            <option value="0.6">0,6 – Mischgebiet (MI)</option>
            <option value="0.8">0,8 – Gewerbegebiet (GE)</option>
            <option value="1.0">1,0 – Kerngebiet (MK)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Ihre GRZ</div>
          <div class="text-5xl font-extrabold font-mono" id="grz-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="grz-status"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Max. Grundfläche</div>
            <div class="text-xl font-bold font-mono" id="grz-max">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Noch bebaubar</div>
            <div class="text-xl font-bold font-mono" id="grz-noch">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">GRZ Überschreitung</div>
            <div class="text-xl font-bold font-mono" id="grz-ueber">–</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Freifläche</div>
            <div class="text-xl font-bold font-mono" id="grz-frei">–</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="lot-coverage" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist die Grundflächenzahl (GRZ)?</h2>
      <p>Die Grundflächenzahl (GRZ) ist eine Kennziffer im deutschen Baurecht, die angibt, welcher Anteil eines Grundstücks bebaut werden darf. Eine GRZ von 0,4 bedeutet, dass maximal 40 % der Grundstücksfläche überbaut werden darf. Sie ist im Bebauungsplan festgelegt und basiert auf der Baunutzungsverordnung (BauNVO).</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Was zählt zur überbauten Grundfläche?</h3>
      <p>Zur überbauten Grundfläche zählen alle baulichen Anlagen auf dem Grundstück, die das Erdreich berühren: Wohngebäude, Garagen, Carports, Terrassen, Außentreppen und Nebenanlagen. Bäume und Rasen zählen nicht dazu.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Darf die GRZ überschritten werden?</h3>
      <p>Ja, bis zu einem bestimmten Maß. Nach § 19 BauNVO darf die GRZ durch Garagen, Stellplätze und Nebenanlagen um bis zu 50 % überschritten werden, maximal jedoch bis zu einer GRZ von 0,8.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Wo finde ich die zulässige GRZ für mein Grundstück?</h3>
      <p>Die zulässige GRZ ist im Bebauungsplan Ihrer Gemeinde festgelegt. Sie können diesen beim Baurechtsamt oder online im Geoportal Ihrer Stadt einsehen.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen GRZ und GFZ?</h3>
      <p>Die GRZ (Grundflächenzahl) gibt die überbaubare Grundstücksfläche an, die GFZ (Geschossflächenzahl) dagegen das Verhältnis aller Geschossflächen zur Grundstücksfläche.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGRZ() {
      const flaeche = parseFloat((document.getElementById('grz-flaeche') as HTMLInputElement).value) || 0;
      const bebaut = parseFloat((document.getElementById('grz-bebaut') as HTMLInputElement).value) || 0;
      const zul = parseFloat((document.getElementById('grz-zul') as HTMLSelectElement).value) || 0.4;
      const grz = flaeche > 0 ? bebaut / flaeche : 0;
      const maxFlaeche = flaeche * zul;
      const noch = Math.max(0, maxFlaeche - bebaut);
      const ueber = Math.max(0, bebaut - maxFlaeche);
      const frei = flaeche - bebaut;
      const ok = grz <= zul;
      document.getElementById('grz-result')!.textContent = grz.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('grz-status')!.textContent = ok ? 'Bebauung zulässig' : 'GRZ überschritten!';
      document.getElementById('grz-max')!.textContent = maxFlaeche.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m²';
      document.getElementById('grz-noch')!.textContent = noch.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m²';
      document.getElementById('grz-ueber')!.textContent = ueber > 0 ? ueber.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m²' : '–';
      document.getElementById('grz-frei')!.textContent = frei.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' m²';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('grz-flaeche')!.addEventListener('input', calcGRZ);
      document.getElementById('grz-bebaut')!.addEventListener('input', calcGRZ);
      document.getElementById('grz-zul')!.addEventListener('change', calcGRZ);
      calcGRZ();
    }, 50);
  </script>
</CalculatorLayout>
