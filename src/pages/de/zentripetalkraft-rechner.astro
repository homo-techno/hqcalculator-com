---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zentripetalkraft-Rechner - Kreisbewegung berechnen";
const description = "Berechnen Sie Zentripetalkraft, Beschleunigung und Geschwindigkeit fuer Kreisbewegungen mit F = mv²/r.";
const relatedCalcs = [
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Beschleunigungsrechner", url: "/de/beschleunigungsrechner", description: "Beschleunigung berechnen." },
  { name: "Geschwindigkeitsrechner", url: "/de/geschwindigkeitsrechner", description: "Geschwindigkeit." },
  { name: "Pendelrechner", url: "/de/pendelrechner", description: "Pendelbewegung." },
  { name: "Kinetische Energie", url: "/de/kinetische-energie-rechner", description: "Kinetische Energie." },
  { name: "Impulsrechner", url: "/de/impulsrechner", description: "Impuls berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Zentripetalkraft-Rechner" enSlug="centripetal-force-calculator" keywords="Zentripetalkraft, Kreisbewegung, Zentripetalbeschleunigung, Winkelgeschwindigkeit, F=mv²/r" breadcrumbs={[{ name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zentripetalkraft-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Zentripetalkraft und Beschleunigung fuer Kreisbewegungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Masse (kg)</label><input type="number" id="zk-m" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1000" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Geschwindigkeit (m/s)</label><input type="number" id="zk-v" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Radius (m)</label><input type="number" id="zk-r" class="zk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Zentripetalkraft</div>
          <div class="text-5xl font-extrabold font-mono" id="zk-result">0 N</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Beschleunigung</div><div class="text-xl font-bold font-mono" id="zk-acc">0 m/s²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">G-Kraft</div><div class="text-xl font-bold font-mono" id="zk-g">0 g</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Winkelgeschw.</div><div class="text-xl font-bold font-mono" id="zk-omega">0 rad/s</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umlaufzeit</div><div class="text-xl font-bold font-mono" id="zk-period">0 s</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Drehzahl</div><div class="text-xl font-bold font-mono" id="zk-rpm">0 U/min</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="zentripetalkraft" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zentripetalkraft verstehen</h2>
      <p>Die Zentripetalkraft ist die Kraft, die einen Koerper auf einer Kreisbahn haelt. Sie wirkt stets zum Mittelpunkt der Kreisbahn und wird mit der Formel F = mv²/r berechnet, wobei m die Masse, v die Geschwindigkeit und r der Radius ist.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Was ist der Unterschied zwischen Zentripetal- und Zentrifugalkraft?</strong> Die Zentripetalkraft zieht zum Mittelpunkt, die Zentrifugalkraft ist eine Scheinkraft im rotierenden Bezugssystem.</li>
        <li><strong>Wo tritt Zentripetalkraft auf?</strong> Bei jeder Kreisbewegung, z.B. in Kurvenfahrten, Karussells oder Planetenbahnen.</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcZK() {
      const m = parseFloat((document.getElementById('zk-m') as HTMLInputElement).value) || 0;
      const v = parseFloat((document.getElementById('zk-v') as HTMLInputElement).value) || 0;
      const r = parseFloat((document.getElementById('zk-r') as HTMLInputElement).value) || 1;
      const acc = r > 0 ? v * v / r : 0;
      const force = m * acc;
      const gForce = acc / 9.81;
      const omega = r > 0 ? v / r : 0;
      const period = omega > 0 ? (2 * Math.PI) / omega : 0;
      const rpm = period > 0 ? 60 / period : 0;
      let display: string;
      if (force >= 1e6) display = (force/1e6).toFixed(2) + ' MN';
      else if (force >= 1e3) display = (force/1e3).toFixed(2) + ' kN';
      else display = force.toFixed(2) + ' N';
      document.getElementById('zk-result')!.textContent = display;
      document.getElementById('zk-acc')!.textContent = acc.toFixed(2) + ' m/s\u00B2';
      document.getElementById('zk-g')!.textContent = gForce.toFixed(2) + ' g';
      document.getElementById('zk-omega')!.textContent = omega.toFixed(4) + ' rad/s';
      document.getElementById('zk-period')!.textContent = period.toFixed(3) + ' s';
      document.getElementById('zk-rpm')!.textContent = rpm.toFixed(1) + ' U/min';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zk-in').forEach(el => { el.addEventListener('input', calcZK); el.addEventListener('change', calcZK); });
      calcZK();
    }, 50);
  </script>
</CalculatorLayout>
