---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Lagerumschlag Rechner – Lagerumschlaghäufigkeit berechnen";
const description = "Berechnen Sie die Lagerumschlaghäufigkeit und Lagerdauer Ihres Unternehmens.";
const relatedCalcs = [
  { name: "Rechnungsrechner", url: "/de/rechnungs-rechner", description: "Rechnungen mit MwSt. berechnen." },
  { name: "Einladungsrechner", url: "/de/einladungs-rechner", description: "Druckkosten für Einladungen." },
  { name: "Kelly-Kriterium Rechner", url: "/de/kelly-kriterium-rechner", description: "Optimale Einsatzgröße." },
  { name: "Zinssatz Rechner", url: "/de/zinssatz-rechner", description: "Zinssätze berechnen." },
];
---
<CalculatorLayout lang="de" enSlug="inventory-turnover-calculator" title={title} description={description} calculatorName="Lagerumschlag Rechner" keywords="Lagerumschlag, Lagerumschlaghäufigkeit, Lagerdauer, Inventory Turnover, Warenumschlag" breadcrumbs={[{ name: "Lagerumschlag Rechner", url: "/de/lagerumschlag-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Lagerumschlag Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Lagerumschlaghäufigkeit (Inventory Turnover) und durchschnittliche Lagerdauer für Ihr Unternehmen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Umsatzkosten / Wareneinsatz (€/Jahr)</label><input type="number" id="lu-cogs" class="lu-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="500000" min="0" step="10000"></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anfangslagerbestand (€)</label><input type="number" id="lu-begin" class="lu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="80000" min="0" step="1000"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Endlagerbestand (€)</label><input type="number" id="lu-end" class="lu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120000" min="0" step="1000"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Berechnungsbasis</label>
          <select id="lu-basis" class="lu-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="365" selected>Kalenderjahr (365 Tage)</option>
            <option value="360">Kaufmännisches Jahr (360 Tage)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Lagerumschlaghäufigkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="lu-result">—</div>
          <div class="text-sm text-blue-200 mt-1">mal pro Jahr</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Lagerdauer</div><div class="text-xl font-bold" id="lu-days">— Tage</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Durchschn. Bestand</div><div class="text-xl font-bold" id="lu-avg">— €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Bewertung</div><div class="text-xl font-bold" id="lu-rating">—</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Branchenvergleich (Richtwerte)</h3>
          <div class="text-xs space-y-1" id="lu-bench"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="inventory-turnover" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text mb-4">Lagerumschlaghäufigkeit – Grundlagen</h2>
      <p class="text-text-secondary">Die Lagerumschlaghäufigkeit gibt an, wie oft der durchschnittliche Lagerbestand innerhalb eines Jahres komplett verkauft und erneuert wurde. Ein hoher Wert signalisiert effizienten Lagereinsatz und geringe Kapitalbindung. Die Kennzahl ist ein wichtiger Indikator für Liquidität und Betriebseffizienz.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>Ø Lagerbestand = (Anfang + Ende) / 2</p>
        <p>Umschlaghäufigkeit = Wareneinsatz / Ø Lagerbestand</p>
        <p>Lagerdauer (Tage) = Basis / Umschlaghäufigkeit</p>
      </div>
      <h3 class="text-xl font-bold text-text mb-3">Häufig gestellte Fragen</h3>
      <div class="space-y-4">
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was ist ein guter Lagerumschlag?</h4>
          <p class="text-text-secondary mt-1">Der optimale Wert variiert stark nach Branche. Im Lebensmittelhandel sind 15–30 Umschläge pro Jahr üblich, im Maschinenbau 3–6. Generell gilt: Je höher, desto besser – solange Lieferengpässe vermieden werden.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Wie kann ich den Lagerumschlag verbessern?</h4>
          <p class="text-text-secondary mt-1">Möglichkeiten zur Verbesserung: Just-in-Time-Lieferung einführen, langsam drehende Artikel identifizieren und reduzieren, Nachfrageprognosen verbessern, Lieferzeiten verkürzen und überflüssige Sicherheitsbestände abbauen.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Was bedeutet eine niedrige Lagerumschlaghäufigkeit?</h4>
          <p class="text-text-secondary mt-1">Ein niedriger Wert deutet auf gebundenes Kapital, mögliche Überbestände, veraltete Ware oder schwache Nachfrage hin. Dies erhöht Lagerkosten und Abschreibungsrisiken und kann die Liquidität des Unternehmens belasten.</p>
        </div>
        <div class="border border-border rounded-xl p-4">
          <h4 class="font-semibold text-text">Welchen Unterschied macht die Berechnungsbasis (360 vs. 365 Tage)?</h4>
          <p class="text-text-secondary mt-1">Das kaufmännische Jahr mit 360 Tagen (12 × 30 Tage) vereinfacht die Berechnung und ist in der deutschen Handelspraxis verbreitet. Das Kalenderjahr mit 365 Tagen ist präziser. Die Wahl der Basis sollte innerhalb eines Unternehmens konsistent bleiben.</p>
        </div>
      </div>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcLU() {
      const cogs = parseFloat((document.getElementById('lu-cogs') as HTMLInputElement).value) || 0;
      const begin = parseFloat((document.getElementById('lu-begin') as HTMLInputElement).value) || 0;
      const end = parseFloat((document.getElementById('lu-end') as HTMLInputElement).value) || 0;
      const basis = parseInt((document.getElementById('lu-basis') as HTMLSelectElement).value) || 365;
      const avg = (begin + end) / 2;
      const turnover = avg > 0 ? cogs / avg : 0;
      const days = turnover > 0 ? basis / turnover : 0;
      const fmtEur = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
      let rating = '—';
      if (turnover > 0) {
        if (turnover >= 12) rating = 'Sehr gut';
        else if (turnover >= 6) rating = 'Gut';
        else if (turnover >= 3) rating = 'Durchschnittlich';
        else rating = 'Verbesserungsbedarf';
      }
      document.getElementById('lu-result')!.textContent = turnover.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('lu-days')!.textContent = days > 0 ? Math.round(days).toLocaleString('de-DE') + ' Tage' : '— Tage';
      document.getElementById('lu-avg')!.textContent = avg > 0 ? fmtEur(avg) : '— €';
      document.getElementById('lu-rating')!.textContent = rating;
      const benches = [
        { branch: 'Lebensmittelhandel', min: 15, max: 30 },
        { branch: 'Elektronikindustrie', min: 6, max: 12 },
        { branch: 'Maschinenbau', min: 3, max: 6 },
        { branch: 'Bekleidungshandel', min: 4, max: 8 },
        { branch: 'Automobilindustrie', min: 8, max: 15 },
      ];
      document.getElementById('lu-bench')!.innerHTML = benches.map(b => {
        const inRange = turnover >= b.min && turnover <= b.max;
        return '<div class="flex justify-between' + (inRange ? ' text-green-700 font-bold' : '') + '"><span>' + b.branch + '</span><span>' + b.min + '–' + b.max + 'x/Jahr' + (inRange ? ' ✓' : '') + '</span></div>';
      }).join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.lu-in').forEach(el => { el.addEventListener('input', calcLU); el.addEventListener('change', calcLU); });
      calcLU();
    }, 50);
  </script>
</CalculatorLayout>
