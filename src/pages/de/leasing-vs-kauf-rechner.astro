---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Leasing vs. Kauf Rechner";
const description = "Vergleichen Sie Leasing und Kauf für gewerbliche Investitionen.";

const relatedCalcs = [
  { name: "Leasingrechner", url: "/de/leasing-rechner", description: "Leasingraten berechnen." },
  { name: "Abschreibungsrechner", url: "/de/abschreibungsrechner", description: "AfA berechnen." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite berechnen." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Anlagewachstum berechnen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Leasing vs. Kauf Rechner" lang="de" enSlug="lease-vs-buy-commercial-calculator" keywords="leasing vs kauf rechner, leasing oder kaufen, gewerbe leasing vergleich, investition leasing kauf" breadcrumbs={[{ name: "Leasing vs. Kauf Rechner", url: "/de/leasing-vs-kauf-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Leasing vs. Kauf Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Vergleichen Sie die Gesamtkosten von Leasing und Kauf für gewerbliche Investitionen und ermitteln Sie die wirtschaftlichere Option.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Gemeinsame Parameter</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Kaufpreis (netto, €)</label><input type="number" id="lvk-price" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50000" min="1000" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Nutzungsdauer (Jahre)</label><input type="number" id="lvk-years" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="20" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Restwert am Ende (€)</label><input type="number" id="lvk-resid" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10000" min="0" step="500"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Steuersatz (%)</label><input type="number" id="lvk-tax" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" max="50" step="1"></div>
        </div>
        <h3 class="font-semibold text-text pt-2">Leasing</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Monatliche Leasingrate (netto, €)</label><input type="number" id="lvk-lease" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="850" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Leasingsonderzahlung (€)</label><input type="number" id="lvk-leasedown" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5000" min="0" step="500"></div>
        </div>
        <h3 class="font-semibold text-text pt-2">Kauf</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Eigenkapital-Anteil (%)</label><input type="number" id="lvk-equity" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="0" max="100" step="5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Kreditzinssatz (% p.a.)</label><input type="number" id="lvk-rate" class="lvk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5.5" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-5 bg-primary rounded-2xl text-white text-center">
            <div class="text-xs text-blue-200 uppercase mb-1">Gesamtkosten Leasing (netto)</div>
            <div class="text-3xl font-extrabold font-mono" id="lvk-lease-total">0 €</div>
          </div>
          <div class="p-5 bg-green-600 rounded-2xl text-white text-center">
            <div class="text-xs text-green-200 uppercase mb-1">Gesamtkosten Kauf (netto)</div>
            <div class="text-3xl font-extrabold font-mono" id="lvk-buy-total">0 €</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase mb-1">Empfehlung</div>
          <div class="text-lg font-bold" id="lvk-rec">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Steuerersparnis Leasing</div><div class="text-xl font-bold" id="lvk-lease-tax">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Steuerersparnis Kauf (AfA)</div><div class="text-xl font-bold" id="lvk-buy-tax">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="lease-vs-buy-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Leasing oder Kauf – was ist günstiger?</h2>
      <p>Für Gewerbetreibende ist die Entscheidung zwischen Leasing und Kauf eine strategische Finanzierungsfrage. Leasing schont die Liquidität, da keine hohe Anzahlung erforderlich ist, und die Raten sind vollständig als Betriebsausgaben absetzbar. Beim Kauf profitiert man von der Abschreibung (AfA) und hat am Ende Eigentum an der Anlage. Welche Option günstiger ist, hängt von Steuersatz, Finanzierungskosten und dem Restwert ab.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was sind die steuerlichen Vorteile von Leasing?</strong> Leasingraten können Gewerbetreibende vollständig als Betriebsausgaben absetzen. Bei Kauf auf Kredit ist nur der Zinsanteil abzugsfähig; das Wirtschaftsgut wird über die Nutzungsdauer abgeschrieben.</p>
      <p><strong>Wann ist Leasing besser als Kauf?</strong> Leasing eignet sich besonders bei schnell veraltenden Gütern (IT, Fahrzeuge), wenn Liquiditätsschonung wichtig ist oder der Steuervorteil die höheren Zinskosten überwiegt.</p>
      <p><strong>Was ist Operating vs. Finance Leasing?</strong> Operating Leasing ist ein reines Mietverhältnis (keine Bilanzierungspflicht), Finance Leasing ähnelt wirtschaftlich einem Kauf und muss aktiviert werden (nach IFRS 16).</p>
      <p><strong>Kann ich vorzeitig aus dem Leasingvertrag aussteigen?</strong> Vorzeitige Kündigung ist meist teuer. Die verbleibenden Raten müssen oft als Ablösesumme geleistet werden. Prüfen Sie die Vertragsbedingungen sorgfältig.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const lvkFmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
    function calcLVK() {
      const price = parseFloat((document.getElementById('lvk-price') as HTMLInputElement).value) || 0;
      const years = parseFloat((document.getElementById('lvk-years') as HTMLInputElement).value) || 5;
      const resid = parseFloat((document.getElementById('lvk-resid') as HTMLInputElement).value) || 0;
      const taxRate = parseFloat((document.getElementById('lvk-tax') as HTMLInputElement).value) / 100 || 0;
      const leaseMonthly = parseFloat((document.getElementById('lvk-lease') as HTMLInputElement).value) || 0;
      const leaseDown = parseFloat((document.getElementById('lvk-leasedown') as HTMLInputElement).value) || 0;
      const equityPct = parseFloat((document.getElementById('lvk-equity') as HTMLInputElement).value) / 100 || 0;
      const creditRate = parseFloat((document.getElementById('lvk-rate') as HTMLInputElement).value) / 100 || 0;
      const leaseTotalGross = leaseMonthly * years * 12 + leaseDown;
      const leaseTaxSave = leaseTotalGross * taxRate;
      const leaseTotalNet = leaseTotalGross - leaseTaxSave;
      const equity = price * equityPct;
      const loan = price - equity;
      const monthRate = creditRate / 12;
      const months = years * 12;
      const monthlyPayment = monthRate > 0 ? loan * monthRate * Math.pow(1 + monthRate, months) / (Math.pow(1 + monthRate, months) - 1) : loan / months;
      const totalPaid = monthlyPayment * months + equity;
      const totalInterest = totalPaid - loan - equity;
      const netCost = totalPaid - resid;
      const afaSave = (price - resid) * taxRate;
      const interestSave = totalInterest * taxRate;
      const buyTaxSave = afaSave + interestSave;
      const buyNet = netCost - buyTaxSave;
      document.getElementById('lvk-lease-total')!.textContent = lvkFmt(leaseTotalNet);
      document.getElementById('lvk-buy-total')!.textContent = lvkFmt(buyNet);
      document.getElementById('lvk-lease-tax')!.textContent = lvkFmt(leaseTaxSave);
      document.getElementById('lvk-buy-tax')!.textContent = lvkFmt(buyTaxSave);
      const diff = buyNet - leaseTotalNet;
      document.getElementById('lvk-rec')!.textContent = diff > 0
        ? 'Leasing ist um ' + lvkFmt(Math.abs(diff)) + ' günstiger'
        : diff < 0
        ? 'Kauf ist um ' + lvkFmt(Math.abs(diff)) + ' günstiger'
        : 'Beide Optionen sind gleichwertig';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.lvk-in').forEach(el => { el.addEventListener('input', calcLVK); el.addEventListener('change', calcLVK); }); calcLVK(); }, 50);
  </script>
</CalculatorLayout>
