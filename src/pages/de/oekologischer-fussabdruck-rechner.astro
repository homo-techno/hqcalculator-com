---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Ökologischer Fußabdruck-Rechner - CO₂, Wasser & Fläche";
const description = "Berechnen Sie Ihren ökologischen Fußabdruck basierend auf Energieverbrauch, Mobilität, Ernährung und Konsum. Ergebnis in globalen Hektar und Erden.";

const relatedCalcs = [
  { name: "CO2-Rechner", url: "/de/co2-rechner", description: "CO2-Ausstoß berechnen." },
  { name: "Stromkosten-Rechner", url: "/de/stromkosten-rechner", description: "Stromkosten berechnen." },
  { name: "Wasserverbrauch-Rechner", url: "/de/wasserverbrauch-rechner", description: "Wasserverbrauch." },
  { name: "Dürre-Index-Rechner", url: "/de/duerre-index-rechner", description: "Trockenheitsindex." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Ökologischer Fußabdruck-Rechner" lang="de" enSlug="ecological-footprint-calculator" keywords="ökologischer fußabdruck, co2 fußabdruck, umweltrechner, globale hektar, nachhaltigkeit rechner" breadcrumbs={[{ name: "Ökologischer Fußabdruck-Rechner", url: "/de/oekologischer-fussabdruck-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">&Ouml;kologischer Fu&szlig;abdruck-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Sch&auml;tzen Sie Ihren &ouml;kologischen Fu&szlig;abdruck anhand Ihres Energieverbrauchs, Ihrer Mobilit&auml;t und Ern&auml;hrungsgewohnheiten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Stromverbrauch (kWh/Jahr)</label><input type="number" id="eco-elec" class="eco-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gasverbrauch (kWh/Jahr)</label><input type="number" id="eco-gas" class="eco-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="100" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Auto-km pro Jahr</label><input type="number" id="eco-car" class="eco-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="500" min="0"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fl&uuml;ge (Stunden/Jahr)</label><input type="number" id="eco-fly" class="eco-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="0"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Ern&auml;hrung</label><select id="eco-diet" class="eco-in w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="meat">Fleischreich</option><option value="average">Durchschnitt</option><option value="veg">Vegetarisch</option><option value="vegan">Vegan</option></select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Haushaltsgr&ouml;&szlig;e</label><input type="number" id="eco-people" class="eco-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" step="1" min="1" max="10"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">&Ouml;kologischer Fu&szlig;abdruck</div>
          <div class="text-5xl font-extrabold font-mono" id="eco-result">0 gha</div>
          <div class="text-sm text-blue-200 mt-1" id="eco-earths"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CO&sub2; (t/Jahr)</div><div class="text-xl font-bold" id="eco-co2">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Energie-Anteil</div><div class="text-xl font-bold" id="eco-energy">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Mobilit&auml;t-Anteil</div><div class="text-xl font-bold" id="eco-mobility">&mdash;</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Ern&auml;hrung-Anteil</div><div class="text-xl font-bold" id="eco-food">&mdash;</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Berechnungsschritte</h3>
          <div class="font-mono text-sm space-y-1" id="eco-steps"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="ecological-footprint-de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">&Ouml;kologischer Fu&szlig;abdruck erkl&auml;rt</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p>CO&sub2; = Strom &times; 0,4 + Gas &times; 0,2 + Auto &times; 0,15 + Flug &times; 250</p>
        <p>gha = CO&sub2; (t) / 3,6 (vereinfachter Umrechnungsfaktor)</p>
        <p>Erden = gha / 1,6 (verf&uuml;gbare Biokapazit&auml;t pro Person)</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was sind globale Hektar (gha)?</strong> Globale Hektar messen die biologisch produktive Fl&auml;che, die ben&ouml;tigt wird, um den Ressourcenverbrauch zu decken.</p>
      <p><strong>Wie gro&szlig; ist der Durchschnitt in Deutschland?</strong> Der durchschnittliche Deutsche verbraucht etwa 4,7 gha, w&auml;hrend nur 1,6 gha pro Person verf&uuml;gbar sind.</p>
      <p><strong>Wie kann ich meinen Fu&szlig;abdruck reduzieren?</strong> Die gr&ouml;&szlig;ten Hebel sind weniger Fliegen, &ouml;ffentliche Verkehrsmittel nutzen und pflanzlichere Ern&auml;hrung.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcEco() {
      const elec = parseFloat((document.getElementById('eco-elec') as HTMLInputElement).value) || 0;
      const gas = parseFloat((document.getElementById('eco-gas') as HTMLInputElement).value) || 0;
      const car = parseFloat((document.getElementById('eco-car') as HTMLInputElement).value) || 0;
      const fly = parseFloat((document.getElementById('eco-fly') as HTMLInputElement).value) || 0;
      const diet = (document.getElementById('eco-diet') as HTMLSelectElement).value;
      const people = parseFloat((document.getElementById('eco-people') as HTMLInputElement).value) || 1;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const steps: string[] = [];
      const co2Elec = (elec * 0.4) / 1000 / people;
      steps.push('CO2 Strom = ' + elec + ' kWh x 0,4 kg/kWh / ' + people + ' = ' + fmt(co2Elec) + ' t');
      const co2Gas = (gas * 0.2) / 1000 / people;
      steps.push('CO2 Gas = ' + gas + ' kWh x 0,2 kg/kWh / ' + people + ' = ' + fmt(co2Gas) + ' t');
      const co2Car = (car * 0.15) / 1000;
      steps.push('CO2 Auto = ' + car + ' km x 0,15 kg/km = ' + fmt(co2Car) + ' t');
      const co2Fly = (fly * 250) / 1000;
      steps.push('CO2 Fluege = ' + fly + ' h x 250 kg/h = ' + fmt(co2Fly) + ' t');
      const dietCo2: Record<string, number> = { meat: 2.5, average: 1.7, veg: 1.1, vegan: 0.7 };
      const co2Food = dietCo2[diet] || 1.7;
      steps.push('CO2 Ernaehrung = ' + fmt(co2Food) + ' t (Typ: ' + diet + ')');
      const totalCo2 = co2Elec + co2Gas + co2Car + co2Fly + co2Food;
      steps.push('Gesamt CO2 = ' + fmt(totalCo2) + ' t/Jahr');
      const gha = totalCo2 / 3.6 + 0.5;
      steps.push('Fussabdruck = ' + fmt(totalCo2) + ' / 3,6 + 0,5 (Basisverbrauch) = ' + fmt(gha) + ' gha');
      const earths = gha / 1.6;
      steps.push('Erden = ' + fmt(gha) + ' / 1,6 = ' + fmt(earths));
      const energyShare = (co2Elec + co2Gas) / totalCo2 * 100;
      const mobilityShare = (co2Car + co2Fly) / totalCo2 * 100;
      const foodShare = co2Food / totalCo2 * 100;
      document.getElementById('eco-result')!.textContent = fmt(gha) + ' gha';
      document.getElementById('eco-earths')!.textContent = fmt(earths) + ' Erden benoetigt';
      document.getElementById('eco-co2')!.textContent = fmt(totalCo2) + ' t';
      document.getElementById('eco-energy')!.textContent = fmt(energyShare) + '%';
      document.getElementById('eco-mobility')!.textContent = fmt(mobilityShare) + '%';
      document.getElementById('eco-food')!.textContent = fmt(foodShare) + '%';
      document.getElementById('eco-steps')!.innerHTML = steps.map(s => '<div>' + s + '</div>').join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('eco-elec') as HTMLInputElement).value = '3000';
      (document.getElementById('eco-gas') as HTMLInputElement).value = '12000';
      (document.getElementById('eco-car') as HTMLInputElement).value = '10000';
      (document.getElementById('eco-fly') as HTMLInputElement).value = '4';
      (document.getElementById('eco-people') as HTMLInputElement).value = '2';
      document.querySelectorAll('.eco-in').forEach(el => { el.addEventListener('input', calcEco); el.addEventListener('change', calcEco); });
      calcEco();
    }, 50);
  </script>
</CalculatorLayout>
