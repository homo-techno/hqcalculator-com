---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Konferenz-Rechner - Breakout-Räume, Technik & Materialplanung";
const description = "Planen Sie Ihre Konferenz mit Breakout-Räumen, AV-Technik, Namensschildern, Druckmaterialien und Verbrauchsmaterial pro Teilnehmer.";
const relatedCalcs = [
  { name: "Veranstaltungsbudget-Rechner", url: "/de/veranstaltungsbudget-rechner", description: "Event-Kosten." },
  { name: "Bankettsaal-Rechner", url: "/de/bankettsaal-rechner", description: "Raumgröße." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Konferenz-Rechner" enSlug="conference-calculator" keywords="Konferenz Rechner, Konferenzplanung, Breakout-Räume, AV-Technik, Namensschilder, Veranstaltung" breadcrumbs={[{ name: "Konferenz-Rechner", url: "/de/konferenz-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Konferenz-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Breakout-Räume, AV-Bedarf, Namensschilder und Materialien für Ihre Konferenz.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Anzahl der Teilnehmer</label>
          <input type="number" id="con-attendees" class="con-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="250" min="10" step="10">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Konferenzdauer (Tage)</label>
          <input type="number" id="con-days" class="con-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="1" max="7" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Breakout-Session-Tracks (parallel)</label>
          <input type="number" id="con-tracks" class="con-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="10" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Sessions pro Track pro Tag</label>
          <input type="number" id="con-sessions" class="con-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="1" max="10" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Keynote-Redner</label>
          <input type="number" id="con-keynotes" class="con-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2" min="0" max="10" step="1">
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Materialpaket pro Teilnehmer</label>
          <select id="con-materials" class="con-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="full">Vollpaket (Namensschild, Programm, Mappe, Notizblock, Stift)</option>
            <option value="basic">Basispaket (Namensschild, Programm, Stift)</option>
            <option value="digital">Nur digital (Namensschild + App)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Verpflegung</label>
          <select id="con-meals" class="con-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="all" selected>Alle Mahlzeiten (Frühstück, Mittag, Pausen)</option>
            <option value="lunch">Nur Mittag + Pausen</option>
            <option value="breaks">Nur Kaffeepausen</option>
            <option value="none">Keine Verpflegung</option>
          </select>
        </div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Räume gesamt</div>
        <div class="text-5xl font-extrabold" id="con-rooms">--</div>
        <div class="text-sm mt-1" id="con-plus">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Gesamte Sessions</div>
          <div class="text-xl font-bold" id="con-totalsess">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Namensschilder</div>
          <div class="text-xl font-bold" id="con-badges">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Mikrofone</div>
          <div class="text-xl font-bold" id="con-mics">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Projektoren / Leinwände</div>
          <div class="text-xl font-bold" id="con-projectors">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="con-details"></div>

      <ShareButton lang="de" calculatorId="conference" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Leitfaden zur Konferenzplanung</h2>
      <p>Breakout-Räume sollten jeweils 30-50% der Teilnehmer fassen. Planen Sie immer einen Hauptsaal plus Breakout-Räume ein. Jeder Raum benötigt eine eigene AV-Ausstattung (Projektor, Leinwand, Mikrofon). Bestellen Sie 10% mehr Namensschilder und Materialien für kurzfristige Anmeldungen.</p>
      <h3 class="text-xl font-semibold text-text mt-6">Checkliste pro Teilnehmer</h3>
      <ul>
        <li>Namensschild mit Lanyard</li>
        <li>Gedrucktes Programm oder App-Zugang</li>
        <li>Willkommenspaket oder Stoffbeutel</li>
        <li>Notizblock und Stift (falls vorgesehen)</li>
        <li>WLAN-Zugangsdaten</li>
      </ul>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    function calcCON() {
      const attendees = parseInt((document.getElementById('con-attendees') as HTMLInputElement).value) || 10;
      const days = parseInt((document.getElementById('con-days') as HTMLInputElement).value) || 2;
      const tracks = parseInt((document.getElementById('con-tracks') as HTMLInputElement).value) || 3;
      const sessionsPerTrack = parseInt((document.getElementById('con-sessions') as HTMLInputElement).value) || 4;
      const keynotes = parseInt((document.getElementById('con-keynotes') as HTMLInputElement).value) || 2;
      const materials = (document.getElementById('con-materials') as HTMLSelectElement).value;
      const meals = (document.getElementById('con-meals') as HTMLSelectElement).value;

      const breakoutRooms = tracks;
      const mainRoom = 1;
      const totalRooms = breakoutRooms + mainRoom;
      const totalSessions = (tracks * sessionsPerTrack * days) + (keynotes * days);
      const badges = Math.ceil(attendees * 1.1);
      const attendeesPerBreakout = Math.ceil(attendees / tracks);

      const micsPerRoom = 2;
      const totalMics = totalRooms * micsPerRoom;
      const projectors = totalRooms;

      let materialItems: { name: string; qty: number }[] = [];
      if (materials === 'full') {
        materialItems = [
          { name: 'Namensschilder + Lanyards', qty: badges },
          { name: 'Gedruckte Programme', qty: badges },
          { name: 'Mappen/Portfolios', qty: badges },
          { name: 'Notizbl\u00F6cke', qty: badges },
          { name: 'Stifte', qty: Math.ceil(badges * 1.2) },
          { name: 'Stoffbeutel', qty: badges },
        ];
      } else if (materials === 'basic') {
        materialItems = [
          { name: 'Namensschilder + Lanyards', qty: badges },
          { name: 'Gedruckte Programme', qty: badges },
          { name: 'Stifte', qty: badges },
        ];
      } else {
        materialItems = [
          { name: 'Namensschilder + Lanyards', qty: badges },
          { name: 'App-Zugangs-QR-Karten', qty: badges },
        ];
      }

      let mealCount = 0;
      if (meals === 'all') mealCount = 3 * days;
      else if (meals === 'lunch') mealCount = 2 * days;
      else if (meals === 'breaks') mealCount = 2 * days;

      const totalMealServings = mealCount * attendees;

      document.getElementById('con-rooms')!.textContent = totalRooms.toString();
      document.getElementById('con-plus')!.textContent = mainRoom + ' Hauptsaal + ' + breakoutRooms + ' Breakout-R\u00E4ume (~' + attendeesPerBreakout + ' pro Raum)';
      document.getElementById('con-totalsess')!.textContent = totalSessions.toString();
      document.getElementById('con-badges')!.textContent = badges.toString();
      document.getElementById('con-mics')!.textContent = totalMics.toString();
      document.getElementById('con-projectors')!.textContent = projectors.toString();

      let details = '<h3 class="font-semibold text-sm text-text mb-2">Konferenz-Material & AV-Technik</h3>';
      details += '<div class="mb-3"><span class="text-xs font-semibold text-text-muted uppercase">AV-Ausstattung</span><ul class="text-sm text-text-secondary space-y-1 mt-1">';
      details += '<li>Projektoren + Leinw\u00E4nde: ' + projectors + ' Sets</li>';
      details += '<li>Funkmikrofone: ' + totalMics + '</li>';
      details += '<li>Laptop-Anschl\u00FCsse/Adapter: ' + projectors + '</li>';
      details += '<li>Redner-Timer/Uhren: ' + totalRooms + '</li>';
      details += '<li>Aufnahme-Equipment: ' + (keynotes > 0 ? mainRoom : 0) + ' Raum/R\u00E4ume</li>';
      details += '</ul></div>';

      details += '<div class="mb-3"><span class="text-xs font-semibold text-text-muted uppercase">Material pro Teilnehmer</span><ul class="text-sm text-text-secondary space-y-1 mt-1">';
      materialItems.forEach(item => {
        details += '<li>' + item.name + ': ' + item.qty + '</li>';
      });
      details += '</ul></div>';

      if (mealCount > 0) {
        details += '<div><span class="text-xs font-semibold text-text-muted uppercase">Verpflegung</span><ul class="text-sm text-text-secondary space-y-1 mt-1">';
        details += '<li>Gesamte Mahlzeiten/Pausenportionen: ' + totalMealServings.toLocaleString('de-DE') + '</li>';
        details += '<li>Kaffee-/Wasser-Stationen: ' + Math.max(2, Math.ceil(attendees / 75)) + '</li>';
        details += '</ul></div>';
      }

      document.getElementById('con-details')!.innerHTML = details;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.con-in').forEach(el => { el.addEventListener('input', calcCON); el.addEventListener('change', calcCON); });
      calcCON();
    }, 50);
  </script>
</CalculatorLayout>
