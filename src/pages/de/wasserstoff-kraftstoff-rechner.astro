---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Wasserstoff-Kraftstoff-Rechner - Brennstoffzellen-Energieausbeute & Effizienz";
const description = "Berechnen Sie die Energieausbeute von Wasserstoff-Brennstoffzellen, den Wirkungsgrad und den Kostenvergleich mit Benzin und Strom.";
const relatedCalcs = [
  { name: "E-Auto vs. Benziner-Rechner", url: "/ev-vs-gas-calculator", description: "EV-Kostenvergleich." },
  { name: "CO2-Fußabdruck-Rechner", url: "/carbon-footprint-calculator", description: "CO2-Emissionen." },
  { name: "Stromkosten-Rechner", url: "/electricity-cost-calculator", description: "Stromkosten." },
  { name: "Kraftstoffverbrauch-Rechner", url: "/gas-mileage-calculator", description: "Kraftstoffeffizienz." },
  { name: "Erneuerbare Energien-Rechner", url: "/renewable-mix-calculator", description: "Energiemix." },
  { name: "CO2-Kompensation-Rechner", url: "/carbon-offset-calculator", description: "CO2 kompensieren." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie effizient ist eine Wasserstoff-Brennstoffzelle?",
      "acceptedAnswer": { "@type": "Answer", "text": "Wasserstoff-Brennstoffzellen haben einen elektrischen Wirkungsgrad von 40–60 %. Grüner Wasserstoff aus erneuerbaren Energien hat nahezu null CO2-Emissionen, während grauer Wasserstoff aus Erdgas etwa 10 kg CO2 pro kg H2 erzeugt." }
    },
    {
      "@type": "Question",
      "name": "Wie viel Energie enthält 1 kg Wasserstoff?",
      "acceptedAnswer": { "@type": "Answer", "text": "1 kg Wasserstoff hat einen Energiegehalt von 33,3 kWh (Niederheizwert). Das entspricht etwa 3,8 Litern Benzin. Damit ist Wasserstoff das energiereichste Element pro Masseeinheit." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Wasserstoff-Kraftstoff-Rechner" lang="de" keywords="wasserstoff brennstoffzelle rechner, wasserstoffenergie, brennstoffzellen wirkungsgrad, wasserstoff vs benzin, grüner wasserstoff" breadcrumbs={[{ name: "Wasserstoff-Kraftstoff-Rechner", url: "/de/wasserstoff-kraftstoff-rechner" }]} enSlug="hydrogen-fuel-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Wasserstoff-Kraftstoff-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Energieausbeute, Wirkungsgrad und Wirtschaftlichkeit von Wasserstoff-Brennstoffzellen berechnen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <h3 class="font-semibold text-text">Wasserstoffeingabe</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wasserstoffmasse (kg)</label><input type="number" id="wk-mass" class="wk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="0.1" max="1000" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Brennstoffzellen-Wirkungsgrad (%)</label><input type="number" id="wk-eff" class="wk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="20" max="80" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">H2-Kosten (€/kg)</label><input type="number" id="wk-h2cost" class="wk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="9" min="1" max="30" step="0.5"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Produktionsmethode</label>
            <select id="wk-method" class="wk-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="green">Grün (Elektrolyse - Erneuerbar)</option>
              <option value="blue">Blau (SMR + CO2-Abscheidung)</option>
              <option value="grey" selected>Grau (Dampfreformierung)</option>
            </select>
          </div>
        </div>
        <h3 class="font-semibold text-text">Vergleich</h3>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Benzinpreis (€/L)</label><input type="number" id="wk-gas" class="wk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1.80" min="0.5" max="5" step="0.05"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Stromtarif (€/kWh)</label><input type="number" id="wk-elec" class="wk-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.32" min="0.01" max="1" step="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Elektrische Energieausbeute</div>
          <div class="text-4xl font-extrabold" id="wk-output">0</div>
          <div class="text-sm text-blue-200 mt-1">kWh</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">H2-Energiegehalt</div><div class="text-xl font-bold" id="wk-energy">0 kWh</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Benzinäquivalent</div><div class="text-xl font-bold" id="wk-gge">0 L</div></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">H2-Kosten</div><div class="text-xl font-bold" id="wk-totalcost">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CO2-Emissionen</div><div class="text-xl font-bold" id="wk-co2">0 kg</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Kosten pro kWh (geliefert)</div>
          <div class="text-2xl font-bold" id="wk-cpkwh">0,000 €</div>
        </div>
      </div>
      <ShareButton calculatorId="wasserstoff-kraftstoff" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wasserstoff-Brennstoffzellen verstehen</h2>
      <p>Wasserstoff hat mit 33,3 kWh/kg (120 MJ/kg) die höchste Energiedichte aller Kraftstoffe pro Masseeinheit. Brennstoffzellen wandeln Wasserstoff bei 40–60 % Wirkungsgrad in Strom um und erzeugen dabei nur Wasser. Grüner Wasserstoff aus erneuerbaren Quellen produziert nahezu kein CO2, während grauer Wasserstoff aus Erdgasreformierung etwa 10 kg CO2 pro kg H2 emittiert.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Wie effizient ist eine Wasserstoff-Brennstoffzelle?</h4>
      <p>Wasserstoff-Brennstoffzellen haben einen elektrischen Wirkungsgrad von 40–60 %. Grüner Wasserstoff aus erneuerbaren Energien hat nahezu null CO2-Emissionen.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Wie viel Energie enthält 1 kg Wasserstoff?</h4>
      <p>1 kg Wasserstoff hat einen Energiegehalt von 33,3 kWh. Das entspricht etwa 3,8 Litern Benzin.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    const wkCO2: Record<string, number> = { green: 0.5, blue: 3, grey: 10 };
    function calcWK() {
      const mass = parseFloat((document.getElementById('wk-mass') as HTMLInputElement).value) || 5;
      const eff = parseFloat((document.getElementById('wk-eff') as HTMLInputElement).value) || 60;
      const h2cost = parseFloat((document.getElementById('wk-h2cost') as HTMLInputElement).value) || 9;
      const method = (document.getElementById('wk-method') as HTMLSelectElement).value;
      const energyContent = mass * 33.3;
      const electricalOut = energyContent * (eff / 100);
      const ggeL = mass * 3.785;
      const totalCost = mass * h2cost;
      const costPerKWh = electricalOut > 0 ? totalCost / electricalOut : 0;
      const co2 = mass * (wkCO2[method] || 10);
      const fmtEur = (n: number) => n.toFixed(2) + ' \u20ac';
      document.getElementById('wk-output')!.textContent = electricalOut.toFixed(1);
      document.getElementById('wk-energy')!.textContent = energyContent.toFixed(1) + ' kWh';
      document.getElementById('wk-gge')!.textContent = ggeL.toFixed(1) + ' L';
      document.getElementById('wk-totalcost')!.textContent = fmtEur(totalCost);
      document.getElementById('wk-co2')!.textContent = co2.toFixed(1) + ' kg';
      document.getElementById('wk-cpkwh')!.textContent = costPerKWh.toFixed(3) + ' \u20ac';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.wk-in').forEach(el => { el.addEventListener('input', calcWK); el.addEventListener('change', calcWK); }); calcWK(); }, 50);
  </script>
</CalculatorLayout>
