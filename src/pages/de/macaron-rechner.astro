---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Macaron Rechner – Zutatenmengen für Macarons berechnen";
const description = "Berechnen Sie Zutatenmengen für Macarons in verschiedenen Batchgrößen. Perfekte Mengen für Mandelmehl, Puderzucker und Eiweiß.";

const relatedCalcs = [
  { name: "Ahornsirup Rechner", url: "/de/ahornsirup-rechner", description: "Rezeptmengen." },
  { name: "Makronährstoff Rechner", url: "/de/makro-rechner", description: "Nährstoffe." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Anteile berechnen." },
];
---
<CalculatorLayout lang="de" enSlug="macaron-calculator" title={title} description={description} calculatorName="Macaron Rechner" keywords="Macaron Rechner, Macarons Rezept skalieren, Mandelmehl Menge, Macaron Zutaten" breadcrumbs={[{ name: "Macaron Rechner", url: "/de/macaron-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Macaron Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Skalieren Sie Ihr Macaron-Rezept auf die gewünschte Anzahl. Alle Zutaten werden automatisch angepasst.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Gewünschte Anzahl Macarons (Schalen)</label>
          <input type="number" id="mac-count" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="40" step="2" min="10" max="500">
          <p class="text-xs text-text-muted mt-1">Hinweis: 2 Schalen = 1 Macaron</p>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Durchmesser (cm)</label>
          <select id="mac-size" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="3.5">Klein (3,5 cm)</option>
            <option value="4.5" selected>Standard (4,5 cm)</option>
            <option value="6">Groß (6 cm)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Macarons (fertig)</div>
          <div class="text-5xl font-extrabold font-mono" id="mac-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="mac-sub">Stück</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Zutaten (Schalen)</h3>
          <div class="space-y-2" id="mac-ingredients">
            <div class="flex justify-between text-sm"><span class="text-text-secondary">Mandelmehl (fein gemahlen)</span><span class="font-bold font-mono" id="mac-almond">–</span></div>
            <div class="flex justify-between text-sm"><span class="text-text-secondary">Puderzucker</span><span class="font-bold font-mono" id="mac-sugar">–</span></div>
            <div class="flex justify-between text-sm"><span class="text-text-secondary">Eiweiß (Alterung empfohlen)</span><span class="font-bold font-mono" id="mac-egg">–</span></div>
            <div class="flex justify-between text-sm"><span class="text-text-secondary">Feiner Zucker (Meringue)</span><span class="font-bold font-mono" id="mac-fine">–</span></div>
          </div>
          <div class="border-t border-border mt-3 pt-3">
            <h3 class="font-semibold text-sm text-text mb-2">Ganache Füllung (Schokolade)</h3>
            <div class="space-y-1">
              <div class="flex justify-between text-sm"><span class="text-text-secondary">Zartbitterschokolade</span><span class="font-bold font-mono" id="mac-choc">–</span></div>
              <div class="flex justify-between text-sm"><span class="text-text-secondary">Sahne (35% Fett)</span><span class="font-bold font-mono" id="mac-cream">–</span></div>
              <div class="flex justify-between text-sm"><span class="text-text-secondary">Butter</span><span class="font-bold font-mono" id="mac-butter">–</span></div>
            </div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="macaron" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Macarons backen – Tipps für das perfekte Ergebnis</h2>
      <p>Macarons sind kleine, zarte französische Gebäckstücke aus Mandelmehl, Puderzucker und Eiweiß. Sie gelten als anspruchsvoll, aber mit dem richtigen Rezept und etwas Übung gelingen sie auch Anfängern. Entscheidend sind: gealtertes Eiweiß (1–2 Tage offen im Kühlschrank), feingesiebtes Mandelmehl, exaktes Macaronage (die spezielle Mischtechnik) und ein gut kalibrierter Ofen.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Warum werden Macarons hohl?</h3>
      <p>Hohle Macarons entstehen oft durch zu viel Luft in der Masse, falsches Mischen (zu wenig Macaronage) oder zu hohe Backtemperatur. Die richtige Konsistenz beim Unterheben ist entscheidend: Der Teig soll wie Lava fließen.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist der Unterschied zwischen französischen und italienischen Macarons?</h3>
      <p>Bei der französischen Methode wird rohes Eiweiß mit Zucker aufgeschlagen. Bei der italienischen Methode wird heißer Zuckersirup ins Eiweiß eingerührt, was stabilere Macarons ergibt, aber aufwendiger ist.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Warum müssen Macarons trocknen?</h3>
      <p>Die Ruhephase (30–60 Minuten) vor dem Backen bildet eine trockene Haut auf der Oberfläche. Diese verhindert Risse und sorgt für den charakteristischen "Fuß" der Macaron.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcMac() {
      const count = parseInt((document.getElementById('mac-count') as HTMLInputElement).value) || 40;
      const size = (document.getElementById('mac-size') as HTMLSelectElement).value;
      const factor = size === '3.5' ? 0.7 : size === '6' ? 1.5 : 1.0;
      const base = 40;
      const ratio = (count / base) * factor;
      const almond = Math.round(125 * ratio);
      const sugar = Math.round(125 * ratio);
      const egg = Math.round(45 * ratio);
      const fine = Math.round(30 * ratio);
      const choc = Math.round(100 * ratio);
      const cream = Math.round(70 * ratio);
      const butter = Math.round(20 * ratio);
      const finished = Math.floor(count / 2);
      document.getElementById('mac-result')!.textContent = count + ' Schalen';
      document.getElementById('mac-sub')!.textContent = '= ' + finished + ' fertige Macarons';
      document.getElementById('mac-almond')!.textContent = almond + ' g';
      document.getElementById('mac-sugar')!.textContent = sugar + ' g';
      document.getElementById('mac-egg')!.textContent = egg + ' g (~' + Math.round(egg / 30) + ' Eiweiß)';
      document.getElementById('mac-fine')!.textContent = fine + ' g';
      document.getElementById('mac-choc')!.textContent = choc + ' g';
      document.getElementById('mac-cream')!.textContent = cream + ' ml';
      document.getElementById('mac-butter')!.textContent = butter + ' g';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('mac-count')!.addEventListener('input', calcMac);
      document.getElementById('mac-size')!.addEventListener('change', calcMac);
      calcMac();
    }, 50);
  </script>
</CalculatorLayout>
