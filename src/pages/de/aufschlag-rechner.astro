---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aufschlagsrechner - Verkaufspreis, Aufschlag und Marge berechnen";
const description = "Berechnen Sie Verkaufspreise, Aufschläge und Margen für Ihre Produkte. Unterschied zwischen Aufschlag (Markup) und Marge (Margin) einfach erklärt.";
const relatedCalcs = [
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Mehrwertsteuer Rechner", url: "/de/mehrwertsteuer-rechner", description: "MwSt berechnen." },
  { name: "Gewinnrechner", url: "/de/gewinnrechner", description: "Gewinn berechnen." },
  { name: "Meeting-Kostenrechner", url: "/de/meeting-kosten-rechner", description: "Meetingkosten ermitteln." },
];
---
<CalculatorLayout lang="de" title={title} description={description} enSlug="markup-calculator" calculatorName="Aufschlagsrechner" keywords="Aufschlag Rechner, Markup Rechner, Marge berechnen, Verkaufspreis, Handelskalkulation" breadcrumbs={[{ name: "Aufschlagsrechner", url: "/de/aufschlag-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aufschlagsrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Verkaufspreise, Aufschläge (Markup) und Gewinnmargen (Margin) für Ihre Kalkulation – inkl. MwSt-Option.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-text mb-1">Berechnungsmodus</label>
          <select id="au-mode" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="from-cost" selected>Aus Einkaufspreis + Aufschlag</option>
            <option value="from-price">Aus Einkaufs- und Verkaufspreis</option>
            <option value="from-margin">Aus Einkaufspreis + Zielmarge</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Einkaufspreis (€)</label><input type="number" id="au-cost" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="50" min="0" step="0.01"></div>
          <div id="au-col2">
            <label class="block text-xs font-medium text-text mb-1" id="au-label2">Aufschlag (%)</label>
            <input type="number" id="au-val2" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="40" min="0" step="0.1">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">MwSt-Satz (%)</label>
            <select id="au-vat" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="0">0 % (steuerfrei)</option>
              <option value="7">7 % (ermäßigt)</option>
              <option value="19" selected>19 % (Standard)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Menge (Stück)</label><input type="number" id="au-qty" class="au-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1" min="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Verkaufspreis (netto)</div>
          <div class="text-5xl font-extrabold font-mono" id="au-price">--</div>
          <div class="text-sm text-blue-200 mt-1" id="au-gross">-- brutto</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aufschlag</div><div class="text-xl font-bold" id="au-markup">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinnmarge</div><div class="text-xl font-bold" id="au-margin">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gewinn (netto)</div><div class="text-xl font-bold" id="au-profit">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MwSt-Betrag</div><div class="text-xl font-bold" id="au-vatamt">--</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aufschlag" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Aufschlag vs. Marge – der Unterschied</h2>
      <p>Aufschlag (Markup) und Marge (Margin) werden oft verwechselt. Der Aufschlag wird auf den Einkaufspreis berechnet: Aufschlag% = (Gewinn / Einkaufspreis) × 100. Die Marge hingegen bezieht sich auf den Verkaufspreis: Marge% = (Gewinn / Verkaufspreis) × 100. Ein Aufschlag von 50 % entspricht daher einer Marge von nur 33,3 %. In der deutschen Handelskalkulation werden beide Begriffe verwendet – die Marge ist jedoch in der Praxis verbreiteter.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Was ist der Unterschied zwischen Aufschlag und Marge?</strong> Aufschlag (Markup) = Gewinn / Einkaufspreis. Marge = Gewinn / Verkaufspreis. Bei gleichem Gewinn ist der Aufschlag stets höher als die Marge.</p>
      <p><strong>Welcher Aufschlag ist typisch im Handel?</strong> Im Einzelhandel sind Aufschläge von 30–100 % üblich. Im Gastronomiebereich liegen die Aufschläge oft bei 200–400 % auf den Wareneinsatz.</p>
      <p><strong>Wie berechne ich den Verkaufspreis?</strong> Verkaufspreis = Einkaufspreis × (1 + Aufschlag / 100). Bei 50 € Einkaufspreis und 40 % Aufschlag: 50 × 1,40 = 70 €.</p>
      <p><strong>Was ist eine gute Gewinnmarge?</strong> Das hängt stark von der Branche ab. Im Lebensmitteleinzelhandel gelten 2–5 % Nettomarge als gut; im Softwarebereich können es 20–30 % sein.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAU() {
      const mode = (document.getElementById('au-mode') as HTMLSelectElement).value;
      const cost = parseFloat((document.getElementById('au-cost') as HTMLInputElement).value) || 0;
      const val2 = parseFloat((document.getElementById('au-val2') as HTMLInputElement).value) || 0;
      const vatRate = parseFloat((document.getElementById('au-vat') as HTMLSelectElement).value) / 100;
      const qty = parseInt((document.getElementById('au-qty') as HTMLInputElement).value) || 1;
      const label2El = document.getElementById('au-label2')!;
      let price = 0;
      if (mode === 'from-cost') {
        label2El.textContent = 'Aufschlag (%)';
        price = cost * (1 + val2 / 100);
      } else if (mode === 'from-price') {
        label2El.textContent = 'Verkaufspreis (€)';
        price = val2;
      } else {
        label2El.textContent = 'Zielmarge (%)';
        price = val2 < 100 ? cost / (1 - val2 / 100) : 0;
      }
      const profit = price - cost;
      const markup = cost > 0 ? (profit / cost) * 100 : 0;
      const margin = price > 0 ? (profit / price) * 100 : 0;
      const gross = price * (1 + vatRate);
      const vatAmt = gross - price;
      const fmt = (v: number) => v.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
      const fmtP = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' %';
      document.getElementById('au-price')!.textContent = price > 0 ? fmt(price) : '--';
      document.getElementById('au-gross')!.textContent = price > 0 ? fmt(gross * qty) + ' brutto (' + qty + ' Stk.)' : '--';
      document.getElementById('au-markup')!.textContent = markup > 0 ? fmtP(markup) : '--';
      document.getElementById('au-margin')!.textContent = margin > 0 ? fmtP(margin) : '--';
      document.getElementById('au-profit')!.textContent = profit > 0 ? fmt(profit * qty) : '--';
      document.getElementById('au-vatamt')!.textContent = vatAmt > 0 ? fmt(vatAmt * qty) : fmt(0);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.au-in').forEach(el => { el.addEventListener('input', calcAU); el.addEventListener('change', calcAU); });
      calcAU();
    }, 50);
  </script>
</CalculatorLayout>
