---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Bildungssparen-Rechner - Sparplan für Ausbildungskosten";
const description = "Berechnen Sie, wie viel Sie für die Ausbildung Ihres Kindes sparen müssen. Sehen Sie projizierte Ersparnisse, Finanzierungslücke und erforderliche monatliche Beiträge.";
const relatedCalcs = [
  { name: "Studienkosten-Rechner", url: "/de/studienkosten-rechner", description: "Studienkosten." },
  { name: "Anlagerechner", url: "/de/anlagerechner", description: "Investitionsrechner." },
  { name: "Zinseszins-Rechner", url: "/de/zinseszins-rechner", description: "Zinseszins." },
  { name: "Studienfonds-Rechner", url: "/de/studienfonds-rechner", description: "Studienfonds." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Bildungssparen-Rechner" enSlug="college-savings-calculator" keywords="Bildungssparen, Ausbildungssparen, Studium Sparplan, Kind Studium sparen, ETF Sparplan Kind" breadcrumbs={[{ name: "Bildungssparen-Rechner", url: "/de/bildungssparen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Bildungssparen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihren Sparplan, um die zukünftigen Ausbildungskosten Ihres Kindes abzudecken.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1">Aktuelles Alter des Kindes</label>
            <input type="number" id="bs-age" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="5" min="0" max="17" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ziel-Gesamtkosten (5 Jahre Studium)</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
              <input type="number" id="bs-target" class="w-full pl-12 pr-3 py-3 border border-border rounded-xl text-lg" value="60000" min="0" step="5000">
            </div>
            <p class="text-xs text-text-muted mt-1">Staatl. Uni ~55K; Privat ~125K; Ausland ~100-250K (5 Jahre)</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Aktuelle Ersparnisse</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
              <input type="number" id="bs-current" class="w-full pl-12 pr-3 py-3 border border-border rounded-xl text-lg" value="10000" min="0" step="1000">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Monatliche Sparrate</label>
            <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
              <input type="number" id="bs-monthly" class="w-full pl-12 pr-3 py-3 border border-border rounded-xl text-lg" value="200" min="0" step="25">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Erwartete Jahresrendite (%)</label>
            <div class="relative">
              <input type="number" id="bs-return" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="6" min="0" max="15" step="0.5">
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted">%</span>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="p-6 bg-primary rounded-2xl text-white text-center">
            <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Projizierte Ersparnisse mit 18</div>
            <div class="text-5xl font-extrabold font-mono" id="bs-projected">0 EUR</div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Finanzierungslücke</div>
              <div class="text-xl font-bold text-red-600" id="bs-gap">0 EUR</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Spardauer</div>
              <div class="text-xl font-bold" id="bs-years">0</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Erforderl. monatl.</div>
              <div class="text-xl font-bold text-green-600" id="bs-required">0 EUR</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl text-center">
              <div class="text-xs text-text-muted uppercase">Gesamteinzahlungen</div>
              <div class="text-xl font-bold" id="bs-total-contrib">0 EUR</div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Anlageerträge</div>
            <div class="text-xl font-bold text-blue-600" id="bs-growth">0 EUR</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="bildungssparen" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Bildungssparen mit ETF-Sparplan</h2>
      <p>Ein ETF-Sparplan auf ein Junior-Depot bietet steuerliche Vorteile durch den Sparerpauschbetrag des Kindes. Beginnen Sie früh, um den Zinseszins-Effekt maximal zu nutzen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Tipps zum Bildungssparen</h3>
      <p>Selbst kleine monatliche Beiträge summieren sich über 18 Jahre. Bitten Sie Großeltern und Familie, statt Spielzeug auf das Sparkonto einzuzahlen. Nutzen Sie altersbasierte Anlagestrategien, die mit zunehmendem Alter konservativer werden.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const fmtBS = (n: number) => Math.round(n).toLocaleString('de-DE') + ' EUR';

    function calcBS() {
      const age = parseInt((document.getElementById('bs-age') as HTMLInputElement).value) || 0;
      const target = parseFloat((document.getElementById('bs-target') as HTMLInputElement).value) || 0;
      const current = parseFloat((document.getElementById('bs-current') as HTMLInputElement).value) || 0;
      const monthly = parseFloat((document.getElementById('bs-monthly') as HTMLInputElement).value) || 0;
      const annualReturn = (parseFloat((document.getElementById('bs-return') as HTMLInputElement).value) || 0) / 100;

      const yearsToSave = Math.max(0, 18 - age);
      const monthsToSave = yearsToSave * 12;
      const monthlyRate = annualReturn / 12;

      let projected = current * Math.pow(1 + annualReturn, yearsToSave);
      if (monthlyRate > 0 && monthsToSave > 0) {
        projected += monthly * ((Math.pow(1 + monthlyRate, monthsToSave) - 1) / monthlyRate);
      } else {
        projected += monthly * monthsToSave;
      }

      const totalContributions = current + monthly * monthsToSave;
      const growth = projected - totalContributions;
      const gap = Math.max(0, target - projected);

      let requiredMonthly = 0;
      if (monthsToSave > 0) {
        const fvCurrent = current * Math.pow(1 + annualReturn, yearsToSave);
        const remaining = target - fvCurrent;
        if (remaining > 0 && monthlyRate > 0) {
          requiredMonthly = remaining / ((Math.pow(1 + monthlyRate, monthsToSave) - 1) / monthlyRate);
        } else if (remaining > 0) {
          requiredMonthly = remaining / monthsToSave;
        }
      }

      document.getElementById('bs-projected')!.textContent = fmtBS(projected);
      document.getElementById('bs-gap')!.textContent = gap > 0 ? fmtBS(gap) : '0 EUR (finanziert!)';
      document.getElementById('bs-years')!.textContent = yearsToSave + ' Jahre';
      document.getElementById('bs-required')!.textContent = fmtBS(Math.max(0, requiredMonthly)) + '/Mo.';
      document.getElementById('bs-total-contrib')!.textContent = fmtBS(totalContributions);
      document.getElementById('bs-growth')!.textContent = fmtBS(Math.max(0, growth));

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      ['bs-age', 'bs-target', 'bs-current', 'bs-monthly', 'bs-return'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.addEventListener('input', calcBS); el.addEventListener('change', calcBS); }
      });
      calcBS();
    }, 50);
  </script>
</CalculatorLayout>
