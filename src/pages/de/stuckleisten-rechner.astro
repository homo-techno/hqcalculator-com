---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Stuckleisten-Rechner - Laenge, Stuecke & Kosten berechnen";
const description = "Berechnen Sie Stuckleisten-Laenge, Stueckzahl, Ecken und Kosten fuer jeden Raum.";
const relatedCalcs = [
  { name: "Quadratmeterrechner", url: "/de/quadratmeterrechner", description: "Flaeche berechnen." },
  { name: "Arbeitsplatten-Rechner", url: "/de/arbeitsplatte-rechner", description: "Arbeitsplatten." },
  { name: "Vorhang-Rechner", url: "/de/vorhang-rechner", description: "Vorhaenge." },
  { name: "Flaechenrechner", url: "/de/flaechenrechner", description: "Flaechen." },
  { name: "Betonrechner", url: "/de/betonrechner", description: "Beton." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Stuckleisten-Rechner" keywords="Stuckleisten Rechner, Stuckleisten Laenge, Deckenleisten, Zierleisten, Raumperimeter" breadcrumbs={[{ name: "Stuckleisten-Rechner", url: "/de/stuckleisten-rechner" }]} lang="de" enSlug="crown-molding-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Stuckleisten-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie den Leistenbedarf fuer Ihren Raum.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Raumlaenge (m)</label><input type="number" id="slr-len" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="4.5" min="0" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="slr-wid" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="3.5" min="0" step="0.1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Leistenlaenge (m)</label>
            <select id="slr-piece" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="2">2 m</option>
              <option value="2.4" selected>2,4 m</option>
              <option value="3">3 m</option>
              <option value="4">4 m</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Preis pro Leiste (EUR)</label><input type="number" id="slr-price" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="8" min="0" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Innenecken</label><input type="number" id="slr-icorn" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Aussenecken</label><input type="number" id="slr-ocorn" class="slr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamtumfang</div>
          <div class="text-5xl font-extrabold font-mono" id="slr-result">0 m</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leisten</div><div class="text-xl font-bold font-mono" id="slr-pieces">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verschnitt</div><div class="text-xl font-bold font-mono" id="slr-waste">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten</div><div class="text-xl font-bold font-mono" id="slr-cost">0 EUR</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Eckverbinder</div><div class="text-xl font-bold font-mono" id="slr-blocks">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Naegel (gesch.)</div><div class="text-xl font-bold font-mono" id="slr-nails">0</div></div>
        </div>
      </div>
      <ShareButton calculatorId="crown-molding" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Stuckleisten anbringen</h2>
      <p>Stuckleisten verleihen jedem Raum einen eleganten Abschluss. Planen Sie immer etwa 10 % Verschnitt ein, besonders bei Raeumen mit vielen Ecken. Messen Sie den Raumumfang genau und beruecksichtigen Sie Tuer- und Fensteroefffnungen.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcSLR() {
      const len = parseFloat((document.getElementById('slr-len') as HTMLInputElement).value) || 0;
      const wid = parseFloat((document.getElementById('slr-wid') as HTMLInputElement).value) || 0;
      const pieceLen = parseFloat((document.getElementById('slr-piece') as HTMLSelectElement).value);
      const price = parseFloat((document.getElementById('slr-price') as HTMLInputElement).value) || 0;
      const iCorn = parseInt((document.getElementById('slr-icorn') as HTMLInputElement).value) || 0;
      const oCorn = parseInt((document.getElementById('slr-ocorn') as HTMLInputElement).value) || 0;
      const perimeter = 2 * (len + wid);
      const perimeterWithWaste = perimeter * 1.1;
      const pieces = Math.ceil(perimeterWithWaste / pieceLen);
      const totalLength = pieces * pieceLen;
      const wasteMt = totalLength - perimeter;
      const nails = Math.ceil(perimeter * 6);
      document.getElementById('slr-result')!.textContent = perimeter.toFixed(1).replace('.', ',') + ' m';
      document.getElementById('slr-pieces')!.textContent = pieces.toString();
      document.getElementById('slr-waste')!.textContent = wasteMt.toFixed(1).replace('.', ',') + ' m';
      document.getElementById('slr-cost')!.textContent = (pieces * price).toFixed(0) + ' \u20AC';
      document.getElementById('slr-blocks')!.textContent = (iCorn + oCorn).toString();
      document.getElementById('slr-nails')!.textContent = nails.toString();
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.slr-in').forEach(el => { el.addEventListener('input', calcSLR); el.addEventListener('change', calcSLR); });
      calcSLR();
    }, 50);
  </script>
</CalculatorLayout>
