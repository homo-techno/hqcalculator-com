---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Zahn-R\u00f6ntgen-Rechner - Strahlendosis & Vergleich";
const description = "Berechnen Sie die Strahlendosis von Zahn-R\u00f6ntgenaufnahmen (Bissfl\u00fcgel, Panorama, DVT) und vergleichen Sie mit der t\u00e4glichen Hintergrundstrahlung.";

const relatedCalcs = [
  { name: "Zahnversicherung-Rechner", url: "/de/zahnversicherung-rechner", description: "Versicherungsanalyse." },
  { name: "Zahnkrone-Rechner", url: "/de/zahnkrone-rechner", description: "Kronenkosten." },
  { name: "Zahnimplantat-Kostenrechner", url: "/de/zahnimplantat-kosten-rechner", description: "Implantatkosten." },
  { name: "Zahnbr\u00fccke-Rechner", url: "/de/zahnbruecke-rechner", description: "Br\u00fcckenkosten." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Zahn-R\u00f6ntgen-Rechner" lang="de" enSlug="dental-x-ray-calculator" keywords="zahn roentgen strahlung, bissfluegel strahlung, panorama roentgen dosis, dvt dosis, zahn roentgen sicherheit, mikrosievert" breadcrumbs={[{ name: "Zahn-R\u00f6ntgen-Rechner", url: "/de/zahn-roentgen-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zahn-R&ouml;ntgen-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die Strahlendosis von Zahnaufnahmen und vergleichen Sie mit der Hintergrundstrahlung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="p-3 bg-blue-50 rounded-xl text-center text-xs font-semibold text-blue-900 uppercase tracking-wide">Anzahl pro R&ouml;ntgentyp eingeben</div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Bissfl&uuml;gelaufnahmen</label><input type="number" id="zrx-bite" class="zrx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="0" max="20" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Zahnfilme (periap.)</label><input type="number" id="zrx-peri" class="zrx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="20" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Panorama (OPG)</label><input type="number" id="zrx-pano" class="zrx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="5" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">DVT (Cone Beam CT)</label><input type="number" id="zrx-cbct" class="zrx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="5" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Vollstatus (FMX)</label><input type="number" id="zrx-fmx" class="zrx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="3" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Fernr&ouml;ntgen (FRS)</label><input type="number" id="zrx-ceph" class="zrx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0" min="0" max="5" step="1"></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Ger&auml;tetyp</label>
          <select id="zrx-equip" class="zrx-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="digital" selected>Digital (geringere Dosis)</option>
            <option value="film">Filmbasiert (h&ouml;here Dosis)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Effektive Gesamtdosis</div>
          <div class="text-5xl font-extrabold font-mono" id="zrx-total">0 &micro;Sv</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tage Hintergrundstr.</div><div class="text-xl font-bold font-mono" id="zrx-days">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">% des Jahreslimits</div><div class="text-xl font-bold font-mono" id="zrx-pct">0%</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Risikostufe</div><div class="text-xl font-bold font-mono" id="zrx-risk">-</div></div>
        </div>
        <div class="p-3 bg-blue-50 rounded-xl text-center text-xs font-semibold text-blue-900 uppercase tracking-wide mb-1">Vergleich mit &uuml;blicher Exposition</div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Thorax-R&ouml;ntgen &Auml;quiv.</div><div class="text-xl font-bold font-mono" id="zrx-chest">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flugstunden &Auml;quiv.</div><div class="text-xl font-bold font-mono" id="zrx-flight">0 Std</div></div>
        </div>
      </div>
      <ShareButton calculatorId="dental-xray-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Strahlendosis bei Zahnaufnahmen</h2>
      <p>Digitale Zahnr&ouml;ntgenaufnahmen haben eine sehr geringe Dosis. Ein Bissfl&uuml;gelbild hat etwa 5 &micro;Sv &ndash; das entspricht weniger als einem Tag nat&uuml;rlicher Hintergrundstrahlung.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Wie oft darf man Zahnr&ouml;ntgen machen?</strong> Das Jahreslimit f&uuml;r die &Ouml;ffentlichkeit liegt bei 1.000 &micro;Sv. Normale Zahnaufnahmen liegen weit darunter.</p>
      <p><strong>Ist ein DVT gef&auml;hrlich?</strong> Ein DVT hat mit ca. 75 &micro;Sv eine h&ouml;here Dosis als ein OPG, ist aber immer noch sehr sicher im Vergleich zu einem CT des Kopfes.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcZRX() {
      const bite = parseFloat((document.getElementById('zrx-bite') as HTMLInputElement).value) || 0;
      const peri = parseFloat((document.getElementById('zrx-peri') as HTMLInputElement).value) || 0;
      const pano = parseFloat((document.getElementById('zrx-pano') as HTMLInputElement).value) || 0;
      const cbct = parseFloat((document.getElementById('zrx-cbct') as HTMLInputElement).value) || 0;
      const fmx = parseFloat((document.getElementById('zrx-fmx') as HTMLInputElement).value) || 0;
      const ceph = parseFloat((document.getElementById('zrx-ceph') as HTMLInputElement).value) || 0;
      const equip = (document.getElementById('zrx-equip') as HTMLSelectElement).value;

      const doses: Record<string, number> = { bite: 5, peri: 5, pano: 14, cbct: 75, fmx: 85, ceph: 6 };
      const filmMult = equip === 'film' ? 1.8 : 1.0;

      const totalDose = Math.round((bite * doses.bite + peri * doses.peri + pano * doses.pano + cbct * doses.cbct + fmx * doses.fmx + ceph * doses.ceph) * filmMult);
      const bgPerDay = 8.2;
      const daysEquiv = (totalDose / bgPerDay).toFixed(1).replace('.', ',');
      const pctLimit = ((totalDose / 1000) * 100).toFixed(1).replace('.', ',');

      let risk: string;
      if (totalDose < 20) risk = 'Vernachl\u00e4ssigbar';
      else if (totalDose < 100) risk = 'Sehr gering';
      else if (totalDose < 500) risk = 'Gering';
      else risk = 'M\u00e4\u00dfig';

      const chestEquiv = (totalDose / 20).toFixed(1).replace('.', ',');
      const flightHours = (totalDose / 5).toFixed(1).replace('.', ',');

      document.getElementById('zrx-total')!.textContent = totalDose + ' \u00B5Sv';
      document.getElementById('zrx-days')!.textContent = daysEquiv + ' Tage';
      document.getElementById('zrx-pct')!.textContent = pctLimit + '%';
      document.getElementById('zrx-risk')!.textContent = risk;
      document.getElementById('zrx-chest')!.textContent = chestEquiv + 'x';
      document.getElementById('zrx-flight')!.textContent = flightHours + ' Std';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.zrx-in').forEach(el => { el.addEventListener('input', calcZRX); el.addEventListener('change', calcZRX); });
      calcZRX();
    }, 50);
  </script>
</CalculatorLayout>
