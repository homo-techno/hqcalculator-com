---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Patentkosten Rechner - DPMA & EPA Gebühren";
const description = "Schätzen Sie Anmelde-, Jahres- und Bearbeitungsgebühren für deutsche (DPMA) und europäische (EPA) Patente über einen Zeitraum von bis zu 20 Jahren.";

const relatedCalcs = [
  { name: "Rechtskosten-Rechner", url: "/de/rechtskosten-rechner", description: "Rechtskosten." },
  { name: "Kostenrechner", url: "/de/kostenrechner", description: "Projektkosten." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Rendite berechnen." },
  { name: "Amortisationsrechner", url: "/de/amortisations-rechner", description: "Amortisation." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Patentkosten Rechner" lang="de" enSlug="patent-cost-calculator" keywords="patentkosten rechner, DPMA gebühren, EPA patent kosten, jahresgebühr patent, patentanmeldung kosten" breadcrumbs={[{ name: "Patentkosten Rechner", url: "/de/patentkosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Patentkosten Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die Gesamtkosten für ein deutsches oder europäisches Patent über seine gesamte Laufzeit.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Patenttyp</label>
            <select id="pat-type" class="pat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="dpma">Deutsches Patent (DPMA)</option>
              <option value="epa">Europäisches Patent (EPA)</option>
              <option value="dpma_util">Gebrauchsmuster (DPMA)</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-text mb-1">Laufzeit (Jahre)</label><input type="number" id="pat-years" class="pat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" max="20" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Anzahl Ansprüche</label><input type="number" id="pat-claims" class="pat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="10" min="1" max="50" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Anwaltskosten (€/Jahr)</label><input type="number" id="pat-attorney" class="pat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="2000" min="0" step="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Validierungsländer (EPA)</label><input type="number" id="pat-countries" class="pat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="5" min="1" max="44" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Übersetzungskosten (€/Land)</label><input type="number" id="pat-transl" class="pat-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="1500" min="0" step="100"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Geschätzte Gesamtkosten</div>
          <div class="text-4xl font-extrabold font-mono" id="pat-result">0 €</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Amtliche Gebühren</div><div class="text-xl font-bold" id="pat-official">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anwaltskosten</div><div class="text-xl font-bold" id="pat-attcost">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Übersetzung</div><div class="text-xl font-bold" id="pat-translcost">0 €</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl overflow-x-auto">
          <h3 class="font-semibold text-sm text-text mb-3">Kostenverlauf (Jahresgebühren)</h3>
          <div id="pat-table" class="text-sm space-y-1"></div>
        </div>
      </div>
      <ShareButton calculatorId="patentkosten-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Patentkosten in Deutschland und Europa</h2>
      <p class="text-text-secondary mt-2">Patentkosten setzen sich aus amtlichen Gebühren, Anwaltskosten und Übersetzungsgebühren zusammen. Ein deutsches Patent (DPMA) ist bei Eigenanmeldung günstiger, schützt aber nur in Deutschland. Ein europäisches Patent (EPA) wird zentral in München geprüft und kann in über 44 Ländern validiert werden – zu entsprechend höheren Kosten. Die Jahresgebühren steigen mit zunehmender Laufzeit deutlich an.</p>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>DPMA Anmeldung:</strong> ca. 40–60 € (elektronisch)</p>
        <p><strong>EPA Anmeldung:</strong> ca. 1.460–2.420 € (inkl. Recherche)</p>
        <p><strong>Jahresgebühren:</strong> steigen von ~100 € (Jahr 3) auf ~1.940 € (Jahr 20)</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie lange gilt ein Patent?</strong> Ein Patent gilt maximal 20 Jahre ab dem Anmeldetag, vorausgesetzt die Jahresgebühren werden bezahlt. Gebrauchsmuster haben eine maximale Laufzeit von 10 Jahren.</p>
      <p><strong>Was ist der Unterschied zwischen Patent und Gebrauchsmuster?</strong> Das Gebrauchsmuster ist günstiger und schneller, wird aber ohne Prüfung eingetragen. Es hat eine kürzere Laufzeit (10 Jahre) und bietet geringere Rechtssicherheit.</p>
      <p><strong>Wann lohnt sich ein europäisches Patent?</strong> Wenn Schutz in mehr als 3–4 europäischen Ländern gewünscht ist, ist das EPA-Patent trotz höherer Kosten günstiger als mehrere nationale Einzelpatente.</p>
      <p><strong>Gibt es Gebührenermäßigungen?</strong> Ja, bei elektronischer Einreichung und für KMU/Einzelpersonen gibt es beim DPMA Ermäßigungen. Beim EPA sind Mikro-KMU seit 2023 beitragsberechtigt.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const patEuro = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';

    function calcPAT() {
      const type = (document.getElementById('pat-type') as HTMLSelectElement).value;
      const years = parseInt((document.getElementById('pat-years') as HTMLInputElement).value) || 20;
      const claims = parseInt((document.getElementById('pat-claims') as HTMLInputElement).value) || 10;
      const attorneyPerYear = parseFloat((document.getElementById('pat-attorney') as HTMLInputElement).value) || 2000;
      const countries = parseInt((document.getElementById('pat-countries') as HTMLInputElement).value) || 5;
      const translPerCountry = parseFloat((document.getElementById('pat-transl') as HTMLInputElement).value) || 1500;

      const dpmaAnnual = [0, 0, 70, 70, 70, 90, 130, 180, 240, 290, 350, 470, 620, 760, 910, 1060, 1230, 1410, 1580, 1760, 1940];
      const epaAnnual = [0, 0, 0, 445, 525, 615, 735, 855, 975, 1095, 1215, 1340, 1470, 1610, 1745, 1890, 2035, 2180, 2325, 2470, 2665];

      let filingFee = 0;
      let examFee = 0;
      let translCost = 0;
      let annualFees = 0;
      const annualRows: string[] = [];

      if (type === 'dpma') {
        filingFee = 40;
        examFee = 350 + Math.max(0, claims - 10) * 20;
        for (let y = 1; y <= Math.min(years, 20); y++) {
          const fee = dpmaAnnual[y] || 0;
          if (fee > 0) annualFees += fee;
          if (fee > 0) annualRows.push('<div class="flex justify-between"><span>Jahr ' + y + '</span><span class="font-mono">' + fee.toLocaleString('de-DE') + ' \u20AC</span></div>');
        }
      } else if (type === 'epa') {
        filingFee = 1460;
        examFee = 1880 + Math.max(0, claims - 15) * 235;
        translCost = countries * translPerCountry;
        for (let y = 1; y <= Math.min(years, 20); y++) {
          const fee = epaAnnual[y] || 0;
          if (fee > 0) annualFees += fee;
          if (fee > 0) annualRows.push('<div class="flex justify-between"><span>Jahr ' + y + '</span><span class="font-mono">' + fee.toLocaleString('de-DE') + ' \u20AC</span></div>');
        }
      } else {
        filingFee = 40;
        examFee = 0;
        for (let y = 1; y <= Math.min(years, 10); y++) {
          const fee = y <= 3 ? 0 : (y - 3) * 60;
          if (fee > 0) annualFees += fee;
          annualRows.push('<div class="flex justify-between"><span>Jahr ' + y + '</span><span class="font-mono">' + fee.toLocaleString('de-DE') + ' \u20AC</span></div>');
        }
      }

      const officialFees = filingFee + examFee + annualFees;
      const attTotal = attorneyPerYear * years;
      const total = officialFees + attTotal + translCost;

      document.getElementById('pat-result')!.textContent = patEuro(total);
      document.getElementById('pat-official')!.textContent = patEuro(officialFees);
      document.getElementById('pat-attcost')!.textContent = patEuro(attTotal);
      document.getElementById('pat-translcost')!.textContent = patEuro(translCost);
      document.getElementById('pat-table')!.innerHTML = annualRows.join('');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.pat-in').forEach(el => { el.addEventListener('input', calcPAT); el.addEventListener('change', calcPAT); });
      calcPAT();
    }, 50);
  </script>
</CalculatorLayout>
