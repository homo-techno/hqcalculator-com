---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Gaming-PC Watt-Rechner - Netzteil & Leistungsaufnahme";
const description = "Berechnen Sie den Netzteilbedarf aus Komponenten-TDP, GPU- und CPU-Leistung und erhalten Sie Empfehlungen f\u00FCr Ihren Gaming-PC.";
const relatedCalcs = [
  { name: "Stromkosten-Rechner", url: "/de/stromkostenrechner", description: "Stromkosten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Budget-Rechner", url: "/de/budgetrechner", description: "Budget." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Gaming-PC Watt-Rechner" lang="de" enSlug="gaming-pc-wattage-calculator" keywords="pc watt rechner, netzteil rechner, stromversorgung, gpu leistung, cpu tdp, gaming pc leistung" breadcrumbs={[{ name: "Gaming-PC Watt", url: "/de/gaming-pc-watt-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gaming-PC Watt-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die richtige Netzteil-Leistung f&uuml;r Ihren Gaming-PC.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-text mb-1">GPU-Leistung (TDP/TGP, Watt)</label>
          <select class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-gpu">
            <option value="75">Budget (GTX 1650 - 75W)</option>
            <option value="130">Mittelklasse (RTX 4060 - 130W)</option>
            <option value="200" selected>High-End (RTX 4070 - 200W)</option>
            <option value="285">Enthusiast (RTX 4080 - 285W)</option>
            <option value="350">Flaggschiff (RTX 4090 - 350W)</option>
            <option value="0">Benutzerdefiniert...</option>
          </select>
        </div>
        <div id="gpw-gpu-custom-wrap" style="display:none">
          <label class="block text-sm font-semibold text-text mb-1">Benutzerdefinierte GPU-Watt</label>
          <input type="number" class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-gpucustom" min="0" value="200">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">CPU-Leistung (TDP, Watt)</label>
          <select class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-cpu">
            <option value="65">Standard (Ryzen 5/i5 - 65W)</option>
            <option value="105" selected>Hohe Leistung (Ryzen 7/i7 - 105W)</option>
            <option value="125">Enthusiast (Ryzen 9/i9 - 125W)</option>
            <option value="170">Extrem (i9-14900K - 170W+)</option>
            <option value="0">Benutzerdefiniert...</option>
          </select>
        </div>
        <div id="gpw-cpu-custom-wrap" style="display:none">
          <label class="block text-sm font-semibold text-text mb-1">Benutzerdefinierte CPU-Watt</label>
          <input type="number" class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-cpucustom" min="0" value="105">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">RAM-Riegel</label>
          <input type="number" class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-ram" min="1" max="8" value="2">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Speicherlaufwerke (SSD/HDD)</label>
          <input type="number" class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-storage" min="0" max="10" value="2">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">Geh&auml;usel&uuml;fter</label>
          <input type="number" class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-fans" min="0" max="10" value="4">
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">AIO/Wasserk&uuml;hlung</label>
          <select class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-cooler">
            <option value="0">Luftk&uuml;hler (in CPU enthalten)</option>
            <option value="15" selected>120/140mm AIO (+15W)</option>
            <option value="25">240/280mm AIO (+25W)</option>
            <option value="35">360mm AIO (+35W)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-text mb-1">RGB/LED-Beleuchtung</label>
          <select class="gpw-in w-full px-4 py-2 border border-border rounded-lg" id="gpw-rgb">
            <option value="0">Keine</option>
            <option value="10" selected>Moderat (10W)</option>
            <option value="25">Viel RGB (25W)</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Empfohlenes Netzteil</div>
          <div class="text-5xl font-extrabold font-mono" id="gpw-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Gesamtverbrauch</div>
            <div class="text-xl font-bold font-mono" id="gpw-total">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Spitze mit Transienten</div>
            <div class="text-xl font-bold font-mono" id="gpw-peak">--</div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Netzteil-Auslastung</div>
            <div class="text-xl font-bold font-mono" id="gpw-load">--</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">J&auml;hrliche Kosten (gesch.)</div>
            <div class="text-xl font-bold font-mono" id="gpw-annual">--</div>
          </div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Komponenten-Aufschl&uuml;sselung</h3>
          <div class="text-xs font-mono space-y-1" id="gpw-breakdown"></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gaming-pc-wattage" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Netzteil-Dimensionierung f&uuml;r Gaming-PCs</h2>
      <p>Ein ausreichend dimensioniertes Netzteil ist entscheidend f&uuml;r Stabilit&auml;t und Langlebigkeit. Planen Sie mindestens 20-30% Reserve &uuml;ber dem tats&auml;chlichen Verbrauch ein, da GPUs kurzzeitige Lastspitzen erzeugen k&ouml;nnen.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Welches Netzteil f&uuml;r RTX 4070?</strong> F&uuml;r eine RTX 4070 mit modernem CPU empfehlen wir mindestens 650W.</p>
      <p><strong>Wie viel Strom verbraucht ein Gaming-PC?</strong> Ein typischer Gaming-PC verbraucht 300-500W unter Last, je nach Komponenten.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGPW() {
      const gpuSelect = parseInt((document.getElementById('gpw-gpu') as HTMLSelectElement).value);
      const gpuCustom = parseInt((document.getElementById('gpw-gpucustom') as HTMLInputElement).value) || 200;
      const cpuSelect = parseInt((document.getElementById('gpw-cpu') as HTMLSelectElement).value);
      const cpuCustom = parseInt((document.getElementById('gpw-cpucustom') as HTMLInputElement).value) || 105;
      const ram = parseInt((document.getElementById('gpw-ram') as HTMLInputElement).value) || 2;
      const storage = parseInt((document.getElementById('gpw-storage') as HTMLInputElement).value) || 2;
      const fans = parseInt((document.getElementById('gpw-fans') as HTMLInputElement).value) || 4;
      const cooler = parseInt((document.getElementById('gpw-cooler') as HTMLSelectElement).value) || 0;
      const rgb = parseInt((document.getElementById('gpw-rgb') as HTMLSelectElement).value) || 0;
      document.getElementById('gpw-gpu-custom-wrap')!.style.display = gpuSelect === 0 ? '' : 'none';
      document.getElementById('gpw-cpu-custom-wrap')!.style.display = cpuSelect === 0 ? '' : 'none';
      const gpuW = gpuSelect === 0 ? gpuCustom : gpuSelect;
      const cpuW = cpuSelect === 0 ? cpuCustom : cpuSelect;
      const ramW = ram * 5;
      const storageW = storage * 8;
      const fansW = fans * 3;
      const moboW = 50;
      const totalW = gpuW + cpuW + ramW + storageW + fansW + cooler + rgb + moboW;
      const peakW = Math.round(totalW + gpuW * 0.5);
      const withHeadroom = Math.round(peakW * 1.25);
      const psuSizes = [450, 550, 650, 750, 850, 1000, 1200, 1600];
      let recommended = psuSizes[psuSizes.length - 1];
      for (const size of psuSizes) {
        if (size >= withHeadroom) { recommended = size; break; }
      }
      const loadPct = (totalW / recommended * 100).toFixed(0);
      const annualKwh = (totalW / 1000) * 4 * 365;
      const annualCost = annualKwh * 0.35;
      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      document.getElementById('gpw-result')!.textContent = recommended + 'W';
      document.getElementById('gpw-total')!.textContent = totalW + 'W';
      document.getElementById('gpw-peak')!.textContent = peakW + 'W';
      document.getElementById('gpw-load')!.textContent = loadPct + '%';
      document.getElementById('gpw-annual')!.textContent = fmt(annualCost) + ' \u20AC/Jahr';
      const parts = [
        { name: 'GPU', w: gpuW },
        { name: 'CPU', w: cpuW },
        { name: 'Mainboard', w: moboW },
        { name: 'RAM (' + ram + ' Riegel)', w: ramW },
        { name: 'Speicher (' + storage + ' Laufwerke)', w: storageW },
        { name: 'L\u00FCfter (' + fans + ')', w: fansW },
        { name: 'K\u00FChlung', w: cooler },
        { name: 'RGB/LEDs', w: rgb }
      ];
      let html = '';
      for (const p of parts) {
        const pct = (p.w / totalW * 100).toFixed(0);
        html += '<div class="flex justify-between py-0.5 border-b border-border"><span>' + p.name + '</span><span>' + p.w + 'W (' + pct + '%)</span></div>';
      }
      html += '<div class="flex justify-between py-0.5 font-bold"><span>Gesamt</span><span>' + totalW + 'W</span></div>';
      document.getElementById('gpw-breakdown')!.innerHTML = html;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.gpw-in').forEach(el => { el.addEventListener('input', calcGPW); el.addEventListener('change', calcGPW); });
      calcGPW();
    }, 50);
  </script>
</CalculatorLayout>
