---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zoll-Rechner - Einfuhrzoelle & Gesamtkosten berechnen";
const description = "Berechnen Sie Einfuhrzoelle, Einfuhrumsatzsteuer und Gesamtkosten fuer internationale Sendungen. Schaetzen Sie Zollabgaben und Landekosten.";
const relatedCalcs = [
  { name: "Gewinnmargenrechner", url: "/de/gewinnmargenrechner", description: "Gewinnmargen." },
  { name: "ROI-Rechner", url: "/de/roi-rechner", description: "Kapitalrendite." },
  { name: "Waehrungsrechner", url: "/de/waehrungsrechner", description: "Waehrungen." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozente." },
  { name: "Break-Even-Rechner", url: "/de/break-even-rechner", description: "Gewinnschwelle." },
  { name: "Budgetrechner", url: "/de/budgetrechner", description: "Budget planen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Zoll-Rechner" keywords="Zoll Rechner, Einfuhrzoll, Zolltarif, Einfuhrumsatzsteuer, Landekosten, Zollgebuehren" breadcrumbs={[{ name: "Zoll-Rechner", url: "/de/zoll-rechner" }]} lang="de" enSlug="customs-duty-calculator">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zoll-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schaetzen Sie Einfuhrzoelle, Steuern und Gesamtkosten fuer internationale Sendungen.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div><label class="block text-xs font-medium text-text mb-1">Warenwert (EUR)</label><input type="number" id="zlr-value" class="zlr-in w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Versand-/Frachtkosten (EUR)</label><input type="number" id="zlr-freight" class="zlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Versicherungskosten (EUR)</label><input type="number" id="zlr-insurance" class="zlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Zollsatz (%)</label><input type="number" id="zlr-rate" class="zlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="0.1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Einfuhrumsatzsteuer / MwSt. (%)</label><input type="number" id="zlr-tax" class="zlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" max="100" step="0.1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Zollabfertigungsgebuehr (EUR)</label><input type="number" id="zlr-broker" class="zlr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="1"></div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Landekosten</div>
          <div class="text-5xl font-extrabold font-mono" id="zlr-result">--</div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">CIF-Wert</div><div class="text-xl font-bold font-mono" id="zlr-cif">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Einfuhrzoll</div><div class="text-xl font-bold font-mono" id="zlr-duty">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">EUSt-Betrag</div><div class="text-xl font-bold font-mono" id="zlr-taxamt">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gebuehren gesamt %</div><div class="text-xl font-bold font-mono" id="zlr-feepct">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="customs-duty" lang="de" /><FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Zoll und Einfuhrumsatzsteuer in Deutschland</h2>
      <p>Bei Einfuhren nach Deutschland fallen Zollabgaben auf den CIF-Wert (Warenwert + Fracht + Versicherung) an. Die Einfuhrumsatzsteuer (EUSt) von 19 % wird auf den Zollwert plus Zollbetrag berechnet. Fuer Sendungen unter 150 EUR Warenwert entfaellt oft der Zoll, die EUSt wird aber trotzdem erhoben.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Haeufig gestellte Fragen</h3>
      <ul>
        <li><strong>Ab welchem Wert faellt Zoll an?</strong> Ab 150 EUR Warenwert (seit Juli 2021 entfaellt die alte 22-EUR-Freigrenze fuer EUSt).</li>
        <li><strong>Wie hoch ist die Einfuhrumsatzsteuer?</strong> In Deutschland betraegt sie 19 % (ermaessigt 7 % fuer bestimmte Waren).</li>
      </ul>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcZLR() {
      const value = parseFloat((document.getElementById('zlr-value') as HTMLInputElement).value) || 0;
      const freight = parseFloat((document.getElementById('zlr-freight') as HTMLInputElement).value) || 0;
      const insurance = parseFloat((document.getElementById('zlr-insurance') as HTMLInputElement).value) || 0;
      const dutyRate = parseFloat((document.getElementById('zlr-rate') as HTMLInputElement).value) || 0;
      const taxRate = parseFloat((document.getElementById('zlr-tax') as HTMLInputElement).value) || 0;
      const broker = parseFloat((document.getElementById('zlr-broker') as HTMLInputElement).value) || 0;

      const cif = value + freight + insurance;
      const duty = cif * (dutyRate / 100);
      const taxableValue = cif + duty;
      const tax = taxableValue * (taxRate / 100);
      const totalLanded = cif + duty + tax + broker;
      const feePct = value > 0 ? ((totalLanded - value) / value) * 100 : 0;

      const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

      document.getElementById('zlr-result')!.textContent = fmt(totalLanded);
      document.getElementById('zlr-cif')!.textContent = fmt(cif);
      document.getElementById('zlr-duty')!.textContent = fmt(duty);
      document.getElementById('zlr-taxamt')!.textContent = fmt(tax);
      document.getElementById('zlr-feepct')!.textContent = feePct.toFixed(1).replace('.', ',') + ' %';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('zlr-value') as HTMLInputElement).value = '500';
      (document.getElementById('zlr-freight') as HTMLInputElement).value = '50';
      (document.getElementById('zlr-insurance') as HTMLInputElement).value = '5';
      (document.getElementById('zlr-rate') as HTMLInputElement).value = '5';
      (document.getElementById('zlr-tax') as HTMLInputElement).value = '19';
      (document.getElementById('zlr-broker') as HTMLInputElement).value = '30';
      document.querySelectorAll('.zlr-in').forEach(el => { el.addEventListener('input', calcZLR); el.addEventListener('change', calcZLR); });
      calcZLR();
    }, 50);
  </script>
</CalculatorLayout>
