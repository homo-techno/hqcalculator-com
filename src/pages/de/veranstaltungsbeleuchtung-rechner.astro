---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Veranstaltungsbeleuchtung-Rechner - Lichterketten, Uplights & Spots";
const description = "Berechnen Sie den Bedarf an Lichterketten, Uplights und Spotlights f\u00fcr Ihre Veranstaltungslocation basierend auf Raumgr\u00f6\u00dfe und gew\u00fcnschter Atmosph\u00e4re.";

const relatedCalcs = [
  { name: "Veranstaltungsbudget-Rechner", url: "/de/veranstaltungsbudget-rechner", description: "Eventbudget." },
  { name: "Veranstaltungspersonal-Rechner", url: "/de/veranstaltungspersonal-rechner", description: "Personalbedarf." },
  { name: "Veranstaltungszeitplan-Rechner", url: "/de/veranstaltungszeitplan-rechner", description: "Zeitplanung." },
  { name: "Veranstaltungsversicherung-Rechner", url: "/de/veranstaltungsversicherung-rechner", description: "Versicherung." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Veranstaltungsbeleuchtung-Rechner" lang="de" enSlug="event-lighting-calculator" keywords="veranstaltungsbeleuchtung, lichterketten, uplighting, hochzeitsbeleuchtung, eventbeleuchtung, dekobeleuchtung" breadcrumbs={[{ name: "Veranstaltungsbeleuchtung-Rechner", url: "/de/veranstaltungsbeleuchtung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Veranstaltungsbeleuchtung-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie die dekorative Beleuchtung f&uuml;r Ihre Veranstaltungslocation.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4 mb-6">
        <div><label class="block text-sm font-medium text-text mb-1">Rauml&auml;nge (m)</label><input type="number" id="vbl-length" class="vbl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="18" min="3" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Raumbreite (m)</label><input type="number" id="vbl-width" class="vbl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="3" step="1"></div>
        <div><label class="block text-sm font-medium text-text mb-1">Decken- / Zeltdachh&ouml;he (m)</label><input type="number" id="vbl-height" class="vbl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="4" min="2.5" max="12" step="0.5"></div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Beleuchtungsstil</label>
          <select id="vbl-style" class="vbl-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="romantic">Romantisch / warmes Licht</option>
            <option value="elegant">Elegant / dramatisch</option>
            <option value="festive">Festlich / Party</option>
            <option value="minimal">Minimal / dezent</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Lichterketten-Layout</label>
          <select id="vbl-strings" class="vbl-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="canopy">Voller Deckenhimmel</option>
            <option value="zigzag">Zickzack &uuml;ber die Decke</option>
            <option value="perimeter">Nur Rand</option>
            <option value="none">Keine Lichterketten</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-text mb-1">Wand-Uplighting</label>
          <select id="vbl-uplight" class="vbl-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="full" selected>Vollst&auml;ndiger Umfang</option>
            <option value="accent">Nur Akzentw&auml;nde</option>
            <option value="none">Keine</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium text-text mb-1">Spotlights (Tanzfl&auml;che, Torte, etc.)</label><input type="number" id="vbl-spots" class="vbl-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="3" min="0" max="10" step="1"></div>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Lichterketten ben&ouml;tigt</div>
        <div class="text-5xl font-extrabold" id="vbl-stringm">--</div>
        <div class="text-sm mt-1" id="vbl-strands">--</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Uplights</div><div class="text-xl font-bold" id="vbl-uplights">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Spotlights</div><div class="text-xl font-bold" id="vbl-spotcount">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Leistungsbedarf</div><div class="text-xl font-bold" id="vbl-power">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesch. Mietkosten</div><div class="text-xl font-bold" id="vbl-cost">--</div></div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4" id="vbl-details"></div>

      <ShareButton calculatorId="event-lighting-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Veranstaltungsbeleuchtung planen</h2>
      <p>Lichterketten schaffen eine warme Atmosph&auml;re. Uplights alle 2 Meter entlang der W&auml;nde erzeugen einen dramatischen Effekt. Spotlights betonen wichtige Bereiche wie Tanzfl&auml;che und Buffet.</p>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>LED oder traditionell?</strong> LED-Leuchten sind energieeffizienter, erzeugen weniger W&auml;rme und sind f&uuml;r Events empfehlenswert.</p>
      <p><strong>Wie viel Strom brauche ich?</strong> Planen Sie mindestens einen separaten Stromkreis f&uuml;r die Beleuchtung ein.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function calcVBL() {
      const length = parseInt((document.getElementById('vbl-length') as HTMLInputElement).value) || 18;
      const width = parseInt((document.getElementById('vbl-width') as HTMLInputElement).value) || 12;
      const height = parseInt((document.getElementById('vbl-height') as HTMLInputElement).value) || 4;
      const style = (document.getElementById('vbl-style') as HTMLSelectElement).value;
      const strings = (document.getElementById('vbl-strings') as HTMLSelectElement).value;
      const uplight = (document.getElementById('vbl-uplight') as HTMLSelectElement).value;
      const spots = parseInt((document.getElementById('vbl-spots') as HTMLInputElement).value) || 0;

      const perimeter = 2 * (length + width);
      const area = length * width;

      let stringM = 0;
      if (strings === 'canopy') {
        const rows = Math.ceil(width / 1);
        stringM = rows * length + perimeter;
      } else if (strings === 'zigzag') {
        const passes = Math.ceil(width / 2);
        stringM = passes * length * 1.2;
      } else if (strings === 'perimeter') {
        stringM = perimeter;
      }
      stringM = Math.ceil(stringM);

      const strandsNeeded = Math.ceil(stringM / 15);

      let uplightCount = 0;
      if (uplight === 'full') uplightCount = Math.ceil(perimeter / 2);
      else if (uplight === 'accent') uplightCount = Math.ceil(perimeter / 2 * 0.4);

      const stringWatts = stringM * 1.5;
      const uplightWatts = uplightCount * 15;
      const spotWatts = spots * 75;
      const totalWatts = Math.ceil(stringWatts + uplightWatts + spotWatts);
      const amps = Math.ceil(totalWatts / 230);

      const stringCost = strandsNeeded * 15;
      const uplightCost = uplightCount * 25;
      const spotCost = spots * 35;
      const totalCost = stringCost + uplightCost + spotCost;

      const fmt = (n: number) => Math.round(n).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('vbl-stringm')!.textContent = stringM > 0 ? stringM.toLocaleString('de-DE') + ' m' : 'Keine';
      document.getElementById('vbl-strands')!.textContent = stringM > 0 ? strandsNeeded + ' Ketten (\u00E0 15 m)' : 'Keine Lichterketten gew\u00E4hlt';
      document.getElementById('vbl-uplights')!.textContent = uplightCount > 0 ? uplightCount.toString() : 'Keine';
      document.getElementById('vbl-spotcount')!.textContent = spots.toString();
      document.getElementById('vbl-power')!.textContent = totalWatts + 'W / ' + amps + 'A';
      document.getElementById('vbl-cost')!.textContent = fmt(totalCost);

      let details = '<h3 class="font-semibold text-sm text-text mb-2">Beleuchtungsplan</h3><ul class="text-sm text-text-secondary space-y-1">';
      details += '<li>Raum: ' + length + ' x ' + width + ' m (' + area.toLocaleString('de-DE') + ' m\u00B2), ' + height + ' m Deckenh\u00F6he</li>';
      if (stringM > 0) details += '<li>Lichterketten: ' + stringM + ' m gesamt (' + strandsNeeded + ' Ketten)</li>';
      if (uplightCount > 0) details += '<li>Uplights: ' + uplightCount + ' St\u00FCck, ca. alle 2 m</li>';
      if (spots > 0) details += '<li>Spotlights: ' + spots + ' St\u00FCck</li>';
      details += '<li>Gesamtleistung: ' + totalWatts + 'W (' + amps + ' Ampere bei 230V)</li>';
      details += '<li>Stil: ' + style + '</li>';
      details += '</ul>';
      document.getElementById('vbl-details')!.innerHTML = details;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.vbl-in').forEach(el => { el.addEventListener('input', calcVBL); el.addEventListener('change', calcVBL); });
      calcVBL();
    }, 50);
  </script>
</CalculatorLayout>
