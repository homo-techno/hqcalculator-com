---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Keramikfaser-Rechner - Ofenisolierung fuer Brennoefen";
const description = "Berechnen Sie Keramikfaser-Isolierung fuer den Ofenbau: R-Wert, benoetigte Dicke und Materialmenge fuer Brennoefen.";
const relatedCalcs = [
  { name: "Keramikform-Rechner", url: "/de/keramikform-rechner", description: "Gipsformen berechnen." },
  { name: "Keramikanalyse-Rechner", url: "/de/keramikanalyse-rechner", description: "Scherbenanalyse." },
  { name: "Fliesengewicht-Rechner", url: "/de/fliesengewicht-rechner", description: "Fliesengewicht." },
  { name: "Kaelteanlage-Rechner", url: "/de/kaelteanlage-rechner", description: "Kaelteanlagen." },
  { name: "Kreis-Rechner", url: "/de/kreis-rechner", description: "Kreisberechnungen." },
  { name: "Zentripetalkraft-Rechner", url: "/de/zentripetalkraft-rechner", description: "Kreisbewegung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Keramikfaser-Rechner" enSlug="ceramic-fiber-calculator" keywords="Keramikfaser, Ofenisolierung, Fasermatte, Faserplatte, Ofenbau, Feuerfest-Isolierung, R-Wert" breadcrumbs={[{ name: "Keramikfaser-Rechner", url: "/de/keramikfaser-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Keramikfaser-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie den Keramikfaser-Isolierungsbedarf fuer Ihren Brennofen. Ermitteln Sie Dicke, Menge und thermische Leistung.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Ofentyp</label>
        <select id="kf-kiln" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="box" selected>Kastenform / Toplader</option>
          <option value="car">Wagenofen / Frontlader</option>
          <option value="raku">Raku-Ofen (Haubenform)</option>
          <option value="custom">Individuelle Masse</option>
        </select>
      </div>
      <h3 class="font-semibold text-text mb-3">Innenmasse</h3>
      <div class="grid grid-cols-3 gap-3 mb-5">
        <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="kf-w" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="15" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Tiefe (cm)</label><input type="number" id="kf-d" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="15" step="1"></div>
        <div><label class="block text-xs font-medium text-text mb-1">Hoehe (cm)</label><input type="number" id="kf-h" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="60" min="15" step="1"></div>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Maximaltemperatur</label>
        <select id="kf-temp" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="1000">1000°C (Niedrigbrand)</option>
          <option value="1260" selected>1260°C (Mittel-/Hochbrand)</option>
          <option value="1430">1430°C (Hochbrand+)</option>
        </select>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Isolierungsprodukt</label>
        <select id="kf-product" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="blanket8" selected>Keramikfasermatte (128 kg/m³)</option>
          <option value="blanket6">Keramikfasermatte (96 kg/m³)</option>
          <option value="board">Keramikfaserplatte</option>
          <option value="combo">Matte + Schamottestein (Kombi)</option>
        </select>
      </div>
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Gewuenschte Wandstaerke (cm)</label>
        <input type="number" id="kf-thick" class="kf-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="15" min="5" max="30" step="1">
        <p class="text-xs text-text-muted mt-1">Typisch: 10-15 cm fuer mittlere Temperaturen, 15-23 cm fuer Hochbrand</p>
      </div>
      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Isolierung benoetigt</div>
        <div class="text-4xl font-extrabold" id="kf-total">--</div>
        <div class="text-sm text-blue-200 mt-1">Quadratmeter Material</div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wandflaeche</div><div class="text-xl font-bold" id="kf-wall-area">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Decke/Boden</div><div class="text-xl font-bold" id="kf-top-area">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Anzahl Lagen</div><div class="text-xl font-bold" id="kf-layers">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">R-Wert (gesch.)</div><div class="text-xl font-bold" id="kf-rvalue">--</div></div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Aussentemp. (gesch.)</div><div class="text-xl font-bold" id="kf-outer">--</div></div>
        <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtgewicht (gesch.)</div><div class="text-xl font-bold" id="kf-weight">--</div></div>
      </div>
      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <h3 class="font-semibold text-sm text-text mb-2">Hinweise</h3>
        <p class="text-xs text-text-muted" id="kf-notes">--</p>
      </div>
      <ShareButton lang="de" calculatorId="keramikfaser" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Keramikfaser-Ofenisolierung</h2>
      <p>Keramikfaser (Aluminiumsilikat-Faser) ist eine hervorragende leichte Isolierung fuer Brennoefen. Sie heizt schnell auf, hat geringe Waermespeicherung und exzellente Isoliereigenschaften.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Isolierungsrichtlinien</h3>
      <ul>
        <li><strong>128 kg/m³ Matte:</strong> Am besten fuer die Innenseite (Heissseite), haltbarer</li>
        <li><strong>96 kg/m³ Matte:</strong> Gut fuer aeussere Lagen, leichter</li>
        <li><strong>Faserplatte:</strong> Starr, gut fuer tragende Waende und Tueren</li>
        <li>Verwenden Sie Versteifer auf der Heissseite, um Faserfreisetzung zu reduzieren</li>
        <li>Tragen Sie beim Umgang mit Keramikfaser stets Atemschutz</li>
      </ul>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKF() {
      const kilnType = (document.getElementById('kf-kiln') as HTMLSelectElement).value;
      const w = parseFloat((document.getElementById('kf-w') as HTMLInputElement).value) || 60;
      const d = parseFloat((document.getElementById('kf-d') as HTMLInputElement).value) || 60;
      const h = parseFloat((document.getElementById('kf-h') as HTMLInputElement).value) || 60;
      const maxTemp = parseInt((document.getElementById('kf-temp') as HTMLSelectElement).value) || 1260;
      const product = (document.getElementById('kf-product') as HTMLSelectElement).value;
      const wallThick = parseFloat((document.getElementById('kf-thick') as HTMLInputElement).value) || 15;
      // Surface areas in cm², convert to m²
      const wallArea = 2 * (w + d) * h;
      const topArea = w * d;
      const bottomArea = w * d;
      const totalInteriorCm2 = wallArea + topArea + bottomArea;
      const totalInteriorM2 = totalInteriorCm2 / 10000;
      // Layers (assuming 2.5cm per layer)
      const layerThick = 2.5;
      const numLayers = Math.ceil(wallThick / layerThick);
      let totalM2 = 0;
      for (let i = 0; i < numLayers; i++) {
        const expand = 1 + (i * 0.03);
        totalM2 += totalInteriorM2 * expand;
      }
      // Thermal conductivity
      const kValues: Record<string, number> = { blanket8: 0.22, blanket6: 0.26, board: 0.17, combo: 0.20 };
      const k = kValues[product] || 0.22;
      const rValue = (wallThick / 100) / k;
      // Outer temp estimate
      const ambientTemp = 20;
      const outerTemp = ambientTemp + (maxTemp - ambientTemp) / (1 + rValue * 8);
      // Weight
      const densities: Record<string, number> = { blanket8: 128, blanket6: 96, board: 256, combo: 160 };
      const density = densities[product] || 128;
      const totalVolM3 = (totalInteriorM2 * wallThick / 100);
      const totalWeight = totalVolM3 * density;
      document.getElementById('kf-total')!.textContent = totalM2.toFixed(1) + ' m\u00B2';
      document.getElementById('kf-wall-area')!.textContent = (wallArea / 10000).toFixed(2) + ' m\u00B2';
      document.getElementById('kf-top-area')!.textContent = ((topArea + bottomArea) / 10000).toFixed(2) + ' m\u00B2';
      document.getElementById('kf-layers')!.textContent = numLayers + ' x ' + layerThick + ' cm';
      document.getElementById('kf-rvalue')!.textContent = 'R-' + rValue.toFixed(2);
      document.getElementById('kf-outer')!.textContent = '~' + Math.round(outerTemp) + '\u00B0C';
      document.getElementById('kf-weight')!.textContent = Math.round(totalWeight) + ' kg';
      const notes = [];
      if (outerTemp > 90) notes.push('Aussenwand wird sehr heiss (' + Math.round(outerTemp) + '\u00B0C). Erwaegen Sie mehr Isolierung oder ein belueftetes Aussengehaeuse.');
      if (outerTemp <= 90) notes.push('Gute Isolierung - Aussenwand sollte unter 90\u00B0C bleiben.');
      if (maxTemp > 1260 && product !== 'blanket8' && product !== 'board') notes.push('Verwenden Sie 128 kg/m\u00B3 Matte oder Platte fuer Hochtemperaturanwendungen.');
      notes.push('Standard-Keramikfasermatten sind 61 cm breit x 7,6 m lang x 2,5 cm dick.');
      document.getElementById('kf-notes')!.textContent = notes.join(' ');
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kf-in').forEach(el => { el.addEventListener('input', calcKF); el.addEventListener('change', calcKF); });
      calcKF();
    }, 50);
  </script>
</CalculatorLayout>
