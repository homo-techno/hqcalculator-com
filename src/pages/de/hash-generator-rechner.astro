---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Hash-Generator-Rechner - Text-Hash &amp; Entropie";
const description = "Generieren Sie einen simulierten Hash aus Texteingaben. Zeigt Hash-Digest, Zeichenanzahl und Shannon-Entropie-Sch&auml;tzung.";

const relatedCalcs = [
  { name: "Base64-Rechner", url: "/de/base64-rechner", description: "Base64 kodieren/dekodieren." },
  { name: "JSON-Formatierer", url: "/de/json-formatierer-rechner", description: "JSON formatieren/validieren." },
  { name: "Bin&auml;r-zu-Text", url: "/de/binaer-zu-text-rechner", description: "Bin&auml;r/Text-Konverter." },
  { name: "Hex-zu-RGB", url: "/de/hex-zu-rgb-rechner", description: "Hex-Farb-Konverter." },
  { name: "Hex-Rechner", url: "/de/hex-rechner", description: "Hexadezimal-Arithmetik." },
];
---

<CalculatorLayout
  title={title}
  description={description}
  calculatorName="Hash-Generator-Rechner"
  keywords="hash generator rechner, text hash, entropie rechner, hash digest, zeichenanzahl, shannon entropie"
  breadcrumbs={[{ name: "Hash-Generator-Rechner", url: "/de/hash-generator-rechner" }]}
  lang="de"
  enSlug="hash-generator-calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Hash-Generator-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Text eingeben und simulierten Hash-Digest mit Entropie- und Zeichenanalyse generieren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text mb-1">Eingabetext</label>
          <textarea id="hgde-input" class="hgde-in w-full px-4 py-3 border border-border rounded-xl text-lg font-mono" rows="3" placeholder="Text zum Hashen eingeben...">Hallo, Welt!</textarea>
        </div>

        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Simulierter Hash (32 Hex-Zeichen)</div>
          <div class="text-xl font-extrabold font-mono break-all" id="hgde-result">&mdash;</div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Zeichenanzahl</div>
            <div class="text-xl font-bold" id="hgde-chars">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Bytegr&ouml;&szlig;e</div>
            <div class="text-xl font-bold" id="hgde-bytes">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Shannon-Entropie</div>
            <div class="text-xl font-bold" id="hgde-entropy">0</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Einmalige Zeichen</div>
            <div class="text-xl font-bold" id="hgde-unique">0</div>
          </div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Weitere Hashes</h3>
          <div class="text-sm text-text-secondary font-mono whitespace-pre-wrap" id="hgde-extra"></div>
        </div>

        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Entropie-Analyse</h3>
          <div class="text-sm text-text-secondary" id="hgde-analysis"></div>
        </div>
      </div>

      <ShareButton calculatorId="hash-generator-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">&Uuml;ber Hash-Funktionen</h2>
      <p>Eine Hash-Funktion bildet Daten beliebiger Gr&ouml;&szlig;e auf einen Wert fester Gr&ouml;&szlig;e ab. Dieser Rechner verwendet eine deterministische JavaScript-basierte Hash-Simulation. F&uuml;r produktive Sicherheitsanwendungen immer Standard-Kryptobibliotheken verwenden.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Shannon-Entropie</h3>
      <p>Die Shannon-Entropie misst den durchschnittlichen Informationsgehalt pro Zeichen: H = -&Sigma; p(x) log2(p(x)). H&ouml;here Entropie bedeutet mehr Zuf&auml;lligkeit.</p>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein Hash?</strong> Ein Hash ist ein Fingerabdruck einer Datenmenge &ndash; eine Funktion, die beliebig gro&szlig;e Eingaben auf eine Ausgabe fester L&auml;nge abbildet. Gleiche Eingaben erzeugen immer denselben Hash (deterministisch), unterschiedliche Eingaben sollten verschiedene Hashes erzeugen.</p>
      <p><strong>Wozu dient die Shannon-Entropie?</strong> Die Shannon-Entropie gibt an, wie viel Information pro Zeichen in einem Text steckt. Ein Text mit hoher Entropie ist schwerer vorherzusagen und eignet sich besser als Grundlage f&uuml;r sichere Hashes.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    function simHashDE(str: string, seed: number = 0): string {
      let h1 = 0xdeadbeef ^ seed, h2 = 0x41c6ce57 ^ seed;
      let h3 = 0x9e3779b9 ^ seed, h4 = 0x85ebca6b ^ seed;
      for (let i = 0; i < str.length; i++) {
        const ch = str.charCodeAt(i);
        h1 = Math.imul(h1 ^ ch, 2654435761);
        h2 = Math.imul(h2 ^ ch, 1597334677);
        h3 = Math.imul(h3 ^ ch, 2246822519);
        h4 = Math.imul(h4 ^ ch, 3266489917);
      }
      h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
      h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
      h3 = Math.imul(h3 ^ (h3 >>> 16), 2246822507) ^ Math.imul(h4 ^ (h4 >>> 13), 3266489909);
      h4 = Math.imul(h4 ^ (h4 >>> 16), 2246822507) ^ Math.imul(h3 ^ (h3 >>> 13), 3266489909);
      return (
        (h1 >>> 0).toString(16).padStart(8, '0') +
        (h2 >>> 0).toString(16).padStart(8, '0') +
        (h3 >>> 0).toString(16).padStart(8, '0') +
        (h4 >>> 0).toString(16).padStart(8, '0')
      );
    }

    function calcHGDE() {
      const input = (document.getElementById('hgde-input') as HTMLTextAreaElement).value;

      if (!input) {
        document.getElementById('hgde-result')!.textContent = '\u2014';
        document.getElementById('hgde-chars')!.textContent = '0';
        document.getElementById('hgde-bytes')!.textContent = '0';
        document.getElementById('hgde-entropy')!.textContent = '0';
        document.getElementById('hgde-unique')!.textContent = '0';
        document.getElementById('hgde-extra')!.textContent = '';
        document.getElementById('hgde-analysis')!.textContent = '';
        document.dispatchEvent(new CustomEvent('calc-update'));
        return;
      }

      const hash32 = simHashDE(input, 0);
      const hash64 = simHashDE(input, 0) + simHashDE(input, 1);

      const freq: Record<string, number> = {};
      for (const ch of input) {
        freq[ch] = (freq[ch] || 0) + 1;
      }
      const len = input.length;
      let entropy = 0;
      for (const ch in freq) {
        const p = freq[ch] / len;
        if (p > 0) entropy -= p * Math.log2(p);
      }

      const uniqueChars = Object.keys(freq).length;
      const byteSize = new Blob([input]).size;
      const fmtNum = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 4, maximumFractionDigits: 4 });

      document.getElementById('hgde-result')!.textContent = hash32;
      document.getElementById('hgde-chars')!.textContent = String(len);
      document.getElementById('hgde-bytes')!.textContent = String(byteSize);
      document.getElementById('hgde-entropy')!.textContent = fmtNum(entropy) + ' Bits/Zeichen';
      document.getElementById('hgde-unique')!.textContent = String(uniqueChars);

      let extra = '32-Zeichen-Hash:  ' + hash32 + '\n';
      extra += '64-Zeichen-Hash:  ' + hash64 + '\n';
      extra += 'CRC-&auml;hnlich:      ' + simHashDE(input, 42).substring(0, 8).toUpperCase();
      document.getElementById('hgde-extra')!.textContent = extra;

      const maxEntropy = Math.log2(uniqueChars || 1);
      const ratio = maxEntropy > 0 ? (entropy / maxEntropy * 100) : 0;
      let quality = '';
      if (entropy < 2) quality = 'Sehr niedrige Entropie \u2013 leicht vorhersagbar.';
      else if (entropy < 3) quality = 'Niedrige Entropie \u2013 etwas vorhersagbar.';
      else if (entropy < 4) quality = 'Mittlere Entropie \u2013 gute Zuf\u00E4lligkeit.';
      else quality = 'Hohe Entropie \u2013 sehr gute Zuf\u00E4lligkeit.';

      document.getElementById('hgde-analysis')!.textContent =
        'Entropie: ' + fmtNum(entropy) + ' Bits/Zeichen von max. ' + fmtNum(maxEntropy) + ' (' + ratio.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + '% des theoretischen Maximums). ' + quality + ' Gesamtinformation: ' + fmtNum(entropy * len) + ' Bits.';

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.hgde-in').forEach(el => {
        el.addEventListener('input', calcHGDE);
        el.addEventListener('change', calcHGDE);
      });
      calcHGDE();
    }, 50);
  </script>
</CalculatorLayout>
