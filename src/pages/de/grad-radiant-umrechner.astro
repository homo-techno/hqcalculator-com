---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Grad-Radiant-Umrechner - Winkelumrechnung";
const description = "Rechnen Sie zwischen Grad, Radiant und Gon um. Inklusive trigonometrischer Werte fuer den Winkel.";

const relatedCalcs = [
  { name: "Dreiecksrechner", url: "/de/dreiecks-rechner", description: "Dreiecke." },
  { name: "Kreisrechner", url: "/de/kreis-rechner", description: "Kreise." },
  { name: "Steigungsrechner", url: "/de/steigungs-rechner", description: "Steigung." },
  { name: "Fl\u00e4chenrechner", url: "/de/flaechen-rechner", description: "2D-Fl\u00e4chen." },
];
---

<CalculatorLayout title={title} description={description} lang="de" enSlug="degrees-radians-converter" calculatorName="Grad-Radiant-Umrechner" keywords="grad in radiant, radiant in grad, winkelumrechner, gon, trigonometrie" breadcrumbs={[{ name: "Grad-Radiant-Umrechner", url: "/de/grad-radiant-umrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Grad &harr; Radiant Umrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie Winkel zwischen Grad, Radiant und Gon um.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wert</label><input type="number" id="gru-val" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold" value="180" step="0.1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Einheit</label><select id="gru-unit" class="w-full px-4 py-3 border border-border rounded-xl text-lg"><option value="deg" selected>Grad (&deg;)</option><option value="rad">Radiant</option><option value="grad">Gon</option><option value="turn">Umdrehungen</option></select></div>
        </div>
        <div class="flex gap-2 flex-wrap">
          <button class="gru-pre px-3 py-1 rounded-lg text-sm font-mono border border-border hover:bg-blue-50" data-val="30">30&deg;</button>
          <button class="gru-pre px-3 py-1 rounded-lg text-sm font-mono border border-border hover:bg-blue-50" data-val="45">45&deg;</button>
          <button class="gru-pre px-3 py-1 rounded-lg text-sm font-mono border border-border hover:bg-blue-50" data-val="60">60&deg;</button>
          <button class="gru-pre px-3 py-1 rounded-lg text-sm font-mono border border-border hover:bg-blue-50" data-val="90">90&deg;</button>
          <button class="gru-pre px-3 py-1 rounded-lg text-sm font-mono border border-border hover:bg-blue-50" data-val="180">180&deg;</button>
          <button class="gru-pre px-3 py-1 rounded-lg text-sm font-mono border border-border hover:bg-blue-50" data-val="270">270&deg;</button>
          <button class="gru-pre px-3 py-1 rounded-lg text-sm font-mono border border-border hover:bg-blue-50" data-val="360">360&deg;</button>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-5 bg-primary rounded-2xl text-white text-center"><div class="text-xs uppercase tracking-wide mb-1 opacity-80">Grad</div><div class="text-2xl font-extrabold font-mono" id="gru-deg">0&deg;</div></div>
          <div class="p-5 bg-secondary rounded-2xl text-white text-center"><div class="text-xs uppercase tracking-wide mb-1 opacity-80">Radiant</div><div class="text-2xl font-extrabold font-mono" id="gru-rad">0</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gon</div><div class="text-xl font-bold font-mono" id="gru-grad">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Umdrehungen</div><div class="text-xl font-bold font-mono" id="gru-turn">0</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">Trigonometrische Werte</h3>
          <div class="grid grid-cols-3 gap-3 text-center">
            <div><div class="text-xs text-text-muted">sin</div><div class="font-bold font-mono" id="gru-sin">0</div></div>
            <div><div class="text-xs text-text-muted">cos</div><div class="font-bold font-mono" id="gru-cos">0</div></div>
            <div><div class="text-xs text-text-muted">tan</div><div class="font-bold font-mono" id="gru-tan">0</div></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="degrees-radians" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Winkeleinheiten erkl&auml;rt</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>Radiant</strong> = Grad &times; &pi; / 180</p>
        <p><strong>Grad</strong> = Radiant &times; 180 / &pi;</p>
        <p><strong>Gon</strong> = Grad &times; 10 / 9</p>
      </div>

      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein Radiant?</strong> Ein Radiant ist der Winkel, bei dem der Kreisbogen gleich dem Radius ist. Ein Vollkreis hat 2&pi; Radiant.</p>
      <p><strong>Wof&uuml;r werden Gon verwendet?</strong> Gon (auch Neugrad) werden haupts&auml;chlich in der Vermessung und Geod&auml;sie verwendet. Ein rechter Winkel entspricht 100 Gon.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcGRU() {
      const val = parseFloat((document.getElementById('gru-val') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('gru-unit') as HTMLSelectElement).value;
      let deg: number;
      if (unit === 'deg') deg = val;
      else if (unit === 'rad') deg = val * 180 / Math.PI;
      else if (unit === 'grad') deg = val * 0.9;
      else deg = val * 360;
      const rad = deg * Math.PI / 180;
      document.getElementById('gru-deg')!.textContent = deg.toFixed(4) + '\u00b0';
      document.getElementById('gru-rad')!.textContent = rad.toFixed(6);
      document.getElementById('gru-grad')!.textContent = (deg / 0.9).toFixed(4);
      document.getElementById('gru-turn')!.textContent = (deg / 360).toFixed(6);
      document.getElementById('gru-sin')!.textContent = Math.sin(rad).toFixed(6);
      document.getElementById('gru-cos')!.textContent = Math.cos(rad).toFixed(6);
      const tanVal = Math.tan(rad);
      document.getElementById('gru-tan')!.textContent = Math.abs(tanVal) > 1e10 ? 'Undefiniert' : tanVal.toFixed(6);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.getElementById('gru-val')!.addEventListener('input', calcGRU);
      document.getElementById('gru-unit')!.addEventListener('change', calcGRU);
      document.querySelectorAll('.gru-pre').forEach(b => b.addEventListener('click', () => {
        (document.getElementById('gru-val') as HTMLInputElement).value = (b as HTMLElement).dataset.val!;
        (document.getElementById('gru-unit') as HTMLSelectElement).value = 'deg';
        calcGRU();
      }));
      calcGRU();
    }, 50);
  </script>
</CalculatorLayout>
