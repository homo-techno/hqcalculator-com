---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Rechner - Volumen, Gewicht & Fische";
const description = "Berechnen Sie Aquariumvolumen, Wassergewicht, Heizergröße und Fischbesatzkapazität.";
const relatedCalcs = [
  { name: "Poolvolumen", url: "/de/poolvolumen-rechner", description: "Pool." },
  { name: "Volumenrechner", url: "/de/volumenrechner", description: "Volumen." },
  { name: "Gewichtsumrechner", url: "/de/gewichtsumrechner", description: "Gewicht." },
  { name: "Dichterechner", url: "/de/dichterechner", description: "Dichte." },
  { name: "Temperaturumrechner", url: "/de/temperaturumrechner", description: "Temperatur." },
  { name: "Tierfutter", url: "/de/tierfutter-rechner", description: "Tierfutter." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquarium-Rechner" keywords="Aquarium-Rechner, Aquarium-Volumen, Aquarium-Liter, Fischbesatz, Aquarium-Heizer" breadcrumbs={[{ name: "Aquarium", url: "/de/aquarium-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Beckenvolumen, Gewicht und Besatzkapazität.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Länge (cm)</label><input type="number" id="aq-l" class="aq2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="120" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Breite (cm)</label><input type="number" id="aq-w" class="aq2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="30" min="0" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Höhe (cm)</label><input type="number" id="aq-h" class="aq2-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="45" min="0" step="1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Beckenvolumen</div>
          <div class="text-5xl font-extrabold font-mono" id="aq-result">0 L</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gallonen</div><div class="text-xl font-bold font-mono" id="aq-liters">0</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wassergewicht</div><div class="text-xl font-bold font-mono" id="aq-weight">0 kg</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Heizer-Watt</div><div class="text-xl font-bold font-mono" id="aq-heater">0 W</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fischkapazität (1cm/L)</div><div class="text-xl font-bold font-mono" id="aq-fish">0 cm</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kies (kg, 2,5cm)</div><div class="text-xl font-bold font-mono" id="aq-gravel">0 kg</div></div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquarium" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAQ2() {
      const l = parseFloat((document.getElementById('aq-l') as HTMLInputElement).value) || 0;
      const w = parseFloat((document.getElementById('aq-w') as HTMLInputElement).value) || 0;
      const h = parseFloat((document.getElementById('aq-h') as HTMLInputElement).value) || 0;
      const cubicCm = l * w * h;
      const liters = cubicCm / 1000;
      const gallons = liters / 3.785;
      const weightKg = liters;
      const heater = Math.ceil(liters * 1.3);
      const fishCm = Math.floor(liters);
      const gravelKg = Math.round(l * w / 10000 * 2.5 * 1.5 * 10) / 10;
      document.getElementById('aq-result')!.textContent = liters.toFixed(1).replace('.', ',') + ' L';
      document.getElementById('aq-liters')!.textContent = gallons.toFixed(1).replace('.', ',');
      document.getElementById('aq-weight')!.textContent = weightKg.toFixed(0) + ' kg';
      document.getElementById('aq-heater')!.textContent = heater + ' W';
      document.getElementById('aq-fish')!.textContent = fishCm + ' cm';
      document.getElementById('aq-gravel')!.textContent = gravelKg + ' kg';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.aq2-in').forEach(el => { el.addEventListener('input', calcAQ2); el.addEventListener('change', calcAQ2); });
      calcAQ2();
    }, 50);
  </script>
</CalculatorLayout>
