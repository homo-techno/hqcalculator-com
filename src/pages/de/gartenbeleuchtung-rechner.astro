---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Gartenbeleuchtung Rechner";
const description = "Planen Sie Gartenbeleuchtung und berechnen Sie Lichtbedarf und Stromkosten.";

const relatedCalcs = [
  { name: "LED-Einsparrechner", url: "/de/led-ersparnis-rechner", description: "LED-Einsparungen berechnen." },
  { name: "LED-Widerstand Rechner", url: "/de/led-widerstand-rechner", description: "Vorwiderstand berechnen." },
  { name: "Rasenrechner", url: "/de/rasen-rechner", description: "Rasenbedarf berechnen." },
  { name: "Koi-Teich Rechner", url: "/de/koi-teich-rechner", description: "Teich planen." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="Gartenbeleuchtung Rechner" lang="de" enSlug="landscape-lighting-calculator" keywords="gartenbeleuchtung rechner, außenbeleuchtung stromkosten, lichtbedarf garten, led garten" breadcrumbs={[{ name: "Gartenbeleuchtung Rechner", url: "/de/gartenbeleuchtung-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Gartenbeleuchtung Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Planen Sie Ihre Gartenbeleuchtung und berechnen Sie Lichtbedarf, Anzahl der Leuchten und jährliche Stromkosten.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Gartenfläche (m²)</label><input type="number" id="gbr-area" class="gbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="150" min="1" step="10"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Beleuchtungszweck</label><select id="gbr-purpose" class="gbr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="30">Stimmungslicht (30 lx)</option>
            <option value="75" selected>Wegebeleuchtung (75 lx)</option>
            <option value="150">Sicherheitslicht (150 lx)</option>
            <option value="300">Sportfläche (300 lx)</option>
          </select></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Leuchtentyp</label><select id="gbr-lamp" class="gbr-in w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="800">LED-Strahler 10 W (800 lm)</option>
            <option value="1600" selected>LED-Strahler 20 W (1.600 lm)</option>
            <option value="3200">LED-Fluter 40 W (3.200 lm)</option>
            <option value="5000">LED-Fluter 60 W (5.000 lm)</option>
          </select></div>
          <div><label class="block text-xs font-medium text-text mb-1">Leuchten-Watt (W)</label><input type="number" id="gbr-watt" class="gbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="20" min="1" step="1"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Betriebsstunden/Tag</label><input type="number" id="gbr-hours" class="gbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="6" min="0.5" max="24" step="0.5"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Strompreis (€/kWh)</label><input type="number" id="gbr-price" class="gbr-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="0.32" min="0.01" step="0.01"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Benötigte Leuchten</div>
          <div class="text-4xl font-extrabold font-mono" id="gbr-lamps">0</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gesamtleistung</div><div class="text-xl font-bold" id="gbr-totalw">0 W</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Monat</div><div class="text-xl font-bold" id="gbr-monthly">0 €</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten/Jahr</div><div class="text-xl font-bold" id="gbr-annual">0 €</div></div>
        </div>
      </div>
      <ShareButton calculatorId="landscape-lighting-de" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Gartenbeleuchtung planen und Kosten senken</h2>
      <p>Eine gut geplante Gartenbeleuchtung erhöht nicht nur die Sicherheit, sondern schafft auch attraktive Stimmung. LED-Leuchten sind heute die erste Wahl: Sie verbrauchen bis zu 80 % weniger Strom als Halogen-Alternativen und halten deutlich länger. Bei der Planung ist die benötigte Beleuchtungsstärke (Lux) entscheidend: Wege benötigen ca. 50–100 lx, Sicherheitsbereiche 150–300 lx, Stimmungsbeleuchtung für Beete und Teiche genügen 20–50 lx.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welche Schutzklasse brauche ich für Außenleuchten?</strong> Für den Außenbereich benötigen Leuchten mindestens IP44 (spritzwassergeschützt), für bodennahe Bereiche oder Teichumgebungen IP65 oder höher.</p>
      <p><strong>Was ist der Unterschied zwischen Lumen und Lux?</strong> Lumen (lm) ist der Lichtstrom einer Leuchte, Lux (lx) ist die Beleuchtungsstärke auf einer Fläche. 1 lx = 1 lm/m².</p>
      <p><strong>Lohnt sich Solar-Gartenbeleuchtung?</strong> Solarbetriebene Leuchten sind günstig in der Installation, aber oft weniger zuverlässig bei schlechtem Wetter. Für dauerhaft helle Beleuchtung empfiehlt sich Netzstrom.</p>
      <p><strong>Wie verlege ich Kabel im Garten?</strong> Erdkabel müssen mindestens 60 cm tief (unter Wegen 80 cm) verlegt werden und in einem Leerrohr gesichert sein. Installationen über 230 V müssen von einem Elektriker durchgeführt werden.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    const gbrFmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';
    function calcGBR() {
      const area = parseFloat((document.getElementById('gbr-area') as HTMLInputElement).value) || 0;
      const lux = parseFloat((document.getElementById('gbr-purpose') as HTMLSelectElement).value) || 75;
      const lumen = parseFloat((document.getElementById('gbr-lamp') as HTMLSelectElement).value) || 1600;
      const watt = parseFloat((document.getElementById('gbr-watt') as HTMLInputElement).value) || 20;
      const hours = parseFloat((document.getElementById('gbr-hours') as HTMLInputElement).value) || 6;
      const price = parseFloat((document.getElementById('gbr-price') as HTMLInputElement).value) || 0.32;
      const totalLumen = area * lux * 1.5;
      const lamps = Math.ceil(totalLumen / lumen);
      const totalW = lamps * watt;
      const kwhPerDay = totalW / 1000 * hours;
      const monthly = kwhPerDay * 30 * price;
      const annual = kwhPerDay * 365 * price;
      document.getElementById('gbr-lamps')!.textContent = lamps.toLocaleString('de-DE');
      document.getElementById('gbr-totalw')!.textContent = totalW.toLocaleString('de-DE') + ' W';
      document.getElementById('gbr-monthly')!.textContent = gbrFmt(monthly);
      document.getElementById('gbr-annual')!.textContent = gbrFmt(annual);
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => { document.querySelectorAll('.gbr-in').forEach(el => { el.addEventListener('input', calcGBR); el.addEventListener('change', calcGBR); }); calcGBR(); }, 50);
  </script>
</CalculatorLayout>
