---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Kochumrechner - Küchenmaße umrechnen";
const description = "Rechnen Sie zwischen Tassen, Esslöffeln, Teelöffeln, Unzen, Millilitern und mehr um. Skalieren Sie Rezepte sofort hoch oder runter.";
const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Tägliche Kalorien." },
  { name: "Temperaturumrechner", url: "/de/temperaturumrechner", description: "Temperaturen." },
  { name: "Einheitenumrechner", url: "/de/einheitenumrechner", description: "Einheiten." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Kochumrechner" enSlug="cooking-converter" keywords="Kochumrechner, Küchenmaße, Esslöffel Tasse, Milliliter Tasse, Rezeptumrechner, Küchenmaße Tabelle" breadcrumbs={[{ name: "Kochumrechner", url: "/de/kochumrechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Kochumrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Küchenmaße umrechnen und Rezepte sofort skalieren.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <h3 class="font-semibold text-text mb-3">Volumen-Umrechner</h3>
      <div class="flex items-end gap-3 mb-4">
        <div class="flex-1">
          <label class="block text-xs font-medium text-text mb-1">Menge</label>
          <input type="number" id="ck-val" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="250" step="any" min="0">
        </div>
        <div class="flex-1">
          <label class="block text-xs font-medium text-text mb-1">Von</label>
          <select id="ck-from" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="ml" selected>Milliliter</option>
            <option value="L">Liter</option>
            <option value="cup">Cups (US)</option>
            <option value="tbsp">Esslöffel</option>
            <option value="tsp">Teelöffel</option>
            <option value="floz">Fluid Ounces</option>
            <option value="pint">Pints</option>
            <option value="quart">Quarts</option>
            <option value="gallon">Gallonen</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3 mb-6" id="ck-results"></div>

      <div class="flex flex-wrap gap-2 mb-6">
        <button class="ck-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold" data-v="100" data-u="ml">100 ml</button>
        <button class="ck-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold" data-v="250" data-u="ml">250 ml</button>
        <button class="ck-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold" data-v="500" data-u="ml">500 ml</button>
        <button class="ck-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold" data-v="1" data-u="L">1 Liter</button>
        <button class="ck-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold" data-v="1" data-u="cup">1 Cup</button>
        <button class="ck-quick px-3 py-1 text-xs rounded-full border border-border hover:bg-surface-alt font-semibold" data-v="1" data-u="tbsp">1 EL</button>
      </div>

      <h3 class="font-semibold text-text mb-3">Ofentemperatur</h3>
      <div class="flex items-end gap-3 mb-4">
        <div class="flex-1">
          <input type="number" id="ck-temp" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="180" step="5" min="0">
        </div>
        <div class="flex-1">
          <select id="ck-temp-unit" class="w-full px-4 py-3 border border-border rounded-xl text-lg">
            <option value="c" selected>°C</option>
            <option value="f">°F</option>
            <option value="gas">Gasstufe</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 mb-6">
        <div class="p-3 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted">°C</div>
          <div class="text-xl font-bold" id="ck-c">180</div>
        </div>
        <div class="p-3 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted">°F</div>
          <div class="text-xl font-bold" id="ck-f">356</div>
        </div>
        <div class="p-3 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted">Gasstufe</div>
          <div class="text-xl font-bold" id="ck-gas">4</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <h3 class="font-semibold text-sm text-text mb-2">Kurzreferenz</h3>
        <div class="grid grid-cols-2 gap-1 text-xs">
          <div class="flex justify-between p-1"><span>1 Cup (US)</span><span class="font-bold">237 ml</span></div>
          <div class="flex justify-between p-1"><span>1 EL</span><span class="font-bold">15 ml</span></div>
          <div class="flex justify-between p-1"><span>1 TL</span><span class="font-bold">5 ml</span></div>
          <div class="flex justify-between p-1"><span>1 Liter</span><span class="font-bold">1.000 ml</span></div>
          <div class="flex justify-between p-1"><span>1 Pint (US)</span><span class="font-bold">473 ml</span></div>
          <div class="flex justify-between p-1"><span>1 Gallone (US)</span><span class="font-bold">3.785 ml</span></div>
        </div>
      </div>

      <ShareButton lang="de" calculatorId="cooking" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Küchenmaße-Leitfaden</h2>
      <p>In deutschen Rezepten werden hauptsächlich metrische Maße (ml, l, g) verwendet. Bei internationalen Rezepten müssen US-Maße wie Cups und Tablespoons umgerechnet werden. Dieser Umrechner unterstützt alle gängigen Küchenmaßeinheiten.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wie viel ml hat ein Cup?</strong> Ein US Cup entspricht 236,6 ml.</p>
      <p><strong>Wie viel ist ein Esslöffel?</strong> Ein Esslöffel (EL) entspricht ca. 15 ml, ein Teelöffel (TL) ca. 5 ml.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const toMl: Record<string, number> = {
      tsp: 4.929, tbsp: 14.787, floz: 29.574, cup: 236.588,
      pint: 473.176, quart: 946.353, gallon: 3785.41, ml: 1, L: 1000,
    };
    const unitLabels: Record<string, string> = {
      tsp: 'TL', tbsp: 'EL', floz: 'fl oz', cup: 'Cups',
      pint: 'Pints', quart: 'Quarts', gallon: 'Gal', ml: 'ml', L: 'L',
    };

    function formatVal(n: number): string {
      if (n === 0) return '0';
      if (n >= 1000) return Math.round(n).toLocaleString('de-DE');
      if (n >= 100) return n.toLocaleString('de-DE', {minimumFractionDigits:1, maximumFractionDigits:1});
      if (n >= 1) return n.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2});
      return n.toLocaleString('de-DE', {minimumFractionDigits:3, maximumFractionDigits:3});
    }

    function calcCooking() {
      const val = parseFloat((document.getElementById('ck-val') as HTMLInputElement).value) || 0;
      const from = (document.getElementById('ck-from') as HTMLSelectElement).value;
      const ml = val * toMl[from];

      document.getElementById('ck-results')!.innerHTML = Object.entries(toMl).map(([key, factor]) => {
        const converted = ml / factor;
        const isSource = key === from;
        return '<div class="p-3 rounded-xl text-center ' + (isSource ? 'bg-primary text-white' : 'bg-surface-alt') + '">' +
          '<div class="text-xs ' + (isSource ? 'text-blue-200' : 'text-text-muted') + '">' + unitLabels[key] + '</div>' +
          '<div class="text-lg font-bold">' + formatVal(converted) + '</div>' +
          '</div>';
      }).join('');
    }

    function calcTemp() {
      const val = parseFloat((document.getElementById('ck-temp') as HTMLInputElement).value) || 0;
      const unit = (document.getElementById('ck-temp-unit') as HTMLSelectElement).value;

      let f: number, c: number, gas: number;
      if (unit === 'c') { c = val; f = val * 9 / 5 + 32; }
      else if (unit === 'f') { f = val; c = (val - 32) * 5 / 9; }
      else { gas = val; f = gas * 25 + 250; c = (f - 32) * 5 / 9; }

      f = f!; c = c!;
      gas = Math.round((f - 250) / 25);

      document.getElementById('ck-c')!.textContent = Math.round(c).toString();
      document.getElementById('ck-f')!.textContent = Math.round(f).toString();
      document.getElementById('ck-gas')!.textContent = String(Math.max(1, gas));
    }

    setTimeout(() => {
      document.getElementById('ck-val')!.addEventListener('input', calcCooking);
      document.getElementById('ck-from')!.addEventListener('change', calcCooking);

      document.querySelectorAll('.ck-quick').forEach(btn => {
        btn.addEventListener('click', () => {
          (document.getElementById('ck-val') as HTMLInputElement).value = (btn as HTMLElement).dataset.v || '1';
          (document.getElementById('ck-from') as HTMLSelectElement).value = (btn as HTMLElement).dataset.u || 'ml';
          calcCooking();
        });
      });

      document.getElementById('ck-temp')!.addEventListener('input', calcTemp);
      document.getElementById('ck-temp-unit')!.addEventListener('change', calcTemp);

      calcCooking();
      calcTemp();
    }, 50);
  </script>
</CalculatorLayout>
