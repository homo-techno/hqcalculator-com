---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Rumpfgeschwindigkeit-Rechner - Theoretische Bootshöchstgeschwindigkeit";
const description = "Berechnen Sie die theoretische Rumpfgeschwindigkeit anhand der Wasserlinienlänge, des Verdrängungsgeschwindigkeitsverhältnisses und der Gleitgrenze für Boote und Schiffe.";
const relatedCalcs = [
  { name: "Bootskredit-Rechner", url: "/boat-loan-calculator", description: "Marine-Finanzierungskosten." },
  { name: "Seemeilen-Rechner", url: "/nautical-mile-calculator", description: "Nautische Distanzumrechnung." },
  { name: "Auftrieb-Rechner", url: "/buoyancy-calculator", description: "Auftriebskraftberechnungen." },
  { name: "Geschwindigkeitsrechner", url: "/speed-calculator", description: "Geschwindigkeit und Distanz." },
  { name: "Großkreis-Rechner", url: "/great-circle-calculator", description: "Großkreisnavigation." },
  { name: "Kayak-Paddel-Rechner", url: "/kayak-paddle-calculator", description: "Paddelgrößenführer." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was ist die Rumpfgeschwindigkeit?",
      "acceptedAnswer": { "@type": "Answer", "text": "Die Rumpfgeschwindigkeit ist die theoretische Höchstgeschwindigkeit eines Verdrängungsrumpfes, berechnet als 1,34 × √Wasserlinienlänge (in Fuß). Schnellere Geschwindigkeiten erfordern ein Gleiten." }
    },
    {
      "@type": "Question",
      "name": "Was bedeutet das S/L-Verhältnis?",
      "acceptedAnswer": { "@type": "Answer", "text": "Das S/L-Verhältnis (Geschwindigkeit/Länge) ist die Geschwindigkeit in Knoten geteilt durch die Wurzel der Wasserlinienlänge. Bei 1,34 erreicht ein Verdrängungsrumpf sein Maximum." }
    }
  ]
};
---
<CalculatorLayout title={title} description={description} calculatorName="Rumpfgeschwindigkeit-Rechner" lang="de" keywords="rumpfgeschwindigkeit rechner, wasserlinienlänge, verdrängungsgeschwindigkeit, gleitschwelle, bootgeschwindigkeit, SL-verhältnis" breadcrumbs={[{ name: "Rumpfgeschwindigkeit-Rechner", url: "/de/rumpfgeschwindigkeit-rechner" }]} enSlug="hull-speed-calculator">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Rumpfgeschwindigkeit-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Bestimmen Sie die theoretische Rumpfgeschwindigkeit, das Verdrängungsgeschwindigkeitsverhältnis und die Gleitgrenze für Verdränger- und Halbgleiterrümpfe.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Wasserlinienlänge (ft)</label><input type="number" id="rg-lwl" class="rg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Verdrängung (lbs)</label><input type="number" id="rg-disp" class="rg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="1" step="100"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Motor PS</label><input type="number" id="rg-hp" class="rg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" min="0" step="10"></div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Rumpftyp</label>
            <select id="rg-type" class="rg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="disp">Verdränger</option>
              <option value="semi">Halbgleiter</option>
              <option value="plane">Gleiter</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Theoretische Rumpfgeschwindigkeit</div>
          <div class="text-5xl font-extrabold font-mono" id="rg-speed">--</div>
          <div class="text-sm text-blue-200 mt-1">Knoten</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">S/L-Verhältnis</div><div class="text-xl font-bold" id="rg-sl">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">D/L-Verhältnis</div><div class="text-xl font-bold" id="rg-dl">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">PS/Tonne</div><div class="text-xl font-bold" id="rg-hpt">--</div></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Gleitschwelle</div><div class="text-xl font-bold" id="rg-plane">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Klassifizierung</div><div class="text-xl font-bold" id="rg-class">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="rumpfgeschwindigkeit" lang="de" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Wie wird die Rumpfgeschwindigkeit berechnet?</h2>
      <p>Die theoretische Rumpfgeschwindigkeit wird mit der Formel 1,34 × √LWL (Wasserlinienlänge in Fuß) berechnet. Diese Grenze gilt für Verdrängungsrümpfe, da bei dieser Geschwindigkeit die Wellenlänge der vom Boot erzeugten Welle gleich der Bootslänge ist.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <h4 class="text-lg font-semibold text-text mt-4">Was ist die Rumpfgeschwindigkeit?</h4>
      <p>Die Rumpfgeschwindigkeit ist die theoretische Höchstgeschwindigkeit eines Verdrängungsrumpfes. Sie wird als 1,34 × √Wasserlinienlänge (in Fuß) berechnet. Schnellere Geschwindigkeiten erfordern ein Gleiten.</p>
      <h4 class="text-lg font-semibold text-text mt-4">Was bedeutet das S/L-Verhältnis?</h4>
      <p>Das S/L-Verhältnis (Geschwindigkeit/Länge) ist die Geschwindigkeit in Knoten geteilt durch die Wurzel der Wasserlinienlänge. Bei 1,34 erreicht ein Verdrängungsrumpf sein Maximum.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcRG() {
      const lwl = parseFloat((document.getElementById('rg-lwl') as HTMLInputElement).value) || 0;
      const disp = parseFloat((document.getElementById('rg-disp') as HTMLInputElement).value) || 0;
      const hp = parseFloat((document.getElementById('rg-hp') as HTMLInputElement).value) || 0;
      const hullType = (document.getElementById('rg-type') as HTMLSelectElement).value;
      if (lwl <= 0) return;
      const slCoeff = hullType === 'plane' ? 2.5 : hullType === 'semi' ? 1.8 : 1.34;
      const hullSpeed = slCoeff * Math.sqrt(lwl);
      const dispLongTons = disp / 2240;
      const dlRatio = disp > 0 ? dispLongTons / Math.pow(0.01 * lwl, 3) : 0;
      const slRatio = lwl > 0 ? hullSpeed / Math.sqrt(lwl) : 0;
      const hpTon = dispLongTons > 0 ? hp / dispLongTons : 0;
      const planingSpeed = hp > 0 && disp > 0 ? 1.34 * Math.sqrt(lwl) * Math.min(2.5, Math.sqrt(hpTon / 40) + 1) : 0;
      let classification = 'Schwere Verdrängung';
      if (dlRatio > 0 && dlRatio < 100) classification = 'Ultraleicht';
      else if (dlRatio < 200) classification = 'Leicht';
      else if (dlRatio < 300) classification = 'Mittel';
      else if (dlRatio < 400) classification = 'Schwer';
      else classification = 'Sehr schwer';
      document.getElementById('rg-speed')!.textContent = hullSpeed.toFixed(1);
      document.getElementById('rg-sl')!.textContent = slRatio.toFixed(2);
      document.getElementById('rg-dl')!.textContent = dlRatio > 0 ? Math.round(dlRatio).toString() : '--';
      document.getElementById('rg-hpt')!.textContent = hpTon > 0 ? hpTon.toFixed(1) : '--';
      document.getElementById('rg-plane')!.textContent = planingSpeed > 0 ? planingSpeed.toFixed(1) + ' kts' : '--';
      document.getElementById('rg-class')!.textContent = dlRatio > 0 ? classification : '--';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      (document.getElementById('rg-lwl') as HTMLInputElement).value = '30';
      (document.getElementById('rg-disp') as HTMLInputElement).value = '8000';
      (document.getElementById('rg-hp') as HTMLInputElement).value = '200';
      document.querySelectorAll('.rg-in').forEach(el => { el.addEventListener('input', calcRG); el.addEventListener('change', calcRG); });
      calcRG();
    }, 50);
  </script>
</CalculatorLayout>
