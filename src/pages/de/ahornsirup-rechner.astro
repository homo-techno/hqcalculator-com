---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Ahornsirup Rechner – Rezeptmengen und Saftausbeute berechnen";
const description = "Berechnen Sie Ahornsirupmengen für Rezepte und die Saftausbeute bei der Produktion. Zucker durch Ahornsirup ersetzen leicht gemacht.";

const relatedCalcs = [
  { name: "Macaron Rechner", url: "/de/macaron-rechner", description: "Backmengen." },
  { name: "Makronährstoff Rechner", url: "/de/makro-rechner", description: "Nährstoffe." },
  { name: "Holzrechner", url: "/de/holz-rechner", description: "Holzmengen (Ahornbäume)." },
];
---
<CalculatorLayout lang="de" enSlug="maple-syrup-calculator" title={title} description={description} calculatorName="Ahornsirup Rechner" keywords="Ahornsirup Rechner, Zucker ersetzen Ahornsirup, Maple Syrup Menge, Ahornsaft Ausbeute" breadcrumbs={[{ name: "Ahornsirup Rechner", url: "/de/ahornsirup-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Ahornsirup Rechner</html>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Ahornsirupmengen für Rezepte oder die Saftausbeute bei der Produktion.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button id="as-m1" class="as-mode flex-1 py-2 rounded-xl border-2 border-primary bg-blue-50 text-primary font-bold text-sm" data-mode="recipe">Rezept-Ersatz</button>
          <button id="as-m2" class="as-mode flex-1 py-2 rounded-xl border-2 border-border text-text-muted font-bold text-sm" data-mode="production">Produktion</button>
        </div>
        <div id="as-panel-recipe">
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-text mb-1">Zucker im Rezept (g)</label>
              <input type="number" id="as-sugar" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="200" step="5" min="0">
            </div>
            <div>
              <label class="block text-xs font-medium text-text mb-1">Ahornsirup-Klasse</label>
              <select id="as-grade" class="w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
                <option value="golden">Golden (mild, hell)</option>
                <option value="amber" selected>Amber (ausgewogen)</option>
                <option value="dark">Dunkel (intensiv)</option>
                <option value="very_dark">Sehr dunkel (kräftig)</option>
              </select>
            </div>
            <div class="p-4 bg-blue-50 border border-blue-100 rounded-xl text-sm text-blue-800">
              <strong>Tipp:</strong> Beim Ersetzen von Zucker durch Ahornsirup: 200 g Zucker = ca. 150 ml Ahornsirup. Flüssigkeitsmenge im Rezept um 3–4 EL pro 200 g Zucker reduzieren.
            </div>
          </div>
        </div>
        <div id="as-panel-production" class="hidden space-y-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Ahornsaft (Liter)</label>
            <input type="number" id="as-sap" class="w-full px-4 py-3 border border-border rounded-xl text-2xl font-bold text-center" value="40" step="1" min="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Zuckergehalt des Safts (%)</label>
            <input type="number" id="as-brix" class="w-full px-4 py-3 border border-border rounded-xl text-xl font-bold text-center" value="2" step="0.1" min="0.5" max="10">
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="as-label">Ahornsirup benötigt</div>
          <div class="text-5xl font-extrabold font-mono" id="as-result">–</div>
          <div class="text-blue-200 text-sm mt-1" id="as-sub">–</div>
        </div>
        <div class="grid grid-cols-2 gap-3" id="as-extras"></div>
      </div>
      <ShareButton lang="de" calculatorId="maple-syrup" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Ahornsirup – Das flüssige Gold aus Nordamerika</h2>
      <p>Ahornsirup wird aus dem Saft des Zuckerahorns (Acer saccharum) gewonnen, der hauptsächlich in Kanada und den nordöstlichen USA wächst. Um 1 Liter Ahornsirup herzustellen, werden durchschnittlich 40 Liter Ahornsaft benötigt. Der Saft wird durch Eindampfen konzentriert, bis ein Zuckergehalt von mindestens 66 % erreicht ist. Kanada produziert etwa 70 % des weltweiten Ahornsirupangebots.</p>

      <h2 class="text-2xl font-bold text-text mt-8">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Kann ich Zucker 1:1 durch Ahornsirup ersetzen?</h3>
      <p>Nein, nicht 1:1. Ahornsirup enthält Feuchtigkeit, daher: 200 g Zucker durch 150 ml Ahornsirup ersetzen. Außerdem sollten Sie 3–4 EL Flüssigkeit aus dem Rezept entfernen, da Ahornsirup flüssiger ist als Zucker.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Was sind die verschiedenen Ahornsirup-Klassen?</h3>
      <p>Seit 2015 gibt es weltweit einheitliche Bezeichnungen: Golden (mild, golden), Amber (ausgewogen, bernsteinfarben), Dunkel (intensiv, für Kochen), Sehr Dunkel (sehr intensiv, für Verarbeitung). Früher gab es die Bezeichnungen Klasse A (hell) und Klasse B (dunkel).</p>
      <h3 class="text-lg font-semibold text-text mt-6">Ist Ahornsirup gesünder als Zucker?</h3>
      <p>Ahornsirup enthält mehr Mineralstoffe (Mangan, Zink) als Haushaltszucker und hat einen leicht niedrigeren glykämischen Index. Er besteht jedoch zu 60–65 % aus Zucker und sollte sparsam verwendet werden.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let asMode = 'recipe';
    const gradeNote: Record<string, string> = {
      golden: 'Goldener Sirup – milder Geschmack, ideal für Desserts',
      amber: 'Bernsteinfarbener Sirup – ausgewogen, vielseitig verwendbar',
      dark: 'Dunkler Sirup – intensiver Geschmack, ideal zum Backen',
      very_dark: 'Sehr dunkler Sirup – kräftiger Ahorngeschmack',
    };
    function setAsMode(m: string) {
      asMode = m;
      document.getElementById('as-panel-recipe')!.classList.toggle('hidden', m !== 'recipe');
      document.getElementById('as-panel-production')!.classList.toggle('hidden', m !== 'production');
      document.querySelectorAll('.as-mode').forEach(b => {
        const btn = b as HTMLButtonElement;
        const active = btn.dataset.mode === m;
        btn.className = 'as-mode flex-1 py-2 rounded-xl border-2 font-bold text-sm ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
      });
      calcAS();
    }
    function calcAS() {
      const extras = document.getElementById('as-extras')!;
      if (asMode === 'recipe') {
        const sugar = parseFloat((document.getElementById('as-sugar') as HTMLInputElement).value) || 0;
        const grade = (document.getElementById('as-grade') as HTMLSelectElement).value;
        const sirup = sugar * 0.75;
        const reduceLiquid = Math.round(sugar / 200 * 3.5 * 10) / 10;
        document.getElementById('as-label')!.textContent = 'Ahornsirup (Ersatz für ' + sugar + ' g Zucker)';
        document.getElementById('as-result')!.textContent = sirup.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' ml';
        document.getElementById('as-sub')!.textContent = gradeNote[grade];
        const kcal = sirup * 2.61;
        extras.innerHTML = `<div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Flüssigkeit reduzieren</div><div class="text-xl font-bold font-mono">${reduceLiquid.toLocaleString('de-DE')} EL</div></div><div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kalorien (ca.)</div><div class="text-xl font-bold font-mono">${Math.round(kcal).toLocaleString('de-DE')} kcal</div></div>`;
      } else {
        const sap = parseFloat((document.getElementById('as-sap') as HTMLInputElement).value) || 0;
        const brix = parseFloat((document.getElementById('as-brix') as HTMLInputElement).value) / 100 || 0.02;
        const sirupL = sap * brix / 0.66;
        const sapNeeded40L = 40 * 0.66 / brix;
        document.getElementById('as-label')!.textContent = 'Ahornsirup Ausbeute';
        document.getElementById('as-result')!.textContent = sirupL.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' L';
        document.getElementById('as-sub')!.textContent = 'Aus ' + sap + ' L Saft bei ' + (brix * 100).toFixed(1) + ' % Zuckergehalt';
        extras.innerHTML = `<div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Saft für 1 L Sirup</div><div class="text-xl font-bold font-mono">${(1 * 0.66 / brix).toLocaleString('de-DE', { maximumFractionDigits: 0 })} L</div></div><div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Reduktion auf</div><div class="text-xl font-bold font-mono">${(sirupL / sap * 100).toLocaleString('de-DE', { maximumFractionDigits: 1 })} %</div></div>`;
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.as-mode').forEach(b => b.addEventListener('click', () => setAsMode((b as HTMLButtonElement).dataset.mode!)));
      ['as-sugar', 'as-sap', 'as-brix'].forEach(id => document.getElementById(id)!.addEventListener('input', calcAS));
      ['as-grade'].forEach(id => document.getElementById(id)!.addEventListener('change', calcAS));
      calcAS();
    }, 50);
  </script>
</CalculatorLayout>
