---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const title = "HQ Calculator - Kostenlose Online-Rechner für Finanzen, Gesundheit, Mathematik & mehr";
const description = "Über 500 kostenlose Online-Rechner. Hypotheken-, BMI-, Prozent-, Alters-, Kredit-, Kalorien-, Notenrechner und mehr. Sofortige Ergebnisse, keine Anmeldung nötig. Die beste Rechner-Webseite im Netz.";

interface CalcLink {
  name: string;
  url: string;
  desc: string;
  hot?: boolean;
}

interface Category {
  id: string;
  title: string;
  icon: string;
  color: string;
  calcs: CalcLink[];
}

const categories: Category[] = [
  {
    id: 'mathe',
    title: 'Mathematik-Rechner',
    icon: 'f(x)',
    color: '#2563eb',
    calcs: [
      { name: 'Prozentrechner', url: '/de/percentage-calculator', desc: '% eines Wertes, Zunahme, Abnahme', hot: true },
      { name: 'Bruchrechner', url: '/de/fraction-calculator', desc: 'Brüche addieren, subtrahieren, multiplizieren, dividieren' },
      { name: 'Wissenschaftlicher Rechner', url: '/de/scientific-calculator', desc: 'Erweiterte mathematische Funktionen' },
      { name: 'Quadratwurzelrechner', url: '/de/square-root-calculator', desc: 'Quadratwurzeln sofort berechnen' },
      { name: 'Zufallszahlengenerator', url: '/de/random-number-generator', desc: 'Zufällige Zahlen erzeugen' },
      { name: 'Notenrechner', url: '/de/gpa-calculator', desc: 'Notendurchschnitt berechnen' },
      { name: 'Potenzrechner', url: '/de/exponent-calculator', desc: 'Potenzen und Exponenten' },
      { name: 'Logarithmusrechner', url: '/de/logarithm-calculator', desc: 'Logarithmus und natürlicher Logarithmus' },
      { name: 'kgV-Rechner', url: '/de/lcm-calculator', desc: 'Kleinstes gemeinsames Vielfaches' },
      { name: 'ggT-Rechner', url: '/de/gcf-calculator', desc: 'Größter gemeinsamer Teiler' },
    ]
  },
  {
    id: 'finanzen',
    title: 'Finanzrechner',
    icon: '\u20AC',
    color: '#059669',
    calcs: [
      { name: 'Hypothekenrechner', url: '/de/mortgage-calculator', desc: 'Monatliche Rate, Tilgungsplan', hot: true },
      { name: 'Kreditrechner', url: '/de/loan-calculator', desc: 'Kreditraten, Zinsen, Laufzeit' },
      { name: 'Zinseszinsrechner', url: '/de/compound-interest-calculator', desc: 'Vermögenswachstum berechnen' },
      { name: 'Autokredit-Rechner', url: '/de/auto-loan-calculator', desc: 'Monatliche Autofinanzierungsrate' },
      { name: 'Gehaltsrechner', url: '/de/salary-calculator', desc: 'Stündlich, wöchentlich, monatlich, jährlich' },
      { name: 'Anlagerechner', url: '/de/investment-calculator', desc: 'Zukünftiger Wert von Investitionen' },
      { name: 'Sparrechner', url: '/de/savings-calculator', desc: 'Sparwachstum über Zeit' },
      { name: 'Rentenrechner', url: '/de/retirement-calculator', desc: 'Altersvorsorge planen' },
      { name: 'Inflationsrechner', url: '/de/inflation-calculator', desc: 'Kaufkraft im Zeitverlauf' },
      { name: 'Währungsrechner', url: '/de/currency-converter', desc: 'Wechselkurse umrechnen' },
    ]
  },
  {
    id: 'gesundheit',
    title: 'Gesundheitsrechner',
    icon: '+',
    color: '#dc2626',
    calcs: [
      { name: 'BMI-Rechner', url: '/de/bmi-calculator', desc: 'Body-Mass-Index berechnen', hot: true },
      { name: 'Kalorienrechner', url: '/de/calorie-calculator', desc: 'Täglicher Kalorienbedarf' },
      { name: 'Körperfettrechner', url: '/de/body-fat-calculator', desc: 'Körperfettanteil schätzen' },
      { name: 'Grundumsatzrechner', url: '/de/bmr-calculator', desc: 'Grundumsatz (BMR) berechnen' },
      { name: 'TDEE-Rechner', url: '/de/tdee-calculator', desc: 'Gesamter täglicher Energieverbrauch' },
      { name: 'Schwangerschaftsrechner', url: '/de/pregnancy-calculator', desc: 'Geburtstermin & Meilensteine' },
      { name: 'Eisprungrechner', url: '/de/ovulation-calculator', desc: 'Fruchtbare Tage berechnen' },
      { name: 'Idealgewichtrechner', url: '/de/ideal-weight-calculator', desc: 'Gesunder Gewichtsbereich' },
      { name: 'Makronährstoffrechner', url: '/de/macro-calculator', desc: 'Eiweiß, Kohlenhydrate, Fett' },
      { name: 'Wasserbedarfsrechner', url: '/de/water-intake-calculator', desc: 'Täglicher Wasserbedarf' },
    ]
  },
  {
    id: 'datumzeit',
    title: 'Datum- & Zeitrechner',
    icon: '\u23F0',
    color: '#7c3aed',
    calcs: [
      { name: 'Altersrechner', url: '/de/age-calculator', desc: 'Wie alt bin ich? Genaues Alter in Jahren und Tagen', hot: true },
      { name: 'Datumsrechner', url: '/de/date-calculator', desc: 'Tage zwischen zwei Daten' },
      { name: 'Zeitrechner', url: '/de/time-calculator', desc: 'Zeit addieren & subtrahieren' },
      { name: 'Stundenrechner', url: '/de/hours-calculator', desc: 'Stunden zwischen Uhrzeiten' },
      { name: 'Zeitzonenrechner', url: '/de/time-zone-converter', desc: 'Zwischen Zeitzonen umrechnen' },
      { name: 'Tagezähler', url: '/de/day-counter', desc: 'Tage ab einem Datum zählen' },
    ]
  },
  {
    id: 'fitness',
    title: 'Fitness & Sport',
    icon: '\u{1F3CB}',
    color: '#ea580c',
    calcs: [
      { name: 'Kalorienverbrauchsrechner', url: '/de/calories-burned-calculator', desc: 'Nach Aktivitätsart' },
      { name: 'Pacerechner', url: '/de/pace-calculator', desc: 'Lauf- & Gehtempo' },
      { name: 'Maximalkraftrechner', url: '/de/one-rep-max-calculator', desc: '1RM im Krafttraining' },
      { name: 'Abnehmrechner', url: '/de/weight-loss-calculator', desc: 'Kaloriendefizit planen' },
      { name: 'VO2-Max-Rechner', url: '/de/vo2-max-calculator', desc: 'Aerobe Fitnessstufe' },
      { name: 'Herzfrequenzzonen-Rechner', url: '/de/heart-rate-zone-calculator', desc: 'Trainingszonen berechnen' },
    ]
  },
  {
    id: 'bauen',
    title: 'Bau & Haus',
    icon: '\u{1F3E0}',
    color: '#854d0e',
    calcs: [
      { name: 'Flächenrechner', url: '/de/square-footage-calculator', desc: 'Raum- & Grundfläche berechnen' },
      { name: 'Betonrechner', url: '/de/concrete-calculator', desc: 'Benötigte Betonmenge' },
      { name: 'BTU-Rechner', url: '/de/btu-calculator', desc: 'Heiz- & Kühlbedarf' },
      { name: 'Dachrechner', url: '/de/roofing-calculator', desc: 'Material für Ihr Dach' },
      { name: 'Fliesenrechner', url: '/de/tile-calculator', desc: 'Fliesen für Boden/Wand' },
      { name: 'Farbrechner', url: '/de/paint-calculator', desc: 'Benötigte Farbmenge' },
    ]
  },
  {
    id: 'steuer',
    title: 'Steuer & Gehalt',
    icon: '\u{1F4B0}',
    color: '#0891b2',
    calcs: [
      { name: 'Einkommensteuerrechner', url: '/de/income-tax-calculator', desc: 'Steuerberechnung' },
      { name: 'Nettolohnrechner', url: '/de/paycheck-calculator', desc: 'Nettoverdienst berechnen' },
      { name: 'Mehrwertsteuerrechner', url: '/de/sales-tax-calculator', desc: 'MwSt. auf Einkäufe' },
      { name: 'Stundenlohn-Jahresgehalt', url: '/de/hourly-to-salary-calculator', desc: 'Stundenlohn in Jahresgehalt umrechnen' },
      { name: 'Steuerklassenrechner', url: '/de/tax-bracket-calculator', desc: 'Ihre Steuerklasse finden' },
      { name: 'Trinkgeldrechner', url: '/de/tip-calculator', desc: 'Trinkgeld & Rechnungsteilung' },
    ]
  },
  {
    id: 'sonstige',
    title: 'Umrechnung & Sonstiges',
    icon: '\u21C4',
    color: '#64748b',
    calcs: [
      { name: 'Temperaturumrechner', url: '/de/temperature-converter', desc: 'Celsius, Fahrenheit, Kelvin' },
      { name: 'Längenumrechner', url: '/de/length-converter', desc: 'cm, Zoll, Fuß, m, km, Meilen' },
      { name: 'Gewichtsumrechner', url: '/de/weight-converter', desc: 'kg, Pfund, Unzen, Stone' },
      { name: 'BH-Größen-Rechner', url: '/de/bra-size-calculator', desc: 'Die richtige Größe finden' },
      { name: 'Schuhgrößen-Umrechner', url: '/de/shoe-size-converter', desc: 'US-, UK-, EU-Größen' },
      { name: 'Stromkostenrechner', url: '/de/electricity-cost-calculator', desc: 'Monatliche Stromrechnung' },
      { name: 'Liebesrechner', url: '/de/love-calculator', desc: 'Namenskompatibilitätstest' },
    ]
  },
];
---

<CalculatorLayout
  title={title}
  description={description}
  keywords="Online-Rechner, kostenloser Rechner, Prozentrechner, BMI-Rechner, Hypothekenrechner, Altersrechner, Kreditrechner"
  lang="de"
>
  <!-- Hero-Bereich -->
  <section class="bg-gradient-to-b from-primary/5 to-surface pt-12 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-text mb-4">
        Kostenlose Online-<span class="text-primary">Rechner</span>
      </h1>
      <p class="text-lg sm:text-xl text-text-secondary max-w-2xl mx-auto mb-8">
        Über 500 Rechner für Finanzen, Gesundheit, Mathematik, Fitness, Bauwesen und mehr. Sofortige Ergebnisse, keine Anmeldung erforderlich.
      </p>

      <!-- Schnellzugriff / Beliebte Rechner -->
      <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto">
        {[
          { name: 'Prozent', url: '/de/percentage-calculator' },
          { name: 'Alter', url: '/de/age-calculator' },
          { name: 'BMI', url: '/de/bmi-calculator' },
          { name: 'Hypotheken', url: '/de/mortgage-calculator' },
          { name: 'Kalorien', url: '/de/calorie-calculator' },
          { name: 'Noten', url: '/de/gpa-calculator' },
          { name: 'Kredit', url: '/de/loan-calculator' },
          { name: 'Trinkgeld', url: '/de/tip-calculator' },
        ].map(calc => (
          <a href={calc.url}
            class="px-4 py-2 bg-white border border-border rounded-full text-sm font-medium text-text-secondary hover:text-primary hover:border-primary/30 hover:shadow-sm transition-all no-underline">
            {calc.name}rechner
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Rechner-Kategorien -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {categories.map((cat) => (
      <div id={cat.id} class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-lg" style={`background: ${cat.color}`}>
            {cat.icon}
          </div>
          <h2 class="text-2xl font-bold text-text">{cat.title}</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {cat.calcs.map((calc) => (
            <a href={calc.url}
              class="block p-4 bg-white border border-border rounded-xl hover:border-primary/30 hover:shadow-md transition-all group no-underline relative">
              {calc.hot && (
                <span class="absolute top-3 right-3 px-2 py-0.5 bg-danger/10 text-danger text-[10px] font-bold uppercase rounded-full">Beliebt</span>
              )}
              <h3 class="font-semibold text-text group-hover:text-primary transition-colors pr-16">{calc.name}</h3>
              <p class="text-sm text-text-secondary mt-1">{calc.desc}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Vertrauen / Vorteile -->
  <section class="bg-surface-alt py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-text">Warum HQ Calculator?</h2>
        <p class="text-text-secondary mt-2">Entwickelt für Geschwindigkeit, Genauigkeit und Einfachheit.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-14 h-14 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
            &lt;1s
          </div>
          <h3 class="font-semibold text-text text-lg">Sofortige Ergebnisse</h3>
          <p class="text-sm text-text-secondary mt-2">Kein Laden, kein Absende-Button. Ergebnisse aktualisieren sich während der Eingabe. Jeder Rechner lädt in unter 1 Sekunde.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-secondary/10 text-secondary rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
            0
          </div>
          <h3 class="font-semibold text-text text-lg">Keine Anmeldung nötig</h3>
          <p class="text-sm text-text-secondary mt-2">100 % kostenlos, keine Registrierung, keine E-Mail-Barrieren. Einfach öffnen und rechnen. Ergebnisse per Link teilen.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-accent/10 text-accent rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl">
            &#10003;
          </div>
          <h3 class="font-semibold text-text text-lg">Geprüfte Genauigkeit</h3>
          <p class="text-sm text-text-secondary mt-2">Jede Formel wird anhand offizieller Quellen verifiziert. Finanzrechner werden von Fachleuten geprüft.</p>
        </div>
      </div>
    </div>
  </section>
</CalculatorLayout>
