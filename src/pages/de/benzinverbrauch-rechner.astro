---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Benzinverbrauch-Rechner - L/100km, Kosten & Vergleich";
const description = "Berechnen Sie den Benzinverbrauch (L/100km), Kraftstoffkosten pro Fahrt und vergleichen Sie Fahrzeuge. Spritverbrauch und Reisekosten sch\u00E4tzen.";
const relatedCalcs = [
  { name: "Gaskosten-Rechner", url: "/de/gaskosten-rechner", description: "Fahrtkosten." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozent." },
  { name: "Sparrechner", url: "/de/sparrechner", description: "Sparwachstum." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Benzinverbrauch-Rechner" lang="de" enSlug="gas-mileage-calculator" keywords="benzinverbrauch rechner, l/100km rechner, kraftstoffkosten, spritverbrauch, kraftstoffeffizienz, reisekosten rechner" breadcrumbs={[{ name: "Benzinverbrauch", url: "/de/benzinverbrauch-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Benzinverbrauch-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie L/100km, Kraftstoffkosten und vergleichen Sie Reiseausgaben.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <div class="flex gap-2 mb-5">
            <button class="bvr-mode-btn px-4 py-2 rounded-xl text-sm font-semibold border border-primary bg-blue-50 text-primary" data-mode="consumption">Verbrauch berechnen</button>
            <button class="bvr-mode-btn px-4 py-2 rounded-xl text-sm font-semibold border border-border" data-mode="trip">Fahrtkosten</button>
            <button class="bvr-mode-btn px-4 py-2 rounded-xl text-sm font-semibold border border-border" data-mode="compare">Vergleich</button>
          </div>
          <div id="bvr-consumption">
            <div class="space-y-3">
              <div><label class="block text-xs font-medium text-text mb-1">Gefahrene Strecke (km)</label><input type="number" id="bvr-distance" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="550" min="0" step="1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Verbrauchter Kraftstoff (Liter)</label><input type="number" id="bvr-fuel" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="42" min="0" step="0.1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Benzinpreis (&euro;/L)</label><input type="number" id="bvr-gas-price" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="1.75" min="0" step="0.01"></div>
            </div>
          </div>
          <div id="bvr-trip" class="hidden">
            <div class="space-y-3">
              <div><label class="block text-xs font-medium text-text mb-1">Fahrstrecke (km)</label><input type="number" id="bvr-trip-dist" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="800" min="0" step="1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Verbrauch (L/100km)</label><input type="number" id="bvr-trip-consumption" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="7.5" min="0.1" step="0.1"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Benzinpreis (&euro;/L)</label><input type="number" id="bvr-trip-price" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="1.75" min="0" step="0.01"></div>
            </div>
          </div>
          <div id="bvr-compare" class="hidden">
            <div class="space-y-3">
              <div><label class="block text-xs font-medium text-text mb-1">J&auml;hrliche Fahrleistung (km)</label><input type="number" id="bvr-annual" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="15000" min="0" step="500"></div>
              <div><label class="block text-xs font-medium text-text mb-1">Benzinpreis (&euro;/L)</label><input type="number" id="bvr-cmp-price" class="w-full px-4 py-3 border border-border rounded-xl text-lg" value="1.75" min="0" step="0.01"></div>
              <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-xs font-medium text-text mb-1">Fahrzeug A (L/100km)</label><input type="number" id="bvr-cons-a" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="8.5" min="0.1" step="0.1"></div>
                <div><label class="block text-xs font-medium text-text mb-1">Fahrzeug B (L/100km)</label><input type="number" id="bvr-cons-b" class="w-full px-3 py-3 border border-border rounded-xl text-lg" value="5.5" min="0.1" step="0.1"></div>
              </div>
            </div>
          </div>
          <div class="mt-4 p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-2">Durchschnittlicher Verbrauch nach Fahrzeugtyp</h3>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div class="flex justify-between"><span>Kleinwagen</span><span class="font-bold">5,5 L/100km</span></div>
              <div class="flex justify-between"><span>Limousine</span><span class="font-bold">7,0 L/100km</span></div>
              <div class="flex justify-between"><span>SUV</span><span class="font-bold">9,0 L/100km</span></div>
              <div class="flex justify-between"><span>Transporter</span><span class="font-bold">10,5 L/100km</span></div>
              <div class="flex justify-between"><span>Hybrid</span><span class="font-bold">4,5 L/100km</span></div>
              <div class="flex justify-between"><span>Van</span><span class="font-bold">8,5 L/100km</span></div>
            </div>
          </div>
        </div>
        <div class="space-y-3">
          <div id="bvr-results">
            <div class="p-6 bg-primary rounded-2xl text-white text-center">
              <div class="text-sm text-blue-200 uppercase tracking-wide mb-1" id="bvr-result-label">Kraftstoffverbrauch</div>
              <div class="text-4xl sm:text-5xl font-extrabold" id="bvr-result">7,6 L/100km</div>
            </div>
            <div class="grid grid-cols-2 gap-3 mt-3">
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kosten pro km</div><div class="text-xl font-bold" id="bvr-cpk">0,13 &euro;</div></div>
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Kraftstoffkosten</div><div class="text-xl font-bold text-secondary" id="bvr-fuel-cost">73,50 &euro;</div></div>
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">km/L</div><div class="text-xl font-bold" id="bvr-kml">0</div></div>
              <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">MPG (US)</div><div class="text-xl font-bold" id="bvr-mpg">0</div></div>
            </div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl">
            <h3 class="font-semibold text-sm text-text mb-2" id="bvr-annual-label">J&auml;hrliche Sch&auml;tzung</h3>
            <div class="space-y-1 text-sm" id="bvr-annual-detail"></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="gas-mileage" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Benzinverbrauch berechnen</h2>
      <div class="bg-surface-alt rounded-xl p-4 my-4 font-mono text-sm space-y-1">
        <p><strong>L/100km</strong> = Verbrauchte Liter / Gefahrene km &times; 100</p>
        <p><strong>Fahrtkosten</strong> = (Strecke / 100) &times; L/100km &times; Benzinpreis</p>
        <p><strong>MPG</strong> = 235,215 / L/100km</p>
      </div>
      <h3 class="text-xl font-semibold text-text mt-8">H&auml;ufig gestellte Fragen</h3>
      <p><strong>Was ist ein guter Verbrauch?</strong> 5-7 L/100km gilt als gut f&uuml;r PKW. Hybride schaffen 3-5 L/100km.</p>
      <p><strong>Wie rechne ich L/100km in MPG um?</strong> Teilen Sie 235,215 durch den L/100km-Wert. Beispiel: 7,5 L/100km = 31,4 MPG.</p>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    let bvrMode = 'consumption';
    const fmtE = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' \u20AC';

    function calcBVR() {
      if (bvrMode === 'consumption') {
        const dist = parseFloat((document.getElementById('bvr-distance') as HTMLInputElement).value) || 0;
        const fuel = parseFloat((document.getElementById('bvr-fuel') as HTMLInputElement).value) || 0;
        const price = parseFloat((document.getElementById('bvr-gas-price') as HTMLInputElement).value) || 0;
        const l100 = dist > 0 ? (fuel / dist) * 100 : 0;
        const cpk = dist > 0 ? (fuel * price) / dist : 0;
        const fuelCost = fuel * price;
        document.getElementById('bvr-result-label')!.textContent = 'Kraftstoffverbrauch';
        document.getElementById('bvr-result')!.textContent = l100.toFixed(1) + ' L/100km';
        document.getElementById('bvr-cpk')!.textContent = fmtE(cpk);
        document.getElementById('bvr-fuel-cost')!.textContent = fmtE(fuelCost);
        document.getElementById('bvr-kml')!.textContent = fuel > 0 ? (dist / fuel).toFixed(1) : '\u2014';
        document.getElementById('bvr-mpg')!.textContent = l100 > 0 ? (235.215 / l100).toFixed(1) : '\u2014';
        const annualKm = 15000;
        const annualL = l100 > 0 ? annualKm * l100 / 100 : 0;
        const annualCost = annualL * price;
        document.getElementById('bvr-annual-label')!.textContent = 'J\u00E4hrliche Sch\u00E4tzung (15.000 km)';
        document.getElementById('bvr-annual-detail')!.innerHTML =
          '<div class="flex justify-between"><span>Liter/Jahr</span><span class="font-bold">' + Math.round(annualL).toLocaleString('de-DE') + '</span></div>' +
          '<div class="flex justify-between"><span>J\u00E4hrliche Kosten</span><span class="font-bold text-secondary">' + fmtE(annualCost) + '</span></div>' +
          '<div class="flex justify-between"><span>Monatliche Kosten</span><span class="font-bold">' + fmtE(annualCost / 12) + '</span></div>';
      } else if (bvrMode === 'trip') {
        const dist = parseFloat((document.getElementById('bvr-trip-dist') as HTMLInputElement).value) || 0;
        const cons = parseFloat((document.getElementById('bvr-trip-consumption') as HTMLInputElement).value) || 1;
        const price = parseFloat((document.getElementById('bvr-trip-price') as HTMLInputElement).value) || 0;
        const liters = dist * cons / 100;
        const cost = liters * price;
        const cpk = cons * price / 100;
        document.getElementById('bvr-result-label')!.textContent = 'Fahrt-Kraftstoffkosten';
        document.getElementById('bvr-result')!.textContent = fmtE(cost);
        document.getElementById('bvr-cpk')!.textContent = fmtE(cpk);
        document.getElementById('bvr-fuel-cost')!.textContent = liters.toFixed(1) + ' L';
        document.getElementById('bvr-kml')!.textContent = (100 / cons).toFixed(1);
        document.getElementById('bvr-mpg')!.textContent = (235.215 / cons).toFixed(1);
        document.getElementById('bvr-annual-label')!.textContent = 'Fahrtdetails';
        document.getElementById('bvr-annual-detail')!.innerHTML =
          '<div class="flex justify-between"><span>Einfach</span><span class="font-bold">' + fmtE(cost) + '</span></div>' +
          '<div class="flex justify-between"><span>Hin und zur\u00FCck</span><span class="font-bold text-secondary">' + fmtE(cost * 2) + '</span></div>' +
          '<div class="flex justify-between"><span>Liter ben\u00F6tigt</span><span class="font-bold">' + liters.toFixed(1) + '</span></div>' +
          '<div class="flex justify-between"><span>Tankstopps (50L Tank)</span><span class="font-bold">' + Math.ceil(liters / 50) + '</span></div>';
      } else {
        const annual = parseFloat((document.getElementById('bvr-annual') as HTMLInputElement).value) || 0;
        const price = parseFloat((document.getElementById('bvr-cmp-price') as HTMLInputElement).value) || 0;
        const consA = parseFloat((document.getElementById('bvr-cons-a') as HTMLInputElement).value) || 1;
        const consB = parseFloat((document.getElementById('bvr-cons-b') as HTMLInputElement).value) || 1;
        const costA = (annual * consA / 100) * price;
        const costB = (annual * consB / 100) * price;
        const savings = Math.abs(costA - costB);
        document.getElementById('bvr-result-label')!.textContent = 'J\u00E4hrliche Ersparnis';
        document.getElementById('bvr-result')!.textContent = Math.round(savings).toLocaleString('de-DE') + ' \u20AC/Jahr';
        document.getElementById('bvr-cpk')!.textContent = fmtE(consA * price / 100);
        document.getElementById('bvr-fuel-cost')!.textContent = fmtE(consB * price / 100);
        document.getElementById('bvr-kml')!.textContent = (100 / consA).toFixed(1);
        document.getElementById('bvr-mpg')!.textContent = (100 / consB).toFixed(1);
        document.getElementById('bvr-annual-label')!.textContent = 'Vergleich';
        document.getElementById('bvr-annual-detail')!.innerHTML =
          '<div class="flex justify-between"><span>Fahrzeug A (' + consA + ' L/100km)</span><span class="font-bold">' + Math.round(costA).toLocaleString('de-DE') + ' \u20AC/Jahr</span></div>' +
          '<div class="flex justify-between"><span>Fahrzeug B (' + consB + ' L/100km)</span><span class="font-bold">' + Math.round(costB).toLocaleString('de-DE') + ' \u20AC/Jahr</span></div>' +
          '<div class="flex justify-between pt-1 border-t border-border/50"><span class="font-semibold">' + (costA > costB ? 'Fahrzeug B' : 'Fahrzeug A') + ' spart</span><span class="font-bold text-secondary">' + Math.round(savings).toLocaleString('de-DE') + ' \u20AC/Jahr</span></div>' +
          '<div class="flex justify-between"><span>5-Jahres-Ersparnis</span><span class="font-bold">' + Math.round(savings * 5).toLocaleString('de-DE') + ' \u20AC</span></div>';
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.querySelectorAll('.bvr-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bvr-mode-btn').forEach(b => { b.classList.remove('border-primary', 'bg-blue-50', 'text-primary'); b.classList.add('border-border'); });
          btn.classList.remove('border-border'); btn.classList.add('border-primary', 'bg-blue-50', 'text-primary');
          bvrMode = (btn as HTMLElement).dataset.mode || 'consumption';
          document.getElementById('bvr-consumption')!.classList.toggle('hidden', bvrMode !== 'consumption');
          document.getElementById('bvr-trip')!.classList.toggle('hidden', bvrMode !== 'trip');
          document.getElementById('bvr-compare')!.classList.toggle('hidden', bvrMode !== 'compare');
          calcBVR();
        });
      });
      ['bvr-distance', 'bvr-fuel', 'bvr-gas-price', 'bvr-trip-dist', 'bvr-trip-consumption', 'bvr-trip-price', 'bvr-annual', 'bvr-cmp-price', 'bvr-cons-a', 'bvr-cons-b'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', calcBVR);
      });
      calcBVR();
    }, 50);
  </script>
</CalculatorLayout>
