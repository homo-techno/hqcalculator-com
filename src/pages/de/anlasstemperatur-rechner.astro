---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "Anlasstemperatur-Rechner - Wärmebehandlungsratgeber";
const description = "Finden Sie Glüh-, Normalisierungs-, Spannungsabbau- und Anlasstemperaturen für verschiedene Metalle und Legierungen. Vollständige Wärmebehandlungsreferenz.";

const relatedCalcs = [
  { name: "Härteumrechner", url: "/de/haerteumrechner-rechner", description: "Härteskalen umrechnen." },
  { name: "Metallausdehnung", url: "/de/metallausdehnung-rechner", description: "Wärmeausdehnung." },
  { name: "Schweißwärmeeintrag", url: "/de/schweisswaermeeintrag-rechner", description: "Schweißwärmeeintrag." },
  { name: "Metallermüdung", url: "/de/metallermüdung-rechner", description: "Ermüdungslebensdauer." },
  { name: "Metallgewicht", url: "/de/metallgewicht-rechner", description: "Metallgewichtberechnung." },
  { name: "Schnittgeschwindigkeit", url: "/de/schnittgeschwindigkeit-rechner", description: "Bearbeitungsgeschwindigkeiten." },
];
---

<CalculatorLayout
  lang="de"
  title={title}
  description={description}
  calculatorName="Anlasstemperatur-Rechner"
  keywords="Anlasstemperatur, Wärmebehandlung, Anlassen, Normalisieren, Spannungsabbau, Abschrecken, Härtetemperatur, Metalllegierung"
  breadcrumbs={[{ name: "Anlasstemperatur-Rechner", url: "/de/anlasstemperatur-rechner" }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Anlasstemperatur-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Finden Sie Glüh-, Anlass-, Normalisierungs- und Spannungsabbau-Temperaturen für Metalle und Legierungen.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Werkstoffkategorie</label>
        <select id="at2-category" class="at2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="carbon_steel">Kohlenstoffstahl</option>
          <option value="alloy_steel">Legierter Stahl</option>
          <option value="stainless">Edelstahl</option>
          <option value="tool_steel">Werkzeugstahl</option>
          <option value="aluminum">Aluminiumlegierungen</option>
          <option value="copper">Kupferlegierungen</option>
          <option value="titanium">Titanlegierungen</option>
        </select>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Spezifische Legierung</label>
        <select id="at2-alloy" class="at2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="1018">1018 Niedrig-Kohlenstoff</option>
        </select>
      </div>

      <div class="mb-5">
        <label class="block text-sm font-medium text-text mb-2">Temperatureinheit</label>
        <select id="at2-tunit" class="at2-in w-full px-4 py-3 border border-border rounded-xl text-lg">
          <option value="C" selected>Celsius</option>
          <option value="F">Fahrenheit</option>
        </select>
      </div>

      <div class="p-6 bg-primary rounded-2xl text-white text-center mb-4">
        <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Glühtemperatur</div>
        <div class="text-4xl font-extrabold" id="at2-anneal">--</div>
        <div class="text-sm text-blue-200 mt-1" id="at2-anneal-note">Vollglühbereich</div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Normalisieren</div>
          <div class="text-xl font-bold" id="at2-normalize">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Spannungsabbau</div>
          <div class="text-xl font-bold" id="at2-stress">--</div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Härten</div>
          <div class="text-xl font-bold" id="at2-harden">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl text-center">
          <div class="text-xs text-text-muted uppercase">Anlassen</div>
          <div class="text-xl font-bold" id="at2-temper">--</div>
        </div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-4">
        <div class="text-xs text-text-muted uppercase mb-2">Abschreckmedium</div>
        <div class="text-sm font-semibold" id="at2-quench">--</div>
      </div>

      <div class="p-4 bg-surface-alt rounded-xl mb-6">
        <div class="text-xs text-text-muted uppercase mb-2">Hinweise</div>
        <div class="text-sm" id="at2-notes">--</div>
      </div>

      <ShareButton lang="de" calculatorId="annealing-temperature" />
      <FeedbackWidget lang="de" />
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Wärmebehandlungsverfahren</h2>
      <ul>
        <li><strong>Glühen:</strong> Metall weich machen, innere Spannungen abbauen, Bearbeitbarkeit verbessern. Auf vorgegebene Temperatur erhitzen, langsam im Ofen abkühlen.</li>
        <li><strong>Normalisieren:</strong> Kornstruktur verfeinern. Über kritische Temperatur erhitzen, an Luft abkühlen.</li>
        <li><strong>Härten:</strong> Härte und Festigkeit erhöhen. Auf Austenitisierungstemperatur erhitzen, schnell abschrecken.</li>
        <li><strong>Anlassen:</strong> Sprödigkeit nach dem Härten reduzieren. Auf niedrigere Temperatur erhitzen, an Luft abkühlen. Höhere Temperatur = mehr Duktilität, weniger Härte.</li>
        <li><strong>Spannungsabbau:</strong> Eigenspannungen durch Schweißen, Bearbeitung oder Umformen ohne wesentliche Gefügeveränderung entfernen.</li>
      </ul>
    </article>

    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>

  <script>
    const at2Data: Record<string, Record<string, {anneal:[number,number], normalize:[number,number], stress:[number,number], harden:[number,number], temper:[number,number], quench:string, notes:string}>> = {
      carbon_steel: {
        '1018': {anneal:[1550,1650], normalize:[1650,1700], stress:[1000,1200], harden:[1575,1650], temper:[300,600], quench:'Wasser oder Öl', notes:'Niedriger Kohlenstoffgehalt, begrenzte Härtbarkeit. Einsatzhärtung für Verschleißflächen empfohlen.'},
        '1045': {anneal:[1450,1550], normalize:[1550,1600], stress:[1000,1200], harden:[1475,1550], temper:[400,1000], quench:'Öl oder Wasser', notes:'Mittlerer Kohlenstoffgehalt. Gute Balance aus Festigkeit und Duktilität nach Wärmebehandlung.'},
        '1095': {anneal:[1400,1500], normalize:[1500,1600], stress:[1000,1200], harden:[1450,1525], temper:[350,800], quench:'Öl', notes:'Hochkohlenstoff-Feder-/Klingenstahl. Hervorragende Schnitthaltigkeit. Rissgefahr bei Wasserabschreckung.'},
        'A36': {anneal:[1550,1650], normalize:[1600,1700], stress:[1000,1200], harden:[0,0], temper:[0,0], quench:'N/A - wird üblicherweise nicht gehärtet', notes:'Baustahl. Vorwärmung beim Schweißen 50-400°F je nach Dicke.'}
      },
      alloy_steel: {
        '4130': {anneal:[1525,1600], normalize:[1600,1700], stress:[1000,1200], harden:[1525,1600], temper:[400,1300], quench:'Öl', notes:'Chromoly. Hervorragend für Flugzeug- und Rennwagenchassis. Nach dem Schweißen normalisieren.'},
        '4140': {anneal:[1450,1550], normalize:[1600,1650], stress:[1000,1200], harden:[1500,1575], temper:[400,1300], quench:'Öl', notes:'Sehr vielseitiger Legierungsstahl. Weit verbreitet für Wellen, Zahnräder und Werkzeuge.'},
        '4340': {anneal:[1450,1550], normalize:[1600,1650], stress:[1000,1200], harden:[1475,1550], temper:[400,1200], quench:'Öl', notes:'Hochfester Legierungsstahl. Wird für Fahrwerke, Antriebswellen und Schwerlastanwendungen verwendet.'},
        '8620': {anneal:[1525,1600], normalize:[1650,1700], stress:[1000,1200], harden:[1525,1575], temper:[300,600], quench:'Öl oder Wasser', notes:'Einsatzhärtungsstahl. Hervorragend für Zahnräder und Lager.'}
      },
      stainless: {
        '304': {anneal:[1900,2050], normalize:[0,0], stress:[700,900], harden:[0,0], temper:[0,0], quench:'Wasserabschreckung von Glühtemperatur', notes:'Austenitisch. Kann nicht durch Wärmebehandlung gehärtet werden. Glühen zur Wiederherstellung der Korrosionsbeständigkeit nach dem Schweißen.'},
        '316': {anneal:[1900,2100], normalize:[0,0], stress:[700,900], harden:[0,0], temper:[0,0], quench:'Wasserabschreckung von Glühtemperatur', notes:'Austenitisch mit Molybdän. Überlegene Korrosionsbeständigkeit. Gleiche Wärmebehandlung wie 304.'},
        '410': {anneal:[1400,1500], normalize:[1700,1800], stress:[400,800], harden:[1700,1850], temper:[400,1400], quench:'Luft oder Öl', notes:'Martensitischer Edelstahl. Kann gehärtet werden. Wird für Besteck, Ventile und Pumpenwellen verwendet.'},
        '17-4PH': {anneal:[1900,1950], normalize:[0,0], stress:[0,0], harden:[1900,1950], temper:[900,1150], quench:'Luftkühlung, dann Ausscheidungshärtung', notes:'Ausscheidungshärtend. Auslagern bei 900°F für H900 (höchste Härte) bis 1150°F für H1150 (beste Zähigkeit).'}
      },
      tool_steel: {
        'O1': {anneal:[1400,1450], normalize:[0,0], stress:[1000,1200], harden:[1450,1500], temper:[350,500], quench:'Öl', notes:'Ölhärtender Werkzeugstahl. Hervorragend für Matrizen, Stempel und Schneidwerkzeuge. Sofort nach dem Abschrecken anlassen.'},
        'D2': {anneal:[1600,1650], normalize:[0,0], stress:[1000,1100], harden:[1800,1875], temper:[400,1000], quench:'Luft', notes:'Lufthärtender Kaltarbeitsstahl. Hervorragende Verschleißfestigkeit. Doppeltes Anlassen empfohlen.'},
        'A2': {anneal:[1525,1600], normalize:[0,0], stress:[1000,1200], harden:[1725,1800], temper:[350,800], quench:'Luft', notes:'Lufthärtend. Gute Zähigkeit und Verschleißfestigkeit. Beliebt für Stempel und Matrizen.'},
        'W1': {anneal:[1360,1450], normalize:[0,0], stress:[1000,1200], harden:[1425,1500], temper:[350,650], quench:'Wasser (Salzlösung)', notes:'Wasserhärtend. Traditioneller Werkzeugstahl. Geringe Einhärttiefe, zäher Kern.'}
      },
      aluminum: {
        '6061': {anneal:[775,775], normalize:[0,0], stress:[500,550], harden:[985,1000], temper:[320,350], quench:'Wasser', notes:'Lösungsglühen bei 985°F, Wasserabschreckung, dann Auslagern (T6-Vergütung) bei 320°F für 18 Std. Glühen bei 775°F, langsam abkühlen.'},
        '7075': {anneal:[775,775], normalize:[0,0], stress:[500,550], harden:[870,890], temper:[250,325], quench:'Wasser', notes:'Luft- und Raumfahrt-Aluminium. Lösungsglühen bei 870°F, Wasserabschreckung, Auslagern bei 250°F für T6. Sehr hohe Festigkeit.'},
        '2024': {anneal:[775,775], normalize:[0,0], stress:[500,550], harden:[920,935], temper:[375,375], quench:'Wasser', notes:'Flugzeug-Aluminium. Lösungsglühen bei 920°F, Wasserabschreckung. Naturauslagern (T4) oder künstliches Auslagern bei 375°F (T6).'},
        '5052': {anneal:[650,650], normalize:[0,0], stress:[400,450], harden:[0,0], temper:[0,0], quench:'N/A - nicht wärmebehandelbar', notes:'Nur Kaltverfestigung. Glühen bei 650°F zur Wiederherstellung der Duktilität nach Kaltumformung. Gute Korrosionsbeständigkeit.'}
      },
      copper: {
        'C110': {anneal:[700,1200], normalize:[0,0], stress:[400,600], harden:[0,0], temper:[0,0], quench:'Luft oder Wasser', notes:'Reinkupfer. Glühen zum Weichmachen nach Kaltumformung. Kann nicht durch Wärmebehandlung gehärtet werden.'},
        'C260': {anneal:[800,1100], normalize:[0,0], stress:[500,700], harden:[0,0], temper:[0,0], quench:'Luft oder Wasser', notes:'Patronenmessing (70/30). Spannungsarmglühen bei 500°F zur Vermeidung von Spannungsrisskorrosion.'},
        'C510': {anneal:[900,1250], normalize:[0,0], stress:[400,600], harden:[0,0], temper:[0,0], quench:'Luft', notes:'Phosphorbronze. Kaltumformung für Festigkeit. Zwischenglühen bei Kaltumformungsvorgängen.'},
        'C172': {anneal:[1425,1475], normalize:[0,0], stress:[0,0], harden:[1425,1475], temper:[600,700], quench:'Wasser', notes:'Berylliumkupfer. Lösungsglühen, abschrecken, auslagern bei 600°F. Extrem hart und leitfähig.'}
      },
      titanium: {
        'Ti-6Al-4V': {anneal:[1300,1400], normalize:[0,0], stress:[900,1100], harden:[1700,1800], temper:[900,1100], quench:'Wasser oder Luft', notes:'Häufigste Titanlegierung. Walzglühen bei 1300°F. Lösungsglühen + Auslagern für maximale Festigkeit.'},
        'CP-Ti-Gr2': {anneal:[1200,1350], normalize:[0,0], stress:[800,1000], harden:[0,0], temper:[0,0], quench:'Luft', notes:'Technisch reines Titan Grad 2. Glühen zur Wiederherstellung der Duktilität. Kann nicht durch Wärmebehandlung verfestigt werden.'},
        'Ti-6Al-2Sn': {anneal:[1300,1500], normalize:[0,0], stress:[900,1100], harden:[1650,1750], temper:[1000,1100], quench:'Luft', notes:'Near-Alpha-Legierung für Hochtemperatureinsatz. Gute Kriechfestigkeit.'},
        'Ti-3Al-2.5V': {anneal:[1300,1400], normalize:[0,0], stress:[800,1000], harden:[1550,1650], temper:[900,1000], quench:'Wasser', notes:'Wird für Hydraulikrohre und Fahrradrahmen verwendet. Lösungsglühen + Auslagern für höhere Festigkeit.'}
      }
    };

    function updateAlloys() {
      const cat = (document.getElementById('at2-category') as HTMLSelectElement).value;
      const alloySelect = document.getElementById('at2-alloy') as HTMLSelectElement;
      const alloys = at2Data[cat] || {};
      alloySelect.innerHTML = '';
      for (const key of Object.keys(alloys)) {
        const opt = document.createElement('option');
        opt.value = key;
        opt.textContent = key;
        alloySelect.appendChild(opt);
      }
    }

    function calcAT2() {
      const cat = (document.getElementById('at2-category') as HTMLSelectElement).value;
      const alloy = (document.getElementById('at2-alloy') as HTMLSelectElement).value;
      const tunit = (document.getElementById('at2-tunit') as HTMLSelectElement).value;

      const data = at2Data[cat]?.[alloy];
      if (!data) return;

      const conv = (f: number) => {
        if (tunit === 'C') return Math.round((f - 32) * 5 / 9);
        return f;
      };
      const suffix = tunit === 'C' ? ' C' : ' F';
      const deg = '\u00B0';

      const rangeStr = (r: [number, number]) => {
        if (r[0] === 0 && r[1] === 0) return 'N/V';
        if (r[0] === r[1]) return conv(r[0]) + deg + suffix;
        return conv(r[0]) + ' - ' + conv(r[1]) + deg + suffix;
      };

      document.getElementById('at2-anneal')!.textContent = rangeStr(data.anneal);
      document.getElementById('at2-normalize')!.textContent = rangeStr(data.normalize);
      document.getElementById('at2-stress')!.textContent = rangeStr(data.stress);
      document.getElementById('at2-harden')!.textContent = rangeStr(data.harden);
      document.getElementById('at2-temper')!.textContent = rangeStr(data.temper);
      document.getElementById('at2-quench')!.textContent = data.quench;
      document.getElementById('at2-notes')!.textContent = data.notes;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    setTimeout(() => {
      document.getElementById('at2-category')!.addEventListener('change', () => { updateAlloys(); calcAT2(); });

      document.querySelectorAll('.at2-in').forEach(el => {
        el.addEventListener('input', calcAT2);
        el.addEventListener('change', calcAT2);
      });

      updateAlloys();
      calcAT2();
    }, 50);
  </script>
</CalculatorLayout>
