---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Aquarium-Kostenrechner - Gesamte Einrichtungs- & Monatskosten";
const description = "Schätzen Sie die Gesamtkosten einer Aquarium-Einrichtung einschließlich Becken, Filter, Heizer, Substrat, Beleuchtung, Fische und laufende Monatskosten.";
const relatedCalcs = [
  { name: "Aquarium-Volumen", url: "/de/aquarium-rechner", description: "Beckenvolumen und Gewicht berechnen." },
  { name: "Aquarium-Substrat", url: "/de/aquarium-substrat-rechner", description: "Benötigte Substratmenge." },
  { name: "Aquarium-Heizung", url: "/de/aquarium-heizung-rechner", description: "Heizleistungsrechner." },
  { name: "Aquarium-Ständer", url: "/de/aquarium-staender-rechner", description: "Ständer-Tragfähigkeitsrechner." },
  { name: "Fischbesatz", url: "/de/fischbesatz-rechner", description: "Fischbesatzkapazität." },
  { name: "Aquarium-Beleuchtung", url: "/de/aquarium-beleuchtung-rechner", description: "Beleuchtungsrechner." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Aquarium-Kostenrechner" keywords="Aquarium-Kostenrechner, Aquarium-Preis, Aquarium-Einrichtungskosten, Aquarium-Budget, monatliche Aquariumkosten" breadcrumbs={[{ name: "Aquarium-Kosten", url: "/de/aquarium-kosten-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Aquarium-Kostenrechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Schätzen Sie die anfänglichen Einrichtungskosten und laufenden Monatsausgaben für Ihr Aquariumprojekt.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beckengröße (Liter)</label>
            <input type="number" id="aqc-vol" class="aqc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="200" min="20" step="10">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Beckentyp</label>
            <select id="aqc-type" class="aqc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="freshwater" selected>Süßwasser-Gesellschaft</option>
              <option value="planted">Pflanzenbecken</option>
              <option value="cichlid">Buntbarsch-Becken</option>
              <option value="marine">Meerwasser nur Fische</option>
              <option value="reef">Riffaquarium</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Anzahl Fische</label>
            <input type="number" id="aqc-fish" class="aqc-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="12" min="0" step="1">
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Qualitätsniveau</label>
            <select id="aqc-quality" class="aqc-in w-full px-4 py-3 border border-border rounded-xl text-lg">
              <option value="budget">Günstig</option>
              <option value="mid" selected>Mittelklasse</option>
              <option value="premium">Premium</option>
            </select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Gesamte Einrichtungskosten</div>
          <div class="text-5xl font-extrabold font-mono" id="aqc-result">0 &euro;</div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Becken + Unterschrank</div>
            <div class="text-xl font-bold font-mono" id="aqc-tank">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Ausrüstung</div>
            <div class="text-xl font-bold font-mono" id="aqc-equip">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Besatz + Deko</div>
            <div class="text-xl font-bold font-mono" id="aqc-live">0 &euro;</div>
          </div>
          <div class="p-4 bg-surface-alt rounded-xl text-center">
            <div class="text-xs text-text-muted uppercase">Monatliche Betriebskosten</div>
            <div class="text-xl font-bold font-mono" id="aqc-monthly">0 &euro;</div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="aquarium-cost" />
      <FeedbackWidget lang="de" />
    </div>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcAQC() {
      const vol = parseFloat((document.getElementById('aqc-vol') as HTMLInputElement).value) || 0;
      const type = (document.getElementById('aqc-type') as HTMLSelectElement).value;
      const fish = parseFloat((document.getElementById('aqc-fish') as HTMLInputElement).value) || 0;
      const quality = (document.getElementById('aqc-quality') as HTMLSelectElement).value;
      const qualMul: Record<string, number> = { budget: 0.65, mid: 1, premium: 1.6 };
      const qm = qualMul[quality] || 1;
      const volGal = vol / 3.785;
      const tankPerGal: Record<string, number> = { freshwater: 2, planted: 2, cichlid: 2, marine: 3, reef: 4 };
      const tankCost = volGal * (tankPerGal[type] || 2) * qm;
      const standCost = volGal * 1.5 * qm;
      const filterCost = (volGal < 30 ? 25 : volGal < 75 ? 50 : 90) * qm;
      const heaterCost = (volGal < 30 ? 15 : volGal < 75 ? 25 : 40) * qm;
      const lightBase: Record<string, number> = { freshwater: 30, planted: 80, cichlid: 30, marine: 100, reef: 200 };
      const lightCost = (lightBase[type] || 30) * qm * (volGal / 55);
      const extras: Record<string, number> = { freshwater: 30, planted: 80, cichlid: 40, marine: 150, reef: 300 };
      const extraCost = (extras[type] || 30) * qm;
      const equipTotal = filterCost + heaterCost + lightCost + extraCost;
      const fishPrice: Record<string, number> = { freshwater: 4, planted: 5, cichlid: 8, marine: 25, reef: 35 };
      const fishCost = fish * (fishPrice[type] || 4) * qm;
      const subCost = volGal * 0.4 * qm;
      const decorCost = (volGal < 30 ? 20 : volGal < 75 ? 40 : 70) * qm;
      const liveTotal = fishCost + subCost + decorCost;
      const total = tankCost + standCost + equipTotal + liveTotal;
      const elecCost = (volGal * 0.08 + 5);
      const foodCost = fish * 0.5;
      const supplyCost = volGal * 0.05;
      const monthly = (elecCost + foodCost + supplyCost) * (type === 'reef' ? 2 : type === 'marine' ? 1.5 : 1);
      const fmtDE = (v: number) => Math.round(v).toLocaleString('de-DE') + ' \u20AC';
      document.getElementById('aqc-result')!.textContent = fmtDE(total);
      document.getElementById('aqc-tank')!.textContent = fmtDE(tankCost + standCost);
      document.getElementById('aqc-equip')!.textContent = fmtDE(equipTotal);
      document.getElementById('aqc-live')!.textContent = fmtDE(liveTotal);
      document.getElementById('aqc-monthly')!.textContent = fmtDE(monthly) + '/Mo.';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.aqc-in').forEach(el => { el.addEventListener('input', calcAQC); el.addEventListener('change', calcAQC); });
      calcAQC();
    }, 50);
  </script>
</CalculatorLayout>
