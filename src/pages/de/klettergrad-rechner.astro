---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Klettergrad-Rechner - Schwierigkeitsgrade umrechnen";
const description = "Rechnen Sie Klettergrade zwischen UIAA, Französisch, YDS, Britisch und V-Skala (Bouldern) um. Vergleichen Sie Schwierigkeiten systemübergreifend.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt berechnen." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Klettergrad-Rechner" enSlug="climbing-grade-calculator" keywords="Klettergrad Umrechner, UIAA Grade, Französische Klettergrade, YDS, V-Skala Bouldern, Schwierigkeitsgrade Klettern" breadcrumbs={[{ name: "Klettergrad-Rechner", url: "/de/klettergrad-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Klettergrad-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Rechnen Sie Klettergrade zwischen UIAA, Französisch, YDS, Britisch und V-Skala (Bouldern) um.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="flex gap-2">
          <button class="kg-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-primary bg-blue-50 text-primary" data-mode="route">Routenklettern</button>
          <button class="kg-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 border-border text-text-muted" data-mode="boulder">Bouldern</button>
        </div>
        <div id="kg-route-section">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bewertungssystem</label>
            <select id="kg-system" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="uiaa">UIAA</option>
              <option value="french">Französisch</option>
              <option value="yds">YDS (Yosemite Decimal)</option>
              <option value="british">Britisch (Tech)</option>
            </select>
          </div>
          <div class="mt-3">
            <label class="block text-xs font-medium text-text mb-1">Grad</label>
            <select id="kg-grade" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"></select>
          </div>
        </div>
        <div id="kg-boulder-section" class="hidden">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Bewertungssystem</label>
            <select id="kg-bsystem" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="vscale">V-Skala (Hueco)</option>
              <option value="font">Font (Fontainebleau)</option>
            </select>
          </div>
          <div class="mt-3">
            <label class="block text-xs font-medium text-text mb-1">Grad</label>
            <select id="kg-bgrade" class="kg-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold"></select>
          </div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Schwierigkeitsstufe</div>
          <div class="text-4xl font-extrabold font-mono" id="kg-level">--</div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Grad-Äquivalente</h3>
          <div class="text-sm space-y-2" id="kg-conversions"></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-2">Beschreibung</h3>
          <p class="text-sm text-text-secondary" id="kg-desc">--</p>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="klettergrad" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">Klettergrade im Vergleich</h2>
      <p>Die UIAA-Skala ist im deutschsprachigen Raum am verbreitetsten. Beim Sportklettern wird oft auch die französische Skala verwendet. In Nordamerika ist das YDS (Yosemite Decimal System) Standard.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Welcher Grad ist für Anfänger geeignet?</strong> UIAA III-IV (franz. 3-4a) sind gute Einstiegsgrade im Freien.</p>
      <p><strong>Ab wann gilt man als fortgeschritten?</strong> Ab UIAA VII (franz. 6a) beginnt der fortgeschrittene Bereich.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    let kgMode = 'route';
    const routeGrades = [
      { idx: 0, yds: '5.2', french: '2', uiaa: 'II', british: '1a', desc: 'Leicht - einfaches Klettern mit großen Griffen.' },
      { idx: 1, yds: '5.3', french: '2+', uiaa: 'III', british: '1b', desc: 'Leicht - moderates Kraxeln.' },
      { idx: 2, yds: '5.4', french: '3', uiaa: 'IV', british: '1c', desc: 'Mäßig - steiler mit kleineren Griffen.' },
      { idx: 3, yds: '5.5', french: '3+', uiaa: 'IV+', british: '2a', desc: 'Mäßig - etwas Technik erforderlich.' },
      { idx: 4, yds: '5.6', french: '4a', uiaa: 'V-', british: '3a', desc: 'Mäßig - guter Einsteiger-Outdoorgrad.' },
      { idx: 5, yds: '5.7', french: '4b', uiaa: 'V', british: '3b', desc: 'Mittel - Ausgesetztheit, Technik nötig.' },
      { idx: 6, yds: '5.8', french: '4c', uiaa: 'V+', british: '3c', desc: 'Mittel - anhaltende Bewegung.' },
      { idx: 7, yds: '5.9', french: '5a', uiaa: 'VI-', british: '4a', desc: 'Obere Mittelstufe - gute Fitness nötig.' },
      { idx: 8, yds: '5.10a', french: '5b', uiaa: 'VI', british: '4b', desc: 'Fortgeschritten - technische Sequenzen.' },
      { idx: 9, yds: '5.10b', french: '5c', uiaa: 'VI+', british: '4c', desc: 'Fortgeschritten - anspruchsvolle Züge.' },
      { idx: 10, yds: '5.10c', french: '6a', uiaa: 'VII-', british: '5a', desc: 'Fortgeschritten - starke Technik und Fitness.' },
      { idx: 11, yds: '5.10d', french: '6a+', uiaa: 'VII', british: '5b', desc: 'Fortgeschritten - anhaltende Schwierigkeit.' },
      { idx: 12, yds: '5.11a', french: '6b', uiaa: 'VII+', british: '5c', desc: 'Experte - kraftvoll und technisch.' },
      { idx: 13, yds: '5.11b', french: '6b+', uiaa: 'VIII-', british: '6a', desc: 'Experte - Training erforderlich.' },
      { idx: 14, yds: '5.11c', french: '6c', uiaa: 'VIII', british: '6a', desc: 'Experte - hohe Ausdauer nötig.' },
      { idx: 15, yds: '5.11d', french: '6c+', uiaa: 'VIII+', british: '6b', desc: 'Experte - ernstes Klettern.' },
      { idx: 16, yds: '5.12a', french: '7a', uiaa: 'VIII+', british: '6b', desc: 'Elite - gezieltes Training nötig.' },
      { idx: 17, yds: '5.12b', french: '7a+', uiaa: 'IX-', british: '6c', desc: 'Elite - athletisch und präzise.' },
      { idx: 18, yds: '5.12c', french: '7b', uiaa: 'IX', british: '6c', desc: 'Elite - außergewöhnliche Fitness.' },
      { idx: 19, yds: '5.12d', french: '7b+', uiaa: 'IX+', british: '7a', desc: 'Elite - Weltklasse-Amateur.' },
      { idx: 20, yds: '5.13a', french: '7c', uiaa: 'IX+', british: '7a', desc: 'Profi - professionelles Niveau.' },
      { idx: 21, yds: '5.13b', french: '7c+', uiaa: 'X-', british: '7b', desc: 'Profi - Wettkampfniveau.' },
      { idx: 22, yds: '5.13c', french: '8a', uiaa: 'X', british: '7b', desc: 'Profi - Weltklasse.' },
      { idx: 23, yds: '5.13d', french: '8a+', uiaa: 'X+', british: '7c', desc: 'Profi - unter den Besten.' },
      { idx: 24, yds: '5.14a', french: '8b', uiaa: 'X+', british: '7c', desc: 'Weltklasse - Top 1% der Kletterer.' },
      { idx: 25, yds: '5.14b', french: '8b+', uiaa: 'XI-', british: '8a', desc: 'Weltklasse - Elite-Profi.' },
      { idx: 26, yds: '5.14c', french: '8c', uiaa: 'XI', british: '8a', desc: 'Weltklasse - Handvoll Kletterer.' },
      { idx: 27, yds: '5.14d', french: '8c+', uiaa: 'XI+', british: '8b', desc: 'Weltklasse - nahe am menschlichen Limit.' },
      { idx: 28, yds: '5.15a', french: '9a', uiaa: 'XII-', british: '8b', desc: 'Spitze - nur wenige in der Geschichte.' },
      { idx: 29, yds: '5.15b', french: '9a+', uiaa: 'XII', british: '8c', desc: 'Spitze - härteste Routen der Welt.' },
      { idx: 30, yds: '5.15c', french: '9b', uiaa: 'XII+', british: '8c', desc: 'Spitze - absolutes menschliches Limit.' },
    ];
    const boulderGrades = [
      { idx: 0, vscale: 'VB', font: '3', desc: 'Anfänger - leichte Züge, gute Griffe.' },
      { idx: 1, vscale: 'V0', font: '4', desc: 'Anfänger - erster richtiger Bouldergrad.' },
      { idx: 2, vscale: 'V1', font: '5', desc: 'Einsteiger - etwas schwierigere Züge.' },
      { idx: 3, vscale: 'V2', font: '5+', desc: 'Einsteiger - technische Züge nötig.' },
      { idx: 4, vscale: 'V3', font: '6A', desc: 'Mittel - Kraft und Technik.' },
      { idx: 5, vscale: 'V4', font: '6B', desc: 'Mittel - solider Kletterer.' },
      { idx: 6, vscale: 'V5', font: '6C', desc: 'Fortgeschritten - Training nötig.' },
      { idx: 7, vscale: 'V6', font: '7A', desc: 'Fortgeschritten - stark und geschickt.' },
      { idx: 8, vscale: 'V7', font: '7A+', desc: 'Fortgeschritten - engagierter Boulderer.' },
      { idx: 9, vscale: 'V8', font: '7B', desc: 'Experte - jahrelange Erfahrung.' },
      { idx: 10, vscale: 'V9', font: '7B+', desc: 'Experte - Elite-Fitness nötig.' },
      { idx: 11, vscale: 'V10', font: '7C', desc: 'Elite - sehr wenige erreichen das.' },
      { idx: 12, vscale: 'V11', font: '7C+', desc: 'Elite - Wettkampfniveau.' },
      { idx: 13, vscale: 'V12', font: '8A', desc: 'Profi - professionelles Niveau.' },
      { idx: 14, vscale: 'V13', font: '8A+', desc: 'Profi - Weltklasse.' },
      { idx: 15, vscale: 'V14', font: '8B', desc: 'Weltklasse - Top-Boulderer.' },
      { idx: 16, vscale: 'V15', font: '8B+', desc: 'Weltklasse - nahe am Limit.' },
      { idx: 17, vscale: 'V16', font: '8C', desc: 'Spitze - härteste bekannte Probleme.' },
      { idx: 18, vscale: 'V17', font: '8C+', desc: 'Spitze - absolutes Limit.' },
    ];
    function populateRouteGrades() {
      const sys = (document.getElementById('kg-system') as HTMLSelectElement).value as 'yds' | 'french' | 'uiaa' | 'british';
      const sel = document.getElementById('kg-grade') as HTMLSelectElement;
      sel.innerHTML = routeGrades.map(g => '<option value="' + g.idx + '">' + g[sys] + '</option>').join('');
      sel.value = '8';
    }
    function populateBoulderGrades() {
      const sys = (document.getElementById('kg-bsystem') as HTMLSelectElement).value as 'vscale' | 'font';
      const sel = document.getElementById('kg-bgrade') as HTMLSelectElement;
      sel.innerHTML = boulderGrades.map(g => '<option value="' + g.idx + '">' + g[sys] + '</option>').join('');
      sel.value = '4';
    }
    function calcKG() {
      if (kgMode === 'route') {
        const idx = parseInt((document.getElementById('kg-grade') as HTMLSelectElement).value) || 0;
        const g = routeGrades[idx];
        if (!g) return;
        document.getElementById('kg-level')!.textContent = g.uiaa + ' / ' + g.french;
        document.getElementById('kg-conversions')!.innerHTML = [
          '<div class="flex justify-between"><span class="text-text-muted">UIAA</span><span class="font-bold font-mono">' + g.uiaa + '</span></div>',
          '<div class="flex justify-between"><span class="text-text-muted">Französisch</span><span class="font-bold font-mono">' + g.french + '</span></div>',
          '<div class="flex justify-between"><span class="text-text-muted">YDS</span><span class="font-bold font-mono">' + g.yds + '</span></div>',
          '<div class="flex justify-between"><span class="text-text-muted">Britisch (Tech)</span><span class="font-bold font-mono">' + g.british + '</span></div>',
        ].join('');
        document.getElementById('kg-desc')!.textContent = g.desc;
      } else {
        const idx = parseInt((document.getElementById('kg-bgrade') as HTMLSelectElement).value) || 0;
        const g = boulderGrades[idx];
        if (!g) return;
        document.getElementById('kg-level')!.textContent = g.vscale + ' / ' + g.font;
        document.getElementById('kg-conversions')!.innerHTML = [
          '<div class="flex justify-between"><span class="text-text-muted">V-Skala (Hueco)</span><span class="font-bold font-mono">' + g.vscale + '</span></div>',
          '<div class="flex justify-between"><span class="text-text-muted">Font (Fontainebleau)</span><span class="font-bold font-mono">' + g.font + '</span></div>',
        ].join('');
        document.getElementById('kg-desc')!.textContent = g.desc;
      }
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.kg-mode').forEach(b => b.addEventListener('click', () => {
        kgMode = (b as HTMLButtonElement).dataset.mode!;
        document.querySelectorAll('.kg-mode').forEach(btn => {
          const active = (btn as HTMLButtonElement).dataset.mode === kgMode;
          (btn as HTMLButtonElement).className = 'kg-mode flex-1 py-2 rounded-xl font-bold text-sm border-2 ' + (active ? 'border-primary bg-blue-50 text-primary' : 'border-border text-text-muted');
        });
        document.getElementById('kg-route-section')!.classList.toggle('hidden', kgMode !== 'route');
        document.getElementById('kg-boulder-section')!.classList.toggle('hidden', kgMode !== 'boulder');
        calcKG();
      }));
      populateRouteGrades();
      populateBoulderGrades();
      document.getElementById('kg-system')!.addEventListener('change', () => { populateRouteGrades(); calcKG(); });
      document.getElementById('kg-bsystem')!.addEventListener('change', () => { populateBoulderGrades(); calcKG(); });
      document.querySelectorAll('.kg-in').forEach(el => { el.addEventListener('input', calcKG); el.addEventListener('change', calcKG); });
      calcKG();
    }, 50);
  </script>
</CalculatorLayout>
