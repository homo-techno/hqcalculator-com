---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Körperoberfläche-Rechner - KOF (Mosteller & Du Bois)";
const description = "Berechnen Sie die Körperoberfläche (KOF/BSA) mit der Mosteller-Formel. Auch Du Bois-Vergleich für klinische Dosierung.";
const relatedCalcs = [
  { name: "BMI-Rechner", url: "/de/bmi-rechner", description: "Body-Mass-Index." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Täglicher Kalorienbedarf." },
  { name: "Militär-Körperfett-Rechner", url: "/de/militaer-koerperfett-rechner", description: "Körperfettanteil." },
  { name: "A1c-Rechner", url: "/de/a1c-rechner", description: "HbA1c-Umrechnung." },
  { name: "Durchschnittsrechner", url: "/de/durchschnittsrechner", description: "Durchschnitt." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
];
---
<CalculatorLayout lang="de" title={title} description={description} calculatorName="Körperoberfläche-Rechner" enSlug="body-surface-area-calculator" keywords="Körperoberfläche, KOF, BSA, Mosteller, Du Bois, Medikamentendosierung, Körperfläche" breadcrumbs={[{ name: "Körperoberfläche-Rechner", url: "/de/koerperoberflaeche-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Körperoberfläche-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie die KOF mit den Formeln nach Mosteller und Du Bois.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-text mb-1">Größe (cm)</label><input type="number" id="ko-ht" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="170" min="50" max="250" step="1"></div>
          <div><label class="block text-xs font-medium text-text mb-1">Gewicht (kg)</label><input type="number" id="ko-wt" class="ko-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold" value="70" min="10" max="300" step="0.1"></div>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Körperoberfläche (Mosteller)</div>
          <div class="text-5xl font-extrabold font-mono" id="ko-result">0</div>
          <div class="text-sm text-blue-200 mt-1">m²</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Du Bois KOF</div><div class="text-xl font-bold" id="ko-dubois">0 m²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Haycock KOF</div><div class="text-xl font-bold" id="ko-haycock">0 m²</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Abweichung</div><div class="text-xl font-bold" id="ko-diff">0%</div></div>
        </div>
        <div class="p-4 bg-surface-alt rounded-xl">
          <h3 class="font-semibold text-sm text-text mb-3">KOF-Referenzwerte</h3>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="flex justify-between"><span>Durchschn. Erwachsener</span><span class="font-bold">1,7 m²</span></div>
            <div class="flex justify-between"><span>Durchschn. Mann</span><span class="font-bold">1,9 m²</span></div>
            <div class="flex justify-between"><span>Durchschn. Frau</span><span class="font-bold">1,6 m²</span></div>
            <div class="flex justify-between"><span>Neugeborenes</span><span class="font-bold">0,25 m²</span></div>
          </div>
        </div>
      </div>
      <ShareButton lang="de" calculatorId="koerperoberflaeche" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">KOF-Formeln</h2>
      <p>Die Mosteller-Formel: KOF (m²) = Wurzel(Größe(cm) x Gewicht(kg) / 3600). Die Du Bois-Formel: KOF = 0,007184 x Größe^0,725 x Gewicht^0,425. Die KOF wird häufig in der Onkologie zur Chemotherapie-Dosierung verwendet.</p>
      <h3 class="text-xl font-semibold text-text mt-8">Häufig gestellte Fragen</h3>
      <p><strong>Wofür wird die KOF verwendet?</strong> Die Körperoberfläche ist ein wichtiger Parameter für die Dosierung von Medikamenten, insbesondere in der Onkologie und bei Verbrennungen.</p>
    </article>
    <RelatedCalculators lang="de" calculators={relatedCalcs} />
  </div>
  <script>
    function calcKO() {
      const ht = parseFloat((document.getElementById('ko-ht') as HTMLInputElement).value) || 0;
      const wt = parseFloat((document.getElementById('ko-wt') as HTMLInputElement).value) || 0;
      const mosteller = Math.sqrt((ht * wt) / 3600);
      const dubois = 0.007184 * Math.pow(ht, 0.725) * Math.pow(wt, 0.425);
      const haycock = 0.024265 * Math.pow(ht, 0.3964) * Math.pow(wt, 0.5378);
      const diff = mosteller > 0 ? Math.abs((mosteller - dubois) / mosteller * 100) : 0;
      document.getElementById('ko-result')!.textContent = mosteller.toFixed(2);
      document.getElementById('ko-dubois')!.textContent = dubois.toFixed(2) + ' m\u00B2';
      document.getElementById('ko-haycock')!.textContent = haycock.toFixed(2) + ' m\u00B2';
      document.getElementById('ko-diff')!.textContent = diff.toFixed(1) + '%';
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      document.querySelectorAll('.ko-in').forEach(el => { el.addEventListener('input', calcKO); el.addEventListener('change', calcKO); });
      calcKO();
    }, 50);
  </script>
</CalculatorLayout>
