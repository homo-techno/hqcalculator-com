---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
const title = "Zucht-Rechner - Tragzeit, Geburtstermin & Wurfgr&ouml;&szlig;e";
const description = "Berechnen Sie die Tragzeit nach Tierart, den voraussichtlichen Geburtstermin ab Deckdatum, Deckfenster und gesch&auml;tzte Wurfgr&ouml;&szlig;e.";
const relatedCalcs = [
  { name: "Zuchtbecken-Rechner", url: "/de/zuchtbecken-rechner", description: "Zuchtbecken planen." },
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Kalorienbedarf." },
  { name: "Prozentrechner", url: "/de/prozentrechner", description: "Prozentrechnung." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Alter berechnen." },
];
---
<CalculatorLayout title={title} description={description} calculatorName="Zucht-Rechner" lang="de" enSlug="breeding-calculator" keywords="zucht rechner, tragzeit, geburtstermin, wurfgr&ouml;&szlig;e, tierzucht, deckdatum" breadcrumbs={[{ name: "Zucht-Rechner", url: "/de/zucht-rechner" }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">Zucht-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechnen Sie Tragzeit, voraussichtlichen Geburtstermin, Deckfenster und Wurfgr&ouml;&szlig;ensch&auml;tzungen nach Tierart.</p>
    <div class="bg-white border border-border rounded-2xl shadow-sm p-6 sm:p-8 max-w-2xl mx-auto">
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-text mb-1">Tierart</label>
            <select id="bd-species" class="bd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
              <option value="dog" selected>Hund</option>
              <option value="cat">Katze</option>
              <option value="horse">Pferd</option>
              <option value="cattle">Rind</option>
              <option value="goat">Ziege</option>
              <option value="sheep">Schaf</option>
              <option value="pig">Schwein</option>
              <option value="rabbit">Kaninchen</option>
              <option value="chicken">Huhn (Brutzeit)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text mb-1">Deck- / Paarungsdatum</label>
            <input type="date" id="bd-date" class="bd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-text mb-1">Rassegr&ouml;&szlig;e (nur Hunde)</label>
          <select id="bd-size" class="bd-in w-full px-4 py-3 border border-border rounded-xl text-lg font-bold">
            <option value="small">Kleine Rasse</option>
            <option value="medium" selected>Mittlere Rasse</option>
            <option value="large">Gro&szlig;e Rasse</option>
          </select>
        </div>
        <div class="p-6 bg-primary rounded-2xl text-white text-center">
          <div class="text-sm text-blue-200 uppercase tracking-wide mb-1">Voraussichtlicher Geburtstermin</div>
          <div class="text-5xl font-extrabold font-mono" id="bd-result">--</div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Tragzeit (Tage)</div><div class="text-xl font-bold font-mono" id="bd-gestation">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Geburtsfenster</div><div class="text-xl font-bold font-mono" id="bd-window">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Wurfgr&ouml;&szlig;e gesch.</div><div class="text-xl font-bold font-mono" id="bd-litter">--</div></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Verbleibende Tage</div><div class="text-xl font-bold font-mono" id="bd-remaining">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Fortschritt</div><div class="text-xl font-bold font-mono" id="bd-progress">--</div></div>
          <div class="p-4 bg-surface-alt rounded-xl text-center"><div class="text-xs text-text-muted uppercase">Trimester</div><div class="text-xl font-bold font-mono" id="bd-trimester">--</div></div>
        </div>
      </div>
      <ShareButton calculatorId="breeding" lang="de" />
      <FeedbackWidget lang="de" />
    </div>
    <article class="mt-12 max-w-4xl prose prose-slate mx-auto">
      <h2 class="text-2xl font-bold text-text">H&auml;ufig gestellte Fragen</h2>
      <p><strong>Wie genau ist der Geburtstermin?</strong> Der Rechner gibt den durchschnittlichen Geburtstermin an. Die tats&auml;chliche Geburt kann einige Tage fr&uuml;her oder sp&auml;ter erfolgen.</p>
      <p><strong>Beeinflusst die Rassegr&ouml;&szlig;e die Wurfgr&ouml;&szlig;e?</strong> Ja, gr&ouml;&szlig;ere Hunderassen haben in der Regel gr&ouml;&szlig;ere W&uuml;rfe als kleinere Rassen.</p>
    </article>
    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>
  <script>
    function calcBD() {
      const species = (document.getElementById('bd-species') as HTMLSelectElement).value;
      const dateStr = (document.getElementById('bd-date') as HTMLInputElement).value;
      const size = (document.getElementById('bd-size') as HTMLSelectElement).value;

      const gestData: Record<string, { days: number; range: number; litter: string }> = {
        dog:     { days: 63, range: 3, litter: '4-8' },
        cat:     { days: 65, range: 3, litter: '3-5' },
        horse:   { days: 340, range: 20, litter: '1' },
        cattle:  { days: 283, range: 10, litter: '1' },
        goat:    { days: 150, range: 5, litter: '1-3' },
        sheep:   { days: 147, range: 5, litter: '1-3' },
        pig:     { days: 114, range: 3, litter: '8-12' },
        rabbit:  { days: 31, range: 2, litter: '4-12' },
        chicken: { days: 21, range: 1, litter: 'N/A' },
      };

      const data = gestData[species] || gestData['dog'];
      let litterDisplay = data.litter;
      if (species === 'dog') {
        const dogLitter: Record<string, string> = { small: '2-5', medium: '4-8', large: '6-12' };
        litterDisplay = dogLitter[size] || '4-8';
      }

      let dueDisplay = '--';
      let remainingDisplay = '--';
      let progressDisplay = '--';
      let trimesterDisplay = '--';

      if (dateStr) {
        const breedDate = new Date(dateStr);
        const dueDate = new Date(breedDate.getTime() + data.days * 86400000);
        const earlyDate = new Date(breedDate.getTime() + (data.days - data.range) * 86400000);
        const lateDate = new Date(breedDate.getTime() + (data.days + data.range) * 86400000);

        const format = (d: Date) => d.getDate() + '.' + (d.getMonth() + 1) + '.' + d.getFullYear();
        dueDisplay = format(dueDate);

        const today = new Date();
        const daysPassed = Math.floor((today.getTime() - breedDate.getTime()) / 86400000);
        const remaining = data.days - daysPassed;
        remainingDisplay = remaining > 0 ? remaining + ' Tage' : 'F\u00e4llig!';

        const progress = Math.min(100, Math.max(0, (daysPassed / data.days) * 100));
        progressDisplay = progress.toFixed(0) + '%';

        const third = data.days / 3;
        if (daysPassed < third) trimesterDisplay = '1.';
        else if (daysPassed < third * 2) trimesterDisplay = '2.';
        else trimesterDisplay = '3.';

        document.getElementById('bd-window')!.textContent = format(earlyDate) + ' - ' + format(lateDate);
      } else {
        document.getElementById('bd-window')!.textContent = 'Datum setzen';
      }

      document.getElementById('bd-result')!.textContent = dueDisplay;
      document.getElementById('bd-gestation')!.textContent = data.days + ' Tage';
      document.getElementById('bd-litter')!.textContent = litterDisplay;
      document.getElementById('bd-remaining')!.textContent = remainingDisplay;
      document.getElementById('bd-progress')!.textContent = progressDisplay;
      document.getElementById('bd-trimester')!.textContent = trimesterDisplay;
      document.dispatchEvent(new CustomEvent('calc-update'));
    }
    setTimeout(() => {
      const today = new Date();
      const dateStr = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
      (document.getElementById('bd-date') as HTMLInputElement).value = dateStr;
      document.querySelectorAll('.bd-in').forEach(el => { el.addEventListener('input', calcBD); el.addEventListener('change', calcBD); });
      calcBD();
    }, 50);
  </script>
</CalculatorLayout>
