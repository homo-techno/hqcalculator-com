---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SliderInput from '../../components/SliderInput.astro';
import ShareButton from '../../components/ShareButton.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const title = "BMI-Rechner - Kostenloser Body-Mass-Index Rechner 2026";
const description = "Berechne deinen Body-Mass-Index (BMI) sofort. Finde heraus, ob du unter-, normal-, übergewichtig oder adipös bist. Unterstützt metrische und imperiale Einheiten.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Was ist ein gesunder BMI?", "acceptedAnswer": { "@type": "Answer", "text": "Ein gesunder BMI liegt zwischen 18,5 und 24,9. Unter 18,5 gilt als Untergewicht, 25-29,9 als Übergewicht und 30 oder höher als Adipositas laut WHO-Klassifikation." } },
    { "@type": "Question", "name": "Wie wird der BMI berechnet?", "acceptedAnswer": { "@type": "Answer", "text": "BMI = Gewicht (kg) / Größe (m)². Für imperiale Einheiten: BMI = (Gewicht in lbs × 703) / (Größe in Zoll)²." } },
    { "@type": "Question", "name": "Ist der BMI für Sportler genau?", "acceptedAnswer": { "@type": "Answer", "text": "Der BMI kann das Körperfett bei Sportlern und muskulösen Personen überschätzen, da er nicht zwischen Muskel- und Fettmasse unterscheidet." } }
  ]
};

const relatedCalcs = [
  { name: "Kalorienrechner", url: "/de/kalorienrechner", description: "Berechne deinen täglichen Kalorienbedarf." },
  { name: "Körperfettrechner", url: "/de/koerperfettrechner", description: "Schätze deinen Körperfettanteil." },
  { name: "Grundumsatzrechner", url: "/de/grundumsatzrechner", description: "Berechne deinen Grundumsatz." },
  { name: "Energieverbrauchsrechner", url: "/de/energieverbrauchsrechner", description: "Berechne deinen täglichen Energieverbrauch." },
  { name: "Abnehmen-Rechner", url: "/de/abnehmenrechner", description: "Plane deinen Gewichtsverlust." },
  { name: "Altersrechner", url: "/de/altersrechner", description: "Berechne dein genaues Alter." },
];
---

<CalculatorLayout title={title} description={description} calculatorName="BMI-Rechner" keywords="BMI-Rechner, Body-Mass-Index, BMI berechnen, BMI-Tabelle, gesundes Gewicht, BMI-Formel" breadcrumbs={[{ name: "BMI-Rechner", url: "/de/bmi-rechner" }]} lang="de">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text mb-2">BMI-Rechner</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">Berechne deinen Body-Mass-Index und finde heraus, wo du auf der BMI-Skala stehst.</p>

    <div class="bg-white border border-border rounded-2xl shadow-sm overflow-hidden">
      <div class="flex border-b border-border">
        <button id="unit-metric" class="flex-1 px-5 py-3 text-sm font-medium text-primary border-b-2 border-primary text-center" data-unit="metric">Metrisch (kg, cm)</button>
        <button id="unit-imperial" class="flex-1 px-5 py-3 text-sm font-medium text-text-secondary border-b-2 border-transparent text-center" data-unit="imperial">Imperial (lbs, ft/in)</button>
      </div>

      <div class="p-6 sm:p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <div id="inputs-metric">
              <SliderInput id="weight-kg" label="Gewicht" min={30} max={200} step={0.5} value={70} suffix=" kg" tooltip="Dein Körpergewicht in Kilogramm" />
              <SliderInput id="height-cm" label="Größe" min={120} max={220} step={1} value={170} suffix=" cm" tooltip="Deine Körpergröße in Zentimetern" />
            </div>
            <div id="inputs-imperial" class="hidden">
              <SliderInput id="weight-lbs" label="Gewicht" min={66} max={440} step={1} value={154} suffix=" lbs" tooltip="Dein Körpergewicht in Pfund" />
              <div class="mb-5">
                <label class="block text-sm font-medium text-text mb-2">Größe</label>
                <div class="flex items-center gap-3">
                  <div class="flex-1"><div class="flex items-center gap-2"><input type="number" id="height-ft" value="5" min="3" max="8" class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" /><span class="text-sm text-text-muted">ft</span></div></div>
                  <div class="flex-1"><div class="flex items-center gap-2"><input type="number" id="height-in" value="7" min="0" max="11" class="w-full text-lg font-semibold border border-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" /><span class="text-sm text-text-muted">in</span></div></div>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 mt-2">
              <div><label for="bmi-age" class="block text-sm font-medium text-text mb-1">Alter (optional)</label><input type="number" id="bmi-age" value="30" min="2" max="120" class="w-full text-sm border border-border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" /></div>
              <div><label class="block text-sm font-medium text-text mb-1">Geschlecht (optional)</label><select id="bmi-gender" class="w-full text-sm border border-border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"><option value="any">Beliebig</option><option value="male">Männlich</option><option value="female">Weiblich</option></select></div>
            </div>
          </div>

          <div class="space-y-4">
            <div class="p-6 rounded-2xl text-white text-center" id="bmi-result-card" style="background: #10b981">
              <div class="text-sm font-medium opacity-80 uppercase tracking-wide mb-1">Dein BMI</div>
              <div class="text-5xl sm:text-6xl font-extrabold" id="bmi-value">24.2</div>
              <div class="text-lg font-semibold mt-2" id="bmi-category">Normalgewicht</div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl">
              <div class="text-xs text-text-muted mb-2 font-medium uppercase tracking-wide">BMI-Skala</div>
              <div class="relative h-6 rounded-full overflow-hidden flex">
                <div class="flex-1 bg-blue-400" title="Untergewicht"></div>
                <div class="flex-1 bg-green-500" title="Normal"></div>
                <div class="flex-1 bg-yellow-500" title="Übergewicht"></div>
                <div class="flex-1 bg-orange-500" title="Adipositas I"></div>
                <div class="flex-[0.5] bg-red-500" title="Adipositas II+"></div>
              </div>
              <div class="relative h-0">
                <div id="bmi-marker" class="absolute -top-7 w-0.5 h-6 bg-text transition-all duration-300" style="left: 50%">
                  <div class="absolute -top-5 left-1/2 -translate-x-1/2 text-xs font-bold bg-text text-white px-1.5 py-0.5 rounded whitespace-nowrap" id="bmi-marker-label">24.2</div>
                </div>
              </div>
              <div class="flex text-[10px] text-text-muted mt-2">
                <div class="flex-1 text-center">Unter<br/>(&lt;18,5)</div>
                <div class="flex-1 text-center">Normal<br/>(18,5-24,9)</div>
                <div class="flex-1 text-center">Über<br/>(25-29,9)</div>
                <div class="flex-1 text-center">Adipos. I<br/>(30-34,9)</div>
                <div class="flex-[0.5] text-center">Adipos. II+<br/>(&ge;35)</div>
              </div>
            </div>
            <div class="p-4 bg-surface-alt rounded-xl">
              <div class="text-xs text-text-muted mb-3 font-medium uppercase tracking-wide">Gesundes Gewicht für deine Größe</div>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between"><span class="text-text-secondary">Untergewicht</span><span class="font-medium" id="range-under">--</span></div>
                <div class="flex justify-between text-secondary font-medium"><span>Normalgewicht</span><span id="range-normal">--</span></div>
                <div class="flex justify-between"><span class="text-text-secondary">Übergewicht</span><span class="font-medium" id="range-over">--</span></div>
                <div class="flex justify-between"><span class="text-text-secondary">Adipositas</span><span class="font-medium" id="range-obese">--</span></div>
              </div>
            </div>
          </div>
        </div>
        <ShareButton calculatorId="bmi" lang="de" />
        <FeedbackWidget lang="de" />
      </div>
    </div>

    <div class="mt-12 bg-white border border-border rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-text mb-4">BMI-Kategorien (WHO-Klassifikation)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-border"><th class="text-left py-2 pr-4 font-semibold text-text">Kategorie</th><th class="text-left py-2 pr-4 font-semibold text-text">BMI-Bereich</th><th class="text-left py-2 font-semibold text-text">Gesundheitsrisiko</th></tr></thead>
          <tbody class="text-text-secondary">
            <tr class="border-b border-border/50"><td class="py-2 pr-4 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-400 inline-block"></span> Starkes Untergewicht</td><td class="py-2 pr-4">&lt; 16,0</td><td class="py-2">Hoch</td></tr>
            <tr class="border-b border-border/50"><td class="py-2 pr-4 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-300 inline-block"></span> Mäßiges Untergewicht</td><td class="py-2 pr-4">16,0 - 16,9</td><td class="py-2">Mäßig</td></tr>
            <tr class="border-b border-border/50"><td class="py-2 pr-4 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-200 inline-block"></span> Leichtes Untergewicht</td><td class="py-2 pr-4">17,0 - 18,4</td><td class="py-2">Gering</td></tr>
            <tr class="border-b border-border/50 bg-green-50"><td class="py-2 pr-4 flex items-center gap-2 font-medium text-secondary"><span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span> Normalgewicht</td><td class="py-2 pr-4 font-medium text-secondary">18,5 - 24,9</td><td class="py-2 text-secondary">Gering</td></tr>
            <tr class="border-b border-border/50"><td class="py-2 pr-4 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span> Übergewicht</td><td class="py-2 pr-4">25,0 - 29,9</td><td class="py-2">Erhöht</td></tr>
            <tr class="border-b border-border/50"><td class="py-2 pr-4 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-orange-500 inline-block"></span> Adipositas Grad I</td><td class="py-2 pr-4">30,0 - 34,9</td><td class="py-2">Hoch</td></tr>
            <tr class="border-b border-border/50"><td class="py-2 pr-4 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span> Adipositas Grad II</td><td class="py-2 pr-4">35,0 - 39,9</td><td class="py-2">Sehr hoch</td></tr>
            <tr><td class="py-2 pr-4 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-red-700 inline-block"></span> Adipositas Grad III</td><td class="py-2 pr-4">&ge; 40,0</td><td class="py-2">Extrem hoch</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <article class="mt-12 max-w-4xl prose prose-slate">
      <h2 class="text-2xl font-bold text-text">Was ist der BMI?</h2>
      <p>Der Body-Mass-Index (BMI) ist eine einfache Messung, die anhand von Größe und Gewicht einschätzt, ob du ein gesundes Gewicht hast. Er wurde vom belgischen Mathematiker Adolphe Quetelet in den 1830er Jahren entwickelt und wird weltweit von medizinischen Fachkräften als schnelles Screening-Instrument verwendet.</p>

      <h3 class="text-xl font-semibold text-text mt-8">Die BMI-Formel</h3>
      <div class="bg-surface-alt rounded-xl p-4 my-4 space-y-2">
        <p class="font-mono text-center"><strong>Metrisch:</strong> BMI = Gewicht (kg) &divide; Größe (m)<sup>2</sup></p>
        <p class="font-mono text-center"><strong>Imperial:</strong> BMI = (Gewicht (lbs) &times; 703) &divide; Größe (in)<sup>2</sup></p>
      </div>
      <p><strong>Beispiel:</strong> Eine Person mit 70 kg und 1,75 m hat einen BMI von 70 &divide; (1,75)<sup>2</sup> = 70 &divide; 3,0625 = <strong>22,9</strong> (Normalgewicht).</p>

      <h3 class="text-xl font-semibold text-text mt-8">Einschränkungen des BMI</h3>
      <ul>
        <li><strong>Unterscheidet nicht zwischen Muskel und Fett:</strong> Sportler können einen "hohen" BMI haben, obwohl sie sehr gesund sind.</li>
        <li><strong>Berücksichtigt nicht die Körperzusammensetzung:</strong> Zwei Personen mit gleichem BMI können sehr unterschiedliche Körperfettanteile haben.</li>
        <li><strong>Variiert nach Ethnie:</strong> Einige Bevölkerungsgruppen haben möglicherweise höhere Gesundheitsrisiken bei niedrigeren BMI-Werten.</li>
        <li><strong>Nicht ideal für Ältere oder Kinder:</strong> Für diese Altersgruppen gelten andere Standards.</li>
      </ul>

      <h2 class="text-2xl font-bold text-text mt-12">Häufig gestellte Fragen</h2>
      <h3 class="text-lg font-semibold text-text mt-6">Was ist ein gesunder BMI?</h3>
      <p>Ein gesunder BMI liegt zwischen 18,5 und 24,9. Unter 18,5 gilt als Untergewicht, 25-29,9 als Übergewicht und 30 oder darüber als Adipositas gemäß der WHO-Klassifikation.</p>
      <h3 class="text-lg font-semibold text-text mt-6">Ist der BMI für Sportler genau?</h3>
      <p>Der BMI kann das Körperfett bei Sportlern und muskulösen Personen überschätzen, da er nicht zwischen Muskel- und Fettmasse unterscheidet. Für diese Personen sind Körperfettanteil oder Taille-Hüfte-Verhältnis genauere Indikatoren.</p>
    </article>

    <RelatedCalculators calculators={relatedCalcs} lang="de" />
  </div>

  <script>
    let currentUnit = 'metric';
    const unitMetric = document.getElementById('unit-metric')!;
    const unitImperial = document.getElementById('unit-imperial')!;
    const inputsMetric = document.getElementById('inputs-metric')!;
    const inputsImperial = document.getElementById('inputs-imperial')!;

    function setUnit(unit: string) {
      currentUnit = unit;
      if (unit === 'metric') {
        unitMetric.classList.add('text-primary', 'border-primary'); unitMetric.classList.remove('text-text-secondary', 'border-transparent');
        unitImperial.classList.remove('text-primary', 'border-primary'); unitImperial.classList.add('text-text-secondary', 'border-transparent');
        inputsMetric.classList.remove('hidden'); inputsImperial.classList.add('hidden');
      } else {
        unitImperial.classList.add('text-primary', 'border-primary'); unitImperial.classList.remove('text-text-secondary', 'border-transparent');
        unitMetric.classList.remove('text-primary', 'border-primary'); unitMetric.classList.add('text-text-secondary', 'border-transparent');
        inputsImperial.classList.remove('hidden'); inputsMetric.classList.add('hidden');
      }
      calculateBMI();
    }
    unitMetric.addEventListener('click', () => setUnit('metric'));
    unitImperial.addEventListener('click', () => setUnit('imperial'));

    function getValues() {
      if (currentUnit === 'metric') {
        const weightKg = parseFloat((document.getElementById('weight-kg-slider') as HTMLInputElement)?.value || '70');
        const heightCm = parseFloat((document.getElementById('height-cm-slider') as HTMLInputElement)?.value || '170');
        return { weightKg, heightM: heightCm / 100 };
      } else {
        const weightLbs = parseFloat((document.getElementById('weight-lbs-slider') as HTMLInputElement)?.value || '154');
        const ft = parseFloat((document.getElementById('height-ft') as HTMLInputElement)?.value || '5');
        const inches = parseFloat((document.getElementById('height-in') as HTMLInputElement)?.value || '7');
        const totalInches = ft * 12 + inches;
        return { weightKg: weightLbs * 0.453592, heightM: totalInches * 0.0254 };
      }
    }

    function calculateBMI() {
      const { weightKg, heightM } = getValues();
      if (heightM <= 0) return;
      const bmi = weightKg / (heightM * heightM);
      const bmiRound = parseFloat(bmi.toFixed(1));

      document.getElementById('bmi-value')!.textContent = String(bmiRound);
      document.getElementById('bmi-marker-label')!.textContent = String(bmiRound);

      let category: string; let color: string;
      if (bmi < 18.5) { category = 'Untergewicht'; color = '#60a5fa'; }
      else if (bmi < 25) { category = 'Normalgewicht'; color = '#10b981'; }
      else if (bmi < 30) { category = 'Übergewicht'; color = '#eab308'; }
      else if (bmi < 35) { category = 'Adipositas Grad I'; color = '#f97316'; }
      else if (bmi < 40) { category = 'Adipositas Grad II'; color = '#ef4444'; }
      else { category = 'Adipositas Grad III'; color = '#b91c1c'; }

      document.getElementById('bmi-category')!.textContent = category;
      (document.getElementById('bmi-result-card') as HTMLElement).style.background = color;

      const minBmi = 10; const maxBmi = 45;
      const pct = Math.min(Math.max((bmi - minBmi) / (maxBmi - minBmi) * 100, 0), 100);
      (document.getElementById('bmi-marker') as HTMLElement).style.left = `${pct}%`;

      const h2 = heightM * heightM;
      const fmtW = (kg: number) => currentUnit === 'metric' ? `${kg.toFixed(1)} kg` : `${(kg * 2.20462).toFixed(1)} lbs`;
      document.getElementById('range-under')!.textContent = `< ${fmtW(18.5 * h2)}`;
      document.getElementById('range-normal')!.textContent = `${fmtW(18.5 * h2)} - ${fmtW(24.9 * h2)}`;
      document.getElementById('range-over')!.textContent = `${fmtW(25 * h2)} - ${fmtW(29.9 * h2)}`;
      document.getElementById('range-obese')!.textContent = `> ${fmtW(30 * h2)}`;

      document.dispatchEvent(new CustomEvent('calc-update'));
    }

    document.addEventListener('calc-update', calculateBMI);
    ['height-ft', 'height-in'].forEach(id => { document.getElementById(id)?.addEventListener('input', calculateBMI); });

    setTimeout(() => {
      calculateBMI();
      ['weight-kg-slider', 'height-cm-slider', 'weight-lbs-slider'].forEach(id => { document.getElementById(id)?.addEventListener('input', calculateBMI); });
      ['weight-kg-input', 'height-cm-input', 'weight-lbs-input', 'height-ft', 'height-in'].forEach(id => { document.getElementById(id)?.addEventListener('input', () => { setTimeout(calculateBMI, 120); }); });
    }, 50);
  </script>
</CalculatorLayout>
