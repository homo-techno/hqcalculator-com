---
import '../styles/global.css';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { getAlternateUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  keywords?: string;
  calculatorName?: string;
  breadcrumbs?: { name: string; url: string }[];
  lang?: Lang;
  enSlug?: string;
}

const {
  title,
  description,
  canonicalUrl,
  keywords,
  calculatorName,
  breadcrumbs = [],
  lang = 'en',
  enSlug,
} = Astro.props;

const siteUrl = 'https://hqcalculator.com';
const currentUrl = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;
const currentYear = new Date().getFullYear();
const homeUrl = lang === 'de' ? '/de' : '/';
const homeAnchor = lang === 'de' ? '/de' : '/';

// Alternate URLs for hreflang
const alternateUrls = getAlternateUrl(Astro.url, lang, siteUrl);
const altLang = lang === 'en' ? 'de' : 'en';
const altUrl = lang === 'en' ? alternateUrls.de : alternateUrls.en;

// Footer calculator links
const footerCalcLinks = lang === 'de' ? {
  mortgage: '/de/hypothekenrechner',
  loan: '/de/kreditrechner',
  compound: '/de/zinseszinsrechner',
  investment: '/de/anlagerechner',
  bmi: '/de/bmi-rechner',
  calorie: '/de/kalorienrechner',
  bodyfat: '/de/koerperfettrechner',
  pregnancy: '/de/schwangerschaftsrechner',
  percentage: '/de/prozentrechner',
  fraction: '/de/bruchrechner',
  gpa: '/de/notenrechner',
  age: '/de/altersrechner',
} : {
  mortgage: '/mortgage-calculator',
  loan: '/loan-calculator',
  compound: '/compound-interest-calculator',
  investment: '/investment-calculator',
  bmi: '/bmi-calculator',
  calorie: '/calorie-calculator',
  bodyfat: '/body-fat-calculator',
  pregnancy: '/pregnancy-calculator',
  percentage: '/percentage-calculator',
  fraction: '/fraction-calculator',
  gpa: '/gpa-calculator',
  age: '/age-calculator',
};

// Schema.org WebApplication
const webAppSchema = calculatorName ? {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": calculatorName,
  "url": currentUrl,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web Browser",
  "inLanguage": lang,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "author": { "@type": "Organization", "name": "HQ Calculator", "url": siteUrl }
} : null;

// Schema.org BreadcrumbList
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t(lang, 'breadcrumb.home'), "item": `${siteUrl}${homeUrl}` },
    ...breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": b.name,
      "item": `${siteUrl}${b.url}`
    }))
  ]
} : null;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={currentUrl} />

  <!-- hreflang -->
  <link rel="alternate" hreflang="en" href={alternateUrls.en} />
  <link rel="alternate" hreflang="de" href={alternateUrls.de} />
  <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />

  <!-- Preconnect for speed -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:site_name" content="HQ Calculator" />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
  <meta property="og:image" content={`${siteUrl}/images/og-default.png`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Schema.org -->
  {webAppSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  )}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}
</head>
<body class="min-h-screen flex flex-col bg-surface">
  <!-- Navigation -->
  <nav class="bg-white border-b border-border sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">
        <a href={homeUrl} class="flex items-center gap-2 text-primary font-bold text-xl no-underline">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="28" height="28" rx="6" fill="currentColor"/>
            <text x="4" y="20" font-size="16" font-weight="bold" fill="white" font-family="Inter, sans-serif">HQ</text>
          </svg>
          <span class="hidden sm:inline">HQ Calculator</span>
        </a>

        <div class="hidden md:flex items-center gap-6 text-sm">
          <a href={`${homeUrl}#financial`} class="text-text-secondary hover:text-primary transition-colors">{t(lang, 'nav.financial')}</a>
          <a href={`${homeUrl}#health`} class="text-text-secondary hover:text-primary transition-colors">{t(lang, 'nav.health')}</a>
          <a href={`${homeUrl}#math`} class="text-text-secondary hover:text-primary transition-colors">{t(lang, 'nav.math')}</a>
          <a href={`${homeUrl}#fitness`} class="text-text-secondary hover:text-primary transition-colors">{t(lang, 'nav.fitness')}</a>
          <a href={`${homeUrl}#other`} class="text-text-secondary hover:text-primary transition-colors">{t(lang, 'nav.more')}</a>

          <!-- Language Selector -->
          <a href={altUrl} class="ml-2 px-2 py-1 text-xs font-semibold border border-border rounded hover:border-primary hover:text-primary transition-colors no-underline">
            {altLang === 'de' ? 'DE' : 'EN'}
          </a>
        </div>

        <!-- Mobile menu button -->
        <div class="flex items-center gap-2 md:hidden">
          <a href={altUrl} class="px-2 py-1 text-xs font-semibold border border-border rounded hover:border-primary hover:text-primary transition-colors no-underline">
            {altLang === 'de' ? 'DE' : 'EN'}
          </a>
          <button id="mobile-menu-btn" class="p-2 text-text-secondary" aria-label={t(lang, 'nav.menu')}>
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white">
      <div class="px-4 py-3 space-y-2">
        <a href={`${homeUrl}#financial`} class="block py-2 text-text-secondary hover:text-primary">{t(lang, 'mobile.financial')}</a>
        <a href={`${homeUrl}#health`} class="block py-2 text-text-secondary hover:text-primary">{t(lang, 'mobile.health')}</a>
        <a href={`${homeUrl}#math`} class="block py-2 text-text-secondary hover:text-primary">{t(lang, 'mobile.math')}</a>
        <a href={`${homeUrl}#fitness`} class="block py-2 text-text-secondary hover:text-primary">{t(lang, 'mobile.fitness')}</a>
        <a href={`${homeUrl}#construction`} class="block py-2 text-text-secondary hover:text-primary">{t(lang, 'mobile.construction')}</a>
      </div>
    </div>
  </nav>

  <!-- Breadcrumbs -->
  {breadcrumbs.length > 0 && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
      <nav class="text-sm text-text-muted" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li><a href={homeUrl} class="hover:text-primary">{t(lang, 'breadcrumb.home')}</a></li>
          {breadcrumbs.map((b) => (
            <li class="flex items-center gap-1">
              <span>/</span>
              <a href={b.url} class="hover:text-primary">{b.name}</a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  )}

  <!-- Main Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-border mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div>
          <h3 class="font-semibold text-text mb-3">{t(lang, 'footer.financial')}</h3>
          <ul class="space-y-2 text-sm text-text-secondary">
            <li><a href={footerCalcLinks.mortgage} class="hover:text-primary">{t(lang, 'footer.mortgage')}</a></li>
            <li><a href={footerCalcLinks.loan} class="hover:text-primary">{t(lang, 'footer.loan')}</a></li>
            <li><a href={footerCalcLinks.compound} class="hover:text-primary">{t(lang, 'footer.compound')}</a></li>
            <li><a href={footerCalcLinks.investment} class="hover:text-primary">{t(lang, 'footer.investment')}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-text mb-3">{t(lang, 'footer.health')}</h3>
          <ul class="space-y-2 text-sm text-text-secondary">
            <li><a href={footerCalcLinks.bmi} class="hover:text-primary">{t(lang, 'footer.bmi')}</a></li>
            <li><a href={footerCalcLinks.calorie} class="hover:text-primary">{t(lang, 'footer.calorie')}</a></li>
            <li><a href={footerCalcLinks.bodyfat} class="hover:text-primary">{t(lang, 'footer.bodyfat')}</a></li>
            <li><a href={footerCalcLinks.pregnancy} class="hover:text-primary">{t(lang, 'footer.pregnancy')}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-text mb-3">{t(lang, 'footer.math')}</h3>
          <ul class="space-y-2 text-sm text-text-secondary">
            <li><a href={footerCalcLinks.percentage} class="hover:text-primary">{t(lang, 'footer.percentage')}</a></li>
            <li><a href={footerCalcLinks.fraction} class="hover:text-primary">{t(lang, 'footer.fraction')}</a></li>
            <li><a href={footerCalcLinks.gpa} class="hover:text-primary">{t(lang, 'footer.gpa')}</a></li>
            <li><a href={footerCalcLinks.age} class="hover:text-primary">{t(lang, 'footer.age')}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-text mb-3">{t(lang, 'footer.about')}</h3>
          <ul class="space-y-2 text-sm text-text-secondary">
            <li><a href={t(lang, 'footer.aboutus.url')} class="hover:text-primary">{t(lang, 'footer.aboutus')}</a></li>
            <li><a href={t(lang, 'footer.privacy.url')} class="hover:text-primary">{t(lang, 'footer.privacy')}</a></li>
            <li><a href={t(lang, 'footer.terms.url')} class="hover:text-primary">{t(lang, 'footer.terms')}</a></li>
            <li><a href="/sitemap-index.xml" class="hover:text-primary">{t(lang, 'footer.sitemap')}</a></li>
          </ul>
        </div>
      </div>
      <div class="mt-10 pt-6 border-t border-border text-center text-sm text-text-muted">
        <p>&copy; {currentYear} {t(lang, 'footer.copyright')}</p>
      </div>
    </div>
  </footer>

  <!-- Mobile menu script -->
  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
